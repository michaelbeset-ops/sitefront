---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Ruit from '../components/Ruit.astro';
import { site, binnen, buiten, horren, plaatsen, reviews, waMet, mailMet } from '../data/site';

import gorinchem from '../assets/gorinchem-markiezen.jpg';
import vouwgordijn from '../assets/hia-vouwgordijn.jpg';
import folds from '../assets/folds.jpg';
import markiezen from '../assets/dordrecht-markiezen.jpg';
import screens from '../assets/hia-screens.jpg';
import bus from '../assets/dordrecht-bus.jpg';
import jaloezieen from '../assets/hia-jaloezieen.jpg';
import ridderkerk from '../assets/ridderkerk-terrasscherm.jpg';
import hordeur from '../assets/kuipersveer-hordeur.jpg';
import rolluiken from '../assets/nieuw-lekkerland-rolluiken.jpg';
import markies from '../assets/dordrecht-markies.jpg';

const pd = (s: string) => `https://www.terlouwinterieur.nl/project-details/${s}/`;

// Projecten: titel letterlijk van hun projectpagina's.
const projecten = [
  { foto: jaloezieen, titel: 'Houten jaloezieën', plaats: 'Hendrik-Ido-Ambacht', href: pd('h-i-ambacht-2'), alt: 'Lichte woonkamer in een nieuwbouwwoning met witte houten jaloezieën voor drie hoge ramen', pos: '50% 50%' },
  { foto: markies, titel: 'Markies', plaats: 'Dordrecht', href: pd('dordrecht-2'), alt: 'Grijs-wit gestreepte markies boven een raam met rode geraniums', pos: '45% 50%' },
  { foto: hordeur, titel: 'Plisséhordeur', plaats: 'Kuipersveer', href: pd('kuipersveer'), alt: 'Zwarte plissé hordeur in een brede schuifpui, met zicht op de woonkamer', pos: '50% 60%' },
  { foto: ridderkerk, titel: 'Terrasscherm', plaats: 'Ridderkerk', href: pd('ridderkerk'), alt: 'Rood uitgedraaid terrasscherm aan een woning met groene gevelbekleding', pos: '50% 50%' },
  { foto: rolluiken, titel: 'Rolluiken', plaats: 'Nieuw-Lekkerland', href: pd('nieuw-lekkerland-2'), alt: 'Antraciet rolluik in een oranje bakstenen gevel', pos: '50% 40%' },
];

const producten = [...binnen, ...buiten, ...horren].map(([t]) => t.toLowerCase());
const eersteBericht = `Hallo Terlouw, ik wil graag advies aan huis over vouwgordijnen voor 3 ramen in Dordrecht. Wanneer komt het u uit?`;

const titel = 'Terlouw Interieur & Montage | Raamdecoratie, zonwering en horren op maat';
const omschrijving = 'Vouwgordijnen, plissés, jaloezieën, shutters, screens, markiezen, terrasschermen, rolluiken en horren. Op maat gemaakt, bij u thuis ingemeten en gemonteerd. Showroom aan de Bruningsstraat 17 in Werkendam.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. HERO: hun nieuwste project, door een kalkwitte omlijsting bekeken zoals door een raam -->
    <section class="bg-kalk px-2.5 pb-2.5 md:px-5 md:pb-5">
      <div class="relative isolate flex min-h-[calc(100svh-9.25rem)] flex-col overflow-hidden bg-grafiet text-wit md:min-h-[calc(100svh-7.25rem)]">
        <Image src={gorinchem} alt="Hoekpand in Gorinchem met groen-wit gestreepte markiezen boven het terras en de bus van Terlouw ernaast" quality={66} widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[46%_60%] md:object-[50%_58%]" />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#22242700_0%,#22242700_30%,#222427a6_62%,#222427f0_100%)] md:bg-[linear-gradient(180deg,#22242700_35%,#2224278c_68%,#222427e6_100%),linear-gradient(90deg,#22242799_0%,#22242700_55%)]"></div>
        <div class="mt-auto grid gap-y-8 px-5 pb-8 pt-40 md:grid-cols-12 md:items-end md:gap-x-8 md:px-12 md:pb-12 lg:px-16 lg:pb-14">
          <div class="md:col-span-8">
            <p class="flex items-center gap-3 text-sm text-wit/85"><Ruit class="h-4 w-auto" open="#ffffffb3" n={2} />Raamdecoratie, zonwering en horren</p>
            <h1 class="mt-5 text-hero">Op maat gemaakt,<br class="max-sm:hidden" /> keurig gemonteerd.</h1>
          </div>
          <div class="md:col-span-4 md:pb-3">
            <p class="max-w-md text-base text-wit/90 md:text-lg">Wij meten bij u thuis in, laten alles op maat maken en monteren het zelf. Van vouwgordijn tot markies.</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="#afspraak" class="knop knop-zand">Afspraak maken</a>
              <a href={site.telHref} class="knop knop-wit num max-sm:hidden"><Icoon naam="tel" />{site.tel}</a>
            </div>
          </div>
        </div>
        <p class="absolute right-5 top-4 text-xs text-wit [text-shadow:0_1px_6px_#000c] md:right-8 md:top-6">Markiezen geplaatst in Gorinchem</p>
      </div>
    </section>

    <!-- Showroom helder: één adres -->
    <section aria-label="Showroom" class="border-b border-lijn">
      <div class="wrap flex flex-col gap-x-10 gap-y-3 py-6 md:flex-row md:items-center md:justify-between md:py-7">
        <p class="flex items-start gap-3 text-[.9375rem] md:items-center"><Icoon naam="pin" class="mt-0.5 h-5 w-5 flex-none text-zand-diep md:mt-0" /><span><strong class="font-semibold">Showroom: Bruningsstraat 17, Werkendam.</strong> <span class="text-grijs">De showroom aan het Noordeinde in Hendrik-Ido-Ambacht is gesloten.</span></span></p>
        <p class="flex flex-none gap-6 pl-8 text-sm font-medium md:pl-0"><a href={site.maps} class="link">Route</a><a href="#afspraak" class="link">Afspraak maken</a></p>
      </div>
    </section>

    <!-- 2. BINNEN: stalenboek -->
    <section id="binnen" class="py-16 md:py-24">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={vouwgordijn} alt="Taupe vouwgordijn half opgetrokken voor een raam, met zicht op een tuin met terrastafel" quality={72} widths={[480, 720, 960]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[4/3] w-full object-cover object-[50%_35%] sm:aspect-[4/5]" />
          <figcaption class="mt-3 text-xs text-grijs">Vouwgordijnen geplaatst in Hendrik-Ido-Ambacht</figcaption>
        </figure>
        <div class="lg:col-span-7 lg:pt-6">
          <h2 class="rijs text-4xl">Binnen</h2>
          <p class="rijs mt-5 max-w-lg text-lg text-grijs" style="--d:.08s">Twaalf soorten raamdecoratie, voor elk raam op maat. Ook voor draaikiepramen, serres en ramen met ronde of meerdere hoeken.</p>
          <ul class="rijs mt-10 grid gap-x-10 sm:grid-cols-2" style="--d:.12s">
            {binnen.map(([t, href]) => <li><a href={href} class="regel">{t}<Icoon naam="pijl" /></a></li>)}
          </ul>
        </div>
      </div>

      <!-- Folds: nieuw in de collectie -->
      <div class="wrap mt-20 md:mt-20">
        <div class="grid items-end gap-y-8 md:grid-cols-12 md:gap-x-10">
          <figure class="rijs relative md:col-span-6">
            <Image src={folds} alt="Close-up van een lichtgrijs Folds-vouwgordijn in zachte, naadloze plooien" quality={72} widths={[640, 960, 1280]} sizes="(min-width: 768px) 48vw, 100vw" class="aspect-[16/9] w-full object-cover object-[30%_50%]" />
          </figure>
          <div class="rijs md:col-span-5 md:col-start-8" style="--d:.1s">
            <p class="flex items-center gap-3 text-sm font-medium text-zand-diep"><Ruit class="h-3.5 w-auto" n={2} />Nieuw in de collectie</p>
            <h3 class="mt-4 text-3xl">Folds</h3>
            <p class="mt-4 text-grijs">De nieuwe generatie vouwgordijnen zonder stiknaden en zomen, afgewerkt met high-end houten baleinen.</p>
            <p class="mt-6 text-xs text-grijs">Beeld: Folds</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. BUITEN EN HORREN -->
    <section id="buiten" class="bg-steen pb-16 md:pb-24">
      <figure class="relative">
        <Image src={screens} alt="Witte nieuwbouwwoning met screens voor alle ramen en de bus van Terlouw op de oprit" quality={70} widths={[640, 960, 1280, 1680]} sizes="100vw" class="h-[50svh] min-h-72 w-full object-cover object-[50%_45%] md:h-[64svh]" />
        <figcaption class="wrap absolute inset-x-0 bottom-0 pb-5 text-xs text-wit [text-shadow:0_1px_8px_#0009]">Tien windvaste screens, nieuwbouwwoning in Hendrik-Ido-Ambacht</figcaption>
      </figure>
      <div class="wrap grid gap-y-14 pt-16 md:pt-24 lg:grid-cols-12 lg:gap-x-14">
        <div class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:col-span-7">
          <div>
            <h2 class="rijs text-4xl">Buiten</h2>
            <p class="rijs mt-5 max-w-sm text-grijs" style="--d:.08s">Screens, markiezen en schermen in de stof en kastkleur die bij uw huis past.</p>
            <ul class="rijs mt-8" style="--d:.12s">
              {buiten.map(([t, href]) => <li><a href={href} class="regel">{t}<Icoon naam="pijl" /></a></li>)}
            </ul>
          </div>
          <div id="horren">
            <h2 class="rijs text-4xl">Horren</h2>
            <p class="rijs mt-5 max-w-sm text-grijs" style="--d:.08s">Ramen open, insecten buiten. Plissé hordeuren in veel RAL-kleuren, passend bij uw kozijnen.</p>
            <ul class="rijs mt-8" style="--d:.12s">
              {horren.map(([t, href]) => <li><a href={href} class="regel">{t}<Icoon naam="pijl" /></a></li>)}
            </ul>
          </div>
        </div>
        <figure class="rijs lg:col-span-4 lg:col-start-9 lg:-mt-48" style="--d:.1s">
          <Image src={markiezen} alt="Twee grijze markiezen met donkere biezen aan een bakstenen gevel in Dordrecht" quality={70} widths={[480, 720, 960]} sizes="(min-width: 1024px) 30vw, 100vw" class="aspect-[4/3] w-full object-cover object-[50%_40%] sm:aspect-[3/4] shadow-[0_30px_60px_-30px_#1c1d2066]" />
          <figcaption class="mt-4 font-kop text-xl leading-snug">“Deze wijk in Dordrecht staat bij ons bekend als de ‘markiezenbuurt’.”</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. WERKWIJZE -->
    <section id="werkwijze" class="bg-grafiet py-16 text-wit md:py-24">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl">U kiest. Wij meten in, laten maken en monteren.</h2>
          <ol class="rijs mt-10 border-t border-lijn-donker" style="--d:.1s">
            {[
              ['Kiezen', 'In de showroom in Werkendam of bij u thuis.'],
              ['Inmeten', 'Wij komen langs en meten alles nauwkeurig op.'],
              ['Maken', 'Op maat gemaakt, precies voor uw raam.'],
              ['Monteren', 'Wij komen terug en plaatsen het.'],
            ].map(([t, z]) => (
              <li class="grid grid-cols-[1.25rem_1fr] items-baseline gap-x-3 border-b border-lijn-donker py-4 sm:grid-cols-[1.25rem_12.5rem_1fr] sm:gap-x-4">
                <Ruit class="h-3 w-auto" n={1} />
                <span class="font-kop text-2xl">{t}</span>
                <span class="col-start-2 text-mist sm:col-start-3">{z}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <figure class="rijs">
            <Image src={bus} alt="Witte bus met het ruitjeslogo van Terlouw Interieur & Montage voor een woning met markiezen in Dordrecht" quality={70} widths={[480, 720, 960]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[4/3] w-full object-cover object-[60%_50%]" />
          </figure>
          <blockquote class="rijs mt-10" style="--d:.1s">
            <p class="font-kop text-2xl leading-snug">“{reviews[0].tekst}”</p>
            <footer class="mt-4 text-sm text-mist">{reviews[0].naam}, Google review</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- 5. PROJECTEN -->
    <section id="projecten" class="py-16 md:py-24">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs text-4xl">Geplaatst in de buurt</h2>
          <a href="https://www.terlouwinterieur.nl/portfolio/" class="link text-sm font-medium">Alle projecten op terlouwinterieur.nl</a>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-x-3 gap-y-8 md:mt-16 md:grid-cols-12 md:gap-x-5 md:gap-y-12">
          {projecten.map((pr, i) => (
            <li class={`rijs ${['col-span-2 md:col-span-7', 'col-span-2 md:col-span-5', 'md:col-span-4', 'md:col-span-4', 'col-span-2 md:col-span-4'][i]}`} style={`--d:${(i % 3) * 0.06}s`}>
              <a href={pr.href} class="group block no-underline">
                <div class="overflow-hidden">
                  <Image src={pr.foto} alt={pr.alt} quality={68} widths={[400, 640, 960]} sizes={i < 2 ? '(min-width: 768px) 55vw, 100vw' : '(min-width: 768px) 32vw, 50vw'} class={`w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] ${i < 2 ? 'aspect-[3/2] md:aspect-[16/10]' : i === 4 ? 'aspect-[3/2] md:aspect-[4/3]' : 'aspect-[4/5] md:aspect-[4/3]'}`} style={`object-position:${pr.pos}`} />
                </div>
                <p class="mt-3 flex flex-wrap items-baseline gap-x-2"><span class="font-kop text-xl text-inkt md:text-2xl">{pr.titel}</span><span class="text-sm text-grijs">{pr.plaats}</span></p>
              </a>
            </li>
          ))}
        </ul>
        <p class="rijs mt-16 border-y border-lijn py-6 font-kop text-xl leading-relaxed text-grijs md:text-2xl">
          {plaatsen.map((pl, i) => <><span class="whitespace-nowrap">{pl}{i < plaatsen.length - 1 && <span class="mx-2 inline-block h-2 w-2 rotate-45 bg-zand align-middle" aria-hidden="true"></span>}</span>{' '}</>)}
        </p>
      </div>
    </section>

    <!-- 6. REVIEWS -->
    <section aria-labelledby="rev" class="bg-steen py-16 md:py-28">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <h2 id="rev" class="sr-only">Reviews</h2>
          <blockquote class="rijs">
            <p class="font-kop text-[clamp(1.6rem,2.3vw+.6rem,2.6rem)] leading-[1.18]">“{reviews[1].tekst}”</p>
            <footer class="mt-6 text-sm text-grijs">{reviews[1].naam}, Sliedrecht · Google review</footer>
          </blockquote>
        </div>
        <div class="space-y-8 lg:col-span-4 lg:col-start-9 lg:pt-3">
          {reviews.slice(2).map((r, i) => (
            <blockquote class="rijs border-t border-lijn-2 pt-5" style={`--d:${i * 0.08}s`}>
              <p>“{r.tekst}”</p>
              <footer class="mt-2 text-sm text-grijs">{r.naam}</footer>
            </blockquote>
          ))}
          <p class="flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews</p>
        </div>
      </div>
    </section>

    <!-- 7. AFSPRAAK (wow) + SHOWROOM -->
    <section id="afspraak" class="py-16 md:py-24">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <h2 class="rijs text-3xl">Advies aan huis, of kom naar de showroom.</h2>
          <form class="rijs mt-10 md:mt-14" data-afspraak style="--d:.08s" onsubmit="return false">
            <p class="font-kop text-[1.6rem] leading-[1.7] md:text-[2.1rem] md:leading-[1.65]">
              Ik wil graag{' '}<label class="sr-only" for="a-modus">Soort afspraak</label><select id="a-modus" class="kies" data-k="modus">
                <option value="advies aan huis">advies aan huis</option>
                <option value="een afspraak in de showroom in Werkendam">een showroomafspraak</option>
              </select>{' '}over{' '}<label class="sr-only" for="a-product">Product</label><select id="a-product" class="kies" data-k="product">
                {producten.map((pr) => <option value={pr}>{pr}</option>)}
              </select><span data-aantal-wrap>{' '}voor{' '}<label class="sr-only" for="a-aantal">Aantal</label><input id="a-aantal" class="vul vul-kort num" data-k="aantal" inputmode="numeric" maxlength="2" value="3" />{' '}<span data-eenheid>ramen</span></span>{' '}in{' '}<label class="sr-only" for="a-plaats">Plaats</label><input id="a-plaats" class="vul" data-k="plaats" value="Dordrecht" placeholder="plaats" autocomplete="address-level2" />.
            </p>
            <div class="mt-10 border-t border-lijn pt-6">
              <p class="text-sm text-grijs">Uw bericht:</p>
              <p class="mt-2 max-w-xl text-[.9375rem]" data-bericht aria-live="polite">{eersteBericht}</p>
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={waMet(eersteBericht)} class="knop knop-inkt" data-wa><Icoon naam="wa" />Verstuur via WhatsApp</a>
                <a href={mailMet('Afspraak', eersteBericht)} class="knop knop-rand" data-mail>Liever per mail</a>
              </div>
            </div>
          </form>
        </div>
        <aside class="rijs lg:col-span-4 lg:col-start-9" style="--d:.12s">
          <div class="border-t-2 border-inkt pt-6">
            <Ruit class="h-11 w-auto" open="#1c1d2080" />
            <p class="mt-6 font-kop text-2xl">Showroom Werkendam</p>
            <p class="mt-2">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <p class="mt-4 text-sm text-grijs">Plan uw bezoek even vooraf, via WhatsApp, mail of telefoon.</p>
            <a href={site.maps} class="link mt-5 inline-block text-sm font-medium">Route plannen</a>
          </div>
          <dl class="mt-10 space-y-4 border-t border-lijn pt-6 text-[.9375rem]">
            <div class="flex justify-between gap-4"><dt class="text-grijs">Telefoon</dt><dd><a href={site.telHref} class="link num">{site.tel}</a></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-grijs">WhatsApp</dt><dd><a href={site.wa} class="link num">{site.mobiel}</a></dd></div>
            <div class="flex justify-between gap-4"><dt class="text-grijs">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></dd></div>
          </dl>
        </aside>
      </div>
    </section>
  </main>
  <Voet />

  <script>
    import { site } from '../data/site';
    const f = document.querySelector<HTMLFormElement>('[data-afspraak]');
    if (f) {
      const v = (k: string) => (f.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-k="${k}"]`)?.value || '').trim();
      const wrap = f.querySelector<HTMLElement>('[data-aantal-wrap]');
      const eenheid = f.querySelector<HTMLElement>('[data-eenheid]');
      const uit = f.querySelector<HTMLElement>('[data-bericht]');
      const wa = f.querySelector<HTMLAnchorElement>('[data-wa]');
      const mail = f.querySelector<HTMLAnchorElement>('[data-mail]');
      const maak = () => {
        const product = v('product');
        const terras = /terrasschermen|uitvalschermen/.test(product);
        const deur = /hordeuren/.test(product);
        const n = Math.max(1, Math.min(99, parseInt(v('aantal'), 10) || 1));
        const ramen = deur ? (n === 1 ? 'deur' : 'deuren') : n === 1 ? 'raam' : 'ramen';
        if (eenheid) eenheid.textContent = ramen;
        if (wrap) wrap.hidden = terras;
        const voor = terras ? ' voor mijn terras of balkon' : ` voor ${n} ${ramen}`;
        const plaats = v('plaats');
        const tekst = `Hallo Terlouw, ik wil graag ${v('modus')} over ${product}${voor}${plaats ? ` in ${plaats}` : ''}. Wanneer komt het u uit?`;
        if (uit) uit.textContent = tekst;
        if (wa) wa.href = `${site.wa}?text=${encodeURIComponent(tekst)}`;
        if (mail) mail.href = `mailto:${site.mail}?subject=${encodeURIComponent('Afspraak')}&body=${encodeURIComponent(tekst)}`;
      };
      const meet = document.createElement('span');
      meet.setAttribute('aria-hidden', 'true');
      meet.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-999px;top:0';
      f.appendChild(meet);
      const pas = () => f.querySelectorAll<HTMLSelectElement>('select.kies').forEach((sel) => {
        meet.style.font = getComputedStyle(sel).font;
        meet.textContent = sel.options[sel.selectedIndex]?.text || '';
        sel.style.width = `calc(${Math.ceil(meet.getBoundingClientRect().width)}px + 1.15em)`;
      });
      const pasPlaats = () => { const i = f.querySelector<HTMLInputElement>('#a-plaats'); if (!i) return; meet.style.font = getComputedStyle(i).font; meet.textContent = i.value || i.placeholder || 'plaats'; i.style.width = `calc(${Math.ceil(meet.getBoundingClientRect().width)}px + .1em)`; };
      f.addEventListener('input', () => { maak(); pasPlaats(); }); f.addEventListener('change', () => { maak(); pas(); pasPlaats(); });
      document.fonts?.ready.then(pasPlaats); pasPlaats();
      document.fonts?.ready.then(pas); pas();
      maak();
    }
  </script>
</Base>
