---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['binnen', 'Binnen'], ['buiten', 'Buiten & horren'], ['werkwijze', 'Werkwijze'], ['projecten', 'Projecten'], ['afspraak', 'Showroom']];
---
<header class="relative z-40 bg-kalk">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6 md:h-24">
    <Merk />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-inkt/80 no-underline transition-colors duration-200 hover:text-zand-diep">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="num hidden text-[.9375rem] font-medium text-inkt no-underline transition-colors hover:text-zand-diep xl:block">{site.tel}</a>
      <a href={h('afspraak')} class="knop knop-inkt hidden min-h-11 px-5 md:inline-flex">Afspraak maken</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-inkt lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="absolute inset-x-0 top-full hidden border-t border-lijn bg-kalk shadow-[0_20px_30px_-20px_#1c1d2040] lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn py-4 font-kop text-2xl text-inkt no-underline">{t}</a></li>)}
      <li class="flex flex-wrap gap-x-6 gap-y-2 pt-6 text-sm"><a href={site.telHref} class="num link">{site.tel}</a><a href={waHoi} class="link">WhatsApp</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-lijn bg-kalk md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn text-[.9375rem] font-semibold text-inkt no-underline"><Icoon naam="tel" class="h-5 w-5 text-zand-diep" />Bellen</a>
  <a href={waHoi} class="flex min-h-14 items-center justify-center gap-2.5 bg-grafiet text-[.9375rem] font-semibold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5 text-zand" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
