---
import { site, url, waHoi, binnen, buiten, horren } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-grafiet text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Raamdecoratie, binnen- en buitenzonwering en horren. Op maat gemaakt, ingemeten en gemonteerd.</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Binnen</p>
      <ul class="mt-4 space-y-1.5">
        {binnen.slice(0, 6).map(([t, href]) => <li><a href={href} class="link link-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Buiten en horren</p>
      <ul class="mt-4 space-y-1.5">
        {[...buiten.slice(0, 4), ...horren.slice(0, 2)].map(([t, href]) => <li><a href={href} class="link link-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Showroom</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link link-licht">WhatsApp</a> · <a href={site.instagram} class="link link-licht">Instagram</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-donker py-7 text-xs">
    <p>© {jaar} {site.naam}. Terlouw Interieur is onderdeel van Berchum Zonwering BV.</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-zand">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten, assortiment en projectfoto’s van terlouwinterieur.nl en jullie Google-profiel; Folds-beeld zoals op jullie homepage. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
