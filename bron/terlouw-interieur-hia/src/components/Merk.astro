---
import { url } from '../data/site';
import Ruit from './Ruit.astro';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<a href={url('')} class={`flex items-center gap-3 no-underline ${licht ? 'text-wit' : 'text-inkt'}`}>
  <Ruit class="h-10 w-auto md:h-11" open={licht ? '#ffffffb3' : '#1c1d2080'} />
  <span class="flex flex-col leading-none">
    <span class="kapitaal text-[1.35rem] md:text-[1.55rem]">Terlouw</span>
    <span class={`mt-1 whitespace-nowrap text-[.56rem] font-semibold uppercase tracking-[.2em] sm:text-[.6rem] sm:tracking-[.26em] ${licht ? 'text-zand-licht' : 'text-zand-diep'}`}>Interieur &amp; montage</span>
  </span>
</a>
