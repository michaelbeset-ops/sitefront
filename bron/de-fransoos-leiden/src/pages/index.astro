---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi, waMet } from '../data/site';

import winkel from '../assets/winkel.jpg';
import ed from '../assets/ed.jpg';
import vitrine from '../assets/vitrine.jpg';
import blauw from '../assets/blauw.jpg';
import patapouf from '../assets/patapouf.jpg';
import broodje from '../assets/broodje.jpg';
import plank from '../assets/plank.jpg';
import pakket from '../assets/pakket.jpg';
import wijn from '../assets/wijn.jpg';
import logoWit from '../assets/logo-wit.png';

// Assortiment zoals hun eigen Facebook-intro het noemt. Noot alleen waar een eigen bron het zegt.
const toonbank = [
  ['Buitenlandse kazen', 'Frans, Zwitsers'],
  ['Hollandse kazen', "vers van 't mes"],
  ['Vleeswaren', ''],
  ['Noten & Belgische bonbons', ''],
  ['Wijnen', ''],
];

// Samenstellen: alleen wat ze echt doen (eigen site: kaasplankje; X: kerstpakketten; reviews: proeverij, pakketje).
const wat = [
  ['kaasplank', 'een kaasplank'],
  ['cadeaupakket', 'een cadeaupakket'],
  ['proeverij', 'een proeverij'],
];
const personen = ['2 personen', '4 personen', '6 personen', '8 personen', '10 of meer'];
const waarvoor = ['voor een borrel', 'voor een verjaardag', 'als bedankje', 'voor de feestdagen', 'zomaar'];

const titel = 'De Fransoos | Kaas & delicatessen, Doezastraat 6 Leiden';
const omschrijving = 'De Fransoos in Leiden: Franse, Zwitserse en Hollandse kazen, wijn, vleeswaren en belegde broodjes. Laat Ed een kaasplank of cadeaupakket samenstellen via WhatsApp.';
const r = reviews;
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: hun eigen winkel, schermvullend -->
    <section class="relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col justify-end overflow-hidden bg-aubergine text-wit md:min-h-[calc(100svh-5rem)]">
      <Image src={winkel} alt="De winkel van De Fransoos: stellingen van steigerbuis vol kaas, mosterd en koekjes, vooraan ronde houten tafels met grote stukken kaas" quality={50} widths={[480, 640, 828, 1080, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[38%_60%] md:object-[50%_78%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#21102e66_0%,#21102e40_22%,#21102eb3_48%,#21102ef2_72%,#21102e_100%)] lg:bg-[linear-gradient(90deg,#21102ef2_0%,#21102ed9_34%,#21102e80_55%,#21102e26_80%,#21102e14_100%),linear-gradient(0deg,#21102ecc_0%,#21102e00_45%)]" aria-hidden="true"></div>
      <div class="wrap flex items-end justify-between gap-10 pb-28 pt-24 md:pb-20 lg:pb-24">
        <div>
          <p class="text-sm text-lila">Kaas &amp; delicatessen, {site.straat} in {site.plaats}</p>
          <h1 class="mt-5 max-w-[12ch] text-hero">Een Franse <i>oase</i> midden in Leiden</h1>
          <p class="mt-7 max-w-md text-lg text-wit/90">Franse, Zwitserse en Hollandse kazen. Met wijn, brood en een ruime keuze belegde broodjes.</p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a href={waHoi} class="knop knop-licht"><Icoon naam="wa" />App Ed</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" />Bel de winkel</a>
          </div>
        </div>
        <div class="hidden flex-none flex-col items-center gap-4 text-center lg:flex">
          <span class="grid h-36 w-36 place-items-center rounded-full bg-violet shadow-sm ring-1 ring-wit/30 ring-offset-4 ring-offset-transparent"><img src={logoWit.src} width="203" height="240" alt="" class="h-20 w-auto" /></span>
          <p class="text-sm text-lila" data-status></p>
        </div>
      </div>
    </section>

    <!-- 2. ED: bienvenue, zijn eigen woorden, het etiket -->
    <section id="ed" class="py-20 md:py-32">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-6">
          <Image src={ed} alt="Ed Chavernac in zijn winkel met een doos Mont d'Or bij zijn wang en de medaille van de Guilde des Fromagers om zijn nek, achter hem planken vol kaas" quality={66} widths={[400, 640, 960]} sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/5] w-full object-cover object-[40%_30%]" />
          <figcaption class="mt-3 text-sm text-grijs">Ed Chavernac, met de medaille van de Guilde des Maîtres Fromagers.</figcaption>
        </figure>
        <div class="flex flex-col lg:col-span-6 lg:pt-6">
          <h2 class="rijs text-3xl text-violet"><i>Bienvenue</i> bij De Fransoos</h2>
          <blockquote class="rijs mt-8 font-kop text-[clamp(1.5rem,1.4vw+1rem,2.125rem)] leading-[1.25]">
            <p>“Ik deel graag mijn liefde voor mijn geboorteland Frankrijk met u.”</p>
            <footer class="mt-4 font-sans text-sm text-grijs">Ed Chavernac, eigenaar</footer>
          </blockquote>
          <div class="rijs etiket mt-12 max-w-lg">
            <p class="mb-3 border-b border-violet/30 pb-4 text-center font-kop text-2xl text-violet">Ed Chavernac</p>
            <dl>
            <div class="etiket-rij"><dt>Origine</dt><span class="stip" aria-hidden="true"></span><dd>Lot-en-Garonne</dd></div>
            <div class="etiket-rij"><dt>Métier</dt><span class="stip" aria-hidden="true"></span><dd>chef-kok</dd></div>
            <div class="etiket-rij"><dt>Depuis</dt><span class="stip" aria-hidden="true"></span><dd>september 2011</dd></div>
            <div class="etiket-rij"><dt>Guilde</dt><span class="stip" aria-hidden="true"></span><dd>Maîtres Fromagers, 2017</dd></div>
          </dl>
          </div>
          <blockquote class="rijs mt-12 max-w-lg border-l-2 border-violet pl-5">
            <p class="text-lg">“{r.monique.tekst}”</p>
            <footer class="mt-2 text-sm text-grijs">{r.monique.naam} op Google</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- 3. DE TOONBANK: wat er ligt, als prijskaartjes zonder prijs -->
    <section id="toonbank" class="border-t border-lijn bg-papier-2 py-20 md:py-32">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl text-violet">Vers van <i>'t mes</i></h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs">Franse, Zwitserse en Hollandse kazen. Met vers brood, olijven en wijnen erbij.</p>
          <ul class="rijs stiplijst mt-10">
            {toonbank.map(([naam, noot]) => (
              <li><span class="naam">{naam}</span>{noot && <><span class="stip" aria-hidden="true"></span><span class="noot">{noot}</span></>}</li>
            ))}
          </ul>
        </div>
        <div class="grid grid-cols-12 items-start gap-4 lg:col-span-7">
          <Image src={vitrine} alt="De koelvitrine van De Fransoos vol Franse kazen: camemberts, geitenkaasjes en stukken harde kaas" quality={66} widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" class="rijs col-span-12 aspect-[4/3] w-full object-cover" />
          <Image src={blauw} alt="Punten blauwe kaas opgestapeld op een schaal in de winkel" quality={66} widths={[320, 480, 720]} sizes="(min-width: 1024px) 24vw, 50vw" class="rijs col-span-6 aspect-[3/4] w-full object-cover" />
          <Image src={patapouf} alt="Twee flessen Le Patapouf, rood en wit, met druiven op de toonbank, achter de wijnkasten" quality={66} widths={[320, 480, 720]} sizes="(min-width: 1024px) 24vw, 50vw" class="rijs col-span-6 mt-14 aspect-[3/4] w-full object-cover" style="--d:.1s" />
        </div>
      </div>
    </section>

    <!-- 4. BROODJES -->
    <section id="broodjes" class="py-20 md:py-32">
      <div class="wrap grid items-start gap-y-12 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-7">
          <Image src={broodje} alt="Een belegd stokbrood met tapenade, mozzarella en rucola op een houten plank" quality={66} widths={[480, 720, 1065]} sizes="(min-width: 1024px) 55vw, 100vw" class="aspect-[5/4] w-full object-cover object-[50%_55%]" />
        </figure>
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl text-violet">Lekkere broodjes hebben we ook</h2>
          <p class="rijs mt-6 text-lg text-grijs">Voor de lunch: een ruime keuze in belegde broodjes.</p>
          <blockquote class="rijs mt-10">
            <p class="font-kop text-2xl italic leading-[1.3]">“{r.fleur.tekst}”</p>
            <footer class="mt-3 text-sm text-grijs">{r.fleur.naam} op Google</footer>
          </blockquote>
          <blockquote class="rijs mt-8">
            <p class="font-kop text-2xl italic leading-[1.3]">“{r.dave.tekst}”</p>
            <footer class="mt-3 text-sm text-grijs">{r.dave.naam} op Google</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- 5. PLANK OF PAKKET: één zin, eindigt in WhatsApp -->
    <section id="samenstellen" class="bg-aubergine pb-20 text-wit md:pb-28" aria-labelledby="sam-titel">
      <Image src={plank} alt="Een lange plank met Franse kazen opgestapeld als taart, met walnoten, vijgen, druiven en gedroogde ham eromheen" quality={72} widths={[800, 1600]} sizes="100vw" class="h-[16rem] w-full object-cover md:h-[24rem] lg:h-[28rem]" />
      <div class="wrap mt-14 grid gap-y-12 md:mt-20 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-8">
          <h2 id="sam-titel" class="rijs text-3xl">Plank of pakket? <i class="text-lila">Ed stelt het samen.</i></h2>
          <form class="rijs mt-10" data-sam>
            <p class="font-kop text-[clamp(1.75rem,2.6vw+.9rem,3.5rem)] leading-[1.3]">
              Ik zoek
              <label class="sr-only" for="s-wat">Wat</label>
              <select id="s-wat" class="kies" data-wat>
                {wat.map(([w, t]) => <option value={w}>{t}</option>)}
              </select>
              voor
              <label class="sr-only" for="s-pers">Aantal personen</label>
              <select id="s-pers" class="kies" data-pers>
                {personen.map((t, i) => <option value={t} selected={i === 1}>{t}</option>)}
              </select>,{' '}
              <label class="sr-only" for="s-voor">Gelegenheid</label>
              <select id="s-voor" class="kies" data-voor>
                {waarvoor.map((t) => <option value={t}>{t}</option>)}
              </select>.
            </p>
            <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-5">
              <a href={waMet('Bonjour Ed, ik zoek een kaasplank voor 4 personen, voor een borrel. Kun je iets voor me samenstellen?')} class="knop knop-licht" data-sam-wa><Icoon naam="wa" />Vraag het Ed via WhatsApp</a>
              <a href={site.telHref} class="link link-licht font-semibold">Of bel de winkel</a>
            </div>
            <p class="mt-6 max-w-lg text-sm text-lila">Je bericht opent in WhatsApp; je verstuurt het zelf.</p>
          </form>
        </div>
        <figure class="rijs lg:col-span-4">
          <Image src={pakket} alt="Een cadeaupakket in folie met een gouden strik, met Franse delicatessen in blik en pot" quality={66} widths={[320, 480, 720]} sizes="(min-width: 1024px) 28vw, 100vw" class="aspect-[4/5] w-full object-cover max-lg:max-h-[28rem]" />
          <figcaption class="mt-4 text-sm text-lila">“{r.jurgen.tekst}” <span class="whitespace-nowrap">{r.jurgen.naam} op Google</span></figcaption>
        </figure>
      </div>
    </section>

    <!-- 6. WAT KLANTEN ZEGGEN -->
    <section class="py-20 md:py-28" aria-labelledby="rev-titel">
      <div class="wrap">
        <h2 id="rev-titel" class="sr-only">Reviews op Google</h2>
        <div class="grid gap-x-14 gap-y-14 md:grid-cols-2">
          {[r.ton, r.birgit].map((x, i) => (
            <figure class="rijs" style={`--d:${i * 0.08}s`}>
              <blockquote class="font-kop text-[clamp(1.5rem,1.5vw+1rem,2.375rem)] leading-[1.22] text-violet">“{x.tekst}”</blockquote>
              <figcaption class="mt-5 flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{x.naam} op Google</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. BEZOEK -->
    <section id="bezoek" class="border-t border-lijn bg-papier-2 py-20 md:py-28">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl text-violet">{site.straat}</h2>
          <p class="rijs mt-4 text-lg text-grijs">{site.postcode} {site.plaats}</p>
          <dl class="rijs mt-10 max-w-md space-y-3 text-lg">
            <div class="flex flex-wrap justify-between gap-x-6 border-b border-lijn pb-3"><dt>Winkel</dt><dd><a href={site.telHref} class="link num">{site.tel}</a></dd></div>
            <div class="flex flex-wrap justify-between gap-x-6 border-b border-lijn pb-3"><dt>WhatsApp</dt><dd><a href={waHoi} class="link num">{site.mobiel}</a></dd></div>
            <div class="flex flex-wrap justify-between gap-x-6 border-b border-lijn pb-3"><dt>E-mail</dt><dd><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></dd></div>
          </dl>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={site.maps} class="knop"><Icoon naam="pin" />Route plannen</a>
            <a href={waHoi} class="knop knop-licht border border-lijn"><Icoon naam="wa" />App Ed</a>
          </div>
          <Image src={wijn} alt="Een rij flessen rosé en witte wijn op een plank in de winkel" quality={62} widths={[480, 720, 960]} sizes="(min-width: 1024px) 45vw, 100vw" class="rijs mt-14 aspect-[16/9] w-full object-cover" />
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rijs etiket">
            <h3 class="text-2xl text-violet"><i>Ouvert</i></h3>
            <p class="mt-2 text-sm font-semibold text-violet" data-status></p>
            <table class="mt-6 w-full text-base">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-dotted border-lijn last:border-0 data-[vandaag]:font-bold data-[vandaag]:text-violet">
                    <th scope="row" class="py-2.5 text-left font-[inherit]">{t.naam}</th>
                    <td class="num whitespace-nowrap py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-sam]');
  if (f) {
    const wat = f.querySelector<HTMLSelectElement>('[data-wat]')!;
    const pers = f.querySelector<HTMLSelectElement>('[data-pers]')!;
    const voor = f.querySelector<HTMLSelectElement>('[data-voor]')!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-sam-wa]')!;
    const basis = wa.href.split('?')[0];
    const zet = () => {
      const w = wat.selectedOptions[0]?.text || '';
      const p = pers.value === '10 of meer' ? '10 of meer personen' : pers.value;
      const vraag = wat.value === 'proeverij' ? 'Kan dat, en hoe gaat dat?' : 'Kun je iets voor me samenstellen?';
      const tekst = `Bonjour Ed, ik zoek ${w} voor ${p}, ${voor.value}. ${vraag}`;
      wa.href = `${basis}?text=${encodeURIComponent(tekst)}`;
    };
    // Elke keuzelijst zo breed als het gekozen woord, zodat de zin een zin blijft.
    const maat = document.createElement('span');
    maat.setAttribute('aria-hidden', 'true');
    maat.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0';
    f.appendChild(maat);
    const pas = () => f.querySelectorAll<HTMLSelectElement>('select').forEach((s) => {
      const cs = getComputedStyle(s);
      maat.style.font = cs.font; maat.style.letterSpacing = cs.letterSpacing;
      maat.textContent = s.selectedOptions[0]?.text || '';
      s.style.width = `calc(${maat.getBoundingClientRect().width}px + 1.2em)`;
    });
    f.addEventListener('change', () => { zet(); pas(); });
    document.fonts?.ready.then(pas); addEventListener('resize', pas); pas();
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
