---
import { url } from '../data/site';
import paars from '../assets/logo-paars.png';
import wit from '../assets/logo-wit.png';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<a href={url('')} class:list={['merk', licht && 'merk-licht']}>
  <img src={(licht ? wit : paars).src} width="203" height="240" alt="" />
  <span class="merk-tekst"><span class="merk-naam"><i>de</i>Fransoos</span><small>kaas &amp; delicatessen</small></span>
</a>
