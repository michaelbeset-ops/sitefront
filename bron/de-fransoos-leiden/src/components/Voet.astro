---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-aubergine text-lila">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk licht />
      <p class="mt-6 max-w-xs">Een Franse oase midden in Leiden. Kaas, wijn en delicatessen aan de Doezastraat.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3">Winkel <a href={site.telHref} class="link link-licht num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1">WhatsApp <a href={waHoi} class="link link-licht num whitespace-nowrap">{site.mobiel}</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <ul class="mt-3 space-y-1">
        <li class="flex justify-between gap-4"><span>ma - vr</span><span class="num whitespace-nowrap">{tijden[0].open} - {tijden[0].dicht}</span></li>
        <li class="flex justify-between gap-4"><span>za</span><span class="num whitespace-nowrap">{tijden[5].open} - {tijden[5].dicht}</span></li>
        <li class="flex justify-between gap-4"><span>zo</span><span>gesloten</span></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Volg ons</p>
      <p class="mt-3"><a href={site.facebook} class="link link-licht">Facebook</a></p>
      <p class="mt-1"><a href={site.maps} class="link link-licht">Google Maps</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.vol}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen website en Facebook. Ed's woorden van winkelenleiden.nl. Reviews letterlijk van Google (stand 7 oktober 2026). Openingstijden van Google.</p>}
</footer>
