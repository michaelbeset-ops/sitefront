---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, vraagMail } from '../data/site';

const uitvoering = [
  'Financiële administratie, op locatie of op kantoor',
  'Aangifte omzetbelasting',
  'Aangifte loonheffing en salarisadministratie',
  'Inkomsten- en vennootschapsbelasting',
  'Tussentijdse rapportages',
  'Jaarrekening en publicatiestukken',
];
const advies = [
  'Jaarrekeninganalyse',
  'Financiële en fiscale planning',
  'Investeringen en financiering',
  'Bedrijfsstructuur en rechtsvorm',
  'Ondernemingsplannen',
  'Verzekeringen en oudedagsvoorziening',
];
const meer = ['bedrijfsontwikkelingen', 'samenwerkings- of fusievraagstukken', 'managementinformatie', 'overheidsmaatregelen', 'personeelsbeleid'];
---
<Base title="Van Eekeres Administratie & Advies | Administratiekantoor in Nieuw-Vennep" description="Allround administratiekantoor voor zzp'ers, vof's en kleine bv's in Nieuw-Vennep. Wij behandelen uw financiën van begin tot eind: administratie, aangiften, jaarrekening en advies.">
  <Kop />
  <main id="inhoud">
    <!-- Eerste scherm: de kop en, als beeld, een T-rekening met wat ze uitvoeren en waarover ze adviseren. -->
    <section class="wrap pb-16 pt-10 md:pt-16 lg:pb-20 lg:pt-[4.5rem]" aria-labelledby="kop">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <h1 id="kop" class="text-[clamp(2.85rem,6.4vw,6rem)] lg:col-span-8">Uw financiën,<br class="max-md:hidden" /> van begin tot eind.</h1>
        <div class="lg:col-span-4 lg:pb-3">
          <p class="max-w-[26rem] text-[1.15rem] text-grafiet">Allround administratiekantoor voor zzp'ers, vof's en kleine bv's. Wij zeggen het helder en duidelijk.</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={site.telHref} class="knop">Bel <span class="tabular-nums">{site.tel}</span></a>
            <a href={vraagMail} class="lijn">Mail uw vraag</a>
          </div>
        </div>
      </div>

      <div class="mt-12 md:mt-16 lg:mt-[4.5rem]" role="group" aria-label="Wat wij doen: uitvoering en advies">
        <div class="t-rek">
          <div class="md:pr-10 lg:pr-14">
            <h2 class="flex items-baseline justify-between border-b-2 border-inkt pb-3 text-[clamp(1.6rem,2.2vw,2.1rem)]">Uitvoering <span class="font-sans text-sm tracking-normal text-grafiet">wij doen het</span></h2>
            <ul class="text-[1.05rem]">{uitvoering.map((u) => <li><span>{u}</span></li>)}</ul>
          </div>
          <div class="mt-10 md:mt-0 md:pl-10 lg:pl-14">
            <h2 class="flex items-baseline justify-between border-b-2 border-inkt pb-3 text-[clamp(1.6rem,2.2vw,2.1rem)]">Advies <span class="font-sans text-sm tracking-normal text-grafiet">wij denken mee</span></h2>
            <ul class="text-[1.05rem]">{advies.map((u) => <li><span>{u}</span></li>)}</ul>
          </div>
        </div>
        <p class="totaal mt-0 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 bg-oranje-licht px-4 py-3.5 md:px-5">
          <span class="serif text-[1.35rem]">Van begin tot eind</span>
          <span class="text-grafiet">thuis in elke branche</span>
        </p>
      </div>
    </section>

    <!-- Het platform: hun netwerk van specialisten, als één zin. -->
    <section class="border-t border-regel bg-wit" aria-labelledby="platform-kop">
      <div class="wrap grid gap-8 py-16 md:py-24 lg:grid-cols-12">
        <h2 id="platform-kop" class="text-[clamp(1.9rem,3vw,2.8rem)] lg:col-span-4">Eén aanspreekpunt, een heel netwerk.</h2>
        <div class="lg:col-span-7 lg:col-start-6">
          <p class="serif text-[clamp(1.4rem,2vw,1.9rem)] leading-[1.35]">Voor álle financiële vraagstukken werken wij nauw samen met accountants- en belastingkantoren, banken, pensioenadviseurs, advocaten, notarissen en verzekeraars.</p>
          <p class="mt-6 text-grafiet">Ook voor {meer.slice(0, -1).join(', ')} en {meer.at(-1)} kunt u bij ons terecht.</p>
        </div>
      </div>
    </section>

    <!-- Kantoor: hun eigen woorden over hoe ze werken. -->
    <section class="wrap grid gap-10 py-16 md:py-24 lg:grid-cols-12" aria-labelledby="kantoor-kop">
      <div class="lg:col-span-4">
        <h2 id="kantoor-kop" class="text-[clamp(1.9rem,3vw,2.8rem)]">Informeel kantoor, <span class="whitespace-nowrap">no-nonsense</span> werkwijze.</h2>
      </div>
      <ol class="serif text-[clamp(1.5rem,2.4vw,2.2rem)] leading-[1.25] lg:col-span-7 lg:col-start-6">
        <li class="border-b border-regel py-3">Korte lijnen</li>
        <li class="border-b border-regel py-3">Betrouwbaar</li>
        <li class="border-b border-regel py-3">Hard werken</li>
        <li class="border-b border-regel py-3">Goede prijsafspraken</li>
        <li class="py-3">Snel handelen</li>
      </ol>
    </section>

    <!-- Contact. -->
    <section id="contact" class="bg-inkt text-wit" aria-labelledby="contact-kop">
      <div class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 id="contact-kop" class="text-[clamp(2.3rem,4.4vw,4rem)]">Even kennismaken?</h2>
          <p class="mt-5 max-w-md text-[1.15rem] text-regel">Bel of mail, of kom langs aan de Lireweg. Er is ruim parkeergelegenheid bij ons kantoor.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={site.telHref} class="knop !bg-oranje !text-inkt hover:!bg-wit">Bel <span class="tabular-nums">{site.tel}</span></a>
            <a href={vraagMail} class="lijn">Mail uw vraag</a>
          </div>
        </div>
        <dl class="grid content-start gap-6 text-[1.1rem] lg:col-span-5 lg:col-start-8">
          <div class="border-t border-white/20 pt-4"><dt class="text-sm text-regel">Adres</dt><dd class="mt-1">{site.straat}<br />{site.postcode} {site.plaats}<br /><a href={site.maps} class="lijn">Route in Google Maps</a></dd></div>
          <div class="border-t border-white/20 pt-4"><dt class="text-sm text-regel">Telefoon</dt><dd class="mt-1"><a href={site.telHref} class="lijn tabular-nums">{site.tel}</a></dd></div>
          <div class="border-t border-white/20 pt-4"><dt class="text-sm text-regel">E-mail</dt><dd class="mt-1"><a href={vraagMail} class="lijn break-all">{site.mail}</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Voet />
</Base>
