---
import Logo from './Logo.astro';
import { site, url } from '../data/site';
---
<footer class="border-t border-white/15 bg-inkt text-regel">
  <div class="wrap flex flex-col gap-8 py-10 md:flex-row md:items-end md:justify-between">
    <span class="rounded-lg bg-wit px-3 py-2 text-[.95rem] text-inkt"><Logo /></span>
    <p class="text-sm md:text-right">Facebook: 5,0 uit 6 beoordelingen · KvK [[AANLEVEREN: KvK-nummer]] · <a href={url('privacy/')} class="lijn">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap border-t border-white/15 pb-8 pt-6 text-sm">Teksten uit uw eigen eerdere website en uw bedrijfsprofielen. Geen foto's gebruikt.</p>}
</footer>
