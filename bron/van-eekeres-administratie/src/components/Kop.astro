---
import Logo from './Logo.astro';
import { site, url } from '../data/site';
---
<header class="border-b border-regel">
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-4 md:h-[5.25rem]">
    <a href={url('')} class="text-[.92rem] no-underline md:text-[1.05rem]" aria-label={`${site.naam}, naar de homepage`}><Logo /></a>
    <nav aria-label="Hoofdmenu" class="flex items-center gap-8 md:gap-10">
      <a href={url('#contact')} class="hidden no-underline transition-colors hover:text-grafiet md:inline">Contact</a>
      <a href={site.telHref} class="inline-flex items-center gap-2 rounded-lg border border-inkt px-3 py-2 text-[.95rem] no-underline transition-colors hover:bg-inkt hover:text-wit md:px-4">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
        <span class="tabular-nums max-[379px]:sr-only">{site.tel}</span><span class="sr-only"> bellen</span>
      </a>
    </nav>
  </div>
</header>
