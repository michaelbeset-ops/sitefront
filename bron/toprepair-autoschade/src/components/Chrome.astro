---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 bg-ink text-white">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-2xl font-black tracking-[-0.03em] no-underline [font-stretch:80%]">TOP<span class="text-orange">repair</span></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href="#zo-werkt-het" class="no-underline hover:text-orange">Zo werkt het</a></li>
          <li><a href="#service" class="no-underline hover:text-orange">Service</a></li>
          <li><a href="#contact" class="no-underline hover:text-orange">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-orange !px-4 !py-2 text-sm">Schade melden</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-white/75">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right">Aangesloten bij FOCWA<br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
  </footer>
)}
