---
import Foto from '../components/Foto.astro';
import hero from '../assets/hero.jpg';
import schade from '../assets/schade.jpg';
import poetsen from '../assets/poetsen.jpg';
import cabine from '../assets/cabine.jpg';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site } from '../data/site';
const tijden = [['Maandag t/m donderdag', '07.45 tot 16.30'], ['Vrijdag', '07.45 tot 15.00'], ['Zaterdag en zondag', 'Gesloten']];
const stappen = [
  ['Bel of mail je schade', 'Je vertelt wat er is gebeurd. Kun je niet rijden, dan halen we je auto op met onze oprijwagen.'],
  ['Wij regelen het papierwerk', 'We helpen je met het schadeformulier en adviseren over de afhandeling met je lease- of verzekeringsmaatschappij.'],
  ['Je rijdt gewoon door', 'In bijna alle gevallen staat er meteen passend vervangend vervoer voor je klaar, voor geel én grijs kenteken.'],
  ['Hersteld volgens de norm', 'Als FOCWA-bedrijf herstellen we je auto zo dat hij weer precies aan alle specificaties en veiligheidsnormen voldoet. Daarna brengen we hem desgewenst terug.'],
];
---
<Base
  title="TopRepair Autoschade | Autoschadeherstel in Ridderkerk, FOCWA"
  description="Autoschade laten herstellen in Ridderkerk en de regio Rotterdam. FOCWA-aangesloten, vervangend vervoer voor geel en grijs kenteken, hulp bij je schadeformulier, en ophalen met de oprijwagen."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="relative overflow-hidden bg-ink pb-16 pt-12 text-white lg:pb-28 lg:pt-24">
      <div class="absolute inset-0 lg:left-1/3"><Foto src={hero} alt="Schadehersteller werkt aan de flank van een rode auto" hero sizes="100vw" class="opacity-40 lg:opacity-75" /></div>
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/15"></div>
      <div class="wrap relative grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="font-semibold text-orange">Ridderkerk, vlak bij A15, A16, A20 en A12</p>
          <h1 class="mt-4 text-4xl">Schade aan je auto? Wij nemen de zorgen uit handen.</h1>
          <p class="mt-6 max-w-xl text-lg text-white/80">
            TopRepair herstelt autoschade snel en vakkundig, voor particulieren en zakelijke rijders in de hele regio Rotterdam.
            Met vervangend vervoer, hulp bij de verzekering, en FOCWA-kwaliteit.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-orange">Bel {site.tel}</a>
            <a href={`mailto:${site.mail}`} class="btn btn-line">Mail je schade</a>
          </div>
          <p class="mt-8 text-sm text-white/65"><span class="font-bold text-white">4,9</span> op Google, uit 15 reviews</p>
        </div>
        <aside aria-labelledby="open" class="self-end border-t-4 border-orange bg-ink/85 p-6 backdrop-blur-sm lg:col-span-4 lg:col-start-9">
          <h2 id="open" class="text-2xl">Openingstijden</h2>
          <dl class="mt-4 space-y-2">
            {tijden.map(([d, t]) => <div class="flex justify-between gap-4 border-b border-white/10 pb-2"><dt>{d}</dt><dd class={`whitespace-nowrap tabular-nums ${t === 'Gesloten' ? 'text-white/55' : ''}`}>{t}</dd></div>)}
          </dl>
        </aside>
      </div>
    </section>

    <section id="zo-werkt-het" class="wrap scroll-mt-20 py-16 lg:py-24">
      <h2 class="max-w-2xl text-3xl">Van schade tot weer op de weg</h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-2">
        {stappen.map(([t, b], i) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-4">
            <span class="font-display text-[3rem] font-black leading-none text-orange-deep [font-stretch:80%]">{i + 1}</span>
            <div><h3 class="text-xl">{t}</h3><p class="mt-2 text-ink-soft">{b}</p></div>
          </li>
        ))}
      </ol>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        <div class="aspect-[16/10] overflow-hidden"><Foto src={schade} alt="Auto met schade aan de zijkant op een oprijwagen" sizes="(min-width: 768px) 560px, 100vw" /></div>
        <div class="aspect-[16/10] overflow-hidden"><Foto src={poetsen} alt="Vakman poetst de lak van een gerepareerde auto" sizes="(min-width: 768px) 560px, 100vw" /></div>
      </div>
    </section>

    <section id="service" class="scroll-mt-20 bg-steel py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="aspect-[4/3] lg:col-span-5 overflow-hidden"><Foto src={cabine} alt="Auto in een verlichte spuitcabine" sizes="(min-width: 1024px) 460px, 100vw" /></div>
        <div class="self-center lg:col-span-6 lg:col-start-7">
          <h2 class="text-3xl">Service die verder gaat dan de reparatie</h2>
          <p class="mt-5 text-lg">Een schade is al vervelend genoeg. Daarom regelen we meer dan alleen het herstel: vervangend vervoer, het ophalen en terugbrengen van je auto, en de administratie met je verzekeraar of leasemaatschappij.</p>
          <p class="mt-4 text-ink-soft">[[AANLEVEREN: met welke verzekeraars en leasemaatschappijen jullie samenwerken]]</p>
        </div>
      </div>
    </section>

    <section id="contact" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Centraal in de Randstad</h2>
        <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
        <a href={site.maps} rel="noopener" class="btn btn-ink mt-6">Route plannen</a>
      </div>
      <div class="grid content-start gap-6 lg:col-span-6 lg:col-start-7">
      <dl class="grid gap-4 text-lg">
        <div><dt class="text-sm text-ink-soft">Telefoon</dt><dd><a href={site.telHref} class="font-display text-3xl font-black underline decoration-orange decoration-[3px] underline-offset-4 [font-stretch:80%]">{site.tel}</a></dd></div>
        <div><dt class="text-sm text-ink-soft">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="underline decoration-orange decoration-[3px] underline-offset-4">{site.mail}</a></dd></div>
      </dl>
      {site.voorstel && <p class="rounded-sm bg-steel p-4 text-sm">Dit is een ontwerpvoorstel. In de echte site komt hier een formulier waarmee je je schade meldt, met foto's.</p>}
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
