---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import { site, url, tijden } from '../data/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const rooster = JSON.stringify(tijden.map((t) => [t.dag, t.van, t.tot, t.open, t.dicht]));
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={fontUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-[4.5rem] md:pb-0" data-rooster={rooster}>
    {site.voorstel && (
      <div class="relative z-50 bg-inkt text-wit">
        <p class="wrap py-2 text-xs leading-snug" style="font-family: system-ui, sans-serif">
          Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website.{" "}
          <a href="https://www.sitefront.nl" class="font-bold underline underline-offset-2">sitefront.nl</a>
        </p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-wit focus:px-4 focus:py-2">Naar de inhoud</a>
    <slot />
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.rijs').forEach((el) => io.observe(el));

      // Openingstijden: vandaag markeren en live open/dicht tonen (Nederlandse tijd).
      const rooster: [number, number, number, string, string][] = JSON.parse(document.body.dataset.rooster || '[]');
      const nu = new Date();
      const deel = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', ...o }).format(nu);
      const dag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(deel({ weekday: 'short' }));
      const min = Number(deel({ hour: '2-digit', hourCycle: 'h23' })) * 60 + Number(deel({ minute: '2-digit' }));
      const namen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
      const r = (d: number) => rooster.find((x) => x[0] === d)!;
      const vandaag = r(dag);
      const open = !!vandaag && vandaag[2] > 0 && min >= vandaag[1] && min < vandaag[2];
      const uur = (s: string) => s.replace(/^0/, '');
      let tekst: string;
      if (open) tekst = `Nu open, tot ${uur(vandaag[4])} uur`;
      else if (vandaag && vandaag[2] > 0 && min < vandaag[1]) tekst = `Gesloten, vandaag open vanaf ${uur(vandaag[3])} uur`;
      else {
        let m = (dag + 1) % 7;
        while (r(m)[2] === 0) m = (m + 1) % 7;
        tekst = `Gesloten, ${m === (dag + 1) % 7 ? 'morgen' : namen[m]} open vanaf ${uur(r(m)[3])} uur`;
      }
      document.querySelectorAll<HTMLElement>('[data-status]').forEach((el) => { el.textContent = tekst; el.closest('[data-status-wrap]')?.setAttribute('data-open', String(open)); });
      document.querySelectorAll(`[data-dag="${dag}"]`).forEach((el) => el.setAttribute('data-vandaag', ''));
    </script>
  </body>
</html>
