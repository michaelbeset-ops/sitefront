  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hoi Denise, ik wil graag een afspraak maken.'];
      if (v('beh')) r.push('Voor: ' + v('beh'));
      const hond = [v('hond'), v('ras') && `(${v('ras')})`].filter(Boolean).join(' ');
      if (hond) r.push('Mijn hond: ' + hond);
      if (v('dag')) r.push('Het liefst op: ' + v('dag').toLowerCase());
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31611762482?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

