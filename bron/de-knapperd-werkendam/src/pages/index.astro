            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="tab-klein grid h-12 w-12 place-items-center bg-lila text-pruim"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block">Bellen</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-magenta" /></a></li>
            <li><a href={site.vastHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="tab-klein grid h-12 w-12 place-items-center bg-lila text-pruim"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block">Vast nummer</b><span class="num text-grijs">{site.vast}</span></span><Icoon naam="pijl" class="h-5 w-5 text-magenta" /></a></li>
