---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waAfspraak, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import trim from '../assets/trim.jpg';
import bad from '../assets/bad.jpg';
import borstel from '../assets/borstel.jpg';
import poten from '../assets/poten.jpg';
import advies from '../assets/advies.jpg';
import kleding from '../assets/kleding.jpg';
import maltezer from '../assets/maltezer.jpg';
import denise from '../assets/denise.png';
import donna from '../assets/donna.png';
import salon from '../assets/salon.jpg';
import fohnen from '../assets/fohnen.jpg';
import kledingrek from '../assets/kledingrek.jpg';
import maltezers from '../assets/maltezers.jpg';

const behandelingen = [
  { t: 'Volledige trimbeurt', d: 'Wassen, knippen, plukken of ontwollen: wat de vacht van uw hond nodig heeft.', src: trim, alt: 'Een ruwharig hondje met een blije snuit wordt geborsteld', pos: '50% 40%', bericht: 'een volledige trimbeurt' },
  { t: 'Een goed bad', d: 'Wassen en föhnen, ook los van een trimbeurt.', src: bad, alt: 'Een natte golden retriever in een betegeld bad', pos: '50% 45%', bericht: 'een wasbeurt' },
  { t: 'Borstelbeurt', d: 'Een professionele borstelbeurt. In de ruiperiode scheelt dat flink in het stofzuigen.', src: borstel, alt: 'Een wit pomeriaantje wordt op schoot geborsteld', pos: '35% 60%', bericht: 'een borstelbeurt' },
  { t: 'Oren en nagels', d: 'Vieze oren worden schoongemaakt en de nagels geknipt als het nodig is.', src: poten, alt: 'Close-up van de voorpoten en nagels van een zwart-bruine hond', pos: '50% 70%', bericht: 'oren en nagels' },
  { t: 'Vachtadvies', d: 'Elke vacht is anders. Denise geeft graag advies over verzorging en de juiste borstel.', src: advies, alt: 'Een hand die over een dikke bruine hondenvacht strijkt', pos: '50% 50%', bericht: 'advies over de vacht van mijn hond' },
  { t: 'Kleding en verzorging', d: 'In de salon kunt u ook terecht voor hondenkleding, verzorgingsproducten en borstels.', src: kleding, alt: 'Een klein hondje in een rood truitje met witte rand', pos: '50% 45%', bericht: 'hondenkleding en verzorgingsproducten' },
];

const stappen = [
  ['Afspraak maken', 'Stuur een appje of bel. Laat weten welk ras uw hond is en wat er moet gebeuren.'],
  ['Vacht bekijken', 'Samen kijken we wat de vacht nodig heeft. Neem gerust uw eigen borstel mee.'],
  ['Trimmen in rust', 'Wassen, knippen of plukken, föhnen en kammen. Met tijd en aandacht.'],
  ['Weer een knapperd', 'Mee naar huis, met tips om de vacht thuis goed bij te houden.'],
];

const tips = [
  ['Borstel één keer per week', 'Van onder tot boven, met een borstel die door de hele vacht gaat en niet alleen over de bovenlaag.'],
  ['Kam na op klitten', 'Klitten zitten vaak in de ondervacht. U ziet ze niet, maar uw hond voelt ze bij elke stap.'],
  ['Begin jong', 'Aai en borstel uw pup van neus tot staart. Start met vijf minuten na het wandelen, als hij lekker moe is.'],
  ['Niet kaal in de zomer', 'Een vacht beschermt juist tegen zon en warmte. Bij sommige rassen groeit het haar zelfs niet goed terug.'],
  ['Ook in de winter trimmen', 'Wel iets minder kort dan in de zomer. Vocht is voor honden een grotere bedreiging dan kou.'],
];

const kijkje = [
  { src: salon, alt: 'De trimsalon: een koffer met scharen en kammen, een gele föhn aan de muur en een blauw hondenbad', t: 'De trimtafel, de föhn en het bad' },
  { src: fohnen, alt: 'Denise föhnt een wit hondje met krullen op de trimtafel', t: 'Föhnen, rustig aan' },
  { src: kledingrek, alt: 'Hondenjasjes en een gebreid truitje aan een rekje in de salon', t: 'Hondenjasjes in de salon' },
  { src: maltezers, alt: 'Twee witte hondjes met hun koppies in de sneeuw', t: 'Maxi en Thirza in de sneeuw' },
];

const [uitgelicht, ...overig] = reviews;
---
<Base title={`${site.naam} | Hondentrimsalon in Werkendam`} description="De hondentrimsalon van Denise in Werkendam. Volledige trimbeurt, wasbeurt, borstelbeurt, oren en nagels. 4,9 op Google. Afspraak via WhatsApp of telefoon.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: een echte knapperd uit hun eigen fotogalerij -->
    <section class="donker relative isolate overflow-hidden bg-pruim text-licht" aria-labelledby="t-hero">
      <div class="absolute inset-0 -z-20 lg:left-[48%]">
        <Image src={hero} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 52vw, 100vw" loading="eager" fetchpriority="high" quality={70} class="h-full w-full object-cover object-[50%_28%]" />
      </div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#66006600_0%,#66006600_30%,#660066d9_56%,#660066_74%)] lg:bg-[linear-gradient(90deg,#660066_0%,#660066_48%,#66006600_56%)]" aria-hidden="true"></div>
      <div class="wrap flex min-h-[calc(100svh-7.75rem)] flex-col justify-end pb-12 pt-[40svh] lg:min-h-[min(calc(100svh-7.75rem),56rem)] lg:justify-center lg:py-24">
        <div class="max-w-[38rem]">
          <p class="label">Hondentrimsalon in Werkendam</p>
          <h1 id="t-hero" class="mt-6 text-hero">Elke hond is een <span class="text-roze">knapperd.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">De trimsalon van Denise. Trimmen, wassen en borstelen, met tijd, aandacht en liefde voor het vak.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-wit text-pruim"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#behandelingen" class="knop knop-rand op-foto">Bekijk de behandelingen</a>
          </div>
          <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2.5 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma, di, do en vr open</span></li>
            <li class="hidden items-center gap-2 sm:flex"><Icoon naam="tel" class="h-4 w-4 text-roze" /><a href={site.telHref} class="num font-semibold text-licht no-underline hover:text-roze">{site.tel}</a></li>
          </ul>
        </div>
      </div>
      <p class="absolute right-4 top-4 hidden rounded-md bg-inkt/55 px-3 py-1.5 text-xs text-licht backdrop-blur-sm lg:block">Een knapperd uit de fotogalerij van De Knapperd</p>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Wat er in een trimbeurt kan">
      <div class="wrap flex items-center gap-x-2.5 gap-y-2.5 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#behandelingen" class="tab-klein shrink-0 bg-lila px-4 pb-2 pt-1.5 text-sm font-medium no-underline transition-colors hover:bg-pruim hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Behandelingen -->
    <section id="behandelingen" class="py-20 lg:py-24" aria-labelledby="t-beh">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <h2 id="t-beh" class="text-3xl">Van een goed bad tot een complete trimbeurt.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Trimmen is meer dan knippen: ook uitdunnen, plukken, ontwollen, wassen, kammen en borstelen. Klik op een behandeling om een afspraak te vragen.</p>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-12 lg:grid-cols-3 lg:gap-6">
          {behandelingen.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={waMet(`Hoi Denise, ik wil graag een afspraak maken voor ${b.bericht}.`)} class="kaart beh group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1248px) 380px, (min-width: 1024px) 31vw, 46vw" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[3/2]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-4 sm:p-6">
                  <div class="min-w-0 self-start">
                    <h3 class="text-[1.0625rem] sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 hyphens-auto text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="tab-klein hidden h-11 w-11 shrink-0 place-items-center bg-lila text-pruim transition-colors group-hover:bg-magenta group-hover:text-wit sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-grijs">Score op Google</dt><dd class="cijfer order-first text-magenta">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Reviews, allemaal 4 of 5 sterren</dt><dd class="cijfer order-first">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Eigen trimsalon sinds</dt><dd class="cijfer order-first">{site.sinds}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Dagen per week open</dt><dd class="cijfer order-first">4</dd></div>
      </dl>
    </section>

    <!-- 5. Over Denise -->
    <section id="denise" class="donker bg-pruim text-licht" aria-labelledby="t-denise">
      <div class="wrap grid items-end gap-12 pt-20 lg:grid-cols-12 lg:gap-10 lg:pt-24">
        <div class="relative mx-auto w-full max-w-[22rem] lg:col-span-5 lg:mx-0 lg:max-w-none">
          <div class="relative mx-auto w-[86%] max-w-[24rem] lg:ml-0">
            <div class="absolute inset-x-0 bottom-0 top-[14%] bg-magenta" style="border-radius:.5rem .5rem 2.5rem 2.5rem" aria-hidden="true"></div>
            <Image src={denise} alt="Denise met twee witte hondjes op schoot" widths={[384]} sizes="(min-width: 1024px) 384px, 80vw" class="relative w-full" />
          </div>
        </div>
        <div class="pb-20 lg:col-span-7 lg:pb-24 lg:pl-6">
          <p class="label label-licht">Over Denise</p>
          <h2 id="t-denise" class="mt-5 text-3xl">Het welbevinden van de hond staat voorop.</h2>
          <p class="mt-6 max-w-2xl text-lg text-licht/85">Mijn naam is Denise. Sinds februari 2012 heb ik mijn eigen trimsalon in Werkendam. Bij het trimmen ligt de nadruk op het welbevinden van de hond. Kernwoorden zijn tijd, aandacht en liefde voor het vak.</p>
          <ul class="mt-9 grid gap-3 sm:grid-cols-3">
            <li class="kader grid grid-cols-[1.5rem_1fr] gap-x-4 sm:block">
              <Icoon naam="hart" class="h-6 w-6 text-roze" />
              <h3 class="text-lg sm:mt-4">Lief voor honden</h3>
              <p class="col-start-2 mt-1 text-[.9375rem] text-licht-zacht sm:mt-1.5">Dat schrijven klanten keer op keer in hun reviews.</p>
            </li>
            <li class="kader grid grid-cols-[1.5rem_1fr] gap-x-4 sm:block">
              <Icoon naam="duim" class="h-6 w-6 text-roze" />
              <h3 class="text-lg sm:mt-4">Positief benaderen</h3>
              <p class="col-start-2 mt-1 text-[.9375rem] text-licht-zacht sm:mt-1.5">Net als bij kinderen loont een positieve aanpak het meest.</p>
            </li>
            <li class="kader grid grid-cols-[1.5rem_1fr] gap-x-4 sm:block">
              <Icoon naam="oog" class="h-6 w-6 text-roze" />
              <h3 class="text-lg sm:mt-4">Oog voor de hele hond</h3>
              <p class="col-start-2 mt-1 text-[.9375rem] text-licht-zacht sm:mt-1.5">Wie de hond van top tot teen trimt, ziet ook bultjes of plekjes.</p>
            </li>
          </ul>
          <a href={waAfspraak} class="knop knop-wit mt-9 text-pruim"><Icoon naam="wa" />Plan een afspraak</a>
        </div>
      </div>
    </section>

    <!-- 6. Kijkje in de salon: hun eigen foto's -->
    <section class="bg-lila py-16 lg:py-20" aria-labelledby="t-kijkje">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="t-kijkje" class="text-2xl">Een kijkje in de salon.</h2>
          <p class="text-grijs">Aan de Aalscholverstraat in Werkendam.</p>
        </div>
        <ul class="mt-8 grid gap-4 md:grid-cols-2 md:gap-5">
          {kijkje.map((k, i) => (
            <li class="rijs" style={`--d:${(i % 2) * 0.06}s`}>
              <figure>
                <Image src={k.src} alt={k.alt} widths={[673]} sizes="(min-width: 768px) 600px, 92vw" class="tab aspect-[673/158] w-full object-cover shadow-sm" />
                <figcaption class="mt-2.5 text-sm text-grijs">{k.t}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Werkwijze -->
    <section class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <h2 id="t-stappen" class="text-3xl">Zo gaat een trimbeurt.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Geen haast. Veel honden vinden vachtverzorging spannend, dus dat krijgt de tijd.</p>
        </div>
        <ol class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-12 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart stap p-5 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="tab-klein inline-grid h-10 w-10 place-items-center bg-pruim font-kop text-[.9375rem] font-bold text-wit num">0{i + 1}</p>
              <h3 class="mt-6 text-[1.0625rem] hyphens-auto sm:mt-8 sm:text-xl">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8. Tips voor thuis: Denise's eigen adviezen van deknapperd.nl -->
    <section id="tips" class="bg-wit py-20 lg:py-24" aria-labelledby="t-tips">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <h2 id="t-tips" class="text-3xl">Tips van Denise voor thuis.</h2>
            <p class="mt-5 text-lg text-grijs">Alle honden hebben vachtverzorging nodig, ook de kortharige. Veel kunt u zelf doen.</p>
            <Image src={maltezer} alt="Een wit hondje met een lange vacht ligt in het gras" widths={[480, 720, 960]} sizes="(min-width: 1024px) 420px, 92vw" class="tab mt-9 aspect-[4/3] w-full object-cover" style="object-position:40% 55%" />
          </div>
        </div>
        <div class="lg:col-span-7">
          <ul class="divide-y divide-lijn border-y border-lijn">
            {tips.map(([t, d], i) => (
              <li class="rijs grid grid-cols-[2.75rem_1fr] gap-4 py-6 sm:grid-cols-[3.5rem_1fr] sm:gap-6" style={`--d:${i * 0.04}s`}>
                <span class="tab-klein grid h-11 w-11 place-items-center bg-lila text-pruim sm:h-14 sm:w-14"><Icoon naam={i === 1 ? 'kam' : i === 2 ? 'hart' : 'vink'} class="h-5 w-5 sm:h-6 sm:w-6" /></span>
                <div>
                  <h3 class="text-xl">{t}</h3>
                  <p class="mt-1.5 text-grijs">{d}</p>
                </div>
              </li>
            ))}
          </ul>
          <div class="tab mt-8 flex flex-col items-start justify-between gap-5 bg-lila px-6 py-6 sm:flex-row sm:items-center md:px-8">
            <p class="text-lg"><b>Komt u zelf niet meer door de klitten?</b> <span class="text-grijs">Bel dan zo snel mogelijk, zodat de vacht misschien nog te redden is.</span></p>
            <a href={site.telHref} class="knop knop-pruim knop-klein shrink-0"><Icoon naam="tel" />Bel Denise</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Reviews -->
    <section id="reviews" class="bg-lila py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <h2 id="t-reviews" class="rijs text-3xl">Wat klanten zeggen.</h2>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-bold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <div class="mt-12 grid gap-4 lg:mt-14 lg:grid-cols-12 lg:gap-5">
          <figure class="rijs donker flex flex-col justify-between bg-pruim p-7 text-licht sm:p-10 lg:col-span-5" style="border-radius:.5rem .5rem 2.5rem 2.5rem">
            <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span>
            <blockquote class="mt-8 font-kop text-[clamp(2rem,2.4vw+1.2rem,3.25rem)] font-semibold leading-[1.08] tracking-[-0.03em]">“{uitgelicht.tekst}”</blockquote>
            <figcaption class="mt-10 flex items-center gap-3 border-t border-lijn-licht pt-5 text-sm">
              <span class="tab-klein grid h-10 w-10 place-items-center bg-magenta font-kop font-bold text-wit" aria-hidden="true">{uitgelicht.naam[0]}</span>
              <span class="flex-1 leading-snug"><b class="block">{uitgelicht.naam}</b><span class="text-licht-zacht">Google review, {uitgelicht.wanneer}</span></span>
            </figcaption>
          </figure>
          <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:gap-5">
            {overig.map((r, i) => (
              <li class="rijs kaart flex flex-col p-6 md:p-7" style={`--d:${(i % 2) * 0.06}s`}>
                <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
                <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
                <div class="mt-6 flex items-center gap-3 border-t border-lijn pt-5">
                  <span class="tab-klein grid h-10 w-10 place-items-center bg-lila font-kop font-bold text-pruim" aria-hidden="true">{r.naam[0]}</span>
                  <span class="flex-1 text-sm leading-snug"><b class="block">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                  <Icoon naam="g" class="h-5 w-5" />
                </div>
              </li>
            ))}
          </ul>
        </div>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <!-- 10. Openingstijden en locatie -->
    <section id="route" class="py-20 lg:py-24" aria-labelledby="t-route">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <h2 id="t-route" class="text-3xl">Openingstijden en adres.</h2>
          <p class="mt-5 text-lg text-grijs">Woensdag en in het weekend is de salon dicht.</p>
          <div class="kaart mt-10 p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Openingstijden</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma, di, do en vr open</span></p>
            </div>
            <table class="mt-4 w-full">
              <caption class="sr-only">Openingstijden van de salon</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-pruim">
                    <th scope="row" class="py-2.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="lg:col-span-7">
          <div class="donker relative isolate flex h-full min-h-[24rem] flex-col justify-between gap-10 overflow-hidden bg-pruim p-6 text-licht sm:p-10" style="border-radius:.5rem .5rem 2.5rem 2.5rem">
