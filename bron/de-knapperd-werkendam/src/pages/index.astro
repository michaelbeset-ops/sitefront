                  return <li class={`dagtab ${t.open ? 'bg-magenta text-wit' : 'text-licht-zacht ring-1 ring-inset ring-lijn-licht'}`} data-dag={t.dag} aria-hidden="true"><b>{d}</b><span>{t.open ? `${t.open.replace(/^0/, '').replace('.00', '')}-${t.dicht.replace('.00', '')}` : 'dicht'}</span></li>;
                })}
              </ul>
            </div>
            <Image src={donna} alt="Donna, een golden retriever, kijkt omhoog" widths={[441]} sizes="(min-width: 1024px) 400px, 60vw" class="pointer-events-none absolute bottom-0 right-0 -z-10 hidden w-[44%] max-w-[22rem] sm:block" />
            <div class="sm:max-w-[56%]">
              <p class="label">Zo vindt u ons</p>
