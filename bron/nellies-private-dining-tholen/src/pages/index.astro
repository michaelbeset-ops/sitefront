---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi } from '../data/site';

import kalfswang from '../assets/kalfswang.jpg';
import huisOud from '../assets/huis-oud.jpg';
import pass from '../assets/pass.jpg';
import sliptong from '../assets/sliptong.jpg';
import tongschar from '../assets/tongschar.jpg';

// Hun laatste gangen voor de zomerbreak, uit de Instagrampost van 29 mei 2026.
const menu = [
  ['Amuse', 'Paddenstoelen ragú', 'zoetzure beukenzwam'],
  ['Voorgerecht', 'Escabèche', 'met sliptong'],
  ['Tussengerecht', 'Zeebaars', 'venkel, geroosterde druiven'],
  ['Soep', 'Bloemkool', 'getoaste brioche met emmentaler, ingelegde bloemkool'],
  ['Hoofdgerecht', 'Gemarineerde lamsfilet', 'asperge, tagliatelle van courgette, krokante aardappel'],
  ['Dessert', 'Cheesecake met een kern van mispel', 'ijs van vlierbloesem met witte chocola, tartelette met ganache van framboos, tuile van koffie, koffiekaramel'],
];

// Alleen wat ze zelf hebben aangekondigd (Facebook/Instagram).
const diners = [
  { datum: '4 & 5 december', titel: 'Sinterklaasmenu', tekst: 'Komt de Sint langs?' },
  { datum: '11 & 12 december', titel: 'De Rijping van Zeeland', tekst: 'Zeeuwse producten die door tijd, rijping, fermentatie, droging, pekelen en bewaren meer smaak krijgen. Vijf gangen en een amuse, met bijpassende wijnen.' },
  { datum: '24 & 25 december', titel: 'Early Diner Kerst', tekst: 'Kerstavond en eerste kerstdag, aanvang 16.00 uur. Noordzeekrab, tarbot, gepofte knolselderij met zwarte truffel, kalfshaas, dessert van witte chocolade.', prijs: '€ 79,50 · wijnarrangement € 45' },
];

const titel = "Nellie's private dining | Tholen";
const omschrijving = "Nellie's private dining, Oudelandsedijk 6 in Tholen: elke week een nieuw vijfgangendiner, ingevuld door de chef. € 74,50 p.p., aanvang 18.30 uur, alleen op reservering.";
const kort = (i: number) => reviews[i];
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO: schermvullend hun kalfswang op de pass -->
    <section class="relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-nacht md:min-h-[100svh] lg:max-h-[62rem]">
      <Kop />
      <div class="absolute inset-x-0 top-0 -z-10 h-[64%] lg:inset-0 lg:h-full">
        <Image src={kalfswang} alt="Kalfswang op mousseline met snijboon en een donkere jus, in een wit diep bord op de pass; achter in het donker meer borden en lampen" quality={74} widths={[640, 960, 1280, 1440]} sizes="(min-width: 1024px) 62vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[50%_68%] lg:absolute lg:right-0 lg:w-[64%] lg:object-[50%_55%]" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,#12100e_0%,#12100e00_28%,#12100e00_60%,#12100e_100%)] lg:bg-[linear-gradient(90deg,#12100e_36%,#12100ecc_46%,#12100e00_66%),linear-gradient(0deg,#12100e_0%,#12100e00_22%)]"></div>
      </div>
      <div class="wrap mt-auto pb-12 lg:my-auto lg:pb-0 lg:pt-24">
        <p class="label label-messing">Vijf gangen · elke week nieuw</p>
        <h1 class="mt-6 text-hero leading-[.92]">Nellie's</h1>
        <p class="mt-5 font-kop text-xl italic text-ivoor/85 md:text-2xl">Private dining aan de dijk, Tholen</p>
        <a href="#reserveren" class="knop mt-9 md:mt-11">Tafel aanvragen</a>
      </div>
      <p class="wrap pb-8 text-right text-xs text-zacht max-lg:hidden">Kalfswang, 24 uur gemarineerd in rode wijn en kruiden</p>
    </section>

    <!-- 2. HET HUIS: kort verhaal naast één grote foto -->
    <section id="huis" class="py-24 md:py-32">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-7">
          <Image src={huisOud} alt="Oude zwart-witfoto van een lang laag huis met schuur aan een dijkweg, met auto's ervoor" quality={78} widths={[640, 960]} sizes="(min-width: 1024px) 56vw, 100vw" class="w-full opacity-90" />
          <figcaption class="mt-4 text-xs text-zacht">Uit ons fotoalbum</figcaption>
        </figure>
        <div class="lg:col-span-4 lg:col-start-9">
          <p class="rijs label label-messing">Sinds 2020</p>
          <h2 class="rijs mt-6 text-3xl">Het oudste huis van de dijk</h2>
          <p class="rijs mt-8 text-zacht">Ons huis aan de Oudelandsedijk is gebouwd in 1795. Paula begon hier in 2020 een klein restaurant aan huis, en vernoemde het naar haar moeder: Nellie.</p>
        </div>
      </div>
    </section>

    <!-- 3. DE AVOND: menublad -->
    <section id="avond" class="border-y border-lijn bg-nacht-2 py-24 md:py-32">
      <div class="wrap grid gap-y-20 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-4">
          <p class="rijs label label-messing">De avond</p>
          <h2 class="rijs mt-6 text-3xl">Wij hebben geen menukaart</h2>
          <p class="rijs mt-8 text-zacht">Iedere week serveren we een nieuw vijfgangendiner, ingevuld door de chef.</p>
          <dl class="mt-12 text-sm">
            {[['Vijf gangen', `${site.prijs} p.p., excl. drankjes`], ['Aanvang', 'altijd om 18.30 uur'], ['Reserveren', 'alleen op reservering']].map(([k, v], i) => (
              <div class="rijs flex items-baseline justify-between gap-6 border-t border-lijn py-4" style={`--d:${i * 0.08}s`}>
                <dt class="label">{k}</dt>
                <dd class="num text-right text-ivoor">{v}</dd>
              </div>
            ))}
          </dl>
          <p class="rijs mt-6 text-xs leading-relaxed text-zacht">Vanwege de drukte houden we geen rekening meer met dieetwensen. Betalen gaat contant of met Tikkie.</p>
        </div>

        <article class="rijs lg:col-span-7 lg:col-start-6" aria-labelledby="menu-titel">
          <div class="border border-lijn px-6 py-14 text-center sm:px-14 md:py-20">
            <p class="label">Een week bij Nellie's · 29 mei 2026</p>
            <h3 id="menu-titel" class="mt-5 text-[clamp(1.75rem,1.4vw+1.2rem,2.5rem)] italic">Vlak voor de zomerbreak</h3>
            <div class="mx-auto mt-8 h-px w-12 bg-messing"></div>
            <ol class="mt-10 space-y-8">
              {menu.map(([gang, titel, rest]) => (
                <li>
                  <p class="label label-messing">{gang}</p>
                  <p class="mt-2 font-kop text-xl">{titel}</p>
                  <p class="mx-auto mt-1 max-w-md text-sm text-zacht">{rest}</p>
                </li>
              ))}
            </ol>
          </div>
        </article>
      </div>
    </section>

    <!-- 4. GERECHTEN: weinig, groot, veel ruimte -->
    <section class="py-24 md:py-32" aria-label="Gerechten">
      <div class="wrap">
        <div class="grid items-end gap-y-16 md:grid-cols-12 md:gap-x-10">
          <figure class="rijs md:col-span-7">
            <Image src={sliptong} alt="Sliptong met gele en roze biet op een glazen bord" quality={74} widths={[640, 960, 1300]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/5] w-full object-cover object-[50%_45%]" />
            <figcaption class="mt-4 flex justify-between gap-6 text-xs text-zacht"><span class="font-kop text-base italic text-ivoor">Sliptong</span><span>September</span></figcaption>
          </figure>
          <div class="md:col-span-4 md:col-start-9 md:pb-24">
            <blockquote class="rijs">
              <p class="font-kop text-2xl italic leading-snug">“Elke week een nieuw verrassend menu. Vers, lokaal en ontzettend lekker.”</p>
              <footer class="mt-5 label">Debbie S. · Google</footer>
            </blockquote>
          </div>
        </div>
        <div class="mt-20 grid items-start gap-y-16 md:mt-24 md:grid-cols-12 md:gap-x-10">
          <figure class="rijs md:col-span-5 md:col-start-2 md:mt-28">
            <Image src={tongschar} alt="Tongschar met mosterdzaad, geroosterde ui, gele biet en wortel op een blauw-wit bord" quality={74} widths={[480, 810]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[5/4] w-full object-cover object-top" />
            <figcaption class="mt-4 flex justify-between gap-6 text-xs text-zacht"><span class="font-kop text-base italic text-ivoor">Tongschar, geroosterde ui, gele biet</span><span>Eb en Vloed</span></figcaption>
          </figure>
          <figure class="rijs max-md:hidden md:col-span-5 md:col-start-8" style="--d:.1s">
            <Image src={pass} alt="Borden met paddenstoelen klaar op de pass, onder de lampen van de keuken" quality={74} widths={[480, 800, 1100]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[4/5] w-full object-cover" />
            <figcaption class="mt-4 text-xs text-zacht">Op de pass, net voor het serveren</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 5. BIJZONDERE DINERS -->
    <section id="diners" class="border-t border-lijn py-24 md:py-32">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-4">
          <p class="rijs label label-messing">Agenda</p>
          <h2 class="rijs mt-6 text-3xl">Bijzondere diners</h2>
        </div>
        <ol class="lg:col-span-8">
          {diners.map((d, i) => (
            <li class="rijs grid gap-x-10 gap-y-2 border-t border-lijn py-9 last:border-b sm:grid-cols-[11rem_1fr]" style={`--d:${i * 0.08}s`}>
              <p class="label label-messing pt-2">{d.datum}</p>
              <div>
                <h3 class="text-2xl">{d.titel}</h3>
                <p class="mt-3 max-w-xl text-sm text-zacht">{d.tekst}</p>
                {d.prijs && <p class="num mt-3 text-sm text-ivoor">{d.prijs}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. RESERVEREN, reviews, adres -->
    <section id="reserveren" class="border-t border-lijn bg-nacht-2 py-24 md:py-32">
      <div class="wrap">
        <div class="mx-auto max-w-2xl text-center">
          <p class="rijs label label-messing">Reserveren</p>
          <h2 class="rijs mt-6 text-[clamp(2.75rem,4vw+1rem,5rem)]">Een tafel aan de dijk</h2>
          <p class="rijs mx-auto mt-8 max-w-md text-zacht">App of bel Paula met de datum en het aantal gasten. Aanvang altijd om 18.30 uur.</p>
          <div class="rijs mt-11 flex flex-wrap justify-center gap-4">
            <a href={waHoi} class="knop knop-vol"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-stil num">{site.tel}</a>
          </div>
          <p class="rijs mt-9 text-xs leading-relaxed text-zacht">Op 17 september was er nog plaats op 17, 23, 30 en 31 oktober.</p>
        </div>

        <div class="mt-24 grid gap-x-16 gap-y-12 md:mt-28 md:grid-cols-3">
          {[kort(2), kort(0), kort(3)].map((r, i) => (
            <figure class="rijs" style={`--d:${i * 0.1}s`}>
              <blockquote class="font-kop text-xl italic leading-snug">“{r.tekst}”</blockquote>
              <figcaption class="mt-5 label">{r.naam} · Google</figcaption>
            </figure>
          ))}
        </div>

        <div class="mt-24 grid gap-y-10 border-t border-lijn pt-14 md:grid-cols-12 md:gap-x-16">
          <div class="md:col-span-4">
            <p class="label label-messing">Adres</p>
            <p class="mt-4 font-kop text-2xl">{site.straat}</p>
            <p class="text-zacht">{site.postcode} {site.plaats}</p>
            <p class="mt-4 text-sm"><a href={site.maps} class="link">Route plannen</a></p>
          </div>
          <div class="md:col-span-4">
            <p class="label label-messing">Open</p>
            <table class="mt-4 w-full max-w-xs text-sm">
              <caption class="sr-only">Openingstijden volgens Google</caption>
              <tbody>
                {tijden.filter((t) => t.open).map((t) => (
                  <tr data-dag={t.dag} class="data-[vandaag]:text-messing">
                    <th scope="row" class="py-1 text-left font-normal">{t.naam}</th>
                    <td class="num py-1 text-right text-zacht">{t.open} - {t.dicht}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-3 text-xs text-zacht">Maandag t/m donderdag gesloten. <span data-status></span></p>
          </div>
          <div class="md:col-span-4">
            <p class="label label-messing">Geen bob nodig</p>
            <p class="mt-4 text-sm text-zacht">Woon je op het eiland Tholen, dan kun je het HUB-punt op onze dijk gebruiken, zo'n 100 meter bij ons vandaan. Check de tijden bij <a href="https://www.reizendoorzeeland.nl" class="link text-ivoor">Reizen door Zeeland</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>
