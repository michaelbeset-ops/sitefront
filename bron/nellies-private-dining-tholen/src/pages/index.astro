---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi } from '../data/site';

import tegel from '../assets/tegel.png';
import sliptong from '../assets/sliptong.jpg';
import tongschar from '../assets/tongschar.jpg';
import brioche from '../assets/brioche.jpg';
import gazpacho from '../assets/gazpacho.jpg';
import wonton from '../assets/wonton.jpg';
import sticky from '../assets/sticky-toffee.jpg';
import veloute from '../assets/veloute.jpg';
import paula from '../assets/paula.jpg';
import huisOud from '../assets/huis-oud.jpg';
import deur from '../assets/deur.jpg';
import hub from '../assets/hub.jpg';

// Huisregels, uit hun eigen infoplaatje (Instagram 23 mei, Facebook 17 september 2026).
const regels = [
  ['Het diner', 'vijf gangen, elke week nieuw'],
  ['De kaart', 'die is er niet, de chef kiest'],
  ['Prijs', `${site.prijs} p.p., exclusief drankjes`],
  ['Aan tafel', 'altijd om 18.30 uur'],
  ['Dieetwensen', 'helaas niet mogelijk*'],
  ['Betalen', 'contant of met Tikkie, geen pin'],
];

// Hun laatste gangen voor de zomerbreak, letterlijk uit de Instagrampost van 29 mei 2026.
const menu = [
  ['Amuse', 'Paddenstoelen ragú en zoetzure beukenzwam'],
  ['Voorgerecht', 'Escabèche met sliptong'],
  ['Tussengerecht', 'Zeebaars met venkel en geroosterde druiven'],
  ['Soep', 'Bloemkool met getoaste brioche, emmentaler en ingelegde bloemkool'],
  ['Hoofdgerecht', 'Gemarineerde lamsfilet met asperge, tagliatelle van courgette en krokante aardappel'],
  ['Dessert', 'Cheesecake met een kern van mispel, ijs van vlierbloesem met witte chocola, tartelette met ganache van framboos, tuile van koffie en koffiekaramel'],
];

// Agenda: alleen wat ze zelf hebben aangekondigd (Facebook/Instagram).
const agenda = [
  { id: 'sint', dag: '4 & 5', maand: 'december', titel: 'Sinterklaasmenu', tekst: 'Komt de Sint langs? Reserveren kan via de app.', bron: 'Aangekondigd op 1 oktober', datum: '2026-12-04', keuze: 'het Sinterklaasmenu' },
  { id: 'rijping', dag: '11 & 12', maand: 'december', titel: 'De Rijping van Zeeland', tekst: 'Zeeuwse producten die door tijd, rijping, fermentatie, droging, pekelen en bewaren meer smaak krijgen. Vijf gangen en een amuse, met bijpassende wijnen.', bron: 'Aangekondigd op 6 september', datum: '2026-12-11', keuze: 'De Rijping van Zeeland' },
  { id: 'kerst', dag: '24 & 25', maand: 'december', titel: 'Early Diner Kerst', tekst: 'Kerstavond en eerste kerstdag, aanvang 16.00 uur. Amuse, Noordzeekrab, tarbot, gepofte knolselderij met zwarte truffel, kalfshaas, dessert van witte chocolade en friandises.', prijs: '€ 79,50 · wijnarrangement € 45', bron: 'Aangekondigd op 26 juli', datum: '2026-12-24', keuze: 'het Early Diner Kerstmenu' },
];

const titel = "Nellie's private dining | Huiskamerrestaurant op Tholen";
const omschrijving = "Nellie's private dining, Oudelandsedijk 6 in Tholen: elke week een nieuw vijfgangendiner in een huiselijke ambiance, € 74,50 p.p. Reserveren via WhatsApp.";
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- HERO: licht, als een gedrukte uitnodiging, met hun sliptong groot -->
    <section class="relative overflow-hidden">
      <div class="wrap grid items-center gap-y-10 pb-20 pt-5 md:pt-16 lg:min-h-[calc(100svh-4.75rem)] lg:max-h-[60rem] lg:grid-cols-12 lg:gap-x-10 lg:py-14">
        <div class="lg:col-span-6 lg:pr-4">
          <div class="hidden items-center gap-5 lg:flex">
            <Image src={tegel} alt="Het Delfts-blauwe tegeltje Welkom Nellie's naast hun voordeur" width={180} class="w-[4.5rem] rounded-[2px] shadow-sm sm:w-[5.5rem]" loading="eager" />
            <p class="text-sm leading-snug text-grijs">Huiskamerrestaurant<br />aan de Oudelandsedijk, Tholen</p>
          </div>
          <h1 class="text-hero lg:mt-10">Elke week een nieuw <em class="kop-i text-blauw">vijfgangendiner</em></h1>
          <p class="mt-8 max-w-[34rem] text-lg text-grijs md:text-xl">Wij hebben geen menukaart. De chef bepaalt wat er op tafel komt, jij schuift om half zeven aan.</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href="#tafel" class="knop knop-blauw"><Icoon naam="wa" />Tafel aanvragen</a>
            <a href={site.telHref} class="link num font-semibold">of bel {site.tel}</a>
          </div>
        </div>
        <figure class="relative max-lg:order-first lg:col-span-6">
          <Image src={sliptong} alt="Sliptong met gele en roze biet op een glazen bord" quality={72} widths={[480, 760, 1100, 1400]} sizes="(min-width: 1024px) 46vw, 100vw" loading="eager" fetchpriority="high" class="aspect-[4/5] w-full object-cover object-[50%_45%] max-lg:aspect-[4/3] max-lg:max-h-[21rem] lg:max-h-[calc(100svh-9rem)]" />
          <figcaption class="mt-4 hidden flex-wrap items-baseline justify-between gap-x-6 gap-y-1 text-sm text-grijs lg:flex">
            <span class="kop-i text-lg text-inkt">“Sliptong. Daar kan heel weinig mis mee gaan, heerlijk!”</span>
            <span class="flex-none">15 september</span>
          </figcaption>
        </figure>
      </div>
      <div class="wrap"><div class="dubbel text-inkt"></div></div>
    </section>

    <!-- ZO GAAT HET: huisregels als menukaart -->
    <section id="werkwijze" class="py-20">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs lg:col-span-5">
          <Image src={paula} alt="Paula spuit kreeftenfoam in frikandellenbakjes met gerookte zalm, naast een bak witte asperges" quality={70} widths={[480, 760, 1000]} sizes="(min-width: 1024px) 38vw, 100vw" class="aspect-[4/5] w-full object-cover object-[50%_30%] max-lg:max-h-[28rem] lg:aspect-auto lg:h-[32rem]" />
          <figcaption class="mt-3 text-sm text-grijs">Paula maakt ons “frikandelletje”: gerookte zalm, asperge, foam van kreeft (april 2026)</figcaption>
        </figure>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-6">
          <h2 class="rijs text-3xl">Zo gaat het bij Nellie's</h2>
          <p class="rijs mt-5 max-w-lg text-lg text-grijs">Een klein restaurant met niet alledaagse gerechten, in een huiselijke ambiance.</p>
          <dl class="mt-8 text-lg">
            {regels.map(([k, v], i) => (
              <div class="rijs regel border-b border-lijn py-3" style={`--d:${i * 0.05}s`}>
                <dt class="font-kop text-xl md:text-2xl">{k}</dt>
                <span class="stip" aria-hidden="true"></span>
                <dd class="num max-w-[60%] text-[1rem] text-grijs md:text-lg">{v}</dd>
              </div>
            ))}
          </dl>
          <p class="rijs mt-6 max-w-xl text-sm text-grijs">* Vanwege de toegenomen drukte houden we helaas geen rekening meer met vegetarische, gluten-, soja-, lactose-, steenvruchten- of diabetesgerichte dieetwensen.</p>
          <a href="#tafel" class="rijs knop knop-inkt mt-8"><Icoon naam="wa" />Reserveren? App ons</a>
        </div>
      </div>
    </section>

    <!-- WIJ HEBBEN GEEN MENUKAART: donker, gevelplanken -->
    <section id="menu" class="donker planken text-licht">
      <div class="wrap py-20">
        <div class="grid items-start gap-y-14 lg:grid-cols-12 lg:gap-x-12">
          <div class="lg:col-span-5">
            <h2 class="rijs text-3xl">Wij hebben geen menukaart.<br /><em class="kop-i text-hemel">Wel dit.</em></h2>
            <p class="rijs mt-6 max-w-md text-lg text-licht-zacht">Elke week iets anders, gekookt met wat het seizoen brengt. Een paar gangen van de afgelopen tijd.</p>
          <!-- De menukaart van 29 mei, gezet als gedrukte kaart -->
          <article class="rijs mt-10 bg-papier px-6 py-9 text-inkt shadow-md sm:px-10" aria-labelledby="kaart-titel">
            <div class="dubbel text-blauw"></div>
            <p class="mt-6 text-center text-xs uppercase tracking-[.22em] text-grijs">Nellie's · 29 mei 2026</p>
            <h3 id="kaart-titel" class="mt-3 text-center text-[1.875rem]">Vlak voor de <em class="kop-i text-blauw">zomerbreak</em></h3>
            <ol class="mt-7 space-y-4">
              {menu.map(([gang, gerecht]) => (
                <li class="text-center">
                  <p class="kop-i text-[1.0625rem] text-blauw">{gang}</p>
                  <p class="mx-auto mt-1 max-w-[26rem] text-[.9375rem] leading-snug">{gerecht}</p>
                </li>
              ))}
            </ol>
            <div class="dubbel mt-8 text-blauw"></div>
            <p class="mt-4 text-center text-xs text-grijs">“Hoofdgerecht natuurlijk vergeten te fotograferen”, uit onze post</p>
          </article>
          </div>

          <!-- Foto's van het Eb en Vloed-diner en september -->
          <div class="grid grid-cols-3 gap-x-4 gap-y-8 sm:gap-x-5 lg:col-span-7 lg:pt-3">
            <figure class="rijs col-span-3">
              <Image src={tongschar} alt="Tongschar met mosterdzaad, geroosterde ui, gele biet en wortel op een blauw-wit bord" quality={72} widths={[600, 900, 1200]} sizes="(min-width: 1024px) 52vw, 100vw" class="aspect-[16/11] w-full object-cover object-[50%_45%]" />
              <figcaption class="mt-3 flex flex-wrap justify-between gap-x-4 gap-y-1 text-sm text-licht-zacht"><span class="font-kop text-lg text-licht">Tongschar, geroosterde ui, gele biet</span><span class="flex-none">Eb en Vloed-diner, 25 en 26 september</span></figcaption>
            </figure>
            {[
              [brioche, 'Brioche met mossel en zuring op een donker bord', 'Brioche, mossel, zuring'],
              [gazpacho, 'Heldere gazpacho met geplette gamba in een glazen schaal', 'Heldere gazpacho, gamba'],
              [sticky, 'Sticky toffee met een bol ijs van Earl Grey, butterscotch en Elstar', 'Sticky toffee, ijs van Earl Grey'],
            ].map(([src, alt, cap], i) => (
              <figure class="rijs" style={`--d:${i * 0.06}s`}>
                <Image src={src} alt={alt} quality={70} widths={[300, 460, 640]} sizes="(min-width: 1024px) 17vw, 33vw" class="aspect-[4/5] w-full object-cover object-top" />
                <figcaption class="mt-2.5 font-kop text-[1.0625rem] leading-tight">{cap}</figcaption>
              </figure>
            ))}
            <figure class="rijs col-span-3 sm:col-span-2">
              <Image src={veloute} alt="Velouté van topinamboer met chips van topinamboer en hazelnoot in een stenen kom" quality={70} widths={[480, 760, 1000]} sizes="(min-width: 1024px) 35vw, 100vw" class="aspect-[4/3] w-full object-cover object-[50%_35%]" />
              <figcaption class="mt-2.5 flex flex-wrap justify-between gap-x-4 text-sm text-licht-zacht"><span class="font-kop text-[1.0625rem] text-licht">Velouté van topinamboer, hazelnoot</span><span>19 september</span></figcaption>
            </figure>
            <figure class="rijs col-span-3 sm:col-span-1" style="--d:.08s">
              <Image src={wonton} alt="Gefrituurde wonton met coquille, tartaar van tonijn en rode curry" quality={70} widths={[300, 460, 640]} sizes="(min-width: 1024px) 17vw, 100vw" class="aspect-[4/5] w-full object-cover object-bottom max-sm:aspect-[4/3]" />
              <figcaption class="mt-2.5 font-kop text-[1.0625rem] leading-tight">Wonton, coquille, tartaar van tonijn</figcaption>
            </figure>
          </div>
        </div>
        <p class="rijs mt-12 text-sm text-licht-zacht">Meer gangen zie je op <a href={site.instagram} class="link font-semibold text-licht">Instagram</a> en <a href={site.facebook} class="link font-semibold text-licht">Facebook</a>.</p>
      </div>
    </section>

    <!-- HET HUIS: oudste huis van de dijk, Paula, Nellie -->
    <section id="huis" class="overflow-hidden py-20">
      <div class="wrap">
        <div class="grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-12">
          <figure class="rijs lg:col-span-7">
            <Image src={huisOud} alt="Oude zwart-witfoto van een lang laag huis met schuur aan een dijkweg, met auto's ervoor" quality={74} widths={[600, 960]} sizes="(min-width: 1024px) 56vw, 100vw" class="w-full" />
            <figcaption class="mt-3 text-sm text-grijs">Uit ons fotoalbum, gedeeld op Facebook in 2024</figcaption>
          </figure>
          <div class="lg:col-span-5">
            <h2 class="rijs text-3xl">In het oudste huis van de dijk</h2>
            <p class="rijs mt-7 text-lg text-grijs">Ons huis is gebouwd in 1795, midden in de Schakerloo polder. Paula begon er in januari 2020 een restaurantje aan huis, en noemde het naar haar moeder: Nellie.</p>
            <blockquote class="rijs mt-9 border-l-2 border-blauw pl-6">
              <p class="kop-i text-[clamp(1.375rem,1.2vw+1rem,1.875rem)] leading-[1.25]">“Wij zijn verkocht aan Paula's kookkunst.”</p>
              <footer class="mt-3 text-sm text-grijs">Natasja V., Google-review</footer>
            </blockquote>
            <figure class="rijs mt-10 grid grid-cols-[5.5rem_1fr] items-center gap-5">
              <Image src={deur} alt="Het tegeltje Welkom Nellie's op de grijze houten gevel naast de deur" quality={70} widths={[200, 400]} sizes="6rem" class="aspect-[3/4] w-full object-cover object-left-top" />
              <figcaption>
                <p class="font-kop text-lg leading-snug">“Omdat onze deur voor iedereen open staat”</p>
                <p class="mt-1 text-sm text-grijs">(Wel eerst even reserveren natuurlijk.)</p>
              </figcaption>
            </figure>
          </div>
        </div>

        </div>
    </section>

    <!-- AGENDA -->
    <section id="agenda" class="border-y border-lijn bg-papier-2 py-20">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <h2 class="rijs text-3xl lg:col-span-6">Binnenkort aan de dijk</h2>
          <p class="rijs max-w-md text-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-3">Naast het weekmenu zetten we een paar keer per jaar een bijzonder diner op tafel.</p>
        </div>
        <ol class="mt-10 border-t-2 border-inkt">
          {agenda.map((a, i) => (
            <li class="rijs grid gap-x-10 gap-y-3 border-b border-lijn py-5 md:grid-cols-12" style={`--d:${i * 0.06}s`}>
              <p class="md:col-span-3">
                <span class="num block font-kop text-[clamp(2.5rem,3vw+1rem,3.75rem)] leading-none">{a.dag}</span>
                <span class="kop-i text-xl text-blauw">{a.maand}</span>
              </p>
              <div class="md:col-span-6">
                <h3 class="text-2xl">{a.titel}</h3>
                <p class="mt-3 max-w-xl text-grijs">{a.tekst}</p>
                {a.prijs && <p class="num mt-3 font-semibold">{a.prijs}</p>}
                <p class="mt-3 text-xs text-grijs">{a.bron} op Facebook en Instagram</p>
              </div>
              <div class="md:col-span-3 md:text-right">
                <a href="#tafel" class="knop knop-rand knop-klein" data-kies={a.id}>Plek aanvragen<Icoon naam="pijl" /></a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- EEN TAFEL VOOR JULLIE (wow): zin-formulier naar WhatsApp -->
    <section id="tafel" class="donker bg-blauw text-wit">
      <div class="wrap grid gap-y-12 py-20 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <Image src={tegel} alt="" width={180} class="w-20 rounded-[2px] shadow-md" />
          <h2 class="rijs mt-8 text-3xl">Een tafel voor jullie</h2>
          <p class="rijs mt-6 max-w-md text-lg text-wit/85">Vul de zin aan en stuur hem via WhatsApp. Met een verjaardag, met vrienden of gewoon samen.</p>
          <div class="rijs mt-10 border-t border-wit/25 pt-6">
            <p class="font-kop text-xl">Nog plek in oktober</p>
            <p class="mt-2 text-[.9375rem] text-wit/85">Op 17 september was september volzet en was er in oktober nog plaats op:</p>
            <p class="mt-4 flex flex-wrap gap-2">
              {[['2026-10-17', 'za 17 okt'], ['2026-10-23', 'vr 23 okt'], ['2026-10-30', 'vr 30 okt'], ['2026-10-31', 'za 31 okt']].map(([d, t]) => (
                <button type="button" class="num rounded-sm border border-wit/40 px-3 py-1.5 text-sm font-semibold transition-colors hover:bg-wit hover:text-blauw" data-datum={d}>{t}</button>
              ))}
            </p>
            <p class="mt-3 text-xs text-wit/75">Even checken in je bericht: het kan inmiddels vol zijn.</p>
          </div>
        </div>

        <form class="rijs bg-papier p-6 text-inkt shadow-md sm:p-10 lg:col-span-7" data-tafel aria-labelledby="tafel-titel" novalidate>
          <p id="tafel-titel" class="sr-only">Tafel aanvragen via WhatsApp</p>
          <div class="font-kop text-[clamp(1.375rem,1.2vw+1rem,1.875rem)] leading-[1.75]">
            Hoi Paula! Wij komen graag eten op
            <label class="inline"><span class="sr-only">Datum</span><input type="date" name="datum" class="invul" /></label>
            met
            <label class="inline"><span class="sr-only">Aantal personen</span><input type="number" name="aantal" min="1" max="99" value="2" inputmode="numeric" class="invul num w-[3.5rem] text-center" /></label>
            personen, voor
            <label class="inline"><span class="sr-only">Welk diner</span>
              <select name="diner" class="invul">
                <option value="het weekmenu">het weekmenu</option>
                <option value="het Sinterklaasmenu" data-optie="sint">het Sinterklaasmenu</option>
                <option value="De Rijping van Zeeland" data-optie="rijping">De Rijping van Zeeland</option>
                <option value="het Early Diner Kerstmenu" data-optie="kerst">het Early Diner Kerst</option>
              </select>
            </label>.
            Het is voor
            <label class="inline"><span class="sr-only">Gelegenheid</span>
              <select name="gelegenheid" class="invul">
                <option value="">een gezellig avondje uit</option>
                <option>een verjaardag</option>
                <option>een jubileum</option>
                <option>een etentje met vrienden</option>
                <option>een familie-etentje</option>
                <option>een uitje met collega's</option>
              </select>
            </label>.
          </div>
          <label class="mt-8 block max-w-sm">
            <span class="text-sm font-semibold">Je naam</span>
            <input name="naam" type="text" class="veld mt-2" autocomplete="name" placeholder="Voor- en achternaam" />
          </label>
          <p class="mt-5 min-h-[1.5rem] text-sm font-semibold text-blauw" data-let-op aria-live="polite"></p>
          <div class="mt-4 rounded-md rounded-tl-none bg-[#e2efe6] p-4 text-[.9375rem] leading-relaxed">
            <p class="text-xs font-bold text-[#2a5a40]">Jouw bericht</p>
            <p class="mt-1" data-bericht-uit>Hoi Paula! Wij willen graag komen eten bij Nellie's.</p>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={waHoi} class="knop knop-blauw" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <a href={site.telHref} class="link num text-[.9375rem] font-semibold">of bel {site.tel}</a>
          </div>
          <p class="mt-5 text-xs text-grijs">Er wordt pas iets verstuurd als jij in WhatsApp op verzenden drukt. Dieetwensen kunnen we helaas niet meenemen; betalen gaat contant of met Tikkie.</p>
        </form>
      </div>
    </section>

    <!-- GASTEN -->
    <section id="gasten" class="bg-wit py-20">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs max-w-3xl text-3xl">“Thuiskomen!”</h2>
          <a href={site.reviews} class="rijs inline-flex items-center gap-2.5 text-sm font-semibold no-underline hover:text-blauw">
            <Icoon naam="g" class="h-5 w-5" />
            <span class="flex gap-0.5 text-ster" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            Alle reviews op Google
          </a>
        </div>
        <div class="mt-14 grid gap-x-12 gap-y-12 lg:grid-cols-12">
          <figure class="rijs border-t-2 border-inkt pt-6 lg:col-span-5">
            <span class="flex gap-0.5 text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            <blockquote class="mt-5 font-kop text-[clamp(1.5rem,1.1vw+1.1rem,2rem)] leading-[1.28]">“{reviews[2].tekst}”</blockquote>
            <figcaption class="mt-5 text-sm text-grijs"><b class="font-semibold text-inkt">{reviews[2].naam}</b> · Google-review, {reviews[2].wanneer}</figcaption>
          </figure>
          <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:col-span-7">
            {[reviews[1], reviews[3], reviews[4], reviews[5]].map((r, i) => (
              <figure class="rijs border-t border-lijn pt-6" style={`--d:${i * 0.06}s`}>
                <span class="flex gap-0.5 text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
                <blockquote class="mt-4 text-lg leading-snug">“{r.tekst}”</blockquote>
                <figcaption class="mt-4 text-sm text-grijs"><b class="font-semibold text-inkt">{r.naam}</b> · Google-review, {r.wanneer}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- BEZOEK -->
    <section id="bezoek" class="border-t border-lijn py-20">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl">Aan de Oudelandsedijk</h2>
          <address class="rijs mt-7 not-italic">
            <p class="text-xl font-semibold">{site.straat}</p>
            <p class="text-lg text-grijs">{site.postcode} {site.plaats}</p>
          </address>
          <p class="rijs mt-6 inline-flex items-center gap-2.5 rounded-sm bg-papier-2 px-4 py-2 text-sm font-semibold" data-status-wrap>
            <span class="stip-open h-2.5 w-2.5 rounded-full bg-grijs" aria-hidden="true"></span>
            <span data-status>Vrijdag, zaterdag en zondag open</span>
          </p>
          <table class="rijs mt-8 w-full max-w-md text-[1rem]">
            <caption class="sr-only">Openingstijden Nellie's</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-bold data-[vandaag]:text-blauw">
                  <th scope="row" class="py-2 text-left font-[inherit]">{t.naam}</th>
                  <td class="num py-2 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="rijs mt-4 max-w-md text-sm text-grijs">Tijden volgens Google. Het diner begint altijd om 18.30 uur; alleen op reservering.</p>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={site.maps} class="knop knop-inkt"><Icoon naam="pin" />Route plannen</a>
            <a href={waHoi} class="knop knop-blauw"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <figure class="rijs">
            <Image src={hub} alt="Het groene HUB-bord voor flexvervoer op de dijk, met het bord Welkom op de hub Tholen, Het Oudeland" quality={70} widths={[480, 800, 1100]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[16/10] w-full object-cover object-left" />
          </figure>
          <div class="rijs mt-8 border-t border-lijn pt-6">
            <p class="font-kop text-2xl">Geen bob nodig</p>
            <p class="mt-3 text-[.9375rem] text-grijs">Op onze dijk, zo'n 100 meter bij ons vandaan, staat een HUB-punt voor flexvervoer. Woon je op het eiland Tholen, dan kun je daar gebruik van maken. In de polder word je zelfs voor de deur opgehaald en gebracht. Check wel even de tijden en voorwaarden bij <a href="https://www.reizendoorzeeland.nl" class="link font-semibold text-inkt">Reizen door Zeeland</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SLOTBAND -->
    <section class="donker planken text-licht">
      <div class="wrap flex flex-wrap items-center justify-between gap-8 py-14 md:py-16">
        <div class="flex items-center gap-6">
          <Image src={tegel} alt="" width={140} class="hidden w-16 flex-none rounded-[2px] sm:block" />
          <p class="max-w-2xl font-kop text-[clamp(1.75rem,2.2vw+1rem,2.75rem)] leading-[1.08]">Heb jij al <em class="kop-i text-hemel">gereserveerd?</em></p>
        </div>
        <a href="#tafel" class="knop knop-licht"><Icoon naam="wa" />Tafel aanvragen</a>
      </div>
    </section>
  </main>
  <Voet />

  <style>
    [data-open='true'] .stip-open { background: #23a565; box-shadow: 0 0 0 4px #23a56533; }
  </style>

  <script>
    import { waMet } from '../data/site';
    const f = document.querySelector<HTMLFormElement>('[data-tafel]');
    if (f) {
      const uit = f.querySelector<HTMLElement>('[data-bericht-uit]')!;
      const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const letOp = f.querySelector<HTMLElement>('[data-let-op]')!;
      const datum = f.querySelector<HTMLInputElement>('input[name=datum]')!;
      const diner = f.querySelector<HTMLSelectElement>('select[name=diner]')!;
      const vandaag = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Amsterdam' }).format(new Date());
      datum.min = vandaag;
      const open = [5, 6, 0]; // vrijdag, zaterdag, zondag (Google)
      const eerste: Record<string, string> = { sint: '2026-12-04', rijping: '2026-12-11', kerst: '2026-12-24' };
      const toegestaan: Record<string, string[]> = { sint: ['2026-12-04', '2026-12-05'], rijping: ['2026-12-11', '2026-12-12'], kerst: ['2026-12-24', '2026-12-25'] };
      const mooi = (iso: string) => new Intl.DateTimeFormat('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(iso + 'T12:00:00Z'));
      const maak = () => {
        const d = new FormData(f);
        const iso = String(d.get('datum') || '');
        const n = Math.max(1, Number(d.get('aantal') || 2));
        const wat = String(d.get('diner'));
        const gel = String(d.get('gelegenheid') || '');
        const naam = String(d.get('naam') || '').trim();
        const optie = diner.selectedOptions[0]?.dataset.optie || '';
        let t = `Hoi Paula! Wij komen graag eten op ${iso ? mooi(iso) : '…'} met ${n} ${n === 1 ? 'persoon' : 'personen'}, voor ${wat}.`;
        if (gel) t += ` Het is voor ${gel}.`;
        t += ' Is er nog plek?';
        if (naam) t += ` Groet, ${naam}`;
        uit.textContent = t;
        stuur.href = waMet(t);
        let w = '';
        if (iso) {
          const dag = new Date(iso + 'T12:00:00Z').getUTCDay();
          if (optie && !toegestaan[optie].includes(iso)) w = `Let op: ${wat} is op ${toegestaan[optie].map(mooi).join(' en ')}.`;
          else if (!optie && !open.includes(dag)) w = `Let op: volgens Google zijn we op ${mooi(iso).split(' ')[0]} gesloten. Vraag het gerust.`;
        }
        letOp.textContent = w;
      };
      diner.addEventListener('change', () => { const o = diner.selectedOptions[0]?.dataset.optie; if (o) datum.value = eerste[o]; maak(); });
      document.querySelectorAll<HTMLButtonElement>('[data-datum]').forEach((b) => b.addEventListener('click', () => { datum.value = b.dataset.datum!; diner.value = 'het weekmenu'; maak(); f.scrollIntoView({ behavior: 'smooth', block: 'center' }); }));
      document.querySelectorAll<HTMLAnchorElement>('[data-kies]').forEach((a) => a.addEventListener('click', () => { const o = a.dataset.kies!; const opt = diner.querySelector<HTMLOptionElement>(`[data-optie="${o}"]`); if (opt) { diner.value = opt.value; datum.value = eerste[o]; maak(); } }));
      f.addEventListener('input', maak); f.addEventListener('change', maak); f.addEventListener('submit', (e) => e.preventDefault());
      maak();
    }
  </script>
</Base>
