---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="border-t border-lijn bg-nacht text-zacht">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.875rem] md:grid-cols-12 md:py-20">
    <div class="text-ivoor md:col-span-6">
      <Merk />
      <p class="mt-6 max-w-xs">Genieten van verrassende gerechten in een huiselijke ambiance.</p>
    </div>
    <div class="md:col-span-3">
      <p class="label label-messing">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">nelliesprivatedining<wbr />@kpnmail.nl</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="label label-messing">Volg ons</p>
      <p class="mt-4"><a href={site.instagram} class="link">Instagram</a></p>
      <p class="mt-1"><a href={site.facebook} class="link">Facebook</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.vol}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-messing">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto’s en teksten van jullie eigen Facebook- en Instagramberichten. Reviews letterlijk van Google (stand 5 oktober 2026).</p>}
</footer>
