---
import { getImage } from 'astro:assets';
import tegel from '../assets/tegel.png';
import { url } from '../data/site';
const img = await getImage({ src: tegel, width: 96, format: 'webp' });
---
<a href={url('')} class="merk">
  <img src={img.src} width="38" height="52" alt="" />
  <span><b>Nellie's</b><small>private dining · Tholen</small></span>
</a>
