---
// Hun ronde uithangbord nagetekend: blauwe schijf, LAKE / SIDE in witte ronde letters, "Café" schuin eronder.
interface Props { class?: string; vul?: string }
const { class: cls = '', vul = '#155fae' } = Astro.props;
---
<svg class={cls} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="31" fill={vul} />
  <circle cx="32" cy="32" r="28.2" fill="none" stroke="#ffffff" stroke-opacity=".35" stroke-width=".8" />
  <g fill="#ffffff" font-family="Comfortaa Variable, Comfortaa, sans-serif" font-weight="700" text-anchor="middle">
    <text x="32" y="25.5" font-size="12.5" letter-spacing="1.2">LAKE</text>
    <text x="32" y="38.5" font-size="12.5" letter-spacing="1.2">SIDE</text>
    <text x="40" y="50" font-size="9" font-weight="500" transform="skewX(-12) translate(10 0)">Café</text>
  </g>
</svg>
