---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-diep text-hemel">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <div class="flex items-center gap-4 text-wit">
        <Merk class="h-14 w-14 flex-none" vul="#155fae" />
        <p class="kop text-[1.6rem] font-bold leading-none">Lakeside Café</p>
      </div>
      <p class="mt-6 max-w-sm">Café en terras aan de haven in Oud Loosdrecht. Ontbijt, lunch, koffie en een goed glas aan het water.</p>
      <p class="mt-5"><a href={site.insta} class="link link-licht inline-flex items-center gap-2"><Icoon naam="insta" class="h-4 w-4" />@lakesidecafeloosdrecht</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-medium text-wit">Contact</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1"><a href={site.route} class="link link-licht">Route</a></p>
    </div>
    <div class="md:col-span-4">
      <p class="font-medium text-wit">Open in de herfst en winter</p>
      <dl class="mt-3 grid max-w-[21rem] gap-x-4 grid-cols-[1fr_auto] gap-y-1 num">
        <dt>Woensdag tot en met zondag</dt><dd>10:00 tot 17:00</dd>
        <dt>Maandag en dinsdag</dt><dd>dicht</dd>
      </dl>
      <p class="mt-4 flex items-center gap-2"><Icoon naam="g" class="h-4 w-4" /><span class="num">{site.google.score} op Google, {site.google.aantal} reviews</span></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.volledig}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's komen van jullie eigen Google-bedrijfsprofiel en Instagram; gezichten van gasten zijn onherkenbaar gemaakt. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
