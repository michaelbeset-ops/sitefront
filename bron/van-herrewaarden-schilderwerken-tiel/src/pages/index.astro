<script>
  // Voor en na: tabs per klus, en per klus schakelen tussen de voor- en de na-foto.
  const vn = document.querySelector<HTMLElement>('[data-vn]');
  if (vn) {
    const tabs = [...vn.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const kies = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => { const aan = x === t; x.setAttribute('aria-selected', String(aan)); x.tabIndex = aan ? 0 : -1; vn.querySelector(`[data-paneel="${x.dataset.tab}"]`)?.classList.toggle('hidden', !aan); });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => kies(t));
      t.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); kies(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true); } });
    });
    vn.querySelectorAll<HTMLElement>('[data-paneel]').forEach((p) => {
      p.querySelectorAll<HTMLButtonElement>('[data-naar]').forEach((k) => k.addEventListener('click', () => {
        p.dataset.stand = k.dataset.naar;
        p.querySelectorAll('[data-naar]').forEach((x) => x.setAttribute('aria-pressed', String(x === k)));
      }));
    });
  }

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const wat = d.getAll('wat').map(String);
      const r = ['Goedendag, ik wil graag een offerte voor schilderwerk.'];
      r.push('Waar: ' + (v('waar') || 'Buiten').toLowerCase());
      if (wat.length) r.push('Wat: ' + wat.join(', ').toLowerCase());
      r.push('Voor: ' + v('voor').toLowerCase());
      if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('toelichting')) r.push('Toelichting: ' + v('toelichting'));
      r.push('Foto\'s stuur ik hierna mee.');
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31643558863?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

