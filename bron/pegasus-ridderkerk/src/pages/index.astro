---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site } from '../data/site';

const tijden = [
  ['Maandag', 'Gesloten'],
  ['Dinsdag', 'Gesloten'],
  ['Woensdag t/m zondag', 'vanaf 17.00'],
];
const feesten = ['Bruiloften', 'Familiefeesten en jubilea', 'Bedrijfsfeesten', 'Presentaties en vergaderingen', 'High tea', 'Babyshowers', 'Barbecues op het terras'];
const buffetKoud = ['Schotse gerookte zalm, gerookte forel en heilbot', 'Hollandse garnalen met whisky-cocktailsaus', 'Serranoham, rosbief en roompaté', 'Carpaccio met pijnboompitten en kruidendressing', 'Salades van kip, rundvlees, zalm en komkommer', 'Brood met Toscaanse tapenade, kruiden- en roomboter'];
const buffetWarm = ['Kipsaté met nasi', 'Varkenshaas in champignonroomsaus met krieltjes', 'Boeuf bourguignon', 'Kip kerrie'];
---
<Base
  title="Restaurant Pegasus | Magic Bites en feesten aan de jachthaven van Ridderkerk"
  description="Onbeperkt Magic Bites, buffetten vanaf 25 personen en bruiloften, jubilea en bedrijfsfeesten aan de jachthaven van Ridderkerk. Open woensdag tot en met zondag vanaf 17.00 uur."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="bg-night pb-16 pt-12 text-paper lg:pb-24 lg:pt-20">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="font-display text-xl italic text-coral">Aan de jachthaven van Ridderkerk</p>
          <h1 class="mt-3 text-4xl">Een avond uit, tot in de puntjes verzorgd</h1>
          <p class="mt-6 max-w-xl text-lg text-paper/80">
            Een sfeervol restaurant met een eigen parkeerplaats en een groot terras aan het water.
            Kom voor een avond Magic Bites, of vier hier je bruiloft, jubileum of bedrijfsfeest.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-coral">Reserveer: {site.tel}</a>
            <a href="#feesten" class="btn btn-line">Iets te vieren?</a>
          </div>
        </div>
        <aside aria-labelledby="open" class="self-end border-l-2 border-coral pl-6 lg:col-span-4">
          <h2 id="open" class="text-2xl">Open</h2>
          <dl class="mt-4 space-y-2">
            {tijden.map(([d, t]) => (
              <div class="flex justify-between gap-4"><dt>{d}</dt><dd class={`whitespace-nowrap ${t === 'Gesloten' ? 'text-paper/55' : ''}`}>{t}</dd></div>
            ))}
          </dl>
          <p class="mt-4 text-sm text-paper/70">Keuken open van 17.00 tot 21.30 uur, desserts tot 22.00 uur. Reserveren kan telefonisch, ook van maandag tot en met woensdag tussen 9.00 en 17.00 uur.</p>
        </aside>
      </div>
    </section>

    <section id="magic-bites" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6">
        <h2 class="text-3xl">Magic Bites</h2>
        <p class="mt-5 text-lg">
          Op je tafel liggen bestelkaartjes. Je kiest steeds twee gerechtjes tegelijk, zo vaak als je wilt.
          Zo proef je in één avond van alles uit onze keuken: vlees, vis, wild en onze dessertspecialiteiten.
        </p>
        <p class="mt-4 text-ink-soft">Om iedereen een verzorgde avond te geven, vragen we je om onnodige verspilling te voorkomen.</p>
        <p class="mt-4 text-sm text-ink-soft">[[AANLEVEREN: de actuele Magic Bites-kaart als tekst]]</p>
      </div>
      <div class="grid content-start gap-6 lg:col-span-5 lg:col-start-8">
        <div class="border-t-2 border-ink pt-4">
          <p class="font-display text-[3.25rem] font-extrabold leading-none tabular-nums">€ 39,95</p>
          <p class="mt-2">per persoon, onbeperkt</p>
        </div>
        <div class="border-t-2 border-coral-deep pt-4">
          <p class="font-display text-[3.25rem] font-extrabold leading-none tabular-nums">€ 19,95</p>
          <p class="mt-2">voor kinderen tot twaalf jaar</p>
        </div>
        <p class="text-sm text-ink-soft">Drankjes worden apart berekend. Heb je een allergie? Laat het ons weten.</p>
      </div>
    </section>

    <section id="feesten" class="scroll-mt-20 bg-paper-deep py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Spraakmakende feesten, groot en klein</h2>
          <ul class="mt-8 space-y-2 font-display text-xl font-bold">
            {feesten.map((f) => <li class="border-b border-line pb-2">{f}</li>)}
          </ul>
        </div>
        <div class="space-y-5 text-lg lg:col-span-6 lg:col-start-7">
          <div class="photo-slot aspect-[16/10]" role="img" aria-label="Plek voor een foto van de zaal of het terras aan de haven">[[AANLEVEREN: foto zaal of terras aan de haven, liggend]]</div>
          <p>
            Voor grote en kleine gezelschappen stellen we samen met jou een thema en een programma op.
            Een feestelijk diner, muziek van een band of drive-in show, licht en geluid: het kan allemaal.
          </p>
          <p>
            Trouw je? De jachthaven met zijn schepen en jachten is een prachtig decor voor je fotoreportage.
            Kom aan in een trouwkoets, sluit af met stil vuurwerk boven de haven, of maak er met ons terras en de barbecue een zomers buitenfeest van.
          </p>
          <a href={site.telHref} class="btn btn-night">Plan een gesprek: {site.tel}</a>
        </div>
      </div>
    </section>

    <section id="buffetten" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Buffetten vanaf 25 personen</h2>
          <p class="mt-5">Geen menukeuze vooraf voor je gasten? Kies een van onze buffetten, of laat er een helemaal naar jouw wens maken.</p>
          <p class="mt-4 text-sm text-ink-soft">[[AANLEVEREN: prijzen per persoon van Buffet Pegasus, De luxe en de warme toevoegingen]]</p>
        </div>
        <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
          <div>
            <h3 class="text-xl">Buffet Pegasus</h3>
            <ul class="mt-4 space-y-2 text-ink-soft">{buffetKoud.map((b) => <li>{b}</li>)}</ul>
            <p class="mt-4 text-sm">De luxe-versie heeft onder meer ook pastasalade, tonijnsalade, kipsaté en varkenshaas.</p>
          </div>
          <div>
            <h3 class="text-xl">Warm erbij</h3>
            <ul class="mt-4 space-y-2 text-ink-soft">{buffetWarm.map((b) => <li>{b}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-20 bg-night py-16 text-paper lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Aan de haven</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <p class="mt-4 text-paper/75">Met eigen parkeerplaats.</p>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <dl class="grid gap-4 text-lg">
            <div><dt class="text-sm text-paper/60">Reserveren</dt><dd><a href={site.telHref} class="font-display text-3xl font-extrabold underline decoration-coral decoration-2 underline-offset-4">{site.tel}</a></dd></div>
            <div><dt class="text-sm text-paper/60">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="underline decoration-coral decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          </dl>
          <p class="mt-10 border-t border-white/15 pt-6 text-paper/80">Werken bij Pegasus? We zoeken regelmatig enthousiaste mensen voor de bediening en de keuken, ook als bijbaan naast je studie. Mail of bel ons gerust.</p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
