---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 bg-night text-paper">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-2xl font-extrabold italic tracking-[-0.03em] no-underline">Pegasus</a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href="#magic-bites" class="no-underline hover:text-coral">Magic Bites</a></li>
          <li><a href="#feesten" class="no-underline hover:text-coral">Feesten</a></li>
          <li><a href="#buffetten" class="no-underline hover:text-coral">Buffetten</a></li>
          <li><a href="#contact" class="no-underline hover:text-coral">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-coral !px-4 !py-2 text-sm">Reserveren</a>
    </div>
  </header>
) : (
  <footer class="bg-night py-10 text-paper/75">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-xl italic text-paper">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
  </footer>
)}
