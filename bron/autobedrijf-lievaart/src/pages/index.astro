---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, occasions, voorraadDatum } from '../data/site';
import hero from '../assets/hero.jpg';
import stuur from '../assets/stuur.jpg';
import groen from '../assets/groen.jpg';
import werk from '../assets/werk.jpg';

const service = [
  { kop: 'Ophalen en wegbrengen', tekst: 'Even ophalen of wegbrengen is geen enkel probleem.' },
  { kop: 'Vervangende auto', tekst: 'Bij een grote beurt stellen we met genoegen een vervangende auto beschikbaar.' },
  { kop: 'Service zoals vroeger', tekst: 'De service is nog steeds vergelijkbaar met die van vroeger.' },
  { kop: 'Onafhankelijk BOVAG-bedrijf', tekst: 'Een onafhankelijk BOVAG-autobedrijf, gespecialiseerd in MG en Rover.' },
];
---
<Base
  title="Autobedrijf Lievaart | MG-Rover specialist in Rozenburg"
  description="Onafhankelijk BOVAG-autobedrijf in Rozenburg, gespecialiseerd in MG en Rover. Onderhoud en reparatie, onderdelen en occasions met PremiumGarantie."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: foto en groen vlak naast elkaar, als een showroomraam. Op mobiel eerst de foto, dan de tekst. -->
    <section class="bg-racing text-cream lg:grid lg:grid-cols-12">
      <div class="aspect-[4/3] overflow-hidden sm:aspect-[16/9] lg:order-2 lg:col-span-6 lg:aspect-auto lg:min-h-[36rem]">
        <Foto src={hero} alt="Lichtgroene klassieke MGB GT op een grindpad, met bomen en een tuinmuur op de achtergrond" hero sizes="(min-width: 1024px) 50vw, 100vw" />
      </div>
      <div class="flex items-center lg:order-1 lg:col-span-6">
        <div class="w-full px-5 py-10 md:px-8 lg:py-16 lg:pl-[max(2rem,calc((100vw-74rem)/2+2rem))] lg:pr-10">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-cream/85">Autobedrijf Lievaart, Rozenburg</p>
          <h1 class="mt-4 text-4xl text-white">Specialist in MG en Rover</h1>
          <div class="chroom mt-6 w-24 opacity-70"></div>
          <p class="mt-6 text-lg">Een onafhankelijk BOVAG-autobedrijf met een historie van meer dan 80 jaar, gespecialiseerd in MG en Rover. Voor onderhoud, reparatie, onderdelen en occasions.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-cream">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            <a href="#aanvragen" class="btn btn-line-light">Onderdelen aanvragen</a>
          </div>
          <p class="mt-6 text-sm"><strong class="text-white">4,7</strong> uit 5 op Google, 30 reviews</p>
        </div>
      </div>
    </section>

    <!-- Werkplaats: tekst links met een genummerde servicelijst, stuurfoto rechts. -->
    <section id="werkplaats" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-6">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-mg">Werkplaats, XPart AutoService</p>
          <h2 class="mt-3 text-3xl">Onderhoud en reparatie van uw MG of Rover</h2>
          <p class="mt-5 text-lg text-ink-soft">Rijdt u een MG of Rover en vraagt u zich af waar u terecht kunt voor onderhoud en reparatie? Dan bent u hier op de juiste plaats. We stellen alles in het werk om u tevreden te stellen en te houden.</p>
          <ol class="mt-10 border-t border-line">
            {service.map((s, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-x-3 border-b border-line py-5">
                <span class="font-display text-2xl leading-none text-mg tabular-nums" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3 class="text-lg">{s.kop}</h3>
                  <p class="mt-1 text-ink-soft">{s.tekst}</p>
                </div>
              </li>
            ))}
          </ol>
          <a href="#aanvragen" class="btn btn-racing mt-8">Plan een werkplaatsafspraak</a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="aspect-[4/5] overflow-hidden rounded-xl shadow-sm lg:sticky lg:top-24">
            <Foto src={stuur} alt="Stuur van een klassieke MG met het rode MG-embleem en de klokken van het dashboard" sizes="(min-width: 1024px) 420px, 100vw" />
          </div>
        </div>
      </div>
    </section>

    <!-- Missie: groen vlak, grote cursieve zin, foto van een MGB GT eronder. -->
    <section class="bg-racing-deep text-cream">
      <div class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-4">
          <p class="font-display text-[clamp(4.5rem,12vw,8rem)] leading-none text-white">80<span class="text-chrome">+</span></p>
          <p class="mt-3 max-w-[16rem] text-sm">jaar historie als autobedrijf</p>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <h2 class="text-3xl font-normal italic text-white">Voorsprong door betrouwbaarheid</h2>
          <p class="mt-6 text-lg">Dat is onze missie, en die leven we elke dag weer nauwlettend na. Om ook werkelijk op voorsprong te blijven, en omdat we graag tevreden klanten zien. Persoonlijke aandacht en persoonlijke service: dat mag u bij Autobedrijf Lievaart verwachten.</p>
        </div>
      </div>
      <div class="aspect-[16/9] max-h-[34rem] w-full overflow-hidden md:aspect-[21/8]">
        <Foto src={groen} alt="Donkergroene klassieke MGB GT met spaakwielen, geparkeerd langs een hek" sizes="100vw" />
      </div>
    </section>

    <!-- Occasions: prijskaartjes op crème, met datum van de voorraad. -->
    <section id="occasions" class="scroll-mt-20 bg-cream py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-mg">Occasions</p>
            <h2 class="mt-3 text-3xl">Nagekeken met een vaste checklist</h2>
          </div>
          <div class="space-y-4 text-lg text-ink-soft lg:col-span-6 lg:col-start-7">
            <p>Alle auto's worden door onze technici nauwgezet met een vaste checklist geïnspecteerd en in topconditie gebracht, voordat ze onze PremiumGarantie verdienen. Die garantie gaat verder dan de standaard BOVAG-garantie met Nationale Autopas.</p>
          </div>
        </div>

        <p class="mt-12 text-sm font-bold text-ink-soft">Voorraad van {voorraadDatum}</p>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {occasions.map((o) => (
            <li class="flex flex-col rounded-xl border-t-4 border-mg bg-white p-6 shadow-sm">
              <h3 class="text-xl">{o.naam}</h3>
              {o.extra && <p class="mt-1 text-sm text-ink-soft">{o.extra}</p>}
              <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
                <div><dt class="text-ink-soft">Bouwjaar</dt><dd class="font-bold whitespace-nowrap tabular-nums">{o.bouwjaar}</dd></div>
                <div><dt class="text-ink-soft">Kilometerstand</dt><dd class="font-bold whitespace-nowrap tabular-nums">{o.km}</dd></div>
                {o.garantie && <div class="col-span-2"><dt class="text-ink-soft">Garantie</dt><dd class="font-bold">{o.garantie}</dd></div>}
              </dl>
              <p class="mt-auto border-t border-line pt-4 font-display text-2xl text-racing whitespace-nowrap tabular-nums">{o.prijs}</p>
            </li>
          ))}
          <li class="flex flex-col justify-between rounded-xl bg-racing p-6 text-cream">
            <p class="font-display text-xl text-white">Interesse in een van deze auto's?</p>
            <p class="mt-3 text-sm">Bel ons voor meer informatie over de auto.</p>
            <a href={site.telHref} class="btn btn-cream mt-6 self-start">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </li>
        </ul>
      </div>
    </section>

    <!-- Aanvragen: formulier naast werkfoto en de onderdelenregel. -->
    <section id="aanvragen" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-mg">Onderdelen en werkplaats</p>
          <h2 class="mt-3 text-3xl">Onderdelen bestellen of een afspraak maken</h2>
          <p class="mt-5 text-lg text-ink-soft">Zoekt u een onderdeel voor uw MG of Rover? Alle onderdelen worden verstuurd vanuit onze vestiging in Rozenburg. Vermeld daarbij het merk en type van uw auto, het bouwjaar of het chassisnummer.</p>
          <div class="mt-8 hidden aspect-[4/3] overflow-hidden rounded-xl shadow-sm sm:block">
            <Foto src={werk} alt="Handen van een monteur bij een geopende zekeringkast onder de motorkap, met een relais in de hand" sizes="(min-width: 1024px) 420px, 100vw" />
          </div>
        </div>
        <form class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-line sm:p-8 lg:col-span-7" action="#" onsubmit="return false">
          <fieldset>
            <legend class="font-bold">Waar gaat het om?</legend>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:gap-6">
              <label class="flex items-center gap-2"><input type="radio" name="soort" value="onderdelen" checked class="h-5 w-5 accent-racing" /> Onderdelen aanvragen</label>
              <label class="flex items-center gap-2"><input type="radio" name="soort" value="werkplaats" class="h-5 w-5 accent-racing" /> Werkplaatsafspraak</label>
            </div>
          </fieldset>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label class="block text-sm font-bold">Naam<input class="veld font-normal" type="text" name="naam" autocomplete="name" /></label>
            <label class="block text-sm font-bold">Telefoon<input class="veld font-normal" type="tel" name="telefoon" autocomplete="tel" /></label>
            <label class="block text-sm font-bold sm:col-span-2">E-mail<input class="veld font-normal" type="email" name="email" autocomplete="email" /></label>
            <label class="block text-sm font-bold sm:col-span-2">Kenteken of merk en type<input class="veld font-normal" type="text" name="auto" /></label>
            <label class="block text-sm font-bold sm:col-span-2">Onderdeel of werkzaamheden<input class="veld font-normal" type="text" name="onderwerp" /></label>
            <label class="block text-sm font-bold sm:col-span-2">Bericht<textarea class="veld font-normal" name="bericht" rows="4"></textarea></label>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg bg-cream p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="font-bold underline underline-offset-2 whitespace-nowrap">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-bold underline underline-offset-2 break-all">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-racing mt-6">Aanvraag versturen</button>
          )}
        </form>
      </div>
    </section>

    <section id="contact" class="scroll-mt-20 bg-ink py-16 text-cream lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl text-white">Langskomen of bellen</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line-light mt-6">Route plannen</a>
        </div>
        <dl class="grid content-start gap-6 text-lg lg:col-span-6 lg:col-start-7">
          <div><dt class="text-sm text-cream/80">Telefoon</dt><dd><a href={site.telHref} class="font-display text-3xl whitespace-nowrap text-white tabular-nums underline decoration-chrome decoration-1 underline-offset-8">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-cream/80">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-chrome underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-cream/80">Openingstijden</dt><dd class="text-sm text-cream/85">[[AANLEVEREN: openingstijden werkplaats en verkoop]]</dd></div>
          <div><dt class="text-sm text-cream/80">Google</dt><dd><span class="tabular-nums">4,7</span> uit 5, op basis van 30 reviews</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
