---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex min-w-0 items-baseline gap-2 no-underline">
        <span class="font-display text-xl font-bold text-racing sm:text-2xl">Lievaart</span>
        <span class="hidden whitespace-nowrap text-xs font-bold uppercase tracking-[0.14em] text-mg sm:inline">MG-Rover specialist</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href={url('#werkplaats')} class="no-underline transition-colors hover:text-mg">Werkplaats</a></li>
          <li><a href={url('#occasions')} class="no-underline transition-colors hover:text-mg">Occasions</a></li>
          <li><a href={url('#aanvragen')} class="no-underline transition-colors hover:text-mg">Onderdelen</a></li>
          <li><a href={url('#contact')} class="no-underline transition-colors hover:text-mg">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-racing shrink-0 !px-3.5 !py-2 text-sm" aria-label={`Bellen naar ${site.tel}`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
        <span>Bellen</span>
      </a>
    </div>
  </header>
) : (
  <footer class="bg-racing-deep py-10 text-cream">
    <div class="wrap">
      <div class="chroom opacity-40"></div>
      <div class="mt-8 flex flex-col gap-6 text-sm md:flex-row md:justify-between">
        <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
        <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
      </div>
      {site.voorstel && <p class="mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
    </div>
  </footer>
)}
