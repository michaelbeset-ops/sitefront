---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const diensten = ['Inspectie hef-, hijs- en klimmiddelen', 'Onderhoud transportsystemen', 'Mini loads en hoogbouwkranen', 'Reparatie en revisie', 'Servicecontracten'];
---
<footer class="donker bg-petrol-diep text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Inspectie, onderhoud en revisie van intern transport. Sinds 1980, vanuit Oosterhout.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Diensten</p>
      <ul class="mt-3 space-y-1">{diensten.map((d) => <li><a href={url('#diensten')} class="link link-licht no-underline hover:underline">{d}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp <span class="num">{site.gsm}</span></a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Bereikbaar</p>
      <p class="mt-3 num">ma t/m vr<br />07:30-17:00</p>
      <p class="mt-4"><a href={site.facebook} class="link link-licht">Facebook</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam} · KvK {site.kvk}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-1"><a href={site.voorwaarden} class="link link-licht">Leveringsvoorwaarden (PDF)</a><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen website en Google-bedrijfsprofiel (Van eigenaar). Teksten op basis van kermul.nl.</p>}
</footer>
