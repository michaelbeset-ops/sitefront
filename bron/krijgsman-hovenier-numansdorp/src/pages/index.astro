<script>
  // Projectviewer: tabbladen per project, schuif en pijlen door de stappen.
  const data: { t: string; s: [string, string][] }[] = JSON.parse(document.getElementById('projdata')?.textContent || '[]');
  const v = document.querySelector<HTMLElement>('[data-viewer]');
  if (v && data.length) {
    const foto = v.querySelector<HTMLImageElement>('[data-foto]')!;
    const achter = v.querySelector<HTMLImageElement>('[data-achter]')!;
    const teller = v.querySelector<HTMLElement>('[data-teller]')!;
    const onder = v.querySelector<HTMLElement>('[data-onder]')!;
    const schuif = v.querySelector<HTMLInputElement>('[data-schuif]')!;
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-proj]')];
    let p = 0, i = 0;
    const pad = (n: number) => String(n).padStart(2, '0');
    const toon = () => {
      const [src, o] = data[p].s[i];
      foto.src = src; achter.src = src; foto.alt = `${data[p].t}: ${o}`;
      teller.textContent = `${pad(i + 1)} / ${pad(data[p].s.length)}`; onder.textContent = o;
      schuif.max = String(data[p].s.length); schuif.value = String(i + 1);
      schuif.style.setProperty('--vul', `${(i / (data[p].s.length - 1)) * 100}%`);
    };
    const voorlaad = () => { const v2 = data[p].s[i + 1]; if (v2) { const im = new Image(); im.src = v2[0]; } };
    tabs.forEach((t) => t.addEventListener('click', () => { p = Number(t.dataset.proj); i = 0; tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t))); toon(); voorlaad(); }));
    schuif.addEventListener('input', () => { i = Number(schuif.value) - 1; toon(); voorlaad(); });
    v.querySelector('[data-vorige]')!.addEventListener('click', () => { i = (i - 1 + data[p].s.length) % data[p].s.length; toon(); voorlaad(); });
    v.querySelector('[data-volgende]')!.addEventListener('click', () => { i = (i + 1) % data[p].s.length; toon(); voorlaad(); });
    toon();
  }

  // Aanvraag: bericht samenstellen voor WhatsApp of e-mail (verstuurt zelf niets).
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const via = (e.submitter as HTMLButtonElement | null)?.value || 'wa';
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const wat = d.getAll('wat').map(String);
      const r = ['Hallo Patrick,', '', 'Ik wil graag contact over mijn tuin.'];
      if (wat.length) r.push('Waarvoor: ' + wat.join(', '));
      if (v('contract')) r.push('Contractvorm: ' + v('contract'));
      if (v('plaats')) r.push('Woonplaats: ' + v('plaats'));
      if (v('bericht')) r.push('', v('bericht'));
      if (v('naam')) r.push('', 'Groet, ' + v('naam'));
      const tekst = r.join('\n');
      if (via === 'mail') location.href = 'mailto:info@krijgsmanhovenier.nl?subject=' + encodeURIComponent('Aanvraag via de website') + '&body=' + encodeURIComponent(tekst);
      else window.open('https://wa.me/31648737270?text=' + encodeURIComponent(tekst), '_blank', 'noopener');
    });
  }
</script>

