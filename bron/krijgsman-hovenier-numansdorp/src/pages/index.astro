---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, contracten, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import heroM from '../assets/hero-m.jpg';
import ontwerp from '../assets/ontwerp.jpg';
import aanleg from '../assets/aanleg.jpg';
import beplanting from '../assets/beplanting.jpg';
import onderhoud from '../assets/onderhoud.jpg';
import bus from '../assets/bus.jpg';
import patrick from '../assets/patrick.jpg';
import wTuinhuis from '../assets/w-tuinhuis.jpg';
import wOverkapping from '../assets/w-overkapping.jpg';
import wSchommel from '../assets/w-schommel.jpg';
import wBorder from '../assets/w-border.jpg';

const pf = import.meta.glob<{ default: ImageMetadata }>('../assets/proj/*.jpg', { eager: true });
const foto = (k: string) => pf[`../assets/proj/${k}.jpg`].default;

// Projecten uit hun fotoalbum: volgorde en onderschriften zoals zij ze gaven ("Geraliseerde" verbeterd).
// De titels per project zijn een korte omschrijving van wat op de foto's te zien is.
const projectBron = [
  { id: 'p1', t: 'Achtertuin met tuinhuis', onder: ['Start', 'Aanleg terras 1', 'Plaatsen schutting', 'Aanleg terras 2', 'Voorbereiding tuinhuis', 'Aanleg grindpaden', 'Plantenperkje', 'Realisatie tuinhuis', 'Aanleg zijpad', 'Aanleg pad naar voordeur', 'Verbinding naar zijpad', 'Plantenbak voorzijde', 'Plantenperkje voorzijde', 'Aanzicht tuinhuis', 'Aanzicht voorzijde'] },
  { id: 'p2', t: 'Voortuin met plantenbakken', onder: ['Situatie voor', 'Tijdens 1', 'Tijdens 2', 'Tijdens 3', 'Tijdens 4', 'Tijdens 5', 'Tijdens 6', 'Situatie na', 'Situatie na'] },
  { id: 'p3', t: 'Nieuw terras', onder: ['Situatie voor', 'Tijdens 1', 'Tijdens 2', 'Tijdens 3', 'Tijdens 4', 'Tijdens 5', 'Situatie na', 'Situatie na'] },
  { id: 'p4', t: 'Tuin aan het water', onder: ['Situatie voor', 'Gerealiseerde damwand', 'Composiet schutting', 'Nieuw terras voor', 'Nieuw terras achter', 'Overzicht eindsituatie'] },
];
const projecten = await Promise.all(projectBron.map(async (p) => ({
  ...p,
  stappen: await Promise.all(p.onder.map(async (o, i) => {
    const src = foto(`${p.id}-${String(i + 1).padStart(2, '0')}`);
    const groot = await getImage({ src, width: Math.min(1100, src.width), format: 'webp', quality: 62 });
    return { o, src: groot.src };
  })),
})));
const eerste = projecten[0].stappen;
const heroD = await getImage({ src: hero, widths: [1024, 1536], format: 'avif', quality: 55 });
const heroMob = await getImage({ src: heroM, widths: [480, 640, 800], format: 'avif', quality: 50 });

const vraag = (d: string) => waMet(`Hallo Patrick, ik heb een vraag over ${d.toLowerCase()} voor mijn tuin.`);
const dienstKaarten = [
  { t: 'Tuinontwerp', d: 'Samen bepalen we hoe uw tuin eruit komt te zien, van terras tot beplanting.', src: ontwerp, alt: 'Achtertuin van bovenaf: grijze tegels, kunstgras, een verhoogde border met lavendel en een wit tuinhuisje', pos: '50% 50%' },
  { t: 'Aanleg en renovatie', d: 'Een nieuwe tuin, of uw bestaande tuin helemaal opnieuw.', src: aanleg, alt: 'Nieuw aangelegde tuin met grote tegels, wit grind, een donkere plantenbak en een loungeset', pos: '50% 60%' },
  { t: 'Materialen en beplanting', d: 'Tegels, hout, grind en planten: ik lever het erbij.', src: beplanting, alt: 'Houten plantenbakken vol jonge beplanting op een nieuw terras', pos: '50% 55%' },
  { t: 'Onderhoud', d: 'Wanneer u het vraagt, of vast met een onderhoudscontract.', src: onderhoud, alt: 'Twee in spiraalvorm gesnoeide coniferen naast een woning', pos: '50% 40%' },
];

const werk = [
  { src: wTuinhuis, alt: 'Achtertuin met wit tuinhuis, kunstgras, een verhoogde border en leibomen', groot: true },
  { src: wOverkapping, alt: 'Houten overkapping met vlonder aan de rand van de polder' },
  { src: foto('p1-14'), alt: 'Houten tuinhuis met overkapping achter een rond plantenperk vol witte bloemen' },
  { src: wBorder, alt: 'Nieuwe border met lage beplanting en een leiboom voor een donkere schutting' },
  { src: foto('p2-08'), alt: 'Terras met lichte tegels en gemetselde plantenbakken met lavendel' },
  { src: wSchommel, alt: 'Loungehoek onder een houten overkapping met een hangstoel' },
  { src: foto('p3-08'), alt: 'Donker terras met lichte banen onder een overkapping, met tuinstoelen' },
  { src: foto('p4-06'), alt: 'Eindsituatie: terras, kunstgras en een donkere composiet schutting' },
  { src: foto('p1-15'), alt: 'Voortuin met lavendel en een strak bestraat pad naar de voordeur' },
];

const stappen = [
  ['Neem contact op', 'Bel, mail of app, of vul het formulier in. Ik neem zo spoedig mogelijk contact met u op.'],
  ['Ik kom bij u langs', 'We lopen samen door de tuin en nemen uw wensen door.'],
  ['Duidelijke offerte', 'Alle werkzaamheden worden met u doorgenomen en verwerkt in een duidelijke offerte.'],
  ['Aan de slag', 'Aanleg, renovatie of onderhoud. U hoeft er geen omkijken meer naar te hebben.'],
];

const labels = ['Responsiviteit', 'Stiptheid', 'Kwaliteit', 'Professionaliteit', 'Waarde'];
---
<Base title={`${site.naam} | Hovenier in Numansdorp`} description="Krijgsman Hovenier in Numansdorp: ontwerp, aanleg, renovatie en onderhoud van tuinen, ook met een onderhoudscontract. Patrick Krijgsman, vakbekwaam hovenier sinds 2012.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen overkapping aan de polder -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.5rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <picture><source media="(max-width: 767px)" srcset={heroMob.srcSet.attribute} sizes="100vw" /><img src={heroD.src} srcset={heroD.srcSet.attribute} sizes="100vw" alt="" width="1536" height="1536" fetchpriority="high" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_60%] md:object-[70%_60%]" /></picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#10151140_0%,#101511b8_48%,#101511f5_100%)] md:bg-[linear-gradient(90deg,#101511f2_0%,#101511c7_45%,#10151126_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-10 pb-16 pt-28 md:pb-20 md:pt-32 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Hovenier in Numansdorp</p>
          <h1 id="t-hero" class="mt-6 text-hero">Uw tuin, <span class="text-oranje-licht">mijn zorg.</span></h1>
          <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Ontwerp, aanleg, renovatie en onderhoud van uw tuin. Door {site.eigenaar}, vakbekwaam hovenier.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#contact" class="knop knop-oranje"><Icoon naam="offerte" />Offerte aanvragen</a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-2.5 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 18.00 uur</span></li>
            <li><a href={site.telHref} class="num flex items-center gap-2 font-semibold text-licht no-underline hover:text-oranje-licht"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a></li>
          </ul>
        </div>
        <figure class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto max-w-[21rem] rounded-lg bg-nacht/70 p-6 ring-1 ring-licht/15 backdrop-blur-md">
            <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            <blockquote class="mt-4 text-[1.0625rem] leading-relaxed text-licht">“Fijne communicatie, scherpe offerte, prettig in omgang en harde werker.”</blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-licht/15 pt-4 text-sm text-licht-zacht"><Icoon naam="g" class="h-5 w-5" />Vincent, Google review</figcaption>
          </div>
        </figure>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Werkzaamheden in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="flex shrink-0 items-center gap-2 rounded-sm bg-zand px-3.5 py-2 text-sm font-medium no-underline transition-colors hover:bg-oranje hover:text-wit"><Icoon naam="blad" class="h-4 w-4 opacity-70" />{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-5 text-3xl">Van eerste schets tot vast onderhoud.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een mooie tuin is een fijne plek om in te vertoeven. Het aanleggen, renoveren en onderhouden ervan vraagt tijd en vakmanschap.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-5">
          {dienstKaarten.map((b, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={vraag(b.t)} class="group relative isolate flex aspect-[5/4] flex-col sm:aspect-[4/5] justify-end overflow-hidden rounded-md bg-nacht p-6 text-licht no-underline shadow-sm">
                <Image format="avif" quality={50} src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 290px, (min-width: 640px) 46vw, 92vw" class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]" style={`object-position:${b.pos}`} />
                <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#10151100_20%,#101511f2_100%)]" aria-hidden="true"></span>
                <span class="num absolute left-6 top-6 rounded-sm bg-nacht/70 px-2 py-0.5 font-kop text-sm font-bold text-licht">0{i + 1}</span>
                <h3 class="text-xl">{b.t}</h3>
                <p class="mt-2 text-[.9375rem] text-licht/85">{b.d}</p>
                <span class="mt-5 flex items-center gap-2 text-sm font-semibold text-oranje-licht">Stel uw vraag<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-6 flex flex-col items-start justify-between gap-5 rounded-md bg-zand px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="flex items-start gap-4 text-lg"><Icoon naam="offerte" class="mt-1 h-6 w-6 shrink-0 text-oranje" /><span><b class="font-semibold">Alle werkzaamheden worden met u doorgenomen</b> <span class="text-grijs">en verwerkt in een duidelijke offerte.</span></span></p>
          <a href="#contact" class="knop knop-inkt knop-klein shrink-0">Offerte aanvragen<Icoon naam="pijl" /></a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Diploma vakbekwaam hovenier</dt><dd class="cijfer num order-first text-oranje">2012</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Score op Google</dt><dd class="cijfer num order-first">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Soorten onderhoudscontract</dt><dd class="cijfer num order-first">3</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Bereikbaar ma t/m vr</dt><dd class="cijfer num order-first">8-18</dd></div>
      </dl>
    </section>

    <!-- 5. Projecten: stap voor stap (wow-functie) -->
    <section id="projecten" class="donker bg-nacht py-24 text-licht lg:py-28" aria-labelledby="t-proj">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-4">
          <p class="eyebrow">Projecten</p>
          <h2 id="t-proj" class="mt-5 text-3xl">Van kale grond tot tuin.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Vier projecten uit mijn fotoalbum, stap voor stap. Schuif door de foto’s en zie hoe de tuin ontstaat.</p>
          <div class="-mx-5 mt-9 flex gap-2 overflow-x-auto px-5 [scrollbar-width:none] lg:mx-0 lg:grid lg:overflow-visible lg:px-0" role="tablist" aria-label="Kies een project" data-proj-tabs>
            {projecten.map((p, i) => (
              <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-proj={i} class="proj-tab">
                <span class="num font-kop text-sm font-bold">0{i + 1}</span>
                <span class="flex-1 text-left"><b class="block font-semibold">{p.t}</b><span class="text-sm opacity-75">{p.stappen.length} foto’s</span></span>
                <Icoon naam="pijl" class="h-4 w-4" />
              </button>
            ))}
          </div>
        </div>
        <div class="min-w-0 lg:col-span-8" data-viewer>
          <div class="relative overflow-hidden rounded-lg bg-nacht-2" style="aspect-ratio: 4 / 3">
            <img src={eerste[0].src} alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-40 blur-2xl" data-achter />
            <img src={eerste[0].src} alt={`${projecten[0].t}: ${eerste[0].o}`} width="1100" height="825" decoding="async" loading="lazy" class="relative h-full w-full object-contain" data-foto />
            <p class="absolute left-4 top-4 rounded-sm bg-nacht/80 px-3 py-1.5 text-sm font-semibold backdrop-blur-sm" aria-live="polite"><span class="num text-oranje-licht" data-teller>01 / {String(eerste.length).padStart(2, '0')}</span> <span class="mx-1.5 opacity-40">|</span> <span data-onder>{eerste[0].o}</span></p>
          </div>
          <div class="mt-5 flex items-center gap-4">
            <button type="button" class="pijlknop" data-vorige aria-label="Vorige foto"><Icoon naam="links" class="h-5 w-5" /></button>
            <label class="flex-1"><span class="sr-only">Stap in het project</span><input type="range" min="1" max={eerste.length} value="1" class="schuif w-full" data-schuif /></label>
            <button type="button" class="pijlknop" data-volgende aria-label="Volgende foto"><Icoon naam="pijl" class="h-5 w-5" /></button>
          </div>
          <div class="mt-4 flex justify-between text-sm text-licht-zacht"><span>Situatie voor</span><span>Resultaat</span></div>
        </div>
      </div>
      <script type="application/json" id="projdata" set:html={JSON.stringify(projecten.map((p) => ({ t: p.t, s: p.stappen.map((s) => [s.src, s.o]) })))} />
    </section>

    <!-- 6. Recent werk -->
    <section class="py-20 lg:py-24" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Recent werk</p>
            <h2 id="t-werk" class="mt-5 text-3xl">Terrassen, overkappingen en borders.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-grijs">Een greep uit het werk van de afgelopen jaren. Meer foto’s staan op Facebook.</p>
            <a href={site.facebook} class="knop knop-rand knop-klein mt-6"><Icoon naam="fb" />Bekijk op Facebook</a>
          </div>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14 lg:grid-cols-6">
          {werk.map((w, i) => (
            <li class={`rijs relative overflow-hidden rounded-md bg-zand ${w.groot ? 'col-span-2 row-span-2 aspect-square md:aspect-auto' : 'aspect-square'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image quality={58} src={w.src} alt={w.alt} widths={w.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={w.groot ? '(min-width: 1248px) 400px, (min-width: 1024px) 33vw, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 190px, (min-width: 1024px) 16vw, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Onderhoudscontracten -->
    <section id="onderhoud" class="bg-zand py-20 lg:py-24" aria-labelledby="t-onderhoud">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Onderhoudscontract</p>
            <h2 id="t-onderhoud" class="mt-5 text-3xl">Geen omkijken meer naar uw tuin.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Iedere tuin heeft een onderhoudsplan. Met een contract plan ik het onderhoud, zodat het op het juiste tijdstip gebeurt.</p>
        </div>
        <ul class="mt-12 grid gap-4 lg:mt-14 lg:grid-cols-3 lg:gap-5">
          {contracten.map((c, i) => (
            <li class="rijs kaart flex flex-col p-7 lg:p-8" style={`--d:${i * 0.06}s`}>
              <div class="flex items-center justify-between gap-4">
                <span class="rounded-sm bg-papier px-3 py-1 text-sm font-semibold text-oranje">{c.kort}</span>
                <span class="num font-kop text-sm font-bold text-grijs">0{i + 1}</span>
              </div>
              <h3 class="mt-8 text-2xl">{c.t}</h3>
              <p class="mt-3 flex-1 text-grijs">{c.d}</p>
              <a href={waMet(`Hallo Patrick, ik wil graag meer weten over het ${c.t.toLowerCase()}.`)} class="mt-7 flex items-center gap-2 font-semibold text-oranje no-underline hover:text-oranje-diep">Meer weten<Icoon naam="pijl" class="h-4 w-4" /></a>
            </li>
          ))}
        </ul>
        <div class="rijs donker mt-6 grid gap-6 rounded-md bg-nacht p-7 text-licht md:grid-cols-[auto_1fr_auto] md:items-center lg:p-8">
          <span class="grid h-12 w-12 place-items-center rounded-sm bg-oranje text-wit"><Icoon naam="slot" class="h-6 w-6" /></span>
          <p class="text-lg"><b class="font-semibold">Prijs vooraf vastgelegd, dus geen verrassingen achteraf.</b> <span class="text-licht-zacht">Ik kom bij u langs om alles door te nemen, zodat de verwachtingen over en weer duidelijk zijn.</span></p>
          <a href="#contact" class="knop knop-oranje knop-klein">Afspraak maken</a>
        </div>
      </div>
    </section>

    <!-- 8. Werkwijze -->
    <section class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Zo werken we samen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Eén vaste hovenier, van het eerste gesprek tot het onderhoud.</p>
        </div>
        <ol class="mt-12 grid gap-px overflow-hidden rounded-md bg-lijn sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs bg-papier p-7 lg:p-8" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-5xl font-extrabold leading-none text-oranje">0{i + 1}</p>
              <h3 class="mt-8 text-xl">{t}</h3>
              <p class="mt-3 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 9. Over mij -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[24rem] sm:min-h-[30rem] lg:col-span-6">
          <Image quality={58} src={bus} alt="De bedrijfsbus van Krijgsman Hovenier met logo, telefoonnummer en website" widths={[640, 960, 1300]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[55%_45%]" />
          <figure class="absolute bottom-5 left-5 w-[8.5rem] overflow-hidden rounded-md bg-nacht shadow-md ring-4 ring-nacht sm:w-44">
            <Image quality={58} src={patrick} alt="Patrick Krijgsman bij de Roparun-wagen met zijn logo" widths={[200, 360]} sizes="176px" class="aspect-[3/4] w-full object-cover object-top" />
            <figcaption class="px-3 py-2 text-xs font-semibold">Patrick Krijgsman</figcaption>
          </figure>
        </div>
