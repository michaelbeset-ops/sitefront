---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Kaart from '../components/Kaart.astro';
import { site, url, lijstMail } from '../data/site';
import knoop from '../assets/touw-knoop.jpg';
import kade from '../assets/kade.jpg';

const dagen = [
  { d: 'Maandag', t: '09:00 - 17:00' },
  { d: 'Dinsdag', t: '09:00 - 17:00' },
  { d: 'Woensdag', t: '09:00 - 17:00' },
  { d: 'Donderdag', t: '09:00 - 17:00' },
  { d: 'Vrijdag', t: '09:00 - 17:00' },
  { d: 'Zaterdag', t: 'in overleg' },
  { d: 'Zondag', t: 'gesloten' },
];
---
<Base title="F.E.M.M. Rotterdam | Groothandel in scheepsuitrusting, Noordereiland" description="F.E.M.M. Rotterdam, groothandel en winkel in scheepsuitrusting aan de Maaskade op het Noordereiland. Ma t/m vr 9 tot 5, in overleg levering aan boord. Bel 010 214 08 47.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. De kaart: zoals op de oude femm.nl, maar dan scherp en op elk scherm. -->
    <section class="relative grid border-b border-lijn md:min-h-[calc(100svh-6.6rem)] md:grid-cols-12" aria-labelledby="kop">
      <div class="relative order-1 h-[19.5rem] overflow-hidden border-b border-lijn md:order-2 md:col-span-6 md:h-auto md:border-b-0 md:border-l">
        <Kaart viewBox="250 0 640 640" class="absolute inset-0 h-full w-full" />
        <div class="ballon absolute left-[46%] top-[1.1rem] w-[12.5rem] px-4 py-3 text-sm md:left-[47%] md:top-[18%] md:w-[15.5rem] md:px-5 md:py-4" style="--px:1.1rem" data-ballon>
          <p class="font-extrabold leading-tight">Hier zit F.E.M.M.</p>
          <p class="mono mt-1 text-[.8rem] leading-snug text-staal">{site.straat}<br />aan de Nieuwe Maas</p>
          <a href={site.maps} class="lijn mono mt-2 inline-block text-[.8rem] font-medium">Route plannen</a>
        </div>
        <p class="mono absolute bottom-3 right-4 hidden text-[.72rem] text-staal md:block">51°54′44″ N · 4°29′29″ O</p>
      </div>

      <div class="wrap order-2 flex min-w-0 flex-col justify-between gap-12 pb-10 pt-8 md:order-1 md:col-span-6 md:!pr-10 md:pb-12 md:pt-[clamp(2.5rem,7vh,5rem)]">
        <div class="md:my-auto">
          <h1 id="kop">
            <span class="flex items-end gap-3 text-[clamp(4.1rem,23vw,6rem)] md:text-[clamp(5rem,10.5vw,9.5rem)] leading-[.8] tracking-[-.06em] md:gap-4">F.E.M.M.</span>
            <span class="mt-4 block text-[clamp(1.45rem,2.2vw,2.05rem)] font-medium leading-[1.12] tracking-[-.02em] md:mt-6">Groothandel in scheepsuitrusting, op het Noordereiland in Rotterdam.</span>
          </h1>
          <p class="mt-5 max-w-[34rem] text-lg leading-relaxed text-staal md:mt-7">Winkel en groothandel voor scheepvaartbenodigdheden aan de Maaskade. Wat u nodig heeft, leveren we in overleg ook aan boord.</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4 md:mt-9">
            <a href={site.telHref} class="knop">Bel <span class="tabular-nums">{site.tel}</span></a>
            <a href={lijstMail} class="lijn font-medium">Of mail uw lijst</a>
          </div>
        </div>
        <p class="mono border-t border-lijn pt-4 text-[.82rem] leading-relaxed text-staal">Ma t/m vr 9 tot 5. Daarbuiten in overleg, ook op zaterdag.</p>
      </div>
    </section>

    <!-- 2. Achter de toonbank: wat klanten noemen, één groot beeld. -->
    <section id="toonbank" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="toonbank-kop">
      <div class="wrap grid items-end gap-10 md:grid-cols-12">
        <figure class="relative aspect-[4/3] overflow-hidden md:col-span-7 md:aspect-[16/11]">
          <Foto src={knoop} alt="Een dikke gevlochten tros met een knoop, van dichtbij." sizes="(min-width: 768px) 58vw, 100vw" />
        </figure>
        <div class="md:col-span-5 md:pb-4">
          <h2 id="toonbank-kop" class="text-2xl">Groot assortiment, en iemand die weet waar het ligt.</h2>
          <p class="mt-6 max-w-[30rem] text-lg leading-relaxed text-staal">In de Google-reviews noemen klanten vooral het grote assortiment, de kennis achter de toonbank en de scherpe prijzen. Wie om primer vraagt, heeft hem zo in handen.</p>
          <p class="mono mt-6 text-[.8rem] text-staal">[[AANLEVEREN: hoofdgroepen van het assortiment, bv. verf, touwwerk, beslag]]</p>
        </div>
      </div>
    </section>

    <!-- 3. Aan boord: de marineblauwe band. -->
    <section id="aan-boord" class="op-donker scroll-mt-20 bg-marine text-wit" aria-labelledby="boord-kop">
      <div class="grid md:grid-cols-12">
        <div class="wrap flex flex-col justify-center py-20 md:col-span-7 md:py-28 lg:!pl-[max(3rem,calc((100vw-90rem)/2+3rem))]">
          <h2 id="boord-kop" class="max-w-[14ch] text-3xl">In overleg leveren we aan boord.</h2>
          <p class="mt-7 max-w-[32rem] text-lg leading-relaxed text-mist">Ligt u aan de kade of verderop in de haven? Zet op een rij wat u nodig heeft en laat weten waar het schip ligt. Dan spreken we af hoe het bij u komt.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={lijstMail} class="knop !bg-boei hover:!bg-wit hover:!text-marine">Mail uw lijst</a>
            <a href={site.telHref} class="lijn font-medium text-wit">of bel <span class="tabular-nums">{site.tel}</span></a>
          </div>
        </div>
        <figure class="relative min-h-[22rem] overflow-hidden md:col-span-5">
          <Foto src={kade} alt="Een houten zeilschip aan een steiger, met een groter wit schip erachter." sizes="(min-width: 768px) 42vw, 100vw" class="absolute inset-0" />
        </figure>
      </div>
    </section>

    <!-- 4. Langskomen: tijden, adres, de kleine kaart. -->
    <section id="langskomen" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="langs-kop">
      <div class="wrap grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <h2 id="langs-kop" class="text-2xl">Langskomen aan de Maaskade</h2>
          <p class="mt-6 text-lg leading-relaxed">{site.straat}<br />{site.postcode} {site.plaats} ({site.wijk})</p>
          <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
            <a href={site.maps} class="lijn font-medium">Route plannen</a>
            <a href={site.telHref} class="lijn font-medium tabular-nums">{site.tel}</a>
            <a href={lijstMail} class="lijn font-medium">{site.mail}</a>
          </p>
          <p class="mono mt-10 text-[.8rem] text-staal">Google-reviews: {site.google.score} uit {site.google.aantal}</p>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          <table class="w-full text-left">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {dagen.map((r, i) => (
                <tr class="border-b border-lijn" data-dag={(i + 1) % 7}>
                  <th scope="row" class="py-3 pr-4 font-medium">{r.d}</th>
                  <td class="mono py-3 text-right tabular-nums text-staal">{r.t}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-5 text-staal">Buiten deze tijden in overleg, ook op zaterdag. Bel even van tevoren.</p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  // De tekstballon met zijn puntje precies boven de pin zetten, ook als de kaart anders wordt bijgesneden.
  const ballon = document.querySelector<HTMLElement>('[data-ballon]');
  const pin = document.querySelector<SVGCircleElement>('[data-pin]');
  function zetBallon() {
    if (!ballon || !pin) return;
    const vak = ballon.offsetParent as HTMLElement;
    const v = vak.getBoundingClientRect(), p = pin.getBoundingClientRect();
    const x = p.left + p.width / 2 - v.left, y = p.top - v.top;
    const breed = ballon.offsetWidth, hoog = ballon.offsetHeight;
    const links = Math.max(12, Math.min(x - breed + 44, v.width - breed - 12));
    ballon.style.left = `${links}px`;
    ballon.style.top = `${Math.max(10, y - hoog - 14)}px`;
    ballon.style.setProperty('--px', `${Math.max(8, x - links - 3)}px`);
  }
  zetBallon();
  addEventListener('resize', zetBallon);
  document.fonts?.ready.then(zetBallon);

  // Vandaag in de tabel aanwijzen (Nederlandse tijd), alleen als visuele hulp.
  const dag = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' })).getDay();
  const rij = document.querySelector<HTMLTableRowElement>(`tr[data-dag="${dag}"]`);
  if (rij) {
    rij.classList.add('vandaag');
    rij.querySelector('th')?.insertAdjacentHTML('beforeend', ' <span class="mono text-[.75rem] font-normal text-marine underline decoration-boei decoration-2 underline-offset-4">vandaag</span>');
  }
</script>

<style>
  :global(tr.vandaag) { border-bottom-color: var(--color-marine); }
  :global(tr.vandaag td) { color: var(--color-marine); }
</style>
