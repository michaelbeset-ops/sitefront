---
// Het merkteken uit het oude FEMM-logo: de pyloon van de Erasmusbrug met tuien boven het dek.
import { brugPaden } from '../data/site';
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 48 40" class={cls} fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
  <path d={brugPaden.tuien} stroke-width="1.1" />
  <path d={brugPaden.pyloon} stroke-width="3.2" stroke-linejoin="round" />
  <path d={brugPaden.dek} stroke-width="2.6" />
</svg>
