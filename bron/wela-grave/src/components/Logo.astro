---
// Woordmerk naar hun menuborden: "Wela" cursief in goud, met de ondertitel van het bord eronder.
interface Props { class?: string; licht?: boolean; kop?: boolean }
const { class: cls = '', licht = false, kop = false } = Astro.props;
---
<span class={`inline-flex items-center gap-3 ${cls}`}>
  <svg aria-hidden="true" viewBox="0 0 36 36" class={`h-9 w-9 shrink-0 ${kop ? 'hidden min-[420px]:block' : ''}`}><circle cx="18" cy="18" r="16" fill="none" stroke="currentColor" stroke-width="1.4" class={licht ? 'text-peper' : 'text-goud'} /><path d="M18 7c3.2 3.6 3.2 7.4 0 11-3.2-3.6-3.2-7.4 0-11Zm0 11c4.6-.4 8 1.4 10 5.2-4.6.6-8-1.2-10-5.2Zm0 0c-4.6-.4-8 1.4-10 5.2 4.6.6 8-1.2 10-5.2Z" fill="currentColor" class={licht ? 'text-peper' : 'text-goud'} /></svg>
  <span class="flex flex-col leading-none">
    <span class={`font-display text-2xl font-semibold italic tracking-[-0.01em] ${licht ? 'text-inkt' : 'text-goud'}`}>Wela</span>
    <span class={`mt-1 whitespace-nowrap text-[0.625rem] font-bold uppercase tracking-[0.12em] min-[420px]:tracking-[0.2em] ${licht ? 'text-inkt-zacht' : 'text-goud-zacht'}`}>Asian Inspired Thai Cuisine</span>
  </span>
</span>
