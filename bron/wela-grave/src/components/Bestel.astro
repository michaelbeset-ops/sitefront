---
// Wow-functie "Reserveer of bestel": aan tafel (6-gangenmenu of à la carte) of afhalen, personen, dag, tijd en
// dieetwensen worden een net WhatsApp-bericht aan 06 16 96 98 24. Verstuurt zelf niets: de gast drukt in WhatsApp op verzenden.
// Zonder JS blijft het formulier leesbaar en werkt de WhatsApp-knop gewoon (zonder ingevuld bericht).
import { site } from '../data/site';
const veld = 'mt-1.5 block w-full rounded-lg border border-lijn bg-white px-3.5 py-3 text-inkt shadow-sm transition-colors focus:border-peper';
const keuze = 'relative flex cursor-pointer flex-col rounded-xl bg-white p-4 shadow-sm ring-1 ring-lijn transition-shadow has-[:checked]:ring-2 has-[:checked]:ring-peper has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-peper';
const tijden: string[] = [];
for (let m = 15 * 60; m <= 21 * 60; m += 30) tijden.push(`${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
const dieet = ['Geen vis', 'Geen schaaldieren', 'Vegetarisch', 'Geen noten of pinda', 'Glutenvrij'];
const wa = '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/>';
---
<form id="bestelform" class="licht grid gap-6 rounded-2xl bg-creme p-5 text-inkt shadow-xl sm:p-8 lg:grid-cols-12 lg:gap-8" novalidate>
  <div class="grid min-w-0 content-start gap-5 lg:col-span-7">
    <fieldset>
      <legend class="eyebrow text-peper">1. Hoe wilt u eten?</legend>
      <div class="mt-3 grid grid-cols-2 gap-3">
        <label class={keuze}><input type="radio" name="soort" value="tafel" checked class="sr-only" /><span class="font-display text-xl font-semibold">Aan tafel</span><span class="text-sm text-inkt-zacht">Reserveren</span></label>
        <label class={keuze}><input type="radio" name="soort" value="afhalen" class="sr-only" /><span class="font-display text-xl font-semibold">Afhalen</span><span class="text-sm text-inkt-zacht">Bestellen</span></label>
      </div>
    </fieldset>

    <fieldset data-alleen="tafel">
      <legend class="eyebrow text-peper">2. Welk menu?</legend>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <label class={keuze}><input type="radio" name="menu" value="6-gangenmenu" checked class="sr-only" /><span class="font-display text-xl font-semibold">6-gangenmenu</span><span class="text-sm text-inkt-zacht">Proeverij WELA, vanaf 4 personen</span></label>
        <label class={keuze}><input type="radio" name="menu" value="à la carte" class="sr-only" /><span class="font-display text-xl font-semibold">À la carte</span><span class="text-sm text-inkt-zacht">Kiezen aan tafel</span></label>
      </div>
    </fieldset>

    <fieldset data-alleen="afhalen" hidden>
      <legend class="eyebrow text-peper">2. Uw bestelling</legend>
      <label class="mt-3 block text-sm font-semibold">Wat wilt u afhalen?
        <textarea name="bestelling" rows="3" class={veld} placeholder="Gerechten en aantallen"></textarea>
      </label>
    </fieldset>

    <div class="grid gap-4 sm:grid-cols-3">
      <div>
        <span class="block text-sm font-semibold" id="perslabel">Personen</span>
        <div class="mt-1.5 flex items-center rounded-lg border border-lijn bg-white shadow-sm">
          <button type="button" class="h-12 w-12 shrink-0 text-xl font-bold text-peper transition-colors hover:bg-creme" data-stap="-1" aria-label="Eén persoon minder">&minus;</button>
          <input type="number" name="personen" min="1" max="40" value="4" inputmode="numeric" aria-labelledby="perslabel" class="h-12 w-full min-w-0 border-x border-lijn text-center font-semibold tabular-nums" />
          <button type="button" class="h-12 w-12 shrink-0 text-xl font-bold text-peper transition-colors hover:bg-creme" data-stap="1" aria-label="Eén persoon meer">+</button>
        </div>
      </div>
      <label class="block text-sm font-semibold">Dag
        <select name="dag" class={veld}>
          <option>Woensdag</option><option>Donderdag</option><option>Vrijdag</option><option>Zaterdag</option><option>Zondag</option>
        </select>
      </label>
      <label class="block text-sm font-semibold">Tijd
        <select name="tijd" class={`${veld} tabular-nums`}>
          {tijden.map((t) => <option value={t} selected={t === '18:00'}>{t.replace(':', '.')}</option>)}
        </select>
      </label>
    </div>

    <fieldset>
      <legend class="text-sm font-semibold">Dieetwensen</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {dieet.map((d) => (
          <label class="cursor-pointer rounded-full bg-white px-3.5 py-2 text-sm shadow-sm ring-1 ring-lijn transition-shadow has-[:checked]:bg-peper has-[:checked]:text-white has-[:checked]:ring-peper has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-peper"><input type="checkbox" name="dieet" value={d} class="sr-only" />{d}</label>
        ))}
      </div>
      <label class="mt-3 block text-sm font-semibold">Andere wensen of allergieën <span class="font-normal text-inkt-zacht">(optioneel)</span>
        <input type="text" name="anders" class={veld} />
      </label>
    </fieldset>

    <label class="block text-sm font-semibold">Uw naam <span class="font-normal text-inkt-zacht">(optioneel)</span>
      <input type="text" name="naam" autocomplete="name" class={veld} />
    </label>
  </div>

  <div class="min-w-0 lg:col-span-5">
    <div class="rounded-xl bg-jade p-4 shadow-sm sm:p-5 lg:sticky lg:top-24">
      <p class="eyebrow text-goud-zacht">Uw WhatsApp-bericht</p>
      <div class="mt-3 rounded-xl rounded-tr-sm bg-[#e3f5d8] p-4 text-sm leading-relaxed text-inkt shadow-sm">
        <p class="whitespace-pre-line break-words" aria-live="polite" data-bericht>Hallo WELA, ik wil graag een tafel reserveren.</p>
      </div>
      <p class="mt-3 hidden rounded-lg bg-nacht-2 px-3.5 py-2.5 text-sm text-goud-zacht" data-let aria-live="polite"></p>
      <a href={site.wa} class="btn btn-wa mt-4 w-full" data-wa><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" set:html={wa} />Open in WhatsApp</a>
      <p class="mt-3 text-sm text-creme/80">Liever bellen? <a href={site.telHref} class="whitespace-nowrap font-semibold tabular-nums text-goud underline underline-offset-2">{site.tel}</a></p>
      {site.voorstel && <p class="mt-3 border-t border-lijn-licht pt-3 text-xs text-creme/75">Dit is een ontwerpvoorstel: er wordt niets automatisch verstuurd. De knop opent WhatsApp met het bericht klaar.</p>}
    </div>
  </div>
</form>

<script>
  const f = document.getElementById('bestelform') as HTMLFormElement;
  const OPEN = [3, 4, 5, 6, 0];
  const DAG = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
  const MND = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
  const el = <T extends Element>(s: string) => f.querySelector(s) as unknown as T;
  const bericht = el<HTMLElement>('[data-bericht]');
  const let_ = el<HTMLElement>('[data-let]');
  const knop = el<HTMLAnchorElement>('[data-wa]');
  const pers = f.elements.namedItem('personen') as HTMLInputElement;
  const dagSel = f.elements.namedItem('dag') as HTMLSelectElement;
  const tijdSel = f.elements.namedItem('tijd') as HTMLSelectElement;
  const basis = knop.href.split('?')[0];

  // Nu in Grave (Europe/Amsterdam)
  const p: Record<string, string> = {};
  new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
    .formatToParts(new Date()).forEach((x) => (p[x.type] = x.value));
  const vandaag = new Date(Date.UTC(+p.year, +p.month - 1, +p.day));
  const nuMin = +p.hour * 60 + +p.minute;

  // Dagkeuze: de eerstvolgende 15 open dagen (wo t/m zo). Vandaag alleen als er nog een tijd over is.
  dagSel.innerHTML = '';
  for (let i = 0, n = 0; n < 15 && i < 40; i++) {
    const d = new Date(vandaag); d.setUTCDate(d.getUTCDate() + i);
    if (!OPEN.includes(d.getUTCDay())) continue;
    if (i === 0 && nuMin > 20 * 60 + 30) continue;
    const naam = `${DAG[d.getUTCDay()]} ${d.getUTCDate()} ${MND[d.getUTCMonth()]}`;
    const o = new Option(i === 0 ? `Vandaag, ${naam}` : i === 1 ? `Morgen, ${naam}` : naam.replace(/^./, (c) => c.toUpperCase()), naam);
    o.dataset.vandaag = String(i === 0);
    dagSel.add(o); n++;
  }

  function tijdenBijwerken() {
    const isVandaag = dagSel.selectedOptions[0]?.dataset.vandaag === 'true';
    let eersteVrij: HTMLOptionElement | null = null;
    for (const o of Array.from(tijdSel.options)) {
      const [h, m] = o.value.split(':').map(Number);
      o.disabled = isVandaag && h * 60 + m < nuMin + 30;
      if (!o.disabled && !eersteVrij) eersteVrij = o;
    }
    if (tijdSel.selectedOptions[0]?.disabled && eersteVrij) eersteVrij.selected = true;
  }

  function bijwerken() {
    const soort = (f.elements.namedItem('soort') as RadioNodeList).value;
    const menu = (f.elements.namedItem('menu') as RadioNodeList).value;
    const n = Math.max(1, Math.min(40, Number(pers.value) || 1));
    const dieet = Array.from(f.querySelectorAll<HTMLInputElement>('[name=dieet]:checked')).map((x) => x.value.toLowerCase());
    const anders = (f.elements.namedItem('anders') as HTMLInputElement).value.trim();
    const naam = (f.elements.namedItem('naam') as HTMLInputElement).value.trim();
    const bestelling = (f.elements.namedItem('bestelling') as HTMLTextAreaElement).value.trim();
    f.querySelectorAll<HTMLElement>('[data-alleen]').forEach((x) => (x.hidden = x.dataset.alleen !== soort));
    const wanneer = `${dagSel.value}, ${tijdSel.value.replace(':', '.')} uur`;
    const wensen = [...dieet, anders].filter(Boolean).join(', ');
    const regels = soort === 'tafel'
      ? ['Hallo WELA, ik wil graag een tafel reserveren.', '', `Menu: ${menu === '6-gangenmenu' ? '6-gangenmenu (Proeverij WELA)' : 'à la carte'}`, `Aantal personen: ${n}`, `Wanneer: ${wanneer}`]
      : ['Hallo WELA, ik wil graag een bestelling afhalen.', '', `Bestelling: ${bestelling || '...'}`, `Voor ${n} ${n === 1 ? 'persoon' : 'personen'}`, `Ophalen: ${wanneer}`];
    if (wensen) regels.push(`Dieetwensen: ${wensen}`);
    if (naam) regels.push('', `Groet, ${naam}`);
    const tekst = regels.join('\n');
    bericht.textContent = tekst;
    knop.href = `${basis}?text=${encodeURIComponent(tekst)}`;
    const waarschuw = soort === 'tafel' && menu === '6-gangenmenu' && n < 4;
    let_.hidden = !waarschuw;
    let_.classList.toggle('hidden', !waarschuw);
    let_.textContent = waarschuw ? 'Het 6-gangenmenu is alleen op reservering vanaf 4 personen.' : '';
  }

  f.querySelectorAll<HTMLButtonElement>('[data-stap]').forEach((b) => b.addEventListener('click', () => {
    pers.value = String(Math.max(1, Math.min(40, (Number(pers.value) || 1) + Number(b.dataset.stap))));
    bijwerken();
  }));
  dagSel.addEventListener('change', tijdenBijwerken);
  f.addEventListener('input', bijwerken);
  f.addEventListener('change', bijwerken);
  f.addEventListener('submit', (e) => e.preventDefault());
  tijdenBijwerken();
  bijwerken();
</script>
