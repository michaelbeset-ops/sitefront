---
import { site, url } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const wa = '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/>';
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-lijn-licht bg-nacht/95 text-creme backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="no-underline"><Logo kop /></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={url('#proeverij')} class="no-underline transition-colors hover:text-goud">6-gangenmenu</a></li>
          <li><a href={url('#bestel')} class="no-underline transition-colors hover:text-goud">Reserveer of bestel</a></li>
          <li><a href={url('#contact')} class="no-underline transition-colors hover:text-goud">Openingstijden en route</a></li>
        </ul>
      </nav>
      <a href={site.wa} class="btn btn-wa !px-3.5 !py-2 text-sm"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" set:html={wa} /><span class="sr-only min-[420px]:not-sr-only">WhatsApp</span></a>
    </div>
  </header>
) : (
  <footer class="bg-nacht pb-10 pt-14 text-creme/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-5">{site.straat}<br />{site.postcode} {site.plaats}</p>
      </div>
      <p class="md:col-span-4"><a href={site.wa} class="underline-offset-2 hover:underline">WhatsApp</a> of <a href={site.telHref} class="whitespace-nowrap tabular-nums underline-offset-2 hover:underline">bel {site.tel}</a><br />Wo t/m zo <span class="whitespace-nowrap tabular-nums">15.00 - 21.30</span> uur<br /><span class="text-creme/70">KvK <span class="text-xs">[[AANLEVEREN: KvK-nummer]]</span></span></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 border-t border-lijn-licht pt-6 text-xs text-creme/70">Foto's van uw Google-bedrijfsprofiel en sfeerfoto's via Unsplash, ter illustratie.</p>}
  </footer>
)}
