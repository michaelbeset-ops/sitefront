---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Bestel from '../components/Bestel.astro';
import { site, proeverij, bord } from '../data/site';
import mix from '../assets/wela-mix.jpg';
import interieur from '../assets/interieur.jpg';
import soep from '../assets/soep.jpg';
import mango from '../assets/mango.jpg';
import loempia from '../assets/loempia.jpg';
import wok from '../assets/wok.jpg';
import tafel from '../assets/stock-tafel.jpg';

const dagen = [
  { dag: 'Maandag', wd: 1, tijd: 'Gesloten' },
  { dag: 'Dinsdag', wd: 2, tijd: 'Gesloten' },
  { dag: 'Woensdag', wd: 3, tijd: '15.00 - 21.30' },
  { dag: 'Donderdag', wd: 4, tijd: '15.00 - 21.30' },
  { dag: 'Vrijdag', wd: 5, tijd: '15.00 - 21.30' },
  { dag: 'Zaterdag', wd: 6, tijd: '15.00 - 21.30' },
  { dag: 'Zondag', wd: 0, tijd: '15.00 - 21.30' },
];
const noemen = [
  { kop: 'Authentiek Thais', tekst: 'Zo beschrijven gasten de keuken.' },
  { kop: 'Verse ingrediënten', tekst: 'Komt meerdere keren terug in de reviews.' },
  { kop: 'Het 6-gangenmenu', tekst: 'Waarbij u per gang kiest uit verschillende gerechten.' },
  { kop: 'Rekening met dieetwensen', tekst: 'Geef het gewoon door bij uw reservering of bestelling.' },
  { kop: 'Thaise thee', tekst: 'Wordt in de reviews apart genoemd.' },
  { kop: 'Gastvrij, mooie locatie', tekst: 'Eerst alleen afhalen, nu ook aan tafel eten.' },
];
const wa = '<path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/>';
const bel = '<path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/>';
---
<Base title={`${site.naam}, ${site.sub} | Maasstraat 16, Grave`} description="WELA, Asian Inspired Thai Cuisine aan de Maasstraat 16 in Grave. Aan tafel eten of afhalen, woensdag t/m zondag van 15.00 tot 21.30 uur. Reserveren of bestellen via WhatsApp: 06 16 96 98 24.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative overflow-x-clip bg-nacht text-creme">
      <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true" style="background-image:radial-gradient(circle at 1px 1px,#f5eee2 1px,transparent 0);background-size:22px 22px"></div>
      <div class="wrap relative grid gap-8 pb-12 pt-6 lg:grid-cols-12 lg:gap-10 lg:pb-0 lg:pt-16">
        <div class="lg:col-span-5 lg:pb-20">
          <p class="eyebrow text-goud">Thais restaurant <span aria-hidden="true" class="mx-1.5">&middot;</span> <span class="whitespace-nowrap">Maasstraat 16, Grave</span></p>
          <h1 class="mt-4">
            <span class="block text-4xl font-semibold italic leading-[0.9] text-goud">Wela</span>
            <span class="mt-3 block text-2xl font-medium text-creme">Asian Inspired Thai Cuisine in Grave</span>
          </h1>
          <div class="ornament mt-6 max-w-sm" aria-hidden="true"></div>
          <p class="mt-6 max-w-md text-lg text-creme/85">Aan tafel eten of afhalen, woensdag t/m zondag van 15.00 tot 21.30 uur. Bestelling doorgeven via WhatsApp of kom even bij ons binnen.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#bestel" class="btn btn-wa"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" set:html={wa} />Reserveer of bestel</a>
            <a href={site.telHref} class="btn btn-lijn text-creme"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" set:html={bel} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <dl class="mt-10 grid max-w-md grid-cols-2 gap-6 border-t border-lijn-licht pt-6">
            <div>
              <dt class="text-sm text-creme/75">Google</dt>
              <dd class="mt-1 flex items-baseline gap-2"><span class="font-display text-3xl font-semibold leading-none">{site.google.score}</span><span class="text-goud" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span></dd>
              <dd class="mt-1 text-sm text-creme/75">uit {site.google.aantal} reviews</dd>
            </div>
            <div>
              <dt class="text-sm text-creme/75">Wo t/m zo</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-3xl font-semibold leading-none tabular-nums">15.00</dd>
              <dd class="mt-1 whitespace-nowrap text-sm tabular-nums text-creme/75">tot 21.30 uur</dd>
            </div>
          </dl>
        </div>

        <div class="relative order-first -mx-5 self-start sm:mx-0 lg:order-none lg:col-span-7 lg:-mb-28">
          <figure class="relative overflow-hidden shadow-xl sm:rounded-2xl">
            <div class="aspect-[4/3] sm:aspect-[16/11] lg:aspect-square">
              <Foto src={mix} alt="WELA Mix: loempia's in een bamboemandje, viskoekjes en saté van kip met kroepoek en dipsausjes" class="object-[40%_center]" hero sizes="(min-width: 1024px) 700px, 100vw" />
            </div>
            <figcaption class="absolute right-4 top-4 rounded-lg bg-nacht/85 px-3 py-1.5 text-xs font-semibold text-goud-zacht backdrop-blur-sm">WELA Mix: saté kip, tod man pla en loempia</figcaption>
          </figure>
          <div class="absolute -left-10 bottom-10 hidden w-72 shadow-xl lg:block"><Status /></div>
        </div>
      </div>
    </section>

    <!-- WAT GASTEN NOEMEN -->
    <section class="licht bg-creme pb-16 pt-12 lg:pb-24 lg:pt-20" aria-labelledby="noemen">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <div class="lg:hidden"><div class="-mt-2 mb-10 rounded-xl bg-nacht"><Status /></div></div>
          <p class="eyebrow text-peper">Wat gasten noemen</p>
          <h2 id="noemen" class="mt-3 text-3xl">Wat gasten over WELA schrijven</h2>
          <p class="mt-5 flex items-baseline gap-3"><span class="font-display text-[5rem] font-semibold italic leading-none text-peper">{site.google.score}</span><span class="text-inkt-zacht">uit {site.google.aantal} Google-reviews</span></p>
          <p class="mt-4 text-sm text-inkt-zacht">Samengevat uit de reviews, zonder citaten.</p>
        </div>
        <ol class="grid gap-px overflow-hidden rounded-xl bg-lijn shadow-sm ring-1 ring-lijn sm:grid-cols-2 lg:col-span-8">
          {noemen.map((n, i) => (
            <li class="bg-papier p-6">
              <span class="font-display text-lg italic text-peper">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-1.5 text-xl">{n.kop}</h3>
              <p class="mt-1.5 text-inkt-zacht">{n.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- PROEVERIJ / 6-GANGENMENU -->
    <section id="proeverij" class="scroll-mt-16 bg-jade py-16 text-creme lg:py-24" aria-labelledby="proefkop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-goud">Proeverij WELA</p>
          <h2 id="proefkop" class="mt-3 text-3xl">Het 6-gangenmenu</h2>
          <p class="mt-4 text-creme/85">Alleen op reservering, vanaf 4 personen. Per gang kiest u uit verschillende gerechten.</p>
          <p class="mt-2 text-xs text-creme/75">[[AANLEVEREN: actuele prijs p.p.]]</p>
          <ol class="mt-8 border-t border-lijn-licht">
            {proeverij.map((g, i) => (
              <li class="grid grid-cols-[3rem_1fr] gap-x-3 border-b border-lijn-licht py-4">
                <span class="font-display text-2xl italic leading-none text-goud">{i + 1}</span>
                <div>
                  <h3 class="text-xl">{g.gang}{g.noot && <span class="ml-2 font-body text-xs font-bold uppercase tracking-[0.14em] text-goud-zacht">{g.noot}</span>}</h3>
                  <p class="mt-1 text-creme/85">{g.items.join(' / ')}</p>
                </div>
              </li>
            ))}
          </ol>
          <a href="#bestel" class="btn btn-goud mt-8">Reserveer het 6-gangenmenu <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        <div class="grid content-start gap-4 sm:grid-cols-2 lg:col-span-7 lg:gap-5">
          <figure class="relative overflow-hidden rounded-2xl shadow-xl sm:col-span-2">
            <div class="aspect-[16/10]"><Foto src={soep} alt="Kokossoep met champignons, rode ui en koriander, met op de achtergrond een wokgerecht" sizes="(min-width: 1024px) 700px, 100vw" /></div>
            <figcaption class="absolute bottom-4 left-4 rounded-lg bg-nacht/85 px-3 py-1.5 text-xs font-semibold text-goud-zacht">Gang 2: kleine soep</figcaption>
          </figure>
          <figure class="relative overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[4/3]"><Foto src={loempia} alt="Vier loempia's met een schaaltje zoete chilisaus" sizes="(min-width: 1024px) 340px, (min-width: 640px) 50vw, 100vw" /></div>
          </figure>
          <figure class="relative overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[4/3]"><Foto src={mango} alt="Mango sticky rice met verse mango, mangosorbet, kokosmelk en eetbare bloemen" sizes="(min-width: 1024px) 340px, (min-width: 640px) 50vw, 100vw" /></div>
            <figcaption class="absolute bottom-4 left-4 rounded-lg bg-nacht/85 px-3 py-1.5 text-xs font-semibold text-goud-zacht">Dessert: Mango Sticky Rice</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- VAN HET MENUBORD -->
    <section class="licht bg-papier py-16 lg:py-24" aria-labelledby="bordkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5 lg:order-last">
          <p class="eyebrow text-peper">Van het menubord</p>
          <h2 id="bordkop" class="mt-3 text-3xl">Curry's, wokgerechten en Pad Thai</h2>
          <ul class="mt-6 font-display text-lg font-medium italic leading-relaxed text-inkt sm:text-xl">
            {bord.map((g, i, a) => (
              <li class="inline">{g}{i < a.length - 1 && <span aria-hidden="true" class="mx-2.5 align-middle text-sm not-italic text-peper">&#9670;</span>} </li>
            ))}
          </ul>
          <p class="mt-6 text-inkt-zacht">Aan tafel of om af te halen. Bestelling doorgeven via WhatsApp of kom even bij ons binnen.</p>
          <p class="mt-2 text-xs text-inkt-zacht">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
          <a href="#bestel" class="btn btn-peper mt-8">Bestel om af te halen <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        <div class="grid content-start gap-4 sm:grid-cols-5 lg:col-span-7 lg:gap-5">
          <figure class="overflow-hidden rounded-2xl shadow-sm sm:col-span-3">
            <div class="aspect-[4/3] sm:aspect-[4/5]"><Foto src={tafel} alt="Sfeerbeeld: Thaise gerechten van bovenaf op een houten tafel, met curry, soep, rijst en noedels" sizes="(min-width: 1024px) 450px, (min-width: 640px) 60vw, 100vw" /></div>
          </figure>
          <figure class="overflow-hidden rounded-2xl shadow-sm sm:col-span-2">
            <div class="aspect-[4/3] sm:aspect-[8/15]"><Foto src={wok} alt="Gewokte rijstnoedels met kip, tofu, taugé, rode ui en limoen" class="object-[35%_center]" sizes="(min-width: 1024px) 300px, (min-width: 640px) 40vw, 100vw" /></div>
          </figure>
        </div>
      </div>
    </section>

    <!-- RESERVEER OF BESTEL -->
    <section id="bestel" class="scroll-mt-16 bg-nacht py-16 text-creme lg:py-24" aria-labelledby="bestelkop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-goud">Reserveer of bestel</p>
            <h2 id="bestelkop" class="mt-3 text-3xl">Aan tafel of afhalen, in één WhatsApp geregeld</h2>
          </div>
          <p class="text-creme/85 lg:col-span-5">Kies hoe u wilt eten, met hoeveel personen en wanneer. Uw bericht staat meteen klaar, u hoeft het alleen nog te versturen.</p>
        </div>
        <div class="mt-10"><Bestel /></div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="licht scroll-mt-16 bg-creme py-16 lg:py-24" aria-labelledby="contactkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <p class="eyebrow text-peper">Openingstijden en route</p>
          <h2 id="contactkop" class="mt-3 text-3xl">Aan de Maasstraat in Grave</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2">
            <div>
              <address class="not-italic text-lg">
                <strong class="font-display text-2xl font-semibold">WELA</strong><br />
                {site.straat}<br />{site.postcode} {site.plaats}
              </address>
              <p class="mt-3"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline-offset-4 hover:underline">{site.tel}</a> <span class="text-inkt-zacht">(bellen of WhatsApp)</span></p>
              <div class="mt-6 flex flex-col gap-3">
                <a href={site.wa} class="btn btn-wa"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" set:html={wa} />Stuur een WhatsApp</a>
                <a href={site.maps} class="btn btn-lijn text-inkt hover:!bg-nacht hover:!text-creme hover:!shadow-none">Route plannen</a>
              </div>
            </div>
            <div class="rounded-xl bg-papier p-6 shadow-sm ring-1 ring-lijn">
              <h3 class="text-2xl">Openingstijden</h3>
              <table class="mt-3 w-full text-left">
                <caption class="sr-only">Openingstijden per dag</caption>
                <tbody>
                  {dagen.map((d) => (
                    <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                      <th scope="row" class="py-2.5 font-semibold">{d.dag}</th>
                      <td class={`whitespace-nowrap py-2.5 text-right tabular-nums ${d.tijd === 'Gesloten' ? 'text-inkt-zacht' : 'font-semibold'}`}>{d.tijd}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <figure class="relative overflow-hidden rounded-2xl shadow-xl lg:col-span-5">
          <div class="aspect-[4/5] lg:aspect-auto lg:h-full"><Foto src={interieur} alt="Het restaurant aan de Maasstraat: houten tafels, groene en okergele fluwelen stoelen en warme wandlampen" sizes="(min-width: 1024px) 480px, 100vw" /></div>
          <figcaption class="absolute bottom-4 left-4 rounded-lg bg-nacht/85 px-3 py-1.5 text-xs font-semibold text-goud-zacht">Ook aan tafel eten</figcaption>
        </figure>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-peper); }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  const p: Record<string, string> = {};
  new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short' }).formatToParts(new Date()).forEach((x) => (p[x.type] = x.value));
  const wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(p.weekday);
  document.querySelector(`.dagrij[data-wd="${wd}"]`)?.classList.add('vandaag');
</script>
