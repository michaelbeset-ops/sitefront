---
import Foto from '../components/Foto.astro';
import hero from '../assets/hero.jpg';
import fiets from '../assets/fiets.jpg';
import werkplaats from '../assets/werkplaats.jpg';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site } from '../data/site';

const tijden = [
  ['Maandag', '12.00 tot 17.30'],
  ['Dinsdag', '09.00 tot 17.30'],
  ['Woensdag', '09.00 tot 17.30'],
  ['Donderdag', '09.00 tot 17.30'],
  ['Vrijdag', '09.00 tot 17.30'],
  ['Zaterdag', '09.00 tot 17.30'],
  ['Zondag', 'Gesloten'],
];
const soorten = ['Damesfietsen', 'Herenfietsen', 'E-bikes', 'Transportfietsen', 'Vouwfietsen', 'Mountainbikes', 'Kinderfietsen', 'Jongensfietsen', 'Meisjesfietsen', 'Tweedehands fietsen', 'Windgoo', 'Onderdelen en accessoires'];
// Een greep uit de e-bikes op thebikedoctor.nl, september 2026.
const ebikes = [
  ['Altec Jade E-Bike 518 Wh, 7 versnellingen, mat zwart 53 cm', '1.299'],
  ['Altec Sirius E-bike 518 Wh, N-7, mat zwart 53 cm', '1.499'],
  ['Altec Atlanta E-bike 518 Wh, N-7, voorwielmotor', '1.599'],
  ['Altec Comfort E-bike vouwfiets 20 inch, 7 versnellingen', '1.250'],
];
---
<Base
  title="The Bike Doctor | Fietsenmaker en fietsenwinkel in de binnenstad van Dordrecht"
  description="Fiets laten repareren of een nieuwe fiets kopen in centrum Dordrecht. 2 jaar garantie op het frame en een jaar gratis werkzaamheden. 's-Heer Boeijenstraat 4."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="relative overflow-hidden bg-ink pb-16 pt-10 text-paper lg:pb-28 lg:pt-20">
      <!-- Foto rechts, naar links weggezakt in antraciet zodat de tekst altijd leesbaar blijft. -->
      <div class="absolute inset-0 lg:left-1/3"><Foto src={hero} alt="Monteur richt een fietswiel in de werkplaats" hero sizes="100vw" class="opacity-45 lg:opacity-80" /></div>
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/20"></div>
      <div class="wrap relative grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="font-display font-bold text-orange-bright">Binnenstad Dordrecht, 's-Heer Boeijenstraat 4</p>
          <h1 class="mt-4 text-4xl">Fiets kapot? Wij maken hem weer rijklaar.</h1>
          <p class="mt-6 max-w-xl text-lg text-paper/85">
            The Bike Doctor is de fietsenwinkel in het centrum van Dordrecht waar je je fiets laat repareren.
            Wil je een nieuwe fiets, dan helpen we je daar ook mee.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.mobielHref} class="btn btn-orange">Bel {site.mobiel}</a>
            <a href={site.maps} rel="noopener" class="btn btn-ghost">Route</a>
          </div>
        </div>
        <aside aria-labelledby="open" class="rounded-sm bg-paper p-6 text-ink lg:col-span-4 lg:col-start-9">
          <h2 id="open" class="text-2xl">Openingstijden</h2>
          <table class="mt-4 w-full">
            <caption class="sr-only">Openingstijden per dag</caption>
            <tbody>
              {tijden.map(([d, t]) => (
                <tr class="border-b border-line last:border-0">
                  <th scope="row" class="py-2 text-left font-semibold">{d}</th>
                  <td class={`py-2 text-right tabular-nums ${t === 'Gesloten' ? 'text-ink-soft' : ''}`}>{t}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </aside>
      </div>
    </section>

    <!-- Garantie is het sterkste verkoopargument dat nu diep in hun tekst verstopt zit. -->
    <section id="fietsen" class="wrap scroll-mt-16 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Nieuwe fiets? Dit krijg je erbij.</h2>
          <p class="mt-5 text-ink-soft">Bij elke nieuwe fiets van The Bike Doctor.</p>
        </div>
        <ol class="grid gap-8 sm:grid-cols-3 lg:col-span-7">
          <li class="border-t-4 border-ink pt-4">
            <p class="whitespace-nowrap font-display text-3xl font-black tracking-[-0.04em]">2 jaar</p>
            <p class="mt-2">garantie op het frame</p>
          </li>
          <li class="border-t-4 border-ink pt-4">
            <p class="whitespace-nowrap font-display text-3xl font-black tracking-[-0.04em]">1 jaar</p>
            <p class="mt-2">gratis werkzaamheden</p>
          </li>
          <li class="border-t-4 border-orange pt-4">
            <p class="whitespace-nowrap font-display text-3xl font-black tracking-[-0.04em]">3×</p>
            <p class="mt-2">een gratis onderhoudsbeurt, als het na dat eerste jaar nodig is</p>
          </li>
        </ol>
      </div>

      <div class="mt-16 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <div class="mb-8 aspect-[4/3] overflow-hidden rounded-sm"><Foto src={fiets} alt="Hollandse fiets met krat voor een grachtenpand" sizes="(min-width: 1024px) 460px, 100vw" /></div>
          <h3 class="text-2xl">Wat we verkopen</h3>
          <ul class="mt-5 flex flex-wrap gap-2">
            {soorten.map((s) => <li class="rounded-sm bg-steel px-3 py-1.5 text-sm font-semibold">{s}</li>)}
          </ul>
          <p class="mt-4 text-sm text-ink-soft">[[AANLEVEREN: hoe de productcatalogus gekoppeld wordt, of dat we alleen de soorten tonen]]</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <h3 class="text-2xl">Een greep uit de e-bikes</h3>
          <ul class="mt-5 divide-y divide-line border-y border-line">
            {ebikes.map(([naam, prijs]) => (
              <li class="flex items-baseline justify-between gap-4 py-3">
                <span>{naam}</span>
                <span class="whitespace-nowrap font-display text-lg font-black tabular-nums">€ {prijs}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-sm text-ink-soft">Prijzen van september 2026. Kom langs voor het actuele aanbod.</p>
        </div>
      </div>
    </section>

    <section id="reparatie" class="scroll-mt-16 bg-steel py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="aspect-[4/3] rounded-sm lg:col-span-5 overflow-hidden"><Foto src={werkplaats} alt="Monteur aan het werk aan een racefiets in de werkplaats" sizes="(min-width: 1024px) 460px, 100vw" /></div>
        <div class="self-center lg:col-span-6 lg:col-start-7">
          <h2 class="text-3xl">Reparatie en onderhoud</h2>
          <p class="mt-5 text-lg">Breng je fiets langs in de winkel voor reparatie of onderhoud. Wil je eerst weten of we tijd hebben, bel dan even.</p>
          <p class="mt-4 text-ink-soft">[[AANLEVEREN: vaste prijzen voor de meest gevraagde reparaties, bijvoorbeeld band plakken en onderhoudsbeurt]]</p>
          <a href={site.mobielHref} class="btn btn-orange mt-8">Bel {site.mobiel}</a>
        </div>
      </div>
    </section>

    <section id="contact" class="wrap scroll-mt-16 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Langskomen of bellen</h2>
        <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
        <dl class="mt-6 grid gap-3">
          <div><dt class="text-sm font-semibold text-ink-soft">Mobiel</dt><dd><a href={site.mobielHref} class="font-display text-lg font-extrabold underline decoration-orange decoration-2 underline-offset-4">{site.mobiel}</a></dd></div>
          <div><dt class="text-sm font-semibold text-ink-soft">Winkel</dt><dd><a href={site.telHref} class="font-display text-lg font-extrabold underline decoration-orange decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm font-semibold text-ink-soft">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="font-display text-lg font-extrabold underline decoration-orange decoration-2 underline-offset-4 break-all">{site.mail}</a></dd></div>
        </dl>
      </div>
      <form class="grid gap-4 lg:col-span-6 lg:col-start-7" aria-describedby="form-uit" onsubmit="return false">
        <h3 class="text-2xl">Vraag over je fiets?</h3>
        <label class="grid gap-1 text-sm font-semibold">Naam<input type="text" name="naam" autocomplete="name" class="rounded-sm border border-line bg-white px-3 py-2.5 text-base font-normal" /></label>
        <label class="grid gap-1 text-sm font-semibold">Telefoon of e-mail<input type="text" name="contact" autocomplete="email" class="rounded-sm border border-line bg-white px-3 py-2.5 text-base font-normal" /></label>
        <label class="grid gap-1 text-sm font-semibold">Wat is er met je fiets?<textarea name="bericht" rows="4" class="rounded-sm border border-line bg-white px-3 py-2.5 text-base font-normal"></textarea></label>
        {site.voorstel ? (
          <p id="form-uit" class="rounded-sm bg-steel p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel {site.mobiel} of mail naar{' '}<a href={`mailto:${site.mail}`} class="font-bold underline break-all">{site.mail}</a>.</p>
        ) : (
          <button type="submit" class="btn btn-orange justify-self-start">Verstuur</button>
        )}
      </form>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
