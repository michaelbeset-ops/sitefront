---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 bg-ink text-paper">
    <div class="wrap flex items-center justify-between gap-4 py-3">
      <a href={url('')} class="font-display text-xl font-black tracking-[-0.035em] no-underline">The Bike Doctor</a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href="#reparatie" class="no-underline hover:text-orange-bright">Reparatie</a></li>
          <li><a href="#fietsen" class="no-underline hover:text-orange-bright">Fietsen</a></li>
          <li><a href="#contact" class="no-underline hover:text-orange-bright">Contact</a></li>
        </ul>
      </nav>
      <a href={site.mobielHref} class="btn btn-orange !px-3.5 !py-2 text-sm">Bel ons</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-paper/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-paper">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a><br />[[AANLEVEREN: algemene voorwaarden]]</p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
