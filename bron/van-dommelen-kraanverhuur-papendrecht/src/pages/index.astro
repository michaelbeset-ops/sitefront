<script>
  // Lichtbak
  const data: { t: string; wie: string; fotos: string[] }[] = JSON.parse(document.getElementById('lb-data')?.textContent || '[]');
  const dlg = document.querySelector<HTMLDialogElement>('[data-lichtbak]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  let p = 0, n = 0;
  const toon = () => {
    if (!dlg || !img) return;
    const pr = data[p];
    img.src = pr.fotos[n];
    img.alt = `${pr.t}, foto ${n + 1} van ${pr.fotos.length}`;
    dlg.querySelector('[data-lb-titel]')!.textContent = pr.t;
    dlg.querySelector('[data-lb-wie]')!.textContent = pr.wie;
    dlg.querySelector('[data-lb-teller]')!.textContent = `${n + 1} / ${pr.fotos.length}`;
    dlg.querySelectorAll<HTMLElement>('.lb-pijl').forEach((b) => (b.hidden = pr.fotos.length < 2));
  };
  const stap = (d: number) => { n = (n + d + data[p].fotos.length) % data[p].fotos.length; toon(); };
  document.querySelectorAll<HTMLButtonElement>('[data-project]').forEach((b) => b.addEventListener('click', () => { p = Number(b.dataset.project); n = 0; toon(); dlg?.showModal(); }));
  dlg?.querySelector('[data-lb-dicht]')?.addEventListener('click', () => dlg.close());
  dlg?.querySelector('[data-lb-vorige]')?.addEventListener('click', () => stap(-1));
  dlg?.querySelector('[data-lb-volgende]')?.addEventListener('click', () => stap(1));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') stap(-1); if (e.key === 'ArrowRight') stap(1); });
  let x0 = 0;
  img?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  img?.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) stap(dx < 0 ? 1 : -1); });

  // Inzetplanner: bericht live opbouwen, pas versturen in WhatsApp zelf.
  const form = document.querySelector<HTMLFormElement>('[data-inzet]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const datum = (s: string) => { if (!s) return ''; const d = new Date(s + 'T12:00:00'); return new Intl.DateTimeFormat('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(d); };
  const bericht = () => {
    if (!form) return '';
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) || '').trim();
    const werk = d.getAll('werk').map(String);
    const r = ['Goedendag Herman, ik wil graag de kraan met machinist inhuren.'];
    if (werk.length) r.push('Soort werk: ' + werk.join(', ').toLowerCase());
    if (v('tril') && v('tril') !== 'Weet ik nog niet') r.push('Trilblok nodig: ' + v('tril').toLowerCase());
    if (v('start')) r.push('Vanaf: ' + datum(v('start')));
    if (v('duur')) r.push('Duur: ' + v('duur'));
    if (v('plaats')) r.push('Project in: ' + v('plaats'));
    if (v('wens')) r.push('Toelichting: ' + v('wens'));
    if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam') + (v('bedrijf') ? ', ' + v('bedrijf') : ''));
    else if (v('bedrijf')) r.push('Met vriendelijke groet, ' + v('bedrijf'));
    return r.join('\n');
  };
  const werkBij = () => { if (vb) vb.textContent = bericht(); };
  const st = document.querySelector<HTMLInputElement>('input[name=start]');
  if (st) st.min = new Date().toISOString().slice(0, 10);
  form?.addEventListener('input', werkBij);
  form?.addEventListener('change', werkBij);
  werkBij();
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    window.open('https://wa.me/31610932937?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
  });
</script>

