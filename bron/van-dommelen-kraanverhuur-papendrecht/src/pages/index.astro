  .lichtbak { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #0e0f13f2; }
  .lichtbak::backdrop { background: #0e0f13cc; }
  .lb-pijl { position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 3rem; height: 3rem; background: #15161bcc; color: #fff; transition: background-color .2s; }
