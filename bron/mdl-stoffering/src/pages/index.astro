---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, reviewGroot, waHoi } from '../data/site';

// Eigen foto's van mdlstoffering.nl en het Google-profiel; twee sfeerfoto's van Unsplash. Zie src/assets/BRONNEN.txt en tools/prep.mjs.
import hero from '../assets/hero.jpg';
import slot from '../assets/slot.jpg';
import cWoning from '../assets/c-woning.jpg';
import cProject from '../assets/c-project.jpg';
import cRaam from '../assets/c-raam.jpg';
import plint from '../assets/plint.jpg';
import mikel from '../assets/mikel.jpg';
import showroom from '../assets/showroom.jpg';
import klantVisgraat from '../assets/klant-visgraat.jpg';
import wKeuken from '../assets/w-keuken-lang.jpg';
import wTrappenhuis from '../assets/w-trappenhuis.jpg';
import wTrap from '../assets/w-trap.jpg';
import wLaminaat from '../assets/w-laminaat.jpg';
import wTapijt from '../assets/w-tapijt.jpg';
import wLaminaat2 from '../assets/w-laminaat2.jpg';

// Hun drie diensten, met de lijsten letterlijk van hun eigen site.
const diensten = [
  { t: 'Woningstoffering', d: 'Laminaat, tapijt, vinyl, PVC, marmoleum, karpetten op maat en entree-systemen.', src: cWoning, pos: '50% 60%', alt: 'Open trap bekleed met donker tapijt', bij: 'Bekleding open trap' },
  { t: 'Projectstoffering', d: 'Uw project kunnen wij tot in de puntjes verzorgen. Denk aan opdrachten voor aannemers en VVE’s.', src: cProject, pos: '50% 60%', alt: 'Winkel met nieuwe grijze vloerbedekking en een balie', bij: 'Winkel / showroom' },
  { t: 'Raamdecoratie', d: 'Rolgordijnen, duo rolgordijnen, plissé en duette rolgordijnen, luxaflex, houten jaloezieën en lamellen.', src: cRaam, pos: '50% 50%', alt: 'Wit duo rolgordijn voor een raam met twee plantjes', bij: 'Duo rolgordijn' },
];
const materialen = ['Laminaat', 'Tapijt', 'Vinyl', 'PVC', 'Marmoleum', 'Karpetten op maat', 'Entree-systemen', 'Trapbekleding'];

// Werkwijze uit hun over-ons-pagina (kijken en meten, vrijblijvende offerte, visie) en een review (stof uitkiezen op de zaak).
const stappen = [
  ['Bellen of appen', 'Vertel wat u zoekt: een nieuwe vloer, een trap of raamdecoratie.'],
  ['Stof uitkiezen', 'Op afspraak kiest u bij ons op de zaak de juiste stof of vloer uit.'],
  ['Kijken en meten', 'Wij komen altijd van tevoren bij u kijken en meten.'],
  ['Vrijblijvende offerte', 'U krijgt een vrijblijvende offerte ter goedkeuring.'],
  ['Leggen en afwerken', 'Elke klus met dezelfde zorg en nauwkeurigheid afgewerkt.'],
];

// Merken zoals op hun eigen homepage ("Welke merken kan MDL stoffering leveren?").
const merken = [
  ['Tapijt en vinyl', 'Desso, Parade, Bonaparte, Lano, Belakos, Interfloor, Lethem Vergeer, Heuga, Forbo, Gerflor'],
  ['Laminaat', 'Quick-Step, Berry Floor, Parador, Krono, Witex, Lamett en het MDL huismerk'],
  ['PVC vloeren', 'Moduleo, Belakos, Forinn, Beauflor, M flor'],
];

// Eigen foto's met de titels van hun eigen werkpagina.
const werk = [
  { src: wKeuken, t: 'Vloer keuken', s: 'Woningstoffering', cls: 'lg:col-span-4 lg:row-span-2', ratio: 'aspect-[3/4] lg:aspect-auto lg:h-full', pos: '50% 60%' },
  { src: wTrap, t: 'Trapbekleding', s: 'Woningstoffering', cls: 'lg:col-span-4', ratio: 'aspect-[4/3] lg:aspect-auto lg:h-full', pos: '50% 45%' },
  { src: wTrappenhuis, t: 'Trappenhuis', s: 'Projectstoffering', cls: 'lg:col-span-4', ratio: 'aspect-[4/3] lg:aspect-auto lg:h-full', pos: '40% 60%' },
  { src: wLaminaat, t: 'Laminaat', s: 'Woningstoffering', cls: 'lg:col-span-3', ratio: 'aspect-[4/3] lg:aspect-auto lg:h-full', pos: '50% 60%' },
  { src: wTapijt, t: 'Vloerbedekking', s: 'Woningstoffering', cls: 'lg:col-span-2', ratio: 'aspect-[4/3] lg:aspect-auto lg:h-full', pos: '60% 50%' },
  { src: wLaminaat2, t: 'Laminaat', s: 'Woningstoffering', cls: 'lg:col-span-3', ratio: 'aspect-[4/3] lg:aspect-auto lg:h-full', pos: '50% 70%' },
];

const sterren = [1, 2, 3, 4, 5];
---
<Base title="MDL stoffering | Vloeren, trappen en raamdecoratie in Oosterhout" description="Stoffeerder in Oosterhout: laminaat, tapijt, vinyl, PVC, marmoleum, karpetten op maat en raamdecoratie. Altijd eerst kijken en meten. Bel 06 10 90 52 10.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: sfeerfoto, donker verloop, hun eigen zin -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={hero} alt="" widths={[640, 960, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" quality={64} class="absolute inset-0 -z-20 h-full w-full object-cover object-[66%_70%] md:object-[50%_70%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1b1916b3_0%,#1b191626_26%,#1b1916b8_56%,#1b1916f7_100%)] md:bg-[linear-gradient(90deg,#1b1916f5_0%,#1b1916d9_36%,#1b191666_66%,#1b191626_100%),linear-gradient(180deg,#1b1916b3_0%,#1b191600_30%,#1b191600_70%,#1b1916a6_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-24 pt-36 md:pb-20 lg:pt-52">
        <div class="max-w-[52rem]">
          <p class="eyebrow eyebrow-licht">Stoffeerder in Oosterhout en omstreken</p>
          <h1 id="inhoud" class="mt-6 text-hero">Geen klus is ons te groot of te <span class="text-merk">klein.</span></h1>
          <p class="mt-7 max-w-xl text-xl leading-relaxed text-wit/95 md:text-[1.4rem]">Laminaat, tapijt, vinyl, PVC, marmoleum, karpetten op maat en raamdecoratie. We komen altijd eerst kijken en meten.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#aanvraag" class="knop knop-merk">Vloer aanvragen<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />Bel {site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-3 text-[1rem] text-wit">
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-5 w-5 text-merk" />Familie De Laat, al meer dan 20 jaar</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-5 w-5 text-merk" />Vrijblijvende offerte</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-5 w-5 text-merk" />Woning en project</li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-8 right-10 hidden text-right text-[.875rem] text-wit/70 md:block">Sfeerfoto ter illustratie</p>
    </section>
  </div>

  <main>
    <!-- 2. Diensten: drie fotokaarten met snede -->
    <section id="diensten" class="py-24 md:py-32" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-5 text-4xl">Van de trap tot het raam, in huis en in projecten.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-4 lg:col-start-9" style="--d:.05s">Of het nu om de bekleding van een trap gaat of om hoge kwaliteit marmoleum in een groot kantoorpand: we starten de klus altijd met de grootste zorg.</p>
        </div>
        <ul class="rijs mt-10 flex flex-wrap gap-2.5" aria-label="Wat we leggen">
          {materialen.map((m) => <li class="chip">{m}</li>)}
        </ul>
        <ul class="mt-12 grid gap-6 md:grid-cols-3">
          {diensten.map((v, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <article class="snede group flex h-full flex-col overflow-hidden bg-wit" style="--s:2.2rem">
                <div class="relative overflow-hidden">
                  <Image src={v.src} alt={v.alt} widths={[420, 640]} sizes="(min-width: 768px) 31vw, 100vw" quality={72} class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${v.pos}`} />
                  <span class="absolute bottom-3 left-3 bg-inkt/85 px-2.5 py-1 text-[.875rem] font-semibold text-wol">{v.bij}</span>
                </div>
                <div class="flex flex-1 flex-col p-7 pb-10">
                  <h3 class="text-[1.85rem]">{v.t}</h3>
                  <p class="mt-3 text-steen">{v.d}</p>
                  <a href="#aanvraag" class="mt-auto inline-flex items-center gap-2 pt-7 font-[family-name:var(--font-kop)] font-extrabold text-merk-diep no-underline transition-colors hover:text-inkt">Vraag het aan<Icoon naam="pijl" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. Werkwijze: vijf treden omhoog (donker) -->
    <section id="werkwijze" class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-6">
            <p class="eyebrow eyebrow-licht">Werkwijze</p>
            <h2 id="t-werk" class="mt-5 text-4xl">Eerst kijken en meten. Dan pas leggen.</h2>
          </div>
          <div class="rijs flex items-end gap-6 lg:col-span-5 lg:col-start-8" style="--d:.06s">
            <Image src={plint} alt="Strak afgewerkte witte plint op een eiken laminaatvloer" widths={[200, 400]} sizes="160px" quality={72} class="snede hidden aspect-[4/5] w-36 flex-none object-cover sm:block" style="--s:1rem" />
            <p class="text-lg leading-relaxed text-mist">Wij kijken nu al uit naar onze samenwerking. Laten we er samen iets moois van maken.</p>
          </div>
        </div>
        <ol class="mt-14 grid gap-3 md:grid-cols-5 md:items-end md:gap-2 lg:mt-20">
          {stappen.map(([t, d], i) => (
            <li class="rijs" style={`--d:${i * 0.07}s`}>
              <div class={`snede-l flex flex-col bg-inkt-3 p-6 md:p-7 ${['md:min-h-[13.5rem]', 'md:min-h-[16rem]', 'md:min-h-[18.5rem]', 'md:min-h-[21rem]', 'md:min-h-[23.5rem]'][i]} ${i === 4 ? 'bg-merk text-inkt' : ''}`} style="--s:1.2rem">
                <span class={`stap-nr num ${i === 4 ? 'text-inkt' : ''}`} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-auto pt-8 text-[1.45rem] leading-[1.05]">{t}</h3>
                <p class={`mt-3 text-[1rem] ${i === 4 ? 'text-inkt/85' : 'text-mist'}`}>{d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="rijs mt-6 text-[.9375rem] text-mist">Vijf treden, van eerste telefoontje tot de laatste plint.</p>
      </div>
    </section>

    <!-- 4. Wow: aanvraag met tekening -> vooraf ingevuld WhatsApp -->
    <section id="aanvraag" class="bg-wit py-24 md:py-32" aria-labelledby="t-aanvraag">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Aanvraag</p>
            <h2 id="t-aanvraag" class="mt-5 text-4xl">Stel uw vloer of trap samen.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:self-end" style="--d:.1s">Kies wat u zoekt en u ziet het meteen. Het bericht gaat via WhatsApp naar Mikel; versturen doet u zelf.</p>
        </div>

        <form class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-6 lg:mt-14 lg:grid-cols-12 lg:gap-8" data-plan>
          <div class="min-w-0 space-y-8 bg-wol p-5 sm:p-8 lg:col-span-6">
            <fieldset>
              <legend class="veld-label">Wat zoekt u?</legend>
              <div class="grid grid-cols-2 gap-2.5">
                {[['laminaat', 'Laminaat'], ['pvc', 'PVC'], ['vinyl', 'Vinyl'], ['marmoleum', 'Marmoleum'], ['tapijt', 'Tapijt'], ['karpet', 'Karpet op maat'], ['trap', 'Trap bekleden'], ['raam', 'Raamdecoratie']].map(([v, t]) => (
                  <label class="keuze"><input type="radio" name="wat" value={v} checked={v === 'trap'} />{t}</label>
                ))}
              </div>
            </fieldset>
            <fieldset data-alleen="trap">
              <legend class="veld-label">Soort trap</legend>
              <div class="grid grid-cols-2 gap-2.5">
                <label class="keuze"><input type="radio" name="trap" value="dichte trap" checked />Dichte trap</label>
                <label class="keuze"><input type="radio" name="trap" value="open trap" />Open trap</label>
              </div>
            </fieldset>
            <div data-alleen="trap">
              <label for="treden" class="veld-label">Aantal treden: <span class="num" data-treden-uit>13</span></label>
              <input id="treden" name="treden" type="range" min="3" max="18" value="13" class="w-full accent-[#1b1916]" />
            </div>
            <div class="grid gap-6 sm:grid-cols-[minmax(0,1fr)_9rem]" data-alleen="vloer">
              <div>
                <label for="ruimte" class="veld-label">Welke ruimte?</label>
                <input id="ruimte" name="ruimte" class="veld" placeholder="Bijvoorbeeld woonkamer en hal" />
              </div>
              <div>
                <label for="m2" class="veld-label">Ongeveer m²</label>
                <input id="m2" name="m2" class="veld num" inputmode="numeric" placeholder="35" />
              </div>
            </div>
            <div data-alleen="raam">
              <label for="ramen" class="veld-label">Hoeveel ramen?</label>
              <input id="ramen" name="ramen" class="veld num" inputmode="numeric" placeholder="4" />
            </div>
            <fieldset>
              <legend class="veld-label">Voor</legend>
              <div class="grid grid-cols-2 gap-2.5">
                <label class="keuze"><input type="radio" name="voor" value="woning" checked />Mijn woning</label>
                <label class="keuze"><input type="radio" name="voor" value="project" />Bedrijf, aannemer of VVE</label>
              </div>
            </fieldset>
            <div>
              <label for="plaats" class="veld-label">Plaats</label>
              <input id="plaats" name="plaats" class="veld" placeholder="Bijvoorbeeld Oosterhout" autocomplete="address-level2" />
            </div>
          </div>

          <div class="min-w-0 lg:col-span-6">
            <div class="snede sticky top-6 bg-inkt p-5 text-wit sm:p-8" style="--s:2rem">
              <div class="relative overflow-hidden bg-inkt-2" aria-hidden="true">
                <svg viewBox="0 0 400 260" class="block h-auto w-full" data-beeld></svg>
                <p class="absolute left-3 top-3 bg-inkt/85 px-2.5 py-1 text-[.875rem] font-bold" data-beeld-label>Dichte trap</p>
              </div>
              <p class="mt-2 text-[.875rem] text-mist">Tekening ter illustratie</p>
              <p class="mt-6 text-[.9375rem] font-bold text-mist">Uw bericht</p>
              <p class="mt-2 min-h-[7.5rem] whitespace-pre-line bg-inkt-2 px-4 py-4 text-[1.0625rem] leading-relaxed" data-voorbeeld aria-live="polite"></p>
              <a href={waHoi} class="knop knop-groen mt-5 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <p class="mt-4 text-[.9375rem] text-mist">Of bel: <a href={site.telHref} class="num font-bold text-wit no-underline hover:text-merk">{site.tel}</a></p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 5. Over Mikel + de zaak + merken -->
    <section id="over" class="py-24 md:py-32" aria-labelledby="t-over">
      <div class="wrap grid items-start gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs relative lg:col-span-5">
          <div class="snede bg-inkt" style="--s:2.4rem">
            <Image src={mikel} alt="Mikel de Laat, eigenaar en stoffeerder, in een zwart MDL-shirt" widths={[400, 475]} sizes="(min-width: 1024px) 475px, 90vw" quality={78} class="aspect-[4/5] w-full object-cover object-[50%_30%] sm:max-w-[475px]" />
          </div>
          <figcaption class="mt-4 flex items-baseline justify-between gap-4 text-[.9375rem] text-steen"><span><b class="text-inkt">Mikel de Laat</b>, eigenaar en stoffeerder</span><span>Foto: mdlstoffering.nl</span></figcaption>
        </figure>
        <div class="lg:col-span-7 lg:pt-6">
          <p class="rijs eyebrow">Over Mikel</p>
          <h2 id="t-over" class="rijs mt-5 text-4xl">Met de paplepel ingegoten.</h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-steen" style="--d:.06s">Opgegroeid in een familiebedrijf. Al op zijn 18e nam Mikel de Laat de zaak van zijn vader over, en in de loop der jaren bouwde hij het bedrijf uit. Inmiddels werkt MDL stoffering niet alleen in Oosterhout, maar in de hele regio.</p>
          <blockquote class="rijs mt-9 border-l-[3px] border-merk pl-6 font-[family-name:var(--font-kop)] text-[1.45rem] font-[750] leading-snug tracking-[-.01em]" style="--d:.1s">Door onze ervaring en de liefde voor het vak werken we elke klus met dezelfde zorg en nauwkeurigheid af. Wij zijn pas tevreden als u dat bent.</blockquote>
          <ul class="rijs mt-10 grid gap-3 sm:grid-cols-3" style="--d:.14s">
            {[
              ['Kwaliteit voorop', 'Kwaliteit staat bij ons hoog in het vaandel.'],
              ['Kijken en meten', 'Altijd vooraf, daarna een vrijblijvende offerte.'],
              ['Groot en klein', 'Van één trap tot een heel kantoorpand.'],
            ].map(([t, d]) => (
              <li class="snede-l bg-wit p-5" style="--s:.9rem">
                <b class="block font-[family-name:var(--font-kop)] text-[1.0625rem]">{t}</b>
                <span class="mt-1 block text-[.9375rem] text-steen">{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="wrap mt-20 grid gap-6 lg:mt-28 lg:grid-cols-12 lg:gap-8">
        <figure class="rijs flex flex-col lg:col-span-7">
          <Image src={showroom} alt="De zaak aan De Wetering: rekken met laminaat- en PVC-stalen en een grote werktafel" widths={[640, 960]} sizes="(min-width: 1024px) 56vw, 100vw" quality={74} class="snede aspect-[2.4/1] w-full object-cover lg:aspect-auto lg:min-h-0 lg:flex-1" style="--s:1.6rem" />
          <figcaption class="mt-3 text-[.9375rem] text-steen">De zaak aan {site.straat} in {site.plaats}. Bezoek alleen op afspraak. Foto: Google-profiel MDL stoffering.</figcaption>
        </figure>
        <div class="rijs bg-inkt p-7 text-wol md:p-9 lg:col-span-5" style="--d:.06s">
          <p class="eyebrow eyebrow-licht">Merken</p>
          <p class="mt-4 font-[family-name:var(--font-kop)] text-2xl font-[800] leading-tight tracking-[-.02em]">Welke merken kan MDL stoffering leveren?</p>
          <dl class="mt-6 space-y-4 text-[1rem]">
            {merken.map(([g, m]) => (
              <div class="border-t border-lijn pt-4">
                <dt class="font-bold text-merk">{g}</dt>
                <dd class="mt-1 text-mist">{m}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- 6. Ons werk: eigen foto's met hun eigen titels -->
    <section id="werk" class="bg-wit py-24 md:py-32" aria-labelledby="t-werkfoto">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Ons werk</p>
            <h2 id="t-werkfoto" class="mt-5 text-4xl">Bekijk wat we voor onze klanten hebben gedaan.</h2>
          </div>
          <p class="rijs max-w-md text-steen lg:col-span-4 lg:col-start-9" style="--d:.05s">Eigen foto's van mdlstoffering.nl, met de titels van de eigen werkpagina.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-12 lg:grid-rows-[17rem_21rem]">
          {werk.map((p, i) => (
            <li class={`rijs ${p.cls}`} style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="group relative h-full overflow-hidden bg-inkt">
                <Image src={p.src} alt={`${p.t}, ${p.s.toLowerCase()}`} widths={[400, 720]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" quality={72} class={`${p.ratio} w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]`} style={`object-position:${p.pos}`} />
                <figcaption class="absolute inset-x-0 bottom-0 bg-[linear-gradient(180deg,#1b191600,#1b1916e6)] px-5 pb-5 pt-16 text-wit">
                  <b class="block font-[family-name:var(--font-kop)] text-[1.2rem] leading-tight">{p.t}</b>
                  <span class="mt-1 block text-[.9375rem] text-wit/85">{p.s}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Reviews -->
    <section class="py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-6 py-5 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-10 w-10 flex-none" />
            <span>
              <b class="block font-[family-name:var(--font-kop)] text-xl text-inkt">Alle reviews op Google</b>
              <span class="mt-0.5 block text-steen">MDL stoffering, {site.plaats}</span>
            </span>
          </a>
        </div>

        <figure class="rijs mt-12 grid overflow-hidden bg-inkt text-wol lg:mt-14 lg:grid-cols-12">
          <div class="relative lg:col-span-6">
            <Image src={klantVisgraat} alt="Visgraatvloer in een woonkamer met een tv-wand, foto van de klant" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" quality={72} class="aspect-[4/3] h-full w-full object-cover" />
            <span class="absolute bottom-3 left-3 bg-inkt/85 px-2.5 py-1 text-[.875rem] font-semibold">Foto van Mathijs B. bij zijn review</span>
          </div>
          <div class="flex flex-col p-7 md:p-10 lg:col-span-6 lg:p-12">
            <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</div>
            <blockquote class="mt-6 font-[family-name:var(--font-kop)] text-[clamp(1.35rem,1.2vw+1rem,1.9rem)] font-[700] leading-[1.3] tracking-[-.01em]">“{reviewGroot.tekst}”</blockquote>
            <figcaption class="mt-auto pt-8 text-mist"><b class="text-wol">{reviewGroot.naam}</b>, Google review, {reviewGroot.wanneer}</figcaption>
          </div>
        </figure>

        <ul class="mt-6 grid gap-6 md:grid-cols-2">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${(i % 2) * 0.06}s`}>
              <figure class="kaart flex h-full flex-col p-8">
                <div class="flex gap-0.5 text-merk-diep" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</div>
                <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5">
                  <span class="grid h-11 w-11 flex-none place-items-center bg-wol-2 font-[family-name:var(--font-kop)] text-lg font-bold">{r.naam[0]}</span>
                  <span><b class="block">{r.naam}</b><span class="text-[.9375rem] text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8. Contact -->
    <section id="contact" class="border-t border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-contact">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Contact</p>
          <h2 id="t-contact" class="rijs mt-5 text-4xl">Wij staan voor u klaar.</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-steen">Wij horen graag van u via telefoon, WhatsApp of mail. Vraag vrijblijvend een offerte aan.</p>
          <p class="rijs mt-8"><a href={site.telHref} class="num font-[family-name:var(--font-kop)] text-[clamp(2.1rem,8vw,4.6rem)] font-[850] leading-none tracking-[-.035em] text-inkt no-underline transition-colors hover:text-merk-diep">{site.tel}</a></p>
          <div class="rijs mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--d:.1s">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" />Bellen</a>
            <a href={`mailto:${site.mail}`} class="knop knop-rand">{site.mail}</a>
          </div>
        </div>
        <div class="rijs lg:col-span-5" style="--d:.15s">
          <div class="snede bg-wol" style="--s:2rem">
            <div class="flex items-start gap-4 border-b border-lijn-licht px-7 py-6">
              <Icoon naam="pin" class="mt-1 h-6 w-6 flex-none text-merk-diep" />
              <div>
                <p class="font-[family-name:var(--font-kop)] text-xl font-extrabold">De zaak</p>
                <p class="mt-1 text-steen">{site.straat}<br />{site.postcode} {site.plaats}</p>
                <a href={site.route} class="link mt-3 inline-block font-bold">Route plannen</a>
              </div>
            </div>
            <div class="flex items-start gap-4 px-7 py-6 pb-10">
              <Icoon naam="klok" class="mt-1 h-6 w-6 flex-none text-merk-diep" />
              <div>
                <p class="font-[family-name:var(--font-kop)] text-xl font-extrabold">Bezoek alleen op afspraak</p>
                <p class="mt-1 text-steen">Bel of app even, dan spreken we een moment af. Op de zaak of bij u thuis om te kijken en te meten.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Slotbalk -->
    <section class="relative isolate overflow-hidden bg-inkt text-wit" aria-label="Offerte aanvragen">
      <Image src={slot} alt="" widths={[800, 1400, 2000]} sizes="100vw" quality={60} class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_70%] opacity-50" />
      <div class="wrap flex flex-col items-start justify-between gap-6 py-16 md:flex-row md:items-center md:py-20">
        <p class="max-w-3xl font-[family-name:var(--font-kop)] text-[clamp(2rem,2.6vw+1rem,3.2rem)] font-[850] leading-none tracking-[-.035em]">Laten we er samen iets <span class="text-merk">moois</span> van maken.</p>
        <a href={waHoi} class="knop knop-merk shrink-0"><Icoon naam="wa" />Kijken en meten</a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  // Aanvraag: tekening per keuze + bericht -> vooraf ingevuld WhatsApp.
  const f = document.querySelector<HTMLFormElement>('[data-plan]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const svg = document.querySelector<SVGSVGElement>('[data-beeld]');
  const lab = document.querySelector<HTMLElement>('[data-beeld-label]');
  const tu = document.querySelector<HTMLElement>('[data-treden-uit]');
  const NS = 'http://www.w3.org/2000/svg';
  let zaad = 7;
  const rnd = () => { zaad = (zaad * 9301 + 49297) % 233280; return zaad / 233280; };
  const el = (tag: string, at: Record<string, string | number>, ouder: Element = svg!) => { const e = document.createElementNS(NS, tag); for (const k in at) e.setAttribute(k, String(at[k])); ouder.appendChild(e); return e; };
  const kies = (a: string[]) => a[Math.floor(rnd() * a.length)];
  const namen: Record<string, string> = { laminaat: 'laminaat', pvc: 'een PVC vloer', vinyl: 'een vinylvloer', marmoleum: 'marmoleum', tapijt: 'tapijt', karpet: 'een karpet op maat', trap: 'trapbekleding', raam: 'raamdecoratie' };
  const labels: Record<string, string> = { laminaat: 'Laminaat', pvc: 'PVC', vinyl: 'Vinyl', marmoleum: 'Marmoleum', tapijt: 'Tapijt', karpet: 'Karpet op maat' };

  function planken(tinten: string[], h = 26, l = 170) {
    for (let y = 0, i = 0; y < 260; y += h, i++) for (let x = -((i * 67) % l); x < 400; x += l) el('rect', { x, y, width: l, height: h, fill: kies(tinten), stroke: '#00000030', 'stroke-width': .7 });
  }
  function korrel(basis: string, stip: string[], n = 2600, r = 1.3) {
    el('rect', { x: 0, y: 0, width: 400, height: 260, fill: basis });
    for (let i = 0; i < n; i++) el('rect', { x: rnd() * 400, y: rnd() * 260, width: r, height: r, fill: kies(stip) });
  }
  function teken(wat: string, trap: string, treden: number) {
    if (!svg) return;
    zaad = 7; svg.innerHTML = '';
    if (wat === 'laminaat') planken(['#c79a62', '#bb8d55', '#d2a76f', '#b58650', '#c4975e']);
    else if (wat === 'pvc') planken(['#a49685', '#9a8c7b', '#ae9f8d', '#928473', '#a69886'], 30, 200);
    else if (wat === 'vinyl') { for (let y = 0; y < 260; y += 65) for (let x = 0; x < 400; x += 100) el('rect', { x, y, width: 100, height: 65, fill: kies(['#7d7a75', '#85827c', '#77746f']), stroke: '#5f5c58', 'stroke-width': 1 }); }
    else if (wat === 'marmoleum') korrel('#b9a98c', ['#a39377', '#cbbd9f', '#8f8068', '#d8ccb2'], 2200, 2);
    else if (wat === 'tapijt') korrel('#4a4440', ['#57504b', '#3d3834', '#625a54', '#433d39'], 4200, 1.6);
    else if (wat === 'karpet') {
      planken(['#c79a62', '#bb8d55', '#d2a76f', '#b58650']);
      el('rect', { x: 60, y: 45, width: 280, height: 170, fill: '#6b5f55' });
      el('rect', { x: 72, y: 57, width: 256, height: 146, fill: 'none', stroke: '#d4a43e', 'stroke-width': 4 });
      zaad = 3; for (let i = 0; i < 900; i++) el('rect', { x: 80 + rnd() * 240, y: 65 + rnd() * 130, width: 1.4, height: 1.4, fill: kies(['#7a6d62', '#5e534a']) });
    } else if (wat === 'raam') {
      el('rect', { x: 0, y: 0, width: 400, height: 260, fill: '#e8e2d8' });
      el('rect', { x: 80, y: 30, width: 240, height: 200, fill: '#9fb4c0' });
      el('rect', { x: 80, y: 30, width: 240, height: 200, fill: 'none', stroke: '#ffffff', 'stroke-width': 10 });
      for (let y = 36; y < 200; y += 22) el('rect', { x: 85, y, width: 230, height: 12, fill: '#f7f4ef' });
      el('rect', { x: 78, y: 22, width: 244, height: 12, fill: '#cfc7b9' });
      el('rect', { x: 70, y: 230, width: 260, height: 8, fill: '#cfc7b9' });
    } else {
      // Trap van opzij: n treden, tapijt op de treden (en de stootborden bij een dichte trap).
      el('rect', { x: 0, y: 0, width: 400, height: 260, fill: '#e8e2d8' });
      const open = trap === 'open trap';
      const sx = 330 / treden, sy = 220 / treden;
      for (let i = 0; i < treden; i++) {
        const x = 30 + i * sx, y = 240 - (i + 1) * sy;
        if (!open) el('rect', { x, y, width: 400 - x, height: sy, fill: '#5a514b' });
        el('rect', { x: x - 2, y: y - 4, width: open ? sx + 10 : 400 - x + 2, height: open ? 7 : 6, fill: '#3e3833' });
      }
      if (open) el('line', { x1: 24, y1: 244, x2: 30 + treden * sx, y2: 240 - treden * sy, stroke: '#f3efe8', 'stroke-width': 6 });
      el('rect', { x: 0, y: 240, width: 400, height: 20, fill: '#c79a62' });
    }
  }
  if (f && vb && knop) {
    const zet = () => {
      const d = new FormData(f);
      const wat = String(d.get('wat'));
      const trap = String(d.get('trap'));
      const treden = Number(d.get('treden'));
      const groep = wat === 'trap' ? 'trap' : wat === 'raam' ? 'raam' : 'vloer';
      f.querySelectorAll<HTMLElement>('[data-alleen]').forEach((e) => { e.style.display = e.dataset.alleen === groep ? '' : 'none'; });
      if (tu) tu.textContent = String(treden);
      teken(wat, trap, treden);
      if (lab) lab.textContent = groep === 'trap' ? `${trap.charAt(0).toUpperCase() + trap.slice(1)}, ${treden} treden` : groep === 'raam' ? 'Duo rolgordijn' : labels[wat];
      const ruimte = String(d.get('ruimte') || '').trim();
      const m2 = String(d.get('m2') || '').replace(/[^\d,.]/g, '');
      const ramen = String(d.get('ramen') || '').replace(/[^\d]/g, '');
      const plaats = String(d.get('plaats') || '').trim();
      const voor = String(d.get('voor'));
      const r = [`Hallo Mikel, ik ben op zoek naar ${namen[wat]}${voor === 'project' ? ' voor een project (bedrijf, aannemer of VVE)' : ' voor mijn woning'}.`];
      if (groep === 'trap') r.push(`Het gaat om een ${trap} met ongeveer ${treden} treden.`);
      if (groep === 'vloer' && (ruimte || m2)) r.push(`Ruimte: ${ruimte || 'nog niet bekend'}${m2 ? `, ongeveer ${m2} m²` : ''}.`);
      if (groep === 'raam' && ramen) r.push(`Het gaat om ${ramen} ${ramen === '1' ? 'raam' : 'ramen'}.`);
      if (plaats) r.push(`Plaats: ${plaats}.`);
      r.push('Kunnen jullie komen kijken en meten?');
      const t = r.join('\n');
      vb.textContent = t; knop.href = `${site.wa}?text=${encodeURIComponent(t)}`;
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
