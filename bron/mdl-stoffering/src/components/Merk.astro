---
// Hun eigen logo van mdlstoffering.nl (bron/site/img/2015_06_MDLstoffering1.png), bijgesneden; wit voor op donker.
import { Image } from 'astro:assets';
import { url } from '../data/site';
import wit from '../assets/logo-wit.png';
import zwart from '../assets/logo-zwart.png';
interface Props { donker?: boolean; class?: string }
const { donker = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class={`inline-block no-underline ${cls}`}>
  <Image src={donker ? zwart : wit} alt="MDL stoffering" widths={[120, 240, 360]} sizes="120px" class="h-auto w-[104px] sm:w-[120px]" loading="eager" />
  <span class="sr-only">, naar de homepage</span>
</a>
