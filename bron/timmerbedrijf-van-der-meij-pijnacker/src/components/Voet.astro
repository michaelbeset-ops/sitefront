---
import { Image } from 'astro:assets';
import { site, url, chips, plaatsen, waOfferte } from '../data/site';
import Icoon from './Icoon.astro';
import merk from '../assets/merk.png';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <span class="grid h-12 w-12 place-items-center rounded-md bg-licht"><Image src={merk} alt="" width={84} class="!w-8" /></span>
        <span><b>Van der Meij</b><small>Timmerbedrijf</small></span>
      </a>
      <p class="mt-6 max-w-xs">Overkappingen, veranda’s, bergingen en buitenverblijven, op maat of als bouwpakket opgebouwd. Mike van der Meij, timmerman uit Pijnacker.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-petrol" aria-label="Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
        <a href={site.reviews} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-petrol" aria-label="Google-reviews"><Icoon naam="ster" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {chips.slice(0, 7).map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-ijs">{c}</a></li>)}
      </ul>
    </div>
    <div class="order-last col-span-2 sm:order-none sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-ijs">{site.tel}</a></li>
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-ijs">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="no-underline transition-colors hover:text-ijs">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-xs">Postadres, geen bezoekadres</span></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Werkgebied</p>
      <p class="mt-4">Regio Zuid-Holland, onder meer:</p>
      <p class="mt-2">{plaatsen.join(', ')}.</p>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-ijs">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw eigen website en Google-bedrijfsprofiel, ter illustratie. Reviews letterlijk van Google (stand 3 oktober 2026).</p>}
  </div>
</footer>
