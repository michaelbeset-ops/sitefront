  </main>
  <Voet />
</Base>

<script>
  // Voor/na-schuif en tabs.
  document.querySelectorAll<HTMLElement>('.vergelijk').forEach((v) => {
    const r = v.querySelector<HTMLInputElement>('.schuif');
    r?.addEventListener('input', () => v.style.setProperty('--pos', r.value + '%'));
  });
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    document.querySelectorAll<HTMLElement>('[data-paneel]').forEach((p) => p.classList.toggle('hidden', p.dataset.paneel !== t.dataset.tab));
  }));

  // Dienstkaart kiest alvast de klus in het formulier.
  document.querySelectorAll<HTMLAnchorElement>('[data-klus]').forEach((a) => a.addEventListener('click', () => {
    const i = document.querySelector<HTMLInputElement>(`input[name=klus][value="${a.dataset.klus}"]`);
    if (i) i.checked = true;
  }));

  // Aanvraag samenstellen: WhatsApp of e-mail met ingevuld bericht.
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  const bericht = () => {
    const d = new FormData(f!);
    const v = (n: string) => String(d.get(n) || '').trim();
    const r = ['Hallo Mike, ik wil graag een prijsopgave aanvragen.'];
    if (v('klus')) r.push('Klus: ' + v('klus'));
    if (v('soort')) r.push('Soort: ' + v('soort'));
    if (v('merk')) r.push('Merk: ' + v('merk'));
    if (v('maat')) r.push('Afmetingen: ' + v('maat'));
    if (v('plaats')) r.push('Plaats: ' + v('plaats'));
    if (v('wens')) r.push('Toelichting: ' + v('wens'));
    if (v('naam')) r.push('Groet, ' + v('naam'));
    return r.join('\n');
  };
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31620567173?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
    f.querySelector('[data-mail]')?.addEventListener('click', () => {
      location.href = 'mailto:mail@timmervandermeij.nl?subject=' + encodeURIComponent('Aanvraag prijsopgave') + '&body=' + encodeURIComponent(bericht());
    });
  }
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: .98; letter-spacing: -0.035em; }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover .tegel { transform: scale(1.04); }

  .tab { flex: none; min-height: 2.75rem; padding: 0 1.1rem; border-radius: var(--radius-sm); background: #fff; font-size: .9375rem; font-weight: 600; box-shadow: inset 0 0 0 1px var(--color-lijn); cursor: pointer; transition: background-color .2s, color .2s; }
  .tab:hover { background: var(--color-papier); }
  .tab[aria-selected='true'] { background: var(--color-inkt); color: var(--color-licht); box-shadow: none; }

  .vergelijk .voor { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .vergelijk .label { position: absolute; top: 1rem; padding: .3rem .7rem; border-radius: var(--radius-sm); background: #0f1d24cc; color: #fff; font-size: .8125rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; pointer-events: none; }
  .vergelijk .greep { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; margin-left: -1.5px; background: #fff; pointer-events: none; box-shadow: 0 0 12px #0006; }
  .vergelijk .greep > span { position: absolute; top: 50%; left: 50%; display: flex; gap: .1rem; align-items: center; justify-content: center; width: 3rem; height: 3rem; margin: -1.5rem 0 0 -1.5rem; border-radius: 999px; background: #fff; color: var(--color-petrol); box-shadow: var(--shadow-md); }
  .vergelijk .schuif { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .vergelijk:has(.schuif:focus-visible) { outline: 3px solid var(--color-petrol); outline-offset: 3px; }

  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-sm); background: var(--color-zand); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #e4dccf; }
  .keuze input:checked + span { background: var(--color-petrol); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-petrol); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-sm); border: 1.5px solid #13212a33; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #13212a66; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-petrol); }
  .veld::placeholder { color: #7a858b; }
</style>
