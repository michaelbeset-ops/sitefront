            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-zand font-kop font-bold text-petrol" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <!-- 11. Offerte: bericht samenstellen -->
    <section id="offerte" class="bg-zand py-20 lg:py-24" aria-labelledby="t-offerte">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-offerte" class="mt-5 text-3xl">Vertel wat u wilt laten bouwen.</h2>
          <p class="mt-6 text-lg text-grijs">Stel hier uw aanvraag samen en stuur hem via WhatsApp of e-mail. Mike streeft ernaar binnen 2 werkdagen te reageren.</p>
          <ul class="mt-10 grid grid-cols-1 gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-petrol text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-petrol" /></a></li>
            <li><a href={mailOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-zand text-petrol"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-petrol" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-zand text-petrol"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Overdag staat Mike op de bouw</span></span><Icoon naam="pijl" class="h-5 w-5 text-petrol" /></a></li>
          </ul>
          <p class="mt-6 flex items-start gap-3 text-sm text-grijs"><Icoon naam="pin" class="mt-0.5 h-5 w-5 shrink-0 text-petrol" /><span>{site.straat}, {site.postcode} {site.plaats}. Dit is een postadres, geen bezoekadres. Werkgebied: regio Zuid-Holland, onder meer {plaatsen.slice(0, 5).join(', ')}.</span></p>
        </div>
        <form class="kaart min-w-0 p-5 sm:p-8 lg:col-span-7 lg:p-10" data-aanvraag aria-describedby="aanvraag-uitleg">
          <h3 class="text-2xl">Uw aanvraag aan Mike</h3>
          <p id="aanvraag-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp of uw mailprogramma zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat wilt u laten bouwen?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {klussen.map((k) => (
                <label class="keuze"><input type="radio" name="klus" value={k} class="sr-only" /><span>{k}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid grid-cols-2 gap-4 sm:gap-5">
            <label class="col-span-2 block sm:col-span-1"><span class="text-sm font-semibold">Maatwerk of bouwpakket</span>
              <select name="soort" class="veld mt-2">
                <option value="">Weet ik nog niet</option>
                <option>Maatwerk, graag een ontwerp op maat</option>
                <option>Ik heb al een bouwpakket</option>
              </select>
            </label>
            <label class="col-span-2 block sm:col-span-1"><span class="text-sm font-semibold">Merk bouwpakket <span class="font-normal text-grijs">(optioneel)</span></span><input name="merk" class="veld mt-2" placeholder="Bijvoorbeeld Hillhout" /></label>
            <label class="block"><span class="text-sm font-semibold">Afmetingen, ongeveer</span><input name="maat" class="veld mt-2" placeholder="Bijv. 500 x 300 cm" /></label>
            <label class="block"><span class="text-sm font-semibold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" /></label>
            <label class="col-span-2 block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="col-span-2 block"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Materiaal, dakbedekking, verlichting, of een link naar het model"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <button type="submit" class="knop knop-petrol"><Icoon naam="wa" />Verstuur via WhatsApp</button>
            <button type="button" class="knop knop-rand" data-mail><Icoon naam="mail" />Of per e-mail</button>
          </div>
          <p class="mt-4 text-sm text-grijs">Een foto of weblink werkt ook goed. Stuur die daarna gewoon mee.</p>
        </form>
      </div>
    </section>

    <!-- 12. Slotbalk -->
    <section class="relative isolate overflow-hidden bg-petrol text-wit" aria-label="Offerte aanvragen">
      <Image src={vakwerk} alt="" widths={[960, 1280]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_50%] opacity-20 mix-blend-luminosity" />
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.875rem,2vw+1.2rem,2.75rem)]">Plannen voor uw tuin?</h2>
          <p class="mt-2 text-lg text-wit/90">Vraag kosteloos een prijsindicatie aan.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#offerte" class="knop knop-wit">Offerte aanvragen<Icoon naam="pijl" /></a>
          <a href={waOfferte} class="knop knop-rand op-foto"><Icoon naam="wa" />WhatsApp</a>
        </div>
      </div>
