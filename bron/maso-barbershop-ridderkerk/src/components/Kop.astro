---
import { url, waDruk, site } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<header class="donker sticky top-0 z-40 border-b border-lijn-licht bg-nacht/95 text-licht backdrop-blur-sm">
  <div class="wrap grid h-[4.5rem] grid-cols-[1fr_auto] items-center md:grid-cols-[1fr_auto_1fr]">
    <a href={url('')} class="merk justify-self-start">
      <b>MASO</b><small>Hair salon &amp; barbershop</small>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden md:block">
      <ul class="ui flex gap-9">
        <li><a href={h('werk')} class="lijn-in">Werk</a></li>
        <li><a href={h('langskomen')} class="lijn-in">Langskomen</a></li>
        <li><a href={h('tijden')} class="lijn-in">Tijden</a></li>
      </ul>
    </nav>
    <p class="ui flex items-center justify-end gap-8">
      <a href={site.telHref} class="lijn-in num hidden lg:inline">{site.tel}</a>
      <a href={waDruk} class="lijn-in">WhatsApp</a>
    </p>
  </div>
</header>
