            <label class="block"><span class="text-sm font-semibold">Dagdeel</span>
              <select name="deel" class="veld mt-2">
                <option value="">Maakt niet uit</option>
                <option>Ochtend</option>
                <option>Middag</option>
                <option>Avond (vrijdag tot 20.00)</option>
              </select>
            </label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="given-name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Opmerking <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: mid fade, bovenop alleen wat korter"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-merk"><Icoon naam="wa" />Open in WhatsApp</button>
