---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, waDruk } from '../data/site';
import taper from '../assets/taper.jpg';
import fadeNek from '../assets/fade-nek.jpg';
import lijntje from '../assets/lijntje.jpg';
import model from '../assets/model.jpg';

// Wat ze doen: alleen wat hun Google-profiel laat zien (foto's, categorie Barbier) of klanten in reviews noemen.
const werk = [
  ['Knippen', 'Voor mannen en kinderen. Klanten komen er met het hele gezin.'],
  ['Fade en taper', 'Strak verlopen in de nek en langs de oren, zoals op de foto’s.'],
  ['Opscheren', 'Zijkanten en nek kort en strak.'],
  ['Lijntjes', 'Een of meer scherpe lijnen in de fade.'],
];

const wa = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>`;
---
<Base title={`${site.naam} | Dillenburgplein, Ridderkerk`} description="Kapper en barbier aan het Dillenburgplein in Ridderkerk. Knippen, fades en opscheren, ook voor kinderen. Maandag tot en met zaterdag open, vrijdag tot 20:00.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Eerste scherm: volle hoogte. Tekst op het nachtblauw, rechts hun eigen foto over de volle hoogte. -->
    <section class="donker relative isolate overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <figure class="absolute inset-0 -z-10 lg:left-auto lg:w-5/12">
        <Image src={taper} alt="Achterhoofd van een klant met een strakke taper in de nek, in de zaak aan het Dillenburgplein" widths={[480, 720]} sizes="(min-width: 1024px) 42vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[50%_75%]" />
        <div class="absolute inset-0 bg-linear-to-t from-nacht from-35% via-nacht/70 via-60% to-nacht/0 lg:hidden"></div>
      </figure>

      <div class="flex min-h-[calc(100svh-4.5rem)] flex-col justify-end px-5 pb-14 pt-40 md:px-10 lg:w-7/12 lg:justify-between lg:pb-14 lg:pt-14 lg:pl-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))] lg:pr-16">
        <p class="ui hidden text-licht-zacht lg:block">{site.straat}, {site.plaats}</p>
        <div>
          <h1 id="t-hero" class="max-w-[14ch] text-3xl lg:max-w-none">Kapper en barbier aan <br class="hidden lg:block" />het Dillenburgplein.</h1>
          <p class="mt-7 max-w-[27rem] text-licht-zacht">Knippen, fades en opscheren, ook voor kinderen. Loop even binnen of stuur een appje.</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-9 gap-y-5">
            <a href={waDruk} class="knop knop-vol"><Fragment set:html={wa} />Is het nu druk?</a>
            <a href="#tijden" class="lijn text-sm">Openingstijden</a>
          </div>
        </div>
        <p class="ui hidden justify-between gap-6 text-licht-zacht lg:flex"><span>Ma t/m za vanaf 9:30</span><span>Vrijdag tot 20:00</span></p>
      </div>
    </section>

    <!-- 2. Werk -->
    <section id="werk" aria-labelledby="t-werk">
      <div class="wrap grid gap-y-16 py-24 md:grid-cols-12 md:gap-x-8 lg:py-40">
        <div class="md:col-span-5">
          <h2 id="t-werk" class="rijs text-2xl">Strak tot in de nek.</h2>
          <p class="rijs mt-6 max-w-sm text-grijs" style="--d:.05s">Fades, tapers en scherpe lijnen. De foto’s komen van het eigen Google-profiel van de zaak.</p>
          <ul class="mt-12">
            {werk.map(([t, d], i) => (
              <li class="rijs border-t border-lijn py-6" style={`--d:${i * 0.05}s`}>
                <h3 class="text-xl">{t}</h3>
                <p class="mt-2 max-w-sm text-sm text-grijs">{d}</p>
              </li>
            ))}
          </ul>
          <p class="border-t border-lijn pt-6 text-xs text-grijs">Prijzen? Stuur even een appje.</p>
        </div>
        <div class="grid grid-cols-2 gap-4 self-start md:col-span-7 md:gap-8">
          <figure class="rijs">
            <Image src={fadeNek} alt="Een fade die in de nek naar de huid verloopt, met baard" widths={[360, 540, 720]} sizes="(min-width: 768px) 28vw, 50vw" class="aspect-[3/4] w-full object-cover" />
            <figcaption class="ui mt-4 text-grijs">Fade met baard</figcaption>
          </figure>
          <figure class="rijs mt-16 md:mt-32" style="--d:.08s">
            <Image src={lijntje} alt="Een korte fade met twee geschoren lijntjes boven het oor, met het zeshoekige lichtplafond van de zaak op de achtergrond" widths={[360, 540, 690]} sizes="(min-width: 768px) 28vw, 50vw" class="aspect-[3/4] w-full object-cover" />
            <figcaption class="ui mt-4 text-grijs">Fade met lijntjes</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 3. Langskomen -->
    <section id="langskomen" class="bg-vlak" aria-labelledby="t-langskomen">
      <div class="wrap grid gap-y-14 py-24 md:grid-cols-12 md:gap-x-8 lg:py-40">
        <figure class="rijs md:col-span-5">
          <Image src={model} alt="De kapper zet het haar van een klant op, het achterhoofd met een verlopen nek" widths={[480, 760]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full object-cover" />
        </figure>
        <div class="md:col-span-7 md:self-center lg:col-span-6 lg:col-start-7">
          <h2 id="t-langskomen" class="rijs text-2xl">Gewoon even langskomen.</h2>
          <div class="rijs mt-8 max-w-xl space-y-5 text-grijs" style="--d:.05s">
            <p>Zes dagen per week open aan het Dillenburgplein. Op zaterdag kan het druk zijn; vraag dan gerust vooraf via WhatsApp hoe lang het wachten is.</p>
          </div>
          <p class="rijs mt-10" style="--d:.1s"><a href={waDruk} class="knop"><Fragment set:html={wa} />App even vooraf</a></p>
          <dl class="rijs mt-14 text-sm" style="--d:.12s">
            <div class="grid gap-1 border-y border-lijn py-5 sm:grid-cols-[9rem_1fr] sm:gap-8">
              <dt class="text-grijs">Op Google</dt>
              <dd><span class="num">{site.google.score} uit {site.google.aantal} reviews.</span> Klanten noemen een gezellige, familievriendelijke zaak met hoge kwaliteit voor een zachte prijs. Ze worden netjes ontvangen, krijgen iets te drinken tijdens het wachten en zijn ook bij drukte snel aan de beurt.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>
