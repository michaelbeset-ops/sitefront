        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hoi Maso, ik wil graag langskomen.'];
      if (v('dienst')) r.push('Wat: ' + v('dienst'));
      if (v('wie')) r.push(v('wie'));
      const wanneer = [v('dag'), v('deel').toLowerCase()].filter(Boolean).join(', ');
      if (wanneer) r.push('Het liefst: ' + wanneer);
      if (v('wens')) r.push('Opmerking: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31647317747?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

