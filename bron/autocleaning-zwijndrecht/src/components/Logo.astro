---
// Naar hun gevelbord: grijze auto met een blauwe zwaai eromheen, "Auto Cleaning" met "Cleaning" in blauw, "Zwijndrecht" eronder.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <svg viewBox="0 0 52 34" class="h-9 w-[3.4rem] flex-none" aria-hidden="true">
    <path d="M11 20.5c0-1.6.9-2.7 2.3-3.2l3.4-6.2c.6-1.1 1.5-1.6 2.8-1.6h11.2c1.3 0 2.2.5 2.8 1.6l3.4 6.2c1.4.5 2.3 1.6 2.3 3.2v3.2c0 .7-.6 1.3-1.3 1.3H12.3c-.7 0-1.3-.6-1.3-1.3z" fill="#c9d1da" />
    <path d="M18.4 17 20.6 12.6c.3-.6.7-.8 1.3-.8h8.2c.6 0 1 .2 1.3.8l2.2 4.4z" fill="#0d1015" opacity=".55" />
    <rect x="14" y="24" width="5" height="3.6" rx="1.2" fill="#8a96a3" /><rect x="33" y="24" width="5" height="3.6" rx="1.2" fill="#8a96a3" />
    <path d="M3 25c6 7.5 38 7 46-9.5" fill="none" stroke="#2aa9ee" stroke-width="3.4" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col">
    <span class="font-display text-[1.12rem] font-bold tracking-[-0.03em] text-white">Auto <span class="text-hemel">Cleaning</span></span>
    <span class="mt-1 font-display text-[.8rem] font-semibold tracking-[0.02em] text-white/75">Zwijndrecht</span>
  </span>
</span>
