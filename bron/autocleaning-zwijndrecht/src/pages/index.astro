---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site } from '../data/site';
import { waIcon, telIcon } from '../data/icons';
import glans from '../assets/glans.jpg';
import pand from '../assets/pand.jpg';
import gevel from '../assets/gevel.jpg';
import terrein from '../assets/terrein.jpg';
import interieur from '../assets/interieur.jpg';
import wassen from '../assets/wassen.jpg';
import schuim from '../assets/schuim.jpg';

const waStart = `${site.whatsapp}?text=${encodeURIComponent('Hallo Autocleaning Zwijndrecht, ik wil graag een afspraak maken voor mijn auto.')}`;

const autos = [
  { id: 'hatchback', label: 'Hatchback', d: 'M4 17v-3.5c0-1.3.8-2.2 2-2.5l6-1 5-4.5h12c1.2 0 2.2.5 2.9 1.5l3.6 4H40c2.2 0 4 1.6 4 3.8V17' },
  { id: 'sedan', label: 'Sedan', d: 'M3 17v-3c0-1.2.8-2.1 2-2.4l7-1.1 5.3-4.5h10.5c1.3 0 2.4.5 3.2 1.5l3 3.5 7.3.8c2.2.3 3.7 1.6 3.7 3.2V17' },
  { id: 'suv', label: 'SUV', d: 'M4 17v-6c0-1.4.9-2.3 2.2-2.5L10 8l3-4h20.5c1.2 0 2.2.5 2.9 1.4L39.5 9H41c1.8 0 3 1.3 3 3v5' },
  { id: 'bus', label: 'Bus', d: 'M4 17V5.2C4 4 5 3 6.2 3H36c1.1 0 2 .5 2.7 1.4L43 10.2c.6.8 1 1.6 1 2.6V17' },
];
const wensen = [
  { id: 'binnen', label: 'Binnen' },
  { id: 'buiten', label: 'Buiten' },
  { id: 'beide', label: 'Binnen en buiten' },
  { id: 'advies', label: 'Advies op maat' },
];
const stars = Array.from({ length: 5 });
---
<Base title={`${site.naam} | Autoschoonmaak en detailing, H.A. Lorentzstraat 116`} description={`${site.naam}: autoschoonmaak en detailing in een eigen unit aan de H.A. Lorentzstraat 116 in Zwijndrecht. ${site.google} op Google uit ${site.reviews} reviews. Afspraak via WhatsApp of bel ${site.tel}.`}>
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="donker relative overflow-hidden bg-nacht text-white">
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-[58%] hidden w-px bg-white/5 lg:block"></div>
      <div class="wrap relative grid gap-12 pb-20 pt-10 lg:grid-cols-12 lg:gap-10 lg:pb-24 lg:pt-16">
        <div class="lg:col-span-7 lg:pt-6 xl:col-span-6">
          <p class="kicker text-hemel">Autoschoonmaak <span class="text-white/40">/</span> detailing</p>
          <h1 class="mt-5 text-4xl">Autoschoonmaak en detailing in <span class="text-hemel">Zwijndrecht</span></h1>
          <p class="mt-6 max-w-xl text-lg text-white/80">Vanuit onze eigen unit aan de H.A. Lorentzstraat 116. Stuur een WhatsApp met uw auto en uw wens, dan is een afspraak snel gemaakt.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={waStart} class="btn btn-hemel"><Fragment set:html={waIcon} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line text-white"><Fragment set:html={telIcon} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <dl class="mt-11 grid max-w-xl grid-cols-2 gap-x-4 gap-y-5 border-t sm:grid-cols-3 border-white/15 pt-6">
            <div class="col-span-2 sm:col-span-1">
              <dt class="text-xs text-white/75">Google</dt>
              <dd class="mt-1 font-display text-2xl font-bold tracking-tight">{site.google}<span class="ml-1 font-body text-xs font-medium text-white/75">({site.reviews} reviews)</span></dd>
            </div>
            <div>
              <dt class="text-xs text-white/75">Ma t/m vr</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-lg font-semibold tabular-nums sm:text-xl">08:00 – 17:30</dd>
            </div>
            <div>
              <dt class="text-xs text-white/75">Zaterdag</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-lg font-semibold tabular-nums sm:text-xl">09:00 – 13:00</dd>
            </div>
          </dl>
        </div>

        <div class="relative lg:col-span-5 xl:col-span-6">
          <div class="relative aspect-[5/4] overflow-hidden rounded-2xl shadow-lg sm:aspect-[4/3] lg:aspect-auto lg:h-[36rem]">
            <Foto src={glans} alt="Microvezeldoek op de glanzende motorkap van een donkere auto (sfeerfoto)" hero sizes="(min-width: 1024px) 45vw, 100vw" />
            <p class="absolute right-4 top-4 hidden max-w-[15rem] sm:block rounded-xl bg-nacht/85 px-4 py-3 text-sm leading-snug text-white backdrop-blur-sm">
              <span class="kicker block text-[0.66rem] text-ijs">Op ons gevelbord</span>
              <span class="mt-1 block font-display font-semibold">Uw auto gratis ophalen en brengen</span>
            </p>
          </div>
          <figure class="absolute -bottom-10 left-3 w-[58%] max-w-[20rem] overflow-hidden rounded-xl bg-lak shadow-lg ring-4 ring-nacht sm:left-6 lg:-bottom-12 lg:-left-10">
            <div class="aspect-[4/3]"><Foto src={gevel} alt="Ons gevelbord boven de deur van unit 116: Auto Cleaning Zwijndrecht, uw auto gratis ophalen en brengen, 06-81 76 60 08" sizes="(min-width: 1024px) 22rem, 58vw" widths={[300, 470]} /></div>
            <figcaption class="px-3.5 py-2.5 text-xs text-white/80"><span class="font-semibold text-white">Ons pand</span>, H.A. Lorentzstraat 116</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- PAND -->
    <section id="pand" class="scroll-mt-20 bg-paper pb-20 pt-24 lg:pb-28 lg:pt-32">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="order-2 lg:order-1 lg:col-span-7">
          <div class="overflow-hidden rounded-2xl shadow-sm">
            <Foto src={pand} alt="Het pand van Autocleaning Zwijndrecht aan de H.A. Lorentzstraat, met gevelbord, huisnummer 116 en auto's op de stoep" sizes="(min-width: 1024px) 50vw, 100vw" widths={[480, 800, 1024]} />
          </div>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-5">
          <p class="kicker text-diep">Waar u ons vindt</p>
          <h2 class="mt-4 text-3xl text-ink">Een eigen unit, herkenbaar aan het gevelbord</h2>
          <p class="mt-5 text-ink-soft">Autocleaning Zwijndrecht zit aan de H.A. Lorentzstraat 116 in Zwijndrecht, in een eigen unit met het gevelbord boven de deur. Daar staat ook ons nummer op: <a href={site.telHref} class="whitespace-nowrap font-semibold text-ink tabular-nums underline underline-offset-2">{site.tel}</a>.</p>
          <div class="donker mt-8 rounded-xl bg-nacht p-6 text-white shadow-sm">
            <p class="kicker text-hemel">Ophalen en brengen</p>
            <p class="mt-3 font-display text-2xl font-bold leading-tight tracking-tight">Uw auto gratis ophalen en brengen</p>
            <p class="mt-3 text-sm text-white/75">Zo staat het op ons gevelbord. Geef het aan in uw WhatsApp-bericht.</p>
          </div>
          <a href={site.maps} class="mt-6 inline-flex items-center gap-2 font-semibold text-diep underline-offset-4 transition-colors hover:text-diepst hover:underline">Route in Google Maps <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </section>

    <!-- AANBOD -->
    <section id="aanbod" class="scroll-mt-20 border-t border-line bg-mist py-20 lg:py-28">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-diep">Aanbod</p>
            <h2 class="mt-4 text-3xl text-ink">Binnen, buiten of allebei</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5">Vertel ons wat u wilt laten doen. Hieronder komen onze behandelingen en prijzen op een rij. <span class="aanleveren">[[AANLEVEREN: behandelingen en prijzen]]</span></p>
        </div>

        <div class="mt-12 grid gap-5 lg:grid-cols-12">
          <article class="group flex flex-col overflow-hidden rounded-xl bg-white shadow-sm lg:col-span-5 lg:row-span-2">
            <div class="aspect-[4/3] overflow-hidden lg:aspect-auto lg:flex-1"><Foto src={interieur} alt="Kwastje dat het dashboard van een auto reinigt (sfeerfoto)" class="transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1024px) 40vw, 100vw" /></div>
            <div class="p-6 lg:p-7">
              <p class="font-display text-sm font-semibold text-diep tabular-nums">01</p>
              <h3 class="mt-2 text-xl text-ink">Binnenkant</h3>
              <p class="mt-2 text-ink-soft">Het interieur van uw auto laten reinigen.</p>
              <p class="aanleveren mt-4 rounded-lg bg-mist px-3 py-2">[[AANLEVEREN: behandelingen en prijzen binnenkant]]</p>
            </div>
          </article>
          {[
            { n: '02', t: 'Buitenkant', p: 'De buitenkant van uw auto laten reinigen.', img: wassen, alt: 'Handen met een spons in het schuim op de zijkant van een donkere auto (sfeerfoto)', a: 'buitenkant' },
            { n: '03', t: 'Binnen en buiten', p: 'Uw auto van binnen en buiten laten reinigen.', img: schuim, alt: 'Spons met schuim op de spiegel van een auto (sfeerfoto)', a: 'binnen en buiten' },
          ].map((k) => (
            <article class="group grid overflow-hidden rounded-xl bg-white shadow-sm sm:grid-cols-5 lg:col-span-7">
              <div class="aspect-[16/9] overflow-hidden sm:col-span-2 sm:aspect-auto"><Foto src={k.img} alt={k.alt} class="transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1024px) 24vw, (min-width: 640px) 40vw, 100vw" widths={[400, 700, 1000]} /></div>
              <div class="p-6 sm:col-span-3 lg:p-7">
                <p class="font-display text-sm font-semibold text-diep tabular-nums">{k.n}</p>
                <h3 class="mt-2 text-xl text-ink">{k.t}</h3>
                <p class="mt-2 text-ink-soft">{k.p}</p>
                <p class="aanleveren mt-4 rounded-lg bg-mist px-3 py-2">[[AANLEVEREN: behandelingen en prijzen {k.a}]]</p>
              </div>
            </article>
          ))}
        </div>

        <div class="donker mt-5 grid items-center gap-6 rounded-xl bg-nacht p-6 text-white shadow-sm md:grid-cols-12 lg:p-8">
          <div class="md:col-span-8">
            <p class="kicker text-hemel">04 &nbsp;Advies op maat</p>
            <p class="mt-3 font-display text-xl font-semibold leading-snug tracking-tight">Twijfelt u wat uw auto nodig heeft? Beschrijf uw auto in een WhatsApp-bericht en vraag wat er kan.</p>
          </div>
          <div class="md:col-span-4 md:text-right">
            <a href="#plannen" class="btn btn-hemel">Plan uw beurt <span aria-hidden="true">&darr;</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- WOW: PLANNER -->
    <section id="plannen" class="donker scroll-mt-16 bg-nacht py-20 text-white lg:py-28">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-hemel">Plan uw beurt via WhatsApp</p>
            <h2 class="mt-4 text-3xl">Kies uw auto, uw wens en een dag. Het bericht staat klaar.</h2>
          </div>
          <p class="text-white/75 lg:col-span-5">U verstuurt het bericht zelf in WhatsApp, en we spreken samen het precieze moment af. Zondag zijn we gesloten, op zaterdag alleen 's ochtends.</p>
        </div>

        <form class="mt-12 grid gap-10 lg:grid-cols-12" data-plan onsubmit="return false">
          <div class="space-y-9 lg:col-span-7">
            <fieldset>
              <legend class="font-display text-lg font-semibold"><span class="mr-2 text-hemel tabular-nums">1</span>Wat voor auto heeft u?</legend>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {autos.map((a) => (
                  <label class="keus">
                    <input type="radio" name="auto" value={a.label} />
                    <span class="flex-col !items-start !gap-2 sm:!py-4">
                      <svg viewBox="0 0 48 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d={a.d} /><path d="M4 17h4.5M18.5 17h11M40 17h4" /><circle cx="13.5" cy="17.5" r="3.2" /><circle cx="35" cy="17.5" r="3.2" /></svg>
                      {a.label}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset>
              <legend class="font-display text-lg font-semibold"><span class="mr-2 text-hemel tabular-nums">2</span>Wat wilt u laten doen?</legend>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {wensen.map((w) => (
                  <label class="keus"><input type="radio" name="wens" value={w.id} data-label={w.label} /><span>{w.label}</span></label>
                ))}
              </div>
            </fieldset>

            <fieldset>
              <legend class="font-display text-lg font-semibold"><span class="mr-2 text-hemel tabular-nums">3</span>Welke dag komt u het liefst?</legend>
              <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4" data-dagen>
                <p class="col-span-full text-sm text-white/75">Noem uw voorkeursdag in het bericht. Open: maandag t/m vrijdag <span class="whitespace-nowrap tabular-nums">08:00 – 17:30</span>, zaterdag <span class="whitespace-nowrap tabular-nums">09:00 – 13:00</span>.</p>
              </div>
            </fieldset>

            <fieldset>
              <legend class="font-display text-lg font-semibold"><span class="mr-2 text-hemel tabular-nums">4</span>Welk dagdeel?</legend>
              <div class="mt-4 grid grid-cols-3 gap-3">
                <label class="keus"><input type="radio" name="deel" value="ochtend" /><span>Ochtend</span></label>
                <label class="keus"><input type="radio" name="deel" value="middag" data-middag /><span>Middag</span></label>
                <label class="keus"><input type="radio" name="deel" value="maakt niet uit" /><span>Maakt niet uit</span></label>
              </div>
              <p class="mt-3 hidden text-sm text-ijs" data-za-melding>Op zaterdag zijn we open van 09:00 tot 13:00, dus alleen 's ochtends.</p>
            </fieldset>

            <label class="flex cursor-pointer items-start gap-3 rounded-xl bg-lak p-4 ring-1 ring-staal transition-shadow hover:ring-hemel">
              <input type="checkbox" name="ophalen" class="mt-1 h-5 w-5 flex-none accent-hemel" />
              <span><span class="font-semibold">Graag ophalen en terugbrengen</span><br /><span class="text-sm text-white/75">Op ons gevelbord: uw auto gratis ophalen en brengen.</span></span>
            </label>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-2xl bg-lak p-5 ring-1 ring-staal lg:sticky lg:top-24 lg:p-6">
              <div class="flex items-center gap-3 border-b border-staal pb-4">
                <span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-hemel text-nacht"><Fragment set:html={waIcon.replace('<svg', '<svg class="h-5 w-5"')} /></span>
                <div class="leading-tight">
                  <p class="font-semibold">{site.naam}</p>
                  <p class="text-xs text-white/75 tabular-nums">{site.tel}</p>
                </div>
              </div>
              <p class="mt-5 text-xs text-white/75">Uw bericht</p>
              <p class="mt-2 min-h-[9rem] whitespace-pre-line rounded-xl rounded-tr-sm bg-[#e3f4fd] p-4 text-[0.98rem] leading-relaxed text-nacht" aria-live="polite" data-bericht>Hallo Autocleaning Zwijndrecht, ik wil graag een afspraak maken voor mijn auto.</p>
              <a href={waStart} class="btn btn-hemel mt-5 w-full" data-wa><Fragment set:html={waIcon} />Verstuur via WhatsApp</a>
              <p class="mt-3 text-center text-xs text-white/75">Opent WhatsApp met dit bericht. Liever bellen? <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a></p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- KLANTEN -->
    <section id="klanten" class="scroll-mt-20 bg-paper py-20 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-14">
        <div class="relative lg:col-span-7">
          <div class="overflow-hidden rounded-2xl shadow-sm">
            <div class="aspect-[4/3]"><Foto src={terrein} alt="Twee auto's, een witte en een grijze, op het terrein bij de units (foto van ons Google-profiel)" sizes="(min-width: 1024px) 50vw, 100vw" widths={[480, 800, 1200, 1530]} /></div>
          </div>
          <div class="donker relative -mt-16 ml-4 mr-4 rounded-xl bg-nacht p-6 text-white shadow-lg sm:ml-auto sm:mr-6 sm:w-80 lg:absolute lg:-bottom-8 lg:-right-8 lg:m-0">
            <p class="kicker text-hemel">Google-reviews</p>
            <p class="mt-3 flex items-end gap-3">
              <span class="font-display text-[3.4rem] font-bold leading-none tracking-tight">{site.google}</span>
              <span class="pb-1.5 text-sm text-white/75">uit {site.reviews} reviews</span>
            </p>
            <p class="mt-3 flex gap-1 text-hemel" role="img" aria-label={`${site.google} van 5 sterren`}>
              {stars.map((_, i) => <svg viewBox="0 0 20 20" class="h-5 w-5" aria-hidden="true"><defs><linearGradient id={`s${i}`}><stop offset={i === 4 ? '80%' : '100%'} stop-color="currentColor" /><stop offset={i === 4 ? '80%' : '100%'} stop-color="#ffffff33" /></linearGradient></defs><path fill={`url(#s${i})`} d="m10 1.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.8z" /></svg>)}
            </p>
            <a href={site.maps} class="mt-4 inline-block text-sm font-semibold text-ijs underline-offset-4 hover:underline">Bekijk op Google Maps <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:pt-4">
          <p class="kicker text-diep">Klanten</p>
          <h2 class="mt-4 text-3xl text-ink">Wat klanten noemen</h2>
          <p class="mt-4 text-ink-soft">Samengevat uit de reviews op ons Google-profiel.</p>
          <ol class="mt-8 divide-y divide-line border-y border-line">
            {[
              { t: 'Ze komen terug', p: 'Er zijn klanten die hun auto voor een tweede keer bij ons brengen.' },
              { t: 'Snel een afspraak', p: 'Een afspraak is snel gemaakt, en klanten zijn te spreken over de service en het resultaat.' },
              { t: 'Persoonlijk contact', p: 'Klanten noemen het contact met de eigenaar persoonlijk en vriendelijk.' },
            ].map((r, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-2 py-5">
                <span class="font-display text-sm font-semibold text-diep tabular-nums">0{i + 1}</span>
                <div><h3 class="text-lg text-ink">{r.t}</h3><p class="mt-1 text-ink-soft">{r.p}</p></div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="scroll-mt-20 border-t border-line bg-mist py-20 lg:py-28">
      <div class="wrap grid gap-6 lg:grid-cols-12">
        <div class="donker rounded-2xl bg-nacht p-7 text-white shadow-sm lg:col-span-5 lg:p-9">
          <p class="kicker text-hemel">Contact</p>
          <h2 class="mt-4 text-3xl">Afspraak maken of iets vragen</h2>
          <p class="mt-4 text-white/75">WhatsApp werkt het snelst. Bellen kan natuurlijk ook.</p>
          <div class="mt-7 grid gap-3">
            <a href={waStart} class="btn btn-hemel w-full !py-4 text-lg"><Fragment set:html={waIcon} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line w-full text-white"><Fragment set:html={telIcon} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <div class="mt-8 border-t border-white/15 pt-6">
            <p class="font-semibold">{site.naam}</p>
            <p class="text-white/80">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <a href={site.maps} class="mt-2 inline-block text-sm font-semibold text-ijs underline-offset-4 hover:underline">Route in Google Maps <span aria-hidden="true">&rarr;</span></a>
          </div>
          <table class="mt-7 w-full text-sm" data-tijden>
            <caption class="kicker mb-3 text-left text-white/75">Openingstijden</caption>
            <tbody>
              {[['Maandag', 1], ['Dinsdag', 2], ['Woensdag', 3], ['Donderdag', 4], ['Vrijdag', 5], ['Zaterdag', 6], ['Zondag', 0]].map(([dag, n]) => {
                const t = site.tijden[n as number];
                return (
                  <tr class="border-b border-white/10 last:border-0" data-dag={n}>
                    <th scope="row" class="py-2 text-left font-medium text-white/85">{dag}</th>
                    <td class="py-2 text-right whitespace-nowrap tabular-nums">{t ? `${t[0]} – ${t[1]}` : 'Gesloten'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <form class="rounded-2xl bg-white p-7 shadow-sm lg:col-span-7 lg:p-9" onsubmit="return false">
          <p class="kicker text-diep">Of laat een bericht achter</p>
          <h3 class="mt-3 text-2xl text-ink">Stuur ons uw vraag</h3>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block text-sm font-semibold text-ink">Naam
              <input type="text" name="naam" autocomplete="name" class="mt-2 block w-full rounded-lg border border-line bg-paper px-4 py-3 font-normal transition-colors focus:border-diep" />
            </label>
            <label class="block text-sm font-semibold text-ink">Telefoonnummer
              <input type="tel" name="telefoon" autocomplete="tel" class="mt-2 block w-full rounded-lg border border-line bg-paper px-4 py-3 font-normal transition-colors focus:border-diep" />
            </label>
            <label class="block text-sm font-semibold text-ink sm:col-span-2">Uw auto en uw vraag
              <textarea name="vraag" rows="5" class="mt-2 block w-full rounded-lg border border-line bg-paper px-4 py-3 font-normal transition-colors focus:border-diep"></textarea>
            </label>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg bg-mist px-4 py-3 text-sm text-ink-soft">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Stuur een WhatsApp of bel <a href={site.telHref} class="whitespace-nowrap font-semibold text-ink tabular-nums underline">{site.tel}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-diep mt-6">Verstuur</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  const tijden: (null | [string, string])[] = [null, ['08:00', '17:30'], ['08:00', '17:30'], ['08:00', '17:30'], ['08:00', '17:30'], ['08:00', '17:30'], ['09:00', '13:00']];
  const WA = 'https://wa.me/31681766008';
  const tz = 'Europe/Amsterdam';

  // "Nu" in Nederlandse tijd, los van de tijdzone van de bezoeker.
  const nu = new Date();
  const deelNu = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(nu).map((p) => [p.type, p.value]));
  const vandaag = new Date(Date.UTC(+deelNu.year, +deelNu.month - 1, +deelNu.day));
  const minNu = +deelNu.hour * 60 + +deelNu.minute;
  const minuten = (t: string) => +t.slice(0, 2) * 60 + +t.slice(3);

  // Openingstijden: vandaag markeren
  const rij = document.querySelector<HTMLElement>(`[data-tijden] [data-dag="${vandaag.getUTCDay()}"]`);
  if (rij) {
    rij.classList.add('text-hemel');
    const th = rij.querySelector('th');
    if (th) th.insertAdjacentHTML('beforeend', ' <span class="ml-1 rounded-full bg-hemel px-2 py-0.5 text-[0.7rem] font-bold text-nacht">vandaag</span>');
  }

  // Planner
  const form = document.querySelector<HTMLFormElement>('[data-plan]');
  const dagenBox = document.querySelector<HTMLElement>('[data-dagen]');
  const bericht = document.querySelector<HTMLElement>('[data-bericht]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-wa]');
  const zaMelding = document.querySelector<HTMLElement>('[data-za-melding]');
  const middag = document.querySelector<HTMLInputElement>('[data-middag]');

  if (form && dagenBox && bericht && knop) {
    const fmtKort = new Intl.DateTimeFormat('nl-NL', { timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short' });
    const fmtLang = new Intl.DateTimeFormat('nl-NL', { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' });
    const dagen: { d: Date; t: [string, string]; label: string }[] = [];
    for (let i = 0; dagen.length < 8 && i < 14; i++) {
      const d = new Date(vandaag.getTime() + i * 86400000);
      const t = tijden[d.getUTCDay()];
      if (!t) continue;
      if (i === 0 && minNu > minuten(t[1]) - 60) continue;
      dagen.push({ d, t, label: i === 0 ? 'vandaag' : i === 1 ? 'morgen' : '' });
    }
    dagenBox.innerHTML = dagen.map((x, n) => {
      const kort = fmtKort.format(x.d).replace('.', '');
      const za = x.d.getUTCDay() === 6;
      return `<label class="keus"><input type="radio" name="dag" value="${n}" /><span class="flex-col !items-start !gap-0.5"><span>${x.label ? x.label.charAt(0).toUpperCase() + x.label.slice(1) : kort.charAt(0).toUpperCase() + kort.slice(1)}</span><span class="text-xs font-medium opacity-80 tabular-nums">${x.label ? kort + (za ? ', ochtend' : '') : za ? 'alleen ochtend' : x.t[0] + ' – ' + x.t[1]}</span></span></label>`;
    }).join('');

    const waarde = (n: string) => form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`);

    const bouw = () => {
      const auto = waarde('auto')?.value;
      const wens = waarde('wens')?.value;
      const dagIdx = waarde('dag')?.value;
      const dag = dagIdx !== undefined ? dagen[+dagIdx] : undefined;
      const isZa = dag?.d.getUTCDay() === 6;

      if (middag) {
        middag.disabled = !!isZa;
        if (isZa && middag.checked) middag.checked = false;
      }
      zaMelding?.classList.toggle('hidden', !isZa);
      const deel = waarde('deel')?.value;
      const ophalen = form.querySelector<HTMLInputElement>('input[name="ophalen"]')?.checked;

      const auto2 = auto ? (auto === 'SUV' ? 'mijn SUV' : auto === 'Bus' ? 'mijn bus' : `mijn ${auto.toLowerCase()}`) : 'mijn auto';
      const regels: string[] = [];
      let zin = `Hallo Autocleaning Zwijndrecht, ik wil graag een afspraak maken voor ${auto2}.`;
      regels.push(zin);
      if (wens === 'binnen') regels.push('Ik wil de binnenkant laten reinigen.');
      if (wens === 'buiten') regels.push('Ik wil de buitenkant laten reinigen.');
      if (wens === 'beide') regels.push('Ik wil hem van binnen en buiten laten reinigen.');
      if (wens === 'advies') regels.push('Ik weet nog niet precies wat hij nodig heeft en hoor graag uw advies.');
      if (dag) {
        const dagTekst = fmtLang.format(dag.d);
        const deelTekst = isZa ? 'ochtend' : deel === 'ochtend' ? 'ochtend' : deel === 'middag' ? 'middag' : '';
        regels.push(`Voorkeur: ${dagTekst}${deelTekst ? ', ' + deelTekst : ''}.`);
      } else if (deel && deel !== 'maakt niet uit') {
        regels.push(`Voorkeur: in de ${deel}.`);
      }
      if (ophalen) regels.push('Graag laten ophalen en terugbrengen.');
      regels.push('Kunt u laten weten wat er kan?');
      const tekst = regels.join('\n');
      bericht.textContent = tekst;
      knop.href = `${WA}?text=${encodeURIComponent(tekst)}`;
    };
    form.addEventListener('change', bouw);
    bouw();
  }
</script>
