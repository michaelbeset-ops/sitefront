---
// Hun eigen beeldmerk (springend rood paard boven de wielen van een aanhanger, met EUSSEN schuin langs de dissel),
// overgetrokken als SVG in public/merk.svg. Daarnaast een strak wordmark in de displayfont.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <img src={url('merk.svg')} alt="" width="58" height="48" class="h-11 w-auto flex-none" />
  <span aria-hidden="true" class="flex flex-col font-display uppercase">
    <span class={`text-[1.6rem] font-bold tracking-[0.02em] ${licht ? 'text-white' : 'text-ink'}`}>Eussen</span>
    <span class={`mt-0.5 text-[0.66rem] font-semibold tracking-[0.3em] ${licht ? 'text-zink' : 'text-roest'}`}>Aanhangwagens</span>
  </span>
  <span class="sr-only">Eussen Aanhangwagens</span>
</span>
