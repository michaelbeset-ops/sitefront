---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, merken } from '../data/site';
import heroFoto from '../assets/paardentrailer-zwart.jpg';
import team from '../assets/team.jpg';
import koelTruck from '../assets/koel-vrachtwagen.jpg';
import uitvaart from '../assets/dierenuitvaart.jpg';
import tandat from '../assets/verkoopwagen-tandat.jpg';
import olie from '../assets/olievoertuig.jpg';
import schaft from '../assets/schaftwagens.jpg';
import werkplaats from '../assets/werkplaats.jpg';
import pandFoto from '../assets/paardentrailer-pand.jpg';
import auto from '../assets/autotransporter.jpg';
import paard from '../assets/paardentrailer-zilver.jpg';
import graver from '../assets/minigraver.jpg';
import gesloten from '../assets/gesloten.jpg';
import koelwagen from '../assets/koelwagen.jpg';
import boot from '../assets/boottrailer.jpg';
import klep from '../assets/gesloten-klep.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

// Koop, huur en lease: alleen wat hun pagina's zeggen.
const HUUR = 'Wij verhuren alle soorten trailers.';
const LEASE = 'Wij bespreken graag de mogelijkheden van het leasen van een trailer.';
const VRAAG = 'Niet apart vermeld: vraag naar de mogelijkheden.';
type Groep = {
  id: string; label: string; titel: string; foto: ImageMetadata; alt: string; fotoW: number;
  tekst: string; typen: string[]; merken: string[]; koop: string; huur: string | null; lease: string | null; extra?: string;
};
// Keuzehulp: elke productgroep met de typen, merken en teksten van hun eigen productpagina's.
const groepen: Groep[] = [
  { id: 'auto', label: 'Auto vervoeren', titel: 'Autotransporters', foto: auto, fotoW: 640, alt: 'Een gegalvaniseerde autotransporter met lange oprijplaten, op het plein bij ons pand',
    tekst: "Autotransporter aanhangwagens kunt u gebruiken voor het vervoeren van auto's van ieder formaat. In verschillende afmetingen en met diverse extra's, zoals een reservewiel en anti-diefstalsloten.",
    typen: ['Autotransporters', 'Multitransporters', 'Plateauwagens'], merken: ['Brian James Trailers', 'Anssems', 'Henra', 'Hulco'],
    koop: 'Nieuw of als occasion.', huur: HUUR, lease: LEASE },
  { id: 'paard', label: 'Paarden', titel: 'Paardentrailers', foto: paard, fotoW: 1200, alt: 'Een zilvergrijze Atec-paardentrailer met dubbele as, langs de weg',
    tekst: 'U bent bij ons op het juiste adres voor de aankoop van een paardentrailer. Voor onderhoud en reparatie van uw paardentrailer kunt u ook bij ons terecht.',
    typen: ['1,5-paards trailer', '2-paards trailer', '2-paards trailer XXL / pony'], merken: ['Atec', 'Weijer', 'Ifor Williams', 'Sirius'],
    koop: 'Nieuw of als occasion.', huur: '1,5-paards trailer v.a. €60 per dag, excl. borg.', lease: LEASE },
  { id: 'vee', label: 'Vee', titel: 'Veetrailers', foto: team, fotoW: 640, alt: 'Ons team van vier mannen in werkkleding voor een Ifor Williams-veetrailer',
    tekst: 'U als veehouder of veehandelaar, of beide, bent bij ons op het juiste adres voor advies, service en garantie en onderhoud van uw standaard of op maat gemaakte veetrailer.',
    typen: ['Standaard veetrailers', 'Veetrailers op maat'], merken: ['Ifor Williams'],
    koop: 'Standaard of op maat gemaakt.', huur: HUUR, lease: LEASE },
  { id: 'bouw', label: 'Bouw en machines', titel: 'Kippers, plateau- en machinewagens', foto: graver, fotoW: 640, alt: 'Een oranje minigraver vastgesjord op een minigraver-transporter, voor ons pand',
    tekst: 'Kippers, plateauwagens en minigraver-transporters, geremd als enkelasser of dubbelasser, of ongeremd tot 750 kg. Ook schaftwagens: robuust, met polyester dak, gegalvaniseerd chassis en geïsoleerde sandwichpanelen.',
    typen: ['Kippers', 'Plateauwagens', 'MTeam minigraver-transporters', 'TwinTrailer: kipper en transporter in 1', 'Enkel- en dubbelassers geremd', 'Ongeremd tot 750 kg', 'Schaftwagens'], merken: ['Hulco', 'Twin Trailers', 'Saris', 'Henra'],
    koop: 'Nieuw of als occasion.', huur: HUUR, lease: LEASE },
  { id: 'gesloten', label: 'Gesloten transport', titel: 'Gesloten aanhangwagens', foto: gesloten, fotoW: 1200, alt: 'Een hoge, gesloten aluminium aanhangwagen met enkele as op ons terrein',
    tekst: 'Gesloten aanhangwagens en bakwagens. Ook als verkoopwagen, zoals de wagen die wij bouwden voor Tan-Dat op de markt van Maastricht.',
    typen: ['Gesloten aanhangwagens', 'Gesloten bakwagens', 'Verkoopwagens'], merken: ['Sirius', 'Ifor Williams'],
    koop: 'Nieuw, bijvoorbeeld een Sirius gesloten 3-asser.', huur: HUUR, lease: LEASE },
  { id: 'koel', label: 'Koeling', titel: 'Koelwagens en koelopbouw', foto: koelwagen, fotoW: 640, alt: 'Een witte gesloten koelaanhanger met dubbele as en koelunit voorop',
    tekst: 'Koelaanhangers, en complete koelopbouwen op vrachtwagens van KIESLING Kühlfahrzeuge: van vers- en diepvriestransport tot multi-temperatuur logistiek, met naadloze integratie op alle gangbare truckchassis.',
    typen: ['Koelwagens (aanhanger)', 'Koelopbouw op vrachtwagen', 'Standaard of volledig op maat'], merken: ['Kiesling'],
    koop: 'Advies op maat en de juiste configuratie.', huur: 'Koelaanhangers: ' + HUUR.toLowerCase(), lease: 'Koelaanhangers: ' + LEASE.toLowerCase() },
  { id: 'boot', label: 'Boot', titel: 'Boottrailers', foto: boot, fotoW: 640, alt: 'Een gegalvaniseerde boottrailer met rollen en verlichting, op ons terrein',
    tekst: 'Boottrailers voor sloepen, vissersbootjes, skiboten, rubberboten en zeilboten, nagenoeg altijd aan te passen aan uw boot. Ook voor onderhoud van uw boottrailer.',
    typen: ['Boottrailers', "Trolley's", 'Aanpassing aan uw boot'], merken: ['Kalf Trailers', 'Freewheel', 'Sunway'],
    koop: 'De goede boottrailer voor een scherpe prijs.', huur: HUUR, lease: LEASE },
  { id: 'luchthaven', label: 'Luchthaven', titel: 'Airport maintenance', foto: olie, fotoW: 690, alt: 'De dubbele schaarlift met werkplatforms op een olievoertuig voor vliegtuigonderhoud',
    tekst: 'Voor airport maintenance: olievoertuigen, een aanhangwagen voor vliegtuigbanden en een stikstof-aanhangwagen.',
    typen: ['Olievoertuigen', 'Vliegtuigbanden-aanhangwagen', 'Stikstof-aanhangwagen'], merken: [],
    koop: 'Neem contact op voor de mogelijkheden.', huur: null, lease: null },
  { id: 'maatwerk', label: 'Speciaalbouw', titel: 'Speciaalbouw en maatwerk', foto: klep, fotoW: 1024, alt: 'Een gesloten aluminium aanhanger met open zijklep en oprijplaat, voor ons pand',
    tekst: 'Een unieke laadopbouw, extra bevestigingspunten, lieren, opklapbare rekken, gesloten kasten, verhoogde schuifdaken, verzwaarde assen of een complete ombouw: we denken mee, ontwerpen en bouwen in-huis. Strak afgewerkt, met keuring en garantie.',
    typen: ['Maatwerkframe en opbouw', 'Interieur: kastsystemen, rails, sjorogen', 'Elektrisch: verlichting, 12V/230V, accu', 'Lieren, kleppen, ramps, steunpoten', 'Rem- en as-upgrades, anti-diefstal', 'Coatings, RVS/alu, belettering en wrap'], merken: [],
    koop: 'Wij bouwen wat u voor ogen heeft.', huur: null, lease: null },
];

// Projecten: hun nieuwsberichten zonder datum, plus de speciaalbouw uit hun productpagina's.
const koelSpecs = ['Lange laadklep', 'Extra bindrails', 'Aluminium vloer', 'Versterking in de wanden', 'Zijdeur met trap', 'Tussenschot met rolluik', 'Brandblussers en watertank'];

// Occasions: een greep uit hun occasionpagina, prijzen exact zoals daar vermeld (excl. btw).
const occasions = [
  { naam: 'Sirius gesloten 3-asser', maat: '500 x 171 x 240 cm', gewicht: '3500 kg', jaar: '2026', staat: 'Nieuw', prijs: '16.500' },
  { naam: 'Henra transporter', maat: '350 x 150 cm', gewicht: '3500 kg', jaar: '2023', staat: 'Gebruikt', prijs: '4.750' },
  { naam: 'Hulco aanhangwagen 3-asser', maat: '500 x 200 cm', gewicht: '3500 kg', jaar: '2021', staat: 'Gebruikt', prijs: '3.750' },
  { naam: 'Hapert transporter', maat: '360 x 175 cm', gewicht: '3500 kg', jaar: '2021', staat: 'Gebruikt', prijs: '3.700' },
  { naam: 'Anssems autotransporter', maat: '340 x 180 cm', gewicht: '1300 kg', jaar: '2025', staat: 'Gebruikt', prijs: '2.750' },
  { naam: 'Orbons machine-doorrijaanhangwagen', maat: '350 x 200 cm', gewicht: '3000 kg', jaar: '2003', staat: 'Gebruikt', prijs: '2.750' },
];
const statusRij = (g: Groep) => [
  { k: 'Koop', v: g.koop, aan: true },
  { k: 'Huur', v: g.huur ?? VRAAG, aan: !!g.huur },
  { k: 'Lease', v: g.lease ?? VRAAG, aan: !!g.lease },
];
---
<Base
  title="Eussen Aanhangwagens | Aanhangwagens, paardentrailers en speciaalbouw in Voerendaal"
  description="Eussen Aanhangwagens in Voerendaal: dealer van Atec, Saris, Hulco, Ifor Williams, Henra en meer. Verkoop, verhuur, lease, speciaalbouw, koelopbouw en BOVAG-onderhoud met remmentestbank."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: antraciet, grote condensed kop, bewijzen als kolom. Rechts de zwarte Atec-paardentrailer die over de rand valt, met ons team als inzet. -->
    <section class="donker relative overflow-x-clip bg-nacht text-white">
      <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[42%] bg-staal lg:block" aria-hidden="true"></div>
      <div class="wrap relative grid grid-cols-1 gap-10 pb-14 lg:grid-cols-12 lg:gap-10 lg:pt-16 lg:pb-12">
        <div class="relative -mx-5 sm:mx-0 lg:order-2 lg:col-span-6 lg:col-start-7 lg:self-start lg:-mb-44">
          <figure class="relative">
            <div class="aspect-[4/3] overflow-hidden sm:rounded-xl lg:aspect-[5/6] lg:shadow-lg">
              <Foto src={heroFoto} alt="Een glanzend zwarte Atec Thensa-paardentrailer met dubbele as, langs een weg onder een blauwe lucht" hero widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 600px, 100vw" class="object-[62%_50%]" />
            </div>
            <figcaption class="absolute top-4 right-4 rounded-md bg-nacht/85 px-3 py-1.5 text-xs font-semibold backdrop-blur-sm">Atec paardentrailer</figcaption>
          </figure>
          <figure class="absolute -bottom-12 left-4 z-10 w-44 overflow-hidden rounded-xl bg-white p-1.5 text-ink shadow-lg sm:left-6 sm:w-56 lg:bottom-24 lg:-left-6 lg:w-[250px] xl:w-[270px]">
            <div class="aspect-[3/2] overflow-hidden rounded-lg"><Foto src={team} alt="Ons team: vier mannen in werkkleding voor een veetrailer" widths={[320, 540]} sizes="(min-width: 1024px) 260px, 220px" /></div>
            <figcaption class="px-1.5 pt-2 pb-1 text-xs font-semibold">Team Eussen. Al meer dan 30 jaar in het vak.</figcaption>
          </figure>
        </div>

        <div class="min-w-0 pt-8 lg:order-1 lg:col-span-6 lg:pt-8 lg:pr-6">
          <p class="kicker text-zink"><span class="streep"></span>Voerendaal, Parkstad</p>
          <h1 class="mt-5 text-4xl lg:text-[clamp(3rem,5.1vw,5.6rem)]">Een aanhanger voor elk transport&shy;probleem</h1>
          <p class="mt-6 max-w-[32rem] text-lg text-white/85">Dealer van een groot aantal fabrikanten, van paardentrailer tot koelopbouw. Met een goed uitgeruste werkplaats en speciaalbouw in-huis.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#keuzehulp" class="btn btn-rood">Welke aanhanger zoekt u? <Fragment set:html={pijl} /></a>
            <a href={site.telHref} class="btn btn-line"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-white/20 pt-6 text-sm sm:grid-cols-4 lg:grid-cols-2">
            <div><dt class="text-white/75">Google</dt><dd><strong class="font-display text-2xl">{site.google}</strong> <span class="whitespace-nowrap text-white/80">({site.reviews} reviews)</span></dd></div>
            <div><dt class="text-white/75">In het vak</dt><dd><strong class="font-display text-2xl">30+</strong> <span class="text-white/80">jaar</span></dd></div>
            <div><dt class="text-white/75">Onderhoud</dt><dd><strong class="font-display text-2xl">BOVAG</strong> <span class="text-white/80">gecertificeerd</span></dd></div>
            <div><dt class="text-white/75">Ma t/m vr</dt><dd class="font-display text-2xl font-bold whitespace-nowrap tabular-nums">08.00 - 17.00</dd></div>
          </dl>
          <p class="mt-4 text-sm text-white/75">Zaterdag en 's avonds op afspraak.</p>
        </div>
      </div>
    </section>

    <!-- Wow: de keuzehulp. Zonder JS: alle productgroepen onder elkaar. -->
    <section id="keuzehulp" class="scroll-mt-20 pt-24 pb-16 lg:pt-56 lg:pb-24" data-hulp>
      <div class="wrap">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="kicker text-roest"><span class="streep"></span>Keuzehulp</p>
            <h2 class="mt-4 text-3xl">Welke aanhanger zoekt u?</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5 lg:self-end">Kies wat u wilt vervoeren. U ziet welke typen en merken wij daarvoor hebben, of u kunt kopen, huren of leasen, en u vraagt direct een offerte aan.</p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
          <form class="lg:col-span-4" hidden data-keuzes>
            <fieldset>
              <legend class="text-sm font-bold">Ik wil vervoeren:</legend>
              <div class="mt-3 grid grid-cols-2 gap-2 lg:grid-cols-1">
                {groepen.map((g, i) => (
                  <label class="doel">
                    <input type="radio" class="sr-only" name="doel" value={g.id} checked={i === 0} />
                    <span class="duim" aria-hidden="true"><Foto src={g.foto} alt="" widths={[160]} sizes="56px" /></span>
                    <strong>{g.label}</strong>
                  </label>
                ))}
              </div>
            </fieldset>
          </form>

          <div class="space-y-8 lg:col-span-8" aria-live="polite" data-panelen>
            {groepen.map((g) => (
              <article data-groep={g.id} class="scroll-mt-20 overflow-hidden rounded-xl bg-white shadow-sm">
                <div class="grid grid-cols-1 md:grid-cols-2">
                  <figure class="relative bg-beton">
                    <div class="aspect-[4/3] h-full overflow-hidden"><Foto src={g.foto} alt={g.alt} widths={[480, Math.min(800, g.fotoW)]} sizes="(min-width: 1024px) 420px, (min-width: 768px) 50vw, 100vw" /></div>
                  </figure>
                  <div class="p-6 sm:p-8">
                    <p class="kicker text-roest">{g.label}</p>
                    <h3 class="mt-2 text-2xl">{g.titel}</h3>
                    <p class="mt-3 text-ink-soft">{g.tekst}</p>
                  </div>
                </div>
                <div class="grid grid-cols-1 gap-6 border-t border-line p-6 sm:p-8 md:grid-cols-2">
                  <div>
                    <h4 class="text-sm font-bold">Typen</h4>
                    <ul class="mt-3 space-y-1.5 text-sm">
                      {g.typen.map((t) => <li class="flex gap-2.5"><span class="mt-2 h-1.5 w-3 flex-none bg-rood" aria-hidden="true"></span><span>{t}</span></li>)}
                    </ul>
                    {g.merken.length > 0 && (
                      <>
                        <h4 class="mt-5 text-sm font-bold">Merken</h4>
                        <ul class="mt-2 flex flex-wrap gap-1.5">
                          {g.merken.map((m) => <li class="rounded-md bg-beton px-2.5 py-1 text-xs font-semibold">{m}</li>)}
                        </ul>
                      </>
                    )}
                  </div>
                  <dl class="divide-y divide-line rounded-lg border border-line text-sm">
                    {statusRij(g).map((s) => (
                      <div class="grid grid-cols-[4.5rem_1fr] gap-3 px-4 py-3">
                        <dt class="flex items-center gap-2 font-bold"><span class={`h-2 w-2 flex-none rounded-full ${s.aan ? 'bg-rood' : 'border border-ink-soft'}`} aria-hidden="true"></span>{s.k}</dt>
                        <dd class={s.aan ? '' : 'text-ink-soft'}>{s.v}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                <div class="flex flex-col gap-3 bg-nacht px-6 py-5 text-white sm:flex-row sm:items-center sm:justify-between sm:px-8">
                  <p class="text-sm text-white/85">{g.titel}: vraag een offerte aan of bel voor de actuele voorraad.</p>
                  <a href="#offerte" data-offerte={g.id} class="btn btn-rood flex-none !py-2.5 text-sm">Offerte aanvragen <Fragment set:html={pijl} /></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <script>
      // Keuzehulp: toont de gekozen productgroep uit hun eigen productpagina's en zet de keuze door naar het offerteformulier.
      const sectie = document.querySelector<HTMLElement>('[data-hulp]');
      if (sectie) {
        const form = sectie.querySelector<HTMLFormElement>('[data-keuzes]')!;
        const panelen = [...sectie.querySelectorAll<HTMLElement>('[data-groep]')];
        const kies = (id: string, schuif = false) => {
          panelen.forEach((p) => (p.hidden = p.dataset.groep !== id));
          const sel = document.querySelector<HTMLSelectElement>('#f-type');
          if (sel) sel.value = id;
          if (schuif && innerWidth < 1024) {
            const p = panelen.find((x) => x.dataset.groep === id);
            const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
            p?.scrollIntoView({ behavior: rustig ? 'auto' : 'smooth', block: 'start' });
          }
        };
        form.hidden = false;
        form.addEventListener('submit', (e) => e.preventDefault());
        form.addEventListener('change', (e) => kies((e.target as HTMLInputElement).value, true));
        kies((form.querySelector('input:checked') as HTMLInputElement).value);
        document.querySelectorAll<HTMLAnchorElement>('[data-offerte]').forEach((a) =>
          a.addEventListener('click', () => {
            const sel = document.querySelector<HTMLSelectElement>('#f-type');
            if (sel) sel.value = a.dataset.offerte!;
            setTimeout(() => document.querySelector<HTMLInputElement>('input[name=vorm]')?.focus({ preventScroll: true }), 400);
          }),
        );
      }
    </script>

    <!-- Projecten: recent afgeleverd en speciaalbouw, uit hun nieuwsberichten. Donker, bento-raster. -->
    <section id="projecten" class="donker scroll-mt-20 bg-nacht py-16 text-white lg:py-24">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
          <div>
            <p class="kicker text-vonk"><span class="streep"></span>Recent afgeleverd</p>
            <h2 class="mt-4 text-3xl">Speciaalbouw uit eigen werkplaats</h2>
          </div>
          <p class="max-w-md text-white/80">Ook interesse in maatwerk? Wij nemen de uitdaging graag aan. We starten met uw wens, maken een passend ontwerp en leveren strak afgewerkt maatwerk.</p>
        </div>

        <!-- Uitgelicht: de eerste complete koel-vrachtwagen. -->
        <article class="mt-12 grid grid-cols-1 overflow-hidden rounded-xl bg-staal lg:grid-cols-12">
          <figure class="lg:col-span-7">
            <div class="aspect-[4/3] h-full overflow-hidden"><Foto src={koelTruck} alt="Een antraciet MAN-vrachtwagen met witte gesloten koelopbouw, opgeleverd voor ons pand" widths={[480, 800, 1200, 1600]} sizes="(min-width: 1024px) 700px, 100vw" /></div>
          </figure>
          <div class="p-6 sm:p-8 lg:col-span-5 lg:p-10">
            <p class="kicker text-vonk">Koelvoertuigen · Kiesling</p>
            <h3 class="mt-3 text-2xl">Eerste complete koel-vrachtwagen opgeleverd</h3>
            <p class="mt-4 text-white/85">De eerste complete vrachtwagen met gesloten koelopbouw door Eussen Aanhangwagens: de officiële start van onze samenwerking met KIESLING Kühlfahrzeuge, fabrikant van koelopbouwen voor vrachtwagens.</p>
            <h4 class="mt-6 text-sm font-bold text-zink">Op wens van de klant</h4>
            <ul class="mt-3 grid grid-cols-1 gap-x-5 gap-y-1.5 text-sm sm:grid-cols-2">
              {koelSpecs.map((s) => <li class="flex gap-2.5"><span class="mt-2 h-1.5 w-3 flex-none bg-rood" aria-hidden="true"></span><span>{s}</span></li>)}
            </ul>
          </div>
        </article>

        <ul class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-12">
          <li class="lg:col-span-4 lg:row-span-2">
            <figure class="flex h-full flex-col overflow-hidden rounded-xl bg-staal">
              <div class="aspect-[3/4] overflow-hidden lg:aspect-auto lg:flex-1"><Foto src={uitvaart} alt="Een gesloten aanhanger met open achterklep: afwasbaar interieur, blauwe draagmat en een lier voorin" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw" /></div>
              <figcaption class="p-6">
                <p class="kicker text-vonk">Speciaalbouw</p>
                <h3 class="mt-2 text-xl">Dierenuitvaartzorg</h3>
                <p class="mt-2 text-sm text-white/80">Een Tohaco aanhangwagen, omgebouwd voor een dierenuitvaartorganisatie: voor het transport van overleden dieren (paarden).</p>
              </figcaption>
            </figure>
          </li>
          <li class="lg:col-span-8">
            <figure class="grid h-full overflow-hidden rounded-xl bg-staal sm:grid-cols-2">
              <div class="aspect-[4/3] overflow-hidden sm:aspect-auto"><Foto src={tandat} alt="Een zilvergrijze verkoopwagen van Tan-Dat met open luiken, op de markt in Maastricht" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" /></div>
              <figcaption class="p-6 sm:self-end">
                <p class="kicker text-vonk">Verkoopwagen</p>
                <h3 class="mt-2 text-xl">Tan-Dat, markt Maastricht</h3>
                <p class="mt-2 text-sm text-white/80">Een verkoopwagen voor de firma Tan-Dat op de markt van Maastricht.</p>
              </figcaption>
            </figure>
          </li>
          <li class="lg:col-span-4">
            <figure class="h-full overflow-hidden rounded-xl bg-staal">
              <div class="aspect-[4/3] overflow-hidden"><Foto src={olie} alt="De dubbele schaarlift met werkplatforms op een olievoertuig" widths={[480, 690]} sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw" class="object-top" /></div>
              <figcaption class="p-6">
                <p class="kicker text-vonk">Airport maintenance</p>
                <h3 class="mt-2 text-xl">Olievoertuig</h3>
                <p class="mt-2 text-sm text-white/80">Naast olievoertuigen ook aanhangwagens voor vliegtuigbanden en stikstof.</p>
              </figcaption>
            </figure>
          </li>
          <li class="lg:col-span-4">
            <figure class="h-full overflow-hidden rounded-xl bg-staal">
              <div class="aspect-[4/3] overflow-hidden"><Foto src={schaft} alt="Twee witte schaftwagens met rode hoekstrepen voor ons pand" widths={[480, 800]} sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw" /></div>
              <figcaption class="p-6">
                <p class="kicker text-vonk">Schaftwagens</p>
                <h3 class="mt-2 text-xl">Kan tegen een stootje</h3>
                <p class="mt-2 text-sm text-white/80">Polyester dak, gegalvaniseerd chassis en geïsoleerde sandwichpanelen: onderhoudsvriendelijk.</p>
              </figcaption>
            </figure>
          </li>
        </ul>
      </div>
    </section>

    <!-- Werkplaats en onderhoud: grote foto links (nooit breder dan 800), feiten rechts. -->
    <section id="werkplaats" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-roest"><span class="streep"></span>Werkplaats en magazijn</p>
          <h2 class="mt-4 text-3xl">Onderhoud volgens BOVAG</h2>
          <p class="mt-6 text-lg">Reparaties, aanpassingen en keuringen aan uw aanhangwagen, oplegger, caravan, vouwwagen, paardentrailer, veetrailer en bedrijfswagen tot en met 3.500 kg.</p>
          <figure class="mt-8 max-w-[800px]">
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={werkplaats} alt="Onze werkplaats van bovenaf: blauwe hefbruggen, een paardentrailer op de brug en een verkoopwagen in onderhoud" widths={[480, 800]} sizes="(min-width: 1024px) 560px, 100vw" /></div>
            <figcaption class="mt-2 text-sm text-ink-soft">Onze werkplaats, met hefbruggen en een remmentestbank.</figcaption>
          </figure>
          <div class="mt-8 rounded-xl bg-nacht p-6 text-white sm:p-8">
            <p class="font-display text-2xl leading-tight font-bold uppercase">Als enige in Limburg: een remmentestbank</p>
            <p class="mt-3 text-sm text-white/80">Onze werkplaats heeft een remmentestbank: het enige bedrijf in Limburg dat u deze service kan bieden. In onze keur- en teststraat voeren we diverse BOVAG-keuringen uit.</p>
          </div>
        </div>
        <div class="lg:col-span-6 lg:pt-2">
          <ol class="border-t border-line">
            {[
              { k: 'BOVAG-bewijs', t: 'Al ons onderhoud en reparatie voldoet aan de BOVAG-voorwaarden. U ontvangt hiervan een BOVAG-bewijs.' },
              { k: 'Jaarlijkse herinnering', t: 'Wij sturen u jaarlijks een herinneringsbrief voor de onderhoudsbeurt. U hoeft er zelf niet aan te denken.' },
              { k: 'Eerste beurt gratis', t: 'Bij aankoop van een nieuwe aanhangwagen is binnen 1 jaar de eerste onderhoudsbeurt gratis (excl. materiaal).' },
              { k: 'Slijtdelen op voorraad', t: 'Alle voorkomende slijtdelen op voorraad in ons magazijn. Ook voor losse onderdelen van alle merken.' },
              { k: 'Constructies op maat', t: 'Laswerk, inbouwen van apparatuur, camera- en beveiligingssystemen, chassisopbouw.' },
              { k: 'Caravanonderhoud', t: 'BOVAG-beurt voor elk merk en model, met keuringsrapport en BOVAG-sticker. Onderstel en remmen, banden en wielen, mover en accessoires.' },
            ].map((r, i) => (
              <li class="grid gap-1 border-b border-line py-5 sm:grid-cols-[2.5rem_11rem_1fr] sm:gap-5">
                <span class="font-display text-lg font-bold text-roest tabular-nums">0{i + 1}</span>
                <h3 class="text-lg">{r.k}</h3>
                <p class="text-ink-soft">{r.t}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Huur, lease en occasions -->
    <section id="occasions" class="scroll-mt-20 bg-beton py-16 lg:py-24">
      <div class="wrap">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="rounded-xl bg-white p-6 shadow-sm sm:p-8">
            <p class="kicker text-roest">Verhuur</p>
            <h2 class="mt-3 text-2xl">Een trailer huren</h2>
            <p class="mt-3 text-ink-soft">Wij verhuren alle soorten trailers. Neem contact met ons op voor de mogelijkheden.</p>
            <p class="mt-6 flex flex-wrap items-baseline gap-x-3 border-t border-line pt-5"><span class="text-sm text-ink-soft">1,5-paards trailer v.a.</span><strong class="font-display text-3xl whitespace-nowrap tabular-nums">€ 60</strong><span class="text-sm text-ink-soft">per dag, excl. borg</span></p>
          </div>
          <div class="rounded-xl bg-white p-6 shadow-sm sm:p-8">
            <p class="kicker text-roest">Lease en financiering</p>
            <h2 class="mt-3 text-2xl">Een trailer leasen</h2>
            <p class="mt-3 text-ink-soft">Wij schatten dat bij 70% van de aankopen de klant (deels) financiert. Daarom bespreken we graag de mogelijkheden. Uw gegevens worden volledig vertrouwelijk behandeld door onze financieringspartner DTC.</p>
            <p class="mt-6 flex flex-wrap items-baseline gap-x-3 border-t border-line pt-5"><strong class="font-display text-3xl tabular-nums">70%</strong><span class="text-sm text-ink-soft">van de aankopen wordt (deels) gefinancierd</span></p>
          </div>
        </div>

        <div class="mt-16 flex flex-wrap items-end justify-between gap-x-10 gap-y-3">
          <div>
            <p class="kicker text-roest"><span class="streep"></span>Occasions</p>
            <h2 class="mt-4 text-3xl">Uit de voorraad</h2>
          </div>
          <p class="max-w-md text-ink-soft">Een greep uit onze occasions en nieuwe aanhangers. Bel ons even voor de actuele voorraad.</p>
        </div>
        <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {occasions.map((o) => (
            <li class="group flex flex-col rounded-xl bg-white p-6 shadow-sm transition-shadow hover:shadow-lg">
              <div class="flex items-center justify-between gap-3">
                <span class={`rounded-md px-2 py-0.5 text-xs font-bold uppercase ${o.staat === 'Nieuw' ? 'bg-sein text-white' : 'bg-beton text-ink'}`}>{o.staat}</span>
                <span class="text-sm text-ink-soft tabular-nums">Bouwjaar {o.jaar}</span>
              </div>
              <h3 class="mt-4 text-xl">{o.naam}</h3>
              <dl class="mt-3 grid grid-cols-2 gap-2 text-sm">
                <div><dt class="text-ink-soft">Afmeting</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{o.maat}</dd></div>
                <div><dt class="text-ink-soft">Gewicht</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{o.gewicht}</dd></div>
              </dl>
              <p class="mt-auto flex items-baseline justify-between gap-3 border-t border-line pt-4 mt-5"><strong class="font-display text-2xl whitespace-nowrap tabular-nums">€ {o.prijs}</strong><span class="text-xs text-ink-soft">excl. btw</span></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Merken: typografische merkenwand op donker. -->
    <section id="merken" class="donker scroll-mt-20 bg-staal py-16 text-white lg:py-24">
      <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker text-vonk"><span class="streep"></span>Onze merken</p>
          <h2 class="mt-4 text-3xl">Dealer van een groot aantal fabrikanten</h2>
          <p class="mt-6 text-white/85">Ieder met een eigen specifiek productaanbod. Merken die samen een passend antwoord geven op elk transportprobleem.</p>
          <p class="mt-4 text-sm text-white/75">Ook dealer van Westfalia en Freeway.</p>
        </div>
        <ul class="grid grid-cols-1 border-t border-white/20 sm:grid-cols-2 lg:col-span-8">
          {merken.map((m) => (
            <li class="border-b border-white/20 py-4 sm:pr-6 sm:odd:border-r sm:even:pl-6">
              <h3 class="text-xl">{m.naam}</h3>
              <p class="mt-1 text-sm text-white/75">{m.kern}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Over ons -->
    <section id="over" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
        <figure class="relative lg:col-span-6">
          <div class="aspect-[4/3] max-w-[800px] overflow-hidden rounded-xl shadow-sm"><Foto src={pandFoto} alt="Een witte paardentrailer met drie assen voor ons pand in Voerendaal" widths={[480, 800]} sizes="(min-width: 1024px) 560px, 100vw" /></div>
          <figcaption class="mt-2 text-sm text-ink-soft">Onze locatie aan de {site.straat}.</figcaption>
        </figure>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="kicker text-roest"><span class="streep"></span>Over ons</p>
          <p class="mt-4 font-display text-reus leading-[0.85] font-bold text-rood">30+</p>
          <h2 class="mt-3 text-3xl">Jaar in het vak</h2>
          <p class="mt-6 text-lg">Gesitueerd in Voerendaal, in de mooie driehoek van Heerlen, Maastricht en Vaals, ook wel bekend als de Parkstad regio. Voor verkoop, aankoop, reparatie en onderhoud van uw aanhangwagen, paardentrailer, boottrailer of caravan.</p>
          <p class="mt-4 text-ink-soft">Onze ervaren monteurs volgen nauwlettend de laatste ontwikkelingen op het gebied van aanhangwagens. Met recht mogen we stellen dat Eussen Aanhangwagens een naam is die blijft hangen.</p>
          <p class="mt-6 border-l-2 border-rood pl-4 font-semibold">Graag verwelkomen wij u op onze nieuwe locatie.<br /><span class="font-normal text-ink-soft">Raoul Eussen</span></p>
        </div>
      </div>
    </section>

    <!-- Offerte en contact -->
    <section id="contact" class="donker scroll-mt-20 bg-nacht py-16 text-white lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-vonk"><span class="streep"></span>Contact</p>
          <h2 class="mt-4 text-3xl">Langskomen of bellen</h2>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-rood"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <p class="mt-6 text-white/85">Of bel <a href={site.tel2Href} class="whitespace-nowrap tabular-nums underline decoration-rood decoration-2 underline-offset-4">{site.tel2}</a>, of mail naar<br /><a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] underline decoration-rood decoration-2 underline-offset-4">{site.mail}</a></p>
          <address class="mt-8 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="mt-4 inline-block font-semibold underline decoration-rood decoration-2 underline-offset-4">Route plannen</a>
          <h3 class="mt-10 text-xl">Openingstijden</h3>
          <dl class="mt-4 border-t border-white/20">
            {tijden.map((t) => (
              <div class="flex justify-between gap-4 border-b border-white/20 py-3"><dt>{t.dag}</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{t.tijd}</dd></div>
            ))}
          </dl>
        </div>

        <form id="offerte" class="scroll-mt-20 rounded-xl bg-staal p-6 shadow-lg sm:p-8 lg:col-span-6 lg:col-start-7" action="#" onsubmit="return false">
          <p class="kicker text-vonk">Offerte</p>
          <h3 class="mt-2 text-2xl">Offerte aanvragen</h3>
          <p class="mt-2 text-sm text-white/80">Vul het formulier in, dan nemen wij zo spoedig mogelijk contact met u op.</p>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <div class="veld sm:col-span-2"><label for="f-type">Wat zoekt u?</label>
              <select id="f-type" name="type">
                {groepen.map((g) => <option value={g.id}>{g.titel}</option>)}
                <option value="onderhoud">Onderhoud of reparatie</option>
                <option value="anders">Iets anders</option>
              </select>
            </div>
            <fieldset class="veld sm:col-span-2">
              <legend>Koop, huur of lease</legend>
              <div class="mt-2 flex flex-wrap gap-2">
                {['Kopen', 'Huren', 'Leasen', 'Weet ik nog niet'].map((v, i) => (
                  <label class="optie"><input type="radio" name="vorm" value={v} class="sr-only" checked={i === 0} />{v}</label>
                ))}
              </div>
            </fieldset>
            <div class="veld"><label for="f-naam">Naam</label><input id="f-naam" name="naam" autocomplete="name" /></div>
            <div class="veld"><label for="f-tel">Telefoon</label><input id="f-tel" name="telefoon" type="tel" autocomplete="tel" /></div>
            <div class="veld sm:col-span-2"><label for="f-mail">E-mail</label><input id="f-mail" name="email" type="email" autocomplete="email" /></div>
            <div class="veld sm:col-span-2"><label for="f-wens">Uw wensen</label><textarea id="f-wens" name="wensen" rows="3" placeholder="Bijvoorbeeld afmeting, gewicht of wat u wilt vervoeren"></textarea></div>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg bg-nacht p-4 text-sm text-white/90">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="font-semibold whitespace-nowrap tabular-nums underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold break-all underline">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-rood mt-6">Versturen</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
