---
// Hun eigen logo (uit de omslagfoto van hun Facebookpagina, witte achtergrond weggehaald).
import { Image } from 'astro:assets';
import { url } from '../data/site';
import logo from '../assets/logo.png';
import logoLicht from '../assets/logo-licht.png';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = 'h-12 w-auto md:h-14' } = Astro.props;
---
<a href={url('')} class="inline-flex shrink-0 items-center no-underline" aria-label="Boutique Mieke, naar de homepage">
  <Image src={licht ? logoLicht : logo} alt="Boutique Mieke" widths={[120, 180, 240]} sizes="10rem" class={cls} loading="eager" />
</a>
