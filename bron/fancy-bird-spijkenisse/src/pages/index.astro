---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Vogel from '../components/Vogel.astro';
import { site, tijden, reviews, waHoi, waMet } from '../data/site';

import hero from '../assets/sfeer-jurken.jpg';
import toonbank from '../assets/eigen-toonbank.jpg';
import lijst from '../assets/eigen-lijst.jpg';
import rek from '../assets/eigen-rek.jpg';
import oorbellen from '../assets/sfeer-oorbellen.jpg';
import koffie from '../assets/sfeer-koffie.jpg';

// Alles hieronder komt uit hun Instagram-bio, Google-profiel en shoppeninspijkenisse.nl.
const aanbod = [
  ['Dameskleding', 'elke week nieuwe items'],
  ['Fancy Jewels', 'onze eigen sieradenlijn'],
  ['My Jewellery', 'ook bij ons in de winkel'],
  ['Persoonlijk advies', 'we kijken met je mee'],
  ['Shoppen & koffie', 'de koffie staat klaar'],
  ['Verzenden?', 'stuur ons een DM'],
];
const soorten = [['jurk', 'Jurk'], ['blouse', 'Blouse'], ['set', 'Set'], ['sieraad', 'Sieraad'], ['anders', 'Iets anders']];
const titel = 'Fancy Bird | Het modewinkeltje in Spijkenisse';
const omschrijving = 'Fancy Bird, dameskleding en eigen sieraden (Fancy Jewels) aan de Nieuwstraat 188 in Stadsplein Shopping Center, Spijkenisse. Elke week nieuwe items, persoonlijk advies en de koffie staat klaar.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- HERO: groot sfeerbeeld met kleur, kop in Gloock -->
    <section class="donker relative isolate flex min-h-[38rem] items-end overflow-hidden bg-nacht text-licht md:min-h-[calc(100svh-7.25rem)] md:max-h-[56rem]">
      <Image src={hero} alt="Een lang rek vol jurken en blouses in felle kleuren" widths={[640, 960, 1440, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_30%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#24161ce6_0%,#24161cb3_38%,#24161c26_75%)] max-md:bg-[linear-gradient(0deg,#24161cf2_0%,#24161cb8_55%,#24161c33_100%)]" aria-hidden="true"></div>
      <div class="wrap pb-14 pt-28 md:pb-20">
        <h1 class="max-w-[13ch] text-hero">Het mode&shy;winkeltje in <span class="text-fel">Spijkenisse</span></h1>
        <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-xl">Dameskleding en onze eigen sieraden, elke week nieuwe items en persoonlijk advies. Kom langs, de koffie staat klaar.</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={waHoi} class="knop knop-roze"><Icoon naam="wa" />Vraag het via WhatsApp</a>
          <a href="#bezoek" class="link font-semibold">Naar de winkel aan het Stadsplein</a>
        </div>
      </div>
      <p class="absolute bottom-4 right-5 text-[.6875rem] uppercase tracking-[.16em] text-licht/70">Sfeerbeeld</p>
    </section>

    <!-- DE WINKEL: vergulde lijst om hun eigen toonbank + prijslijstje-typografie -->
    <section id="winkel" class="py-24 md:py-32">
      <div class="wrap grid items-start gap-x-10 gap-y-16 lg:grid-cols-12">
        <figure class="rijs mx-auto w-full max-w-[22rem] lg:col-span-4 lg:mx-0 lg:mt-3">
          <div class="lijst">
            <div class="lijst-binnen aspect-[4/5]">
              <Image src={toonbank} alt="De toonbank van Fancy Bird met het houten FANCY BIRD-bord en bloemen" widths={[425]} sizes="22rem" class="h-full w-full object-cover" />
            </div>
          </div>
          <figcaption class="mt-5 text-center text-sm text-grijs">Onze toonbank, met het FANCY BIRD-bord.</figcaption>
        </figure>
        <div class="lg:col-span-7 lg:col-start-6">
          <blockquote class="rijs">
            <p class="font-kop text-3xl leading-[1.04]">“Fancy Bird, ook wel gezegd: <span class="text-flamingo">Hippe vogel!</span>”</p>
            <footer class="mt-4 text-sm text-grijs">Zo stelt Shoppen in Spijkenisse ons voor.</footer>
          </blockquote>
          <p class="rijs mt-8 max-w-xl text-lg text-grijs">We zoeken de leukste merkjes en musthaves voor dames. Veel kleur, veel gezelligheid, en altijd iemand die met je meekijkt.</p>
          <ul class="mt-12 border-t border-lijn">
            {aanbod.map(([wat, uitleg], i) => (
              <li class="rijs flex items-baseline gap-4 border-b border-lijn py-4 md:py-5" style={`--d:${i * 0.05}s`}>
                <span class="font-kop text-xl md:text-2xl">{wat}</span>
                <span class="stip hidden sm:block" aria-hidden="true"></span>
                <span class="ml-auto text-right text-[.9375rem] text-grijs sm:ml-0">{uitleg}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- FANCY JEWELS: donker, groot woordbeeld -->
    <section id="jewels" class="donker overflow-hidden bg-nacht text-licht">
      <div class="wrap grid gap-y-12 py-24 md:py-32 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-7">
          <h2 class="rijs font-kop text-[clamp(4rem,11vw,10rem)] leading-[.85] tracking-[-.03em]">Fancy<br /><span class="text-fel">Jewels</span></h2>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:max-w-2xl">
            <p class="rijs text-lg">Onze eigen sieradenlijn. Te zien in de winkel en in onze reels.</p>
            <p class="rijs text-licht-zacht" style="--d:.1s">Daarnaast hebben we ook sieraden van My Jewellery. Iets moois gezien? Stuur ons een berichtje, dan kijken we of het er nog is.</p>
          </div>
          <div class="rijs mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={waMet('Hoi Fancy Bird! Ik zag een sieraad van Fancy Jewels. Is dit er nog?')} class="knop knop-roze"><Icoon naam="wa" />Vraag naar een sieraad</a>
            <a href={site.instagram} class="link font-semibold">Nieuwste sieraden op Instagram</a>
          </div>
        </div>
        <figure class="relative lg:col-span-5">
          <Image src={oorbellen} alt="Twee gedraaide gouden oorringen op een witte steen in de zon" widths={[480, 800, 1000]} sizes="(min-width: 1024px) 30vw, 100vw" class="rijs aspect-[4/5] w-full rounded-md object-cover max-lg:max-h-[30rem]" />
          <figcaption class="absolute bottom-3 right-4 text-[.6875rem] uppercase tracking-[.16em] text-inkt/70">Sfeerbeeld</figcaption>
        </figure>
      </div>
    </section>

    <!-- LIVE: elke week nieuw, eigen Instagram-beelden -->
    <section id="live" class="bg-roos py-24 md:py-32">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl">Elke week nieuw. En soms gaan we <span class="text-flamingo">live.</span></h2>
          <p class="rijs mt-7 max-w-md text-lg text-grijs">Nieuwe items zie je het eerst op Instagram. Bij Fancy Bird Live laten we ze ’s avonds zien, zoals op 10 september om 20.00 uur. En dan zijn er nog de Ladies Nights en de Fancy Bird Show.</p>
          <p class="rijs mt-5 max-w-md text-grijs">Op donderdag 18 juni 2026 vierden we 11 jaar Fancy Bird.</p>
          <a href={site.instagram} class="rijs knop knop-inkt mt-9"><Icoon naam="insta" />Volg @fancybirdspijkenisse</a>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:gap-5 lg:col-span-7">
          <a href={site.instagram} class="rijs group relative block overflow-hidden rounded-md row-span-2" aria-label="Fancy Bird op Instagram: rek met nieuwe items">
            <Image src={rek} alt="Rek met nieuwe items in de winkel: blouses, vesten, een nepbontjas en tassen op de plank" widths={[360]} sizes="(min-width: 1024px) 22rem, 50vw" class="h-full min-h-[18rem] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
          </a>
          <a href={site.instagram} class="rijs group relative block overflow-hidden rounded-md" style="--d:.08s" aria-label="Fancy Bird op Instagram: het logo in een vergulde lijst">
            <Image src={lijst} alt="Het FANCY BIRD-logo in een vergulde lijst aan de mintgroene muur van de winkel" widths={[640]} sizes="(min-width: 1024px) 22rem, 50vw" class="aspect-square w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]" />
          </a>
          <a href={site.instagram} class="rijs flex flex-col justify-between rounded-md bg-flamingo p-5 text-wit no-underline transition-colors hover:bg-flamingo-diep sm:p-7" style="--d:.16s">
            <Vogel class="h-8 w-8" />
            <span>
              <span class="num block font-kop text-[clamp(2rem,3.4vw,3rem)] leading-none">6.680</span>
              <span class="mt-2 block text-sm font-semibold">volgers op Instagram, en ruim 4.200 op Facebook</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- WOW: vraag via WhatsApp, als kledinglabel -->
    <section id="vraag" class="py-24 md:py-32">
      <div class="wrap grid items-start gap-y-14 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:sticky lg:top-32 lg:col-span-5">
          <h2 class="rijs text-3xl">Geen webshop.<br /><span class="text-flamingo">Wel WhatsApp.</span></h2>
          <p class="rijs mt-7 max-w-md text-lg text-grijs">Onze webshop is in de maak. Zag je iets op Instagram of in de etalage? Vraag het ons, dan kijken we of het er nog is in jouw maat.</p>
          <p class="rijs mt-8 inline-flex items-center gap-2.5 rounded-full bg-roos px-4 py-2 text-sm font-semibold" data-status-wrap>
            <span class="stip-open h-2.5 w-2.5 rounded-full bg-grijs" aria-hidden="true"></span>
            <span data-status>Ma 13.00-17.00, di t/m za 10.00-17.00, do tot 20.00</span>
          </p>
        </div>

        <div class="rijs lg:col-span-6 lg:col-start-7">
          <div class="relative mx-auto max-w-xl">
            <form class="label px-6 pb-8 pt-16 shadow-md sm:px-10 sm:pb-10 sm:pt-20" data-vraag aria-labelledby="vraag-titel">
              <span class="label-gat" aria-hidden="true"></span>
              <p id="vraag-titel" class="text-center font-kop text-2xl">Is dit er nog?</p>
              <p class="mt-1 text-center text-sm text-grijs">Kies, vul je maat in en open het bericht in WhatsApp.</p>

              <fieldset class="mt-8">
                <legend class="text-sm font-bold">Ik zag</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  {soorten.map(([v, t], i) => (
                    <label>
                      <input type="radio" name="soort" value={v} class="peer sr-only" checked={i === 0} />
                      <span class="keus">{t}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="mt-6 grid gap-5 sm:grid-cols-2">
                <label class="block">
                  <span class="text-sm font-bold">Waar?</span>
                  <select name="waar" class="veld mt-2">
                    <option>op Instagram</option>
                    <option>op Facebook</option>
                    <option>in de etalage</option>
                    <option>bij Fancy Bird Live</option>
                  </select>
                </label>
                <label class="block" data-maat>
                  <span class="text-sm font-bold">Maat</span>
                  <input name="maat" type="text" class="veld mt-2" placeholder="Bijvoorbeeld M of 38" autocomplete="off" />
                </label>
              </div>
              <label class="mt-5 block">
                <span class="text-sm font-bold">Welke precies? <span class="font-normal text-grijs">(mag leeg)</span></span>
                <input name="welke" type="text" class="veld mt-2" placeholder="Bijvoorbeeld de roze blouse uit jullie post" autocomplete="off" />
              </label>
              <label class="mt-5 flex cursor-pointer items-center gap-3 text-[.9375rem]">
                <input name="verzenden" type="checkbox" class="h-5 w-5 accent-[#cf2462]" />
                Kunnen jullie het opsturen?
              </label>

              <div class="mt-8 rounded-xl rounded-tl-sm bg-[#e7f6df] p-4 text-[.9375rem] leading-relaxed text-inkt" aria-live="polite">
                <p class="text-xs font-bold text-[#2f6a3a]">Jouw bericht</p>
                <p class="mt-1" data-bericht>Hoi Fancy Bird! Ik zag een jurk op Instagram. Is dit er nog in maat …?</p>
              </div>
              <a href={waHoi} class="knop knop-roze mt-6 w-full" data-stuur><Icoon naam="wa" />Open in WhatsApp</a>
              <p class="mt-3 text-center text-xs text-grijs">Er wordt pas iets verstuurd als jij in WhatsApp op verzenden drukt.</p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- REVIEWS: grote citaten -->
    <section id="reviews" class="border-t border-lijn bg-wit py-24 md:py-32">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs max-w-2xl text-3xl">Over de meiden van <span class="text-flamingo">Fancy Bird</span></h2>
          <a href={site.reviews} class="rijs inline-flex items-center gap-2.5 text-sm font-semibold no-underline hover:text-flamingo">
            <Icoon naam="g" class="h-5 w-5" />
            <span class="flex gap-0.5 text-ster" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            {site.google.score} uit {site.google.aantal} Google-reviews
          </a>
        </div>
        <div class="mt-14 grid gap-x-10 gap-y-12 lg:grid-cols-12">
          <figure class="rijs lg:col-span-7">
            <blockquote class="font-kop text-[clamp(1.75rem,2.4vw+1rem,2.75rem)] leading-[1.12]">“{reviews[0].tekst}”</blockquote>
            <figcaption class="mt-6 text-sm text-grijs"><b class="font-semibold text-inkt">{reviews[0].naam}</b> · Google-review</figcaption>
          </figure>
          <div class="grid content-start gap-10 lg:col-span-4 lg:col-start-9 lg:border-l lg:border-lijn lg:pl-10">
            {reviews.slice(1).map((r, i) => (
              <figure class="rijs" style={`--d:${0.1 + i * 0.1}s`}>
                <span class="flex gap-0.5 text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
                <blockquote class="mt-3 text-lg leading-snug">“{r.tekst}”</blockquote>
                <figcaption class="mt-3 text-sm text-grijs"><b class="font-semibold text-inkt">{r.naam}</b> · Google-review</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- BEZOEK ONS -->
    <section id="bezoek" class="bg-papier py-24 md:py-32">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs relative self-start overflow-hidden rounded-md lg:col-span-5">
          <Image src={koffie} alt="Cappuccino met latte art in een roze kopje" widths={[480, 800, 1000]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[4/5] w-full object-cover max-lg:max-h-[28rem]" />
          <div class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#24161ccc,#24161c00)] p-6 pt-24 sm:p-8 sm:pt-28">
            <p class="font-kop text-[clamp(1.875rem,2vw+1.2rem,2.75rem)] leading-none text-licht">Kom langs, de koffie staat klaar.</p>
          </div>
          <figcaption class="absolute right-4 top-3 text-[.6875rem] uppercase tracking-[.16em] text-inkt/70">Sfeerbeeld</figcaption>
        </figure>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-4">
          <h2 class="rijs text-3xl">Bezoek ons</h2>
          <address class="rijs mt-7 not-italic">
            <p class="text-xl font-semibold">{site.straat}</p>
            <p class="text-lg text-grijs">{site.postcode} {site.plaats} · in {site.centrum}</p>
          </address>
          <p class="rijs mt-6 inline-flex items-center gap-2.5 rounded-full bg-roos px-4 py-2 text-sm font-semibold" data-status-wrap>
            <span class="stip-open h-2.5 w-2.5 rounded-full bg-grijs" aria-hidden="true"></span>
            <span data-status>Ma 13.00-17.00, di t/m za 10.00-17.00, do tot 20.00</span>
          </p>
          <table class="rijs mt-8 w-full max-w-md text-[1rem]">
            <caption class="sr-only">Openingstijden Fancy Bird</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-bold data-[vandaag]:text-flamingo">
                  <th scope="row" class="py-2.5 text-left font-[inherit]">{t.naam}{t.dag === 4 && <span class="ml-2 text-xs font-semibold text-grijs">koopavond</span>}</th>
                  <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={site.maps} class="knop knop-inkt"><Icoon naam="pin" />Route plannen</a>
            <a href={waHoi} class="knop knop-roze"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-wit shadow-sm"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- SLOTBAND -->
    <section class="relative overflow-hidden bg-flamingo text-wit">
      <Vogel class="pointer-events-none absolute -right-10 -top-6 h-72 w-72 text-[#ffffff1a] max-sm:hidden" />
      <div class="wrap flex flex-wrap items-center justify-between gap-8 py-14 md:py-16">
        <p class="max-w-2xl font-kop text-[clamp(1.875rem,2.4vw+1rem,3rem)] leading-[1.02]">Veel kleur &amp; gezelligheid. Tot snel in de winkel!</p>
        <a href={waHoi} class="knop knop-wit"><Icoon naam="wa" />WhatsApp ons</a>
      </div>
    </section>
  </main>
  <Voet />

  <style>
    [data-open='true'] .stip-open { background: #23a565; box-shadow: 0 0 0 4px #23a56533; }
  </style>

  <script>
    import { waMet } from '../data/site';
    const f = document.querySelector<HTMLFormElement>('[data-vraag]');
    if (f) {
      const uit = f.querySelector<HTMLElement>('[data-bericht]')!;
      const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const maatVak = f.querySelector<HTMLElement>('[data-maat]')!;
      const woord: Record<string, string> = { jurk: 'een jurk', blouse: 'een blouse', set: 'een set', sieraad: 'een sieraad van Fancy Jewels', anders: 'iets leuks' };
      const maak = () => {
        const d = new FormData(f);
        const soort = String(d.get('soort') || 'jurk');
        const welke = String(d.get('welke') || '').trim();
        const maat = String(d.get('maat') || '').trim();
        const sieraad = soort === 'sieraad';
        maatVak.style.opacity = sieraad ? '.4' : '';
        (maatVak.querySelector('input') as HTMLInputElement).disabled = sieraad;
        let t = `Hoi Fancy Bird! Ik zag ${woord[soort]} ${d.get('waar')}${welke ? ` (${welke})` : ''}.`;
        t += sieraad ? ' Is dit er nog?' : ` Is dit er nog in maat ${maat || '…'}?`;
        if (d.get('verzenden')) t += ' En kunnen jullie het opsturen?';
        uit.textContent = t;
        stuur.href = waMet(t);
      };
      f.addEventListener('input', maak); f.addEventListener('change', maak); f.addEventListener('submit', (e) => e.preventDefault());
      maak();
    }
  </script>
</Base>
