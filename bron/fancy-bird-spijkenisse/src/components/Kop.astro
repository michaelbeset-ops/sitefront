---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['winkel', 'De winkel'], ['jewels', 'Fancy Jewels'], ['live', 'Live'], ['vraag', 'Iets gezien?'], ['bezoek', 'Bezoek ons']];
---
<div class="bg-nacht text-licht">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[.8125rem]">
    <p class="flex min-w-0 items-center gap-2 whitespace-nowrap" data-status-wrap>
      <span class="stip-status h-2 w-2 flex-none rounded-full bg-licht-zacht" aria-hidden="true"></span>
      <span data-status class="truncate">Ma 13.00-17.00, di t/m za 10.00-17.00, do tot 20.00</span>
      <span class="hidden text-licht-zacht md:inline">· {site.straat}, {site.centrum}</span>
    </p>
    <a href={site.telHref} class="num hidden items-center gap-1.5 font-semibold no-underline hover:text-fel md:flex"><Icoon naam="tel" class="h-3.5 w-3.5" />{site.tel}</a>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-md">
  <div class="wrap flex h-[4.75rem] items-center justify-between gap-3">
    <Merk />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[.9375rem] font-semibold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-flamingo">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={waHoi} class="knop knop-roze knop-klein hidden sm:inline-flex"><Icoon naam="wa" />WhatsApp ons</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full bg-wit shadow-sm lg:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu" aria-label="Menu" class="hidden border-t border-lijn bg-papier lg:hidden" data-menu>
    <ul class="wrap py-4">
      {nav.map(([id, t]) => <li><a href={h(id)} class="flex items-center justify-between border-b border-lijn py-3.5 font-kop text-2xl no-underline">{t}<Icoon naam="pijl" class="h-5 w-5 text-flamingo" /></a></li>)}
      <li class="pt-5"><a href={waHoi} class="knop knop-roze w-full"><Icoon naam="wa" />WhatsApp ons</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2.5 border-t border-lijn bg-papier/95 p-2.5 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="knop knop-wit knop-klein shadow-sm"><Icoon naam="tel" />Bellen</a>
  <a href={waHoi} class="knop knop-roze knop-klein"><Icoon naam="wa" />WhatsApp</a>
</div>

<style>
  [data-open='true'] .stip-status { background: #5fd39a; box-shadow: 0 0 0 3px #5fd39a33; }
</style>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
