---
import Vogel from './Vogel.astro';
import { site, url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<a href={url('')} class:list={['merk', licht && 'text-licht']} aria-label="Fancy Bird, dameskleding en sieraden, naar de homepage">
  <span class:list={['merk-teken', licht && '!bg-flamingo !text-wit']}><Vogel class="h-6 w-6" /></span>
  <span><b>FANCY BIRD</b><small>Dameskleding &amp; sieraden</small></span>
</a>
