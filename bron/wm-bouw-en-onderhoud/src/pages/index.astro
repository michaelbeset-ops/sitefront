---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;

// Werkzaamheden zoals W&M ze zelf op Facebook noemt.
const werk = ['Schilderwerk', 'Timmerwerk', 'Badkamer verbouwen', 'Keuken verbouwen', 'Onderhoud'];
---
<Base
  title="W&M bouw en onderhoud | Verbouwen en onderhoud in Dordrecht"
  description="W&M bouw en onderhoud uit Dordrecht: schilderwerk, timmerwerk en het verbouwen van uw badkamer of keuken. Bel 06 51 40 31 26."
>
  <!-- Hero: foto over de volle breedte, kop onderin. -->
  <section class="relative isolate bg-night text-paper">
    <div class="absolute inset-0 -z-10 [&_img]:h-full [&_img]:w-full [&_img]:object-cover">
      <Foto naam="hero" alt="Vakmannen zagen een plank op maat in een woning in verbouwing" sizes="100vw" eager />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(22_25_42/0.92)_10%,rgb(22_25_42/0.5)_55%,rgb(22_25_42/0.1))]"></div>
    <div class="absolute inset-0 -z-10 bg-[rgb(22_25_42/0.4)] lg:bg-[rgb(22_25_42/0.15)]"></div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 min-h-[34rem] sm:min-h-[40rem] lg:min-h-[44rem] flex flex-col justify-end pt-20 pb-12 sm:pb-16">
      <h1 class="text-4xl max-w-[15ch]">Verbouwen en onderhoud in Dordrecht</h1>
      <p class="mt-6 max-w-xl text-lg text-paper/90">W&amp;M bouw en onderhoud is een klein bouwbedrijf voor schilderwerk, timmerwerk en het verbouwen van uw badkamer of keuken.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="tel:+31651403126" class="inline-flex bg-accent text-paper font-semibold px-5 py-3 hover:bg-accent-deep transition-colors">Bel 06 51 40 31 26</a>
        <a href={u('#contact')} class="inline-flex border border-paper/70 px-5 py-3 hover:bg-paper hover:text-ink transition-colors">Vraag een prijsopgave</a>
      </div>
    </div>
  </section>

  <!-- Werk als grote typografische lijst met een korte regel erachter. -->
  <section id="werk" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="text-3xl">Waar u ons voor belt</h2>
      <p class="mt-5 text-ink-soft">De meest voorkomende bouw- en onderhoudsklussen, in en om het huis.</p>
    </div>
    <ul class="lg:col-span-8 border-t-2 border-ink">
      {werk.map((titel, i) => (
        <li class="py-5 border-b border-line flex items-baseline gap-6">
          <span class="text-sm text-accent tabular-nums w-6">{String(i + 1).padStart(2, '0')}</span>
          <span class="display text-2xl sm:text-3xl">{titel}</span>
        </li>
      ))}
    </ul>
    <p class="lg:col-start-5 lg:col-span-8 -mt-6 text-sm text-ink-soft">[[AANLEVEREN: per klus een zin over hoe jullie werken]]</p>
  </section>

  <section id="aanpak" class="bg-paper-2">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7 [&_img]:w-full [&_img]:h-auto">
        <Foto naam="werk" alt="Ruimte in verbouwing met gereedschap en platen" sizes="(min-width: 1024px) 55vw, 100vw" />
      </div>
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Klein bedrijf, korte lijnen</h2>
        <p class="mt-6 text-ink-soft">U heeft contact met de mensen die het werk ook doen. Vertel wat u wilt laten doen, dan krijgt u een duidelijke prijsopgave.</p>
        <p class="mt-3 text-sm text-ink-soft">[[AANLEVEREN: foto's van eigen projecten en wie W&amp;M zijn]]</p>
      </div>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 class="text-3xl">Prijsopgave aanvragen</h2>
      <p class="mt-5 text-ink-soft">Bel, mail of vul het formulier in. Een paar foto's van de ruimte maken het makkelijker.</p>
      <p class="mt-8 leading-8">
        <a class="font-semibold hover:text-accent" href="tel:+31651403126">06 51 40 31 26</a><br />
        <a class="hover:text-accent break-all" href="mailto:info@bouwbedrijfwm.nl">info@bouwbedrijfwm.nl</a>
      </p>
      <p class="mt-6">Einsteinstraat 67-12<br />3316 GG Dordrecht</p>
    </div>
    <form class="lg:col-span-6 lg:col-start-7 grid gap-5" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-key]]" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2 text-sm">Naam<input name="naam" required autocomplete="name" class="bg-paper border border-line px-3 py-3 text-base" /></label>
        <label class="grid gap-2 text-sm">Telefoon<input name="telefoon" type="tel" required autocomplete="tel" class="bg-paper border border-line px-3 py-3 text-base" /></label>
      </div>
      <label class="grid gap-2 text-sm">Wat wilt u laten doen?<textarea name="bericht" rows="5" class="bg-paper border border-line px-3 py-3 text-base"></textarea></label>
      {voorstel ? (
        <p class="border border-accent px-4 py-3 text-sm">Dit is een ontwerpvoorstel, dus het formulier verstuurt nog niets. Bel <a class="underline" href="tel:+31651403126">06 51 40 31 26</a> of mail <a class="underline" href="mailto:info@bouwbedrijfwm.nl">info@bouwbedrijfwm.nl</a>.</p>
      ) : (
        <button type="submit" class="justify-self-start bg-accent text-paper font-semibold px-6 py-3 hover:bg-accent-deep">Verstuur aanvraag</button>
      )}
      <p class="text-xs text-ink-soft">We gebruiken uw gegevens alleen voor uw aanvraag. Zie de <a class="underline" href={u('privacy/')}>privacyverklaring</a>.</p>
    </form>
  </section>
</Base>
