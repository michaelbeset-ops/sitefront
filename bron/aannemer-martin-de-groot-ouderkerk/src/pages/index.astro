---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, werkgebied, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import stuken2 from '../assets/stuken2.jpg';
import stuken6 from '../assets/stuken6.jpg';
import stuken7 from '../assets/stuken7.jpg';
import stuken8 from '../assets/stuken8.jpg';
import stuken10 from '../assets/stuken10.jpg';
import stuken11 from '../assets/stuken11.jpg';
import voegen2 from '../assets/voegen2.jpg';
import voegen3 from '../assets/voegen3.jpg';
import voegen6 from '../assets/voegen6.jpg';
import voegen7 from '../assets/voegen7.jpg';
import metselen1 from '../assets/metselen1.jpg';
import metselen3 from '../assets/metselen3.jpg';
import metselen4 from '../assets/metselen4.jpg';
import metselen6 from '../assets/metselen6.jpg';
import metselen7 from '../assets/metselen7.jpg';

const vraag = (d: string) => waMet(`Goedendag Martin, ik heb een vraag over ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Stucwerk', d: 'Om later over te verven of te behangen, of juist als mooie afwerking op zich. Samen maken we een plan voor uw ruimte.', src: stuken7, alt: 'Schoorsteen boven een haard met granieten plaat, strak wit gestuct', pos: '50% 40%', icoon: 'spaan' },
  { t: 'Voegwerk', d: 'Een strakke voeg geeft de muur een nette uitstraling. We voegen, reinigen en restaureren gevels van woning, kantoor en bedrijf.', src: voegen2, alt: 'Nieuw gevoegde gevel van gele en roze baksteen onder een raamkozijn', pos: '50% 50%', icoon: 'meter' },
  { t: 'Metselwerk', d: 'Van kleine muurtjes tot grote bouwwerken. Uw wensen worden vakkundig en precies uitgevoerd.', src: metselen4, alt: 'Nieuw metselwerk tegen een bestaande gevel, met een waterslag onder het kozijn', pos: '40% 50%', icoon: 'muur' },
];

const projecten = [
  { src: stuken10, cat: 'stucwerk', alt: 'Gestucte vide met trapgat, inbouwspots en een groot raam', groot: true },
  { src: voegen3, cat: 'voegwerk', alt: 'Close-up van nieuw voegwerk in gele baksteen' },
  { src: metselen1, cat: 'metselwerk', alt: 'Metselwerk onder een raampartij in uitvoering, met stapels stenen en specikuipen' },
  { src: voegen7, cat: 'voegwerk', alt: 'Gevoegde gevel langs een terras' },
  { src: stuken6, cat: 'stucwerk', alt: 'Gestucte wand naast een haard, nog met afgeplakte vloer' },
  { src: metselen6, cat: 'metselwerk', alt: 'Gevel van rode baksteen met voordeur en raam' },
  { src: voegen6, cat: 'voegwerk', alt: 'Lange gevoegde gevel in perspectief' },
  { src: stuken11, cat: 'stucwerk', alt: 'Gestucte overloop met een witte borstwering' },
  { src: metselen7, cat: 'metselwerk', alt: 'Muur van rode baksteen in halfsteens verband' },
];
const groot = await Promise.all(projecten.map((p) => getImage({ src: p.src, width: p.src.width, format: 'webp' })));

const stappen = [
  ['Bel of app', 'Vertel kort wat u wilt laten doen. U kunt altijd even bellen om advies te vragen.'],
  ['We komen langs', 'Vrijblijvend en kosteloos bekijken we de situatie en uw wensen op locatie.'],
  ['Plan en prijs', 'Samen maken we een plan. Zo weet u precies wat er gaat gebeuren en wat het gaat kosten.'],
  ['Vakkundig uitgevoerd', 'Zijn er extra materialen of mensen nodig, dan schakelen we snel. Zo ontstaat er geen vertraging.'],
];
---
<Base title={`${site.naam} | Metselwerk, voegwerk en stucwerk in Ouderkerk aan den IJssel`} description="Aannemersbedrijf Martin de Groot uit Ouderkerk aan den IJssel: stucwerk, voegwerk, metselwerk en lijmwerk van kalkzandsteen. Kosteloos advies op locatie in de regio Rotterdam, Krimpenerwaard en Gouda.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: eigen werkfoto op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1800]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_40%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0b2f3c40_0%,#0b2f3cc4_42%,#0b2f3cf5_100%)] md:bg-[linear-gradient(90deg,#0b2f3cf7_0%,#0b2f3cd9_45%,#0b2f3c40_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow"><span class="sm:hidden">Aannemer in Ouderkerk a/d IJssel</span><span class="hidden sm:inline">Aannemer in Ouderkerk aan den IJssel</span></p>
          <h1 id="t-hero" class="mt-6 text-hero">Metselwerk, voegwerk <span class="text-lucht">en stucwerk.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Met jarenlange ervaring en oog voor detail. Voor woningen, kantoren en bedrijven in de regio Rotterdam, Krimpenerwaard en Gouda.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-blauw"><Icoon naam="wa" />Offerte via WhatsApp</a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-lucht" />Kosteloos advies op locatie</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 17.00 uur</span></li>
            <li><a href={site.telHref} class="num flex items-center gap-2 font-semibold text-licht no-underline hover:text-lucht"><Icoon naam="tel" class="h-4 w-4 text-lucht" />{site.tel}</a></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto w-full max-w-[19rem] rounded-md bg-licht/10 p-2.5 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <Image src={stuken8} alt="Vrijstaande haard met een strak wit gestucte schouw" widths={[300, 450]} sizes="300px" loading="eager" class="aspect-[4/5] w-full rounded-sm object-cover" />
            <figcaption class="flex items-center justify-between gap-3 px-2 pb-1 pt-3 text-sm">
              <span class="whitespace-nowrap">Schouw gestuct</span>
              <a href="#voor-na" class="flex items-center gap-1 whitespace-nowrap font-semibold text-licht no-underline hover:text-lucht">Voor en na<Icoon naam="pijl" class="h-4 w-4" /></a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Werkzaamheden in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-sm border border-lijn bg-kalk px-4 py-2 text-sm font-medium no-underline transition-colors hover:border-blauw hover:bg-blauw hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-24 lg:py-28" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-dienst" class="mt-5 text-3xl">Van een kleine muur tot een groot bouwwerk.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Moet uw muur gestuct worden, of moet de muur eerst nog gebouwd worden? Voor allebei bent u bij Martin de Groot aan het juiste adres.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-16 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600]} sizes="(min-width: 1248px) 380px, (min-width: 768px) 31vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                  <span class="absolute left-4 top-4 grid h-11 w-11 place-items-center rounded-sm bg-nacht text-lucht"><Icoon naam={b.icoon} class="h-5 w-5" /></span>
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-[2.25rem]">{b.t}</h3>
                  <p class="mt-3 flex-1 text-grijs">{b.d}</p>
                  <span class="mt-6 flex items-center gap-2 text-sm font-semibold text-blauw">Vraag het Martin<Icoon naam="pijl" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-6 flex flex-col items-start justify-between gap-5 rounded-md bg-zand px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="flex items-start gap-4 text-lg"><Icoon naam="blok" class="mt-1 h-6 w-6 shrink-0 text-blauw" /><span><b class="font-semibold">Ook voor lijmwerk van kalkzandsteen.</b> <span class="text-grijs">Twijfelt u wat u nodig heeft? Bel gerust even voor advies.</span></span></p>
          <a href={site.telHref} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Vakgebieden: stuken, voegen, metselen</dt><dd class="num order-first font-kop text-[clamp(3.5rem,3vw+2.5rem,4.75rem)] font-semibold leading-[.85] text-blauw">3</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Plaatsen in ons werkgebied</dt><dd class="num order-first font-kop text-[clamp(3.5rem,3vw+2.5rem,4.75rem)] font-semibold leading-[.85]">13</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Kosten voor advies op locatie</dt><dd class="num order-first font-kop text-[clamp(3.5rem,3vw+2.5rem,4.75rem)] font-semibold leading-[.85]">€ 0</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Bereikbaar op werkdagen</dt><dd class="num order-first font-kop text-[clamp(3.5rem,3vw+2.5rem,4.75rem)] font-semibold leading-[.85]">8-17</dd></div>
      </dl>
    </section>

    <!-- 5. Voor en na (wow) -->
    <section id="voor-na" class="bg-zand py-24 lg:py-28" aria-labelledby="t-vn">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="rijs lg:col-span-5">
          <p class="eyebrow">Voor en na</p>
          <h2 id="t-vn" class="mt-5 text-3xl">Van kale steen naar strak stucwerk.</h2>
          <p class="mt-6 text-lg text-grijs">Een schouw van baksteen, strak wit gestuct. Sleep over de foto om het verschil te zien.</p>
          <ul class="mt-8 space-y-3">
            <li class="flex items-start gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 shrink-0 text-blauw" />Stucwerk als eindresultaat, of als basis voor verf en behang</li>
            <li class="flex items-start gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 shrink-0 text-blauw" />Advies over het stucen van uw ruimte</li>
            <li class="flex items-start gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 shrink-0 text-blauw" />Ook in Krimpen aan den IJssel en omstreken</li>
          </ul>
          <a href={vraag('stucwerk')} class="knop knop-blauw mt-9"><Icoon naam="wa" />Muur laten stucen</a>
        </div>
        <div class="rijs lg:col-span-6 lg:col-start-7" style="--d:.06s">
          <div class="vn relative mx-auto aspect-[3/4] max-w-[30rem] select-none overflow-hidden rounded-md bg-nacht shadow-md" data-vn style="--p:50%">
            <Image src={stuken8} alt="Na: de schouw strak wit gestuct" widths={[450]} sizes="480px" class="absolute inset-0 h-full w-full object-cover" />
            <div class="vn-voor absolute inset-0" aria-hidden="true">
              <Image src={stuken2} alt="" widths={[450]} sizes="480px" class="absolute inset-0 h-full w-full object-cover" />
            </div>
            <span class="absolute left-3 top-3 rounded-sm bg-nacht/85 px-3 py-1 text-xs font-bold uppercase tracking-[.14em] text-licht">Voor</span>
            <span class="absolute right-3 top-3 rounded-sm bg-blauw px-3 py-1 text-xs font-bold uppercase tracking-[.14em] text-wit">Na</span>
            <div class="vn-lijn pointer-events-none absolute inset-y-0 w-0.5 bg-wit" aria-hidden="true">
              <span class="absolute left-1/2 top-1/2 grid h-12 w-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-wit text-inkt shadow-md"><Icoon naam="pijlen" class="h-5 w-5" /></span>
            </div>
            <input type="range" min="0" max="100" value="50" class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0" aria-label="Schuif tussen voor en na" data-vn-range />
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Projecten -->
    <section id="projecten" class="donker bg-nacht py-24 text-licht lg:py-28" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-5 text-3xl">Werk waar we voor staan.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Een greep uit stuc-, voeg- en metselwerk van Aannemersbedrijf Martin de Groot. Klik op een foto voor een grotere weergave.</p>
        </div>
        <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter projecten">
          {[['alles', 'Alles'], ['stucwerk', 'Stucwerk'], ['voegwerk', 'Voegwerk'], ['metselwerk', 'Metselwerk']].map(([v, t], i) => (
            <button type="button" class="filter" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={v}>{t}</button>
          ))}
        </div>
        <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4" data-galerij>
          {projecten.map((w, i) => (
            <li class={`relative overflow-hidden rounded-sm bg-nacht-2 ${w.groot ? 'col-span-2 row-span-2' : ''} aspect-square`} data-cat={w.cat}>
              <button type="button" class="group absolute inset-0 h-full w-full cursor-zoom-in" data-groot={groot[i].src} data-alt={w.alt}>
                <span class="sr-only">Vergroot foto: </span>
                <Image src={w.src} alt={w.alt} widths={w.groot ? [450, 600] : [300, 450]} sizes={w.groot ? '(min-width: 1248px) 600px, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
                <span class="absolute bottom-2 left-2 rounded-sm bg-nacht/80 px-2 py-0.5 text-xs font-semibold capitalize text-licht">{w.cat}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <dialog class="lichtbak" data-lichtbak aria-label="Foto vergroot">
        <img src="" alt="" data-lb-img />
        <p class="mt-3 text-sm text-licht-zacht" data-lb-tekst></p>
        <form method="dialog"><button class="absolute right-3 top-3 grid h-11 w-11 place-items-center rounded-sm bg-wit text-inkt" aria-label="Sluiten"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button></form>
      </dialog>
    </section>

    <!-- 7. Werkwijze -->
    <section id="werkwijze" class="py-24 lg:py-28" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Van eerste belletje tot strakke muur.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Persoonlijk en efficiënt. U weet vooraf wat er gaat gebeuren en wat het kost.</p>
        </div>
        <ol class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-md bg-lijn outline outline-1 outline-lijn lg:mt-16 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs bg-wit p-5 sm:p-7 lg:p-8" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.75rem] font-semibold leading-[.8] text-blauw sm:text-[3.5rem]">0{i + 1}</p>
              <h3 class="mt-6 text-[1.5rem] sm:mt-8 sm:text-[1.875rem]">{t}</h3>
              <p class="mt-3 text-sm text-grijs sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8. Over het bedrijf -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:col-span-5">
          <Image src={metselen3} alt="Metselwerk in uitvoering onder een raampartij, met specikuipen en stapels gevelsteen" widths={[600]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[35%_50%]" />
          <p class="absolute bottom-4 left-4 rounded-sm bg-blauw px-4 py-1.5 text-sm font-semibold text-wit">Gevestigd in {site.plaats}</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over het bedrijf</p>
          <h2 id="t-over" class="mt-5 text-3xl">Uw project in goede handen.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Aannemersbedrijf Martin de Groot specialiseert zich in hoogwaardig stucwerk, metselwerk en voegwerk. Of het nu gaat om een muur, een groot bouwwerk of iets heel specifieks: Martin denkt met u mee en geeft advies waar u dat nodig heeft.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-blauw text-wit"><Icoon naam="pin" class="h-5 w-5" /></span>
              <div><h3 class="text-[1.625rem]">Regionaal, dus snel ter plaatse</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Centraal in de Krimpenerwaard. Wij geloven dat regionaal werken een hogere kwaliteit oplevert.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-blauw text-wit"><Icoon naam="euro" class="h-5 w-5" /></span>
              <div><h3 class="text-[1.625rem]">Duidelijk over de kosten</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Advies op locatie is kosteloos, en vooraf weet u wat het werk gaat kosten.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-blauw text-wit"><Icoon naam="troffel" class="h-5 w-5" /></span>
              <div><h3 class="text-[1.625rem]">Drie vakken, één aanspreekpunt</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Stuken, voegen en metselen, plus lijmwerk van kalkzandsteen.</p></div>
            </li>
          </ul>
          <a href={waOfferte} class="knop knop-blauw mt-9"><Icoon naam="wa" />Vraag een offerte aan</a>
        </div>
      </div>
    </section>

    <!-- 9. Werkgebied, bereikbaarheid en locatie -->
    <section id="werkgebied" class="py-24 lg:py-28" aria-labelledby="t-gebied">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <p class="eyebrow">Werkgebied</p>
          <h2 id="t-gebied" class="mt-5 text-3xl">Rotterdam, de Krimpenerwaard en Gouda.</h2>
          <p class="mt-6 max-w-xl text-lg text-grijs">Zijn er voor een klus extra materialen of mensen nodig, dan kunnen we snel schakelen. We werken onder andere in:</p>
          <ul class="mt-9 grid grid-cols-2 gap-x-4 text-sm sm:gap-x-6 sm:text-base">
            {werkgebied.map((p) => (
              <li class={`flex items-center gap-3 border-b border-lijn py-3 ${p === site.plaats ? 'font-semibold text-blauw' : ''}`}>
                <Icoon naam="pin" class={`h-[1.125rem] w-[1.125rem] shrink-0 ${p === site.plaats ? 'text-blauw' : 'text-grijs'}`} />{p}{p === site.plaats && <span class="ml-auto hidden rounded-sm bg-blauw sm:inline px-2 py-0.5 text-[.6875rem] font-bold uppercase tracking-[.12em] text-wit">Vestiging</span>}
              </li>
            ))}
          </ul>
        </div>
        <div class="flex flex-col gap-5 lg:col-span-5">
          <div class="kaart p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-[1.875rem]">Bereikbaar</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr</span></p>
            </div>
            <table class="mt-4 w-full">
              <caption class="sr-only">Bereikbaarheid per dag</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-blauw">
                    <th scope="row" class="py-2.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="donker flex flex-col gap-5 rounded-md bg-nacht p-6 text-licht md:p-8">
            <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-lucht" /><span><b class="font-semibold">{site.naam}</b><br /><span class="text-licht-zacht">{site.straat}, {site.postcode} {site.plaats}</span></span></p>
            <a href={site.maps} class="knop knop-wit knop-klein self-start">Route plannen<Icoon naam="pijl" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Contact: offerte-aanvraag als WhatsApp-bericht -->
    <section id="contact" class="bg-zand py-24 lg:py-28" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-contact" class="mt-5 text-3xl">Vertel wat er moet gebeuren.</h2>
          <p class="mt-6 text-lg text-grijs">Kies wat u wilt laten doen. Wij maken er een WhatsApp-bericht van; foto’s van de situatie stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid grid-cols-1 gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-blauw text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-blauw" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-zand text-blauw"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Ma t/m vr, 8.00 tot 17.00 uur</span></span><Icoon naam="pijl" class="h-5 w-5 text-blauw" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-zand text-blauw"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-blauw" /></a></li>
          </ul>
        </div>
        <form class="kaart min-w-0 p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-[2.25rem]">Uw aanvraag</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat wilt u laten doen?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Stucwerk', 'Voegwerk', 'Metselwerk', 'Lijmwerk kalkzandsteen', 'Weet ik nog niet'].map((b) => (
                <label class="keuze"><input type="radio" name="werk" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-7">
            <legend class="text-sm font-semibold">Voor een</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Woning', 'Kantoor', 'Bedrijf'].map((b) => (
                <label class="keuze"><input type="radio" name="pand" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Plaats</span>
              <select name="plaats" class="veld mt-2">
                <option value="">Kies een plaats</option>
                {werkgebied.map((p) => <option>{p}</option>)}
                <option value="anders">Andere plaats</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Omschrijving <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: woonkamermuur van ongeveer 4 meter laten stucen"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-blauw"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Liever langs laten komen? Vraag het in uw bericht.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="bg-blauw text-wit" aria-label="Offerte aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(2.25rem,2.4vw+1.5rem,3.25rem)]">Muur laten metselen, voegen of stucen?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel of app, dan komen we vrijblijvend bij u langs.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp</a>
          <a href={site.telHref} class="knop knop-rand op-foto num"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Offerte-aanvraag: bouwt een WhatsApp-bericht, verstuurt zelf niets.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Goedendag Martin, ik wil graag een offerte aanvragen.'];
      if (v('werk')) r.push('Werk: ' + v('werk'));
      if (v('pand')) r.push('Voor een: ' + v('pand').toLowerCase());
      if (v('plaats') && v('plaats') !== 'anders') r.push('Plaats: ' + v('plaats'));
      if (v('wens')) r.push('Omschrijving: ' + v('wens'));
      if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam'));
      window.open('https://wa.me/31651285209?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }

  // Voor/na-schuif
  document.querySelectorAll<HTMLElement>('[data-vn]').forEach((el) => {
    const r = el.querySelector<HTMLInputElement>('[data-vn-range]');
    r?.addEventListener('input', () => el.style.setProperty('--p', r.value + '%'));
  });

  // Projectfilter
  const knoppen = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  knoppen.forEach((k) => k.addEventListener('click', () => {
    knoppen.forEach((b) => b.setAttribute('aria-pressed', String(b === k)));
    const c = k.dataset.filter;
    document.querySelectorAll<HTMLElement>('[data-galerij] > li').forEach((li) => {
      const toon = c === 'alles' || li.dataset.cat === c;
      li.hidden = !toon;
      li.classList.toggle('col-span-2', toon && c === 'alles' && li === li.parentElement?.firstElementChild);
      li.classList.toggle('row-span-2', toon && c === 'alles' && li === li.parentElement?.firstElementChild);
    });
  }));

  // Lichtbak
  const dlg = document.querySelector<HTMLDialogElement>('[data-lichtbak]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const txt = document.querySelector<HTMLElement>('[data-lb-tekst]');
  document.querySelectorAll<HTMLButtonElement>('[data-groot]').forEach((b) => b.addEventListener('click', () => {
    if (!dlg || !img || !txt) return;
    img.src = b.dataset.groot || ''; img.alt = b.dataset.alt || ''; txt.textContent = b.dataset.alt || '';
    dlg.showModal();
  }));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: .86; letter-spacing: .002em; }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: 2px; background: var(--color-zand); }
  .tegel { transition: transform .9s var(--ease-zacht); }
  button:hover > .tegel { transform: scale(1.04); }
  .vn-voor { clip-path: inset(0 calc(100% - var(--p)) 0 0); }
  .vn-lijn { left: var(--p); transform: translateX(-50%); }
  .vn:has(input:focus-visible) { outline: 3px solid var(--color-blauw); outline-offset: 3px; }
  .filter { min-height: 2.75rem; padding: 0 1.1rem; border-radius: 2px; font-size: .9375rem; font-weight: 600; color: var(--color-licht); box-shadow: inset 0 0 0 1.5px #f4f2ed40; transition: background-color .2s, box-shadow .2s, color .2s; cursor: pointer; }
  .filter:hover { box-shadow: inset 0 0 0 1.5px var(--color-lucht); }
  .filter[aria-pressed='true'] { background: var(--color-lucht); color: var(--color-nacht); box-shadow: none; }
  .lichtbak { margin: auto; max-width: min(56rem, 94vw); padding: 1rem; border: 0; border-radius: 4px; background: var(--color-nacht); color: var(--color-licht); }
  .lichtbak::backdrop { background: #061a22e6; }
  .lichtbak img { display: block; max-height: 80vh; width: auto; max-width: 100%; margin-inline: auto; border-radius: 2px; }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: 2px; background: var(--color-zand); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #dcd5c6; }
  .keuze input:checked + span { background: var(--color-blauw); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-blauw); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: 2px; border: 1.5px solid #10222a33; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #10222a66; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-blauw); }
  .veld::placeholder { color: #6f7c82; }
</style>
