---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Logo from '../components/Logo.astro';
import { site, tijden, chips, reviews, waAfspraak, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import werkplaats from '../assets/werkplaats.jpg';
import brug from '../assets/brug.jpg';
import koperhoek from '../assets/koperhoek.jpg';
import koplamp from '../assets/koplamp.jpg';
import sMotor from '../assets/s-motor.jpg';
import sBanden from '../assets/s-banden.jpg';
import sElektra from '../assets/s-elektra.jpg';
import sSleutel from '../assets/s-sleutel.jpg';

const vraag = (b: string) => waMet(`Hallo Arsam Auto's, ik heb een vraag over ${b.toLowerCase()} voor mijn auto.`);

const diensten = [
  { t: 'APK', d: 'De wettelijke keuring, in hun eigen APK-keuringstation. Er wordt onder meer gekeken naar de verlichting en de uitstoot.', src: werkplaats, alt: 'Monteur in een zwart Arsam B.V.-shirt werkt onder een auto op de brug', pos: '50% 62%', w: 'APK' },
  { t: 'Onderhoud en airco', d: 'Onderhoud, olie verversen en remmen nakijken of vervangen. Airco’s installeren en repareren voor alle soorten auto’s.', src: sSleutel, alt: 'Handen met een ringsleutel in een motorruimte', pos: '50% 50%', w: 'onderhoud' },
  { t: 'Motor en koppeling', d: 'Reparaties aan de motor, de koppakking en de koppelingsplaat.', src: sMotor, alt: 'Monteur buigt zich over een geopende motorkap', pos: '50% 45%', w: 'een reparatie' },
  { t: 'Banden', d: 'Alles rond banden: uitlijnen, velgen en de juiste bandenspanning.', src: sBanden, alt: 'Handen in werkhandschoenen aan een autoband', pos: '40% 50%', w: 'banden' },
  { t: 'Diagnose en elektra', d: 'Storingen uitlezen en eerst een duidelijke uitleg. Ook elektrische ramen en daken.', src: sElektra, alt: 'Monteur meet aan een zekeringkast in de motorruimte', pos: '50% 50%', w: 'een diagnose' },
  { t: 'In- en verkoop', d: 'Uw tweedehands auto verkopen? Arsam koopt auto’s van elk bouwjaar. Vrijblijvend contact, landelijke ophaaldienst.', src: brug, alt: 'Witte auto op de brug met een gele plaat met de tekst Arsam Auto’s', pos: '50% 40%', w: 'de verkoop van mijn auto' },
];

const stappen = [
  { t: 'Afspraak', d: 'Bel of app Ebi. Vertel kort wat er speelt, dan plant hij een moment in.' },
  { t: 'Diagnose en uitleg', d: 'Vóór de reparatie hoort u wat er aan de hand is en welke onderdelen eventueel vervangen moeten worden.' },
  { t: 'Reparatie', d: 'Ebi gaat aan de slag. Zijn er grote wijzigingen, dan belt hij eerst even.' },
  { t: 'Weer de weg op', d: 'Uw auto ophalen of laten brengen. Betalen kan ook via een overschrijving.' },
];

const faq = [
  { v: 'Wat als mijn auto langer moet blijven staan?', a: 'Dan krijgt u een leenauto tot uw eigen auto klaar is.' },
  { v: 'Werkt u aan alle merken?', a: 'Ja. Ebi heeft onder meer ervaring met Mercedes, BMW, Volkswagen en Renault.' },
  { v: 'Koopt u ook mijn kapotte auto?', a: 'Ja, als hij geen ernstige schade aan de carrosserie heeft.' },
  { v: 'Repareert u ook elektrische onderdelen?', a: 'Ja, bijvoorbeeld elektrische ramen en daken.' },
  { v: 'Kan ik betalen via een overschrijving?', a: 'Ja.' },
  { v: 'Doet u ook schadeherstel?', a: 'Nee, schadeherstel doen wij niet.' },
];

const sterren = [0, 1, 2, 3, 4];
---
<Base title="Arsam Auto's | Garage en APK in Rhoon" description="Garage en APK-keuringstation aan de Koperhoek in Rhoon. Onderhoud, reparatie, banden, airco en diagnose voor alle merken. 4,9 op Google.">
  <Kop />
  <main id="inhoud">
    <!-- HERO -->
    <section class="donker relative isolate overflow-hidden bg-asfalt text-licht">
      <Image quality={70} src={hero} alt="Het pand van Arsam Auto's aan de Koperhoek in Rhoon, met het rode APK-bord boven de open werkplaatsdeur" widths={[640, 960, 1200]} sizes="(min-width: 1024px) 56vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-y-0 right-0 -z-20 h-full w-full object-cover object-[28%_50%] lg:w-[56%]" />
      <div class="absolute inset-0 -z-10 bg-asfalt/[.72] lg:bg-transparent lg:bg-gradient-to-r lg:from-asfalt lg:from-45% lg:via-asfalt/80 lg:via-55% lg:to-asfalt/10" aria-hidden="true"></div>
      <div class="golf absolute inset-y-0 left-0 -z-10 hidden w-[46%] lg:block" aria-hidden="true"></div>
      <div class="wrap flex min-h-[calc(100svh-7rem)] flex-col justify-center py-20 lg:min-h-[47rem] lg:py-24">
        <div class="max-w-[42rem]">
          <p class="eyebrow rijs">Garage in Rhoon</p>
          <h1 class="rijs mt-6 text-hero" style="--d:.08s">APK, onderhoud en reparatie. <span class="text-geel">Alle merken.</span></h1>
          <p class="rijs mt-7 max-w-[34rem] text-lg leading-relaxed text-licht-zacht md:text-xl" style="--d:.16s">Gediplomeerd monteur Ebi werkt sinds 2000 in het vak. Hij legt eerst duidelijk uit wat er met uw auto aan de hand is, en dan pas begint de reparatie.</p>
          <div class="rijs mt-9 flex flex-wrap gap-3" style="--d:.24s">
            <a href={waAfspraak} class="knop knop-geel"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#apk-check" class="knop knop-rand">Wanneer moet ik APK?</a>
          </div>
          <div class="rijs mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 text-[.9688rem]" style="--d:.32s">
            <a href={site.reviews} class="flex items-center gap-2 no-underline hover:text-geel">
              <span class="flex text-ster" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
              <span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</span>
            </a>
            <span class="flex items-center gap-2" data-status-wrap>
              <span class="h-2 w-2 rounded-full bg-licht-zacht in-data-[open=true]:bg-geel" aria-hidden="true"></span>
              <span data-status>Ma t/m vr 9.00 - 17.30, za 9.00 - 14.00</span>
            </span>
          </div>
        </div>
      </div>
      <div class="absolute bottom-24 right-8 hidden items-center gap-4 rounded-lg bg-asfalt/85 p-3 pr-5 backdrop-blur-sm lg:flex">
        <span class="plaat text-xl"><span class="plaat-eu">NL</span><span class="plaat-tekst">Arsam Auto's</span></span>
        <span class="text-sm leading-snug text-licht-zacht">{site.straat}<br />{site.postcode} {site.plaats}</span>
      </div>
    </section>

    <!-- STATS -->
    <section aria-label="In het kort" class="relative z-10 bg-papier">
      <div class="wrap">
        <dl class="kaart -mt-10 grid grid-cols-2 divide-lijn overflow-hidden md:-mt-14 lg:grid-cols-4 lg:divide-x">
          <div class="flex flex-col gap-2 border-b border-lijn p-6 lg:border-b-0 lg:p-8">
            <dt class="text-sm text-grijs">Google-score uit {site.google.aantal} reviews</dt>
            <dd class="num order-first font-kop text-[2.75rem] font-extrabold leading-none tracking-tight">{site.google.score}</dd>
          </div>
          <div class="flex flex-col gap-2 border-b border-l border-lijn p-6 lg:border-b-0 lg:p-8">
            <dt class="text-sm text-grijs">Ebi werkt in de branche sinds</dt>
            <dd class="num order-first font-kop text-[2.75rem] font-extrabold leading-none tracking-tight">2000</dd>
          </div>
          <div class="flex flex-col gap-2 p-6 lg:p-8">
            <dt class="text-sm text-grijs">Arsam Auto’s opgericht</dt>
            <dd class="num order-first font-kop text-[2.75rem] font-extrabold leading-none tracking-tight">2019</dd>
          </div>
          <div class="flex flex-col gap-2 border-l border-lijn p-6 lg:p-8">
            <dt class="text-sm text-grijs">Van Mercedes tot Renault</dt>
            <dd class="order-first font-kop text-[2.75rem] font-extrabold leading-none tracking-tight">Alle merken</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- DIENSTEN -->
    <section id="diensten" class="bg-papier py-24 lg:py-32">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 class="mt-5 text-3xl">Van APK tot koppeling, onder één dak.</h2>
          </div>
          <p class="max-w-md text-lg text-grijs lg:col-span-5">Ondervindt u problemen aan uw auto? Is er een technisch probleem? Wij zorgen voor een oplossing.</p>
        </div>
        <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {diensten.map((d, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.08}s`}>
              <a href={vraag(d.w)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative aspect-[16/10] overflow-hidden bg-asfalt sm:aspect-[4/3]">
                  <Image quality={70} src={d.src} alt={d.alt} widths={[420, 640, 840]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${d.pos}`} />
                  <span class="num absolute left-4 top-4 rounded-sm bg-geel px-2 py-1 font-plaat text-sm font-extrabold">0{i + 1}</span>
                </div>
                <div class="flex flex-1 flex-col p-6 lg:p-7">
                  <h3 class="text-2xl">{d.t}</h3>
                  <p class="mt-3 text-grijs">{d.d}</p>
                  <span class="mt-auto flex items-center gap-2 pt-6 text-[.9688rem] font-bold">Vraag het via WhatsApp<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-12 flex flex-wrap gap-2.5" aria-label="Alle werkzaamheden">
          {chips.map((c) => <li class="rounded-full bg-wit px-4 py-2 text-[.9375rem] font-semibold shadow-sm outline outline-1 -outline-offset-1 outline-lijn">{c}</li>)}
        </ul>
      </div>
    </section>

    <!-- APK-CHECK (wow) -->
    <section id="apk-check" class="donker golf relative overflow-hidden bg-asfalt py-24 text-licht lg:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">APK-check</p>
          <h2 class="mt-5 text-3xl">Wanneer moet uw auto weer APK?</h2>
          <p class="mt-6 max-w-md text-lg text-licht-zacht">Vul uw kenteken in. U ziet direct de vervaldatum uit het RDW-register, en uw APK-afspraak staat klaar in WhatsApp.</p>
          <p class="mt-8 flex items-center gap-3 text-sm text-licht-zacht"><Icoon naam="vink" class="h-4 w-4 text-geel" />Arsam Auto’s is zelf APK-keuringstation.</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <form class="rounded-xl bg-asfalt-2 p-6 shadow-md outline outline-1 -outline-offset-1 outline-lijn-licht sm:p-9" data-apk novalidate>
            <label for="kenteken" class="block text-sm font-bold text-licht">Uw kenteken</label>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row">
              <div class="plaat min-w-0 flex-1 text-[clamp(1.75rem,6vw,2.5rem)]">
                <span class="plaat-eu text-[clamp(1.75rem,6vw,2.5rem)]">NL</span>
                <input id="kenteken" name="kenteken" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="10" placeholder="AB-123-C" class="plaat-tekst w-full min-w-0 bg-transparent uppercase placeholder:text-inkt/45 focus:outline-none" />
              </div>
              <button type="submit" class="knop knop-geel shrink-0 sm:min-h-0">Opzoeken<Icoon naam="pijl" /></button>
            </div>
            <div class="mt-6 min-h-[7.5rem]" aria-live="polite" data-uitslag>
              <p class="text-[.9375rem] text-licht-zacht">Bijvoorbeeld een kenteken als <span class="whitespace-nowrap font-plaat font-bold tracking-wider text-licht">AB-123-C</span>. Streepjes mogen, hoeft niet.</p>
            </div>
            <p class="mt-4 border-t border-lijn-licht pt-4 text-xs text-licht-zacht">Gegevens van RDW Open Data. Uw kenteken wordt niet door Arsam Auto’s opgeslagen.</p>
          </form>
        </div>
      </div>
    </section>

    <!-- WERKWIJZE -->
    <section class="bg-papier py-24 lg:py-32">
      <div class="wrap">
        <div class="max-w-2xl">
          <p class="eyebrow">Zo werkt het</p>
          <h2 class="mt-5 text-3xl">Eerst uitleg, dan sleutelen.</h2>
        </div>
        <ol class="mt-14 grid gap-px overflow-hidden rounded-xl bg-lijn outline outline-1 -outline-offset-1 outline-lijn sm:grid-cols-2 lg:grid-cols-4">
          {stappen.map((s, i) => (
            <li class="rijs bg-wit p-7 lg:p-8" style={`--d:${i * 0.08}s`}>
              <span class="num inline-block rounded-sm bg-geel px-2.5 py-1.5 font-plaat text-2xl font-extrabold leading-none">0{i + 1}</span>
              <h3 class="mt-6 text-xl">{s.t}</h3>
              <p class="mt-2.5 text-grijs">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- OVER EBI -->
    <section id="ebi" class="bg-wit py-24 lg:py-32">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="relative lg:col-span-6">
          <Image quality={70} src={werkplaats} alt="Monteur in een Arsam B.V.-shirt aan het werk onder een auto op de brug" widths={[480, 720, 960]} sizes="(min-width: 1024px) 560px, 92vw" class="aspect-[4/5] w-full rounded-xl object-cover object-[50%_70%] sm:aspect-[5/4] lg:aspect-[4/5]" />
          <figure class="absolute -bottom-8 right-4 w-40 overflow-hidden rounded-lg bg-wit p-1.5 shadow-md sm:w-52 lg:-right-8">
            <Image quality={70} src={koplamp} alt="Monteur poetst een koplamp op in de werkplaats" widths={[220, 420]} sizes="208px" class="aspect-square w-full rounded-md object-cover object-[40%_40%]" />
            <figcaption class="px-1.5 pb-1 pt-2 text-xs font-semibold text-grijs">In de werkplaats aan de Koperhoek</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="eyebrow">Over Ebi</p>
          <h2 class="mt-5 text-3xl">Meer dan 20 jaar werk&shy;ervaring.</h2>
          <p class="mt-6 text-lg text-grijs">Ebi is gediplomeerd monteur en werkt sinds 2000 in deze branche, met ervaring bij topmerken als Mercedes, BMW, Volkswagen en Renault. In 2019 begon hij Arsam Auto’s: een garage met goede diagnose en een vakkundige aanpak. Samen met u als klant komt hij altijd tot een passende oplossing.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex gap-4 rounded-lg bg-papier p-5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-geel"><Icoon naam="uitleg" class="h-5 w-5" /></span>
              <span><b class="block">Uitleg vóór de reparatie</b><span class="text-[.9688rem] text-grijs">U ziet wat nodig is en welke onderdelen eventueel vervangen moeten worden.</span></span>
            </li>
            <li class="flex gap-4 rounded-lg bg-papier p-5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-geel"><Icoon naam="auto" class="h-5 w-5" /></span>
              <span><b class="block">Leenauto als het langer duurt</b><span class="text-[.9688rem] text-grijs">Blijft uw auto langer staan, dan rijdt u zolang in een leenauto.</span></span>
            </li>
            <li class="flex gap-4 rounded-lg bg-papier p-5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-geel"><Icoon naam="wissel" class="h-5 w-5" /></span>
              <span><b class="block">Haal- en brengservice</b><span class="text-[.9688rem] text-grijs">Uw auto wordt opgehaald en weer teruggebracht.</span></span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews" class="donker bg-asfalt py-24 text-licht lg:py-32">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-8">
          <div>
            <p class="eyebrow">Reviews</p>
            <h2 class="mt-5 text-3xl">Wat klanten zeggen</h2>
          </div>
          <a href={site.reviews} class="flex items-center gap-4 rounded-lg bg-asfalt-2 px-5 py-4 no-underline outline outline-1 -outline-offset-1 outline-lijn-licht transition-colors hover:bg-asfalt-3">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-wit"><Icoon naam="g" class="h-6 w-6" /></span>
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-extrabold">{site.google.score}</b><span class="flex text-ster" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-licht-zacht">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <li class="rijs flex flex-col rounded-xl bg-asfalt-2 p-7 outline outline-1 -outline-offset-1 outline-lijn-licht" style={`--d:${(i % 3) * 0.08}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-[1.05rem] w-[1.05rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed text-licht">“{r.tekst}”</blockquote>
              <p class="mt-6 flex items-center justify-between gap-3 border-t border-lijn-licht pt-5 text-sm">
                <span><b class="text-licht">{r.naam}</b><span class="block text-licht-zacht">{r.wanneer}</span></span>
                <span class="flex items-center gap-1.5 text-licht-zacht"><Icoon naam="g" class="h-4 w-4" />Google review</span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-papier py-24 lg:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
          <p class="eyebrow">Vragen</p>
          <h2 class="mt-5 text-3xl">Veel&shy;gestelde vragen</h2>
          <p class="mt-6 text-grijs">Staat uw vraag er niet bij? Bel of app Ebi gerust.</p>
          <p class="mt-6 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-inkt knop-klein"><Icoon naam="wa" class="text-geel" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand knop-klein num">{site.tel}</a>
          </p>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          {faq.map((f) => (
            <details class="group border-b border-lijn py-1 first:border-t">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-bold [&::-webkit-details-marker]:hidden">
                {f.v}
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-md bg-wit shadow-sm transition-transform duration-300 group-open:rotate-45" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
              </summary>
              <p class="max-w-xl pb-6 text-grijs">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- TIJDEN EN ROUTE -->
    <section id="contact" class="bg-wit py-24 lg:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <div class="relative h-full overflow-hidden rounded-xl">
            <Image quality={70} src={koperhoek} alt="De rij bedrijfsunits aan de Koperhoek in Rhoon, met het rode APK-bord van Arsam Auto's" widths={[640, 960, 1300]} sizes="(min-width: 1024px) 700px, 92vw" class="aspect-[4/3] w-full object-cover object-[22%_42%] sm:aspect-[16/10] lg:aspect-auto lg:h-full" />
            <span class="plaat absolute bottom-4 left-4 text-lg sm:text-xl"><span class="plaat-eu">NL</span><span class="plaat-tekst">Koperhoek 80 A</span></span>
          </div>
        </div>
        <div class="lg:col-span-5">
          <p class="eyebrow">Openingstijden en route</p>
          <h2 class="mt-5 text-3xl">Langs&shy;komen in Rhoon</h2>
          <p class="mt-5 flex items-center gap-2.5 text-[.9688rem] font-bold" data-status-wrap>
            <span class="h-2.5 w-2.5 rounded-full bg-grijs in-data-[open=true]:bg-geel in-data-[open=true]:shadow-[0_0_0_3px_#f6c40055]" aria-hidden="true"></span>
            <span data-status>Ma t/m vr 9.00 - 17.30, za 9.00 - 14.00</span>
          </p>
          <table class="mt-6 w-full">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:bg-geel data-[vandaag]:font-bold">
                  <th scope="row" class="py-3 pl-3 text-left font-semibold">{t.naam}</th>
                  <td class="num py-3 pr-3 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <address class="mt-8 flex items-start gap-3 not-italic">
            <Icoon naam="pin" class="mt-0.5 h-5 w-5 shrink-0" />
            <span>{site.straat}<br />{site.postcode} {site.plaats}</span>
          </address>
          <p class="mt-6 flex flex-wrap gap-3">
            <a href={site.maps} class="knop knop-inkt knop-klein"><Icoon naam="pin" class="text-geel" />Route plannen</a>
            <a href={`mailto:${site.mail}`} class="knop knop-rand knop-klein"><Icoon naam="mail" />Mail ons</a>
          </p>
        </div>
      </div>
    </section>

    <!-- SLOTBALK -->
    <section class="bg-geel">
      <div class="wrap flex flex-col gap-8 py-16 lg:flex-row lg:items-center lg:justify-between lg:py-20">
        <div class="flex items-center gap-6">
          <Logo class="hidden h-16 w-24 shrink-0 sm:block" />
          <h2 class="max-w-3xl text-[clamp(2rem,2.6vw+1rem,3.25rem)]">Problemen met uw auto? Ebi zorgt voor een oplossing.</h2>
        </div>
        <p class="flex flex-wrap gap-3">
          <a href={waAfspraak} class="knop knop-inkt"><Icoon naam="wa" class="text-geel" />Stuur een WhatsApp</a>
          <a href={site.telHref} class="knop knop-rand num"><Icoon naam="tel" />Bel {site.tel}</a>
        </p>
      </div>
    </section>
  </main>
  <Voet />

  <script>
    // APK-check: vervaldatum opzoeken in RDW Open Data (dataset m9d7-ebf2, openbaar) en een WhatsApp-bericht klaarzetten.
    const form = document.querySelector<HTMLFormElement>('[data-apk]');
    const uit = document.querySelector<HTMLElement>('[data-uitslag]');
    const wa = 'https://wa.me/31652559180?text=';
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const knopWa = (tekst: string, label: string) => `<a href="${wa}${encodeURIComponent(tekst)}" class="knop knop-geel mt-5"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.36A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.08.81.82-3-.2-.31a8.2 8.2 0 1 1 6.94 3.83Z"/></svg>${label}</a>`;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!uit) return;
      const invoer = String(new FormData(form).get('kenteken') || '').toUpperCase().trim();
      const k = invoer.replace(/[^A-Z0-9]/g, '');
      if (k.length < 4 || k.length > 8) { uit.innerHTML = '<p class="text-licht">Vul een geldig Nederlands kenteken in, bijvoorbeeld AB-123-C.</p>'; return; }
      uit.innerHTML = '<p class="text-licht-zacht">Even zoeken bij de RDW…</p>';
      try {
        const r = await fetch(`https://opendata.rdw.nl/resource/m9d7-ebf2.json?kenteken=${k}&$select=merk,handelsbenaming,vervaldatum_apk_dt`);
        const d = (await r.json())[0];
        if (!d) { uit.innerHTML = `<p class="text-licht">Kenteken <b>${esc(invoer)}</b> niet gevonden. Klopt het? U kunt ook gewoon even bellen.</p>`; return; }
        const merk = String(d.merk || '').toLowerCase().replace(/(^|[\s-])\S/g, (c: string) => c.toUpperCase());
        const auto = [merk, String(d.handelsbenaming || '').replace(new RegExp(`^${d.merk}\\s*`, 'i'), '')].filter(Boolean).join(' ');
        if (!d.vervaldatum_apk_dt) {
          uit.innerHTML = `<p class="text-licht"><b>${esc(auto)}</b>: bij de RDW staat geen APK-vervaldatum.</p>` + knopWa(`Hallo Arsam Auto's, ik heb een vraag over de APK van mijn ${auto} (kenteken ${invoer}).`, 'Vraag het via WhatsApp');
          return;
        }
        const datum = new Date(d.vervaldatum_apk_dt);
        const dagen = Math.ceil((datum.getTime() - Date.now()) / 864e5);
        const mooi = datum.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
        const status = dagen < 0 ? `<span class="text-geel">verlopen sinds ${mooi}</span>` : `geldig tot <span class="text-geel">${mooi}</span>`;
        const extra = dagen < 0 ? 'Rijd er niet mee de weg op: plan zo snel mogelijk een keuring.' : dagen <= 60 ? `Nog ${dagen} dagen. Een mooi moment om de keuring in te plannen.` : `Nog ${dagen} dagen. U kunt de APK tot twee maanden voor de vervaldatum laten doen.`;
        uit.innerHTML = `<p class="text-sm font-bold uppercase tracking-[.14em] text-licht-zacht">${esc(auto)}</p><p class="mt-1.5 font-kop text-2xl font-extrabold leading-tight text-licht">APK ${status}</p><p class="mt-2 text-[.9375rem] text-licht-zacht">${extra}</p>` +
          knopWa(`Hallo Arsam Auto's, ik wil graag een APK-afspraak voor mijn ${auto} (kenteken ${invoer}). De APK verloopt op ${mooi}.`, 'APK inplannen via WhatsApp');
      } catch {
        uit.innerHTML = `<p class="text-licht">De RDW is nu niet bereikbaar. Bel of app gerust: <a class="link font-bold" href="tel:+31652559180">06 52 55 91 80</a>.</p>`;
      }
    });
  </script>
</Base>
