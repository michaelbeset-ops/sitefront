---
// Nagetekend naar hun logo: de "A" in een cirkel met twee vleugels (gevelbord, shirt en oude site).
interface Props { class?: string }
const { class: cls = 'h-8 w-12' } = Astro.props;
const veren = ['M20.4 17.6C14.6 11.8 8 10.4 1.2 11.6', 'M20.6 20.6C14.8 16.6 8.6 16.4 3 18', 'M21.2 23.6C16 21.6 10.6 22 5.6 24.4', 'M22.4 26.6C18.4 26.2 14.4 27.4 10.8 30'];
---
<svg viewBox="0 0 62 40" class={cls} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {veren.map((d) => <path d={d} />)}
  <g transform="translate(62 0) scale(-1 1)">{veren.map((d) => <path d={d} />)}</g>
  <circle cx="31" cy="22" r="9.6" />
  <path d="M26.6 27.6 31 15.8l4.4 11.8M28 24.2h6" stroke-width="2.1" />
</svg>
