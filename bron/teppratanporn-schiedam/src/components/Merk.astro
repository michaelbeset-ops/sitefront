---
// Woordmerk naar hun gevelbord (bron/google/foto/046.jpg): "TEPPRATANPORN" in brede kapitalen met ruime spatiëring,
// daarnaast klein "THAI FOOD". Het streepje in het chilirood van hun menukaart.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`group inline-flex flex-col no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class="font-kop text-[1.02rem] font-semibold leading-none tracking-[.2em] sm:text-[1.2rem]">TEPPRATANPORN</span>
  <span class="mt-1.5 flex items-center gap-2 text-[.62rem] font-bold leading-none tracking-[.32em] opacity-80 sm:text-[.68rem]"><span class="h-[2px] w-5 bg-merk-licht" aria-hidden="true"></span>THAI FOOD</span>
</a>
