---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi, kaart, week } from '../data/site';

// Hero: Unsplash-sfeerfoto (wok op het vuur). Gerechten, interieur en pand: foto's van hun Google-profiel.
// Menukaart: foto van hun eigen gedrukte kaart. Zie src/assets/BRONNEN.txt.
import hero from '../assets/hero.jpg';
import gViskoek from '../assets/g-viskoek.jpg';
import gTomkha from '../assets/g-tomkha.jpg';
import gLaab from '../assets/g-laab.jpg';
import gPadthai from '../assets/g-padthai.jpg';
import gWok from '../assets/g-wok.jpg';
import gRood from '../assets/g-rood.jpg';
import gSate from '../assets/g-sate.jpg';
import gLoempia from '../assets/g-loempia.jpg';
import gTomyam from '../assets/g-tomyam.jpg';
import gMassaman from '../assets/g-massaman.jpg';
import interieur from '../assets/interieur.jpg';
import pand from '../assets/pand.jpg';
import menukaart from '../assets/menukaart.jpg';

// Rubrieken van hun eigen kaart, met een foto van een gerecht uit die rubriek (Google-profiel).
const rubrieken = [
  { id: 'voor', t: 'Voorgerechten', d: "Loempia's, garnalen in loempiablad, viskoekjes of kipsaté, per 4 stuks.", src: gViskoek, alt: 'Viskoekjes met chilisaus en komkommer' },
  { id: 'soep', t: 'Soepen', d: 'Tom Kha, kokossoep, en Tom Yam, pittig en helder. Met kip of garnalen.', src: gTomkha, alt: 'Kom witte kokossoep met koriander' },
  { id: 'salade', t: 'Salades', d: 'Som Tam van groene papaya, Laab Kai met munt en citroen, Yam Woensen.', src: gLaab, alt: 'Laab: fijngehakte kip met munt en sla' },
  { id: 'rijst', t: 'Rijst en noedels', d: 'Khao Phad, Thaise gebakken rijst, en Phad Thai met tofu en taugé.', src: gPadthai, alt: 'Phad Thai met pinda, taugé en limoen' },
  { id: 'wok', t: 'Wokgerechten', d: 'Vijf gerechten uit de wok, van zoetzuur tot knoflook met witte pepers.', src: gWok, alt: 'Wokgerecht met kouseband en paprika' },
  { id: 'curry', t: 'Kaeng curry', d: 'Rood, groen, Massaman en Panaeng, met kokos en Thaise basilicum.', src: gRood, alt: 'Rode curry met kouseband en paprika' },
];

const stappen = [
  ['Kies van de kaart', 'Stel hieronder uw bestelling samen, of pak de kaart erbij.'],
  ['App of bel', `Uw bestelling gaat als WhatsApp-bericht naar ${site.tel}. Bellen kan ook.`],
  ['Vers bereid', 'Elk gerecht wordt pas gemaakt als u het bestelt. Bij drukte duurt het wat langer.'],
  ['Ophalen', `${site.straat} in ${site.plaats}. Dagelijks vanaf 14.00 uur, woensdag gesloten.`],
];

const sterren = [1, 2, 3, 4, 5];
// Afhaal-/tafeltijden: elk kwartier binnen de openingstijden.
const tijden: string[] = [];
for (let m = site.open * 60 + 30; m <= site.dicht * 60 - 15; m += 15) tijden.push(`${Math.floor(m / 60)}.${String(m % 60).padStart(2, '0')}`);
---
<Base title="Teppratanporn | Thais restaurant in Schiedam, ter plaatse eten en afhalen" description="Teppratanporn, Thais restaurant aan het Broersveld 108 in Schiedam. Elk gerecht vers bereid: curry's, wokgerechten, Phad Thai, Tom Kha. Dagelijks open van 14.00 tot 21.30 uur, woensdag gesloten. Bel en bestel!">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: sfeerfoto wok op het vuur, donker verloop -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={hero} alt="" widths={[640, 960, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" quality={64} class="absolute inset-0 -z-20 h-full w-full object-cover object-[28%_55%] md:-scale-x-100 md:object-[50%_55%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1a1311b3_0%,#1a131140_26%,#1a1311cc_58%,#1a1311fa_100%)] md:bg-[linear-gradient(90deg,#1a1311f5_0%,#1a1311d1_38%,#1a131147_70%,#1a131126_100%),linear-gradient(180deg,#1a1311b3_0%,#1a131100_30%,#1a131100_70%,#1a1311cc_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-[6.75rem] pt-32 md:pb-20 lg:pt-48">
        <div class="max-w-[50rem]">
          <p class="eyebrow eyebrow-licht">Thais restaurant in {site.plaats}</p>
          <h1 id="inhoud" class="mt-6 text-hero">Het beste wat <span class="text-merk-licht">Thailand</span> u te bieden heeft uit Schiedam!</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-wit/90 md:text-[1.3rem]">Een klein Thais restaurant aan het Broersveld. Elk gerecht wordt vers voor u bereid, om hier te eten of af te halen.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#bestellen" class="knop knop-merk max-sm:px-5"><span class="sm:hidden">Bestellen</span><span class="max-sm:hidden">Bestelling samenstellen</span><Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-wit num max-sm:px-5"><Icoon naam="tel" />Bel en bestel</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.95rem] text-wit/90">
            <li class="flex items-center gap-2"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-wit">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-merk-licht" /><span data-status>Dagelijks 14.00 tot 21.30 uur, woensdag gesloten</span></li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-7 right-10 hidden text-xs text-wit/55 lg:block">Sfeerfoto, ter illustratie</p>
    </section>
  </div>

  <main>
    <!-- 2. Cijfers: alleen echte cijfers van hun kaart en Google -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-x-6 gap-y-9 py-11 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-steen">op Google, uit {site.google.aantal} reviews</dt><dd class="num order-first font-kop text-[clamp(2rem,2vw+1.3rem,3.2rem)] font-extrabold leading-none tracking-[-.05em] text-merk">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">genummerde gerechten op de kaart</dt><dd class="num order-first font-kop text-[clamp(2rem,2vw+1.3rem,3.2rem)] font-extrabold leading-none tracking-[-.05em]">29</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">keuzes bij elke curry en elk wokgerecht: vega / tofoe, kip, rund of garnalen</dt><dd class="num order-first font-kop text-[clamp(2rem,2vw+1.3rem,3.2rem)] font-extrabold leading-none tracking-[-.05em]">4</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">dagen per week open, van 14.00 tot 21.30 uur</dt><dd class="num order-first font-kop text-[clamp(2rem,2vw+1.3rem,3.2rem)] font-extrabold leading-none tracking-[-.05em]">6</dd></div>
      </dl>
    </section>

    <!-- 3. De kaart: rubrieken als fotokaarten -->
    <section id="kaart" class="py-24 md:py-32" aria-labelledby="t-kaart">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">De kaart</p>
            <h2 id="t-kaart" class="mt-5 text-4xl">Van loempia tot <span class="text-merk">Panaeng</span>.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Soepen, salades, rijst en noedels, wokgerechten en curry's. Alles van de eigen kaart, vers bereid.</p>
        </div>
        <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {rubrieken.map((r, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href="#bestellen" data-naar={r.id} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-[0_14px_36px_#1a131117]">
                <div class="overflow-hidden">
                  <Image src={r.src} alt={r.alt} widths={[420, 640, 820]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 100vw" quality={70} class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[4/3]" />
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-[1.65rem]">{r.t}</h3>
                  <p class="mt-3 text-steen">{r.d}</p>
                  <span class="mt-auto inline-flex items-center gap-2 pt-6 font-bold text-merk transition-colors group-hover:text-merk-diep">Bekijk en bestel<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Over de zaak: donker, interieur + pand + eigenschappen uit reviews en kaart -->
    <section id="over" class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-over">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="rijs relative lg:col-span-6">
          <Image src={interieur} alt="Het restaurant van binnen: ronde houten tafels, krijtbord met gerechten en Thaise beeldjes" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" quality={68} class="aspect-[4/3] w-full rounded-[22px] object-cover" />
          <Image src={pand} alt="De gevel aan het Broersveld 108 met het bord Teppratanporn Thai Food" widths={[320, 480]} sizes="(min-width: 1024px) 200px, 34vw" quality={70} class="absolute -bottom-10 right-4 w-[36%] max-w-[13rem] rounded-[18px] border-4 border-inkt object-cover shadow-[0_20px_40px_#00000066] md:right-8" />
        </div>
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Over ons</p>
          <h2 id="t-over" class="rijs mt-5 text-4xl">Eén keuken. <span class="text-merk-licht">Alles vers.</span></h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-wit/90" style="--d:.06s">Teppratanporn is een klein Thais restaurant aan het Broersveld, met een paar tafels. Elk gerecht wordt pas gemaakt als u het bestelt. Eet hier, of haal af.</p>
          <ul class="mt-10 grid gap-4 sm:grid-cols-3">
            {[
              ['pan', 'Vers per portie', 'Niets staat klaar in grote pannen.'],
              ['peper', 'Pittig naar wens', 'Zeg hoe pittig u het wilt hebben.'],
              ['blad', 'Ook vega', 'Curry en wok ook met vega / tofoe.'],
            ].map(([ic, t, d], i) => (
              <li class="rijs rounded-[18px] border border-lijn bg-inkt-2 p-5" style={`--d:${0.08 + i * 0.05}s`}>
                <Icoon naam={ic} class="h-7 w-7 text-merk-licht" />
                <p class="mt-4 font-bold">{t}</p>
                <p class="mt-1 text-sm text-mist">{d}</p>
              </li>
            ))}
          </ul>
          <figure class="rijs mt-10 border-l-2 border-merk-licht pl-5" style="--d:.2s">
            <blockquote class="text-lg italic leading-relaxed text-wit/90">“Heerlijk gegeten, leuk om te zien hoe de eigenaresse alles vers maakt!”</blockquote>
            <figcaption class="mt-2 text-sm text-mist">Merel B., Google review</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 5. Werkwijze afhalen -->
    <section class="border-b border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Afhalen</p>
            <h2 id="t-werk" class="mt-5 text-4xl">Bel en bestel!</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Afhalen gaat het snelst als uw bestelling al binnen is. Druk rond etenstijd? Bel of app dan even vooraf.</p>
        </div>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
          {stappen.map(([t, d], i) => (
            <li class="rijs flex flex-col rounded-[22px] bg-room p-7" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-6 text-2xl">{t}</h3>
              <p class="mt-3 text-steen">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. Wow: de echte kaart als bestellijst, eindigt in een vooraf ingevuld WhatsApp-bericht -->
    <section id="bestellen" class="py-24 md:py-32" aria-labelledby="t-best">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Bestellen</p>
            <h2 id="t-best" class="mt-5 text-4xl">Stel uw <span class="text-merk">bestelling</span> samen.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Tik op + bij wat u wilt. Uw bestelling staat daarna klaar in WhatsApp, voor afhalen of een tafel.</p>
        </div>

        <div class="mt-12 grid gap-x-12 gap-y-12 lg:mt-16 lg:grid-cols-12">
          <div class="min-w-0 lg:col-span-7">
            <div class="-mx-5 overflow-x-auto px-5 pb-2 md:mx-0 md:px-0" style="scrollbar-width: none">
              <div class="flex gap-2.5 md:flex-wrap" role="tablist" aria-label="Rubrieken van de kaart">
                {kaart.map((r, i) => <button type="button" role="tab" class="chip" id={`tab-${r.id}`} aria-controls={`r-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={r.id}>{r.t}</button>)}
              </div>
            </div>
            {kaart.map((r, i) => (
              <div id={`r-${r.id}`} role="tabpanel" aria-labelledby={`tab-${r.id}`} class:list={['mt-6', i !== 0 && 'hidden']} data-paneel={r.id}>
                <ul>
                  {r.items.map((g) => (
                    <li class="regel">
                      <span class="regel-nr num" aria-hidden="true">{g.nr ? g.nr : ''}</span>
                      <div class="min-w-0">
                        <p class="font-kop text-[1.2rem] font-extrabold leading-tight tracking-[-.02em]">{g.n}</p>
                        {g.d && <p class="mt-1 text-[.98rem] text-steen">{g.d}</p>}
                        {g.v && (
                          <select class="variant" aria-label={`Keuze voor ${g.n}`} data-variant>
                            {g.v.map((v) => <option value={v}>{v}</option>)}
                          </select>
                        )}
                      </div>
                      <button type="button" class="plus" aria-label={`${g.n} toevoegen`} data-plus data-nr={g.nr} data-naam={g.n}><Icoon naam="plus" class="h-5 w-5" /></button>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="mt-6 text-sm text-steen">Gerechten en omschrijvingen van de eigen kaart. Prijzen staan op de kaart in de zaak.</p>
          </div>

          <div class="min-w-0 lg:col-span-5">
            <form class="rounded-[22px] bg-inkt p-6 text-wit sm:p-8 lg:sticky lg:top-8" data-bestel>
              <div class="flex items-center justify-between gap-4">
                <p class="font-kop text-2xl font-extrabold tracking-[-.03em]">Uw bestelling</p>
                <span class="num rounded-full bg-merk px-3 py-1 text-sm font-bold" data-aantal>0</span>
              </div>
              <ul class="mt-5 space-y-2" data-lijst aria-live="polite"></ul>
              <p class="mt-5 rounded-[14px] border border-dashed border-lijn px-4 py-5 text-center text-sm text-mist" data-leeg>Nog niets gekozen. Tik op + bij een gerecht.</p>

              <fieldset class="mt-7">
                <legend class="veld-label">Afhalen of hier eten?</legend>
                <div class="flex flex-wrap gap-2.5">
                  <label class="keuze"><input type="radio" name="soort" value="afhalen" checked /><Icoon naam="zak" class="h-4 w-4" />Afhalen</label>
                  <label class="keuze"><input type="radio" name="soort" value="tafel" /><Icoon naam="tafel" class="h-4 w-4" />Tafel aanvragen</label>
                </div>
              </fieldset>
              <div class="mt-6 grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="tijd" class="veld-label">Hoe laat?</label>
                  <select id="tijd" name="tijd" class="veld num">
                    <option value="">Zo snel mogelijk</option>
                    {tijden.map((t) => <option value={t}>{t} uur</option>)}
                  </select>
                </div>
                <div data-personen class="hidden">
                  <label for="pers" class="veld-label">Met hoeveel personen?</label>
                  <select id="pers" name="pers" class="veld num">
                    {[1, 2, 3, 4, 5, 6, 7].map((n) => <option value={n} selected={n === 2}>{n}</option>)}
                  </select>
                </div>
                <div>
                  <label for="pit" class="veld-label">Hoe pittig?</label>
                  <select id="pit" name="pit" class="veld">
                    <option>Niet pittig</option><option>Een beetje pittig</option><option selected>Normaal</option><option>Extra pittig</option>
                  </select>
                </div>
              </div>
              <div class="mt-5">
                <label for="naam" class="veld-label">Uw naam</label>
                <input id="naam" name="naam" class="veld" autocomplete="given-name" placeholder="Voor bij de bestelling" />
              </div>
              <p class="mt-6 hidden rounded-[12px] bg-merk/20 px-4 py-3 text-sm text-wit" data-dicht></p>
              <a href={waHoi} class="knop knop-merk mt-6 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <p class="mt-3 text-center text-sm text-mist">Liever bellen? <a href={site.telHref} class="num font-bold text-wit no-underline hover:text-merk-licht">{site.tel}</a></p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Mobiel: zwevende knop naar de bestelling zodra er iets gekozen is -->
    <a href="#bestel-paneel" class="knop knop-inkt fixed inset-x-4 bottom-[4.4rem] z-30 hidden transition-opacity shadow-[0_12px_30px_#1a131166] md:hidden" data-zweef><span>Bekijk bestelling (<span class="num" data-zweef-n>0</span>)</span><Icoon naam="pijl" /></a>

    <!-- 7. Galerij: gerechten van het Google-profiel -->
    <section class="bg-room-2 py-20 md:py-24" aria-label="Gerechten van Teppratanporn">
      <div class="wrap">
        <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
          {[
            [gSate, 'Kipsaté met pindasaus'],
            [gTomyam, 'Heldere pittige soep met tomaat en champignons'],
            [gLoempia, "Loempia's met komkommer en chilisaus"],
            [gMassaman, 'Gele kokoscurry met aardappel'],
          ].map(([src, alt], i) => (
            <li class="rijs" style={`--d:${i * 0.05}s`}><Image src={src} alt={alt as string} widths={[360, 560]} sizes="(min-width: 768px) 24vw, 48vw" quality={68} class="aspect-[4/5] w-full rounded-[18px] object-cover" /></li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-steen">Foto's van gerechten zoals gasten ze op Google zetten.</p>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat gasten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-9 w-9 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-extrabold leading-none">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-sm text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="kaart flex h-full flex-col p-7">
                <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
                <blockquote class="mt-5 flex-1 leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5 text-sm">
                  <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-room-2 font-bold">{r.naam[0]}</span>
                  <span><b class="block font-bold">{r.naam}</b><span class="text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. Tijden en route -->
    <section id="contact" class="border-t border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-contact">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Tijden en route</p>
          <h2 id="t-contact" class="rijs mt-5 text-4xl">Broersveld 108, Schiedam.</h2>
          <p class="rijs mt-8"><a href={site.telHref} class="num font-kop text-[clamp(2.1rem,4.6vw,3.8rem)] font-extrabold leading-none tracking-[-.05em] text-inkt no-underline transition-colors hover:text-merk">{site.tel}</a></p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.08s">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.route} class="knop knop-rand"><Icoon naam="pin" />Route plannen</a>
          </div>
          <div class="rijs kaart mt-10 overflow-hidden" style="--d:.12s">
            <div class="flex items-center justify-between gap-4 border-b border-lijn-licht px-6 py-4">
              <p class="font-bold">Openingstijden</p>
              <p class="flex items-center gap-2 text-sm font-bold" data-nu><span class="h-2.5 w-2.5 rounded-full bg-room-3" data-stip></span><span data-nu-tekst>Dagelijks open, woensdag gesloten</span></p>
            </div>
            <ul class="num divide-y divide-lijn-licht">
              {week.map((d) => (
                <li class="flex justify-between gap-4 px-6 py-3" data-dag={d.dag}>
                  <span>{d.t}</span><span class={d.dag === site.dichtDag ? 'text-steen' : ''}>{d.dag === site.dichtDag ? 'Gesloten' : '14.00 tot 21.30 uur'}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <figure class="rijs self-start lg:col-span-5">
          <Image src={menukaart} alt="De eigen menukaart van Teppratanporn: de naam in grote letters, een Thaise figuur en de tekst Bel en bestel" widths={[420, 640, 1000]} sizes="(min-width: 1024px) 36vw, 100vw" quality={72} class="aspect-[1000/1357] w-full rounded-[22px] object-cover shadow-[0_24px_50px_-20px_#1a131159] max-lg:aspect-[4/3] max-lg:object-[50%_8%]" />
          <figcaption class="mt-3 text-sm text-steen">De eigen menukaart, met de tijden en "Bel en bestel!"</figcaption>
        </figure>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-merk text-wit" aria-label="Bestellen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center md:py-14">
        <p class="font-kop text-3xl font-extrabold leading-none tracking-[-.04em]">Bel en bestel!</p>
        <div class="flex flex-wrap gap-3">
          <a href="#bestellen" class="knop knop-inkt shrink-0">Bestelling samenstellen<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-wit num shrink-0"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';

  // Live status: dagelijks 14.00 tot 21.30, woensdag gesloten.
  const nu = new Date();
  const dag = nu.getDay();
  const uur = nu.getHours() + nu.getMinutes() / 60;
  const dichtVandaag = dag === site.dichtDag;
  const open = !dichtVandaag && uur >= site.open && uur < site.dicht;
  const tekst = open ? 'Nu open, tot 21.30 uur' : dichtVandaag ? 'Vandaag gesloten (woensdag)' : uur < site.open ? 'Vandaag open vanaf 14.00 uur' : 'Nu gesloten, morgen weer open';
  const s = document.querySelector('[data-status]');
  if (s) s.textContent = tekst;
  const nt = document.querySelector('[data-nu-tekst]');
  if (nt) nt.textContent = tekst.replace(', morgen weer open', '');
  document.querySelector('[data-stip]')?.classList.replace('bg-room-3', open ? 'bg-[#2f9e5b]' : 'bg-merk');
  document.querySelector(`[data-dag="${dag}"]`)?.classList.add('bg-room', 'font-bold');

  // Rubrieken (tabs)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const toon = (id: string) => {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
    document.querySelectorAll<HTMLElement>('[data-paneel]').forEach((p) => p.classList.toggle('hidden', p.dataset.paneel !== id));
  };
  tabs.forEach((t) => t.addEventListener('click', () => toon(t.dataset.tab!)));
  document.querySelectorAll<HTMLAnchorElement>('[data-naar]').forEach((a) => a.addEventListener('click', () => toon(a.dataset.naar!)));

  // Bestelling
  type Regel = { sleutel: string; nr: string; naam: string; n: number };
  const regels: Regel[] = [];
  const f = document.querySelector<HTMLFormElement>('[data-bestel]')!;
  f.id = 'bestel-paneel';
  const lijst = f.querySelector<HTMLElement>('[data-lijst]')!;
  const leeg = f.querySelector<HTMLElement>('[data-leeg]')!;
  const aantal = f.querySelector<HTMLElement>('[data-aantal]')!;
  const knop = f.querySelector<HTMLAnchorElement>('[data-verstuur]')!;
  const dicht = f.querySelector<HTMLElement>('[data-dicht]')!;
  const zweef = document.querySelector<HTMLElement>('[data-zweef]');
  const zweefN = document.querySelector<HTMLElement>('[data-zweef-n]');
  const pers = f.querySelector<HTMLElement>('[data-personen]')!;

  const teken = () => {
    lijst.innerHTML = '';
    regels.forEach((r, i) => {
      const li = document.createElement('li');
      li.className = 'flex items-center justify-between gap-3 border-b border-[#ffffff1a] pb-2';
      li.innerHTML = `<span class="min-w-0 text-[.98rem]"><span class="text-[#bcaea4]">${r.nr ? r.nr + '. ' : ''}</span>${r.naam}</span>`;
      const t = document.createElement('span'); t.className = 'teller flex-none';
      t.innerHTML = `<button type="button" aria-label="Eén minder">−</button><span class="num w-6 text-center font-bold">${r.n}</span><button type="button" aria-label="Eén meer">+</button>`;
      const [min, plus] = t.querySelectorAll('button');
      min.addEventListener('click', () => { r.n--; if (r.n < 1) regels.splice(i, 1); zet(); });
      plus.addEventListener('click', () => { r.n++; zet(); });
      li.append(t); lijst.append(li);
    });
  };

  const zet = () => {
    teken();
    const n = regels.reduce((a, r) => a + r.n, 0);
    aantal.textContent = String(n);
    leeg.classList.toggle('hidden', n > 0);
    if (zweef && zweefN) { zweefN.textContent = String(n); zweef.classList.toggle('hidden', n === 0); zweef.classList.toggle('inline-flex', n > 0); }
    const d = new FormData(f);
    const tafel = d.get('soort') === 'tafel';
    pers.classList.toggle('hidden', !tafel);
    const tijd = String(d.get('tijd') || '');
    const naam = String(d.get('naam') || '').trim();
    const r: string[] = [];
    if (tafel) r.push(`Hallo Teppratanporn, ik wil graag een tafel voor ${d.get('pers')} ${d.get('pers') === '1' ? 'persoon' : 'personen'}${tijd ? ` om ${tijd} uur` : ''}.`);
    else r.push(`Hallo Teppratanporn, ik wil graag bestellen om af te halen${tijd ? ` om ${tijd} uur` : ''}.`);
    if (regels.length) { r.push(tafel ? 'We willen graag dit eten:' : 'Mijn bestelling:'); regels.forEach((x) => r.push(`${x.n}x ${x.nr ? x.nr + '. ' : ''}${x.naam}`)); r.push(`Pittigheid: ${String(d.get('pit')).toLowerCase()}.`); }
    if (naam) r.push(`Naam: ${naam}`);
    knop.href = `${site.wa}?text=${encodeURIComponent(r.join('\n'))}`;
    // Waarschuwing bij woensdag of buiten de tijden
    const msg = dichtVandaag ? 'Let op: op woensdag is Teppratanporn gesloten.' : uur >= site.dicht ? 'Let op: vandaag zijn we al dicht. Morgen vanaf 14.00 uur weer open.' : '';
    dicht.textContent = msg; dicht.classList.toggle('hidden', !msg);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-plus]').forEach((b) => b.addEventListener('click', () => {
    const v = b.closest('li')?.querySelector<HTMLSelectElement>('[data-variant]')?.value;
    const naam = v ? `${b.dataset.naam} (${v.toLowerCase()})` : b.dataset.naam!;
    const nr = b.dataset.nr === '0' ? '' : b.dataset.nr!;
    const sleutel = nr + naam;
    const r = regels.find((x) => x.sleutel === sleutel);
    if (r) r.n++; else regels.push({ sleutel, nr, naam, n: 1 });
    b.classList.remove('tik'); void b.offsetWidth; b.classList.add('tik');
    zet();
  }));
  // Zwevende knop verbergen zolang het bestelpaneel in beeld is
  let paneelZicht = false;
  new IntersectionObserver((es) => { paneelZicht = es[0].isIntersecting; zweef?.classList.toggle('opacity-0', paneelZicht); zweef?.classList.toggle('pointer-events-none', paneelZicht); }).observe(f);
  f.addEventListener('input', zet); f.addEventListener('change', zet);
  f.addEventListener('submit', (e) => e.preventDefault());
  zet();
</script>
