          <fieldset class="mt-7">
            <legend class="text-sm font-semibold">Wilt u ook een kleurproef?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Ja, graag', 'Nee', 'Weet ik nog niet'].map((b) => (
                <label class="keuze"><input type="radio" name="proef" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block"><span class="text-sm font-semibold">Woonplaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Omschrijving <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="2" class="veld mt-2" placeholder="Bijvoorbeeld: kozijnen en voordeur buiten, jaren 30 woning"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
