        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Alle reviews op Google</a></p>
      </div>
    </section>

    <!-- 10. Offerte: bericht samenstellen + bereikbaarheid -->
    <section id="offerte" class="py-20 lg:py-20" aria-labelledby="t-offerte">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
