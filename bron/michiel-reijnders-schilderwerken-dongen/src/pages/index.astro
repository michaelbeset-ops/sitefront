  </main>
  <Voet />
</Base>

<script>
  // Voor/na-schuif
  document.querySelectorAll<HTMLElement>('[data-vn]').forEach((vn) => {
    const inp = vn.querySelector<HTMLInputElement>('[data-vn-in]');
    inp?.addEventListener('input', () => vn.style.setProperty('--p', inp.value + '%'));
  });
  // Wandkleur wisselen
  document.querySelectorAll<HTMLInputElement>('input[name="wand"]').forEach((r) => r.addEventListener('change', () => {
    document.querySelectorAll<HTMLElement>('[data-wand] [data-kleur]').forEach((img) => img.classList.toggle('opacity-0', img.dataset.kleur !== r.value));
  }));
  // Offerte naar WhatsApp
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Goedendag Michiel, ik wil graag een vrijblijvende offerte.'];
      const werk = d.getAll('werk').map(String);
      if (werk.length) r.push('Werk: ' + werk.join(', '));
      if (v('proef')) r.push('Kleurproef: ' + v('proef').toLowerCase());
      if (v('plaats')) r.push('Woonplaats: ' + v('plaats'));
      if (v('wens')) r.push('Omschrijving: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31640373035?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

