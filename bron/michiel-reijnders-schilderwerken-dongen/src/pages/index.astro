---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero-herenhuis.jpg';
import ladder from '../assets/michiel-ladder.jpg';
import schouw from '../assets/schouw-decoratief.jpg';
import deurLak from '../assets/deur-lak.jpg';
import inbouwkast from '../assets/inbouwkast.jpg';
import houtrotVoor from '../assets/houtrot-voor.jpg';
import houtrotNa from '../assets/houtrot-na.jpg';
import behang from '../assets/behang.jpg';
import steiger from '../assets/herenhuis-steiger.jpg';
import villa from '../assets/villa.jpg';
import veranda from '../assets/veranda.jpg';
import serre from '../assets/serre.jpg';
import dakkapel from '../assets/dakkapel.jpg';
import deurVoor from '../assets/deur-voor.jpg';
import deurNa from '../assets/deur-na.jpg';
import huisOrigineel from '../assets/kleur-huis-origineel.jpg';
import huisBewerkt from '../assets/kleur-huis-bewerkt.jpg';
import wandWit from '../assets/kleur-wand-wit.jpg';
import wandOker from '../assets/kleur-wand-oker.jpg';
import wandPetrol from '../assets/kleur-wand-petrol.jpg';

const vraag = (d: string) => waMet(`Goedendag Michiel, ik wil graag een vrijblijvende offerte voor ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Buitenschilderwerk', d: 'Onderhoud en nieuwbouw. Mooi afgewerkt, en vaktechnisch in orde.', src: deurLak, alt: 'Een donkere voordeur in hoogglans lak, waarin de tuin weerspiegelt', pos: '40% 50%' },
  { t: 'Binnenschilderwerk', d: 'Muren sausen, kozijnen, deuren en kasten lakken.', src: inbouwkast, alt: 'Een woonkamer met witgelakte inbouwkasten naast openslaande deuren', pos: '50% 50%' },
  { t: 'Houtrot herstel', d: 'Zacht hout en bladderende verf vakkundig hersteld, met professionele producten.', src: houtrotVoor, alt: 'Aangetast hout onderaan een witte houten gevelbetimmering', pos: '50% 60%' },
  { t: 'Behang en wandafwerking', d: 'Een muur behangen, of een afwerking die net even anders is.', src: behang, alt: 'Een kamer met banen bloemenbehang in verschillende dessins', pos: '50% 50%' },
  { t: 'Decoratieve technieken', d: 'Marmer- en houtimitatie, betonlook, kalkverf en meer.', src: schouw, alt: 'Een schouw met verouderde afwerking voor een wand in donkere decoratieve techniek', pos: '50% 50%' },
  { t: 'Kleur- en klusadvies', d: 'Gaat u zelf schilderen? Michiel adviseert over kleur en aanpak.', src: wandPetrol, alt: 'Een woonkamer met een gebogen wand, digitaal ingekleurd in petrolblauw', pos: '50% 50%' },
];

const technieken = ['Marrakech walls', 'Inschaduw- en verouderingstechnieken', 'Hout- en marmerimitaties', 'Muurdecoraties', 'Betonlook of tadelakt look', 'Kalkverf technieken', 'White wash afwerking'];

const stappen = [
  ['Bel of app', 'Vertel kort wat er moet gebeuren, binnen of buiten. Een foto meesturen helpt.'],
  ['Kijken en meedenken', 'Michiel komt kijken, denkt mee over de mogelijkheden en geeft kleuradvies.'],
  ['Vrijblijvende offerte', 'U krijgt een heldere offerte. Twijfelt u over de kleur, dan kan er een kleurproef bij.'],
  ['Uitvoering', 'Michiel voert het werk zelf uit, van voorbereiding tot de laatste laklaag.'],
];
---
<Base title={`${site.naam} | Schilder in Dongen`} description="Michiel Reijnders Schilderwerken in Dongen: buiten- en binnenschilderwerk, houtrot herstel, behang en decoratieve technieken. 5,0 op Google. Vrijblijvende offerte.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: herenhuis met hun eigen bus en steigerkar -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2048]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[58%_62%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#14191b40_0%,#14191bb0_42%,#14191bf5_100%)] md:bg-[linear-gradient(90deg,#14191bf2_0%,#14191bc4_40%,#14191b33_75%,#14191b1a_100%)]" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 hidden h-1/3 bg-[linear-gradient(0deg,#14191bcc,transparent)] md:block" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-10 pb-24 pt-32 md:pb-20 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Schilder in Dongen</p>
          <h1 id="t-hero" class="mt-6 text-hero">Schilderwerk, zoals schilderwerk <em class="text-ijs">hoort</em> te zijn.</h1>
          <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Buiten- en binnenschilderwerk, houtrot herstel, behang en decoratieve technieken. Door Michiel Reijnders zelf, opgeleid aan Sint Lucas in Boxtel.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="knop knop-petrol">Vrijblijvende offerte<Icoon naam="pijl" /></a>
            <a href="#kleurproef" class="knop knop-rand op-foto">Bekijk de kleurproef</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90 lg:hidden">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 17.00 uur</span></li>
          </ul>
        </div>
        <div class="hidden text-right lg:col-span-4 lg:block">
          <p class="flex items-center justify-end gap-2 text-[.9375rem] text-licht/90" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 17.00 uur</span></p>
          <p class="mt-2 flex items-center justify-end gap-2 text-[.9375rem] text-licht/90"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</p>
          <a href={site.telHref} class="num mt-3 inline-block font-kop text-[2.1rem] font-bold leading-none text-licht no-underline hover:text-ijs">{site.tel}</a>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-3 overflow-x-auto py-4 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-sm border border-lijn bg-papier px-3.5 py-1.5 text-sm font-medium no-underline transition-colors hover:border-petrol hover:bg-petrol hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-20" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-dienst" class="mt-5 text-3xl">Van de buitengevel tot de <em class="text-petrol">laatste</em> deur binnen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Voor particulieren, in onderhoud en nieuwbouw. Ook kitwerk van kozijnen. Klik op een dienst voor een offerte.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[16/10]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-4 sm:p-6">
                  <div>
                    <h3 class="text-[1.2rem] sm:text-[1.65rem]">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-sm border border-lijn text-petrol transition-colors group-hover:border-petrol group-hover:bg-petrol group-hover:text-wit sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Kleurproef: hun eigen digitale bewerkingen -->
    <section id="kleurproef" class="border-y border-lijn bg-wit py-20 lg:py-20" aria-labelledby="t-kleur">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Kleurproef</p>
            <h2 id="t-kleur" class="mt-5 text-3xl">Eerst zien, <em class="text-petrol">dan</em> schilderen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Twijfelt u over een nieuwe kleur? Michiel bewerkt een foto van uw huis of kamer in de kleuren die u samen bespreekt.</p>
        </div>
        <div class="mt-12 grid gap-5 lg:mt-16 lg:grid-cols-12 lg:gap-6">
          <figure class="rijs kaart overflow-hidden lg:col-span-7">
            <div class="vn relative aspect-[796/594] select-none overflow-hidden bg-steen" style="--p:50%" data-vn>
              <Image src={huisOrigineel} alt="Een vrijstaand huis in rode baksteen, de originele foto" widths={[400, 796]} sizes="(min-width: 1024px) 680px, 92vw" class="absolute inset-0 h-full w-full object-cover" />
              <div class="vn-na absolute inset-0">
                <Image src={huisBewerkt} alt="Hetzelfde huis, digitaal bewerkt met lichte gevel en donkere kozijnen" widths={[400, 796]} sizes="(min-width: 1024px) 680px, 92vw" class="absolute inset-0 h-full w-full object-cover" />
              </div>
              <span class="pointer-events-none absolute left-3 top-3 rounded-sm bg-nacht/80 px-2.5 py-1 text-xs font-semibold uppercase tracking-[.14em] text-licht">Origineel</span>
              <span class="pointer-events-none absolute right-3 top-3 rounded-sm bg-petrol px-2.5 py-1 text-xs font-semibold uppercase tracking-[.14em] text-wit">Bewerkt</span>
              <span class="vn-lijn pointer-events-none absolute inset-y-0" aria-hidden="true"><span class="vn-greep"><Icoon naam="schuif" class="h-5 w-5" /></span></span>
              <input type="range" min="0" max="100" value="50" class="vn-in absolute inset-0 h-full w-full cursor-ew-resize opacity-0" aria-label="Schuif tussen origineel en bewerkt" data-vn-in />
            </div>
            <figcaption class="flex items-center justify-between gap-4 px-5 py-4 text-sm text-grijs">
              <span>Schuif om de gevel voor en na te vergelijken.</span>
              <span class="hidden font-semibold text-inkt sm:inline">Gevel</span>
            </figcaption>
          </figure>
          <figure class="rijs kaart flex flex-col overflow-hidden lg:col-span-5" style="--d:.06s">
            <div class="relative aspect-[618/376] overflow-hidden bg-steen lg:aspect-auto lg:min-h-[17rem] lg:flex-1" data-wand>
              <Image src={wandWit} alt="Woonkamer met de gebogen wand in wit" widths={[320, 618]} sizes="(min-width: 1024px) 480px, 92vw" class="wand absolute inset-0 h-full w-full object-cover" data-kleur="wit" />
              <Image src={wandOker} alt="Dezelfde woonkamer met de gebogen wand in oker" widths={[320, 618]} sizes="(min-width: 1024px) 480px, 92vw" class="wand absolute inset-0 h-full w-full object-cover opacity-0" data-kleur="oker" />
              <Image src={wandPetrol} alt="Dezelfde woonkamer met de gebogen wand in petrolblauw" widths={[320, 618]} sizes="(min-width: 1024px) 480px, 92vw" class="wand absolute inset-0 h-full w-full object-cover opacity-0" data-kleur="petrol" />
            </div>
            <figcaption class="flex flex-col gap-4 px-5 py-5">
              <fieldset>
                <legend class="text-sm text-grijs">Kies een wandkleur</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  {[['wit', 'Wit', '#ecebe4'], ['oker', 'Oker', '#b49a3c'], ['petrol', 'Petrol', '#2f5f73']].map(([v, t, c], i) => (
                    <label class="swatch"><input type="radio" name="wand" value={v} class="sr-only" checked={i === 0} /><span><i style={`background:${c}`}></i>{t}</span></label>
                  ))}
                </div>
              </fieldset>
              <p class="text-sm text-grijs">Voorbeelden van eerdere kleurproeven van Michiel.</p>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 5. Werk -->
    <section id="werk" class="donker bg-nacht py-20 text-licht lg:py-28" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Uit de praktijk</p>
            <h2 id="t-werk" class="mt-5 text-3xl">Van herenhuis <em class="text-ijs">tot</em> dakkapel.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Een greep uit het werk van Michiel, buiten en binnen. Met twee keer een voor en na.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-16">
          <li class="rijs relative col-span-2 row-span-2 aspect-[4/3] overflow-hidden rounded-md bg-nacht-2 md:aspect-auto">
            <Image src={steiger} alt="Een herenhuis in donkere baksteen met witte kozijnen, met steiger en reclamebord van Michiel Reijnders Schilderwerken" widths={[600, 838]} sizes="(min-width: 1248px) 590px, (min-width: 768px) 48vw, 92vw" class="tegel absolute inset-0 h-full w-full object-cover" />
          </li>
          {[
            { src: villa, alt: 'Een woning met donkere luiken en strak geschilderde witte kozijnen' },
            { src: veranda, alt: 'Een woning met een overkapping met zwarte staanders' },
            { src: serre, alt: 'Een serre met witgeschilderde kozijnen' },
            { src: dakkapel, alt: 'Een gerenoveerde dakkapel in wit en grijs' },
          ].map((w, i) => (
            <li class="rijs relative aspect-square overflow-hidden rounded-md bg-nacht-2 md:aspect-[4/3]" style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={[320, 458]} sizes="(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw" class="tegel absolute inset-0 h-full w-full object-cover" />
            </li>
          ))}
        </ul>
        <div class="mt-3 grid gap-3 md:mt-4 md:grid-cols-2 md:gap-4">
          {[
            { t: 'Houtrot herstel', a: houtrotVoor, aa: 'Aangetast hout onderaan een houten betimmering', b: houtrotNa, ba: 'De betimmering na herstel, strak in het wit' },
            { t: 'Een deur opgeknapt', a: deurVoor, aa: 'Een paneeldeur, geschuurd en geplamuurd', b: deurNa, ba: 'Dezelfde paneeldeur, wit gelakt' },
          ].map((p, i) => (
            <div class="rijs rounded-md bg-nacht-2 p-3" style={`--d:${i * 0.06}s`}>
              <div class="grid grid-cols-2 gap-3">
                <figure class="relative aspect-[4/3] overflow-hidden rounded-sm md:aspect-[16/10]"><Image src={p.a} alt={p.aa} widths={[320, 480]} sizes="(min-width: 768px) 290px, 45vw" class="h-full w-full object-cover" /><figcaption class="absolute left-2 top-2 rounded-sm bg-nacht/85 px-2 py-0.5 text-xs font-semibold uppercase tracking-[.14em]">Voor</figcaption></figure>
                <figure class="relative aspect-[4/3] overflow-hidden rounded-sm md:aspect-[16/10]"><Image src={p.b} alt={p.ba} widths={[320, 480]} sizes="(min-width: 768px) 290px, 45vw" class="h-full w-full object-cover" /><figcaption class="absolute left-2 top-2 rounded-sm bg-petrol px-2 py-0.5 text-xs font-semibold uppercase tracking-[.14em] text-wit">Na</figcaption></figure>
              </div>
              <p class="px-1 pb-1 pt-3 font-kop text-xl font-bold">{p.t}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Decoratieve technieken -->
    <section class="bg-steen py-20 lg:py-20" aria-labelledby="t-deco">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="rijs relative min-h-[22rem] overflow-hidden rounded-md lg:col-span-5">
          <Image src={schouw} alt="Een schouw met een verouderde, kalkachtige afwerking tegen een wand in een donkere, gewolkte decoratieve techniek" widths={[640, 960, 1280]} sizes="(min-width: 1248px) 590px, (min-width: 1024px) 48vw, 92vw" class="absolute inset-0 h-full w-full object-cover object-[65%_50%]" />
        </div>
        <div class="lg:col-span-7 lg:py-2 lg:pl-6">
          <p class="eyebrow">Restauratie en decoratie</p>
          <h2 id="t-deco" class="mt-5 text-3xl">Meer dan <em class="text-petrol">een strak</em> laklaagje.</h2>
          <p class="mt-6 text-lg text-grijs">Michiel studeerde in 2009 af aan Sint Lucas in Boxtel, als Specialist Schilder, Restaurateur, Decorateur. Wilt u iets aparts met uw wanden? Hij denkt graag mee.</p>
          <ul class="mt-8 grid gap-x-6 sm:grid-cols-2">
            {technieken.map((t) => <li class="flex items-center gap-3 border-b border-lijn py-3"><span class="h-1.5 w-1.5 shrink-0 bg-petrol" aria-hidden="true"></span>{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 8. Over Michiel -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[28rem] lg:col-span-6">
          <Image src={ladder} alt="Michiel Reijnders op een trap, aan het werk aan een houten plafond onder een overkapping" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[32%_78%]" />
          <p class="absolute bottom-4 left-4 rounded-sm bg-petrol px-4 py-1.5 text-sm font-semibold text-wit">Michiel Reijnders</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Michiel</p>
          <h2 id="t-over" class="mt-5 text-[clamp(2.2rem,2.2vw+1.3rem,3.3rem)]">“Ik kan nu eindelijk de kwaliteit leveren waar ik <em class="text-ijs">zelf</em> achter sta.”</h2>
          <p class="mt-6 text-lg text-licht-zacht">Michiel Reijnders Schilderwerken is een eenmanszaak voor particulieren in Dongen. Na zijn opleiding deed Michiel eerst praktijkervaring op. Hij streeft naar een perfect eindresultaat: niet alleen mooi, maar ook vaktechnisch goed onderhouden.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-petrol text-wit"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Denkt met u mee</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Over de mogelijkheden, de aanpak en de kleur.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-petrol text-wit"><Icoon naam="persoon" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Eén vast aanspreekpunt</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">U spreekt Michiel, en Michiel doet het werk.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-petrol text-wit"><Icoon naam="kwast" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Keurig uitgevoerd</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Dat schrijven klanten ook in hun Google-reviews.</p></div>
            </li>
          </ul>
          <a href="#offerte" class="knop knop-petrol mt-8">Vraag een offerte aan<Icoon naam="pijl" /></a>
        </div>
      </div>
    </section>

    <!-- 9. Reviews -->
    <section id="reviews" class="bg-steen py-20 lg:py-20" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
