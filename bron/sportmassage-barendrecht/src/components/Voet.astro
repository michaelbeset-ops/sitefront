---
import { site, tijden, uur, url } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const thuis = url('');
// Volgorde ma-zo voor de lijst.
const week = [...tijden.slice(1), tijden[0]];
---
<footer class="donker bg-asfalt-diep text-licht-zacht">
  <div class="wrap grid gap-12 py-20 text-sm sm:grid-cols-2 lg:grid-cols-12 lg:gap-8 lg:py-24">
    <div class="lg:col-span-4">
      <a href={thuis} class="inline-flex items-center gap-3 text-licht">
        <span class="grid h-10 w-10 place-items-center rounded-md bg-geel"><Merk class="h-3.5 w-auto text-inkt" /></span>
        <span class="leading-none"><span class="block font-display text-lg font-extrabold tracking-[-.03em]">Sportmassage</span><span class="mt-1 block text-xs text-licht-zacht">Praktijk Barendrecht</span></span>
      </a>
      <p class="mt-6 max-w-[20rem] leading-relaxed">Sport-, hot stone-, ontspannings- en zwangerschapsmassage door gediplomeerd masseur {site.masseur}. In de praktijk aan de Dorpsstraat-Oost of op locatie.</p>
    </div>
    <div class="lg:col-span-2">
      <h2 class="font-display text-xs font-bold uppercase tracking-[.16em] text-licht">Behandelingen</h2>
      <ul class="mt-5 space-y-2.5">
        {['Sportmassage', 'Hot stone-massage', 'Full body relaxing', 'Rug-schouder-nek', 'Zwangerschapsmassage', 'Op locatie', 'Cadeaubon'].map((b) => <li><a href={`${thuis}#behandelingen`} class="hover:text-licht">{b}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <h2 class="font-display text-xs font-bold uppercase tracking-[.16em] text-licht">Contact</h2>
      <ul class="mt-5 space-y-3">
        <li class="flex gap-3"><Icoon naam="pin" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-geel" /><span>{site.straat}<br />{site.postcode} {site.plaats}</span></li>
        <li class="flex gap-3"><Icoon naam="tel" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-geel" /><a href={site.telHref} class="num whitespace-nowrap hover:text-licht">{site.tel}</a></li>
        <li class="flex gap-3"><Icoon naam="mail" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-geel" /><a href={`mailto:${site.mail}`} class="break-all hover:text-licht">{site.mail}</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <h2 class="font-display text-xs font-bold uppercase tracking-[.16em] text-licht">Openingstijden</h2>
      <dl class="num mt-5 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1.5">
        {week.map((d) => (<><dt>{d.dag}</dt><dd class="whitespace-nowrap text-right sm:text-left">{d.open ? `${uur(d.open)} tot ${uur(d.dicht!)}` : 'gesloten'}</dd></>))}
      </dl>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs">
    <p class="num">© 2026 {site.naam} · {site.google} op Google uit {site.googleAantal} reviews</p>
    <p><a href={url('privacy/')} class="underline underline-offset-4 hover:text-licht">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap pb-10 text-xs">Foto's van uw Google-bedrijfsprofiel (hero en praktijkfoto) en sfeerfoto's via Unsplash, ter illustratie. Teksten, gastenboekberichten en voorwaarden van sportmassagebarendrecht.nl; reviews letterlijk van Google.</p>}
</footer>
