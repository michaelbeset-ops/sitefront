---
// Topbar met USP's, sticky header (woordmerk, nav, telefoon, WhatsApp) en op mobiel een vaste onderbalk.
import { site, url, waMet } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const thuis = url('');
const nav = [
  ['Behandelingen', '#behandelingen'],
  ['Werkwijze', '#werkwijze'],
  ['Over Andrea', '#over'],
  ['Reviews', '#reviews'],
  ['Cadeaubon', '#cadeaubon'],
  ['Contact', '#contact'],
];
const wa = waMet('ik wil graag een afspraak maken. ');
---
<div class="hidden bg-asfalt-diep text-licht-zacht md:block">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-xs">
    <ul class="flex gap-6">
      {['Gediplomeerd masseur', 'Kosteloos intakegesprek', 'Ook op locatie'].map((u) => (
        <li class="flex items-center gap-1.5"><Icoon naam="check" class="h-4 w-4 text-geel" />{u}</li>
      ))}
    </ul>
    <p class="flex items-center gap-5">
      <span class="hidden items-center gap-1.5 lg:flex"><span class="sterren"><Icoon naam="ster" class="h-3.5 w-3.5" /></span>{site.google} op Google</span>
      <a href={site.telHref} class="num whitespace-nowrap font-semibold text-licht hover:text-geel">{site.tel}</a>
    </p>
  </div>
</div>

<header class="kop sticky top-0 z-40 border-b border-lijn bg-wit/95 backdrop-blur-md" data-kop>
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-4 lg:h-[4.75rem]">
    <a href={thuis} class="flex items-center gap-3">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-md bg-inkt"><Merk class="h-3.5 w-auto text-geel" /></span>
      <span class="leading-none">
        <span class="block font-display text-[1.125rem] font-extrabold tracking-[-.03em]">Sportmassage</span>
        <span class="mt-1 block text-xs text-grijs">Praktijk Barendrecht</span>
      </span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 font-display text-[.9375rem] font-semibold">
        {nav.map(([t, h]) => <li><a href={`${thuis}${h}`} class="navlink">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={site.telHref} class="num hidden items-center gap-2 whitespace-nowrap font-display font-bold xl:flex"><Icoon naam="tel" class="h-4.5 w-4.5" />{site.tel}</a>
      <a href={wa} class="btn btn-geel btn-klein hidden sm:inline-flex"><Icoon naam="whatsapp" />Afspraak maken</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full border border-lijn lg:hidden" aria-expanded="false" aria-controls="menu" aria-label="Menu openen" data-menu-knop>
        <Icoon naam="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div id="menu" class="menu lg:hidden" hidden data-menu>
    <nav aria-label="Menu" class="wrap flex min-h-full flex-col justify-between gap-10 pb-28 pt-6">
      <ul class="divide-y divide-lijn border-y border-lijn">
        {nav.map(([t, h]) => <li><a href={`${thuis}${h}`} class="flex items-center justify-between py-4 font-display text-2xl font-bold tracking-[-.03em]" data-menu-link>{t}<Icoon naam="pijl" class="h-5 w-5 text-grijs" /></a></li>)}
      </ul>
      <div class="space-y-3">
        <a href={wa} class="btn btn-geel w-full"><Icoon naam="whatsapp" />Afspraak via WhatsApp</a>
        <a href={site.telHref} class="btn btn-rand num w-full"><Icoon naam="tel" />Bel {site.tel}</a>
      </div>
    </nav>
  </div>
</header>

<div class="onderbalk fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-lijn bg-wit/95 p-2.5 backdrop-blur-md lg:hidden">
  <a href={site.telHref} class="btn btn-inkt btn-klein"><Icoon naam="tel" />Bellen</a>
  <a href={wa} class="btn btn-wa btn-klein"><Icoon naam="whatsapp" />WhatsApp</a>
</div>

<style>
  .navlink { position: relative; padding: .4rem 0; transition: color .2s ease; }
  .navlink::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; border-radius: 2px; background: var(--color-geel); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease-zacht); }
  .navlink:hover::after { transform: scaleX(1); }
  .kop.schaduw { box-shadow: var(--shadow-md); }
  .menu { position: fixed; left: 0; right: 0; bottom: 0; top: 4.25rem; background: var(--color-wit); overflow-y: auto; }
  .onderbalk { padding-bottom: max(.625rem, env(safe-area-inset-bottom)); }
</style>

<script>
  const kop = document.querySelector<HTMLElement>('[data-kop]')!;
  const zet = () => kop.classList.toggle('schaduw', scrollY > 40);
  zet(); addEventListener('scroll', zet, { passive: true });
  const knop = kop.querySelector<HTMLButtonElement>('[data-menu-knop]')!;
  const menu = kop.querySelector<HTMLElement>('[data-menu]')!;
  const open = (aan: boolean) => {
    menu.style.top = kop.getBoundingClientRect().bottom + 'px';
    menu.hidden = !aan;
    knop.setAttribute('aria-expanded', String(aan));
    knop.setAttribute('aria-label', aan ? 'Menu sluiten' : 'Menu openen');
    document.documentElement.style.overflow = aan ? 'hidden' : '';
  };
  knop.addEventListener('click', () => open(menu.hidden));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => open(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { open(false); knop.focus(); } });
</script>
