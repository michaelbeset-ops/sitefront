---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, kaart, reviews as r, waHoi, waBestel, waCouscous } from '../data/site';

import hero from '../assets/hero.jpg';
import bar from '../assets/bar.jpg';
import raam from '../assets/raam.jpg';
import cappuccino from '../assets/cappuccino.jpg';
import mojito from '../assets/mojito.jpg';
import matcha from '../assets/matcha.jpg';
import brownie from '../assets/brownie.jpg';
import thee from '../assets/thee.jpg';
import gevel from '../assets/gevel.jpg';

const tijdKeuzes = ['10.00', '10.30', '11.00', '11.30', '12.00', '12.30', '13.00', '13.30', '14.00', '14.30', '15.00', '15.30', '16.00', '16.30', '17.00', '17.30'];

const titel = 'Lunchroom Mirage | Ontbijt en lunch aan de Amsterdamsestraatweg, Utrecht';
const omschrijving = 'Lunchroom Mirage, Amsterdamsestraatweg 378 in Utrecht: Marokkaans ontbijt, msemen, harira, broodjes en salades, koffie van biologische bonen. Dinsdag t/m zondag 10.00-18.00 uur. Bestellen en afhalen via WhatsApp.';
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO: hun eigen foto van binnen, met de plantenwand en de kroonluchter -->
    <section class="op-blad relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-blad text-krijt md:min-h-[100svh]">
      <Kop />
      <div class="absolute inset-0 -z-10">
        <Image src={hero} alt="Binnen bij Mirage: barkrukken met gouden poten, houten stoelen, een groene plantenwand met neonletters en een kristallen kroonluchter" quality={72} widths={[480, 768, 1080, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[88%_50%] md:object-[50%_30%]" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,#10302fcc_0%,#10302f26_28%,#10302f4d_55%,#10302ff2_100%)] md:bg-[linear-gradient(90deg,#10302fe6_0%,#10302fa6_38%,#10302f00_70%),linear-gradient(180deg,#10302f99_0%,#10302f00_24%,#10302f00_68%,#10302fbf_100%)]"></div>
      </div>
      <div class="wrap mt-auto pb-20 pt-36 md:pb-20 lg:pb-24">
        <p class="text-[.9375rem] font-medium text-krijt/90">Lunchroom aan de Amsterdamsestraatweg, Utrecht</p>
        <h1 class="mt-5 max-w-[11ch] text-hero leading-[.98]">Van msemen tot <span class="text-neon">tuna melt.</span></h1>
        <p class="mt-6 max-w-lg text-lg text-krijt/90 md:mt-7 md:text-xl">Ontbijt en lunch, dinsdag tot en met zondag vanaf 10.00 uur. Hier eten of afhalen.</p>
        <div class="mt-8 flex flex-wrap gap-3 md:mt-9">
          <a href="#kaart" class="knop knop-neon max-sm:min-h-12 max-sm:px-5">Bekijk de kaart</a>
          <a href={waBestel} class="knop knop-wit max-sm:min-h-12 max-sm:px-5"><Icoon naam="wa" /><span class="max-sm:hidden">Bestellen via WhatsApp</span><span class="sm:hidden">Bestellen</span></a>
        </div>
      </div>
    </section>

    <!-- 2. DE ZAAK: groot beeld van binnen, weinig woorden -->
    <section id="binnen" class="py-24 md:py-28">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5 lg:pt-10">
          <h2 class="rijs text-3xl">Even de straat uit.</h2>
          <p class="rijs mt-8 max-w-md text-lg text-grijs">Bladerbehang, een groene wand en een kroonluchter boven de tafels. Binnen zit je aan de bar of aan tafel, buiten op het terras aan de straat.</p>
          <figure class="rijs mt-12 max-w-md border-l-2 border-petrol pl-6">
            <blockquote class="text-lg leading-relaxed">“{r.silva.tekst}”</blockquote>
            <figcaption class="mt-3 text-sm text-grijs">{r.silva.naam} · Google</figcaption>
          </figure>
          <figure class="rijs mt-10 hidden w-48 lg:block" style="--d:.1s">
            <Image src={raam} alt="Een broodje op een Marokkaans bord, een smoothie en een mojito aan het raam, met het terras erachter" quality={70} widths={[320, 520]} sizes="16rem" class="aspect-square w-full rounded-lg object-cover object-[50%_72%]" />
            <figcaption class="mt-3 text-sm text-grijs">Lunch aan het raam, met uitzicht op het terras</figcaption>
          </figure>
        </div>
        <figure class="rijs lg:col-span-7">
          <Image src={bar} alt="De bar van Mirage met koperen hanglampen, gouden barkrukken, tulpen en het krijtbordje van de vrijdag" quality={72} widths={[480, 760, 1000, 1400]} sizes="(min-width: 1024px) 54vw, 100vw" class="aspect-[4/5] w-full rounded-lg object-cover object-[50%_60%] lg:aspect-[1/1]" />
          <figcaption class="mt-3 text-sm text-grijs">De bar, met op het krijtbordje de special van vrijdag</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. DE KAART: de wow. Tik aan wat je wilt, stuur je lijstje via WhatsApp. -->
    <section id="kaart" class="bg-kalk-2 py-24 md:py-28">
      <div class="wrap">
        <div class="grid items-end gap-y-8 md:grid-cols-12 md:gap-x-10">
          <h2 class="rijs text-3xl md:col-span-6">De kaart</h2>
          <p class="rijs max-w-md text-lg text-grijs md:col-span-5 md:col-start-8">Tik aan wat je wilt en stuur je lijstje via WhatsApp. Om af te halen, of om met een groep te komen eten.</p>
        </div>

        <div class="mt-14 grid gap-y-14 lg:mt-16 lg:grid-cols-12 lg:gap-x-14">
          <div class="gap-x-12 md:columns-2 lg:col-span-8" data-kaart>
            {kaart.map((g, gi) => (
              <div class="rijs mb-12 break-inside-avoid" style={`--d:${(gi % 2) * 0.08}s`}>
                <h3 class="flex items-baseline justify-between gap-4 border-b-2 border-tekst pb-3 text-2xl">{g.kop}{g.noot && <span class="font-sans text-sm text-grijs">{g.noot}</span>}</h3>
                <ul>
                  {g.items.map((it) => (
                    <li>
                      <button type="button" class="gerecht" aria-pressed="false" data-gerecht={it.naam}>
                        <span class="text-[1.0625rem] font-semibold">{it.naam}{it.veg && <span class="ml-2 text-xs font-medium text-petrol">vega</span>}</span>
                        <span class="stip"></span>
                        <span class="plus" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
                        {it.wat && <span class="wat">{it.wat}</span>}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- Het lijstje, als een bonnetje -->
          <aside id="lijstje" class="scroll-mt-6 lg:col-span-4" aria-labelledby="lijstje-kop">
            <div class="rijs rounded-lg bg-kalk p-7 shadow-[0_1px_0_#14222114,0_20px_50px_-30px_#14222166] lg:sticky lg:top-8 md:p-8">
              <p id="lijstje-kop" class="font-kop text-2xl">Je lijstje</p>
              <p class="mt-2 text-sm text-grijs" data-leeg>Nog niets aangetikt. Tik gerechten op de kaart aan.</p>
              <ol class="mt-4 space-y-2 text-[1.0625rem]" data-lijst aria-live="polite"></ol>

              <fieldset class="mt-7 border-t border-dashed border-lijn pt-6">
                <legend class="sr-only">Afhalen of hier eten</legend>
                <div class="grid grid-cols-2 gap-2 rounded-full bg-kalk-2 p-1 text-sm font-semibold">
                  <label class="cursor-pointer"><input type="radio" name="soort" value="afhalen" class="peer sr-only" checked /><span class="block rounded-full py-2.5 text-center text-grijs transition-colors peer-checked:bg-petrol peer-checked:text-wit peer-focus-visible:outline-2 peer-focus-visible:outline-petrol">Afhalen</span></label>
                  <label class="cursor-pointer"><input type="radio" name="soort" value="groep" class="peer sr-only" /><span class="block rounded-full py-2.5 text-center text-grijs transition-colors peer-checked:bg-petrol peer-checked:text-wit peer-focus-visible:outline-2 peer-focus-visible:outline-petrol">Met een groep</span></label>
                </div>
              </fieldset>

              <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
                <label class="block"><span class="text-grijs">Hoe laat</span>
                  <select class="mt-1 w-full rounded-md border border-lijn bg-kalk px-3 py-2.5 text-base" data-tijd>
                    {tijdKeuzes.map((t) => <option value={t} selected={t === '12.30'}>{t} uur</option>)}
                  </select>
                </label>
                <label class="block" data-personen-wrap hidden><span class="text-grijs">Personen</span>
                  <select class="mt-1 w-full rounded-md border border-lijn bg-kalk px-3 py-2.5 text-base" data-personen>
                    {[4, 5, 6, 7, 8, 9, 10, 12, 15, 20].map((n) => <option value={n}>{n}{n === 20 ? '+' : ''}</option>)}
                  </select>
                </label>
              </div>

              <a href={waBestel} class="knop knop-petrol mt-7 w-full" data-stuur><Icoon naam="wa" />Stuur via WhatsApp</a>
              <p class="mt-4 text-xs leading-relaxed text-grijs">Je stuurt het bericht zelf vanuit WhatsApp. Het aanbod kan per dag wisselen.</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <a href="#lijstje" class="op-blad fixed inset-x-3 bottom-[4.25rem] z-30 flex items-center justify-between gap-3 rounded-full bg-petrol px-5 py-3 text-sm font-semibold text-wit no-underline shadow-[0_10px_30px_-10px_#10302f99] transition-transform duration-300 lg:hidden md:bottom-4" data-mini hidden><span data-mini-tekst>1 op je lijstje</span><span class="inline-flex items-center gap-1.5">Naar je lijstje <Icoon naam="pijl" class="h-4 w-4" /></span></a>

    <!-- 4. VRIJDAG: het krijtbordje van de bar, als echte sectie -->
    <section id="vrijdag" class="bordvlak relative overflow-hidden text-krijt">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] items-center gap-y-14 py-24 md:py-28 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-7">
          <p class="krijt rijs font-bord text-xl italic text-zacht">elke week</p>
          <h2 class="krijt rijs mt-2 text-[clamp(3.25rem,9vw,8.5rem)] leading-[.9]">Vrijdag<br />couscous</h2>
          <p class="rijs mt-8 max-w-md text-lg text-zacht">Op vrijdag staat de couscous op het krijtbordje bij de bar. Vraag even of hij er vandaag is.</p>
          <p class="mt-4 text-neon" data-vrijdag hidden>Het is vandaag vrijdag.</p>
          <a href={waCouscous} class="rijs knop knop-krijt mt-9 whitespace-normal py-3 text-left leading-tight"><Icoon naam="wa" />Staat er vandaag couscous op het bord?</a>
          <figure class="rijs mt-14 max-w-md border-l-2 border-neon pl-6" style="--d:.1s">
            <blockquote class="text-lg leading-relaxed">“{r.esra.tekst}”</blockquote>
            <figcaption class="mt-3 text-sm text-zacht">{r.esra.naam} · Google</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-5">
          <figure class="rijs mx-auto max-w-sm">
            <Image src={thee} alt="Een gouden dienblad vol Marokkaanse theeglaasjes met gekleurde randjes" quality={74} widths={[360, 640]} sizes="(min-width: 1024px) 24rem, 90vw" class="aspect-[4/5] w-full rounded-t-full object-cover object-[50%_45%]" />
            <figcaption class="mt-3 text-sm text-zacht">Marokkaanse muntthee, in glaasjes</figcaption>
          </figure>

        </div>
      </div>
    </section>

    <!-- 5. KOFFIE & THEE: hun eigen drankjes, groot -->
    <section id="drinken" class="py-24 md:py-28">
      <div class="wrap">
        <div class="grid items-end gap-y-8 md:grid-cols-12 md:gap-x-10">
          <h2 class="rijs text-3xl md:col-span-7">Ook met havermelk</h2>
          <p class="rijs max-w-md text-lg text-grijs md:col-span-4 md:col-start-9">Cappuccino, chai, ijskoffie of matcha. En een brownie van het huis.</p>
        </div>
        <div class="mt-16 grid grid-cols-2 gap-x-4 gap-y-10 md:mt-20 md:grid-cols-12 md:gap-x-8">
          <figure class="rijs col-span-2 md:col-span-5 md:row-span-2">
            <Image src={cappuccino} alt="Een cappuccino met cacao in een kristallen glas, met een gemberkoekje op een schaaltje" quality={72} widths={[480, 760, 1000]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[4/5] w-full rounded-lg object-cover object-[50%_40%] md:aspect-auto md:h-full" />
            <figcaption class="mt-3 flex justify-between gap-4 text-sm text-grijs"><span class="font-kop text-lg text-tekst">Cappuccino</span><span>ook met havermelk</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-4" style="--d:.06s">
            <Image src={matcha} alt="Een gelaagde ijsmatcha met banaan en karamel in een hoog glas" quality={74} widths={[320, 640]} sizes="(min-width: 768px) 28vw, 50vw" class="aspect-[3/4] md:aspect-square w-full rounded-lg object-cover" />
            <figcaption class="mt-3 text-sm text-grijs"><span class="font-kop text-lg text-tekst">Banaan caramel matcha</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-3" style="--d:.12s">
            <Image src={mojito} alt="Een mojito met munt, sinaasappel en passievrucht in een kristallen glas" quality={72} widths={[320, 640]} sizes="(min-width: 768px) 22vw, 50vw" class="aspect-[3/4] md:aspect-[3/4] w-full rounded-lg object-cover object-[50%_45%]" />
            <figcaption class="mt-3 text-sm text-grijs"><span class="font-kop text-lg text-tekst">Mojito</span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-7" style="--d:.08s">
            <Image src={brownie} alt="Een punt walnotenbrownie met aardbei en blauwe bes op een gebloemd bordje" quality={74} widths={[480, 640]} sizes="(min-width: 768px) 52vw, 100vw" class="aspect-[16/10] w-full rounded-lg object-cover object-[50%_62%] md:aspect-[2/1]" />
            <figcaption class="mt-3 flex justify-between gap-4 text-sm text-grijs"><span class="font-kop text-lg text-tekst">Walnut brownie</span><span>homemade</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 6. REVIEWS: één grote stem, drie kleinere, zonder kaartjes -->
    <section class="op-blad bg-blad py-24 text-krijt md:py-28">
      <div class="wrap">
        <figure class="rijs max-w-4xl">
          <blockquote class="font-kop text-[clamp(1.75rem,2.6vw+1rem,3.25rem)] leading-[1.12]">“{r.rida.tekst}”</blockquote>
          <figcaption class="mt-6 text-sm text-zacht">{r.rida.naam} · Google</figcaption>
        </figure>
        <div class="mt-16 grid gap-x-12 gap-y-12 border-t border-lijn-blad pt-12 md:grid-cols-3">
          {[r.daphne, r.silvaSoep, r.hanane].map((x, i) => (
            <figure class="rijs" style={`--d:${i * 0.08}s`}>
              <blockquote class="text-lg leading-relaxed text-krijt/95">“{x.tekst}”</blockquote>
              <figcaption class="mt-4 text-sm text-zacht">{x.naam} · Google</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. BEZOEK: het gevelbord, tijden, adres -->
    <section id="bezoek" class="py-24 md:py-24">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <Image src={gevel} alt="Het gevelbord van Mirage, ontbijt en lunch, boven de glazen pui aan de Amsterdamsestraatweg" quality={72} widths={[480, 760, 1000, 1240]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[4/3] w-full rounded-lg object-cover object-[50%_40%]" />
        </figure>
        <div class="lg:col-span-6 lg:pt-4">
          <h2 class="rijs text-3xl">Kom langs</h2>
          <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2">
            <div class="rijs">
              <p class="text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
              <p class="mt-4"><a href={site.maps} class="link">Route plannen</a></p>
              <p class="mt-8 text-sm text-grijs" data-status-wrap><span data-status>Dinsdag t/m zondag 10.00 - 18.00 uur</span></p>
            </div>
            <table class="rijs w-full max-w-xs text-[1.0625rem]">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-semibold data-[vandaag]:text-petrol">
                    <th scope="row" class="py-2 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="rijs mt-12 border-t border-lijn pt-10">
            <p class="font-kop text-xl">Bestellen, een groep of een vraag?</p>
            <p class="mt-2 text-grijs">Stuur een berichtje of bel even.</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={waHoi} class="knop knop-petrol"><Icoon naam="wa" />WhatsApp</a>
              <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" />{site.tel}</a>
            </div>
            <p class="mt-6 text-sm text-grijs"><a href={site.instagram} class="link">@lunchroommirage</a> op Instagram</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { waMet } from '../data/site';
  // De kaart: tik gerechten aan, het lijstje en het WhatsApp-bericht passen zich aan.
  const gekozen: string[] = [];
  const lijst = document.querySelector<HTMLOListElement>('[data-lijst]')!;
  const leeg = document.querySelector<HTMLElement>('[data-leeg]')!;
  const stuur = document.querySelector<HTMLAnchorElement>('[data-stuur]')!;
  const tijd = document.querySelector<HTMLSelectElement>('[data-tijd]')!;
  const pers = document.querySelector<HTMLSelectElement>('[data-personen]')!;
  const persWrap = document.querySelector<HTMLElement>('[data-personen-wrap]')!;
  const mini = document.querySelector<HTMLElement>('[data-mini]')!;
  const miniTekst = document.querySelector<HTMLElement>('[data-mini-tekst]')!;
  let lijstZichtbaar = false;
  new IntersectionObserver(([e]) => { lijstZichtbaar = e.isIntersecting; mini.hidden = gekozen.length === 0 || lijstZichtbaar; }).observe(document.querySelector('#lijstje')!);
  const soort = () => (document.querySelector<HTMLInputElement>('input[name="soort"]:checked')?.value ?? 'afhalen');

  function bijwerken() {
    lijst.replaceChildren(...gekozen.map((g) => { const li = document.createElement('li'); li.className = 'flex gap-3'; li.innerHTML = '<span class="text-petrol" aria-hidden="true">·</span>'; li.append(g); return li; }));
    leeg.hidden = gekozen.length > 0;
    mini.hidden = gekozen.length === 0 || lijstZichtbaar;
    miniTekst.textContent = `${gekozen.length} op je lijstje`;
    const groep = soort() === 'groep';
    persWrap.hidden = !groep;
    const wat = gekozen.length ? `\n${gekozen.map((g) => `- ${g}`).join('\n')}` : ' …';
    const tekst = groep
      ? `Hoi Mirage! Wij willen graag op … met ${pers.value} personen komen eten, rond ${tijd.value} uur. Wat we lekker vinden:${wat}`
      : `Hoi Mirage! Ik wil graag afhalen rond ${tijd.value} uur:${wat}`;
    stuur.href = waMet(tekst);
  }
  document.querySelectorAll<HTMLButtonElement>('[data-gerecht]').forEach((b) => b.addEventListener('click', () => {
    const n = b.dataset.gerecht!; const i = gekozen.indexOf(n);
    if (i >= 0) gekozen.splice(i, 1); else gekozen.push(n);
    b.setAttribute('aria-pressed', String(i < 0));
    bijwerken();
  }));
  document.querySelectorAll('input[name="soort"]').forEach((x) => x.addEventListener('change', bijwerken));
  tijd.addEventListener('change', bijwerken); pers.addEventListener('change', bijwerken);
  bijwerken();
</script>
