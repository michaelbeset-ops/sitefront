---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="op-blad bg-blad pb-14 text-zacht md:pb-0">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-16">
    <div class="text-krijt md:col-span-5">
      <Merk klein />
      <p class="mt-6 max-w-xs text-zacht">Ontbijt en lunch aan de Amsterdamsestraatweg in Utrecht.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-kop text-lg text-krijt">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a> · <a href={site.instagram} class="link">Instagram</a></p>
    </div>
    <div class="md:col-span-4">
      <p class="font-kop text-lg text-krijt">Open</p>
      <p class="mt-4">Dinsdag t/m zondag 10.00 - 18.00 uur<br />Maandag gesloten</p>
      <p class="mt-3">{site.google.score} op Google, uit {site.google.aantal} reviews</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-blad py-7 text-xs">
    <p>© {jaar} {site.vol}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-neon">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-10 text-xs md:pb-8">Foto’s van jullie eigen Google-profiel en Instagram. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
