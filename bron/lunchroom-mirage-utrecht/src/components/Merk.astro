---
// Woordmerk naar hun gevelbord: MIRAGE in klassieke kapitalen, een streep links onder en ONTBIJT & LUNCH ernaast.
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="merk inline-flex flex-col no-underline">
  <span class={klein ? "text-[1.6rem]" : "text-[1.75rem] md:text-[2rem]"}>MIRAGE</span>
  <span class="mt-1 flex items-center gap-2">
    <span class="h-[2px] w-9 bg-current" aria-hidden="true"></span>
    <span class="text-[.6rem] tracking-[.12em] md:text-[.65rem]">ONTBIJT &amp; LUNCH</span>
  </span>
</a>
