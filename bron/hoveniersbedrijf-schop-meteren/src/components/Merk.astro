---
// Woordmerk naar hun eigen logo (schop uit hun logo, "D.SCHOP Hoveniersbedrijf"), strak hertekend.
import { url } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['merk', cls]}>
  <span class="merk-teken" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.5 3h5M12 3v9" /><path d="M8 12h8v2.5a4 4 0 0 1-8 0Z" fill="currentColor" fill-opacity=".25" /><path d="M4 21c3-1.6 13-1.6 16 0" />
    </svg>
  </span>
  <span><b>D<i>.</i>Schop</b> <small>Hoveniersbedrijf</small></span>
</a>
