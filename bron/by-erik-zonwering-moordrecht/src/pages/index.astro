---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews } from '../data/site';

import hero from '../assets/knikarm-schuifpui.jpg';
import heroMobiel from '../assets/knikarm-schuifpui.jpg';
import screensGevel from '../assets/screens-gevel.jpg';
import screenZij from '../assets/screen-zijgevel.jpg';
import knikarmTuin from '../assets/knikarm-tuin.jpg';
import rolAchter from '../assets/rolluiken-achtergevel.jpg';
import rolDruif from '../assets/rolluik-druif.jpg';
import rolDakkapel from '../assets/rolluik-dakkapel.jpg';
import rolWit from '../assets/rolluik-wit.jpg';
import erik from '../assets/erik.jpg';
import erikPolder from '../assets/erik-polder.jpg';

const titel = 'BY ERIK Zonwering | Knikarmschermen, screens, rolluiken en horren uit Moordrecht';
const omschrijving = 'BY ERIK Zonwering uit Moordrecht levert en monteert knikarmschermen, screens, rolluiken, overkappingen en horren. Vrijblijvend advies bij u op locatie.';

// Hero: hun knikarmscherm boven de schuifpui; op mobiel kleinere bestanden en een snede op het scherm.
const hD = await getImage({ src: hero, widths: [960, 1280, 1600], sizes: '100vw', format: 'webp', quality: 64 });
const hM = await getImage({ src: heroMobiel, widths: [760, 1100], sizes: '290vw', format: 'webp', quality: 52 });

// Offerte: alleen producten van hun eigen site. Breedtes per model letterlijk van by-erik.nl.
const producten = [
  { w: 'knikarmscherm', t: 'Knikarmscherm', max: 1350 },
  { w: 'screens', t: 'Screens', max: 0 },
  { w: 'rolluiken', t: 'Rolluiken', max: 0 },
  { w: 'uitvalscherm', t: 'Uitvalscherm', max: 2300 },
  { w: 'pergolazonwering', t: 'Pergolazonwering', max: 0 },
  { w: 'overkapping', t: 'Overkapping', max: 1600 },
  { w: 'horren', t: 'Horren', max: 0 },
];
const plekken = ['de achtergevel', 'de voorgevel', 'de dakkapel', 'het balkon', 'de schuifpui of deur', 'het terras'];
const [stephan, ...rest] = reviews;
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. Opening: hun eigen knikarmscherm, schermvullend -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-nacht text-wit">
      <picture>
        <source media="(min-width: 768px)" srcset={hD.srcSet.attribute} sizes="100vw" type="image/webp" />
        <source srcset={hM.srcSet.attribute} sizes="290vw" type="image/webp" />
        <img src={hD.src} alt="Lichtgrijs knikarmscherm uitgerold boven een schuifpui met hordeur, naast een gevel met klimop" width="1600" height="1200" fetchpriority="high" loading="eager" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover object-[30%_50%] md:object-[50%_45%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1d212300_28%,#1d2123b8_60%,#1d2123f2_100%)] md:bg-[linear-gradient(90deg,#1d2123e6_0%,#1d2123a8_38%,#1d212330_64%,#1d212300_82%),linear-gradient(0deg,#1d2123a6_0%,#1d212300_40%)]" aria-hidden="true"></div>
      <div class="wrap pb-28 pt-32 md:pb-16 lg:pb-20">
        <p class="staander text-[1.0625rem] font-[560] text-wit/85">Zonwering uit Moordrecht</p>
        <h1 class="mt-6 max-w-[13ch] text-hero font-[680]">Een eerlijk verhaal, een eerlijke offerte.</h1>
        <p class="mt-7 max-w-[34rem] text-lg text-wit/90 md:text-xl">Knikarmschermen, screens, rolluiken, overkappingen en horren. Erik komt vrijblijvend bij u langs en adviseert op locatie.</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#offerte" class="knop knop-wit">Vraag een offerte aan<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-lijn num max-sm:hidden"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
      <p class="absolute bottom-16 right-10 hidden max-w-[14rem] text-right text-xs leading-snug text-wit/70 md:block">Knikarmscherm boven de schuifpui.</p>
    </section>

    <!-- 2. Aanbod: drie producten groot met hun eigen foto's, de rest als lijst -->
    <section id="aanbod" class="pb-24 pt-20 md:pb-32 md:pt-28" aria-labelledby="aanbod-titel">
      <div class="wrap grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
        <h2 id="aanbod-titel" class="rijs text-3xl lg:col-span-7">Voor iedere gevel een passende keuze.</h2>
        <p class="rijs max-w-md self-end text-lg text-grijs lg:col-span-4 lg:col-start-9">Een moderne woning vraagt een strak design, een karakteristiek pand iets klassiekers. Erik kijkt samen met u wat het beste past.</p>
      </div>

      <!-- Screens -->
      <article class="wrap mt-14 grid gap-y-8 md:mt-20 lg:grid-cols-12 lg:gap-x-12" aria-labelledby="p-screens">
        <div class="grid grid-cols-[1.3fr_1fr] items-end gap-3 md:gap-5 lg:col-span-7">
          <div class="lamel rounded-sm"><Image src={screensGevel} alt="Drie donkere screens voor de ramen van een bakstenen gevel met een dakkapel erboven" widths={[400, 640, 900]} sizes="(min-width: 1024px) 34vw, 56vw" class="aspect-[3/4] w-full object-cover" /></div>
          <div class="lamel rounded-sm" style="--d:.15s"><Image src={screenZij} alt="Screen voor een raam op de verdieping van een bakstenen woning, in de winterzon" widths={[320, 480, 640]} sizes="(min-width: 1024px) 26vw, 42vw" class="aspect-[4/5] w-full object-cover" /></div>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:self-center">
          <h3 id="p-screens" class="rijs text-[clamp(2rem,2.4vw+1rem,3rem)]">Screens</h3>
          <p class="rijs mt-4 text-lg">De zon buiten houden, maar toch zicht en lichtinval behouden.</p>
          <p class="rijs staander mt-6 text-grijs">Ritsscreens, windvast op iedere hoogte. Ook als verduistering, met 1% doeken.</p>
          <button type="button" data-kies="screens" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-[680]">Offerte voor screens<Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
      </article>

      <!-- Rolluiken -->
      <article class="mt-20 md:mt-28" aria-labelledby="p-rolluiken">
        <div class="lamel mx-auto max-w-[96rem] md:px-10"><Image src={rolAchter} alt="Twee antraciet rolluiken voor de slaapkamerramen van een rijtjeswoning, de tuindeuren eronder open" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1536px) 1456px, 100vw" class="aspect-[16/10] w-full object-cover object-[50%_40%] md:aspect-[21/9] md:rounded-sm" /></div>
        <div class="wrap mt-10 grid gap-y-8 lg:grid-cols-12 lg:gap-x-12">
          <div class="lg:col-span-5">
            <h3 id="p-rolluiken" class="rijs text-[clamp(2rem,2.4vw+1rem,3rem)]">Rolluiken</h3>
            <p class="rijs mt-4 text-lg">Donker slapen, inbraak lastiger maken of zon en geluid weren.</p>
            <p class="rijs staander mt-6 text-grijs">Kast en lamel in diverse RAL-kleuren. Bediening met een schakelaar, de afstandsbediening of uw smartphone.</p>
            <button type="button" data-kies="rolluiken" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-[680]">Offerte voor rolluiken<Icoon naam="pijl" class="h-4 w-4" /></button>
          </div>
          <div class="grid grid-cols-3 gap-3 md:gap-5 lg:col-span-6 lg:col-start-7">
            <div class="lamel rounded-sm"><Image src={rolDruif} alt="Antraciet rolluik voor een raam, met een druivenrank langs de gevel" widths={[240, 400, 560]} sizes="(min-width: 1024px) 15vw, 31vw" class="aspect-[3/4] w-full object-cover" /></div>
            <div class="lamel rounded-sm" style="--d:.12s"><Image src={rolDakkapel} alt="Rolluik voor het raam van een dakkapel, met blauwe lucht" widths={[240, 400, 560]} sizes="(min-width: 1024px) 15vw, 31vw" class="aspect-[3/4] w-full object-cover" /></div>
            <div class="lamel rounded-sm" style="--d:.24s"><Image src={rolWit} alt="Wit rolluik half neergelaten voor een raam in een bakstenen gevel" widths={[240, 400, 560]} sizes="(min-width: 1024px) 15vw, 31vw" class="aspect-[3/4] w-full object-cover" /></div>
          </div>
        </div>
      </article>

      <!-- Knikarmschermen -->
      <article class="wrap mt-20 grid gap-y-8 md:mt-28 lg:grid-cols-12 lg:gap-x-12" aria-labelledby="p-knikarm">
        <div class="lg:order-2 lg:col-span-6 lg:col-start-7">
          <div class="lamel rounded-sm"><Image src={knikarmTuin} alt="Twee uitgerolde knikarmschermen naast elkaar boven de terrassen van een rij woningen" widths={[400, 640]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-square w-full object-cover" /></div>
        </div>
        <div class="lg:col-span-5 lg:self-center">
          <h3 id="p-knikarm" class="rijs text-[clamp(2rem,2.4vw+1rem,3rem)]">Knikarmschermen</h3>
          <p class="rijs mt-4 text-lg">Een verlengstuk van uw woning. Overdag schaduw in de woonkamer, 's avonds lang buiten op het terras.</p>
          <p class="rijs staander mt-6 text-grijs">Vier modellen van SunCircle, het grootste tot 13,5 meter breed en 3,5 meter uitval. Doeken in talloze kleuren en dessins.</p>
          <button type="button" data-kies="knikarmscherm" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-[680]">Offerte voor een knikarmscherm<Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
      </article>

      <!-- De rest van het aanbod: typografisch, zonder foto's die niet van hen zijn -->
      <div class="wrap mt-20 md:mt-28">
        <h3 class="rijs text-2xl">Verder levert en monteert BY ERIK</h3>
        <dl class="mt-8 border-t border-lijn">
          {[
            ['Uitvalschermen', 'Ronde of vierkante cassette, tot 23 meter breed.', 'uitvalscherm'],
            ['Pergolazonwering', 'Op slanke palen, minder belasting op de gevel.', 'pergolazonwering'],
            ['Overkappingen', 'Aluminium, op maat, met waterdicht doek.', 'overkapping'],
            ['Horren', 'Van plissé hordeur tot raamrolhor, op maat van Unilux.', 'horren'],
          ].map(([n, z, k], i) => (
            <div class="rijs grid items-baseline gap-x-8 gap-y-1 border-b border-lijn py-6 md:grid-cols-12" style={`--d:${i * .06}s`}>
              <dt class="text-[clamp(1.5rem,1.6vw+1rem,2.25rem)] font-[680] tracking-[-0.02em] md:col-span-5">{n}</dt>
              <dd class="text-grijs md:col-span-5">{z}</dd>
              <dd class="md:col-span-2 md:text-right"><button type="button" data-kies={k} class="link inline-flex min-h-11 items-center gap-2 font-[680]">Offerte<Icoon naam="pijl" class="h-4 w-4" /></button></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 3. Erik en het eerlijke verhaal -->
    <section id="erik" class="bg-nacht py-24 text-wit md:py-32" aria-labelledby="erik-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <div class="lamel rounded-sm"><Image src={erik} alt="Erik, eigenaar van BY ERIK Zonwering" widths={[360, 480, 600]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[4/5] w-full object-cover object-[50%_30%]" /></div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-6">
          <h2 id="erik-titel" class="rijs text-3xl">Aangenaam. Ik ben Erik.</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-mist">BY ERIK is een eenmanszaak. Samen met toeleveranciers, producenten en monteurs zorgt Erik dat u meer dan tevreden achterblijft.</p>
          <p class="rijs mt-14 text-mist">BY ERIK staat voor een</p>
          <ul class="mt-4 space-y-1 text-[clamp(1.75rem,3vw+.6rem,3.25rem)] font-[600] leading-[1.12] tracking-[-0.025em]">
            <li class="rijs">eerlijk verhaal,</li>
            <li class="rijs" style="--d:.08s">eerlijk vrijblijvend advies,</li>
            <li class="rijs" style="--d:.16s">eerlijk product van Neerlands fabrikaat</li>
            <li class="rijs" style="--d:.24s">en een eerlijke offerte.</li>
          </ul>
          <figure class="rijs mt-14 flex items-center gap-5">
            <Image src={erikPolder} alt="Erik op de rug gezien in een jas met het BY ERIK-logo, op een besneeuwde polder" widths={[160, 240]} sizes="7rem" class="h-28 w-28 flex-none rounded-sm object-cover" />
            <figcaption class="text-sm text-mist">Merken die Erik levert: SunCircle, Unilux en Dickson.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 4. Hoe werkt BY ERIK -->
    <section id="werkwijze" class="py-24 md:py-32" aria-labelledby="werk-titel">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <h2 id="werk-titel" class="rijs text-3xl">Hoe werkt BY ERIK</h2>
            <p class="rijs mt-5 max-w-sm text-lg text-grijs">Voor uw woning, bedrijfspand of VvE.</p>
          </div>
        </div>
        <ol class="lg:col-span-7 lg:col-start-6">
          {[
            ['U neemt contact op', 'Per telefoon of mail. Vertel globaal wat u wilt.'],
            ['Erik komt langs', 'Een oriëntatiegesprek bij u op locatie. Hij neemt de maten op, laat kleurstalen zien en bekijkt hoe er gemonteerd kan worden.'],
            ['Uw offerte', 'Meestal binnen een week, passend bij wat u besproken heeft.'],
            ['De order', 'Gaat u akkoord, dan gaat de order naar de leverancier. Zodra de leverdatum bekend is, plant u samen de montage.'],
            ['De montage', 'Door zelfstandige, zeer ervaren monteurs met wie BY ERIK al jaren werkt. Daarna kunt u gaan genieten.'],
          ].map(([k, t], i) => (
            <li class="rijs grid grid-cols-[3.25rem_1fr] gap-x-4 border-t border-lijn py-8 md:grid-cols-[5rem_1fr]" style={`--d:${i * .05}s`}>
              <span class="num text-[1.75rem] font-[300] leading-none text-grijs md:text-[2.5rem]">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-[clamp(1.4rem,1.2vw+1rem,1.875rem)] font-[680]">{k}</h3>
                <p class="mt-2 max-w-xl text-grijs">{t}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. Reviews, letterlijk van Google -->
    <section id="reviews" class="bg-steen py-24 md:py-32" aria-labelledby="rev-titel">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="rev-titel" class="rijs text-3xl">Wat klanten zeggen</h2>
          <p class="rijs inline-flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-5 w-5" /><span class="num font-[700] text-inkt">{site.google.score}</span> op Google, {site.google.aantal} reviews</p>
        </div>
        <figure class="rijs mt-14 max-w-5xl">
          <blockquote class="text-[clamp(1.6rem,2.4vw+.8rem,3rem)] font-[560] leading-[1.18] tracking-[-0.02em]">"{stephan.tekst}"</blockquote>
          <figcaption class="mt-6 text-grijs">{stephan.naam}, Google review</figcaption>
        </figure>
        <div class="mt-16 grid gap-x-12 gap-y-10 border-t border-lijn pt-12 md:grid-cols-2 lg:grid-cols-3">
          {rest.slice(0, 3).map((r, i) => (
            <figure class="rijs" style={`--d:${i * .08}s`}>
              <p class="flex gap-0.5 text-antraciet" role="img" aria-label="5 sterren">{[0, 1, 2, 3, 4].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</p>
              <blockquote class="mt-4 text-lg">"{r.tekst}"</blockquote>
              <figcaption class="mt-4 text-sm text-grijs">{r.naam}, Google review</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Offerte: het maatbriefje, eindigt in WhatsApp -->
    <section id="offerte" class="py-24 md:py-32" aria-labelledby="off-titel">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2 id="off-titel" class="rijs text-3xl">Offerte aanvragen</h2>
          <p class="rijs mt-5 max-w-sm text-lg text-grijs">Vertel zo veel mogelijk, dan kan Erik zich goed voorbereiden. Een foto van de plek helpt.</p>
          <div class="rijs mt-10 space-y-2 text-[1.0625rem]">
            <p><a href={site.telHref} class="link num font-[680]">{site.tel}</a></p>
            <p><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
            <p class="text-grijs">Telefonisch bereikbaar maandag t/m vrijdag, <span class="num">8:00 - 17:00</span>.</p>
          </div>
        </div>

        <form class="rijs min-w-0 rounded-md bg-wit p-5 sm:p-6 shadow-[0_1px_0_var(--color-lijn),0_20px_50px_-30px_#1d212340] md:p-10 lg:col-span-7 lg:col-start-6" data-briefje onsubmit="return false" novalidate>
          <div class="grid gap-6 md:grid-cols-2">
            <label class="block">
              <span class="text-sm font-[680]">Wat zoekt u?</span>
              <select class="veld mt-2" data-product>
                {producten.map((p) => <option value={p.w} data-max={p.max}>{p.t}</option>)}
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-[680]">Waar?</span>
              <select class="veld mt-2" data-plek>
                {plekken.map((p) => <option value={p}>{p.replace(/^(de|het) /, '').replace(/^./, (c) => c.toUpperCase())}</option>)}
              </select>
            </label>
          </div>

          <label class="mt-8 block">
            <span class="flex items-baseline justify-between gap-4 text-sm font-[680]"><span>Breedte, ongeveer</span><output class="num text-grijs" data-meter>4,00 m</output></span>
            <input type="range" min="50" max="1600" step="10" value="400" class="mt-4 w-full accent-[var(--color-antraciet)]" data-breed aria-describedby="maat-hint" />
            <span class="lint mt-1 block h-3 text-antraciet/50" aria-hidden="true"></span>
            <span id="maat-hint" class="mt-3 block min-h-[1.6em] text-sm text-grijs" data-hint></span>
          </label>

          <div class="mt-6 grid gap-6 md:grid-cols-2">
            <label class="block">
              <span class="text-sm font-[680]">Uw naam</span>
              <input type="text" class="veld mt-2" autocomplete="name" data-naam />
            </label>
            <label class="block">
              <span class="text-sm font-[680]">Woonplaats</span>
              <input type="text" class="veld mt-2" autocomplete="address-level2" data-plaats />
            </label>
          </div>

          <label class="mt-6 flex min-h-11 cursor-pointer items-center gap-3">
            <input type="checkbox" class="h-5 w-5 accent-[var(--color-antraciet)]" checked data-foto />
            <span>Ik stuur een foto van de plek mee</span>
          </label>

          <div class="mt-8 rounded-sm bg-papier p-5">
            <p class="text-xs font-[680] text-grijs">Uw WhatsApp-bericht</p>
            <p class="mt-2 whitespace-pre-line" data-voorbeeld aria-live="polite"></p>
          </div>
          <a href={site.wa} class="knop mt-6 w-full sm:w-auto" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-briefje]');
  if (f) {
    const $ = <T extends Element>(s: string) => f.querySelector<T>(s)!;
    const product = $<HTMLSelectElement>('[data-product]');
    const plek = $<HTMLSelectElement>('[data-plek]');
    const breed = $<HTMLInputElement>('[data-breed]');
    const meter = $<HTMLOutputElement>('[data-meter]');
    const hint = $<HTMLElement>('[data-hint]');
    const naam = $<HTMLInputElement>('[data-naam]');
    const plaats = $<HTMLInputElement>('[data-plaats]');
    const foto = $<HTMLInputElement>('[data-foto]');
    const voorbeeld = $<HTMLElement>('[data-voorbeeld]');
    const stuur = $<HTMLAnchorElement>('[data-stuur]');
    const m = (cm: number) => (cm / 100).toFixed(2).replace('.', ',') + ' m';
    const lidwoord: Record<string, string> = { knikarmscherm: 'een knikarmscherm', screens: 'screens', rolluiken: 'rolluiken', uitvalscherm: 'een uitvalscherm', pergolazonwering: 'pergolazonwering', overkapping: 'een overkapping', horren: 'horren' };
    // Hints met de grootste breedtes die op by-erik.nl staan.
    const tips: Record<string, (cm: number) => string> = {
      knikarmscherm: (cm) => cm <= 550 ? 'Tot 5,5 m breed kan met alle vier de knikarmmodellen.' : cm <= 1350 ? 'Breder dan 5,5 m: de HZ-D3400 gaat tot 13,5 m.' : 'Breder dan 13,5 m? Erik denkt met u mee.',
      uitvalscherm: () => 'Uitvalschermen tot 23 m breed.',
      overkapping: (cm) => cm <= 1200 ? 'De BT 128 gaat tot 12 m breed, de BT 230 tot 16 m.' : 'De BT 230 gaat tot 16 m breed.',
    };
    const zet = () => {
      const cm = +breed.value;
      meter.value = m(cm);
      breed.style.setProperty('--p', String(cm));
      hint.textContent = tips[product.value]?.(cm) ?? '';
      const regels = [
        `Hallo Erik, ik wil graag een offerte voor ${lidwoord[product.value]} bij ${plek.value}.`,
        `De breedte is ongeveer ${m(cm)}.`,
        foto.checked ? 'Ik stuur een foto van de plek mee.' : '',
        plaats.value.trim() ? `Ik woon in ${plaats.value.trim()}.` : '',
        naam.value.trim() ? `Groet, ${naam.value.trim()}` : '',
      ].filter(Boolean);
      const tekst = regels.join('\n');
      voorbeeld.textContent = tekst;
      stuur.href = `https://wa.me/31655142150?text=${encodeURIComponent(tekst)}`;
    };
    f.addEventListener('input', zet);
    f.addEventListener('change', zet);
    zet();
    document.querySelectorAll<HTMLElement>('[data-kies]').forEach((b) => b.addEventListener('click', () => {
      product.value = b.dataset.kies!;
      zet();
      document.getElementById('offerte')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      setTimeout(() => product.focus({ preventScroll: true }), 600);
    }));
  }
</script>
