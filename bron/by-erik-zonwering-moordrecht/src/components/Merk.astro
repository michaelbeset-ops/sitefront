---
// Woordmerk nagetekend naar hun eigen logo: twee open cassettes (het D|D-teken), een dunne staander,
// BY licht en ERIK donker, eronder ZONWERING in wijde kapitalen.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['merk group inline-flex items-center gap-3 no-underline', licht ? 'text-wit' : 'text-inkt', cls]} aria-label="BY ERIK Zonwering">
  <svg viewBox="0 0 30 40" class="h-9 w-auto flex-none" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4">
    <path d="M1 2.5h10.5a6.3 6.3 0 0 1 0 12.6H1" class="opacity-60" />
    <path d="M1 24.9h10.5a6.3 6.3 0 0 1 0 12.6H1" class="opacity-60" />
    <path d="M27 1v38" class="opacity-60" stroke-width="2" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="text-[1.45rem] tracking-[.06em]"><span class="font-[350] opacity-70">BY</span><span class="font-[680]">ERIK</span></span>
    <span class="mt-1 text-[.62rem] font-[560] tracking-[.5em]">ZONWERING</span>
  </span>
</a>
