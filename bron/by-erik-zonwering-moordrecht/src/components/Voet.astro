---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const aanbod = ['Knikarmschermen', 'Screens', 'Rolluiken', 'Uitvalschermen', 'Pergolazonwering', 'Overkappingen', 'Horren'];
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Zonwering, overkappingen en horren voor uw woning of bedrijfspand. Vrijblijvend advies bij u op locatie.</p>
      <p class="mt-5">
        <a href={site.instagram} class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-lijn-licht text-wit transition-colors hover:border-wit" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="md:col-span-3">
      <p class="font-[700] text-wit">Aanbod</p>
      <ul class="mt-3 space-y-1">{aanbod.map((p) => <li><a href={url('#aanbod')} class="no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-[700] text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-4">{site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-[700] text-wit">Bereikbaar</p>
      <p class="mt-3">Maandag t/m vrijdag<br /><span class="num">8:00 - 17:00</span></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam} · KvK <span class="num">{site.kvk}</span></p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's komen van jullie eigen Google-profiel, Instagram en by-erik.nl. Teksten uit by-erik.nl en Instagram, reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
