---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Stempel from '../components/Stempel.astro';
import { site, categorieen, materialen, plaatsen, reviews, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import wandkast from '../assets/wandkast-eiken.jpg';
import bed from '../assets/bed-douglas.jpg';
import cinewall from '../assets/cinewall.jpg';
import tafel from '../assets/tafel-steiger.jpg';
import buitenkeuken from '../assets/buitenkeuken.jpg';
import wandplank from '../assets/wandplank.jpg';
import balie from '../assets/balie.jpg';
import personeelskeuken from '../assets/personeelskeuken.jpg';
import stefan from '../assets/stefan.jpg';

const titel = 'Stefig maatwerk in hout | Meubels op maat uit Dordrecht';
const omschrijving = 'Kasten, cinewalls, tafels en meubels op maat van Stefan Oostveen, gemaakt in zijn eigen werkplaats in Dordrecht. Voor particulier en zakelijk.';
const [wendy, sjoerd, vincent] = reviews.los;
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: hun wandkast van eikenfineer met nis, gemonteerd in Dordrecht -->
    <section class="relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col justify-end overflow-hidden bg-inkt text-wit md:min-h-[calc(100svh-5rem)]">
      <Image src={hero} alt="Een wandkast van eikenfineer over de volle breedte van een kamer, met een raam erin opgenomen en een verlichte nis met spots" quality={74} widths={[480, 720, 960, 1280, 1680]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[74%_50%] md:object-[50%_45%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1b1a1826_0%,#1b1a1859_30%,#1b1a18cc_58%,#1b1a18f2_100%)] lg:bg-[linear-gradient(90deg,#1b1a18e6_0%,#1b1a18b3_32%,#1b1a1840_58%,#1b1a1800_80%),linear-gradient(0deg,#1b1a18b3_0%,#1b1a1800_40%)]" aria-hidden="true"></div>
      <div class="wrap grid items-end gap-y-10 pb-28 pt-28 md:pb-16 lg:grid-cols-12 lg:pb-20">
        <div class="lg:col-span-8">
          <p class="text-sm font-semibold text-wit/80">Meubelmakerij in Dordrecht</p>
          <h1 class="mt-5 max-w-[15ch] text-hero">Wat niet in de winkel staat, maakt Stefan.</h1>
          <p class="mt-7 max-w-[33rem] text-lg text-wit/90">Kasten, tafels en meubels op maat uit een eigen werkplaats in Dordrecht. Voor thuis en voor de zaak.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#maatwerk" class="knop">Stuur uw idee<Icoon naam="pijl" /></a>
            <a href="#werk" class="knop knop-lijn">Bekijk het werk</a>
          </div>
        </div>
        <p class="hidden justify-self-end text-right text-sm text-wit/80 lg:col-span-4 lg:block">
          <span class="stempel stempel-licht">Gemonteerd in Dordrecht</span><br />
          <span class="mt-2 inline-block">Wandkast van eikenfineer met nis</span>
        </p>
      </div>
    </section>

    <!-- 2. WERK: hun eigen foto's, met hun eigen beschrijving als stempelregel -->
    <section id="werk" class="py-20 md:py-24" aria-labelledby="werk-titel">
      <div class="wrap">
        <div class="grid gap-y-5 lg:grid-cols-12 lg:gap-x-12">
          <h2 id="werk-titel" class="rijs text-3xl lg:col-span-6">Elk stuk voor één plek</h2>
          <p class="rijs max-w-md self-end text-lg text-grijs lg:col-span-5 lg:col-start-8">Gemaakt in de werkplaats en geplaatst bij de klant. Onder elke foto staat waar.</p>
        </div>

        <div class="mt-12 grid grid-cols-2 gap-x-3 gap-y-8 md:mt-16 md:grid-cols-12 md:gap-x-5 md:gap-y-10">
          <figure class="rijs col-span-2 md:col-span-5 md:row-span-2">
            <Image src={wandkast} alt="Een open wandkast van eikenfineer met vakken in verschillende maten rond een televisie, met dichte kastjes eronder" quality={70} widths={[360, 480, 720, 960]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[46rem]" />
            <figcaption class="bijschrift"><span class="text-inkt">Wandkast van eikenfineer met nis</span><span class="stempel">Barendrecht</span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-7" style="--d:.08s">
            <Image src={bed} alt="Close-up van een bed van massieve douglas balken, de jaarringen zichtbaar op de kopse kant" quality={70} widths={[360, 480, 720, 960, 1200]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[3/2] w-full rounded-sm object-cover md:aspect-auto md:h-[21.5rem]" />
            <figcaption class="bijschrift"><span class="text-inkt">Bed van robuuste massieve douglas balken</span><span class="stempel">Ridderkerk</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-4" style="--d:.12s">
            <Image src={cinewall} alt="Een cinewall in marmerlook met televisie, sfeerhaard en verlichte glazen nissen aan beide kanten" quality={70} widths={[360, 560, 760]} sizes="(min-width: 768px) 32vw, 50vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[19.5rem]" />
            <figcaption class="bijschrift"><span class="text-inkt">Cinewall van marmerlook plaat</span><span class="stempel">Terneuzen</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-3" style="--d:.18s">
            <Image src={tafel} alt="Het blad van een eettafel van oud steigerhout, van dichtbij langs de planken gezien" quality={70} widths={[300, 450, 600]} sizes="(min-width: 768px) 24vw, 50vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[19.5rem]" />
            <figcaption class="bijschrift"><span class="text-inkt">Eettafel van steigerhout</span><span class="stempel">Utrecht</span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-7">
            <Image src={buitenkeuken} alt="Een buitenkeuken van steigerhout met zwarte scharnieren, een gasbarbecue en een groene kamado onder een houten overkapping" quality={70} widths={[360, 480, 720, 960, 1200]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-[27rem]" />
            <figcaption class="bijschrift"><span class="text-inkt">Buitenkeuken van steigerhout, met spoelbak, bbq en Green Egg</span><span class="stempel">Barendrecht</span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-5" style="--d:.08s">
            <Image src={wandplank} alt="Een zwevende wandplank van massief eiken met een ruwe boomkant, van dichtbij" quality={70} widths={[360, 480, 720, 960]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-[27rem]" />
            <figcaption class="bijschrift"><span class="text-inkt">Zwevende wandplank van massief eiken met robuuste kant</span><span class="stempel">Ridderkerk</span></figcaption>
          </figure>
        </div>

        <div class="rijs mt-16 grid gap-y-5 border-t border-lijn pt-10 md:mt-20 lg:grid-cols-12 lg:gap-x-12">
          <h3 class="text-2xl lg:col-span-3">Ook op maat</h3>
          <div class="lg:col-span-9">
            <p class="kop text-lg leading-relaxed text-inkt md:text-2xl md:leading-relaxed">
              {categorieen.map((c, i) => <>{c}{i < categorieen.length - 1 && <span class="mx-2 text-rood" aria-hidden="true">/</span>}{' '}</>)}
            </p>
            <p class="mt-5 max-w-xl text-grijs">Vraag gerust naar de mogelijkheden als u niet kunt vinden wat u zoekt.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. ZAKELIJK: balie en personeelskeuken, met de namen die ze zelf bij hun foto's zetten -->
    <section id="zakelijk" class="bg-inkt py-20 text-wit md:py-24" aria-labelledby="zak-titel">
      <div class="wrap">
        <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-12">
          <figure class="rijs lg:col-span-8">
            <Image src={balie} alt="Een ronde ontvangstbalie met eiken front en wit blad in een lichte hal, met een zwart scherm en een rond venster ernaast" quality={70} widths={[360, 480, 720, 960, 1200]} sizes="(min-width: 1024px) 62vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover lg:aspect-auto lg:h-[38rem]" />
            <figcaption class="bijschrift !text-mist"><span class="text-wit">Balie voor woningcorporatie Trivire</span><span class="stempel stempel-licht">Dordrecht</span></figcaption>
          </figure>
          <div class="flex flex-col lg:col-span-4">
            <h2 id="zak-titel" class="rijs text-3xl">Ook voor de zaak</h2>
            <p class="rijs mt-6 text-lg text-mist">Stefig helpt u graag bij het inrichten van uw winkel of bedrijf.</p>
            <ul class="rijs mt-8 border-t border-lijn-licht text-[.9375rem]">
              <li class="flex flex-wrap justify-between gap-x-4 border-b border-lijn-licht py-3"><span>Toonbank voor kledingwinkel bij Keesje</span><span class="text-mist">Barendrecht</span></li>
              <li class="flex flex-wrap justify-between gap-x-4 border-b border-lijn-licht py-3"><span>Toonbank en displaykast voor Beautiful Meerssen</span><span class="text-mist">Meerssen</span></li>
              <li class="flex flex-wrap justify-between gap-x-4 border-b border-lijn-licht py-3"><span>Personeelskeuken voor Avedko B.V.</span><span class="text-mist">Dordrecht</span></li>
            </ul>
            <figure class="rijs mt-10 lg:mt-auto">
              <Image src={personeelskeuken} alt="Een personeelskeuken met een lang gebogen kookeiland, groene tegels, rode barkrukken en een neonletter aan de wand" quality={70} widths={[360, 560, 760]} sizes="(min-width: 1024px) 30vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
              <figcaption class="bijschrift !text-mist"><span class="text-wit">Personeelskeuken voor Avedko B.V.</span></figcaption>
            </figure>
            <a href={waMet('Hallo Stefan, ik heb een zakelijke aanvraag voor maatwerk in hout.')} class="rijs knop mt-8 w-full sm:w-fit"><Icoon naam="wa" />Zakelijke aanvraag</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. WERKPLAATS: Stefan zelf, zijn verhaal in het kort -->
    <section id="werkplaats" class="relative overflow-hidden py-20 md:py-24" aria-labelledby="wp-titel">
      <Stempel class="pointer-events-none absolute -right-24 -top-16 hidden h-[26rem] w-[26rem] rotate-12 text-inkt/[.06] lg:block" band="transparent" id="groot" />
      <div class="wrap relative grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={stefan} alt="Stefan Oostveen staat naast een cinewall in marmerlook die hij heeft gemaakt" quality={78} widths={[400, 600, 768]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-top" />
        </figure>
        <div class="flex flex-col lg:col-span-6 lg:col-start-7 lg:pt-6">
          <h2 id="wp-titel" class="rijs text-3xl">Stefan Oostveen, meubelmaker</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-grijs">Sinds 2006 in het vak, opgeleid bij het Hout en Meubilerings College in Rotterdam. Begin 2017 begon hij voor zichzelf. Nu werkt hij vanuit een loods van 200 m2 in Dordrecht.</p>
          <blockquote class="rijs mt-10 border-l-[3px] border-rood pl-6">
            <p class="kop text-2xl leading-snug">“Ik wilde dit ooit ook als eigen baas doen.”</p>
            <footer class="mt-2 text-sm text-grijs">Stefan, over zijn eerste jaren in een meubelmakerij</footer>
          </blockquote>
          <dl class="rijs mt-12 max-w-lg">
            <div class="spec"><dt class="font-semibold">Uw idee</dt><span aria-hidden="true"></span><dd class="text-grijs">eigen ontwerp, schets of foto</dd></div>
            <div class="spec"><dt class="font-semibold">Ontwerp en offerte</dt><span aria-hidden="true"></span><dd class="text-grijs">vrijblijvend</dd></div>
            <div class="spec"><dt class="font-semibold">Maken</dt><span aria-hidden="true"></span><dd class="text-grijs">in de werkplaats in Dordrecht</dd></div>
            <div class="spec"><dt class="font-semibold">Plaatsen</dt><span aria-hidden="true"></span><dd class="text-grijs">opgemeten en geplaatst bij u</dd></div>
            <div class="spec"><dt class="font-semibold">Langskomen</dt><span aria-hidden="true"></span><dd class="text-grijs">geen showroom, wel op afspraak</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 5. REVIEWS: letterlijk van Google -->
    <section id="reviews" class="border-t border-lijn bg-wit py-20 md:py-24" aria-labelledby="rev-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <h2 id="rev-titel" class="text-3xl">“Een echte vakman”</h2>
          <blockquote class="mt-10">
            <p class="kop text-2xl leading-snug md:text-[1.875rem] md:leading-snug">{reviews.groot.tekst}</p>
          </blockquote>
          <figcaption class="mt-5 text-sm text-grijs">{reviews.groot.naam} op Google</figcaption>
        </figure>
        <div class="space-y-10 lg:col-span-5 lg:col-start-8 lg:pt-4">
          {[wendy, sjoerd, vincent].map((x, i) => (
            <figure class="rijs border-b border-lijn pb-10" style={`--d:${i * 0.08}s`}>
              <div class="flex gap-0.5 text-rood" role="img" aria-label="5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
              <blockquote class="mt-3 text-lg leading-relaxed">{x.tekst}</blockquote>
              <figcaption class="mt-3 text-sm text-grijs">{x.naam} op Google</figcaption>
            </figure>
          ))}
          <p class="flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews · <a href={site.google.url} class="link">alle reviews</a></p>
        </div>
      </div>
    </section>

    <!-- 6. MAATWERK: het idee doorsturen, met een maatschets die meetekent -->
    <section id="maatwerk" class="bg-paneel-2 py-16 md:py-24" aria-labelledby="mw-titel">
      <div class="wrap">
        <form class="rijs grid overflow-hidden rounded-md border border-lijn bg-wit shadow-sm lg:grid-cols-12" data-intake>
          <div class="p-6 sm:p-10 lg:col-span-7 lg:p-12">
            <h2 id="mw-titel" class="text-3xl">Stuur uw idee</h2>
            <p class="mt-4 max-w-md text-grijs">Vul in wat u al weet. Stefan denkt mee en maakt een vrijblijvende offerte.</p>

            <div class="mt-9 grid gap-x-8 gap-y-8">
              <label class="block">
                <span class="text-sm font-semibold text-grijs">Wat wilt u laten maken?</span>
                <select class="veld" name="soort">
                  {categorieen.map((c, i) => <option value={c} selected={c === 'Wandkasten'}>{c}</option>)}
                  <option value="Iets anders">Iets anders</option>
                </select>
              </label>
              <fieldset>
                <legend class="text-sm font-semibold text-grijs">Hout of afwerking</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  {materialen.map((m, i) => <label><input type="radio" name="hout" value={m} checked={i === 0} class="peer sr-only" /><span class="keus">{m}</span></label>)}
                </div>
              </fieldset>
              <div>
                <p class="text-sm font-semibold text-grijs" id="maat-label">Ongeveer hoe groot? (cm)</p>
                <div class="mt-1 grid grid-cols-[1fr_auto_1fr_auto_1fr] items-end gap-3" role="group" aria-labelledby="maat-label">
                  <label class="block"><span class="sr-only">Breedte in cm</span><input class="veld num" type="number" inputmode="numeric" min="10" max="2000" name="b" placeholder="breed" /></label>
                  <span class="kop pb-3 text-grijs" aria-hidden="true">x</span>
                  <label class="block"><span class="sr-only">Hoogte in cm</span><input class="veld num" type="number" inputmode="numeric" min="10" max="600" name="h" placeholder="hoog" /></label>
                  <span class="kop pb-3 text-grijs" aria-hidden="true">x</span>
                  <label class="block"><span class="sr-only">Diepte in cm</span><input class="veld num" type="number" inputmode="numeric" min="5" max="300" name="d" placeholder="diep" /></label>
                </div>
              </div>
              <label class="block">
                <span class="text-sm font-semibold text-grijs">In welke plaats?</span>
                <input class="veld" type="text" name="plaats" autocomplete="address-level2" placeholder="bijvoorbeeld Dordrecht" />
              </label>
            </div>
          </div>

          <div class="flex flex-col bg-inkt p-6 text-wit sm:p-10 lg:col-span-5 lg:p-12">
            <!-- Maatschets: een kast in schuin aanzicht, met maatlijnen die meetekenen -->
            <svg viewBox="0 0 340 250" class="w-full max-w-[20rem] self-center" aria-hidden="true">
              <defs><marker id="pijl" viewBox="0 0 8 8" refX="4" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 8 4 0 8z" fill="#e2826d" /></marker></defs>
              <g fill="none" stroke="#f4f3ef" stroke-width="1.6" stroke-linejoin="round" data-kast>
                <path data-zij />
                <path data-top />
                <rect data-front fill="#2a2826" />
                <line data-deel stroke-width="1" stroke="#bdb9b2" />
              </g>
              <line data-mb stroke="#e2826d" stroke-width="1.4" marker-start="url(#pijl)" marker-end="url(#pijl)" />
              <line data-mh stroke="#e2826d" stroke-width="1.4" marker-start="url(#pijl)" marker-end="url(#pijl)" />
              <text data-tb text-anchor="middle" fill="#ffffff" font-size="13" font-family="Bree Serif, Georgia, serif">B ?</text>
              <text data-th text-anchor="middle" fill="#ffffff" font-size="13" font-family="Bree Serif, Georgia, serif">H ?</text>
              <text data-td fill="#bdb9b2" font-size="12" font-family="Bree Serif, Georgia, serif">D ?</text>
            </svg>
            <p class="mt-8 text-sm font-semibold text-mist">Uw bericht aan Stefan</p>
            <p class="mt-2 rounded-sm bg-inkt-2 p-4 text-[.9375rem] leading-relaxed" data-bericht aria-live="polite"></p>
            <a href={site.wa} class="knop mt-6 w-full" data-wa><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <p class="mt-4 text-sm text-mist">Een foto van de ruimte of een schets voegt u in WhatsApp toe. Liever mailen? <a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
          </div>
        </form>
      </div>
    </section>

    <!-- 7. CONTACT EN PLAATSEN -->
    <section id="contact" class="py-20 md:py-24" aria-labelledby="contact-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <h2 id="contact-titel" class="rijs text-3xl">Bel, app of kom langs</h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs">De werkplaats in Dordrecht is geen showroom. Wilt u langskomen? Spreek dan eerst even een tijd af.</p>
          <dl class="mt-10 max-w-md">
            <div class="rijs spec"><dt class="font-semibold">Telefoon</dt><span aria-hidden="true"></span><dd><a href={site.telHref} class="link num">{site.tel}</a></dd></div>
            <div class="rijs spec"><dt class="font-semibold">E-mail</dt><span aria-hidden="true"></span><dd><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></dd></div>
            <div class="rijs spec"><dt class="font-semibold">Ma t/m vr</dt><span aria-hidden="true"></span><dd class="num text-grijs">7:30 tot 16:30</dd></div>
            <div class="rijs spec"><dt class="font-semibold">Zaterdag</dt><span aria-hidden="true"></span><dd class="text-grijs">op afspraak</dd></div>
            <div class="rijs spec"><dt class="font-semibold">Zondag</dt><span aria-hidden="true"></span><dd class="text-grijs">gesloten</dd></div>
          </dl>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={waMet('Hallo Stefan, ik wil graag een afspraak maken om langs te komen in de werkplaats.')} class="knop"><Icoon naam="wa" />Afspraak maken</a>
            <a href={site.telHref} class="knop knop-inkt num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rijs border-t-4 border-inkt pt-7">
            <h3 class="text-2xl">Gemonteerd in</h3>
            <p class="mt-2 text-sm text-grijs">Plaatsen uit de eigen fotoalbums van Stefig</p>
            <p class="mt-6 leading-loose text-inkt">
              {plaatsen.map((p, i) => <><span class="whitespace-nowrap">{p}</span>{i < plaatsen.length - 1 && <span class="mx-1.5 text-rood" aria-hidden="true">·</span>}{' '}</>)}
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-intake]');
  if (f) {
    const $ = <T extends Element>(s: string) => f.querySelector<T>(s)!;
    const wa = $<HTMLAnchorElement>('[data-wa]');
    const basis = wa.href.split('?')[0];
    const n = (v: FormDataEntryValue | null) => Math.max(0, Math.round(Number(v) || 0));
    const zet = () => {
      const d = new FormData(f);
      const soort = String(d.get('soort'));
      const hout = String(d.get('hout'));
      const plaats = String(d.get('plaats') || '').trim();
      const b = n(d.get('b')), h = n(d.get('h')), dp = n(d.get('d'));

      const wat = soort === 'Iets anders' ? 'iets op maat' : soort.toLowerCase();
      const houtZin = hout === 'Weet ik nog niet' ? ' Over het hout twijfel ik nog.' : hout === 'Gelakt' ? ' Het liefst in een gelakte uitvoering.' : ` Het liefst van ${hout.toLowerCase()}.`;
      const maten = [b && `${b} breed`, h && `${h} hoog`, dp && `${dp} diep`].filter(Boolean);
      const maatZin = maten.length ? ` Ongeveer ${maten.join(', ')} (cm).` : '';
      const waar = plaats ? ` Het komt in ${plaats}.` : '';
      const tekst = `Hallo Stefan, ik wil graag een offerte voor ${wat}.${houtZin}${maatZin}${waar} Ik stuur een foto of schets mee.`;
      $('[data-bericht]').textContent = tekst;
      wa.href = `${basis}?text=${encodeURIComponent(tekst)}`;

      // Maatschets: voorkant schaalt mee met breedte en hoogte, diepte als schuine zijkant.
      const B = b || 200, H = h || 220, D = dp || 60;
      const s = Math.min(170 / B, 150 / H);
      const w = Math.max(30, B * s), hh = Math.max(30, H * s);
      const dd = Math.min(70, Math.max(10, D * s * 0.6));
      const x = 50 + (170 - w) / 2, y = 50 + (150 - hh);
      const dx = dd, dy = -dd * 0.6;
      $('[data-front]').setAttribute('x', String(x)); $('[data-front]').setAttribute('y', String(y));
      $('[data-front]').setAttribute('width', String(w)); $('[data-front]').setAttribute('height', String(hh));
      $('[data-top]').setAttribute('d', `M${x} ${y}l${dx} ${dy}h${w}l${-dx} ${-dy}z`);
      $('[data-zij]').setAttribute('d', `M${x + w} ${y}l${dx} ${dy}v${hh}l${-dx} ${-dy}z`);
      const deel = $('[data-deel]'); deel.setAttribute('x1', String(x + w / 2)); deel.setAttribute('x2', String(x + w / 2)); deel.setAttribute('y1', String(y)); deel.setAttribute('y2', String(y + hh));
      const mb = $('[data-mb]'); mb.setAttribute('x1', String(x)); mb.setAttribute('x2', String(x + w)); mb.setAttribute('y1', String(y + hh + 18)); mb.setAttribute('y2', String(y + hh + 18));
      const mh = $('[data-mh]'); mh.setAttribute('x1', String(x - 18)); mh.setAttribute('x2', String(x - 18)); mh.setAttribute('y1', String(y)); mh.setAttribute('y2', String(y + hh));
      const tb = $('[data-tb]'); tb.setAttribute('x', String(x + w / 2)); tb.setAttribute('y', String(y + hh + 38)); tb.textContent = b ? `${b} cm` : 'B ?';
      const th = $('[data-th]'); const thx = x - 30, thy = y + hh / 2; th.setAttribute('x', String(thx)); th.setAttribute('y', String(thy)); th.setAttribute('transform', `rotate(-90 ${thx} ${thy})`); th.textContent = h ? `${h} cm` : 'H ?';
      const td = $('[data-td]'); td.setAttribute('x', String(x + w + dx + 6)); td.setAttribute('y', String(y + dy + 4)); td.textContent = dp ? `${dp} cm` : 'D ?';
    };
    f.addEventListener('input', zet);
    f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
