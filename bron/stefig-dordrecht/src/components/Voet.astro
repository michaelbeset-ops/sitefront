---
import { site, url, waHoi } from '../data/site';
import Stempel from './Stempel.astro';
const jaar = new Date().getFullYear();
const lijst = ['Kasten op maat', 'Cinewalls en audiomeubels', 'Eettafels en salontafels', 'Wandplanken', 'Keukens en badkamermeubels', 'Winkelinrichting'];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <div class="flex items-center gap-4 text-wit">
        <Stempel class="h-20 w-20 flex-none" band="var(--color-inkt)" id="voet" />
        <p class="kop text-2xl leading-tight">Stefig<br /><span class="text-base text-mist">maatwerk in hout</span></p>
      </div>
      <p class="mt-6 max-w-xs">Meubels op maat van Stefan Oostveen, uit een eigen werkplaats in Dordrecht. Voor particulier en zakelijk.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Maatwerk</p>
      <ul class="mt-3 space-y-1">{lijst.map((p) => <li><a href={url('#werk')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
      <p class="mt-4"><a href={site.webshop} class="link link-licht">Meubelpanelen in de webshop</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">Werkplaats in Dordrecht<br />Langskomen op afspraak</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Werktijden</p>
      <p class="mt-3 num">ma t/m vr<br />7:30 tot 16:30</p>
      <p class="mt-2">za op afspraak<br />zo gesloten</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Stefig - maatwerk in hout, Dordrecht · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's en beschrijvingen komen van jullie eigen website stefig.nl. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
