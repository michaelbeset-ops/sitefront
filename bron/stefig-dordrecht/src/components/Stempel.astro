---
// Hun stempel-logo nagetekend: dubbele ring, "MAATWERK IN HOUT" boven, "INTERIEUR & EXTERIEUR" onder, schuine band met STEFIG.
interface Props { class?: string; band?: string; id?: string }
const { class: cls = '', band = 'currentColor', id = 's' } = Astro.props;
---
<svg viewBox="0 0 200 200" class={cls} aria-hidden="true" fill="none" stroke="currentColor">
  <defs>
    <path id={`${id}-boven`} d="M30 100a70 70 0 0 1 140 0" />
    <path id={`${id}-onder`} d="M22 100a78 78 0 0 0 156 0" />
  </defs>
  <g filter="url(#slijt)">
    <circle cx="100" cy="100" r="95" stroke-width="5" />
    <circle cx="100" cy="100" r="88" stroke-width="1.6" />
    <circle cx="100" cy="100" r="52" stroke-width="1.6" />
    <text fill="currentColor" stroke="none" font-family="Bree Serif, Georgia, serif" font-size="17" letter-spacing="2.2"><textPath href={`#${id}-boven`} startOffset="50%" text-anchor="middle">MAATWERK IN HOUT</textPath></text>
    <text fill="currentColor" stroke="none" font-family="Bree Serif, Georgia, serif" font-size="13" letter-spacing="1.6"><textPath href={`#${id}-onder`} startOffset="50%" text-anchor="middle" dominant-baseline="hanging">INTERIEUR &amp; EXTERIEUR</textPath></text>
    <g transform="rotate(-14 100 100)">
      <rect x="6" y="76" width="188" height="48" fill={band} stroke-width="3.5" />
      <text x="100" y="113" fill="currentColor" stroke="none" text-anchor="middle" font-family="Bree Serif, Georgia, serif" font-size="38" letter-spacing="3">STEFIG</text>
    </g>
  </g>
</svg>
