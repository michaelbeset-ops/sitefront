---
interface Props { donker?: boolean; class?: string }
const { donker = false, class: cls = '' } = Astro.props;
---
<span class:list={['merk', { 'op-donker': donker }, cls]}>
  <span class="merk-haak" aria-hidden="true"></span>
  <span class="merk-naam"><small>van</small>LEEUWEN</span>
  <span class="merk-sub">TIMMERWERKEN</span>
</span>
