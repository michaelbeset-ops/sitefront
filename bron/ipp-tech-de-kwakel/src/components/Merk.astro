---
// Hun eigen logo (logo-rework.png van ipp-tech.nl, 244x68, op halve grootte scherp op retina).
// Op donker staat het op een wit plaatje, zoals op hun huidige site in de footer.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex flex-none items-center no-underline', licht && 'rounded-sm bg-wit p-2.5', cls]} aria-label="IPP-Tech, naar de homepage">
  <img src={url('logo-ipp-tech.png')} alt="IPP-Tech: supply, maintenance, forklift services" width="244" height="68" class="h-[2.375rem] w-auto md:h-[2.625rem]" />
</a>
