---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const links = [['service', 'Service en onderhoud'], ['occasions', 'Verkoop en verhuur'], ['onderdelen', 'Onderdelen'], ['melden', 'Storing melden']];
---
<footer class="bg-zwart text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Heftruckservice en Baoli-dealer in De Kwakel. Onderhoud, verkoop, verhuur en onderdelen.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Snel naar</p>
      <ul class="mt-3 space-y-1">{links.map(([id, t]) => <li><a href={url(`#${id}`)} class="link link-licht no-underline hover:underline">{t}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <p class="mt-3 num">ma t/m vr 08:00-17:00<br />za 09:00-14:00</p>
      <p class="mt-3">Buiten kantooruren per e-mail.</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen website en Google-bedrijfsprofiel (Van eigenaar). Teksten op basis van ipp-tech.nl.</p>}
</footer>
