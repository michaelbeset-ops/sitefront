---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import buiten from '../assets/buiten.jpg';
import binnen from '../assets/binnen.jpg';
import glas from '../assets/glas.jpg';
import behang from '../assets/behang.jpg';
import kleur from '../assets/kleur.jpg';
import straat from '../assets/straat.jpg';
import h001 from '../assets/h001.jpg';
import h005 from '../assets/h005.jpg';
import h006 from '../assets/h006.jpg';
import h012 from '../assets/h012.jpg';
import f004 from '../assets/f004.jpg';
import f005 from '../assets/f005.jpg';
import f008 from '../assets/f008.jpg';
import f011 from '../assets/f011.jpg';
import f012 from '../assets/f012.jpg';
import f014 from '../assets/f014.jpg';
import f016 from '../assets/f016.jpg';
import f017 from '../assets/f017.jpg';

const vraag = (d: string) => waMet(`Goedendag Jack, ik heb een vraag over ${d.toLowerCase()}.`);

// Teksten gebaseerd op hun eigen dienstpagina's (schilderwerk, beglazing, wandafwerking, houtrot, kleuradvies).
const diensten = [
  { t: 'Buitenschilderwerk', d: 'Kozijnen, deuren en boeidelen beschermd tegen het Nederlandse weer.', src: buiten, alt: 'Donkergroen geschilderd kozijn in een bakstenen gevel', pos: '50% 45%' },
  { t: 'Binnenschilderwerk', d: 'Wanden, plafonds, deuren en trappen strak in de verf.', src: binnen, alt: 'Witte paneeldeur in een donkerblauw geschilderde wand', pos: '50% 38%' },
  { t: 'Beglazing', d: 'Levering en plaatsing van alle typen glas, ook bij glasschade.', src: glas, alt: 'Wit houten raam met kleine ruiten en uitzicht op groen', pos: '50% 50%' },
  { t: 'Behang en glasvlies', d: 'Behangen en afwerken van wanden, uit boeken met voorbeelden.', src: behang, alt: 'Groenblauw behang met een patroon van getekende bladeren', pos: '50% 50%' },
  { t: 'Houtrotreparaties', d: 'Rot hout eruit, nieuw hout erin en weer netjes afgewerkt.', src: h012, alt: 'Hoek van een wit kozijn na een houtrotreparatie, strak afgelakt', pos: '50% 45%' },
  { t: 'Kleuradvies', d: 'Hulp bij het kiezen van een kleur die bij uw huis past.', src: kleur, alt: 'Een waaier met kleurstalen in groen, blauw en paars', pos: '50% 50%' },
];

const houtrot = [
  { k: 'Voor', t: 'Verf bladdert, het hout geeft mee', d: 'Bij de onderdorpels en hoeken van kozijnen zit vocht het langst. Daar begint houtrot meestal.', src: h005, alt: 'Erkerkozijn met afbladderende witte verf en kaal hout in de hoek' },
  { k: 'Tijdens', t: 'Rot hout eruit, nieuw hout erin', d: 'Het aangetaste deel wordt weggehaald en aangevuld, daarna geschuurd en in de grondverf gezet.', src: h006, alt: 'Kozijnstijl met een nieuw ingezet stuk hout en de eerste laag grondverf' },
  { k: 'Na', t: 'Strak afgelakt en weer beschermd', d: 'Daarna in de lak gezet, zodat het kozijn weer beschermd is tegen weer en wind.', src: h012, alt: 'Dezelfde erker na de reparatie, wit afgelakt' },
];

const stappen = [
  ['Bel of app', 'Vertel kort wat er geschilderd of gerepareerd moet worden. Een foto meesturen helpt.'],
  ['Opname en offerte', 'We maken een afspraak om te kijken en u ontvangt een vrijblijvende offerte.'],
  ['Vakkundig uitgevoerd', 'Met kwaliteitsverf van Sikkens, Sigma of Wijzonol, binnen of buiten.'],
  ['Netjes opgeleverd', 'Vragen of wensen bespreekt u direct met Jack, tot het werk af is.'],
];

const projecten = [
  { src: f012, alt: 'Vrijstaande boerderijwoning met rode pannen en zwarte luiken' },
  { src: f017, alt: 'Woning met groene luiken en een schilder op de ladder bij de goot' },
  { src: f005, alt: 'Bakstenen woning met wit lijstwerk en een balkon met balusters' },
  { src: f014, alt: 'Wit geschilderde woning met een grote erker en rode pannen' },
  { src: f016, alt: 'Twee woningen met oranje pannen en wit geschilderde kozijnen' },
  { src: f004, alt: 'Hoekwoning met wit geschilderde garagedeuren en kozijnen' },
  { src: f011, alt: 'Twee-onder-een-kap met lichte kozijnen en een donkere voordeur' },
  { src: f008, alt: 'Kantoorpand met blauwe kozijnen en een gele gevelstrook' },
];
---
<Base title={`${site.naam} | Schildersbedrijf in Etten-Leur`} description="Schildersbedrijf in Etten-Leur: buiten- en binnenschilderwerk, beglazing, behang en glasvlies, houtrotreparaties en kleuradvies. 5,0 op Google. Vraag vrijblijvend een offerte aan.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1800, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[78%_50%] md:object-[70%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c223833_0%,#0c2238b8_48%,#0c2238f5_100%)] md:bg-[linear-gradient(90deg,#0c2238f7_0%,#0c2238d9_40%,#0c223826_78%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-10 pb-16 pt-32 md:pb-20 lg:grid-cols-12 lg:pb-24">
        <div class="lg:col-span-8">
          <p class="eyebrow">Schildersbedrijf in Etten-Leur</p>
          <h1 id="t-hero" class="mt-5 text-hero">Schilderwerk met de afwerking van een <span class="text-blad">vakschilder</span>.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Binnen en buiten, beglazing, behang en houtrotreparaties. Voor particulieren en kleine bedrijven, met verf van Sikkens, Sigma en Wijzonol.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-groen"><Icoon naam="wa" />Offerte aanvragen</a>
            <a href="#houtrot" class="knop knop-rand op-foto">Bekijk een reparatie</a>
          </div>
          <p class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-1 text-[.9375rem] text-licht/90">
            <span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            <span><b class="num text-licht">{site.google.score}</b> op Google, alle {site.google.aantal} reviews vijf sterren</span>
          </p>
        </div>
        <aside class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto max-w-[20rem] rounded-md bg-kalk p-6 text-inkt shadow-md">
            <p class="text-xs font-bold uppercase tracking-[.16em] text-groen">Direct contact met Jack</p>
            <a href={site.telHref} class="num mt-3 block font-kop text-[1.875rem] leading-none no-underline hover:text-groen">{site.tel}</a>
            <p class="mt-3 text-sm text-grijs">Bellen of appen voor een afspraak of een vrijblijvende offerte.</p>
            <p class="mt-5 flex items-center gap-2 border-t border-lijn pt-4 text-sm font-semibold"><Icoon naam="sneeuw" class="h-4 w-4 text-groen" /><span data-winter>Januari t/m april: 10% winterpremie op het uurloon</span></p>
          </div>
        </aside>
      </div>
    </section>

    <!-- 2. Diensten in het kort -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {['Buitenschilderwerk', 'Binnenschilderwerk', 'Isolatieglas', 'Glasschade', 'Behang', 'Glasvlies', 'Houtrotreparaties', 'Kleuradvies'].map((c) => <a href="#diensten" class="shrink-0 rounded-sm bg-mist px-4 py-2 text-sm font-medium no-underline transition-colors hover:bg-groen hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-4 text-3xl">Alle facetten van het schildersvak.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Goed schilderwerk maakt uw huis mooier, maar beschermt vooral het hout en ijzerwerk. Daar moet je zuinig op zijn.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw" class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                  <span class="num absolute left-0 top-0 bg-nacht px-3 py-1.5 font-kop text-sm text-licht">0{i + 1}</span>
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 border-t-4 border-groen p-5 sm:p-6">
                  <div>
                    <h3 class="text-[1.25rem] hyphens-auto [overflow-wrap:normal] sm:text-[1.375rem]">{b.t}</h3>
                    <p class="mt-2 text-grijs">{b.d}</p>
                  </div>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-mist text-groen transition-colors group-hover:bg-groen group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Houtrot: voor, tijdens, na (eigen foto's, één klus) -->
    <section id="houtrot" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-houtrot">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Houtrotreparatie</p>
          <h2 id="t-houtrot" class="mt-4 text-3xl">Van rot hout naar een strak kozijn.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Eén klus uit de praktijk, in drie foto’s. Houtrot zit vaak verstopt onder de verf. Op tijd repareren voorkomt dat u later het hele kozijn moet vervangen.</p>
          <div class="mt-9 grid gap-2" role="tablist" aria-label="Fase van de reparatie" data-tabs>
            {houtrot.map((s, i) => (
              <button type="button" role="tab" id={`tab-${i}`} aria-controls={`paneel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="fase group flex items-start gap-4 rounded-md p-4 text-left transition-colors">
                <span class="num grid h-10 w-10 shrink-0 place-items-center rounded-sm font-kop text-lg">{i + 1}</span>
                <span><b class="block text-xs font-bold uppercase tracking-[.16em]">{s.k}</b><span class="mt-1 block font-kop text-xl leading-tight text-licht">{s.t}</span><span class="fase-uitleg mt-2 block text-[.9375rem] text-licht-zacht">{s.d}</span></span>
              </button>
            ))}
          </div>
          <a href={vraag('houtrot')} class="knop knop-groen mt-9"><Icoon naam="wa" />Stuur een foto van uw kozijn</a>
        </div>
        <div class="order-first lg:order-none lg:col-span-7">
          <div class="relative h-full min-h-[22rem] overflow-hidden rounded-md bg-nacht-2 sm:min-h-[34rem]">
            {houtrot.map((s, i) => (
              <figure id={`paneel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} class="paneel absolute inset-0" data-actief={i === 0 ? '' : undefined}>
                <Image src={s.src} alt={s.alt} widths={[600, 900, 1200]} sizes="(min-width: 1248px) 680px, (min-width: 1024px) 55vw, 92vw" class="h-full w-full object-cover object-[50%_60%]" />
                <figcaption class="absolute bottom-4 left-4 bg-groen px-3 py-1.5 text-sm font-semibold text-wit">{s.k}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section class="py-20" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van eerste telefoontje tot oplevering.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Wilt u in een bepaalde periode laten schilderen? Reageer dan op tijd.</p>
        </div>
        <ol class="mt-12 grid gap-px overflow-hidden rounded-md bg-lijn sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs bg-wit p-6 sm:p-8" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.5rem] leading-none text-groen">0{i + 1}</p>
              <h3 class="mt-6 text-xl">{t}</h3>
              <p class="mt-2 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. Projecten -->
    <section id="projecten" class="bg-mist py-20" aria-labelledby="t-projecten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Uitgevoerde projecten</p>
            <h2 id="t-projecten" class="mt-4 text-3xl">Woningen die er weer jaren tegen kunnen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een greep uit het werk van Van Oers Schilderwerken, van rijtjeshuis tot vrijstaande woning.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14">
          {projecten.map((p, i) => (
            <li class="rijs overflow-hidden rounded-md bg-wit" style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={p.src} alt={p.alt} widths={[320, 465]} sizes="(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw" class="tegel aspect-[4/3] w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Over Jack -->
    <section id="over" class="bg-wit" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:col-span-6">
          <Image src={h001} alt="Schilder van Van Oers aan het werk: met hamer en beitel wordt rot hout uit een kozijn gehaald" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[55%_35%]" />
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-16 lg:py-20 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Van Oers</p>
          <h2 id="t-over" class="mt-4 text-3xl">Jack van Oers, vakschilder in Etten-Leur.</h2>
          <p class="mt-6 text-lg text-grijs">Van Oers Schilderwerken is het schildersbedrijf van Jack van Oers, aan de Havik in Etten-Leur. Het bedrijf werkt vooral voor particulieren en kleine bedrijven. Klanten noemen de schilders aardig en het werk mooi.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-start gap-4 rounded-md bg-kalk p-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-groen text-wit"><Icoon naam="blik" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Alleen kwaliteitsverf</h3><p class="mt-1 text-[.9375rem] text-grijs">Sikkens, Sigma en Wijzonol: duurzaam en bestand tegen elk weertype.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-kalk p-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-groen text-wit"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Denkt met u mee</h3><p class="mt-1 text-[.9375rem] text-grijs">Over kleur, aanpak en planning. Klanten noemen het goede advies.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-kalk p-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-groen text-wit"><Icoon naam="euro" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Vakwerk voor een redelijke prijs</h3><p class="mt-1 text-[.9375rem] text-grijs">En in de wintermaanden 10% premie op het uurloon.</p></div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="rijs lg:col-span-4">
          <p class="eyebrow">Reviews</p>
          <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          <a href={site.reviews} class="kaart mt-10 flex items-center gap-5 p-6 no-underline transition-shadow hover:shadow-md">
            <Icoon naam="g" class="h-10 w-10 shrink-0" />
            <span>
              <span class="flex items-center gap-3"><b class="num font-kop text-[2.75rem] leading-none">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span></span>
              <span class="mt-1 block text-sm text-grijs">{site.google.aantal} van {site.google.aantal} reviews met vijf sterren</span>
            </span>
          </a>
          <p class="mt-6"><a href={site.reviews} class="link font-semibold">Bekijk alle reviews op Google</a></p>
        </div>
        <ul class="grid gap-5 lg:col-span-8">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex flex-col gap-6 p-6 sm:flex-row sm:items-start sm:p-8" style={`--d:${i * 0.06}s`}>
              <span class="flex shrink-0 text-ster sm:pt-2" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <div class="flex-1">
                <blockquote class="font-kop text-[clamp(1.375rem,1vw+1.1rem,1.75rem)] leading-snug">“{r.tekst}”</blockquote>
                <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-grijs"><b class="whitespace-nowrap font-semibold text-inkt">{r.naam}</b><span aria-hidden="true">·</span><span class="whitespace-nowrap">Google review, {r.wanneer}</span><Icoon naam="g" class="h-4 w-4" /></p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. Contact: offerte-hulp naar WhatsApp -->
    <section id="contact" class="bg-mist py-20 lg:py-24" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Vertel wat er moet gebeuren.</h2>
          <p class="mt-6 text-lg text-grijs">Kies de klus en wanneer het u uitkomt. Wij zetten het in een WhatsApp-bericht aan Jack; foto’s stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-groen text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-mist text-groen"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-mist text-groen"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
            <li><a href={site.maps} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-mist text-groen"><Icoon naam="pin" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">{site.straat}</b><span class="text-grijs">{site.postcode} {site.plaats}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
          </ul>
        </div>
        <form class="kaart min-w-0 p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw bericht aan Van Oers</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat moet er gebeuren? <span class="font-normal text-grijs">(meer keuzes mogelijk)</span></legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Buitenschilderwerk', 'Binnenschilderwerk', 'Beglazing', 'Behang of glasvlies', 'Houtrot', 'Kleuradvies'].map((b) => (
                <label class="keuze"><input type="checkbox" name="klus" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-7">
            <legend class="text-sm font-semibold">Voor wie?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Particulier', 'Bedrijf'].map((b) => (
                <label class="keuze"><input type="radio" name="wie" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Wanneer?</span>
              <select name="wanneer" class="veld mt-2" data-wanneer>
                <option value="">Maakt niet uit</option>
                <option>Zo snel mogelijk</option>
                <option value="In de winter (jan t/m apr)">In de winter, met winterpremie</option>
                <option>In het voorjaar</option>
                <option>In de zomer</option>
                <option>In het najaar</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld Etten-Leur" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: voorkant van de woning, kozijnen en voordeur"></textarea></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
          </div>
          <p class="mt-5 hidden items-center gap-2 rounded-sm bg-mist px-4 py-3 text-sm font-semibold text-groen" data-premie><Icoon naam="sneeuw" class="h-4 w-4" />Van januari t/m april geldt 10% winterpremie op het uurloon.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-groen"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Liever bellen? <a href={site.telHref} class="link num font-semibold text-inkt">{site.tel}</a></p>
