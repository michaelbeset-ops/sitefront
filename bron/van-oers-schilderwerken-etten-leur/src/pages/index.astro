          <h2 class="text-[clamp(1.875rem,2.2vw+1.2rem,3rem)]">Toe aan een fris kleurtje?</h2>
          <p class="mt-3 max-w-xl text-lg text-licht/90">Bel of app Jack voor een afspraak of een vrijblijvende offerte.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-groen"><Icoon naam="wa" />WhatsApp Jack</a>
          <a href={site.telHref} class="knop knop-rand op-foto num"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Houtrot-fases: tabs met pijltjestoetsen.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tabs] [role=tab]')];
  const kies = (i: number, focus = false) => {
    tabs.forEach((t, j) => {
      const aan = i === j;
      t.setAttribute('aria-selected', String(aan)); t.tabIndex = aan ? 0 : -1;
      document.getElementById(`paneel-${j}`)?.toggleAttribute('data-actief', aan);
    });
    if (focus) tabs[i].focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => kies(i));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); kies((i + 1) % tabs.length, true); }
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); kies((i + tabs.length - 1) % tabs.length, true); }
    });
  });

  // Offerte-hulp: maakt een net WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const premie = document.querySelector<HTMLElement>('[data-premie]');
  f?.querySelector('[data-wanneer]')?.addEventListener('change', (e) => {
    const v = (e.target as HTMLSelectElement).value;
    premie?.classList.toggle('hidden', !v.startsWith('In de winter'));
    premie?.classList.toggle('flex', v.startsWith('In de winter'));
  });
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(f);
    const v = (n: string) => String(d.get(n) || '').trim();
    const klussen = d.getAll('klus').map(String);
    const r = ['Goedendag Jack, ik wil graag een offerte aanvragen.'];
    if (klussen.length) r.push('Klus: ' + klussen.join(', ').toLowerCase());
    if (v('wie')) r.push('Voor: ' + v('wie').toLowerCase());
    if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
    if (v('plaats')) r.push('Plaats: ' + v('plaats'));
    if (v('wens')) r.push('Toelichting: ' + v('wens'));
    if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam'));
    window.open('https://wa.me/31642076636?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
  });
</script>

