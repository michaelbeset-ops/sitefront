  .fase { color: var(--color-licht-zacht); box-shadow: inset 0 0 0 1px var(--color-lijn-licht); }
  .fase:hover { background: var(--color-nacht-2); }
  .fase > span:first-child { background: var(--color-nacht-2); color: var(--color-licht); }
  .fase b { color: var(--color-licht-zacht); }
  .fase-uitleg { display: none; }
  .fase[aria-selected='true'] { background: var(--color-nacht-2); box-shadow: inset 4px 0 0 var(--color-blad); }
  .fase[aria-selected='true'] > span:first-child { background: var(--color-groen); color: #fff; }
  .fase[aria-selected='true'] b { color: var(--color-blad); }
  .fase[aria-selected='true'] .fase-uitleg { display: block; }
  .paneel { opacity: 0; visibility: hidden; transition: opacity .5s var(--ease-zacht), visibility 0s .5s; }
  .paneel[data-actief] { opacity: 1; visibility: visible; transition: opacity .5s var(--ease-zacht); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-sm); background: var(--color-mist); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #dce1d8; }
  .keuze input:checked + span { background: var(--color-groen); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-groen); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-sm); border: 1.5px solid #0c223833; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #0c223866; }
