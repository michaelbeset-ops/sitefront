---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Bestelling from '../components/Bestelling.astro';
import { site, waIcoon, telIcoon } from '../data/site';
import schotel from '../assets/schotel.jpg';
import hummus from '../assets/hummus.jpg';
import zaak from '../assets/zaak.jpg';
import thee from '../assets/thee.jpg';
import drankjes from '../assets/drankjes.jpg';
import vitrine from '../assets/vitrine.jpg';
import wraps from '../assets/wraps.jpg';
import handwrap from '../assets/handwrap.jpg';

const pijl = '<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base title={`${site.naam} | Libanees restaurant in Leiden`} description="Taratoer, Libanees restaurant aan de Van der Waalsstraat 3 in Leiden. Wraps, falafel, shoarma en broodjes, ook vegan en vegetarisch. Open vanaf 17.00 uur. Bestellen via WhatsApp.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO: donker cedergroen, grote kop, eigen foto van het Google-profiel rechts die over de rand valt -->
    <section class="donker relative bg-ceder text-creme">
      <div class="wrap grid gap-10 pb-0 pt-10 lg:grid-cols-12 lg:gap-12 lg:pt-16">
        <div class="lg:col-span-6 lg:pb-24 lg:pt-6">
          <p class="eyebrow text-munt">Libanees restaurant &middot; Leiden</p>
          <h1 class="mt-4 text-4xl font-extrabold">
            Taratoer
            <span class="mt-3 block text-2xl font-semibold tracking-[-0.02em] text-saffraan">Libanees, en alles vers.</span>
          </h1>
          <p class="mt-5 max-w-lg text-lg text-creme/85 sm:mt-6">Wraps, falafel, shoarma en broodjes, met veel groente. Ook vegan en vegetarisch.</p>
          <div class="mt-7 flex flex-wrap gap-3 sm:mt-8">
            <a href="#bestellen" class="btn btn-wa"><Fragment set:html={waIcoon} />Bestel via WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-creme"><Fragment set:html={telIcoon} /><span class="sm:hidden">Bel</span><span class="sr-only whitespace-nowrap tabular-nums sm:not-sr-only">{site.tel}</span></a>
          </div>
          <p class="mt-6 text-sm text-creme/85 sm:hidden"><span class="font-display text-lg font-bold text-creme">{site.google.score}</span> <span class="text-saffraan" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> uit {site.google.aantal} Google-reviews &middot; open vanaf <span class="whitespace-nowrap tabular-nums">17.00</span></p>
          <dl class="mt-10 hidden max-w-lg grid-cols-2 sm:grid gap-6 border-t border-lijn-licht pt-6">
            <div>
              <dt class="text-sm text-creme/75">Google-reviews</dt>
              <dd class="mt-1 flex items-baseline gap-2 font-display text-3xl font-bold leading-none">{site.google.score}<span class="text-lg text-saffraan" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span></dd>
              <dd class="mt-1 text-sm text-creme/75">uit {site.google.aantal} reviews</dd>
            </div>
            <div>
              <dt class="text-sm text-creme/75">Open vanaf</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-3xl font-bold leading-none tabular-nums">17.00</dd>
              <dd class="mt-1 text-sm text-creme/75">{site.straat}</dd>
            </div>
          </dl>
        </div>
        <div class="relative lg:col-span-6">
          <figure class="relative z-10 -mb-24 overflow-hidden rounded-2xl shadow-xl sm:-mb-32 lg:-mb-40">
            <div class="aspect-[5/4] sm:aspect-[4/3] lg:aspect-[4/5]">
              <Foto src={schotel} alt="Aan tafel bij Taratoer: een bord met hummus, zuur, uitjes met peterselie en gebakken vlees met pijnboompitten, erachter falafel en brood" class="object-[center_60%]" hero sizes="(min-width: 1024px) 600px, 100vw" />
            </div>
            <figcaption class="absolute left-4 top-4 rounded-full bg-ceder/90 px-3.5 py-1.5 text-xs font-semibold text-creme backdrop-blur-sm">Aan tafel bij Taratoer</figcaption>
          </figure>
          <figure class="absolute -bottom-40 -left-10 z-20 hidden w-56 overflow-hidden rounded-xl bg-papier p-2 shadow-xl xl:block">
            <div class="aspect-[4/3] overflow-hidden rounded-lg"><Foto src={zaak} alt="Het interieur van Taratoer met houten tafels, kasten vol potten en de toonbank" sizes="224px" /></div>
            <figcaption class="px-1.5 pb-1 pt-2 text-xs font-semibold text-inkt">{site.straat}, {site.plaats}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- POPULAIR BIJ GASTEN -->
    <section id="populair" class="licht scroll-mt-16 bg-papier pb-16 pt-36 sm:pt-44 lg:pb-24 lg:pt-28" aria-labelledby="popkop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <p class="eyebrow text-granaat">Populair bij gasten</p>
            <h2 id="popkop" class="mt-3 text-3xl">Wraps, falafel, shoarma en broodjes</h2>
          </div>
          <div class="self-end lg:col-span-5 lg:col-start-8">
            <p class="text-inkt-zacht">Dit noemen gasten het vaakst in hun Google-reviews. De volledige kaart met prijzen volgt.</p>
            <p class="mt-2 text-xs text-inkt-zacht">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
          </div>
        </div>

        <ul class="mt-10 grid gap-4 md:grid-cols-12 md:gap-5">
          <li class="group relative overflow-hidden rounded-xl shadow-sm md:col-span-7 md:row-span-2">
            <div class="aspect-[4/3] h-full md:aspect-auto md:min-h-[30rem]"><Foto src={wraps} alt="Sfeerbeeld: opgerolde wraps met vlees, gebakken aardappel, sausjes en groente op een bord" class="transition-transform duration-700 group-hover:scale-[1.03]" sizes="(min-width: 768px) 60vw, 100vw" /></div>
            <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ceder/90 via-ceder/55 to-transparent p-5 pt-20 text-creme sm:p-7 sm:pt-24">
              <span class="eyebrow text-saffraan">Meest genoemd</span>
              <h3 class="mt-1 text-2xl text-creme">Wraps</h3>
            </div>
          </li>
          <li class="group relative overflow-hidden rounded-xl shadow-sm md:col-span-5">
            <div class="aspect-[3/2]"><Foto src={hummus} alt="Falafel op een bord hummus, een schotel met yoghurt en noten en een koperen theepot op tafel bij Taratoer" class="object-[center_35%] transition-transform duration-700 group-hover:scale-[1.03]" sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ceder/90 via-ceder/50 to-transparent p-5 pt-16 text-creme">
              <h3 class="text-2xl text-creme">Falafel</h3>
            </div>
          </li>
          <li class="group relative overflow-hidden rounded-xl shadow-sm md:col-span-5">
            <div class="aspect-[3/2]"><Foto src={handwrap} alt="Sfeerbeeld: een broodje met falafel en gebakken aubergine in de hand" class="transition-transform duration-700 group-hover:scale-[1.03]" sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-ceder/90 via-ceder/50 to-transparent p-5 pt-16 text-creme">
              <h3 class="text-2xl text-creme">Broodjes</h3>
            </div>
          </li>
          <li class="donker flex flex-col justify-between rounded-xl bg-sumak p-6 text-creme shadow-sm md:col-span-4">
            <span class="font-display text-lg font-bold text-saffraan">04</span>
            <h3 class="mt-8 text-2xl text-creme">Shoarma</h3>
          </li>
          <li class="flex flex-col justify-between rounded-xl bg-zand p-6 shadow-sm md:col-span-4">
            <span class="font-display text-lg font-bold text-granaat">05</span>
            <h3 class="mt-8 text-2xl">Vegan en vegetarisch</h3>
          </li>
          <li class="donker flex flex-col justify-between rounded-xl bg-ceder p-6 text-creme shadow-sm md:col-span-4">
            <span class="eyebrow text-munt">Ook genoemd</span>
            <p class="mt-8 font-display text-2xl font-bold leading-tight tracking-[-0.02em]">Ayran, salep en kashkaval</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- WOW: BESTELLING SAMENSTELLEN -->
    <section id="bestellen" class="donker scroll-mt-16 bg-ceder-2 py-16 text-creme lg:py-24" aria-labelledby="beskop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="eyebrow text-saffraan">Bestellen via WhatsApp</p>
            <h2 id="beskop" class="mt-3 text-3xl">Stel je bestelling samen</h2>
          </div>
          <p class="self-end text-creme/85 lg:col-span-5">Kies je gerechten, afhalen of hier eten en een tijd. Wij zetten het klaar als een net WhatsApp-bericht aan Taratoer.</p>
        </div>
        <div class="mt-10">
          <Bestelling />
        </div>
      </div>
    </section>

    <!-- WAT GASTEN NOEMEN -->
    <section class="licht bg-creme py-16 lg:py-24" aria-labelledby="gastkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-granaat">Wat gasten noemen</p>
          <h2 id="gastkop" class="mt-3 text-3xl">Libanese keuken van hoge kwaliteit</h2>
          <div class="mt-8 flex items-end gap-5 rounded-xl bg-papier p-6 shadow-sm ring-1 ring-lijn">
            <p class="font-display text-[4.5rem] font-extrabold leading-none tracking-[-0.05em] text-ceder">{site.google.score}</p>
            <p class="pb-1.5 text-inkt-zacht"><span class="block text-granaat" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>uit {site.google.aantal} reviews op Google</p>
          </div>
          <ul class="mt-8 divide-y divide-lijn border-y border-lijn">
            <li class="flex gap-4 py-4"><span class="font-display font-bold text-granaat">01</span><span>Alles vers, met veel groente.</span></li>
            <li class="flex gap-4 py-4"><span class="font-display font-bold text-granaat">02</span><span>Vegan en vegetarisch, vaak genoemd.</span></li>
            <li class="flex gap-4 py-4"><span class="font-display font-bold text-granaat">03</span><span>De eigenaar komt in veel reviews terug.</span></li>
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-4 lg:col-span-7 lg:gap-5">
          <figure class="col-span-2 overflow-hidden rounded-xl shadow-sm">
            <div class="aspect-[16/10]"><Foto src={zaak} alt="Het interieur van Taratoer: hanglampen, houten tafels en stoelen, kasten vol potten en de toonbank met koelkast" sizes="(min-width: 1024px) 700px, 100vw" /></div>
          </figure>
          <figure class="overflow-hidden rounded-xl shadow-sm">
            <div class="aspect-[4/5]"><Foto src={thee} alt="Thee wordt uit een koperen kan ingeschonken, op tafel een schaal bonen" class="object-[center_60%]" sizes="(min-width: 1024px) 340px, 50vw" /></div>
          </figure>
          <figure class="overflow-hidden rounded-xl shadow-sm">
            <div class="aspect-[4/5]"><Foto src={drankjes} alt="Twee glazen met ijs, een schijfje sinaasappel en een framboos" sizes="(min-width: 1024px) 340px, 50vw" /></div>
          </figure>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="donker scroll-mt-16 bg-ceder py-16 text-creme lg:py-24" aria-labelledby="contactkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-munt">Tijden en route</p>
          <h2 id="contactkop" class="mt-3 text-3xl">Van der Waalsstraat 3, Leiden</h2>
          <address class="mt-6 not-italic text-lg text-creme/85">
            <strong class="font-display text-2xl font-bold text-creme">{site.naam}</strong><br />
            {site.straat}<br />{site.postcode} {site.plaats}
          </address>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.whatsapp} class="btn btn-wa text-lg"><Fragment set:html={waIcoon} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-creme"><Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <a href={site.maps} class="inline-flex items-center gap-1.5 font-semibold text-saffraan underline-offset-4 hover:underline">Route plannen <Fragment set:html={pijl} /></a>
            <a href={site.instagram} class="inline-flex items-center gap-1.5 font-semibold text-saffraan underline-offset-4 hover:underline">Instagram {site.instaNaam} <Fragment set:html={pijl} /></a>
          </p>
        </div>
        <div class="lg:col-span-6">
          <div class="overflow-hidden rounded-xl bg-ceder-2 shadow-sm ring-1 ring-lijn-licht">
            <div class="aspect-[16/9]"><Foto src={vitrine} alt="Zicht vanuit Taratoer door de glazen pui naar de straat, met tafeltjes bij het raam" class="object-[center_40%]" sizes="(min-width: 1024px) 600px, 100vw" /></div>
            <div class="p-6 sm:p-8">
              <h3 class="text-2xl text-creme">Openingstijden</h3>
              <p class="mt-4 flex items-baseline justify-between gap-4 border-b border-lijn-licht pb-4"><span>Open vanaf</span><span class="whitespace-nowrap font-display text-2xl font-bold tabular-nums text-saffraan">17.00 uur</span></p>
              <p class="mt-4 text-sm text-creme/75">[[AANLEVEREN: openingstijden per dag]]</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
