---
// Typografisch woordmerk: gestileerde ceder (zoals op de Libanese vlag in de zaak) en de naam in Bricolage Grotesque.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg aria-hidden="true" viewBox="0 0 32 32" class="h-8 w-8 shrink-0 text-saffraan"><path d="M16 3l6.5 7.5h-3.2l5.4 6.5h-4.2l5.5 6.5H6l5.5-6.5H7.3l5.4-6.5H9.5z" fill="currentColor"/><rect x="14.7" y="23.5" width="2.6" height="5.5" rx="1" fill="currentColor"/></svg>
  <span class="flex flex-col leading-none">
    <span class="whitespace-nowrap font-display text-2xl font-extrabold tracking-[-0.04em]">taratoer</span>
    <span class="mt-0.5 text-[0.625rem] font-bold uppercase tracking-[0.26em] text-munt">Libanees · Leiden</span>
  </span>
</span>
