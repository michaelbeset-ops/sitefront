---
import { site, url, chips, waOfferte, projecten } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <span class="merk-teken" aria-hidden="true"><Icoon naam="sneeuw" class="h-5 w-5" /></span>
        <span><b>Benne</b><small>koeltechniek</small></span>
      </a>
      <p class="mt-6 max-w-xs">Koeltechnisch installatie-, service- en adviesbureau in Vianen. Airconditioning, koel- en vriescellen en luchtbehandeling voor particulieren en bedrijven.</p>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {chips.slice(0, 7).map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-munt">{c}</a></li>)}
      </ul>
    </div>
    <div class="min-w-0 lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-munt">{site.tel}</a></li>
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-munt">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] no-underline transition-colors hover:text-munt">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Eerdere projecten</p>
      <ul class="mt-4 space-y-2">
        {projecten.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam} B.V., {site.plaats} · KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-munt">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Projectfoto's van uw huidige website en uw Google-bedrijfsprofiel; sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 3 oktober 2026).</p>}
  </div>
</footer>
