---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, chips, merken, projecten, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import thuis from '../assets/thuis.jpg';
import bedrijf from '../assets/bedrijf.jpg';
import koelcel from '../assets/koelcel.jpg';
import stacaravan from '../assets/stacaravan.jpg';
import vocht from '../assets/vocht.jpg';
import service from '../assets/service.jpg';
import monteur from '../assets/monteur.jpg';
import p01 from '../assets/p01.jpg';
import p05 from '../assets/p05.jpg';
import p08 from '../assets/p08.jpg';
import p10 from '../assets/p10.jpg';
import p14 from '../assets/p14.jpg';
import p16 from '../assets/p16.jpg';

const vraag = (d: string) => waMet(`Goedendag, ik heb een vraag over ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Airco voor thuis', d: 'Woonkamer, slaapkamer of zolder. Single split, of multisplit met meerdere binnenunits op één buitenunit.', src: thuis, alt: 'Lichte woonkamer met een witte airco-binnenunit hoog aan de wand', pos: '50% 22%' },
  { t: 'Airco voor bedrijven', d: 'Kantoren, serverruimtes, kantines, winkels, magazijnen en restaurants.', src: bedrijf, alt: 'Twee buiteneenheden op een grinddak, geplaatst door Benne Koeltechniek', pos: '50% 50%' },
  { t: 'Koel- en vriescellen', d: 'Voor slager, snackbar, supermarkt of visbedrijf. Op maat berekend voor wat u koelt.', src: koelcel, alt: 'Bevroren vis in metalen bakken in een vriescel', pos: '50% 45%' },
  { t: 'Stacaravans', d: 'Koel- en verwarmingsoplossingen voor stacaravans, netjes weggewerkt.', src: stacaravan, alt: 'Binnenunit van een airco boven de ramen in de woonkamer van een stacaravan', pos: '50% 30%' },
  { t: 'Luchtvochtigheid', d: 'Bevochtigen in de winter, ontvochtigen in de zomer. Richting een prettige 40 tot 60 procent.', src: vocht, alt: 'Airco-binnenunit onder een schuin dakraam, geplaatst door Benne Koeltechniek', pos: '50% 50%' },
  { t: 'Service en onderhoud', d: 'Inregelen en onderhoud: bedrijfszekerder, zuiniger en langer mee.', src: service, alt: 'Witte airco-binnenunit aan een lichte wand', pos: '50% 50%' },
];

const werk = [
  { src: p05, alt: 'Twee buiteneenheden met afgewerkte leidingen op een plat dak', groot: true },
  { src: p14, alt: 'Twee buiteneenheden op een nat bitumendak' },
  { src: p10, alt: 'Twee buiteneenheden naast elkaar op een grinddak' },
  { src: p08, alt: 'Buiteneenheid op een balkon met houten vloer en erker' },
  { src: p01, alt: 'Buiteneenheid hoog in een erker van een woning', pos: '50% 8%' },
];

const stappen = [
  ['Bel of app', 'Vertel wat u wilt koelen, verwarmen of verbeteren, thuis of in uw bedrijf.'],
  ['Advies op locatie', 'We komen langs en kijken wat voor uw woning of bedrijf het beste werkt.'],
  ['Nette offerte', 'U krijgt een duidelijke, vrijblijvende offerte op maat.'],
  ['Zorgvuldig geplaatst', 'Op de afgesproken tijd. Vloer beschermd, leidingen netjes in een goot.'],
  ['Uitleg en onderhoud', 'Uitleg over de bediening en de app. Daarna onderhoud wanneer nodig.'],
];
---
<Base title={`${site.naam} | Airco en koeltechniek in Vianen`} description="Benne Koeltechniek in Vianen: advies, ontwerp, installatie en onderhoud van airconditioning, koel- en vriescellen en luchtbehandeling. Voor particulieren en bedrijven. 5,0 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] flex-col overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c171455_0%,#0c1714c4_50%,#0c1714f5_100%)] md:bg-[linear-gradient(90deg,#0c1714f7_0%,#0c1714d9_40%,#0c171433_78%)]" aria-hidden="true"></div>
      <div class="wrap flex flex-1 items-end pb-14 pt-28 md:items-center md:py-20">
        <div class="max-w-[46rem]">
          <p class="eyebrow">Koeltechniek in Vianen</p>
          <h1 id="t-hero" class="mt-5 text-hero">Airco en koeling, <span class="text-munt">netjes</span> geplaatst.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Advies, ontwerp, installatie en onderhoud van airconditioning, koel- en vriescellen en luchtbehandeling. Voor uw woning, uw bedrijf of uw stacaravan.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#contact" class="knop knop-groen">Offerte aanvragen<Icoon naam="pijl" /></a>
            <a href={waOfferte} class="knop knop-rand op-foto"><Icoon naam="wa" />WhatsApp</a>
          </div>
        </div>
      </div>
      <div class="border-t border-lijn-licht bg-nacht/60 backdrop-blur-md">
        <ul class="wrap grid grid-cols-1 divide-y divide-lijn-licht text-[.9375rem] sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          <li class="flex items-center gap-3 py-4 sm:pr-6"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span><b class="num text-licht">{site.google.score}</b> op Google</span></li>
          <li class="flex items-center gap-3 py-4 sm:px-6"><Icoon naam="sneeuw" class="h-5 w-5 text-munt" /><span>Sinds 1987 in de koeltechniek</span></li>
          <li class="flex items-center gap-3 py-4 sm:pl-6"><Icoon naam="tel" class="h-5 w-5 text-munt" /><span>Bel of app <a href={site.telHref} class="num font-semibold text-licht no-underline hover:text-munt">{site.tel}</a></span></li>
        </ul>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-md border border-lijn px-4 py-2 text-sm font-medium no-underline transition-colors hover:border-groen hover:bg-groen hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-4 text-3xl">Alles wat koelt, van slaapkamer tot vriescel.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Advies, berekening, plaatsing en onderhoud uit één hand. Voor particulieren en voor bedrijven.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[3/2]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 border-t-[3px] border-groen p-4 sm:p-6">
                  <div>
                    <h3 class="text-[1.0625rem] hyphens-auto sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 hyphens-auto text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-md bg-mist text-groen transition-colors group-hover:bg-groen group-hover:text-wit sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-md bg-mist px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Merken: {merken.join(', ')}.</b> <span class="text-grijs">Andere merken in overleg.</span></p>
          <a href={waOfferte} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="wa" />Stel uw vraag</a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Begonnen in de koeltechniek</dt><dd class="cijfer num order-first text-groen">1987</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Jaar avondschool gevolgd</dt><dd class="cijfer num order-first">11</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Score op Google</dt><dd class="cijfer num order-first">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">F-gassencertificaat behaald</dt><dd class="cijfer num order-first">2010</dd></div>
      </dl>
    </section>

    <!-- 5. Projecten -->
    <section id="projecten" class="donker bg-nacht py-24 text-licht lg:py-28" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-4 text-3xl">Van zolderkamer tot dak in Utrecht.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Een greep uit eerder werk, bij particulieren en bij bedrijven.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14">
          {werk.map((w, i) => (
            <li class={`rijs relative overflow-hidden rounded-md bg-nacht-2 ${w.groot ? 'col-span-2 row-span-2 aspect-[4/3] md:aspect-auto' : 'aspect-[4/3]'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={w.groot ? [600, 850] : [320, 480]} sizes={w.groot ? '(min-width: 768px) 600px, 92vw' : '(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" style={w.pos ? `object-position:${w.pos}` : undefined} />
            </li>
          ))}
        </ul>
        <ul class="mt-8 flex flex-wrap gap-2 text-sm" aria-label="Eerdere projecten">
          {projecten.map((p) => <li class="rounded-sm border border-lijn-licht px-3 py-1.5 text-licht-zacht">{p}</li>)}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van eerste belletje tot koele kamer.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Zo verloopt een opdracht, of het nu om één airco gaat of om een complete koelcel.</p>
        </div>
        <ol class="relative mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5 lg:gap-6">
          <span class="absolute left-0 right-0 top-[1.375rem] hidden h-px bg-lijn lg:block" aria-hidden="true"></span>
          {stappen.map(([t, d], i) => (
            <li class="rijs relative" style={`--d:${i * 0.06}s`}>
              <p class="num relative grid h-11 w-11 place-items-center rounded-md bg-groen font-kop text-lg font-extrabold text-wit">0{i + 1}</p>
              <h3 class="mt-5 text-xl">{t}</h3>
              <p class="mt-2 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="bg-mist py-20 lg:py-24" aria-labelledby="t-over">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="relative lg:col-span-5">
          <Image src={p16} alt="Condensors op een plat dak boven de stad Utrecht, met de Domtoren in de verte" widths={[367]} sizes="(min-width: 1024px) 367px, 80vw" class="aspect-[2/3] w-full max-w-[23rem] rounded-md object-cover shadow-md" />
          <figure class="absolute -bottom-8 right-0 w-[48%] max-w-[15rem] rounded-md bg-wit p-2 shadow-md sm:right-4 lg:-right-4">
            <Image src={monteur} alt="Monteur van Benne Koeltechniek aan het werk met een koffer gereedschap" widths={[300]} sizes="240px" class="aspect-[3/2] w-full rounded-sm object-cover" />
            <figcaption class="px-1 pb-0.5 pt-2 text-xs text-grijs">Aan het werk</figcaption>
          </figure>
        </div>
        <div class="pt-6 lg:col-span-7 lg:pt-0">
          <p class="eyebrow">Over Benne Koeltechniek</p>
          <h2 id="t-over" class="mt-4 text-3xl">Vakkennis uit treinen, horeca en tuinbouw.</h2>
          <p class="mt-6 text-lg text-grijs">De eigenaar begon in 1987, na de MTS werktuigbouwkunde, als monteur bij een koeltechnisch bedrijf en werkte zich op tot projectleider en praktijkopleider. Hij werkte in de utiliteitsbouw, de horeca, de tuinbouw, op universiteiten en aan de koeling van treinen en trams voor NS. Daarnaast volgde hij elf jaar avondschool in koeltechniek, elektrotechniek en ontwerp.</p>
          <ul class="mt-8 grid gap-3 sm:grid-cols-3">
            <li class="kaart p-5">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-groen text-wit"><Icoon naam="kwast" class="h-5 w-5" /></span>
              <h3 class="mt-4 text-lg">Nette afwerking</h3>
              <p class="mt-1 text-[.9375rem] text-grijs">Vloer beschermd, leidingen in een goot, units na afloop schoongemaakt.</p>
            </li>
            <li class="kaart p-5">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-groen text-wit"><Icoon naam="lineaal" class="h-5 w-5" /></span>
              <h3 class="mt-4 text-lg">Berekend en ontworpen</h3>
              <p class="mt-1 text-[.9375rem] text-grijs">Niet alleen plaatsen: ook koelingen en koelsystemen berekenen en ontwerpen.</p>
            </li>
            <li class="kaart p-5">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-groen text-wit"><Icoon naam="schild" class="h-5 w-5" /></span>
              <h3 class="mt-4 text-lg">A-kwaliteit</h3>
              <p class="mt-1 text-[.9375rem] text-grijs">Alleen apparatuur van A-kwaliteit, van merken als Daikin en Mitsubishi.</p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-extrabold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">Op basis van {site.google.aantal} Google-reviews</span>
            </span>
          </a>
        </div>
        <div class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-12">
          <figure class="rijs donker flex flex-col rounded-md bg-groen p-7 text-wit md:p-10 lg:col-span-7">
            <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span>
            <blockquote class="mt-6 flex-1 space-y-4 text-lg leading-relaxed md:text-xl">
              {reviews.groot.tekst.map((t, i) => <p>{i === 0 ? '“' : ''}{t}{i === reviews.groot.tekst.length - 1 ? '”' : ''}</p>)}
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-3 border-t border-wit/25 pt-5">
              <span class="grid h-10 w-10 place-items-center rounded-md bg-wit/15 font-kop font-bold" aria-hidden="true">F</span>
              <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{reviews.groot.naam}</b><span class="text-wit/80">Google review, twee airco's geplaatst</span></span>
              <span class="grid h-8 w-8 place-items-center rounded-full bg-wit"><Icoon naam="g" class="h-5 w-5" /></span>
            </figcaption>
          </figure>
          <div class="grid gap-5 lg:col-span-5">
            {reviews.klein.map((r, i) => (
              <figure class="rijs kaart flex flex-col p-6 md:p-7" style={`--d:${(i + 1) * 0.06}s`}>
                <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
                <blockquote class="mt-4 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn pt-5">
                  <span class="grid h-10 w-10 place-items-center rounded-md bg-mist font-kop font-bold text-groen" aria-hidden="true">{r.naam[0]}</span>
                  <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">{r.noot}</span></span>
                  <Icoon naam="g" class="h-5 w-5" />
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Contact: offerteaanvraag via WhatsApp -->
    <section id="contact" class="bg-mist py-20 lg:py-24" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Vertel wat u wilt koelen.</h2>
          <p class="mt-6 text-lg text-grijs">Kies wat u nodig heeft. Wij zetten het in een WhatsApp-bericht; foto's van de ruimte stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid grid-cols-1 gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-groen text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-mist text-groen"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-mist text-groen"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
            <li><a href={site.maps} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-mist text-groen"><Icoon naam="pin" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">{site.straat}, {site.plaats}</b><span class="text-grijs">Landelijk actief</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
          </ul>
        </div>
        <form class="kaart min-w-0 p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw aanvraag</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Voor</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Mijn woning', 'Mijn bedrijf', 'Mijn stacaravan'].map((b, i) => (
                <label class="keuze"><input type="radio" name="voor" value={b} class="sr-only" checked={i === 0} /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-6">
            <legend class="text-sm font-semibold">Waarvoor</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Airco', 'Multisplit', 'Koel- of vriescel', 'Luchtvochtigheid', 'Onderhoud of storing', 'Advies'].map((b, i) => (
                <label class="keuze"><input type="radio" name="wat" value={b} class="sr-only" checked={i === 0} /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Aantal ruimtes</span>
              <select name="ruimtes" class="veld mt-2">
                <option value="">Weet ik nog niet</option>
                <option>1</option><option>2</option><option>3</option><option>4 of meer</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: zolderkamer van 4 bij 5 meter, wordt erg warm"></textarea></label>
          </div>
          <div class="mt-7 rounded-md bg-mist p-4 text-sm" aria-live="polite">
            <p class="font-semibold">Voorbeeld van uw bericht</p>
            <p class="mt-2 whitespace-pre-line text-grijs" data-voorbeeld></p>
          </div>
          <div class="mt-7">
            <button type="submit" class="knop knop-groen"><Icoon naam="wa" />Open in WhatsApp</button>
          </div>
        </form>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-groen text-wit" aria-label="Contact opnemen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Advies nodig over airco of koeling?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel of app, dan komen we vrijblijvend kijken.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const bericht = () => {
    if (!f) return '';
    const d = new FormData(f);
    const v = (n: string) => String(d.get(n) || '').trim();
    const r = ['Goedendag, ik wil graag een offerte aanvragen.'];
    r.push(`Voor: ${v('voor').replace('Mijn ', 'mijn ')}`);
    r.push(`Waarvoor: ${v('wat')}`);
    if (v('ruimtes')) r.push(`Aantal ruimtes: ${v('ruimtes')}`);
    if (v('plaats')) r.push(`Plaats: ${v('plaats')}`);
    if (v('wens')) r.push(`Toelichting: ${v('wens')}`);
    if (v('naam')) r.push(`Groet, ${v('naam')}`);
    return r.join('\n');
  };
  if (f) {
    const toon = () => { if (vb) vb.textContent = bericht(); };
    f.addEventListener('input', toon); f.addEventListener('change', toon); toon();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31620949755?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
  }
</script>

