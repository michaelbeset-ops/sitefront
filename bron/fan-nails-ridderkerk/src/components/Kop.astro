---
import { url, waAfspraak, site } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<header class="sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-sm">
  <div class="wrap grid h-[4.5rem] grid-cols-[1fr_auto] items-center gap-6 md:grid-cols-[1fr_auto_1fr]">
    <a href={url('')} class="merk justify-self-start">
      <b>FAN NAILS</b><small>studio</small>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden md:block">
      <ul class="ui flex gap-8 lg:gap-10">
        <li><a href={h('behandelingen')} class="lijn-in">Behandelingen</a></li>
        <li><a href={h('werk')} class="lijn-in">Werk</a></li>
        <li><a href={h('studio')} class="lijn-in">Studio</a></li>
        <li><a href={h('contact')} class="lijn-in">Contact</a></li>
      </ul>
    </nav>
    <p class="ui flex items-center justify-end gap-8">
      <a href={site.telHref} class="lijn-in num hidden lg:inline">{site.tel}</a>
      <a href={waAfspraak} class="lijn-in">WhatsApp</a>
    </p>
  </div>
</header>
