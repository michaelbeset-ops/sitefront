---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waAfspraak, waMet } from '../data/site';
import studio from '../assets/studio.jpg';
import zaal from '../assets/zaal.jpg';
import pand from '../assets/pand.jpg';
import acryl from '../assets/acryl.jpg';
import biab from '../assets/biab.jpg';
import verlenging from '../assets/verlenging.jpg';
import french from '../assets/french.jpg';
import nailart from '../assets/nailart.jpg';
import pedicure from '../assets/pedicure.jpg';
import wGeel from '../assets/w-geel.jpg';
import wBlauw from '../assets/w-blauw.jpg';
import wStrass from '../assets/w-strass.jpg';
import wGroen from '../assets/w-groen.jpg';
import wRood from '../assets/w-rood.jpg';
import wKobalt from '../assets/w-kobalt.jpg';
import wCitroen from '../assets/w-citroen.jpg';
import wBruin from '../assets/w-bruin.jpg';
import wZilver from '../assets/w-zilver.jpg';

const vraag = (b: string) => waMet(`Hoi Fan Nails, ik wil graag een afspraak maken voor ${b.toLowerCase()}.`);

const behandelingen = [
  { t: 'Acrylnagels', d: 'Een nieuwe set of opvullen, van naturel tot lang.', src: acryl, alt: 'Amandelvormige nude nagels met gouden lijntjes, rode bloemetjes en een luipaardprint', pos: '50% 40%' },
  { t: 'Gellak en BIAB', d: 'Glans op je eigen nagels. Ook BIAB met chroom.', src: biab, alt: 'Roze nagels met een parelmoerachtige chroomglans', pos: '50% 45%' },
  { t: 'Nagelverlenging', d: 'Kunstnagels in de vorm en lengte die jij wilt.', src: verlenging, alt: 'Lange spitse nagels in glanzend donkerblauw en groen met een kattenoog-effect', pos: '50% 50%' },
  { t: 'French manicure', d: 'Klassiek wit, subtiel of juist in een felle kleur.', src: french, alt: 'Vierkante nagels met een felroze French-rand', pos: '50% 40%' },
  { t: 'Nail art', d: 'Bloemen, vlinders, strass of chroom: een ontwerp op maat.', src: nailart, alt: 'Nagels met geschilderde vlinders in zwart, blauw glitter en goud', pos: '50% 45%' },
  { t: 'Manicure en pedicure', d: 'Verzorgde handen en voeten, ook met kleur op je teennagels.', src: pedicure, alt: 'Teennagels gelakt in glanzend paars', pos: '50% 35%' },
];

const werk = [
  { src: wGeel, alt: 'Nude nagels met een gele French-rand en roze bloemetjes', groot: true },
  { src: wBlauw, alt: 'Nagels met kobaltblauwe bloemen, een blauwe French en gouden sterretjes' },
  { src: wGroen, alt: 'Spitse nagels met een groen-gele swirl, naast gouden ringen' },
  { src: wRood, alt: 'Rode nagels met zwarte lijnen en strass-steentjes' },
  { src: wStrass, alt: 'Petrolblauwe nagels met strass, op een roze pioenroos' },
  { src: wKobalt, alt: 'Blauwe nagels met dunne blauwe lijnen en glitter' },
  { src: wCitroen, alt: 'Amandelvormige nagels met een citroengele French-rand' },
  { src: wBruin, alt: 'Lange spitse nagels in glanzend chocoladebruin' },
  { src: wZilver, alt: 'Witte French-nagels met zilveren lijntjes en een nagel in zilverglitter' },
];

const stappen = [
  ['Stuur een appje', 'Laat weten wat je wilt laten doen en welke dag je uitkomt. Bellen mag natuurlijk ook.'],
  ['Neem je idee mee', 'Een voorbeeldfoto of alleen een kleur. We denken mee over vorm, lengte en design.'],
  ['Even voor jezelf', 'Je eigen bakje met vijltjes, en koffie of thee erbij. We nemen de tijd voor je.'],
  ['Blij naar huis', 'Tijd voor opvullen of iets nieuws? Stuur weer een appje.'],
];
---
<Base title={`${site.naam} | Nagelstudio in Ridderkerk`} description="Nagelstudio in Winkelcentrum De Ridderhof, Ridderkerk. Acryl, gellak en BIAB, nagelverlenging, nail art, manicure en pedicure. 4,7 op Google. Afspraak via WhatsApp.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen studio op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={studio} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1f151933_0%,#1f1519b3_45%,#1f1519f2_100%)] md:bg-[linear-gradient(90deg,#1f1519f2_0%,#1f1519cc_42%,#1f151933_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Nagelstudio in Ridderkerk</p>
          <h1 id="t-hero" class="mt-5 text-hero">Nagels precies <span class="text-roze">zoals jij</span> ze wilt.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Acryl, gellak en BIAB, nail art, manicure en pedicure. Op de begane grond van {site.centrum}.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-bes"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#werk" class="knop knop-rand op-foto">Bekijk ons werk</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za 9.00 tot 17.00 uur</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto w-full max-w-[19rem] rounded-lg bg-licht/10 p-2.5 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <Image src={acryl} alt="Nude nagels met gouden lijntjes en rode bloemetjes, gemaakt in de studio" widths={[320, 600]} sizes="300px" loading="eager" class="aspect-[4/5] w-full rounded-md object-cover" />
            <figcaption class="flex items-center justify-between gap-3 px-2 pb-1 pt-3 text-sm">
              <span>Recent werk uit de studio</span>
              <a href={site.telHref} class="num whitespace-nowrap font-semibold text-licht no-underline hover:text-roze">{site.tel}</a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Behandelingen in het kort">
      <div class="wrap flex items-center gap-x-6 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#behandelingen" class="shrink-0 rounded-full bg-blos px-4 py-2 text-sm font-medium no-underline transition-colors hover:bg-bes hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Behandelingen -->
    <section id="behandelingen" class="py-20 lg:py-24" aria-labelledby="t-beh">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Behandelingen</p>
            <h2 id="t-beh" class="mt-4 text-3xl">Van een strakke French tot nail art die je zelf bedenkt.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Kom met een voorbeeld of een idee. We denken mee over vorm, lengte en kleur.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {behandelingen.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-square sm:aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-4 sm:p-6">
                  <div>
                    <h3 class="text-[1.0625rem] hyphens-auto sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-full bg-blos sm:grid text-bes transition-colors group-hover:bg-bes group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-lg bg-blos px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Ook dip powder, nagels lakken en opvullen.</b> <span class="text-grijs">Prijs of beschikbaarheid? Stuur even een appje.</span></p>
          <a href={waAfspraak} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="wa" />Stel je vraag</a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Score op Google</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.04em] text-bes">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Google-reviews</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.04em]">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Dagen per week open</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.04em]">6</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Talen: Nederlands en Engels</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.04em]">2</dd></div>
      </dl>
    </section>

    <!-- 5. Werk -->
    <section id="werk" class="donker bg-nacht py-24 text-licht lg:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Ons werk</p>
            <h2 id="t-werk" class="mt-4 text-3xl">Iedere keer wat anders.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-licht-zacht">Een greep uit wat er de afgelopen tijd in de studio is gemaakt, van subtiel tot uitgesproken.</p>
            <a href={site.instagram} class="knop knop-rand knop-klein mt-6"><Icoon naam="insta" />Meer op Instagram</a>
          </div>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14 lg:grid-cols-6">
          {werk.map((w, i) => (
            <li class={`rijs relative overflow-hidden rounded-md bg-nacht-2 ${w.groot ? 'col-span-2 row-span-2 aspect-square md:aspect-auto' : 'aspect-square'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={w.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={w.groot ? '(min-width: 1248px) 400px, (min-width: 1024px) 33vw, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 190px, (min-width: 1024px) 16vw, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo gaat het</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van appje tot nieuwe nagels.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een afspraak maak je via WhatsApp of telefoon. De rest regelen we in de studio.</p>
        </div>
        <ol class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart p-5 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-lg font-extrabold text-bes">0{i + 1}</p>
              <h3 class="mt-5 text-[1.0625rem] hyphens-auto sm:mt-8 sm:text-xl">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. De studio -->
    <section id="studio" class="donker bg-nacht text-licht" aria-labelledby="t-studio">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[26rem] lg:col-span-5">
          <Image src={zaal} alt="De studio: witte nageltafels met lampen, een lichte vloer, een bank en planten bij het raam" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
          <p class="absolute bottom-4 left-4 rounded-full bg-bes px-4 py-1.5 text-sm font-semibold text-wit">{site.centrum}</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-20 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">De studio</p>
          <h2 id="t-studio" class="mt-4 text-3xl">De trendy nagelstudio van Ridderkerk.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Fan Nails Studio zit op de begane grond van {site.centrum}, aan het Sint Jorisplein. Een lichte studio met nageltafels en pedicurestoelen, en een team dat de tijd voor je neemt. In het Nederlands of in het Engels.</p>
          <ul class="mt-8 grid gap-3 xl:grid-cols-1">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-bes text-wit"><Icoon naam="bakje" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Eigen bakje per klant</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Met je eigen vijltjes. Hygiëne komt in de reviews steeds terug.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-bes text-wit"><Icoon naam="kop" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Koffie of thee staat klaar</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Even zitten en bijpraten. Vaste klanten noemen het gezellig.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-bes text-wit"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">We denken met je mee</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Ook als je iets bijzonders wilt. Geen ontwerp is ons te gek.</p></div>
            </li>
          </ul>
          <a href={waAfspraak} class="knop knop-bes mt-8"><Icoon naam="wa" />Plan je afspraak</a>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="bg-blos py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-extrabold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-blos font-kop font-bold text-bes" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <!-- 9. Openingstijden en locatie -->
    <section id="route" class="py-20 lg:py-24" aria-labelledby="t-route">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Openingstijden en route</p>
          <h2 id="t-route" class="mt-4 text-3xl">Kom langs in De Ridderhof.</h2>
          <p class="mt-6 text-lg text-grijs">Op de begane grond van het winkelcentrum, aan het Sint Jorisplein.</p>
          <div class="kaart mt-10 p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Openingstijden</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za open</span></p>
            </div>
            <table class="mt-4 w-full">
              <caption class="sr-only">Openingstijden van de studio</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-bes">
                    <th scope="row" class="py-2.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="flex flex-col gap-5 lg:col-span-7">
          <figure class="relative flex-1 overflow-hidden rounded-lg">
            <Image src={pand} alt="De winkelpui van Fan Nails Studio met het uithangbord, de deuren open en de studio erachter" widths={[600, 900, 1300]} sizes="(min-width: 1248px) 700px, (min-width: 1024px) 56vw, 92vw" class="h-full min-h-[18rem] w-full object-cover" />
          </figure>
          <div class="kaart flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-bes" /><span><b class="font-semibold">{site.straat}</b><br /><span class="text-grijs">{site.postcode} {site.plaats}, {site.centrum}</span></span></p>
            <a href={site.maps} class="knop knop-inkt knop-klein shrink-0">Route plannen<Icoon naam="pijl" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Contact: WhatsApp-bericht samenstellen -->
    <section id="contact" class="bg-blos py-20 lg:py-24" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Afspraak maken</p>
