<script>
  // Projectfilter
  const knoppen = document.querySelectorAll<HTMLButtonElement>('[data-filters] [data-cat]');
  const items = document.querySelectorAll<HTMLElement>('[data-projecten] > li');
  knoppen.forEach((k) => k.addEventListener('click', () => {
    const c = k.dataset.cat;
    knoppen.forEach((b) => b.setAttribute('aria-pressed', String(b === k)));
    items.forEach((li) => { li.hidden = c !== 'alles' && li.dataset.cat !== c; li.classList.toggle('vlak', c !== 'alles'); });
  }));

  // Lichtbak
  const data: { t: string; cat: string; fotos: string[] }[] = JSON.parse(document.getElementById('lb-data')?.textContent || '[]');
  const dlg = document.querySelector<HTMLDialogElement>('[data-lichtbak]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  let p = 0, n = 0;
  const toon = () => {
    if (!dlg || !img) return;
    const pr = data[p];
    img.src = pr.fotos[n];
    img.alt = `${pr.t}, foto ${n + 1} van ${pr.fotos.length}`;
    dlg.querySelector('[data-lb-titel]')!.textContent = pr.t;
    dlg.querySelector('[data-lb-cat]')!.textContent = pr.cat;
    dlg.querySelector('[data-lb-teller]')!.textContent = `${n + 1} / ${pr.fotos.length}`;
  };
  const stap = (d: number) => { n = (n + d + data[p].fotos.length) % data[p].fotos.length; toon(); };
  document.querySelectorAll<HTMLButtonElement>('[data-project]').forEach((b) => b.addEventListener('click', () => { p = Number(b.dataset.project); n = 0; toon(); dlg?.showModal(); }));
  dlg?.querySelector('[data-lb-dicht]')?.addEventListener('click', () => dlg.close());
  dlg?.querySelector('[data-lb-vorige]')?.addEventListener('click', () => stap(-1));
  dlg?.querySelector('[data-lb-volgende]')?.addEventListener('click', () => stap(1));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') stap(-1); if (e.key === 'ArrowRight') stap(1); });
  let x0 = 0;
  img?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  img?.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) stap(dx < 0 ? 1 : -1); });

  // Offerteformulier: bericht samenstellen, niets wordt automatisch verstuurd.
  const form = document.querySelector<HTMLFormElement>('[data-offerte]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const via = (e.submitter as HTMLButtonElement | null)?.value || 'wa';
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) || '').trim();
    const klus = d.getAll('klus').map(String);
    const r = ['Goedendag Gertjan, ik wil graag een offerte aanvragen.'];
    if (klus.length) r.push('Soort klus: ' + klus.join(', '));
    if (v('voor')) r.push('Voor: ' + v('voor').toLowerCase());
    if (v('plaats')) r.push('Plaats: ' + v('plaats'));
    if (v('maat')) r.push('Omvang: ' + v('maat'));
    if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
    if (v('wens')) r.push('Toelichting: ' + v('wens'));
    if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam'));
    const tekst = r.join('\n');
    if (via === 'mail') window.location.href = 'mailto:info@gertjanoudshoorn.nl?subject=' + encodeURIComponent('Offerteaanvraag' + (klus.length ? ': ' + klus.join(', ') : '')) + '&body=' + encodeURIComponent(tekst);
    else window.open('https://wa.me/31654994512?text=' + encodeURIComponent(tekst), '_blank', 'noopener');
  });
</script>

