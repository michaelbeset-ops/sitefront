---
import { site, url, chips, waVraag } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Familiebedrijf uit {site.plaats}, in de Alblasserwaard. Agrarisch loonwerk, grondverzet en kraanverhuur sinds 1961.</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Werkzaamheden</p>
      <ul class="mt-4 space-y-2">
        {chips.slice(0, 7).map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-geel">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-geel">{site.tel}</a></li>
        <li><a href={waVraag} class="no-underline transition-colors hover:text-geel">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-geel">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-2">
      <p class="font-semibold text-licht">Bedrijfsgegevens</p>
      <ul class="mt-4 space-y-2">
        <li>{site.officieel}</li>
        <li class="num">KvK {site.kvk}</li>
        <li><a href={site.docs.wka} class="no-underline transition-colors hover:text-geel">WKA-verklaring</a></li>
        <li><a href={site.docs.kvk} class="no-underline transition-colors hover:text-geel">KvK-uittreksel</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.officieel}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-geel">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s en geschiedenis van uw eigen website loonbedrijfdonk.nl, ter illustratie.</p>}
  </div>
</footer>
