---
// Woordmerk naar de belettering op hun kraan: graafmachine-teken, "T. DONK" en de band "Loonbedrijf · Kraanverhuur".
import { site, url } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class={`merk ${cls}`} aria-label={`${site.naam}, naar de homepage`}>
  <span class="merk-teken" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="17" width="12" height="3.6" rx="1.8"/><path d="M3.5 17v-4.5h3.2L8 9.5h3.5V17"/><path d="M11.5 12.5 16 5l4.5 3.5"/><path d="m20.5 8.5-.3 4.2-2.7.8"/></svg>
  </span>
  <span><b>T. DONK</b><small>Loonbedrijf · Kraanverhuur</small></span>
</a>
