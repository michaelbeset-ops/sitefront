<script>
  // Projecten: filter, "toon alle" en fotodialoog.
  const lijst = document.querySelector<HTMLElement>('[data-projecten]');
  const meer = document.querySelector<HTMLButtonElement>('[data-meer]');
  const knoppen = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  let alles = false;
  const toon = (k: string) => {
    lijst?.querySelectorAll<HTMLElement>('.project').forEach((li) => {
      const past = k === 'alle' || (li.dataset.tags || '').split(' ').includes(k);
      li.hidden = !past || (k === 'alle' && !alles && li.hasAttribute('data-extra'));
    });
    if (meer) meer.parentElement!.hidden = k !== 'alle' || alles;
  };
  knoppen.forEach((b) => b.addEventListener('click', () => { knoppen.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); toon(b.dataset.filter!); }));
  meer?.addEventListener('click', () => { alles = true; toon('alle'); });
  toon('alle');
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement)?.showModal()));
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((d) => {
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    d.querySelectorAll('[data-sluit]').forEach((s) => s.addEventListener('click', () => d.close()));
  });

  // Dakvraag: keuzes samenvoegen tot een bericht voor WhatsApp of e-mail.
  const f = document.querySelector<HTMLFormElement>('[data-dakvraag]');
  if (f) {
    const voorbeeld = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
    const voortgang = f.querySelector<HTMLElement>('[data-voortgang]')!;
    const mail = f.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const bericht = () => {
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Goedendag Berry, ik heb een vraag over mijn dak.'];
      if (v('soort')) r.push('Soort dak: ' + v('soort'));
      if (v('kwestie')) r.push('Het gaat om: ' + v('kwestie'));
      if (v('tempo')) r.push('Wanneer: ' + v('tempo'));
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      const klaar = ['soort', 'kwestie', 'tempo'].filter((n) => v(n)).length + (v('plaats') || v('naam') ? 1 : 0);
      voortgang.textContent = `${klaar} van 4`;
      return r.join('\n');
    };
    const ververs = () => { const t = bericht(); voorbeeld.textContent = t; mail.href = `mailto:info@langedak.nl?subject=${encodeURIComponent('Dakvraag via de website')}&body=${encodeURIComponent(t)}`; };
    f.addEventListener('input', ververs);
    f.addEventListener('change', ververs);
    f.addEventListener('submit', (e) => { e.preventDefault(); window.open('https://wa.me/31642286632?text=' + encodeURIComponent(bericht()), '_blank', 'noopener'); });
    document.querySelectorAll<HTMLAnchorElement>('[data-kies]').forEach((a) => a.addEventListener('click', () => {
      const r = f.querySelector<HTMLInputElement>(`input[name=soort][value="${a.dataset.kies}"]`);
      if (r) { r.checked = true; ververs(); }
    }));
    ververs();
  }
</script>

