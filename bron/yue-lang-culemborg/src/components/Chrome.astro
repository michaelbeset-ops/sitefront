---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-washi/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="flex min-w-0 items-center gap-2.5 no-underline">
        <span class="size-3.5 shrink-0 rounded-full bg-hinomaru" aria-hidden="true"></span>
        <span class="font-display text-xl font-extrabold leading-none">Yue Lang</span>
        <span class="hidden text-xs font-bold uppercase tracking-[0.14em] text-ink-soft sm:inline">Japans restaurant</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-medium">
          <li><a href={url('#concept')} class="no-underline transition-colors hover:text-hinomaru">All you can eat</a></li>
          <li><a href={url('#bezorgen')} class="no-underline transition-colors hover:text-hinomaru">Bezorgen en afhalen</a></li>
          <li><a href={url('#contact')} class="no-underline transition-colors hover:text-hinomaru">Reserveren</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-rood shrink-0 !px-4 !py-2 text-sm">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
        <span class="sm:hidden">Bel</span><span class="hidden sm:inline num">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="op-donker border-t border-white/10 bg-sumi py-10 text-washi/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-washi">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK <span class="text-washi/70">[[AANLEVEREN: KvK-nummer]]</span></p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
