---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site, url } from '../data/site';
---
<Base title={`Privacyverklaring | ${site.naam}`} description={`Hoe ${site.naam} omgaat met uw gegevens.`}>
  <Chrome deel="kop" />
  <main id="inhoud" class="wrap max-w-3xl py-14 lg:py-20">
    <p><a href={url('')} class="underline underline-offset-2">Terug naar de homepage</a></p>
    <h1 class="mt-4 text-3xl">Privacyverklaring</h1>
    <div class="mt-8 space-y-6">
      <section>
        <h2 class="text-xl">Wie wij zijn</h2>
        <p class="mt-2">{site.naam}, {site.straat}, {site.postcode} {site.plaats}. Telefoon: <a href={site.telHref} class="underline">{site.tel}</a>. E-mail: <span class="text-xs text-ink-soft">[[AANLEVEREN: e-mailadres]]</span>. KvK <span class="text-xs text-ink-soft">[[AANLEVEREN: KvK-nummer]]</span>.</p>
      </section>
      <section>
        <h2 class="text-xl">Welke gegevens</h2>
        <p class="mt-2">Als u belt om te reserveren of een bestelling door te geven, krijgen wij uw naam, telefoonnummer en uw wensen. Die gebruiken we alleen om uw reservering of bestelling af te handelen. Online bestellen voor bezorging gaat via een aparte website; daar geldt de privacyverklaring van die dienst.</p>
      </section>
      <section>
        <h2 class="text-xl">Hoe lang</h2>
        <p class="mt-2">We bewaren uw gegevens niet langer dan nodig. <span class="text-xs text-ink-soft">[[AANLEVEREN: bevestiging bewaartermijn]]</span></p>
      </section>
      <section>
        <h2 class="text-xl">Cookies</h2>
        <p class="mt-2">Deze website plaatst geen cookies en gebruikt geen statistieken, advertenties of ingesloten kaarten. Daarom ziet u ook geen cookiemelding. Links naar andere diensten, zoals Google Maps of de bestelsite, openen een aparte pagina van die dienst.</p>
      </section>
      <section>
        <h2 class="text-xl">Uw rechten</h2>
        <p class="mt-2">U mag altijd vragen welke gegevens wij van u hebben, en vragen om ze aan te passen of te verwijderen. Neem daarvoor contact op via {site.tel}. Bent u het niet eens met hoe wij met uw gegevens omgaan, dan kunt u een klacht indienen bij de Autoriteit Persoonsgegevens.</p>
      </section>
    </div>
  </main>
  <Chrome deel="voet" />
</Base>
