---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, prijzen } from '../data/site';
import hero from '../assets/hero.jpg';
import mes from '../assets/mes.jpg';
import teppanyaki from '../assets/teppanyaki.jpg';
import rollen from '../assets/rollen.jpg';

const bel = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
---
<Base
  title="Yue Lang Japans Restaurant Culemborg | All you can eat, bezorgen en afhalen"
  description="Japans restaurant in het historische centrum van Culemborg. All you can eat vanaf € 37,50 p.p. met sushi, teppanyaki, tempura en noodles. Ook bezorgen en afhalen. Reserveren via 0345 779 159."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: het concept en de prijzen meteen zichtbaar, want dat was precies wat op de oude site ontbrak. -->
    <section class="op-donker relative isolate overflow-hidden bg-sumi text-washi">
      <div class="absolute inset-0 -z-10 lg:left-[52%]">
        <Foto src={hero} alt="Sushichef in wit tenue vormt nigiri met de hand achter een houten bar met messen en een vitrine met vis" hero sizes="(min-width: 1024px) 48vw, 100vw" class="object-[62%_center]" />
        <div class="absolute inset-0 bg-sumi/80 lg:bg-transparent lg:bg-linear-to-r lg:from-sumi lg:via-sumi/10 lg:to-transparent"></div>
      </div>
      <div class="wrap grid grid-cols-1 lg:grid-cols-12">
        <div class="min-w-0 py-14 sm:py-20 lg:col-span-6 lg:py-28 lg:pr-10">
          <p class="label text-matcha-light">Japans restaurant in Culemborg</p>
          <h1 class="mt-4 text-4xl">Onbeperkt Japans eten, voor één vaste prijs</h1>
          <p class="mt-5 max-w-xl text-lg text-washi/90">Bij all you can eat betaalt u per persoon en geniet u onbeperkt van de uitgebreide menukaart. Van sushi tot teppanyaki, van tempura tot noodles.</p>

          <dl class="mt-8 max-w-xl divide-y divide-washi/20 border-y border-washi/20">
            {prijzen.map((p) => (
              <div class="flex items-baseline justify-between gap-4 py-3">
                <dt class="text-washi/90">{p.wanneer}</dt>
                <dd class="num font-display text-xl font-extrabold">{p.prijs}<span class="ml-1 font-body text-xs font-medium text-washi/75">p.p.</span></dd>
              </div>
            ))}
          </dl>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-rood sm:text-lg">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor"><path d={bel} /></svg>
              Reserveer: <span class="num">{site.tel}</span>
            </a>
            <a href="#bezorgen" class="btn btn-lijn">Bezorgen of afhalen</a>
          </div>
          <p class="mt-5 max-w-xl text-sm text-washi/80">Reserveren is gewenst en kan alleen telefonisch. U kunt bellen vanaf <span class="num">13:00</span> uur. <strong class="text-washi">4,3</strong> op Google (387 reviews).</p>
        </div>
      </div>
    </section>

    <!-- Wat er op tafel komt: grote woorden links, twee foto's verspringend rechts. -->
    <section id="concept" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-matcha">Op de kaart</p>
          <h2 class="mt-3 text-3xl">Van sushi tot teppanyaki, zoveel u wilt</h2>
          <p class="mt-5 text-ink-soft">Yue Lang is gespecialiseerd in verse sushi en Japanse gerechten. Er wordt alleen met verse producten gewerkt.</p>
          <ol class="mt-8 border-t border-line">
            {['Sushi', 'Teppanyaki', 'Tempura', 'Noodles'].map((g, i) => (
              <li class="flex items-baseline gap-5 border-b border-line py-3">
                <span class="num w-6 text-xs font-bold text-hinomaru">0{i + 1}</span>
                <span class="font-display text-2xl font-semibold">{g}</span>
              </li>
            ))}
          </ol>
          <a href={site.menukaart} rel="noopener" class="mt-8 inline-block font-bold underline decoration-hinomaru decoration-2 underline-offset-4 hover:text-hinomaru">Bekijk de menukaart (pdf)</a>
        </div>
        <div class="grid grid-cols-6 gap-4 lg:col-span-7">
          <div class="col-span-6 aspect-[3/2] overflow-hidden rounded-sm sm:col-span-4"><Foto src={mes} alt="Close-up van een mes dat door een stuk rauwe tonijn snijdt op een houten plank" sizes="(min-width: 1024px) 440px, (min-width: 640px) 66vw, 100vw" /></div>
          <div class="col-span-6 aspect-[3/2] overflow-hidden rounded-sm sm:col-span-4 sm:col-start-3 sm:-mt-16 lg:-mt-24"><Foto src={teppanyaki} alt="Kok strooit zout over twee stukken vlees op een teppanyaki-bakplaat" sizes="(min-width: 1024px) 440px, (min-width: 640px) 66vw, 100vw" /></div>
        </div>
      </div>

      <ul class="mt-16 grid gap-8 border-t border-sumi pt-8 md:grid-cols-3 lg:mt-24">
        <li>
          <h3 class="text-xl">Geen sushiliefhebber?</h3>
          <p class="mt-2 text-ink-soft">Op de kaart staat genoeg keuze, ook voor wie geen sushi eet en voor vegetariërs.</p>
        </li>
        <li>
          <h3 class="text-xl">Halal</h3>
          <p class="mt-2 text-ink-soft">De gerechten zijn halal, met één uitzondering: nr. 70, de gyoza.</p>
        </li>
        <li>
          <h3 class="text-xl">Met kinderen</h3>
          <p class="mt-2 text-ink-soft">Kinderen van 4 t/m 11 jaar eten mee voor <span class="num">€ 18,50</span> per persoon.</p>
          <p class="mt-2 text-xs text-ink-soft">[[AANLEVEREN: prijs voor kinderen onder 4 jaar, en of er een tijdslimiet of aantal rondes geldt]]</p>
        </li>
      </ul>
    </section>

    <!-- Het restaurant: foto links, verhaal rechts, op een iets donkerder papier. -->
    <section class="bg-kinu py-16 lg:py-28">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12">
        <div class="aspect-[4/3] overflow-hidden rounded-sm lg:col-span-6"><Foto src={rollen} alt="Kok met eetstokjes en een zwart schaaltje achter een lange, sfeervol verlichte bar" sizes="(min-width: 1024px) 560px, 100vw" class="object-[35%_center]" /></div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="label text-matcha">Het restaurant</p>
          <h2 class="mt-3 text-3xl">In het historische centrum van Culemborg</h2>
          <div class="mt-5 space-y-4 text-ink-soft">
            <p>Yue Lang zit aan de Tollenstraat, midden in het historische centrum. Binnen is het gezellig, met een warme uitstraling, comfortabele stoelen en grote foto's van Japan aan de muren.</p>
            <p>Iets te vieren, of gewoon geen zin om te koken? Sushi en de andere Japanse gerechten kunt u ook afhalen of laten bezorgen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bezorgen en afhalen: twee kolommen met tijden, zonder poespas. -->
    <section id="bezorgen" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="max-w-2xl">
        <p class="label text-matcha">Thuis eten</p>
        <h2 class="mt-3 text-3xl">Bezorgen of afhalen</h2>
      </div>
      <div class="mt-12 grid gap-12 lg:grid-cols-12">
        <div class="rounded-sm bg-white p-6 shadow-[0_1px_2px_#14141418] ring-1 ring-line md:p-8 lg:col-span-7">
          <h3 class="text-2xl">Bezorgen</h3>
          <dl class="mt-5 divide-y divide-line border-y border-line">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3"><dt>Culemborg en Beusichem</dt><dd class="num font-bold">16:30 tot 21:00 uur</dd></div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3"><dt>Geldermalsen</dt><dd class="num font-bold">17:00 tot 20:00 uur</dd></div>
          </dl>
          <ul class="mt-5 space-y-1.5 text-ink-soft">
            <li>Gratis bezorgd vanaf <span class="num font-bold text-sumi">€ 25,00</span></li>
            <li>Daaronder betaalt u <span class="num font-bold text-sumi">€ 2,50</span> bezorgkosten</li>
            <li>Minimaal bestelbedrag <span class="num font-bold text-sumi">€ 20,00</span>; bestelt u minder, dan kunt u het afhalen</li>
          </ul>
          <a href={site.bezorgen} rel="noopener" class="btn btn-rood mt-7">Bestel online</a>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <h3 class="text-2xl">Afhalen</h3>
          <p class="mt-5 text-ink-soft">Geef uw bestelling telefonisch door en haal hem op aan de Tollenstraat 8.</p>
          <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-4 border-y border-line py-3"><span class="text-ink-soft">Afhalen</span> <span class="num font-bold">16:30 tot 21:00 uur</span></div>
          <a href={site.telHref} class="btn btn-lijn mt-7">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0" fill="currentColor"><path d={bel} /></svg>
            Bel <span class="num">{site.tel}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Reserveren en contact: donker vlak, het nummer zo groot mogelijk. -->
    <section id="contact" class="op-donker scroll-mt-20 bg-sumi py-16 text-washi lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="label text-matcha-light">Reserveren</p>
          <h2 class="mt-3 text-3xl">Een tafel reserveert u telefonisch</h2>
          <a href={site.telHref} class="num mt-8 block font-display text-3xl font-extrabold underline decoration-hinomaru-light decoration-2 underline-offset-8">{site.tel}</a>
          <p class="mt-4 text-washi/80">Reserveren is gewenst en kan alleen telefonisch. U kunt bellen vanaf <span class="num">13:00</span> uur.</p>
          <a href={site.telHref} class="btn btn-rood mt-8 sm:text-lg">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor"><path d={bel} /></svg>
            Bel om te reserveren
          </a>
        </div>
        <div class="grid content-start gap-10 sm:grid-cols-2 lg:col-span-5 lg:col-start-8 lg:grid-cols-1">
          <div>
            <h3 class="text-xl">Openingstijden</h3>
            <dl class="mt-4 divide-y divide-washi/15 border-y border-washi/15">
              <div class="flex flex-wrap justify-between gap-x-4 py-2.5"><dt>Maandag</dt><dd>gesloten</dd></div>
              <div class="flex flex-wrap justify-between gap-x-4 py-2.5"><dt>Dinsdag t/m zondag</dt><dd class="num">vanaf 16:00 uur</dd></div>
            </dl>
            <p class="mt-3 text-xs text-washi/75">[[AANLEVEREN: sluitingstijd per dag]]</p>
          </div>
          <div>
            <h3 class="text-xl">Adres en parkeren</h3>
            <address class="mt-4 not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
            <p class="mt-3 text-washi/80">Op 30 meter kunt u parkeren op de Lange Meent (betaald) of bij Palumbus (gratis).</p>
            <a href={site.maps} rel="noopener" class="btn btn-lijn mt-5">Route plannen</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
