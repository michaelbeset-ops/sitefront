---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, mailMet, tijden } from '../data/site';
import w1971 from '../assets/werkbank-1971.jpg';
import w2007 from '../assets/werkbank-2007.jpg';
import bootkap from '../assets/bootkap-blauw.jpg';
import veranda from '../assets/verandazeil.jpg';
import luifel from '../assets/luifel-bus.jpg';
import rib from '../assets/rib-zeilmakerij.jpg';

// Letterlijk van hun pagina "Onze diensten".
const wel = [
  'Boottenten', 'bootkappen', 'railingzeilen', 'zeilhuiken', 'hoezen',
  'bungalowtenten', 'caravantenten', 'luifels', 'vouwwagententen',
  'golfkartenten', 'raamzeilen', 'overkappingszeilen', 'winterkleden', 'marktzeilen', 'afdekhoezen',
];
const niet = ['vrachtwagenzeilen', 'autobekleding', "cabriokappen van auto's"];

// Het jaar van de zeilmaker, naar hun eigen uitleg: na het seizoen en in de winter is er meer tijd.
const maanden = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
const rustig = [true, true, false, false, false, false, false, false, false, true, true, true];

const mailFoto = mailMet('Reparatie: foto van de schade', 'Goedendag,\n\nIn de bijlage een foto van de schade aan mijn [zeil / tent / kap / hoes].\n\nNaam:\nTelefoon:\n');
const mailWinter = mailMet('Winterklus inplannen', 'Goedendag,\n\nIk wil deze winter graag laten doen: [afdekzeil vermaken / ritsen vervangen / nieuwe ramen in de buiskap of tent].\n\nNaam:\nTelefoon:\n');
---
<Base title={`${site.volledig} | Reparatie van zeilen, kappen en tenten`} description="Zeilmakerij Capel aan De Steiger 7c in Almere repareert boottenten, bootkappen, hoezen, caravantenten, luifels en zeilen. Bel 036 534 88 12.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- Eerste scherm: de werkbank in 1971, de zoom van een dekzeil als naad, en het nummer. -->
    <section class="relative lg:grid lg:h-[calc(100svh-4.5rem-2.25rem)] lg:min-h-[38rem] lg:max-h-[56rem] lg:grid-cols-[minmax(0,1fr)_46px_minmax(0,1fr)]">
      <div class="wrap pb-6 pt-7 lg:hidden">
        <h1 class="text-[2.6rem] leading-[.95]">Zeil gescheurd? Tent lek?<br /><span class="text-zeil">Wij naaien het.</span></h1>
      </div>
      <figure class="relative h-[16.5rem] sm:h-[26rem] lg:h-full">
        <Foto src={w1971} alt="Zwart-witfoto uit 1971: de zeilmaker aan zijn naaimachine in de werkplaats" hero sizes="(min-width: 1024px) 50vw, 100vw" class="object-[66%_45%]" />
        <figcaption class="slab lining-nums absolute bottom-3 left-5 text-[2.4rem] font-bold leading-none text-white lg:bottom-8 lg:left-10 lg:text-[5.5rem]" style="text-shadow:0 2px 18px #0006">1971</figcaption>
      </figure>
      <div class="zoom lg:hidden" aria-hidden="true"></div>
      <div class="zoom-v hidden lg:block" aria-hidden="true"></div>
      <div class="flex flex-col justify-center px-5 pb-8 pt-6 sm:px-12 lg:px-14 lg:py-12 xl:px-20">
        <h1 class="hidden text-[clamp(3.4rem,5.2vw,5.3rem)] leading-[.93] lg:block">Zeil gescheurd?<br />Tent lek?<br /><span class="text-zeil">Wij naaien het.</span></h1>
        <div class="lg:mt-14">
          <p class="max-w-[30rem] text-lg leading-relaxed text-staal">Boottenten, kappen, hoezen, voortenten en zeilen: al meer dan veertig jaar repareren wij ze aan De Steiger in Almere.</p>
          <div class="mt-6 flex flex-wrap items-end gap-x-8 gap-y-3 lg:mt-9">
            <p class="leading-tight">
              <span class="block text-sm text-staal">Bel ons, ma t/m vr 9.00 - 12.00 en 13.30 - 16.00</span>
              <a href={site.telHref} class="nummer mt-1 inline-block whitespace-nowrap text-[2.2rem] tabular-nums lining-nums lg:text-[2.9rem]">{site.tel}</a>
            </p>
            <a href={mailFoto} class="lijn pb-2 text-[1.05rem]">of mail ons een foto van de schade</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Wat wij wel en niet repareren, letterlijk hun lijst, met hun eigen werk ernaast. -->
    <section id="repareren" class="scroll-mt-4 border-t border-lijn py-20 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <h2 class="text-2xl">Wat wij repareren</h2>
          <p class="slab mt-7 text-[1.6rem] font-medium leading-[1.3] lg:text-[1.95rem]">
            {wel.map((w, i) => (<Fragment><span class="whitespace-nowrap">{w}</span>{i < wel.length - 1 ? <span class="text-zeil">, </span> : '.'}</Fragment>))}
          </p>
          <div class="steek mt-9 pt-6 text-staal">
            <p><span class="font-semibold text-inkt">Niet:</span> {niet.join(', ')}.</p>
            <p class="mt-3">Een boot op de trailer rijdt u bij ons gewoon naar binnen.</p>
          </div>
        </div>
        <div class="grid grid-cols-6 gap-3 lg:col-span-7 lg:gap-4">
          <figure class="col-span-6">
            <div class="aspect-[16/10] overflow-hidden"><Foto src={bootkap} alt="Blauwe kap op maat over een kajuitbootje op de trailer" sizes="(min-width: 1024px) 55vw, 100vw" /></div>
            <figcaption class="mt-2 text-sm text-staal">Kap op maat voor een kajuitbootje</figcaption>
          </figure>
          <figure class="col-span-3">
            <div class="aspect-[4/3] overflow-hidden"><Foto src={veranda} alt="Tuinhuis met verandazeilen met grote ramen" sizes="(min-width: 1024px) 28vw, 50vw" /></div>
            <figcaption class="mt-2 text-sm text-staal">Verandazeilen</figcaption>
          </figure>
          <figure class="col-span-3">
            <div class="aspect-[4/3] overflow-hidden"><Foto src={luifel} alt="Busje met een witte luifel met blauwe banen" sizes="(min-width: 1024px) 28vw, 50vw" class="object-[50%_60%]" /></div>
            <figcaption class="mt-2 text-sm text-staal">Luifel</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- De winterklus: het jaar als strook, de huidige maand gemarkeerd. -->
    <section id="winter" class="op-zeil scroll-mt-4 bg-zeil text-white">
      <div class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:gap-10 lg:py-24">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Grote klussen? Liefst in de winter.</h2>
          <p class="mt-6 max-w-[32rem] text-lg leading-relaxed text-[#dfe6f6]">Afdekzeilen vermaken, ritsen vervangen, nieuwe ramen in de buiskap of tent: na het zeilseizoen hebben wij er meer tijd voor, en het is voordeliger.</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-3">
          <ol class="grid grid-cols-12 gap-1" aria-label="Het jaar van de zeilmaker">
            {maanden.map((m, i) => (
              <li class="maand flex flex-col items-center gap-2" data-i={i}>
                <span class={`block h-24 w-full sm:h-32 ${rustig[i] ? 'bg-white' : 'border border-[#ffffff66]'}`}></span>
                <span class="text-[.7rem] sm:text-xs">{m}</span>
                <span class="nu-stip h-1.5 w-1.5 rounded-full bg-white opacity-0"></span>
              </li>
            ))}
          </ol>
          <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-[#dfe6f6]">
            <span class="flex items-center gap-2"><span class="inline-block h-3 w-3 bg-white"></span>meer tijd voor u</span>
            <span class="flex items-center gap-2"><span class="inline-block h-3 w-3 border border-[#ffffff99]"></span>voor en in het seizoen</span>
          </div>
          <p class="slab mt-8 text-[1.6rem] font-medium leading-snug" id="nu-tekst" aria-live="polite">Het is oktober: het seizoen loopt af. Een goed moment om uw spullen te laten nakijken.</p>
          <p class="mt-5"><a href={mailWinter} class="lijn text-lg">Mail ons uw winterklus</a> <span class="text-[#dfe6f6]">of bel</span> <a href={site.telHref} class="lijn whitespace-nowrap text-lg tabular-nums lining-nums">{site.tel}</a></p>
        </div>
      </div>
    </section>

    <!-- 2007: hetzelfde ambacht, en hoe ze werken. -->
    <section class="py-20 lg:py-28">
      <div class="wrap grid items-end gap-10 lg:grid-cols-12">
        <figure class="lg:col-span-7">
          <div class="aspect-[4/3] overflow-hidden"><Foto src={w2007} alt="De zeilmaker in 2007 aan een industriële naaimachine met blauw garen" sizes="(min-width: 1024px) 58vw, 100vw" /></div>
          <figcaption class="slab lining-nums mt-3 text-xl font-bold">2007</figcaption>
        </figure>
        <div class="lg:col-span-4 lg:col-start-9 lg:pb-14">
          <h2 class="text-2xl">Eerst bellen, dan pas naaien.</h2>
          <p class="mt-6 leading-relaxed text-staal">Valt een reparatie duurder uit dan verwacht, dan nemen wij eerst contact met u op. Wij nemen de tijd om uw wensen door te nemen. Zo zijn we gegroeid: via mond-tot-mondreclame.</p>
        </div>
      </div>
    </section>

    <!-- De Steiger 7c: hun eigen pand met het bord, tijden en route. -->
    <section id="steiger" class="scroll-mt-4 border-t border-lijn bg-white">
      <div class="grid lg:grid-cols-2">
        <figure class="aspect-[4/3] lg:aspect-auto">
          <Foto src={rib} alt="Rubberboot met rode kap op de trailer voor het bord van Zeilmakerij P.J. Capel" sizes="(min-width: 1024px) 50vw, 100vw" class="object-[40%_50%]" />
        </figure>
        <div class="px-5 py-16 sm:px-12 lg:px-16 lg:py-24">
          <h2 class="text-3xl">De Steiger 7c</h2>
          <p class="mt-2 text-lg text-staal">{site.postcode} {site.plaats}</p>
          <dl class="mt-10 max-w-md">
            {tijden.map(([d, t]) => (
              <div class="steek flex justify-between gap-6 py-3"><dt>{d}</dt><dd class="text-right tabular-nums lining-nums text-staal">{t}</dd></div>
            ))}
          </dl>
          <div class="mt-10 space-y-3 text-lg">
            <p><a href={site.telHref} class="nummer whitespace-nowrap text-[2rem] tabular-nums lining-nums">{site.tel}</a></p>
            <p><a href={`mailto:${site.mail}`} class="lijn break-all">{site.mail}</a></p>
            <p><a href={site.maps} class="lijn">Route in Google Maps</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />

  <script>
    // Markeer de huidige maand in de jaarstrook en zeg wat dat betekent, in hun eigen woorden.
    const namen = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
    const m = new Date().getMonth();
    const li = document.querySelector<HTMLElement>(`.maand[data-i="${m}"]`);
    li?.querySelector('.nu-stip')?.classList.remove('opacity-0');
    li?.setAttribute('aria-current', 'date');
    const t = document.getElementById('nu-tekst');
    if (t) {
      const n = namen[m];
      t.textContent =
        m === 9 ? `Het is ${n}: het seizoen loopt af. Een goed moment om uw spullen te laten nakijken.` :
        m >= 10 || m <= 1 ? `Het is ${n}: nu hebben wij de tijd voor de grote klussen.` :
        m <= 3 ? `Het is ${n}: het seizoen komt eraan. Wacht niet te lang met uw reparatie.` :
        `Het is ${n}, midden in het seizoen. Wij helpen u zo snel mogelijk, ook in de drukte.`;
    }
  </script>
</Base>
