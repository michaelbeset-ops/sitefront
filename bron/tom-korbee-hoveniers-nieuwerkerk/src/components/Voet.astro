---
import { site, url, tijden, waVraag } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const diensten = [['diensten', 'Tuinontwerp'], ['diensten', 'Tuinaanleg en renovatie'], ['onderhoud', 'Tuinonderhoud'], ['diensten', 'Boomverzorging'], ['projecten', 'Projecten'], ['reviews', 'Referenties']];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <span class="merk-teken bg-nacht-2" aria-hidden="true"><Icoon naam="blad" class="h-5 w-5" /></span>
        <span><b>Tom Korbee</b><small>Hoveniers</small></span>
      </a>
      <p class="mt-6 max-w-xs">Ontwerp, aanleg en onderhoud van tuinen, en boomverzorging. Voor particulieren en bedrijven in {site.plaats} en {site.regio}.</p>
      <p class="mt-6 flex gap-3">
        <a href={waVraag} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-messing hover:text-inkt" aria-label="WhatsApp"><Icoon naam="wa" class="h-5 w-5" /></a>
        <a href={`mailto:${site.mail}`} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-messing hover:text-inkt" aria-label="E-mail"><Icoon naam="mail" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-extrabold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {diensten.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-messing">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-extrabold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-messing">{site.tel}</a></li>
        <li><a href={waVraag} class="no-underline transition-colors hover:text-messing">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="no-underline transition-colors hover:text-messing">{site.mail}</a></li>
        <li>{site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-extrabold text-licht">Bereikbaar</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Bereikbaarheid</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-bold data-[vandaag]:text-messing">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-messing">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van tomkorbee.nl en uw Google-bedrijfsprofiel. Review letterlijk van Google, referenties letterlijk van tomkorbee.nl (stand 3 oktober 2026).</p>}
  </div>
</footer>
