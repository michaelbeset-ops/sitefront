---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, onderdelen, reviews, waVraag, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import ontwerp3d from '../assets/ontwerp-3d.jpg';
import aanleg from '../assets/aanleg.jpg';
import onderhoud from '../assets/onderhoud.jpg';
import vormsnoei from '../assets/vormsnoei.jpg';
import border from '../assets/border.jpg';
import waterkant from '../assets/waterkant.jpg';
import vlonderG from '../assets/vlonder-g.jpg';
import bord from '../assets/bord.jpg';
import bus from '../assets/bus.jpg';
import pPergola from '../assets/p-pergola.jpg';
import pLounge from '../assets/p-lounge.jpg';
import pVlonderWater from '../assets/p-vlonder-water.jpg';
import pLigbedden from '../assets/p-ligbedden.jpg';
import pVijver from '../assets/p-vijver.jpg';
import pVijver2 from '../assets/p-vijver2.jpg';
import pSteiger from '../assets/p-steiger.jpg';
import pBloemen from '../assets/p-bloemen.jpg';
import pSchaduw from '../assets/p-schaduw.jpg';
import pAnemoon from '../assets/p-anemoon.jpg';
import pGras from '../assets/p-gras.jpg';
import pTulpen from '../assets/p-tulpen.jpg';
import pAvond from '../assets/p-avond.jpg';
import pLichtwand from '../assets/p-lichtwand.jpg';
import pStrak from '../assets/p-strak.jpg';
import pKunstgras from '../assets/p-kunstgras.jpg';
import pGazon from '../assets/p-gazon.jpg';
import pHout from '../assets/p-hout.jpg';
import pBank from '../assets/p-bank.jpg';
import pHof from '../assets/p-hof.jpg';
import pTerras from '../assets/p-terras.jpg';
import pHekwerk from '../assets/p-hekwerk.jpg';
import pVoortuin from '../assets/p-voortuin.jpg';

const diensten = [
  { id: 'ontwerp', t: 'Tuinontwerp', d: 'Een creatief, vindingrijk en origineel ontwerp, van schets tot uitvoeringsplan.', src: ontwerp3d, alt: '3D-ontwerp van een tuin met overkapping, hagen, siergrassen en een grote tafel', pos: '45% 50%', naar: '#werkwijze' },
  { id: 'aanleg', t: 'Tuinaanleg en renovatie', d: 'Bestrating, beplanting, houtwerk, vijvers, gazons, verlichting en beregening.', src: aanleg, alt: 'Aangelegde tuin met hardhouten vlonder, stalen pergola, strakke vijver en bomen in bakken', pos: '50% 55%', naar: '#werkwijze' },
  { id: 'onderhoud', t: 'Tuinonderhoud', d: 'Eenmalig, tijdens het seizoen of wekelijks. Afgestemd op uw tuin en wensen.', src: onderhoud, alt: 'Vijver met een rand van vaste planten, siergrassen en een Japanse esdoorn tegen een houten schutting', pos: '50% 60%', naar: '#onderhoud' },
  { id: 'bomen', t: 'Boomverzorging', d: 'Snoeiwerk aan bomen en het modelleren van struiken.', src: vormsnoei, alt: 'Voortuin met een in wolkvorm gesnoeide boom tussen buxusbollen', pos: '50% 40%', naar: '#contact' },
];

// Projectfoto's: alle van tomkorbee.nl (fotoboek) of hun Google-profiel. Categorie op basis van wat er op de foto staat.
const fotos = [
  { src: pVijver, c: 'water', alt: 'Strakke vijver met natuursteen rand en twee olijfbomen in zwarte bakken', top: true },
  { src: pPergola, c: 'hout', alt: 'Houten overkapping met hekwerk en een kleurrijke border eromheen', top: true },
  { src: pBloemen, c: 'groen', alt: 'Border vol vingerhoedskruid, rode spoorbloem en siergrassen', top: true },
  { src: pAvond, c: 'licht', alt: 'Tuin bij avond met verlichte bomen en een verlicht terras', top: true },
  { src: pLounge, c: 'hout', alt: 'Loungebank met groene kussens voor een donkere lamellenwand, met agapanthus ervoor', top: true },
  { src: pKunstgras, c: 'bestrating', alt: 'Voortuin met kunstgras, klinkers en drie bomen in grote antraciet bakken', top: true },
  { src: pVlonderWater, c: 'hout', alt: 'Hardhouten vlonder met trap en ligbed aan het water', top: true },
  { src: pVijver2, c: 'water', alt: 'Vijver met natuurstenen wand, vlonder, pergola en wolkbomen', top: true },
  { src: pBank, c: 'groen', alt: 'Golvende houten bank tussen bloeiende vaste planten', top: true },
  { src: pStrak, c: 'bestrating', alt: 'Strakke tuin met natuursteen, grind, een olijfboom en keien', top: true },
  { src: pLichtwand, c: 'licht', alt: 'Donkere houten wand met drie bakken met kronkeltakken, van onderen verlicht', top: true },
  { src: pSteiger, c: 'water', alt: 'Houten vlonder aan de waterkant met een witte bloesemboom', top: true },
  { src: vlonderG, c: 'hout', alt: 'Hardhouten vlonder met een trede, omzoomd door taxushagen', top: true },
  { src: pHout, c: 'hout', alt: 'Verhoogd hardhouten terras met een schutting en lage hagen' },
  { src: pLigbedden, c: 'hout', alt: 'Vlonder met twee ligstoelen tussen bakken met bomen' },
  { src: pHekwerk, c: 'hout', alt: 'Hardhouten schutting met boogvormig latwerk boven de beplanting' },
  { src: waterkant, c: 'water', alt: 'Tuin aan het water met een verhoogde plantenbak, paden van natuursteen en klinkers en zuilvormige coniferen' },
  { src: border, c: 'groen', alt: 'Bloeiende border met tuinlamp, siergrassen en stapstenen naar de vijver' },
  { src: pSchaduw, c: 'groen', alt: 'Schaduwborder met varens en gele sleutelbloemen' },
  { src: pAnemoon, c: 'groen', alt: 'Witte herfstanemonen van dichtbij' },
  { src: pTulpen, c: 'groen', alt: 'Witte tulpen in een verhoogde bak voor een muur met keien' },
  { src: pGras, c: 'groen', alt: 'Pluimen van lampenpoetsersgras van dichtbij' },
  { src: pGazon, c: 'bestrating', alt: 'Gestreept gemaaid gazon met een boom op stam en een schuurtje' },
  { src: pHof, c: 'bestrating', alt: 'Stadstuin met grind, twee bolbomen, siergrassen en een berging' },
  { src: pTerras, c: 'bestrating', alt: 'Terras van grijs hout met lage bakken, hagen en een tafel' },
  { src: pVoortuin, c: 'bestrating', alt: 'Tuin met natuursteen pad, witte hortensia’s, een bank en jonge bomen' },
];
const fotoData = await Promise.all(fotos.map(async (f) => ({ ...f, groot: (await getImage({ src: f.src, width: 1400, format: 'webp' })).src })));
const filters = [['alles', 'Uitgelicht'], ['hout', 'Hout en overkapping'], ['water', 'Water'], ['groen', 'Beplanting'], ['bestrating', 'Bestrating en gazon'], ['licht', 'Verlichting']];
const aantal = (c: string) => (c === 'alles' ? fotos.filter((f) => f.top).length : fotos.filter((f) => f.c === c).length);

// Hun eigen ontwerp- en aanlegtraject (tomkorbee.nl/ontwerp.html en aanleg.html), ingekort.
const ontwerpStappen = [
  ['Kennismaking', 'Tom komt langs en maakt een lijst van uw wensen en eisen. Samen kijken we naar de tuin en de mogelijkheden. Binnen een week krijgt u een offerte voor een schetsontwerp.'],
  ['Inmeten', 'We meten de kavel en de woning in en leggen de situatie vast met foto’s, of werken met uw bouwtekeningen.'],
  ['Schetsontwerp', 'Meestal 3 tot 4 weken na het inmeten bespreken we het ingekleurde schetsontwerp bij u thuis. Aanpassen kan dan nog.'],
  ['Definitief ontwerp', 'We verwerken de wijzigingen en bespreken het definitieve schetsontwerp tot het helemaal naar uw wens is.'],
  ['Werkplan en offerte', 'Het ontwerp wordt tot in detail uitgewerkt in een werkplan, met een definitieve offerte voor uitvoering en materialen.'],
  ['Uw keuze', 'U bepaalt wie de tuin aanlegt. Kiest u voor ons, dan nemen wij de kosten van het schetsontwerp voor onze rekening.'],
];
const aanlegStappen = [
  ['Opdracht', 'U komt langs bij ons bedrijf, maakt kennis met de hoveniers die uw tuin aanleggen en we nemen een conceptplanning door.'],
  ['Planning', 'We stemmen de levering van materialen af met vaste leveranciers en onderaannemers en sturen u de definitieve planning.'],
  ['Week vooraf', 'Tom bespreekt de laatste details met u en informeert de buren over wat er gaat gebeuren.'],
  ['Uitvoering', 'Dagelijks contact over de voortgang. Werk dat later niet meer zichtbaar is, leveren we apart met u op.'],
  ['Oplevering', 'Samen kijken we of alles naar tevredenheid is. Zo nodig spreken we meteen af wanneer we de laatste puntjes op de i zetten.'],
];
const volgorde = ['Uitzetten', 'Opruimen en snoeien', 'Grondwerk', 'Verlichting en beregening', 'Verharding', 'Bouwkundige werken', 'Grondverbetering', 'Beplanting', 'Gazon', 'Afwerking', 'Oplevering'];

const contracten = [
  ['Eenmalig', 'Eén onderhoudsbeurt, op een moment dat het u uitkomt.', 'kalender'],
  ['Tijdens het seizoen', 'Vaste beurten in de maanden dat de tuin groeit.', 'zon'],
  ['Wekelijks', 'Elke week, ook als u met vakantie bent.', 'blad'],
];
const taken = ['Snoeien', 'Maaien', 'Vegen', 'Schoffelen', 'Hagen knippen', 'Planten scheuren', 'Verticuteren', 'Bemesten', 'Vijveronderhoud', 'Bestrating onkruidvrij', 'Houtwerk herstellen'];
---
<Base title={`${site.naam} | Hovenier in Nieuwerkerk aan den IJssel`} description="Tom Korbee Hoveniers uit Nieuwerkerk aan den IJssel: tuinontwerp, tuinaanleg, tuinonderhoud en boomverzorging in de Zuidplas. Schetsontwerp gratis bij aanleg. Offerte aanvragen via WhatsApp of e-mail.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen tuin bij avond -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.5rem)] flex-col md:min-h-[calc(100svh-9.6rem)] overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image quality={68} src={hero} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_55%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#13201a59_0%,#13201ab3_50%,#13201af5_100%)] md:bg-[linear-gradient(90deg,#13201af2_0%,#13201ac2_45%,#13201a40_100%)]" aria-hidden="true"></div>
      <div class="wrap flex flex-1 items-end pb-14 pt-24 md:items-center md:py-14">
        <div class="max-w-3xl">
          <p class="eyebrow">Hovenier in Nieuwerkerk<span class="hidden sm:inline">&nbsp;aan den IJssel</span></p>
          <h1 id="t-hero" class="mt-5 text-hero">Jarenlang genieten van <span class="text-messing">uw tuin.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Ontwerp, aanleg en onderhoud van tuinen, en boomverzorging. Volgens afspraak, secuur en netjes.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#contact" class="knop knop-messing">Offerte aanvragen<Icoon naam="pijl" /></a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.9375rem] font-semibold text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num font-black text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 17.00 uur</span></li>
            <li><a href={site.telHref} class="num flex items-center gap-2 text-licht no-underline hover:text-messing"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a></li>
          </ul>
        </div>
      </div>
      <div class="hidden border-t border-licht/15 bg-nacht/55 backdrop-blur-md md:block">
        <ul class="wrap grid grid-cols-3 divide-x divide-licht/15">
          <li class="flex items-center gap-4 py-6 pr-6"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-messing text-inkt"><Icoon naam="ontwerp" class="h-5 w-5" /></span><span class="text-[.9375rem] leading-snug"><b class="block font-extrabold text-licht">Schetsontwerp gratis</b><span class="text-licht-zacht">als wij uw tuin ook aanleggen</span></span></li>
          <li class="flex items-center gap-4 px-6 py-6"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-licht/10 text-messing"><Icoon naam="praat" class="h-5 w-5" /></span><span class="text-[.9375rem] leading-snug"><b class="block font-extrabold text-licht">Dagelijks contact</b><span class="text-licht-zacht">tijdens de aanleg van uw tuin</span></span></li>
          <li class="flex items-center gap-4 py-6 pl-6"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-licht/10 text-messing"><Icoon naam="gebouw" class="h-5 w-5" /></span><span class="text-[.9375rem] leading-snug"><b class="block font-extrabold text-licht">Particulier en zakelijk</b><span class="text-licht-zacht">onderhoud voor huis en bedrijf</span></span></li>
        </ul>
      </div>
    </section>

    <!-- 2. Chips: wat ze doen -->
    <section class="border-b border-lijn bg-zand" aria-label="Werkzaamheden">
      <div class="wrap flex flex-wrap items-center gap-2.5 py-6">
        <span class="mr-2 text-sm font-extrabold uppercase tracking-[.16em] text-grijs">Wij doen</span>
        {['Tuinontwerp', 'Tuinaanleg', 'Renovatie', 'Tuinonderhoud', 'Boomverzorging', ...onderdelen].map((c) => (
          <span class="rounded-md bg-papier px-3.5 py-1.5 text-[.9375rem] font-bold shadow-sm">{c}</span>
        ))}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid items-end gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="eyebrow">Onze diensten</p>
            <h2 id="t-diensten" class="mt-4 text-3xl">Van eerste schets tot <span class="text-messing-diep">vaste onderhoudsbeurt.</span></h2>
          </div>
          <p class="text-lg text-grijs lg:col-span-5">Voor alle voorkomende werkzaamheden hebben we de vakkennis in huis. U kunt ons inschakelen voor het hele traject of voor één klus.</p>
        </div>
        <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {diensten.map((d, i) => (
            <li class="rijs" style={`--d:${(i % 2) * 0.08}s`}>
              <a href={d.naar} class="group relative block aspect-[16/10] overflow-hidden rounded-lg bg-nacht text-licht no-underline sm:aspect-[16/11] lg:aspect-[3/4.3]">
                <Image quality={68} src={d.src} alt={d.alt} widths={[480, 720, 1000]} sizes="(min-width: 1024px) 23vw, (min-width: 768px) 46vw, 92vw" class="tegel absolute inset-0 h-full w-full object-cover" style={`object-position:${d.pos}`} />
                <span class="absolute inset-0 bg-[linear-gradient(180deg,#13201a00_30%,#13201aeb_100%)]" aria-hidden="true"></span>
                <span class="absolute right-5 top-5 grid h-11 w-11 place-items-center rounded-md bg-messing text-inkt transition-transform duration-300 group-hover:translate-x-1"><Icoon naam="pijl" class="h-5 w-5" /></span>
                <span class="absolute inset-x-0 bottom-0 block p-6">
                  <span class="num text-sm font-extrabold text-messing">0{i + 1}</span>
                  <span class="mt-1 block text-[1.625rem] font-black leading-tight tracking-[-0.03em]">{d.t}</span>
                  <span class="mt-2 block text-[.9375rem] text-licht/85">{d.d}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <!-- Cijfers -->
        <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-lg bg-lijn lg:grid-cols-4">
          {[
            ['2005', 'Sinds dit jaar actief in de Zuidplas'],
            ['1 week', 'Na de kennismaking: offerte voor het schetsontwerp'],
            ['3-4 weken', 'Na het inmeten bespreken we het schetsontwerp'],
            ['5,0', 'Gemiddelde score op Google'],
          ].map(([n, t]) => (
            <div class="bg-papier p-6 lg:p-8">
              <dt class="sr-only">{t}</dt>
              <dd class="num text-[clamp(2rem,2vw+1.4rem,3rem)] font-black leading-none tracking-[-0.04em]">{n}</dd>
              <dd class="mt-3 text-[.9375rem] text-grijs">{t}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 4. Projecten: filterbare galerij met vergroting -->
    <section id="projecten" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-projecten">
      <div class="wrap">
        <div class="grid items-end gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-projecten" class="mt-4 text-3xl">Tuinen die we <span class="text-messing">aanlegden.</span></h2>
          </div>
          <p class="text-lg text-licht-zacht lg:col-span-5">Vlonders, vijvers, borders en verlichting: een greep uit ons fotoboek. Klik op een foto om hem groot te bekijken.</p>
        </div>
        <div class="-mx-5 mt-10 overflow-x-auto px-5 pb-2 md:mx-0 md:px-0" role="group" aria-label="Filter projecten">
          <div class="flex gap-2 whitespace-nowrap">
            {filters.map(([c, t], i) => (
              <button type="button" class="filter" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>{t}<span class="num">{aantal(c)}</span></button>
            ))}
          </div>
        </div>
        <ul class="galerij mt-8" data-galerij data-modus="alles">
          {fotoData.map((f, i) => (
            <li data-c={f.c} data-top={f.top ? '' : undefined} class={f.top ? '' : 'hidden'}>
              <button type="button" class="group relative block h-full w-full overflow-hidden rounded-md bg-nacht-2" data-groot={f.groot} data-alt={f.alt} data-i={i}>
                <Image quality={68} src={f.src} alt={f.alt} widths={[400, 640]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw" class="tegel h-full w-full object-cover" />
                <span class="absolute right-3 top-3 grid h-9 w-9 place-items-center rounded-md bg-nacht/70 text-licht opacity-0 backdrop-blur transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true"><Icoon naam="plus" class="h-4 w-4" /></span>
              </button>
            </li>
          ))}
        </ul>
        <div class="mt-10 flex flex-wrap items-center justify-between gap-4">
          <p class="text-licht-zacht">Foto’s uit ons fotoboek en van ons Google-profiel.</p>
          <button type="button" class="knop knop-rand" data-alles>Toon alle {fotos.length} foto’s</button>
        </div>
      </div>
      <dialog class="lichtbak" data-lichtbak aria-label="Projectfoto">
        <figure class="flex h-full flex-col items-center justify-center gap-4 p-4 md:p-10">
          <img src="" alt="" class="max-h-[78vh] w-auto max-w-full rounded-md object-contain" data-lb-img />
          <figcaption class="max-w-2xl text-center text-[.9375rem] text-licht-zacht" data-lb-tekst></figcaption>
        </figure>
        <button type="button" class="lb-knop right-4 top-4" data-lb-dicht aria-label="Sluiten"><Icoon naam="kruis" class="h-5 w-5" /></button>
        <button type="button" class="lb-knop left-4 top-1/2 -translate-y-1/2" data-lb-vorige aria-label="Vorige foto"><Icoon naam="links" class="h-5 w-5" /></button>
        <button type="button" class="lb-knop right-4 top-1/2 -translate-y-1/2" data-lb-volgende aria-label="Volgende foto"><Icoon naam="pijl" class="h-5 w-5" /></button>
      </dialog>
    </section>

    <!-- 5. Werkwijze: ontwerp- en aanlegtraject -->
    <section id="werkwijze" class="py-20 lg:py-24" aria-labelledby="t-werkwijze">
      <div class="wrap">
        <div class="grid items-end gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-werkwijze" class="mt-4 text-3xl">Zo ontstaat <span class="text-messing-diep">uw tuinplan.</span></h2>
          </div>
          <div class="lg:col-span-5">
            <div class="inline-flex max-w-full rounded-md bg-zand p-1" role="tablist" aria-label="Traject">
              <button type="button" role="tab" class="tab" id="tab-ontwerp" aria-controls="paneel-ontwerp" aria-selected="true" data-tab="ontwerp">Ontwerp <span class="num hidden sm:inline">6 stappen</span></button>
              <button type="button" role="tab" class="tab" id="tab-aanleg" aria-controls="paneel-aanleg" aria-selected="false" tabindex="-1" data-tab="aanleg">Aanleg <span class="num hidden sm:inline">5 stappen</span></button>
            </div>
          </div>
        </div>

        <div id="paneel-ontwerp" role="tabpanel" aria-labelledby="tab-ontwerp" class="mt-12 grid gap-10 lg:grid-cols-12" data-paneel="ontwerp">
          <ol class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:col-span-7">
            {ontwerpStappen.map(([t, d], i) => (
              <li class="stap">
                <span class="num stap-nr">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-xl">{t}</h3>
                <p class="mt-2 text-[.9375rem] text-grijs">{d}</p>
              </li>
            ))}
          </ol>
          <figure class="lg:col-span-5">
            <div class="relative overflow-hidden rounded-lg">
              <Image quality={68} src={ontwerp3d} alt="3D-ontwerp van een tuin met overkapping, hagen, siergrassen en een grote tafel" widths={[480, 896]} sizes="(min-width: 1024px) 38vw, 92vw" class="aspect-[4/3] w-full object-cover object-[45%_50%]" />
            </div>
            <figcaption class="kaart -mt-10 ml-4 mr-4 relative p-5 sm:ml-8 sm:mr-0 sm:p-6">
