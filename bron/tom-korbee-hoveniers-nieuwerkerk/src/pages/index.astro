<script>
  // Projectgalerij: filter, alles tonen en vergroting.
  const lijst = document.querySelector<HTMLElement>('[data-galerij]');
  const items = lijst ? [...lijst.querySelectorAll<HTMLElement>('li')] : [];
  const knoppen = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const alles = document.querySelector<HTMLButtonElement>('[data-alles]');
  const toon = (c: string, allesTonen = false) => {
    items.forEach((li) => li.classList.toggle('hidden', c === 'alles' ? !(allesTonen || li.hasAttribute('data-top')) : li.dataset.c !== c));
    knoppen.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.filter === c)));
    if (alles) alles.hidden = c !== 'alles' || allesTonen;
    lijst?.setAttribute('data-modus', c);
  };
  knoppen.forEach((k) => k.addEventListener('click', () => toon(k.dataset.filter || 'alles')));
  alles?.addEventListener('click', () => toon('alles', true));

  const lb = document.querySelector<HTMLDialogElement>('[data-lichtbak]');
  const lbImg = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const lbTekst = document.querySelector<HTMLElement>('[data-lb-tekst]');
  let huidige = 0;
  const zichtbaar = () => items.filter((li) => !li.classList.contains('hidden')).map((li) => li.querySelector<HTMLButtonElement>('button')!);
  const open = (b: HTMLButtonElement) => {
    if (!lb || !lbImg || !lbTekst) return;
    huidige = zichtbaar().indexOf(b);
    lbImg.src = b.dataset.groot || ''; lbImg.alt = b.dataset.alt || ''; lbTekst.textContent = b.dataset.alt || '';
    if (!lb.open) lb.showModal();
  };
  const stap = (d: number) => { const z = zichtbaar(); if (z.length) open(z[(huidige + d + z.length) % z.length]); };
  lijst?.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-groot]'); if (b) open(b); });
  document.querySelector('[data-lb-dicht]')?.addEventListener('click', () => lb?.close());
  document.querySelector('[data-lb-vorige]')?.addEventListener('click', () => stap(-1));
  document.querySelector('[data-lb-volgende]')?.addEventListener('click', () => stap(1));
  lb?.addEventListener('click', (e) => { if (e.target === lb || (e.target as HTMLElement).tagName === 'FIGURE') lb.close(); });
  lb?.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') stap(1); if (e.key === 'ArrowLeft') stap(-1); });

  // Werkwijze-tabs.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const kies = (t: HTMLButtonElement) => {
    tabs.forEach((x) => { const aan = x === t; x.setAttribute('aria-selected', String(aan)); x.tabIndex = aan ? 0 : -1; document.querySelector(`[data-paneel="${x.dataset.tab}"]`)?.classList.toggle('hidden', !aan); });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => kies(t));
    t.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length]; kies(n); n.focus(); } });
  });

  // Aanvraag: bericht samenstellen voor WhatsApp of e-mail.
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  if (f) {
    const ond = f.querySelector<HTMLElement>('[data-onderdelen]');
    const freq = f.querySelector<HTMLElement>('[data-frequentie]');
    const wissel = () => { const s = (f.querySelector<HTMLInputElement>('input[name=soort]:checked')?.value) || ''; ond?.classList.toggle('hidden', s === 'Onderhoud' || s === 'Boomverzorging'); freq?.classList.toggle('hidden', s !== 'Onderhoud'); };
    f.querySelectorAll('input[name=soort]').forEach((i) => i.addEventListener('change', wissel));
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const via = ((e as SubmitEvent).submitter as HTMLButtonElement | null)?.value || 'wa';
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const soort = v('soort');
      const r = [`Hallo Tom, ik wil graag een offerte voor ${soort ? soort.toLowerCase() : 'mijn tuin'}.`];
      const delen = d.getAll('onderdeel').map(String);
      if (delen.length && soort !== 'Onderhoud' && soort !== 'Boomverzorging') r.push('Onderdelen: ' + delen.join(', ').toLowerCase());
      if (soort === 'Onderhoud' && v('freq')) r.push('Hoe vaak: ' + v('freq').toLowerCase());
      if (v('tuin')) r.push('Tuin: ' + v('tuin').toLowerCase());
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('wens')) r.push('Toelichting: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      const tekst = r.join('\n');
      if (via === 'mail') window.location.href = `mailto:info@tomkorbee.nl?subject=${encodeURIComponent('Offerteaanvraag ' + (soort || 'tuin').toLowerCase())}&body=${encodeURIComponent(tekst)}`;
      else window.open('https://wa.me/31624472784?text=' + encodeURIComponent(tekst), '_blank', 'noopener');
    });
  }
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: .95; letter-spacing: -0.045em; }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .3rem .7rem; border-radius: .5rem; background: var(--color-nacht-2); }
