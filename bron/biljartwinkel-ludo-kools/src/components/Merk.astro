---
// Woordmerk nagetekend naar hun eigen visitekaartje: "BILJARTWINKEL" klein in rood tussen twee streepjes,
// daaronder "Ludo Kools" waarin de o's de drie carambole-ballen zijn (wit, rood, geel).
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['merk inline-flex flex-col items-center leading-none no-underline', cls]}>
  <span class="sr-only">Biljartwinkel Ludo Kools</span>
  <span class:list={['flex items-center gap-1.5 text-[.6rem] font-[800] tracking-[.22em]', licht ? 'text-rood-licht' : 'text-rood-licht group-data-[vast]/kop:text-rood']} aria-hidden="true">
    <span class="h-px w-3 bg-current opacity-80"></span>BILJARTWINKEL<span class="h-px w-3 bg-current opacity-80"></span>
  </span>
  <span class="mt-1 whitespace-nowrap text-[1.5rem] font-[850] tracking-[-.01em]" aria-hidden="true">Lud<span class="bal mx-[.02em]"></span> K<span class="bal bal-rood mx-[.02em]"></span><span class="bal bal-geel mx-[.02em]"></span>ls</span>
</a>
