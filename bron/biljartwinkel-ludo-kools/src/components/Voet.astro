---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const links = [['winkel', 'De winkel'], ['assortiment', 'Assortiment'], ['wat-zoekt-u', 'Wat zoekt u?'], ['reviews', 'Reviews'], ['langskomen', 'Langskomen']];
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht class="text-wit" />
      <p class="mt-6 max-w-xs">Reparatie · Keuen · Biljartartikelen · Persoonlijk advies</p>
      <p class="mt-5">
        <a href={site.facebook} class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-lijn-licht text-wit transition-colors hover:border-wit" aria-label="Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="md:col-span-3">
      <p class="font-[750] text-wit">Op deze pagina</p>
      <ul class="mt-3 space-y-1">{links.map(([id, t]) => <li><a href={url(`#${id}`)} class="no-underline hover:underline">{t}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-[750] text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={site.facebook} class="link">Facebook</a></p>
      <p class="mt-4">{site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-[750] text-wit">Open</p>
      <p class="mt-3">Woensdag<br /><span class="num">17:00 - 20:00</span></p>
      <p class="mt-2">Zaterdag<br /><span class="num">10:00 - 17:00</span></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen Google-profiel (ook foto's die klanten daar plaatsten van de winkel). Teksten uit jullie Facebook-pagina, visitekaartje en het artikel van ZuidWest Update (14 september 2021); reviews letterlijk van Google (stand 9 oktober 2026).</p>}
</footer>
