---
// De band van een carambole-biljart: een lijn met zeven "diamanten" (de merktekens op de lange band).
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class:list={['band', cls]} aria-hidden="true">
  {[1, 2, 3, 4, 5, 6, 7].map((k) => <i style={`left:${(k * 100) / 8}%`}></i>)}
</div>
