---
import { silhouet } from '../data/site';
interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 240 22" preserveAspectRatio="xMinYMid meet" class={cls} aria-hidden="true">
  <path d={silhouet} fill="currentColor" />
  <g stroke="currentColor" stroke-width=".8">
    {Array.from({ length: 14 }, (_, i) => <line x1={92 + i * 4.3} y1="14" x2={92 + i * 4.3} y2={4 + (i % 3) * 2} />)}
  </g>
  <path d="M0 21.4 H240" stroke="currentColor" stroke-width="1.2" />
  <path d="M150 21 H196" stroke="currentColor" stroke-width="1" />
</svg>
