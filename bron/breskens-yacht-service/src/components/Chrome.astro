---
import { site, url, offerteMail } from '../data/site';
import Silhouet from './Silhouet.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const tel = `<svg viewBox="0 0 24 24" class="h-[1.05em] w-[1.05em]" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>`;
---
{deel === 'kop' ? (
  <header class="op-blauw sticky top-0 z-40 bg-lift text-wit">
    <div class="flex h-[4.25rem] items-center justify-between gap-4 px-4 md:h-[4.75rem] md:px-[calc(14px+2rem)]">
      <a href={url('')} class="flex flex-col no-underline" aria-label={`${site.naam}, naar de homepage`}>
        <span class="spatie text-[.98rem] leading-none tracking-[.2em] md:text-[1.3rem] md:tracking-[.26em]">Breskens Yacht Service</span>
        <Silhouet class="mt-1.5 h-[.95rem] w-[11.5rem] text-hemel md:h-[1.3rem] md:w-[16rem]" />
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-9 cond text-[1.15rem] font-medium uppercase tracking-[.08em]">
          <li><a href={url('#werf')} class="no-underline underline-offset-[6px] hover:underline decoration-geel decoration-2">De werf</a></li>
          <li><a href={url('#stalling')} class="no-underline underline-offset-[6px] hover:underline decoration-geel decoration-2">Winterstalling</a></li>
          <li><a href={url('#contact')} class="no-underline underline-offset-[6px] hover:underline decoration-geel decoration-2">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="knop !px-3 !py-2 !text-[1.05rem] md:!px-4"><Fragment set:html={tel} /><span class="tabular-nums max-[399px]:sr-only">{site.tel}</span><span class="sr-only">bellen</span></a>
    </div>
  </header>
) : (
  <footer class="op-blauw bg-lift text-wit">
    <div class="wrap grid gap-10 pb-10 pt-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="spatie text-[1.5rem] leading-tight">Breskens Yacht Service</p>
        <Silhouet class="mt-2 h-[1.3rem] w-[20rem] max-w-full text-hemel" />
      </div>
      <p class="md:col-span-4">
        {site.straat}<br />{site.postcode} {site.plaats}<br />
        <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a><br />
        <a href={offerteMail} class="lijn break-all">{site.mail}</a>
      </p>
      <p class="md:col-span-3 md:text-right">
        <a href={site.voorwaarden} class="lijn">Algemene voorwaarden</a> (pdf)<br />
        <a href={site.werfreglement} class="lijn">Werfreglement</a> (pdf)<br />
        <a href={url('privacy/')} class="lijn">Privacyverklaring</a><br />
        <span class="text-sm text-hemel">KvK [[AANLEVEREN: KvK-nummer]]</span>
      </p>
    </div>
    {site.voorstel && <p class="wrap border-t border-lijn-licht pb-8 pt-6 text-sm text-hemel">Foto's van uw eigen website, ter illustratie.</p>}
  </footer>
)}
