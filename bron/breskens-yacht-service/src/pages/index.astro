---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, stallingMail, offerteMail } from '../data/site';
import loods from '../assets/loods.jpg';
import travellift from '../assets/travellift.jpg';
import teakdek from '../assets/teakdek.jpg';
import transport from '../assets/transport.jpg';

// Het werfbord: de vier regels van hun eigen homepage.
const bord = [
  ['6000 m²', 'vorstvrije winterstallingsloods'],
  ['68 TON', 'liften en kranen'],
  ['TRANSPORT', 'boten transportklaar maken'],
  ['SCHADE', 'onderdeel van het Schadeherstelnetwerk van Nationale Nederlanden'],
];
// Het menu "Service & stalling" van hun huidige site.
const werk = ['Scheepslift', 'Kraan- en hoogtewerk', 'Onderhoud', 'Scheepsherstellingen', 'Laswerken', 'Draai- en freeswerk', 'Volledige refits', 'Stalling binnen en buiten', 'Transport', 'Taxatie'];
---
<Base title="Breskens Yacht Service | Refits, onderhoud en winterberging in Breskens" description="Werf aan de Middenhavendam in Breskens: refits, onderhoud en winterberging. 6000 m² vorstvrije winterstallingsloods, liften en kranen tot 68 ton. Bel 0117 383 126.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. Onder de travellift: de kop hangt aan de blauwe balk, de poten lopen langs het hele eerste scherm. -->
    <section class="poten relative flex flex-col bg-beton md:grid md:min-h-[calc(100svh-6.85rem)] md:grid-cols-12 md:grid-rows-[auto_1fr]" aria-labelledby="kop">
      <div class="px-5 pb-7 pt-7 md:col-span-8 md:px-8 md:pb-10 md:pt-[clamp(2rem,5.5vh,3.6rem)] xl:pl-12">
        <h1 id="kop" class="text-[clamp(3.1rem,7.4vw,7.6rem)] leading-[.86]">Refits, onderhoud en winter&shy;berging</h1>
        <div class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-3 md:mt-8">
          <a href={site.telHref} class="knop knop-blauw">Bel <span class="tabular-nums">{site.tel}</span></a>
          <a href={offerteMail} class="lijn text-lg">Offerte aanvragen per mail</a>
        </div>
      </div>
      <dl class="order-3 mx-5 mb-2 mt-8 self-end border-t-[3px] border-inkt md:order-none md:col-span-4 md:mx-0 md:mb-10 md:mr-8 md:mt-0 xl:mr-12">
        {bord.map(([k, v]) => (
          <div class="grid grid-cols-[6.6rem_1fr] items-baseline gap-3 border-b border-lijn py-2 md:grid-cols-[7.4rem_1fr]">
            <dt class="cond text-[1.45rem] font-bold leading-none md:text-[1.6rem]">{k}</dt>
            <dd class="text-[.98rem] leading-snug text-staal">{v}</dd>
          </div>
        ))}
      </dl>
      <figure class="relative h-[14.5rem] overflow-hidden md:col-span-12 md:h-auto md:min-h-[22rem]">
        <Foto src={loods} alt="Een rode tractor met een lange gele botentrailer voor de open deur van een grote blauwgrijze loods." hero sizes="100vw" class="absolute inset-0 object-[30%_58%] md:object-[50%_44%]" />
        <figcaption class="absolute bottom-0 right-0 bg-inkt/80 px-3 py-1.5 text-sm italic text-wit md:px-4">De eigen tractor en trailer bij de loods.</figcaption>
      </figure>
    </section>

    <!-- 2. De werf: hun eigen foto's groot, daaronder het werk als register. -->
    <section id="werf" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="werf-kop">
      <div class="wrap">
        <div class="grid gap-5 md:grid-cols-12 md:gap-6">
          <figure class="md:col-span-7">
            <div class="aspect-[4/3] overflow-hidden"><Foto src={travellift} alt="De blauwe travellift met de naam Breskens Yacht Service tilt een donker motorjacht op de kade." sizes="(min-width: 768px) 56vw, 100vw" /></div>
            <figcaption class="mt-2 text-sm italic text-staal">De eigen travellift op de kade.</figcaption>
          </figure>
          <figure class="md:col-span-5 md:mt-24">
            <div class="aspect-[4/3] overflow-hidden"><Foto src={teakdek} alt="Een nieuw teakdek in aanbouw op het voordek van een jacht in de werkplaats, met lijmtangen en een zaag." sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <figcaption class="mt-2 text-sm italic text-staal">Een nieuw teakdek, plank voor plank.</figcaption>
          </figure>
        </div>

        <div class="mt-16 grid gap-10 md:mt-24 md:grid-cols-12">
          <div class="md:col-span-5">
            <h2 id="werf-kop" class="text-2xl">Wat er op de werf gebeurt</h2>
            <p class="mt-6 max-w-[30rem] text-lg leading-relaxed">In de reviews noemen klanten de deskundigheid en de snelheid, en dat moeilijke klussen hier niet uit de weg gegaan worden. Eén van hen laat er al jaren zijn Grand Banks onderhouden.</p>
          </div>
          <ul class="cond grid content-start text-[1.55rem] font-medium uppercase leading-none sm:grid-cols-2 sm:gap-x-10 md:col-span-7">
            {werk.map((w) => <li class="border-b border-lijn py-3">{w}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. Winterstalling: de blauwe balk als band. -->
    <section id="stalling" class="op-blauw scroll-mt-20 bg-lift text-wit" aria-labelledby="stalling-kop">
      <div class="wrap grid items-center gap-12 py-20 md:grid-cols-12 md:py-28">
        <div class="md:col-span-6">
          <h2 id="stalling-kop" class="text-3xl">6000 <span class="normal-case">m²</span> vorstvrij</h2>
          <p class="mt-7 max-w-[30rem] text-lg leading-relaxed text-hemel">Winterberging in de eigen loods, en transport als de boot verder moet. Laat weten wat voor boot het is en wat er deze winter aan moet gebeuren.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={stallingMail} class="knop">Stalling aanvragen</a>
            <a href={site.telHref} class="lijn text-lg">of bel <span class="tabular-nums">{site.tel}</span></a>
          </div>
        </div>
        <figure class="md:col-span-6">
          <div class="aspect-[4/3] overflow-hidden"><Foto src={transport} alt="Een wit zeiljacht staat op een gele trailer, klaar voor transport." sizes="(min-width: 768px) 46vw, 100vw" /></div>
          <figcaption class="mt-2 text-sm italic text-hemel">Transportklaar op de trailer.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Contact. -->
    <section id="contact" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="contact-kop">
      <div class="wrap grid gap-12 md:grid-cols-12">
        <h2 id="contact-kop" class="text-3xl md:col-span-5">Naar de werf</h2>
        <div class="grid gap-10 sm:grid-cols-2 md:col-span-7">
          <div>
            <p class="text-lg leading-relaxed">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <p class="mt-3"><a href={site.maps} class="lijn">Route plannen</a></p>
            <p class="mt-6 text-lg"><a href={site.telHref} class="lijn tabular-nums">{site.tel}</a><br /><a href={offerteMail} class="lijn break-all">{site.mail}</a></p>
          </div>
          <div>
            <p class="cond text-[1.45rem] font-bold uppercase leading-none">Maandag t/m vrijdag</p>
            <p class="mt-1 text-lg tabular-nums">08:00 - 17:00</p>
            <p class="mt-8 text-sm text-staal">Google-reviews: {site.google.score} uit {site.google.aantal}</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
