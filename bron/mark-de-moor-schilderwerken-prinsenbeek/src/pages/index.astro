---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import wapen from '../assets/wapen.png';
import onderhoud from '../assets/onderhoud.jpg';
import houtrotVoor from '../assets/houtrot-voor.jpg';
import houtrotNa from '../assets/houtrot-na.jpg';
import gevelVoor from '../assets/gevel-voor.jpg';
import gevelNa from '../assets/gevel-na.jpg';
import behang from '../assets/behang.jpg';
import dakkapel from '../assets/dakkapel.jpg';
import zonnebloem from '../assets/decor-zonnebloem.jpg';
import heilige from '../assets/decor-heilige.jpg';
import rank from '../assets/decor-rank.jpg';
import anno from '../assets/letters-anno.jpg';
import jaartal from '../assets/letters-1898.jpg';
import voordeur from '../assets/voordeur.jpg';
import jaren30 from '../assets/jaren30.jpg';

const vraag = (d: string) => waMet(`Goedendag Mark, ik heb een vraag over ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Onderhoud binnen en buiten', d: 'Kozijnen, ramen, deuren, muren, plafonds en hekwerk. Goed onderbouwd in een technisch advies en een zuivere offerte.', src: onderhoud, alt: 'Rode bakstenen gevel met boogramen en een ladder tegen het kozijn', pos: '50% 85%' },
  { t: 'Renoveren en houtrot', d: 'Iedere ondergrond, hoe slecht ook, valt te herstellen. Zo dat de reparatie niet meer zichtbaar is.', src: houtrotNa, alt: 'Wit geschilderde onderdorpel van een kozijn, glad hersteld naast een regenpijp', pos: '40% 50%' },
  { t: 'Advies en meerjarenplan', d: 'Verftechnisch advies en kleuradvies zitten bij de prijs inbegrepen. Een meerjarenonderhoudsplan is ideaal voor VvE’s en bedrijven.', src: dakkapel, alt: 'Dakkapel met strak wit geschilderde boeidelen en kozijnen', pos: '50% 50%' },
  { t: 'Wandbekleding', d: 'Behang en vinyl in eindeloze patronen, fotobehang en sterk glasvezelbehang dat ook scheuren opvangt.', src: behang, alt: 'Slaapkamer met een wand in oranje behang met krullend patroon', pos: '50% 40%' },
  { t: 'Oude schilderstechnieken', d: 'Glas in lood, letters penselen, hout-, marmer- en bronsimitatie en vergulden.', src: zonnebloem, alt: 'Gerestaureerde decoratieschildering met zonnebloemen en bladranken', pos: '50% 50%' },
];
const extra = [
  ['Spuitwerk', 'Lak en muurverf spuiten, voor grote oppervlakken.'],
  ['Kitwerk', 'Beglazingskit, badkamer en sanitair, dilatatievoegen.'],
  ['Hydrofoberen', 'De gevel vochtregulerend maken: vocht kan er niet in, wel uit.'],
  ['Beton saneren', 'Bij betonrot of beschadigingen.'],
  ['Houtworm en boktor', 'Bestrijding als uw hout is aangetast.'],
];

const technieken = [
  ['Glas in lood', 'Geheel nieuwe ontwerpen, of een kapot deel vervangen.'],
  ['Letters penselen', 'Bijvoorbeeld een familienaam of huisnummer.'],
  ['Hout- en marmerimitatie', 'Eiken, grenen of mahonie; witmarmer of Napoleon rouge, op een schouw of lambrisering.'],
  ['Bronsimitatie', 'Een willekeurige ondergrond die eruitziet als brons.'],
  ['Vergulden', 'Van de haan op een kerk tot een sierlijst.'],
];

const kaders = [
  ['afspraak', 'Afspraak = afspraak', 'Het motto bij elke offerte. Klanten schrijven het ook: hij komt zijn afspraken na.'],
  ['advies', 'Advies inbegrepen', 'Verftechnisch advies en kleuradvies zitten bij de prijs. Alleen advies? Dan spreken we vooraf een prijs af.'],
  ['huis', 'Thuis in oude panden', '“Mark heeft veel ervaring in het schilderen van ‘oude’ panden en dat is zichtbaar.”'],
];

const stappen = [
  ['Kennismaken', 'Bel of app wat er moet gebeuren. Mark komt kijken, binnen of buiten.'],
  ['Advies en offerte', 'Een eerlijk, onderbouwd onderhoudsadvies met een zuivere offerte.'],
  ['Vakkundig uitvoeren', `Met professionele producten van o.a. ${site.merken}.`],
  ['Netjes opgeleverd', 'Het resultaat volgens afspraak, en alles wordt netjes achtergelaten.'],
];
---
<Base title={`${site.naam} | Schilder in Prinsenbeek en Breda`} description="Schildersbedrijf in Prinsenbeek voor onderhoud, renovatie en oude schilderstechnieken, binnen en buiten. Ook in Breda, Etten-Leur, Ulvenhout en Rijsbergen. 5,0 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={hero} alt="" quality={62} widths={[480, 720, 960, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[52%_50%] md:object-[60%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1b181359_0%,#1b1813cc_40%,#1b1813f5_100%)] md:bg-[linear-gradient(90deg,#1b1813f7_0%,#1b1813d9_40%,#1b181340_78%,#1b181320_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-12 pt-12 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Schildersbedrijf in Prinsenbeek</p>
          <h1 id="t-hero" class="goud-em mt-6 text-hero">Schilderwerk dat iets meer <em>aandacht</em> nodig heeft.</h1>
          <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Onderhoud, renovatie en oude schilderstechnieken, binnen en buiten. Eerst een eerlijk advies, daarna werk volgens afspraak.</p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-goud"><Icoon naam="wa" />Offerte via WhatsApp</a>
            <a href="#voor-na" class="knop knop-rand op-foto">Bekijk voor en na</a>
          </div>
          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 9.00 tot 17.00 uur</span></li>
          </ul>
        </div>
        <figure class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto max-w-[20rem] rounded-md bg-nacht/80 p-7 shadow-md ring-1 ring-licht/15 backdrop-blur-md">
            <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            <blockquote class="mt-4 font-kop text-[1.3125rem] italic leading-snug">“Mark heeft veel ervaring in het schilderen van ‘oude’ panden en dat is zichtbaar.”</blockquote>
            <figcaption class="mt-5 flex items-center gap-2.5 border-t border-lijn-licht pt-4 text-sm text-licht-zacht"><Icoon naam="g" class="h-4 w-4" />R. Potters, Google review</figcaption>
          </div>
        </figure>
      </div>
    </section>

    <!-- 2. Werkzaamheden in het kort -->
    <section class="border-b border-lijn bg-perkament" aria-label="Werkzaamheden in het kort">
      <ul class="wrap flex items-center gap-x-5 overflow-x-auto py-5 text-[.9375rem] font-medium [scrollbar-width:none] lg:flex-wrap lg:justify-center lg:gap-y-2 lg:overflow-visible">
        {chips.map((c, i) => <li class="flex shrink-0 items-center gap-5">{i > 0 && <span class="ruit" aria-hidden="true"></span>}{c}</li>)}
      </ul>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-20" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkzaamheden</p>
            <h2 id="t-dienst" class="goud-em mt-5 text-3xl">Van een kozijn tot een <em>complete</em> gevel.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Bij al ons onderhoudsschilderwerk staat de prijs/kwaliteitverhouding centraal. Altijd met de wensen en mogelijkheden van de klant voorop.</p>
        </div>
        <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 640, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw" class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-[1.375rem]">{b.t}</h3>
                  <p class="mt-2.5 flex-1 text-grijs">{b.d}</p>
                  <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-oker">Vraag het Mark<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
          <li class="rijs" style="--d:.12s">
            <div class="donker flex h-full flex-col rounded-md bg-nacht p-6 text-licht lg:p-8">
              <h3 class="text-[1.375rem]">Verder</h3>
              <dl class="mt-4 flex-1 divide-y divide-lijn-licht">
                {extra.map(([t, d]) => <div class="py-2"><dt class="font-semibold text-goud">{t}</dt><dd class="mt-0.5 text-sm text-licht-zacht">{d}</dd></div>)}
              </dl>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- 4. Voor en na (wow) -->
    <section id="voor-na" class="donker bg-nacht py-20 text-licht lg:py-28" aria-labelledby="t-vn">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-4">
          <p class="eyebrow">Voor en na</p>
          <h2 id="t-vn" class="goud-em mt-5 text-3xl">Schuif en zie het <em>verschil</em>.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Kozijnen en voordeur van een rijwoning, voor en na het schilderwerk. Daaronder een rotte onderdorpel: blootgelegd, hersteld en afgelakt.</p>
          <div class="mt-9 grid grid-cols-2 gap-3">
            <figure>
              <Image src={houtrotVoor} alt="Rotte onderdorpel van een kozijn, opengelegd met een beitel" widths={[300, 500]} sizes="(min-width: 1024px) 190px, 45vw" class="aspect-square w-full rounded-sm object-cover" />
              <figcaption class="mt-2 text-sm text-licht-zacht">Houtrot blootgelegd</figcaption>
            </figure>
            <figure>
              <Image src={houtrotNa} alt="Dezelfde onderdorpel, hersteld en wit gelakt" widths={[300, 500]} sizes="(min-width: 1024px) 190px, 45vw" class="aspect-square w-full rounded-sm object-cover object-[60%_50%]" />
              <figcaption class="mt-2 text-sm text-licht-zacht">Hersteld en gelakt</figcaption>
            </figure>
          </div>
        </div>
        <div class="lg:col-span-8">
          <div class="vn lijst" data-vn style="--p:50%">
            <Image src={gevelNa} alt="Na: kozijnen wit met rood, voordeur rood gelakt" widths={[480, 760, 960]} sizes="(min-width: 1248px) 780px, (min-width: 1024px) 62vw, 92vw" class="vn-img" />
            <div class="vn-voor" aria-hidden="true">
              <Image src={gevelVoor} alt="" widths={[480, 760, 960]} sizes="(min-width: 1248px) 780px, (min-width: 1024px) 62vw, 92vw" class="vn-img" />
            </div>
            <span class="vn-label left-4">Voor</span>
            <span class="vn-label right-4">Na</span>
            <span class="vn-lijn" aria-hidden="true"><span class="vn-greep"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6"/></svg></span></span>
            <input type="range" min="0" max="100" value="50" class="vn-schuif" aria-label="Schuif tussen voor en na" />
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Oude schilderstechnieken -->
    <section id="technieken" class="py-20 lg:py-20" aria-labelledby="t-tech">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="eyebrow">Oude schilderstechnieken</p>
          <h2 id="t-tech" class="goud-em mt-5 text-3xl">Vakwerk met <em>de hand</em>.</h2>
          <p class="mt-6 text-lg text-grijs">Soms vraagt een pand om meer dan een verse laag verf. Daarvoor beheerst Mark de oude technieken van het schildersvak.</p>
          <ul class="mt-9 border-t border-lijn">
            {technieken.map(([t, d], i) => (
              <li class="flex gap-5 border-b border-lijn py-3">
                <span class="num w-6 shrink-0 pt-0.5 font-kop text-lg italic text-oker">{i + 1}</span>
                <span><b class="font-semibold">{t}</b><span class="mt-0.5 block text-[.9375rem] text-grijs">{d}</span></span>
              </li>
            ))}
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:col-span-7">
          <figure class="col-span-2 grid grid-cols-2 overflow-hidden rounded-md bg-wit">
            <Image src={anno} alt="Met de hand gepenselde letters: anno" widths={[400, 640]} sizes="(min-width: 1024px) 330px, 46vw" class="aspect-[3/2] h-full w-full object-cover" />
            <Image src={jaartal} alt="Met de hand gepenseld jaartal: 1898" widths={[400, 640]} sizes="(min-width: 1024px) 330px, 46vw" class="aspect-[3/2] h-full w-full object-cover" />
            <figcaption class="col-span-2 px-5 py-3 text-sm text-grijs">Letters penselen: “anno 1898” op een gevel</figcaption>
          </figure>
          <figure class="row-span-2 overflow-hidden rounded-md">
            <Image src={heilige} alt="Decoratieschildering met een medaillon van een heilige en gouden ornamenten" widths={[400, 640]} sizes="(min-width: 1024px) 330px, 46vw" class="h-full min-h-[14rem] w-full object-cover" />
          </figure>
          <figure class="overflow-hidden rounded-md">
            <Image src={zonnebloem} alt="Decoratieschildering met zonnebloemen" widths={[400, 640]} sizes="(min-width: 1024px) 330px, 46vw" class="aspect-[3/2] w-full object-cover" />
          </figure>
          <figure class="overflow-hidden rounded-md">
            <Image src={rank} alt="Sjabloonschildering met bloemranken in een hoek" widths={[400, 640]} sizes="(min-width: 1024px) 330px, 46vw" class="aspect-[3/2] w-full object-cover" />
          </figure>
        </div>
      </div>
    </section>

    <!-- 6. Over Mark + werkwijze -->
    <section id="over" class="bg-perkament py-20 lg:py-20" aria-labelledby="t-over">
      <div class="wrap">
        <div class="grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-12">
          <div class="relative mx-3 lg:col-span-5 lg:mx-0">
            <div class="lijst">
              <Image src={voordeur} alt="Monumentale voordeur in diep glanzend zwart met glas in lood erboven" widths={[400, 600, 768]} sizes="(min-width: 1024px) 440px, 88vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
            </div>
            <div class="absolute -bottom-8 right-4 flex items-center gap-4 rounded-md bg-wit p-4 pr-6 shadow-md sm:right-8">
              <Image src={wapen} alt="Het familiewapen van Mark de Moor" width={128} height={128} class="h-16 w-16" />
              <p class="text-sm leading-snug"><b class="block font-kop text-lg">Mark de Moor</b><span class="text-grijs">Schilder in {site.plaats}</span></p>
            </div>
          </div>
          <div class="lg:col-span-6 lg:col-start-7">
            <p class="eyebrow">Over Mark</p>
            <h2 id="t-over" class="goud-em mt-5 text-3xl">Afspraak is <em>afspraak</em>.</h2>
            <p class="mt-6 text-lg">Na een eerlijk en onderbouwd onderhoudsadvies houdt Mark altijd de wensen en mogelijkheden van de klant in ere. Het resultaat is dan ook altijd volgens afspraak.</p>
            <p class="mt-4 text-grijs">Hij werkt met gerenommeerde, professionele producten van onder andere {site.merken}, zodat een lange levensduur gewaarborgd is.</p>
            <ul class="mt-9 grid gap-3">
              {kaders.map(([ic, t, d]) => (
                <li class="kaart flex gap-4 p-4 pr-5">
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-nacht text-goud"><Icoon naam={ic} class="h-5 w-5" /></span>
                  <span><b class="block font-semibold">{t}</b><span class="mt-0.5 block text-[.9375rem] text-grijs">{d}</span></span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <ol class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-md bg-lijn lg:mt-20 lg:grid-cols-4" aria-label="Zo werkt het">
          {stappen.map(([t, d], i) => (
            <li class="rijs bg-ivoor p-5 sm:p-6 lg:p-8" style={`--d:${i * 0.06}s`}>
              <span class="num font-kop text-[2rem] sm:text-[2.5rem] italic leading-none text-oker">0{i + 1}</span>
              <h3 class="mt-4 text-lg sm:mt-5 sm:text-xl">{t}</h3>
              <p class="mt-2 text-[.9375rem] text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Reviews -->
    <section id="reviews" class="py-20 lg:py-20" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="goud-em mt-5 text-3xl">Wat klanten <em>zeggen</em>.</h2>
          </div>
          <a href={site.reviews} class="kaart flex shrink-0 items-center gap-4 p-4 pr-6 no-underline transition-shadow hover:shadow-md">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-sm bg-perkament font-kop font-bold text-oker" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8. Contact: offerte-aanvraag via WhatsApp + bereikbaarheid -->
    <section id="contact" class="bg-perkament py-20 lg:py-20" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-contact" class="goud-em mt-5 text-3xl">Wat mag Mark voor u <em>schilderen</em>?</h2>
          <p class="mt-6 text-lg text-grijs">Kies het soort werk en vertel kort wat er moet gebeuren. Er wordt een WhatsApp-bericht van gemaakt; foto’s van de klus stuurt u daarna gewoon mee.</p>
          <div class="kaart mt-10 p-6 md:p-7">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Bereikbaar</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr bereikbaar</span></p>
            </div>
            <table class="mt-3 w-full">
              <caption class="sr-only">Bereikbaarheid</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-oker">
                    <th scope="row" class="py-1.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-1.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="flex flex-col gap-4 lg:col-span-7">
        <form class="kaart p-6 sm:p-8 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw aanvraag aan Mark</h3>
