                <option>Twee-onder-een-kap</option>
                <option>Vrijstaand</option>
                <option>Appartement of VvE</option>
                <option>Bedrijfspand</option>
                <option>Monument of oud pand</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Plaats</span>
              <input name="plaats" list="plaatsen" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld Breda" />
              <datalist id="plaatsen">{site.werkgebied.map((p) => <option value={p} />)}</datalist>
            </label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Wat moet er gebeuren? <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: kozijnen en voordeur aan de voorkant, hier en daar wat houtrot"></textarea></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-goud"><Icoon naam="wa" />Open in WhatsApp</button>
            <a href={site.telHref} class="link text-sm font-semibold">Liever bellen? {site.tel}</a>
          </div>
        </form>
          <ul class="grid gap-3 sm:grid-cols-3">
          <li><a href={site.telHref} class="kaart flex h-full items-center gap-3.5 p-4 no-underline transition-shadow hover:shadow-md"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-sm bg-nacht text-goud"><Icoon naam="tel" class="h-5 w-5" /></span><span class="text-sm"><b class="block font-semibold">Bellen</b><span class="num text-grijs">{site.tel}</span></span></a></li>
          <li><a href={`mailto:${site.mail}`} class="kaart flex h-full items-center gap-3.5 p-4 no-underline transition-shadow hover:shadow-md"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-sm bg-nacht text-goud"><Icoon naam="mail" class="h-5 w-5" /></span><span class="min-w-0 text-sm"><b class="block font-semibold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span></a></li>
