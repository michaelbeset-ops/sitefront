        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Voor/na-schuif
  document.querySelectorAll<HTMLElement>('[data-vn]').forEach((vn) => {
    const r = vn.querySelector<HTMLInputElement>('input');
    r?.addEventListener('input', () => vn.style.setProperty('--p', r.value + '%'));
  });

  // Offerte-aanvraag als WhatsApp-bericht
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const werk = d.getAll('werk').map(String);
      const r = ['Goedendag Mark, ik wil graag een offerte voor schilderwerk.'];
      if (werk.length) r.push('Soort werk: ' + werk.join(', ').toLowerCase());
      if (v('pand')) r.push('Pand: ' + v('pand').toLowerCase());
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('wens')) r.push('Wat er moet gebeuren: ' + v('wens'));
      if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam'));
      window.open('https://wa.me/31627485879?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

