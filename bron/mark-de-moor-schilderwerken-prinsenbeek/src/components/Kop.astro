---
import { Image } from 'astro:assets';
import wapen from '../assets/wapen.png';
import { url, waOfferte, site } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['diensten', 'Diensten'], ['voor-na', 'Voor en na'], ['technieken', 'Oude technieken'], ['over', 'Over Mark'], ['reviews', 'Reviews'], ['contact', 'Contact']];
---
<div class="bg-nacht text-licht">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[.8125rem]">
    <ul class="flex items-center gap-7 overflow-hidden whitespace-nowrap">
      <li class="flex items-center gap-1.5"><Icoon naam="vink" class="h-3.5 w-3.5 text-goud" />Afspraak = afspraak</li>
      <li class="hidden items-center gap-1.5 sm:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-goud" />Advies bij de prijs inbegrepen</li>
      <li class="hidden items-center gap-1.5 lg:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-goud" />Werkt met Sikkens, Sigma, Wijzonol en Herfst &amp; Helder</li>
    </ul>
    <a href={site.telHref} class="num hidden items-center gap-1.5 font-semibold no-underline hover:text-goud md:flex"><Icoon naam="tel" class="h-3.5 w-3.5" />{site.tel}</a>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-lijn bg-ivoor/95 backdrop-blur-md">
  <div class="wrap flex h-[4.75rem] items-center justify-between gap-6">
    <a href={url('')} class="merk">
      <Image src={wapen} alt="" width={104} height={104} loading="eager" />
      <span><b>Mark de Moor</b><small>Schilderwerken</small><span class="sr-only">, naar de homepage</span></span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-oker">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={site.telHref} class="num hidden font-semibold no-underline transition-colors hover:text-oker xl:inline">{site.tel}</a>
      <a href={waOfferte} class="knop knop-goud knop-klein hidden sm:inline-flex"><Icoon naam="wa" />Offerte aanvragen</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-sm bg-wit shadow-sm lg:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu" aria-label="Menu" class="hidden border-t border-lijn bg-ivoor lg:hidden" data-menu>
    <ul class="wrap py-4">
      {nav.map(([id, t]) => <li><a href={h(id)} class="flex items-center justify-between border-b border-lijn py-3.5 font-kop text-xl font-bold no-underline">{t}<Icoon naam="pijl" class="h-5 w-5 text-oker" /></a></li>)}
      <li class="pt-5"><a href={waOfferte} class="knop knop-goud w-full"><Icoon naam="wa" />Offerte via WhatsApp</a></li>
    </ul>
  </nav>
</header>

<!-- Mobiele onderbalk -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2.5 border-t border-lijn bg-ivoor/95 p-2.5 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="knop knop-inkt knop-klein"><Icoon naam="tel" />Bellen</a>
  <a href={waOfferte} class="knop knop-goud knop-klein"><Icoon naam="wa" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
