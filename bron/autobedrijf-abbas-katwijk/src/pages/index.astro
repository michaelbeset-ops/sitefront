  .text-hero { font-size: var(--text-hero); line-height: 1; letter-spacing: -0.025em; }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; background: var(--color-mist); }
  .status-pil .status-stip { background: #8a93a5; }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border: 1.5px solid #0c142426; background: #fff; font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s, border-color .2s; }
  .keuze span:hover { border-color: var(--color-blauw); }
  .keuze input:checked + span { background: var(--color-blauw); border-color: var(--color-blauw); color: #fff; }
  .keuze input:focus-visible + span, .tab input:focus-visible + span { outline: 3px solid var(--color-blauw); outline-offset: 2px; }
  .tab span { display: flex; align-items: center; justify-content: center; gap: .5rem; min-height: 2.9rem; padding: 0 .75rem; font-family: var(--font-kop); font-weight: 700; font-size: .9375rem; cursor: pointer; color: var(--color-grijs); transition: background-color .2s, color .2s; white-space: nowrap; }
  .tab input:checked + span { background: var(--color-inkt); color: #fff; }
  .veld { display: block; width: 100%; border-radius: 0; border: 1.5px solid #0c142433; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #0c142466; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-blauw); }
  .veld::placeholder { color: #6b7385; text-transform: none; }
</style>
