---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 bg-ink text-white">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-xl font-bold uppercase leading-none no-underline">Van Wendel de Joode <span class="text-rosso-light">&amp; Zn.</span></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-6 font-display text-base uppercase">
          <li><a href="#diensten" class="no-underline hover:text-rosso-light">Diensten</a></li>
          <li><a href="#italiaans" class="no-underline hover:text-rosso-light">Italian cars</a></li>
          <li><a href="#schade-melden" class="no-underline hover:text-rosso-light">Schade melden</a></li>
          <li><a href="#contact" class="no-underline hover:text-rosso-light">Contact</a></li>
        </ul>
      </nav>
      <a href={site.mobielHref} class="btn btn-rosso !px-3.5 !py-1.5 !text-base">Bel</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg uppercase text-white">Autoschadeherstel {site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
