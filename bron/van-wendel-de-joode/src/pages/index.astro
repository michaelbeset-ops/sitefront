---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, diensten } from '../data/site';
import hero from '../assets/hero.jpg';
import ferrari from '../assets/ferrari.jpg';
import rood from '../assets/rood.jpg';
const tijden = [['Maandag t/m donderdag', '08.00 tot 17.00'], ['Vrijdag', '08.00 tot 16.30'], ['Zaterdag en zondag', 'Gesloten']];
const nodig = ['Kenteken, merk en type', 'Uw verzekeraar en polisnummer', 'Dekking (WA, WA plus of all risk) en eigen risico', "Een paar foto's van de schade", 'Of u vervangend vervoer nodig heeft'];
---
<Base
  title="Van Wendel de Joode & Zn. | Autoschadeherstel in Sleeuwijk"
  description="Al meer dan 30 jaar onafhankelijk autoschadeherstel in Sleeuwijk, voor alle merken en verzekeraars. Haal- en brengservice, vervangend vervoer en specialist in Italiaanse sportauto's."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="relative overflow-hidden bg-ink pb-16 pt-12 text-white lg:pb-28 lg:pt-24">
      <div class="absolute inset-0 lg:left-1/3"><Foto src={hero} alt="Schadehersteller werkt aan de achterkant van een auto" hero sizes="100vw" class="opacity-35 lg:opacity-70" /></div>
      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/10"></div>
      <div class="wrap relative grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="font-display text-lg uppercase tracking-wide text-rosso-light">Autoschadeherstel in Sleeuwijk · al ruim 30 jaar</p>
          <h1 class="mt-4 text-4xl">Onze beste reclame zie je niet</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">
            Een goed herstel is onzichtbaar. Wij repareren grote en kleine schades aan alle merken, regelen de afhandeling met uw verzekering
            en zorgen voor vervangend vervoer. U hoeft niet blij te zijn dat u ons nodig heeft, maar we zorgen dat u blij bent met ons.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.mobielHref} class="btn btn-rosso">Bel {site.mobiel}</a>
            <a href="#schade-melden" class="btn btn-line">Schade melden</a>
          </div>
          <p class="mt-8 text-sm text-white/70"><span class="font-bold text-white">4,6</span> op Google · onafhankelijk, voor alle verzekeraars</p>
        </div>
        <aside aria-labelledby="open" class="self-end border-t-4 border-rosso bg-ink/85 p-6 backdrop-blur-sm lg:col-span-4 lg:col-start-9">
          <h2 id="open" class="text-2xl">Openingstijden</h2>
          <dl class="mt-4 space-y-2">
            {tijden.map(([d, t]) => <div class="flex justify-between gap-4 border-b border-white/10 pb-2"><dt>{d}</dt><dd class={`whitespace-nowrap tabular-nums ${t === 'Gesloten' ? 'text-white/55' : ''}`}>{t}</dd></div>)}
          </dl>
        </aside>
      </div>
    </section>

    <section id="diensten" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Waar u bij ons voor terechtkunt</h2>
        <p class="mt-5 text-lg">Wij zijn een onafhankelijk schadeherstelbedrijf. Dat betekent dat we schades afhandelen met alle verzekeringsmaatschappijen.</p>
        <div class="mt-8 aspect-[16/11] overflow-hidden"><Foto src={rood} alt="Glanzend rode sportauto van dichtbij" sizes="(min-width: 1024px) 460px, 100vw" /></div>
      </div>
      <ul class="grid content-start gap-x-10 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
        {diensten.map((d) => (
          <li class="flex gap-3 border-b border-line py-4">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" class="mt-1 shrink-0"><path d="M3 9.5l4 4 8-9" fill="none" stroke="#b3131b" stroke-width="2.4" stroke-linecap="square"/></svg>
            <span>{d}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="italiaans" class="scroll-mt-20 bg-ink text-white">
      <div class="grid lg:grid-cols-2">
        <div class="aspect-[4/3] overflow-hidden lg:aspect-auto"><Foto src={ferrari} alt="Rode klassieke Ferrari in een werkplaats" sizes="(min-width: 1024px) 50vw, 100vw" /></div>
        <div class="flex flex-col justify-center px-5 py-16 md:px-10 lg:px-16">
          <p class="font-display text-lg uppercase tracking-wide text-rosso-light">Italian cars</p>
          <h2 class="mt-3 text-3xl">Ook voor Ferrari en Lamborghini</h2>
          <p class="mt-5 max-w-lg text-lg text-white/85">
            Onze passie voor schadeherstel gaat samen met een passie voor Italiaanse sportauto's. Daardoor vertrouwen veel eigenaren
            van deze dure auto's hun geliefde bolide aan ons toe.
          </p>
          <p class="mt-4 text-sm text-white/70">[[AANLEVEREN: eigen foto's van herstelde Italiaanse auto's, met akkoord van de eigenaar]]</p>
        </div>
      </div>
    </section>

    <section id="schade-melden" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Schade melden</h2>
        <p class="mt-5 text-lg">Geef uw schade online door, dan nemen we zo snel mogelijk contact met u op. Houd dit bij de hand:</p>
        <ol class="mt-6 space-y-3">
          {nodig.map((n, i) => <li class="flex gap-4"><span class="font-display text-2xl font-bold leading-none text-rosso">{i + 1}</span><span>{n}</span></li>)}
        </ol>
      </div>
      <form class="grid gap-4 lg:col-span-6 lg:col-start-7" aria-describedby="form-uit" onsubmit="return false">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-1 text-sm font-medium">Naam<input type="text" name="naam" autocomplete="name" class="border border-line bg-white px-3 py-2.5 text-base" /></label>
          <label class="grid gap-1 text-sm font-medium">Telefoon<input type="tel" name="tel" autocomplete="tel" class="border border-line bg-white px-3 py-2.5 text-base" /></label>
          <label class="grid gap-1 text-sm font-medium">Kenteken<input type="text" name="kenteken" class="border border-line bg-white px-3 py-2.5 text-base uppercase" /></label>
          <label class="grid gap-1 text-sm font-medium">Verzekeraar<input type="text" name="verzekeraar" class="border border-line bg-white px-3 py-2.5 text-base" /></label>
        </div>
        <label class="grid gap-1 text-sm font-medium">Wat is er gebeurd?<textarea name="omschrijving" rows="4" class="border border-line bg-white px-3 py-2.5 text-base"></textarea></label>
        {site.voorstel ? (
          <p id="form-uit" class="bg-steel p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel {site.tel} of mail naar{' '}<a href={`mailto:${site.mail}`} class="font-medium underline">{site.mail}</a>.</p>
        ) : (
          <button type="submit" class="btn btn-rosso justify-self-start">Verstuur melding</button>
        )}
      </form>
    </section>

    <section id="contact" class="scroll-mt-20 bg-steel py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Langskomen in Sleeuwijk</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-rosso mt-6">Route plannen</a>
        </div>
        <dl class="grid content-start gap-4 text-lg lg:col-span-6 lg:col-start-7">
          <div><dt class="text-sm text-ink-soft">Mobiel</dt><dd><a href={site.mobielHref} class="font-display text-3xl font-bold underline decoration-rosso decoration-2 underline-offset-4">{site.mobiel}</a></dd></div>
          <div><dt class="text-sm text-ink-soft">Werkplaats</dt><dd><a href={site.telHref} class="font-display text-3xl font-bold underline decoration-rosso decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-ink-soft">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="underline decoration-rosso decoration-2 underline-offset-4">{site.mail}</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
