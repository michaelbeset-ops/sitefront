---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const diensten = [['reparatie', 'Uurwerk'], ['reparatie', 'Kast'], ['reparatie', 'Wijzerplaat'], ['werkwijze', 'Ophalen en thuisbrengen'], ['aanvraag', 'Klok aanmelden']];
---
<footer class="bg-nacht text-mist">
  <div class="wrap"><div class="cijferring text-merk"></div></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1.0625rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Reparaties en restauraties van moderne en antieke klokken. Klokkenmaker {site.eigenaar}, {site.plaats}.</p>
      <a href={site.telHref} class="knop knop-merk num mt-7 min-h-12 px-5"><Icoon naam="tel" />{site.tel}</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Reparatie en restauratie</p>
      <ul class="mt-5 space-y-2.5">
        {diensten.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-merk">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2.5">
        <li><a href={site.telHref} class="num no-underline hover:text-merk">{site.tel}</a></li>
        <li><a href={waHoi} class="no-underline hover:text-merk">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-merk">{site.mail}</a></li>
        <li>{site.plaats}</li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Volgen</p>
      <ul class="mt-5 space-y-2.5">
        <li><a href={site.insta} class="inline-flex items-center gap-2 no-underline hover:text-merk"><Icoon naam="insta" class="h-5 w-5" />Instagram</a></li>
        <li><a href={site.fb} class="inline-flex items-center gap-2 no-underline hover:text-merk"><Icoon naam="fb" class="h-5 w-5" />Facebook</a></li>
        <li class="pt-3 text-wit">Alleen op afspraak</li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Teksten en eigen foto's van jullie website kuiperuurwerktechniek.nl. Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 12 oktober 2026).</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
