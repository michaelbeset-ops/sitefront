---
// Nagezet naar hun logo (bron/site/img/logo2.png): KUIPER in brede messingkleurige kapitalen, daaronder Uurwerktechniek met ruime spatiëring.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col items-start leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class={`text-[1.7rem] font-[800] uppercase tracking-[.16em] sm:text-[2rem] ${donker ? 'text-merk-donker' : 'text-merk'}`}>Kuiper</span>
  <span class="mt-1 pl-[.08em] text-[.8rem] font-[500] tracking-[.24em] sm:text-[.92rem]">Uurwerktechniek</span>
  <span class="sr-only">, naar de homepage</span>
</a>
