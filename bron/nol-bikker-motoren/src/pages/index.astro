---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, werkplaatsMail, vraagMail } from '../data/site';
import mach from '../assets/mach.jpg';
import w1 from '../assets/w1.jpg';
import loods from '../assets/loods.jpg';
import nieuw from '../assets/nieuw.jpg';
import werkplaats from '../assets/werkplaats.jpg';

const tel = `<svg viewBox="0 0 24 24" class="h-[1.05em] w-[1.05em]" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>`;
const motoren = ['Supersport', 'Sports', 'Touring', 'Cruiser', 'Dual purpose', 'Motocross'];
---
<Base title="Nol Bikker Motoren | Kawasaki-dealer in Noordeloos, met eigen museum" description="Kawasaki-dealer aan de Grotewaard 8 in Noordeloos, vlak langs de A27. Nieuwe Kawasaki's, jet-ski, quad, ATV en Mule, een eigen werkplaats en een museum vol klassiekers. Bel 0183 582 200.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. Voor de Mach IV -->
    <section class="relative grid lg:h-[calc(100svh-4.5rem-2rem)] lg:max-h-[54rem] lg:min-h-[38rem] lg:grid-cols-12">
      <figure class="relative aspect-[4/3] overflow-hidden lg:order-2 lg:col-span-7 lg:aspect-auto">
        <Foto src={mach} alt="Een zwartgroene Kawasaki 750 Mach IV in het museum van Nol Bikker, tegen de grenen wand" hero sizes="(min-width: 1024px) 58vw, 100vw" class="object-[55%_60%]" />
        <figcaption class="absolute bottom-6 right-0 bg-tank px-4 py-2 text-[.82rem] text-mist md:px-6"><span class="text-bies">Kawasaki 750 Mach IV</span>, in het museum</figcaption>
      </figure>
      <div class="flex flex-col justify-center px-5 pb-14 pt-9 md:px-12 lg:order-1 lg:col-span-5 lg:py-12 xl:pl-[max(3rem,calc((100vw-90rem)/2+3rem))]">
        <p class="text-[1.05rem] text-mist">Kawasaki-dealer in Noordeloos</p>
        <h1 class="mt-3 text-[clamp(3.4rem,15vw,5.2rem)] lg:text-[clamp(4.4rem,7.2vw,7.6rem)]">Nol Bikker <span class="block text-groen">Motoren</span></h1>
        <p class="mt-7 max-w-[27rem] text-lg leading-relaxed">Nieuwe Kawasaki's, een eigen werkplaats en een museum vol klassiekers. Vlak langs de A27, tussen Vianen en Gorinchem.</p>
        <div class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-9">
          <a href={site.telHref} class="streep text-[1.2rem]"><Fragment set:html={tel} />Bel <span class="tabular-nums">{site.tel}</span></a>
          <a href="#werkplaats" class="lijn font-medium">Afspraak werkplaats</a>
        </div>
      </div>
      <!-- de bies van de tank als afsluiting van het eerste scherm -->
      <div aria-hidden="true" class="absolute inset-x-0 bottom-0 hidden h-[14px] lg:block" style="background: linear-gradient(var(--color-groen) 0 8px, transparent 8px 11px, var(--color-bies) 11px 13px, transparent 13px);"></div>
    </section>

    <!-- 2. Het museum, tegen de grenen wand -->
    <section id="museum" class="scroll-mt-16 bg-grenen text-tank">
      <div class="wrap grid items-end gap-10 py-20 md:py-28 lg:grid-cols-12 lg:gap-14">
        <figure class="overflow-hidden lg:col-span-7">
          <Foto src={w1} alt="Een blauwe Kawasaki-klassieker met krom gebogen uitlaten, naast een groene Z in het museum" sizes="(min-width: 1024px) 55vw, 100vw" class="aspect-[16/10]" />
        </figure>
        <div class="lg:col-span-5">
          <h2 class="text-2xl">Groen bloed.</h2>
          <p class="mt-6 text-lg leading-relaxed">Klanten noemen Nol "de man met groen bloed". In de zaak staat zijn eigen museum: een collectie Kawasaki-klassiekers, spik en span.</p>
          <p class="mt-4 text-lg leading-relaxed">En ook de koffie krijgt in de reviews een compliment.</p>
          <figure class="mt-10 grid grid-cols-[9rem_1fr] items-end gap-4 sm:grid-cols-[13rem_1fr]">
            <Foto src={loods} alt="Rijen Kawasaki-klassiekers voor de groene houten loods" sizes="13rem" class="aspect-[4/3]" />
            <figcaption class="text-sm">Diverse Kawasaki-klassiekers op een rij, ook te koop als occasion.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 3. Het aanbod, als register -->
    <section id="aanbod" class="wrap grid scroll-mt-16 gap-12 py-20 md:py-28 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <h2 class="sr-only">Aanbod</h2>
        <ul class="font-display text-[clamp(2.6rem,6vw,5.2rem)] font-extrabold italic leading-[1.02]">
          <li>Motoren
            <span class="mt-2 mb-5 block font-sans text-base font-medium not-italic leading-relaxed text-mist">{motoren.join(' · ')}</span>
          </li>
          <li>Jet-ski</li>
          <li>Quad <span class="text-groen">&amp;</span> ATV</li>
          <li>Mule</li>
          <li class="text-groen">Klassiekers</li>
        </ul>
      </div>
      <div class="self-end lg:col-span-6">
        <figure class="overflow-hidden">
          <Foto src={nieuw} alt="Nieuwe groene Kawasaki-motoren op het voorplein, met een Kawasaki-vlag" sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[16/9]" />
        </figure>
        <p class="mt-6 max-w-md text-lg leading-relaxed">Alles van Kawasaki, en alleen Kawasaki. Bij Nol is iedereen Kawasaki-minded.</p>
        <p class="mt-5"><a href={vraagMail} class="lijn font-semibold">Vraag naar een model of occasion</a></p>
      </div>
    </section>

    <!-- 4. Werkplaats -->
    <section id="werkplaats" class="scroll-mt-16 bg-tank-licht">
      <div class="wrap grid items-center gap-10 py-20 md:py-28 lg:grid-cols-12 lg:gap-14">
        <div class="lg:order-2 lg:col-span-5 lg:col-start-8">
          <h2 class="text-2xl">De werkplaats.</h2>
          <p class="mt-6 text-lg leading-relaxed">Onderhoud aan uw Kawasaki in de eigen werkplaats. Klanten noemen Nol een echte vakman.</p>
          <p class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-9">
            <a href={werkplaatsMail} class="streep text-[1.1rem]">Afspraak per mail</a>
            <a href={site.telHref} class="lijn">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </p>
        </div>
        <figure class="overflow-hidden lg:order-1 lg:col-span-6">
          <Foto src={werkplaats} alt="Een zwartgroene Kawasaki in opbouw in de werkplaats, met groen gespoten carburateurs" sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/3]" />
        </figure>
      </div>
    </section>

    <!-- 5. 2009 -->
    <section class="bg-groen text-tank">
      <p class="wrap py-10 font-display text-[clamp(1.4rem,2.4vw,2.1rem)] font-semibold italic leading-snug">30 mei 2009: Nol Bikker Motoren bestond dertig jaar, en vierde dat met de toertocht met de meeste Kawasaki's ooit.</p>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
