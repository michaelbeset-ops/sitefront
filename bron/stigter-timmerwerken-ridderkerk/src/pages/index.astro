---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, diensten, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import dakkapelVoor from '../assets/dakkapel-voor.jpg';
import dakkapelAchter from '../assets/dakkapel-achter.jpg';
import kozijn from '../assets/kozijn-werkplaats.jpg';
import steiger from '../assets/steiger.jpg';
import bediening from '../assets/bediening.jpg';
import schuifwandkast from '../assets/schuifwandkast.jpg';
import laminaat from '../assets/laminaat.jpg';
import badkamer from '../assets/badkamer.jpg';
import raambekleding from '../assets/raambekleding.jpg';
import keuken from '../assets/keuken.jpg';
import keuken2 from '../assets/keuken-2.jpg';
import kastRaam from '../assets/kast-raam.jpg';
import wastafel from '../assets/wastafel.jpg';
import uitzicht from '../assets/uitzicht.jpg';
import douche from '../assets/douche-zit.jpg';
import radiatorknop from '../assets/radiatorknop.jpg';
import apparatuur from '../assets/apparatuur.jpg';
import overkapping from '../assets/overkapping.jpg';
import overkapVoor from '../assets/overkap-voor.jpg';
import overkapBouw from '../assets/overkap-bouw.jpg';
import inloopkast from '../assets/inloopkast.jpg';
import glaskast from '../assets/glaskast.jpg';
import kastBruin from '../assets/kast-bruin.jpg';
import regendouche from '../assets/regendouche.jpg';
import radiatorZwart from '../assets/radiator-zwart.jpg';
import toilet from '../assets/toilet.jpg';
import toiletTegel from '../assets/toilet-tegel.jpg';
import badmeubel from '../assets/badmeubel.jpg';
import tegelsRuit from '../assets/tegels-ruit.jpg';
import bus from '../assets/bus.jpg';

const vraag = (d: string) => waMet(`Hallo Marco, ik heb een vraag over ${d.toLowerCase()}. Kunt u een vrijblijvende offerte maken?`);

// Negen diensten met hun eigen zin van de homepage (licht ingekort) en een eigen foto.
const dienstKaarten = [
  { t: 'Dakkapellen', d: 'Kwalitatief goede dakkapellen, traditioneel opgebouwd.', src: dakkapelAchter, alt: 'Een nieuwe witte dakkapel over bijna de hele breedte van een pannendak', pos: '50% 40%' },
  { t: 'Kozijnen, ramen en deuren', d: 'Kozijnen worden altijd tot in de perfectie afgewerkt.', src: kozijn, alt: 'Nieuwe houten kozijnen met deuren, nog in de grondverf', pos: '50% 35%' },
  { t: 'Timmerwerk', d: 'Timmerwerk van hoogwaardige kwaliteit, in en rondom het huis.', src: overkapVoor, alt: 'Een houten overkapping met balustrade in aanbouw in een achtertuin', pos: '50% 50%' },
  { t: 'Stuc- en sauswerk', d: 'Met nauwkeurigheid gedaan, voor de beste resultaten.', src: bediening, alt: 'Een strak gestucte en gesauste witte muur met twee ronde bedieningsknoppen', pos: '40% 50%' },
  { t: 'Schuifwand- en inloopkasten', d: 'Inbouwen is geen probleem: alles kan perfect op maat.', src: schuifwandkast, alt: 'Een witte schuifwandkast van vloer tot plafond met een open middenvak', pos: '50% 50%' },
  { t: 'Laminaat', d: 'Een laminaatvloer leggen, met materiaal van topkwaliteit.', src: laminaat, alt: 'Een lichte kamer met een nieuwe laminaatvloer in eikenkleur', pos: '50% 60%' },
  { t: 'Badkamers en toiletten', d: 'Ingebouwd met de nieuwste technieken en snufjes.', src: badkamer, alt: 'Een witte betegelde badkamer met een zwart wastafelmeubel en een regendouche', pos: '50% 55%' },
  { t: 'Raambekleding en hordeuren', d: 'Ook uw raambekleding en hordeuren worden verzorgd.', src: raambekleding, alt: 'Een raam in een bakstenen gevel met witte raambekleding aan de binnenkant', pos: '50% 50%' },
  { t: 'Verbouwingen', d: 'Van een nieuwe keuken tot een complete woning.', src: keuken, alt: 'Een nieuwe keuken met houten werkblad, inductiekookplaat en een donkere wand', pos: '50% 50%' },
];

// Projecten: verhalen uit hun eigen pagina Verbouwingen en hun Facebook-post (november 2024). Foto's van eigen werk.
const projecten = [
  {
    id: 'renovatie', t: 'Renovatie woning', plaats: 'Ridderkerk', cover: dakkapelVoor, coverAlt: 'De voorgevel van een hoekwoning met een nieuwe witte dakkapel',
    tekst: [
      'Aan de voor- en achterkant zijn handgemaakte dakkapellen geplaatst. Beneden kwam een nieuwe keuken met luxe apparaten, de woonkamer kreeg vloerverwarming en alle muren en plafonds zijn gestuct en gesaust.',
      'Een verdieping hoger de badkamer, met een draadloze speaker achter de spiegel. In de twee slaapkamers een schuifwandkast, in breedte en hoogte exact op maat en van twee kanten te openen.',
    ],
    fotos: [
      { src: dakkapelVoor, alt: 'Voorgevel met een nieuwe witte dakkapel en een kleinere dakkapel op de zijkant' },
      { src: dakkapelAchter, alt: 'Achterkant van de woning met een brede nieuwe dakkapel' },
      { src: keuken2, alt: 'Een witte keuken met kookeiland en een betegelde achterwand' },
      { src: schuifwandkast, alt: 'Een witte schuifwandkast van vloer tot plafond' },
      { src: wastafel, alt: 'Een witte wastafel met een moderne kraan in de nieuwe badkamer' },
    ],
  },
  {
    id: 'appartement', t: 'Appartement vernieuwd', plaats: 'Ridderkerk', cover: uitzicht, coverAlt: 'De lege woonkamer van een appartement met een groot raam en uitzicht op bomen',
    tekst: [
      'Een oud appartement volledig vernieuwd tot een luxe appartement, van alle gemakken voorzien en keurig strak afgewerkt.',
      'In de douche een zit onder de douchekop, met het oog op minder validen. De bediening van het zonnescherm opnieuw in de muur, met nieuwe knoppen. En de radiatorknop keurig uitgezaagd onder de vensterbank.',
    ],
    fotos: [
      { src: uitzicht, alt: 'De woonkamer met een groot raam en uitzicht over het groen' },
      { src: keuken, alt: 'De keuken met houten werkblad en een elektrische kookplaat' },
      { src: apparatuur, alt: 'Twee inbouwovens in een witte keukenkast' },
      { src: douche, alt: 'Een betegelde douche met een zitje onder de douchekop' },
      { src: radiatorknop, alt: 'Een radiatorombouw met een uitgezaagde opening voor de radiatorknop' },
      { src: laminaat, alt: 'Een kamer met een nieuwe laminaatvloer' },
    ],
  },
  {
    id: 'overkapping', t: 'Grote overkapping', plaats: 'November 2024', cover: overkapping, coverAlt: 'Een grote houten overkapping in aanbouw in een achtertuin',
    tekst: [
      'Een grote houten overkapping in een achtertuin: eerst het staanderwerk en de vloer, daarna de wanden, de balustrade en het dak.',
    ],
    fotos: [
      { src: overkapping, alt: 'De overkapping in aanbouw, met planken en een afkortzaag op de voorgrond' },
      { src: overkapVoor, alt: 'De voorkant van de overkapping met een houten balustrade' },
      { src: overkapBouw, alt: 'Binnen in de overkapping tijdens de bouw, met de vloerbalken' },
    ],
  },
  {
    id: 'kasten', t: 'Kasten op maat', plaats: 'Schuifwand- en inloopkasten', cover: inloopkast, coverAlt: 'Een inloopkast met houten legplanken en een spotje in het plafond',
    tekst: [
      'Het inbouwen van schuifwandkasten en inloopkasten is geen probleem. Alles kan perfect op maat ingepast worden, ook onder een schuin dak of onder het raam.',
    ],
    fotos: [
      { src: inloopkast, alt: 'Een inloopkast met houten legplanken tot onder het schuine dak' },
      { src: glaskast, alt: 'Een schuifwandkast met matglazen deuren en spotjes erboven' },
      { src: kastBruin, alt: 'Een schuifwandkast met donkere houten deuren en een open vak met planken' },
      { src: kastRaam, alt: 'Witte inbouwkasten onder een raam in een slaapkamer' },
    ],
  },
  {
    id: 'badkamers', t: 'Badkamers en toiletten', plaats: 'Verschillende projecten', cover: regendouche, coverAlt: 'Een witte betegelde douche met een regendouche',
    tekst: [
      'Badkamers en toiletten worden met de nieuwste technieken en snufjes ingebouwd. Let vooral op de afwerking van alle hoeken en naden.',
    ],
    fotos: [
      { src: badkamer, alt: 'Een witte badkamer met een zwart wastafelmeubel' },
      { src: regendouche, alt: 'Een regendouche tegen witte tegels' },
      { src: radiatorZwart, alt: 'Een zwarte designradiator naast het raam in een badkamer' },
      { src: toilet, alt: 'Een hangtoilet in een licht betegelde ruimte' },
      { src: toiletTegel, alt: 'Een hangtoilet tegen grote grijze tegels' },
      { src: badmeubel, alt: 'Een wit badmeubel met spiegelkast' },
      { src: tegelsRuit, alt: 'Een douche met zwart-witte tegels in ruitpatroon' },
    ],
  },
  {
    id: 'kozijnen', t: 'Kozijnen en ramen', plaats: 'Van werkplaats tot gevel', cover: steiger, coverAlt: 'Een steiger voor de gevel van een rijtjeshuis met nieuwe ramen',
    tekst: [
      'Kozijnen, ramen en deuren worden altijd tot in de perfectie afgewerkt. Ook de raambekleding en hordeuren worden verzorgd.',
    ],
    fotos: [
      { src: steiger, alt: 'Een steiger voor de gevel, met de nieuwe ramen van de verdieping' },
      { src: kozijn, alt: 'Nieuwe houten kozijnen met deuren, nog in de grondverf' },
      { src: raambekleding, alt: 'Een raam met witte raambekleding in een bakstenen gevel' },
    ],
  },
];

const stappen = [
  ['Stuur een appje', 'Vertel wat u wilt laten maken. Een foto van de plek helpt. Bellen of mailen kan ook.'],
  ['Samen bekijken', 'Marco denkt mee over maat, materiaal en planning, en u krijgt een vrijblijvende offerte.'],
  ['Op maat gemaakt', 'Of het nu een kast, kozijn of dakkapel is: alles wordt exact op maat ingepast.'],
  ['Strak opgeleverd', 'Keurig en strak afgewerkt, tot in de hoeken en naden.'],
];

const details = [
  { src: douche, alt: 'Een betegelde douche met een zitje van donkergrijze tegels onder de douchekop', t: 'Een zit onder de douchekop', d: 'Met het oog op minder validen.', pos: '50% 70%' },
  { src: radiatorknop, alt: 'Een witte radiatorombouw met een keurig uitgezaagde opening voor de radiatorknop', t: 'De radiatorknop uitgezaagd', d: 'Keurig, onder de vensterbank.', pos: '50% 50%' },
  { src: bediening, alt: 'Twee nieuwe ronde bedieningsknoppen in een strak gestucte muur', t: 'Bediening in de muur', d: 'Voor het zonnescherm, met nieuwe knoppen.', pos: '45% 50%' },
];
---
<Base title={`${site.naam} | Timmerwerk in en rondom het huis, Ridderkerk`} description="Marco Stigter uit Ridderkerk: dakkapellen, kozijnen, schuifwand- en inloopkasten, badkamers, laminaat en complete verbouwingen. Vrijblijvende offerte via WhatsApp.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen dakkapel op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[800, 1300, 1900, 2600]} sizes="(min-width: 768px) 165vw, 400vw" loading="eager" fetchpriority="high" quality={68} class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_55%] md:object-[85%_80%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0e131a40_0%,#0e131ab8_45%,#0e131af5_100%)] md:bg-[linear-gradient(90deg,#0e131af5_0%,#0e131ad0_38%,#0e131a40_75%,#0e131a10_100%)]" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-[linear-gradient(0deg,#0e131acc,transparent)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-32 md:pb-24 md:pt-40 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Timmer- en montagebedrijf in Ridderkerk</p>
          <h1 id="t-hero" class="mt-6 text-hero">Timmerwerk in en <span class="text-hemel">rondom het huis.</span></h1>
          <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Marco Stigter maakt dakkapellen, kozijnen en kasten op maat, bouwt badkamers in en verbouwt complete woningen.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-blauw"><Icoon naam="wa" />Offerte via WhatsApp</a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-hemel" />Alles op maat ingepast</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-hemel" />Keurig en strak afgewerkt</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-hemel" />Vrijblijvende offerte</li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:flex lg:justify-end">
          <div class="rounded-md bg-nacht/75 px-6 py-5 text-right ring-1 ring-licht/10 backdrop-blur-md">
            <p class="flex items-center justify-end gap-2 text-[.9375rem]"><span class="flex text-ster">{[1, 2, 3, 4, 5].map((n) => <Icoon naam="ster" class={`h-4 w-4 ${n === 5 ? 'opacity-40' : ''}`} />)}</span><b class="num">{site.google.score}</b> op Google</p>
            <p class="mt-1 text-sm text-licht-zacht">Direct contact met Marco</p>
            <a href={site.telHref} class="num mt-1 block font-kop text-[2rem] font-extrabold tracking-[-0.02em] text-licht no-underline [font-stretch:112%] hover:text-hemel">{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Diensten in het kort -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-2.5 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {diensten.map((c) => <a href="#diensten" class="shrink-0 rounded-sm border border-lijn px-3.5 py-2 text-sm font-medium no-underline transition-colors hover:border-blauw hover:bg-blauw hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-24 lg:py-32" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-5 text-3xl">Van dakkapel tot inloopkast.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Negen vakgebieden, van klein timmerwerk tot een complete verbouwing. Alle foto's zijn van eigen werk. Klik op een dienst en stel uw vraag meteen via WhatsApp.</p>
        </div>
        <ul class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-5">
          {dienstKaarten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="dienst group relative block aspect-[16/9] sm:aspect-[4/3] overflow-hidden rounded-md bg-nacht text-licht no-underline">
                <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1264px) 400px, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]" style={`object-position:${b.pos}`} />
                <span class="absolute inset-0 bg-[linear-gradient(180deg,#0e131a1a_0%,#0e131a33_35%,#0e131af2_100%)]" aria-hidden="true"></span>
                <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-5 sm:p-6">
                  <span>
                    <span class="num block font-kop text-xs font-bold tracking-[.2em] text-hemel [font-stretch:118%]">0{i + 1}</span>
                    <h3 class="mt-2 text-xl uppercase tracking-[.01em] [font-stretch:115%]">{b.t}</h3>
                    <span class="mt-1.5 block text-[.9375rem] leading-snug text-licht/85">{b.d}</span>
                  </span>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-licht/15 backdrop-blur transition-colors group-hover:bg-blauw" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Projecten: Werk dat blijft -->
    <section id="projecten" class="donker bg-nacht py-24 text-licht lg:py-32" aria-labelledby="t-projecten">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-projecten" class="mt-5 text-3xl uppercase [font-stretch:118%]">Werk dat blijft.</h2>
            <p class="mt-6 max-w-xl text-lg text-licht-zacht">Een greep uit eigen werk. Klik op een project voor de foto's en het verhaal.</p>
          </div>
          <div class="flex gap-2" aria-hidden="true">
            <button type="button" class="grid h-12 w-12 place-items-center rounded-sm border border-lijn-licht transition-colors hover:bg-licht hover:text-inkt" data-schuif="-1" tabindex="-1"><Icoon naam="links" class="h-5 w-5" /></button>
            <button type="button" class="grid h-12 w-12 place-items-center rounded-sm bg-blauw transition-colors hover:bg-blauw-diep" data-schuif="1" tabindex="-1"><Icoon naam="pijl" class="h-5 w-5" /></button>
          </div>
        </div>
      </div>
      <ul class="projecten mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-6 [scrollbar-width:none] md:gap-5 lg:mt-14" data-rail>
        {projecten.map((p, i) => (
          <li class="w-[82%] shrink-0 snap-start sm:w-[24rem] lg:w-[29rem]">
            <button type="button" class="group block w-full text-left" data-open={p.id} aria-haspopup="dialog">
              <span class="relative block aspect-[4/3] overflow-hidden rounded-md bg-nacht-2">
                <Image src={p.cover} alt={p.coverAlt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 464px, (min-width: 640px) 384px, 82vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                <span class="absolute left-4 top-4 rounded-sm bg-nacht/80 px-2.5 py-1 text-xs font-semibold backdrop-blur">{p.fotos.length} foto's</span>
              </span>
              <span class="mt-5 flex items-baseline justify-between gap-4 border-b border-lijn-licht pb-4">
                <span class="font-kop text-xl font-extrabold uppercase tracking-[-0.01em] [font-stretch:115%] group-hover:text-hemel">{p.t}</span>
                <span class="num shrink-0 font-kop text-xs font-bold tracking-[.18em] text-hemel">0{i + 1}</span>
              </span>
              <span class="mt-3 block text-sm text-licht-zacht">{p.plaats}</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="wrap">
        <div class="h-[3px] w-full bg-lijn-licht"><div class="h-full w-1/4 bg-hemel transition-[margin] duration-300" data-voortgang></div></div>
      </div>

      {projecten.map((p) => (
        <dialog id={`p-${p.id}`} class="project m-auto max-h-[92dvh] w-[min(68rem,94vw)] overflow-hidden rounded-md bg-papier p-0 text-inkt" aria-labelledby={`pt-${p.id}`}>
          <div class="grid max-h-[92dvh] overflow-y-auto lg:grid-cols-12">
            <div class="bg-nacht p-2 lg:col-span-7">
              <div class="grid grid-cols-2 gap-2">
                {p.fotos.map((f, j) => (
                  <Image src={f.src} alt={f.alt} widths={[480, 800]} sizes="(min-width: 1024px) 40vw, 92vw" loading="lazy" class={`w-full object-cover ${j === 0 ? 'col-span-2 aspect-[3/2]' : 'aspect-square'}`} />
                ))}
              </div>
            </div>
            <div class="flex flex-col p-6 sm:p-8 lg:sticky lg:top-0 lg:col-span-5 lg:self-start lg:p-10">
              <div class="flex items-start justify-between gap-4">
                <p class="eyebrow">{p.plaats}</p>
                <button type="button" class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-inkt text-licht transition-colors hover:bg-blauw" data-sluit><Icoon naam="kruis" class="h-5 w-5" /><span class="sr-only">Sluiten</span></button>
              </div>
              <h3 id={`pt-${p.id}`} class="mt-4 text-[clamp(1.75rem,1.6vw+1.1rem,2.5rem)] uppercase [overflow-wrap:normal] [font-stretch:112%]">{p.t}</h3>
              <div class="mt-6 space-y-4 text-grijs">{p.tekst.map((t) => <p>{t}</p>)}</div>
              <div class="pt-8">
                <a href={waMet(`Hallo Marco, ik zag het project "${p.t}" op uw website. Zoiets wil ik ook graag laten maken.`)} class="knop knop-blauw w-full sm:w-auto"><Icoon naam="wa" />Zoiets wil ik ook</a>
              </div>
            </div>
          </div>
        </dialog>
      ))}
    </section>

    <!-- 5. Werkwijze -->
    <section id="werkwijze" class="py-24 lg:py-32" aria-labelledby="t-werkwijze">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-werkwijze" class="mt-5 text-3xl">Van eerste appje tot strakke oplevering.</h2>
          </div>
