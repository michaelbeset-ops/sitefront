  <Voet />
</Base>

<script>
  // Projectenrail: pijlen en voortgangsbalk.
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const balk = document.querySelector<HTMLElement>('[data-voortgang]');
  if (rail) {
    const stap = () => (rail.querySelector('li')?.getBoundingClientRect().width || 400) + 20;
    document.querySelectorAll<HTMLButtonElement>('[data-schuif]').forEach((b) => b.addEventListener('click', () => rail.scrollBy({ left: Number(b.dataset.schuif) * stap(), behavior: 'smooth' })));
    const zet = () => { if (!balk) return; const max = rail.scrollWidth - rail.clientWidth; const f = max > 0 ? rail.scrollLeft / max : 0; balk.style.marginLeft = `${f * 75}%`; };
    rail.addEventListener('scroll', zet, { passive: true }); zet();
  }

  // Projecten openen in een venster met alle foto's en het verhaal.
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
    const d = document.getElementById(`p-${b.dataset.open}`) as HTMLDialogElement | null;
    d?.showModal();
  }));
  document.querySelectorAll<HTMLDialogElement>('dialog.project').forEach((d) => {
    d.querySelector('[data-sluit]')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });

  // Offerteformulier: zet de keuzes om in een WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hallo Marco, ik wil graag een vrijblijvende offerte.'];
      if (v('klus')) r.push('Klus: ' + v('klus'));
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
      if (v('wens')) r.push('Omschrijving: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31621931500?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

