  @media (min-width: 768px) { .projecten { padding-inline: max(2.5rem, calc((100vw - 79rem) / 2 + 2.5rem)); scroll-padding-inline: max(2.5rem, calc((100vw - 79rem) / 2 + 2.5rem)); } }
  dialog.project::backdrop { background: #0e131acc; backdrop-filter: blur(4px); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 .95rem; border-radius: var(--radius-sm); border: 1px solid var(--color-lijn); background: var(--color-papier); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s, border-color .2s; }
