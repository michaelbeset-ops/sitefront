---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import dakkapel from '../assets/dakkapel-achter.jpg';
import dakkapelVoor from '../assets/dakkapel-voor.jpg';
import kozijn from '../assets/kozijn-werkplaats.jpg';
import radiator from '../assets/radiatorknop.jpg';
import bediening from '../assets/bediening.jpg';
import kast from '../assets/schuifwandkast.jpg';
import laminaat from '../assets/laminaat.jpg';
import badkamer from '../assets/badkamer.jpg';
import raam from '../assets/raambekleding.jpg';
import keuken from '../assets/keuken.jpg';
import overkapping from '../assets/overkapping.jpg';
import kastRaam from '../assets/kast-raam.jpg';
import wastafel from '../assets/wastafel.jpg';
import keuken2 from '../assets/keuken-2.jpg';
import douche from '../assets/douche-zit.jpg';
import uitzicht from '../assets/uitzicht.jpg';
import steiger from '../assets/steiger.jpg';
import apparatuur from '../assets/apparatuur.jpg';

// Diensten met hun eigen zin van de homepage; de overkapping komt van hun Facebook-pagina (november 2024).
const werk = [
  { t: 'Dakkapellen', d: 'Kwalitatief goede dakkapellen, traditioneel opgebouwd.', src: dakkapel, alt: 'Een nieuwe witte dakkapel over bijna de hele breedte van een pannendak, met een kleinere dakkapel ernaast.', wa: 'dakkapellen' },
  { t: 'Kozijnen, ramen en deuren', d: 'Kozijnen worden altijd tot in de perfectie afgewerkt.', src: steiger, alt: 'Een steiger voor de gevel van een rijtjeshuis, met de ramen van de verdieping erachter.', wa: 'kozijnen, ramen of deuren' },
  { t: 'Timmerwerk', d: 'Timmerwerk van hoogwaardige kwaliteit, in en rondom het huis.', src: kozijn, alt: 'Houten kozijnen in de werkplaats, nog in de grondverf.', wa: 'timmerwerk' },
  { t: 'Stuc- en sauswerk', d: 'Met nauwkeurigheid gedaan, voor de beste resultaten.', src: bediening, alt: 'Een gestucte en gesauste witte muur met twee ronde bedieningsknoppen.', wa: 'stuc- en sauswerk' },
  { t: 'Schuifwandkasten en inloopkasten', d: 'Alles kan perfect op maat worden ingepast.', src: kast, alt: 'Een witte schuifwandkast van vloer tot plafond, met een open middenvak met planken.', wa: 'een schuifwandkast of inloopkast' },
  { t: 'Laminaat', d: 'Een laminaatvloer leggen, met materiaal van topkwaliteit.', src: laminaat, alt: 'Een lege, lichte kamer met een nieuwe laminaatvloer in eikenkleur.', wa: 'laminaat' },
  { t: 'Badkamers en toiletten', d: 'Ingebouwd met de nieuwste technieken en snufjes.', src: badkamer, alt: 'Een witte betegelde badkamer met een zwart wastafelmeubel en een regendouche.', wa: 'een badkamer of toilet' },
  { t: 'Raambekleding en hordeuren', d: 'Ook uw raambekleding en hordeuren worden verzorgd.', src: raam, alt: 'Een raam in een bakstenen gevel met witte raambekleding aan de binnenkant.', wa: 'raambekleding of hordeuren' },
  { t: 'Verbouwingen', d: 'Voor al uw verbouwingen kunt u contact opnemen.', src: keuken, alt: 'Een nieuwe keuken onder een dakraam, met houten werkblad, inductiekookplaat en een donkere wand.', wa: 'een verbouwing' },
  { t: 'Overkappingen', d: 'Zoals de grote overkapping van november 2024.', src: overkapping, alt: 'Een grote houten overkapping in aanbouw in een achtertuin, met planken en een afkortzaag op de voorgrond.', wa: 'een overkapping' },
];
---
<Base title="Stigter Timmer- en Montagebedrijf | Timmerwerk in en rondom het huis, Ridderkerk" description="Marco Stigter uit Ridderkerk: dakkapellen, kozijnen, schuifwandkasten, badkamers, laminaat en complete verbouwingen. Stuur een WhatsApp voor een vrijblijvende offerte.">
  <Kop overBeeld />
  <main id="inhoud">

    <!-- 1. Eerste scherm: hun eigen dakkapel onder een open lucht. De lucht loopt door tot boven in beeld en draagt de kop. -->
    <section class="hero relative isolate flex flex-col overflow-hidden bg-lucht" aria-labelledby="titel">
      <div class="lucht flex flex-1 flex-col justify-end" data-beeld>
        <div class="wrap grid gap-y-7 pb-6 pt-24 md:pt-28 lg:grid-cols-12 lg:items-end lg:gap-x-8 lg:pb-2">
          <h1 id="titel" class="text-4xl lg:col-span-8">Timmerwerk in en rondom het huis.</h1>
          <div class="lg:col-span-4 lg:pb-2">
            <p class="max-w-[24rem] leading-relaxed">Marco Stigter uit Ridderkerk maakt dakkapellen, kozijnen en kasten op maat, bouwt badkamers in en verbouwt complete woningen.</p>
            <p class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-4">
              <a href={waMet('ik heb een vraag over ')} class="knop knop-vol">App Marco</a>
              <a href="#werk" class="ui lijn">Bekijk het werk</a>
            </p>
          </div>
        </div>
      </div>
      <div class="dak relative shrink-0">
        <Image src={hero} alt="Een nieuwe, brede witte dakkapel op een grijs pannendak, met een kleinere dakkapel ernaast en een blauwe lucht erboven." widths={[800, 1300, 1900, 2600]} sizes="(min-width: 768px) 100vw, 260vw" format="webp" quality={72} loading="eager" fetchpriority="high" class="dak-foto absolute inset-0 h-full w-full object-cover" />
      </div>
    </section>

    <!-- 2. Het werk: hun eigen lijst, met de bijbehorende foto die meeschuift. Elke regel kan als appje naar Marco. -->
    <section id="werk" class="wrap scroll-mt-20 py-28 lg:py-40" aria-labelledby="t-werk">
      <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-8">
        <h2 id="t-werk" class="text-3xl lg:col-span-6">Van dakkapel tot inloopkast.</h2>
        <p class="max-w-[26rem] text-grijs lg:col-span-4 lg:col-start-9 lg:self-end">Alle foto's zijn van eigen werk. Kies wat u wilt laten maken en stuur het meteen als appje.</p>
      </div>
      <div class="mt-16 grid gap-y-12 lg:mt-24 lg:grid-cols-12 lg:gap-x-8">
        <div class="hidden lg:col-span-5 lg:block">
          <div class="sticky top-28 aspect-[4/5] overflow-hidden bg-steen" data-werkbeeld>
            {werk.map((w, i) => (
              <Image src={w.src} alt="" widths={[500, 800]} sizes="40vw" format="webp" quality={70} class:list={['werkfoto absolute inset-0 h-full w-full object-cover', { aan: i === 0 }]} data-i={i} />
            ))}
          </div>
        </div>
        <ul class="werk border-t border-lijn lg:col-span-6 lg:col-start-7" data-werk>
          {werk.map((w, i) => (
            <li class="rij group grid grid-cols-[4.5rem_1fr] gap-x-5 border-b border-lijn py-6 md:grid-cols-[6rem_1fr] lg:grid-cols-1 lg:py-7" data-i={i}>
              <div class="aspect-square overflow-hidden bg-steen lg:hidden">
                <Image src={w.src} alt={w.alt} widths={[200, 300]} sizes="6rem" format="webp" quality={65} class="h-full w-full object-cover" />
              </div>
              <div class="flex flex-col gap-x-8 gap-y-2 lg:flex-row lg:items-baseline lg:justify-between">
                <div>
                  <h3 class="text-xl">{w.t}</h3>
                  <p class="mt-1.5 text-grijs">{w.d}</p>
                </div>
                <a href={waMet(`ik heb een vraag over ${w.wa}. `)} class="ui lijn-in shrink-0 self-start whitespace-nowrap lg:self-auto">App hierover<span class="sr-only">: {w.t}</span></a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. Eén project groot: de renovatie in Ridderkerk, in hun eigen woorden. -->
    <section id="renovatie" class="scroll-mt-20 bg-wit py-28 lg:py-40" aria-labelledby="t-renovatie">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
        <figure class="lg:col-span-7">
          <div class="aspect-[1200/795] overflow-hidden bg-steen">
            <Image src={dakkapelVoor} alt="De voorgevel van een hoekwoning met een nieuwe witte dakkapel en een kleinere dakkapel op de zijkant." widths={[600, 900, 1200]} sizes="(min-width: 1024px) 55vw, 100vw" format="webp" quality={72} class="h-full w-full object-cover" />
          </div>
          <figcaption class="mt-4 text-sm text-grijs">Handgemaakte dakkapellen, aan de voor- en achterkant.</figcaption>
        </figure>
        <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
          <h2 id="t-renovatie" class="text-3xl">Renovatie, Ridderkerk.</h2>
          <div class="mt-8 space-y-5 text-grijs">
            <p>Voor en achter nieuwe dakkapellen. Beneden een nieuwe keuken en vloerverwarming in de woonkamer; alle muren en plafonds gestuct en gesaust.</p>
            <p>Boven de badkamer, met een draadloze speaker achter de spiegel. En in de slaapkamers een schuifwandkast, in breedte en hoogte exact op maat, van twee kanten te openen.</p>
          </div>
        </div>
      </div>
      <div class="wrap mt-20 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-8 lg:mt-28 lg:grid-cols-12">
        <figure class="col-span-2 lg:col-span-5">
          <div class="aspect-[1200/795] overflow-hidden bg-steen"><Image src={kastRaam} alt="Een slaapkamer onder het dak met witte inbouwkasten onder een raam met uitzicht op bomen." widths={[500, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" format="webp" quality={70} class="h-full w-full object-cover" /></div>
          <figcaption class="mt-4 text-sm text-grijs">Kasten op maat onder het raam.</figcaption>
        </figure>
        <figure class="lg:col-span-3 lg:col-start-7 lg:mt-24">
          <div class="aspect-[4/5] overflow-hidden bg-steen"><Image src={wastafel} alt="Een witte wastafel met een moderne kraan, in een lichte badkamer." widths={[400, 700]} sizes="(min-width: 1024px) 23vw, 50vw" format="webp" quality={70} class="h-full w-full object-cover" /></div>
          <figcaption class="mt-4 text-sm text-grijs">Badkamer.</figcaption>
        </figure>
        <figure class="lg:col-span-3 lg:mt-48">
          <div class="aspect-[4/5] overflow-hidden bg-steen"><Image src={keuken2} alt="Een witte keuken met kookeiland en een betegelde achterwand." widths={[400, 700]} sizes="(min-width: 1024px) 23vw, 50vw" format="webp" quality={70} class="h-full w-full object-cover object-[60%_50%]" /></div>
          <figcaption class="mt-4 text-sm text-grijs">Keuken.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Het appartement: drie details uit hun eigen tekst, elk met de foto die het laat zien. -->
    <section id="details" class="scroll-mt-20 py-28 lg:py-40" aria-labelledby="t-details">
      <div class="wrap grid gap-y-8 lg:grid-cols-12 lg:gap-x-8">
        <h2 id="t-details" class="text-3xl lg:col-span-6">Let op de kleinste details.</h2>
        <p class="max-w-[28rem] text-grijs lg:col-span-4 lg:col-start-9 lg:self-end">Een oud appartement in Ridderkerk, volledig vernieuwd en keurig strak afgewerkt.</p>
      </div>
      <div class="wrap mt-16 grid gap-y-14 lg:mt-24 lg:grid-cols-12 lg:gap-x-8">
        <figure class="lg:col-span-5">
          <div class="aspect-[4/5] overflow-hidden bg-steen"><Image src={douche} alt="Een witte betegelde douche met een zitje van donkergrijze tegels onder de douchekop." widths={[500, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" format="webp" quality={72} class="h-full w-full object-cover object-[50%_70%]" /></div>
          <figcaption class="detail"><span class="num">1</span><span>Een zit onder de douchekop, met het oog op minder validen.</span></figcaption>
        </figure>
        <div class="grid gap-y-14 lg:col-span-6 lg:col-start-7">
          <figure>
            <div class="aspect-[3/2] overflow-hidden bg-steen"><Image src={radiator} alt="Een witte radiatorombouw onder de vensterbank met een keurig uitgezaagde opening voor de radiatorknop." widths={[500, 800, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" format="webp" quality={72} class="h-full w-full object-cover" /></div>
            <figcaption class="detail"><span class="num">2</span><span>De radiatorknop, keurig uitgezaagd onder de vensterbank.</span></figcaption>
          </figure>
          <figure class="lg:w-2/3">
            <div class="aspect-[3/2] overflow-hidden bg-steen"><Image src={apparatuur} alt="Twee inbouwovens in een witte keukenkast, met verlichting erboven." widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, 100vw" format="webp" quality={72} class="h-full w-full object-cover" /></div>
            <figcaption class="detail"><span class="num">3</span><span>Een keuken met de nieuwste apparatuur en een elektrische kookplaat.</span></figcaption>
          </figure>
        </div>
      </div>
      <figure class="wrap mt-20 lg:mt-28">
        <div class="uitzicht overflow-hidden bg-steen"><Image src={uitzicht} alt="De lege woonkamer van het appartement met een groot raam en uitzicht op bomen." widths={[640, 1000, 1200]} sizes="(min-width: 1280px) 1200px, 100vw" format="webp" quality={72} class="h-full w-full object-cover" /></div>
        <figcaption class="mt-4 flex max-w-[1200px] flex-wrap justify-between gap-x-8 gap-y-3 text-sm text-grijs">
          <span>De woonkamer van het appartement, met uitzicht over het groen.</span>
          <a href={waMet('ik wil graag meer foto\'s zien van ')} class="ui lijn text-inkt">Meer foto's? App Marco</a>
        </figcaption>
      </figure>
    </section>

    <!-- 5. Wat klanten zeggen, samengevat uit Google; geen citaten. -->
    <section class="border-t border-lijn bg-wit py-24 lg:py-32" aria-labelledby="t-klanten">
      <div class="wrap grid gap-y-8 lg:grid-cols-12 lg:gap-x-8">
        <h2 id="t-klanten" class="text-2xl lg:col-span-4">Klanten over hun badkamer.</h2>
        <p class="max-w-[40rem] text-xl leading-snug lg:col-span-7 lg:col-start-6">Prachtig en netjes afgeleverd, flexibel en goed meegedacht. Klanten noemen ook de duidelijke communicatie en het overzicht van de werkzaamheden.</p>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .hero { min-height: calc(100svh - var(--balk, 0px)); }
  .dak { height: 44svh; min-height: 17rem; }
  @media (min-width: 768px) { .dak { height: clamp(20rem, 56svh, 46vw); } }
  :global(.dak-foto) {
    object-position: 63% 100%;
    filter: saturate(.8);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 16%);
  }
  @media (min-width: 768px) { :global(.dak-foto) { object-position: 50% 100%; } }

  :global(.werkfoto) { opacity: 0; transition: opacity .6s var(--ease-zacht); }
  :global(.werkfoto.aan) { opacity: 1; }
  @media (min-width: 1024px) {
    .werk .rij { transition: padding-left .45s var(--ease-zacht); }
    .werk .rij.aan { padding-left: 1.25rem; }
    .werk .rij.aan h3 { color: var(--color-inkt); }
    .werk .rij:not(.aan) h3 { color: var(--color-grijs); }
  }
  .detail { display: grid; grid-template-columns: 1.75rem 1fr; margin-top: 1rem; font-size: var(--text-sm); line-height: 1.6; max-width: 30rem; }
  .detail .num { color: var(--color-grijs); }
  .uitzicht { aspect-ratio: 4 / 3; max-width: 1200px; }
  @media (min-width: 768px) { .uitzicht { aspect-ratio: 1200 / 560; } }
</style>

<script>
  // Werklijst: de foto links schuift mee met de regel die u aanwijst of met het toetsenbord bereikt.
  const lijst = document.querySelector<HTMLElement>('[data-werk]');
  const fotos = document.querySelectorAll<HTMLElement>('[data-werkbeeld] [data-i]');
  if (lijst) {
    const rijen = lijst.querySelectorAll<HTMLElement>('li[data-i]');
    const zet = (i: string) => {
      fotos.forEach((f) => f.classList.toggle('aan', f.dataset.i === i));
      rijen.forEach((r) => r.classList.toggle('aan', r.dataset.i === i));
    };
    rijen.forEach((r) => {
      r.addEventListener('mouseenter', () => zet(r.dataset.i!));
      r.addEventListener('focusin', () => zet(r.dataset.i!));
    });
    zet('0');
  }
</script>
