---
import { site, url, waMet } from '../data/site';
import Merk from './Merk.astro';
---
<footer id="contact" class="donker scroll-mt-20 bg-nacht text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-y-16 pb-20 pt-28 lg:grid-cols-12 lg:gap-x-8 lg:pb-32 lg:pt-40">
    <div class="lg:col-span-6">
      <h2 id="t-contact" class="text-3xl">Een vraag of een vrijblijvende offerte?</h2>
      <p class="mt-8 max-w-[30rem] text-lg leading-relaxed text-licht-zacht">Stuur Marco een appje, met een foto van de plek als u die heeft. Bellen of mailen kan ook.</p>
      <p class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={waMet('ik wil graag een offerte voor ')} class="knop knop-licht">App Marco</a>
        <a href={site.telHref} class="ui num lijn whitespace-nowrap">Bel {site.tel}</a>
      </p>
    </div>

    <dl class="grid grid-cols-1 gap-x-8 gap-y-10 text-[.9375rem] min-[420px]:grid-cols-2 lg:col-span-5 lg:col-start-8 lg:self-end">
      <div>
        <dt class="ui text-licht-zacht">Bellen en WhatsApp</dt>
        <dd class="mt-3"><a href={site.telHref} class="lijn num whitespace-nowrap">{site.tel}</a></dd>
      </div>
      <div>
        <dt class="ui text-licht-zacht">Adres</dt>
        <dd class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</dd>
        <dd class="mt-3"><a href={site.maps} class="lijn text-licht-zacht">Kaart ↗</a></dd>
      </div>
      <div>
        <dt class="ui text-licht-zacht">Mail</dt>
        <dd class="mt-3"><a href={`mailto:${site.mail}`} class="lijn [overflow-wrap:anywhere]">{site.mail}</a></dd>
      </div>
      <div>
        <dt class="ui text-licht-zacht">Facebook</dt>
        <dd class="mt-3"><a href={site.facebook} class="lijn">Stigter op Facebook ↗</a></dd>
      </div>
    </dl>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p class="flex items-center gap-3"><Merk class="h-4 w-auto text-licht" /> <span class="num">{site.naam}, {site.plaats}. {site.google} op Google, uit {site.googleAantal} reviews.</span></p>
    <p><a href={url('privacy/')} class="lijn-in">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Alle foto's zijn van {site.kort} zelf: van timmerwerken-mstigter.nl en, de overkapping, van hun Facebook-pagina. Teksten en gegevens van die website, Facebook en het Google-bedrijfsprofiel.</p>}
</footer>
