---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, eigenschappen, stappen } from '../data/site';
import hero from '../assets/hero.jpg';
import band from '../assets/band.jpg';
import gereedschap from '../assets/gereedschap.jpg';

const telIcoon = 'M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z';
---
<Base
  title="Autocorner Zuid-Beijerland | Allround garage in de Hoeksche Waard"
  description="Onderhoud en reparatie van uw auto aan de Oranjeweg in Zuid-Beijerland. Eerst uitleg en een prijsindicatie, dan pas aan de slag. 5,0 op Google. Bel 0186 669 308."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: foto over de volle breedte, tekst links onderin. Mobiel een egale overlay, desktop een verloop. -->
    <section class="relative isolate overflow-hidden bg-polder-deep text-white">
      <div class="absolute inset-0 -z-10"><Foto src={hero} alt="Lichte werkplaats met meerdere auto's; bij de voorste staat de motorkap open" hero sizes="100vw" class="object-[65%_center]" /></div>
      <div class="absolute inset-0 -z-10 bg-polder-deep/80 md:bg-transparent md:bg-[linear-gradient(90deg,#0e2640f2_0%,#0e2640d9_45%,#0e264026_100%)]"></div>
      <div class="wrap flex min-h-[34rem] flex-col justify-end pb-12 pt-24 md:min-h-[38rem] lg:pb-20">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold text-oker">
          <span>{site.straat}, {site.plaats}</span>
          <span aria-hidden="true" class="hidden h-px w-6 bg-oker sm:block"></span>
          <span>{site.regio}</span>
        </p>
        <h1 class="mt-4 max-w-3xl text-4xl">Allround garage in Zuid-Beijerland</h1>
        <p class="mt-5 max-w-xl text-lg text-white/90">Onderhoud en reparatie van uw auto. We leggen eerst uit wat er moet gebeuren en geven vooraf een prijsindicatie. Pas dan gaan we aan de slag.</p>
        <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
          <a href={site.telHref} class="btn btn-oker">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current"><path d={telIcoon} /></svg>
            Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span>
          </a>
          <a href="#afspraak" class="font-display font-bold text-white underline decoration-oker decoration-2 underline-offset-4 hover:text-oker">Of vraag een afspraak aan</a>
        </div>
      </div>
    </section>

    <!-- Google-score als strook, daarna in eigen woorden wat klanten noemen. -->
    <div class="bg-oker text-ink">
      <div class="wrap flex flex-wrap items-center gap-x-4 gap-y-1 py-4">
        <p class="flex items-center gap-2 font-display text-xl font-bold">
          <span class="whitespace-nowrap tabular-nums">{site.score}</span>
          <span aria-hidden="true" class="tracking-[0.1em]">★★★★★</span>
        </p>
        <p class="text-sm font-semibold">op Google, uit {site.reviews} reviews</p>
      </div>
    </div>
    <section class="wrap py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="klanten" class="text-3xl">Zo omschrijven klanten ons op Google</h2>
          <p class="mt-4 text-ink-soft">Wat er in de reviews steeds terugkomt.</p>
        </div>
        <ul class="border-t border-line lg:col-span-7">
          {eigenschappen.map((e, i) => (
            <li class="flex gap-5 border-b border-line py-4">
              <span class="w-6 shrink-0 font-display font-bold text-polder tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-lg">{e}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Werkwijze: donker vlak, drie stappen als tijdlijn naast de foto van de band. -->
    <section id="werkwijze" class="scroll-mt-16 bg-polder text-white">
      <div class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Zo werken we</h2>
          <p class="mt-4 max-w-md text-white/85">Eerst weten wat er speelt, dan pas sleutelen. Alles in goed overleg.</p>
          <ol class="mt-10 space-y-0">
            {stappen.map((s, i) => (
              <li class="relative grid grid-cols-[2.5rem_1fr] gap-4 pb-8 last:pb-0">
                {i < stappen.length - 1 && <span aria-hidden="true" class="absolute left-[1.2rem] top-11 bottom-2 w-px bg-white/25"></span>}
                <span class="grid size-10 place-items-center rounded-full bg-oker font-display font-bold text-ink">{i + 1}</span>
                <div class="pt-1.5">
                  <h3 class="text-xl">{s.kop}</h3>
                  <p class="mt-1.5 text-white/85">{s.tekst}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="aspect-[4/3] overflow-hidden rounded-xl lg:aspect-[4/5]"><Foto src={band} alt="Autoband op een stalen velg op een donkere werkplaatsvloer, met een schroevendraaier ernaast" sizes="(min-width: 1024px) 420px, 100vw" /></div>
        </div>
      </div>
    </section>

    <!-- Diensten: foto links, tekst rechts. -->
    <section id="diensten" class="wrap scroll-mt-16 py-16 lg:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="order-2 lg:order-1 lg:col-span-5">
          <div class="aspect-[3/2] overflow-hidden rounded-xl"><Foto src={gereedschap} alt="Wand in een werkplaats vol gebruikte auto-onderdelen, met jerrycans motorolie eronder" sizes="(min-width: 1024px) 440px, 100vw" /></div>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-6 lg:col-start-7">
          <h2 class="text-3xl">Onderhoud en reparatie, diverse merken</h2>
          <p class="mt-5 text-lg">Als allround garage houden we uw auto in orde, van onderhoud tot reparatie. En heeft u plotseling een probleem met uw auto, dan staan we voor u klaar.</p>
          <p class="mt-5 text-sm text-ink-soft">[[AANLEVEREN: welke diensten precies, bijvoorbeeld APK, banden, airco, en of er occasions te koop zijn]]</p>
          <a href={site.telHref} class="btn btn-polder mt-8">Bel voor uw auto</a>
        </div>
      </div>
    </section>

    <!-- Openingstijden en route naast elkaar op een licht vlak. -->
    <section id="route" class="scroll-mt-16 bg-mist">
      <div class="wrap grid gap-10 py-16 md:grid-cols-12 lg:py-20">
        <div class="md:col-span-5">
          <h2 class="text-2xl">Openingstijden</h2>
          <p class="mt-4 text-sm text-ink-soft">[[AANLEVEREN: openingstijden per dag]]</p>
          <p class="mt-4">Twijfelt u of we open zijn? Bel even: <a href={site.telHref} class="whitespace-nowrap font-semibold tabular-nums text-polder underline underline-offset-2">{site.tel}</a>.</p>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          <h2 class="text-2xl">Route</h2>
          <address class="mt-4 not-italic text-lg">
            {site.naamVol}<br />
            {site.straat}<br />
            <span class="whitespace-nowrap">{site.postcode}</span> {site.plaats}<br />
            <span class="text-ink-soft">{site.regio}</span>
          </address>
          <a href={site.maps} class="mt-5 inline-block font-display font-bold text-polder underline decoration-2 underline-offset-4 hover:text-ink">Open in Google Maps</a>
        </div>
      </div>
    </section>

    <!-- Afspraakformulier: vier velden. In voorstelmodus geen verstuurknop. -->
    <section id="afspraak" class="wrap scroll-mt-16 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Afspraak aanvragen</h2>
          <p class="mt-4 text-ink-soft">Laat hier uw gegevens en uw vraag achter. Liever meteen iemand spreken? Bel <a href={site.telHref} class="whitespace-nowrap font-semibold tabular-nums text-polder underline underline-offset-2">{site.tel}</a>.</p>
        </div>
        <form class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line md:p-8 lg:col-span-7 lg:col-start-6" onsubmit="return false">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block font-semibold">Naam
              <input class="veld font-normal" type="text" name="naam" autocomplete="name" required />
            </label>
            <label class="block font-semibold">Telefoon
              <input class="veld font-normal" type="tel" name="telefoon" autocomplete="tel" required />
            </label>
            <label class="block font-semibold sm:col-span-2">Kenteken
              <input class="veld font-normal uppercase" type="text" name="kenteken" placeholder="bijv. AB-123-C" />
            </label>
            <label class="block font-semibold sm:col-span-2">Wat moet er gebeuren?
              <textarea class="veld font-normal" name="omschrijving" rows="4"></textarea>
            </label>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg bg-mist p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap font-semibold tabular-nums underline">{site.tel}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-polder mt-6">Verstuur aanvraag</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
