---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex min-w-0 flex-col leading-none no-underline">
        <span class="font-display text-xl font-bold tracking-[-0.03em] text-polder">Autocorner</span>
        <span class="mt-1 text-xs font-semibold text-ink-soft">Zuid-Beijerland</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={url('#werkwijze')} class="no-underline hover:text-polder">Zo werken we</a></li>
          <li><a href={url('#diensten')} class="no-underline hover:text-polder">Onderhoud en reparatie</a></li>
          <li><a href={url('#route')} class="no-underline hover:text-polder">Route</a></li>
          <li><a href={url('#afspraak')} class="no-underline hover:text-polder">Afspraak</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-polder shrink-0 !px-4 !py-2 !text-sm" aria-label={`Bel ${site.tel}`}>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-current"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        <span class="sm:hidden">Bel</span><span class="hidden sm:inline whitespace-nowrap tabular-nums">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="bg-polder-deep py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naamVol}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />Telefoon <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
