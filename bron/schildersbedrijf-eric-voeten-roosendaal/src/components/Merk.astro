---
// Woordmerk naar hun logobord: zwart vlak, "Schildersbedrijf", tien verfvlakken, "Eric Voeten".
import { url, site, vlakken } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class={`merk ${cls}`}>
  <small>Schildersbedrijf</small>{" "}
  <span class="merk-vlakken" aria-hidden="true">{vlakken.map((k) => <i style={`background:${k}`}></i>)}</span>
  <b>Eric Voeten</b>
</a>
