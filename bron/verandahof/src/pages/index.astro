---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Maten from '../components/Maten.astro';
import Dak from '../components/Dak.astro';
import { site, tijden, reviews, aanbod, waHoi } from '../data/site';

import hero from '../assets/hero.jpg';
import heroM from '../assets/hero-m.jpg';
import tuinzicht from '../assets/tuinzicht.jpg';
import schuifwand from '../assets/schuifwand-open.jpg';
import antraciet from '../assets/antraciet.jpg';
import glaswand from '../assets/glaswand.jpg';
import eettafel from '../assets/eettafel.jpg';

const hD = await getImage({ src: hero, widths: [1024, 1280, 1600], format: 'webp', quality: 72 });
const hM = await getImage({ src: heroM, widths: [480, 768, 1080], format: 'webp', quality: 64 });
const tz = await getImage({ src: tuinzicht, widths: [768, 1280, 2048], format: 'webp', quality: 64 });

const titel = "Verandahof | Veranda's op maat, glazen schuifwanden, carports en zijwanden";
const omschrijving = "Verandahof plaatst veranda's, glazen schuifwanden, carports en zijwanden. Volledig maatwerk, met persoonlijk advies. Vanuit Waalwijk.";
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. Opening: onder hun eigen opaal dak, uitkijkend op het gras -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-antraciet text-wit">
      <picture>
        <source media="(min-width: 768px)" srcset={hD.srcSet.attribute} sizes="100vw" type="image/webp" />
        <source srcset={hM.srcSet.attribute} sizes="100vw" type="image/webp" />
        <img src={hD.src} alt="Onder een veranda met opaal dak en antraciet liggers: glazen wanden rondom, een loungebank en het gras erachter" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_60%] md:object-[50%_55%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#23272aa6_0%,#23272a1a_26%,#23272a40_50%,#23272af2_100%)] md:bg-[linear-gradient(180deg,#23272acc_0%,#23272a59_14%,#23272a00_30%),linear-gradient(0deg,#23272af0_0%,#23272aa6_36%,#23272a00_72%)]"></div>
      <div class="wrap pb-28 pt-32 md:pb-16">
        <p class="rijs text-[.9375rem] font-medium tracking-[.02em] text-wit/85">Veranda's op maat, vanuit Waalwijk</p>
        <h1 class="rijs mt-4 max-w-[14ch] text-hero" style="--d:.08s">Extra ruimte,<br /> <em class="text-groen">het hele jaar</em> door.</h1>
        <div class="mt-8 grid gap-8 md:grid-cols-12 md:items-end">
          <p class="rijs max-w-[33rem] text-lg text-wit/90 md:col-span-6 md:text-xl" style="--d:.16s">Veranda's, glazen schuifwanden, carports en zijwanden. Volledig maatwerk, met persoonlijk advies.</p>
          <div class="rijs flex flex-wrap gap-3 md:col-span-6 md:justify-end" style="--d:.24s">
            <a href="#maten" class="knop">Maten doorgeven<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-lijn num hidden sm:inline-flex"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Aanbod: hun eigen zinnen per product, onder een rij liggers -->
    <section id="aanbod" class="bg-antraciet text-wit">
      <div class="liggers h-3 opacity-80" aria-hidden="true"></div>
      <div class="wrap grid gap-y-12 py-20 md:grid-cols-12 md:gap-x-10 md:py-32">
        <div class="md:col-span-4">
          <h2 class="rijs text-3xl">Specialist in <em class="text-groen">maatwerk</em>.</h2>
          <p class="rijs mt-6 max-w-xs text-mist" style="--d:.1s">Ook serres en tuinkamers, met zijwanden en schuifpuien op maat.</p>
        </div>
        <ul class="md:col-span-7 md:col-start-6">
          {aanbod.map((a, i) => (
            <li class="regel rijs" style={`--d:${i * 0.06}s`}>
              <span class="font-serif text-2xl">{a.naam}</span>
              <span class="text-mist">{a.zin}</span>
            </li>
          ))}
          <li class="border-t border-lijn-licht pt-8">
            <a href="#maten" class="link link-licht font-medium">Geef je maten door voor een offerte</a>
          </li>
        </ul>
      </div>
    </section>

    <!-- 3. Het uitzicht: hun eigen foto vanonder het dak naar de tuin, met één zin van een klant -->
    <section class="relative isolate overflow-hidden bg-antraciet text-wit" aria-label="Uitzicht vanonder een veranda">
      <img src={tz.src} srcset={tz.srcSet.attribute} sizes="100vw" alt="Vanonder een veranda met zijwand en opaal dak kijk je de tuin in, met kunstgras en een glazen schuifwand aan de zijkant" width="2048" height="640" loading="lazy" decoding="async" class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#23272ae6_0%,#23272a99_40%,#23272a00_75%)]"></div>
      <figure class="wrap flex min-h-[34rem] flex-col justify-center py-20 md:min-h-[40rem]">
        <blockquote class="rijs max-w-[16ch] font-serif text-[clamp(2rem,3.4vw+1rem,4.25rem)] leading-[1.04] tracking-[-0.02em]">“Ik kan heel het jaar door extra genieten.”</blockquote>
        <figcaption class="rijs mt-6 text-sm text-wit/80" style="--d:.1s">Fadma E., Google review</figcaption>
      </figure>
    </section>

    <!-- 4. Werk: eigen projectfoto's, groot en asymmetrisch -->
    <section id="werk" class="pt-20 md:pt-32">
      <div class="wrap">
        <Dak class="rijs" />
        <div class="mt-10 grid gap-y-6 md:grid-cols-12 md:gap-x-8">
          <h2 class="rijs text-3xl md:col-span-7">Zo staat het bij klanten.</h2>
          <p class="rijs max-w-sm text-grijs md:col-span-4 md:col-start-9 md:self-end" style="--d:.1s">Foto's van eigen projecten, van Verandahof op Instagram.</p>
        </div>
      </div>

      <div class="wrap mt-12 grid gap-5 md:mt-16 md:grid-cols-12">
        <figure class="rijs md:col-span-7">
          <Image quality={68} src={antraciet} alt="Antraciet veranda over de hele achtergevel van een rijtjeshuis, met een zijwand en een tegelterras" widths={[640, 960, 1080]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-square w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-sm text-grijs">Over de hele achtergevel, met zijwand</figcaption>
        </figure>
        <figure class="rijs md:col-span-5 md:mt-32" style="--d:.1s">
          <Image quality={68} src={schuifwand} alt="Glazen schuifwanden van een antraciet veranda, opengeschoven tegen de zijkant" widths={[480, 800, 1040]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[30%_50%]" />
          <figcaption class="mt-3 text-sm text-grijs">Glazen schuifwanden, opengeschoven</figcaption>
        </figure>
      </div>

      <div class="wrap mt-5 grid gap-5 md:mt-8 md:grid-cols-12">
        <figure class="rijs md:col-span-4">
          <Image quality={68} src={glaswand} alt="Antraciet veranda met grote glazen panelen aan de tuinkant, nat terras ervoor" widths={[480, 900]} sizes="(min-width: 768px) 32vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[40%_60%]" />
          <figcaption class="mt-3 text-sm text-grijs">Glas aan de tuinkant</figcaption>
        </figure>
        <figure class="rijs md:col-span-8" style="--d:.1s">
          <Image quality={66} src={eettafel} alt="Eettafel onder een veranda, met een antraciet zijwand naast de schutting en een schuifpui erachter" widths={[640, 1280, 2048]} sizes="(min-width: 768px) 64vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-[16/10]" />
          <figcaption class="mt-3 text-sm text-grijs">Zijwand langs de schutting</figcaption>
        </figure>
      </div>
      <p class="wrap mt-10"><a href={site.instagram} class="link inline-flex items-center gap-2 font-medium"><Icoon naam="insta" class="h-5 w-5" />Meer op Instagram</a></p>
    </section>

    <!-- 5. Wow: maten doorgeven, het bovenaanzicht tekent mee, eindigt in WhatsApp -->
    <section id="maten" class="py-20 md:py-32">
      <div class="wrap">
        <div class="grid gap-y-6 md:grid-cols-12 md:gap-x-8">
          <h2 class="rijs text-3xl md:col-span-6">Geef je maten door.</h2>
          <p class="rijs max-w-sm text-grijs md:col-span-5 md:col-start-8 md:self-end" style="--d:.1s">Een schatting is genoeg om mee te beginnen.</p>
        </div>
        <div class="mt-12 md:mt-16"><Maten /></div>
      </div>
    </section>

    <!-- 6. Reviews: één grote, drie kleine -->
    <section id="reviews" class="bg-opaal-2 py-20 md:py-32">
      <div class="wrap grid gap-y-14 md:grid-cols-12 md:gap-x-10">
        <figure class="rijs md:col-span-7">
          <blockquote class="font-serif text-[clamp(1.7rem,2.3vw+.9rem,3rem)] leading-[1.12] tracking-[-0.015em]">“{reviews.groot.tekst}”</blockquote>
          <figcaption class="mt-6 text-sm font-medium text-grijs">{reviews.groot.naam}, Google review</figcaption>
        </figure>
        <div class="space-y-9 md:col-span-4 md:col-start-9 md:pt-3">
          {reviews.klein.map((r, i) => (
            <figure class="rijs border-t border-lijn pt-6" style={`--d:${0.1 + i * 0.08}s`}>
              <blockquote class="text-lg leading-snug">“{r.tekst}”</blockquote>
              <figcaption class="mt-3 text-sm font-medium text-grijs">{r.naam}, Google review</figcaption>
            </figure>
          ))}
          <p class="flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews</p>
        </div>
      </div>
    </section>

    <!-- 7. Contact: bellen of appen, met de tijden van Google -->
    <section id="contact" class="py-20 md:py-32">
      <div class="wrap grid gap-y-12 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-6">
          <h2 class="rijs text-3xl">Bel of app <em class="text-groen-diep">gerust</em>.</h2>
          <p class="rijs mt-6 max-w-md text-grijs" style="--d:.08s">Verandahof zit in Waalwijk.</p>
          <div class="rijs mt-10 flex flex-wrap gap-3" style="--d:.14s">
            <a href={waHoi} class="knop"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-donker num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
        <div class="md:col-span-5 md:col-start-8 md:pt-3">
          <p class="flex items-center gap-2 text-sm font-semibold" data-nu><span class="h-2 w-2 rounded-full bg-grijs" data-stip></span><span data-nu-tekst>Openingstijden</span></p>
          <table class="num mt-4 w-full text-[.9375rem]">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {[1, 2, 3, 4, 5, 6, 0].map((d) => (
                <tr class="border-t border-lijn" data-dag={d}>
                  <th scope="row" class="py-2.5 text-left font-normal">{tijden[d][0]}</th>
                  <td class="py-2.5 text-right">{tijden[d][1] ?? 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { tijden } from '../data/site';
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const d = nu.getDay();
  document.querySelector(`[data-dag="${d}"]`)?.classList.add('font-semibold', 'text-groen-diep');
  const t = tijden[d][1];
  const m = nu.getHours() * 60 + nu.getMinutes();
  const minuten = (s: string) => { const [h, mm] = s.split(':').map(Number); return h * 60 + mm; };
  const open = !!t && m >= minuten(t.split('-')[0]) && m < minuten(t.split('-')[1]);
  const tekst = document.querySelector('[data-nu-tekst]');
  const stip = document.querySelector('[data-stip]');
  if (tekst) tekst.textContent = open ? `Nu bereikbaar, tot ${t!.split('-')[1]}` : 'Nu gesloten';
  if (stip && open) stip.classList.replace('bg-grijs', 'bg-groen');
</script>
