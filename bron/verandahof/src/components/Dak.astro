---
<svg viewBox="0 0 1000 34" preserveAspectRatio="none" class:list={['dak', cls]} aria-hidden="true">
  <path pathLength="1" d="M0 33H120L170 4L214 30" stroke="#48c41a" />
  <path pathLength="1" d="M196 20L224 4L282 33H1000" stroke={licht ? '#ffffff66' : '#191c1e66'} />
