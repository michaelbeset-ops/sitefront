---
import { site, url, waHoi, aanbod } from '../data/site';
import Merk from './Merk.astro';
import Dak from './Dak.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-antraciet text-mist">
  <div class="wrap pt-16 md:pt-20"><Dak licht /></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-14 text-[.9375rem] md:grid-cols-12 md:py-16">
    <div class="text-wit md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-mist">Veranda's, glazen schuifwanden, carports en zijwanden. Volledig maatwerk, vanuit {site.plaats}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Aanbod</p>
      <ul class="mt-3 space-y-1">{aanbod.map((a) => <li><a href={url('#aanbod')} class="link link-licht no-underline hover:underline">{a.naam}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a> · <a href={site.instagram} class="link link-licht">Instagram</a></p>
      <p class="mt-4">{site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Bereikbaar</p>
      <p class="num mt-3">Ma t/m vr<br />08:30-19:00</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Verandahof, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen Instagram. Teksten over het aanbod van de oude verandahof.nl. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
