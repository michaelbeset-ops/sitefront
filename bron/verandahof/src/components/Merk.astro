---
// Woordmerk naar hun logo: twee dakpunten (groen en grijs) boven VERANDAHOF, met HOF in groen.
import { url } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['flex flex-col items-start text-current no-underline', cls]} aria-label="Verandahof, naar de homepage">
  <svg viewBox="0 0 60 18" class="ml-[18%] h-[15px] w-auto" aria-hidden="true">
    <path d="M2 17 19 2l15 13" fill="none" stroke="#48c41a" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" />
    <path d="M24 9l7-7 26 15" fill="none" stroke="currentColor" stroke-opacity=".7" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" />
  </svg>
  <span class="mt-[3px] block text-[1.3rem] font-medium leading-none tracking-[.06em]">VERANDA<span class="font-semibold text-groen">HOF</span></span>
</a>
