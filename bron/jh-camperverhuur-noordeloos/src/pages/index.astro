  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: 999px; background: var(--color-zand); }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  .veld { display: block; width: 100%; border-radius: .75rem; border: 1.5px solid #16142b33; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #16142b66; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-indigo); }
  .stap { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; background: var(--color-indigo); color: #fff; cursor: pointer; transition: background-color .2s; }
  .stap:hover { background: var(--color-indigo-diep); }
  summary::-webkit-details-marker { display: none; }
  :global(.plus) { transition: transform .3s var(--ease-zacht); }
  details[open] > summary :global(.plus) { transform: rotate(45deg); }
</style>
