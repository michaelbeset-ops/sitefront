---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, diensten, reviews, genoemd, foto } from '../data/site';

const heroSrcset = [640, 1024, 1600].map((w) => `${foto.hero(w)} ${w}w`).join(', ');
---
<Base
  title="Stukadoorsbedrijf L. van Kempen | Stukadoor in Bergen op Zoom"
  description="Raapwerk, pleisterwerk, sierpleisters, beton ciré en buitenwerk door Stukadoorsbedrijf L. van Kempen uit Bergen op Zoom. Gemiddeld een 9,8 uit 167 reviews."
  heroFoto={foto.hero(1600)}
  heroSrcset={heroSrcset}
>
  <Kop />
  <main id="inhoud">
    <!-- Hero: schermvullende foto, tekst linksonder, het reviewcijfer als tegenwicht rechts. -->
    <section class="op-donker relative isolate flex min-h-[100svh] items-end overflow-hidden bg-beton text-gips">
      <img
        src={foto.hero(1600)}
        srcset={heroSrcset}
        sizes="100vw"
        alt="Lichte kamer met een houten ladder, een witte kruk en een plant"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        fetchpriority="high"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(29_28_26/0.92)_0%,rgb(29_28_26/0.6)_45%,rgb(29_28_26/0.25)_100%)]"></div>
      <div class="wrap grid gap-10 pb-14 pt-32 md:pb-20 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="label text-oker">Stukadoor in {site.plaats}, sinds 2002</p>
          <h1 class="mt-5 text-5xl">Strakke wanden. En daarna een schone vloer.</h1>
          <p class="mt-6 max-w-xl text-lg text-gips/90">Luciën van Kempen en zijn team doen raapwerk, pleisterwerk, sierpleisters en beton ciré. Binnen en buiten.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.mobielHref} class="knop knop-oker">Bel {site.mobiel}</a>
            <a href={site.whatsapp} class="knop knop-lijn">Stuur een WhatsApp</a>
          </div>
        </div>
        <a href="#reviews" class="group block border-t-2 border-oker pt-4 lg:col-span-3 lg:col-start-10">
          <span class="block font-kop text-[clamp(4rem,3rem+3vw,6rem)] font-extrabold leading-none [font-stretch:72%]">9,8</span>
          <span class="mt-2 block text-sm text-gips/85 group-hover:underline">gemiddeld uit 167 reviews op Klantenvertellen</span>
        </a>
      </div>
    </section>

    <!-- Diensten: links de kop die blijft staan, rechts de lijst als een staalboek. -->
    <section id="diensten" class="scroll-mt-4 py-20 lg:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-10">
            <span class="veeg" aria-hidden="true"></span>
            <h2 class="mt-6 text-4xl">Van ruwe muur tot sierpleister</h2>
            <p class="mt-6 max-w-md text-grijs">Alles wat met stucwerk te maken heeft, binnen en buiten. Laat weten wat u wilt laten doen, dan hoort u snel wat er kan.</p>
            <img
              src={foto.pleister(900)}
              alt="Wit gepleisterd oppervlak van dichtbij"
              width="900" height="700" loading="lazy" decoding="async"
              class="mt-10 hidden aspect-[9/7] w-full max-w-md object-cover lg:block"
            />
          </div>
        </div>
        <ol class="border-t border-inkt lg:col-span-7">
          {diensten.map((d, i) => (
            <li class="rij grid grid-cols-[3rem_1fr] gap-x-4 border-b border-lijn py-6 sm:grid-cols-[4.5rem_1fr] sm:py-8">
              <span class="pt-2 text-sm font-semibold tabular-nums text-grijs">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-3xl">{d.naam}</h3>
                {d.soorten && (
                  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Soorten sierpleister">
                    {d.soorten.map((s) => <li class="border border-inkt/40 px-3 py-1 text-sm">{s}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Reviews: het cijfer is het sterkste verkoopargument, dus groot en eerst. -->
    <section id="reviews" class="op-donker scroll-mt-4 bg-beton py-20 text-gips lg:py-32">
      <div class="wrap">
        <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-5">
            <p class="label text-oker">Klantenvertellen</p>
            <p class="mt-4 font-kop font-extrabold leading-[0.8] tracking-[-0.03em] text-oker [font-stretch:65%] text-[clamp(7rem,5rem+12vw,15rem)]">9,8</p>
            <p class="mt-6 max-w-sm text-gips/85">Gemiddeld uit 167 reviews. Achttien daarvan kwamen in het afgelopen jaar binnen.</p>
          </div>
          <div class="lg:col-span-6 lg:col-start-7">
            <h2 class="text-4xl">Wat klanten steeds weer noemen</h2>
            <ul class="mt-8 grid gap-4">
              {genoemd.map((g) => (
                <li class="flex items-start gap-4 text-lg"><span class="veeg mt-3 w-6 shrink-0" aria-hidden="true"></span>{g}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-20 grid gap-x-12 gap-y-12 md:grid-cols-2">
          {reviews.map((r) => (
            <figure class="border-t border-gips/25 pt-6">
              <blockquote class="font-kop text-2xl font-bold leading-tight tracking-[-0.01em] [font-stretch:80%] sm:text-3xl">“{r.tekst}”</blockquote>
              <figcaption class="mt-4 text-sm text-gips/75">{r.naam}, {r.plaats}, {r.datum}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-14"><a href={site.reviews} class="knop knop-lijn text-gips">Alle reviews op Klantenvertellen</a></p>
      </div>
    </section>

    <!-- Het bedrijf: foto links smal en hoog, tekst rechts, feiten als korte regels. -->
    <section id="bedrijf" class="scroll-mt-4 py-20 lg:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center">
        <img
          src={foto.beton(1000)}
          alt="Lichtgrijze wand met een zachte, gevlekte structuur"
          width="1000" height="1200" loading="lazy" decoding="async"
          class="aspect-[5/4] w-full object-cover lg:col-span-5 lg:aspect-[5/6]"
        />
        <div class="lg:col-span-6 lg:col-start-7">
          <span class="veeg" aria-hidden="true"></span>
          <h2 class="mt-6 text-4xl">Een klein team uit Bergen op Zoom</h2>
          <div class="mt-6 grid max-w-xl gap-4 text-grijs">
            <p>Stukadoorsbedrijf L. van Kempen bestaat sinds 1 juni 2002. Eigenaar en directeur is Luciën van Kempen.</p>
            <p>In de reviews noemen klanten ook Stefan, William en leerling Gino. Van Kempen is een erkend leerbedrijf en het team is VCA-gecertificeerd.</p>
          </div>
          <dl class="mt-10 grid border-t border-inkt sm:grid-cols-3">
            <div class="flex items-baseline justify-between gap-4 border-b border-lijn py-4 sm:block sm:border-b-0 sm:border-r sm:py-5 sm:pr-3">
              <dt class="text-xs font-semibold text-grijs">Opgericht</dt>
              <dd class="mt-1 font-kop text-2xl font-extrabold [font-stretch:72%]">2002</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-lijn py-4 sm:block sm:border-b-0 sm:border-r sm:px-3 sm:py-5">
              <dt class="text-xs font-semibold text-grijs">Veiligheid</dt>
              <dd class="mt-1 font-kop text-2xl font-extrabold [font-stretch:72%]">VCA</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-4 sm:block sm:py-5 sm:pl-3">
              <dt class="text-xs font-semibold text-grijs">Opleiden</dt>
              <dd class="mt-1 font-kop text-2xl font-extrabold [font-stretch:72%]">Leerbedrijf</dd>
            </div>
          </dl>
          <p class="mt-10 text-grijs">Nieuwe projecten zet het team op Facebook.</p>
          <p class="mt-4"><a href={site.facebook} class="knop knop-lijn">Bekijk de projecten op Facebook</a></p>
        </div>
      </div>
    </section>

    <!-- Contact: gegevens en werkgebied links, formulier rechts. -->
    <section id="contact" class="scroll-mt-4 border-t border-lijn bg-gips py-20 lg:py-32">
      <div class="wrap grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="veeg" aria-hidden="true"></span>
          <h2 class="mt-6 text-4xl">Muren die strak moeten?</h2>
          <p class="mt-6 max-w-md text-grijs">Bel of app voor een afspraak. Mailen kan ook.</p>
          <dl class="mt-10 grid gap-6">
            <div>
              <dt class="label text-grijs">Mobiel en WhatsApp</dt>
              <dd class="mt-1 text-xl font-semibold"><a href={site.mobielHref} class="underline-offset-4 hover:underline">{site.mobiel}</a></dd>
            </div>
            <div>
              <dt class="label text-grijs">Vast</dt>
              <dd class="mt-1 text-xl font-semibold"><a href={site.vastHref} class="underline-offset-4 hover:underline">{site.vast}</a></dd>
            </div>
            <div>
              <dt class="label text-grijs">E-mail</dt>
              <dd class="mt-1 break-all text-lg font-semibold"><a href={`mailto:${site.mail}`} class="underline-offset-4 hover:underline">{site.mail}</a></dd>
            </div>
            <div>
              <dt class="label text-grijs">Adres</dt>
              <dd class="mt-1 text-lg">{site.straat}, {site.postcode} {site.plaats}<br /><a href={site.route} class="text-sm font-semibold underline underline-offset-4">Route in Google Maps</a></dd>
            </div>
          </dl>
          <div class="mt-12 border-t border-inkt pt-6">
            <h3 class="text-2xl">Werkgebied</h3>
            <p class="mt-3 max-w-md text-grijs">Recente klanten wonen in Bergen op Zoom, Ossendrecht, Woensdrecht en Roosendaal.</p>
          </div>
        </div>

        <form class="grid content-start gap-5 lg:col-span-6 lg:col-start-7" onsubmit="return false" aria-describedby="formulier-noot">
          <h3 class="text-2xl">Vertel wat er moet gebeuren</h3>
          <label class="grid gap-2 text-sm font-semibold">Naam
            <input type="text" name="naam" autocomplete="name" class="min-h-12 border border-inkt/50 bg-kalk px-3 text-base font-normal" />
          </label>
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-2 text-sm font-semibold">Telefoon
              <input type="tel" name="telefoon" autocomplete="tel" class="min-h-12 border border-inkt/50 bg-kalk px-3 text-base font-normal" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">E-mail
              <input type="email" name="email" autocomplete="email" class="min-h-12 border border-inkt/50 bg-kalk px-3 text-base font-normal" />
            </label>
          </div>
          <label class="grid gap-2 text-sm font-semibold">Wat wilt u laten doen?
            <textarea name="bericht" rows="5" class="border border-inkt/50 bg-kalk px-3 py-2 text-base font-normal"></textarea>
          </label>
          {site.voorstel ? (
            <p id="formulier-noot" class="border-l-4 border-oker bg-kalk px-4 py-3 text-sm text-grijs">Dit is een ontwerpvoorstel, het formulier verstuurt nog niets. Bel of app <a href={site.mobielHref} class="whitespace-nowrap font-semibold text-inkt underline">{site.mobiel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all font-semibold text-inkt underline">{site.mail}</a>.</p>
          ) : (
            <p id="formulier-noot" class="text-sm text-grijs">U krijgt zo snel mogelijk antwoord.</p>
          )}
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>
