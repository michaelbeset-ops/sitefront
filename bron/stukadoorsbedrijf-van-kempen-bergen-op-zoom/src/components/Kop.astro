---
import { site, url } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
// Op de homepage ligt de kop over de foto heen; op andere pagina's staat hij op kalk.
const h = (anker: string) => (thuis ? `#${anker}` : url(`#${anker}`));
---
<header class:list={[thuis ? 'op-donker absolute inset-x-0 z-30 text-gips' : 'border-b border-lijn text-inkt']}>
  <div class="wrap flex items-center justify-between gap-6 py-5">
    <a href={url()} class="group flex items-baseline gap-2 leading-none" aria-label={`${site.naam}, naar de homepage`}>
      <span class="font-kop text-2xl font-extrabold tracking-[-0.02em] [font-stretch:72%]">Van Kempen</span>
      <span class="hidden text-xs font-semibold uppercase tracking-[0.12em] opacity-80 sm:inline">Stukadoorsbedrijf</span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden items-center gap-7 text-sm font-semibold md:flex">
      <a href={h('diensten')} class="underline-offset-[6px] hover:underline">Diensten</a>
      <a href={h('reviews')} class="underline-offset-[6px] hover:underline">Reviews</a>
      <a href={h('bedrijf')} class="underline-offset-[6px] hover:underline">Het bedrijf</a>
      <a href={h('contact')} class="underline-offset-[6px] hover:underline">Contact</a>
      <a href={site.mobielHref} class:list={['knop min-h-11 px-4', thuis ? 'knop-oker' : 'knop-inkt']}>{site.mobiel}</a>
    </nav>
    <a href={h('contact')} class="text-sm font-semibold underline underline-offset-4 md:hidden">Contact</a>
  </div>
</header>
