---
import { site, url } from '../data/site';
---
<footer class="op-donker bg-inkt text-gips">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="label text-oker">Stukadoorsbedrijf</p>
      <p class="mt-1 font-kop text-4xl font-extrabold tracking-[-0.02em] [font-stretch:72%]">L. van Kempen</p>
      <p class="mt-4 max-w-sm text-sm text-gips/80">Raapwerk, pleisterwerk, sierpleisters, beton ciré en buitenwerk vanuit {site.plaats}. Sinds 2002.</p>
    </div>
    <div class="text-sm md:col-span-4">
      <p class="font-semibold">Contact</p>
      <p class="mt-3 text-gips/80">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.mobielHref} class="underline-offset-4 hover:underline">{site.mobiel}</a><br /><a href={site.vastHref} class="underline-offset-4 hover:underline">{site.vast}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline-offset-4 hover:underline">{site.mail}</a></p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="font-semibold">Gegevens</p>
      <p class="mt-3 text-gips/80">KvK {site.kvk}<br />VCA-gecertificeerd<br />Erkend leerbedrijf</p>
      <p class="mt-3"><a href={site.facebook} class="underline underline-offset-4">Facebook</a><br /><a href={url('privacy/')} class="underline underline-offset-4">Privacyverklaring</a></p>
    </div>
  </div>
  <div class="wrap border-t border-gips/15 py-5 text-xs text-gips/70">
    <p>De foto's op deze site zijn sfeerbeelden van Unsplash.</p>
  </div>
</footer>
