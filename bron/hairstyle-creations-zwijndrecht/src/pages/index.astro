---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, tijden, diensten, reviews, foto, srcset } from '../data/site';

const heroSet = srcset(foto.hero, [800, 1200, 1600, 2000]);
---
<Base
  title="Hairstyle Creations | Kapsalon en waxstudio in Zwijndrecht"
  description="Kapsalon en waxstudio van Aïscha aan de Jacob Marisstraat in Zwijndrecht. Knippen en stylen voor alle haartypes, gespecialiseerd in krullend haar. 5,0 uit 224 reviews op Treatwell."
  heroFoto={foto.hero(1600)}
  heroSrcset={heroSet}
>
  <Kop />
  <main id="inhoud">
    <!-- Hero: de foto vult het scherm, de tekst staat links onderin. De verloop houdt de tekst leesbaar op elke uitsnede. -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-petrol text-kalk">
      <img
        src={foto.hero(1600)}
        srcset={heroSet}
        sizes="100vw"
        alt="Close-up van krullend haar"
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-[65%_30%]"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(14_37_36/0.94)_0%,rgb(14_37_36/0.7)_40%,rgb(14_37_36/0.2)_75%,rgb(14_37_36/0.5)_100%)] lg:bg-[linear-gradient(to_right,rgb(14_37_36/0.92)_0%,rgb(14_37_36/0.7)_42%,rgb(14_37_36/0.05)_75%)]"></div>
      <div class="wrap pb-14 pt-36 sm:pb-20 lg:pb-24">
        <p class="label text-koper-licht">Kapsalon en waxstudio in Zwijndrecht</p>
        <h1 class="mt-6 max-w-[12ch] text-4xl text-kalk">Krullen in goede handen.</h1>
        <p class="mt-7 max-w-[32rem] text-lg leading-relaxed text-kalk/90">De salon van Aïscha aan de Jacob Marisstraat. Knippen en stylen voor alle haartypes, met krullend haar als specialiteit. Ook voor kleur, haarbehandelingen en waxen.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.boeken} class="knop-vol">Afspraak maken</a>
          <a href={site.mobielHref} class="knop-licht">Bel {site.mobiel}</a>
        </div>
        <a href="#reviews" class="mt-12 inline-flex items-center gap-4 border-t border-kalk/30 pt-5 text-sm text-kalk/90 hover:text-kalk">
          <span class="font-kop text-3xl font-bold tracking-[-0.04em] text-koper-licht">5,0</span>
          <span>uit 224 reviews<br />op Treatwell</span>
        </a>
      </div>
    </section>

    <!-- Blikvanger: de krullenspecialiteit. Foto groot links, tekst rechts, bewust niet in het midden. -->
    <section id="krullen" class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:items-center lg:gap-10 lg:py-32">
      <div class="rijs relative lg:col-span-6">
        <img
          src={foto.krullen(1000)}
          srcset={srcset(foto.krullen, [600, 900, 1200])}
          sizes="(min-width: 1024px) 45vw, 100vw"
          alt="Sfeerbeeld van zwart krullend haar"
          loading="lazy"
          width="900" height="1100"
          class="aspect-[4/3] w-full rounded-sm bg-mist object-cover sm:aspect-[4/5] lg:aspect-[5/6]"
        />
        <svg class="absolute -bottom-6 -right-3 w-36 text-koper sm:w-44" viewBox="0 0 48 12" aria-hidden="true"><path d="M1 9c3-9 10-9 9-2-1 5-6 4-5 0 2-7 11-8 12-1 1 5-5 5-5 1 1-6 11-8 13-1 1 5-5 5-4 1 2-6 11-8 13-1 1 4-3 5-4 2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </div>
      <div class="rijs lg:col-span-5 lg:col-start-8">
        <p class="label text-koper-donker">De specialiteit</p>
        <h2 class="mt-6 text-3xl">Sterkere krullen, met meer veerkracht en definitie.</h2>
        <div class="mt-8 grid gap-5 text-grijs">
          <p>Aïscha is gespecialiseerd in het knippen en stylen van krullend haar. Knippen en stylen doet ze voor alle haartypes.</p>
          <p>Voor krullen die wat extra nodig hebben is er de <strong class="font-semibold text-diep">Magic Curl Treatment</strong>, de eigen intensieve krullenbehandeling van de salon. Is je haar beschadigd, dan helpt <strong class="font-semibold text-diep">hair botox</strong>.</p>
        </div>
        <a href={site.boeken} class="knop-donker mt-10">Plan een krullenafspraak</a>
      </div>
    </section>

    <!-- Behandelingen als genummerde rijen in plaats van kaartjes. Alleen prijzen die echt bekend zijn. -->
    <section id="behandelingen" class="bg-wit py-20 lg:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-10">
            <p class="label text-koper-donker">Behandelingen</p>
            <h2 class="mt-6 text-3xl">Van knippen tot waxen.</h2>
            <p class="mt-6 text-grijs">Kleur en verzorging met Tahe en Finnleys. Waxen met Lycon wax, die minder pijnlijk is. Vrije tijden zie je meteen in de online agenda.</p>
            <a href={site.boeken} class="link mt-6 inline-block text-sm font-semibold">Naar de online agenda</a>
            <img
              src={foto.kleur(700)}
              srcset={srcset(foto.kleur, [500, 700, 1000])}
              sizes="(min-width: 1024px) 28vw, 100vw"
              alt="Sfeerbeeld van haar in zwart en bruin"
              loading="lazy"
              width="700" height="500"
              class="mt-10 hidden aspect-[7/5] w-full rounded-sm bg-mist object-cover lg:block"
            />
          </div>
        </div>
        <ol class="border-t border-diep lg:col-span-7 lg:col-start-6">
          {diensten.map((d, i) => (
            <li class="rijs grid gap-4 border-b border-lijn py-8 sm:grid-cols-[4.5rem_1fr]">
              <span class="font-kop text-sm font-semibold text-koper-donker">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-2xl">{d.titel}</h3>
                <ul class="mt-4 grid gap-2 text-grijs">
                  {d.regels.map((r) => (
                    <li class="flex items-baseline justify-between gap-6">
                      <span>{r.naam}</span>
                      {r.prijs && <span class="whitespace-nowrap font-semibold text-diep">{r.prijs}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Reviews: het grote cijfer als anker, de citaten verspringend zodat het geen rijtje kaartjes wordt. -->
    <section id="reviews" class="bg-petrol py-20 text-kalk lg:py-32">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-4">
          <p class="label text-koper-licht">Reviews op Treatwell</p>
          <p class="mt-8 font-kop text-reus font-bold leading-none tracking-[-0.06em] text-koper">5,0</p>
          <p class="mt-4 text-lg text-kalk/90">uit 224 reviews</p>
          <p class="mt-8 max-w-xs text-kalk/80">Klanten noemen vaak hoe vriendelijk en gezellig het is, dat Aïscha meedenkt en dat het knipwerk goed is.</p>
        </div>
        <ul class="grid gap-10 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-14 lg:col-span-7 lg:col-start-6">
          {reviews.map((r, i) => (
            <li class:list={['rijs border-t border-kalk/25 pt-6', i % 2 === 1 && 'sm:mt-16']}>
              <blockquote>
                <p class="font-kop text-lg font-medium leading-snug tracking-[-0.02em]">“{r.tekst}”</p>
                <footer class="mt-5 text-sm text-koper-licht">{r.naam}, via Treatwell</footer>
              </blockquote>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Over Aïscha. Haar eigen woorden van de site, de rest in gewone zinnen uit de bronnen. -->
    <section id="aischa" class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:gap-10 lg:py-32">
      <div class="rijs lg:col-span-6 lg:order-2 lg:col-start-7">
        <img
          src={foto.fohn(1000)}
          srcset={srcset(foto.fohn, [600, 900, 1200])}
          sizes="(min-width: 1024px) 45vw, 100vw"
          alt="Sfeerbeeld van een kapper die haar föhnt met een ronde borstel"
          loading="lazy"
          width="1000" height="750"
          class="aspect-[4/3] w-full rounded-sm bg-mist object-cover"
        />
      </div>
      <div class="rijs lg:col-span-5 lg:order-1">
        <p class="label text-koper-donker">Over Aïscha</p>
        <h2 class="mt-6 text-3xl">“Ik sta voor je klaar!”</h2>
        <div class="mt-8 grid gap-5 text-grijs">
          <p>Een eigen salon was altijd de droom van Aïscha. Op 15 september 2023 ging Hairstyle Creations open aan de Jacob Marisstraat, vlak bij station Zwijndrecht.</p>
          <p>Professioneel en huiselijk, zo voelt de salon. Je bent welkom met elk haartype, voor een knipbeurt, een nieuwe kleur, een behandeling of om te waxen.</p>
        </div>
      </div>
    </section>

    <!-- Contact: tijden en adres naast een formulier dat in het voorstel niets verstuurt. -->
    <section id="contact" class="border-t border-lijn bg-wit py-20 lg:py-32">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="label text-koper-donker">Langskomen</p>
          <h2 class="mt-6 text-3xl">Vlak bij station Zwijndrecht.</h2>
          <p class="mt-6 text-grijs">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <a href={site.route} class="link mt-4 inline-block text-sm font-semibold">Route in Google Maps</a>

          <h3 class="mt-12 text-xl">Openingstijden</h3>
          <dl class="mt-4 border-t border-diep">
            {tijden.map((t) => (
              <div class="flex justify-between gap-6 border-b border-lijn py-3">
                <dt>{t.dag}</dt>
                <dd class:list={[t.tijd === 'gesloten' ? 'text-grijs' : 'font-semibold']}>{t.tijd}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-10 grid gap-1">
            <a class="link w-fit font-semibold" href={site.mobielHref}>{site.mobiel}</a>
            <a class="link w-fit" href={`mailto:${site.mail}`}>{site.mail}</a>
          </div>
        </div>

        <div class="min-w-0 lg:col-span-6 lg:col-start-7">
          <div class="bg-kalk p-6 sm:p-10">
            <h3 class="text-2xl">Liever eerst een vraag stellen?</h3>
            <p class="mt-3 text-grijs">Een afspraak maak je het snelst in de <a class="link text-diep" href={site.boeken}>online agenda</a>. Voor een vraag over je haar of een behandeling kun je dit formulier gebruiken.</p>
            <form class="mt-8 grid gap-5" action="#" onsubmit="return false">
              <div class="grid gap-2">
                <label for="naam" class="text-sm font-semibold">Naam</label>
                <input id="naam" name="naam" autocomplete="name" class="min-h-12 w-full min-w-0 rounded-sm border border-lijn bg-wit px-4" />
              </div>
              <div class="grid gap-2">
                <label for="tel" class="text-sm font-semibold">Telefoon of e-mail</label>
                <input id="tel" name="contact" autocomplete="tel" class="min-h-12 w-full min-w-0 rounded-sm border border-lijn bg-wit px-4" />
              </div>
              <div class="grid gap-2">
                <label for="vraag" class="text-sm font-semibold">Je vraag</label>
                <textarea id="vraag" name="vraag" rows="4" class="w-full min-w-0 rounded-sm border border-lijn bg-wit px-4 py-3"></textarea>
              </div>
              {site.voorstel ? (
                <p class="border-l-4 border-koper bg-wit px-4 py-3 text-sm text-grijs">Dit is een ontwerpvoorstel, het formulier verstuurt niets. Bel <a class="link text-diep" href={site.mobielHref}>{site.mobiel}</a> of mail <a class="link text-diep" href={`mailto:${site.mail}`}>{site.mail}</a>.</p>
              ) : (
                <button type="submit" class="knop-donker w-fit">Versturen</button>
              )}
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>
