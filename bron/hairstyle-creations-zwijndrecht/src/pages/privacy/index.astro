---
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import { site } from '../../data/site';
---
<Base title="Privacyverklaring | Hairstyle Creations" description="Hoe Hairstyle Creations in Zwijndrecht omgaat met je persoonsgegevens.">
  <Kop thuis={false} />
  <main id="inhoud" class="wrap py-16 lg:py-24">
    <article class="max-w-2xl">
      <p class="label text-koper-donker">Privacy</p>
      <h1 class="mt-6 text-3xl">Privacyverklaring</h1>
      <div class="mt-10 grid gap-8 text-grijs [&_h2]:mb-2 [&_h2]:text-xl [&_h2]:text-diep">
        <section><h2>Wie zijn wij</h2><p>{site.naam}, {site.straat}, {site.postcode} {site.plaats}. KvK {site.kvk}. Telefoon {site.mobiel}, e-mail {site.mail}.</p></section>
        <section><h2>Welke gegevens</h2><p>Als je belt, mailt of het formulier invult, ontvangen we je naam, je telefoonnummer of e-mailadres en wat je ons vertelt.</p>
          {site.voorstel && <p class="mt-2">In dit ontwerpvoorstel verstuurt het formulier niets.</p>}</section>
        <section><h2>Afspraken</h2><p>Afspraken maak je in de online agenda van Salonized. Wat je daar invult, valt onder de voorwaarden van Salonized.</p></section>
        <section><h2>Waarvoor</h2><p>Alleen om je vraag te beantwoorden en je afspraak te regelen. We verkopen of delen je gegevens niet.</p></section>
        <section><h2>Hoe lang</h2><p>Vragen zonder vervolg bewaren we niet langer dan nodig. Gegevens voor de administratie bewaren we zolang de wet dat vraagt.</p></section>
        <section><h2>Cookies</h2><p>Deze website plaatst geen cookies en gebruikt geen analyse- of advertentiediensten. De foto's worden geladen van Unsplash. De links naar Google Maps en de online agenda openen die diensten pas als je erop klikt.</p></section>
        <section><h2>Je rechten</h2><p>Je mag je gegevens inzien, laten aanpassen of laten verwijderen. Neem daarvoor contact met ons op. Ben je het niet eens met hoe we met je gegevens omgaan, dan kun je een klacht indienen bij de Autoriteit Persoonsgegevens.</p></section>
      </div>
    </article>
  </main>
  <Voet />
</Base>
