---
import { site, url } from '../data/site';
---
<footer class="bg-diep text-kalk/80">
  <div class="wrap grid gap-10 py-14 text-sm md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <p class="font-kop text-2xl font-bold tracking-[-0.04em] text-kalk">Hairstyle Creations</p>
      <p class="mt-2 text-koper-licht">{site.soort} in {site.plaats}</p>
    </div>
    <div>
      <p>{site.straat}<br />{site.postcode} {site.plaats}<br />KvK {site.kvk}</p>
    </div>
    <div class="grid content-start gap-1">
      <a class="hover:text-kalk" href={site.mobielHref}>{site.mobiel}</a>
      <a class="hover:text-kalk" href={`mailto:${site.mail}`}>{site.mail}</a>
      <a class="hover:text-kalk" href={site.boeken}>Online afspraak maken</a>
    </div>
  </div>
  <div class="wrap flex flex-wrap justify-between gap-3 border-t border-kalk/15 py-6 text-xs">
    <p>&copy; 2026 {site.naam}</p>
    <a class="underline underline-offset-2 hover:text-kalk" href={url('privacy/')}>Privacyverklaring</a>
  </div>
</footer>
