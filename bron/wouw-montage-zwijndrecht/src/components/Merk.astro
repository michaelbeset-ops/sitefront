---
// Logo nagetekend: de W uit twee schuine blokken met de rode lijn die doorloopt, plus WOUW in Bungee.
import { url } from '../data/site';
interface Props { licht?: boolean; klein?: boolean }
const { licht = true, klein = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-end gap-2 no-underline ${licht ? 'text-wit' : 'text-inkt'}`}>
  <svg viewBox="0 128 684 424" class={klein ? 'h-8 w-auto' : 'h-9 w-auto md:h-10'} aria-hidden="true">
    <path d="M8 247 73 152 242 437 175 538Z M293 375 362 272 461 437 390 543Z" fill={licht ? '#e8392e' : '#14161c'} stroke="#e8392e" stroke-width="12" stroke-linejoin="miter" />
    <path d="M242 437 293 375 M461 437 678 136" fill="none" stroke="#e8392e" stroke-width="12" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-kop text-[1.35rem] tracking-[.02em] md:text-[1.5rem]">Wouw</span>
    <span class="mt-1 whitespace-nowrap text-[.625rem] font-bold uppercase tracking-[.22em] opacity-80 max-[359px]:hidden">Montage · Onderhoud</span>
  </span>
</a>
