---
import { site, url, waHoi, zonwering } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-bus text-mist">
  <div class="bies bies-licht" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-3">
      <Merk />
      <p class="mt-6 max-w-xs">Garagedeuren, industriële deuren en zonwering: leveren, monteren en onderhouden. Officiële dealer van Verano®.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Aanbod</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={url('#garagedeuren')} class="link">Garagedeuren en industriële deuren</a></li>
        {zonwering.slice(0, 6).map((z) => <li><a href={url(`#zw-${z.id}`)} class="link">{z.titel}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-1.5"><a href={site.instagram} class="link">Instagram</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Adres</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3">Maandag tot en met vrijdag<br />08.00 tot 18.00 uur</p>
      <p class="mt-3"><a href={site.maps} class="link">{site.google.score} op Google, {site.google.aantal} reviews</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.eigenaar} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-rood-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en projectfoto’s van wouwmontage.nl en wouwzonwering.nl, foto’s van jullie Google-profiel. Reviews letterlijk van Google en jullie referentiepagina (stand 7 oktober 2026).</p>}
</footer>
