---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, bus, zonwering, reviews, plaatsen, waHoi } from '../data/site';

import deurDonker from '../assets/deur-donker.jpg';
import knikarmPalm from '../assets/knikarm-palm.jpg';
import busGarages from '../assets/bus-garages.jpg';
import deurWit from '../assets/deur-wit.jpg';
import industriedeur from '../assets/industriedeur.jpg';
import screensHoek from '../assets/screens-hoek.jpg';
import rolluikenGevel from '../assets/rolluiken-gevel.jpg';
import verandaScreen from '../assets/veranda-screen.jpg';
import uitvalBlauw from '../assets/uitval-blauw.jpg';
import knikarmStreep from '../assets/knikarm-streep.jpg';
import uitvalRood from '../assets/uitval-rood.jpg';
import rolluikDak from '../assets/rolluik-dak.jpg';
import knikarmTuin from '../assets/knikarm-tuin.jpg';

// Wisselfoto bij de zonwering-index: alleen echte projectfoto's van hun fotoalbum, per productsoort.
const indexFoto = {
  knikarm: { src: knikarmTuin, alt: 'Zwart knikarmscherm boven een terras in een strakke tuin met hagen', bij: 'Knikarmscherm' },
  screens: { src: screensHoek, alt: 'Groot donker screen voor het bovenraam van een woning met rode gevel', bij: 'Screens' },
  rolluiken: { src: rolluikenGevel, alt: 'Antraciet rolluiken voor de bovenramen van een bakstenen woning', bij: 'Rolluiken' },
  veranda: { src: verandaScreen, alt: 'Houten overkapping met een screen aan de voorkant, binnen een zithoek', bij: 'Overkapping met screen' },
};

// Offerte in één zin: alleen producten die ze zelf noemen (aanbod wouwzonwering.nl, diensten wouwmontage.nl).
const producten = ['een garagedeur', 'een industriële deur', 'een knikarmscherm', 'een uitvalscherm', 'screens', 'rolluiken', 'een markies', 'een veranda of overkapping', 'binnenzonwering', 'een windscherm', 'een losse motor'];
const watLijst = ['een offerte', 'onderhoud', 'een reparatie'];
const plekken = ['mijn woning', 'ons bedrijfspand'];

const titel = 'Wouw Montage | Garagedeuren en zonwering in Zwijndrecht';
const omschrijving = 'Garagedeuren, industriële deuren en zonwering: leveren, monteren en onderhouden. Paul van de Wouw, Marsmanstraat 2 Zwijndrecht, officiële dealer van Verano®. Voor particulieren en bedrijven in de Drechtsteden en omstreken.';
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">
    <h1 class="sr-only">Wouw Montage in Zwijndrecht: garagedeuren, industriële deuren en zonwering</h1>

    <!-- 1. HERO: twee deuren, twee ingangen -->
    <section class="relative grid min-h-[calc(100svh-3.5rem)] grid-rows-2 bg-bus md:min-h-svh md:grid-cols-2 md:grid-rows-1" aria-label="Kies garagedeuren of zonwering">
      <Kop />
      <a href="#garagedeuren" class="deur">
        <Image src={deurDonker} alt="Nieuwe antraciet garagedeur in een lichte bakstenen garage, in de zon" quality={66} widths={[420, 720, 900]} sizes="(min-width: 768px) 50vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_62%]" />
        <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#121a2cb3_0%,#121a2c1a_34%,#121a2c26_55%,#121a2ce6_100%)]" aria-hidden="true"></span>
        <span class="wrap pb-8 pt-24 md:mx-0 md:max-w-none md:pb-28 md:pl-[calc(max(0px,(100vw-80rem)/2)+2.5rem)] md:pr-10">
          <span class="block font-kop text-hero uppercase leading-[.95]">Garage&shy;deuren</span>
          <span class="mt-3 block max-w-sm text-base text-wit/90 md:text-lg">Garagedeuren en industriële deuren. Leveren, monteren, onderhouden.</span>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold">Bekijk garagedeuren <Icoon naam="pijl" class="pijl h-4 w-4 text-rood-licht" /></span>
        </span>
      </a>
      <a href="#zonwering" class="deur">
        <Image src={knikarmPalm} alt="Antraciet knikarmscherm boven een terras met een palm, gemonteerd door Wouw Zonwering" quality={66} widths={[420, 720, 960]} sizes="(min-width: 768px) 50vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[40%_50%]" />
        <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#121a2c33_0%,#121a2c1a_40%,#121a2ce6_100%)] md:bg-[linear-gradient(180deg,#121a2cb3_0%,#121a2c1a_34%,#121a2c26_55%,#121a2ce6_100%)]" aria-hidden="true"></span>
        <span class="wrap pb-8 pt-10 md:mx-0 md:max-w-none md:pb-28 md:pl-14 md:pr-10">
          <span class="block font-kop text-hero uppercase leading-[.95]">Zonwering</span>
          <span class="mt-3 block max-w-sm text-base text-wit/90 md:text-lg">Zonneschermen, screens, rolluiken, markiezen en overkappingen.</span>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold">Bekijk zonwering <Icoon naam="pijl" class="pijl h-4 w-4 text-rood-licht" /></span>
        </span>
      </a>
      <span class="pointer-events-none absolute left-1/2 top-1/2 z-10 grid h-14 w-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-rood font-kop text-2xl text-wit md:h-20 md:w-20 md:text-4xl" aria-hidden="true">&amp;</span>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 hidden md:block">
        <div class="bies bies-licht opacity-95" aria-hidden="true"></div>
      </div>
      <div class="absolute inset-x-0 bottom-[14px] z-10 hidden md:block">
        <div class="wrap flex items-end justify-between gap-6 pb-6 text-sm text-wit/85">
          <p>Paul van de Wouw · {site.plaats} · voor particulieren en bedrijven</p>
          <p data-status-wrap class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-rood-licht" aria-hidden="true"></span><span data-status>Maandag tot en met vrijdag 08.00 tot 18.00 uur</span></p>
        </div>
      </div>
    </section>

    <!-- 2. DE BUS: wie is Wouw -->
    <section class="bg-bus pb-16 pt-14 text-wit md:pb-24 md:pt-20">
      <div class="wrap grid grid-cols-1 items-end gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <ul class="rijs font-kop text-[clamp(1.6rem,3.2vw+.6rem,3.1rem)] uppercase leading-[1.06] lg:col-span-5" aria-label="Wat er op de bus staat">
          {bus.map((w, i) => <li class={i === 0 ? 'text-rood-licht' : ''}>{w}</li>)}
        </ul>
        <figure class="rijs lg:col-span-7" style="--d:.1s">
          <Image src={busGarages} alt="Donkerblauwe Wouw-bus met het rode W-logo naast een rij van vijf antraciet garagedeuren" quality={74} widths={[400, 640, 960, 1440]} sizes="(min-width: 1280px) 720px, (min-width: 1024px) 56vw, calc(100vw - 2.5rem)" class="aspect-[16/10] w-full rounded-sm object-cover object-[30%_50%]" />
          <figcaption class="mt-3 text-xs text-mist">Foto van het Google-profiel Wouwgaragedeuren en Wouwzonwering</figcaption>
        </figure>
      </div>
      <div class="wrap mt-12 grid grid-cols-1 gap-y-8 border-t border-lijn pt-10 md:mt-16 lg:grid-cols-12 lg:gap-x-12">
        <h2 class="rijs text-4xl lg:col-span-5">Mooier kan het niet!</h2>
        <div class="rijs space-y-5 text-mist lg:col-span-6 lg:col-start-7" style="--d:.1s">
          <p class="text-xl text-wit">Wouw Montage richt zich helemaal op het leveren, onderhouden en monteren van garagedeuren, industriële deuren en zonwering.</p>
          <p>Wij zijn officiële dealer van Verano®. Dat zo'n mooi product met zorg gemonteerd moet worden, spreekt voor zich. Wij hebben de vakkennis en ervaring om al onze producten perfect te monteren.</p>
          <p class="font-semibold text-wit">{site.eigenaar}</p>
        </div>
      </div>
    </section>

    <!-- 3. GARAGEDEUREN -->
    <section id="garagedeuren" class="py-16 md:py-24">
      <div class="wrap grid grid-cols-1 gap-y-8 lg:grid-cols-12 lg:gap-x-12">
        <h2 class="rijs text-4xl lg:col-span-7">Garagedeuren <span class="text-rood-diep">&amp; industriële deuren</span></h2>
        <p class="rijs text-lg text-grijs lg:col-span-5 lg:pt-2" style="--d:.1s">Wouw Garagedeuren richt zich helemaal op het leveren, onderhouden en monteren van garagedeuren en industriële deuren. Officiële dealer van Verano®.</p>
      </div>
      <div class="wrap mt-12 grid grid-cols-1 gap-x-6 gap-y-10 md:mt-16 md:grid-cols-12">
        <figure class="rijs md:col-span-7">
          <Image src={deurWit} alt="Witte garagedeur met ingebouwde loopdeur tussen lichte bakstenen muren" quality={74} widths={[640, 960, 1280]} sizes="(min-width: 1280px) 700px, (min-width: 768px) 58vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-[30rem]" />
          <figcaption class="mt-3 text-xs text-grijs">Garagedeur met loopdeur</figcaption>
        </figure>
        <figure class="rijs md:col-span-5" style="--d:.1s">
          <Image src={industriedeur} alt="Grijze sectionaaldeur in de zwarte gevel van een bedrijfspand" quality={74} widths={[480, 720, 960]} sizes="(min-width: 1280px) 500px, (min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_40%] md:aspect-auto md:h-[30rem]" />
          <figcaption class="mt-3 text-xs text-grijs">Industriële deur bij een bedrijfspand</figcaption>
        </figure>
      </div>
      <div class="wrap mt-14 grid grid-cols-1 gap-y-8 md:mt-16 lg:grid-cols-12 lg:gap-x-12">
        <blockquote class="rijs lg:col-span-8">
          <p class="font-kop text-2xl uppercase leading-[1.12] md:text-[2.1rem]">“Alles keurig volgens gemaakte afspraken, en op tijd.”</p>
          <footer class="mt-4 max-w-2xl text-grijs">“{reviews.aart.tekst.replace(' Alles keurig volgens gemaakte afspraken, en op tijd.', '')}” <span class="mt-2 block text-sm font-semibold text-inkt">{reviews.aart.naam}, {reviews.aart.bron.toLowerCase()}</span></footer>
        </blockquote>
        <div class="rijs lg:col-span-4 lg:pt-2" style="--d:.1s">
          <a href="#offerte" data-product="een garagedeur" class="knop knop-bus">Offerte voor een garagedeur <Icoon naam="pijl" /></a>
        </div>
      </div>
    </section>

    <!-- 4. ZONWERING: hun aanbod als index met wisselfoto -->
    <section id="zonwering" class="bg-steen py-16 md:py-24">
      <div class="wrap grid grid-cols-1 gap-y-8 lg:grid-cols-12 lg:gap-x-12">
        <h2 class="rijs text-4xl lg:col-span-6">Zonwering</h2>
        <p class="rijs text-lg text-grijs lg:col-span-6" style="--d:.1s">Met meer dan tien verschillende typen zonwering vind je altijd een geschikte oplossing voor jouw wens. Onze zonwering wordt geproduceerd in Nederland.</p>
      </div>
      <div class="wrap mt-10 grid grid-cols-1 gap-y-10 md:mt-12 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs hidden lg:col-span-6 lg:block">
          <div class="sticky top-8">
            <div class="relative aspect-square overflow-hidden rounded-sm bg-bus">
              {Object.entries(indexFoto).map(([k, f], i) => (
                <Image src={f.src} alt={f.alt} quality={72} widths={[480, 640, 800]} sizes="(min-width: 1280px) 600px, 46vw" class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ${i ? 'opacity-0' : ''}`} data-foto={k} />
              ))}
            </div>
            <figcaption class="mt-3 text-xs text-grijs" data-foto-bij>Knikarmscherm, uit het fotoalbum van Wouw Zonwering</figcaption>
          </div>
        </figure>
        <ul class="lg:col-span-6" data-index>
          {zonwering.map((z, i) => (
            <li id={`zw-${z.id}`} class="rijs" style={`--d:${i * .04}s`}>
              <a href="#offerte" class="rij" data-rij={z.foto} data-product={z.product || undefined}>
                <span>
                  <span class="block font-kop text-xl uppercase md:text-2xl">{z.titel}</span>
                  <span class="mt-1 block text-sm text-grijs">{z.items}</span>
                </span>
                <Icoon naam="pijl" class="h-5 w-5 flex-none" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="wrap mt-14 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 sm:grid sm:grid-cols-3 sm:overflow-visible md:mt-20">
        {[[uitvalBlauw, 'Blauw uitvalscherm voor een raam in een bakstenen gevel', 'Uitvalscherm'], [knikarmStreep, 'Knikarmscherm met grijs-wit gestreept doek boven een voorraam', 'Knikarmscherm'], [uitvalRood, 'Rood uitvalscherm boven het raam van een rijtjeshuis', 'Uitvalscherm']].map(([src, alt, bij], i) => (
          <figure class="rijs w-[78%] flex-none snap-start sm:w-auto" style={`--d:${i * .08}s`}>
            <Image src={src as any} alt={alt as string} quality={70} widths={[400, 600, 800]} sizes="(min-width: 1280px) 400px, (min-width: 640px) 32vw, 78vw" class="aspect-[3/2] w-full rounded-sm object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">{bij}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 5. ONDERHOUD EN REPARATIE -->
    <section id="onderhoud" class="bg-bus py-20 text-wit md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 class="rijs text-4xl">Onderhoud en reparatie</h2>
          <p class="rijs mt-6 text-lg text-wit/90" style="--d:.1s">Onderdelen voor alle merken en soorten zonwering. Wij kunnen alle maten buismotors leveren en eventueel monteren voor u.</p>
          <figure class="rijs mt-10" style="--d:.15s">
            <Image src={rolluikDak} alt="Nieuw antraciet rolluik aan een oranje bakstenen gevel, een ladder op het platte dak ervoor" quality={72} widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
          </figure>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="rijs text-sm font-semibold text-mist">Een spoedgeval, uit de referentie van {reviews.jorrit.naam}</p>
          <ol class="mt-6 border-l-2 border-rood">
            {[['09:00', 'uur een berichtje gestuurd'], ['10:00', 'uur terug gebeld'], ['12:00', 'uur aanwezig om het rolluik wat de achterdeur blokkeerde te repareren.']].map(([t, w], i) => (
              <li class="rijs relative pb-8 pl-7 last:pb-0" style={`--d:${i * .1}s`}>
                <span class="absolute -left-[7px] top-3 h-3 w-3 rounded-full bg-rood" aria-hidden="true"></span>
                <span class="num block font-kop text-4xl text-rood-licht">{t}</span>
                <span class="mt-1 block text-lg">{w}</span>
              </li>
            ))}
          </ol>
          <p class="rijs mt-8 text-mist">“{reviews.jorrit.tekst}”</p>
          <div class="mt-10 grid gap-8 border-t border-lijn pt-8 sm:grid-cols-2">
            {[reviews.rita, reviews.cockMerken].map((r, i) => (
              <blockquote class="rijs" style={`--d:${i * .08}s`}>
                <p class="text-wit/90">“{r.tekst}”</p>
                <footer class="mt-3 text-sm text-mist"><span class="font-semibold text-wit">{r.naam}</span> · {r.bron}</footer>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. OFFERTE IN ÉÉN ZIN, eindigt in WhatsApp -->
    <section id="offerte" class="py-16 md:py-24" data-offerte>
      <div class="wrap">
        <div class="grid grid-cols-1 gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <h2 class="rijs text-4xl lg:col-span-6">Vrijblijvend een offerte</h2>
          <p class="rijs text-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-2" style="--d:.1s">Vul de rode woorden in. Uw bericht gaat via WhatsApp naar Paul.</p>
        </div>
        <form class="rijs mt-12 md:mt-16" style="--d:.15s" data-zin onsubmit="return false">
          <p class="text-[clamp(1.45rem,2.6vw+.7rem,2.75rem)] font-semibold leading-[1.45] tracking-[-.01em]">
            Hallo Paul, ik wil graag
            <label class="sr-only" for="o-wat">Offerte, onderhoud of reparatie</label><select id="o-wat" class="veld" data-v="wat">{watLijst.map((p) => <option>{p}</option>)}</select>
            <span data-voor>voor</span>
            <label class="sr-only" for="o-product">Product</label><select id="o-product" class="veld" data-v="product">{producten.map((p) => <option>{p}</option>)}</select>
            bij
            <label class="sr-only" for="o-plek">Waar</label><select id="o-plek" class="veld" data-v="plek">{plekken.map((p) => <option>{p}</option>)}</select>
            in
            <label class="sr-only" for="o-plaats">Plaats</label><input id="o-plaats" class="veld w-[6.5em]" data-v="plaats" placeholder="plaats" autocomplete="address-level2" />.
            Maat of aantal:
            <label class="sr-only" for="o-maat">Maat of aantal</label><input id="o-maat" class="veld w-[8em]" data-v="maat" placeholder="bv. 3 ramen" />
          </p>
        </form>
        <div class="rijs mt-12 grid grid-cols-1 gap-8 border-t border-lijn-licht pt-8 lg:grid-cols-12" style="--d:.2s">
          <div class="lg:col-span-7">
            <p class="text-sm font-semibold text-grijs">Uw bericht</p>
            <p class="mt-3 rounded-sm bg-steen p-5" data-bericht aria-live="polite">Hallo Paul, ik wil graag een offerte voor een garagedeur bij mijn woning. Kunt u een vrijblijvende offerte maken?</p>
            <a href={waHoi} class="knop knop-rood mt-5" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <p class="mt-4 text-sm text-grijs">Stuur er gerust een foto van de plek bij. Of bel <a href={site.telHref} class="link link-diep num whitespace-nowrap font-semibold text-inkt">{site.tel}</a>.</p>
          </div>
          <blockquote class="lg:col-span-4 lg:col-start-9">
            <p class="font-kop text-xl uppercase leading-snug">“{reviews.whatsapp.tekst}”</p>
            <footer class="mt-3 text-sm text-grijs">{reviews.whatsapp.naam}, {reviews.whatsapp.bron}</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- 7. REVIEWS -->
    <section class="bg-steen py-16 md:py-24">
      <div class="wrap">
        <div class="rijs flex flex-wrap items-end justify-between gap-6">
          <h2 class="max-w-3xl text-4xl">“Een vakman met topservice!”</h2>
          <a href={site.maps} class="inline-flex items-center gap-2.5 text-sm font-semibold no-underline hover:text-rood-diep"><Icoon naam="g" class="h-5 w-5" />Alle reviews op Google</a>
        </div>
        <p class="rijs mt-6 max-w-3xl text-lg text-grijs" style="--d:.05s">“{reviews.cock.tekst}” <span class="text-sm font-semibold text-inkt">{reviews.cock.naam}</span></p>
        <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {[reviews.angela, reviews.charlotte, reviews.niels].map((r, i) => (
            <blockquote class="rijs border-t-2 border-inkt pt-6" style={`--d:${i * .08}s`}>
              <p class="text-lg">“{r.tekst}”</p>
              <footer class="mt-5 text-sm text-grijs"><span class="font-semibold text-inkt">{r.naam}</span> · {r.bron}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. CONTACT EN WERKGEBIED -->
    <section id="contact" class="bg-bus pb-16 pt-0 text-wit md:pb-24">
      <div class="bies" aria-hidden="true"></div>
      <div class="wrap grid grid-cols-1 gap-y-14 pt-16 md:pt-24 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <h2 class="rijs text-4xl">Drechtsteden en omstreken</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-wit/90" style="--d:.1s">Wij werken voor particulieren en bedrijven in Zeeland, Noord-Brabant, Utrecht en Zuid-Holland, maar vooral in de Drechtsteden en omstreken.</p>
          <ul class="rijs mt-8 flex flex-wrap gap-x-5 gap-y-2 font-kop text-lg uppercase text-mist md:text-xl" style="--d:.15s" aria-label="Werkgebied">
            {plaatsen.map((p, i) => <li class={i === 0 ? 'text-rood-licht' : ''}>{p}</li>)}
          </ul>
          <div class="rijs mt-10 flex flex-wrap gap-3" style="--d:.2s">
            <a href={waHoi} class="knop knop-rood"><Icoon naam="wa" />WhatsApp Paul</a>
            <a href={site.telHref} class="knop knop-wit"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
          </div>
          <p class="rijs mt-6 text-sm text-mist" style="--d:.25s">Of mail naar <a href={`mailto:${site.mail}`} class="link text-wit">{site.mail}</a>.</p>
        </div>
        <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.1s">
          <div class="rounded-md bg-bus-2 p-6">
            <p class="flex items-start gap-3 font-semibold" data-status-wrap><span class="mt-2 h-2.5 w-2.5 flex-none rounded-full bg-rood-licht" aria-hidden="true"></span><span data-status>Maandag tot en met vrijdag 08.00 tot 18.00 uur</span></p>
            <dl class="mt-5 space-y-1 border-t border-lijn pt-4 text-sm">
              {[['1', 'Maandag'], ['2', 'Dinsdag'], ['3', 'Woensdag'], ['4', 'Donderdag'], ['5', 'Vrijdag'], ['6', 'Zaterdag'], ['0', 'Zondag']].map(([d, n]) => (
                <div class="flex justify-between gap-4 rounded-sm px-2 py-1.5 data-[vandaag=true]:bg-bus-3 data-[vandaag=true]:font-semibold data-[vandaag=true]:text-wit" data-dag={d}><dt>{n}</dt><dd class="num text-mist">{Number(d) >= 1 && Number(d) <= 5 ? '08.00 tot 18.00' : 'gesloten'}</dd></div>
              ))}
            </dl>
            <div class="mt-5 border-t border-lijn pt-5 text-sm text-mist">
              <p class="text-wit">{site.naam}</p>
              <p>{site.straat}, {site.postcode} {site.plaats}</p>
              <p class="mt-3"><a href={site.maps} class="link text-wit">Route in Google Maps</a></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script define:vars={{ wa: site.wa, indexFoto: Object.fromEntries(Object.entries(indexFoto).map(([k, f]) => [k, f.bij])) }}>
    // Zonwering-index: wisselfoto bij hover/focus (alleen rijen met een eigen projectfoto).
    const rijen = document.querySelectorAll('[data-rij]');
    const fotos = document.querySelectorAll('[data-foto]');
    const bij = document.querySelector('[data-foto-bij]');
    const toon = (k) => {
      if (!k) return;
      fotos.forEach((f) => f.classList.toggle('opacity-0', f.dataset.foto !== k));
      rijen.forEach((r) => r.setAttribute('data-actief', String(r.dataset.rij === k)));
      if (bij) bij.textContent = `${indexFoto[k]}, uit het fotoalbum van Wouw Zonwering`;
    };
    rijen.forEach((r) => { r.addEventListener('mouseenter', () => toon(r.dataset.rij)); r.addEventListener('focus', () => toon(r.dataset.rij)); });

    // Offerte in één zin.
    const vorm = document.querySelector('[data-zin]');
    const bericht = document.querySelector('[data-bericht]');
    const stuur = document.querySelector('[data-stuur]');
    const v = (n) => vorm.querySelector(`[data-v="${n}"]`);
    const maak = () => {
      const plaats = v('plaats').value.trim(); const maat = v('maat').value.trim();
      const product = v('product').value; const wat = v('wat').value;
      const voor = wat === 'een offerte' ? 'voor' : 'aan';
      document.querySelector('[data-voor]').textContent = voor;
      let t = `Hallo Paul, ik wil graag ${wat} ${voor} ${product} bij ${v('plek').value}${plaats ? ` in ${plaats}` : ''}.`;
      if (maat) t += ` Maat of aantal: ${maat}.`;
      t += wat === 'een offerte' ? ' Kunt u een vrijblijvende offerte maken?' : ' Wanneer kunt u langskomen?';
      bericht.textContent = t;
      stuur.href = `${wa}?text=${encodeURIComponent(t)}`;
    };
    vorm.querySelectorAll('select, input').forEach((el) => { el.addEventListener('input', maak); el.addEventListener('change', maak); });
    // Links met een product (bv. "Offerte voor een garagedeur") zetten de zin alvast goed.
    document.querySelectorAll('[data-product]').forEach((a) => a.addEventListener('click', () => { v('product').value = a.dataset.product; maak(); }));
    // Selects zo breed als het gekozen woord.
    const meet = document.createElement('canvas').getContext('2d');
    const pas = (sel) => { const cs = getComputedStyle(sel); meet.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`; sel.style.width = `${Math.ceil(meet.measureText(sel.value).width + parseFloat(cs.fontSize) * 1.05)}px`; };
    vorm.querySelectorAll('select').forEach((sel) => { pas(sel); sel.addEventListener('change', () => pas(sel)); });
    document.fonts?.ready.then(() => vorm.querySelectorAll('select').forEach(pas));
    document.querySelectorAll('[data-product]').forEach((a) => a.addEventListener('click', () => pas(v('product'))));
    maak();
  </script>
</Base>
