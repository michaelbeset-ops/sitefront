---
import { site, url, waHoi, tijden } from '../data/site';
const jaar = new Date().getFullYear();
---
<footer class="bg-blauw-nacht text-blauw-licht">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <a href={url('')} class="bord"><b>CC ROLLUIKEN</b><small>In en verkoop</small></a>
      <p class="mt-6 max-w-xs">Nieuwe en gebruikte rolluiken op maat gemaakt, aan de Sluisweg in Waalwijk.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <ul class="mt-3 space-y-1">
        {tijden.filter((t) => t.open).map((t) => <li class="flex justify-between gap-4"><span>{t.naam.slice(0, 2)}</span><span class="num whitespace-nowrap">{t.open} - {t.dicht}</span></li>)}
      </ul>
      <p class="mt-3 text-xs">Buiten deze tijden op afspraak.</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Ook op</p>
      <p class="mt-3"><a href={site.marktplaats} class="link link-licht">Marktplaats</a></p>
      <p class="mt-1"><a href={site.facebook} class="link link-licht">Facebook</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto’s uit jullie eigen Google-bedrijfsprofiel en Marktplaats-advertenties. Teksten uit jullie oude website (webarchief), Facebook en Marktplaats. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
