---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, tarieven, gebied, euro, waInschrijven, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import wagens from '../assets/wagens.jpg';
import motor from '../assets/motor.jpg';
import aanhanger from '../assets/aanhanger.jpg';
import team from '../assets/team.jpg';

const pakketten = [
  { id: 'auto', icoon: 'auto', soort: 'Auto', naam: 'WK instappakket', prijs: 315, wat: '5 lessen van 60 minuten + gratis proefles' },
  { id: 'motor', icoon: 'motor', soort: 'Motor', naam: 'WK opstappakket', prijs: 1495, wat: '20 lessen + AVB- en AVD-examen' },
  { id: 'aanhanger', icoon: 'kar', soort: 'Aanhanger', naam: 'WK aanhangpakket', prijs: 883.5, wat: '8 lessen + praktijkexamen' },
];

const opleidingen = [
  {
    id: 'auto', icoon: 'auto', titel: 'Autorijles', code: 'Rijbewijs B', src: wagens, pos: '62% 60%',
    alt: 'De twee zwarte lesauto’s van WK Rijopleidingen met de belettering “Auto, motor, aanhanger” op een parkeerplaats',
    tekst: 'Bij ons alleen privéles: er rijdt niemand mee op de achterbank. Je lest in het tempo dat bij je past, en als je wilt meerdere keren per week.',
    punten: ['Een les duurt 60 minuten, geen 50 of 45', 'Vaste instructeur en vaste lesauto', 'Geen extra kosten op zaterdag of ’s avonds', 'Met 2todrive al beginnen vanaf 16,5 jaar'],
    prijs: 'Instappakket € 315,-, daarna € 66,- per uur',
    wa: 'Hoi Wim, ik wil me graag inschrijven voor autorijles.',
  },
  {
    id: 'motor', icoon: 'motor', titel: 'Motorrijles', code: 'Rijbewijs A1 en A', src: motor, pos: '50% 55%',
    alt: 'Wim Kanters in motorjas met helm op een van de drie lesmotoren, naast een Honda en een tweede Yamaha',
    tekst: 'Je lest op een Honda CBF 125 voor A1 of op een van de twee Yamaha MT‑07’s voor A. Licht en wendbaar, en dat lest prettig bij de bijzondere verrichtingen.',
    punten: ['Twee lessen van 45 minuten achter elkaar', 'Motorjas, helm en handschoenen kun je lenen', 'AVB- en AVD-examen inclusief motorhuur', 'Opstappakket te betalen in 4 termijnen'],
    prijs: 'Opstappakket € 1.495,- inclusief AVB en AVD',
    wa: 'Hoi Wim, ik wil me graag inschrijven voor motorrijles.',
  },
  {
    id: 'aanhanger', icoon: 'kar', titel: 'Aanhanger', code: 'Rijbewijs BE', src: aanhanger, pos: '50% 60%',
    alt: 'Wim Kanters bij de zilveren lesbus met de grote huifaanhanger',
    tekst: 'Een BE-rijbewijs heb je nodig als auto en aanhanger samen meer dan 3.500 kg wegen, gerekend met ledig gewicht plus laadvermogen.',
    punten: ['In 2 dagdelen, ook als dagopleiding', 'Examen inclusief huur van de lescombinatie', 'Geen verborgen bijkomende kosten', 'Intakeles van 2 uur bij de dagopleiding'],
    prijs: 'Aanhangpakket € 883,50 inclusief examen',
    wa: 'Hoi Wim, ik wil me graag inschrijven voor aanhangerrijles (BE).',
  },
];

const extra = [
  { icoon: 'opfris', t: 'Opfriscursus', d: 'Lang niet gereden, of moeite met rotondes of de snelweg? Meestal zijn 3 à 4 lessen genoeg. De laatste les mag in je eigen auto.', p: '€ 66,- per uur' },
  { icoon: 'hart', t: 'Faalangst', d: 'Wij zijn een gecertificeerde faalangst-rijschool. Het faalangst-examen duurt 80 minuten en begint met een rustig gesprek met de examinator.', p: 'Examen € 385,-' },
  { icoon: 'kalender', t: 'Lessen vanaf 16,5', d: 'Met 2todrive begin je op je 16,5e met rijles en doe je op je 17e examen. Tot je 18e rijd je met een coach naast je.', p: 'Rijbewijs B' },
  { icoon: 'boek', t: 'Theorie', d: 'Begin er op tijd mee: dan verlopen je rijlessen beter. Studieboeken en oefenexamens haal je via ons of in de webshop.', p: 'Naar de webshop', href: site.webshop },
];

const stappen = [
  ['Schrijf je in', 'Stuur Wim een appje of bel. Bij het instappakket hoort een gratis proefles van 60 minuten.'],
  ['Machtig de rijschool', `Op mijn.cbr.nl met je DigiD, met rijschoolcode ${site.cbrCode}. Daar vul je ook je gezondheidsverklaring in.`],
  ['Begin met je theorie', 'Zo snel mogelijk. Wie de borden en regels kent, haalt meer uit elke les.'],
  ['Lessen in jouw tempo', 'Met een vaste instructeur en een vaste lesauto of lesmotor. Overdag, ’s avonds of op zaterdag.'],
  ['Examen', 'Wij vragen je tussentijdse toets en praktijkexamen aan bij het CBR. Annemarie verzorgt de planning.'],
];

const soorten = ['auto', 'motor', 'aanhanger'] as const;
---
<Base title={`${site.naam} | Rijschool in Hendrik-Ido-Ambacht voor auto, motor en aanhanger`} description="Rijschool in Hendrik-Ido-Ambacht. Privéles van 60 minuten voor auto, motor en aanhanger bij Wim en Annemarie Kanters. Ook opfriscursus en faalangst. 5,0 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: de hele vloot met Wim en Annemarie -->
    <section class="donker relative isolate flex flex-col overflow-hidden bg-nacht text-licht md:min-h-[calc(100svh-7rem)]" aria-labelledby="t-hero">
      <svg class="pointer-events-none absolute right-0 top-0 z-0 hidden h-[26rem] w-[34rem] lg:block" viewBox="0 0 544 416" fill="none" aria-hidden="true">
        <path d="M560 -20 C 420 60, 330 150, 300 416" stroke="#15214a" stroke-width="74" />
        <path d="M560 -20 C 420 60, 330 150, 300 416" stroke="#2bb0e8" stroke-width="5" stroke-dasharray="34 22" opacity=".85" />
      </svg>
      <div class="wrap relative z-10 pt-2 md:pt-14 lg:pt-16">
        <p class="eyebrow"><span class="sm:hidden">Rijschool H.I. Ambacht</span><span class="hidden sm:inline">Rijschool in Hendrik-Ido-Ambacht</span></p>
        <h1 id="t-hero" class="mt-6 max-w-[17ch] text-hero lg:max-w-none">Een uur rijles is bij ons <span class="text-streep">écht een uur.</span></h1>
        <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-6">
            <p class="max-w-xl text-lg text-licht/90 md:text-[1.25rem] md:leading-relaxed">Auto, motor en aanhanger. Privéles bij Wim en Annemarie Kanters, ook ’s avonds en op zaterdag.</p>
            <ul class="mt-6 flex flex-wrap gap-x-7 gap-y-2 text-[.9375rem] text-licht/90">
              <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
              <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 22.00 uur</span></li>
            </ul>
          </div>
          <div class="flex flex-wrap gap-3 pb-10 md:pb-0 lg:col-span-6 lg:justify-end">
            <a href={waInschrijven} class="knop knop-streep"><Icoon naam="wa" />Inschrijven via WhatsApp</a>
            <a href="#tarieven" class="knop knop-rand op-foto">Bekijk de tarieven</a>
          </div>
        </div>
      </div>
      <div class="relative order-first aspect-[16/10] md:order-none md:-mt-6 md:aspect-auto md:min-h-[24rem] md:flex-1">
        <Image src={hero} alt="Annemarie en Wim Kanters bij hun lesauto’s, drie lesmotoren, de lesbus en de aanhanger" widths={[480, 768, 1080, 1440, 1600]} sizes="100vw" quality={68} loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[50%_72%]" />
        <div class="absolute inset-x-0 bottom-0 h-1/3 bg-[linear-gradient(0deg,#0b1530_0%,#0b153000_100%)] md:bottom-auto md:top-0 md:bg-[linear-gradient(180deg,#0b1530_0%,#0b153000_100%)]" aria-hidden="true"></div>
      </div>
    </section>

    <!-- 2. Pakketten, half over de foto -->
    <section class="relative z-10" aria-label="De drie WK-pakketten">
      <ul class="wrap grid grid-cols-[minmax(0,1fr)] gap-3 py-6 md:-mt-14 md:grid-cols-3 md:gap-5 md:py-0">
        {pakketten.map((p) => (
          <li>
            <a href={`#${p.id}`} class="kaart group flex h-full items-center gap-4 p-4 no-underline shadow-md transition-transform duration-300 hover:-translate-y-0.5 sm:p-5">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-nacht text-streep transition-colors group-hover:bg-navy"><Icoon naam={p.icoon} class="h-6 w-6" /></span>
              <span class="min-w-0 flex-1">
                <span class="flex items-baseline justify-between gap-3"><b class="font-kop text-lg font-bold">{p.soort}</b><b class="num whitespace-nowrap font-kop text-lg font-extrabold text-navy">{euro(p.prijs)}</b></span>
                <span class="block text-sm text-grijs">{p.naam}: {p.wat}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 3. Opleidingen -->
    <section id="opleidingen" class="pb-20 pt-16 lg:pb-28 lg:pt-24" aria-labelledby="t-opl">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Opleidingen</p>
            <h2 id="t-opl" class="mt-4 text-3xl">Eén rijschool voor auto, motor en aanhanger.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Bij ons staat de leerling centraal. Daarom geven we alleen privéles, volgens de laatste methoden.</p>
        </div>
        <div class="mt-14 grid gap-16 lg:mt-16 lg:gap-20">
          {opleidingen.map((o, i) => (
            <article id={o.id} class="grid scroll-mt-28 items-center gap-8 lg:grid-cols-12 lg:gap-14" aria-labelledby={`t-${o.id}`}>
              <div class={`rijs relative lg:col-span-7 ${i % 2 ? 'lg:order-2' : ''}`}>
                <Image src={o.src} alt={o.alt} widths={[480, 800, 1100, 1400]} quality={72} sizes="(min-width: 1248px) 680px, (min-width: 1024px) 56vw, 92vw" class="aspect-[4/3] w-full rounded-lg object-cover shadow-md sm:aspect-[16/10]" style={`object-position:${o.pos}`} />
                <p class={`absolute -bottom-5 flex items-center gap-2 rounded-full bg-nacht px-4 py-2.5 text-sm font-semibold text-licht shadow-md ${i % 2 ? 'right-5' : 'left-5'}`}><Icoon naam={o.icoon} class="h-5 w-5 text-streep" />{o.code}</p>
              </div>
              <div class={`rijs lg:col-span-5 ${i % 2 ? 'lg:order-1' : ''}`} style="--d:.06s">
                <p class="num font-kop text-sm font-extrabold tracking-[.12em] text-navy">0{i + 1} / 03</p>
                <h3 id={`t-${o.id}`} class="mt-3 text-[clamp(1.75rem,1.4vw+1.3rem,2.5rem)] font-extrabold tracking-[-0.03em]">{o.titel}</h3>
                <p class="mt-4 text-lg text-grijs">{o.tekst}</p>
                <ul class="mt-6 grid gap-2.5">
                  {o.punten.map((pt) => <li class="flex gap-3"><span class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-mist text-navy"><Icoon naam="vink" class="h-3.5 w-3.5" /></span>{pt}</li>)}
                </ul>
                <p class="num mt-7 border-l-4 border-streep pl-4 font-semibold">{o.prijs}</p>
                <div class="mt-7 flex flex-wrap gap-3">
                  <a href={waMet(o.wa)} class="knop knop-navy knop-klein"><Icoon naam="wa" />Inschrijven</a>
                  <a href="#tarieven" data-naar={o.id} class="knop knop-rand knop-klein">Alle tarieven<Icoon naam="pijl" /></a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Ook voor -->
    <section id="extra" class="border-y border-lijn bg-wit py-20 lg:py-24" aria-labelledby="t-extra">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <h2 id="t-extra" class="text-3xl">Lange tijd niet gereden? Angstig in het verkeer?</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Autorijden moet voor iedereen plezierig zijn en blijven. Daarom ook dit:</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-5">
          {extra.map((e, i) => (
            <li class="rijs flex flex-col rounded-md bg-papier p-6 outline outline-1 -outline-offset-1 outline-lijn lg:p-7" style={`--d:${i * 0.06}s`}>
              <span class="grid h-12 w-12 place-items-center rounded-full bg-nacht text-streep"><Icoon naam={e.icoon} class="h-6 w-6" /></span>
              <h3 class="mt-6 text-xl">{e.t}</h3>
              <p class="mt-2 flex-1 text-[.9688rem] text-grijs">{e.d}</p>
              {e.href
                ? <a href={e.href} class="link mt-5 self-start font-semibold">{e.p}</a>
                : <p class="num mt-5 font-semibold text-navy">{e.p}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Cijfers -->
    <section class="donker bg-nacht text-licht" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-14 lg:grid-cols-4 lg:py-16">
        <div class="flex flex-col"><dt class="text-sm text-licht-zacht">op Google, uit {site.google.aantal} reviews</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.04em] text-streep">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="text-sm text-licht-zacht">minuten duurt een autorijles</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.04em]">60</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="text-sm text-licht-zacht">aanbevolen op Facebook</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.04em]">{site.fb.procent}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="text-sm text-licht-zacht">dagen per week les, doordeweeks tot 22.00 uur</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.04em]">6</dd></div>
      </dl>
    </section>

    <!-- 6. Tarieven + rekenhulp -->
    <section id="tarieven" class="py-20 lg:py-24" aria-labelledby="t-tar">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Tarieven</p>
            <h2 id="t-tar" class="mt-4 text-3xl">Geen dure pakketten. Wel duidelijke prijzen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Ter vergelijking: € 66,- voor 60 minuten is € 49,50 voor 45 minuten. Individuele afspraken over betalen zijn mogelijk.</p>
        </div>

        <div class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-8 lg:mt-14 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-7">
            <div class="flex gap-1.5 rounded-full bg-mist p-1.5" role="tablist" aria-label="Kies een opleiding">
              {soorten.map((s, i) => (
                <button type="button" role="tab" id={`tab-${s}`} aria-controls={`paneel-${s}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={s} class="tab min-w-0 flex-1 rounded-full px-2 py-2.5 text-[.8125rem] font-semibold sm:px-3 sm:text-base">{tarieven[s].titel}</button>
              ))}
            </div>
            {soorten.map((s, i) => (
              <div id={`paneel-${s}`} role="tabpanel" aria-labelledby={`tab-${s}`} data-paneel={s} class:list={['kaart mt-5 p-2 sm:p-4', { hidden: i !== 0 }]}>
                <table class="w-full text-left">
                  <caption class="sr-only">Tarieven {tarieven[s].titel}</caption>
                  <tbody>
                    {tarieven[s].rijen.map((r) => (
                      <tr class:list={['border-b border-lijn last:border-0', { 'bg-mist/60': 'uit' in r && r.uit }]}>
                        <th scope="row" class="py-3.5 pl-2 pr-1 font-normal [overflow-wrap:anywhere] sm:px-4">
                          <span class="block font-semibold">{r.t}</span>
                          {r.s && <span class="block text-sm text-grijs">{r.s}</span>}
                        </th>
                        <td class="num whitespace-nowrap py-3.5 pl-2 pr-2 text-right align-top font-semibold sm:px-4">{euro(r.p)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="px-3 pb-2 pt-4 text-sm text-grijs sm:px-4">{tarieven[s].noot}</p>
              </div>
            ))}
          </div>

          <!-- Rekenhulp -->
          <form class="donker relative overflow-hidden rounded-lg bg-nacht p-6 text-licht shadow-md sm:p-8 lg:col-span-5 lg:self-start" data-reken aria-labelledby="t-reken">
            <div class="strepen absolute left-8 top-0 w-28 opacity-90" aria-hidden="true"></div>
            <h3 id="t-reken" class="text-2xl">Wat kost mijn rijbewijs?</h3>
            <p class="mt-2 text-[.9375rem] text-licht-zacht">Een indicatie met onze tarieven. Hoeveel lessen je nodig hebt, verschilt per persoon.</p>

            <fieldset class="mt-7">
              <legend class="text-sm font-semibold">Opleiding</legend>
              <div class="mt-3 grid grid-cols-3 gap-2">
                {soorten.map((s, i) => (
                  <label class="keuze"><input type="radio" name="soort" value={s} checked={i === 0} class="sr-only" /><span>{s === 'aanhanger' ? 'Aanhanger' : s === 'auto' ? 'Auto' : 'Motor'}</span></label>
                ))}
              </div>
            </fieldset>

            <label class="mt-7 block">
              <span class="flex items-baseline justify-between text-sm font-semibold"><span data-lessen-label>Aantal lessen van 60 minuten</span><output class="num font-kop text-2xl font-extrabold text-streep" data-lessen-uit>20</output></span>
              <input type="range" name="lessen" min="6" max="50" value="20" class="schuif mt-3 w-full" data-lessen />
            </label>

            <div class="mt-6 grid gap-3 text-[.9375rem]" data-opties="auto">
              <label class="vinkje"><input type="checkbox" name="eerder" /><span>Ik heb al eerder les gehad bij een andere rijschool</span></label>
              <label class="vinkje"><input type="checkbox" name="tt" /><span>Met tussentijdse toets (€ 315,-)</span></label>
              <label class="vinkje"><input type="checkbox" name="fa" /><span>Faalangst-examen in plaats van gewoon examen</span></label>
            </div>
            <div class="mt-6 grid hidden gap-3 text-[.9375rem]" data-opties="aanhanger">
              <label class="vinkje"><input type="checkbox" name="dag" /><span>Als dagopleiding, met intakeles van 2 uur (€ 85,-)</span></label>
            </div>

            <div class="mt-8 border-t border-lijn-licht pt-6" aria-live="polite">
              <ul class="grid gap-1.5 text-[.9375rem] text-licht-zacht" data-regels></ul>
              <p class="mt-5 flex items-end justify-between gap-4">
                <span class="text-sm">Totaal, indicatie</span>
                <b class="num font-kop text-[2.5rem] font-extrabold leading-none tracking-[-0.04em] text-licht" data-totaal>€ 1.239,-</b>
              </p>
              <p class="mt-3 text-xs text-licht-zacht">Plus gezondheidsverklaring (€ 46,90), die betaal je zelf aan het CBR. Tarieven onder voorbehoud.</p>
            </div>
            <button type="submit" class="knop knop-streep mt-7 w-full"><Icoon naam="wa" />Stuur dit naar Wim</button>
          </form>
        </div>
      </div>
    </section>

    <!-- 7. Werkwijze -->
    <section id="werkwijze" class="border-t border-lijn bg-wit py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo werkt het</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van eerste appje tot je rijbewijs.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Schrijf je in en start direct. De rest regelen we samen met je.</p>
        </div>
        <ol class="relative mt-14 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5 lg:gap-6">
          <li class="strepen absolute left-0 right-0 top-6 hidden lg:block" aria-hidden="true"></li>
          {stappen.map(([t, d], i) => (
            <li class="rijs relative" style={`--d:${i * 0.06}s`}>
              <span class="num relative grid h-12 w-12 place-items-center rounded-full bg-nacht font-kop text-lg font-extrabold text-streep ring-8 ring-wit">0{i + 1}</span>
              <h3 class="mt-5 text-xl">{t}</h3>
              <p class="mt-2 text-[.9688rem] text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8. Over ons -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[30rem] lg:col-span-6">
