<script>
  import { tarieven } from '../data/site';
  const WA = 'https://wa.me/31641573435?text=';
  const eur = (n: number) => '€ ' + n.toLocaleString('nl-NL', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 }) + (n % 1 ? '' : ',-');

  // Tabs tarieven
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const kies = (s: string, focus = false) => {
    tabs.forEach((t) => { const aan = t.dataset.tab === s; t.setAttribute('aria-selected', String(aan)); t.tabIndex = aan ? 0 : -1; if (aan && focus) t.focus(); });
    document.querySelectorAll<HTMLElement>('[data-paneel]').forEach((p) => p.classList.toggle('hidden', p.dataset.paneel !== s));
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => { kies(t.dataset.tab!); zetSoort(t.dataset.tab!); });
    t.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]; kies(n.dataset.tab!, true); zetSoort(n.dataset.tab!); } });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-naar]').forEach((a) => a.addEventListener('click', () => { kies(a.dataset.naar!); zetSoort(a.dataset.naar!); }));

  // Rekenhulp
  const f = document.querySelector<HTMLFormElement>('[data-reken]')!;
  const schuif = f.querySelector<HTMLInputElement>('[data-lessen]')!;
  const uit = f.querySelector<HTMLOutputElement>('[data-lessen-uit]')!;
  const label = f.querySelector<HTMLElement>('[data-lessen-label]')!;
  const regelsEl = f.querySelector<HTMLElement>('[data-regels]')!;
  const totaalEl = f.querySelector<HTMLElement>('[data-totaal]')!;
  const prijs = (s: 'auto' | 'motor' | 'aanhanger', t: string) => tarieven[s].rijen.find((r) => r.t === t)!.p;
  const bereik: Record<string, [number, number, number, string]> = {
    auto: [6, 50, 20, 'Aantal lessen van 60 minuten'],
    motor: [20, 50, 20, 'Aantal lessen van 45 minuten'],
    aanhanger: [6, 14, 8, 'Aantal lessen van 60 minuten'],
  };
  let soort: 'auto' | 'motor' | 'aanhanger' = 'auto';
  let regels: [string, number][] = [];
  function zetSoort(s: string) {
    soort = s as typeof soort;
    const r = f.querySelector<HTMLInputElement>(`input[name="soort"][value="${s}"]`); if (r) r.checked = true;
    const [mn, mx, st, lb] = bereik[s];
    schuif.min = String(mn); schuif.max = String(mx); schuif.value = String(st); label.textContent = lb;
    f.querySelectorAll<HTMLElement>('[data-opties]').forEach((o) => o.classList.toggle('hidden', o.dataset.opties !== s));
    reken();
  }
  function reken() {
    const n = Number(schuif.value); uit.textContent = String(n);
    const v = (k: string) => (f.elements.namedItem(k) as HTMLInputElement | null)?.checked;
    regels = [];
    if (soort === 'auto') {
      const uur = prijs('auto', 'Privéles per uur, cat. B');
      if (v('eerder')) regels.push([`${n} lessen à ${eur(uur)}`, n * uur]);
      else { regels.push(['WK instappakket (6 lessen)', prijs('auto', 'WK instappakket')]); if (n > 6) regels.push([`${n - 6} lessen à ${eur(uur)}`, (n - 6) * uur]); }
      if (v('tt')) regels.push(['Tussentijdse toets', prijs('auto', 'Tussentijdse toets')]);
      regels.push(v('fa') ? ['Faalangst-examen', prijs('auto', 'Faalangst-examen')] : ['Praktijkexamen', prijs('auto', 'Praktijkexamen')]);
    } else if (soort === 'motor') {
      const les = prijs('motor', 'Motorrijles à 45 minuten');
      const a = prijs('motor', 'WK opstappakket') + Math.max(0, n - 20) * les;
      const b = n >= 30 ? prijs('motor', '30 lessen + AVB- en AVD-examen') + (n - 30) * les : Infinity;
      if (b < a) { regels.push(['30 lessen + AVB- en AVD-examen', prijs('motor', '30 lessen + AVB- en AVD-examen')]); if (n > 30) regels.push([`${n - 30} lessen à ${eur(les)}`, (n - 30) * les]); }
      else { regels.push(['WK opstappakket (20 lessen + AVB en AVD)', prijs('motor', 'WK opstappakket')]); if (n > 20) regels.push([`${n - 20} lessen à ${eur(les)}`, (n - 20) * les]); }
    } else {
      const les = prijs('aanhanger', 'Losse les à 60 minuten');
      if (n < 8) { regels.push(['6 lessen + praktijkexamen', prijs('aanhanger', '6 lessen (2 dagdelen) inclusief praktijkexamen')]); if (n > 6) regels.push([`${n - 6} losse les à ${eur(les)}`, (n - 6) * les]); }
      else { regels.push(['WK aanhangpakket (8 lessen + examen)', prijs('aanhanger', 'WK aanhangpakket')]); if (n > 8) regels.push([`${n - 8} losse lessen à ${eur(les)}`, (n - 8) * les]); }
      if (v('dag')) regels.push(['Intakeles van 2 uur', prijs('aanhanger', 'Intakeles van 2 uur')]);
    }
    const tot = regels.reduce((s, [, p]) => s + p, 0);
    regelsEl.innerHTML = '';
    regels.forEach(([t, p]) => { const li = document.createElement('li'); li.className = 'flex justify-between gap-4'; li.innerHTML = `<span></span><span class="num whitespace-nowrap"></span>`; li.children[0].textContent = t; li.children[1].textContent = eur(p); regelsEl.append(li); });
    totaalEl.textContent = eur(Math.round(tot * 100) / 100);
  }
  f.addEventListener('input', (e) => { const t = e.target as HTMLInputElement; if (t.name === 'soort') { zetSoort(t.value); kies(t.value); } else reken(); });
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const naam = { auto: 'autorijles', motor: 'motorrijles', aanhanger: 'aanhangerrijles (BE)' }[soort];
    const r = [`Hoi Wim, ik wil me graag inschrijven voor ${naam}.`, 'Ik heb op jullie site deze indicatie uitgerekend:', ...regels.map(([t, p]) => `- ${t}: ${eur(p)}`), `Totaal: ${totaalEl.textContent}`];
    window.open(WA + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
  });
  zetSoort('auto');

</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: 1; letter-spacing: -0.045em; }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: 999px; background: var(--color-mist); }
  .status-pil .status-stip { background: var(--color-grijs); }
  .status-pil[data-open='true'] .status-stip { background: #2f9e67; }

  .tab { color: var(--color-grijs); transition: background-color .2s, color .2s, box-shadow .2s; }
  .tab:hover { color: var(--color-inkt); }
  .tab[aria-selected='true'] { background: #fff; color: var(--color-inkt); box-shadow: var(--shadow-sm); }

  .keuze span { display: inline-flex; width: 100%; align-items: center; justify-content: center; min-height: 2.75rem; padding: 0 .5rem; border-radius: 999px; background: var(--color-nacht-2); color: var(--color-licht); font-size: .9375rem; font-weight: 600; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #1f2d5e; }
  .keuze input:checked + span { background: var(--color-streep); color: var(--color-inkt); }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-streep); outline-offset: 2px; }
  .keuze.licht span { width: auto; background: #fff; color: var(--color-inkt); box-shadow: inset 0 0 0 1.5px #0b153024; font-weight: 500; }
  .keuze.licht span:hover { box-shadow: inset 0 0 0 1.5px #0b153055; }
  .keuze.licht input:checked + span { background: var(--color-navy); color: #fff; box-shadow: none; }
  .keuze.licht input:focus-visible + span { outline-color: var(--color-navy); }

  .vinkje { display: flex; gap: .75rem; align-items: flex-start; cursor: pointer; }
  .vinkje input { appearance: none; flex: none; margin-top: .15rem; width: 1.25rem; height: 1.25rem; border-radius: .35rem; border: 1.5px solid var(--color-licht-zacht); display: grid; place-items: center; cursor: pointer; transition: background-color .2s, border-color .2s; }
  .vinkje input:checked { background: var(--color-streep); border-color: var(--color-streep); }
  .vinkje input:checked::after { content: ""; width: .35rem; height: .65rem; border: solid var(--color-inkt); border-width: 0 2.5px 2.5px 0; transform: translateY(-1px) rotate(45deg); }

  .schuif { appearance: none; height: .5rem; border-radius: 999px; background: var(--color-nacht-2); cursor: pointer; }
  .schuif::-webkit-slider-thumb { appearance: none; width: 1.6rem; height: 1.6rem; border-radius: 999px; background: var(--color-streep); border: 4px solid var(--color-nacht); box-shadow: 0 0 0 2px var(--color-streep); }
  .schuif::-moz-range-thumb { width: 1.2rem; height: 1.2rem; border-radius: 999px; background: var(--color-streep); border: 4px solid var(--color-nacht); }

  .veld { display: block; width: 100%; border-radius: .75rem; border: 1.5px solid #0b153033; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #0b153066; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-navy); }
</style>
