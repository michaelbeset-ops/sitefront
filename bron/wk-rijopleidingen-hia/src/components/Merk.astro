---
// Woordmerk: het logo-rondje (navy schijf met een witte weg en lichtblauwe strepen) nagetekend, plus de naam.
interface Props { class?: string; href: string }
const { class: cls = '', href } = Astro.props;
const id = 'wk-' + Math.random().toString(36).slice(2, 8);
---
<a href={href} class:list={['merk', cls]}>
  <svg viewBox="0 0 48 48" aria-hidden="true">
    <defs><clipPath id={id}><circle cx="23" cy="25" r="21" /></clipPath></defs>
    <circle cx="23" cy="25" r="21" fill="#1d3b78" />
    <g clip-path={`url(#${id})`}>
      <path d="M-2 40 C 12 30, 28 20, 50 12" stroke="#fff" stroke-width="9" fill="none" />
    </g>
    <path d="M38 17.6 C 42 16, 45 14.6, 48 13.4" stroke="#fff" stroke-width="5.5" stroke-linecap="round" fill="none" />
    <path d="M2 37.6 C 13 30, 27 21.6, 44 15" stroke="#2bb0e8" stroke-width="2.2" stroke-dasharray="4.2 3.2" fill="none" />
  </svg>
  <span><b>WK <span>Rijopleidingen</span></b><small>Auto · Motor · Aanhanger</small></span>
</a>
