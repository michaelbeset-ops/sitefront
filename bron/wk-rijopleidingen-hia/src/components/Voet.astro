---
import { site, url, tijden, waInschrijven } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker overflow-hidden bg-nacht text-licht-zacht">
  <div class="strepen mx-auto max-w-[78rem] opacity-60" aria-hidden="true"></div>
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <Merk href={url('')} class="text-licht" />
      <p class="mt-6 max-w-xs">Rijschool in Hendrik-Ido-Ambacht voor auto, motor en aanhanger. Privéles bij Wim en Annemarie Kanters.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-full bg-nacht-2 text-licht transition-colors hover:bg-navy" aria-label="Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
        <a href={`mailto:${site.mail}`} class="grid h-10 w-10 place-items-center rounded-full bg-nacht-2 text-licht transition-colors hover:bg-navy" aria-label="E-mail"><Icoon naam="mail" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Opleidingen</p>
      <ul class="mt-4 space-y-2">
        <li><a href={h('auto')} class="no-underline transition-colors hover:text-streep">Autorijles (B)</a></li>
        <li><a href={h('motor')} class="no-underline transition-colors hover:text-streep">Motorrijles (A1 en A)</a></li>
        <li><a href={h('aanhanger')} class="no-underline transition-colors hover:text-streep">Aanhanger (BE)</a></li>
        <li><a href={h('extra')} class="no-underline transition-colors hover:text-streep">Opfriscursus</a></li>
        <li><a href={h('extra')} class="no-underline transition-colors hover:text-streep">Faalangst-examen</a></li>
        <li><a href={site.webshop} class="no-underline transition-colors hover:text-streep">Theorie-webshop</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li class="flex justify-between gap-3 sm:justify-start"><span>Wim</span> <a href={site.wim.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-streep">{site.wim.tel}</a></li>
        <li class="flex justify-between gap-3 sm:justify-start"><span>Annemarie</span> <a href={site.annemarie.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-streep">{site.annemarie.tel}</a></li>
        <li><a href={waInschrijven} class="no-underline transition-colors hover:text-streep">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-streep">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Openingstijden</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Openingstijden</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-streep">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num whitespace-nowrap py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats} · CBR-rijschoolcode {site.cbrCode}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-streep">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw Google-bedrijfsprofiel en de huidige website, ter illustratie; kentekens onherkenbaar gemaakt. Reviews letterlijk van Google (stand 3 oktober 2026).</p>}
  </div>
</footer>
