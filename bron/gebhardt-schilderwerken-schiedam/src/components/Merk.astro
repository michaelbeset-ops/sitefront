---
// Woordmerk. Het teken is een vereenvoudigde versie van hun logo: een ruit met een kwast die een streek zet.
import { url, site } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class={`merk ${cls}`}>
  <span class="merk-teken" aria-hidden="true">
    <svg viewBox="0 0 40 40" class="h-10 w-10">
      <rect x="9" y="9" width="22" height="22" transform="rotate(45 20 20)" fill="currentColor" opacity=".16" />
      <rect x="9" y="9" width="22" height="22" transform="rotate(45 20 20)" fill="none" stroke="currentColor" stroke-width="2.2" />
      <path d="M8 27.5c5-1.2 10.5-1.4 16-.6" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" />
      <path d="m24.5 26.6 6.2-9.4 3 2-6.2 9.4z" fill="currentColor" />
      <path d="m30.7 17.2 1.8-2.7a1.8 1.8 0 0 1 3 2l-1.8 2.7z" fill="currentColor" opacity=".7" />
    </svg>
  </span>
  <span><b>Gebhardt</b><small>Schilderwerken · Schiedam</small></span>
</a>
