---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, werkgebied, waOfferte } from '../data/site';
import hero from '../assets/hero.jpg';
import over from '../assets/over.jpg';
import dBuiten from '../assets/d-buiten.jpg';
import dBinnen from '../assets/d-binnen.jpg';
import dWand from '../assets/d-wand.jpg';
import dHoutrot from '../assets/d-houtrot.jpg';
import dBeton from '../assets/d-beton.jpg';
import dCoating from '../assets/d-coating.jpg';
import vPart from '../assets/v-particulier.jpg';
import vVve from '../assets/v-vve.jpg';
import vBedrijf from '../assets/v-bedrijf.jpg';
import vAannemer from '../assets/v-aannemer.jpg';
import vnH1 from '../assets/vn-hout-1.jpg';
import vnH2 from '../assets/vn-hout-2.jpg';
import vnH3 from '../assets/vn-hout-3.jpg';
import vnB1 from '../assets/vn-balkon-1.jpg';
import vnB2 from '../assets/vn-balkon-2.jpg';
import vnB3 from '../assets/vn-balkon-3.jpg';
import vnD1 from '../assets/vn-deur-1.jpg';
import vnD3 from '../assets/vn-deur-3.jpg';
import pAvond from '../assets/p-avond.jpg';
import pRiet from '../assets/p-riet.jpg';
import pVilla from '../assets/p-villa.jpg';
import pMonument from '../assets/p-monument.jpg';
import pKerk from '../assets/p-kerk.jpg';
import pWoonkamer from '../assets/p-woonkamer.jpg';
import pGalerij from '../assets/p-galerij.jpg';
import pDeur from '../assets/p-deur.jpg';
import pHek from '../assets/p-hek.jpg';

const doelgroepen = [
  { t: 'Particulieren', i: 'huis', src: vPart, alt: 'Wit geschilderde woning met donkere kozijnen en een rieten tuinhuis', pos: '30% 50%' },
  { t: 'Verenigingen van eigenaren', i: 'flat', src: vVve, alt: 'Appartementencomplex in baksteen met een hoogwerker bij de balkons', pos: '50% 50%' },
  { t: 'Bedrijven en instellingen', i: 'gebouw', src: vBedrijf, alt: 'Kerkzaal met rolsteiger, witte wanden en een donker plafond', pos: '55% 50%' },
  { t: 'Aannemers', i: 'helm', src: vAannemer, alt: 'Nieuwbouwwoning met zwarte gevelbekleding en witte stuc op de bouwplaats', pos: '50% 40%' },
];

const diensten = [
  { t: 'Buitenschilderwerk', d: 'Kozijnen, deuren, ramen en luiken. Voor onderhoud, renovatie en nieuwbouw.', src: dBuiten, alt: 'Monumentaal bakstenen pand met rood-groen geschilderde luiken en kozijnen', pos: '50% 50%' },
  { t: 'Binnenschilderwerk', d: 'Wanden, plafonds, trappen en deuren, strak afgewerkt.', src: dBinnen, alt: 'Twee schilders op een rolsteiger werken aan een schuin plafond', pos: '50% 35%' },
  { t: 'Wandafwerking en kleuradvies', d: 'Advies over kleuren en mogelijkheden, bij u op locatie.', src: dWand, alt: 'Gang met een groene lambrisering en witte wanden', pos: '50% 60%' },
  { t: 'Houtrotherstel', d: 'Aangetast hout herstellen, daarna pas grondverf en lak.', src: dHoutrot, alt: 'Boeideel met een hersteld stuk hout in oranje houtvuller', pos: '50% 50%' },
  { t: 'Betonrenovatie', d: 'Balkons en galerijen weer heel en netjes afgewerkt.', src: dBeton, alt: 'Schilder rolt een grijze coating op een balkonvloer', pos: '50% 50%' },
  { t: 'Coatings, impregneren en kitwerk', d: 'Bescherming voor hout, steen en naden.', src: dCoating, alt: 'Zwart glanzende houten gevelbekleding', pos: '50% 50%' },
];

const voorNa = [
  { id: 'hout', t: 'Houtrot', kop: 'Houtrot in een boeideel', fotos: [
    { src: vnH1, l: 'Voor', alt: 'Boeideel met een scheur en donker rot hout' },
    { src: vnH2, l: 'Tijdens', alt: 'Hetzelfde boeideel, gerepareerd met oranje houtvuller' },
    { src: vnH3, l: 'Na', alt: 'Het boeideel strak in de lak tegen een blauwe lucht' },
  ] },
  { id: 'balkon', t: 'Balkon', kop: 'Een balkonvloer opnieuw opgebouwd', fotos: [
    { src: vnB1, l: 'Voor', alt: 'Balkonvloer met losgeraakte verf en kale plekken' },
    { src: vnB2, l: 'Tijdens', alt: 'Schilder rolt een lichtgrijze coating over de balkonvloer' },
    { src: vnB3, l: 'Na', alt: 'Het balkon met lichtgrijze vloer en donkergroen geschilderde deuren' },
  ] },
  { id: 'deur', t: 'Voordeur', kop: 'Een oude voordeur in de hoogglans', fotos: [
    { src: vnD1, l: 'Voor', alt: 'Dubbele voordeur met afgebladderde, deels kaal geschuurde verf achter een steiger' },
    { src: vnD3, l: 'Na', alt: 'Zwarte voordeur in hoogglans met een sierrooster en koperen beslag' },
  ] },
];

const projecten = [
  { src: pAvond, c: 'buiten', t: 'Nieuwbouwvilla, buitenschilderwerk', alt: 'Witte villa met donker dak, aangelicht in de avond', groot: true },
  { src: pKerk, c: 'binnen', t: 'Kerkzaal', alt: 'Kerkzaal met witte wanden, donker plafond, kroonluchters en rolsteiger' },
  { src: pHek, c: 'deuren', t: 'Smeedijzeren toegangshek', alt: 'Groen geschilderd sierlijk smeedijzeren hek in de herfst' },
  { src: pRiet, c: 'buiten', t: 'Villa met rieten kap', alt: 'Witte villa met rieten kap en zwarte kozijnen aan het water' },
  { src: pDeur, c: 'deuren', t: 'Voordeur in hoogglans', alt: 'Zwarte voordeur in hoogglans met glas-in-lood en een rooster' },
  { src: pMonument, c: 'buiten', t: 'Monument in de steigers', alt: 'Rijk versierd bakstenen pand met steigers langs de gevel' },
  { src: pWoonkamer, c: 'binnen', t: 'Woning, binnenschilderwerk', alt: 'Lichte woonkamer met witte wanden en een gashaard, klaar voor oplevering' },
  { src: pVilla, c: 'buiten', t: 'Herenhuis met erker', alt: 'Bakstenen herenhuis met witte kozijnen, sierlijsten en een tuinlantaarn' },
  { src: pGalerij, c: 'binnen', t: 'Atrium met galerijen', alt: 'Overdekt atrium met groene wanden, galerijen en loopbruggen' },
];

const stappen = [
  ['Bel of app voor een afspraak', 'Leg uw schilderplannen vrijblijvend voor. Ons advies verplicht u tot niets.'],
  ['Advies bij u op locatie', 'We bespreken uw wensen en adviseren over kleuren, mogelijkheden en behandelingen.'],
  ['Een duidelijke offerte', 'Al onze bevindingen en afspraken, met de garantietermijn. U weet vooraf waar u aan toe bent.'],
  ['Vakwerk met topmaterialen', 'Wij werken uitsluitend met de beste professionele materialen. Dat ziet u terug in het resultaat.'],
];
---
<Base title={`${site.naam} | Vakschilder in Schiedam`} description="Gebhardt Schilderwerken Vastgoedonderhoud, Schiedam. Binnen- en buitenschilderwerk voor bedrijf, VvE en particulier, sinds 2005. Vrijblijvend advies en een duidelijke offerte.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" quality={70} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[42%_50%] md:object-[50%_45%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#10162a40_0%,#10162a99_40%,#10162af2_100%)] md:bg-[linear-gradient(90deg,#10162af0_0%,#10162ac4_38%,#10162a33_75%,#10162a1a_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-10 pb-24 pt-32 md:pb-20 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow"><span>Schilder in Schiedam<span class="hidden sm:inline"> · sinds {site.sinds}</span></span></p>
          <h1 id="t-hero" class="mt-5 text-hero">Uw vakschilder voor al uw <span class="text-hemel">schilderwerk.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Binnen en buiten, voor bedrijf, VvE en particulier. Deskundig persoonlijk advies, professioneel vakwerk en een eerlijke prijs.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="knop knop-kobalt"><Icoon naam="offerte" />Vraag een offerte aan</a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-hemel" />Vrijblijvend advies</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-hemel" />Offerte met garantietermijn</li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:flex lg:justify-end">
          <div class="w-full max-w-[18.5rem] rounded-lg bg-nacht/70 p-6 ring-1 ring-licht/15 backdrop-blur-md">
            <p class="text-sm text-licht-zacht">Bel gerust voor een afspraak</p>
            <a href={site.telHref} class="num mt-1 block font-kop text-[1.75rem] font-extrabold tracking-[-0.02em] text-licht no-underline hover:text-hemel">{site.tel}</a>
            <p class="mt-3 border-t border-lijn-licht pt-3 text-sm text-licht-zacht">Ons advies verplicht u tot niets.</p>
            <a href={waOfferte} class="knop knop-wit knop-klein mt-5 w-full"><Icoon naam="wa" />Of stuur een WhatsApp</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Voor wie -->
    <section class="py-20 lg:py-24" aria-labelledby="t-wie">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Voor wie</p>
            <h2 id="t-wie" class="mt-4 text-3xl">Voor bedrijf, VvE en particulier.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Schilderwerk en onderhoud voor uw woning, bedrijfspand of vastgoed. Van één voordeur tot een heel complex.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {doelgroepen.map((g, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href="#offerte" data-voor={g.t} class="group relative block aspect-[3/4] overflow-hidden sm:aspect-[1/1] rounded-lg bg-nacht no-underline">
                <Image src={g.src} alt={g.alt} widths={[360, 540, 720]} sizes="(min-width: 1248px) 290px, (min-width: 1024px) 23vw, 46vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${g.pos}`} />
                <span class="absolute inset-0 bg-[linear-gradient(180deg,#10162a00_40%,#10162ae0_100%)]" aria-hidden="true"></span>
                <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-4 text-licht sm:p-6">
                  <span>
                    <Icoon naam={g.i} class="h-6 w-6 text-hemel" />
                    <span class="mt-3 block font-kop text-[1.0625rem] font-bold leading-tight tracking-[-0.02em] hyphens-auto sm:text-xl">{g.t}</span>
                  </span>
                  <span class="hidden h-10 w-10 shrink-0 place-items-center rounded-md bg-licht/15 transition-colors group-hover:bg-kobalt sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="border-t border-lijn bg-wit py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-4 text-3xl">Van A tot Z, binnen en buiten.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Schilderwerk voor onderhoud, renovatie en nieuwbouw. Wij werken uitsluitend met de beste professionele materialen.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href="#offerte" data-dienst={b.t} class="kaart group flex h-full flex-row overflow-hidden bg-linnen no-underline sm:flex-col transition-shadow duration-300 hover:shadow-md">
                <div class="relative w-[38%] shrink-0 overflow-hidden sm:w-auto">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 38vw" class="h-full min-h-[8.5rem] w-full object-cover sm:aspect-[3/2] sm:h-auto transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                  <span class="num absolute left-2.5 top-2.5 rounded-sm sm:left-4 sm:top-4 bg-nacht/80 px-2 py-1 text-xs font-bold text-licht backdrop-blur">0{i + 1}</span>
                </div>
                <div class="flex flex-1 items-center justify-between gap-4 p-4 sm:items-end sm:p-6">
                  <div>
                    <h3 class="text-lg hyphens-auto sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-[.9375rem] text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-md bg-wit text-kobalt shadow-sm sm:grid transition-colors group-hover:bg-kobalt group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Voor en na -->
    <section class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-vn">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Voor en na</p>
            <h2 id="t-vn" class="mt-4 text-3xl">Eerst herstellen, dan pas schilderen.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Mooi schilderwerk begint bij een goede ondergrond. Drie voorbeelden uit ons projectalbum.</p>
        </div>
        <div class="mt-12 lg:mt-14" data-tabs>
          <div class="flex flex-wrap gap-2" role="tablist" aria-label="Voorbeelden">
            {voorNa.map((v, i) => (
              <button type="button" role="tab" id={`tab-${v.id}`} aria-controls={`paneel-${v.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tab">{v.t}</button>
            ))}
          </div>
          {voorNa.map((v, i) => (
            <div role="tabpanel" id={`paneel-${v.id}`} aria-labelledby={`tab-${v.id}`} class="mt-8" hidden={i !== 0}>
              <h3 class="sr-only">{v.kop}</h3>
              <ol class={`-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 [scrollbar-width:none] sm:mx-0 sm:grid sm:gap-5 sm:overflow-visible sm:px-0 ${v.fotos.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`}>
                {v.fotos.map((f, j) => (
                  <li class="relative w-[78%] shrink-0 snap-center overflow-hidden rounded-lg bg-nacht-2 sm:w-auto">
                    <Image src={f.src} alt={f.alt} widths={[320, 520, 800]} sizes={v.fotos.length === 3 ? '(min-width: 1248px) 380px, (min-width: 640px) 31vw, 78vw' : '(min-width: 1248px) 580px, (min-width: 640px) 46vw, 78vw'} class={`w-full object-cover ${v.fotos.length === 3 ? 'aspect-[4/5] sm:aspect-[4/3]' : 'aspect-[4/5] sm:aspect-[4/3]'}`} />
                    <span class={`absolute left-3 top-3 rounded-sm px-2.5 py-1 text-xs font-bold uppercase tracking-[.12em] sm:left-4 sm:top-4 ${j === v.fotos.length - 1 ? 'bg-kobalt text-wit' : 'bg-licht text-inkt'}`}>{f.l}</span>
                  </li>
                ))}
              </ol>
              <p class="mt-5 text-sm text-licht-zacht">{v.kop}.<span class="sm:hidden"> Veeg voor het resultaat.</span></p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Projecten -->
    <section id="projecten" class="py-20 lg:py-24" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-4 text-3xl">Uit ons projectalbum.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Woningen, monumenten, appartementen en bedrijfspanden. Een greep uit ons werk.</p>
        </div>
        <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter projecten" data-filter>
          {[['alles', 'Alles'], ['buiten', 'Buiten'], ['binnen', 'Binnen'], ['deuren', 'Deuren en hekwerk']].map(([k, t], i) => (
            <button type="button" data-f={k} aria-pressed={i === 0 ? 'true' : 'false'} class="filter">{t}</button>
          ))}
        </div>
        <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-4" data-grid>
          {projecten.map((p) => (
            <li data-c={p.c} class={`project group relative overflow-hidden rounded-lg bg-zand ${p.groot ? 'col-span-2 row-span-2 aspect-square md:aspect-auto' : 'aspect-square'}`}>
              <Image src={p.src} alt={p.alt} widths={p.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={p.groot ? '(min-width: 1248px) 580px, (min-width: 768px) 62vw, 92vw' : '(min-width: 1248px) 290px, (min-width: 1024px) 23vw, (min-width: 768px) 31vw, 46vw'} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
              <span class="absolute inset-x-0 bottom-0 bg-[linear-gradient(180deg,#10162a00,#10162acc)] px-3 pb-3 pt-10 text-[.8125rem] font-semibold leading-snug text-licht sm:px-4 sm:pb-4 sm:text-sm">{p.t}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="border-t border-lijn bg-zand py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Zo pakken wij het aan.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Persoonlijk, duidelijk en zonder verrassingen achteraf.</p>
        </div>
        <ol class="mt-12 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative p-6 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.5rem] font-black leading-none tracking-[-0.04em] text-kobalt">0{i + 1}</p>
              <h3 class="mt-6 text-xl">{t}</h3>
              <p class="mt-3 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[28rem] lg:col-span-5">
          <Image src={over} alt="Schilder in witte werkkleding op een steiger, aan het werk aan een gevel" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_40%]" />
          <p class="absolute bottom-4 left-4 rounded-sm bg-kobalt px-3 py-1.5 text-sm font-semibold text-wit">Sinds {site.sinds} in Schiedam en omstreken</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over ons</p>
          <h2 id="t-over" class="mt-4 text-3xl">Een betrouwbare vakschilder, al sinds {site.sinds}.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Gebhardt Schilderwerken Vastgoedonderhoud verzorgt binnen- en buitenschilderwerk voor particulieren, aannemers, VvE’s, bedrijven en instellingen. In al die jaren hebben we een goede en betrouwbare indruk achtergelaten bij onze vaste klanten en opdrachtgevers.</p>
          <figure class="mt-8 border-l-2 border-hemel pl-5">
            <blockquote class="font-kop text-xl font-semibold leading-snug tracking-[-0.01em] text-licht">“Graag kom ik persoonlijk bij u langs om uw wensen te bespreken en te adviseren over kleuren en mogelijkheden.”</blockquote>
