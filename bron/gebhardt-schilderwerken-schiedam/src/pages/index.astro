  [data-open='true'] .status-stip { background: #2f9e6a; box-shadow: 0 0 0 4px #2f9e6a33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: var(--radius-sm); background: var(--color-zand); }
  .tab { min-height: 2.75rem; padding: 0 1.2rem; border-radius: var(--radius-md); font-weight: 600; font-size: .9375rem; color: var(--color-licht); box-shadow: inset 0 0 0 1.5px #f6f3ed40; cursor: pointer; transition: background-color .2s, color .2s, box-shadow .2s; }
  .tab:hover { box-shadow: inset 0 0 0 1.5px var(--color-licht); }
  .tab[aria-selected='true'] { background: var(--color-licht); color: var(--color-inkt); box-shadow: none; }
  .filter { min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-md); font-weight: 600; font-size: .9375rem; background: var(--color-wit); box-shadow: inset 0 0 0 1px var(--color-lijn); cursor: pointer; transition: background-color .2s, color .2s; }
  .filter:hover { background: var(--color-zand); }
  .filter[aria-pressed='true'] { background: var(--color-inkt); color: var(--color-licht); box-shadow: none; }
  .project.los { grid-column: auto; grid-row: auto; aspect-ratio: 1; }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-md); background: var(--color-zand); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #e0d8c8; }
