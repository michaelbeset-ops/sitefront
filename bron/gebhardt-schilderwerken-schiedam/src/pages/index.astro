<script>
  // Voor/na-tabs
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const kies = (t: HTMLButtonElement) => {
    tabs.forEach((x) => { const aan = x === t; x.setAttribute('aria-selected', String(aan)); x.tabIndex = aan ? 0 : -1; document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !aan; });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => kies(t));
    t.addEventListener('keydown', (e) => {
      const n = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (n) { const v = tabs[(i + n + tabs.length) % tabs.length]; kies(v); v.focus(); }
    });
  });

  // Projectfilter
  const knoppen = [...document.querySelectorAll<HTMLButtonElement>('[data-f]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-grid] > li')];
  knoppen.forEach((k) => k.addEventListener('click', () => {
    const f = k.dataset.f;
    knoppen.forEach((x) => x.setAttribute('aria-pressed', String(x === k)));
    items.forEach((li) => { li.hidden = f !== 'alles' && li.dataset.c !== f; li.classList.toggle('los', f !== 'alles'); });
  }));

  // Klik op doelgroep of dienst: alvast aanvinken in het offerteformulier.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  document.querySelectorAll<HTMLAnchorElement>('[data-voor]').forEach((a) => a.addEventListener('click', () => {
    const w = a.dataset.voor === 'Verenigingen van eigenaren' ? 'VvE' : a.dataset.voor === 'Particulieren' ? 'Particulier' : a.dataset.voor === 'Aannemers' ? 'Aannemer' : 'Bedrijf of instelling';
    const r = f?.querySelector<HTMLInputElement>(`input[name=wie][value="${w}"]`); if (r) r.checked = true;
  }));
  document.querySelectorAll<HTMLAnchorElement>('[data-dienst]').forEach((a) => a.addEventListener('click', () => {
    const c = f?.querySelector<HTMLInputElement>(`input[name=werk][value="${a.dataset.dienst}"]`); if (c) c.checked = true;
  }));

  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Goedendag, ik wil graag een vrijblijvende offerte voor schilderwerk.'];
      if (v('wie')) r.push('Ik ben: ' + v('wie'));
      const werk = d.getAll('werk').map(String);
      if (werk.length) r.push('Het gaat om: ' + werk.join(', ').toLowerCase());
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('wens')) r.push('Toelichting: ' + v('wens'));
      if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam'));
      window.open('https://wa.me/31624509873?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

