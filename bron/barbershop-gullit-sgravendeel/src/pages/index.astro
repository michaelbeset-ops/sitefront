---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waAfspraak, waMet } from '../data/site';
import pand from '../assets/pand.jpg';
import zaakAvond from '../assets/zaak-avond.jpg';
import zaak from '../assets/zaak.jpg';
import bord from '../assets/bord.jpg';
import fade from '../assets/fade.jpg';
import parfum from '../assets/parfum.jpg';
import home from '../assets/home.jpg';
import depot from '../assets/depot.png';
import accessoires from '../assets/accessoires.jpg';
import wKrul from '../assets/w-krul.jpg';
import wPlatina from '../assets/w-platina.jpg';
import wFringe from '../assets/w-fringe.jpg';
import wSlick from '../assets/w-slick.jpg';
import wGrijs from '../assets/w-grijs.jpg';
import wKids from '../assets/w-kids.jpg';
import wTaper from '../assets/w-taper.jpg';
import wBuzz from '../assets/w-buzz.jpg';

const vraag = (b: string) => waMet(`Hoi Barbershop Gullit, ik wil graag een afspraak maken voor ${b.toLowerCase()}.`);

const diensten = [
  { t: 'Knippen en fades', d: 'Van een strakke skin fade tot een klassieke coupe met de schaar.', src: fade, alt: 'Achterhoofd met een strak verlopen fade, net geknipt', pos: '50% 45%', w: 'knippen' },
  { t: 'Scheren en baard', d: 'Haircuts and shaves, zoals het op het bord staat. Ook je baard in model.', src: bord, alt: 'Het zwarte bord van de zaak met de tekst Barbershop, haircuts and shaves', pos: '50% 50%', w: 'scheren of baard' },
  { t: 'Kinderen', d: 'Ook de kleinste klanten. Met geduld, juist als ze de kapper spannend vinden.', src: wKids, alt: 'Jongen met een fris geknipte fade en het haar luchtig naar voren', pos: '50% 40%', w: 'mijn kind' },
];

const werk = [
  { src: wKrul, alt: 'Achterkant van een krullend kapsel met een strakke taper in de nek', groot: true },
  { src: wPlatina, alt: 'Platinablond haar strak naar achteren met een korte fade aan de zijkant' },
  { src: wFringe, alt: 'Pony naar voren over een hoge fade' },
  { src: wGrijs, alt: 'Grijs haar kort geknipt met een nette overgang naar de nek' },
  { src: wTaper, alt: 'Volle bovenkant met een taper rond het oor' },
  { src: wSlick, alt: 'Donker haar naar achteren gekamd met een korte zijkant' },
  { src: wBuzz, alt: 'Korte crop met een heldere fade boven het oor' },
];

const stappen = [
  ['Stuur een appje', 'Zeg welke dag je uitkomt. Bellen kan natuurlijk ook.'],
  ['Vertel wat je wilt', 'Een foto of alleen een idee. We luisteren en denken mee over wat bij je past.'],
  ['In de stoel', 'Knippen, fade of scheren, met de tijd en aandacht die erbij horen.'],
  ['Met stijl de deur uit', 'En wil je het thuis zo houden: de producten staan in de store.'],
];

const store = [
  { t: 'Niche parfum', src: parfum, alt: 'Rij donkere parfumflacons in strijklicht op een zwarte achtergrond', pos: '50% 60%' },
  { t: 'Haar en baard', src: depot, alt: 'Haar- en baardproducten van Depot op een lichte ondergrond', pos: '50% 50%' },
  { t: 'Home accessoires', src: home, alt: 'Roomspray en geurstokjes in bruine flesjes op een ronde salontafel', pos: '50% 70%' },
  { t: 'Accessoires', src: accessoires, alt: 'Zonnebril met een lila doosje op het strand', pos: '50% 55%' },
];

const open = tijden.filter((t) => t.open);
---
<Base title={`${site.naam} | Barbier in 's-Gravendeel, in Casa Gullit`} description="Oldschool barbershop in Casa Gullit, Noord Voorstraat 11 in 's-Gravendeel. Knippen, fades, scheren en kinderen. 4,9 op Google. Afspraak via WhatsApp: 06 46 43 23 97.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen pand aan de Noord Voorstraat -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht lg:items-center" aria-labelledby="t-hero">
      <div class="absolute inset-0 -z-20 lg:left-auto lg:w-[54%]">
        <Image src={pand} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 54vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[50%_62%] lg:object-[50%_55%]" />
      </div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#14131240_0%,#141312b3_42%,#141312f5_78%)] lg:bg-[linear-gradient(90deg,#141312_0%,#141312_46%,#141312cc_54%,#14131226_78%,#14131200_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full gap-12 pb-16 pt-48 sm:pt-64 lg:grid-cols-12 lg:py-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">Barbier in 's-Gravendeel</p>
          <h1 id="t-hero" class="text-hero mt-6">Haircuts <span class="text-oker">&amp;<br /> shaves</span><br /> in Casa Gullit</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Een oldschool barbershop waar vakmanschap en beleving centraal staan. Knippen, fades en scheren aan de Noord Voorstraat.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-oker"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#werk" class="knop knop-rand op-foto">Bekijk ons werk</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 border-t border-lijn-licht pt-6 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Wo t/m za open</span></li>
            <li class="hidden items-center gap-2 sm:flex"><Icoon naam="tel" class="h-4 w-4 text-oker" /><a href={site.telHref} class="num font-semibold text-licht no-underline hover:text-oker-licht">{site.tel}</a></li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-6 right-6 hidden items-center gap-2 bg-nacht/80 px-4 py-2 text-sm backdrop-blur-sm lg:flex"><Icoon naam="pin" class="h-4 w-4 text-oker" />{site.straat}, {site.plaats}</p>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Barbershop en store in het kort">
      <ul class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c, i) => <li class="shrink-0"><a href={i < 5 ? '#knippen' : '#store'} class="chip">{c}</a></li>)}
      </ul>
    </section>

    <!-- 3. Knippen -->
    <section id="knippen" class="py-20 lg:py-24" aria-labelledby="t-knip">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">In de stoel</p>
            <h2 id="t-knip" class="mt-5 text-3xl">Knippen, fades<br /> en scheren.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Kom met een foto of alleen een idee. Je krijgt de tijd, en een kapsel dat bij je past.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-16 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={vraag(b.w)} class="group flex h-full flex-col bg-inkt text-licht no-underline">
                <div class="kozijn overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 640, 800]} sizes="(min-width: 1264px) 395px, (min-width: 768px) 31vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-6 lg:p-7">
                  <div>
                    <h3 class="text-[1.875rem]">{b.t}</h3>
                    <p class="mt-2 text-licht-zacht">{b.d}</p>
                  </div>
                  <span class="grid h-11 w-11 shrink-0 place-items-center bg-oker text-inkt transition-colors group-hover:bg-oker-licht" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-6 flex flex-col items-start justify-between gap-5 border border-lijn bg-steen px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Prijs of plek vragen?</b> <span class="text-grijs">Stuur even een appje, dan hoor je het meteen.</span></p>
          <a href={waAfspraak} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="wa" />Stel je vraag</a>
        </div>
      </div>
    </section>

    <!-- 4. Werk -->
    <section id="werk" class="donker bg-nacht py-24 text-licht lg:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Ons werk</p>
            <h2 id="t-werk" class="mt-5 text-3xl">Vers uit<br /> de stoel.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-licht-zacht">Fades, tapers, crops en klassieke coupes. Een greep uit wat er de afgelopen maanden in de zaak is geknipt.</p>
            <a href={site.instagram} class="knop knop-rand knop-klein mt-6"><Icoon naam="insta" />@barbershopgullit</a>
          </div>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-16 lg:grid-cols-5">
          {werk.map((w, i) => (
            <li class={`rijs relative overflow-hidden bg-nacht-2 ${w.groot ? 'col-span-2 row-span-2 aspect-square md:aspect-auto' : 'aspect-[4/5]'} ${i === werk.length - 1 ? 'md:max-lg:hidden' : ''}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={w.groot ? [380, 600] : [230, 320]} sizes={w.groot ? '(min-width: 768px) 48vw, 92vw' : '(min-width: 1264px) 230px, (min-width: 1024px) 19vw, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo gaat het</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Van appje<br /> tot fade.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een afspraak maak je via WhatsApp of telefoon. Op donderdag kan het tot 20.00 uur.</p>
        </div>
        <ol class="mt-12 grid grid-cols-2 gap-px overflow-hidden border border-lijn bg-lijn lg:mt-16 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs bg-papier p-5 sm:p-7 lg:p-8" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.5rem] font-extrabold leading-none text-oker sm:text-[3.5rem]">0{i + 1}</p>
              <h3 class="mt-5 text-[1.375rem] sm:mt-8 sm:text-[1.75rem]">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. De zaak -->
    <section id="zaak" class="donker bg-nacht text-licht" aria-labelledby="t-zaak">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[28rem] lg:col-span-6">
          <Image src={zaakAvond} alt="De barbershop 's avonds: zwarte kappersstoelen, spotjes aan een rail en glazen wanden met stalen kozijnen" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_60%]" />
          <p class="absolute bottom-0 left-0 bg-oker px-5 py-2.5 font-kop text-xl font-extrabold uppercase tracking-wide text-inkt">Luxury in simplicity</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-16 lg:py-20 xl:pr-[max(4rem,calc((100vw-79rem)/2+2.5rem))]">
          <p class="eyebrow">De zaak</p>
          <h2 id="t-zaak" class="mt-5 text-3xl">Meer dan knippen<br /> en scheren.</h2>
          <p class="mt-7 text-lg text-licht-zacht">Haar, haarstijlen en verzorging fascineren de barbier van Gullit al van jongs af aan. Na de opleiding bij de Heads Academy in Delft volgde een aanvullende cursus aan de Old School Barber Academy van Schorem in Rotterdam.</p>
          <p class="mt-4 text-lg text-licht-zacht">Het doel: dat iedere klant zich gezien voelt, even echt verzorgd wordt en met zelfvertrouwen en stijl de deur uitgaat.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-center gap-4 border border-lijn-licht bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center bg-oker text-inkt"><Icoon naam="schaar" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Geschoold in het oldschool vak</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Heads Academy in Delft en de Old School Barber Academy van Schorem.</p></div>
            </li>
            <li class="flex items-center gap-4 border border-lijn-licht bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center bg-oker text-inkt"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Luistert naar je wensen</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">En denkt mee, zeggen klanten. Constante kwaliteit.</p></div>
            </li>
            <li class="flex items-center gap-4 border border-lijn-licht bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center bg-oker text-inkt"><Icoon naam="hart" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Geduld met kleine klanten</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Ook als de kapper voor je zoontje van twee nog doodeng is.</p></div>
            </li>
          </ul>
          <a href={waAfspraak} class="knop knop-oker mt-9"><Icoon naam="wa" />Plan je afspraak</a>
        </div>
      </div>
    </section>

    <!-- 7. Casa Gullit store -->
    <section id="store" class="py-20 lg:py-24" aria-labelledby="t-store">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Casa Gullit</p>
            <h2 id="t-store" class="mt-5 text-3xl">Na het knippen<br /> even rondkijken.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">De barbershop zit in Casa Gullit, een concept store met niche parfum, haar- en baardproducten, kleding en home accessoires.</p>
        </div>
        <div class="mt-12 grid gap-4 lg:mt-16 lg:grid-cols-12 lg:gap-5">
          <figure class="rijs kozijn relative min-h-[22rem] overflow-hidden bg-inkt lg:col-span-5 lg:row-span-2">
            <Image src={zaak} alt="De store van Casa Gullit: een kledingrek, een spiegel en zwarte glazen wanden op een betonvloer" widths={[480, 720, 1000]} sizes="(min-width: 1264px) 500px, (min-width: 1024px) 40vw, 92vw" class="absolute inset-0 h-full w-full object-cover object-[50%_55%]" />
          </figure>
          <ul class="grid grid-cols-2 gap-4 lg:col-span-7 lg:gap-5">
            {store.map((s, i) => (
              <li class="rijs group relative aspect-[4/5] overflow-hidden bg-inkt sm:aspect-[5/4]" style={`--d:${i * 0.05}s`}>
                <Image src={s.src} alt={s.alt} widths={[320, 480, 640]} sizes="(min-width: 1264px) 340px, (min-width: 1024px) 28vw, 46vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${s.pos}`} />
                <span class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#141312e6,#14131200)] px-4 pb-3.5 pt-10 font-kop text-xl font-extrabold uppercase tracking-wide text-licht sm:text-2xl">{s.t}</span>
              </li>
            ))}
          </ul>
          <div class="rijs flex flex-col justify-between gap-5 bg-inkt p-6 text-licht sm:flex-row sm:items-center lg:col-span-7 lg:p-7">
            <p class="text-lg">Nieuwe parfums en producten zie je het eerst op Instagram.</p>
            <a href={site.instaStore} class="knop knop-oker knop-klein shrink-0"><Icoon naam="insta" />@casagullit</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="bg-steen py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-3xl font-extrabold leading-none">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-16 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center bg-inkt font-kop text-lg font-extrabold text-oker" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <!-- 9. Openingstijden en route -->
    <section id="route" class="py-20 lg:py-24" aria-labelledby="t-route">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Openingstijden en route</p>
          <h2 id="t-route" class="mt-5 text-3xl">Aan de Noord Voorstraat.</h2>
          <p class="mt-6 text-lg text-grijs">Het gele pand met de trapgevel en het balkon, op nummer 11. Je ziet Casa Gullit op het raam staan.</p>
          <div class="kaart mt-10 p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-2xl">Openingstijden</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Wo t/m za open</span></p>
            </div>
            <table class="mt-4 w-full">
              <caption class="sr-only">Openingstijden van de barbershop</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-oker-diep">
                    <th scope="row" class="py-2.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="flex flex-col gap-5 lg:col-span-7">
          <figure class="kozijn relative flex-1 overflow-hidden bg-inkt">
