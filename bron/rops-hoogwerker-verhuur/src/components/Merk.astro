---
// Woordmerk naar hun logo: "ROPS" zwaar en schuin in rood, "VERHUUR" breed en dun ernaast, zoals op de cabine van hun vrachtwagens.
// Op donker een helderder rood (zelfde tint) voor voldoende contrast.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-start gap-1.5 leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class={`schuin kop text-[2rem] font-[900] tracking-[-.02em] sm:text-[2.2rem] ${donker ? 'text-merk' : 'text-merk-helder'}`} style="font-stretch:125%">ROPS</span>{' '}
  <span class="kop pt-[.15rem] text-[.72rem] font-[500] tracking-[.2em]" style="font-stretch:125%">VERHUUR</span>
  <span class="sr-only">, naar de homepage</span>
</a>
