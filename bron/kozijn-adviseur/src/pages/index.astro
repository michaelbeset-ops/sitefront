---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Maat from '../components/Maat.astro';
import { site, tijden, reviews, waHoi } from '../data/site';

import hero from '../assets/hero.jpg';
import alu from '../assets/alu.jpg';
import perzikgaard from '../assets/perzikgaard.jpg';
import schuifpui from '../assets/schuifpui.jpg';
import voordeur from '../assets/voordeur.jpg';
import oudeTonge from '../assets/oude-tonge.jpg';
import schouw2 from '../assets/schouw-2.jpg';
import kunststof from '../assets/kunststof.jpg';
import paltro2 from '../assets/paltro-2.jpg';
import paltro6 from '../assets/paltro-6.jpg';

const producten = [
  { naam: 'Kunststof kozijnen', kies: 'Raamkozijnen', tekst: 'Duurzaam en op maat, voor elke woning.', foto: perzikgaard, alt: 'Twee nieuwe kunststof kozijnen in een bakstenen gevel in Spijkenisse', pos: '50% 50%', sfeer: false },
  { naam: 'Schuifpuien', kies: 'Schuifpui', tekst: 'Een ruimtelijk gevoel en een open verbinding met buiten.', foto: schuifpui, alt: 'Nieuwe witte schuifpui in een bakstenen gevel', pos: '50% 50%', sfeer: false },
  { naam: 'Aluminium kozijnen', kies: 'Raamkozijnen', tekst: 'Strak, modern en duurzaam.', foto: alu, alt: 'Sfeerfoto: woonkamer met grote ramen in donkere kozijnen', pos: '60% 50%', sfeer: true },
  { naam: 'Deuren', kies: 'Voordeur', tekst: 'Veiligheid en stijl, van voordeur tot openslaande deuren.', foto: voordeur, alt: 'Nieuwe antraciet voordeur met zijlichten', pos: '50% 40%', sfeer: false },
];

// Uit reviews (Petra H., Melanie van K., Annette E.) en de eigen site ("Ervaren monteurs die meedenken").
const stappen = [
  { t: 'Bellen of appen', z: 'U vertelt wat u zoekt. Onze monteurs denken mee.' },
  { t: 'Duidelijke offerte', z: 'Na een kort gesprek krijgt u een heldere offerte, gratis.' },
  { t: 'Nameten', z: 'We meten alles na ter plekke en leggen uit wat u krijgt.' },
  { t: 'Plaatsen', z: 'Snel, secuur en netjes geplaatst, en na afloop alles schoon.' },
];

const merken = ['Gealan', 'Schüco', 'Polytec', 'K-Vision', 'Duco'];
---
<Base title="Kozijn-Adviseur BV | Kunststof en aluminium kozijnen in Rotterdam" description="Kunststof en aluminium kozijnen, schuifpuien en deuren uit Rotterdam. Duits kwaliteitsproduct, altijd met SKG** politiekeurmerk. Vraag gratis een offerte aan.">
  <Kop />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-inkt text-wit">
      <Image src={hero} alt="Sfeerfoto: woonkamer met een glazen pui van vloer tot plafond" widths={[640, 960, 1280, 1600, 2000, 2400]} sizes="100vw" quality={70} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[52%_40%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#14181ccc_0%,#14181c8c_20%,#14181ca6_40%,#14181ce6_68%,#14181c_100%)] lg:bg-[linear-gradient(90deg,#14181cf2_0%,#14181cbf_34%,#14181c26_62%,#14181c00_80%),linear-gradient(180deg,#14181c99_0%,#14181c00_25%,#14181c00_70%,#14181ccc_100%)]"></div>

      <div class="wrap pb-28 pt-40 md:pb-20 lg:pb-16">
        <div class="max-w-[46rem]">
          <p class="eyebrow eyebrow-licht max-sm:text-[.8125rem] max-sm:tracking-[.1em]">Kozijnspecialist in Rotterdam</p>
          <h1 class="mt-5 text-hero leading-[.92]">Nieuwe kozijnen.<br /><span class="text-merk-licht">Strak</span> afgewerkt.</h1>
          <p class="mt-6 max-w-[34rem] text-[1.1875rem] leading-relaxed text-wit/90 md:text-[1.375rem]">Kunststof en aluminium kozijnen, schuifpuien en deuren. Duits kwaliteitsproduct, altijd met SKG** politiekeurmerk.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#offerte" class="knop knop-merk">Gratis offerte aanvragen<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
        <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-lijn pt-6 text-[1rem] text-wit/85">
          <a href={site.reviews} class="inline-flex items-center gap-2 text-wit/90 no-underline hover:text-wit">
            <span class="flex text-[#f5b300]">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            <span><span class="num font-bold text-wit">{site.google.score}</span> op Google, <span class="num">{site.google.aantal}</span> reviews</span>
          </a>
          <span class="inline-flex items-center gap-2"><Icoon naam="klok" class="h-5 w-5 text-merk-licht" /><span data-status>Ma t/m vr 9:00 tot 17:00</span></span>
          <span class="hidden items-center gap-2 sm:inline-flex"><Icoon naam="vink" class="h-5 w-5 text-merk-licht" />Ervaren monteurs die meedenken</span>
        </div>
      </div>
    </section>

    <!-- FEITEN -->
    <section aria-label="In het kort" class="bg-wit">
      <div class="wrap grid grid-cols-2 gap-x-6 gap-y-10 py-14 md:py-16 lg:grid-cols-4">
        <div class="rijs">
          <p class="font-kop text-[3.4rem] font-bold leading-none text-merk-diep md:text-[4.2rem]"><span class="num">30+</span></p>
          <p class="mt-3 max-w-[14rem] font-semibold text-steen">jaar ervaring in de branche</p>
        </div>
        <div class="rijs" style="--d:.08s">
          <p class="font-kop text-[3.4rem] font-bold leading-none text-merk-diep md:text-[4.2rem]"><span class="num">10+</span></p>
          <p class="mt-3 max-w-[14rem] font-semibold text-steen">jaar Kozijn-Adviseur BV</p>
        </div>
        <div class="rijs" style="--d:.16s">
          <p class="font-kop text-[3.4rem] font-bold leading-none text-merk-diep md:text-[4.2rem]">SKG**</p>
          <p class="mt-3 max-w-[14rem] font-semibold text-steen">politiekeurmerk, altijd</p>
        </div>
        <div class="rijs" style="--d:.24s">
          <p class="font-kop text-[3.4rem] font-bold leading-none text-merk-diep md:text-[4.2rem]">Duits</p>
          <p class="mt-3 max-w-[14rem] font-semibold text-steen">kwaliteitsproduct</p>
        </div>
      </div>
    </section>

    <!-- PRODUCTEN -->
    <section id="producten" class="py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 class="text-4xl lg:col-span-7">Kozijnen, puien<br />en <span class="text-merk">deuren</span></h2>
          <p class="max-w-md text-lg text-steen lg:col-span-5 lg:justify-self-end">Wij leveren en plaatsen maatwerk voor elke woning, met minimale overlast.</p>
        </div>
        <Maat class="mt-10" />
        <ul class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 xl:grid-cols-4">
          {producten.map((p, i) => (
            <li class="rijs" style={`--d:${i * 0.07}s`}>
              <a href="#offerte" data-kies={p.kies} class="group block no-underline">
                <div class="lijst">
                  <div class="relative aspect-[4/5] overflow-hidden">
                    <Image src={p.foto} alt={p.alt} widths={[400, 600, 800]} sizes="(min-width: 1280px) 290px, (min-width: 640px) 45vw, 92vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${p.pos}`} />
                    {p.sfeer && <span class="absolute bottom-2 left-2 rounded-[2px] bg-inkt/70 px-2 py-0.5 text-[.75rem] font-semibold text-wit">Sfeerfoto</span>}
                  </div>
                </div>
                <h3 class="mt-6 flex items-center justify-between gap-3 text-[1.9rem] text-inkt">{p.naam}<Icoon naam="pijl" class="h-6 w-6 flex-none text-merk transition-transform duration-300 group-hover:translate-x-1" /></h3>
                <p class="mt-2 text-steen">{p.tekst}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PROFIEL EN MERKEN -->
    <section class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32">
      <div class="pointer-events-none absolute inset-0 opacity-[.07] [background-image:linear-gradient(#fff_1px,transparent_1px),linear-gradient(90deg,#fff_1px,transparent_1px)] [background-size:32px_32px]" aria-hidden="true"></div>
      <div class="wrap relative grid gap-16 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <h2 class="text-4xl">Duits profiel.<br /><span class="text-merk-licht">Altijd SKG**.</span></h2>
          <p class="mt-7 max-w-md text-lg text-mist">In Rotterdam Schiebroek plaatsten we Gealan S 9000 NL Slim: een vlak profiel, 82,5 mm dik. Elk kozijn met SKG** politiekeurmerk.</p>
          <p class="mt-12 font-bold text-wit">De beste merken voor het beste resultaat</p>
          <ul class="mt-5 flex flex-wrap gap-x-7 gap-y-3 font-kop text-[1.9rem] font-bold uppercase leading-none text-wit/80">
            {merken.map((m) => <li>{m}</li>)}
          </ul>
        </div>
        <figure class="lg:col-span-6 lg:col-start-7">
          <svg viewBox="0 0 560 440" class="w-full text-merk-licht" fill="none" stroke="currentColor" role="img" aria-labelledby="tek-t">
            <title id="tek-t">Schematische tekening van een kozijn met een draairaam en de profieldikte van 82,5 mm</title>
            <!-- kozijn vooraanzicht -->
            <rect x="40" y="40" width="300" height="340" stroke-width="3" />
            <rect x="58" y="58" width="264" height="304" stroke-width="1.2" opacity=".7" />
            <line x1="190" y1="58" x2="190" y2="362" stroke-width="3" />
            <rect x="72" y="72" width="104" height="276" stroke-width="1.2" />
            <!-- draairaam-symbool -->
            <path d="M72 72 176 210 72 348" stroke-width="1.2" stroke-dasharray="6 6" opacity=".85" />
            <rect x="204" y="72" width="104" height="276" stroke-width="1.2" opacity=".55" />
            <!-- maatlijnen -->
            <g stroke-width="1" opacity=".75">
              <line x1="40" y1="410" x2="340" y2="410" /><line x1="40" y1="398" x2="40" y2="420" /><line x1="340" y1="398" x2="340" y2="420" />
              <line x1="34" y1="416" x2="46" y2="404" /><line x1="334" y1="416" x2="346" y2="404" />
              <line x1="10" y1="40" x2="10" y2="380" /><line x1="0" y1="40" x2="20" y2="40" /><line x1="0" y1="380" x2="20" y2="380" />
              <line x1="4" y1="46" x2="16" y2="34" /><line x1="4" y1="386" x2="16" y2="374" />
            </g>
            <text x="190" y="434" fill="currentColor" stroke="none" font-size="13" font-family="Public Sans Variable, sans-serif" font-weight="600" text-anchor="middle" letter-spacing="1.5">OP MAAT</text>
            <!-- doorsnede profiel -->
            <g transform="translate(410 110)">
              <rect x="0" y="0" width="82" height="200" stroke-width="2.5" />
              <path d="M0 40h82M0 80h82M0 120h82M0 160h82M41 0v200" stroke-width="1" opacity=".55" />
              <line x1="0" y1="232" x2="82" y2="232" stroke-width="1" /><line x1="0" y1="222" x2="0" y2="242" stroke-width="1" /><line x1="82" y1="222" x2="82" y2="242" stroke-width="1" />
              <line x1="-6" y1="238" x2="6" y2="226" stroke-width="1" /><line x1="76" y1="238" x2="88" y2="226" stroke-width="1" />
              <text x="41" y="266" fill="#fff" stroke="none" font-size="22" font-family="Antonio Variable, sans-serif" font-weight="700" text-anchor="middle">82,5 MM</text>
              <text x="41" y="-18" fill="currentColor" stroke="none" font-size="13" font-family="Public Sans Variable, sans-serif" font-weight="600" text-anchor="middle" letter-spacing="1.5">DOORSNEDE</text>
            </g>
          </svg>
          <figcaption class="mt-4 text-[.9375rem] text-mist">Schematische weergave, geen bouwtekening.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ONS WERK -->
    <section id="werk" class="py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 class="text-4xl lg:col-span-7">Ons <span class="text-merk">werk</span></h2>
          <p class="max-w-md text-lg text-steen lg:col-span-5 lg:justify-self-end">Projecten in onder meer Rotterdam, Spijkenisse en Oude Tonge.</p>
        </div>
        <Maat class="mt-10" />
        <div class="mt-12 grid gap-6 md:grid-cols-12 md:gap-8">
          <figure class="rijs md:col-span-7">
            <div class="lijst"><Image src={oudeTonge} alt="Woning in Oude Tonge met nieuwe witte kozijnen en een blauwe gevel" widths={[600, 900, 1080]} sizes="(min-width: 768px) 58vw, 92vw" class="aspect-[4/3] w-full object-cover" /></div>
            <figcaption class="mt-4 flex items-baseline justify-between gap-4"><span class="font-bold">Oude Tonge</span><span class="text-[.9375rem] text-steen">Kozijnen</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-5 md:mt-24" style="--d:.1s">
            <div class="lijst"><Image src={schouw2} alt="Hoekwoning in Spijkenisse met nieuwe kunststof kozijnen met schuine hoeken" widths={[500, 800, 1000]} sizes="(min-width: 768px) 40vw, 92vw" class="aspect-[4/3] w-full object-cover" /></div>
            <figcaption class="mt-4"><span class="flex items-baseline justify-between gap-4"><span class="font-bold">Spijkenisse</span><span class="num text-[.9375rem] text-steen">januari 2023</span></span><span class="mt-1 block text-[.9375rem] text-steen">Kunststof kozijn met schuine hoeken. Gealan S9000.</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-4">
            <div class="lijst"><Image src={paltro2} alt="Benedenwoning in Rotterdam Schiebroek met nieuwe kunststof kozijnen en deuren" widths={[400, 700, 900]} sizes="(min-width: 768px) 31vw, 92vw" class="aspect-[4/3] w-full object-cover" /></div>
            <figcaption class="mt-4"><span class="flex items-baseline justify-between gap-4"><span class="font-bold">Rotterdam Schiebroek</span><span class="num text-[.9375rem] text-steen">februari 2023</span></span><span class="mt-1 block text-[.9375rem] text-steen">Kunststof kozijnen en deuren.</span></figcaption>
          </figure>
          <blockquote class="rijs flex flex-col justify-between bg-merk p-8 text-wit md:col-span-4 md:p-10" style="--d:.08s">
            <p class="font-kop text-[2rem] font-bold uppercase leading-[1.02] md:text-[2.3rem]">“Tijdens de montage werd de lunch goed voor ons verzorgd. Toppie.”</p>
            <footer class="mt-8 text-[.9375rem] text-wit/85">Uit ons projectverslag, Spijkenisse</footer>
          </blockquote>
          <figure class="rijs md:col-span-4" style="--d:.16s">
            <div class="lijst"><Image src={paltro6} alt="Nieuwe kunststof kozijnen aan de tuinzijde van een woning in Rotterdam Schiebroek" widths={[400, 700, 900]} sizes="(min-width: 768px) 31vw, 92vw" class="aspect-[4/3] w-full object-cover" /></div>
            <figcaption class="mt-4"><span class="flex items-baseline justify-between gap-4"><span class="font-bold">Rotterdam Schiebroek</span><span class="text-[.9375rem] text-steen">Vlak profiel</span></span><span class="mt-1 block text-[.9375rem] text-steen">Gealan S 9000 NL Slim, 82,5 mm.</span></figcaption>
          </figure>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-12 md:gap-8">
          <figure class="rijs md:col-span-5 md:col-start-2">
            <div class="lijst"><Image src={kunststof} alt="Nieuw wit kunststof kozijn met bovenlicht in een gele bakstenen gevel" widths={[400, 600]} sizes="(min-width: 768px) 40vw, 92vw" class="aspect-[4/3] w-full object-cover object-[50%_40%]" /></div>
            <figcaption class="mt-4 flex items-baseline justify-between gap-4"><span class="font-bold">Kunststof kozijnen</span><span class="text-[.9375rem] text-steen">Met bovenlicht</span></figcaption>
          </figure>
          <div class="rijs flex flex-col justify-end md:col-span-5" style="--d:.1s">
            <p class="font-kop text-3xl font-bold uppercase leading-[1.02]">Ook zo’n gevel?</p>
            <p class="mt-4 max-w-sm text-steen">Stuur een foto van uw huidige kozijnen via WhatsApp. Dan denken we met u mee.</p>
            <div class="mt-7"><a href={waHoi} class="knop knop-groen"><Icoon naam="wa" />Foto sturen via WhatsApp</a></div>
          </div>
        </div>
      </div>
    </section>

    <!-- WERKWIJZE -->
    <section id="werkwijze" class="bg-wit py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 class="text-4xl lg:col-span-7">Zo <span class="text-merk">gaat</span> het</h2>
          <p class="max-w-md text-lg text-steen lg:col-span-5 lg:justify-self-end">Van eerste telefoontje tot opgeruimde kamer.</p>
        </div>
        <ol class="relative mt-16 grid gap-12 md:grid-cols-4 md:gap-8">
          <span class="absolute bottom-0 left-[1.15rem] top-2 w-px bg-papier-3 md:inset-x-0 md:bottom-auto md:left-0 md:top-[1.15rem] md:h-px md:w-auto" aria-hidden="true"></span>
          {stappen.map((s, i) => (
            <li class="rijs relative pl-16 md:pl-0" style={`--d:${i * 0.08}s`}>
              <span class="absolute left-0 top-0 grid h-[2.3rem] w-[2.3rem] place-items-center bg-merk font-kop text-[1.2rem] font-bold text-wit md:relative num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-[1.9rem] md:mt-8">{s.t}</h3>
              <p class="mt-3 max-w-[17rem] text-steen">{s.z}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews" class="py-24 md:py-32">
      <div class="wrap">
        <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
          <h2 class="text-4xl">Wat klanten <span class="text-merk">zeggen</span></h2>
          <a href={site.reviews} class="inline-flex items-center gap-4 self-start rounded-[3px] border border-lijn-licht bg-wit px-5 py-4 no-underline shadow-[0_1px_2px_#14181c14] transition-colors hover:border-merk md:self-auto">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><span class="num font-kop text-[1.6rem] font-bold leading-none">{site.google.score}</span><span class="flex text-[#f5b300]">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-[.9375rem] text-steen"><span class="num">{site.google.aantal}</span> reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <li class="rijs flex flex-col rounded-[3px] border border-lijn-licht bg-wit p-7 shadow-[0_1px_2px_#14181c0d] md:p-8" style={`--d:${(i % 3) * 0.07}s`}>
              <span class="flex text-[#f5b300]" role="img" aria-label="5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.1rem] w-[1.1rem]" />)}</span>
              <p class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</p>
              <p class="mt-6 flex items-center justify-between gap-3 border-t border-lijn-licht pt-5 text-[.9375rem]"><span class="font-bold">{r.naam}</span><span class="text-steen">{r.bron} review</span></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- OFFERTE (wow) -->
    <section id="offerte" class="relative overflow-hidden bg-merk-diep py-24 text-wit md:py-32">
      <div class="pointer-events-none absolute inset-0 opacity-[.12] [background-image:linear-gradient(#fff_1px,transparent_1px),linear-gradient(90deg,#fff_1px,transparent_1px)] [background-size:24px_24px]" aria-hidden="true"></div>
      <div class="wrap relative">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 class="text-4xl lg:col-span-7">Gratis offerte<br />aanvragen</h2>
          <p class="max-w-md text-lg text-wit/85 lg:col-span-5 lg:justify-self-end">Kies wat u zoekt. WhatsApp opent met uw aanvraag klaar, u verstuurt hem zelf.</p>
        </div>
        <form class="mt-14 grid bg-wit text-inkt shadow-[0_24px_60px_-24px_#00000080] lg:grid-cols-12" data-offerte>
          <div class="grid gap-9 p-6 sm:p-9 lg:col-span-8 lg:p-12">
            <fieldset>
              <legend class="veld-label">Wat wilt u laten plaatsen?</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                {['Raamkozijnen', 'Schuifpui', 'Voordeur', 'Openslaande deuren'].map((s) => <label class="keuze"><input type="checkbox" name="soort" value={s} />{s}</label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label">Hoeveel kozijnen ongeveer?</legend>
              <div class="grid grid-cols-2 gap-3">
                {['1', '2 tot 4', '5 tot 10', '11 of meer'].map((s) => <label class="keuze num"><input type="radio" name="aantal" value={s} />{s}</label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label">Materiaal</legend>
              <div class="grid gap-3 sm:grid-cols-3">
                {['Kunststof', 'Aluminium', 'Weet ik nog niet'].map((s) => <label class="keuze"><input type="radio" name="materiaal" value={s} />{s}</label>)}
              </div>
            </fieldset>
            <div class="grid gap-5 sm:grid-cols-2">
              <div><label class="veld-label" for="o-plaats">Plaats</label><input id="o-plaats" name="plaats" class="veld" autocomplete="address-level2" placeholder="Bijvoorbeeld Spijkenisse" /></div>
              <div><label class="veld-label" for="o-naam">Uw naam <span class="font-normal text-steen">(mag leeg)</span></label><input id="o-naam" name="naam" class="veld" autocomplete="name" /></div>
            </div>
          </div>
          <!-- titelhoek van de werktekening -->
          <div class="flex flex-col border-t-2 border-inkt bg-papier lg:col-span-4 lg:border-l-2 lg:border-t-0">
            <div class="grid grid-cols-2 border-b border-papier-3 text-[.875rem]">
              <p class="border-r border-papier-3 p-4"><span class="block font-bold uppercase tracking-[.08em] text-steen">Opdrachtgever</span><span data-o-naam>U</span></p>
              <p class="p-4"><span class="block font-bold uppercase tracking-[.08em] text-steen">Werk</span><span data-o-plaats>Plaats nog leeg</span></p>
            </div>
            <div class="flex-1 p-5 sm:p-6">
              <p class="text-[.875rem] font-bold uppercase tracking-[.08em] text-steen">Uw bericht</p>
              <p class="mt-3 whitespace-pre-line text-[1rem] leading-relaxed" data-o-tekst aria-live="polite"></p>
            </div>
            <div class="p-5 pt-0 sm:p-6 sm:pt-0">
              <a href={waHoi} class="knop knop-groen w-full" data-o-knop><Icoon naam="wa" />Verstuur via WhatsApp</a>
              <p class="mt-3 text-center text-[.9375rem] text-steen">Of bel <a href={site.telHref} class="link num font-semibold text-inkt">{site.tel}</a></p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- CONTACT EN TIJDEN -->
    <section id="contact" class="py-24 md:py-32">
      <div class="wrap grid gap-16 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="text-4xl">Bel, app<br />of <span class="text-merk">mail</span></h2>
          <p class="mt-6 max-w-md text-lg text-steen">Gevestigd in Rotterdam. Projecten in onder meer Rotterdam, Spijkenisse en Oude Tonge.</p>
          <ul class="mt-10 divide-y divide-lijn-licht border-y border-lijn-licht">
            <li><a href={site.telHref} class="flex items-center justify-between gap-4 py-5 no-underline transition-colors hover:text-merk-diep"><span class="flex items-center gap-4"><Icoon naam="tel" class="h-6 w-6 text-merk" /><span class="num font-kop text-[1.9rem] font-bold">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-steen" /></a></li>
            <li><a href={waHoi} class="flex items-center justify-between gap-4 py-5 no-underline transition-colors hover:text-merk-diep"><span class="flex items-center gap-4"><Icoon naam="wa" class="h-6 w-6 text-[#1a7f4b]" /><span class="font-kop text-[1.9rem] font-bold uppercase">WhatsApp</span></span><Icoon naam="pijl" class="h-5 w-5 text-steen" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="flex items-center justify-between gap-4 py-5 no-underline transition-colors hover:text-merk-diep"><span class="flex min-w-0 items-center gap-4"><Icoon naam="praat" class="h-6 w-6 flex-none text-merk" /><span class="break-all text-[1.1875rem] font-bold">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 flex-none text-steen" /></a></li>
          </ul>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rounded-[3px] border border-lijn-licht bg-wit p-7 shadow-[0_1px_2px_#14181c0d] md:p-9">
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-[1.9rem]">Bereikbaar</h3>
              <span class="inline-flex items-center gap-2 text-[.9375rem] font-bold" data-nu><span class="h-2.5 w-2.5 rounded-full bg-papier-3" data-nu-stip></span><span data-nu-tekst>Ma t/m vr</span></span>
            </div>
            <table class="mt-6 w-full text-[1.0625rem]">
              <tbody>
                {tijden.map((t) => (
                  <tr class="border-b border-lijn-licht last:border-0" data-dag={t.nr}>
                    <th scope="row" class="py-3 text-left font-semibold">{t.dag}</th>
                    <td class="num py-3 text-right text-steen">{t.open ? `${t.open[0]}:00 tot ${t.open[1]}:00` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-6 text-[.9375rem] text-steen">Tijden volgens ons Google-profiel. Buiten deze tijden kunt u altijd een WhatsApp sturen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SLOTBALK -->
    <section class="bg-merk text-wit">
      <div class="wrap flex flex-col gap-8 py-14 md:flex-row md:items-center md:justify-between md:py-16">
        <p class="font-kop text-3xl font-bold uppercase leading-[1.02]">Vraag nu gratis<br class="sm:hidden" /> een offerte aan</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="#offerte" class="knop knop-blanco">Offerte aanvragen<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { site, tijden } from '../data/site';

  // Live open/gesloten.
  const nu = new Date();
  const dag = nu.getDay();
  const uur = nu.getHours() + nu.getMinutes() / 60;
  const vandaag = tijden.find((t) => t.nr === dag);
  const open = !!(vandaag?.open && uur >= vandaag.open[0] && uur < vandaag.open[1]);
  document.querySelector(`[data-dag="${dag}"]`)?.classList.add('bg-merk-zacht', 'font-bold');
  const tekst = open ? `Nu bereikbaar, tot ${vandaag!.open![1]}:00` : 'Nu gesloten, app gerust';
  const t = document.querySelector('[data-nu-tekst]'); if (t) t.textContent = open ? 'Nu bereikbaar' : 'Nu gesloten';
  document.querySelector('[data-nu-stip]')?.classList.replace('bg-papier-3', open ? 'bg-[#1a7f4b]' : 'bg-[#c2410c]');
  const st = document.querySelector('[data-status]'); if (st && open) st.textContent = tekst;

  // Offerte: bericht live opbouwen.
  const f = document.querySelector<HTMLFormElement>('[data-offerte]');
  const uit = document.querySelector('[data-o-tekst]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-o-knop]');
  const naamUit = document.querySelector('[data-o-naam]');
  const plaatsUit = document.querySelector('[data-o-plaats]');
  function bouw() {
    if (!f || !uit || !knop) return;
    const d = new FormData(f);
    const soort = d.getAll('soort').join(', ');
    const aantal = d.get('aantal') as string | null;
    const mat = d.get('materiaal') as string | null;
    const plaats = ((d.get('plaats') as string) || '').trim();
    const naam = ((d.get('naam') as string) || '').trim();
    const r = ['Hallo Kozijn-Adviseur, ik wil graag een offerte.'];
    if (soort) r.push(`Soort: ${soort}`);
    if (aantal) r.push(`Aantal kozijnen: ${aantal}`);
    if (mat) r.push(`Materiaal: ${mat}`);
    if (plaats) r.push(`Plaats: ${plaats}`);
    if (naam) r.push(`Groet, ${naam}`);
    const s = r.join('\n');
    uit.textContent = s;
    knop.href = `${site.wa}?text=${encodeURIComponent(s)}`;
    if (naamUit) naamUit.textContent = naam || 'U';
    if (plaatsUit) plaatsUit.textContent = plaats || 'Plaats nog leeg';
  }
  f?.addEventListener('input', bouw);
  f?.addEventListener('change', bouw);
  f?.addEventListener('submit', (e) => e.preventDefault());
  bouw();

  // Productkaart kiest alvast de juiste soort.
  document.querySelectorAll<HTMLAnchorElement>('[data-kies]').forEach((a) => a.addEventListener('click', () => {
    const i = f?.querySelector<HTMLInputElement>(`input[name="soort"][value="${a.dataset.kies}"]`);
    if (i && !i.checked) { i.checked = true; bouw(); }
  }));
</script>
