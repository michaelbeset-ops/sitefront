---
// Woordmerk naar hun logo: KOZIJN in blauw, ADVISEUR in de tekstkleur, met het kozijn in perspectief eromheen.
import { url } from '../data/site';
interface Props { donker?: boolean; class?: string }
const { donker = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['group relative inline-flex items-center no-underline', cls]} aria-label="Kozijn-Adviseur, naar de homepage">
  <span class:list={['relative z-10 font-kop text-[1.65rem] font-bold leading-none tracking-[-.01em] md:text-[1.9rem]', donker ? 'text-inkt' : 'text-wit']}>
    <span class={donker ? 'text-merk' : 'text-merk-licht'}>KOZIJN</span>ADVISEUR
  </span>
  <svg viewBox="0 0 60 80" class:list={['-ml-[1.15rem] h-[3.1rem] w-auto md:h-[3.5rem]', donker ? 'text-merk' : 'text-merk-licht']} fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="miter" aria-hidden="true">
    <path d="M6 22V12L56 2v76L6 68V58" />
  </svg>
</a>
