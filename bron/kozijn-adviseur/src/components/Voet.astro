---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const producten = ['Kunststof kozijnen', 'Aluminium kozijnen', 'Schuifpuien', 'Deuren'];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Dé specialist in kunststof kozijnen. Meer dan 30 jaar ervaring in de branche.</p>
      <a href={site.telHref} class="knop knop-merk num mt-7 min-h-12 px-5"><Icoon naam="tel" />{site.tel}</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Producten</p>
      <ul class="mt-5 space-y-2.5">
        {producten.map((t) => <li><a href={h('producten')} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
        <li><a href={h('offerte')} class="no-underline transition-colors hover:text-merk-licht">Offerte aanvragen</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2.5">
        <li>{site.voluit}, {site.plaats}</li>
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-merk-licht">{site.mail}</a></li>
        <li><a href={waHoi} class="inline-flex items-center gap-2 no-underline hover:text-merk-licht"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Bereikbaar</p>
      <ul class="mt-5 space-y-2.5">
        <li>Ma t/m vr<br /><span class="num">9:00 tot 17:00</span></li>
        <li>Za en zo gesloten</li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.voluit}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Teksten en eigen foto's van jullie website kozijn-adviseur.nl. Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google en Trustoo (stand 15 oktober 2026).</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
