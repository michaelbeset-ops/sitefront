---
interface Props { label?: string; licht?: boolean; class?: string }
const { label = '', licht = false, class: cls = '' } = Astro.props;
---
<div class:list={['maat', licht && 'maat-licht', cls]} aria-hidden="true">{label ? <><span class="l l-a"></span><span class="num">{label}</span><span class="l l-b"></span></> : <span class="l l-a l-b"></span>}</div>
