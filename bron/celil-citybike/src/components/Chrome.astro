---
import { site, url } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="flex items-baseline gap-1.5 font-display text-2xl font-extrabold tracking-[-0.04em] text-gracht no-underline">Celil<span class="text-base font-semibold tracking-normal text-ink">CityBike</span></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm font-medium">
          <li><a href={`${url('')}#reparatie`} class="no-underline transition-colors hover:text-steen">Reparatie</a></li>
          <li><a href={`${url('')}#fietsen`} class="no-underline transition-colors hover:text-steen">Fietsen</a></li>
          <li><a href={`${url('')}#sleutel`} class="no-underline transition-colors hover:text-steen">Sleutel kwijt</a></li>
          <li><a href={`${url('')}#open`} class="no-underline transition-colors hover:text-steen">Openingstijden</a></li>
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a href={site.telHref} class="hidden text-sm font-semibold whitespace-nowrap tabular-nums no-underline hover:text-steen sm:inline">{site.tel}</a>
        <a href={site.whatsapp} class="btn btn-gracht !gap-2 !px-3.5 !py-2 !text-sm"><Icoon naam="whatsapp" /><span>WhatsApp</span></a>
      </div>
    </div>
  </header>
) : (
  <footer class="op-donker bg-ink pt-12 pb-8 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-xl font-extrabold text-white">{site.naam}</strong><br />Fietsenwinkel en reparatie in hartje Utrecht</p>
      <p class="md:col-span-4">{site.straat}<br />{site.postcode} {site.plaats}<br /><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a></p>
      <p class="md:col-span-3 md:text-right">KvK <span class="tabular-nums">{site.kvk}</span><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 text-xs text-white/75">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
