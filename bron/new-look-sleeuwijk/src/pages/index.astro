  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-sm); background: var(--color-lila); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #ddd3ea; }
  .keuze input:checked + span { background: var(--color-paars); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-paars); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-sm); border: 1.5px solid #16121c33; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #16121c66; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-paars); }
</style>
