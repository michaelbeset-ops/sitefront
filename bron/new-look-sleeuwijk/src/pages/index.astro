          <a href={waVraag} class="knop knop-wit"><Icoon naam="wa" />WhatsApp ons</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hoi New Look, ik wil graag langskomen.'];
      if (v('wat')) r.push('Voor: ' + v('wat').toLowerCase());
      if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
      if (v('aantal') && v('aantal') !== '1') r.push('Met ' + v('aantal') + ' personen');
      r.push(v('wanneer') === 'Een andere dag' ? 'Wanneer is het meestal rustig?' : 'Is het nu druk?');
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31681689451?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

