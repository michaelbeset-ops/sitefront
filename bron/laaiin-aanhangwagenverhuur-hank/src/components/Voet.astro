---
import { site, url, tijden, types, waVraag } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-asfalt text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht"><b>LAAIIN</b><small>aanhangwagens</small></a>
      <p class="mt-6 max-w-xs">Aanhangwagenverhuur en verkoop vanuit Hank. Meer dan 550 aanhangers bij tankstations en bouwmarkten door bijna heel Nederland.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-full bg-asfalt-2 text-licht transition-colors hover:bg-rood" aria-label="Facebook"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1Z"/></svg></a>
        <a href={waVraag} class="grid h-10 w-10 place-items-center rounded-full bg-asfalt-2 text-licht transition-colors hover:bg-rood" aria-label="WhatsApp"><Icoon naam="wa" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Aanhangers</p>
      <ul class="mt-4 space-y-2">
        {types.map((t) => <li><a href={h('reserveren')} class="no-underline transition-colors hover:text-sein">{t.naam}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-sein">{site.tel}</a></li>
        <li><a href={site.kantoorHref} class="num whitespace-nowrap no-underline transition-colors hover:text-sein">{site.kantoor}</a></li>
        <li><a href={`mailto:${site.mail}`} class="no-underline transition-colors hover:text-sein">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Loods Hank</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Openingstijden loods Hank</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-sein">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam} v.o.f., {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-sein">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van de Facebook-pagina van Laaiin Aanhangwagens. Tarieven, types en locaties van laaiin.nl, reviews letterlijk van Google (stand 5 oktober 2026).</p>}
  </div>
</footer>
