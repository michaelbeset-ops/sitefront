---
// Nagetekend naar hun logo (bron/site-img/logo-full.png): twee puntdaken met een rond raampje, staalblauw, en daaronder
// "DE HORRENSPECIALIST" in kapitalen. Hier als woordmerk met BSR erbij, zoals op Google en Instagram.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex min-w-0 items-center gap-2.5 leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <svg viewBox="0 0 64 40" class="h-8 w-[3.2rem] flex-none min-[380px]:h-10 min-[380px]:w-16 sm:h-11 sm:w-[4.4rem]" aria-hidden="true">
    <defs><linearGradient id="dak" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={donker ? '#2c4a6b' : '#b9d4ee'} /><stop offset="1" stop-color={donker ? '#5a7fa6' : '#6f98c2'} /></linearGradient></defs>
    <path d="M2 38 19 8l17 30h-6L19 18 8 38Z" fill="url(#dak)" />
    <path d="M28 38 45 6l17 32h-6L45 16 34 38Z" fill="url(#dak)" />
    <path d="M19 8 45 6l-6 10-20 2Z" fill="url(#dak)" opacity=".75" />
    <path d="M15.5 33v-4.2a3.5 3.5 0 0 1 7 0V33ZM41.5 31v-4.2a3.5 3.5 0 0 1 7 0V31Z" fill="url(#dak)" />
  </svg>
  <span class="flex flex-col" style="font-family: var(--font-kop)">
    <span class="text-[1.02rem] font-[900] uppercase tracking-[.01em] min-[380px]:text-[1.2rem] sm:text-[1.4rem]">Horrenspecialist</span>
    <span class={`mt-1 text-[.72rem] font-[800] uppercase tracking-[.3em] sm:text-[.8rem] ${donker ? 'text-merk' : 'text-merk-licht'}`}>BSR · {`Tilburg`}</span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>

