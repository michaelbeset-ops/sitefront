---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, tijden, tijdTekst, waHoi } from '../data/site';

// Eigen foto's (site, Instagram, Google-profiel) en één sfeerfoto van Unsplash. Zie src/assets/BRONNEN.txt.
import sHero from '../assets/s-hero.jpg';
import eRaam from '../assets/e-raam.jpg';
import eDubbeldeur from '../assets/e-dubbeldeur.jpg';
import eRolluik from '../assets/e-rolluik.jpg';
import ePlisse from '../assets/e-plisse.jpg';
import eMontage from '../assets/e-montage.jpg';
import eVeranda from '../assets/e-veranda.jpg';
import eAvond from '../assets/e-avond.jpg';
import eGevel from '../assets/e-gevel.jpg';
import ePui from '../assets/e-pui.jpg';
import eDakraam from '../assets/e-dakraam.jpg';
import eSchuifpui from '../assets/e-schuifpui.jpg';
import eRaam2 from '../assets/e-raam2.jpg';

// Teksten uit hun eigen site (Home, Assortiment, Over ons) en Instagram-posts.
const aanbod = [
  { t: 'Raamhorren', d: 'Geschikt voor ieder soort raam, of het nou een wc-raam, zolderraam of schuifpui is.', l: ['Rolhor raam (vaste raamhor)', 'Plissé hor raam', 'Dubbele plissé hor raam', 'Inzethorren voor een dakraam of badkamerraam'], src: eRaam, pos: '50% 50%', alt: 'Plissé hor voor een draairaam, met uitzicht op de tuin' },
  { t: 'Hordeuren', d: 'Makkelijk te openen en sluiten. In ieder gewenst formaat en kleur.', l: ['Plissé hordeur', 'Dubbele plissé hordeur', 'Ook voor de schuifpui'], src: eDubbeldeur, pos: '50% 50%', alt: 'Witte plissé hordeur in een schuifpui' },
  { t: 'Rolluiken en screens', d: 'Zonwering screens zijn verkrijgbaar in diverse kleuren, manueel of elektrisch.', l: ['Rolluiken, 5 jaar garantie', 'Zonwering screens, 5 jaar garantie', 'Manueel of elektrisch'], src: eRolluik, pos: '50% 35%', alt: 'Raam met een rolluikkast erboven en een hor ervoor' },
];
const soorten = ['Rolhor raam', 'Plissé hor raam', 'Dubbele plissé hor raam', 'Plissé hordeur', 'Dubbele plissé hordeur', 'Rolluiken', 'Zonwering screens'];

const kleuren = [['Wit', '#f4f4f1'], ['Bruin', '#4a3427'], ['Antraciet', '#373b40'], ['Grijs', '#8d9399']];

const werk = [
  { src: eVeranda, alt: 'Plissé hordeur in een veranda', t: 'Plisséhorren in de veranda', c: 'col-span-2 lg:row-span-2', a: 'aspect-[4/3] lg:aspect-auto lg:h-full' },
  { src: eAvond, alt: 'Plissé hor voor een schuifpui, ’s avonds met licht binnen', t: 'Schuifpui, ’s avonds', c: '', a: 'aspect-[3/4]' },
  { src: eDakraam, alt: 'Hor in een dakraam, van binnen gezien', t: 'Dakraam', c: '', a: 'aspect-[3/4]' },
  { src: eGevel, alt: 'Rij plissé horren voor de ramen boven een pannendak', t: 'Rij raamhorren', c: '', a: 'aspect-[3/4]' },
  { src: ePui, alt: 'Plissé hor voor een glazen pui', t: 'Pui', c: '', a: 'aspect-[3/4]' },
  { src: eSchuifpui, alt: 'Plissé hor in een schuifpui naar de overkapping', t: 'Schuifpui met overkapping', c: '', a: 'aspect-[3/4]' },
  { src: eRaam2, alt: 'Raamhor in een groot raam met uitzicht op een grasveld', t: 'Raamhor', c: '', a: 'aspect-[3/4]' },
];

// Hun eigen "Proces" van de Assortiment-pagina, per stap.
const stappen = [
  ['Aanvraag', 'Wij reageren doorgaans binnen 24 uur op uw aanvraag.'],
  ['Inmeten aan huis', 'Binnen één week plannen we een vrijblijvende inmeetafspraak bij u thuis.'],
  ['Scherpe offerte', 'Op basis van het inmeten krijgt u binnen één dag een offerte.'],
  ['Productie op maat', 'Gaat u akkoord, dan is de levertijd 3 à 4 weken.'],
  ['Montage', 'Zodra alles klaar is, plannen we binnen één week een kosteloze montageafspraak.'],
];

const typen = [
  ['rolhor', 'Rolhor raam'],
  ['plisse-raam', 'Plissé hor raam'],
  ['dubbel-raam', 'Dubbele plissé hor raam'],
  ['plisse-deur', 'Plissé hordeur'],
  ['dubbel-deur', 'Dubbele plissé hordeur'],
  ['rolluik', 'Rolluik'],
  ['screen', 'Zonwering screen'],
  ['weet-niet', 'Weet ik nog niet'],
];

const sterren = [1, 2, 3, 4, 5];
---
<Base title="Horrenspecialist BSR | Horren en hordeuren op maat in Tilburg" description="Raamhorren, plissé hordeuren, rolluiken en screens op maat, van gepoedercoated aluminium. Kosteloos inmeten aan huis. 5,0 op Google. Bel 06 40 86 76 82.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: sfeerfoto (licht door vitrage), met rechts een plissé hor die bij het laden dichtschuift -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={sHero} alt="" widths={[640, 960, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" quality={66} class="absolute inset-0 -z-30 h-full w-full object-cover object-[78%_50%] md:object-[70%_50%]" />
      <div class="absolute inset-0 -z-20 bg-[linear-gradient(180deg,#0d1b2ab3_0%,#0d1b2a40_30%,#0d1b2ad0_60%,#0d1b2af7_100%)] md:bg-[linear-gradient(90deg,#0d1b2af5_0%,#0d1b2ad9_36%,#0d1b2a59_64%,#0d1b2a1a_100%),linear-gradient(180deg,#0d1b2aa6_0%,#0d1b2a00_30%,#0d1b2a00_74%,#0d1b2a99_100%)]" aria-hidden="true"></div>
      <div class="hor-dicht absolute inset-y-0 right-0 -z-10 hidden w-[24%] md:flex" aria-hidden="true">
        <div class="profiel w-2.5 shadow-[-10px_0_30px_#0008]"></div>
        <div class="hor-gaas flex-1"></div>
      </div>

      <div class="wrap w-full pb-28 pt-36 md:pb-16 lg:pt-44">
        <div class="max-w-[50rem]">
          <p class="eyebrow eyebrow-licht">Horren op maat · {site.plaats}</p>
          <h1 id="inhoud" class="mt-5 text-hero">Ramen open. Kleine bezoekers <span class="text-merk-licht">buiten.</span></h1>
          <p class="mt-7 max-w-xl text-xl leading-relaxed text-wit md:text-[1.4375rem]">De Horrenspecialist maakt kwalitatieve horren op maat, voor een scherpe prijs. Wij komen vrijblijvend aan huis voor een inmeetafspraak.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#aanvraag" class="knop knop-merk"><Icoon naam="meet" />Hor aanvragen</a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />Bel {site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-3 text-[1.0625rem] text-wit">
            <li class="flex items-center gap-2"><span class="flex text-[#f5c451]" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="huis" class="h-5 w-5 text-merk-licht" />Kosteloos inmeten aan huis</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-5 w-5 text-merk-licht" />Ma t/m vr {tijdTekst(tijden[0].open!)}</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- 2. Wat we maken + echte cijfers -->
    <section class="bg-wit py-20 md:py-24" aria-labelledby="t-intro">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <p class="rijs eyebrow">Horrenspecialist BSR</p>
          <h2 id="t-intro" class="rijs mt-4 text-3xl">Zomers het raam open, zonder muggen en vliegen.</h2>
          <p class="rijs mt-6 max-w-xl text-lg leading-relaxed text-steen" style="--d:.05s">'s Zomers het raam openzetten voor frisse lucht is heerlijk, maar maakt het voor insecten ook buitengewoon makkelijk om binnen te komen. Een hor tegen muggen en vliegen biedt de uitkomst.</p>
          <ul class="rijs mt-8 flex flex-wrap gap-2.5" style="--d:.1s" aria-label="Wat we maken">
            {soorten.map((s) => <li class="chip">{s}</li>)}
          </ul>
        </div>
        <dl class="grid grid-cols-2 gap-px self-center overflow-hidden rounded-[10px] border border-lijn-licht bg-lijn-licht lg:col-span-6">
          {[
            [site.google.score, `op Google, ${site.google.aantal} reviews`],
            ['2 jaar', 'garantie op onze horren'],
            ['5 jaar', 'garantie op rolluiken en screens'],
            ['3 à 4', 'weken levertijd na akkoord'],
          ].map(([w, t], i) => (
            <div class="rijs bg-alu px-5 py-7 sm:px-8 sm:py-9" style={`--d:${i * 0.05}s`}>
              <dt class="sr-only">{t}</dt>
              <dd class="num font-[900] text-[clamp(2.2rem,3vw+1rem,3.4rem)] leading-none tracking-[-.04em] text-merk" style="font-family: var(--font-kop)">{w}</dd>
              <dd class="mt-3 text-[1.0625rem] leading-snug text-steen">{t}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 3. Aanbod: fotokaarten met eigen foto's -->
    <section id="horren" class="py-20 md:py-28" aria-labelledby="t-horren">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Assortiment</p>
            <h2 id="t-horren" class="mt-4 text-4xl">Voor ieder raam en iedere deur.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-4 lg:col-start-9" style="--d:.05s">Wij leveren aluminium horren voor uw raam of deur in ieder gewenst formaat, binnenshuis of buitenshuis gemonteerd.</p>
        </div>
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-16 lg:grid-cols-3">
          {aanbod.map((v, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden">
                <div class="relative overflow-hidden">
                  <Image src={v.src} alt={v.alt} widths={[420, 640, 860]} sizes="(min-width: 1024px) 400px, (min-width: 768px) 46vw, 100vw" quality={70} class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${v.pos}`} />
                  <div class="profiel absolute inset-x-0 bottom-0 h-1.5" aria-hidden="true"></div>
                </div>
                <div class="flex flex-1 flex-col p-7 sm:p-8">
                  <h3 class="text-[1.9rem]">{v.t}</h3>
                  <p class="mt-3 text-lg text-steen">{v.d}</p>
                  <ul class="mt-6 space-y-2.5 border-t border-lijn-licht pt-6">
                    {v.l.map((x) => <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk" />{x}</li>)}
                  </ul>
                  <a href="#aanvraag" class="mt-auto inline-flex items-center gap-2 pt-8 text-lg font-extrabold text-merk no-underline transition-colors hover:text-merk-diep" style="font-family: var(--font-kop)">Aanvragen<Icoon naam="pijl" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Vakwerk: materiaal, kleuren, eigen team (donker) -->
    <section id="over" class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-over">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs grid grid-cols-5 gap-4 lg:col-span-6">
          <Image src={eMontage} alt="Monteur in een shirt van De Horrenspecialist schroeft een hor vast aan een raam" widths={[500, 800, 1100]} sizes="(min-width: 1024px) 30vw, 60vw" quality={70} class="col-span-3 aspect-[3/4] h-full w-full rounded-[10px] object-cover object-[60%_40%]" />
          <div class="col-span-2 flex flex-col gap-4">
            <Image src={ePlisse} alt="Close-up van de vouwen van een plissé hor" widths={[300, 600]} sizes="(min-width: 1024px) 20vw, 40vw" quality={72} class="aspect-[3/4] w-full flex-1 rounded-[10px] object-cover" />
            <div class="rounded-[10px] bg-merk p-4 sm:p-5">
              <p class="num text-[clamp(1.7rem,2vw+1rem,2.6rem)] font-[900] leading-none tracking-[-.04em]" style="font-family: var(--font-kop)">2 jaar</p>
              <p class="mt-2 text-[1rem] font-semibold leading-snug text-wit/90">garantie op de horren</p>
            </div>
          </div>
          <figcaption class="col-span-5 text-[.9375rem] text-mist">Eigen foto's van Instagram @horrenspecialist.</figcaption>
        </figure>
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Vakwerk</p>
          <h2 id="t-over" class="rijs mt-4 text-4xl">Gepoedercoated aluminium, volledig geschroefd.</h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-wit/90" style="--d:.06s">Onze horren worden gemaakt van hoogwaardig gepoedercoated aluminium. Het inmeten, de montage en reparatie wordt door ons eigen team uitgevoerd.</p>
          <div class="rijs mt-9" style="--d:.1s">
            <p class="font-bold">Standaard in vier kleuren</p>
            <ul class="mt-4 flex flex-wrap gap-3.5" aria-label="Kleuren">
              {kleuren.map(([n, c]) => (
                <li class="flex flex-col items-center gap-2 text-[.9375rem] text-mist"><span class="h-12 w-12 rounded-[8px] border border-lijn" style={`background:${c}`}></span>{n}</li>
              ))}
              <li class="flex flex-col items-center gap-2 text-[.9375rem] text-mist"><span class="h-12 w-12 rounded-[8px] border border-lijn bg-[conic-gradient(#c94f3d,#e0b13c,#5d9c59,#3b78b5,#8a5aa8,#c94f3d)]"></span>In overleg</li>
            </ul>
          </div>
          <ul class="rijs mt-10 grid gap-3 sm:grid-cols-2" style="--d:.14s">
            {[
              ['Binnen of buiten', 'Te monteren binnenshuis en buitenshuis.'],
              ['Op maat gemaakt', 'In ieder gewenst formaat en kleur.'],
              ['Rolluiken en screens', '5 jaar garantie, manueel of elektrisch.'],
              ['Aan huis', 'Kosteloos inmeten en monteren.'],
            ].map(([t, d]) => (
              <li class="flex gap-4 rounded-[10px] border border-lijn bg-inkt-2 px-5 py-5">
                <span class="grid h-10 w-10 flex-none place-items-center rounded-[8px] bg-merk"><Icoon naam="vink" class="h-5 w-5" /></span>
                <span><b class="block text-lg">{t}</b><span class="text-mist">{d}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 5. Ons werk: eigen foto's -->
    <section id="werk" class="bg-wit py-20 md:py-28" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Ons werk</p>
            <h2 id="t-werk" class="mt-4 text-4xl">Geplaatst bij klanten thuis.</h2>
          </div>
          <a href={site.insta} class="rijs inline-flex items-center gap-2 self-start text-lg font-extrabold text-merk no-underline hover:text-merk-diep lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="font-family: var(--font-kop)"><Icoon naam="insta" class="h-6 w-6" />Meer op Instagram</a>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-14 lg:grid-cols-4">
          {werk.map((w, i) => (
            <li class={`rijs group relative overflow-hidden rounded-[10px] ${w.c}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={[360, 560, 900]} sizes={i === 0 ? '(min-width: 1024px) 50vw, 50vw' : '(min-width: 1024px) 25vw, 50vw'} quality={68} class={`w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] ${w.a}`} />
              <p class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#0d1b2ad9,#0d1b2a00)] px-4 pb-3 pt-10 text-[1rem] font-bold text-wit sm:text-[1.0625rem]">{w.t}</p>
            </li>
          ))}
          <li class="rijs col-span-2 flex flex-col justify-between gap-6 rounded-[10px] bg-alu p-6 sm:p-8 lg:col-span-2" style="--d:.1s">
            <p class="text-[clamp(1.4rem,1.2vw+1rem,1.9rem)] font-[900] leading-tight tracking-[-.02em]" style="font-family: var(--font-kop)">Ook een hor voor de hele woning? Plan vrijblijvend een inmeetafspraak.</p>
            <a href="#aanvraag" class="knop knop-merk self-start"><Icoon naam="meet" />Hor aanvragen</a>
          </li>
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze: hun eigen proces -->
    <section id="werkwijze" class="py-20 md:py-28" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="rijs max-w-2xl">
          <p class="eyebrow">Werkwijze</p>
          <h2 id="t-stappen" class="mt-4 text-4xl">Van aanvraag tot montage.</h2>
        </div>
        <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative flex flex-col overflow-hidden p-7" style={`--d:${i * 0.05}s`}>
              <span class="stap-nr num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-5 text-[1.5rem]">{t}</h3>
              <p class="mt-3 text-[1.0625rem] text-steen">{d}</p>
              <div class="plisse-licht absolute inset-x-0 top-0 h-1.5 bg-merk" aria-hidden="true"></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Een stem uit de reviews -->
    <section class="relative overflow-hidden bg-merk text-wit" aria-label="Uit een review">
      <div class="plisse-licht absolute inset-y-0 right-0 hidden w-1/4 opacity-60 md:block" aria-hidden="true"></div>
      <figure class="wrap relative py-20 md:py-24">
        <blockquote class="rijs max-w-4xl text-[clamp(1.9rem,3vw+.9rem,3.6rem)] font-[900] leading-[1.08] tracking-[-.025em]" style="font-family: var(--font-kop)">“In een woord geweldig! Meer dan 5 sterren. Kwaliteit, komt afspraken na.”</blockquote>
        <figcaption class="rijs mt-7 text-lg text-wit/90" style="--d:.08s">Y. M. · Google review</figcaption>
      </figure>
    </section>

    <!-- 8. Wow: hor-aanvraag met live tekening -> vooraf ingevuld WhatsApp -->
    <section id="aanvraag" class="bg-alu-2 py-20 md:py-28" aria-labelledby="t-aanvraag">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Hor aanvragen</p>
            <h2 id="t-aanvraag" class="mt-4 text-4xl">Stel uw hor samen.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:self-end" style="--d:.1s">Kies wat u zoekt. U ziet meteen de tekening en het bericht; versturen doet u zelf in WhatsApp. Het precieze inmeten doen wij bij u thuis.</p>
        </div>

        <form class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-8 lg:mt-14 lg:grid-cols-12" data-aanvraag>
          <div class="kaart min-w-0 space-y-9 p-5 sm:p-9 lg:col-span-7">
            <fieldset>
              <legend class="veld-label"><span class="text-merk">1.</span> Wat zoekt u?</legend>
              <div class="grid gap-2.5 sm:grid-cols-2">
                {typen.map(([v, t], i) => <label class="keuze"><input type="radio" name="type" value={v} data-label={t} checked={i === 3} />{t}</label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label"><span class="text-merk">2.</span> Welke kleur?</legend>
              <div class="flex flex-wrap gap-x-3 gap-y-4">
                {kleuren.map(([n, c], i) => <label class="kleur"><input type="radio" name="kleur" value={n.toLowerCase()} data-hex={c} checked={i === 2} /><span class="staal" style={`background:${c}`}></span>{n}</label>)}
                <label class="kleur"><input type="radio" name="kleur" value="een andere kleur (in overleg)" data-hex="#6f98c2" /><span class="staal bg-[conic-gradient(#c94f3d,#e0b13c,#5d9c59,#3b78b5,#8a5aa8,#c94f3d)]"></span>Andere</label>
              </div>
            </fieldset>
            <div class="grid gap-9 sm:grid-cols-2">
              <div>
                <span class="veld-label" id="l-aantal"><span class="text-merk">3.</span> Hoeveel?</span>
                <div class="flex items-center gap-2" role="group" aria-labelledby="l-aantal">
                  <button type="button" class="knop knop-rand !h-[3.6rem] !w-[3.6rem] !p-0 text-2xl" data-min aria-label="Een minder">−</button>
                  <input id="aantal" name="aantal" type="number" min="1" max="30" value="1" inputmode="numeric" class="veld num !w-20 text-center text-xl font-bold" aria-label="Aantal" />
                  <button type="button" class="knop knop-rand !h-[3.6rem] !w-[3.6rem] !p-0 text-2xl" data-plus aria-label="Een meer">+</button>
                </div>
              </div>
              <div>
                <span class="veld-label" id="l-maat"><span class="text-merk">4.</span> Maat ongeveer <span class="font-normal text-steen">(mag leeg)</span></span>
                <div class="flex items-center gap-2" role="group" aria-labelledby="l-maat">
                  <input name="breed" type="number" min="20" max="600" inputmode="numeric" class="veld num min-w-0 text-center" placeholder="breed" aria-label="Breedte in centimeter" />
                  <span class="text-steen" aria-hidden="true">×</span>
                  <input name="hoog" type="number" min="20" max="400" inputmode="numeric" class="veld num min-w-0 text-center" placeholder="hoog" aria-label="Hoogte in centimeter" />
                  <span class="text-steen">cm</span>
                </div>
              </div>
            </div>
            <div class="grid gap-9 sm:grid-cols-2">
              <div>
                <label for="plaats" class="veld-label"><span class="text-merk">5.</span> Uw woonplaats</label>
                <input id="plaats" name="plaats" class="veld" autocomplete="address-level2" placeholder="Bijvoorbeeld Tilburg" />
              </div>
              <div>
                <label for="naam" class="veld-label">Uw naam <span class="font-normal text-steen">(mag leeg)</span></label>
                <input id="naam" name="naam" class="veld" autocomplete="name" />
              </div>
            </div>
          </div>

          <div class="min-w-0 lg:col-span-5">
            <div class="sticky top-6 rounded-[10px] bg-inkt p-6 text-wit sm:p-8">
              <div class="flex items-end justify-center rounded-[8px] bg-[linear-gradient(180deg,#eef2f5,#cfd8e1)] px-4 pb-4 pt-6">
                <svg viewBox="0 0 220 200" class="h-48 w-full max-w-[17rem] sm:h-56" role="img" aria-label="Tekening van uw keuze" data-tekening></svg>
              </div>
              <p class="mt-3 text-center text-[.9375rem] text-mist" data-onderschrift>Plissé hordeur, antraciet</p>
              <p class="mt-6 text-lg font-bold text-mist">Uw bericht</p>
              <p class="mt-3 min-h-[8rem] whitespace-pre-line rounded-[8px] bg-inkt-2 px-5 py-5 text-[1.0625rem] leading-relaxed" data-voorbeeld aria-live="polite"></p>
              <a href={waHoi} class="knop knop-groen mt-6 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <div class="mt-7 border-t border-lijn pt-6">
                <p class="text-mist">Of bel direct:</p>
                <a href={site.telHref} class="num mt-1 block text-[clamp(1.9rem,3vw+1rem,2.6rem)] font-[900] leading-tight text-wit no-underline hover:text-merk-licht" style="font-family: var(--font-kop)">{site.tel}</a>
              </div>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 9. Reviews -->
    <section class="py-20 md:py-28" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-4 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-6 py-5 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-10 w-10 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num text-3xl font-[900] leading-none text-inkt" style="font-family: var(--font-kop)">{site.google.score}</b><span class="flex text-[#e3a008]" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span></span>
              <span class="mt-1 block text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-14 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="kaart flex h-full flex-col p-8">
                <div class="flex gap-0.5 text-[#e3a008]" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</div>
                <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5">
                  <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-alu-2 text-lg font-bold">{r.naam[0]}</span>
                  <span><b class="block">{r.naam}</b><span class="text-[1rem] text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 10. Contact en tijden -->
    <section id="contact" class="border-t border-lijn-licht bg-wit py-20 md:py-28" aria-labelledby="t-contact">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Contact</p>
          <h2 id="t-contact" class="rijs mt-4 text-4xl">Benieuwd naar de mogelijkheden?</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-steen">Neem vrijblijvend contact op. Bel, app of mail; wij komen kosteloos aan huis voor een inmeetafspraak.</p>
          <p class="rijs mt-8"><a href={site.telHref} class="num text-[clamp(2.1rem,8.5vw,4.8rem)] font-[900] leading-none tracking-[-.03em] text-inkt no-underline transition-colors hover:text-merk" style="font-family: var(--font-kop)">{site.tel}</a></p>
          <div class="rijs mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--d:.1s">
            <a href={site.telHref} class="knop knop-merk"><Icoon naam="tel" />Bellen</a>
            <a href={waHoi} class="knop knop-rand"><Icoon naam="wa" class="text-[#1a7f4b]" />WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="knop knop-rand !whitespace-normal break-all text-[1.0625rem]"><Icoon naam="mail" class="text-merk" />{site.mail}</a>
          </div>
        </div>
        <div class="rijs lg:col-span-5" style="--d:.15s">
          <div class="kaart overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-lijn-licht px-6 py-5">
              <p class="text-xl font-extrabold" style="font-family: var(--font-kop)">Openingstijden</p>
              <p class="flex items-center gap-2 text-[1rem] font-bold" data-status><span class="h-3 w-3 rounded-full bg-alu-3" data-stip></span><span data-status-tekst>Ma t/m za</span></p>
            </div>
            <table class="w-full text-[1.0625rem]">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr class="border-b border-lijn-licht last:border-0 data-[vandaag]:bg-[#eaf2fa] data-[vandaag]:font-extrabold" data-dag={t.nr} data-open={t.open ? t.open.join('-') : ''}>
                    <th scope="row" class="py-3.5 pl-5 pr-2 text-left font-[inherit] sm:px-6">{t.dag}</th>
                    <td class="num whitespace-nowrap py-3.5 pl-2 pr-5 text-right sm:px-6">{t.open ? tijdTekst(t.open) : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <ul class="divide-y divide-lijn-licht border-t border-lijn-licht">
              <li class="flex gap-4 p-6"><Icoon naam="pin" class="mt-1 h-6 w-6 flex-none text-merk" /><div><p class="font-extrabold">Gevestigd in {site.plaats}</p><p class="mt-1 text-steen">Wij komen bij u thuis om in te meten en te monteren.</p></div></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="relative overflow-hidden bg-inkt text-wit" aria-label="Hor aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center md:py-16">
        <p class="text-[clamp(1.9rem,2.4vw+1rem,3rem)] font-[900] leading-none tracking-[-.03em]" style="font-family: var(--font-kop)">Geniet met de ramen <span class="text-merk-licht">open.</span></p>
        <a href="#aanvraag" class="knop knop-merk shrink-0"><Icoon naam="meet" />Hor aanvragen</a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  // Hor-aanvraag -> tekening + vooraf ingevuld WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const svg = document.querySelector<SVGSVGElement>('[data-tekening]');
  const onder = document.querySelector<HTMLElement>('[data-onderschrift]');
  const aantal = document.querySelector<HTMLInputElement>('#aantal');

  // Tekent de gekozen hor in de gekozen kleur: kozijn, profiel en het plissé of gaas.
  const teken = (type: string, kleur: string) => {
    const deur = type.includes('deur') || type === 'screen';
    const w = deur ? 120 : 150, h = deur ? 190 : 130, x = (220 - w) / 2, y = 200 - h - 4;
    const p: string[] = [`<rect x="${x - 8}" y="${y - 8}" width="${w + 16}" height="${h + 12}" rx="3" fill="none" stroke="#7f8d9b" stroke-width="2" opacity=".6"/>`];
    const vouwen = (x0: number, w0: number, dicht: number) => { let s = ''; for (let i = 0; i < w0 * dicht; i += 5) s += `<line x1="${x0 + i}" y1="${y + 4}" x2="${x0 + i}" y2="${y + h - 4}" stroke="${i % 10 ? '#ffffff55' : '#00000055'}" stroke-width="1"/>`; return s; };
    if (type === 'rolluik') {
      p.push(`<rect x="${x}" y="${y}" width="${w}" height="18" rx="2" fill="${kleur}"/>`);
      for (let yy = y + 20; yy < y + h * .8; yy += 9) p.push(`<rect x="${x + 2}" y="${yy}" width="${w - 4}" height="7" rx="1" fill="${kleur}" opacity=".92"/>`);
    } else if (type === 'screen') {
      p.push(`<rect x="${x}" y="${y}" width="${w}" height="16" rx="2" fill="${kleur}"/><rect x="${x + 4}" y="${y + 16}" width="${w - 8}" height="${h * .7}" fill="#3a4d61"/><rect x="${x + 4}" y="${y + 16}" width="${w - 8}" height="${h * .7}" fill="url(#gaas)"/><rect x="${x + 2}" y="${y + 16 + h * .7}" width="${w - 4}" height="6" rx="1" fill="${kleur}"/>`);
    } else if (type === 'weet-niet') {
      p.push(`<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="2" fill="none" stroke="${kleur}" stroke-width="6"/><text x="110" y="${y + h / 2 + 14}" text-anchor="middle" font-size="44" font-weight="900" fill="#2b5d8c" font-family="Red Hat Display Variable, sans-serif">?</text>`);
    } else if (type === 'rolhor') {
      p.push(`<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="#2a3e53"/><rect x="${x}" y="${y}" width="${w}" height="${h}" fill="url(#gaas)"/><rect x="${x}" y="${y}" width="${w}" height="12" rx="2" fill="${kleur}"/><rect x="${x}" y="${y + h - 6}" width="${w}" height="6" fill="${kleur}"/><rect x="${x}" y="${y}" width="5" height="${h}" fill="${kleur}"/><rect x="${x + w - 5}" y="${y}" width="5" height="${h}" fill="${kleur}"/>`);
    } else {
      const dubbel = type.startsWith('dubbel');
      p.push(`<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="#2a3e53"/>`);
      if (dubbel) { p.push(`<rect x="${x}" y="${y}" width="${w / 2 - 3}" height="${h}" fill="url(#gaas)"/><rect x="${x + w / 2 + 3}" y="${y}" width="${w / 2 - 3}" height="${h}" fill="url(#gaas)"/>`); p.push(vouwen(x + 4, w / 2 - 8, 1), vouwen(x + w / 2 + 4, w / 2 - 8, 1)); p.push(`<rect x="${x + w / 2 - 3}" y="${y}" width="6" height="${h}" fill="${kleur}"/>`); }
      else { p.push(`<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="url(#gaas)"/>`, vouwen(x + 4, w - 8, 1)); }
      p.push(`<rect x="${x}" y="${y}" width="${w}" height="6" fill="${kleur}"/><rect x="${x}" y="${y + h - 6}" width="${w}" height="6" fill="${kleur}"/><rect x="${x}" y="${y}" width="6" height="${h}" fill="${kleur}"/><rect x="${x + w - 6}" y="${y}" width="6" height="${h}" fill="${kleur}"/>`);
      if (type.includes('deur')) p.push(`<rect x="${dubbel ? x + w / 2 - 10 : x + w - 16}" y="${y + h / 2 - 12}" width="4" height="24" rx="2" fill="#cfd8e1"/>${dubbel ? `<rect x="${x + w / 2 + 6}" y="${y + h / 2 - 12}" width="4" height="24" rx="2" fill="#cfd8e1"/>` : ''}`);
    }
    return `<defs><pattern id="gaas" width="3" height="3" patternUnits="userSpaceOnUse"><path d="M0 0h3M0 0v3" stroke="#ffffff22" stroke-width=".6"/></pattern></defs>` + p.join('');
  };

  if (f && vb && knop && svg && onder && aantal) {
    const zet = () => {
      const d = new FormData(f);
      const typeIn = f.querySelector<HTMLInputElement>('input[name=type]:checked');
      const kleurIn = f.querySelector<HTMLInputElement>('input[name=kleur]:checked');
      const type = typeIn?.value || 'weet-niet';
      const label = typeIn?.dataset.label || 'hor';
      const kleur = String(d.get('kleur') || '');
      const n = Math.max(1, Math.min(30, Number(d.get('aantal')) || 1));
      const breed = String(d.get('breed') || '').trim(), hoog = String(d.get('hoog') || '').trim();
      const plaats = String(d.get('plaats') || '').trim(), naam = String(d.get('naam') || '').trim();
      svg.innerHTML = teken(type, kleurIn?.dataset.hex || '#373b40');
      const kleurKort = kleur.startsWith('een andere') ? 'andere kleur' : kleur;
      onder.textContent = `${n > 1 ? n + ' x ' : ''}${label}, ${kleurKort}${breed && hoog ? `, ca. ${breed} x ${hoog} cm` : ''}`;
      const r = type === 'weet-niet'
        ? ['Hallo Horrenspecialist BSR, ik wil graag advies over horren en een inmeetafspraak.']
        : [`Hallo Horrenspecialist BSR, ik heb interesse in ${n > 1 ? n + ' x ' : 'een '}${label.toLowerCase()}, in ${kleur}.`];
      if (breed && hoog) r.push(`Maat ongeveer ${breed} x ${hoog} cm (breed x hoog).`);
      r.push(plaats ? `Graag een inmeetafspraak in ${plaats}.` : 'Graag een inmeetafspraak.');
      if (naam) r.push(`Groet, ${naam}`);
      const t = r.join('\n');
      vb.textContent = t; knop.href = `${site.wa}?text=${encodeURIComponent(t)}`;
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    f.querySelector('[data-min]')?.addEventListener('click', () => { aantal.value = String(Math.max(1, (Number(aantal.value) || 1) - 1)); zet(); });
    f.querySelector('[data-plus]')?.addEventListener('click', () => { aantal.value = String(Math.min(30, (Number(aantal.value) || 1) + 1)); zet(); });
    zet();
  }

  // Vandaag in de tijdentabel + nu open.
  const nu = new Date(); const dag = nu.getDay(); const uur = nu.getHours() + nu.getMinutes() / 60;
  const rij = document.querySelector<HTMLElement>(`[data-dag="${dag}"]`); rij?.setAttribute('data-vandaag', '');
  const [van, tot] = (rij?.dataset.open || '').split('-').map(Number);
  const open = !!rij?.dataset.open && uur >= van && uur < tot;
  const st = document.querySelector('[data-status-tekst]'); const stip = document.querySelector<HTMLElement>('[data-stip]');
  if (st && stip) { st.textContent = open ? 'Nu open' : 'Nu gesloten'; stip.style.background = open ? '#1a7f4b' : '#b3261e'; }
</script>


