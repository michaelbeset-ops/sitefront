  .streep { position: relative; white-space: nowrap; }
  .streep::after { content: ""; position: absolute; left: -.04em; right: -.06em; bottom: .02em; height: .14em; background: var(--color-rood); z-index: -1; transform: skewX(-12deg); }
  .cijfer { font-family: var(--font-kop); font-size: clamp(2.75rem, 3vw + 1.5rem, 3.75rem); font-weight: 800; line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 .95rem; border-radius: var(--radius-sm); background: var(--color-steen); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #ddd5c9; }
  .keuze input:checked + span { background: var(--color-rood); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-rood); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-sm); border: 1.5px solid #19171633; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #19171666; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-rood); }
  .veld::placeholder { color: #7d756f; }
  .bericht { border-left: 3px solid var(--color-rood); padding-left: .9rem; }
</style>
