---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, diensten, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import buiten from '../assets/buiten.jpg';
import binnen from '../assets/binnen.jpg';
import glas from '../assets/glas.jpg';
import houtrot from '../assets/houtrot.jpg';
import wanden from '../assets/wanden.jpg';
import behang from '../assets/behang.jpg';
import huis from '../assets/huis.jpg';
import verf from '../assets/verf.jpg';
import eigenMuur from '../assets/eigen-muur-2.jpg';

const vraag = (b: string) => waMet(`Hallo Berry, ik wil graag een offerte voor ${b.toLowerCase()}.`);

const kaarten = [
  { t: 'Schilderwerk buiten', d: 'Kozijnen, deuren en gevels. Uw huis zomer- of winterklaar.', src: buiten, alt: 'Schilder op een ladder schildert een raamkozijn aan de buitenkant', pos: '50% 30%' },
  { t: 'Schilderwerk binnen', d: 'Plafonds sausen, muren latexen en vernieuwen.', src: binnen, alt: 'Een muur wordt met een roller lichtgeel geverfd', pos: '50% 40%' },
  { t: 'Glaszetten', d: 'Van enkel glas naar isolatieglas: besparen op energiekosten.', src: glas, alt: 'Wit houten raamkozijn met glas en uitzicht op bomen', pos: '50% 50%' },
  { t: 'Houtrotreparatie', d: 'Houtproblemen? Veel ervaring om u goed te adviseren.', src: houtrot, alt: 'Wit houten kozijn waarvan de verf afbladdert', pos: '50% 50%' },
  { t: 'Scheidingswanden', d: 'Geplaatst van metalstud of Gibo, klaar voor afwerking.', src: wanden, alt: 'Ruimte in aanbouw met metalen profielen en gipsplaten', pos: '50% 50%' },
  { t: 'Behangen', d: 'Net dat beetje meer effect of structuur op de muur.', src: behang, alt: 'Muur met lichtgestreept behang en een ingelijst schilderijtje', pos: '50% 45%' },
];

const extra = [
  { i: 'vuur', t: 'Brandvertragende coatings', d: 'Hierin is B.V.T. gespecialiseerd.' },
  { i: 'spaan', t: 'Stukadoorswerk', d: 'Wanden strak gezet, klaar voor verf of behang.' },
  { i: 'hamer', t: 'Klein timmerwerk', d: 'Een plint, een deur of een aftimmering.' },
];

const stappen = [
  ['Bel of app', 'Advies nodig? Bel Berry direct of stuur een appje, gerust met een foto van de klus.'],
  ['Samen kijken', 'Samen met u kijken we naar de wensen en eventuele mogelijkheden.'],
  ['Passende offerte', 'Vrijblijvend, passend bij uw financiële wensen, en we lichten hem toe.'],
  ['Strak afgewerkt', 'Eén aanspreekpunt voor het totale pakket. Het einddoel: een tevreden klant.'],
];

const keuzes = ['Buiten schilderen', 'Binnen schilderen', 'Glas', 'Houtrot', 'Behang', 'Stucwerk', 'Wanden', 'Timmerwerk', 'Brandvertragend'];
---
<Base title={`${site.naam} | Schilder in Oosterhout`} description="Schilder- en afwerkingsbedrijf van Berry van Tilburg in Oosterhout. Schilderwerk binnen en buiten, glaszetten, behang, houtrotreparatie en wanden. Kwaliteit hoeft niet duur te zijn.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="hero-foto absolute inset-0 -z-20 h-full w-full object-cover object-[70%_40%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#19171633_0%,#191716a6_45%,#191716f5_100%)] md:bg-[linear-gradient(90deg,#191716f5_0%,#191716c7_45%,#19171626_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-32 md:pb-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow"><span class="sm:hidden">Schilder in Oosterhout</span><span class="hidden sm:inline">Schilder- en glaswerk in Oosterhout</span></p>
          <h1 id="t-hero" class="mt-6 text-hero">Kwaliteit hoeft niet <span class="streep">duur</span> te zijn.</h1>
          <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Schilderwerk binnen en buiten, glaszetten, behang en houtrotreparatie. Met B.V.T. haalt u de juiste persoon in huis.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="knop knop-rood"><Icoon naam="doc" />Vraag een offerte aan</a>
            <a href="#diensten" class="knop knop-rand op-foto">Bekijk de diensten</a>
          </div>
          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-vonk" />Eigen bedrijf sinds 2006</li>
            <li class="flex items-center gap-2"><Icoon naam="pin" class="h-4 w-4 text-vonk" />{site.plaats} en omgeving</li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto max-w-[19rem] border-l-4 border-rood bg-nacht/80 p-7 backdrop-blur-md">
            <p class="text-sm font-semibold uppercase tracking-[.16em] text-vonk">Advies nodig?</p>
            <a href={site.telHref} class="num mt-3 block font-kop text-[2rem] font-extrabold leading-none tracking-[-0.02em] text-licht no-underline hover:text-vonk">{site.tel}</a>
            <p class="mt-4 text-[.9375rem] text-licht-zacht">Bel {site.voornaam} direct, of stuur een appje met een foto van de klus.</p>
            <a href={waOfferte} class="mt-5 inline-flex items-center gap-2 font-semibold text-licht no-underline hover:text-vonk"><Icoon naam="wa" class="h-5 w-5" />WhatsApp {site.voornaam}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-2 overflow-x-auto py-5 [scrollbar-width:none] lg:flex-wrap lg:justify-center lg:gap-x-5 lg:overflow-visible">
        {diensten.map((c, i) => <a href="#diensten" class="flex shrink-0 items-center gap-2 px-2 py-1 text-sm font-semibold no-underline transition-colors hover:text-rood"><span class="num font-kop text-xs font-extrabold text-rood">0{i + 1}</span>{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-28" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-5 text-3xl">Van klein timmerwerk tot strak gezette wanden.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Voor al het onderhoud aan uw huis of bedrijfspand. Klik op een vak en u stuurt {site.voornaam} meteen een appje.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {kaarten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[4/3]" style={`object-position:${b.pos}`} />
                  <span class="num absolute left-0 top-0 bg-rood px-3 py-1.5 font-kop text-sm font-extrabold text-wit">0{i + 1}</span>
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 border-t-[3px] border-transparent p-4 transition-colors group-hover:border-rood sm:p-6">
                  <div>
                    <h3 class="text-[1.0625rem] hyphens-auto sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center bg-steen text-rood transition-colors group-hover:bg-rood group-hover:text-wit sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-6 grid gap-3 sm:gap-5 md:grid-cols-3 lg:gap-6">
          {extra.map((e, i) => (
            <li class="rijs flex items-start gap-4 bg-steen p-5 sm:p-6" style={`--d:${i * 0.06}s`}>
              <span class="grid h-11 w-11 shrink-0 place-items-center bg-wit text-rood"><Icoon naam={e.i} class="h-5 w-5" /></span>
              <div><h3 class="text-lg">{e.t}</h3><p class="mt-1 text-[.9375rem] text-grijs">{e.d}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Eigen bedrijf sinds</dt><dd class="cijfer order-first">2006</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Jaar ervaring in het vak</dt><dd class="cijfer order-first">30</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Vakken onder één dak</dt><dd class="cijfer order-first">{diensten.length}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Score op Google</dt><dd class="cijfer order-first text-rood">{site.google.score}</dd></div>
      </dl>
    </section>

    <!-- 5. Glas -->
    <section id="glas" class="donker bg-nacht text-licht" aria-labelledby="t-glas">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:col-span-6">
          <Image src={huis} alt="Bakstenen woning met donkere houten kozijnen en een groene haag" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[45%_50%]" />
          <p class="absolute bottom-0 left-0 bg-rood px-5 py-2.5 text-sm font-semibold text-wit">Glas- &amp; schilderwerken</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Glas en kozijnen</p>
          <h2 id="t-glas" class="mt-5 text-3xl">Van enkel glas naar isolatieglas.</h2>
          <p class="mt-6 text-lg text-licht-zacht">B.V.T. is ook glaszetter. Vervangt u enkel glas door isolatieglas, dan bespaart u op energiekosten. Kozijn, glas en verf regelt u zo bij één vakman.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 bg-nacht-2 px-5 py-4"><span class="grid h-10 w-10 shrink-0 place-items-center bg-rood text-wit"><Icoon naam="raam" class="h-5 w-5" /></span><span><b class="block font-semibold text-licht">Isolatieglas in bestaande kozijnen</b><span class="text-[.9375rem] text-licht-zacht">Minder warmte die naar buiten weglekt.</span></span></li>
            <li class="flex items-center gap-4 bg-nacht-2 px-5 py-4"><span class="grid h-10 w-10 shrink-0 place-items-center bg-rood text-wit"><Icoon naam="blad" class="h-5 w-5" /></span><span><b class="block font-semibold text-licht">Houtrot eerst hersteld</b><span class="text-[.9375rem] text-licht-zacht">Een gezond kozijn voordat er geschilderd wordt.</span></span></li>
            <li class="flex items-center gap-4 bg-nacht-2 px-5 py-4"><span class="grid h-10 w-10 shrink-0 place-items-center bg-rood text-wit"><Icoon naam="kwast" class="h-5 w-5" /></span><span><b class="block font-semibold text-licht">Daarna in de verf</b><span class="text-[.9375rem] text-licht-zacht">Met A-merk verf, beschermd voor de winter.</span></span></li>
          </ul>
          <a href={waMet('Hallo Berry, ik wil graag enkel glas laten vervangen door isolatieglas. Kunt u een keer komen kijken?')} class="knop knop-rood mt-9"><Icoon naam="wa" />Vraag naar glas</a>
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-28" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Samen kijken naar uw wensen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">U gaat verhuizen of heeft tijdsdruk? Dan kijken we samen naar de planning, zodat u op tijd klaar bent.</p>
        </div>
        <ol class="stappen mt-12 grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-5 lg:mt-16 lg:grid-cols-4 lg:gap-0">
          {stappen.map(([t, d], i) => (
            <li class="rijs relative lg:pr-10" style={`--d:${i * 0.06}s`}>
              <p class="num flex items-center gap-3 font-kop text-[2.5rem] font-extrabold leading-none tracking-[-0.03em] text-rood">0{i + 1}<span class="hidden h-[3px] flex-1 bg-lijn lg:block" aria-hidden="true"></span></p>
              <h3 class="mt-6 text-[1.0625rem] hyphens-auto sm:text-xl">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over Berry -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
        <div class="relative lg:col-span-5">
          <Image src={verf} alt="Open blik witte verf met een kwast erop" widths={[600, 900, 1200]} sizes="(min-width: 1024px) 460px, 92vw" class="aspect-[4/5] w-full object-cover sm:aspect-[4/3] lg:aspect-[4/5]" />
          <figure class="absolute -bottom-6 right-4 w-[11.5rem] bg-kalk p-2 text-inkt shadow-md sm:right-6 sm:w-[13rem]">
            <Image src={eigenMuur} alt="Grijs geverfde buitenmuur met blauwe deuren, werk van B.V.T." widths={[300]} sizes="208px" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="px-1 pb-0.5 pt-2 text-xs font-semibold leading-snug">Uit eigen portfolio: muren latexen en verfraaien</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-7 lg:pt-4">
          <p class="eyebrow">Over B.V.T.</p>
          <h2 id="t-over" class="mt-5 text-3xl">Al jaren de schilder in Oosterhout en omgeving.</h2>
          <p class="mt-6 text-lg text-licht-zacht">{site.eigenaar} zet zich met B.V.T. sinds 2006 in onder het motto ‘kwaliteit hoeft niet duur te zijn’. Waar nodig werkt hij samen met vaste partners, zoals een aannemer, stukadoor of glaszetter. U houdt één aanspreekpunt: B.V.T. verzorgt het totale pakket.</p>
          <ul class="mt-9 grid gap-3 sm:grid-cols-3">
            <li class="border-t-[3px] border-rood bg-nacht-2 p-5"><Icoon naam="hand" class="h-6 w-6 text-vonk" /><h3 class="mt-4 text-lg">Afspraak is afspraak</h3><p class="mt-1.5 text-[.9375rem] text-licht-zacht">“Komt zijn afspraken na”, schrijft een klant op Google.</p></li>
            <li class="border-t-[3px] border-rood bg-nacht-2 p-5"><Icoon naam="mens" class="h-6 w-6 text-vonk" /><h3 class="mt-4 text-lg">Eén aanspreekpunt</h3><p class="mt-1.5 text-[.9375rem] text-licht-zacht">Ook als er een partner meewerkt aan uw klus.</p></li>
            <li class="border-t-[3px] border-rood bg-nacht-2 p-5"><Icoon naam="rol" class="h-6 w-6 text-vonk" /><h3 class="mt-4 text-lg">A-merk verf</h3><p class="mt-1.5 text-[.9375rem] text-licht-zacht">Verf en advies van Schildersbenodigdheden LavanTil.</p></li>
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-rood"><Icoon naam="wa" />App {site.voornaam}</a>
            <a href={site.telHref} class="knop knop-rand num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="bg-steen py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="rijs lg:col-span-5">
          <p class="eyebrow">Reviews</p>
          <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
          <a href={site.reviews} class="kaart mt-8 inline-flex items-center gap-4 px-5 py-4 no-underline transition-shadow hover:shadow-md">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-extrabold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        {reviews.map((r) => (
          <figure class="rijs kaart relative p-8 sm:p-10 lg:col-span-7" style="--d:.06s">
            <span class="absolute right-8 top-6 font-kop text-[6rem] font-extrabold leading-none text-rood/15" aria-hidden="true">“</span>
            <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span>
            <blockquote class="mt-6 font-kop text-[clamp(1.5rem,1.4vw+1.1rem,2.25rem)] font-bold leading-[1.15] tracking-[-0.02em]">“{r.tekst}”</blockquote>
            <figcaption class="mt-8 flex items-center gap-3 border-t border-lijn pt-5">
              <span class="grid h-10 w-10 place-items-center bg-steen font-kop font-bold text-rood" aria-hidden="true">{r.naam[0]}</span>
              <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
              <Icoon naam="g" class="h-5 w-5" />
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 9. Offerte: WhatsApp-bericht samenstellen -->
    <section id="offerte" class="py-20 lg:py-28" aria-labelledby="t-offerte">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-offerte" class="mt-5 text-3xl">Vertel wat er moet gebeuren.</h2>
          <p class="mt-6 text-lg text-grijs">Kies de klus, binnen of buiten en wanneer het u uitkomt. Wij zetten het in een WhatsApp-bericht aan {site.voornaam}; foto’s stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center bg-rood text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center bg-steen text-rood"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Advies nodig? Bel {site.voornaam} direct.</span></span><Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>
            <li><a href={site.maps} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center bg-steen text-rood"><Icoon naam="pin" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">{site.straat}</b><span class="text-grijs">{site.postcode} {site.plaats}</span></span><Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>
          </ul>
        </div>
        <form class="kaart p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw aanvraag aan {site.voornaam}</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat moet er gebeuren? <span class="font-normal text-grijs">(meer kiezen mag)</span></legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {keuzes.map((b) => (
                <label class="keuze"><input type="checkbox" name="klus" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Wanneer</span>
              <select name="wanneer" class="veld mt-2">
                <option value="">Maakt niet uit</option>
                <option>Zo snel mogelijk</option>
                <option>Voor een verhuizing</option>
                <option>Voor de winter</option>
                <option>In het voorjaar</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld Oosterhout" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: vier kozijnen aan de voorkant, één met houtrot"></textarea></label>
          </div>
          <div class="mt-7 bg-steen p-4">
            <p class="text-xs font-semibold uppercase tracking-[.14em] text-grijs">Voorbeeld van uw bericht</p>
            <p class="bericht mt-3 whitespace-pre-line text-[.9375rem]" data-voorbeeld aria-live="polite">Hallo Berry, ik wil graag een vrijblijvende offerte.</p>
          </div>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-rood"><Icoon naam="wa" />Open in WhatsApp</button>
            <a href={site.telHref} class="link text-sm font-semibold">Liever bellen?</a>
          </div>
        </form>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-rood text-wit" aria-label="Offerte aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Toe aan een opknapbeurt?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel of app {site.voornaam} voor een vrijblijvende offerte.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const uit = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const bericht = () => {
    const d = new FormData(f!);
    const v = (n: string) => String(d.get(n) || '').trim();
    const klus = d.getAll('klus').map(String);
    const r = ['Hallo Berry, ik wil graag een vrijblijvende offerte.'];
    if (klus.length) r.push('Klus: ' + klus.join(', ').toLowerCase());
    if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
    if (v('plaats')) r.push('Plaats: ' + v('plaats'));
    if (v('wens')) r.push('Toelichting: ' + v('wens'));
    if (v('naam')) r.push('Groet, ' + v('naam'));
    return r.join('\n');
  };
  if (f) {
    const ververs = () => { if (uit) uit.textContent = bericht(); };
    f.addEventListener('input', ververs);
    f.addEventListener('change', ververs);
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31623456497?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
  }
</script>

