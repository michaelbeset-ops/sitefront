---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const diensten = ['Keukenontwerp in 3D', 'Werkbladen', 'A-merken apparatuur', 'Montage en stucwerk', 'Leidingwerk en elektra', 'Badkamers'];
const kort = (n: number) => `${n}:00`;
---
<footer class="bg-front text-mist">
  <div class="plintlicht"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Kwaliteitskeukens en apparatuur in Rotterdam. Van ontwerp in 3D tot de volledige montage, met een compacte showroom op afspraak.</p>
      <a href={site.telHref} class="knop knop-merk num mt-7 min-h-12 px-5"><Icoon naam="tel" />{site.tel}</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Diensten</p>
      <ul class="mt-5 space-y-2.5">
        {diensten.map((t) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Showroom</p>
      <ul class="mt-5 space-y-2.5">
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li>Uitsluitend op afspraak</li>
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a></li>
        <li><a href={waHoi} class="inline-flex items-center gap-2 no-underline hover:text-merk-licht"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a></li>
        <li><a href={site.facebook} class="inline-flex items-center gap-2 no-underline hover:text-merk-licht"><Icoon naam="fb" class="h-5 w-5" />Facebook</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Bereikbaar</p>
      <ul class="num mt-5 space-y-1.5 text-[.9375rem]">
        {tijden.map((t) => <li class="flex justify-between gap-3"><span>{t.dag.slice(0, 2)}</span><span>{kort(t.open[0])} - {kort(t.open[1])}</span></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Teksten en foto's van jullie eigen website goodkitchenstore.nl. Reviews letterlijk van Google (stand 15 oktober 2026). Tijden volgens jullie Google-profiel.</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
