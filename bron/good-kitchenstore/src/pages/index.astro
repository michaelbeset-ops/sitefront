---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, tijden, waHoi, waMet } from '../data/site';

// Alle foto's van hun eigen site goodkitchenstore.nl. Zie src/assets/BRONNEN.txt en tools/prep.mjs.
import hero from '../assets/hero.jpg';
import ontwerp from '../assets/ontwerp-3d.jpg';
import werkblad from '../assets/werkblad.jpg';
import apparatuur from '../assets/apparatuur.jpg';
import montage from '../assets/montage.jpg';
import leiding from '../assets/leiding.jpg';
import montageB from '../assets/montage-b.jpg';
import badkamer from '../assets/badkamer.jpg';
import pLandelijk from '../assets/p-landelijk.jpg';
import pLichtU from '../assets/p-licht-u.jpg';
import pEilandHout from '../assets/p-eiland-hout.jpg';
import pVisgraat from '../assets/p-visgraat.jpg';
import pSchier from '../assets/p-schiereiland.jpg';
import pWitHout from '../assets/p-wit-hout.jpg';
import pKraan from '../assets/p-kraan.jpg';
import pKast from '../assets/p-kast.jpg';

// Teksten van hun eigen homepage, ontwerpen-pagina en boek-nu-pagina (letterlijk of licht ingekort).
const diensten = [
  { t: 'Ontwerp in 3D', d: 'Uw keuken eerst als realistische tekening, zodat u een duidelijk beeld krijgt van hoe hij er in de praktijk uitziet.', src: ontwerp, pos: '50% 50%', alt: '3D-ontwerp van een keuken met donkere fronten en een wit kookeiland', icoon: 'kubus' },
  { t: 'Werkbladen', d: 'Wij leveren vrijwel alle soorten werkbladen. U kiest het blad dat bij uw keuken past.', src: werkblad, pos: '50% 62%', alt: 'Zwart werkblad met witte ader en verlichting onder de bovenkasten', icoon: 'meet' },
  { t: 'A-merken apparatuur', d: 'Een ruime keuze aan A-merken apparatuur, van inbouwoven tot Quooker.', src: apparatuur, pos: '50% 40%', alt: 'Kastenwand in houtdecor met ingebouwde apparatuur', icoon: 'stekker' },
  { t: 'Montage en stucwerk', d: 'De volledige montage, het stucwerk erbij en desgewenst verwijderen wij uw oude keuken.', src: montageB, pos: '50% 50%', alt: 'Hoge kastenwand in donker houtdecor met inbouwovens en plintverlichting', icoon: 'huis' },
  { t: 'Leidingwerk en elektra', d: 'Water, afvoer, elektra en groepenkasten, afgestemd op uw nieuwe keuken.', src: pKraan, pos: '50% 55%', alt: 'Spoelbak met kraan in een houten werkblad', icoon: 'druppel' },
  { t: 'Badkamers', d: 'Ook complete badkamers: van ontwerp en advies tot de volledige installatie en afwerking.', src: badkamer, pos: '50% 50%', alt: 'Badkamer met marmerlook wanden, zwevend meubel en inloopdouche', icoon: 'druppel' },
];
const chips = ['Parallelopstelling', 'U-opstelling', 'Eilandopstelling', 'Werkbladen', 'Inbouwapparatuur', 'Quooker', 'Groepenkasten', 'Badkamers'];

const feiten = [
  ['kubus', 'Ontwerp in een 3D-programma'],
  ['meet', 'Vrijwel alle soorten werkbladen'],
  ['stekker', 'Ruime keuze aan A-merken apparatuur'],
  ['huis', 'Inmeten en bespreken bij u thuis'],
];

const stappen = [
  ['Afspraak maken', 'Bel of app voor een afspraak met een van de adviseurs. De showroom is uitsluitend op afspraak.'],
  ['Advies en inmeten', 'Deskundig advies en een nauwkeurige inmeting. Desgewenst komen wij daarvoor bij u langs.'],
  ['Ontwerp in 3D', 'U ziet uw keuken als realistische tekening. Fronten kunt u mee naar huis nemen om de kleur te bekijken.'],
  ['Levering en montage', 'Plaatsing, leiding- en stucwerk, en desgewenst halen wij uw oude keuken eruit.'],
];

const projecten = [
  { src: pVisgraat, t: 'Greeploos op een visgraatvloer', cls: 'col-span-2 sm:col-span-1 lg:col-span-5 lg:row-span-2', ratio: 'aspect-[4/5] lg:aspect-auto lg:h-full', pos: '50% 50%' },
  { src: pEilandHout, t: 'Kookeiland met houten bar', cls: 'col-span-2 sm:col-span-1 lg:col-span-7', ratio: 'aspect-[16/9]', pos: '50% 50%' },
  { src: pSchier, t: 'Schiereiland in donker front', cls: 'lg:col-span-3', ratio: 'aspect-[4/5]', pos: '50% 50%' },
  { src: pLandelijk, t: 'Kaderfronten met houten achterwand', cls: 'lg:col-span-4', ratio: 'aspect-[4/5] lg:aspect-auto lg:h-full', pos: '50% 40%' },
  { src: pLichtU, t: 'Lichte U-keuken', cls: 'lg:col-span-4', ratio: 'aspect-[4/3]', pos: '50% 50%' },
  { src: pKast, t: 'Hoge kastenwand met plintlicht', cls: 'lg:col-span-4', ratio: 'aspect-[4/3]', pos: '50% 35%' },
  { src: pWitHout, t: 'Witte hoekkeuken, houten wand', cls: 'lg:col-span-4', ratio: 'aspect-[4/3]', pos: '50% 50%' },
];

// Opstellingen: hun eigen inspiratiepagina (ingekort). Rechte wand en hoek zijn keuzes voor de bezoeker zelf.
const opstellingen = [
  { id: 'recht', t: 'Rechte wand', uitleg: '' },
  { id: 'hoek', t: 'Hoekkeuken', uitleg: '' },
  { id: 'u', t: 'U-opstelling', uitleg: 'De keuken loopt langs drie zijden van de ruimte. Veel werkblad en opbergruimte, zeer praktisch als u graag en vaak kookt.' },
  { id: 'parallel', t: 'Parallel', uitleg: 'Twee keukenblokken aan tegenoverliggende wanden met een loopruimte ertussen. Vooral geschikt voor langere of smallere ruimtes.' },
  { id: 'eiland', t: 'Met eiland', uitleg: 'Naast de keuken tegen de wand een los kookeiland. Een open uitstraling, en de keuken wordt een centrale plek in huis.' },
];
const wensen = ['Werkblad', 'Inbouwapparatuur', 'Quooker', 'Leidingen verleggen', 'Elektra of groepenkast', 'Oude keuken verwijderen', 'Stucwerk'];

const sterren = [1, 2, 3, 4, 5];
---
<Base title="Good Kitchenstore | Kwaliteitskeukens en apparatuur in Rotterdam" description="Keukenwinkel in Rotterdam: ontwerp in 3D, werkbladen, A-merken apparatuur, leiding- en stucwerk en volledige montage. Showroom op afspraak. Bel 06 21 53 89 98.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: hun eigen foto van het marmeren eiland -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-front text-wit lg:items-center" aria-labelledby="inhoud">
      <div class="absolute inset-y-0 right-0 -z-20 w-full lg:w-[56%]">
        <Image src={hero} alt="Kookeiland met marmeren blad en hanglampen, geplaatst door Good Kitchenstore" widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 56vw, 100vw" loading="eager" fetchpriority="high" quality={66} class="h-full w-full object-cover object-[50%_30%] lg:object-[50%_62%]" />
      </div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#141414d9_0%,#14141426_14%,#14141499_28%,#141414e6_50%,#141414_100%)] lg:bg-[linear-gradient(90deg,#141414_0%,#141414_44%,#141414b3_54%,#14141426_72%,#14141400_100%),linear-gradient(180deg,#141414b3_0%,#14141400_26%,#14141400_80%,#14141480_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-28 pt-44 md:pb-24 lg:pb-16 lg:pt-44">
        <div class="max-w-[46rem] lg:max-w-[40rem]">
          <p class="eyebrow eyebrow-licht max-lg:!text-wit">Keukenwinkel in Rotterdam</p>
          <h1 id="inhoud" class="mt-6 text-hero">Uw <span class="text-merk-licht">droomkeuken</span>, van ontwerp tot montage</h1>
          <p class="mt-7 max-w-[34rem] text-[1.1875rem] leading-relaxed text-wit/90 md:text-[1.3125rem]">Wij verzorgen het leiding- en stucwerk, de volledige montage en kunnen desgewenst uw oude keuken verwijderen.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />Plan een afspraak</a>
            <a href="#planner" class="knop knop-wit">Stel uw keuken samen<Icoon naam="pijl" /></a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-3 text-[1rem] text-wit/90">
            <li><a href={site.reviews} class="flex items-center gap-2 text-wit/90 no-underline hover:text-wit"><span class="flex text-led">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span class="num font-bold">{site.google.score}</span> op Google, {site.google.aantal} reviews</a></li>
            <li class="flex items-center gap-2"><Icoon naam="kalender" class="h-5 w-5 text-merk-licht" />Showroom op afspraak</li>
            <li><a href={site.telHref} class="num flex items-center gap-2 font-bold text-wit no-underline hover:text-merk-licht"><Icoon naam="tel" class="h-5 w-5 text-merk-licht" />{site.tel}</a></li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- 2. Showroom en wat ze leveren -->
    <section class="py-20 md:py-28" aria-labelledby="t-showroom">
      <div class="wrap grid items-center gap-x-16 gap-y-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow rijs">Kwaliteitskeukens en apparatuur</p>
          <h2 id="t-showroom" class="rijs mt-5 text-4xl">Compacte showroom, <span class="text-merk">ruime</span> keuze</h2>
          <p class="rijs mt-7 max-w-xl text-lg text-steen">Wij werken met een compacte showroom en uitsluitend op afspraak. Desgewenst komen wij bij u langs om direct in te meten en uw keukenwensen te bespreken.</p>
          <ul class="mt-10 grid gap-4 sm:grid-cols-2">
            {feiten.map(([i, t], n) => (
              <li class="kaart rijs flex items-center gap-4 p-5" style={`--d:${n * 0.06}s`}>
                <span class="grid h-12 w-12 flex-none place-items-center rounded-md bg-front text-merk-licht"><Icoon naam={i} class="h-6 w-6" /></span>
                <span class="font-bold leading-snug">{t}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rijs relative lg:col-span-6">
          <Image src={montage} alt="Geplaatste hoekkeuken in donker houtdecor met verlichting onder de plint" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 46vw, 100vw" quality={70} class="aspect-[4/3] w-full rounded-md object-cover" />
          <div class="absolute -bottom-6 left-5 right-5 rounded-md bg-front px-6 py-5 text-wit shadow-[0_18px_40px_-18px_#14141499] md:left-auto md:right-8 md:max-w-[19rem]">
            <p class="text-[.9375rem] font-semibold uppercase tracking-[.14em] text-merk-licht">Ook buiten de showroom</p>
            <p class="mt-1.5 font-semibold leading-snug">Inmeten en uw wensen bespreken, gewoon bij u thuis.</p>
          </div>
        </div>
      </div>
      <div class="wrap mt-20">
        <ul class="flex flex-wrap gap-2.5" aria-label="Opstellingen en producten">
          {chips.map((c) => <li class="chip">{c}</li>)}
        </ul>
      </div>
    </section>

    <!-- 3. Diensten als fotokaarten -->
    <section id="diensten" class="bg-wit py-20 md:py-28" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow rijs">Diensten</p>
            <h2 id="t-diensten" class="rijs mt-5 text-4xl">Het <span class="text-merk">complete</span> pakket</h2>
          </div>
          <p class="rijs text-lg text-steen lg:col-span-5">Wij bieden het complete pakket voor een zorgeloze installatie van uw keuken. Van het eerste ontwerp tot het laatste stopcontact.</p>
        </div>
        <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {diensten.map((d, n) => (
            <li class="rijs group overflow-hidden rounded-md border border-lijn-licht bg-blad" style={`--d:${(n % 3) * 0.07}s`}>
              <div class="relative overflow-hidden">
                <Image src={d.src} alt={d.alt} widths={[400, 640, 900]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" quality={68} class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" style={`object-position:${d.pos}`} />
                <span class="absolute left-4 top-4 grid h-11 w-11 place-items-center rounded-md bg-front text-merk-licht"><Icoon naam={d.icoon} class="h-5 w-5" /></span>
              </div>
              <div class="p-6 md:p-7">
                <h3 class="text-2xl">{d.t}</h3>
                <p class="mt-3 text-steen">{d.d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Elders een keuken gekocht? Hun specialisme -->
    <section class="relative overflow-hidden bg-front py-24 text-wit md:py-32" aria-labelledby="t-elders">
      <div class="wrap grid items-center gap-x-16 gap-y-12 lg:grid-cols-12">
        <div class="rijs relative order-last lg:order-first lg:col-span-6">
          <Image src={leiding} alt="Kookeiland met spoelbak en zwarte kraan op een houten werkblad" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 46vw, 100vw" quality={70} class="aspect-[5/4] w-full rounded-md object-cover object-[60%_50%]" />
          <div class="plintlicht absolute -bottom-px left-6 right-6"></div>
        </div>
        <div class="lg:col-span-6">
          <p class="eyebrow eyebrow-licht rijs">Leidingwerk en elektra</p>
          <h2 id="t-elders" class="rijs mt-5 text-4xl">Elders een keuken <span class="text-merk-licht">gekocht?</span></h2>
          <p class="rijs mt-7 text-lg text-mist">Heeft u elders een keuken gekocht en geen partij voor het verleggen van leidingen? Wij zijn hierin gespecialiseerd en zorgen voor een vakkundige aanleg van water en afvoer.</p>
          <p class="rijs mt-4 text-lg text-mist">Ook voor het aanpassen van groepenkasten en het verzorgen van elektra kunt u bij ons terecht.</p>
          <ul class="mt-9 grid gap-3 sm:grid-cols-2">
            {['Leidingen verleggen', 'Water en afvoer', 'Groepenkast aanpassen', 'Elektra verzorgen'].map((t) => (
              <li class="rijs flex items-center gap-3 rounded-md border border-lijn bg-front-2 px-4 py-3.5 font-semibold"><Icoon naam="vink" class="h-5 w-5 flex-none text-merk-licht" />{t}</li>
            ))}
          </ul>
          <a href={waMet('Hallo Good Kitchenstore, ik heb elders een keuken gekocht en zoek iemand voor het leidingwerk en/of de elektra. Kunnen jullie helpen?')} class="knop knop-merk rijs mt-10"><Icoon naam="wa" />Vraag het via WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section id="werkwijze" class="py-20 md:py-28" aria-labelledby="t-werkwijze">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow rijs">Werkwijze</p>
            <h2 id="t-werkwijze" class="rijs mt-5 text-4xl">In vier stappen naar uw <span class="text-merk">nieuwe</span> keuken</h2>
          </div>
          <p class="rijs text-lg text-steen lg:col-span-5">Tijdens het bezoek voorzien wij u van deskundig advies en zorgen wij voor een nauwkeurige inmeting.</p>
        </div>
        <ol class="mt-14 grid gap-px overflow-hidden rounded-md border border-lijn-licht bg-blad-3 sm:grid-cols-2 lg:grid-cols-4">
          {stappen.map(([t, d], n) => (
            <li class="rijs bg-wit p-7 md:p-8" style={`--d:${n * 0.07}s`}>
              <span class="stap-nr num">0{n + 1}</span>
              <h3 class="mt-5 text-xl">{t}</h3>
              <p class="mt-3 text-steen">{d}</p>
            </li>
          ))}
        </ol>

      </div>
    </section>

    <!-- 6. Keukenplanner: de wow-functie -->
    <section id="planner" class="bg-wit py-20 md:py-28" aria-labelledby="t-planner">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow rijs">Keukenplanner</p>
            <h2 id="t-planner" class="rijs mt-5 text-4xl">Schets uw keuken in <span class="text-merk">één</span> minuut</h2>
          </div>
          <p class="rijs text-lg text-steen lg:col-span-5">Kies een opstelling en de lengte van de wand, vink aan wat u nodig heeft. U ziet direct een plattegrond, en stuurt uw schets via WhatsApp mee naar de showroom.</p>
        </div>

        <form id="planner-form" class="mt-14 grid gap-8 lg:grid-cols-12" novalidate>
          <div class="space-y-10 lg:col-span-7">
            <fieldset>
              <legend class="veld-label"><span class="num text-merk">1.</span> Welke opstelling?</legend>
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
                {opstellingen.map((o, n) => (
                  <label class={`opst ${n === 4 ? 'col-span-2 sm:col-span-1' : ''}`}>
                    <input type="radio" name="opstelling" value={o.id} checked={n === 1} class="sr-only" data-uitleg={o.uitleg} data-naam={o.t} />
                    <svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true">
                      {o.id === 'recht' && <rect x="6" y="8" width="36" height="9" rx="1" />}
                      {o.id === 'hoek' && <path d="M6 8h36v9H15v23H6z" />}
                      {o.id === 'u' && <path d="M6 8h36v32h-9V17H15v23H6z" />}
                      {o.id === 'parallel' && <><rect x="6" y="8" width="36" height="9" rx="1" /><rect x="6" y="31" width="36" height="9" rx="1" /></>}
                      {o.id === 'eiland' && <><rect x="6" y="8" width="36" height="9" rx="1" /><rect x="13" y="28" width="22" height="10" rx="1" /></>}
                    </svg>
                    <span>{o.t}</span>
                  </label>
                ))}
              </div>
              <p id="opst-uitleg" class="mt-4 min-h-[3.2em] max-w-2xl text-[1rem] text-steen" aria-live="polite"></p>
            </fieldset>

            <fieldset>
              <legend class="veld-label"><span class="num text-merk">2.</span> Lengte van de langste wand: <output id="lengte-out" class="num text-merk">3,6 m</output></legend>
              <input id="lengte" name="lengte" type="range" aria-label="Lengte van de langste wand in meters" min="2" max="8" step="0.1" value="3.6" class="schuif" aria-describedby="lengte-hulp" />
              <p id="lengte-hulp" class="num flex justify-between text-[.9375rem] text-steen"><span>2 m</span><span>ongeveer, wij meten het precies in</span><span>8 m</span></p>
            </fieldset>

            <fieldset>
              <legend class="veld-label"><span class="num text-merk">3.</span> Wat heeft u nodig?</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                {wensen.map((w) => <label class="keuze"><input type="checkbox" name="wens" value={w} />{w}</label>)}
              </div>
            </fieldset>

            <fieldset>
              <legend class="veld-label"><span class="num text-merk">4.</span> Eerste afspraak</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="keuze"><input type="radio" name="waar" value="in de showroom (op afspraak)" checked />In de showroom</label>
                <label class="keuze"><input type="radio" name="waar" value="bij mij thuis, om in te meten" />Bij mij thuis inmeten</label>
              </div>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                <div><label for="p-naam" class="veld-label">Uw naam</label><input id="p-naam" name="naam" class="veld" autocomplete="name" placeholder="Voornaam" /></div>
                <div><label for="p-plaats" class="veld-label">Plaats</label><input id="p-plaats" name="plaats" class="veld" autocomplete="address-level2" placeholder="Bijvoorbeeld Rotterdam" /></div>
              </div>
            </fieldset>
          </div>

          <aside class="lg:col-span-5" aria-label="Uw schets">
            <div class="sticky top-6 overflow-hidden rounded-md bg-front text-wit">
              <div class="flex items-center justify-between border-b border-lijn px-6 py-4">
                <p class="text-[.9375rem] font-semibold uppercase tracking-[.14em] text-merk-licht">Uw schets</p>
                <p id="schets-label" class="num text-[.9375rem] text-mist">Hoekkeuken, 3,6 m</p>
              </div>
              <div class="relative bg-[radial-gradient(#ffffff14_1px,transparent_1px)] [background-size:18px_18px] px-6 py-8">
                <svg id="plan" viewBox="0 0 320 230" class="mx-auto block h-auto w-full max-w-[26rem]" role="img" aria-label="Plattegrond van de gekozen opstelling"></svg>
              </div>
              <div class="border-t border-lijn px-6 py-6">
                <p class="text-[.9375rem] text-mist">Uw WhatsApp-bericht</p>
                <p id="bericht" class="mt-2 whitespace-pre-line text-[1rem] leading-relaxed text-wit/90"></p>
                <a id="planner-wa" href={waHoi} class="knop knop-groen mt-6 w-full"><Icoon naam="wa" />Verstuur via WhatsApp</a>
                <p class="mt-3 text-[.875rem] text-mist">Er wordt niets verstuurd voordat u zelf op verzenden drukt in WhatsApp.</p>
              </div>
            </div>
          </aside>
        </form>
      </div>
    </section>

    <!-- 7. Projecten -->
    <section id="projecten" class="bg-front py-24 text-wit md:py-32" aria-labelledby="t-projecten">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow eyebrow-licht rijs">Projecten</p>
