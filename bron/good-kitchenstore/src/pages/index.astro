          <p class="rijs text-lg text-mist lg:col-span-5">Een greep uit de keukens die wij ontwierpen, leverden en plaatsten. Van strak en greeploos tot landelijk met houten accenten.</p>
        </div>
        <ul class="mt-14 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-12 lg:gap-5">
          {projecten.map((p) => (
            <li class={`rijs group relative overflow-hidden rounded-md ${p.cls}`}>
              <Image src={p.src} alt={p.t} widths={[400, 640, 960]} sizes="(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 100vw" quality={68} class={`w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] ${p.ratio}`} style={`object-position:${p.pos}`} />
              <p class="absolute inset-x-0 bottom-0 bg-[linear-gradient(180deg,#14141400,#141414d9)] px-3 pb-3 pt-10 text-[.9375rem] font-semibold leading-snug sm:px-5 sm:pb-4 sm:text-base">{p.t}</p>
