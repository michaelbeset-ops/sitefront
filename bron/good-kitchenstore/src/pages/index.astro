          ))}
          <li class="rijs flex flex-col justify-between gap-6 rounded-md bg-merk p-7 col-span-2 lg:col-span-12 lg:flex-row lg:items-center">
            <p class="max-w-2xl text-xl font-semibold leading-snug">Zelf zo'n keuken? Stuur een foto van uw huidige keuken of plattegrond mee, dan denken wij met u mee.</p>
            <a href={waMet('Hallo Good Kitchenstore, ik stuur een foto van mijn huidige keuken/plattegrond mee. Kunnen jullie meedenken over een nieuwe keuken?')} class="knop flex-none bg-wit text-front hover:bg-blad"><Icoon naam="wa" />Foto sturen</a>
          </li>
        </ul>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-20 md:py-28" aria-labelledby="t-reviews">
      <div class="wrap">
        <p class="eyebrow rijs">Reviews</p>
        <h2 id="t-reviews" class="rijs mt-5 text-4xl">Wat klanten <span class="text-merk">zeggen</span></h2>
        <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <li class="rijs flex flex-col justify-between rounded-md bg-front p-7 text-wit">
            <div class="flex items-center gap-3"><span class="grid h-12 w-12 place-items-center rounded-full bg-wit"><Icoon naam="g" class="h-6 w-6" /></span><span class="font-semibold">Google reviews</span></div>
            <div class="mt-10">
              <p class="num text-[4.5rem] leading-none" style="font-family: var(--font-kop); font-weight: 860; font-stretch: 70%;">{site.google.score}</p>
              <p class="mt-2 flex text-led">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</p>
              <p class="mt-3 text-mist">Gemiddeld uit {site.google.aantal} reviews</p>
              <a href={site.reviews} class="link mt-6 inline-block font-semibold text-wit">Alle reviews op Google</a>
            </div>
          </li>
          {reviews.map((r, n) => (
            <li class="kaart rijs flex flex-col p-7" style={`--d:${(n % 3) * 0.07}s`}>
              <p class="flex text-merk">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}<span class="sr-only">5 van 5 sterren</span></p>
              <blockquote class="mt-4 flex-1 text-[1.0625rem] leading-relaxed">"{r.tekst}"</blockquote>
              <p class="mt-6 flex items-center justify-between gap-3 border-t border-lijn-licht pt-4 text-[.9375rem]"><span class="font-bold">{r.naam}</span><span class="flex items-center gap-1.5 text-steen"><Icoon naam="g" class="h-4 w-4" />Google review</span></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. Contact, showroom en tijden -->
    <section id="contact" class="bg-wit py-20 md:py-28" aria-labelledby="t-contact">
      <div class="wrap grid gap-x-16 gap-y-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow rijs">Contact</p>
          <h2 id="t-contact" class="rijs mt-5 text-4xl">Plan uw <span class="text-merk">afspraak</span></h2>
          <p class="rijs mt-7 max-w-xl text-lg text-steen">Heeft u vragen, wilt u een offerte of een afspraak maken? Bel of app ons. We geven graag vrijblijvend advies.</p>
          <div class="rijs mt-9 flex flex-col gap-3 sm:flex-row">
            <a href={site.telHref} class="knop knop-merk num"><Icoon naam="tel" />{site.tel}</a>
            <a href={waHoi} class="knop knop-rand"><Icoon naam="wa" class="text-[#157a45]" />WhatsApp</a>
          </div>
          <div class="kaart rijs mt-10 grid gap-6 p-7 sm:grid-cols-2">
            <div>
              <p class="flex items-center gap-2 font-bold"><Icoon naam="pin" class="h-5 w-5 text-merk" />Showroom</p>
              <p class="mt-2 text-steen">{site.straat}<br />{site.postcode} {site.plaats}</p>
              <a href={site.route} class="link mt-3 inline-block font-semibold">Route plannen</a>
            </div>
            <div>
              <p class="flex items-center gap-2 font-bold"><Icoon naam="kalender" class="h-5 w-5 text-merk" />Uitsluitend op afspraak</p>
              <p class="mt-2 text-steen">Desgewenst komen wij bij u langs om direct in te meten.</p>
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rijs overflow-hidden rounded-md border border-lijn-licht bg-blad">
            <div class="flex items-center justify-between gap-4 border-b border-lijn-licht px-6 py-5">
              <p class="flex items-center gap-2 font-bold"><Icoon naam="klok" class="h-5 w-5 text-merk" />Bereikbaar</p>
              <p id="nu-open" class="text-[.9375rem] font-semibold text-steen"></p>
            </div>
            <table class="num w-full text-left text-[1.0625rem]">
              <caption class="sr-only">Tijden volgens Google</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.nr} class="border-b border-lijn-licht last:border-0">
                    <th scope="row" class="px-6 py-3 font-semibold">{t.dag}</th>
                    <td class="whitespace-nowrap px-6 py-3 text-right text-steen">{t.open[0]}:00 - {t.open[1]}:00</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="border-t border-lijn-licht px-6 py-4 text-[.9375rem] text-steen">Tijden volgens Google. Een bezoek aan de showroom altijd op afspraak.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Slotbalk -->
    <section class="bg-merk text-wit" aria-label="Afspraak maken">
      <div class="wrap flex flex-col gap-6 py-12 md:flex-row md:items-center md:justify-between md:py-14">
        <p class="text-3xl" style="font-family: var(--font-kop); font-weight: 860; font-stretch: 74%; text-transform: uppercase; line-height: .95;">Bij ons bent u aan het juiste adres voor uw droomkeuken.</p>
        <a href={waHoi} class="knop flex-none bg-front text-wit hover:bg-front-3"><Icoon naam="wa" />Plan een afspraak</a>
      </div>
    </section>
  </main>

  <Voet />

  <script>
    // Tijden: vandaag markeren en live bereikbaar/gesloten.
    const tabel = document.querySelectorAll<HTMLTableRowElement>('tr[data-dag]');
    const nu = new Date();
    const dag = nu.getDay();
    const uur = nu.getHours() + nu.getMinutes() / 60;
    tabel.forEach((r) => {
      if (Number(r.dataset.dag) !== dag) return;
      r.classList.add('bg-wit');
      r.querySelector('th')?.insertAdjacentHTML('beforeend', ' <span class="ml-1 text-[.875rem] font-semibold text-merk">vandaag</span>');
      const t = r.querySelector('td')?.textContent?.match(/(\d+):00 - (\d+):00/);
      const el = document.getElementById('nu-open');
      if (t && el) {
        const open = uur >= Number(t[1]) && uur < Number(t[2]);
        el.innerHTML = open ? '<span class="inline-block h-2.5 w-2.5 rounded-full bg-[#1f9d55] align-middle"></span> Nu bereikbaar' : 'Nu gesloten';
      }
    });

    // Keukenplanner: live plattegrond + vooraf ingevuld WhatsApp-bericht.
    const form = document.getElementById('planner-form') as HTMLFormElement | null;
    const plan = document.getElementById('plan');
    const out = document.getElementById('lengte-out');
    const label = document.getElementById('schets-label');
    const uitleg = document.getElementById('opst-uitleg');
    const bericht = document.getElementById('bericht');
    const wa = document.getElementById('planner-wa') as HTMLAnchorElement | null;
    const WA = 'https://wa.me/31621538998?text=';
    const fmt = (n: number) => n.toFixed(1).replace('.', ',');

    function teken(opst: string, len: number) {
      if (!plan) return;
      const W = 320, H = 230, m = 24, maxL = Math.max(len, 5);
      const s = (W - 2 * m) / maxL;              // px per meter bij 8 m
      const L = Math.max(len * s, 2 * s);
      const d = 0.62 * s;                        // kastdiepte ca. 60 cm
      const x0 = (W - L) / 2, y0 = m;
      const side = Math.min(L * 0.62, H - 2 * m - 26);
      const wand = '#5b5650', kast = '#e9e4dc', blad = '#ff6b62';
      let r = '';
      const rect = (x: number, y: number, w: number, h: number, f = kast) => { r += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${w.toFixed(1)}" height="${h.toFixed(1)}" rx="2" fill="${f}" />`; };
      const lijn = (x1: number, y1: number, x2: number, y2: number) => { r += `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="${wand}" stroke-width="4" stroke-linecap="square" />`; };
      // muren
      lijn(x0 - 4, y0 - 4, x0 + L + 4, y0 - 4);
      if (opst === 'hoek' || opst === 'u') lijn(x0 - 4, y0 - 4, x0 - 4, y0 + side);
      if (opst === 'u') lijn(x0 + L + 4, y0 - 4, x0 + L + 4, y0 + side);
      // kasten
      rect(x0, y0, L, d);
      if (opst === 'hoek' || opst === 'u') rect(x0, y0 + d, d, side - d);
      if (opst === 'u') rect(x0 + L - d, y0 + d, d, side - d);
      if (opst === 'parallel') { const y2 = y0 + Math.min(side, 3.2 * s) ; lijn(x0 - 4, y2 + d + 4, x0 + L + 4, y2 + d + 4); rect(x0, y2, L, d); }
      if (opst === 'eiland') { const iw = Math.max(L * 0.55, 1.6 * s), ih = 0.95 * s; rect((W - iw) / 2, y0 + d + 1.2 * s, iw, ih, '#d3ccc1'); r += `<text x="${W / 2}" y="${(y0 + d + 1.2 * s + ih / 2 + 4).toFixed(1)}" text-anchor="middle" font-size="11" font-weight="700" fill="#141414" font-family="system-ui,sans-serif">EILAND</text>`; }
      // spoelbak en kookplaat
      r += `<rect x="${(x0 + L * 0.28).toFixed(1)}" y="${(y0 + d * 0.22).toFixed(1)}" width="${(0.5 * s).toFixed(1)}" height="${(d * 0.56).toFixed(1)}" rx="3" fill="none" stroke="#8a837a" stroke-width="1.5" />`;
      const kx = x0 + L * 0.66;
      [[0, 0], [1, 0], [0, 1], [1, 1]].forEach(([a, b]) => { r += `<circle cx="${(kx + a * 0.26 * s).toFixed(1)}" cy="${(y0 + d * 0.32 + b * d * 0.36).toFixed(1)}" r="${(0.09 * s).toFixed(1)}" fill="none" stroke="#141414" stroke-width="1.5" />`; });
      // maatlijn
      const yM = H - 14;
      r += `<line x1="${x0.toFixed(1)}" y1="${yM}" x2="${(x0 + L).toFixed(1)}" y2="${yM}" stroke="${blad}" stroke-width="1.5" /><line x1="${x0.toFixed(1)}" y1="${yM - 5}" x2="${x0.toFixed(1)}" y2="${yM + 5}" stroke="${blad}" stroke-width="1.5" /><line x1="${(x0 + L).toFixed(1)}" y1="${yM - 5}" x2="${(x0 + L).toFixed(1)}" y2="${yM + 5}" stroke="${blad}" stroke-width="1.5" />`;
      r += `<text x="${W / 2}" y="${yM - 6}" text-anchor="middle" font-size="12" font-weight="700" fill="${blad}" font-family="system-ui,sans-serif">${fmt(len)} m</text>`;
      plan.innerHTML = r;
    }

    function update() {
      if (!form) return;
      const fd = new FormData(form);
      const opstInput = form.querySelector<HTMLInputElement>('input[name=opstelling]:checked');
      const opst = String(fd.get('opstelling') || 'hoek');
      const naamOpst = opstInput?.dataset.naam || '';
      const len = Number(fd.get('lengte') || 3.6);
      const w = fd.getAll('wens').map(String);
      const waar = String(fd.get('waar') || '');
      const naam = String(fd.get('naam') || '').trim();
      const plaats = String(fd.get('plaats') || '').trim();
      if (out) out.textContent = `${fmt(len)} m`;
      if (label) label.textContent = `${naamOpst}, ${fmt(len)} m`;
      if (uitleg) uitleg.textContent = opstInput?.dataset.uitleg || '';
      teken(opst, len);
      const regels = [
        `Hallo Good Kitchenstore${naam ? `, ik ben ${naam}` : ''}. Ik denk aan een nieuwe keuken:`,
        `- Opstelling: ${naamOpst.toLowerCase()}`,
        `- Langste wand: ongeveer ${fmt(len)} meter`,
        w.length ? `- Graag ook: ${w.join(', ')}` : '',
        `- Eerste afspraak: ${waar}`,
        plaats ? `- Plaats: ${plaats}` : '',
        'Wanneer komt het jullie uit?',
      ].filter(Boolean);
      const tekst = regels.join('\n');
      if (bericht) bericht.textContent = tekst;
      if (wa) wa.href = WA + encodeURIComponent(tekst);
    }
    form?.addEventListener('input', update);
    form?.addEventListener('change', update);
    form?.addEventListener('submit', (e) => e.preventDefault());
    update();
  </script>
</Base>
