---
import '../styles/global.css';
// Voorladen voorkomt dat de grote Bodoni-kop verspringt als het font binnenkomt (CLS).
import bodoni from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';
import bodoniItalic from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-italic.woff2?url';
import albert from '@fontsource-variable/albert-sans/files/albert-sans-latin-wght-normal.woff2?url';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;
const og = new URL(u('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {voorstel && <meta name="robots" content="noindex, nofollow" />}
  {!voorstel && <link rel="canonical" href="https://www.boskeuken-en-baddesign.nl/" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content="nl_NL" />
  <meta name="theme-color" content="#f2ede5" />
  {[bodoni, bodoniItalic, albert].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('sitemap-index.xml')} />
  {!voorstel && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'HomeAndConstructionBusiness',
      name: 'Bos Keuken- en Baddesign',
      telephone: '+31653129494',
      email: 'info@boskeuken-en-baddesign.nl',
      address: { '@type': 'PostalAddress', streetAddress: 'Nicolaas Beetsstraat 43', postalCode: '3355 ET', addressLocality: 'Papendrecht', addressCountry: 'NL' },
    })} />
  )}
</head>
<body>
  {voorstel && (
    <div class="bg-night text-paper text-xs">
      <p class="mx-auto max-w-[88rem] px-4 sm:px-8 py-2">
        Ontwerpvoorstel van <a class="underline underline-offset-2" href="https://www.sitefront.nl">Sitefront</a> voor Bos Keuken- en Baddesign. Dit is niet de officiële website.
      </p>
    </div>
  )}

  <header class="sticky top-0 z-30 bg-paper/95 backdrop-blur-[2px] border-b border-line">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
      <a href={u()} class="flex items-baseline gap-2 leading-none">
        <span class="display text-[1.9rem] sm:text-[2.2rem]">Bos</span>
        <span class="sr-only min-[400px]:not-sr-only text-xs tracking-[0.14em] uppercase text-ink-soft">Keuken- en Baddesign</span>
      </a>
      <nav aria-label="Hoofdmenu" class="flex items-center gap-6 text-sm">
        <a class="hidden lg:inline hover:text-accent" href={u('#aanbod')}>Aanbod</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#merken')}>Pedini &amp; Scavolini</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#werkwijze')}>Werkwijze</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#contact')}>Contact</a>
        <a href="tel:+31653129494" class="inline-flex items-center gap-2 border border-ink px-3 sm:px-4 py-2 hover:bg-ink hover:text-paper transition-colors">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>
          <span class="whitespace-nowrap">06 53 12 94 94</span>
        </a>
      </nav>
    </div>
  </header>

  <main id="inhoud">
    <slot />
  </main>

  <footer class="bg-night text-paper">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 pt-16 pb-10 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="display text-[2.6rem] leading-none">Bos</p>
        <p class="mt-2 text-xs tracking-[0.14em] uppercase text-night-soft">Keuken- en Baddesign</p>
        <p class="mt-6 max-w-sm text-sm text-night-soft">Keukens en badkamers van Pedini en Scavolini, montage en totale verbouwingen. Vanuit Papendrecht.</p>
      </div>
      <div class="md:col-span-4 text-sm leading-7">
        <p>Nicolaas Beetsstraat 43<br />3355 ET Papendrecht</p>
        <p class="mt-3"><a class="hover:underline" href="tel:+31653129494">06 53 12 94 94</a><br /><a class="hover:underline" href="tel:+31786154262">078 615 42 62</a><br /><a class="hover:underline break-all" href="mailto:info@boskeuken-en-baddesign.nl">info@boskeuken-en-baddesign.nl</a></p>
      </div>
      <div class="md:col-span-3 text-sm leading-7">
        <p><a class="hover:underline" href={u('privacy/')}>Privacyverklaring</a></p>
        <p><a class="hover:underline" href="http://www.bad-en-bubbels.nl/">Bad en Bubbels</a></p>
        <p class="text-night-soft">KvK [[AANLEVEREN: KvK-nummer]]</p>
      </div>
    </div>
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 pb-8">
      <p class="border-t border-ink-soft pt-6 text-xs text-night-soft">© {new Date().getFullYear()} Bos Keuken- en Baddesign</p>
    </div>
  </footer>
</body>
</html>
