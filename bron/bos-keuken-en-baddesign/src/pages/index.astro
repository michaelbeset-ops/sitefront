---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';

const aanbod = [
  { t: 'Keukens', d: 'Complete keukens, maatwerk of losse onderdelen. Klassiek, modern, landelijk of design, in verschillende prijsklassen.' },
  { t: 'Badkamers en toiletruimten', d: 'Nieuwbouw of vervanging, van een complete badkamer tot een losse kraan. Ook hoektoiletten en toiletten met een vermaalsysteem.' },
  { t: 'Meubels', d: 'Woon- en slaapkamermeubels, badkamermeubels en toiletmeubels.' },
  { t: 'Afwerking', d: 'Plafonds met verlichting, vloer- en wandtegels, beton ciré en andere vloer- en wandafwerking.' },
  { t: 'Decoratieve verwarming', d: 'Designradiatoren en andere verwarming die ook gezien mag worden.' },
  { t: 'Apparatuur en sanitair', d: 'Kookplaten, ovens, stoomovens, vaatwassers, koelkasten en afzuigkappen. Kranen, baden, douchecabines, wastafels en toiletten.' },
  { t: 'Montage en verbouwing', d: 'Levering en montage, inclusief leidingwerk en tegelwerk. Tot en met een totale verbouwing, onder begeleiding.' },
];

const stappen = [
  { t: 'U belt of mailt', d: 'Bel 06 53 12 94 94 of 078 615 42 62, of stuur een mail. Dan spreken we een moment af.' },
  { t: 'Huisbezoek', d: 'Gratis en vrijblijvend. Bij u thuis, op de plek waar de keuken of badkamer komt.' },
  { t: 'Ontwerp met prijs', d: 'Meestal binnen één à twee weken ligt er een ontwerp met prijsopgave.' },
  { t: 'Levering en montage', d: 'Door eigen monteurs en vaste vakmensen. Afspraak is afspraak, dus u weet vooraf waar u aan toe bent.' },
];

const soorten = ['Keuken', 'Badkamer', 'Toiletruimte', 'Verbouwing'];
---
<Base
  title="Bos Keuken- en Baddesign | Pedini en Scavolini in Papendrecht"
  description="Italiaanse keukens en badkamers van Pedini en Scavolini, ontworpen bij u thuis. Gratis huisbezoek, ontwerp met prijsopgave meestal binnen één à twee weken."
>
  <!-- HERO: schermvullende foto; gradient van linksonder houdt de tekst leesbaar op elke foto -->
  <section class="relative isolate min-h-[calc(100svh-4rem)] sm:min-h-[calc(100svh-5rem)] flex items-end text-paper bg-night">
    <Foto naam="hero" eager alt="Sfeerbeeld van een lichte designkeuken" sizes="100vw"
      class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(20_17_14/0.88)_0%,rgb(20_17_14/0.55)_45%,rgb(20_17_14/0.15)_80%),linear-gradient(to_right,rgb(20_17_14/0.55),transparent_70%)]"></div>
    <div class="mx-auto w-full max-w-[88rem] px-4 sm:px-8 pt-28 pb-14 sm:pb-20 lg:pb-24">
      <div class="max-w-[46rem]">
        <p class="text-xs tracking-[0.16em] uppercase text-paper/85">Papendrecht · exclusief dealer Pedini en Scavolini</p>
        <h1 class="mt-6 text-4xl">
          Italiaanse keukens en badkamers, ontworpen <em class="text-accent-light">aan uw eigen tafel.</em>
        </h1>
        <p class="mt-8 max-w-[34rem] text-lg text-paper/90 leading-relaxed">
          Theo Bos komt bij u thuis, kijkt naar de ruimte en luistert naar wat u wilt. Daarna maakt hij een ontwerp met prijsopgave, meestal binnen één à twee weken.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="#afspraak" class="inline-flex items-center gap-3 bg-paper text-ink px-6 py-4 text-sm tracking-wide hover:bg-stone transition-colors">
            Plan een gratis huisbezoek
            <svg aria-hidden="true" width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M0 5h16M12 1l4 4-4 4"/></svg>
          </a>
          <a href="tel:+31653129494" class="link-u text-sm">of bel 06 53 12 94 94</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Eerlijke melding: de showroom is dicht, dus het huisbezoek is de hoofdroute -->
  <section aria-labelledby="showroom" class="border-y border-line bg-paper-2">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 py-10 grid gap-4 md:grid-cols-12 md:gap-8">
      <h2 id="showroom" class="md:col-span-4 text-2xl">De showroom krijgt een nieuwe afwerking</h2>
      <div class="md:col-span-7 md:col-start-6 text-ink-soft">
        <p>Vloeren, wanden, plafonds, verlichting, verwarming, koeling en zonnepanelen worden vernieuwd. Daarom is de showroom tijdelijk gesloten. Het magazijn en de werkplaats draaien gewoon door.</p>
        <p class="mt-3 text-ink">We komen graag bij u thuis. Daar komt de keuken of badkamer tenslotte ook te staan.</p>
      </div>
    </div>
  </section>

  <!-- AANBOD: index als catalogus in plaats van kaartjes -->
  <section id="aanbod" aria-labelledby="aanbod-kop" class="mx-auto max-w-[88rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-32">
        <h2 id="aanbod-kop" class="text-3xl">Van keuken tot plafond</h2>
        <p class="mt-6 max-w-sm text-ink-soft">Een keuken en een badkamer of toiletruimte tegelijk? Kan ook. U heeft dan één aanspreekpunt voor het hele project.</p>
        <Foto naam="badkamer-2" alt="Sfeerbeeld van een badkamer met beton ciré" sizes="(min-width: 1024px) 28vw, 100vw"
          class="mt-10 w-full max-w-sm aspect-[4/5] object-cover bg-paper-2" />
      </div>
    </div>
    <ol class="lg:col-span-7 lg:col-start-6 border-t border-ink">
      {aanbod.map((a, i) => (
        <li class="grid grid-cols-[3rem_1fr] sm:grid-cols-[4.5rem_1fr_1.3fr] gap-x-4 gap-y-2 border-b border-line py-6 sm:py-7">
          <span class="display italic text-xl text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-xl sm:text-2xl">{a.t}</h3>
          <p class="col-start-2 sm:col-start-3 text-sm sm:text-base text-ink-soft">{a.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- MERKEN: de twee namen dragen de sectie, typografisch -->
  <section id="merken" aria-labelledby="merken-kop" class="bg-night text-paper">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 py-20 lg:py-28">
      <div class="grid gap-6 md:grid-cols-12">
        <p class="md:col-span-3 text-xs tracking-[0.16em] uppercase text-night-soft">Exclusief dealer voor Nederland en België</p>
        <h2 id="merken-kop" class="md:col-span-8 md:col-start-5 text-3xl">Twee Italiaanse merken, ingepast in uw huis.</h2>
      </div>
      <div class="mt-14 lg:mt-20 border-t border-ink-soft">
        <a href="http://www.pedini.it" class="group flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-ink-soft py-6 sm:py-8">
          <span class="display text-5xl leading-[0.9] group-hover:italic">Pedini</span>
          <span class="text-sm text-night-soft shrink-0">pedini.it ↗</span>
        </a>
        <a href="https://www.scavolini.com" class="group flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-ink-soft py-6 sm:py-8 md:pl-[16%]">
          <span class="display text-5xl leading-[0.9] group-hover:italic">Scavolini</span>
          <span class="text-sm text-night-soft shrink-0">scavolini.com ↗</span>
        </a>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-12 text-sm text-night-soft">
        <p class="md:col-span-4">Bekijk de collecties op de sites van de merken. Bij Bos kiest u wat bij u past, en wordt het op maat bij u thuis ingepast.</p>
        <p class="md:col-span-3 md:col-start-6"><span class="block text-paper mb-1">Sanitair</span>Dealer van Villeroy &amp; Boch.</p>
        <p class="md:col-span-4 md:col-start-9"><span class="block text-paper mb-1">Apparatuur</span>Dealer van Bauknecht, Whirlpool, Bosch, Miele, Neff en Siemens.</p>
      </div>
    </div>
  </section>

  <!-- CITAAT -->
  <section aria-label="Citaat van de eigenaar" class="mx-auto max-w-[88rem] px-4 sm:px-8 py-20 lg:py-28 grid md:grid-cols-12">
    <figure class="md:col-span-9 md:col-start-3">
      <blockquote class="display italic text-4xl">“Bij ons is alles mogelijk.”</blockquote>
      <figcaption class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-soft">
        <span class="h-px w-10 bg-ink"></span>
        <span>Theo Bos, eigenaar</span>
        <span class="text-xs">[[AANLEVEREN: akkoord citaat van Theo Bos]]</span>
      </figcaption>
    </figure>
  </section>

  <!-- WERKWIJZE -->
  <section id="werkwijze" aria-labelledby="werkwijze-kop" class="bg-paper-2 border-y border-line">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 py-20 lg:py-24">
      <h2 id="werkwijze-kop" class="text-3xl max-w-xl">Zo gaat het, van eerste telefoontje tot de laatste tegel</h2>
      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {stappen.map((s, i) => (
          <li class="border-t border-ink pt-5">
            <span class="display italic text-2xl text-accent">{i + 1}</span>
            <h3 class="mt-3 text-xl">{s.t}</h3>
            <p class="mt-3 text-ink-soft">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SFEER: sfeerbeelden, uitdrukkelijk niet als eigen werk van Bos; op mobiel swipen -->
  <section aria-labelledby="werk-kop" class="py-20 lg:py-28">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 flex flex-wrap items-end justify-between gap-4">
      <h2 id="werk-kop" class="text-3xl">Keuken, bad en afwerking</h2>
      <p class="text-sm text-ink-soft">Sfeerbeelden. [[AANLEVEREN: eigen projectfoto's van Bos ter vervanging]]</p>
    </div>
    <div class="mx-auto max-w-[88rem] mt-10 px-4 sm:px-8">
      <div class="flex md:grid md:grid-cols-12 md:grid-rows-2 gap-3 overflow-x-auto md:overflow-visible snap-x snap-mandatory pb-2 md:h-[38rem]" tabindex="0" aria-label="Sfeerbeelden, horizontaal scrollbaar">
        <Foto naam="keuken-1" alt="Sfeerbeeld van een keuken" sizes="(min-width: 768px) 50vw, 82vw"
          class="snap-start shrink-0 w-[82%] md:w-full h-auto md:h-full aspect-[4/5] md:aspect-auto md:col-span-6 md:row-span-2 object-cover bg-paper-2" />
        <Foto naam="badkamer-1" alt="Sfeerbeeld van een badkamer" sizes="(min-width: 768px) 25vw, 82vw"
          class="snap-start shrink-0 w-[82%] md:w-full h-auto md:h-full aspect-[4/5] md:aspect-auto md:col-span-3 object-cover bg-paper-2" />
        <Foto naam="detail-1" alt="Detail van beton ciré en tegelwerk" sizes="(min-width: 768px) 25vw, 82vw"
          class="snap-start shrink-0 w-[82%] md:w-full h-auto md:h-full aspect-[4/5] md:aspect-auto md:col-span-3 object-cover bg-paper-2" />
        <Foto naam="plafond-1" alt="Sfeerbeeld van een plafond met verlichting" sizes="(min-width: 768px) 50vw, 82vw"
          class="snap-start shrink-0 w-[82%] md:w-full h-auto md:h-full aspect-[4/5] md:aspect-auto md:col-span-6 object-cover bg-paper-2" />
      </div>
    </div>
  </section>

  <!-- AFSPRAAK: belangrijkste actie -->
  <section id="afspraak" aria-labelledby="afspraak-kop" class="border-t border-ink">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <h2 id="afspraak-kop" class="text-3xl">Plan een huisbezoek</h2>
        <p class="mt-6 text-ink-soft">Vertel kort wat u zoekt. Theo Bos neemt contact op voor een afspraak. Het bezoek is gratis en vrijblijvend.</p>
        <p class="mt-8 text-sm">Liever direct bellen?</p>
        <p class="mt-1 display text-2xl"><a class="hover:text-accent" href="tel:+31653129494">06 53 12 94 94</a></p>
      </div>

      <form class="lg:col-span-7 lg:col-start-6 grid gap-6 sm:grid-cols-2"
        action={voorstel ? undefined : 'https://api.web3forms.com/submit'}
        method={voorstel ? undefined : 'POST'}
        onsubmit={voorstel ? 'return false' : undefined}>
        {!voorstel && <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-key]]" />}
        {!voorstel && <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />}

        <fieldset class="sm:col-span-2">
          <legend class="text-sm">Waarvoor?</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {soorten.map((s, i) => (
              <label class="cursor-pointer">
                <input type="checkbox" name="soort" value={s} class="peer sr-only" checked={i === 0} />
                <span class="inline-block border border-line px-4 py-2 text-sm peer-checked:bg-ink peer-checked:text-paper peer-checked:border-ink peer-focus-visible:outline-2 peer-focus-visible:outline-accent peer-focus-visible:outline-offset-2">{s}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="grid gap-2 text-sm">Naam
          <input name="naam" autocomplete="name" required class="border-b border-ink bg-transparent py-2 text-base focus:outline-none focus-visible:border-accent focus-visible:outline-offset-4" />
        </label>
        <label class="grid gap-2 text-sm">Woonplaats
          <input name="plaats" autocomplete="address-level2" class="border-b border-ink bg-transparent py-2 text-base focus:outline-none focus-visible:border-accent focus-visible:outline-offset-4" />
        </label>
        <label class="grid gap-2 text-sm">Telefoon
          <input name="telefoon" type="tel" autocomplete="tel" class="border-b border-ink bg-transparent py-2 text-base focus:outline-none focus-visible:border-accent focus-visible:outline-offset-4" />
        </label>
        <label class="grid gap-2 text-sm">E-mail
          <input name="email" type="email" autocomplete="email" required class="border-b border-ink bg-transparent py-2 text-base focus:outline-none focus-visible:border-accent focus-visible:outline-offset-4" />
        </label>
        <label class="grid gap-2 text-sm sm:col-span-2">Wat heeft u in gedachten?
          <textarea name="bericht" rows="4" class="border-b border-ink bg-transparent py-2 text-base resize-y focus:outline-none focus-visible:border-accent focus-visible:outline-offset-4"></textarea>
        </label>

        {voorstel ? (
          <p class="sm:col-span-2 border-l-2 border-accent pl-4 text-sm text-ink-soft">
            Dit is een ontwerpvoorstel, dit formulier verstuurt niets. Bel Bos Keuken- en Baddesign op <a class="text-ink underline" href="tel:+31653129494">06 53 12 94 94</a> of mail naar <a class="text-ink underline break-all" href="mailto:info@boskeuken-en-baddesign.nl">info@boskeuken-en-baddesign.nl</a>.
          </p>
        ) : (
          <div class="sm:col-span-2 flex flex-wrap items-center gap-6">
            <button type="submit" class="bg-ink text-paper px-6 py-4 text-sm tracking-wide hover:bg-accent-deep">Verstuur aanvraag</button>
            <p class="text-xs text-ink-soft">Uw gegevens gebruiken we alleen om contact op te nemen. Zie de <a class="underline" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/privacy/`}>privacyverklaring</a>.</p>
          </div>
        )}
      </form>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" aria-labelledby="contact-kop" class="bg-stone">
    <div class="mx-auto max-w-[88rem] px-4 sm:px-8 py-20 grid gap-10 md:grid-cols-12 md:gap-8">
      <h2 id="contact-kop" class="md:col-span-4 text-3xl">Contact</h2>
      <div class="md:col-span-4 md:col-start-6 leading-7">
        <p>Bos Keuken- en Baddesign<br />Nicolaas Beetsstraat 43<br />3355 ET Papendrecht</p>
        <p class="mt-4"><a class="link-u" href="https://www.google.com/maps/search/?api=1&query=Nicolaas+Beetsstraat+43+Papendrecht">Route in Google Maps</a></p>
        <p class="mt-6 text-sm text-ink-soft">De showroom is tijdelijk gesloten. Magazijn en werkplaats zijn open.</p>
      </div>
      <div class="md:col-span-3 leading-7">
        <p><a class="hover:text-accent" href="tel:+31653129494">06 53 12 94 94</a><br /><a class="hover:text-accent" href="tel:+31786154262">078 615 42 62</a><br /><a class="hover:text-accent break-all" href="mailto:info@boskeuken-en-baddesign.nl">info@boskeuken-en-baddesign.nl</a></p>
        <p class="mt-6 text-sm"><span class="block text-ink-soft">Telefonisch bereikbaar</span>maandag t/m vrijdag<br />08.30 tot 16.30 uur</p>
      </div>
      <p class="md:col-span-8 md:col-start-6 border-t border-ink-soft/40 pt-6 text-sm text-ink-soft">
        Ook iets voor buiten? Zusterbedrijf <a class="text-ink underline" href="http://www.bad-en-bubbels.nl/">Bad en Bubbels</a> levert onder meer buitenkeukens, sauna's, jacuzzi's en tuinmeubelen.
      </p>
    </div>
  </section>
</Base>
