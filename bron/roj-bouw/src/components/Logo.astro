---
// Nagemaakt naar het logo op hun werkshirt: een gouden huis met een tweede huis erin, "ROJ" zwaar en "BOUW" licht.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const tekst = licht ? '#ffffff' : '#292520';
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <svg viewBox="0 0 40 40" class="h-10 w-10 flex-none" aria-hidden="true">
    <path d="M5 35V17.5L20 5l15 12.5V35" fill="none" stroke="#c9a35c" stroke-width="3.2" stroke-linejoin="miter" />
    <path d="M12.5 35V22L20 15.8l7.5 6.2V35" fill="none" stroke="#c9a35c" stroke-width="3.2" stroke-linejoin="miter" />
  </svg>
  <span class="flex flex-col font-body uppercase" style={`color:${tekst}`}>
    <span class="text-[1.4rem] font-extrabold tracking-[0.02em]">Roj</span>
    <span class="-mt-0.5 text-[0.95rem] font-normal tracking-[0.22em]">Bouw</span>
  </span>
</span>
