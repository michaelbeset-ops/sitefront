---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';

// Eigen foto's van het Google-bedrijfsprofiel
import heroFoto from '../assets/hero-stukadoor.jpg';
import keuken from '../assets/keuken.jpg';
import trap from '../assets/trap.jpg';
import hal from '../assets/hal.jpg';
import tijdens from '../assets/tijdens-werk.jpg';
import tijdens2 from '../assets/tijdens-werk-2.jpg';
// Sfeerfoto's (Unsplash)
import stucen from '../assets/stucen.jpg';
import sauzen from '../assets/sauzen.jpg';
import roller from '../assets/roller.jpg';
import woonkamer from '../assets/woonkamer.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const wa = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
const ster = `<svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L10 14.8l-5.2 2.8 1-5.8L1.5 7.7l5.9-.8z"/></svg>`;

// Werkzaamheden: zoals genoemd in hun Google-reviews.
const diensten = [
  { nr: '01', naam: 'Stucwerk van muren en plafonds', tekst: 'Muren en plafonds strak gestuukt.', waar: ['Woonkamer', 'Keuken', 'Badkamer'] },
  { nr: '02', naam: 'Schuren en sauzen', tekst: 'Wanden en plafonds geschuurd en gesausd.', waar: ['Muren', 'Plafonds'] },
  { nr: '03', naam: 'Plafonds witten', tekst: 'Het plafond weer wit.', waar: ['Plafonds'] },
  { nr: '04', naam: 'Binnenschilderwerk', tekst: 'Stukadoor en schilder in één: het stucwerk en het schilderwerk binnen door hetzelfde team.', waar: ['Binnen'] },
];

// Offertehulp: keuzes. Geen prijzen: de klant vraagt een vrijblijvende offerte via WhatsApp.
const ruimtes = ['Woonkamer', 'Keuken', 'Badkamer', 'Slaapkamer', 'Hal of trap', 'Plafond'];
const werken = [
  { id: 'stucen', label: 'Stucen', kort: 'stucen' },
  { id: 'sauzen', label: 'Sauzen of witten', kort: 'sauzen/witten' },
  { id: 'schilderen', label: 'Schilderen', kort: 'schilderen' },
];

// Wat klanten noemen: samengevat uit de Google-reviews (geen citaten, geen namen).
const punten = [
  { kop: 'Strak en netjes afgewerkt', tekst: 'Klanten noemen de afwerking strak en netjes, en na afloop is alles schoon achtergelaten.' },
  { kop: 'Afspraak is afspraak', tekst: 'Afspraken worden nagekomen en het team is precies op tijd. Vooraf zijn de afspraken duidelijk en de communicatie is fijn.' },
  { kop: 'Denkt mee', tekst: 'Er wordt meegedacht met uw wensen, en bij meerwerk is het team flexibel.' },
  { kop: 'Prijs en kwaliteit', tekst: 'Een goede verhouding tussen prijs en kwaliteit. Eigenaar en collega\'s zijn respectvol en vriendelijk.' },
];
---
<Base
  title="Roj Bouw | Stukadoor en schilder in Zwijndrecht"
  description="Roj Bouw uit Zwijndrecht: stucwerk van muren en plafonds, schuren en sauzen, plafonds witten en binnenschilderwerk. 4,8 op Google uit 45 reviews. Vraag via WhatsApp een vrijblijvende offerte."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: licht en strak, eigen foto van de stukadoor in het ROJ BOUW-shirt die over de rand valt. -->
    <section class="relative z-10 bg-paper">
      <div class="absolute inset-y-0 right-0 hidden w-[38%] bg-kalk lg:block" aria-hidden="true"></div>
      <div class="wrap relative grid grid-cols-1 gap-10 pt-10 pb-12 lg:grid-cols-12 lg:gap-8 lg:pt-16 lg:pb-16">
        <div class="lg:col-span-7 lg:pr-6">
          <p class="kicker text-brons">Stukadoor en schilder in {site.plaats}</p>
          <h1 class="mt-5 text-4xl">Strakke muren en plafonds, <em class="text-brons">netjes</em> afgewerkt</h1>
          <figure class="relative mt-7 lg:hidden">
            <div class="aspect-[16/10] overflow-hidden rounded-xl shadow-lg sm:aspect-[16/9]"><Foto src={heroFoto} alt="Onze stukadoor in een wit ROJ BOUW-shirt zet een muur onder de plafondrand strak met een spaan" hero widths={[480, 800, 1200]} sizes="100vw" class="object-[50%_60%]" /></div>
            <figcaption class="absolute right-3 bottom-3 rounded-full bg-paper/95 px-3 py-1 text-sm font-semibold">Eigenaar en collega's, één team</figcaption>
          </figure>
          <p class="mt-6 max-w-xl text-lg text-ink-soft">Stucwerk van muren en plafonds, schuren en sauzen, plafonds witten en binnenschilderwerk. Stukadoor en schilder in één, met een team van eigenaar en collega's.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.whatsapp} class="btn btn-donker"><Fragment set:html={wa} /><span>Stuur een WhatsApp</span></a>
            <a href={site.mobielHref} class="btn btn-line text-ink"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.mobiel}</span></span></a>
          </div>
          <p class="mt-5"><a href="#offerte" class="inline-flex items-center gap-1.5 font-semibold text-brons underline decoration-goud decoration-2 underline-offset-4 transition-colors hover:text-ink">Of stel eerst uw offertevraag samen <Fragment set:html={pijl} /></a></p>
          <dl class="mt-10 grid max-w-2xl grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6 text-sm sm:grid-cols-3">
            <div>
              <dt class="text-ink-soft">Google</dt>
              <dd class="mt-1"><strong class="flex items-center gap-1.5 font-display text-2xl leading-tight font-semibold tabular-nums">{site.google}<span class="text-goud"><Fragment set:html={ster} /></span></strong><span class="text-ink-soft">{site.reviews} reviews</span></dd>
            </div>
            <div>
              <dt class="text-ink-soft">Reviews</dt>
              <dd class="mt-1"><strong class="block font-display text-2xl leading-tight font-semibold">Iedere</strong><span class="text-ink-soft">krijgt van ons een reactie</span></dd>
            </div>
            <div class="col-span-2 sm:col-span-1">
              <dt class="text-ink-soft">Gerund door</dt>
              <dd class="mt-1"><strong class="block font-display text-2xl leading-tight font-semibold">Vrouwelijke</strong><span class="text-ink-soft">ondernemer</span></dd>
            </div>
          </dl>
        </div>
        <div class="relative hidden lg:col-span-5 lg:block">
          <figure class="absolute inset-x-0 top-0">
            <div class="h-[46rem] overflow-hidden rounded-xl shadow-lg">
              <Foto src={heroFoto} alt="Onze stukadoor in een wit ROJ BOUW-shirt zet een muur onder de plafondrand strak met een spaan" widths={[480, 800, 1200]} sizes="500px" />
            </div>
            <figcaption class="absolute -left-10 bottom-14 flex items-center gap-3 rounded-xl bg-white px-4 py-3 shadow-sm">
              <Logo class="scale-90" />
              <span class="border-l border-line pl-3 text-sm leading-snug text-ink-soft">Eigenaar en collega's,<br />één team</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Werkzaamheden: genummerde lijst naast grote sfeerfoto's. -->
    <section id="diensten" class="scroll-mt-20 bg-kalk pt-16 pb-16 lg:pt-28 lg:pb-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-brons">Werkzaamheden</p>
          <h2 class="mt-3 text-3xl">Stukadoor en schilder in één</h2>
          <p class="mt-5 max-w-md text-lg text-ink-soft">Van het stucwerk tot de laatste laag verf: één team voor muren en plafonds, binnen in uw huis.</p>
          <figure class="mt-10">
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[5/6]"><Foto src={stucen} alt="Handen met een spaan en een plamuurmes vol wit stucwerk" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 480px, 100vw" class="object-[40%_50%]" /></div>
          </figure>
        </div>
        <div class="lg:col-span-7 lg:pl-6">
          <ol class="border-b border-line">
            {diensten.map((d) => (
              <li class="grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 border-t border-line py-7 sm:grid-cols-[4.5rem_minmax(0,1fr)]">
                <span class="font-display text-2xl leading-none font-medium text-brons tabular-nums sm:text-3xl">{d.nr}</span>
                <div>
                  <h3 class="text-2xl">{d.naam}</h3>
                  <p class="mt-2 text-ink-soft">{d.tekst}</p>
                  <ul class="mt-4 flex flex-wrap gap-2 text-sm font-semibold">
                    {d.waar.map((w) => <li class="rounded-full bg-paper px-3 py-1 shadow-sm">{w}</li>)}
                  </ul>
                </div>
              </li>
            ))}
          </ol>
          <div class="mt-10 grid gap-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] sm:items-end">
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={sauzen} alt="Een verfroller zet witte saus op een muur" widths={[480, 800]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" /></div>
            <div class="rounded-xl bg-antraciet p-6 text-white shadow-sm">
              <p class="font-display text-xl leading-snug">Welke ruimte, welk werk? Zet het in één bericht bij elkaar.</p>
              <a href="#offerte" class="btn btn-goud mt-5 w-full">Naar de offertehulp <Fragment set:html={pijl} /></a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WOW: offertehulp. Kies ruimte(s) en werk, vul eventueel m² of kamers in, en verstuur een net WhatsApp-bericht. -->
    <section id="offerte" class="donker relative isolate scroll-mt-16 overflow-hidden bg-antraciet py-16 text-white lg:py-24">
      <div class="absolute inset-y-0 right-0 -z-10 hidden w-1/2 opacity-[0.16] lg:block [mask-image:linear-gradient(90deg,transparent,#000_45%)]" aria-hidden="true">
        <Foto src={roller} alt="" widths={[800, 1200]} sizes="50vw" />
      </div>
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-goud">Offertehulp</p>
            <h2 class="mt-3 text-3xl">Wat wilt u laten doen?</h2>
          </div>
          <p class="text-white/85 lg:col-span-5">Kies de ruimte en het werk, vul als u wilt de grootte in, en stuur ons een net WhatsApp-bericht voor een vrijblijvende offerte.</p>
        </div>

        <form class="mt-10 grid gap-8 lg:grid-cols-12" data-oh onsubmit="return false">
          <div class="space-y-8 lg:col-span-7">
            <fieldset>
              <legend class="kicker text-goud">1. Welke ruimte(s)?</legend>
              <div class="mt-4 flex flex-wrap gap-2.5">
                {ruimtes.map((r) => <label class="keus"><input type="checkbox" name="ruimte" value={r} /><span>{r}</span></label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="kicker text-goud">2. Wat moet er gebeuren?</legend>
              <div class="mt-4 flex flex-wrap gap-2.5">
                {werken.map((w) => <label class="keus"><input type="checkbox" name="werk" value={w.kort} /><span>{w.label}</span></label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="kicker text-goud">3. Hoe groot ongeveer? <span class="font-medium tracking-normal normal-case text-white/75">(mag leeg blijven)</span></legend>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="oh-m2" class="text-sm font-semibold">Oppervlakte in m²</label>
                  <input id="oh-m2" name="m2" type="number" inputmode="numeric" min="1" max="2000" placeholder="Bijvoorbeeld 35" class="veld mt-2 tabular-nums" />
                </div>
                <div>
                  <label for="oh-kamers" class="text-sm font-semibold">Aantal kamers</label>
                  <input id="oh-kamers" name="kamers" type="number" inputmode="numeric" min="1" max="50" placeholder="Bijvoorbeeld 2" class="veld mt-2 tabular-nums" />
                </div>
              </div>
              <div class="mt-4">
                <label for="oh-extra" class="text-sm font-semibold">Nog iets dat wij moeten weten?</label>
                <input id="oh-extra" name="extra" type="text" maxlength="200" placeholder="Bijvoorbeeld: liefst in november" class="veld mt-2" />
              </div>
            </fieldset>
          </div>

          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-24">
              <div class="rounded-xl bg-roet p-5 shadow-sm sm:p-6">
                <p class="kicker text-white/75">Uw bericht aan Roj Bouw</p>
                <div class="mt-4 rounded-xl rounded-tr-md bg-paper p-4 text-ink shadow-sm">
                  <p class="text-sm leading-relaxed whitespace-pre-line [overflow-wrap:anywhere]" aria-live="polite" data-oh-tekst>Hallo Roj Bouw, ik wil graag een vrijblijvende offerte.</p>
                </div>
                <p class="mt-3 text-sm text-white/75" data-oh-status>Nog niets gekozen: tik hierboven een ruimte en het werk aan.</p>
                <a href={`${site.whatsapp}?text=${encodeURIComponent('Hallo Roj Bouw, ik wil graag een vrijblijvende offerte.')}`} class="btn btn-goud mt-5 w-full" data-oh-wa><Fragment set:html={wa} /><span>Verstuur via WhatsApp</span></a>
                <p class="mt-4 text-sm text-white/75">U stuurt het bericht zelf vanuit WhatsApp. Liever bellen? <a href={site.mobielHref} class="font-semibold whitespace-nowrap text-white tabular-nums underline underline-offset-2">{site.mobiel}</a></p>
              </div>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- Ons werk: eigen foto's van het Google-profiel. -->
    <section id="werk" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-brons">Ons werk</p>
            <h2 class="mt-3 text-3xl">Tijdens het werk en na afloop</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5">Een greep uit de foto's op ons Google-profiel: een afgewerkte keuken, een trap, een hal en kamers tijdens het werk.</p>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:grid-rows-[15rem_15rem_16rem] lg:gap-5">
          <li class="col-span-2 lg:row-span-2">
            <figure class="relative h-full overflow-hidden rounded-xl shadow-sm">
              <div class="aspect-[4/3] h-full lg:aspect-auto"><Foto src={keuken} alt="Een afgewerkte keuken met strakke witte wanden en verlichting onder de bovenkastjes" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 640px, 100vw" /></div>
              <figcaption class="absolute bottom-3 left-3 rounded-full bg-paper/95 px-3 py-1 text-sm font-semibold">Afgewerkte keuken</figcaption>
            </figure>
          </li>
          <li class="lg:row-span-2">
            <figure class="relative h-full overflow-hidden rounded-xl shadow-sm">
              <div class="aspect-[3/4] h-full lg:aspect-auto"><Foto src={trap} alt="Een trap met houten treden langs een strakke, lichte wand" widths={[400, 800]} sizes="(min-width: 1024px) 300px, 50vw" /></div>
              <figcaption class="absolute bottom-3 left-3 rounded-full bg-paper/95 px-3 py-1 text-sm font-semibold">Trap</figcaption>
            </figure>
          </li>
          <li class="lg:row-span-2">
            <figure class="relative h-full overflow-hidden rounded-xl shadow-sm">
              <div class="aspect-[3/4] h-full lg:aspect-auto"><Foto src={hal} alt="Een hal met een strakke witte wand richting de voordeur" widths={[400, 800]} sizes="(min-width: 1024px) 300px, 50vw" /></div>
              <figcaption class="absolute bottom-3 left-3 rounded-full bg-paper/95 px-3 py-1 text-sm font-semibold">Hal</figcaption>
            </figure>
          </li>
          <li class="col-span-2">
            <figure class="relative h-full overflow-hidden rounded-xl shadow-sm">
              <div class="aspect-[16/9] h-full lg:aspect-auto"><Foto src={tijdens} alt="Een kamer tijdens het werk: gladde witte wanden, een trap en leidingen die nog aangesloten moeten worden" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 640px, 100vw" class="object-[50%_45%]" /></div>
              <figcaption class="absolute bottom-3 left-3 rounded-full bg-paper/95 px-3 py-1 text-sm font-semibold">Tijdens het werk</figcaption>
            </figure>
          </li>
          <li class="col-span-2">
            <div class="flex h-full flex-col justify-between gap-6 rounded-xl bg-kalk p-6 sm:p-7">
              <p class="font-display text-2xl leading-snug">Meer foto's van ons werk staan op ons Google-profiel, samen met de reviews.</p>
              <a href={site.googleLink} rel="noopener" class="inline-flex items-center gap-1.5 self-start font-semibold text-brons underline decoration-goud decoration-2 underline-offset-4 transition-colors hover:text-ink">Bekijk Roj Bouw op Google <Fragment set:html={pijl} /></a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- Wat klanten noemen: samenvatting van de Google-reviews, met de echte score. -->
    <section id="klanten" class="scroll-mt-20 bg-kalk py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker text-brons">Wat klanten noemen</p>
          <h2 class="mt-3 text-3xl">Strak, schoon en op tijd</h2>
          <div class="mt-8 rounded-xl bg-paper p-6 shadow-sm">
            <p class="flex items-end gap-3"><span class="font-display text-[4.5rem] leading-[0.85] font-medium tabular-nums">{site.google}</span><span class="pb-1 text-sm text-ink-soft">uit {site.reviews}<br />Google-reviews</span></p>
            <p class="mt-4 flex gap-0.5 text-goud" aria-hidden="true"><Fragment set:html={ster} /><Fragment set:html={ster} /><Fragment set:html={ster} /><Fragment set:html={ster} /><Fragment set:html={ster} /></p>
            <p class="mt-4 border-t border-line pt-4 font-semibold">Wij reageren op iedere review.</p>
            <a href={site.googleLink} rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brons underline underline-offset-4 transition-colors hover:text-ink">Lees de reviews op Google <Fragment set:html={pijl} /></a>
          </div>
        </div>
        <div class="lg:col-span-8 lg:pl-6">
          <p class="text-ink-soft">Samengevat uit onze reviews op Google.</p>
          <ul class="mt-5 grid gap-5 sm:grid-cols-2">
            {punten.map((p, i) => (
              <li class="rounded-xl border border-line bg-paper p-6 shadow-sm sm:p-7">
                <span class="font-display text-lg text-brons tabular-nums">0{i + 1}</span>
                <h3 class="mt-2 text-xl">{p.kop}</h3>
                <p class="mt-2 text-ink-soft">{p.tekst}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Over Roj Bouw: slogan van het werkshirt, feiten van het Google-profiel. -->
    <section id="over" class="donker scroll-mt-20 bg-antraciet py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="relative lg:col-span-6">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-lg lg:aspect-[5/4]"><Foto src={woonkamer} alt="Een lichte woonkamer met witte wanden, een raam met gordijnen en een bank" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 600px, 100vw" /></div>
          <div class="absolute -bottom-8 right-4 w-[38%] overflow-hidden rounded-xl border-4 border-antraciet shadow-lg lg:-right-8">
            <div class="aspect-[3/4]"><Foto src={tijdens2} alt="Een pas gestuukte witte wand tijdens het werk, met schragen en een trap" widths={[320, 480]} sizes="220px" /></div>
          </div>
        </div>
        <div class="mt-6 lg:col-span-5 lg:col-start-8 lg:mt-0">
          <p class="kicker text-goud">Over Roj Bouw</p>
          <h2 class="mt-3 text-3xl"><em>{site.slogan}</em></h2>
          <p class="mt-6 text-lg text-white/85">Roj Bouw is een team van eigenaar en collega's uit {site.plaats}: stukadoor en schilder in één. De slogan staat op ons werkshirt, naast het gouden huis van ons logo.</p>
          <ul class="mt-8 divide-y divide-white/15 border-y border-white/15">
            <li class="flex items-baseline justify-between gap-4 py-4"><span class="text-white/75">Gerund door</span><strong class="text-right font-semibold">een vrouwelijke ondernemer</strong></li>
            <li class="flex items-baseline justify-between gap-4 py-4"><span class="text-white/75">Op Google</span><strong class="text-right font-semibold">LGBTQ+ vriendelijk</strong></li>
            <li class="flex items-baseline justify-between gap-4 py-4"><span class="text-white/75">Reviews</span><strong class="text-right font-semibold">wij reageren op iedere review</strong></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Contact: WhatsApp-first, bellen, en een formulier dat in voorstelmodus niets verstuurt. -->
    <section id="contact" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-brons">Contact</p>
          <h2 class="mt-3 text-3xl">Vraag een vrijblijvende offerte</h2>
          <p class="mt-5 max-w-xl text-lg text-ink-soft">Stuur een WhatsApp of bel met uw vraag. Roj Bouw werkt vanuit {site.plaats}.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.whatsapp} class="btn btn-donker text-lg !py-4"><Fragment set:html={wa} /><span>WhatsApp <span class="whitespace-nowrap tabular-nums">{site.mobiel}</span></span></a>
            <a href={site.mobielHref} class="btn btn-line text-ink"><Fragment set:html={tel} /><span>Bellen</span></a>
          </div>
          <dl class="mt-10 grid gap-x-8 gap-y-6 border-t border-line pt-8 sm:grid-cols-2">
            <div>
              <dt class="kicker text-brons">Mobiel en WhatsApp</dt>
              <dd class="mt-2"><a href={site.mobielHref} class="text-xl font-semibold whitespace-nowrap tabular-nums underline-offset-4 hover:underline">{site.mobiel}</a></dd>
            </div>
            <div>
              <dt class="kicker text-brons">Tijden</dt>
              <dd class="mt-2"><span class="text-xl font-semibold whitespace-nowrap tabular-nums">07:00 tot 17:00</span><span class="mt-1 block text-sm text-ink-soft">[[AANLEVEREN: op welke dagen]]</span></dd>
            </div>
            <div>
              <dt class="kicker text-brons">Plaats</dt>
              <dd class="mt-2 text-xl font-semibold">{site.plaats}</dd>
            </div>
            <div>
              <dt class="kicker text-brons">Google</dt>
              <dd class="mt-2"><span class="text-xl font-semibold tabular-nums">{site.google}</span> <span class="text-ink-soft">uit {site.reviews} reviews</span></dd>
            </div>
          </dl>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <form class="rounded-xl border border-line bg-kalk p-6 shadow-sm sm:p-8" onsubmit="return false">
            <h3 class="text-2xl">Liever een bericht achterlaten?</h3>
            <div class="mt-6 space-y-4">
              <div><label for="c-naam" class="text-sm font-semibold">Naam</label><input id="c-naam" name="naam" type="text" autocomplete="name" class="veld-licht mt-1.5" /></div>
              <div><label for="c-tel" class="text-sm font-semibold">Telefoonnummer</label><input id="c-tel" name="telefoon" type="tel" autocomplete="tel" class="veld-licht mt-1.5" /></div>
              <div><label for="c-vraag" class="text-sm font-semibold">Wat wilt u laten doen?</label><textarea id="c-vraag" name="vraag" rows="4" class="veld-licht mt-1.5"></textarea></div>
            </div>
            {site.voorstel ? (
              <p class="mt-6 rounded-lg bg-paper p-4 text-sm text-ink-soft">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.mobielHref} class="font-semibold whitespace-nowrap text-ink tabular-nums underline">{site.mobiel}</a> of stuur een <a href={site.whatsapp} class="font-semibold text-ink underline">WhatsApp</a>.</p>
            ) : (
              <button type="submit" class="btn btn-donker mt-6 w-full">Versturen</button>
            )}
          </form>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  // Offertehulp: zonder JS staat er een standaardbericht; met JS bouwt het bericht zich op uit de keuzes.
  const oh = document.querySelector<HTMLFormElement>('[data-oh]');
  if (oh) {
    const tekst = oh.querySelector<HTMLElement>('[data-oh-tekst]')!;
    const status = oh.querySelector<HTMLElement>('[data-oh-status]')!;
    const knop = oh.querySelector<HTMLAnchorElement>('[data-oh-wa]')!;
    const basis = knop.href.split('?')[0];
    const lijst = (a: string[]) => (a.length < 2 ? a.join('') : `${a.slice(0, -1).join(', ')} en ${a[a.length - 1]}`);
    const getal = (v: string) => { const n = Math.round(Number(v)); return v.trim() && n > 0 ? n : 0; };

    const bouw = () => {
      const fd = new FormData(oh);
      const ruimtes = (fd.getAll('ruimte') as string[]).map((r) => r.toLowerCase());
      const werk = fd.getAll('werk') as string[];
      const m2 = getal(String(fd.get('m2') || ''));
      const kamers = getal(String(fd.get('kamers') || ''));
      const extra = String(fd.get('extra') || '').trim();

      const regels = ['Hallo Roj Bouw, ik wil graag een vrijblijvende offerte.'];
      if (werk.length || ruimtes.length) regels.push('');
      if (werk.length) regels.push(`Werk: ${lijst(werk)}`);
      if (ruimtes.length) regels.push(`${ruimtes.length > 1 ? 'Ruimtes' : 'Ruimte'}: ${lijst(ruimtes)}`);
      if (m2) regels.push(`Oppervlakte: ongeveer ${m2} m²`);
      if (kamers) regels.push(`Aantal kamers: ${kamers}`);
      if (extra) regels.push(`Verder: ${extra}`);
      regels.push('', 'Kunt u contact met mij opnemen?');
      const bericht = regels.join('\n');

      tekst.textContent = bericht;
      knop.href = `${basis}?text=${encodeURIComponent(bericht)}`;
      const n = ruimtes.length + werk.length;
      status.textContent = !n
        ? 'Nog niets gekozen: tik hierboven een ruimte en het werk aan.'
        : !werk.length ? 'Kies ook wat er moet gebeuren.'
        : !ruimtes.length ? 'Kies ook de ruimte.'
        : 'Klaar om te versturen. U kunt het bericht in WhatsApp nog aanpassen.';
    };
    oh.addEventListener('input', bouw);
    oh.addEventListener('change', bouw);
    bouw();
  }
</script>
