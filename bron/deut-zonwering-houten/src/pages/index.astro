---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Daklijn from '../components/Daklijn.astro';
import Gevel from '../components/Gevel.astro';
import { site, plaatsen, reviews, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import terras from '../assets/terras.jpg';
import tuinkamer from '../assets/screens-tuinkamer.jpg';
import blauw from '../assets/screens-blauw.jpg';
import gevel from '../assets/screen-gevel.jpg';
import rolluik from '../assets/rolluik.jpg';
import markiezen from '../assets/markiezen.png';
import showroom from '../assets/showroom.jpg';

// Elke regel terug te voeren op hun eigen productpagina's (deutzonwering.nl, bron/web/alle-paginas.txt).
const producten = [
  ['Terras- en knikarmschermen', 'Brede uitval, dus veel schaduw over terras en tuin. Binnen blijft het daardoor ook koeler.'],
  ['Screens', 'Zon en warmte buiten, het zicht naar buiten blijft. Windvast tot 145 km/h.'],
  ['Rolluiken', 'Inbraakvertragend, geluiddempend en isolerend. Met band of koord, een motor van Somfy of Faher, of op zonne-energie zonder boren door de gevel.'],
  ['Markiezen', 'Door de zijschotten houden ze de zon vaak beter tegen dan andere schermen.'],
  ['Uitvalschermen en markisolettes', 'Ze vallen schuin uit de gevel en het vrije zicht blijft. Een markisolette past goed bij hoge ramen.'],
  ['Binnenzonwering', 'Houten jaloezieën met lamellen van 50 mm. De kleurstalen liggen in de showroom.'],
  ['Horren van Unilux', 'Hordeuren en raamhorren, in Nederland gemaakt, met 5 jaar garantie. Wij meten in en monteren.'],
  ['Onderhoud, reparatie en nieuw doek', 'Werkt het scherm nog goed, maar bent u op het doek uitgekeken? Dan vervangen we het doek, naar uw wens.'],
];

const stappen = [
  'We komen vrijblijvend bij u langs voor advies en om in te meten.',
  'Binnen 2 dagen heeft u de offerte.',
  'Akkoord? Dan bestellen we de producten.',
  'Zijn ze binnen, dan plannen we samen het ophangen.',
];

const [willy, ...andere] = reviews;
const waStoring = waMet('Hallo Melvin, ik heb een storing aan mijn zonwering. Het gaat om een ... in ...');
const titel = 'Deut Zonwering | Zonwering op maat in Houten en Nieuwegein';
const omschrijving = 'Terrasschermen, screens, rolluiken, markiezen en horren van Unilux, geleverd en gemonteerd door Deut Zonwering uit Houten. Advies aan huis, binnen 2 dagen een offerte.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. Opening: onder hun eigen terrasscherm, de lijn van licht langs de voorlijst -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-antraciet text-wit">
      <Image quality={66} src={hero} alt="Onderkant van een antraciet terrasscherm boven een tuindeur, met een lichtlijn langs de voorkant" widths={[640, 960, 1440, 2048]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[62%_50%] md:object-[50%_40%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1c1f23b3_0%,#1c1f2333_32%,#1c1f2340_55%,#1c1f23e6_100%)] md:bg-[linear-gradient(90deg,#1c1f23e0_0%,#1c1f2399_42%,#1c1f2310_75%),linear-gradient(0deg,#1c1f23a0_0%,#1c1f2300_40%)]"></div>
      <div class="wrap pb-28 pt-32 md:pb-24">
        <p class="rijs text-[.9375rem] font-semibold text-wit/85">Zonwering op maat, uit Houten</p>
        <h1 class="rijs mt-4 max-w-[13ch] text-hero" style="--d:.08s">Schaduw, <span class="text-blauw-licht">op maat</span> gemonteerd.</h1>
        <p class="rijs mt-6 max-w-[34rem] text-lg text-wit/90 md:text-xl" style="--d:.16s">Terrasschermen, screens, rolluiken, markiezen en horren. We komen vrijblijvend langs voor advies en inmeten, binnen 2 dagen heeft u de offerte.</p>
        <div class="rijs mt-9 flex flex-wrap gap-3" style="--d:.24s">
          <a href="#aanwijzen" class="knop">Offerte aanvragen<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-lijn num hidden sm:inline-flex"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
    </section>

    <!-- 2. Het werk: groot en eerlijk, hun eigen foto's van Facebook en hun portfolio -->
    <section id="werk" class="pt-20 md:pt-28">
      <div class="wrap grid gap-y-8 md:grid-cols-12 md:gap-x-8">
        <h2 class="rijs text-3xl md:col-span-7">Een greep uit ons werk.</h2>
        <p class="rijs max-w-md text-grijs md:col-span-4 md:col-start-9 md:self-end" style="--d:.1s">Geen plaatjes uit een folder: dit hangt bij klanten thuis.</p>
      </div>

      <div class="wrap mt-12 grid gap-4 md:mt-16 md:grid-cols-12 md:gap-5">
        <figure class="rijs md:col-span-8">
          <Image quality={66} src={terras} alt="Antraciet terrasscherm over een terras met loungebank achter een rijtjeshuis" widths={[640, 960, 1400]} sizes="(min-width: 768px) 66vw, 100vw" class="aspect-[16/10] w-full rounded-sm object-cover object-[50%_70%]" />
          <figcaption class="mt-3 text-sm text-grijs">Terrasscherm</figcaption>
        </figure>
        <figure class="rijs md:col-span-4 md:mt-16" style="--d:.1s">
          <Image quality={66} src={blauw} alt="Blauwe screens voor drie ramen van een rijtjeshuis, gezien vanuit de tuin" widths={[480, 800]} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[3/4] w-full rounded-sm object-cover object-[50%_30%]" />
          <figcaption class="mt-3 text-sm text-grijs">Screens</figcaption>
        </figure>

        <figure class="rijs md:col-span-6">
          <Image quality={66} src={tuinkamer} alt="Twee antraciet screens rondom een tuinkamer onder een plat dak" widths={[640, 960, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-[26rem]" />
          <figcaption class="mt-3 text-sm text-grijs">Screens</figcaption>
        </figure>
        <figure class="rijs md:col-span-3 md:mt-14" style="--d:.08s">
          <Image quality={66} src={rolluik} alt="Antraciet rolluik, dicht, in een witte gemetselde gevel" widths={[480, 800]} sizes="(min-width: 768px) 25vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[26rem]" />
          <figcaption class="mt-3 text-sm text-grijs">Rolluik</figcaption>
        </figure>
        <figure class="rijs md:col-span-3" style="--d:.16s">
          <Image quality={66} src={markiezen} alt="Gestreepte markiezen voor de ramen van een rij huizen met een berk ervoor" widths={[480, 800, 1200]} sizes="(min-width: 768px) 25vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[62%_50%] md:aspect-auto md:h-[26rem]" />
          <figcaption class="mt-3 text-sm text-grijs">Markiezen</figcaption>
        </figure>
      </div>
    </section>

    <Daklijn class="mt-20 md:mt-28" />

    <!-- 3. Producten: hun eigen lijst, als regels met maatstreep -->
    <section id="producten" class="pb-24 pt-12 md:pb-28 md:pt-16">
      <div class="wrap grid gap-y-12 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-5">
          <div class="md:sticky md:top-28">
            <h2 class="rijs text-3xl">Wat we leveren en monteren.</h2>
            <p class="rijs mt-5 max-w-sm text-grijs" style="--d:.08s">Voor uw woning of bedrijfspand, op maat en naar uw wensen.</p>
            <Image quality={66} src={gevel} alt="Grijs screen voor een breed raam onder de dakgoot van een bakstenen huis" widths={[480, 800, 1000]} sizes="(min-width: 768px) 38vw, 100vw" class="rijs mt-10 hidden aspect-[4/3] w-full rounded-sm object-cover md:block" />
          </div>
        </div>
        <ul class="md:col-span-7">
          {producten.map(([naam, zin], i) => (
            <li class="regel rijs" style={`--d:${(i % 4) * 0.05}s`}>
              <h3 class="text-2xl">{naam}</h3>
              <p class="text-grijs">{zin}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Wow: wijs op de gevel aan waar het moet komen, en stuur het via WhatsApp -->
    <section id="aanwijzen" class="bg-kalk-2 py-20 md:py-24">
      <div class="wrap">
        <div class="grid gap-y-6 md:grid-cols-12 md:gap-x-8">
          <h2 class="rijs text-3xl md:col-span-7">Wijs aan waar het moet komen.</h2>
          <p class="rijs max-w-md text-grijs md:col-span-5 md:self-end" style="--d:.08s">Tik op de plek, geef ongeveer de breedte op en stuur het via WhatsApp. U krijgt dan een richtprijs, zonder dat er eerst een afspraak nodig is.</p>
        </div>
        <Gevel />
      </div>
    </section>

    <!-- 5. Werkwijze en storing: donker, zoals hun doeken -->
    <section id="service" class="bg-antraciet py-20 text-wit md:py-24">
      <div class="wrap grid gap-y-16 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl">Langs, inmeten, offerte, ophangen.</h2>
          <ol class="mt-10 border-b border-lijn-licht">
            {stappen.map((s, i) => (
              <li class="rijs flex gap-6 border-t border-lijn-licht py-5" style={`--d:${i * 0.06}s`}>
                <span class="breed num w-8 flex-none pt-0.5 text-blauw-licht">{i + 1}</span>
                <span class="text-lg">{s}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rijs rounded-sm bg-staal p-7 md:p-10" style="--d:.1s">
            <h3 class="text-2xl">Storing aan uw zonwering?</h3>
            <p class="mt-4 text-mist">In de regio Houten en Nieuwegein streven we ernaar binnen 48 uur bij u langs te komen.</p>
            <dl class="mt-6 border-b border-lijn-licht text-[.9375rem]">
              <div class="flex justify-between gap-6 border-t border-lijn-licht py-3"><dt class="text-mist">Voorrijden en diagnose</dt><dd class="num text-right font-semibold">€ 150 incl. btw</dd></div>
              <div class="flex justify-between gap-6 border-t border-lijn-licht py-3"><dt class="text-mist">Eerste 30 minuten reparatie</dt><dd class="text-right font-semibold">inbegrepen</dd></div>
              <div class="flex justify-between gap-6 border-t border-lijn-licht py-3"><dt class="text-mist">Onderdelen</dt><dd class="text-right font-semibold">altijd in overleg</dd></div>
            </dl>
            <a href={waStoring} class="knop mt-8 w-full sm:w-auto"><Icoon naam="wa" />Storing melden</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Klanten: één zin die alles zegt, groot; de rest klein -->
    <section class="py-20 md:py-24">
      <div class="wrap">
        <figure class="rijs max-w-5xl">
          <blockquote class="kop text-[clamp(1.75rem,3.4vw+.6rem,3.75rem)] leading-[1.08]">
            <span class="text-blauw">“</span>{willy.tekst.split('. ')[0]}.<span class="text-blauw">”</span>
          </blockquote>
          <figcaption class="mt-6 text-grijs">{willy.naam}, op Google</figcaption>
        </figure>
        <div class="mt-14 grid gap-x-10 gap-y-10 border-t border-lijn pt-10 md:mt-16 md:grid-cols-2 lg:grid-cols-4">
          {andere.map((r, i) => (
            <figure class="rijs" style={`--d:${i * 0.06}s`}>
              <blockquote class="text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <figcaption class="mt-4 text-sm font-semibold text-grijs">{r.naam}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-12 inline-flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" /><span><span class="num">{site.google.score}</span> op Google, {site.google.aantal} reviews</span></p>
      </div>
    </section>

    <!-- 7. Showroom en contact -->
    <section id="showroom" class="pb-20 md:pb-28">
      <div class="wrap grid gap-y-10 md:grid-cols-12 md:gap-x-10">
        <Image quality={66} src={showroom} alt="Showroom van Deut Zonwering met een knikarmscherm aan het plafond, rolluikkasten aan de wand en een screen op een standaard" widths={[640, 960, 1300]} sizes="(min-width: 768px) 55vw, 100vw" class="rijs aspect-[4/3] w-full rounded-sm object-cover md:col-span-7" />
        <div class="md:col-span-5 md:pt-6">
          <h2 class="rijs text-3xl">Showroom aan de Pakketboot.</h2>
          <p class="rijs mt-5 text-grijs" style="--d:.06s">Open op afspraak. Hier ziet u de producten, de bediening en de kleuren. De showroom is op de eerste verdieping, bereikbaar met een trap.</p>
          <ul class="rijs mt-8 border-b border-lijn text-[1.0625rem]" style="--d:.12s">
            <li class="flex items-center justify-between gap-4 border-t border-lijn py-3.5"><span class="text-grijs">Mobiel en WhatsApp</span><a href={site.telHref} class="link num font-semibold">{site.tel}</a></li>
            <li class="flex items-center justify-between gap-4 border-t border-lijn py-3.5"><span class="text-grijs">Telefoon</span><a href={site.vastHref} class="link num font-semibold">{site.vast}</a></li>
            <li class="flex items-center justify-between gap-4 border-t border-lijn py-3.5"><span class="text-grijs">E-mail</span><a href={`mailto:${site.mail}`} class="link break-all text-right font-semibold">{site.mail}</a></li>
            <li class="flex items-start justify-between gap-4 border-t border-lijn py-3.5"><span class="text-grijs">Adres</span><span class="text-right font-semibold">{site.straat}, {site.plaats}<br /><span class="text-sm font-normal text-grijs">achter Pakketboot 38 (Zorgdepot)</span></span></li>
          </ul>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.18s">
            <a href={waMet('Hallo Melvin, ik wil graag een afspraak maken in de showroom.')} class="knop"><Icoon naam="wa" />Afspraak maken</a>
            <a href={site.maps} class="knop knop-wit !shadow-[inset_0_0_0_1.5px_var(--color-inkt)]"><Icoon naam="pin" />Route</a>
          </div>
        </div>
      </div>
      <div class="wrap mt-16 md:mt-20">
        <p class="text-sm font-semibold text-grijs">We komen in</p>
        <p class="breed mt-3 text-[clamp(1.25rem,1.6vw+.8rem,2.25rem)] leading-snug">
          {plaatsen.map((p, i) => <>{i > 0 && <span class="text-blauw" aria-hidden="true"> / </span>}<span class="whitespace-nowrap">{p}</span></>)}
        </p>
      </div>
    </section>
  </main>
  <Voet />
</Base>
