---
// Woordmerk naar hun logo: de puntdaken (hier als één lijn) met "Deut Zonwering" in brede letter.
import { url } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['group inline-flex items-center gap-3 text-current no-underline', cls]} aria-label="Deut Zonwering, naar de homepage">
  <svg viewBox="0 0 44 28" class="h-7 w-auto flex-none" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
    <path d="M2 24 13 9l6.5 8.5L27 6l13 18" />
    <path d="M4 26.5c10-4.5 24-5 37-2.6" class="text-blauw-licht" stroke="currentColor" stroke-width="2.2" />
  </svg>
  <span class="breed text-[1.05rem] font-[750] leading-none tracking-[-0.01em]">Deut Zonwering</span>
</a>
