---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Daklijn from './Daklijn.astro';
const jaar = new Date().getFullYear();
const producten = ['Terrasschermen', 'Screens', 'Rolluiken', 'Markiezen', 'Uitvalschermen', 'Horren van Unilux'];
---
<footer class="bg-antraciet text-mist">
  <Daklijn licht class="pt-10" />
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-wit md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-mist">Advies, montage, onderhoud en reparatie van zonwering, vanuit Houten voor Houten, Nieuwegein en omgeving.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Producten</p>
      <ul class="mt-3 space-y-1">{producten.map((p) => <li><a href={url('#producten')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Showroom</p>
      <p class="mt-3">Open op afspraak</p>
      <p class="mt-4"><a href={site.facebook} class="link link-licht">Facebook</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen Facebook-pagina en huidige website. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
