---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Icoon from '../components/Icoon.astro';
import { site, diensten } from '../data/site';
import hero from '../assets/hero.jpg';
import visgraat from '../assets/visgraat.jpg';
import eiken from '../assets/eiken.jpg';
import kamer from '../assets/kamer.jpg';
---
<Base
  title="S.P.S. vloeren | Slagmolen Parket Service in Barendrecht"
  description="Slagmolen Parket Service uit Barendrecht: alle werkzaamheden aan uw houten vloer en laminaatvloer, en het grondig reinigen van uw stenen vloer. Stuur een foto van uw vloer via WhatsApp."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Tekst links op linnen, de vloer rechts tot de rand: rustig, licht, ambachtelijk. -->
    <section class="relative overflow-hidden">
      <div class="lg:grid lg:min-h-[36rem] lg:grid-cols-12">
        <div class="wrap py-10 md:py-14 lg:col-span-7 lg:mr-0 lg:flex lg:max-w-none lg:flex-col lg:justify-center lg:py-20 lg:pr-12 xl:pl-[max(2rem,calc((100vw-74rem)/2+2rem))]">
          <p class="text-sm font-semibold text-walnut">Barendrecht · hout, laminaat en steen</p>
          <h1 class="mt-3 max-w-[14ch] text-4xl text-ink">Is uw houten vloer toe aan een tweede leven?</h1>
          <p class="mt-5 max-w-xl text-lg text-ink-soft">Slagmolen Parket Service is er voor alle werkzaamheden aan uw houten vloer en laminaatvloer. En voor het grondig reinigen van uw stenen vloer.</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.wa} class="btn btn-walnut"><Icoon soort="wa" />Stuur een foto via WhatsApp</a>
            <a href={site.telHref} class="btn btn-line whitespace-nowrap tabular-nums"><Icoon soort="tel" />Bel {site.tel}</a>
          </div>
          <p class="mt-6 flex items-center gap-2 text-sm text-ink-soft">
            <span class="font-display text-lg font-bold text-ink tabular-nums">5,0</span>
            <span>op Google, 16 reviews</span>
          </p>
        </div>
        <div class="relative aspect-[16/10] lg:col-span-5 lg:aspect-auto">
          <div class="absolute inset-0"><Foto src={hero} alt="Lichte houten plankenvloer die schuin doorloopt langs een witte wand" hero sizes="(min-width: 1024px) 42vw, 100vw" /></div>
        </div>
      </div>
    </section>

    <section id="diensten" class="scroll-mt-20 border-t border-line py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Waar u ons voor belt</h2>
          <p class="mt-4 max-w-md text-ink-soft">Van een houten vloer die geschuurd moet worden tot een stenen vloer die weer schoon moet. Twijfelt u wat uw vloer nodig heeft? Stuur een foto, dan kijken we mee.</p>
          <div class="mt-8 hidden aspect-[4/5] overflow-hidden rounded-xl shadow-sm lg:block"><Foto src={visgraat} alt="Close-up van een glanzende, gelakte visgraatvloer" sizes="(min-width: 1024px) 440px, 100vw" /></div>
        </div>
        <ol class="lg:col-span-7">
          {diensten.map((d, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-x-4 border-t border-line py-7 first:border-t-0 first:pt-0 sm:grid-cols-[4.5rem_1fr] lg:first:pt-2">
              <span class="font-display text-2xl font-bold text-walnut tabular-nums" aria-hidden="true">0{i + 1}</span>
              <div>
                <h3 class="text-xl">{d.naam}</h3>
                <p class="mt-2 text-ink-soft">{d.tekst}</p>
              </div>
            </li>
          ))}
          <li class="mt-2 aspect-[16/10] overflow-hidden rounded-xl shadow-sm lg:hidden" aria-hidden="true"><Foto src={visgraat} alt="" sizes="100vw" /></li>
        </ol>
      </div>
    </section>

    <!-- Uitgelicht project uit hun eigen Facebook-post, typografisch: geen foto die doet alsof het hun werk is. -->
    <section id="project" class="op-donker scroll-mt-20 bg-ink text-white">
      <div class="wrap py-14 lg:py-20">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="text-sm font-semibold text-honey">Uitgelicht project · augustus 2026</p>
            <h2 class="mt-4 text-3xl">Een eiken vloer onder een vergeelde laklaag</h2>
          </div>
          <figure class="lg:col-span-5">
            <div class="aspect-[16/9] overflow-hidden rounded-xl"><Foto src={eiken} alt="Close-up van eiken planken met duidelijke houtnerf" sizes="(min-width: 1024px) 440px, 100vw" /></div>
            <figcaption class="mt-2 text-xs text-white/75">Sfeerfoto van eikenhout, niet van dit project.</figcaption>
          </figure>
        </div>
        <div class="mt-10 grid border-y border-white/20 md:grid-cols-2">
          <div class="py-8 md:border-r md:border-white/20 md:py-10 md:pr-10">
            <p class="font-display text-2xl font-bold text-white/75">Voor</p>
            <p class="mt-3 text-lg text-white/85">Een eiken vloer, verstopt onder een oude laklaag die geel was geworden.</p>
          </div>
          <div class="border-t border-white/20 py-8 md:border-t-0 md:py-10 md:pl-10">
            <p class="font-display text-2xl font-bold text-honey">Na</p>
            <p class="mt-3 text-lg text-white">Grondig geschuurd en behandeld met Royl 2K olie <span class="whitespace-nowrap">(pigment 11)</span>. De vloer ziet er weer als nieuw uit en gaat weer jaren mee.</p>
          </div>
        </div>
        <div class="mt-10 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
          <p class="max-w-lg text-lg text-white/85">Ook een vloer die er moe uitziet? Stuur een foto, dan hoort u wat er mogelijk is.</p>
          <a href={site.wa} class="btn btn-honey self-start md:self-auto"><Icoon soort="wa" />Stuur een foto via WhatsApp</a>
        </div>
      </div>
    </section>

    <section id="werkwijze" class="scroll-mt-20 bg-oak py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="order-2 lg:order-1 lg:col-span-5">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[4/5]"><Foto src={kamer} alt="Woonkamer met een houten vloer, bank en ramen" sizes="(min-width: 1024px) 440px, 100vw" /></div>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-6 lg:col-start-7">
          <h2 class="text-3xl">Eerst uitleg, dan pas aan de slag</h2>
          <ol class="mt-8 space-y-7">
            <li class="border-l-2 border-walnut pl-5">
              <h3 class="text-lg">Stuur een foto of bel</h3>
              <p class="mt-1 text-ink-soft">Een foto van uw vloer via WhatsApp is genoeg om te beginnen. Vrijblijvend.</p>
            </li>
            <li class="border-l-2 border-walnut pl-5">
              <h3 class="text-lg">U hoort de opties en de stappen</h3>
              <p class="mt-1 text-ink-soft">Welke mogelijkheden er zijn voor uw vloer, en wat er stap voor stap gebeurt. Zodat u vooraf weet waar u aan toe bent.</p>
            </li>
            <li class="border-l-2 border-walnut pl-5">
              <h3 class="text-lg">De vloer wordt aangepakt</h3>
              <p class="mt-1 text-ink-soft">Schuren en lakken, schuren en oliën, of grondig reinigen: wat bij uw vloer past.</p>
            </li>
          </ol>
          <dl class="mt-10 grid gap-3 border-t border-line pt-6 text-sm sm:grid-cols-[8rem_1fr]">
            <dt class="font-semibold">Werkgebied</dt><dd class="aanleveren">[[AANLEVEREN: werkgebied]]</dd>
            <dt class="font-semibold">Prijzen</dt><dd class="aanleveren">[[AANLEVEREN: prijzen of prijsindicatie]]</dd>
          </dl>
        </div>
      </div>
    </section>

    <section id="contact" class="op-donker scroll-mt-20 bg-walnut py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Laat uw vloer zien</h2>
          <p class="mt-4 max-w-md text-lg text-white/85">Stuur een foto van uw vloer via WhatsApp, of bel. Dan hoort u wat er mogelijk is.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.wa} class="btn btn-honey"><Icoon soort="wa" />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line-light whitespace-nowrap tabular-nums"><Icoon soort="tel" />Bel {site.tel}</a>
          </div>
        </div>
        <dl class="grid content-start gap-5 lg:col-span-5 lg:col-start-8">
          <div><dt class="text-sm text-white/75">Telefoon en WhatsApp</dt><dd><a href={site.telHref} class="font-display text-2xl font-bold whitespace-nowrap tabular-nums underline decoration-honey decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-white/75">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-honey decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-white/75">Adres</dt><dd><address class="not-italic">{site.straat}<br />{site.postcode} {site.plaats}</address></dd></div>
          <div><dt class="text-sm text-white/75">Tijden</dt><dd>Op afspraak <span class="block text-sm text-white/75">[[AANLEVEREN: openingstijden]]</span></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
