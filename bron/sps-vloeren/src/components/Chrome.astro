---
import { site, url } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-linen/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="shrink-0 font-display text-xl font-bold tracking-[-0.02em] text-walnut no-underline md:text-2xl">S.P.S.<span class="ml-1.5 font-medium text-ink">vloeren</span></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href="#diensten" class="no-underline transition-colors hover:text-walnut">Diensten</a></li>
          <li><a href="#project" class="no-underline transition-colors hover:text-walnut">Project</a></li>
          <li><a href="#werkwijze" class="no-underline transition-colors hover:text-walnut">Werkwijze</a></li>
          <li><a href="#contact" class="no-underline transition-colors hover:text-walnut">Contact</a></li>
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a href={site.telHref} class="hidden text-sm font-semibold no-underline hover:text-walnut sm:inline tabular-nums whitespace-nowrap">{site.tel}</a>
        <a href={site.wa} class="btn btn-walnut !gap-2 !px-3.5 !py-2 text-sm"><Icoon soort="wa" class="h-4 w-4" />WhatsApp</a>
      </div>
    </div>
  </header>
) : (
  <footer class="op-donker bg-ink py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="flex flex-col gap-1 md:text-right">
        <a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a>
        <a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a>
      </p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
