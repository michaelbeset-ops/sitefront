---
// Kleine inline iconen (geen iconfont): chatballon voor WhatsApp, hoorn voor bellen.
interface Props { soort: 'wa' | 'tel'; class?: string }
const { soort, class: cls = 'h-5 w-5' } = Astro.props;
---
{soort === 'wa' ? (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.5-4.3A8.5 8.5 0 1 1 20.5 11.6z"/><path d="M9 9.2c.3 2.4 2.6 4.8 5.2 5.3l1-1.2-1.8-.9-.8.7c-.9-.4-1.8-1.3-2.2-2.2l.7-.8-.9-1.8z" fill="currentColor" stroke-width="1"/></svg>
) : (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5h3.5l1.7 4.3-2.2 1.4a11 11 0 0 0 6.8 6.8l1.4-2.2 4.3 1.7V19a1.5 1.5 0 0 1-1.5 1.5A16.5 16.5 0 0 1 3.5 5 1.5 1.5 0 0 1 5 3.5z"/></svg>
)}
