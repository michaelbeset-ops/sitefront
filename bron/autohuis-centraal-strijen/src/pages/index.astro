    </section>
  </main>
  <Voet />
</Base>

<script>
  // Filter op soort auto.
  const knoppen = document.querySelectorAll<HTMLButtonElement>('[data-filter] button');
  const items = document.querySelectorAll<HTMLElement>('[data-aanbod] > li');
  knoppen.forEach((k) => k.addEventListener('click', () => {
    knoppen.forEach((x) => x.setAttribute('aria-pressed', String(x === k)));
    const s = k.dataset.soort;
    items.forEach((li) => { li.hidden = !!s && li.dataset.soort !== s; });
  }));

  // Tabs in het berichtformulier.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const kies = (naam: string, focus = false) => tabs.forEach((t) => {
    const aan = t.dataset.tab === naam;
    t.setAttribute('aria-selected', String(aan)); t.tabIndex = aan ? 0 : -1;
    const p = document.getElementById(t.getAttribute('aria-controls')!); if (p) p.hidden = !aan;
    if (aan && focus) t.focus();
  });
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => kies(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]; kies(n.dataset.tab!, true);
    });
  });
  document.querySelectorAll<HTMLElement>('[data-tab-open]').forEach((a) => a.addEventListener('click', () => kies(a.dataset.tabOpen!)));

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const tab = tabs.find((t) => t.getAttribute('aria-selected') === 'true')?.dataset.tab;
      const r: string[] = [];
      if (tab === 'zoeken') {
        r.push('Hallo Autohuis Centraal, ik ben op zoek naar een auto.');
        if (v('soort')) r.push('Soort: ' + v('soort'));
        if (v('budget')) r.push('Budget: ' + v('budget'));
        if (v('bak')) r.push('Schakeling: ' + v('bak'));
      } else if (tab === 'werk') {
        r.push('Hallo Autohuis Centraal, ik wil graag een afspraak voor de werkplaats.');
        if (v('werk')) r.push('Waarvoor: ' + v('werk'));
        if (v('model')) r.push('Auto: ' + v('model'));
        if (v('dag')) r.push('Het liefst op: ' + v('dag'));
      } else {
        r.push('Hallo Autohuis Centraal, ik wil mijn auto aanbieden.');
        if (v('vmodel')) r.push('Auto: ' + v('vmodel'));
        if (v('jaar')) r.push('Bouwjaar: ' + v('jaar'));
        if (v('km')) r.push('Kilometerstand: ' + v('km'));
      }
      if (v('wens')) r.push(v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31652380727?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

