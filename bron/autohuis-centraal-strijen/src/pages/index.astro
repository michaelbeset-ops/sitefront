          <p class="mt-6 text-lg text-grijs">Bel of app ons. Of stel hiernaast uw bericht samen: een zoekopdracht, een afspraak voor de werkplaats, of uw auto aanbieden.</p>
          <ul class="mt-10 grid gap-3">
            <li><a href={waHallo} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-brons text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-brons" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-papier text-brons"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Ma t/m vr 9.00 tot 17.00, za tot 14.00</span></span><Icoon naam="pijl" class="h-5 w-5 text-brons" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-sm bg-papier text-brons"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="text-sm text-grijs [overflow-wrap:anywhere] sm:text-base">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 shrink-0 text-brons" /></a></li>
          </ul>
        </div>
        <form class="kaart bg-papier p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw bericht aan Autohuis Centraal</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <div class="mt-7 grid grid-cols-3 gap-1 rounded-sm bg-vloer p-1" role="tablist" aria-label="Waar gaat uw bericht over?">
            <button type="button" role="tab" class="tab" aria-selected="true" aria-controls="p-zoeken" id="t-zoeken" data-tab="zoeken"><span class="sm:hidden">Zoeken</span><span class="hidden sm:inline">Auto zoeken</span></button>
            <button type="button" role="tab" class="tab" aria-selected="false" aria-controls="p-werk" id="t-werk" data-tab="werk" tabindex="-1">Werkplaats</button>
            <button type="button" role="tab" class="tab" aria-selected="false" aria-controls="p-verkopen" id="t-verkopen" data-tab="verkopen" tabindex="-1"><span class="sm:hidden">Verkopen</span><span class="hidden sm:inline">Auto verkopen</span></button>
          </div>

          <div id="p-zoeken" role="tabpanel" aria-labelledby="t-zoeken" class="paneel mt-7 grid gap-5 sm:grid-cols-2">
            <fieldset class="sm:col-span-2">
              <legend class="text-sm font-semibold">Soort auto</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                {['Stadsauto', 'Gezinsauto', 'Stationwagen', 'Cabrio', 'Bedrijfswagen', 'Maakt niet uit'].map((b) => (
                  <label class="keuze"><input type="radio" name="soort" value={b} class="sr-only" /><span>{b}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="block"><span class="text-sm font-semibold">Budget</span>
              <select name="budget" class="veld mt-2"><option value="">Weet ik nog niet</option><option>Tot € 5.000</option><option>€ 5.000 tot € 10.000</option><option>€ 10.000 tot € 15.000</option><option>Boven € 15.000</option></select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Schakeling</span>
              <select name="bak" class="veld mt-2"><option value="">Maakt niet uit</option><option>Handgeschakeld</option><option>Automaat</option></select>
            </label>
          </div>

          <div id="p-werk" role="tabpanel" aria-labelledby="t-werk" class="paneel mt-7 grid gap-5 sm:grid-cols-2" hidden>
            <fieldset class="sm:col-span-2">
              <legend class="text-sm font-semibold">Waarvoor</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                {['APK', 'Onderhoudsbeurt', 'Reparatie', 'Iets anders'].map((b) => (
                  <label class="keuze"><input type="radio" name="werk" value={b} class="sr-only" /><span>{b}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="block"><span class="text-sm font-semibold">Merk en model</span><input name="model" class="veld mt-2" placeholder="Bijvoorbeeld: Peugeot 107" /></label>
            <label class="block"><span class="text-sm font-semibold">Voorkeursdag</span>
              <select name="dag" class="veld mt-2"><option value="">Maakt niet uit</option>{tijden.filter((t) => t.open).map((t) => <option>{t.naam}</option>)}</select>
