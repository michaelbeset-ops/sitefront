  .tab { min-height: 2.75rem; border-radius: .25rem; font-size: .9375rem; font-weight: 600; color: var(--color-grijs); cursor: pointer; transition: background-color .2s, color .2s; padding: 0 .5rem; }
  .tab:hover { color: var(--color-inkt); }
  .tab[aria-selected='true'] { background: var(--color-wit); color: var(--color-inkt); box-shadow: var(--shadow-sm); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-sm); background: var(--color-wit); box-shadow: inset 0 0 0 1px var(--color-lijn); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: var(--color-vloer); }
