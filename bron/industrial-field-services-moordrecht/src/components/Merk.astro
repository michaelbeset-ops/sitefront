---
// Woordmerk naar hun logo: het IFS-tandwiel en INDUSTRIAL FIELD SERVICES met een blauwe streep eronder.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['group inline-flex items-center gap-3 no-underline', licht ? 'text-wit' : 'text-marine', cls]} aria-label="Industrial Field Services, naar de homepage">
  <svg viewBox="0 0 48 48" class="h-11 w-11 flex-none transition-transform duration-700 group-hover:rotate-45" aria-hidden="true">
    <circle cx="24" cy="24" r="20.5" fill="none" stroke="currentColor" stroke-width="4.5" stroke-dasharray="3.2 2.24" />
    <circle cx="24" cy="24" r="17" fill="none" stroke="currentColor" stroke-width="2.6" />
    <text x="24" y="29.2" text-anchor="middle" font-family="Rajdhani, sans-serif" font-weight="700" font-size="15" fill="currentColor" letter-spacing="-.3">IFS</text>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="kop text-[1.0625rem] tracking-[.02em] sm:text-[1.1875rem]">INDUSTRIAL FIELD SERVICES</span>
    <span class="mt-1.5 block h-[3px] w-full bg-blauw"></span>
  </span>
</a>
