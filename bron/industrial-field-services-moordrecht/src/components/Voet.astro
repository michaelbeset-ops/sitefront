---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const diensten = ['Storingen', 'Onderhoud', 'Retrofit machine-besturingen', 'Paneelbouw', 'Ondersteuning'];
---
<footer class="bg-marine text-mist">
  <div class="klemmen" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Besturingstechniek voor de industrie en machinebouw. PLC, HMI en SCADA, vanuit Moordrecht.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Diensten</p>
      <ul class="mt-3 space-y-1">{diensten.map((d) => <li><a href={url('#diensten')} class="link link-licht no-underline hover:underline">{d}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Bereikbaar</p>
      <p class="mt-3 num">ma t/m do 07:00-17:00<br />vr 07:00-12:00</p>
      <p class="mt-4"><a href={site.linkedin} class="link link-licht">LinkedIn</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Industrial Field Services IFS, {site.plaats} · KvK {site.kvk} · VCA VOL</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen Google-bedrijfsprofiel (Van eigenaar) en huidige website. Teksten op basis van industrialfieldservices.nl.</p>}
</footer>
