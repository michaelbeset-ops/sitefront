---
import { url, waStandaard, site } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<header class="donker sticky top-0 z-40 border-b border-lijn-licht bg-zwart text-licht">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <a href={url('')} class="merk">
      <b>DAMDORP</b> <small class="hidden min-[360px]:inline">Barbershop</small>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden md:block">
      <ul class="ui flex gap-9">
        <li><a href={h('werk')} class="lijn-in">Werk</a></li>
        <li><a href={h('zaak')} class="lijn-in">De zaak</a></li>
        <li><a href={h('tijden')} class="lijn-in">Tijden en route</a></li>
      </ul>
    </nav>
    <p class="ui flex items-center gap-8">
      <a href={site.telHref} class="lijn-in num hidden lg:inline">{site.tel}</a>
      <a href={waStandaard} class="lijn-in text-licht">WhatsApp</a>
    </p>
  </div>
</header>
