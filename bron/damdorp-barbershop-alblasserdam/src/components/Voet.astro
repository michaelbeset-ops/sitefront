---
import { site, url, waStandaard } from '../data/site';
---
<footer class="donker bg-zwart text-licht" aria-label="Contact en gegevens">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 pb-12 pt-24 text-sm lg:grid-cols-12 lg:gap-x-8 lg:pt-32">
    <div class="col-span-2 sm:col-span-1 lg:col-span-4">
      <p class="ui text-licht-zacht">Adres</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-licht-zacht">{site.centrum}</span></p>
      <a href={site.maps} class="lijn mt-4 inline-block">Route in Google Maps</a>
    </div>
    <div class="lg:col-span-3">
      <p class="ui text-licht-zacht">Contact</p>
      <p class="mt-4 space-y-1">
        <a href={waStandaard} class="lijn-in block w-fit">WhatsApp</a>
        <a href={site.telHref} class="lijn-in num block w-fit">{site.tel}</a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="ui text-licht-zacht">Volgen</p>
      <p class="mt-4 space-y-1">
        <a href={site.instagram} class="lijn-in block w-fit">Instagram</a>
        <a href={site.facebook} class="lijn-in block w-fit">Facebook</a>
      </p>
    </div>
    <div class="lg:col-span-2">
      <p class="ui text-licht-zacht">Open</p>
      <p class="mt-4">Di t/m za<br /><span class="text-licht-zacht">Zo en ma gesloten</span></p>
    </div>
  </div>

  <div class="wrap overflow-hidden" aria-hidden="true">
    <svg class="voetmerk" viewBox="0 0 1000 170" role="presentation" focusable="false"><text x="500" y="150" text-anchor="middle" textLength="1000" lengthAdjust="spacingAndGlyphs">DAMDORP</text></svg>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p>{site.naam}, {site.plaats}. KvK {site.kvk}</p>
    <p><a href={url('privacy/')} class="lijn-in">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Logo van uw Google-bedrijfsprofiel, foto’s van uw Instagram en een sfeerfoto via Unsplash (bovenaan), ter illustratie.</p>}
</footer>

<style>
  .voetmerk { display: block; width: 100%; height: auto; margin-top: 1rem; }
  .voetmerk text { font-family: var(--font-sans); font-size: 190px; font-weight: 760; font-stretch: 75%; fill: var(--color-licht); fill-opacity: .09; }
</style>
