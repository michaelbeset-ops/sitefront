  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: 2px; background: var(--color-papier); }
  .status-pil .status-stip { background: #8f8a83; }
  .status-pil[data-open='true'] .status-stip { background: #2f9e67; }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1rem; border-radius: 2px; background: var(--color-papier); box-shadow: inset 0 0 0 1px var(--color-lijn); font-size: .9375rem; font-weight: 600; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: var(--color-vlak); }
  .keuze input:checked + span { background: var(--color-rood); color: #fff; box-shadow: none; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-rood); outline-offset: 2px; }
  .veld { display: block; width: 100%; min-height: 3rem; border-radius: 2px; border: 1.5px solid #12121233; background: #fff; padding: .65rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #12121266; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-rood); }
</style>
