---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Wa from '../components/Wa.astro';
import { site, tijden, waStandaard } from '../data/site';
import hero from '../assets/hero-mes.jpg';
import krullen from '../assets/ig-2.jpg';
import scheiding from '../assets/ig-10.jpg';
import achterover from '../assets/ig-3.jpg';
import rood from '../assets/ig-12.jpg';
import golven from '../assets/ig-11.jpg';
import zaak from '../assets/ig-9.jpg';
import karren from '../assets/ig-7.jpg';
import logo from '../assets/logo-wit.png';

// Werk: foto's van hun Instagram @damdorpbarbershop. Bijschriften beschrijven alleen wat er te zien is.
const klein = [
  { src: scheiding, alt: 'Achterhoofd met een fade en een geschoren scheiding', bij: 'Fade met scheiding' },
  { src: achterover, alt: 'Zijkant van een kapsel: kort opgeschoren, bovenop lang en naar achteren', bij: 'Naar achteren, kort opzij' },
];
const onder = [
  { src: golven, alt: 'Kort geknipt hoofd van bovenaf, met een golvend patroon in het haar', bij: 'Golven, van boven' },
  { src: rood, alt: 'Achterhoofd met een fade, op de achtergrond de rode muur van de zaak', bij: 'Fade, voor de rode muur' },
];
---
<Base title={`${site.naam} | Barbershop in het Makado-Center, Alblasserdam`} description="Damdorp Barbershop in het Makado-Center in Alblasserdam. Open van dinsdag tot en met zaterdag, vrijdag tot 21:00. Stuur een WhatsApp voor een plek in de stoel.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Eerste scherm: volle hoogte, één beeld -->
    <section class="donker relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col justify-end overflow-hidden bg-zwart text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 1024, 1440, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[78%_50%] md:object-[60%_50%]" />
      <div class="hero-sluier absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="wrap pb-10 pt-40 md:pb-14">
        <h1 id="t-hero" class="text-3xl" lang="en">Making people <br class="hidden sm:block" />look good.</h1>
        <div class="mt-8 grid gap-10 md:mt-10 md:grid-cols-12 md:items-end md:gap-8">
          <p class="max-w-[26rem] text-licht-zacht md:col-span-5">Barbershop in het Makado-Center in Alblasserdam. Stuur een appje en vraag wanneer u in de stoel kunt.</p>
          <div class="flex flex-wrap items-center gap-x-9 gap-y-5 md:col-span-7 md:justify-end">
            <a href={waStandaard} class="knop knop-vol"><Wa />Stuur een WhatsApp</a>
            <a href="#tijden" class="lijn text-sm">Tijden en route</a>
          </div>
        </div>
        <p class="ui mt-14 flex flex-wrap justify-between gap-x-8 gap-y-2 border-t border-lijn-licht pt-5 text-licht-zacht md:mt-20">
          <span>{site.straat}, {site.plaats}</span>
          <span>Di t/m za open</span>
        </p>
      </div>
    </section>

    <!-- 2. Werk -->
    <section id="werk" aria-labelledby="t-werk">
      <div class="wrap grid gap-y-14 py-24 md:grid-cols-12 md:gap-x-8 lg:py-40">
        <div class="rijs md:col-span-4 md:sticky md:top-28 md:self-start">
          <h2 id="t-werk" class="text-2xl">Uit de stoel.</h2>
          <p class="mt-6 max-w-xs text-grijs">Fades, krullen, een strakke scheiding. Een greep uit wat Damdorp op Instagram laat zien.</p>
          <a href={site.instagram} class="lijn mt-8 inline-block text-sm">@damdorpbarbershop</a>
        </div>
        <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 md:col-span-8 md:grid-cols-6">
          <figure class="rijs col-span-2 md:col-span-4">
            <Image src={krullen} alt="Achterhoofd met krullen bovenop en een korte, verlopen zijkant" widths={[400, 640]} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-square w-full bg-vlak object-cover" />
            <figcaption class="mt-3 text-xs text-grijs">Krullen, kort verlopen</figcaption>
          </figure>
          <div class="col-span-2 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 md:col-span-2 md:grid-cols-1 md:content-between">
            {klein.map((f, i) => (
              <figure class="rijs" style={`--d:${0.08 + i * 0.06}s`}>
                <Image src={f.src} alt={f.alt} widths={[320, 640]} sizes="(min-width: 768px) 20vw, 50vw" class="aspect-square w-full bg-vlak object-cover" />
                <figcaption class="mt-3 text-xs text-grijs">{f.bij}</figcaption>
              </figure>
            ))}
          </div>
          {onder.map((f, i) => (
            <figure class={`rijs md:col-span-3 ${i === 0 ? 'md:mt-10' : ''}`} style={`--d:${i * 0.06}s`}>
              <Image src={f.src} alt={f.alt} widths={[320, 640]} sizes="(min-width: 768px) 32vw, 50vw" class="aspect-square w-full bg-vlak object-cover" />
              <figcaption class="mt-3 text-xs text-grijs">{f.bij}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. De zaak -->
    <section id="zaak" class="donker bg-zwart text-licht" aria-labelledby="t-zaak">
      <div class="wrap grid gap-y-14 py-24 md:grid-cols-12 md:items-center md:gap-x-8 lg:py-40">
        <figure class="rijs md:col-span-6">
          <Image src={zaak} alt="Zwarte kappersstoelen op een zwart-wit geblokte vloer, met rode gereedschapskarren langs de muur" widths={[400, 640]} sizes="(min-width: 768px) 45vw, 100vw" class="aspect-[4/5] w-full object-cover" />
          <figcaption class="mt-3 text-xs text-licht-zacht">Foto van @damdorpbarbershop</figcaption>
        </figure>
        <div class="rijs md:col-span-5 md:col-start-8" style="--d:.08s">
          <Image src={logo} alt="Logo van Damdorp Barbershop: twee gekruiste scheermessen boven een scheerkom" widths={[160, 320]} sizes="10rem" class="h-auto w-28 md:w-36" />
          <h2 id="t-zaak" class="mt-12 text-2xl">Een praatje, koffie, en dan de stoel in.</h2>
          <p class="mt-6 max-w-md text-licht-zacht">Een kapperszaak voor heren met tijd voor een praatje en een kop koffie, voor een schappelijke prijs. Zo omschrijven klanten Damdorp op Google.</p>
          <p class="mt-10 border-t border-lijn-licht pt-5 text-sm">De enige, echte Damdorp Barbershop.</p>
          <p class="mt-2 text-xs text-licht-zacht"><span class="num">{site.google.score}</span> op Google uit {site.google.aantal} reviews, {site.facebookAanbevolen.pct} aanbevolen op Facebook ({site.facebookAanbevolen.aantal})</p>
        </div>
      </div>
    </section>

    <div class="tegels" aria-hidden="true"></div>

    <!-- 4. Tijden en route, met de dagkeuze voor WhatsApp -->
    <section id="tijden" aria-labelledby="t-tijden">
      <div class="wrap grid gap-y-16 py-24 md:grid-cols-12 md:gap-x-8 lg:py-40">
        <div class="md:col-span-6 lg:col-span-5">
          <h2 id="t-tijden" class="rijs text-2xl">Dinsdag tot en met zaterdag open.</h2>
          <p class="rijs mt-6 max-w-sm text-grijs">Tik op een dag en vraag via WhatsApp of er plek is.</p>

          <ul class="rijs mt-12 border-t border-lijn" data-dagen>
            {tijden.map((t, i) => ({ ...t, i })).slice(1).concat({ ...tijden[0], i: 0 }).map((t) => (
              <li class="border-b border-lijn">
                {t.open ? (
                  <button type="button" class="dag" data-dag={t.i} aria-pressed="false">
                    <span class="dag-naam">{t.dag}<em data-vandaag hidden> vandaag</em></span>
                    <span class="num whitespace-nowrap">{t.open} – {t.dicht}</span>
                  </button>
                ) : (
                  <p class="dag dag-dicht" data-dag={t.i}>
                    <span class="dag-naam">{t.dag}<em data-vandaag hidden> vandaag</em></span>
                    <span>gesloten</span>
                  </p>
                )}
              </li>
            ))}
          </ul>

          <a href={waStandaard} class="knop knop-vol rijs mt-10 w-full sm:w-auto" data-wa-dag><Wa /><span data-wa-tekst>Stuur een WhatsApp</span></a>
        </div>

        <div class="md:col-span-5 md:col-start-8 md:pt-2">
          <figure class="rijs mb-14">
            <Image src={karren} alt="Kappersstoelen op een geblokte vloer, met rode gereedschapskarren en een leren bank" widths={[400, 640]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[3/2] w-full bg-vlak object-cover" />
            <figcaption class="mt-3 text-xs text-grijs">Foto van @damdorpbarbershop</figcaption>
          </figure>
          <p class="ui text-grijs">Adres</p>
          <p class="mt-5 text-xl" style="font-stretch: 85%; font-weight: 640; line-height: 1.15">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-3 text-grijs">In {site.centrum}.</p>
          <p class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
            <a href={site.maps} class="lijn">Route in Google Maps</a>
            <a href={site.telHref} class="lijn num whitespace-nowrap">Bel {site.tel}</a>
          </p>

          <p class="ui mt-16 text-grijs">Prijzen</p>
          <p class="mt-5 text-sm text-grijs">Prijzen? Stuur even een appje.</p>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { tijden, waMet } from '../data/site';
  const knop = document.querySelector<HTMLAnchorElement>('[data-wa-dag]');
  const label = document.querySelector<HTMLElement>('[data-wa-tekst]');
  const knoppen = [...document.querySelectorAll<HTMLButtonElement>('button[data-dag]')];
  const vandaag = new Date().getDay();
  document.querySelectorAll<HTMLElement>(`[data-dag="${vandaag}"] [data-vandaag]`).forEach((el) => (el.hidden = false));
  const kies = (i: number) => {
    const t = tijden[i];
    knoppen.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.dag) === i)));
    const wanneer = i === vandaag ? `vandaag (${t.dag})` : t.dag;
    if (knop) knop.href = waMet(`Hoi Damdorp, kan ik ${wanneer} langskomen om te knippen? Hoe laat komt het uit?`);
    if (label) label.textContent = i === vandaag ? 'Vraag naar vandaag' : `Vraag naar ${t.dag}`;
  };
  let start = vandaag;
  for (let n = 0; n < 7 && !tijden[start].open; n++) start = (start + 1) % 7;
  kies(start);
  knoppen.forEach((b) => b.addEventListener('click', () => kies(Number(b.dataset.dag))));
</script>

<style>
  .hero-sluier { background: #0d0d0d8c; }
  @media (min-width: 768px) {
    .hero-sluier { background: linear-gradient(90deg, #0d0d0de6 0%, #0d0d0d99 38%, #0d0d0d1a 70%), linear-gradient(0deg, #0d0d0dcc 0%, #0d0d0d00 45%); }
  }
  .dag { display: flex; width: 100%; align-items: baseline; justify-content: space-between; gap: 1.5rem; padding: 1rem .25rem; text-align: left; font: inherit; color: inherit; background: none; border: 0; }
  button.dag { cursor: pointer; transition: background-color .3s var(--ease-zacht), padding .3s var(--ease-zacht); }
  button.dag:hover { background: var(--color-vlak); }
  button.dag[aria-pressed="true"] { background: var(--color-zwart); color: var(--color-wit); padding-inline: 1rem; }
  .dag-naam { text-transform: capitalize; }
  .dag-naam em { font-style: normal; font-size: var(--text-micro); letter-spacing: .16em; text-transform: uppercase; color: var(--color-rood); margin-left: .5rem; }
  button.dag[aria-pressed="true"] .dag-naam em { color: var(--color-rood-licht); }
  .dag-dicht { color: var(--color-grijs); }
</style>
