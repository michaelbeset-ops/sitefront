---
// Naar hun eigen logo: drie groene cirkels met witte pictogrammen (constructie, trekker, tuin en park),
// daaronder/ernaast "Gebr. Heemskerk bv" en in kleine kapitalen "Mechanisatie en constructie".
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const wit = '#ffffff';
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <span class="sr-only">Gebr. Heemskerk bv, mechanisatie en constructie</span>
  <svg viewBox="0 0 78 26" class="hidden h-[22px] w-[66px] flex-none min-[360px]:block sm:h-[26px] sm:w-[78px]" aria-hidden="true">
    <g fill="#6cb33f"><circle cx="13" cy="13" r="12.5" /><circle cx="39" cy="13" r="12.5" /><circle cx="65" cy="13" r="12.5" /></g>
    <g fill="none" stroke={wit} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <!-- constructie: lasbrander met vonken op een balk -->
      <path d="M6 18.5h13M9 7.5l5.5 8M12.2 16.5l1.6-.6" />
      <path d="M16.5 11.5l2-1.5M17.2 14l2.4-.4M14.5 10l.6-2.2" stroke-width="1.3" />
      <!-- trekker -->
      <circle cx="35" cy="16" r="4.2" /><circle cx="45.2" cy="17.6" r="2.4" />
      <path d="M32.5 11.6V6.2h5.2l1.3 5.8h5.6l.9 3.4M39 12h-2" />
      <!-- zitmaaier -->
      <circle cx="59.5" cy="18.4" r="2" /><circle cx="70.5" cy="18.4" r="2" />
      <path d="M57.5 15h15M61 15l1.5-5h3.5M66 10l2.5-2.6M66 10v5" />
      <circle cx="63.5" cy="6.8" r="1.5" fill={wit} stroke="none" />
    </g>
  </svg>
  <span aria-hidden="true" class="flex flex-col">
    <span class={`whitespace-nowrap text-[1.1rem] font-bold tracking-[-0.02em] sm:text-[1.28rem] ${licht ? 'text-white' : 'text-ink'}`}>Gebr. Heemskerk <span class="font-semibold">bv</span></span>
    <span class={`mt-[3px] whitespace-nowrap text-[0.52rem] font-bold tracking-[0.16em] uppercase sm:text-[0.58rem] sm:tracking-[0.2em] ${licht ? 'text-plaat' : 'text-staal'}`}>Mechanisatie en constructie</span>
  </span>
</span>
