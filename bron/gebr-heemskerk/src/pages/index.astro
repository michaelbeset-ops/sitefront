---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site } from '../data/site';
import heroFoto from '../assets/hero-akker.jpg';
import luchtfoto from '../assets/eigen15.jpg';
import snijbrander from '../assets/snijbrander.jpg';
import plasma from '../assets/eigen01.jpg';
import cabine from '../assets/eigen02.jpg';
import oprichters from '../assets/eigen03.jpg';
import team from '../assets/eigen09.jpg';
import lasser from '../assets/eigen10.jpg';
import busSpuit from '../assets/eigen13.jpg';
import busMaaier from '../assets/eigen14.jpg';
import e11trap from '../assets/eigen11-trap.jpg';
import e11bak from '../assets/eigen11-bak.jpg';
import e11plasma from '../assets/eigen11-plasma.jpg';
import e16 from '../assets/eigen16.jpg';
import e18 from '../assets/eigen18.jpg';
import e19 from '../assets/eigen19.jpg';
import e20 from '../assets/eigen20.jpg';
import e21 from '../assets/eigen21.jpg';
import e23 from '../assets/eigen23.jpg';
import e24 from '../assets/eigen24.jpg';
import e25 from '../assets/eigen25.jpg';
import e26 from '../assets/eigen26.jpg';
import e27 from '../assets/eigen27.jpg';
import e29 from '../assets/eigen29.jpg';
import e30 from '../assets/eigen30.jpg';
import e31 from '../assets/eigen31.jpg';
import e32 from '../assets/eigen32.jpg';
import e34 from '../assets/eigen34.jpg';
import e35 from '../assets/eigen35.jpg';
import e36 from '../assets/eigen36.jpg';
import e38 from '../assets/eigen38.jpg';
import e39 from '../assets/eigen39.jpg';
import e40 from '../assets/eigen40.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const wa = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

// Mechanisatie: pagina's land- en tuinbouw, tuin en park, service op locatie, occasions.
const mechanisatie = [
  { kop: 'Land- en tuinbouw', tekst: 'In onze werkplaats werken gecertificeerde monteurs elke dag aan klantspecifieke reparaties en oplossingen. Wij zijn bevoegd certificeringsbedrijf voor veldspuiten en kunnen vermogenstests afnemen.' },
  { kop: 'Tuin en park', tekst: 'Als dealer van Husqvarna hebben wij een uitgebreid programma maaiers, kettingzagen, bladblazers en heggenscharen. Ook leveren wij palenboren, veegmachines en trilplaten. Voor professional én hobbyist: kom gerust eens langs in onze winkel voor een advies op maat.' },
  { kop: 'Reparatie', tekst: 'Ook voor de reparatie van uw bladblazer of bosmaaier bent u bij ons aan het juiste adres. Geen uitdaging is te gek.' },
  { kop: 'Onderdelen', tekst: 'Naast onze merken kunt u bij Gebr. Heemskerk ook terecht voor onderdelen van het merk Renault.' },
];

// Merken: pagina "Merken", ingekort maar zonder iets toe te voegen.
const merken = [
  { naam: 'Claas', tekst: 'Marktleider in oogstmachines. Van maaimachines tot hakselaars en van verreikers tot balenpersen.' },
  { naam: 'Amazone', tekst: 'Het complete aanbod: van cultivatoren tot schijvenstrooiers en veldspuiten op GPS.' },
  { naam: 'Kaweco', tekst: 'Nederlandse fabrikant van bemesters en silagewagens, compleet in Nederland gefabriceerd.' },
  { naam: 'Kioti', tekst: 'Compacttractoren met simpele, robuuste techniek. Al vanaf 26 pk een passende tractor.' },
  { naam: 'Monosem', tekst: 'Precisiezaaimachines, pneumatisch of elektrisch, met GPS en ISOBUS. Van 4 tot 30 rijen.' },
  { naam: 'Quappen', tekst: 'Mini laadschoppen en knikladers met een bijzonder groot hefvermogen.' },
  { naam: 'Trioliet', tekst: 'Voersystemen in alle soorten en maten, begonnen met kuilvoersnijders.' },
  { naam: 'Weed-IT', tekst: 'Computergestuurde onkruidbestrijding op verharding: spuit alleen waar onkruid staat.' },
  { naam: 'Wifo', tekst: 'Kistenkantelaars, schepbakken, balenklemmen, hefmasten en palletdragers.' },
  { naam: 'Thermobile', tekst: 'Kachels in alle soorten en maten, luchtontvochtigers en koelsystemen.' },
  { naam: 'Husqvarna', tekst: 'Maaiers, kettingzagen, bladblazers en heggenscharen voor tuin en park.' },
];

// Pagina "Recent afgeleverd" (een selectie, letterlijk).
const afgeleverd = [
  { wie: 'Van der Maarl, Boesingheliede', wat: 'Amazone UX 5200 Super met 34 meter spuitbreedte' },
  { wie: 'Gebroeders Ham, Nieuw-Vennep', wat: 'Een nieuwe Claas Arion 650 C-MATIC' },
  { wie: 'Willem van der Spek Flowers, Sassenheim', wat: 'Kioti CS 2610' },
  { wie: 'Loonbedrijf van der Post, Aarlanderveen', wat: 'Twee Kaweco Radium 45 silagewagens' },
  { wie: 'Van Ruiten, Kaag', wat: 'Claas Arion 430 CIS met FL 120 voorlader en Zuidberg fronthef en PTO' },
  { wie: 'Loonbedrijf van der Kraan en Spaan, Leidschendam', wat: 'Claas Axion 850 Cebis' },
  { wie: 'Jaap en Klaas van Dijk, Voorhout', wat: 'Amazone ZA-M 1001 Special Profis' },
  { wie: 'Verhuur- en aannemersbedrijf P. Vos, Alphen aan den Rijn', wat: 'Kaweco Profi 2.18' },
];

// Constructie: pagina's constructie, over ons en projecten.
const opdrachtgevers = [
  'Brandtrap en bordes voor de luchtschacht van de Velsertunnel',
  'Calamiteitencontainer ingericht voor politie Haaglanden',
  'Vliegtuigbandenkar en bandenrek voor Arke Fly op Schiphol',
  'Complete blusopbouw op een BMW-motorfiets',
  'Trap maken en plaatsen in de Villa Arena',
  'Valbeveiliging voor de gemeente Bloemendaal',
];

// Projectengalerij: elke foto hoort bij het onderschrift op hun projectenpagina (zelfde volgorde en bestandsnamen).
const categorieen = [
  { id: 'machines', naam: 'Machines en werktuigen' },
  { id: 'trappen', naam: 'Trappen en bordessen' },
  { id: 'hekwerk', naam: 'Hekwerk en beveiliging' },
  { id: 'bakken', naam: 'Bakken en inrichting' },
];
const projecten = [
  { src: e16, cat: 'machines', kop: 'Onkruidborstel, pasgemaakt aan de Holder', bij: 'Van der Luit Groenbeheer', alt: 'Een oranje Holder werktuigdrager met een onkruidborstel aan de voorkant' },
  { src: e18, cat: 'trappen', kop: 'Brandtrap en bordes voor de luchtschacht', bij: 'Velsertunnel', alt: 'Stalen trap met kooiladder en bordes langs een bakstenen gebouw' },
  { src: e21, cat: 'machines', kop: 'Twee ontbladermachines voor snijbloemen', bij: 'Ruigrok, Hillegom', alt: 'Twee groen gespoten ontbladermachines in de werkplaats' },
  { src: e20, cat: 'bakken', kop: 'Tien bloembakken', bij: 'AW groen, Lisse', alt: 'Een rij witte, grote bloembakken op een terrein' },
  { src: e23, cat: 'machines', kop: 'Manegebodemvlakker, lasergestuurd', bij: 'Stal Jasper, Hillegom', alt: 'Een compacttractor met een bodemvlakker in een manege' },
  { src: e25, cat: 'hekwerk', kop: 'Nieuw hekwerk voor de camping', bij: 'Camping Kagerzoom', alt: 'Een zwart smeedijzeren toegangshek tussen twee gemetselde pilaren' },
  { src: e24, cat: 'machines', kop: 'Vijfdelige grondboor', bij: 'Loonbedrijf Van Staveren, Nieuw-Vennep', alt: 'Een trekker met een grondboor met vijf boren op een akker' },
  { src: e19, cat: 'trappen', kop: 'Brandtrap en bordes, gezien vanaf het water', bij: 'Velsertunnel', alt: 'Stalen trap met leuningen aan de waterkant' },
  { src: e26, cat: 'bakken', kop: 'Bandenrek', bij: 'Arke Fly, Schiphol', alt: 'Een blauw stalen rek met vliegtuigbanden in een magazijn' },
  { src: e27, cat: 'machines', kop: 'Houtklover voor grote boomstammen', bij: 'Bram Versteeg, Zwaanshoek', alt: 'Een houtklover met een boomstam buiten voor de hal' },
  { src: e34, cat: 'hekwerk', kop: 'Valbeveiliging met snelsluiting, liggers makkelijk los te halen', bij: 'Gemeente Bloemendaal', alt: 'Een verzinkt hekwerk met gele borden langs een kade' },
  { src: e29, cat: 'machines', kop: 'Klepelmaaier op een quad gebouwd', bij: 'Mark Hogervorst, Noordwijk', alt: 'Een man op een quad met een klepelmaaier aan de voorkant in het gras' },
  { src: e31, cat: 'trappen', kop: 'Loopbrug naar de derde robot', bij: 'P. van der Eijk, Biddinghuizen', alt: 'Een verzinkte stalen loopbrug met leuningen in een stal' },
  { src: e35, cat: 'bakken', kop: 'Calamiteitencontainer, samen met Maarl klusbedrijf', bij: 'Politie Haaglanden', alt: 'Een witte container met een uitklapbare luifel' },
  { src: e30, cat: 'machines', kop: 'Kraan opgebouwd op een bestaande kipper', bij: 'Loonbedrijf Van Staveren, Nieuw-Vennep', alt: 'Een gele kipper met een opgebouwde laadkraan' },
  { src: e38, cat: 'hekwerk', kop: 'Veiligheidskooi om een perscontainer', bij: 'De Meerlanden, Diemen', alt: 'Een gele stalen gaaskooi' },
  { src: e32, cat: 'bakken', kop: 'Afvalbunker met vijzel voor een afvalverkleiner', bij: 'Van der Luyt transport', alt: 'Een verzinkte bunker met vijzel in de constructiehal' },
  { src: e40, cat: 'hekwerk', kop: 'Nettensysteem', bij: 'De Meerlanden, Rijsenhout', alt: 'Een hoge stalen constructie met netten boven een betonnen opslagvak' },
  { src: e39, cat: 'bakken', kop: 'Vuurschaal', bij: 'Uit onze constructiehal', alt: 'Een vierkante stalen vuurschaal op pootjes' },
  { src: e11trap, cat: 'trappen', kop: 'Stalen trap met hekwerk', bij: 'Uit onze constructiehal', alt: 'Een zwarte stalen trap met een spijlenhek in een nieuwbouwhal' },
  { src: e36, cat: 'bakken', kop: 'Inrichting van de calamiteitencontainer', bij: 'Politie Haaglanden', alt: 'Interieur van een container met werkblad, kastjes en een aggregaat' },
  { src: e11bak, cat: 'bakken', kop: 'Roestvrijstalen bak met hijsogen', bij: 'Uit onze constructiehal', alt: 'Een grote rvs-bak met hijsframe op een bestrating' },
];

// Tijdlijn: pagina "Over ons" en nieuws.
const tijdlijn = [
  { jaar: '1960', kop: 'Een schuur op de veehouderij', tekst: 'Leo Heemskerk, destijds werkzaam bij Tinus Kroon in Abbenes, begint \'s avonds en in het weekend thuis in een schuur op de veehouderij van zijn ouders met de reparatie van landbouwwerktuigen en smederij-activiteiten. Na enkele jaren zet hij met broer Wim een eigen smederij op aan de IJweg in Nieuw-Vennep.' },
  { jaar: '1962', kop: 'Dealer van Porsche', tekst: 'Van de trekkers van het merk, wel te verstaan. Er is veel werk door de erwtenoogst en de dopperij in Nieuw-Vennep. Uit het herstellen en verbouwen van wagens en werktuigen ontstaat het constructiewerk.' },
  { jaar: '1966', kop: 'Over op Renault', tekst: 'Porsche stopt, de importeur stapt over naar Renault en zo ook Gebr. Heemskerk.' },
  { jaar: '1970', kop: 'Twee hallen', tekst: 'Rond 1970 worden de twee hallen gebouwd die nu nog steeds in gebruik zijn.' },
  { jaar: '2002', kop: 'Claas', tekst: 'Renault wordt overgenomen door het Duitse Claas: opnieuw een ander trekkermerk.' },
  { jaar: '2015', kop: 'Combi West Mechanisatie', tekst: 'Per 1 november bundelen vier landbouwmechanisatiebedrijven de krachten voor Claas, Amazone en Kaweco.' },
];
---
<Base title={`${site.naam} | Mechanisatie en constructie in Nieuw-Vennep`} description="Mechanisatie- en Constructiebedrijf Gebr. Heemskerk in Nieuw-Vennep: dealer van Claas, Amazone, Kaweco, Kioti en Monosem, tuin en park, service op locatie en maatwerk in staal. Sinds 1960.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- Hero: akker als sfeer, bewijzen rechts, eigen bedrijf (luchtfoto) valt over de rand. -->
    <section class="donker relative isolate bg-antraciet text-white">
      <div class="absolute inset-0 -z-10 overflow-hidden">
        <Foto src={heroFoto} alt="" hero sizes="100vw" widths={[800, 1200, 1800, 2000]} class="object-[70%_50%]" />
        <div class="absolute inset-0 bg-antraciet/80 lg:bg-transparent lg:bg-[linear-gradient(90deg,#15181b_0%,#15181bf2_38%,#15181b99_70%,#15181b4d_100%)]"></div>
      </div>
      <div class="wrap grid gap-12 pb-44 pt-14 sm:pb-56 lg:grid-cols-12 lg:pb-64 lg:pt-24">
        <div class="lg:col-span-8">
          <p class="kicker text-groen">Nieuw-Vennep, sinds 1960</p>
          <h1 class="mt-5 text-4xl uppercase">Mechanisatie <span class="text-groen">en</span> constructie</h1>
          <p class="mt-7 max-w-[38rem] text-lg text-white/90">Dealer van Claas, Amazone, Kaweco, Kioti en Monosem, met een eigen constructiehal. De kracht van ons bedrijf: de flexibiliteit om naast standaard machines ook speciale machines te bouwen.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-groen"><Fragment set:html={tel} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            <a href={site.whatsapp} class="btn btn-line text-white"><Fragment set:html={wa} />App met verkoop</a>
          </div>
          <a href="#service" class="mt-6 inline-flex items-center gap-2 font-semibold text-white underline decoration-groen decoration-2 underline-offset-[6px] transition-colors hover:text-groen [&>svg]:h-4 [&>svg]:w-4">Service op locatie aanvragen <Fragment set:html={pijl} /></a>
        </div>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-7 self-end border-t border-white/20 pt-7 lg:col-span-4 lg:grid-cols-1 lg:border-l lg:border-t-0 lg:pl-9 lg:pt-0">
          <div><dt class="text-sm text-white/80">Google</dt><dd class="mt-1 font-display text-2xl font-bold">{site.google} <span class="font-body text-sm font-normal text-white/80">({site.reviews} reviews)</span></dd></div>
          <div><dt class="text-sm text-white/80">Vaste medewerkers</dt><dd class="mt-1 font-display text-2xl font-bold tabular-nums">11</dd></div>
          <div><dt class="text-sm text-white/80">Servicebussen, volledig ingericht</dt><dd class="mt-1 font-display text-2xl font-bold tabular-nums">2</dd></div>
          <div><dt class="text-sm text-white/80">Aan de IJweg</dt><dd class="mt-1 font-display text-2xl font-bold tabular-nums">Sinds 1960</dd></div>
        </dl>
      </div>
    </section>

    <!-- Hun eigen bedrijf, over de rand van de hero. -->
    <div class="wrap relative z-10 -mt-32 sm:-mt-44 lg:-mt-52">
      <figure class="relative mx-auto max-w-[925px] overflow-hidden rounded-xl bg-kool shadow-lg ring-1 ring-white/10">
        <div class="aspect-[925/342]"><Foto src={luchtfoto} alt="Luchtfoto van ons bedrijf aan de IJweg: twee antracietkleurige hallen, servicebussen, trekkers en een Claas-combine op het erf" widths={[480, 925]} sizes="(min-width: 1000px) 925px, 100vw" /></div>
        <figcaption class="absolute bottom-3 left-3 rounded-md bg-antraciet/90 px-3 py-1.5 label text-white">{site.straat}, {site.plaats}</figcaption>
      </figure>
    </div>

    <!-- Wow: twee sporen, schakelaar wisselt de hele sectie. -->
    <section id="sporen" class="scroll-mt-20 py-20 lg:py-28" aria-labelledby="sporen-kop">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-6">
            <p class="kicker text-bosgroen">Twee afdelingen, één adres</p>
            <h2 id="sporen-kop" class="mt-4 text-3xl">Van trekker tot brandtrap</h2>
          </div>
          <p class="text-ink-soft lg:col-span-6">Uit het bouwen van werktuigen voor de land- en tuinbouw is het constructiewerk ontstaan, en dat is tot op heden een belangrijke pijler van het bedrijf. Kies hieronder waar u voor komt.</p>
        </div>

        <div data-schakel hidden class="mt-10 grid grid-cols-2 gap-1.5 rounded-xl bg-white p-1.5 shadow-sm ring-1 ring-line sm:max-w-xl" role="group" aria-label="Kies een afdeling">
          <button type="button" class="spoor" data-spoor="mechanisatie" aria-pressed="true" aria-controls="mechanisatie">
            <span class="font-display text-xl font-bold uppercase">Mechanisatie</span><small>Land- en tuinbouw, tuin en park</small>
          </button>
          <button type="button" class="spoor" data-spoor="constructie" aria-pressed="false" aria-controls="constructie">
            <span class="font-display text-xl font-bold uppercase">Constructie</span><small>Maatwerk in staal, projecten</small>
          </button>
        </div>

        <!-- Spoor 1: mechanisatie -->
        <div id="mechanisatie" data-paneel="mechanisatie" class="scroll-mt-24 mt-10">
          <div class="grid gap-10 lg:grid-cols-12">
            <div class="lg:col-span-5">
              <h3 class="font-display text-2xl font-bold">Mechanisatie</h3>
              <p class="mt-4">Al sinds de oprichting is Gebr. Heemskerk actief en betrokken in de land- en tuinbouwsector. Ons hedendaagse aanbod bevat kwaliteitsmerken als Claas, Kaweco, Amazone, Kioti en Monosem, voor elk specialistisch doeleinde.</p>
              <figure class="mt-7 overflow-hidden rounded-xl shadow-sm">
                <div class="aspect-[950/305]"><Foto src={cabine} alt="Een monteur leest in de cabine van een trekker de gegevens uit op een laptop" widths={[480, 950]} sizes="(min-width: 1024px) 480px, 100vw" /></div>
                <figcaption class="bg-white px-4 py-2.5 label text-ink-soft">In de werkplaats: uitlezen vanuit de cabine</figcaption>
              </figure>
            </div>
            <ol class="grid gap-px overflow-hidden rounded-xl bg-line shadow-sm ring-1 ring-line sm:grid-cols-2 lg:col-span-7">
              {mechanisatie.map((m, i) => (
                <li class="bg-white p-6 lg:p-7">
                  <span class="font-display text-sm font-bold tabular-nums text-bosgroen">0{i + 1}</span>
                  <h4 class="mt-2 font-display text-xl font-bold">{m.kop}</h4>
                  <p class="mt-2 text-sm text-ink-soft">{m.tekst}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="mt-14 grid gap-10 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <p class="kicker text-bosgroen">Merken</p>
              <h4 class="mt-3 font-display text-2xl font-bold">Wat wij ú kunnen bieden</h4>
              <div class="donker mt-6 rounded-xl bg-antraciet p-6 text-white shadow-sm">
                <p class="font-display text-lg font-bold uppercase leading-none tracking-wide text-[#c3d62a]">Combi West <span class="block text-sm tracking-[0.18em] text-white">Mechanisatie bv</span></p>
                <p class="mt-4 text-sm text-white/85">Per 1 november 2015 hebben wij ons verenigd met drie andere landbouwmechanisatiebedrijven: Evenboer uit Broek in Waterland, Smit &amp; Alles uit Assendelft/Uitgeest en Van den Berg mechanisatie uit Kockengen. Samen trekken we op voor Claas, Amazone en Kaweco.</p>
                <p class="mt-3 text-sm text-white/85">Door de samenwerking zijn de investeringen in demonstratiemachines, scholing, ICT, garantie en onderdelenvoorziening naar een concurrerender niveau gebracht.</p>
              </div>
            </div>
            <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-8 xl:grid-cols-3">
              {merken.map((m) => (
                <li class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-line transition-shadow hover:shadow-lg">
                  <p class="font-display text-xl font-bold uppercase tracking-wide">{m.naam}</p>
                  <p class="mt-1.5 text-sm text-ink-soft">{m.tekst}</p>
                </li>
              ))}
              <li class="rounded-xl bg-mist p-5">
                <p class="font-display text-xl font-bold uppercase tracking-wide">Occasions</p>
                <p class="mt-1.5 text-sm text-ink-soft">Ons actuele aanbod staat op Tractors &amp; Machinery:</p>
                <p class="mt-2 text-sm font-semibold"><a class="text-bosgroen underline underline-offset-2" href="https://www.tractors-and-machinery.nl/occasions/1/497/Gebr-Heemskerk-BV">Gebr. Heemskerk</a> <span aria-hidden="true">·</span> <a class="text-bosgroen underline underline-offset-2" href="https://www.tractors-and-machinery.nl/occasions/1/6035/Combi-West-Mechanisatie-BV">Combi West</a></p>
              </li>
            </ul>
          </div>

          <div class="donker mt-14 overflow-hidden rounded-xl bg-antraciet text-white shadow-sm">
            <div class="grid lg:grid-cols-12">
              <div class="p-7 lg:col-span-4 lg:p-10">
                <p class="kicker text-groen">Recent afgeleverd</p>
                <h4 class="mt-3 font-display text-2xl font-bold">Onlangs de poort uit</h4>
                <p class="mt-4 text-sm text-white/80">Een greep uit de machines die we de afgelopen tijd hebben afgeleverd, van Boesingheliede tot Leidschendam.</p>
              </div>
              <ul class="grid border-t border-white/10 sm:grid-cols-2 lg:col-span-8 lg:border-l lg:border-t-0">
                {afgeleverd.map((a) => (
                  <li class="border-b border-white/10 px-7 py-4 sm:odd:border-r">
                    <p class="font-semibold leading-snug">{a.wat}</p>
                    <p class="mt-0.5 text-sm text-plaat">{a.wie}</p>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Spoor 2: constructie -->
        <div id="constructie" data-paneel="constructie" class="scroll-mt-24 mt-16">
          <div class="donker relative isolate overflow-hidden rounded-xl bg-antraciet text-white shadow-sm">
            <div class="absolute inset-0 -z-10">
              <Foto src={snijbrander} alt="" sizes="(min-width: 1280px) 1200px, 100vw" widths={[800, 1200, 1800]} class="object-[35%_60%]" />
              <div class="absolute inset-0 bg-antraciet/80 lg:bg-transparent lg:bg-[linear-gradient(90deg,#15181b_0%,#15181bee_45%,#15181b66_100%)]"></div>
            </div>
            <div class="grid gap-8 p-7 sm:p-10 lg:grid-cols-12 lg:p-14">
              <div class="lg:col-span-7">
                <h3 class="font-display text-2xl font-bold uppercase text-groen">Constructie &amp; metaalbewerking</h3>
                <p class="mt-5 text-lg text-white/90">Gebr. Heemskerk is een mechanisatiebedrijf gespecialiseerd in constructietechniek. Met vakkundig personeel, metalen van hoge kwaliteit en een moderne constructiehal voorzien van de nieuwste machines bent u verzekerd van het beste resultaat.</p>
                <p class="mt-4 text-white/85">Naast agrarische klanten en aannemers doet de constructieafdeling veel werk om motoren voor onder andere politie en brandweer te voorzien van diverse beugels en apparatuur. Ook hier geldt: niets is te gek.</p>
                <a href="#projecten" class="btn btn-groen mt-8">Bekijk onze projecten <Fragment set:html={pijl} /></a>
              </div>
              <div class="lg:col-span-5 lg:pl-6">
                <p class="kicker text-plaat">Een greep uit ons werk</p>
                <ul class="mt-4 divide-y divide-white/15 border-y border-white/15">
                  {opdrachtgevers.map((o) => <li class="py-3 text-sm font-semibold">{o}</li>)}
                </ul>
              </div>
            </div>
          </div>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            <figure class="overflow-hidden rounded-xl bg-white shadow-sm">
              <div class="aspect-[950/248]"><Foto src={lasser} alt="Een lasser met laskap aan het werk in onze constructiehal" widths={[480, 950]} sizes="(min-width: 768px) 50vw, 100vw" /></div>
              <figcaption class="px-4 py-2.5 label text-ink-soft">Lassen in de constructiehal</figcaption>
            </figure>
            <figure class="overflow-hidden rounded-xl bg-white shadow-sm">
              <div class="aspect-[950/248]"><Foto src={plasma} alt="Een snijmachine snijdt vormen uit een stalen plaat, met vonken eronder" widths={[480, 950]} sizes="(min-width: 768px) 50vw, 100vw" class="object-[50%_30%]" /></div>
              <figcaption class="px-4 py-2.5 label text-ink-soft">Plaat snijden op maat</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Projectengalerij met filter -->
    <section id="projecten" class="scroll-mt-16 border-t border-line bg-mist py-20 lg:py-28" aria-labelledby="projecten-kop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-bosgroen">Projecten</p>
            <h2 id="projecten-kop" class="mt-4 text-3xl">Op verzoek gemaakt</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5">Van grondboor tot brandtrap: een greep uit onze projecten, voor loonbedrijven, kwekers, gemeenten, de politie en Schiphol.</p>
        </div>
        <div data-filters hidden class="mt-9 flex flex-wrap gap-2" role="group" aria-label="Filter projecten">
          <button type="button" class="chip" data-filter="alles" aria-pressed="true">Alles</button>
          {categorieen.map((c) => <button type="button" class="chip" data-filter={c.id} aria-pressed="false">{c.naam}</button>)}
        </div>
        <p data-telling class="mt-4 label text-ink-soft" aria-live="polite"></p>
        <ul class="mt-6 grid grid-cols-1 gap-4 min-[480px]:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {projecten.map((p) => (
            <li data-cat={p.cat} class="group overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-line">
              <div class="aspect-[4/3] overflow-hidden"><Foto src={p.src} alt={p.alt} widths={[p.src.width]} sizes={`${p.src.width}px`} class="transition-transform duration-500 group-hover:scale-[1.03]" /></div>
              <div class="px-4 pb-4 pt-3">
                <p class="font-semibold leading-snug">{p.kop}</p>
                <p class="mt-1 label text-ink-soft">{p.bij}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Service op locatie -->
    <section id="service" class="donker scroll-mt-16 bg-antraciet py-20 text-white lg:py-28" aria-labelledby="service-kop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-groen">Service op locatie</p>
          <h2 id="service-kop" class="mt-4 text-3xl">Twee volledig ingerichte servicebussen</h2>
          <p class="mt-6 text-lg text-white/90">In het geval van een calamiteit zijn wij zo snel ter plaatse met het juiste materiaal. Met de deskundige hulp en het advies van onze monteurs helpen wij u zó weer op weg.</p>
          <figure class="mt-9 overflow-hidden rounded-xl shadow-lg ring-1 ring-white/10">
            <div class="aspect-[950/285]"><Foto src={busMaaier} alt="Onze servicebus met open zijdeur naast een Claas-trekker met maaier in het veld" widths={[480, 950]} sizes="(min-width: 1024px) 580px, 100vw" /></div>
          </figure>
          <figure class="mt-4 overflow-hidden rounded-xl shadow-lg ring-1 ring-white/10 lg:ml-16">
            <div class="aspect-[950/301]"><Foto src={busSpuit} alt="Een monteur bij een veldspuit op het stoppelveld, met onze servicebus ernaast" widths={[480, 950]} sizes="(min-width: 1024px) 520px, 100vw" /></div>
            <figcaption class="bg-kool px-4 py-2.5 label text-plaat">Op locatie: van maaier tot veldspuit</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-6">
          <form class="rounded-xl bg-paper p-6 text-ink shadow-lg sm:p-8" onsubmit="return false" aria-labelledby="form-kop">
            <h3 id="form-kop" class="font-display text-2xl font-bold">Service op locatie aanvragen</h3>
            <p class="mt-2 text-sm text-ink-soft">Laat weten waar de machine staat en wat er aan de hand is. Wij nemen contact met u op.</p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <div class="veld"><label for="f-naam">Naam</label><input id="f-naam" name="naam" autocomplete="name" /></div>
              <div class="veld"><label for="f-tel">Telefoon</label><input id="f-tel" name="telefoon" type="tel" autocomplete="tel" /></div>
              <div class="veld sm:col-span-2"><label for="f-plek">Waar staat de machine?</label><input id="f-plek" name="locatie" placeholder="Adres of perceel, plaats" /></div>
              <div class="veld"><label for="f-soort">Soort machine</label>
                <select id="f-soort" name="soort">
                  <option>Trekker</option><option>Veldspuit</option><option>Maaier of hooibouw</option><option>Grondbewerking of zaaien</option><option>Tuin en park</option><option>Anders</option>
                </select>
              </div>
              <div class="veld"><label for="f-merk">Merk en type</label><input id="f-merk" name="merk" placeholder="Bijv. Claas Arion 650" /></div>
              <fieldset class="veld sm:col-span-2">
                <legend>Hoe dringend?</legend>
                <div class="mt-2 grid gap-2 sm:grid-cols-2">
                  <label class="optie"><input type="radio" name="spoed" value="calamiteit" checked /> Calamiteit, machine staat stil</label>
                  <label class="optie"><input type="radio" name="spoed" value="inplannen" /> Graag een afspraak inplannen</label>
                </div>
              </fieldset>
              <div class="veld sm:col-span-2"><label for="f-wat">Wat is er aan de hand?</label><textarea id="f-wat" name="omschrijving" rows="4"></textarea></div>
            </div>
            {site.voorstel ? (
              <p class="mt-6 rounded-lg bg-mist p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="font-semibold whitespace-nowrap tabular-nums underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold break-all underline">{site.mail}</a>.</p>
            ) : (
              <button type="submit" class="btn btn-bos mt-6">Aanvraag versturen</button>
            )}
          </form>
          <p class="mt-5 text-sm text-white/80">Liever direct? Bel <a href={site.telHref} class="font-semibold whitespace-nowrap tabular-nums text-white underline underline-offset-2">{site.tel}</a>.</p>
        </div>
      </div>
    </section>

    <!-- Over ons en tijdlijn -->
    <section id="over" class="scroll-mt-16 py-20 lg:py-28" aria-labelledby="over-kop">
      <div class="wrap grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-bosgroen">Over ons</p>
          <h2 id="over-kop" class="mt-4 text-3xl">De grondleggers: Willem en Leo Heemskerk</h2>
          <figure class="relative mt-9 max-w-[500px] overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-line">
            <div class="aspect-[500/305]"><Foto src={oprichters} alt="Zwart-witfoto van de broers Leo en Wim Heemskerk voor een trekker" widths={[500]} sizes="500px" /></div>
            <figcaption class="absolute left-3 top-3 rounded-md bg-antraciet/90 px-3 py-1.5 label text-white">Gebr. L. en W. Heemskerk</figcaption>
          </figure>
          <figure class="relative z-10 -mt-10 ml-auto w-[78%] max-w-[420px] overflow-hidden rounded-xl bg-white shadow-lg ring-1 ring-line sm:-mt-16">
            <div class="aspect-[533/525]"><Foto src={team} alt="Ons team op een trap in de showroom" widths={[480, 533]} sizes="420px" /></div>
            <figcaption class="px-4 py-2.5 label text-ink-soft">11 vaste medewerkers, onder leiding van Han en Lia van Hamburg</figcaption>
          </figure>
        </div>
        <ol class="relative lg:col-span-7 lg:pl-6">
          <span class="absolute bottom-3 left-[7rem] top-3 hidden w-px bg-line sm:block lg:left-[8.5rem]" aria-hidden="true"></span>
          {tijdlijn.map((t) => (
            <li class="grid gap-2 border-b border-line py-7 first:pt-0 sm:grid-cols-[6rem_1fr] sm:gap-8">
              <p class="font-display text-jaar font-bold leading-none tabular-nums text-bosgroen">{t.jaar}</p>
              <div>
                <h3 class="font-display text-xl font-bold">{t.kop}</h3>
                <p class="mt-2 text-ink-soft">{t.tekst}</p>
              </div>
            </li>
          ))}
          <li class="grid gap-2 py-7 sm:grid-cols-[6rem_1fr] sm:gap-8">
            <p class="font-display text-jaar font-bold leading-none text-bosgroen">Nu</p>
            <div>
              <h3 class="font-display text-xl font-bold">Speciale machines, voor elke bedrijfstak</h3>
              <p class="mt-2 text-ink-soft">De kracht van ons bedrijf is de flexibiliteit om naast standaard machines, niet alleen voor de land- en tuinbouw, speciale machines te bouwen. Het bedrijf bestaat uit 11 vaste medewerkers onder leiding van Han en Lia van Hamburg.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="donker scroll-mt-16 bg-bosgroen py-20 text-white lg:py-24" aria-labelledby="contact-kop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-white/85">Contact</p>
          <h2 id="contact-kop" class="mt-4 text-3xl">Langskomen aan de IJweg</h2>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn bg-white text-ink hover:bg-antraciet hover:text-white"><Fragment set:html={tel} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line text-white"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <address class="mt-9 not-italic text-lg">
            <strong>{site.volledig}</strong><br />{site.straat}<br />{site.postcode} {site.plaats}
          </address>
          <p class="mt-4"><a href={site.maps} class="font-semibold underline underline-offset-4">Route plannen</a></p>
        </div>
        <div class="grid gap-4 self-start lg:col-span-6">
          <div class="rounded-xl bg-antraciet p-7 shadow-sm">
            <p class="kicker text-groen">Verkoop algemeen</p>
            <p class="mt-3 font-display text-2xl font-bold">{site.verkoper}</p>
            <p class="mt-1"><a href={site.mobielHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.mobiel}</a></p>
            <a href={site.whatsapp} class="btn btn-groen mt-5"><Fragment set:html={wa} />App met verkoop</a>
          </div>
          <div class="rounded-xl bg-antraciet/25 p-7 ring-1 ring-white/20">
            <p class="kicker text-white">Openingstijden winkel en werkplaats</p>
            <p class="mt-3 text-sm text-white">[[AANLEVEREN: openingstijden]]</p>
            <p class="mt-5 text-sm text-white">Op onze werkzaamheden zijn de Metaalunie-voorwaarden van toepassing.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  // Schakelaar Mechanisatie / Constructie. Zonder JS staan beide sporen gewoon onder elkaar.
  const schakel = document.querySelector<HTMLElement>('[data-schakel]');
  const knoppen = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-spoor]'));
  const panelen = Array.from(document.querySelectorAll<HTMLElement>('[data-paneel]'));
  function kies(id: string) {
    knoppen.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.spoor === id)));
    panelen.forEach((p) => { p.hidden = p.dataset.paneel !== id; });
  }
  if (schakel) {
    schakel.hidden = false;
    panelen.forEach((p) => p.classList.remove('mt-16'));
    kies(location.hash === '#constructie' ? 'constructie' : 'mechanisatie');
    knoppen.forEach((k) => k.addEventListener('click', () => kies(k.dataset.spoor!)));
    document.querySelectorAll<HTMLAnchorElement>('[data-spoor-link="mechanisatie"], [data-spoor-link="constructie"]').forEach((a) =>
      a.addEventListener('click', () => kies(a.dataset.spoorLink!)));
    window.addEventListener('hashchange', () => {
      if (location.hash === '#constructie' || location.hash === '#mechanisatie') kies(location.hash.slice(1));
    });
  }

  // Filter voor de projectengalerij.
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const tegels = Array.from(document.querySelectorAll<HTMLElement>('[data-cat]'));
  const telling = document.querySelector<HTMLElement>('[data-telling]');
  function filter(id: string) {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === id)));
    let n = 0;
    tegels.forEach((t) => { const aan = id === 'alles' || t.dataset.cat === id; t.hidden = !aan; if (aan) n++; });
    const naam = chips.find((c) => c.dataset.filter === id)?.textContent ?? '';
    if (telling) telling.textContent = id === 'alles' ? `${n} projecten` : `${n} projecten in ${naam.toLowerCase()}`;
  }
  if (filters) {
    filters.hidden = false;
    chips.forEach((c) => c.addEventListener('click', () => filter(c.dataset.filter!)));
    filter('alles');
  }
</script>
