---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="op-donker bg-roet text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk licht />
      <p class="mt-6 max-w-xs">Haarden, kachels en rookkanalen, geplaatst door Hans van der Vorst uit Eindhoven.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Hans doet</p>
      <ul class="mt-3 space-y-1">
        <li><a href={h('werk')} class="link link-licht">Haarden en kachels</a></li>
        <li><a href={h('buiten')} class="link link-licht">Buitenhaarden</a></li>
        <li><a href={h('onderhoud')} class="link link-licht">Onderhoud</a></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Showroom</p>
      <p class="mt-3">Op afspraak</p>
      <p class="mt-1"><a href={site.maps} class="link link-licht">Route</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Hans van der Vorst Openhaarden, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto’s van het eigen Google-bedrijfsprofiel. Teksten uit de eigen website (webarchief, april 2025). Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
