---
// Woordmerk naar hun logo: "Hans van der Vorst" en "Sterk in [open]haarden werk" (Sterk en werk in rood).
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<a href={url('')} class:list={['merk', licht && 'merk-licht']} aria-label="Hans van der Vorst, naar de homepage">
  <b>Hans van der Vorst</b>
  <small><em>Sterk</em> in [open]haarden <em>werk</em></small>
</a>
