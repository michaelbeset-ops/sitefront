---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import ruwVuur from '../assets/ruw-vuur.jpg';
import ruwTunnel from '../assets/ruw-tunnel.jpg';
import driezijdig from '../assets/driezijdig.jpg';
import houtkachel from '../assets/houtkachel.jpg';
import tuinhuis from '../assets/tuinhuis.jpg';
import buiten from '../assets/buiten.jpg';
import wok from '../assets/wok.jpg';
import pand from '../assets/pand.jpg';

// Letterlijk van hun site ("Ik verzorg voor u:"), webarchief april 2025.
const diensten = [
  'de installatie van open of gesloten houthaarden',
  'de installatie van open of gesloten gashaarden',
  'het ombouwen van uw houthaard naar een gashaard',
  'de aanleg van rookkanalen',
  'de installatie van ventilatoren',
  'service en periodiek onderhoud',
  'boor-, metsel-, stucwerk en elektra',
];
// Merken zoals op hun homepage.
const merken = ['Barbas', 'Bellfire', 'Dru', 'Faber', 'Dik Geurts', 'Kal-fire', 'Harrie Leenders'];

// Haardkiezer: alleen soorten die op hun site staan. soort = gas | hout | elek | buiten | schouw | ombouw | open | nvt
const typen = [
  ['een gesloten gashaard', 'gas'],
  ['een open gashaard', 'open'],
  ['een inbouwhaard op hout', 'hout'],
  ['een houtkachel', 'hout'],
  ['een gaskachel', 'gas'],
  ['een speksteenkachel', 'hout'],
  ['een elektrische haard', 'elek'],
  ['een schouw op maat', 'schouw'],
  ['ombouw naar gas', 'ombouw'],
  ['een buitenhaard', 'buiten'],
];
const plekken = ['een bestaand huis', 'een nieuwbouwhuis', 'een verbouwing', 'de tuin of het terras'];
const kanalen = [['al een schoorsteen', 'ja'], ['nog geen rookkanaal', 'nee'], ['weet ik niet', 'nvt']];

const titel = 'Hans van der Vorst | Openhaarden in Eindhoven';
const omschrijving = 'Hans van der Vorst uit Eindhoven installeert open en gesloten haarden op hout en gas, kachels, schouwen en rookkanalen, en doet het onderhoud. Showroom aan de Lucas Gasselstraat op afspraak.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: zijn eigen mediawand met gashaard, schermvullend. Het vuur links blijft vrij, de tekst staat rechts. -->
    <section class="op-donker relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col overflow-hidden bg-roet text-wit md:min-h-[calc(100svh-5rem)]">
      <Image src={hero} alt="Woonkamer met een donkere lamellenwand en verlichte lijnen; links in de wand een gashaard met vuur" quality={60} widths={[480, 720, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[25%_50%] lg:object-[50%_62%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#141211e6_0%,#141211a6_28%,#14121100_44%,#14121100_62%,#141211d9_80%,#141211_100%)] lg:bg-[linear-gradient(90deg,#14121126_0%,#14121100_30%,#141211b3_52%,#141211f0_70%,#141211f5_100%)]" aria-hidden="true"></div>
      <div class="wrap flex flex-1 flex-col justify-between gap-10 pb-32 pt-10 md:pb-20 lg:grid lg:grid-cols-12 lg:content-end lg:pb-24">
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="text-sm text-as">Openhaardenwerk in Eindhoven</p>
          <h1 class="mt-3 text-[clamp(2.1rem,9.4vw,4.25rem)] leading-[1]">Sterk in<br /><span class="haak">open</span>haarden<br />werk</h1>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="max-w-lg text-lg text-wit/90">Haarden en kachels op hout en gas, ingebouwd of vrijstaand. Snel en vakkundig van advies naar stookklaar, met één aanspreekpunt.</p>
          <div class="mt-8 hidden flex-wrap items-center gap-3 md:flex">
            <a href={waHoi} class="knop"><Icoon naam="wa" />App Hans</a>
            <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. HANS: één man, ruwbouw tot vuur -->
    <section id="hans" class="py-20 md:py-24 lg:py-20">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs kader lg:col-span-5">
          <Image src={ruwVuur} alt="Een vrijstaande haardkolom tijdens de bouw, nog zonder stucwerk, met een driezijdige gashaard die al brandt" quality={62} widths={[400, 600, 800, 1000]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full object-cover object-[50%_60%]" />
        </figure>
        <div class="flex flex-col lg:col-span-7 lg:pt-10">
          <h2 class="rijs text-3xl">Eén vakman, van de eerste schets tot het eerste vuur</h2>
          <blockquote class="rijs mt-10 max-w-2xl border-l-4 border-rood pl-6">
            <p class="text-xl italic leading-relaxed md:text-2xl">“Ik heb hart voor mijn zaak. Ik ga ervoor en zorg dat het afkomt.”</p>
            <footer class="mt-3 text-sm text-steen">Hans van der Vorst</footer>
          </blockquote>
          <p class="rijs mt-10 max-w-xl text-lg text-steen">Hans werkt alleen. Hij geeft het advies bij u thuis, bouwt de haard en is na de installatie ook degene die u belt voor service en onderhoud.</p>
          <dl class="rijs mt-12 grid max-w-2xl gap-x-10 gap-y-6 border-t border-lijn pt-8 sm:grid-cols-2">
            <div><dt class="font-semibold">Ruim 25 jaar</dt><dd class="text-steen">ervaring als installateur van haarden</dd></div>
            <div><dt class="font-semibold">Erkend door Evis</dt><dd class="text-steen">de erkenning voor installateurs van sfeerverwarming</dd></div>
            <div><dt class="font-semibold">Alles in één hand</dt><dd class="text-steen">rookkanaal, ventilatie, metsel- en stucwerk, elektra</dd></div>
            <div><dt class="font-semibold">Bij u thuis</dt><dd class="text-steen">in Eindhoven, Veldhoven, Valkenswaard of verder weg</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 3. WERK: ruwbouw en opgeleverd, plus wat hij doet -->
    <section id="werk" class="bg-kalk-2 py-20 md:py-24 lg:py-20">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <h2 class="rijs text-3xl lg:col-span-7">Gebouwd in de woonkamer</h2>
          <p class="rijs self-end text-steen lg:col-span-4 lg:col-start-9">Van kale ombouw tot strak gestucte kolom. Eigen foto’s van Hans.</p>
        </div>

        <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-5">
          <figure class="rijs col-span-1 md:col-span-4 md:row-span-2">
            <Image src={ruwTunnel} alt="Een haardkolom met een doorkijkhaard in een woning die nog in de ruwbouw zit" quality={60} widths={[300, 500, 700]} sizes="(min-width: 768px) 32vw, 50vw" class="h-full min-h-full w-full object-cover" />
            <figcaption class="mt-2 text-xs text-steen">Tijdens de bouw</figcaption>
          </figure>
          <figure class="rijs col-span-1 md:col-span-8" style="--d:.06s">
            <Image src={driezijdig} alt="Witte haardkolom boven een zwevend dressoir met keramisch blad, met een driezijdige gashaard met houtblokken" quality={60} widths={[400, 700, 1000]} sizes="(min-width: 768px) 60vw, 50vw" class="aspect-[3/4] w-full object-cover md:aspect-[2/1] md:object-[50%_72%]" />
            <figcaption class="mt-2 text-xs text-steen">Opgeleverd</figcaption>
          </figure>
          <figure class="rijs col-span-1 md:col-span-4" style="--d:.1s">
            <Image src={tuinhuis} alt="Tuinkamer met stalen puien, in het midden een kolom van witte natuursteen met een ingebouwde haard en een rookkanaal door het dak" quality={60} widths={[300, 500]} sizes="(min-width: 768px) 30vw, 50vw" class="aspect-[3/4] w-full object-cover md:aspect-[4/5] md:object-[50%_40%]" />
          </figure>
          <figure class="rijs col-span-1 md:col-span-4" style="--d:.14s">
            <Image src={houtkachel} alt="Vrijstaande houtkachel met een flink vuur, met een houtvak eronder" quality={60} widths={[300, 500]} sizes="(min-width: 768px) 30vw, 50vw" class="aspect-[3/4] w-full object-cover md:aspect-[4/5] md:object-[40%_50%]" />
          </figure>
        </div>

        <div class="mt-16 grid gap-y-8 lg:grid-cols-12 lg:gap-x-12">
          <h3 class="rijs text-2xl lg:col-span-4">Wat Hans voor u regelt</h3>
          <div class="lg:col-span-8">
            <ul class="grid sm:grid-cols-2 sm:gap-x-10">
              {diensten.map((d) => (
                <li class="rijs flex items-baseline gap-4 border-b border-lijn py-3"><span class="font-kop text-rood" aria-hidden="true">]</span><span>{d.charAt(0).toUpperCase() + d.slice(1)}</span></li>
              ))}
            </ul>
            <p class="rijs mt-8 text-sm text-steen">Haarden onder meer van {merken.slice(0, -1).join(', ')} en {merken.at(-1)}. Schouwen van Galante, Gijsen, Kal-fire en Lugé Haarden.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. HAARDKIEZER: één zin, uitleg uit zijn eigen informatiepagina, eindigt in WhatsApp -->
    <section id="kiezen" class="op-donker bg-roet py-20 text-wit md:py-24 lg:py-20" aria-labelledby="kies-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <form class="lg:col-span-8" data-kiezer>
          <h2 id="kies-titel" class="text-2xl text-as">Welke haard past bij uw huis?</h2>
          <p class="mt-8 font-kop text-[clamp(1.375rem,2.8vw+.75rem,3.25rem)] leading-[1.3]">
            Ik denk aan
            <span class="kies-wrap"><label class="sr-only" for="k-type">Soort haard</label><select id="k-type" class="kies" data-type>
              {typen.map(([t, s]) => <option value={t} data-s={s}>{t}</option>)}
            </select></span>
            voor
            <span class="kies-wrap"><label class="sr-only" for="k-plek">Waar</label><select id="k-plek" class="kies" data-plek>
              {plekken.map((t) => <option value={t}>{t}</option>)}
            </select></span>.
            Rookkanaal:
            <span class="kies-wrap"><label class="sr-only" for="k-kanaal">Rookkanaal</label><select id="k-kanaal" class="kies" data-kanaal>
              {kanalen.map(([t, v], i) => <option value={t} data-v={v} selected={i === 1}>{t}</option>)}
            </select></span>.
          </p>
          <p class="mt-10 max-w-2xl border-l-4 border-gloed pl-5 text-lg text-wit/90" data-uitleg aria-live="polite">Een gesloten gashaard werkt met een eenvoudige muur- of dakdoorvoer: een schoorsteen is dan niet nodig.</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
            <a href={waMet('Hoi Hans, ik denk aan een gesloten gashaard voor een bestaand huis. Rookkanaal: nog geen rookkanaal. Kunt u een keer langskomen?')} class="knop" data-kiezer-wa><Icoon naam="wa" />Stuur dit naar Hans</a>
            <a href={site.telHref} class="link link-licht num font-semibold">of bel {site.tel}</a>
          </div>
          <p class="mt-5 text-sm text-as">Het bericht opent in WhatsApp; u verstuurt het zelf.</p>
        </form>
        <aside class="lg:col-span-4 lg:pt-24">
          <h3 class="text-xl">Rendement, volgens Hans</h3>
          <dl class="mt-5 text-as">
            <div class="flex items-baseline gap-3 border-b border-lijn-licht py-3"><dt>Open haard</dt><span class="mb-1 flex-1 border-b border-dotted border-lijn-licht" aria-hidden="true"></span><dd class="num text-wit">ongeveer 20%</dd></div>
            <div class="flex items-baseline gap-3 border-b border-lijn-licht py-3"><dt>Gesloten systeem</dt><span class="mb-1 flex-1 border-b border-dotted border-lijn-licht" aria-hidden="true"></span><dd class="num text-wit">boven de 70%</dd></div>
            <div class="flex items-baseline gap-3 border-b border-lijn-licht py-3"><dt>Moderne houtkachel</dt><span class="mb-1 flex-1 border-b border-dotted border-lijn-licht" aria-hidden="true"></span><dd class="num text-wit">meer dan 80%</dd></div>
          </dl>
          <p class="mt-5 text-sm text-as">Alle materialen voldoen aan het bouwbesluit en hebben een Europees CE-keurmerk.</p>
        </aside>
      </div>
    </section>

    <!-- 5. BUITEN: Girse Design -->
    <section id="buiten" class="py-20 md:py-24 lg:py-20" aria-labelledby="buiten-titel">
      <div class="wrap">
        <figure class="rijs kader">
          <Image src={buiten} alt="Zwarte buitenhaard met kap en rookpijp, met brandend hout, op een terras in een groene tuin" quality={62} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1280px) 1200px, 100vw" class="aspect-[4/3] w-full object-cover md:aspect-[3/1] md:object-[50%_64%]" />
        </figure>
        <div class="mt-14 grid gap-y-10 lg:grid-cols-12 lg:gap-x-12">
          <div class="lg:col-span-5">
            <h2 id="buiten-titel" class="rijs text-3xl">Ook buiten: vuur op het terras</h2>
            <p class="rijs mt-6 max-w-md text-lg text-steen">Hans werkt samen met Girse Design. Hun buitenhaarden richt u met een paar accessoires ook in als buitenkeuken.</p>
            <p class="rijs mt-6 max-w-md text-sm text-steen">Tip: Neem bij een bezoek enkele foto’s en de afmetingen van uw terras of overkapping mee.</p>
          </div>
          <div class="grid grid-cols-[1fr_1.1fr] items-start gap-6 lg:col-span-6 lg:col-start-7">
            <ul class="rijs">
              {['Wok', 'Pizza-oven', 'Elektrisch draaispit', 'Argentijnse steakpan', 'Kookpan met warmhoudstoof', 'Vetvangschaal', 'Vuurkorven en vuurschalen'].map((a) => (
                <li class="border-b border-lijn py-2.5">{a}</li>
              ))}
            </ul>
            <Image src={wok} alt="Buitenhaard met een wok boven het vuur, tussen hortensia’s" quality={60} widths={[260, 400, 520]} sizes="(min-width: 1024px) 26vw, 50vw" class="rijs aspect-[3/4] w-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- 6. ONDERHOUD + reviews -->
    <section id="onderhoud" class="bg-kalk-2 py-20 md:py-24 lg:py-20">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl">Eén keer per jaar een beurt</h2>
          <p class="rijs mt-6 max-w-md text-lg text-steen">Als onderhoudscontract of één keer los. Bij een gashaard doet Hans dit:</p>
        </div>
        <ol class="lg:col-span-6 lg:col-start-7">
          {['De ruiten schoonmaken', 'De brander en waakvlam controleren en reinigen', 'De gasaansluiting, de aansluiting op het rookgasafvoerkanaal en de toevoer van verbrandingslucht nalopen', 'De gasdruk nameten'].map((s, i) => (
            <li class="rijs grid grid-cols-[2.5rem_1fr] border-b border-lijn py-4" style={`--d:${i * 0.05}s`}><span class="num font-kop text-rood">{i + 1}</span><span>{s}</span></li>
          ))}
          <li class="rijs pt-6 text-sm text-steen">Houthaard? Laat de schoorsteen 1 of 2 keer per jaar controleren door een erkend ASPB-schoorsteenveegbedrijf.</li>
        </ol>
      </div>

      <div class="wrap mt-20 md:mt-24">
        <h2 class="rijs text-2xl">Op Google over Hans</h2>
        <figure class="rijs mt-8 max-w-5xl">
          <blockquote class="font-kop text-[clamp(1.375rem,1.3vw+1rem,2rem)] leading-[1.28]">“{reviews[0].tekst}”</blockquote>
          <figcaption class="mt-5 text-sm text-steen">{reviews[0].naam}, Google-review</figcaption>
        </figure>
        <div class="mt-12 grid gap-x-12 gap-y-12 md:grid-cols-2 lg:grid-cols-4">
          {reviews.slice(1).map((x, i) => (
            <figure class="rijs border-t-2 border-roet pt-5" style={`--d:${i * 0.06}s`}>
              <blockquote class="text-base leading-relaxed">“{x.tekst}”</blockquote>
              <figcaption class="mt-4 text-sm text-steen">{x.naam}, Google-review</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. LANGSKOMEN -->
    <section id="langskomen" class="py-20 md:py-24 lg:py-20">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl">Langskomen kan, op afspraak</h2>
          <p class="rijs mt-6 max-w-md text-lg text-steen">Op aanvraag gaat de showroom open voor een persoonlijke afspraak, waarbij u de enige gast bent. Hans komt ook met voorbeelden bij u thuis.</p>
          <p class="rijs mt-10 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <div class="rijs mt-8 flex flex-wrap gap-3">
            <a href={waMet('Hoi Hans, ik wil graag een afspraak maken.')} class="knop"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href={site.telHref} class="knop knop-donker num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <p class="rijs mt-6"><a href={site.maps} class="link inline-flex items-center gap-2 font-semibold"><Icoon naam="pin" class="h-4 w-4 text-rood" />Route in Google Maps</a></p>
        </div>
        <figure class="rijs lg:col-span-6 lg:col-start-7">
          <Image src={pand} alt="Bedrijfsverzamelgebouw aan de Lucas Gasselstraat met parkeerplaats en naamborden; een rode pijl wijst de unit aan" quality={60} widths={[400, 640, 900]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="mt-3 text-sm text-steen">De rode pijl op de foto is van Hans zelf.</figcaption>
        </figure>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-kiezer]');
  if (f) {
    const type = f.querySelector<HTMLSelectElement>('[data-type]')!;
    const plek = f.querySelector<HTMLSelectElement>('[data-plek]')!;
    const kanaal = f.querySelector<HTMLSelectElement>('[data-kanaal]')!;
    const uitleg = f.querySelector<HTMLElement>('[data-uitleg]')!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-kiezer-wa]')!;
    const basis = wa.href.split('?')[0];
    // Uitleg uit zijn eigen pagina "Informatie" en "Haarden" (webarchief april 2025).
    const tekst = (s: string, k: string) => {
      if (s === 'elek') return 'Een elektrische haard heeft geen rookkanaal of schoorsteen nodig: stekker erin en genieten van het vlammenspel.';
      if (s === 'buiten') return 'Buitenhaarden van Girse Design, ook in te richten als buitenkeuken. Neem foto’s en de maten van uw terras mee.';
      if (s === 'schouw') return 'Een schouw op maat: eigen materiaalkeuze, alle afmetingen mogelijk, en de apparatuur passend weggewerkt.';
      if (s === 'ombouw') return 'Uw houthaard ombouwen naar een gashaard kan. Hans regelt ook het rookkanaal en de aansluiting.';
      if (s === 'open') return 'Een open haard heeft altijd een verticaal afvoerkanaal nodig, en vaak een luchttoevoer van buiten tot vlak bij de haard.';
      if (s === 'gas') return k === 'ja' ? 'Een gesloten gashaard werkt via één dubbelwandig kanaal. Wat er met uw schoorsteen kan, bekijkt Hans bij u thuis.' : 'Een gesloten gashaard werkt met een eenvoudige muur- of dakdoorvoer: een schoorsteen is dan niet nodig.';
      if (s === 'hout') return k === 'nee' ? 'Hout vraagt een goed rookkanaal. Hans legt het aan en sluit de kachel of haard aan, zodat u direct kunt stoken.' : 'Bij hout is een goed rookkanaal belangrijk. Hans kijkt bij u thuis of het bestaande kanaal geschikt is.';
      return '';
    };
    const zet = () => {
      const s = type.selectedOptions[0]?.dataset.s || '';
      const k = kanaal.selectedOptions[0]?.dataset.v || '';
      uitleg.textContent = tekst(s, k);
      const bericht = `Hoi Hans, ik denk aan ${type.value} voor ${plek.value}. Rookkanaal: ${kanaal.value}. Kunt u een keer langskomen?`;
      wa.href = `${basis}?text=${encodeURIComponent(bericht)}`;
    };
    // Elke keuzelijst zo breed als het gekozen woord, zodat de zin een zin blijft.
    const maat = document.createElement('span');
    maat.setAttribute('aria-hidden', 'true');
    maat.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0';
    f.appendChild(maat);
    const pas = () => f.querySelectorAll<HTMLSelectElement>('select').forEach((s) => {
      const cs = getComputedStyle(s);
      maat.style.font = cs.font; maat.style.letterSpacing = cs.letterSpacing;
      maat.textContent = s.selectedOptions[0]?.text || '';
      s.style.width = `calc(${maat.getBoundingClientRect().width}px + 1.15em)`;
    });
    f.addEventListener('change', () => { zet(); pas(); });
    document.fonts?.ready.then(pas); addEventListener('resize', pas); pas();
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
