---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-white/10 bg-petrol text-white">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-xl font-black tracking-[-0.03em] no-underline">Heijstek <span class="font-normal text-signal">autoschade</span></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href="#herstel" class="no-underline hover:text-signal">Schadeherstel</a></li>
          <li><a href="#meer" class="no-underline hover:text-signal">Ruiten en meer</a></li>
          <li><a href="#contact" class="no-underline hover:text-signal">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-signal !px-3.5 !py-2 text-sm">Bel ons</a>
    </div>
  </header>
) : (
  <footer class="bg-petrol py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right">FOCWA · Eurogarant · RDW-erkend<br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
