---
// Hun logo: waaier van stenen platen (nagetekend als SVG) + woordmerk zoals op hun gevel.
interface Props { donker?: boolean; class?: string }
const { donker = true, class: cls = '' } = Astro.props;
import { url } from '../data/site';
const zwart = donker ? '#e7e2d9' : '#000';
const lijn = donker ? '#121110' : '#000';
---
<a href={url('')} class={`flex items-center gap-2.5 no-underline ${cls}`} aria-label="EU Naturalstones, naar de homepage">
  <svg viewBox="0 0 165 124" class="h-9 w-auto flex-none md:h-10" aria-hidden="true">
    <g stroke={lijn} stroke-width="3" stroke-linejoin="miter">
      <path d="M62 4h37v84H62z" fill="#ff6600" />
      <path d="M119 29l26 25-38 39-26-26z" fill="#979ea3" />
      <path d="M42 29l64 63-24 25-66-63z" fill="#505355" />
      <path d="M4 83h78v36H4z" fill={zwart} />
      <path d="M108 84h49v35H83z" fill="#fff" />
    </g>
  </svg>
  <span class={`font-kop text-[1.6rem] font-extrabold uppercase leading-none tracking-[.01em] md:text-[1.8rem] ${donker ? 'text-wit' : 'text-nero'}`}>EU <span class="text-oranje">Naturalstones</span></span>
</a>
