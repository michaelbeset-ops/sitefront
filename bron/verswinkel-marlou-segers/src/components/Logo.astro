---
// Wordmark naar hun oude kopbalk: roomwit label met klein "Verswinkel" boven "Marlou Segers" in een serif.
// Modern gemaakt met een kaaspunt als beeldmerk.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <span class="sr-only">Verswinkel Marlou Segers</span>
  <svg viewBox="0 0 34 34" class="h-9 w-9 flex-none" aria-hidden="true">
    <rect width="34" height="34" rx="9" class={licht ? 'fill-kaas' : 'fill-olijf'} />
    <path d="M7 24 27 12.5V24z" class={licht ? 'fill-olijf' : 'fill-kaas'} />
    <circle cx="17" cy="20.3" r="1.7" class={licht ? 'fill-kaas' : 'fill-olijf'} />
    <circle cx="22.6" cy="18.4" r="1.2" class={licht ? 'fill-kaas' : 'fill-olijf'} />
  </svg>
  <span aria-hidden="true" class="flex flex-col">
    <span class={`font-body text-[0.62rem] font-bold tracking-[0.3em] uppercase ${licht ? 'text-terra-licht' : 'text-terra'}`}>Verswinkel</span>
    <span class={`mt-1 font-display text-[1.2rem] font-extrabold tracking-[-0.01em] ${licht ? 'text-white' : 'text-olijf'}`}>Marlou Segers</span>
  </span>
</span>
