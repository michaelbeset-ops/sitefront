---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
// Beeldmerk: een zeshoek (raat) met een bijenkorf erin, in hun eigen stijl.
const merk = `<svg viewBox="0 0 40 44" aria-hidden="true" class="h-10 w-9 flex-none"><path d="M20 1.5 38 11.8v20.4L20 42.5 2 32.2V11.8z" fill="#f2b43a"/><path d="M11 31.5h18M9.8 26.8h20.4M10.6 22.1h18.8M12.4 17.4h15.2M15.6 12.9h8.8" stroke="#1d150d" stroke-width="2.4" stroke-linecap="round"/><path d="M18 31.5v-3.2a2 2 0 0 1 4 0v3.2" fill="#1d150d"/></svg>`;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex min-w-0 items-center gap-2.5 no-underline">
        <Fragment set:html={merk} />
        <span class="leading-none">
          <span class="block text-[0.6875rem] font-extrabold tracking-[0.28em] text-amber uppercase">Imkerij</span>
          <span class="block font-display text-xl font-semibold tracking-[-0.01em]">Poppendamme</span>
        </span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm font-bold">
          <li><a href="#open" class="no-underline transition-colors hover:text-amber">Openingstijden</a></li>
          <li><a href="#winkel" class="no-underline transition-colors hover:text-amber">Winkel</a></li>
          <li><a href="#expo" class="no-underline transition-colors hover:text-amber">Expositie</a></li>
          <li><a href="#terras" class="no-underline transition-colors hover:text-amber">Terras</a></li>
          <li><a href="#route" class="no-underline transition-colors hover:text-amber">Route</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-amber !px-4 !py-2.5 text-sm"><Fragment set:html={tel} /><span class="sm:hidden">Bel</span><span class="hidden whitespace-nowrap tabular-nums sm:inline">{site.tel}</span></a>
    </div>
  </header>
) : (
  <footer class="donker bg-bij pt-12 pb-10 text-white/85">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="flex items-center gap-2.5"><Fragment set:html={merk} /><span class="font-display text-xl font-semibold text-white">{site.naam}</span></p>
        <p class="mt-4">{site.straat}, 4364 SL {site.plaats} ({site.regio})</p>
      </div>
      <div class="md:col-span-4">
        <p><a href={site.telHref} class="whitespace-nowrap tabular-nums underline decoration-honing underline-offset-4">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline decoration-honing underline-offset-4">{site.mail}</a></p>
        <p class="mt-4 text-white/75">KvK [[AANLEVEREN: KvK-nummer]]</p>
      </div>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-4">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 border-t border-white/15 pt-6 text-xs text-white/75">Sfeerfoto's via Unsplash en foto's van de huidige website, ter illustratie. Bij oplevering vervangen we ze door nieuwe eigen foto's.</p>}
  </footer>
)}
