---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, seizoenen, producten } from '../data/site';
import hero from '../assets/hero.jpg';
import glas from '../assets/glas.jpg';
import winkel from '../assets/winkel.jpg';
import balie from '../assets/balie.jpg';
import korven from '../assets/korven.jpg';
import kast from '../assets/kast.jpg';
import tuin from '../assets/tuin.jpg';
import pand from '../assets/pand.jpg';
import stokroos from '../assets/stokroos.jpg';
import pot from '../assets/pot.jpg';
import lepel from '../assets/lepel.jpg';
import bloem from '../assets/bloem.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const vink = `<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m2.5 6.2 2.3 2.3 4.7-5"/></svg>`;
const eigen = { widths: [320, 640] };
---
<Base
  title="Imkerij Poppendamme | Imkerijwinkel, expositie en terras in Grijpskerke"
  description="Al 25 jaar een begrip op Walcheren. Imkerijwinkel, expositieruimte met bijen achter glas en een groen terras aan de Poppendamseweg in Grijpskerke. Toegang is gratis."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: goudkleurige raat groot rechts (mobiel bovenaan), hun eigen bijen achter glas als overlappende kaart. -->
    <section class="donker bg-bij text-white lg:bg-[linear-gradient(to_bottom,var(--color-bij)_calc(100%-6rem),var(--color-paper)_calc(100%-6rem))]">
      <div class="wrap grid lg:grid-cols-12 lg:gap-12">
        <div class="relative -mx-5 md:-mx-8 lg:col-span-6 lg:col-start-7 lg:row-start-1 lg:mx-0 lg:pt-12">
          <figure class="aspect-[16/11] overflow-hidden sm:aspect-[16/9] lg:aspect-[5/6] lg:rounded-xl lg:shadow-lg">
            <Foto src={hero} alt="Honingbijen aan het werk op een goudgele raat, een deel van de cellen is open" hero sizes="(min-width: 1216px) 560px, (min-width: 1024px) 46vw, 100vw" widths={[480, 800, 1120, 1600]} />
          </figure>
          <figure class="absolute right-5 -bottom-12 w-40 rounded-xl bg-paper p-1.5 text-ink shadow-lg sm:w-52 md:right-8 lg:right-auto lg:-left-20 lg:bottom-16 lg:w-64 lg:p-2">
            <div class="aspect-[4/3] overflow-hidden rounded-lg"><Foto src={glas} alt="Onze bijen achter glas in de expositieruimte, met de naam Imkerij Poppendamme op het glas" widths={[320, 640]} sizes="(min-width: 1024px) 240px, 200px" /></div>
            <figcaption class="px-1.5 pt-1.5 pb-0.5 text-xs leading-snug font-bold sm:text-sm">Onze bijen, veilig achter glas</figcaption>
          </figure>
        </div>
        <div class="pt-16 pb-14 sm:pt-20 lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:pt-20 lg:pb-36">
          <p class="kicker text-honing">Al 25 jaar een begrip op Walcheren</p>
          <h1 class="mt-4 text-4xl">Honing, bijen en een groen terras</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">Aan een van die mooie binnenwegen vindt u onze imkerijwinkel, expositieruimte en terras. De ideale plek om even uit te rusten na een fietstocht over het Walcherse platteland.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-honing"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href="#open" class="btn btn-line">Vandaag open?</a>
          </div>
          <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-white/20 pt-6 text-sm">
            <div><dt class="text-white/75">Google</dt><dd><strong class="font-display text-2xl font-semibold">{site.google}</strong> <span class="block text-white/80 sm:inline">({site.reviews} reviews)</span></dd></div>
            <div><dt class="text-white/75">Vandaag</dt><dd class="font-display text-lg leading-tight font-semibold sm:text-xl" data-kort>Zie de tijden</dd></div>
            <div><dt class="text-white/75">Toegang</dt><dd class="font-display text-lg leading-tight font-semibold sm:text-xl">Gratis</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Wow: vandaag open? Live status uit de echte seizoenstijden, plus een dagplanner voor een uitje. -->
    <section id="open" class="scroll-mt-20 py-16 lg:pt-20 lg:pb-24" data-open>
      <div class="wrap grid gap-8 lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-12 lg:gap-y-8">
        <div class="lg:col-span-5 lg:row-start-1">
          <p class="kicker text-amber">Openingstijden</p>
          <h2 class="mt-3 text-3xl">Vandaag open?</h2>
          <p class="mt-5 text-ink-soft">Onze openingstijden wisselen met het seizoen. Hier ziet u meteen of we open zijn, en welke dag het beste past voor een uitje.</p>
        </div>
        <div data-tabellen class="order-last lg:order-none lg:col-span-5 lg:col-start-1 lg:row-start-2">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
            {seizoenen.map((s) => (
              <div data-seizoen={s.id} class="rounded-xl border border-line bg-white p-5 shadow-sm transition-shadow">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-lg">{s.naam}</h3>
                  <span data-nu hidden class="rounded-md bg-zee px-2 py-0.5 text-xs font-extrabold text-zee-diep">Nu</span>
                </div>
                <dl class="mt-3 text-sm">
                  {s.tijden.map((t) => (
                    <div class="flex justify-between gap-4 border-t border-line py-2"><dt>{t.dag}</dt><dd class="font-bold whitespace-nowrap tabular-nums">{t.tijd}</dd></div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
          <p class="mt-5 font-bold">Toegang is gratis.</p>
        </div>

        <div class="lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1">
          <div class="donker raat rounded-xl bg-bij p-6 text-white shadow-lg sm:p-8">
            <p class="flex items-center gap-2.5 text-sm font-bold text-white/80"><span data-stip class="h-2.5 w-2.5 flex-none rounded-full bg-white/40" aria-hidden="true"></span><span data-vandaag>Openingstijden</span></p>
            <p data-status aria-live="polite" class="mt-3 font-display text-3xl leading-[1.05] font-semibold">Wij zijn open volgens de tijden op deze pagina.</p>
            <p data-volgende class="mt-3 text-lg text-white/85"></p>
            <p data-wissel hidden class="mt-5 rounded-lg border border-honing/40 px-4 py-3 text-sm text-white/90"></p>

            <div data-planner hidden class="mt-8 border-t border-white/15 pt-6">
              <h3 class="text-xl">Plan uw uitje</h3>
              <p class="mt-1 text-sm text-white/75">Kies een dag.</p>
              <div data-dagen class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-8" role="group" aria-label="Kies een dag"></div>
              <div data-keuze aria-live="polite" class="mt-5 rounded-xl bg-bij-2 p-5">
                <p data-keuze-kop class="font-display text-xl leading-tight font-semibold"></p>
                <p data-keuze-tekst class="mt-1 text-white/85"></p>
              </div>
            </div>

            <ul class="mt-8 grid gap-4 border-t border-white/15 pt-6 text-sm text-white/85 sm:grid-cols-2">
              <li><strong class="block text-white">Met de fiets</strong>De imkerij staat aangegeven op de bekende fietsrouteborden van de ANWB, op een knooppunt van fiets- en wandelroutes.</li>
              <li><strong class="block text-white">Met een groep</strong>Dat kan altijd. Stuur ons een <a href={`mailto:${site.mail}`} class="underline decoration-honing underline-offset-4">e-mail</a> om naar de mogelijkheden te informeren.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <script>
      // Live status uit de seizoenstijden van hun site. Rekent in Nederlandse tijd, ook voor bezoekers elders.
      const sectie = document.querySelector<HTMLElement>('[data-open]');
      if (sectie) {
        const $ = <T extends HTMLElement>(s: string) => sectie.querySelector<T>(s)!;
        const dagen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
        const kortDag = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];
        const maanden = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
        const delen = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date()).map((p) => [p.type, p.value]));
        const vandaag = new Date(Date.UTC(+delen.year, +delen.month - 1, +delen.day));
        const minuten = +delen.hour * 60 + +delen.minute;
        const dag = (n: number) => new Date(vandaag.getTime() + n * 864e5);
        const zomer = (d: Date) => { const m = d.getUTCMonth() + 1, dd = d.getUTCDate(); return (m > 3 && m < 10) || (m === 10 && dd <= 25); };
        const tijden = (d: Date): [number, number] | null => {
          const w = d.getUTCDay();
          if (zomer(d)) return w === 1 ? null : w === 0 ? [13, 17] : [10, 17];
          return w === 6 ? [10, 17] : null;
        };
        const uur = (h: number) => `${String(h).padStart(2, '0')}:00`;
        const datum = (d: Date) => `${dagen[d.getUTCDay()]} ${d.getUTCDate()} ${maanden[d.getUTCMonth()]}`;
        const hoofd = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

        // Status nu
        const t = tijden(vandaag);
        const status = $('[data-status]'), volgende = $('[data-volgende]'), stip = $('[data-stip]'), kort = document.querySelector<HTMLElement>('[data-kort]');
        $('[data-vandaag]').textContent = `Vandaag, ${datum(vandaag)}`;
        let open = false;
        if (t && minuten < t[0] * 60) { status.textContent = `Vandaag open vanaf ${uur(t[0])}`; volgende.textContent = `Van ${uur(t[0])} tot ${uur(t[1])}.`; if (kort) kort.textContent = `Open vanaf ${uur(t[0])}`; }
        else if (t && minuten < t[1] * 60) { open = true; status.textContent = `Nu open, tot ${uur(t[1])}`; volgende.textContent = `Vandaag van ${uur(t[0])} tot ${uur(t[1])}. Kom gerust langs.`; if (kort) kort.textContent = `Open tot ${uur(t[1])}`; }
        else {
          status.textContent = t ? 'Voor vandaag gesloten' : 'Vandaag gesloten';
          if (kort) kort.textContent = 'Gesloten';
          for (let i = 1; i < 200; i++) { const v = tijden(dag(i)); if (v) { volgende.textContent = `Weer open: ${i === 1 ? 'morgen' : datum(dag(i))}, vanaf ${uur(v[0])}.`; break; } }
        }
        stip.classList.remove('bg-white/40');
        stip.classList.add(open ? 'bg-honing' : 'bg-white/60');

        // Seizoen markeren en een wissel binnen 30 dagen aankondigen
        const nu = zomer(vandaag) ? 'zomer' : 'winter';
        sectie.querySelectorAll<HTMLElement>('[data-seizoen]').forEach((k) => {
          const actief = k.dataset.seizoen === nu;
          k.querySelector<HTMLElement>('[data-nu]')!.hidden = !actief;
          k.classList.toggle('ring-2', actief); k.classList.toggle('ring-amber', actief);
          if (!actief) k.classList.add('opacity-80');
        });
        for (let i = 1; i <= 30; i++) {
          if (zomer(dag(i)) !== zomer(vandaag)) {
            const w = $('[data-wissel]');
            w.textContent = zomer(dag(i))
              ? `Vanaf ${datum(dag(i))} gelden de zomertijden: dinsdag t/m zaterdag 10:00 - 17:00, zondag 13:00 - 17:00.`
              : `Let op: vanaf ${datum(dag(i))} gelden de wintertijden. Dan zijn we alleen op zaterdag open, van 10:00 tot 17:00.`;
            w.hidden = false;
            break;
          }
        }

        // Dagplanner: vandaag + 7 dagen
        const rij = $('[data-dagen]'), kop = $('[data-keuze-kop]'), tekst = $('[data-keuze-tekst]');
        const kies = (i: number) => {
          rij.querySelectorAll('button').forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
          const d = dag(i), v = tijden(d);
          kop.textContent = `${i === 0 ? 'Vandaag, ' : i === 1 ? 'Morgen, ' : ''}${i < 2 ? datum(d) : hoofd(datum(d))}: ${v ? `open van ${uur(v[0])} tot ${uur(v[1])}` : 'gesloten'}`;
          tekst.textContent = v
            ? 'Imkerijwinkel, expositieruimte en terras. Toegang is gratis, reserveren is niet nodig.'
            : 'Wilt u toch iets bestellen? Bel of mail gerust, dan wordt uw bestelling per post bezorgd.';
        };
        for (let i = 0; i < 8; i++) {
          const d = dag(i), v = tijden(d);
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'rounded-lg border border-white/20 px-1 py-2.5 text-center transition-colors hover:border-honing aria-pressed:border-honing aria-pressed:bg-honing aria-pressed:text-bij';
          b.innerHTML = `<span class="sr-only">${datum(d)}, ${v ? `open van ${uur(v[0])} tot ${uur(v[1])}` : "gesloten"}</span><span aria-hidden="true"><span class="block text-xs font-bold uppercase">${i === 0 ? 'vand.' : kortDag[d.getUTCDay()]}</span><span class="block font-display text-xl font-semibold tabular-nums">${d.getUTCDate()}</span><span class="block text-xs whitespace-nowrap tabular-nums">${v ? `${v[0]}-${v[1]}` : 'dicht'}</span></span>`;
          b.addEventListener('click', () => kies(i));
          rij.append(b);
        }
        $('[data-planner]').hidden = false;
        kies(0);
      }
    </script>

    <!-- Winkel: eigen foto's als collage, tekst ernaast, daaronder het bestellijstje. -->
    <section id="winkel" class="scroll-mt-20 bg-was py-16 lg:py-24">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12">
        <div class="relative pb-16 sm:pb-24 lg:col-span-6">
          <figure class="max-w-[560px] overflow-hidden rounded-xl shadow-md">
            <div class="aspect-[4/3]"><Foto src={winkel} alt="Onze imkerijwinkel: schappen met honing en kaarsen, een strooien bijenkorf en manden met honingsnoep" {...eigen} sizes="(min-width: 1024px) 560px, 92vw" /></div>
          </figure>
          <figure class="absolute right-0 bottom-0 w-[58%] max-w-[320px] rounded-xl bg-paper p-1.5 shadow-lg">
            <div class="aspect-[4/3] overflow-hidden rounded-lg"><Foto src={balie} alt="Achter de balie in onze winkel, met de vitrine voor ambachtelijk ijs" {...eigen} sizes="(min-width: 1024px) 310px, 56vw" /></div>
            <figcaption class="px-1.5 pt-1.5 text-xs font-bold sm:text-sm">Aan de balie, met ambachtelijk ijs</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="kicker text-amber">Imkerijwinkel</p>
          <h2 class="mt-3 text-3xl">Alles wat met bijen en honing te maken heeft</h2>
          <p class="mt-5 text-lg">Wie op zoek is naar bijzondere bijenproducten of een leuk en uniek kadootje, komt in de imkerijwinkel goed aan zijn trekken.</p>
          <p class="mt-4 text-ink-soft">Wij vinden het veel leuker als u zelf langskomt en hebben daarom geen webwinkel. Kunt u niet langskomen? Bel of mail ons voor uw bestelling. Wij zorgen er dan voor dat uw bestelling per post thuis wordt afgeleverd.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#bestellen" class="btn btn-amber">Stel uw bestelling samen</a>
            <a href={site.telHref} class="btn btn-line btn-line-ink"><Fragment set:html={tel} /><span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
        </div>
      </div>

      <div id="bestellen" class="wrap mt-16 scroll-mt-20 lg:mt-24" data-bestel data-voorstel={site.voorstel ? '1' : '0'}>
        <div class="grid gap-10 border-t border-line pt-12 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-4">
            <h3 class="text-2xl">Bestellen zonder webwinkel</h3>
            <p class="mt-3 text-ink-soft">Tik aan wat u zoekt. Hieronder staat dan een bericht klaar dat u kunt mailen, of noem het als u belt.</p>
            <figure class="mt-8 hidden aspect-[4/5] overflow-hidden rounded-xl shadow-md lg:block">
              <Foto src={pot} alt="Een glazen pot honing op een houten tafel in het zonlicht" sizes="360px" widths={[400, 720]} />
            </figure>
          </div>
          <div class="lg:col-span-8">
            <ul class="grid gap-3 sm:grid-cols-2">
              {producten.map((p, i) => (
                <li>
                  <label class="group flex h-full cursor-pointer gap-4 rounded-xl border border-line bg-white p-4 shadow-sm transition-colors hover:border-amber has-[:checked]:border-amber has-[:checked]:bg-paper">
                    <input type="checkbox" name="product" value={p.naam} class="peer sr-only" />
                    <span class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-md border-2 border-amber text-white transition-colors peer-checked:bg-amber peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-amber [&>svg]:h-3.5 [&>svg]:w-3.5"><Fragment set:html={vink} /></span>
                    <span class="min-w-0">
                      <span class="block font-display text-lg leading-tight font-semibold"><span class="mr-1.5 text-sm text-ink-soft tabular-nums">0{i + 1}</span>{p.naam}</span>
                      <span class="mt-1 block text-sm text-ink-soft">{p.tekst}</span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>
            <div class="mt-6 rounded-xl bg-bij p-5 text-white shadow-md sm:p-6 donker">
              <p class="kicker text-honing">Uw bericht</p>
              <p data-bericht aria-live="polite" class="mt-3 text-lg whitespace-pre-line">Kies hierboven wat u zoekt, of bel ons gerust op <span class="whitespace-nowrap tabular-nums">{site.tel}</span>.</p>
              <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                {site.voorstel ? (
                  <p class="text-sm text-white/85">Dit is een ontwerpvoorstel: deze module verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline decoration-honing underline-offset-4">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all underline decoration-honing underline-offset-4">{site.mail}</a>.</p>
                ) : (
                  <>
                    <a data-mailto href={`mailto:${site.mail}`} class="btn btn-honing"><Fragment set:html={mail} />Mail dit bericht</a>
                    <a href={site.telHref} class="btn btn-line"><Fragment set:html={tel} />Liever bellen</a>
                  </>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      // Bestellijstje: stelt een mailbericht samen van de aangevinkte producten. Verstuurt zelf niets.
      const blok = document.querySelector<HTMLElement>('[data-bestel]');
      if (blok) {
        const bericht = blok.querySelector<HTMLElement>('[data-bericht]')!;
        const link = blok.querySelector<HTMLAnchorElement>('[data-mailto]');
        const start = bericht.innerHTML;
        const lijst = (a: string[]) => (a.length > 1 ? a.slice(0, -1).join(', ') + ' en ' + a[a.length - 1] : a[0]);
        blok.addEventListener('change', () => {
          const aan = [...blok.querySelectorAll<HTMLInputElement>('input[name=product]:checked')].map((i) => i.value.toLowerCase());
          if (!aan.length) { bericht.innerHTML = start; return; }
          const tekst = `Beste Imkerij Poppendamme,\n\nGraag bestel ik: ${lijst(aan)}.\nKunt u mij laten weten wat de mogelijkheden zijn?\n\nMijn naam en adres:`;
          bericht.textContent = tekst;
          if (link) link.href = `mailto:imkerijpoppendamme@gmail.com?subject=${encodeURIComponent('Bestelling')}&body=${encodeURIComponent(tekst + '\n')}`;
        });
      }
    </script>

    <!-- Expositie: donker, grote sfeerfoto met hun eigen korvencollectie eroverheen, genummerde lijst. -->
    <section id="expo" class="donker raat scroll-mt-20 bg-bij py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="relative pb-20 sm:pb-28 lg:col-span-7 lg:pb-0">
          <figure class="aspect-[4/3] overflow-hidden rounded-xl lg:aspect-[5/4]">
            <Foto src={kast} alt="Honingbijen vliegen af en aan bij de vliegplank van een bijenkast in het gras" sizes="(min-width: 1024px) 640px, 100vw" />
          </figure>
          <figure class="absolute right-3 bottom-0 w-[62%] max-w-[360px] rounded-xl bg-paper p-1.5 text-ink shadow-lg lg:-right-8 lg:-bottom-12">
            <div class="aspect-[4/3] overflow-hidden rounded-lg"><Foto src={korven} alt="Oude strooien en houten bijenkorven op een rij in onze expositieruimte" {...eigen} sizes="(min-width: 1024px) 350px, 60vw" /></div>
            <figcaption class="px-1.5 pt-1.5 text-xs font-bold sm:text-sm">Korven uit onze collectie</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-5">
          <p class="kicker text-honing">Expositie</p>
          <h2 class="mt-3 text-3xl">Bijen aan het werk, veilig achter glas</h2>
          <p class="mt-5 text-lg text-white/85">De honingbij is het kleinste landbouwhuisdier van de mens. Maar zeker een van de belangrijkste: de bij is onmisbaar voor de wereldwijde voedselproductie.</p>
          <ol class="mt-8 border-t border-white/15">
            <li class="grid grid-cols-[2.5rem_1fr] gap-2 border-b border-white/15 py-5">
              <span class="font-display text-lg font-semibold text-honing tabular-nums">01</span>
              <div><h3 class="text-xl">Bijen achter glas</h3><p class="mt-1.5 text-white/85">Vanaf een paar centimeter ziet u de werksters nieuwe raten maken en af en aan vliegen met klontjes stuifmeel aan de poten. Met een beetje geluk ziet u een bijenzwerm of de bruidsvlucht van de koningin.</p></div>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-2 border-b border-white/15 py-5">
              <span class="font-display text-lg font-semibold text-honing tabular-nums">02</span>
              <div><h3 class="text-xl">Imkermaterialen van over de hele wereld</h3><p class="mt-1.5 text-white/85">Een kleine tentoonstelling over de bijenhouderij: een kort en interessant overzicht van wat er allemaal komt kijken bij het houden van bijen.</p></div>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-2 border-b border-white/15 py-5">
              <span class="font-display text-lg font-semibold text-honing tabular-nums">03</span>
              <div><h3 class="text-xl">De film</h3><p class="mt-1.5 text-white/85">Een informatieve film die het leven van de honingbij duidelijk maakt voor jong en oud.</p></div>
            </li>
          </ol>
          <p class="mt-6 text-white/85">De expositie is vrij toegankelijk, reserveren is niet nodig. Heeft u daarna nog vragen over bijen? Die beantwoorden we graag.</p>
        </div>
      </div>
    </section>

    <!-- Terras: zeegroen vlak, tekst met een kleine 'kaart', fotobento met hun tuin. -->
    <section id="terras" class="scroll-mt-20 bg-zee py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-zee-diep">Terras</p>
          <h2 class="mt-3 text-3xl">Midden in onze drachtplantentuin</h2>
          <p class="mt-5 text-lg">Al sinds jaar en dag een populaire pleisterplaats voor fietsers en wandelaars. Wordt de drukte aan de Zeeuwse kusten u soms wat te veel, dan komt u hier even helemaal tot rust.</p>
          <div class="mt-8 rounded-xl bg-paper p-6 shadow-sm">
            <h3 class="text-xl">Op het terras</h3>
            <ul class="mt-3">
              {['Koffie met gebak', 'Een kopje honingthee', 'Een heerlijk honingijsje', 'Thee en diverse andere versnaperingen'].map((i) => (
                <li class="flex items-center gap-3 border-t border-line py-2.5 first:border-t-0"><span class="h-2 w-2 flex-none rotate-45 bg-amber" aria-hidden="true"></span>{i}</li>
              ))}
            </ul>
          </div>
          <p class="mt-6 text-ink-soft">Wilt u ons met een grotere groep bezoeken? Dat kan uiteraard altijd. Stuur ons een <a href={`mailto:${site.mail}`} class="font-bold text-zee-diep underline underline-offset-4">e-mail</a> om naar de mogelijkheden te informeren.</p>
        </div>
        <div class="grid grid-cols-2 gap-3 self-start sm:gap-4 lg:col-span-7">
          <figure class="col-span-2 overflow-hidden rounded-xl shadow-sm">
            <div class="aspect-[16/10]"><Foto src={tuin} alt="Onze tuin met het terras onder een parasol, voor het huis met de bakstenen gevel" {...eigen} sizes="(min-width: 1024px) 640px, 92vw" /></div>
          </figure>
          <figure class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm">
            <Foto src={lepel} alt="Een honinglepel boven een open pot honing" sizes="(min-width: 1024px) 330px, 46vw" widths={[400, 800]} />
          </figure>
          <figure class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm">
            <Foto src={bloem} alt="Een honingbij met stuifmeel aan de poot op een paarse bloem" sizes="(min-width: 1024px) 330px, 46vw" widths={[400, 800]} />
          </figure>
        </div>
      </div>
    </section>

    <!-- Route: het pand, de verhuizing in 2011 en de routebeschrijving als stappen. -->
    <section id="route" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-amber">Route</p>
          <h2 class="mt-3 text-3xl">Op een steenworp van Grijpskerke</h2>
          <p class="mt-5 text-lg">Centraal gelegen op Walcheren, in de Poppendamseweg.</p>
          <figure class="mt-8 max-w-[480px]">
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-md"><Foto src={pand} alt="Ons pand: zwart houten gebouw met een bakstenen topgevel, met rozen ervoor" {...eigen} sizes="(min-width: 1024px) 460px, 92vw" /></div>
            <figcaption class="mt-3 text-sm text-ink-soft">De imkerij aan de Poppendamseweg.</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="rounded-xl border-l-4 border-amber bg-was p-6">
            <p class="kicker text-amber">Eind 2011</p>
            <p class="mt-2 text-lg">We zijn verhuisd naar de schuur in de tuin bij het woonhuis, ongeveer 50 meter van de oude locatie. Rijdt u de Poppendamseweg in, dan ziet u aan de borden langs de weg precies waar de inrit is.</p>
          </div>
          <div class="mt-10">
            <h3 class="text-2xl">Met de fiets</h3>
            <p class="mt-3 text-ink-soft">U vindt ons op een knooppunt van een aantal fiets- en wandelroutes. De imkerij staat aangegeven op de bekende fietsrouteborden van de ANWB.</p>
          </div>
          <div class="mt-10">
            <h3 class="text-2xl">Met de auto</h3>
            <ol class="mt-4 border-t border-line">
              <li class="grid gap-1 border-b border-line py-4 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <span class="font-bold">Vanaf Middelburg</span>
                <span class="text-ink-soft">Richting Grijpskerke. Vlak voor Grijpskerke neemt u de eerste weg links na het tankstation.</span>
              </li>
              <li class="grid gap-1 border-b border-line py-4 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <span class="font-bold">Vanaf Domburg, Zoutelande of Veere</span>
                <span class="text-ink-soft">In Grijpskerke neemt u de Middelburgseweg richting Middelburg. Na ongeveer 1 kilometer slaat u rechtsaf de Poppendamseweg in.</span>
              </li>
            </ol>
          </div>
          <a href={site.maps} rel="noopener" class="btn btn-amber mt-8">Route plannen</a>
        </div>
      </div>
    </section>

    <!-- Contact: bellen en mailen voorop, tijden compact, daaronder 'zie ook'. -->
    <section id="contact" class="donker scroll-mt-20 bg-bij text-white">
      <div class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-6">
          <p class="kicker text-honing">Contact</p>
          <h2 class="mt-3 text-3xl">Heeft u vragen? Bel of mail gerust</h2>
          <p class="mt-5 text-lg text-white/85">We staan u graag te woord. Ook voor een bestelling, die we per post bij u thuis laten bezorgen.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-honing"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <p class="mt-6 break-all text-white/85"><a href={`mailto:${site.mail}`} class="underline decoration-honing decoration-2 underline-offset-4">{site.mail}</a></p>
          <address class="mt-8 text-lg not-italic">{site.naam}<br />{site.straat}<br />4364 SL {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="mt-4 inline-block font-bold underline decoration-honing decoration-2 underline-offset-4">Route plannen</a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="text-xl">Openingstijden</h3>
          {seizoenen.map((s) => (
            <div class="mt-5">
              <p class="text-sm font-bold text-honing">{s.naam}</p>
              <dl class="mt-2 border-t border-white/20">
                {s.tijden.map((t) => (
                  <div class="flex justify-between gap-4 border-b border-white/20 py-2.5"><dt>{t.dag}</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{t.tijd}</dd></div>
                ))}
              </dl>
            </div>
          ))}
          <p class="mt-5 font-bold">Toegang is gratis.</p>
        </div>
      </div>
      <div class="border-t border-white/15">
        <div class="wrap grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-12">
          <figure class="hidden max-w-[240px] overflow-hidden rounded-xl lg:col-span-3 lg:block">
            <div class="aspect-[4/3]"><Foto src={stokroos} alt="Roze stokrozen tegen een bakstenen muur in onze tuin" widths={[320, 480]} sizes="240px" /></div>
          </figure>
          <div class="lg:col-span-3">
            <h3 class="text-lg">Logeren bij de imker</h3>
            <p class="mt-2 text-sm text-white/80">Logeren in het huis van de imker? Dat kan: Logeren in Poppendamme.</p>
          </div>
          <div class="lg:col-span-3">
            <h3 class="text-lg">Een zwerm in de tuin?</h3>
            <p class="mt-2 text-sm text-white/80">De afdeling Walcheren van de Nederlandse Bijenhoudersvereniging heeft een scheplijst met imkers in de buurt.</p>
          </div>
          <div class="lg:col-span-3">
            <h3 class="text-lg">Bijenhouders in Noord-Uganda</h3>
            <p class="mt-2 text-sm text-white/80">Imkerij Poppendamme steunt de Stichting ter Bevordering van de Bijenteelt in Noord-Uganda.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
