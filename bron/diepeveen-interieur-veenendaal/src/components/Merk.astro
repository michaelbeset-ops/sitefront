---
// Woordmerk naar hun logo: het taupe blokje met de ronde D, DIEPEVEEN en daaronder ruim gespatieerd INTERIEUR.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['group inline-flex items-center gap-3 no-underline', licht ? 'text-wit' : 'text-inkt', cls]}>
  <svg viewBox="0 0 40 40" class="h-10 w-10 flex-none" aria-hidden="true">
    <defs><clipPath id={licht ? 'mk-l' : 'mk-d'}><rect x="0" y="0" width="40" height="40" rx="5" /></clipPath></defs>
    <g clip-path={`url(#${licht ? 'mk-l' : 'mk-d'})`}>
      <rect width="40" height="40" fill="#af9f8d" />
      <circle cx="15" cy="20" r="16.5" fill="#af9f8d" stroke={licht ? '#262924' : '#f5f4f0'} stroke-width="4" />
    </g>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="kop text-[1.45rem] tracking-[.02em]">DIEPEVEEN</span>
    <span class:list={['kop mt-1 text-[.62rem] tracking-[.62em]', licht ? 'text-mist' : 'text-grijs']}>INTERIEUR</span>
  </span>
</a>
