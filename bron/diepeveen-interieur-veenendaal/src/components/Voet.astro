---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const werk = ['Keukens', 'Kasten en zolderkasten', 'Badkamer en toilet', 'Bureaus en werkplekken', 'Balies voor bedrijven'];
---
<footer class="bg-grafiet text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Interieurbouw op maat. Ontwerp, productie en montage, voor thuis en voor bedrijven.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Wat we maken</p>
      <ul class="mt-3 space-y-1">{werk.map((p) => <li><a href={url('#projecten')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Bereikbaar</p>
      <p class="mt-3">Maandag t/m vrijdag<br /><span class="num">07:30 tot 17:00</span></p>
      <p class="mt-4 flex gap-4"><a href={site.facebook} class="link link-licht">Facebook</a><a href={site.linkedin} class="link link-licht">LinkedIn</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK <span class="num">{site.kvk}</span></p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's en projectomschrijvingen van jullie eigen website. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
