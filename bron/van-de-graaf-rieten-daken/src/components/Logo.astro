---
// Woordmerk naar hun bouwbord: "Van de Graaf Rieten Daken" in goudgeel. Beeldmerk: een rieten kap met nok en halmen.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const naam = licht ? '#ffffff' : '#1b1712';
const goud = licht ? '#dcae57' : '#7a5716';
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <svg viewBox="0 0 44 40" class="h-10 w-auto flex-none" aria-hidden="true">
    <path d="M22 3 3 30h38z" fill={licht ? '#dcae57' : '#c9953a'} />
    <path d="M22 3 3 30h38z" fill="none" stroke={licht ? '#1b1712' : '#1b1712'} stroke-opacity=".28" stroke-width="1" />
    <g stroke={licht ? '#1b1712' : '#1b1712'} stroke-opacity=".38" stroke-width="1.1" stroke-linecap="round">
      <path d="M22 7v22M17 12l-3.5 17M27 12l3.5 17M12.5 19 9 29M31.5 19 35 29" />
    </g>
    <path d="M17 7.5h10" stroke={naam} stroke-width="3" stroke-linecap="round" />
    <path d="M9 30v7h26v-7" fill="none" stroke={naam} stroke-width="2.4" stroke-linejoin="round" />
  </svg>
  <span class="flex flex-col">
    <span class="font-display text-[1.28rem] font-bold tracking-[-0.02em]" style={`color:${naam}`}>Van de Graaf</span>
    <span class="mt-1 text-[0.66rem] font-bold tracking-[0.3em] uppercase" style={`color:${goud}`}>Rieten daken</span>
  </span>
</span>
