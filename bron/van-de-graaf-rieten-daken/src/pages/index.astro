<script>
  // Tijdlijn: zonder JS staan alle fasen als raster; met JS een diavoorstelling met knoppen, fasebalk en pijltjestoetsen.
  const tl = document.querySelector<HTMLElement>('[data-tl]');
  if (tl) {
    const lijst = tl.querySelector<HTMLElement>('[data-tl-lijst]')!;
    const stappen = [...tl.querySelectorAll<HTMLElement>('.tl-stap')];
    const knoppen = [...tl.querySelectorAll<HTMLButtonElement>('[data-naar]')];
    const paneel = tl.querySelector<HTMLElement>('[data-tl-paneel]')!;
    const nr = tl.querySelector<HTMLElement>('[data-tl-nr]')!;
    const bij = tl.querySelector<HTMLElement>('[data-tl-bij]')!;
    const hierna = tl.querySelector<HTMLElement>('[data-tl-hierna]')!;
    const balk = tl.querySelector<HTMLElement>('[data-tl-balk]')!;
    const vorige = tl.querySelector<HTMLButtonElement>('[data-tl-vorige]')!;
    const volgende = tl.querySelector<HTMLButtonElement>('[data-tl-volgende]')!;
    const bijschriften = stappen.map((s) => s.querySelector('figcaption')?.textContent ?? '');
    let huidig = 0;

    lijst.classList.add('tl-js');
    lijst.classList.remove('sm:grid-cols-2', 'lg:grid-cols-2');
    paneel.classList.remove('hidden');
    paneel.classList.add('flex');
    tl.querySelector('[data-tl-knoppen]')!.classList.replace('hidden', 'grid');

    const toon = (i: number) => {
      huidig = (i + stappen.length) % stappen.length;
      stappen.forEach((s, j) => s.toggleAttribute('data-actief', j === huidig));
      knoppen.forEach((k, j) => {
        k.classList.toggle('gedaan', j < huidig);
        if (j === huidig) k.setAttribute('aria-current', 'step'); else k.removeAttribute('aria-current');
      });
      nr.textContent = String(huidig + 1);
      bij.textContent = bijschriften[huidig];
      hierna.textContent = huidig === stappen.length - 1 ? 'Terug naar het begin' : bijschriften[huidig + 1];
      balk.style.width = `${((huidig + 1) / stappen.length) * 100}%`;
    };
    knoppen.forEach((k, j) => k.addEventListener('click', () => toon(j)));
    vorige.addEventListener('click', () => toon(huidig - 1));
    volgende.addEventListener('click', () => toon(huidig + 1));
    tl.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { toon(huidig + 1); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { toon(huidig - 1); e.preventDefault(); }
    });
    toon(0);
  }
</script>
