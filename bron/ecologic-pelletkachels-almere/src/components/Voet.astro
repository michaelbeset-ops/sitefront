---
import { site, url, waHoi, merken, ook } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-nacht text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Wij verkopen pelletketels, cv-pelletkachels en pelletkachels die niet alleen zeer energiezuinig zijn, maar ook extreem duurzaam.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Assortiment</p>
      <ul class="mt-4 space-y-1.5">
        {merken.map((m) => <li><a href={m.href} class="link">{m.naam}</a></li>)}
        {ook.map(([t, href]) => <li><a href={href} class="link">{t}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
      <p class="mt-1.5"><a href={site.instagram} class="link">Instagram</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Almere</p>
      <p class="mt-4">Bezichtiging alleen op afspraak.</p>
      <p class="mt-3"><a href={site.reviews} class="link num">{site.google.score} uit {site.google.aantal} reviews op Google</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, Almere</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-blad">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten, modellen en specificaties van ecologicpelletkachels.nl; foto’s van jullie eigen Google-profiel. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
