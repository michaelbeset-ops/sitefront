---
// Woordmerk naar hun logo: groen blad + ECO (vet, groen) LOGIC (licht).
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<a href={url('')} class="flex items-center gap-2.5 no-underline" aria-label="Ecologic Pelletkachels, naar de homepage">
  <svg viewBox="0 0 32 36" class="h-8 w-7 flex-none" aria-hidden="true">
    <path d="M16 1C9 9 3 15 3 22.5 3 30 9 35 16 35s13-5 13-12.5C29 15 23 9 16 1Z" fill="#5fb233" />
    <path d="M16 34V12M16 20l-5-4M16 26l6-5" stroke="#121611" stroke-opacity=".45" stroke-width="1.6" fill="none" stroke-linecap="round" />
  </svg>
  <span class={`text-[1.35rem] leading-none tracking-[.08em] ${licht ? 'text-inkt' : 'text-wit'}`}><span class={`font-semibold ${licht ? 'text-blad-diep' : 'text-blad'}`}>ECO</span><span class="font-light">LOGIC</span></span>
</a>
