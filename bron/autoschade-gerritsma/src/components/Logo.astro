---
// Wordmark naar hun eigen logo: "Gerritsma" groot in logoblauw, "autoschade" klein en grijs erboven rechts,
// en het beeldmerk: een auto van voren in een afgerond kader met een blauwe rechterhelft.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-end gap-2 leading-none ${cls}`}>
  <span class="sr-only">Autoschade Gerritsma</span>
  <span aria-hidden="true" class="flex flex-col items-end font-display">
    <span class={`text-[0.68rem] font-bold tracking-[0.04em] ${licht ? 'text-white/80' : 'text-ink-soft'}`}>autoschade</span>
    <span class={`-mt-[1px] text-[1.7rem] font-bold tracking-[-0.03em] ${licht ? 'text-white' : 'text-staal'}`}>Gerritsma</span>
  </span>
  <svg viewBox="0 0 32 32" class="mb-[2px] h-8 w-8 flex-none" aria-hidden="true">
    <rect x="1.5" y="1.5" width="29" height="29" rx="6" fill="none" stroke={licht ? '#9fd0f5' : '#4a5968'} stroke-width="2" />
    <path d="M18 1.5h6.5a6 6 0 0 1 6 6v17a6 6 0 0 1-6 6H18Z" fill="#1e7fc8" />
    <path d="M8 19.5v-3.2l1.8-4.6c.3-.8 1-1.2 1.8-1.2h8.8c.8 0 1.5.4 1.8 1.2l1.8 4.6v3.2Z M8 19.5v2.5h2.6v-2.5 M21.4 19.5v2.5H24v-2.5" fill="none" stroke={licht ? '#ffffff' : '#0e1c2a'} stroke-width="1.8" stroke-linejoin="round" />
    <circle cx="11" cy="17" r="1.1" fill={licht ? '#ffffff' : '#0e1c2a'} />
    <circle cx="21" cy="17" r="1.1" fill={licht ? '#ffffff' : '#0e1c2a'} />
  </svg>
</span>
