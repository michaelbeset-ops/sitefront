---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="bg-email text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-2 md:py-20 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk class="h-20 w-20" />
      <p class="mt-6 max-w-xs font-kop text-2xl leading-tight text-wit">Liefde voor lekkers.</p>
      <p class="mt-3 max-w-xs">Patisserie, traiteur en catering in de Korte Brugstraat, Etten-Leur.</p>
    </div>
    <div class="lg:col-span-2">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[.14em] text-wit">Catering</h2>
      <ul class="mt-4 space-y-1.5">
        <li><a href={h('catering')} class="link">Buffetten</a></li>
        <li><a href={h('catering')} class="link">High tea en lunch</a></li>
        <li><a href={h('catering')} class="link">Barbecue en gourmet</a></li>
        <li><a href={h('aanvragen')} class="link">Catering aanvragen</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[.14em] text-wit">Contact</h2>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a> · <a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-3"><a href={site.instagram} class="link">Instagram</a> · <a href={site.facebook} class="link">Facebook</a></p>
    </div>
    <div class="lg:col-span-3">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[.14em] text-wit">Winkel open</h2>
      <table class="mt-4 w-full max-w-60">
        <caption class="sr-only">Openingstijden van de winkel</caption>
        <tbody>
          <tr><th scope="row" class="py-0.5 text-left font-normal">Di t/m vr</th><td class="num whitespace-nowrap py-0.5 text-right">8.30 - 17.00</td></tr>
          <tr><th scope="row" class="py-0.5 text-left font-normal">Zaterdag</th><td class="num whitespace-nowrap py-0.5 text-right">8.30 - 15.00</td></tr>
          <tr><th scope="row" class="py-0.5 text-left font-normal">Zo en ma</th><td class="py-0.5 text-right">gesloten</td></tr>
        </tbody>
      </table>
      <p class="mt-4 text-xs">{site.google.score} op Google · {site.google.aantal} reviews</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.vol}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen website (basenanneloes.nl). Buffetten en prijzen uit jullie eigen PDF-lijsten; reviews letterlijk van Google (stand 6 oktober 2026).</p>}
</footer>
