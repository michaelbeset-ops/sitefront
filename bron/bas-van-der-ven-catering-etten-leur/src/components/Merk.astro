---
import { Image } from 'astro:assets';
import { url, site } from '../data/site';
import logo from '../assets/logo.png';
interface Props { class?: string }
const { class: cls = 'h-14 w-14' } = Astro.props;
---
<a href={url('')} class="inline-flex shrink-0 items-center gap-3 no-underline">
  <Image src={logo} alt="" width={128} height={128} class={cls} loading="eager" />
  <span class="sr-only">{site.naam}, home</span>
</a>
