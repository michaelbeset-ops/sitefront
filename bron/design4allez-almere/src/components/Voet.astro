---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const lijst = ['Elektrische wandhaarden', 'Inbouwhaarden', '3-zijdige haarden', 'Bio-ethanol haarden', 'Accessoires', "BBQ's en smokers"];
---
<footer class="bg-roet text-mist">
  <div class="wrap"><span class="spleet" aria-hidden="true"></span></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk class="text-[1.45rem] text-wit min-[400px]:text-[1.9rem]" />
      <p class="mt-5 max-w-xs">Sfeerhaarden uit Almere. Elektrisch en bio-ethanol, aan de wand, ingebouwd of vrijstaand.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Assortiment</p>
      <ul class="mt-3 space-y-1">{lijst.map((p) => <li><a href={site.shop} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a> (Vincent)</p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-1"><a href={site.fb} class="link link-licht">Facebook</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Showroom</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-2">op afspraak</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Design4AlleZ, Almere · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Teksten en foto's komen van jullie eigen site design4allez.nl (webwinkel en sfeerimpressie met haarden bij klanten thuis). Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
