---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi } from '../data/site';
import hero from '../assets/hero.jpg';
import inbouwVlam from '../assets/inbouw-vlam.jpg';
import wand from '../assets/wand.jpg';
import inbouwThuis from '../assets/inbouw-thuis.jpg';
import driezijdig from '../assets/driezijdig.jpg';
import amsterdam from '../assets/amsterdam.jpg';
import kleuren from '../assets/kleuren.jpg';
import donker from '../assets/donker.jpg';
---
<Base title="Design4AlleZ | Sfeerhaarden in Almere: elektrisch, inbouw en bio-ethanol" description="Elektrische haarden, inbouwhaarden en bio-ethanol sfeerhaarden. Showroom aan de Neonweg in Almere, op afspraak. App of bel Vincent: 06 40 51 18 89.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen foto, de haard brandt -->
    <section class="relative -mt-[4.5rem] flex min-h-[calc(100svh-var(--balk,0px))] items-end overflow-hidden bg-roet pt-36 text-wit md:-mt-20">
      <Image src={hero} alt="Bio-ethanol wandhaard van Design4AlleZ met brandende vlammen, in een RVS-omlijsting" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[46%_8%] md:object-[50%_0%]" />
      <div class="absolute inset-0 md:hidden" style="background: linear-gradient(0deg, #121110 0%, #121110 47%, #121110d9 58%, #12111040 78%, #12111026 100%)" aria-hidden="true"></div>
      <div class="absolute inset-0 hidden md:block" style="background: linear-gradient(0deg, #121110 6%, #121110f2 36%, #12111080 60%, #12111026 100%)" aria-hidden="true"></div>
      <div class="absolute inset-0 hidden md:block" style="background: linear-gradient(90deg, #121110b3, transparent 62%)" aria-hidden="true"></div>
      <div class="wrap relative pb-[6.25rem] md:pb-24">
        <p class="text-sm font-semibold text-gloed">Sfeerhaarden · showroom in Almere</p>
        <h1 class="mt-4 text-hero font-bold">Een haard zonder<br class="hidden sm:block" /> afvoer&shy;kanaal<span class="text-vlam">.</span></h1>
        <p class="mt-5 max-w-[34rem] text-wit/85 sm:text-lg md:mt-6 md:text-xl">Elektrisch of op bio-ethanol. Aan de wand, ingebouwd of vrijstaand. Kom ze zien branden in de showroom aan de Neonweg.</p>
        <div class="mt-7 flex flex-wrap gap-3 md:mt-9">
          <a href={waHoi} class="knop max-sm:!px-4"><Icoon naam="wa" />App Vincent</a>
          <a href="#kiezen" class="knop knop-lijn max-sm:!px-4">Welke haard past?</a>
        </div>
      </div>
    </section>

    <!-- 2. Het eigen detail: glas 2 cm terug, verborgen rooster -->
    <section id="inbouw" class="py-20 md:py-24">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5 lg:pt-6">
          <h2 class="rijs text-3xl">Twee centimeter terug.</h2>
          <p class="rijs mt-7 max-w-md text-lg text-grijs" style="--d:.1s">Bij onze inbouwhaarden zit de glasplaat ongeveer 2 cm naar achteren. Daar, onder de omlijsting, zitten de roosters. De warmte komt aan de voorkant naar buiten, zonder dat u ze ziet.</p>
          <p class="rijs mt-5 max-w-md text-lg font-semibold" style="--d:.15s">Geen gaten in uw cinewall. Geen afvoerkanaal. Geen brandwerende platen.</p>
          <figure class="rijs mt-12">
          <Image src={inbouwVlam} alt="Close-up van het vuurbeeld in een elektrische inbouwhaard, zwart staal" widths={[480, 760]} sizes="(min-width: 1024px) 460px, 100vw" class="aspect-[760/340] w-full object-cover" />
          <figcaption class="mt-3 text-xs text-grijs">Inbouwhaard Zwart Staal 152 cm</figcaption>
        </figure>
        </div>
        <figure class="rijs lg:col-span-7" style="--d:.1s">
          <svg viewBox="0 0 640 420" class="h-auto w-full" role="img" aria-labelledby="doorsnede-titel">
            <title id="doorsnede-titel">Doorsnede van een inbouwhaard in een wand: de glasplaat staat 2 cm terug, het rooster zit verborgen onder de omlijsting en de warmte gaat voor het glas naar buiten.</title>
            <defs>
              <pattern id="arcering" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="9" stroke="#12111033" stroke-width="2" /></pattern>
              <linearGradient id="vuur" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#eb7325" /><stop offset="1" stop-color="#f6a15f" stop-opacity="0" /></linearGradient>
            </defs>
            <!-- wand boven en onder -->
            <rect x="40" y="18" width="262" height="112" fill="url(#arcering)" stroke="#121110" stroke-width="1.5" />
            <rect x="40" y="300" width="262" height="102" fill="url(#arcering)" stroke="#121110" stroke-width="1.5" />
            <!-- haardkast -->
            <rect x="110" y="130" width="192" height="170" fill="#1c1a18" />
            <!-- vlammen achter het glas -->
            <path d="M150 284c6-26 18-30 14-56 14 18 20 30 16 56zM196 284c4-34 22-40 16-74 18 26 24 46 18 74zM246 284c4-22 14-26 12-48 12 16 16 30 12 48z" fill="url(#vuur)" />
            <rect x="120" y="282" width="168" height="8" fill="#eb7325" opacity=".55" />
            <!-- omlijsting (voorkant) -->
            <path d="M302 118h14v40h-14zM302 282h14v30h-14z" fill="#121110" />
            <!-- glasplaat, 2 cm terug -->
            <rect x="290" y="158" width="4" height="124" fill="#8fb4c4" opacity=".9" />
            <!-- verborgen rooster -->
            <g stroke="#121110" stroke-width="2"><line x1="295" y1="146" x2="301" y2="146" /><line x1="295" y1="151" x2="301" y2="151" /><line x1="295" y1="156" x2="301" y2="156" /></g>
            <!-- warmte voor het glas naar buiten -->
            <g fill="none" stroke="#eb7325" stroke-width="2.5" stroke-linecap="round">
              <path d="M300 168c26 4 44 0 66-14" /><path d="M300 196c30 4 52-2 80-18" /><path d="M300 224c32 2 58-6 88-22" />
              <path d="M360 148l8 5-6 7M374 172l9 5-7 7M382 196l9 5-7 7" />
            </g>
            <!-- maat 2 cm -->
            <g stroke="#121110" stroke-width="1.2"><line x1="292" y1="326" x2="292" y2="340" /><line x1="316" y1="326" x2="316" y2="340" /><line x1="292" y1="333" x2="316" y2="333" /></g>
            <text x="326" y="340" font-family="Manrope Variable, sans-serif" font-size="20" font-weight="700" fill="#121110">2 cm</text>
            <!-- labels -->
            <g font-family="Manrope Variable, sans-serif" font-size="20" fill="#121110">
              <line x1="318" y1="126" x2="420" y2="70" stroke="#121110" stroke-width="1" /><text x="426" y="66">omlijsting</text>
              <line x1="302" y1="151" x2="420" y2="104" stroke="#121110" stroke-width="1" /><text x="426" y="100">rooster, uit het zicht</text>
              <text x="398" y="186" fill="#c95d16" font-weight="700">warmte naar voren</text>
              <line x1="292" y1="262" x2="420" y2="262" stroke="#121110" stroke-width="1" /><text x="426" y="258">glasplaat</text>
              <text x="426" y="282" fill="#57534d" font-size="17">ca. 2 cm naar achteren</text>
              <text x="60" y="80" fill="#57534d" font-size="17">wand / cinewall</text>
              <text x="60" y="364" fill="#57534d" font-size="17">geen ventilatiegaten</text>
            </g>
          </svg>
          <figcaption class="mt-3 text-xs text-grijs">Schematische doorsnede, naar de omschrijving van hun inbouwhaarden.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. Assortiment, editoriaal -->
    <section id="assortiment" class="bg-roet py-24 text-wit md:py-36">
      <div class="wrap">
        <h2 class="rijs max-w-[16ch] text-3xl">Aan de wand, in de wand of los in de kamer.</h2>

        <div class="mt-16 grid items-end gap-y-8 md:mt-24 lg:grid-cols-12 lg:gap-x-12">
          <figure class="rijs lg:col-span-8">
            <Image src={wand} alt="Bio-ethanol wandhaard met vlammen op een houten wand in een woonkamer, bij een klant thuis" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 66vw, 100vw" class="aspect-[16/9] w-full object-cover object-[50%_30%]" />
            <figcaption class="mt-3 text-xs text-mist">Bij een klant thuis</figcaption>
          </figure>
          <div class="rijs lg:col-span-4 lg:pb-10" style="--d:.1s">
            <h3 class="text-2xl">Aan de wand</h3>
            <p class="mt-4 text-mist">Elektrische wandhaarden van 128 tot 240 cm, in zwart, wit of spiegel. En bio-ethanol wandmodellen in RVS, wit of zwart.</p>
          </div>
        </div>

        <div class="mt-20 grid gap-y-8 md:mt-28 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs order-2 lg:order-1 lg:col-span-4 lg:col-start-1 lg:self-center">
            <h3 class="text-2xl">In de wand</h3>
            <p class="mt-4 text-mist">Inbouwhaarden in zwart staal, zwart glas of RVS, van 128, 152 en 182 cm. Voor een cinewall of een schouw.</p>
            <figure class="mt-10">
              <Image src={driezijdig} alt="3-zijdige elektrische haard met glas aan de voorkant en de zijkanten" widths={[400, 550]} sizes="(min-width: 1024px) 360px, 80vw" class="w-full max-w-[22rem] bg-wit object-contain" />
              <figcaption class="mt-3 text-sm text-mist"><span class="font-semibold text-wit">Ook 3-zijdig.</span> Glas aan drie kanten, van 93 tot 182 cm.</figcaption>
            </figure>
          </div>
          <figure class="rijs order-1 lg:order-2 lg:col-span-5 lg:col-start-7">
            <Image src={inbouwThuis} alt="Ingebouwde haard met vlammen in een schouw van leisteen, onder de tv, bij een klant thuis" widths={[480, 768]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/5] w-full object-cover object-[50%_70%]" />
            <figcaption class="mt-3 text-xs text-mist">Bij een klant thuis</figcaption>
          </figure>
        </div>

        <div class="mt-20 grid items-center gap-y-8 md:mt-28 lg:grid-cols-12 lg:gap-x-12">
          <figure class="rijs bg-kalk p-8 lg:col-span-5 md:p-12">
            <Image src={amsterdam} alt="Vrijstaande bio-ethanol sfeerhaard Amsterdam, rond zwart frame met glas" widths={[400, 500]} sizes="(min-width: 1024px) 420px, 80vw" class="mx-auto w-full max-w-[26rem] mix-blend-multiply" />
            <figcaption class="mt-2 text-center text-xs text-grijs">Sfeerhaard Amsterdam</figcaption>
          </figure>
          <div class="rijs lg:col-span-5 lg:col-start-7" style="--d:.1s">
            <h3 class="text-2xl">Los in de kamer</h3>
            <p class="mt-4 text-mist">Bio-ethanol tafelmodellen en vrijstaande haarden. Geen afvoerkanaal, geen stopcontact nodig.</p>
          </div>
        </div>

        <p class="rijs mt-20 border-t border-lijn-licht pt-8 text-mist md:mt-28">Op de webshop ook accessoires, bbq's en smokers. <a href={site.shop} class="link link-licht whitespace-nowrap font-semibold text-wit">Naar de webshop</a></p>
      </div>
    </section>

    <!-- 4. Elektrisch: hun eigen productblad -->
    <section id="elektrisch" class="py-20 md:py-24">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl">Vuur met of zonder warmte.</h2>
          <p class="rijs mt-7 max-w-md text-lg text-grijs" style="--d:.1s">Stekker in het stopcontact en de vlammen branden. Warmte aan in de winter, uit in de zomer.</p>
          <figure class="rijs mt-12" style="--d:.15s">
            <Image src={kleuren} alt="Dezelfde elektrische haard drie keer, met oranje-paarse, gele en blauwe vlammen" widths={[480, 759]} sizes="(min-width: 1024px) 560px, 100vw" class="w-full max-w-[35rem]" />
            <figcaption class="mt-3 text-xs text-grijs">Eén haard, drie vlamkleuren</figcaption>
          </figure>
        </div>
        <div class="rijs lg:col-span-5 lg:col-start-8 lg:pt-4" style="--d:.1s">
          <p class="spec"><span>Vlammen</span><span></span><span>3 kleuren, te dimmen</span></p>
          <p class="spec"><span>Bodem</span><span></span><span>10 kleuren, ook wisselend</span></p>
          <p class="spec"><span>Warmte</span><span></span><span>2 standen, 750 of 1500 W</span></p>
          <p class="spec"><span>Zonder warmte</span><span></span><span>alleen het vuurbeeld</span></p>
          <p class="spec"><span>Bediening</span><span></span><span>afstandsbediening en touchpaneel</span></p>
          <p class="spec"><span>Erbij</span><span></span><span>houtstammen, kristallen en sierstenen</span></p>
          <p class="mt-6 text-sm text-grijs">Uit de omschrijving van hun elektrische haarden; per model verschilt het iets.</p>
        </div>
      </div>
    </section>

    <!-- 5. Wow: welke haard past, op schaal, naar WhatsApp -->
    <section id="kiezen" class="bg-roet py-24 text-wit md:py-36">
      <div class="wrap">
        <h2 class="rijs text-3xl">Welke haard past bij u?</h2>
        <form class="rijs mt-12 md:mt-16" data-kiezen onsubmit="return false" style="--d:.1s">
          <p class="kop max-w-5xl text-[1.4rem] font-bold leading-[1.5] tracking-[-0.02em] sm:text-[1.75rem] md:text-[2.5rem]">
            Ik zoek een
            <label class="sr-only" for="k-soort">Soort haard</label>
            <select id="k-soort" class="kies" data-soort>
              <option value="elektrische">elektrische</option>
              <option value="bio-ethanol">bio-ethanol</option>
              <option value="elektrische of bio-ethanol">elektrische of bio-ethanol</option>
            </select>
            haard
            <label class="sr-only" for="k-plek">Waar komt de haard</label>
            <select id="k-plek" class="kies" data-plek>
              <option value="wand">aan de wand</option>
              <option value="inbouw">in de wand</option>
              <option value="los">los in de kamer</option>
            </select><span data-maat-zin>,
            <label class="sr-only" for="k-maat">Breedte</label>
            <select id="k-maat" class="kies" data-maat>
              <option value="128">ongeveer 128 cm breed</option>
              <option value="152">ongeveer 152 cm breed</option>
              <option value="182" selected>ongeveer 182 cm breed</option>
              <option value="240">ongeveer 240 cm breed</option>
              <option value="">maat weet ik nog niet</option>
            </select>.</span><span data-punt hidden>.</span>
          </p>
          <p class="mt-4 min-h-[1.6em] text-mist" data-hint aria-live="polite"></p>

          <div class="mt-10 max-w-5xl" data-maatlat>
            <div class="relative h-36 border border-lijn-licht bg-roet-2 md:h-44">
              <span class="spleet absolute left-1/2 top-[58%] -translate-x-1/2 !h-3 transition-[width] duration-500" style="width:60.7%" data-strook aria-hidden="true"></span>
            </div>
            <div class="mt-2 flex justify-between text-xs text-mist num" aria-hidden="true"><span>0</span><span>50</span><span>100</span><span>150</span><span>200</span><span>250</span><span>300 cm</span></div>
            <p class="mt-3 text-sm text-mist" data-maat-uitleg>Op schaal: 182 cm op een wand van 3 meter.</p>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waHoi} class="knop" data-stuur><Icoon naam="wa" />Stuur naar Vincent</a>
            <p class="max-w-md text-sm text-mist">Opent WhatsApp met dit bericht. U verstuurt het zelf.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 6. Reviews -->
    <section id="vincent" class="py-20 md:py-24">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2 class="rijs text-3xl">Langs bij Vincent.</h2>
          <a href={site.google.url} class="rijs mt-8 inline-flex items-center gap-2 text-sm text-grijs no-underline hover:text-roet" style="--d:.1s"><Icoon naam="g" class="h-4 w-4" /><span class="num">{site.google.score}</span> op Google · {site.google.aantal} reviews</a>
        </div>
        <div class="lg:col-span-8">
          <blockquote class="rijs">
            <p class="kop text-2xl font-semibold leading-snug md:text-[2rem]">“{reviews.groot.tekst}”</p>
            <footer class="mt-5 text-sm text-grijs">{reviews.groot.naam}, Google review</footer>
          </blockquote>
          <div class="mt-16 grid gap-x-10 gap-y-10 border-t border-lijn pt-10 sm:grid-cols-2">
            {reviews.los.map((r, i) => (
              <blockquote class="rijs" style={`--d:${i * 0.06}s`}>
                <p>“{r.tekst}”</p>
                <footer class="mt-3 text-sm text-grijs">{r.naam}, Google review</footer>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Showroom -->
    <section id="showroom" class="bg-roet py-24 text-wit md:py-36">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl">Neonweg 191, Almere.</h2>
          <p class="rijs mt-7 max-w-md text-lg text-mist" style="--d:.1s">Magazijn en showroom, op afspraak. In principe maandag tot en met zaterdag van 10.30 tot 17.00 uur, maar Vincent is ook weleens buiten de deur. Spreek dus even een dag en tijd af.</p>
          <div class="rijs mt-10 flex flex-wrap gap-3" style="--d:.15s">
            <a href={waHoi} class="knop"><Icoon naam="wa" />App Vincent</a>
            <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <p class="rijs mt-8 flex flex-wrap gap-x-8 gap-y-2 text-mist" style="--d:.2s">
            <a href={site.route} class="link link-licht text-wit">Route plannen</a>
            <a href={`mailto:${site.mail}`} class="link link-licht break-all text-wit">{site.mail}</a>
          </p>
        </div>
        <figure class="rijs lg:col-span-6" style="--d:.1s">
          <Image src={donker} alt="RVS bio-ethanol wandhaard met vlammen boven een tafel met windlichten, bij een klant thuis" widths={[480, 721]} sizes="(min-width: 1024px) 600px, 100vw" class="aspect-[3/2] w-full object-cover" />
          <figcaption class="mt-3 text-xs text-mist">Bij een klant thuis</figcaption>
        </figure>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { waMet } from '../data/site';
  const f = document.querySelector<HTMLFormElement>('[data-kiezen]');
  if (f) {
    const soort = f.querySelector<HTMLSelectElement>('[data-soort]')!;
    const plek = f.querySelector<HTMLSelectElement>('[data-plek]')!;
    const maat = f.querySelector<HTMLSelectElement>('[data-maat]')!;
    const maatZin = f.querySelector<HTMLElement>('[data-maat-zin]')!;
    const lat = f.querySelector<HTMLElement>('[data-maatlat]')!;
    const strook = f.querySelector<HTMLElement>('[data-strook]')!;
    const uitleg = f.querySelector<HTMLElement>('[data-maat-uitleg]')!;
    const hint = f.querySelector<HTMLElement>('[data-hint]')!;
    const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
    const plekTekst: Record<string, string> = { wand: 'aan de wand', inbouw: 'in de wand (inbouw)', los: 'los in de kamer' };
    const zet = () => {
      // Los in de kamer: alleen bio-ethanol (tafel- en vrijstaande modellen). Inbouw: tot 182 cm.
      const los = plek.value === 'los';
      soort.querySelector<HTMLOptionElement>('[value="elektrische"]')!.disabled = los;
      soort.querySelector<HTMLOptionElement>('[value="elektrische of bio-ethanol"]')!.disabled = los;
      if (los) soort.value = 'bio-ethanol';
      const inbouw = plek.value === 'inbouw';
      maat.querySelector<HTMLOptionElement>('[value="240"]')!.disabled = inbouw;
      if (inbouw && maat.value === '240') maat.value = '182';
      const elek = soort.value === 'elektrische';
      maatZin.hidden = !elek;
      f.querySelector<HTMLElement>('[data-punt]')!.hidden = elek;
      const cm = elek ? Number(maat.value) : 0;
      lat.hidden = !cm;
      if (cm) { strook.style.width = `${(cm / 300) * 100}%`; uitleg.textContent = `Op schaal: ${cm} cm op een wand van 3 meter.`; }
      hint.textContent = los ? 'Tafelmodellen en vrijstaande haarden zijn er op bio-ethanol.'
        : inbouw && elek ? 'Inbouw kan in zwart staal, zwart glas of RVS. Of 3-zijdig.'
        : soort.value === 'bio-ethanol' ? 'Bio-ethanol: geen afvoerkanaal en geen stopcontact nodig.'
        : '';
      const m = elek && cm ? `, ongeveer ${cm} cm breed` : '';
      stuur.href = waMet(`Hallo Vincent, ik zoek een ${soort.value} haard ${plekTekst[plek.value]}${m}. Wanneer kan ik in de showroom komen kijken?`);
    };
    const meet = document.createElement('span');
    meet.setAttribute('aria-hidden', 'true');
    meet.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0';
    f.appendChild(meet);
    const pas = () => [soort, plek, maat].forEach((s) => {
      const cs = getComputedStyle(s);
      meet.style.font = cs.font; meet.style.letterSpacing = cs.letterSpacing;
      meet.textContent = s.options[s.selectedIndex].text;
      s.style.width = `calc(${meet.getBoundingClientRect().width}px + 1.5em)`;
    });
    [soort, plek, maat].forEach((s) => s.addEventListener('change', () => { zet(); pas(); }));
    zet(); pas();
    document.fonts?.ready.then(pas);
  }
</script>
