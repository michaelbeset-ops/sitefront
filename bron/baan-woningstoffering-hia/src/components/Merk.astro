---
// Woordmerk naar hun eigen logo: drie overlappende vlakken (blauw, rood, bruin) en "BAAN / Woningstoffering".
import { url, site } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class={`merk ${cls}`} aria-label="BAAN Woningstoffering, naar de homepage">
  <svg viewBox="0 0 220 215" aria-hidden="true">
    <rect x="0" y="66" width="130" height="112" fill="#0a859f" />
    <rect x="58" y="0" width="132" height="88" fill="#bf2e0c" />
    <rect x="128" y="58" width="92" height="157" fill="#974a2e" />
  </svg>
  <span><b>BAAN</b><small>Woningstoffering</small></span>
</a>
