---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, chips, reviews, waStalen, waMet } from '../data/site';
import pand from '../assets/pand.jpg';
import stalenwand from '../assets/stalenwand.jpg';
import tapijtstalen from '../assets/tapijtstalen.jpg';
import dammesStalen from '../assets/dammes-stalen.jpg';
import tapijt from '../assets/tapijt.jpg';
import pvc from '../assets/pvc.jpg';
import laminaat from '../assets/laminaat.jpg';
import trap from '../assets/trap.jpg';
import gordijnen from '../assets/gordijnen.jpg';
import jaloezie from '../assets/jaloezie.jpg';
import interieur from '../assets/interieur.jpg';

const vraag = (b: string) => waMet(`Goedendag, ik wil graag stalen bekijken van ${b.toLowerCase()}. Kunnen we een afspraak maken?`);

const assortiment = [
  { t: 'Tapijt', d: 'Zachte vloerbedekking voor woonkamer, slaapkamer en overloop.', src: tapijt, alt: 'Zacht beige tapijt met een gebreide gele poef', pos: '50% 60%' },
  { t: 'Vinyl', d: 'Harde vloerbedekking, rustig te kiezen uit de stalen.', src: pvc, alt: 'Close-up van een vloer van grijsbruine planken', pos: '50% 50%' },
  { t: 'Laminaat', d: 'Rustige planken die passen bij uw interieur.', src: laminaat, alt: 'Lichte woonkamer met een eiken plankenvloer, een bank en planten', pos: '50% 65%' },
  { t: 'Trap bekleden', d: 'Uw trap netjes bekleed, met de overloop erbij als u wilt.', src: trap, alt: 'Een met beige tapijt beklede trap met een houten leuning', pos: '50% 50%' },
  { t: 'Gordijnen en vitrage', d: 'Ingemeten en opgehangen door Dammes zelf.', src: gordijnen, alt: 'Een lichte linnen gordijnstof die tot op de houten vloer valt', pos: '50% 40%' },
  { t: 'Binnenzonwering', d: 'Rolgordijnen, lamellen en horizontale jaloezieën.', src: jaloezie, alt: 'Horizontale jaloezieën voor een raam in warm middaglicht', pos: '50% 50%' },
];

const stappen = [
  ['Bel of app', 'Vertel wat u zoekt: een nieuwe vloer, gordijnen of zonwering, voor welke ruimte.'],
  ['Stalen bekijken', 'Dammes komt met stalen bij u thuis, of u haalt ze op aan de Energieweg. Geheel vrijblijvend.'],
  ['Inmeten', 'Hij meet zelf in, zodat alles precies past. Ook de trap of dat lastige raam.'],
  ['Leggen en ophangen', 'Oude vloer eruit en afgevoerd, meubels verplaatst en teruggezet, nieuwe vloer erin.'],
];
---
<Base title={`${site.naam} | Vloeren, gordijnen en raamdecoratie in Hendrik-Ido-Ambacht`} description="Tapijt, vinyl, laminaat, trap bekleden, gordijnen, vitrage en binnenzonwering. Advies, verkoop, meten en installeren door Dammes Baan. Stalen vrijblijvend aan huis. 5,0 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen loods aan de Energieweg -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={pand} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={70} class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_45%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1f1c1940_0%,#1f1c19b8_42%,#1f1c19f5_100%)] md:bg-[linear-gradient(90deg,#1f1c19f0_0%,#1f1c19c4_38%,#1f1c1940_72%,#1f1c1914_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-32 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Woningstoffering in Hendrik-Ido-Ambacht</p>
          <h1 id="t-hero" class="mt-5 text-hero">Van stalen tot <span class="text-koper">montage</span>, uit één hand.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Tapijt, vinyl en laminaat, gordijnen, vitrage en binnenzonwering. Dammes Baan adviseert, meet in en installeert alles zelf. Dus één aanspreekpunt.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waStalen} class="knop knop-roest"><Icoon naam="wa" />Stalen aan huis aanvragen</a>
            <a href="#assortiment" class="knop knop-rand op-foto">Bekijk het assortiment</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-koper" />Familiebedrijf, al {site.jaren} jaar</li>
            <li class="flex items-center gap-2"><Icoon naam="tel" class="h-4 w-4 text-koper" /><a href={site.telHref} class="num font-semibold text-licht no-underline hover:text-koper">{site.tel}</a></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto w-full max-w-[19rem] rounded-lg bg-licht/10 p-2.5 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <Image src={tapijtstalen} alt="Hangende tapijtstalen in grijs en antraciet, en een rij vloerplanken" widths={[320, 640]} sizes="300px" loading="eager" class="aspect-[4/5] w-full rounded-md object-cover" />
            <figcaption class="px-2 pb-1 pt-3 text-sm">
              <span class="block font-semibold text-licht">Uit de stalenwand</span>
              <span class="text-licht-zacht">Tapijt en vloerplanken om uit te kiezen</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Assortiment in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#assortiment" class="shrink-0 rounded-md border border-lijn bg-papier px-4 py-2 text-sm font-medium no-underline transition-colors hover:border-roest hover:bg-roest hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Assortiment -->
    <section id="assortiment" class="py-20 lg:py-28" aria-labelledby="t-ass">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Assortiment</p>
            <h2 id="t-ass" class="mt-4 text-3xl">Harde en zachte vloeren, en alles voor de ramen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Kies rustig uit de stalen. Dammes denkt mee en kijkt naar de opdracht met de ogen van de klant.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {assortiment.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[4/3]" style={`object-position:${b.pos}`} />
                  <span class="absolute left-3 top-3 rounded-sm bg-nacht/80 px-2 py-0.5 font-kop text-xs font-bold text-licht num">0{i + 1}</span>
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-4 sm:p-6">
                  <div>
                    <h3 class="text-[1.0625rem] hyphens-auto sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-md bg-zand text-roest transition-colors group-hover:bg-roest group-hover:text-wit sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-xs text-grijs">Sfeerfoto’s ter illustratie. Vraag naar de stalen voor de echte kleuren en structuren.</p>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Jaar familiebedrijf</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.03em] text-roest">{site.jaren}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Score op Google</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.03em]">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Aanspreekpunt, van advies tot montage</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.03em]">1</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Generaties klanten in sommige families</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.03em]">3</dd></div>
      </dl>
    </section>

    <!-- 5. Stalen aan huis -->
    <section id="stalen" class="py-20 lg:py-28" aria-labelledby="t-stalen">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="relative lg:col-span-6">
          <Image src={stalenwand} alt="Stalenwand met hangende tapijtstalen, stapels vloerplanken en stalenboeken voor rolgordijnen en plissés" widths={[600, 900, 1200]} sizes="(min-width: 1024px) 560px, 92vw" class="aspect-[4/3] w-full rounded-lg object-cover shadow-md" />
          <div class="absolute -bottom-6 right-4 hidden max-w-[15rem] rounded-lg bg-roest p-5 text-wit shadow-md sm:block lg:-right-6">
            <Icoon naam="huis" class="h-6 w-6" />
            <p class="mt-3 font-kop text-lg font-bold leading-snug">Stalen aan huis, geheel vrijblijvend.</p>
          </div>
        </div>
        <div class="lg:col-span-6">
          <p class="eyebrow">Stalen aan huis</p>
          <h2 id="t-stalen" class="mt-4 text-3xl">Kiezen in uw eigen kamer, bij uw eigen licht.</h2>
          <p class="mt-6 text-lg text-grijs">Een staal ziet er in de winkel anders uit dan thuis. Daarom komen de stalen naar u toe. Zo bekijkt u ze op uw gemak, bij verschillende lichtinval, naast uw eigen meubels.</p>
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            <li class="kaart flex items-start gap-3 p-4"><Icoon naam="stalen" class="mt-0.5 h-5 w-5 shrink-0 text-roest" /><span class="text-[.9375rem]"><b class="block font-semibold">Aan huis of ophalen</b><span class="text-grijs">Bij u thuis, of aan de Energieweg.</span></span></li>
            <li class="kaart flex items-start gap-3 p-4"><Icoon naam="meet" class="mt-0.5 h-5 w-5 shrink-0 text-roest" /><span class="text-[.9375rem]"><b class="block font-semibold">Meteen ingemeten</b><span class="text-grijs">Door dezelfde man die straks legt.</span></span></li>
            <li class="kaart flex items-start gap-3 p-4"><Icoon naam="verhuis" class="mt-0.5 h-5 w-5 shrink-0 text-roest" /><span class="text-[.9375rem]"><b class="block font-semibold">Oude vloer afgevoerd</b><span class="text-grijs">Verwijderen en afvoeren kan erbij.</span></span></li>
            <li class="kaart flex items-start gap-3 p-4"><Icoon naam="huis" class="mt-0.5 h-5 w-5 shrink-0 text-roest" /><span class="text-[.9375rem]"><b class="block font-semibold">Meubels verplaatst</b><span class="text-grijs">En na het leggen teruggezet.</span></span></li>
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#contact" class="knop knop-roest">Stalen aanvragen<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-rand num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="bg-zand py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Advies, verkoop, meten en installeren.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Alles doet Dammes zelf. U hoeft dus nooit uit te leggen wat u al eens aan een ander vertelde.</p>
        </div>
        <ol class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative p-5 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.5rem] font-bold leading-none text-roest/25">0{i + 1}</p>
              <h3 class="mt-5 text-[1.0625rem] hyphens-auto sm:mt-6 sm:text-xl">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over Dammes -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[30rem] lg:col-span-6">
          <div class="absolute inset-0 bg-[#ffffff]"></div><Image src={dammesStalen} alt="Dammes Baan met een waaier vloerstalen en tapijtstalen" widths={[400, 650]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-x-0 bottom-0 mx-auto h-[92%] w-auto object-contain object-bottom" />
          <p class="absolute bottom-4 left-4 rounded-md bg-roest px-4 py-1.5 text-sm font-semibold text-wit">Dammes Baan, eigenaar</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Dammes Baan</p>
          <h2 id="t-over" class="mt-4 text-3xl">Van vader Ad op zoon Dammes.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Baan Woningstoffering is al {site.jaren} jaar een begrip in Hendrik-Ido-Ambacht. Wat bij vader Ad Baan begon, zet Dammes voort, met zijn gezin aan de Energieweg. Geen luxe showroom: de meeste klanten komen via mond-tot-mondreclame, en bij sommige families komt hij al bij de derde generatie over de vloer.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-roest text-wit"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Eén aanspreekpunt</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Wie u adviseert, meet ook in en legt de vloer.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-roest text-wit"><Icoon naam="afspraak" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Afspraak is afspraak</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">“Komt altijd afspraken na”, schrijft een klant op Google.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-roest text-wit"><Icoon naam="oog" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Meekijken als klant</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Nuchter advies, en tarieven die een klant voordelig noemt.</p></div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-20 lg:py-28" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-bold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">Alle {site.google.aantal} reviews op Google: 5 sterren</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-8" style={`--d:${(i % 2) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              {r.kop && <p class="mt-5 font-kop text-xl font-bold">{r.kop}</p>}
              <blockquote class={`${r.kop ? 'mt-2' : 'mt-5'} flex-1 text-[1.0625rem] leading-relaxed md:text-lg`}>“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-md bg-zand font-kop font-bold text-roest" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Bekijk de reviews op Google</a></p>
      </div>
    </section>

    <!-- 9. Locatie en bereikbaarheid -->
    <section id="route" class="bg-zand py-20 lg:py-24" aria-labelledby="t-route">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Locatie</p>
          <h2 id="t-route" class="mt-4 text-3xl">Aan de rand van Ambacht, bij de Ambachtsezoom.</h2>
          <p class="mt-6 text-lg text-grijs">Sinds maart 2021 zit Baan Woningstoffering aan de Energieweg, met een grote loods voor de opslag. Stalen ophalen kan hier; bel of app even vooraf.</p>
          <div class="kaart mt-10 divide-y divide-lijn">
            <p class="flex items-start gap-4 p-5"><Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-roest" /><span><b class="font-semibold">{site.straat}</b><br /><span class="text-grijs">{site.postcode} {site.plaats}</span></span></p>
            <p class="flex items-start gap-4 p-5"><Icoon naam="tel" class="mt-0.5 h-6 w-6 shrink-0 text-roest" /><span><a href={site.telHref} class="num font-semibold no-underline hover:text-roest">{site.tel}</a><span class="text-grijs"> mobiel en WhatsApp</span><br /><a href={site.vastHref} class="num text-grijs no-underline hover:text-roest">{site.vast}</a></span></p>
            <p class="flex items-start gap-4 p-5"><Icoon naam="mail" class="mt-0.5 h-6 w-6 shrink-0 text-roest" /><a href={`mailto:${site.mail}`} class="font-semibold no-underline hover:text-roest">{site.mail}</a></p>
          </div>
          <a href={site.maps} class="knop knop-inkt mt-6">Route plannen<Icoon naam="pijl" /></a>
        </div>
        <figure class="relative overflow-hidden rounded-lg lg:col-span-7">
          <Image src={pand} alt="De donkere loods en het woonhuis van de familie Baan aan de Energieweg, achter een weiland met pluimen riet" widths={[600, 900, 1300]} sizes="(min-width: 1248px) 700px, (min-width: 1024px) 56vw, 92vw" class="h-full min-h-[20rem] w-full object-cover object-[40%_55%]" />
          <figcaption class="absolute bottom-4 left-4 rounded-md bg-nacht/80 px-4 py-2 text-sm font-semibold text-licht backdrop-blur">Energieweg 1, Hendrik-Ido-Ambacht</figcaption>
        </figure>
      </div>
    </section>

    <!-- 10. Contact: stalenaanvraag via WhatsApp -->
    <section id="contact" class="py-20 lg:py-28" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Contact</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Stalen aanvragen.</h2>
          <p class="mt-6 text-lg text-grijs">Vink aan wat u zoekt en voor welke ruimte. Wij maken er een WhatsApp-bericht van, dan neemt Dammes contact met u op voor een afspraak.</p>
          <div class="mt-10 flex items-end gap-5 rounded-lg bg-wit p-5 shadow-sm ring-1 ring-lijn">
            <Image src={dammesStalen} alt="Dammes Baan met een waaier vloerstalen en tapijtstalen" widths={[200, 360]} sizes="150px" class="hidden h-40 w-32 shrink-0 object-contain object-bottom min-[380px]:block sm:h-44 sm:w-36" />
            <div class="pb-2">
              <p class="font-kop text-xl font-bold">Liever even bellen?</p>
              <p class="mt-1 text-grijs">Of stuur een appje naar hetzelfde nummer.</p>
              <a href={site.telHref} class="knop knop-roest knop-klein mt-4 num"><Icoon naam="tel" />{site.tel}</a>
            </div>
          </div>
        </div>
        <form class="kaart p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw aanvraag aan Baan Woningstoffering</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Waar wilt u stalen van zien?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Tapijt', 'Vinyl', 'Laminaat', 'Trap bekleden', 'Gordijnen', 'Vitrage', 'Rolgordijnen', 'Lamellen', 'Jaloezieën'].map((b) => (
                <label class="keuze"><input type="checkbox" name="prod" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-7">
            <legend class="text-sm font-semibold">Voor welke ruimte?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Woonkamer', 'Slaapkamer', 'Trap en overloop', 'Hal', 'Keuken', 'Hele woning'].map((b) => (
                <label class="keuze"><input type="checkbox" name="ruimte" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-7">
            <legend class="text-sm font-semibold">Extra</legend>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              <label class="vink"><input type="checkbox" name="extra" value="oude vloer verwijderen en afvoeren" /><span>Oude vloer verwijderen en afvoeren</span></label>
              <label class="vink"><input type="checkbox" name="extra" value="meubels verplaatsen" /><span>Meubels verplaatsen</span></label>
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Stalen bekijken</span>
              <select name="waar" class="veld mt-2">
                <option>Bij mij thuis</option>
                <option>Ik haal ze op aan de Energieweg</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Woonplaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld Zwijndrecht" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: ca. 30 m², liefst iets lichts en goed schoon te houden"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-roest"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Of mail naar <a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
          </div>
        </form>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="relative isolate overflow-hidden bg-roest text-wit" aria-label="Stalen aanvragen">
      <Image src={interieur} alt="" widths={[800, 1400]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-15 mix-blend-multiply" />
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Toe aan een nieuwe vloer of nieuwe gordijnen?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel of app, dan komt Dammes met de stalen langs.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waStalen} class="knop knop-wit"><Icoon naam="wa" />WhatsApp</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const alle = (n: string) => d.getAll(n).map(String);
      const r = ['Goedendag, ik wil graag vrijblijvend stalen bekijken.'];
      if (alle('prod').length) r.push('Stalen van: ' + alle('prod').join(', ').toLowerCase());
      if (alle('ruimte').length) r.push('Voor: ' + alle('ruimte').join(', ').toLowerCase());
      if (alle('extra').length) r.push('Graag ook: ' + alle('extra').join(' en '));
      r.push(v('waar') === 'Bij mij thuis' ? 'Het liefst bij mij thuis' + (v('plaats') ? ' in ' + v('plaats') : '') + '.' : 'Ik haal de stalen graag op aan de Energieweg.');
      if (v('wens')) r.push('Toelichting: ' + v('wens'));
      if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam'));
      window.open('https://wa.me/31612646003?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

