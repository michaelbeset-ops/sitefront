  .text-hero { font-size: var(--text-hero); line-height: .98; letter-spacing: -0.03em; }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-md); background: var(--color-papier); border: 1px solid var(--color-lijn); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s, border-color .2s; }
  .keuze span:hover { border-color: var(--color-roest); }
  .keuze input:checked + span { background: var(--color-roest); border-color: var(--color-roest); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-roest); outline-offset: 2px; }
  .vink { display: flex; align-items: center; gap: .65rem; min-height: 2.75rem; padding: 0 .9rem; border-radius: var(--radius-md); background: var(--color-papier); border: 1px solid var(--color-lijn); font-size: .9375rem; cursor: pointer; }
  .vink input { width: 1.1rem; height: 1.1rem; accent-color: var(--color-roest); flex: none; }
  .veld { display: block; width: 100%; border-radius: var(--radius-md); border: 1.5px solid #1f1c1933; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #1f1c1966; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-roest); }
  .veld::placeholder { color: #857d72; }
</style>
