---
import { site, url } from '../data/site';
const nav = [
  ['Theetuin', '#theetuin'],
  ['Vieren', '#vieren'],
  ['Winkel', '#winkel'],
  ['Paarden', '#paarden'],
  ['Route', '#route'],
];
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <a href={url('')} class="group flex items-baseline gap-2 no-underline">
      <span class="font-display text-xl font-extrabold tracking-[-0.03em]">De Griendheuvel</span>
      <span class="hidden text-xs text-ink-soft sm:inline">Shirestal, Dordrecht</span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 font-display text-sm font-semibold">
        {nav.map(([label, href]) => (
          <li><a href={href} class="no-underline decoration-hay decoration-2 underline-offset-4 hover:underline">{label}</a></li>
        ))}
      </ul>
    </nav>
    <a href={site.telHref} class="btn btn-hay !px-4 !py-2.5 text-sm">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
      <span>Bel ons</span>
    </a>
  </div>
</header>
