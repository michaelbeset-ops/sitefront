---
import { site, url } from '../data/site';
---
<footer class="bg-ink py-12 text-paper/85">
  <div class="wrap grid gap-8 text-sm md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-extrabold tracking-[-0.03em] text-paper">{site.naam}</p>
      <p class="mt-2">{site.familie}<br />{site.straat}, {site.postcode} {site.plaats}</p>
    </div>
    <div>
      <p class="font-display font-bold text-paper">Aangesloten bij</p>
      <ul class="mt-2 space-y-1">
        <li>Vereniging van paardenmelkers</li>
        <li>Nederlandse Shire Horse Society</li>
        <li>Belgian Shire Horse Society</li>
      </ul>
    </div>
    <div class="md:text-right">
      <p><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
      <p class="mt-2">KvK [[AANLEVEREN: KvK-nummer]]</p>
    </div>
  </div>
  {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
</footer>
