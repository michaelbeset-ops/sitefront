---
import Foto from '../components/Foto.astro';
import shire from '../assets/shire.jpg';
import weide from '../assets/weide.jpg';
import grazen from '../assets/grazen.jpg';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const verzorging = ['Douchegel', 'Badschuim', 'Zeeptablet', 'Shampoo', 'Conditioner', 'Reinigingsmelk', 'Facial lotion', 'Bodylotion', 'Special care', 'Day care', 'Night care', 'Hand care', 'Pedi care'];
const shires = ['Alexis', 'Jake', 'July', 'Magnum', 'Missing-one', 'Ocean', 'Shirley', 'Tara', 'Withney', 'Xavira'];
---
<Base
  title="Shirestal De Griendheuvel | Theetuin en paardenmelkerij in de Dordtse Biesbosch"
  description="Theetuin, boerderijwinkel en paardenmelkerij tussen de Shirepaarden aan de Nieuwe Merwedeweg in Dordrecht. In het seizoen open van donderdag tot en met zondag."
>
  <Header />
  <main id="inhoud">

    <!-- Hero: wat het is, wanneer open, en bellen of rijden. Meer hoeft een bezoeker niet. -->
    <section class="wrap grid gap-10 pb-14 pt-10 md:pt-16 lg:grid-cols-12 lg:gap-8 lg:pb-20">
      <div class="lg:col-span-7">
        <p class="kicker">Theetuin, winkel en paardenmelkerij in de Dordtse Biesbosch</p>
        <h1 class="mt-4 text-[clamp(2.5rem,6vw+0.5rem,4.5rem)]">Pannenkoeken en muntthee tussen de Shires</h1>
        <p class="mt-6 max-w-[38rem] text-lg text-ink-soft">
          Via een laantje met pruimenbomen komt u op ons erf. Daar ligt de theetuin, met uitzicht op het land,
          op onze Shirepaarden en hun veulens. Proef paardenmelk, neem iets mee uit de winkel, of blijf gewoon even zitten.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.telHref} class="btn btn-hay">Bel {site.tel}</a>
          <a href={site.maps} class="btn btn-line" rel="noopener">Route plannen</a>
        </div>
      </div>

      <aside aria-labelledby="open-kop" class="self-end border-t-4 border-hay bg-white p-6 shadow-soft lg:col-span-5 lg:p-8">
        <h2 id="open-kop" class="text-2xl">Wanneer we open zijn</h2>
        <dl class="mt-5 divide-y divide-line">
          <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
            <dt class="font-display font-bold">Theetuin</dt>
            <dd>Donderdag tot en met zondag, 11.00 tot 17.00 uur, in het seizoen.
              <span class="block text-sm text-ink-soft">[[AANLEVEREN: begin- en einddatum seizoen 2027]]</span></dd>
          </div>
          <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
            <dt class="font-display font-bold">Winkel</dt>
            <dd>Het hele jaar op zaterdag, 11.00 tot 16.00 uur. Is de theetuin open, dan de winkel ook.</dd>
          </div>
          <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
            <dt class="font-display font-bold">Melkerij</dt>
            <dd>In het melkseizoen op afspraak.</dd>
          </div>
        </dl>
      </aside>

      <div class="aspect-[16/9] rounded-sm lg:col-span-12 lg:aspect-[21/8] overflow-hidden"><Foto src={shire} alt="Shirepaard in vol tuig op een weide" hero sizes="(min-width: 1152px) 1100px, 100vw" /></div>
    </section>

    <!-- Theetuin -->
    <section id="theetuin" class="scroll-mt-20 bg-white py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Een theetuin met eigen paardenmelk</h2>
          <div class="mt-8 aspect-[4/3] overflow-hidden rounded-sm"><Foto src={grazen} alt="Twee paarden grazen in het gras" sizes="(min-width: 1024px) 460px, 100vw" /></div>
        </div>
        <div class="space-y-5 lg:col-span-6 lg:col-start-7">
          <p>
            In de theetuin serveren we koffie, thee en ambachtelijke lekkernijen, een deel ervan gemaakt met onze eigen paardenmelk.
            Op de kaart staan onder meer pannenkoeken en broodjes, en er is keus uit meer dan tachtig soorten muntthee.
          </p>
          <p>
            Wie bij ons fietst of wandelt: we liggen aan de NS-wandelroute tussen station Dordrecht Stadspolders en station Dordrecht Zuid.
            Een goede plek om halverwege even bij te komen.
          </p>
          <div class="border-l-4 border-hay bg-paper p-5">
            <h3 class="text-xl">Menukaart</h3>
            <p class="mt-2 text-ink-soft">[[AANLEVEREN: menukaart met prijzen als tekst, zodat hij op de telefoon leesbaar is in plaats van als download]]</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Vieren: de plek als locatie. Hier zit de omzet buiten het seizoen. -->
    <section id="vieren" class="scroll-mt-20 bg-ink py-16 text-paper lg:py-24">
      <div class="wrap">
        <p class="kicker !text-hay-light">Iets te vieren of te herdenken</p>
        <h2 class="mt-3 max-w-3xl text-3xl">Ons erf als plek voor uw bijeenkomst</h2>
        <div class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-3">
          <div>
            <h3 class="text-xl text-hay-light">Groepen in de winter</h3>
            <p class="mt-3 text-paper/85">
              Ook als de theetuin dicht is, kunt u met een groep vanaf 25 personen bij ons terecht in de binnenruimte.
              Denk aan een lunch, een barbecue of een hapjesbuffet.
            </p>
          </div>
          <div>
            <h3 class="text-xl text-hay-light">Bruiloft</h3>
            <p class="mt-3 text-paper/85">
              Een avondreceptie kan op onze gewone openingsdagen. Op dagen dat we gesloten zijn, is de hele dag mogelijk.
            </p>
          </div>
          <div>
            <h3 class="text-xl text-hay-light">Afscheid</h3>
            <p class="mt-3 text-paper/85">
              In de zomer kunnen uitvaartceremonies op maandag tot en met woensdag, buiten het seizoen op elke dag.
              Er is plaats voor ongeveer 120 mensen buiten en 75 binnen.
            </p>
          </div>
        </div>
        <p class="mt-12 max-w-2xl border-t border-paper/20 pt-6 text-paper/85">
          Catering stemmen we samen met u af. Bel {site.tel} of mail naar{" "}
          <a href={`mailto:${site.mail}`} class="font-bold underline underline-offset-2">{site.mail}</a> voor de mogelijkheden.
        </p>
      </div>
    </section>

    <!-- Winkel -->
    <section id="winkel" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">In de winkel: paardenmelk en wat het land geeft</h2>
          <p class="mt-5 text-ink-soft">
            Proeven en testen mag altijd. Bestellen kan ook telefonisch of per mail, ophalen doet u op het erf.
          </p>
        </div>
        <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
          <div>
            <h3 class="text-xl">Paardenmelk</h3>
            <p class="mt-2">Vers of diepgevroren, in flesjes van 250 ml. Prijs op aanvraag.</p>
            <p class="mt-3">Nieuw: likeur van paardenmelk in de smaken kokos en hazelnoot, en een drinkyoghurt van paardenmelk.</p>
          </div>
          <div>
            <h3 class="text-xl">Van het erf en uit de Biesbosch</h3>
            <p class="mt-2">Kaas, Biesbosch-honing, jam, sappen, walnoten, eieren, aardappels en groente van het seizoen.</p>
          </div>
          <div class="sm:col-span-2">
            <h3 class="text-xl">Verzorging op basis van paardenmelk</h3>
            <p class="mt-2 text-ink-soft">Dierproefvrij, ontwikkeld en gemaakt door Brabanderhof Cosmetics in België.</p>
            <ul class="mt-4 flex flex-wrap gap-2 text-sm">
              {verzorging.map((v) => <li class="rounded-sm border border-line bg-white px-3 py-1.5">{v}</li>)}
            </ul>
          </div>
          <div class="sm:col-span-2">
            <h3 class="text-xl">Shire-souvenirs</h3>
            <p class="mt-2">Beeldjes, sleutelhangers, broches en natuurlijk horse brasses.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Paarden -->
    <section id="paarden" class="scroll-mt-20 border-y border-line bg-paper-deep py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">De grootste paarden die er zijn</h2>
          <p class="mt-5">
            De Shire komt uit midden-Engeland en is het grootste paardenras. Hij werd gefokt voor zwaar landwerk en trok in de
            negentiende eeuw kanaalboten, trams en bierwagens. Rond 1960 was het ras bijna uitgestorven. Inmiddels groeien de aantallen weer.
          </p>
          <p class="mt-4">
            Onze merries melken we vanaf ruim acht weken na de geboorte van hun veulen, altijd met het veulen erbij.
            Alleen dan geeft een merrie haar melk, en er blijft genoeg over voor het jong.
          </p>
          <h3 class="mt-10 text-xl">Wie hier nu wonen en werken</h3>
          <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1 font-display font-semibold sm:grid-cols-3">
            {shires.map((n) => <li>{n}</li>)}
          </ul>
        </div>
        <div class="space-y-10 lg:col-span-5 lg:col-start-8">
          <div class="bg-white p-6 shadow-soft lg:p-8">
            <h3 class="text-xl">Bedrijfsbezoek</h3>
            <p class="mt-3">
              Een rondleiding over het bedrijf, kijken bij het melken, en daarna in de theetuin een wafel van paardenmelk
              met warme kersen en slagroom, met twee drankjes. Bel of mail om een afspraak te maken.
            </p>
            <p class="mt-3 text-sm text-ink-soft">[[AANLEVEREN: prijs per persoon en minimale groepsgrootte]]</p>
          </div>
          <div class="bg-white p-6 shadow-soft lg:p-8">
            <h3 class="text-xl">Training en paarden te koop</h3>
            <p class="mt-3">
              Joyce Komejan is dressuurinstructeur (niveau 4) en maakt paarden en pony's zadelmak, traint ze door
              en brengt ze uit op wedstrijden. Uw paard staat dan in volledig pension bij ons op stal.
              We hebben geregeld Shires, sportpaarden en pony's te koop.
            </p>
            <p class="mt-4 font-display font-bold">
              <a href={site.telPaardenHref} class="underline decoration-hay decoration-2 underline-offset-4">{site.telPaarden}</a>
              <span class="font-normal text-ink-soft"> of via </span>
              <a href={site.whatsappPaarden} class="underline decoration-hay decoration-2 underline-offset-4" rel="noopener">WhatsApp</a>
            </p>
          </div>
          <p class="border-l-4 border-hay pl-5 font-display text-lg font-bold">Open dag: elke eerste zaterdag van september.</p>
        </div>
      </div>
    </section>

    <!-- Over ons -->
    <section class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:py-24">
      <div class="aspect-[4/3] rounded-sm lg:col-span-4 lg:aspect-[4/5] overflow-hidden"><Foto src={weide} alt="Paard in de wei bij een houten hek" sizes="(min-width: 1024px) 380px, 100vw" /></div>
      <div class="self-center lg:col-span-6 lg:col-start-6">
        <h2 class="text-3xl">Begonnen als hobby</h2>
        <p class="mt-5 text-lg">
          Wij zijn Chris, Gerdien en Joyce Komejan. Wat ooit begon als een kleine hobby met Shire horses, is uitgegroeid tot een
          flinke Shirestal. We fokken onze eigen Shires, melken de merries en ontvangen u graag op het erf.
        </p>
      </div>
    </section>

    <!-- Route en contact -->
    <section id="route" class="scroll-mt-20 bg-white py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Aan de rand van de Dordtse Biesbosch</h2>
          <address class="mt-6 not-italic text-lg">
            {site.naam}<br />
            {site.straat}<br />
            {site.postcode} {site.plaats}
          </address>
          <p class="mt-4">Met de auto zijn we goed te bereiken. Te voet ligt het erf aan de NS-wandelroute tussen Dordrecht Stadspolders en Dordrecht Zuid.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={site.maps} class="btn btn-hay" rel="noopener">Open in Google Maps</a>
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <dl class="grid gap-5 text-lg">
            <div><dt class="font-display text-sm font-bold text-ink-soft">Theetuin, winkel en groepen</dt><dd><a href={site.telHref} class="font-display font-bold underline decoration-hay decoration-2 underline-offset-4">{site.tel}</a></dd></div>
            <div><dt class="font-display text-sm font-bold text-ink-soft">Paarden en training</dt><dd><a href={site.telPaardenHref} class="font-display font-bold underline decoration-hay decoration-2 underline-offset-4">{site.telPaarden}</a> <span class="text-base text-ink-soft">(ook WhatsApp)</span></dd></div>
            <div><dt class="font-display text-sm font-bold text-ink-soft">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="font-display font-bold underline decoration-hay decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          </dl>

          <form class="mt-10 grid gap-4 border-t border-line pt-8" aria-describedby="form-uit" onsubmit="return false">
            <h3 class="text-xl">Stuur ons een bericht</h3>
            <label class="grid gap-1 text-sm font-display font-semibold">Naam
              <input type="text" name="naam" autocomplete="name" class="rounded-sm border border-line bg-paper px-3 py-2.5 font-body text-base font-normal" />
            </label>
            <label class="grid gap-1 text-sm font-display font-semibold">E-mail
              <input type="email" name="email" autocomplete="email" class="rounded-sm border border-line bg-paper px-3 py-2.5 font-body text-base font-normal" />
            </label>
            <label class="grid gap-1 text-sm font-display font-semibold">Uw vraag
              <textarea name="bericht" rows="4" class="rounded-sm border border-line bg-paper px-3 py-2.5 font-body text-base font-normal"></textarea>
            </label>
            {site.voorstel ? (
              <p id="form-uit" class="bg-paper-deep p-4 text-sm">
                Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Mail rechtstreeks naar{" "}
                <a href={`mailto:${site.mail}`} class="font-bold underline">{site.mail}</a> of bel {site.tel}.
              </p>
            ) : (
              <button type="submit" class="btn btn-hay justify-self-start">Verstuur</button>
            )}
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
