---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi, waMet } from '../data/site';

import engel from '../assets/engel.png';
import hero from '../assets/etalage-turquoise.jpg';
import roest from '../assets/etalage-roest.jpg';
import blauw from '../assets/etalage-blauw.jpg';
import broeken from '../assets/etalage-broeken.jpg';
import tuniek from '../assets/item-tuniek.jpg';
import jassen from '../assets/item-jassen.jpg';
import riemen from '../assets/item-riemen.jpg';
import truien from '../assets/item-truien.jpg';
import sjaal from '../assets/item-sjaal.jpg';
import borduur from '../assets/detail-borduur.jpg';
import curiosa from '../assets/curiosa-omslag.jpg';

// Stukken uit hun eigen posts (Facebook/Instagram), met de tekst en prijs zoals Rosa die zelf schreef.
const stukken = [
  { id: 'tuniek', naam: 'Zijden tuniek', wat: '100% zijde, prachtige uitlopende mouwen', prijs: '€ 59', post: '1 oktober', foto: tuniek, alt: 'Roze zijden tuniek met paisleyprint en wijde mouwen', bericht: 'de zijden tuniek met uitlopende mouwen' },
  { id: 'jas', naam: 'Jas van vilt', wat: 'Free size, past van maat M tot XXL. In paars, chocobruin en diepzwart', prijs: '€ 79', post: '24 september', foto: jassen, alt: 'Drie vilten jassen met capuchon in paars, bruin en zwart aan de deur', bericht: 'de vilten jas' },
  { id: 'riem', naam: 'Leren riem', wat: 'Heel veel nieuwe riemen binnen, alles echt leer', prijs: '', post: '3 oktober', foto: riemen, alt: 'Een rij leren riemen in bruin, cognac en zwart op een oosters tapijt', bericht: 'een van de nieuwe leren riemen' },
  { id: 'trui', naam: 'Truitjes en vesten', wat: 'In verschillende kleuren, in zacht katoen', prijs: '', post: '1 oktober', foto: truien, alt: 'Een rek gebreide truitjes en vesten in oranje, groen, rood en paars', bericht: 'de truitjes en vesten in zacht katoen' },
];
const titel = 'Rosa | Exclusieve kleding & curiosa in Gorinchem';
const omschrijving = 'Rosa, Burgstraat 10 in Gorinchem: vintage, bohemian, hippie en romantische kleding en accessoires in mooie materialen. Woensdag t/m zaterdag open, bestellen via WhatsApp.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- HERO: donker vlak met het engeltje, rechts hun etalage op volle hoogte -->
    <section class="donker grid bg-nacht text-licht lg:min-h-[calc(100svh-7.25rem)] lg:max-h-[58rem] lg:grid-cols-12">
      <figure class="relative h-[min(40svh,21rem)] overflow-hidden lg:order-2 lg:col-span-6 lg:h-auto">
        <Image src={hero} alt="Turquoise trui en patchwork rok aan de etalage van Rosa, met de gouden letters Rosa op het raam" quality={70} widths={[420, 640, 900, 1300]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[50%_40%]" />
        <figcaption class="absolute bottom-3 right-4 rounded-sm bg-nacht/70 px-2 py-1 text-[.6875rem] text-licht">De etalage, uit onze post van 29 september</figcaption>
      </figure>
      <div class="relative flex flex-col justify-center px-5 pb-14 pt-12 sm:px-10 lg:order-1 lg:col-span-6 lg:py-16 lg:pl-[max(2.5rem,calc((100vw-79rem)/2+2.5rem))] lg:pr-14">
        <span class="camee mb-8 hidden w-[8.75rem] lg:grid"><Image src={engel} alt="" width={260} class="w-[82%]" /></span>
        <p class="text-xs font-semibold uppercase tracking-[.2em] text-turkoois">Burgstraat 10 · Gorinchem</p>
        <h1 class="mt-5 max-w-[13ch] text-hero">Unieke kleding in de mooiste <span class="text-turkoois">kleuren</span></h1>
        <p class="mt-7 max-w-lg text-lg text-licht/85 md:text-xl">Vintage, bohemian, hippie en romantisch. Kleding en accessoires in mooie materialen, en iedere dag nieuwe pareltjes.</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={waHoi} class="knop knop-licht"><Icoon naam="wa" />Iets gezien? App Rosa</a>
          <a href="#binnen" class="link font-semibold">Wat er net binnen is</a>
        </div>
      </div>
    </section>
    <div class="arcering text-pauw" aria-hidden="true"></div>

    <!-- ETALAGE: hun dagelijkse outfits aan het raam -->
    <section id="etalage" class="overflow-hidden py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-10">
          <h2 class="rijs text-3xl lg:col-span-5">Elke dag een nieuwe etalage</h2>
          <div class="lg:col-span-6 lg:col-start-7 lg:pt-2">
            <p class="rijs max-w-xl text-lg text-grijs">Bijna elke dag een nieuwe post op Facebook en Instagram, met wat er aan de etalage hangt. Alles is heerlijk te combineren met elkaar.</p>
            <div class="rijs mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
              <a href={site.facebook} class="knop knop-inkt knop-klein"><Icoon naam="fb" />Volg op Facebook</a>
              <a href={site.instagram} class="link text-[.9375rem] font-semibold">@rosa.curiosa op Instagram</a>
              <span class="text-sm text-grijs">6.400 volgers op Facebook</span>
            </div>
          </div>
        </div>
        <div class="mt-16 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 md:items-start">
          <figure class="rijs col-span-2 md:col-span-1">
            <Image src={broeken} alt="Vijf patchwork broeken in blauw, oranje, rood, grijs en groen aan de gevel naast de deur" quality={70} widths={[480, 800, 1000]} sizes="(min-width: 768px) 32vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">Broeken in alle kleuren, 29 september</figcaption>
          </figure>
          <figure class="rijs md:mt-20" style="--d:.08s">
            <Image src={roest} alt="Roestkleurig vest met knopen boven een gestreepte broek in rood, bruin en oker, aan de etalage" quality={70} widths={[400, 700, 900]} sizes="(min-width: 768px) 32vw, 50vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">Herfstkleuren, 3 oktober</figcaption>
          </figure>
          <figure class="rijs md:mt-8" style="--d:.16s">
            <Image src={blauw} alt="Blauwe blouse en blauwe patchwork broek voor het raam met Rosa in gouden letters" quality={70} widths={[400, 700, 900]} sizes="(min-width: 768px) 32vw, 50vw" class="aspect-[4/5] w-full rounded-sm object-cover object-top" />
            <figcaption class="mt-3 text-sm text-grijs">Pauwblauw, 2 oktober</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- NET BINNEN: reserveren via WhatsApp (wow) -->
    <section id="binnen" class="border-y border-lijn bg-papier-2 py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-10">
          <h2 class="rijs text-3xl lg:col-span-6">Iets gezien op Facebook of Instagram?</h2>
          <p class="rijs max-w-xl text-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-3">Kies het stuk, geef je maat door en zeg of je het komt passen of liever opgestuurd krijgt. Dan staat je bericht voor Rosa klaar in WhatsApp.</p>
        </div>

        <div class="mt-14 grid items-start gap-y-12 lg:grid-cols-12 lg:gap-x-10">
          <ul class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 lg:col-span-8" data-stukken>
            {stukken.map((s, i) => (
              <li class:list={['rijs', i % 2 === 1 && 'sm:translate-y-16']} style={`--d:${i * 0.06}s`}>
                <button type="button" class="group block w-full text-left" aria-pressed={i === 0 ? 'true' : 'false'} data-stuk={s.id} data-bericht={s.bericht} data-post={s.post} data-naam={s.naam}>
                  <span class="relative block overflow-hidden rounded-sm">
                    <Image src={s.foto} alt={s.alt} quality={70} widths={[300, 460, 640]} sizes="(min-width: 1024px) 26vw, 50vw" class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
                    <span class="gekozen absolute inset-0 ring-4 ring-inset ring-pauw opacity-0 transition-opacity" aria-hidden="true"></span>
                    <span class="gekozen-label absolute left-3 top-3 hidden items-center gap-1.5 rounded-sm bg-pauw px-2.5 py-1 text-xs font-bold text-wit"><Icoon naam="vink" class="h-3.5 w-3.5" />Gekozen</span>
                  </span>
                  <span class="mt-4 flex items-baseline justify-between gap-3">
                    <span class="font-kop text-xl leading-tight sm:text-2xl">{s.naam}</span>
                    {s.prijs && <span class="num flex-none font-semibold">{s.prijs}</span>}
                  </span>
                  <span class="mt-1 block text-[.9375rem] leading-snug text-grijs">{s.wat}</span>
                  <span class="mt-2 block text-xs text-grijs">Uit de post van {s.post}</span>
                </button>
              </li>
            ))}
          </ul>

          <form class="rijs rounded-sm bg-wit p-6 shadow-md sm:p-8 lg:sticky lg:top-28 lg:col-span-4" data-briefje aria-labelledby="briefje-titel">
            <p id="briefje-titel" class="font-kop text-2xl">Reserveren</p>
            <p class="mt-2 text-[.9375rem] text-grijs">Gekozen: <b class="font-semibold text-inkt" data-gekozen>Zijden tuniek</b></p>
            <label class="mt-3 flex cursor-pointer items-center gap-3 text-[.9375rem]">
              <input type="checkbox" name="anders" class="h-5 w-5 accent-[#0b5b62]" />
              Nee, iets anders uit een post
            </label>
            <label class="mt-3 hidden" data-anders-vak>
              <span class="text-sm font-bold">Wat zag je?</span>
              <input name="welke" type="text" class="veld mt-2" placeholder="Bijvoorbeeld de rode bomberjas" autocomplete="off" />
            </label>
            <label class="mt-6 block">
              <span class="text-sm font-bold">Je maat</span>
              <input name="maat" type="text" class="veld mt-2" placeholder="Bijvoorbeeld L of 42" autocomplete="off" />
            </label>
            <fieldset class="mt-6">
              <legend class="text-sm font-bold">Hoe wil je het?</legend>
              <label class="mt-3 flex cursor-pointer items-center gap-3 text-[.9375rem]"><input type="radio" name="hoe" value="passen" checked class="h-5 w-5 accent-[#0b5b62]" />Ik kom het passen in Gorinchem</label>
              <label class="mt-2 flex cursor-pointer items-center gap-3 text-[.9375rem]"><input type="radio" name="hoe" value="opsturen" class="h-5 w-5 accent-[#0b5b62]" />Graag opsturen</label>
            </fieldset>
            <div class="mt-6 rounded-md rounded-tl-none bg-[#e3f1ea] p-4 text-[.9375rem] leading-relaxed" aria-live="polite">
              <p class="text-xs font-bold text-[#2b5d46]">Jouw bericht</p>
              <p class="mt-1" data-bericht-uit>Hoi Rosa! Ik zag de zijden tuniek met uitlopende mouwen (post van 1 oktober). Is die er nog in maat …? Ik kom hem graag passen in de winkel.</p>
            </div>
            <a href={waHoi} class="knop knop-pauw mt-6 w-full" data-stuur><Icoon naam="wa" />Open in WhatsApp</a>
            <p class="mt-3 text-xs text-grijs">Er wordt pas iets verstuurd als jij in WhatsApp op verzenden drukt.</p>
          </form>
        </div>
      </div>
    </section>

    <!-- OVER ROSA: donker, groot borduurwerk + het citaat -->
    <section id="rosa" class="donker overflow-hidden bg-nacht text-licht">
      <div class="wrap grid gap-y-14 py-24 md:py-32 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs relative lg:col-span-5">
          <Image src={borduur} alt="Close-up van rood fluweel met bloemen- en paisleyborduursel" quality={70} widths={[480, 800, 1100]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover max-lg:max-h-[30rem]" />
          <figcaption class="mt-3 text-sm text-licht-zacht">Borduurwerk op fluweel, uit onze post van 28 september</figcaption>
        </figure>
        <div class="lg:col-span-7 lg:pt-6">
          <h2 class="rijs text-3xl">Rosa weet waar de <span class="text-turkoois">pareltjes</span> hangen</h2>
          <blockquote class="rijs mt-10 border-l-2 border-turkoois pl-6">
            <p class="font-kop text-[clamp(1.375rem,1.2vw+1rem,1.875rem)] leading-[1.3]">“Rosa heeft zó veel meer dan je in eerste instantie ziet, ze weet altijd de verborgen pareltjes tevoorschijn te toveren.”</p>
            <footer class="mt-4 text-sm text-licht-zacht">Rabbits &amp; Cats Company, Google-review</footer>
          </blockquote>
          <div class="mt-14 grid gap-x-8 gap-y-8 border-t border-lijn-licht pt-10 sm:grid-cols-3">
            <div class="rijs">
              <p class="font-kop text-xl">Op je gemak passen</p>
              <p class="mt-2 text-[.9375rem] text-licht-zacht">Vertel wat je ongeveer zoekt, dan kijkt Rosa met je mee.</p>
            </div>
            <div class="rijs" style="--d:.08s">
              <p class="font-kop text-xl">Ook opgestuurd</p>
              <p class="mt-2 text-[.9375rem] text-licht-zacht">Bestellen via de app of een PB is zo geregeld. Rosa verstuurt het pakje.</p>
            </div>
            <div class="rijs" style="--d:.16s">
              <p class="font-kop text-xl">En curiosa</p>
              <p class="mt-2 text-[.9375rem] text-licht-zacht">Tussen de kleding: sjaals, hoeden, tassen en nostalgische snuisterijen.</p>
            </div>
          </div>
          <figure class="rijs mt-12">
            <Image src={curiosa} alt="Curiosa: oorbellen met camee, kant en klosjes garen, en de etalage met Rosa op het raam" quality={70} widths={[851]} sizes="(min-width: 1024px) 44vw, 100vw" class="w-full rounded-sm" />
            <figcaption class="mt-3 text-sm text-licht-zacht">Onze Facebook-omslagfoto</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews" class="bg-wit py-24 md:py-32">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs max-w-3xl text-3xl">“Parel van een winkel”</h2>
          <a href={site.reviews} class="rijs inline-flex items-center gap-2.5 text-sm font-semibold no-underline hover:text-pauw">
            <Icoon naam="g" class="h-5 w-5" />
            <span class="flex gap-0.5 text-ster" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            {site.google.score} uit {site.google.aantal} Google-reviews
          </a>
        </div>
        <div class="mt-14 grid gap-x-12 gap-y-12 lg:grid-cols-12">
          <figure class="rijs border-t-2 border-inkt pt-6 lg:col-span-5">
            <span class="flex gap-0.5 text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            <blockquote class="mt-5 font-kop text-[clamp(1.5rem,1.1vw+1.1rem,2rem)] leading-[1.25]">“{reviews[0].tekst}”</blockquote>
            <figcaption class="mt-5 text-sm text-grijs"><b class="font-semibold text-inkt">{reviews[0].naam}</b> · Google-review, {reviews[0].wanneer}</figcaption>
          </figure>
          <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:col-span-7">
            {reviews.slice(1).map((r, i) => (
              <figure class="rijs border-t border-lijn pt-6" style={`--d:${i * 0.06}s`}>
                <span class="flex gap-0.5 text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
                <blockquote class="mt-4 text-lg leading-snug">“{r.tekst}”</blockquote>
                <figcaption class="mt-4 text-sm text-grijs"><b class="font-semibold text-inkt">{r.naam}</b> · Google-review, {r.wanneer}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- BEZOEK -->
    <section id="bezoek" class="border-t border-lijn py-24 md:py-32">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl">Kom langs in de Burgstraat</h2>
          <address class="rijs mt-7 not-italic">
            <p class="text-xl font-semibold">{site.straat}</p>
            <p class="text-lg text-grijs">{site.postcode} {site.plaats}</p>
          </address>
          <p class="rijs mt-6 inline-flex items-center gap-2.5 rounded-sm bg-papier-2 px-4 py-2 text-sm font-semibold" data-status-wrap>
            <span class="stip-open h-2.5 w-2.5 rounded-full bg-grijs" aria-hidden="true"></span>
            <span data-status>Woensdag t/m zaterdag 11.00-17.00</span>
          </p>
          <table class="rijs mt-8 w-full max-w-md text-[1rem]">
            <caption class="sr-only">Openingstijden Rosa</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-bold data-[vandaag]:text-pauw">
                  <th scope="row" class="py-2.5 text-left font-[inherit]">{t.naam}</th>
                  <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="rijs mt-8 max-w-md border-l-2 border-pauw bg-papier-2 px-5 py-4 text-[.9375rem]">
            <p class="font-semibold">Oktober</p>
            <p class="mt-1 text-grijs">Open en pakjes versturen tot en met vrijdag 16 oktober. Daarna gaan we de rest van oktober dicht om weer op te laden. Twijfel je? Kijk even op Facebook of we open zijn.</p>
          </div>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={site.maps} class="knop knop-inkt"><Icoon naam="pin" />Route plannen</a>
            <a href={waHoi} class="knop knop-pauw"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <figure class="rijs">
            <Image src={sjaal} alt="Witte omslagdoek met bloemenborduursel en franje voor een etalageraam" quality={70} widths={[480, 800, 1000]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover max-lg:max-h-[30rem]" />
          </figure>
          <div class="rijs mt-8 border-t border-lijn pt-6">
            <p class="font-kop text-xl">Ook in Dordrecht</p>
            <p class="mt-2 text-[.9375rem] text-grijs">Kom langs in Gorinchem of bij <a href={site.dochter} class="link font-semibold text-inkt">Rosa's Dochter</a> in Dordrecht. Samen zorgen ze iedere dag voor nieuwe aanvoer.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SLOTBAND -->
    <section class="donker relative overflow-hidden bg-pauw text-wit">
      <Image src={engel} alt="" width={300} class="pointer-events-none absolute -right-6 top-1/2 w-72 -translate-y-1/2 opacity-[.18] max-md:hidden" />
      <div class="wrap relative flex flex-wrap items-center justify-between gap-8 py-14 md:py-16">
        <p class="max-w-2xl font-kop text-[clamp(1.75rem,2.2vw+1rem,2.75rem)] leading-[1.08]">Bestellen? Via de app of een PB is het zo geregeld.</p>
        <a href={waHoi} class="knop knop-licht"><Icoon naam="wa" />App Rosa</a>
      </div>
    </section>
  </main>
  <Voet />

  <style>
    [data-open='true'] .stip-open { background: #23a565; box-shadow: 0 0 0 4px #23a56533; }
    [aria-pressed='true'] .gekozen { opacity: 1; }
    [aria-pressed='true'] .gekozen-label { display: inline-flex; }
  </style>

  <script>
    import { waMet } from '../data/site';
    const f = document.querySelector<HTMLFormElement>('[data-briefje]');
    const knoppen = [...document.querySelectorAll<HTMLButtonElement>('[data-stuk]')];
    if (f) {
      const uit = f.querySelector<HTMLElement>('[data-bericht-uit]')!;
      const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const gekozen = f.querySelector<HTMLElement>('[data-gekozen]')!;
      const anders = f.querySelector<HTMLInputElement>('input[name=anders]')!;
      const andersVak = f.querySelector<HTMLElement>('[data-anders-vak]')!;
      let keus = knoppen[0];
      const maak = () => {
        const d = new FormData(f);
        const maat = String(d.get('maat') || '').trim();
        const welke = String(d.get('welke') || '').trim();
        const isAnders = anders.checked;
        andersVak.classList.toggle('hidden', !isAnders);
        andersVak.classList.toggle('block', isAnders);
        knoppen.forEach((k) => k.setAttribute('aria-pressed', String(!isAnders && k === keus)));
        gekozen.textContent = isAnders ? 'iets anders' : keus.dataset.naam!;
        let t = isAnders
          ? `Hoi Rosa! Ik zag ${welke || 'iets moois'} in een post.`
          : `Hoi Rosa! Ik zag ${keus.dataset.bericht} (post van ${keus.dataset.post}).`;
        t += ` Is het er nog in maat ${maat || '…'}?`;
        t += d.get('hoe') === 'opsturen' ? ' Kunnen jullie het opsturen?' : ' Ik kom het graag passen in de winkel.';
        uit.textContent = t;
        stuur.href = waMet(t);
      };
      knoppen.forEach((k) => k.addEventListener('click', () => { keus = k; anders.checked = false; maak(); }));
      f.addEventListener('input', maak); f.addEventListener('change', maak); f.addEventListener('submit', (e) => e.preventDefault());
      maak();
    }
  </script>
</Base>
