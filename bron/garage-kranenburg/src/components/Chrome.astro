---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="flex items-baseline gap-2 font-display text-xl font-bold uppercase leading-none tracking-[0.02em] text-olijf no-underline">
        <span>Kranenburg</span><span class="hidden text-sm tracking-[0.12em] text-ink-soft sm:inline">garage</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href="#voertuigen" class="no-underline hover:text-rood">Voertuigen</a></li>
          <li><a href="#route" class="no-underline hover:text-rood">Openingstijden en route</a></li>
          <li><a href="#afspraak" class="no-underline hover:text-rood">Afspraak</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-rood !px-3.5 !py-2 !text-base">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
        <span class="sm:hidden">Bellen</span><span class="hidden whitespace-nowrap tabular-nums sm:inline">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="op-donker bg-olijf-diep py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg uppercase tracking-[0.02em] text-white">{site.officieel}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
