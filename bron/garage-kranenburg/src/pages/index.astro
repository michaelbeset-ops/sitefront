---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, route } from '../data/site';
import hero from '../assets/hero.jpg';
import onderkant from '../assets/onderkant.jpg';
import camper from '../assets/camper.jpg';

const telIcoon = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
---
<Base
  title="Garage Kranenburg | APK, onderhoud en reparatie in Klaaswaal"
  description="Garagebedrijf Jeroen Kranenburg aan de Molendijk in Klaaswaal: APK, onderhoud en reparatie van personenauto's, bedrijfswagens en campers. Maandag t/m vrijdag open van 8.00 tot 18.00 uur."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Werkplaatsfoto onder een olijfgroene laag; tekst links, zwaar en smal. -->
    <section class="op-donker relative isolate overflow-hidden bg-olijf text-white">
      <div class="absolute inset-0 -z-10">
        <Foto src={hero} alt="Monteur ligt op een werkplaatsvloer naast een opgekrikte rode auto, met gereedschap om zich heen" hero sizes="100vw" class="object-[70%_center]" />
        <div class="absolute inset-0 bg-olijf/85 lg:bg-transparent lg:bg-linear-to-r lg:from-olijf lg:from-35% lg:via-olijf/80 lg:to-olijf/10"></div>
      </div>
      <div class="wrap grid py-14 sm:py-20 lg:grid-cols-12 lg:py-28">
        <div class="lg:col-span-7">
          <p class="label text-geel">Molendijk 17, Klaaswaal</p>
          <h1 class="mt-4 text-4xl uppercase">APK, onderhoud en reparatie</h1>
          <p class="mt-6 max-w-xl text-lg text-white/90">{site.officieel}. Voor personenauto's, bedrijfswagens en campers, onder aan de dijk in Klaaswaal.</p>
          <div class="mt-9 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-rood">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d={telIcoon} /></svg>
              Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span>
            </a>
            <a href="#afspraak" class="btn btn-line">Afspraak aanvragen</a>
          </div>
        </div>
      </div>
      <!-- Gele strook: de drie dingen die je wilt weten voor je komt. -->
      <div class="bg-geel text-ink">
        <ul class="wrap grid gap-x-8 gap-y-2 py-4 text-sm font-semibold sm:grid-cols-3 sm:py-5">
          <li><span class="font-display text-xl font-bold tabular-nums">{site.google.score}</span> op Google <span class="font-normal">({site.google.aantal} reviews)</span></li>
          <li>{site.open} <span class="whitespace-nowrap tabular-nums">{site.tijden}</span></li>
          <li>Vanaf de A29, afslag Numansdorp (22)</li>
        </ul>
      </div>
    </section>

    <!-- Drie voertuigtypes, drie ongelijke blokken. -->
    <section id="voertuigen" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <h2 class="text-3xl uppercase lg:col-span-6">Voor de auto, de bus en de camper</h2>
        <p class="text-lg text-ink-soft lg:col-span-5 lg:col-start-8">Voor APK, onderhoud en reparatie kunt u bij ons terecht met drie soorten voertuigen.</p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-12">
        <article class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-line lg:col-span-7 lg:row-span-2 lg:flex lg:flex-col">
          <div class="aspect-[16/10] overflow-hidden lg:aspect-auto lg:flex-1"><Foto src={onderkant} alt="Onderkant van een opgebokte auto; op de grond liggen een wiel en een losse schokdemper met veer" sizes="(min-width: 1024px) 680px, 100vw" /></div>
          <div class="flex flex-col gap-2 p-6 sm:flex-row sm:gap-5 md:p-8">
            <span class="font-display text-2xl font-bold text-rood tabular-nums">01</span>
            <div>
              <h3 class="text-xl uppercase sm:text-2xl">Personenauto's</h3>
              <p class="mt-2 text-ink-soft">APK, onderhoud en reparatie van uw auto.</p>
              <p class="mt-3 text-xs text-ink-soft">[[AANLEVEREN: merken of bijzonderheden, bijvoorbeeld vervangend vervoer]]</p>
            </div>
          </div>
        </article>

        <article class="flex flex-col gap-2 rounded-xl bg-klei p-6 sm:flex-row sm:gap-5 md:p-8 lg:col-span-5">
          <span class="font-display text-2xl font-bold text-rood tabular-nums">02</span>
          <div>
            <h3 class="text-xl uppercase sm:text-2xl">Bedrijfswagens</h3>
            <p class="mt-2 text-ink-soft">Ook met de bestelbus of bedrijfsauto kunt u bij ons terecht.</p>
            <p class="mt-3 text-xs text-ink-soft">[[AANLEVEREN: tot welk formaat of gewicht, en of u met een wagenpark kunt afspreken]]</p>
          </div>
        </article>

        <article class="op-donker overflow-hidden rounded-xl bg-olijf text-white lg:col-span-5">
          <div class="aspect-[16/9] overflow-hidden"><Foto src={camper} alt="Witte Mercedes Sprinter-camperbus op een smalle weg, met een besneeuwde berg op de achtergrond" sizes="(min-width: 1024px) 480px, 100vw" /></div>
          <div class="flex flex-col gap-2 p-6 sm:flex-row sm:gap-5 md:p-8">
            <span class="font-display text-2xl font-bold text-geel tabular-nums">03</span>
            <div>
              <h3 class="text-xl uppercase sm:text-2xl">Campers</h3>
              <p class="mt-2 text-white/90">Voor de APK, een onderhoudsbeurt of reparatie van uw camper.</p>
              <p class="mt-3 text-xs text-white/80">[[AANLEVEREN: tot welke lengte of hoogte, en welke campers]]</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Openingstijden naast de route in stappen, met een doorsnede van de dijk. -->
    <section id="route" class="scroll-mt-20 border-y border-line bg-klei py-16 lg:py-24">
      <div class="wrap">
        <h2 class="max-w-3xl text-3xl uppercase">Openingstijden en route</h2>
      </div>
      <div class="wrap mt-12 grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h3 class="text-xl uppercase">Openingstijden</h3>
          <dl class="mt-5 border-t-2 border-olijf pt-5">
            <dt class="label text-ink-soft">{site.open}</dt>
            <dd class="mt-1 whitespace-nowrap font-display text-2xl font-bold tabular-nums">{site.tijden}</dd>
          </dl>
          <address class="mt-10 not-italic">
            <span class="label text-ink-soft">Adres</span><br />
            <span class="text-lg">{site.straat}<br />{site.postcode} {site.plaats}</span>
          </address>
        </div>

        <div class="lg:col-span-7 lg:col-start-6">
          <h3 class="text-xl uppercase">Vanaf de A29</h3>
          <ol class="mt-6 space-y-0">
            {route.map((stap, i) => (
              <li class="relative flex gap-5 pb-7 last:pb-0">
                {i < route.length - 1 && <span aria-hidden="true" class="absolute left-[1.05rem] top-10 bottom-1 w-0.5 bg-olijf/30"></span>}
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-olijf font-display font-bold text-geel tabular-nums">{i + 1}</span>
                <p class="pt-1 text-lg">{stap}</p>
              </li>
            ))}
          </ol>
          <!-- Doorsnede: de garage ligt onder aan de dijk, aan de lager gelegen parallelweg. -->
          <figure class="mt-10 rounded-xl bg-paper p-5 ring-1 ring-line">
            <svg viewBox="0 0 400 110" role="img" aria-labelledby="dijk-titel" class="h-auto w-full">
              <title id="dijk-titel">Doorsnede: rechts de dijk af, naar de lager gelegen parallelweg waar de garage staat</title>
              <path d="M0 96h400" stroke="#2f3b2a" stroke-width="2" />
              <path d="M20 96 L95 34 H175 L250 96 Z" fill="#2f3b2a" />
              <path d="M95 34 H175" stroke="#e3b341" stroke-width="4" />
              <path d="M180 30 C215 30 225 88 265 90" stroke="#b3261e" stroke-width="3" fill="none" stroke-dasharray="6 5" />
              <path d="M258 84 l10 6 -11 4" stroke="#b3261e" stroke-width="3" fill="none" />
              <path d="M255 96h90" stroke="#e3b341" stroke-width="4" />
              <path d="M335 96 V70 L355 58 L375 70 V96 Z" fill="#b3261e" />
              <text x="135" y="24" text-anchor="middle" font-size="12" fill="#20281c" font-family="system-ui, sans-serif">dijk</text>
              <text x="300" y="86" text-anchor="middle" font-size="12" fill="#20281c" font-family="system-ui, sans-serif">parallelweg</text>
              <text x="355" y="50" text-anchor="middle" font-size="12" fill="#20281c" font-family="system-ui, sans-serif">garage</text>
            </svg>
          </figure>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-8 text-olijf">Route plannen in Google Maps</a>
        </div>
      </div>
    </section>

    <!-- Afspraakformulier naast de directe lijnen. -->
    <section id="afspraak" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl uppercase">Afspraak maken</h2>
          <p class="mt-5 text-lg text-ink-soft">Bel of mail ons, of laat hier uw gegevens en kenteken achter.</p>
          <dl class="mt-8 space-y-5">
            <div>
              <dt class="label text-ink-soft">Telefoon</dt>
              <dd><a href={site.telHref} class="whitespace-nowrap font-display text-2xl font-bold tabular-nums text-rood underline decoration-2 underline-offset-4">{site.tel}</a></dd>
            </div>
            <div>
              <dt class="label text-ink-soft">E-mail</dt>
              <dd><a href={`mailto:${site.mail}`} class="break-all text-lg underline decoration-2 underline-offset-4">{site.mail}</a></dd>
            </div>
          </dl>
        </div>

        <form class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line md:p-8 lg:col-span-7 lg:col-start-6" action="#" method="post">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="naam" class="block text-sm font-semibold">Naam</label>
              <input id="naam" name="naam" type="text" autocomplete="name" required class="veld mt-1.5" />
            </div>
            <div>
              <label for="telefoon" class="block text-sm font-semibold">Telefoon</label>
              <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" required class="veld mt-1.5" />
            </div>
            <div class="sm:col-span-2">
              <label for="kenteken" class="block text-sm font-semibold">Kenteken</label>
              <input id="kenteken" name="kenteken" type="text" autocapitalize="characters" placeholder="bijv. AB-123-C" class="veld mt-1.5 max-w-60 uppercase tracking-wider placeholder:normal-case placeholder:tracking-normal placeholder:text-ink-soft" />
            </div>
            <fieldset class="sm:col-span-2">
              <legend class="text-sm font-semibold">Soort voertuig</legend>
              <div class="mt-2 flex flex-wrap gap-2">
                {['Personenauto', 'Bedrijfswagen', 'Camper'].map((v, i) => (
                  <label class="flex cursor-pointer items-center gap-2 rounded-lg px-3.5 py-2 ring-1 ring-line has-checked:bg-olijf has-checked:text-white">
                    <input type="radio" name="voertuig" value={v} checked={i === 0} class="accent-rood" /> {v}
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="sm:col-span-2">
              <label for="wat" class="block text-sm font-semibold">Wat moet er gebeuren?</label>
              <textarea id="wat" name="wat" rows="4" placeholder="Bijvoorbeeld APK, een onderhoudsbeurt of een reparatie" class="veld mt-1.5 placeholder:text-ink-soft"></textarea>
            </div>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg bg-klei p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap font-semibold underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all font-semibold underline">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-rood mt-6">Afspraak aanvragen</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
