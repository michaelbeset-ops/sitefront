---
// Hun logo nagemaakt: "BAKS" in een kader, met "ijs & spijs" dat de onderrand onderbreekt (zoals op de ijskar).
interface Props { licht?: boolean; groot?: boolean; }
const { licht = false, groot = false } = Astro.props;
const kleur = licht ? 'text-white' : 'text-forest';
const bg = licht ? 'bg-forest-deep' : 'bg-cream';
---
<span class={`relative inline-flex flex-col items-start leading-none ${kleur}`}>
  <span class={`border-[2.5px] border-current font-display font-bold tracking-[0.04em] ${groot ? 'px-4 pt-2 pb-3 text-[2.6rem]' : 'px-2.5 pt-1 pb-2 text-[1.45rem]'}`}>BAKS</span>
  <span class={`absolute right-1.5 -bottom-[0.55em] px-1 font-body font-bold italic ${bg} ${groot ? 'text-base' : 'text-[0.7rem]'}`}>ijs &amp; spijs</span>
</span>
