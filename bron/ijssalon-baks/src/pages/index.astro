---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Logo from '../components/Logo.astro';
import { site, locaties, smaken, beideLocaties, alleenWoudrichem, oliebollen } from '../data/site';
import vitrine from '../assets/vitrine.jpg';
import pand from '../assets/pand.jpg';
import hoorntje from '../assets/hoorntje.jpg';
import lekkernijen from '../assets/lekkernijen.jpg';
import ijskar from '../assets/ijskar.jpg';
import smoothie from '../assets/smoothie.jpg';
import bakjes from '../assets/bakjes.jpg';
import bolletje from '../assets/bolletje.jpg';
import olie from '../assets/oliebollen.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const wa = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2s.2-1.1.2-1.2-.2-.2-.4-.3z"/></svg>`;
const vink = `<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m2.5 6.2 2.3 2.3 4.7-5"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>`;

const telling = (l: string) => smaken.filter((s) => s.labels.includes(l)).length;
const reserveren = [
  { naam: 'High Ice ijsproeverij', tekst: 'Een bord vol zoete lekkernijen en 8 smaken ambachtelijk ijs. Vanaf 2 personen.', href: '#high-ice' },
  { naam: 'IJs per halve liter', tekst: 'Het is mogelijk uw ijs mee te nemen.', href: '#smaken' },
  { naam: 'Cadeaubonnen', tekst: 'Vraag ernaar in de salon, of bel of mail ons.', href: '#locaties' },
  { naam: 'Verhuur ijskar', tekst: 'Voor een bruiloft, verjaardag of tuinfeest met barbecue.', href: '#ijskar' },
];
const loc = [locaties.woudrichem, locaties.raamsdonksveer];
---
<Base
  title="IJs & Spijssalon Baks | Ambachtelijk schepijs in Woudrichem en Raamsdonksveer"
  description="Sinds 2012 in vestingstad Woudrichem, sinds 2025 ook in Raamsdonksveer. Ambachtelijk schepijs, softijs, High Ice ijsproeverij, ijs per halve liter en verhuur van onze ijskar."
>
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO: diep ijskar-groen. Tekst en bewijzen links, grote vitrinefoto rechts met ons pand als overlappende kaart. -->
    <section class="donker overflow-hidden bg-forest text-white">
      <div class="wrap grid gap-8 pb-14 lg:grid-cols-12 lg:gap-12 lg:pt-14 lg:pb-16">
        <div class="relative -mx-5 sm:-mx-8 lg:order-2 lg:col-span-5 lg:mx-0">
          <figure class="relative overflow-hidden lg:rounded-2xl lg:shadow-lg">
            <div class="aspect-[16/9] lg:aspect-[4/5]"><Foto src={vitrine} alt="Een ijsvitrine met bakken vol schepijs: roze, geel, pistachegroen en chocolade" hero sizes="(min-width: 1216px) 470px, (min-width: 1024px) 40vw, 100vw" /></div>
            <figcaption class="absolute top-3 right-3 rounded-lg bg-forest-deep/85 px-2.5 py-1 text-xs text-white lg:top-4 lg:right-4">Sfeerfoto</figcaption>
          </figure>
          <figure class="absolute right-4 -bottom-8 z-10 flex w-[15.5rem] items-center gap-3 rounded-xl bg-white p-1.5 pr-3 text-ink shadow-lg sm:right-8 lg:right-auto lg:bottom-8 lg:-left-10 lg:block lg:w-[260px] lg:p-2">
            <div class="aspect-[3/2] w-24 flex-none overflow-hidden rounded-lg lg:w-full"><Foto src={pand} alt="Ons pand op de hoek van de Bagijnestraat in Woudrichem, met luifels en een terras vol gasten" widths={[200, 600]} sizes="(min-width: 1024px) 244px, 96px" /></div>
            <figcaption class="text-xs leading-snug lg:px-1.5 lg:pt-3 lg:pb-1 lg:text-sm"><strong class="font-display text-sm font-semibold lg:text-base">Ons pand in Woudrichem</strong><br /><span class="text-ink-soft">Bagijnestraat 2, met terras</span></figcaption>
          </figure>
        </div>
        <div class="pt-8 lg:order-1 lg:col-span-7 lg:flex lg:flex-col lg:justify-center lg:pt-0">
          <p class="kicker text-pistache">Woudrichem <span aria-hidden="true">·</span> Raamsdonksveer</p>
          <h1 class="mt-4 text-4xl">Ambachtelijk schepijs uit de vestingstad</h1>
          <p class="mt-5 max-w-xl text-base text-white/90 sm:text-lg lg:mt-6">Sinds 2012 gevestigd in de mooie vestingstad Woudrichem, en vanaf 2025 ook in Raamsdonksveer. Schepijs door ons ambachtelijk bereid, premium milkshakes, smoothies, ijscoupes en ijskoffie.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#smaken" class="btn btn-pistache">Kies uw smaak<Fragment set:html={pijl} /></a>
            <a href={site.wa} class="btn btn-line"><Fragment set:html={wa} /><span>WhatsApp <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <p class="mt-4 max-w-xl text-sm text-white/80">Tijdens onze openingstijden telefonisch bereikbaar. Anders mail naar <a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] underline underline-offset-2">{site.mail}</a>, dan reageren we zo snel mogelijk.</p>
          <dl class="mt-9 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/20 pt-6 text-sm sm:grid-cols-3">
            <div><dt class="text-white/80">Google, Woudrichem</dt><dd class="mt-0.5"><strong class="font-display text-2xl font-semibold">{site.google}</strong> <span class="text-white/80">({site.reviews} reviews)</span></dd></div>
            <div><dt class="text-white/80">IJsseizoen</dt><dd class="font-display text-xl font-semibold whitespace-nowrap">april t/m september</dd></div>
            <div class="col-span-2 sm:col-span-1"><dt class="text-white/80">Openingstijden</dt><dd><a href="#locaties" class="font-display text-xl font-semibold text-pistache underline underline-offset-4">Per locatie</a></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- OVER + RESERVEREN: kop links, genummerde lijst rechts. -->
    <section class="wrap pt-16 pb-16 lg:pt-24 lg:pb-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-berry">Over ons</p>
          <h2 class="mt-3 text-3xl">Twee salons, één ambacht</h2>
          <p class="mt-5 text-ink-soft">Op beide locaties kunt u genieten van premium milkshakes, smoothies, ijscoupes, ijskoffie, zoete lekkernijen zoals appelgebak en meringue gebak, warme en koude dranken en natuurlijk heerlijk schepijs door ons ambachtelijk bereid.</p>
          <p class="mt-4 text-ink-soft">Ook bent u bij ons aan het juiste adres voor:</p>
        </div>
        <ol class="border-t border-line lg:col-span-7">
          {reserveren.map((d, i) => (
            <li class="border-b border-line">
              <a href={d.href} class="group grid gap-1 py-6 no-underline sm:grid-cols-[3rem_14rem_1fr_1.5rem] sm:items-baseline sm:gap-5">
                <span class="font-display text-sm font-semibold tabular-nums text-berry">0{i + 1}</span>
                <h3 class="text-xl transition-colors group-hover:text-berry">{d.naam}</h3>
                <p class="text-ink-soft">{d.tekst}</p>
                <span class="hidden h-5 w-5 text-leaf transition-transform group-hover:translate-x-1 sm:block"><Fragment set:html={pijl} /></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- WOW 1: SMAKENKIEZER. Zonder JS: alle smaken gewoon als tegels. -->
    <section id="smaken" class="scroll-mt-16 bg-blush/60 py-16 lg:py-24" data-smaken>
      <div class="wrap">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-6">
            <p class="kicker text-berry">Smaken ijs</p>
            <h2 class="mt-3 text-3xl">Welke smaak wordt het vandaag?</h2>
            <p class="mt-5 text-lg">Al het schepijs wordt door IJssalon Baks ambachtelijk bereid, met veel passie en liefde. Verkrijgbaar op een knapperig hoorntje of in een bakje, maar ook als take away ijscoupe.</p>
            <p class="mt-3 text-ink-soft">Wij streven ernaar deze smaken dagelijks in de vitrine te hebben, maar het kan helaas voorkomen dat er een smaak is uitverkocht. In Woudrichem verkopen we ook softijs en sundaes.</p>
          </div>
          <figure class="relative overflow-hidden rounded-2xl shadow-sm lg:col-span-6">
            <div class="aspect-[16/9]"><Foto src={hoorntje} alt="Een hoorntje met drie bolletjes ijs, rood, geel en lichtgroen, tussen gekleurde spikkels" /></div>
          </figure>
        </div>

        <div class="mt-12 rounded-2xl bg-cream p-3 shadow-sm sm:p-6 lg:p-8">
          <form hidden data-filters class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between" onsubmit="return false">
            <div class="relative lg:w-80">
              <label for="zoek" class="sr-only">Zoek een smaak</label>
              <input id="zoek" type="search" placeholder="Zoek een smaak, bijv. kers" autocomplete="off" class="veld veld-licht !rounded-full !pl-11" data-zoek />
              <svg class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </div>
            <fieldset class="flex flex-wrap items-center gap-2">
              <legend class="sr-only">Toon alleen</legend>
              {['Vegan', 'Sorbet', 'Suikerarm'].map((l) => (
                <label class="filter"><input type="checkbox" class="sr-only" value={l} data-filter />{l}<span class="n">{telling(l)}</span></label>
              ))}
            </fieldset>
          </form>
          <p data-uitkomst aria-live="polite" class="mt-4 text-sm font-bold text-ink-soft lg:mt-5">{smaken.length} smaken in de vitrine</p>

          <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5" data-tegels>
            {smaken.map((s) => (
              <li class="tegel flex flex-col items-start gap-2 rounded-xl bg-white p-3.5 shadow-sm lg:flex-row lg:items-center lg:gap-3 lg:p-4" data-naam={`${s.naam} ${s.sub ?? ''}`.replace(/­/g, '').toLowerCase()} data-labels={s.labels.join(' ')}>
                <span class="bol flex-none" style={`background:${s.kleur}`} aria-hidden="true"></span>
                <span class="min-w-0">
                  <span class="block font-display text-base leading-tight font-semibold break-words sm:text-lg">{s.naam}</span>
                  {s.sub && <span class="block text-xs text-ink-soft">{s.sub}</span>}
                  {s.labels.length > 0 && <span class="mt-1 flex flex-wrap gap-1">{s.labels.map((l) => <span class={`label label-${l}`}>{l}</span>)}</span>}
                </span>
              </li>
            ))}
          </ul>
          <p data-leeg hidden class="mt-4 rounded-xl bg-white p-5 text-ink-soft">Geen smaak gevonden. Probeer een ander woord, of zet een filter uit.</p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-12">
          <p class="lg:col-span-7">We hebben een aantal ijssmaken op sorbetbasis en veganbasis, speciaal voor mensen met een allergie voor melkproducten en/of een veganlifestyle. Ook is er suikerarm ijs verkrijgbaar, onder andere voor mensen met diabetes.</p>
          <p class="lg:col-span-5 lg:text-right"><a href="#high-ice" class="inline-flex items-center gap-2 font-display text-lg font-semibold text-berry underline underline-offset-4">Kunt u niet kiezen? Probeer de High Ice<span class="h-5 w-5"><Fragment set:html={pijl} /></span></a></p>
        </div>
      </div>
    </section>

    <!-- HIGH ICE en IJSKAR: donker, twee grote blokken met aanvraag. -->
    <section class="donker bg-forest py-16 text-white lg:py-24">
      <div class="wrap">
        <!-- High Ice -->
        <div id="high-ice" class="grid scroll-mt-20 gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-6">
            <figure class="relative">
              <div class="aspect-[768/463] overflow-hidden rounded-2xl shadow-lg lg:max-w-[600px]"><Foto src={lekkernijen} alt="Een zwarte schaal vol zoete lekkernijen: macarons, petitfours, bonbons en bolletjes ijs met crumble" widths={[480, 768]} sizes="(min-width: 1024px) 600px, 100vw" /></div>
              <ul class="mt-6 grid grid-cols-2 gap-3 text-sm">
                <li class="min-w-0 rounded-xl border border-white/20 p-3 sm:p-4"><strong class="block font-display text-xl sm:text-2xl font-semibold text-pistache">8 smaken</strong>ambachtelijk ijs</li>
                <li class="min-w-0 rounded-xl border border-white/20 p-3 sm:p-4"><strong class="block font-display text-xl sm:text-2xl font-semibold text-pistache">Onbeperkt</strong>koffie of thee</li>
                <li class="min-w-0 rounded-xl border border-white/20 p-3 sm:p-4"><strong class="block font-display text-xl sm:text-2xl font-semibold text-pistache">Vanaf 2</strong>personen</li>
                <li class="min-w-0 rounded-xl border border-white/20 p-3 sm:p-4"><strong class="block font-display text-xl sm:text-2xl font-semibold text-pistache">1 dag</strong>van tevoren reserveren</li>
              </ul>
            </figure>
          </div>
          <div class="lg:col-span-6">
            <p class="kicker text-pistache">High Ice ijsproeverij</p>
            <h2 class="mt-3 text-3xl">Een bord vol zoete lekkernijen</h2>
            <p class="mt-5 text-lg text-white/90">Wilt u genieten van een bord vol zoete lekkernijen, slagroom, saus, dip en natuurlijk 8 smaken ambachtelijk ijs, inclusief onbeperkt koffie of thee? Reserveer dan een High Ice.</p>
            <form class="mt-8 rounded-2xl bg-forest-deep p-5 sm:p-6" data-aanvraag="highice" onsubmit="return false">
              <p class="font-display text-xl font-semibold">Reservering voorbereiden</p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div><label for="hi-loc" class="text-sm font-bold">Locatie</label><select id="hi-loc" name="locatie" class="veld mt-1"><option>Woudrichem</option><option>Raamsdonksveer</option></select></div>
                <div><label for="hi-datum" class="text-sm font-bold">Datum</label><input id="hi-datum" name="datum" type="date" class="veld mt-1" data-morgen /></div>
                <div><label for="hi-pers" class="text-sm font-bold">Aantal personen</label><input id="hi-pers" name="personen" type="number" min="2" value="2" inputmode="numeric" class="veld mt-1" /></div>
                <div><label for="hi-naam" class="text-sm font-bold">Uw naam</label><input id="hi-naam" name="naam" autocomplete="name" class="veld mt-1" /></div>
              </div>
              <p data-samenvatting aria-live="polite" class="mt-5 rounded-xl bg-white/10 p-4 font-bold leading-snug">Kies een datum. Minimaal 1 dag van tevoren, vanaf 2 personen.</p>
              {site.voorstel
                ? <p class="mt-4 text-sm text-white/85">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] underline">{site.mail}</a>.</p>
                : <button type="submit" class="btn btn-pistache mt-4">Reservering versturen</button>}
            </form>
          </div>
        </div>

        <!-- IJskar -->
        <div id="ijskar" class="mt-20 grid scroll-mt-20 gap-10 border-t border-white/15 pt-16 lg:mt-24 lg:grid-cols-12 lg:gap-12 lg:pt-24">
          <div class="lg:order-2 lg:col-span-5 lg:col-start-8">
            <figure class="relative mx-auto mb-6 max-w-[460px] lg:mb-0 lg:ml-auto">
              <div class="aspect-[768/1012] overflow-hidden rounded-2xl shadow-lg"><Foto src={ijskar} alt="Onze groene ijskar met het Baks-logo, met achter de kar een man in een Baks-schort" widths={[480, 768]} sizes="(min-width: 1024px) 460px, 100vw" /></div>
              <figcaption class="absolute -bottom-5 left-5 rounded-xl bg-cream px-4 py-3 text-ink shadow-lg"><Logo /></figcaption>
            </figure>
          </div>
          <div class="lg:order-1 lg:col-span-6">
            <p class="kicker text-pistache">Verhuur ijskar</p>
            <h2 class="mt-3 text-3xl">Heeft u iets te vieren?</h2>
            <p class="mt-5 text-lg text-white/90">Een bruiloft, verjaardag of een tuinfeest met barbecue? Wij komen graag met onze leuke ijskar bij u langs om dit feest compleet te maken. Kom gerust eens langs en vraag naar de mogelijkheden.</p>
            <form class="mt-8 rounded-2xl bg-forest-deep p-5 sm:p-6" data-aanvraag="ijskar" onsubmit="return false">
              <fieldset>
                <legend class="font-display text-xl font-semibold">Wat viert u?</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  {['Bruiloft', 'Verjaardag', 'Tuinfeest met barbecue', 'Iets anders'].map((f, i) => (
                    <label class="filter !bg-transparent text-white !shadow-[inset_0_0_0_1.5px_#ffffff66] has-[:checked]:!bg-pistache has-[:checked]:!text-forest-deep"><input type="radio" name="feest" value={f} class="sr-only" checked={i === 0} />{f}</label>
                  ))}
                </div>
              </fieldset>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div><label for="ik-datum" class="text-sm font-bold">Datum van het feest</label><input id="ik-datum" name="datum" type="date" class="veld mt-1" data-morgen /></div>
                <div><label for="ik-plaats" class="text-sm font-bold">Plaats</label><input id="ik-plaats" name="plaats" autocomplete="address-level2" class="veld mt-1" /></div>
              </div>
              <p data-samenvatting aria-live="polite" class="mt-5 rounded-xl bg-white/10 p-4 font-bold leading-snug">Kies wat u viert en de datum.</p>
              {site.voorstel
                ? <p class="mt-4 text-sm text-white/85">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] underline">{site.mail}</a>.</p>
                : <button type="submit" class="btn btn-pistache mt-4">Vraag de mogelijkheden aan</button>}
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- WOW 2: LOCATIEWISSEL. Zonder JS: beide locaties onder elkaar. -->
    <section id="locaties" class="scroll-mt-16 py-16 lg:py-24" data-locaties>
      <div class="wrap">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="kicker text-berry">Locaties en openingstijden</p>
            <h2 class="mt-3 text-3xl">Woudrichem of Raamsdonksveer?</h2>
          </div>
          <div hidden role="tablist" aria-label="Kies een locatie" class="grid w-full grid-cols-2 self-start rounded-full bg-oat p-1 sm:inline-flex sm:w-auto sm:p-1.5" data-tabs>
            {loc.map((l, i) => (
              <button type="button" role="tab" id={`tab-${i}`} aria-controls={`paneel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tab">{l.naam}</button>
            ))}
          </div>
        </div>

        {loc.map((l, i) => (
          <div id={`paneel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} class="mt-10 grid gap-6 lg:grid-cols-12" data-paneel>
            <div class="flex flex-col rounded-2xl bg-forest p-6 text-white shadow-sm donker lg:col-span-4 lg:p-8">
              <p class="kicker text-pistache">{l.sinds}</p>
              <h3 class="mt-2 text-2xl">{l.naam}</h3>
              <p class="mt-4 text-lg">{l.straat}<br />{l.postcode} {l.plaats}</p>
              {i === 0 && <p class="mt-3"><a href={site.telHref} class="font-bold whitespace-nowrap tabular-nums underline underline-offset-4">{site.tel}</a></p>}
              <p class="mt-3"><a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] underline underline-offset-4">{site.mail}</a></p>
              <p class="mt-auto pt-8"><a href={l.maps} class="btn btn-pistache !text-base">Route plannen<Fragment set:html={pijl} /></a></p>
            </div>
            <div class="rounded-2xl bg-white p-6 shadow-sm lg:col-span-4 lg:p-8">
              <h3 class="text-xl">Openingstijden</h3>
              <dl class="mt-4 space-y-4 text-sm">
                {l.tijden.map((t) => (
                  <div class="rounded-lg border-l-[3px] border-oat py-0.5 pl-3 transition-colors" data-maanden={t.maanden.join(' ')}>
                    <dt class="flex flex-wrap items-center gap-2 font-display text-base font-semibold">{t.kop}<span hidden data-nu class="label label-Sorbet">Deze maand</span></dt>
                    {t.regels.map(([d, u]) => (
                      <dd class="flex justify-between gap-3"><span class="text-ink-soft">{d}</span><span class="whitespace-nowrap tabular-nums font-bold">{u}</span></dd>
                    ))}
                  </div>
                ))}
              </dl>
            </div>
            <div class="rounded-2xl bg-oat p-6 lg:col-span-4 lg:p-8">
              <h3 class="text-xl">Aanbod</h3>
              <ul class="mt-4 space-y-1.5 text-sm">
                {beideLocaties.map((a) => <li class="flex gap-2"><span class="mt-1 h-4 w-4 flex-none text-leaf"><Fragment set:html={vink} /></span>{a}</li>)}
              </ul>
              <p class="mt-5 text-xs font-bold tracking-[0.12em] uppercase text-ink-soft">{i === 0 ? 'Ook in Woudrichem' : 'Alleen in Woudrichem'}</p>
              <ul class="mt-2 space-y-1.5 text-sm">
                {alleenWoudrichem.map((a) => i === 0
                  ? <li class="flex gap-2"><span class="mt-1 h-4 w-4 flex-none text-berry"><Fragment set:html={vink} /></span>{a}</li>
                  : <li class="flex gap-2 text-ink-soft"><span class="mt-2 h-0.5 w-3 flex-none bg-current" aria-hidden="true"></span>{a}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SPIJSKAART WOUDRICHEM: eigen smoothie + sfeerfoto. -->
    <section class="bg-oat py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
        <div class="grid grid-cols-5 gap-4 lg:col-span-6">
          <div class="col-span-3 aspect-[736/1024] overflow-hidden rounded-2xl shadow-sm"><Foto src={smoothie} alt="Een glas rode fruitsmoothie met een geel rietje en een blauw cocktailparasolletje" widths={[400, 736]} sizes="(min-width: 1024px) 340px, 60vw" /></div>
          <div class="col-span-2 flex flex-col gap-4 pt-12">
            <div class="aspect-[4/5] overflow-hidden rounded-2xl shadow-sm"><Foto src={bolletje} alt="Een bolletje chocolade-ijs boven een halve kokosnoot met ijs" sizes="(min-width: 1024px) 220px, 40vw" /></div>
            <div class="aspect-square overflow-hidden rounded-2xl shadow-sm"><Foto src={bakjes} alt="Vier schaaltjes met een bolletje ijs en gouden lepeltjes op een donkere tafel" sizes="(min-width: 1024px) 220px, 40vw" /></div>
          </div>
        </div>
        <div class="lg:col-span-6">
          <p class="kicker text-berry">Spijskaart Woudrichem</p>
          <h2 class="mt-3 text-3xl">Meer dan ijs alleen</h2>
          <p class="mt-5 text-lg">Naast ambachtelijk bereid ijs of softijs staan er heerlijke tosti’s op onze kaart. En zoete lekkernijen voor bij de koffie of thee, zoals wafels, meringue gebak en appelgebak met slagroom.</p>
          <dl class="mt-8 grid gap-px overflow-hidden rounded-xl bg-line text-sm sm:grid-cols-2">
            <div class="bg-cream p-5"><dt class="font-display text-lg font-semibold">Hartig</dt><dd class="mt-1 text-ink-soft">Tosti’s</dd></div>
            <div class="bg-cream p-5"><dt class="font-display text-lg font-semibold">Zoet</dt><dd class="mt-1 text-ink-soft">Wafels met ijs, aardbeien of warme kersen, meringue gebak, appelgebak met slagroom</dd></div>
            <div class="bg-cream p-5"><dt class="font-display text-lg font-semibold">Koud</dt><dd class="mt-1 text-ink-soft">Premium milkshakes, verse fruitshakes, ijskoffie, vers gemixte fruit- of groentesmoothies</dd></div>
            <div class="bg-cream p-5"><dt class="font-display text-lg font-semibold">Warm</dt><dd class="mt-1 text-ink-soft">Diverse specials en verse muntthee</dd></div>
          </dl>
          <p class="mt-6 text-sm text-ink-soft">En kunt u naast zelf energie opdoen ook uw elektrische fiets opladen. Wij hebben veel informatie en folders om uw bezoek aan Woudrichem compleet te maken.</p>
        </div>
      </div>
    </section>

    <!-- OLIEBOLLEN: warm bessenrood, eigen foto uit de bakpan. -->
    <section id="oliebollen" class="donker scroll-mt-16 bg-berry py-16 text-white lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <p class="kicker text-blush">Seizoen, alleen in Woudrichem</p>
          <h2 class="mt-3 text-3xl">Oliebollen en appelbeignets</h2>
          <p class="mt-5 text-lg text-white/90">Op locatie Woudrichem bakken we op deze data de lekkerste oliebollen en appelbeignets.</p>
          <ol class="mt-8 border-t border-white/25">
            {oliebollen.map((o) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-white/25 py-4">
                <span class="font-display text-xl font-semibold">{o.dag}</span>
                <span class="whitespace-nowrap tabular-nums text-white/90">{o.tijd}</span>
              </li>
            ))}
          </ol>
          <p class="mt-6 max-w-xl text-white/90">Op 31 december hanteren we een op=op principe voor niet bestelde oliebollen en appelbeignets, dus bestel op tijd.</p>
          <p class="mt-6"><a href={`mailto:${site.mail}?subject=Bestelling%20oliebollen`} class="btn btn-line"><Fragment set:html={mail} />Bestel via {site.mail}</a></p>
        </div>
        <figure class="lg:col-span-5">
          <div class="mx-auto aspect-[768/919] max-w-[440px] overflow-hidden rounded-2xl shadow-lg lg:mr-0"><Foto src={olie} alt="Oliebollen en appelbeignets die goudbruin bakken in de frituurpan" widths={[440, 768]} sizes="(min-width: 1024px) 440px, 100vw" /></div>
        </figure>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="donker bg-forest py-16 text-white lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-pistache">Contact</p>
          <h2 class="mt-3 text-3xl">Bellen, appen of mailen</h2>
          <p class="mt-5 max-w-lg text-lg text-white/90">Tijdens onze openingstijden zijn we telefonisch bereikbaar. Zijn wij telefonisch niet bereikbaar, mail dan uw vraag; dan reageren we zo snel mogelijk.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.wa} class="btn btn-pistache"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <p class="mt-4"><a href={`mailto:${site.mail}`} class="inline-flex items-center gap-2 [overflow-wrap:anywhere] underline underline-offset-4"><span class="h-5 w-5 flex-none"><Fragment set:html={mail} /></span>{site.mail}</a></p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-6">
          {loc.map((l) => (
            <div class="flex flex-col rounded-2xl bg-forest-deep p-6">
              <p class="kicker text-pistache">Locatie</p>
              <h3 class="mt-2 text-xl">{l.naam}</h3>
              <p class="mt-3">{l.straat}<br />{l.postcode} {l.plaats}</p>
              <p class="mt-auto pt-6"><a href={l.maps} class="font-bold text-pistache underline underline-offset-4">Route plannen</a></p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  // Smakenkiezer: zoeken + filters, met telling voor schermlezers.
  const s = document.querySelector<HTMLElement>('[data-smaken]');
  if (s) {
    const form = s.querySelector<HTMLFormElement>('[data-filters]')!;
    const zoek = s.querySelector<HTMLInputElement>('[data-zoek]')!;
    const filters = [...s.querySelectorAll<HTMLInputElement>('[data-filter]')];
    const tegels = [...s.querySelectorAll<HTMLElement>('[data-tegels] > li')];
    const uit = s.querySelector<HTMLElement>('[data-uitkomst]')!;
    const leeg = s.querySelector<HTMLElement>('[data-leeg]')!;
    form.hidden = false;
    const werk = () => {
      const q = zoek.value.trim().toLowerCase();
      const aan = filters.filter((f) => f.checked).map((f) => f.value);
      let n = 0;
      for (const t of tegels) {
        const labels = (t.dataset.labels || '').split(' ');
        const ok = (!q || (t.dataset.naam || '').includes(q)) && aan.every((a) => labels.includes(a));
        t.hidden = !ok;
        if (ok) n++;
      }
      leeg.hidden = n > 0;
      const wat = aan.length ? ` (${aan.join(' en ').toLowerCase()})` : '';
      uit.textContent = n === 1 ? `1 smaak${wat}` : `${n} smaken${wat}`;
    };
    zoek.addEventListener('input', werk);
    filters.forEach((f) => f.addEventListener('change', werk));
  }

  // Locatiewissel: tabs met pijltjestoetsen; zonder JS staan beide locaties onder elkaar.
  const l = document.querySelector<HTMLElement>('[data-locaties]');
  if (l) {
    const lijst = l.querySelector<HTMLElement>('[data-tabs]')!;
    const tabs = [...lijst.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panelen = [...l.querySelectorAll<HTMLElement>('[data-paneel]')];
    lijst.hidden = false;
    const kies = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panelen.forEach((p, j) => { p.hidden = i !== j; });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => kies(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); kies((i + 1) % tabs.length, true); }
      });
    });
    kies(0);
    // Markeer de huidige maand in de openingstijden.
    const m = String(new Date().getMonth() + 1);
    l.querySelectorAll<HTMLElement>('[data-maanden]').forEach((r) => {
      if (r.dataset.maanden!.split(' ').includes(m)) {
        r.classList.replace('border-oat', 'border-berry');
        r.querySelector<HTMLElement>('[data-nu]')!.hidden = false;
      }
    });
  }

  // Aanvragen High Ice en ijskar: live samenvatting, versturen doet niets in het voorstel.
  const morgen = new Date(); morgen.setDate(morgen.getDate() + 1);
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  document.querySelectorAll<HTMLInputElement>('[data-morgen]').forEach((i) => { i.min = iso(morgen); });
  // Vaste openingstijden (pagina Openingstijden): beide locaties april t/m september.
  const open = (_loc: string, v: string) => { const m = Number(v.slice(5, 7)); return m >= 4 && m <= 9; };
  const lang = (v: string) => new Date(v + 'T12:00').toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long' });
  document.querySelectorAll<HTMLFormElement>('[data-aanvraag]').forEach((f) => {
    const out = f.querySelector<HTMLElement>('[data-samenvatting]')!;
    const werk = () => {
      const d = new FormData(f);
      const datum = String(d.get('datum') || '');
      const telaat = datum && datum < iso(morgen);
      if (f.dataset.aanvraag === 'highice') {
        const p = Number(d.get('personen') || 0);
        if (!datum) out.textContent = 'Kies een datum. Minimaal 1 dag van tevoren, vanaf 2 personen.';
        else if (telaat) out.textContent = 'Een High Ice reserveert u minimaal 1 dag van tevoren. Kies een latere datum.';
        else if (p < 2) out.textContent = 'Een High Ice is vanaf 2 personen.';
        else if (!open(String(d.get('locatie')), datum)) out.textContent = `In ${new Date(datum + 'T12:00').toLocaleDateString('nl-NL', { month: 'long' })} heeft ${d.get('locatie')} geen vaste openingstijden. Kies een datum van april t/m september, of bel ons.`;
        else out.textContent = `High Ice voor ${p} personen, ${lang(datum)}, in ${d.get('locatie')}.`;
      } else {
        const plaats = String(d.get('plaats') || '').trim();
        if (!datum) out.textContent = `${d.get('feest')}: kies nog de datum.`;
        else if (telaat) out.textContent = 'Kies een datum in de toekomst.';
        else out.textContent = `IJskar${d.get('feest') === 'Iets anders' ? '' : ` voor ${String(d.get('feest')).toLowerCase()}`}, ${lang(datum)}${plaats ? `, in ${plaats}` : ''}.`;
      }
    };
    f.addEventListener('input', werk);
    f.addEventListener('change', werk);
  });
</script>
