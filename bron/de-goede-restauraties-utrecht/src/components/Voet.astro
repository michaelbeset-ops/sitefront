---
import { Image } from 'astro:assets';
import { site, url, waHoi } from '../data/site';
import Kleurkaart from './Kleurkaart.astro';
import logo from '../assets/logo.png';
const jaar = new Date().getFullYear();
const lijst = ['Meubelrestauratie', 'Schellak politoeren', 'Fineer en marqueterie', 'Houtdraaien en slotenmaken', 'Vergulden', 'Collectieadvies'];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <div class="flex items-center gap-4 text-wit">
        <Image src={logo} alt="" width={56} height={74} densities={[1, 2]} class="h-[4.6rem] w-auto flex-none" />
        <p class="kop text-2xl leading-tight">De Goede<br />Restauraties</p>
      </div>
      <p class="mt-6 max-w-xs">Conservatie en restauratie van antiek, houtkunst en meubelen. Restaurator Arian de Goede, Utrecht.</p>
      <Kleurkaart class="mt-8 h-3.5 w-40" />
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Ambachten</p>
      <ul class="mt-3 space-y-1">{lijst.map((p) => <li><a href={url('#ambachten')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-4 flex gap-5"><a href={site.insta} class="link link-licht">Instagram</a><a href={site.linkedin} class="link link-licht">LinkedIn</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Werktijden</p>
      <p class="mt-3 num">ma t/m vr<br />9:00 tot 17:00</p>
      <p class="mt-2">langskomen graag op afspraak</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} De Goede Restauraties, Utrecht · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's en teksten komen van jullie eigen website degoederestauraties.nl. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
