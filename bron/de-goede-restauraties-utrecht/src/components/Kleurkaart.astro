---
// Eigen detail: de kleurkaart die De Goede naast objecten legt bij het documenteren (zie hun objectfoto's).
// Grijswaarden van wit naar zwart, met zes kleurvakjes. Puur decoratief.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const grijs = ['#f6f6f4', '#d9dbda', '#b4b8b8', '#8b9091', '#62676a', '#3d4144', '#1c1e1f'];
const kleur = ['#843f40', '#b9853f', '#5b7a4c', '#3f6487', '#7b5a86', '#c9a98e'];
---
<svg class={cls} viewBox="0 0 156 14" aria-hidden="true" focusable="false" preserveAspectRatio="xMinYMid meet">
  {grijs.map((c, i) => <rect x={i * 12} y="0" width="12" height="14" fill={c} />)}
  <rect x="0" y="0" width="84" height="14" fill="none" stroke="#1c1e1f" stroke-opacity=".35" stroke-width=".6" />
  {kleur.map((c, i) => <rect x={90 + i * 11} y="2" width="10" height="10" fill={c} />)}
</svg>
