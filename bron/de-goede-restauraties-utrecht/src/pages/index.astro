---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Kleurkaart from '../components/Kleurkaart.astro';
import { site, ambachten, soorten, problemen, reviews, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import keeftkast from '../assets/keeftkast.jpg';
import tafelLs from '../assets/tafel-ls.jpg';
import kussenkast from '../assets/kussenkast.jpg';
import chronometer from '../assets/chronometer.jpg';
import bureau from '../assets/bureau.jpg';
import kabinet from '../assets/kabinet.jpg';
import politoer from '../assets/politoer.jpg';
import beslag from '../assets/beslag.jpg';
import draaien from '../assets/draaien.jpg';
import arian from '../assets/arian.jpg';
import werkplaats from '../assets/werkplaats.jpg';

const titel = 'De Goede Restauraties | Meubelrestauratie in Utrecht';
const omschrijving = 'Restaurator Arian de Goede conserveert en restaureert antieke meubels en houten objecten in zijn werkplaats aan de Plompetorengracht in Utrecht.';

---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: hun eigen detailfoto, een kopbeslag op een tafelpoot, op het grijze fotodoek -->
    <section class="relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col justify-end overflow-hidden bg-inkt text-wit md:min-h-[calc(100svh-5rem)]">
      <Image src={hero} alt="Detail van een tafel met een metalen kopbeslag in de vorm van een vrouwenhoofd boven de tafelpoot, en een rand van ingelegd lijnwerk" quality={76} widths={[480, 720, 960, 1280, 1680, 2200]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_40%] lg:object-[62%_30%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1c1e1f1a_0%,#1c1e1f33_35%,#1c1e1fb3_62%,#1c1e1fed_100%)] lg:bg-[linear-gradient(90deg,#1c1e1fd9_0%,#1c1e1f99_30%,#1c1e1f26_55%,#1c1e1f00_75%),linear-gradient(0deg,#1c1e1f8c_0%,#1c1e1f00_38%)]" aria-hidden="true"></div>
      <div class="wrap grid items-end gap-y-10 pb-28 pt-28 md:pb-16 lg:grid-cols-12 lg:pb-20">
        <div class="lg:col-span-7">
          <p class="text-sm text-wit/85">Meubelrestauratie in Utrecht</p>
          <h1 class="mt-5 max-w-[14ch] text-hero">Restauratie geeft meubel&shy;geschiedenis toekomst.</h1>
          <p class="mt-7 max-w-[32rem] text-lg text-wit/90">Restaurator Arian de Goede conserveert en restaureert antieke meubels en houten objecten, in zijn werkplaats aan de Plompetorengracht.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#aanvraag" class="knop">Restauratie aanvragen<Icoon naam="pijl" /></a>
            <a href="#werk" class="knop knop-lijn">Bekijk het werk</a>
          </div>
        </div>
        <div class="hidden justify-self-end text-right lg:col-span-5 lg:block">
          <Kleurkaart class="ml-auto h-3.5 w-40" />
          <p class="cursief mt-3 text-[.9375rem] text-wit/85">Kopbeslag op een tafelpoot, in de werkplaats</p>
        </div>
      </div>
    </section>

    <!-- 2. CATALOGUS: hun eigen objectfoto's met de omschrijving die ze er zelf bij geven -->
    <section id="werk" class="bg-doek py-20 md:py-24" aria-labelledby="werk-titel">
      <div class="wrap">
        <div class="grid gap-y-5 lg:grid-cols-12 lg:gap-x-12">
          <h2 id="werk-titel" class="rijs text-3xl lg:col-span-6">Uit de werkplaats</h2>
          <p class="rijs max-w-md self-end text-lg text-grijs lg:col-span-5 lg:col-start-8">Van een renaissance keeftkast tot een scheepschronometer. Elk object vraagt een eigen behandeling.</p>
        </div>

        <div class="mt-12 grid grid-cols-2 gap-x-3 gap-y-10 md:mt-16 md:grid-cols-12 md:gap-x-6 md:gap-y-14">
          <figure class="rijs col-span-2 md:col-span-5 md:row-span-2">
            <Image src={keeftkast} alt="Een renaissance keeftkast van eikenhout met gecanneleerde zuilen, gestoken lijstwerk en bolpoten" quality={72} widths={[400, 600, 800, 1000]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[41rem]" />
            <figcaption class="cat"><span class="cat-nr">nr. 1</span><span class="cat-naam">Keeftkast</span><span class="cat-sub">Renaissance, eikenhout, zeventiende eeuw</span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-7" style="--d:.08s">
            <Image src={tafelLs} alt="Een ronde neoclassicistische tafel van gefineerd satijnhout met een ingelegd medaillon en taps toelopende poten" quality={72} widths={[400, 600, 800, 1100]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-[19rem]" />
            <figcaption class="cat"><span class="cat-nr">nr. 2</span><span class="cat-naam">Tafel</span><span class="cat-sub">Neoclassicistisch, Louis Seize, satijnhout gefineerd, schellak politoer</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-4" style="--d:.12s">
            <Image src={kussenkast} alt="Een Gelderse kussenkast met zwarte accenten, bolpoten en gestoken onderrand" quality={70} widths={[300, 480, 640]} sizes="(min-width: 768px) 32vw, 50vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[16rem]" />
            <figcaption class="cat"><span class="cat-nr">nr. 3</span><span class="cat-naam">Kussenkast</span><span class="cat-sub">Gelders, zeventiende eeuw</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-3" style="--d:.18s">
            <Image src={chronometer} alt="Een scheepschronometer in een houten kist met koperen hoeken, het deksel open" quality={70} widths={[300, 450, 600]} sizes="(min-width: 768px) 24vw, 50vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[16rem]" />
            <figcaption class="cat"><span class="cat-nr">nr. 4</span><span class="cat-naam">Scheeps&shy;chronometer</span><span class="cat-sub">Na restauratie</span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-7">
            <Image src={bureau} alt="Een bureau met twee kolommen, een groen ingelegd schrijfblad, gestoken leeuwenkoppen en paneeldeuren" quality={72} widths={[400, 600, 800, 1100]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-[25rem]" />
            <figcaption class="cat"><span class="cat-nr">nr. 5</span><span class="cat-naam">Bureau</span><span class="cat-sub">Met gestoken leeuwenkoppen</span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-5" style="--d:.08s">
            <Image src={kabinet} alt="Een klein kabinet van gevlamd hout met laatjes achter een deurtje en een afgeronde bovenkant" quality={72} widths={[400, 600, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_40%] md:aspect-auto md:h-[25rem]" />
            <figcaption class="cat"><span class="cat-nr">nr. 6</span><span class="cat-naam">Klein kabinet</span><span class="cat-sub">Na restauratie</span></figcaption>
          </figure>
        </div>

      </div>
    </section>

    <!-- 3. AMBACHTEN: letterlijk uit hun eigen (verstopte) dienstenpagina -->
    <section id="ambachten" class="bg-inkt py-20 text-wit md:py-24" aria-labelledby="amb-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-4">
          <figure class="rijs">
            <Image src={politoer} alt="Een restaurator wrijft met een politoerbal over een rond tafelblad dat spiegelt van de schellak" quality={72} widths={[400, 600, 800, 1000]} sizes="(min-width: 1024px) 38vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[40%_50%]" />
            <figcaption class="cursief mt-3 text-[.9375rem] text-mist">Schellak politoeren van een tafelblad</figcaption>
          </figure>
          <div class="mt-6 grid grid-cols-2 gap-3">
            <figure class="rijs" style="--d:.08s">
              <Image src={draaien} alt="Arian de Goede aan de houtdraaibank, met veiligheidsbril en schort" quality={70} widths={[300, 450, 600]} sizes="(min-width: 1024px) 18vw, 50vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
              <figcaption class="cursief mt-3 text-[.9375rem] text-mist">Houtdraaien</figcaption>
            </figure>
            <figure class="rijs" style="--d:.14s">
              <Image src={beslag} alt="Twee oude sleutels en twee messing sleutelschildjes op een werkbank, voor een houten kast" quality={70} widths={[300, 450, 600]} sizes="(min-width: 1024px) 18vw, 50vw" class="aspect-[3/4] w-full rounded-sm object-cover object-[45%_70%]" />
              <figcaption class="cursief mt-3 text-[.9375rem] text-mist">Sleutels en beslag</figcaption>
            </figure>
          </div>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <h2 id="amb-titel" class="rijs text-3xl">Binnen restauratie komen ambachten samen</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-mist">Van ebenist, schrijnwerker en houtsnijder tot draaier, marqueteur, vergulder, politoerder en slotenmaker.</p>
          <dl class="mt-10 grid border-t border-lijn-licht sm:grid-cols-2 sm:gap-x-10">
            {ambachten.map((a, i) => (
              <div class="rijs border-b border-lijn-licht py-5" style={`--d:${(i % 2) * 0.06}s`}>
                <dt class="kop text-xl text-wit">{a.naam}</dt>
                <dd class="mt-1.5 text-[.9375rem] leading-relaxed text-mist">{a.tekst}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- 4. DE RESTAURATOR: Arian zelf, opleiding en restauratie-ethiek van zijn eigen site -->
    <section id="restaurator" class="py-20 md:py-24" aria-labelledby="res-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <figure class="rijs">
            <Image src={arian} alt="Arian de Goede in schort met de armen over elkaar in zijn werkplaats" quality={78} widths={[400, 600, 800]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_25%]" />
          </figure>
        </div>
        <div class="flex flex-col lg:col-span-6 lg:col-start-7 lg:pt-4">
          <h2 id="res-titel" class="rijs text-3xl">Arian de Goede, restaurator</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-grijs">Opgeleid in Amsterdam en aan West Dean College in Engeland, na vier jaar meubelmaker met specialisatie restauratie aan het HMC. In 2019 begon hij zijn eigen bedrijf.</p>
          <blockquote class="rijs mt-10 border-l-2 border-rood pl-6">
            <p class="cursief text-2xl leading-snug">“Elk restauratie object is een puzzel, wat is de oorzaak van schade en hoe deze het beste op te lossen.”</p>
          </blockquote>
          <dl class="rijs mt-12 max-w-xl">
            <div class="spec"><dt class="font-semibold">Ethische code</dt><span aria-hidden="true"></span><dd class="text-grijs">E.C.C.O. en beroepsvereniging</dd></div>
            <div class="spec"><dt class="font-semibold">Werkwijze</dt><span aria-hidden="true"></span><dd class="text-grijs">reversibel werken</dd></div>
            <div class="spec"><dt class="font-semibold">Voorop</dt><span aria-hidden="true"></span><dd class="text-grijs">het object en zijn historische waarde</dd></div>
            <div class="spec"><dt class="font-semibold">Vastleggen</dt><span aria-hidden="true"></span><dd class="text-grijs">heldere communicatie en documentatie</dd></div>
            <div class="spec"><dt class="font-semibold">Bijscholing</dt><span aria-hidden="true"></span><dd class="text-grijs">ICWCT 2024, ICCROM, Noorwegen</dd></div>
          </dl>
          <p class="rijs mt-8 text-sm text-grijs">Lid van <a href="https://restauratoren.nl/leden/" class="link">Restauratoren Nederland</a>, <a href="https://www.aranederland.nl/nl/restauratoren/hout-en-snijwerk/631-goede-a-de" class="link">ARA</a> en <a href="https://www.iiconservation.org/profile/56428/108524/view" class="link">IIC</a>.</p>
        </div>
      </div>
    </section>

    <!-- 5. REVIEWS: letterlijk van Google -->
    <section id="reviews" class="border-t border-lijn bg-wit py-20 md:py-24" aria-labelledby="rev-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <h2 id="rev-titel" class="text-3xl">“Een echte professional”</h2>
          <blockquote class="mt-10">
            <p class="cursief text-2xl leading-snug md:text-[1.875rem] md:leading-snug">{reviews.groot.tekst}</p>
          </blockquote>
          <figcaption class="mt-5 text-sm text-grijs">{reviews.groot.naam} op Google, over een antieke stoel</figcaption>
          <p class="mt-12 flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews · <a href={site.google.url} class="link">alle reviews</a></p>
        </figure>
        <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:col-span-6 lg:pt-4">
          {reviews.los.map((x, i) => (
            <figure class="rijs border-t border-lijn pt-6" style={`--d:${i * 0.06}s`}>
              <div class="flex gap-0.5 text-rood" role="img" aria-label="5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-3.5 w-3.5" />)}</div>
              <blockquote class="mt-3 leading-relaxed">{x.tekst}</blockquote>
              <figcaption class="mt-3 text-sm text-grijs">{x.naam} op Google</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. OBJECTKAART: restauratie aanvragen, eindigt in een WhatsApp-bericht met foto's -->
    <section id="aanvraag" class="bg-doek py-16 md:py-24" aria-labelledby="aan-titel">
      <div class="wrap">
        <form class="rijs grid overflow-hidden rounded-md border border-lijn bg-papier shadow-sm lg:grid-cols-12" data-kaart>
          <div class="p-6 sm:p-10 lg:col-span-7 lg:p-14">
            <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-inkt pb-4">
              <h2 id="aan-titel" class="text-3xl">Restauratie aanvragen</h2>
              <Kleurkaart class="h-3 w-32" />
            </div>
            <p class="mt-5 max-w-md text-grijs">Vul de objectkaart in en stuur foto's mee. Arian laat weten wat er mogelijk is.</p>

            <div class="mt-9 grid gap-y-9">
              <label class="block">
                <span class="cursief text-[.9375rem] text-rood">Object</span>
                <select class="veld" name="soort">
                  {soorten.map((c) => <option value={c} selected={c === 'Kast'}>{c}</option>)}
                </select>
              </label>
              <fieldset>
                <legend class="cursief text-[.9375rem] text-rood">Wat is er aan de hand?</legend>
                <div class="mt-2 grid sm:grid-cols-2 sm:gap-x-8">
                  {problemen.map((p) => (
                    <label class="vink"><input type="checkbox" name="probleem" value={p} class="sr-only" /><span class="vink-box"><Icoon naam="vink" /></span><span>{p}</span></label>
                  ))}
                </div>
              </fieldset>
              <label class="block">
                <span class="cursief text-[.9375rem] text-rood">Waar staat het?</span>
                <input class="veld" type="text" name="plaats" autocomplete="address-level2" placeholder="bijvoorbeeld Utrecht" />
              </label>
            </div>
          </div>

          <div class="flex flex-col bg-inkt p-6 text-wit sm:p-10 lg:col-span-5 lg:p-14">
            <p class="cursief text-[.9375rem] text-rood-licht">Uw bericht aan Arian</p>
            <p class="mt-3 rounded-sm bg-inkt-2 p-5 text-[.9688rem] leading-relaxed" data-bericht aria-live="polite"></p>
            <a href={site.wa} class="knop mt-6 w-full" data-wa><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <p class="mt-6 text-sm text-mist">Stuur in WhatsApp een foto van het hele object en een van de schade van dichtbij.</p>
            <p class="mt-auto pt-8 text-sm text-mist">Liever mailen? <a href={`mailto:${site.mail}`} class="link link-licht break-all">{site.mail}</a></p>
          </div>
        </form>
      </div>
    </section>

    <!-- 7. WERKPLAATS EN CONTACT -->
    <section id="werkplaats" class="py-20 md:py-24" aria-labelledby="wp-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-7">
          <Image src={werkplaats} alt="De werkplaats met werkbanken, gereedschap aan de wand, een staande klok en een eikenhouten kast in restauratie" quality={72} widths={[400, 600, 800, 1100]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
        </figure>
        <div class="lg:col-span-5">
          <h2 id="wp-titel" class="rijs text-3xl">De werkplaats aan de Plompe&shy;torengracht</h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs">Bij interesse of vragen staat Arian u graag te woord. Langskomen graag volgens afspraak.</p>
          <dl class="mt-10">
            <div class="rijs spec"><dt class="font-semibold">Adres</dt><span aria-hidden="true"></span><dd class="text-grijs">{site.straat}, {site.plaats}</dd></div>
            <div class="rijs spec"><dt class="font-semibold">Ma t/m vr</dt><span aria-hidden="true"></span><dd class="num text-grijs">9:00 tot 17:00</dd></div>
            <div class="rijs spec"><dt class="font-semibold">Telefoon</dt><span aria-hidden="true"></span><dd><a href={site.telHref} class="link num">{site.tel}</a></dd></div>
            <div class="rijs spec"><dt class="font-semibold">E-mail</dt><span aria-hidden="true"></span><dd class="min-w-0"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></dd></div>
          </dl>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={waMet('Hallo Arian, ik wil graag een afspraak maken om langs te komen in de werkplaats.')} class="knop"><Icoon naam="wa" />Afspraak maken</a>
            <a href={site.route} class="knop knop-inkt"><Icoon naam="pin" />Route</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-kaart]');
  if (f) {
    const wa = f.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const uit = f.querySelector<HTMLElement>('[data-bericht]')!;
    const basis = wa.href.split('?')[0];
    const lidwoord: Record<string, string> = { 'Kast': 'een kast', 'Tafel': 'een tafel', 'Stoel of bank': 'een stoel of bank', 'Secretaire of bureau': 'een secretaire of bureau', 'Commode of ladekast': 'een commode of ladekast', 'Klok': 'een klok', 'Kistje of doos': 'een kistje of doos', 'Iets anders': 'een houten object' };
    const zet = () => {
      const d = new FormData(f);
      const soort = lidwoord[String(d.get('soort'))] || 'een meubel';
      const pr = d.getAll('probleem').map((p) => String(p).charAt(0).toLowerCase() + String(p).slice(1));
      const plaats = String(d.get('plaats') || '').trim();
      const wat = pr.length ? ` ${pr.length > 1 ? 'Wat er aan de hand is: ' + pr.join('; ') : pr[0].charAt(0).toUpperCase() + pr[0].slice(1)}.` : '';
      const waar = plaats ? ` Het staat in ${plaats}.` : '';
      const tekst = `Hallo Arian, ik wil graag ${soort} laten restaureren.${wat}${waar} Ik stuur foto's mee.`;
      uit.textContent = tekst;
      wa.href = `${basis}?text=${encodeURIComponent(tekst)}`;
    };
    f.addEventListener('input', zet);
    f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
