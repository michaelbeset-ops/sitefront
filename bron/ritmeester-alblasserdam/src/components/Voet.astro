---
import { site, url, cat } from '../data/site';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Jachtinterieurs, project- en privé-interieurs, CNC-freeswerk, spuitwerk en lijstwerk. Aan de A15 in Alblasserdam.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Werkvelden</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={h('maritiem')} class="link link-licht">Jachtinterieurs en teakdekken</a></li>
        <li><a href={h('interieur')} class="link link-licht">Project- en privé-interieurs</a></li>
        <li><a href={h('pastoe')} class="link link-licht">Pastoe en design-meubels</a></li>
        <li><a href={h('cnc')} class="link link-licht">CNC-freeswerk en azobé</a></li>
        <li><a href={site.oud} class="link link-licht">Alle projecten van A tot Z</a></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={site.wa} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Werkplaats</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3">Telefonisch bereikbaar: dagelijks 07.30 tot 21.30 uur, vrijdag tot ca. 17.00 uur, zaterdag 09.00 tot 16.00 uur.</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en foto’s van ritmeester-bv.nl en ritmeesteralblasserdam.nl. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
