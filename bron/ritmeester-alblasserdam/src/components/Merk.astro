---
// Woordmerk naar hun logo: "RitMeester" met de grote M, en de blauwe balk "MEESTERWERKEN IN HOUT" eronder.
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = true } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col items-start no-underline ${licht ? 'text-wit' : 'text-zwart'}`}>
  <span class="font-kop text-[1.7rem] leading-none tracking-[.01em]">Rit<span class="text-[1.18em] font-bold">M</span>eester</span>
  <span class={`mt-1 px-1.5 py-[3px] text-[.5625rem] font-bold uppercase leading-none tracking-[.22em] ${licht ? 'bg-wit text-inkt' : 'bg-blauw text-wit'}`}><span class="sr-only"> </span>Meesterwerken in hout</span>
</a>
