---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, cat, reviews, vacatures, waMet, mailMet } from '../data/site';

import hero from '../assets/hero.jpg';
import maritiem from '../assets/maritiem.jpg';
import interieur from '../assets/interieur.jpg';
import pastoe from '../assets/pastoe.jpg';
import pastoe2 from '../assets/pastoe-2.jpg';
import cnc from '../assets/cnc.jpg';
import werkplaats from '../assets/werkplaats.jpg';

// Aanvraag: alleen werkvelden en materialen die ze zelf noemen (ritmeester-bv.nl en categorieën op ritmeesteralblasserdam.nl).
const keuzes = {
  wat: ['een jachtinterieur', 'onderdelen voor een jacht', 'teakdelen of een teakdek', 'een project-interieur', 'een vergadertafel', 'een balie', 'een keuken op maat', 'een privé-interieur', 'Pastoe-restauratie', 'spuitwerk voor een meubel', 'CNC-freeswerk', 'azobé blokken of wiggen', 'een scheepsnaambord'],
  hout: ['teak', 'eiken', 'azobé', 'olijfhout', 'fineer', 'massief hout', 'plaatmateriaal of mdf', 'een ander materiaal'],
  aantal: ['als one-off', 'in een kleine serie', 'in serie'],
  tekening: ['heb ik een tekening', 'heb ik nog geen tekening', 'heb ik een schets of foto'],
};
const zin = (w = 0, h = 0, a = 0, t = 0) => `Goedendag, ik zoek ${keuzes.wat[w]} in ${keuzes.hout[h]}, ${keuzes.aantal[a]}, en daarvoor ${keuzes.tekening[t]}. Kunnen we de mogelijkheden bespreken?`;

const titel = 'Ritmeester BV | Meesterwerken in hout, in CNC en in finishing | Alblasserdam';
const omschrijving = 'Jachtinterieurs en teakdekken, project- en privé-interieurs, restauratie en spuitwerk van Pastoe en design-meubels, CNC-freeswerk en azobé. Staalindustrieweg 43, Alblasserdam.';

const velden = [
  {
    id: 'maritiem', titel: 'Jacht­interieurs en teakdekken', woord: 'hout',
    zin: 'Van onderdeel tot en met compleet, voor serie en one off, in zeil- en motorjachten.',
    regels: ['Van plaatpakket tot totaalinbouw', 'Scheepstafels, deuren, kozijnen, dinettes, lijstwerk', 'Teakdelen op maat, ook voor refit'],
    foto: maritiem, alt: 'Achterkajuit van een motorjacht met vier teakhouten deuren met patrijspoorten, glanzend gelakt', bij: 'Scheepsdeuren in teak, lak- en spuitwerk',
    links: [['Jachtinterieurs', cat(453)], ['Teakdekken', cat(258)], ['Scheepstafels', cat(446)]],
  },
  {
    id: 'interieur', titel: 'Project- en privé-interieurs', woord: 'hout',
    zin: 'Van laboratoriumtafel tot directiekantoor, van keuken tot inloopkledingkast.',
    regels: ['Luxe directie- en vergadertafels met AV-faciliteiten', 'Balies en verkoopcounters, ook in 3-D', 'Naar uw eigen ontwerp, van uw architect, of van ons samen'],
    foto: interieur, alt: 'Stapel gebogen interieurpanelen in de werkplaats', bij: 'Gebogen interieurdelen',
    links: [['Vergadertafels', cat(54)], ['Balies', cat(70)], ['Keukens', cat(139)]],
  },
  {
    id: 'pastoe', titel: 'Pastoe en design-meubels', woord: 'Finishing',
    zin: 'Reparatie, renovatie en restauratie, met lak- en spuitwerk uit de eigen spuiterij.',
    regels: ['Pastoe L-serie, Vision, Amsterdammer en Braakman', 'Herspuiten in een nieuwe kleur', 'Ook verhuizen en opnieuw afstellen'],
    foto: pastoe, alt: 'Rood gespoten Pastoe Frame-dressoir op een houten vloer in een woonkamer', bij: 'Pastoe Frame, herspoten',
    links: [['Pastoe', cat(705)], ['Spuiterij', cat(707)]],
  },
  {
    id: 'cnc', titel: 'CNC-freeswerk en azobé', woord: 'CNC',
    zin: 'Freeswerk in 2-D en 3-D, van klein model tot groot, in hout, mdf en schuim.',
    regels: ['Autocad-tekenwerk en digitalisatie van tekeningen', 'Pluggen, mallen, kielen en vormdelen', 'Azobé blokken, wiggen, zadels en vriescelblokken'],
    foto: cnc, alt: 'Groot 3-D gefreesd azobé blok op de vorken van een heftruck in de werkplaats', bij: 'Azobé support block, 3-D CNC gefreesd',
    links: [['CNC-freeswerk', cat(94)], ['Azobé', cat(923)]],
  },
];
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO -->
    <section class="relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-inkt text-wit md:min-h-[100svh]">
      <Kop />
      <Image src={hero} alt="" quality={76} widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#13294fb3_0%,#13294f33_30%,#13294f99_60%,#13294ff2_100%)] md:bg-[linear-gradient(90deg,#13294fe6_0%,#13294fb3_40%,#13294f26_75%),linear-gradient(0deg,#13294fcc_0%,#13294f00_35%)]"></div>
      <div class="wrap mt-auto pb-14 pt-28 md:my-auto md:pb-16">
        <p class="text-sm font-medium text-wit/85 md:text-base">Interieurbouw, CNC en spuiterij in Alblasserdam</p>
        <h1 class="mt-4 max-w-[12ch] text-hero">Meester&shy;werken in hout.</h1>
        <p class="mt-6 max-w-xl text-base text-wit/90 sm:text-lg md:text-xl">Als het in hout mogelijk is, maken wij het. Van jachtinterieur tot vergadertafel, van Pastoe-restauratie tot CNC-freeswerk.</p>
        <div class="mt-8 flex flex-wrap gap-3 md:mt-10">
          <a href="#aanvraag" class="knop knop-wit">Wat wilt u laten maken?</a>
          <a href={site.telHref} class="knop knop-rand-wit max-sm:hidden"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
        </div>
      </div>
      <div class="wrap pb-7 max-md:hidden">
        <p class="maat maat-licht"><span>{site.straat}, direct aan de A15</span></p>
      </div>
    </section>

    <!-- 2. WERKVELDEN -->
    <section id="werkvelden" class="py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-8 lg:grid-cols-12 lg:gap-x-12">
        <h2 class="rijs text-4xl lg:col-span-7">Eén werkplaats voor hout, CNC en <span class="text-blauw">finishing</span>.</h2>
        <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9 lg:pt-3" style="--d:.1s">Meubelmakers, een CNC-afdeling, een spuiterij en een lijstenmakerij onder één dak. Werven, architecten, bedrijven en particulieren besteden er uit wat ze zelf niet in huis hebben.</p>
      </div>

      <div class="mt-14 space-y-16 md:mt-20 md:space-y-24">
        {velden.map((v, i) => (
          <article id={v.id} class="wrap grid grid-cols-1 items-center gap-y-8 lg:grid-cols-12 lg:gap-x-12">
            <figure class={`rijs lg:col-span-7 ${i % 2 ? 'lg:order-2 lg:col-start-6' : ''}`}>
              <Image src={v.foto} alt={v.alt} quality={72} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-[3/2]" />
              <figcaption class="mt-3 text-xs text-grijs">{v.bij}</figcaption>
            </figure>
            <div class={`rijs lg:col-span-5 ${i % 2 ? 'lg:order-1 lg:col-start-1 lg:pr-4' : 'lg:pl-4'}`} style="--d:.1s">
              <p class="font-kop text-xl text-blauw">Meesterwerken in {v.woord}</p>
              <h3 class="mt-3 text-3xl">{v.titel}</h3>
              <p class="mt-5 text-lg">{v.zin}</p>
              <ul class="mt-6 border-t border-lijn-licht">
                {v.regels.map((r) => <li class="border-b border-lijn-licht py-3 text-grijs">{r}</li>)}
              </ul>
              <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
                <span class="text-grijs">Voorbeelden:</span>
                {v.links.map(([t, href]) => <a href={href} class="link">{t}</a>)}
              </p>
            </div>
          </article>
        ))}
      </div>

      <div class="wrap mt-20 md:mt-28">
        <div class="rijs grid grid-cols-1 gap-y-6 border-y border-lijn-licht py-10 lg:grid-cols-12 lg:gap-x-12">
          <h3 class="text-2xl lg:col-span-4">En verder: specials.</h3>
          <p class="text-lg lg:col-span-8">Houten waskommen, het houten bad, De KooKist, scheepsnaamborden en wimpels, ronde en gebogen wanden, relatiegeschenken met uw logo. <span class="text-grijs">Uw droom is onze grens.</span></p>
        </div>
      </div>
    </section>

    <!-- 3. WERKPLAATS -->
    <section id="werkplaats" class="bg-inkt py-20 text-wit md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <h2 class="rijs text-4xl">Vier afdelingen, één adres.</h2>
          <ul class="rijs mt-10 font-kop text-2xl leading-snug md:text-[1.75rem]" style="--d:.1s">
            <li class="border-t border-lijn py-4">Ritmeester BV</li>
            <li class="border-t border-lijn py-4">Ritmeester CNC Productions BV</li>
            <li class="border-t border-lijn py-4">Ritmeester Spuiterij</li>
            <li class="border-y border-lijn py-4">Ritmeester Lijstenmakerij</li>
          </ul>
          <dl class="rijs mt-12 text-sm" style="--d:.15s">
            <div class="spec"><dt class="text-mist">Gestart</dt><dd>1988, Hendrik-Ido-Ambacht</dd></div>
            <div class="spec"><dt class="text-mist">Ligging</dt><dd>Direct aan de A15</dd></div>
            <div class="spec"><dt class="text-mist">CNC</dt><dd>3- en 5-assig</dd></div>
            <div class="spec"><dt class="text-mist">Persen</dt><dd>Vacuüm en hydraulisch</dd></div>
            <div class="spec"><dt class="text-mist">Jachten</dt><dd>Van 6 tot 20 meter en groter</dd></div>
          </dl>
        </div>
        <figure class="rijs lg:col-span-6" style="--d:.1s">
          <Image src={werkplaats} alt="Twee medewerkers in de werkplaats bij een gebogen paneel in fineer" quality={72} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-xs text-mist">Gebogen interieurdeel in fineer</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. ERVARINGEN -->
    <section id="ervaringen" class="py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={pastoe2} alt="Zwavelgeel gespoten Pastoe Frame-dressoir op een parketvloer" quality={72} widths={[480, 720, 960]} sizes="(min-width: 1024px) 38vw, 100vw" class="aspect-[16/10] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-xs text-grijs">Pastoe Frame, geel gespoten</figcaption>
        </figure>
        <div class="lg:col-span-7">
          <blockquote class="rijs">
            <p class="font-kop text-2xl leading-[1.25] md:text-[2.1rem]">“{reviews.pastoe.tekst}”</p>
            <footer class="mt-5 text-sm text-grijs"><span class="font-semibold text-zwart">{reviews.pastoe.naam}</span> · Google review</footer>
          </blockquote>
          <div class="mt-12 grid gap-x-10 gap-y-10 border-t border-lijn-licht pt-10 md:grid-cols-2">
            {[reviews.teak, reviews.porro].map((r, i) => (
              <blockquote class="rijs" style={`--d:${.08 + i * .08}s`}>
                <p class="text-lg">“{r.tekst}”</p>
                <footer class="mt-4 text-sm text-grijs"><span class="font-semibold text-zwart">{r.naam}</span> · Google review</footer>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. AANVRAAG -->
    <section id="aanvraag" class="bg-inkt py-20 text-wit md:py-28" data-hulp>
      <div class="wrap">
        <h2 class="rijs text-4xl">Wat wilt u laten maken?</h2>
        <p class="rijs mt-10 max-w-5xl font-kop text-[1.5rem] leading-[1.45] sm:text-3xl md:text-[2.6rem] md:leading-[1.35]" style="--d:.1s">
          Ik zoek{" "}
          <label class="sr-only" for="k-wat">Werkveld</label><select id="k-wat" class="kies" data-k="wat">{keuzes.wat.map((t) => <option>{t}</option>)}</select>
          {" "}in{" "}<label class="sr-only" for="k-hout">Houtsoort of materiaal</label><select id="k-hout" class="kies" data-k="hout">{keuzes.hout.map((t) => <option>{t}</option>)}</select>,{" "}
          <label class="sr-only" for="k-aantal">Aantal</label><select id="k-aantal" class="kies" data-k="aantal">{keuzes.aantal.map((t) => <option>{t}</option>)}</select>,
          {" "}en daarvoor{" "}<label class="sr-only" for="k-tek">Tekening</label><select id="k-tek" class="kies" data-k="tekening">{keuzes.tekening.map((t) => <option>{t}</option>)}</select>.
        </p>
        <div class="rijs mt-12 grid grid-cols-1 gap-8 border-t border-lijn pt-8 lg:grid-cols-12" style="--d:.15s">
          <div class="lg:col-span-7">
            <p class="text-sm font-semibold text-mist">Uw bericht</p>
            <p class="mt-3 rounded-sm bg-inkt-2 p-5 text-wit/90" data-bericht aria-live="polite">{zin()}</p>
          </div>
          <div class="flex flex-col gap-3 lg:col-span-4 lg:col-start-9 lg:pt-8">
            <a href={waMet(zin())} class="knop knop-wit" data-wa><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <a href={mailMet('Aanvraag via de website', zin())} class="knop knop-rand-wit" data-mail>Verstuur per e-mail</a>
            <p class="mt-2 text-sm text-mist">Tekening of foto? Die kunt u meesturen in WhatsApp of de e-mail.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- 7. CONTACT -->
    <section id="contact" class="bg-papier-2 py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <h2 class="rijs text-4xl">Bij een kop koffie vertellen wij graag wat wij voor u kunnen betekenen.</h2>
          <p class="rijs mt-10" style="--d:.1s"><a href={site.telHref} class="num text-4xl font-semibold tracking-[-.01em] text-blauw no-underline hover:text-inkt">{site.tel}</a></p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.15s">
            <a href={site.telHref} class="knop knop-blauw"><Icoon naam="tel" />Bellen</a>
            <a href={site.wa} class="knop knop-rand"><Icoon naam="wa" />WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="knop knop-rand">{site.mail}</a>
          </div>
        </div>
        <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.1s">
          <p class="font-kop text-2xl">{site.naam}</p>
          <p class="mt-3 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-2 text-sm text-grijs">Bedrijventerrein Het Nieuwland, direct aan de A15 van Rotterdam naar Gorinchem.</p>
          <a href={site.maps} class="link mt-4 inline-flex items-center gap-2 text-sm font-semibold"><Icoon naam="pin" class="h-4 w-4" />Route plannen</a>
          <dl class="mt-8 border-t border-lijn-licht pt-5 text-sm">
            <dt class="font-semibold">Telefonisch bereikbaar</dt>
            <dd class="mt-2 flex justify-between gap-4 text-grijs"><span>Dagelijks</span><span class="num">07.30 tot 21.30</span></dd>
            <dd class="mt-1 flex justify-between gap-4 text-grijs"><span>Vrijdag</span><span class="num">tot ca. 17.00</span></dd>
            <dd class="mt-1 flex justify-between gap-4 text-grijs"><span>Zaterdag</span><span class="num">09.00 tot 16.00</span></dd>
          </dl>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script define:vars={{ keuzes, wa: site.wa, mail: site.mail }}>
    const hulp = document.querySelector('[data-hulp]');
    if (hulp) {
      const bericht = hulp.querySelector('[data-bericht]');
      const waL = hulp.querySelector('[data-wa]');
      const mailL = hulp.querySelector('[data-mail]');
      const sel = (k) => hulp.querySelector(`[data-k="${k}"]`).value;
      const maak = () => {
        const t = `Goedendag, ik zoek ${sel('wat')} in ${sel('hout')}, ${sel('aantal')}, en daarvoor ${sel('tekening')}. Kunnen we de mogelijkheden bespreken?`;
        bericht.textContent = t;
        waL.href = `${wa}?text=${encodeURIComponent(t)}`;
        mailL.href = `mailto:${mail}?subject=${encodeURIComponent('Aanvraag via de website')}&body=${encodeURIComponent(t)}`;
      };
      hulp.querySelectorAll('select').forEach((s) => s.addEventListener('change', maak));
    }
  </script>
</Base>
