---
import { site, url } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-white/10 bg-nacht text-white">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="font-display text-[1.75rem] leading-none font-extrabold tracking-tight text-white no-underline">AR<span class="text-gloed">-</span>Support</a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm font-bold">
          <li><a href={`${url('')}#ontstoppen`} class="no-underline hover:text-gloed">Ontstoppen</a></li>
          <li><a href={`${url('')}#tarieven`} class="no-underline hover:text-gloed">Tarieven</a></li>
          <li><a href={`${url('')}#reparatie`} class="no-underline hover:text-gloed">Reparatie</a></li>
          <li><a href={`${url('')}#inspectie`} class="no-underline hover:text-gloed">Inspectie en stank</a></li>
          <li><a href={`${url('')}#contact`} class="no-underline hover:text-gloed">Contact</a></li>
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a href={site.telHref} class="hidden font-display text-lg font-bold whitespace-nowrap tabular-nums text-white no-underline hover:text-gloed md:inline">{site.tel}</a>
        <a href={site.whatsapp} class="btn btn-vuur !px-3.5 !py-2 !text-base"><Icoon naam="wa" />WhatsApp</a>
      </div>
    </div>
  </header>
) : (
  <>
    <footer class="border-t border-white/10 bg-nacht py-12 text-white/80">
      <div class="wrap grid gap-8 text-sm md:grid-cols-12">
        <p class="md:col-span-5"><strong class="font-display text-2xl text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK {site.kvk}</p>
        <p class="md:col-span-4"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a>, dag en nacht<br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
        <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
      </div>
      {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
    </footer>
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-white/10 bg-nacht p-2 md:hidden">
      <a href={site.whatsapp} class="btn btn-vuur !py-3 !text-base"><Icoon naam="wa" />WhatsApp</a>
      <a href={site.telHref} class="btn btn-line !py-3 !text-base text-white"><Icoon naam="tel" />Bellen</a>
    </div>
  </>
)}
