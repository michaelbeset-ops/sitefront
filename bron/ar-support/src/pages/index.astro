---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Icoon from '../components/Icoon.astro';
import { site, afvoeren, reparaties, cameraWanneer, checkup, signalen, werkgebied } from '../data/site';
import hero from '../assets/hero.jpg';
import buizen from '../assets/buizen.jpg';
import put from '../assets/put.jpg';
import afvoer from '../assets/afvoer.jpg';
---
<Base
  title="AR-Support | Ontstoppingsbedrijf, 24 uur per dag, 7 dagen per week"
  description="Afvoer of riool verstopt? AR-Support ontstopt, repareert en inspecteert riolering in de regio Rotterdam. Dag en nacht bereikbaar, ook op zon- en feestdagen."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: foto over de volle breedte, tekst links. Mobiel een egale overlay, desktop een verloop. -->
    <section class="relative isolate overflow-hidden bg-nacht text-white">
      <div class="absolute inset-0 -z-10 lg:left-[38%]">
        <Foto src={hero} alt="Handen van een monteur die onder een wastafel de afvoer losdraait, in blauw licht" hero sizes="(min-width: 1024px) 62vw, 100vw" class="object-[70%_50%] lg:object-center" />
        <div class="absolute inset-0 bg-nacht/80 lg:bg-transparent lg:bg-linear-to-r lg:from-nacht lg:via-nacht/60 lg:via-35% lg:to-transparent"></div>
      </div>
      <div class="wrap py-14 md:py-20 lg:py-28">
        <div class="max-w-2xl">
          <p class="kicker text-gloed">Ontstoppingsbedrijf, regio Rotterdam</p>
          <h1 class="mt-4 text-4xl">Verstopt?<br /> U belt, wij komen.</h1>
          <p class="mt-6 max-w-xl text-lg text-white/90">Een verstopping komt altijd onverwacht. Daarom is <span class="whitespace-nowrap">AR-Support</span> 24 uur per dag bereikbaar, 7 dagen per week, ook op zondag en feestdagen. Voor wc, keuken, douche, riool en alles daartussen.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={site.whatsapp} class="btn btn-vuur"><Icoon naam="wa" />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line text-white"><Icoon naam="tel" /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <p class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-white/85">
            <span><strong class="font-display text-2xl text-white">4,8</strong> uit 5 op Google (29 reviews)</span>
            <span class="hidden sm:inline" aria-hidden="true">/</span>
            <span>Voor elk probleem een lopende oplossing</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 24/7-strook -->
    <section aria-label="Bereikbaarheid" class="bg-vuur text-white">
      <div class="wrap flex flex-col gap-3 py-5 md:flex-row md:items-center md:justify-between">
        <p class="font-display text-2xl leading-none font-extrabold uppercase tracking-wide">Dag en nacht bereikbaar</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-1 font-bold">
          <li>24 uur per dag</li>
          <li>7 dagen per week</li>
          <li>Ook op zon- en feestdagen</li>
        </ul>
        <a href={site.telHref} class="font-display text-2xl font-extrabold whitespace-nowrap tabular-nums text-white underline decoration-white/60 decoration-2 underline-offset-4">{site.tel}</a>
      </div>
    </section>

    <!-- Ontstoppen: uitleg links, lijst van afvoeren rechts -->
    <section id="ontstoppen" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-vuur-donker">Ontstoppen</p>
          <h2 class="mt-3 text-3xl">Waar de verstopping ook zit</h2>
          <p class="mt-5 text-ink-soft">Elke verstopping vraagt om een eigen aanpak. De monteur kiest ter plekke het juiste materiaal: water onder hoge druk, of mechanisch met een freesmachine. Daarna reinigen we de leiding met de hogedrukmachine, zodat ook de aanslag weg is.</p>
          <p class="mt-4 text-ink-soft">Binnenshuis en buitenshuis, van gootsteen tot regenafvoer.</p>
        </div>
        <ul class="grid content-start gap-x-8 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
          {afvoeren.map((a) => (
            <li class="flex items-center gap-4 border-b border-line py-3.5 font-display text-xl font-bold">
              <span class="h-3 w-3 flex-none rounded-full border-[3px] border-vuur" aria-hidden="true"></span>{a}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-16 grid overflow-hidden rounded-2xl bg-beton md:grid-cols-12">
        <div class="aspect-[16/10] md:col-span-5 md:aspect-auto"><Foto src={afvoer} alt="Afvoerputje van roestvrij staal in een witte wasbak met waterdruppels" sizes="(min-width: 768px) 40vw, 100vw" /></div>
        <div class="p-6 md:col-span-7 md:p-10">
          <h3 class="text-2xl">Eerst zelf proberen?</h3>
          <p class="mt-3 text-ink-soft">Bij een keuken-, bad- of wasbakafvoer lukt het vaak zelf, met een handveer, een plopper of door de sifon (zwanenhals) met de hand schoon te maken. Lukt het niet? Neem dan direct contact op.</p>
          <p class="mt-3 text-sm text-ink-soft">Heeft u al een ontstoppingsmiddel gebruikt? Meld dat vooraf en laat het middel zo mogelijk aan de monteur zien.</p>
        </div>
      </div>
    </section>

    <!-- Tarieven en garantie -->
    <section id="tarieven" class="scroll-mt-20 bg-beton py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker text-vuur-donker">Tarieven</p>
          <h2 class="mt-3 text-3xl">Vaste prijs, geen verrassingen</h2>
          <p class="mt-5 text-ink-soft">Zijn er grotere problemen dan verwacht, dan krijgt u eerst een vrijblijvende offerte of overleggen we hoe we verder gaan.</p>
          <p class="mt-4 text-xs text-ink-soft">[[AANLEVEREN: tarieven bevestigen]]</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:col-span-8">
          <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-line md:p-8">
            <p class="font-bold">Ontstoppen, eerste 30 minuten</p>
            <p class="mt-2 font-display text-[3.5rem] leading-none font-extrabold whitespace-nowrap tabular-nums">€ 108,-</p>
            <p class="text-sm text-ink-soft">inclusief btw</p>
            <ul class="mt-6 space-y-2 border-t border-line pt-5 text-ink-soft">
              <li>30 minuten werk</li>
              <li>Voorrijkosten binnen 25 km</li>
              <li>Materiaal: hogedrukunit of freesmachine</li>
              <li>Eén maand garantie</li>
            </ul>
          </div>
          <div class="flex flex-col gap-5">
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-line md:p-8">
              <p class="font-bold">Daarna, per kwartier</p>
              <p class="mt-2 font-display text-[2.5rem] leading-none font-extrabold whitespace-nowrap tabular-nums">€ 32,-</p>
              <p class="text-sm text-ink-soft">inclusief btw</p>
            </div>
            <ul class="space-y-2 text-sm text-ink-soft">
              <li>In 80% van de gevallen is de verstopping binnen de eerste 30 minuten verholpen, als het riool niet open hoeft.</li>
              <li>Moet er gegraven worden, dan komen de gewerkte uren en 10% vuilwerktoeslag erbij.</li>
              <li>Prijzen voor particulieren, exclusief eventuele avond- of weekendtoeslag. Betalen contant of per bankoverschrijving.</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="wrap mt-12">
        <div class="grid gap-6 rounded-2xl bg-nacht p-6 text-white md:grid-cols-12 md:p-10">
          <h3 class="text-2xl md:col-span-4">Eén maand garantie op ontstoppen</h3>
          <div class="space-y-3 text-white/85 md:col-span-8">
            <p>Raakt een leiding die wij hebben ontstopt binnen een maand weer verstopt, dan lossen we dat op zonder extra kosten.</p>
            <p class="text-sm">Voorwaarden: de verstopping komt niet door verzakking, breuk of een ander defect aan het riool, en niet door dingen die er niet in horen, zoals vet of vochtig toiletpapier. Het stelsel moet voldoen aan de NEN-normen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Reparatie en aanleg: foto links, lijst rechts -->
    <section id="reparatie" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="aspect-[4/3] overflow-hidden rounded-2xl lg:col-span-6 lg:aspect-[5/6]"><Foto src={buizen} alt="Gestapelde oranje kunststof rioolbuizen met een witte binnenkant" sizes="(min-width: 1024px) 560px, 100vw" /></div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="kicker text-vuur-donker">Reparatie en aanleg</p>
          <h2 class="mt-3 text-3xl">Riool kapot of aan vervanging toe</h2>
          <p class="mt-5 text-ink-soft">Bij het ontstoppen komt soms een breuk of fout aan het licht. AR-Support repareert dat, en legt ook nieuwe riolering aan. Met een zender zoeken we de plek van het probleem op, zodat er niet onnodig gebroken of gegraven hoeft te worden. Het straatwerk herstellen we ook.</p>
          <ul class="mt-6 divide-y divide-line border-y border-line">
            {reparaties.map((r) => <li class="py-3 font-bold">{r}</li>)}
          </ul>
          <p class="mt-6 text-ink-soft">Voor reparaties komen we eerst vrijblijvend langs, zodat u een scherpe prijs krijgt.</p>
          <a href="#offerte" class="btn btn-vuur mt-6">Vraag een offerte aan</a>
        </div>
      </div>
    </section>

    <!-- Inspectie, stank en check-up -->
    <section id="inspectie" class="scroll-mt-20 bg-nacht py-16 text-white lg:py-24">
      <div class="wrap">
        <p class="kicker text-gloed">Inspectie en stank</p>
        <h2 class="mt-3 max-w-2xl text-3xl">Zien wat er in het riool gebeurt</h2>
        <div class="mt-12 grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <h3 class="text-2xl">Camera-inspectie</h3>
            <p class="mt-3 text-white/85">Een camera met een draaiende kop bekijkt de leiding van binnen, op aanslag, wortels, verzakking en breuken. Handig bij:</p>
            <ul class="mt-5 grid gap-x-6 gap-y-2 sm:grid-cols-2">
              {cameraWanneer.map((c) => <li class="border-l-2 border-gloed pl-3">{c}</li>)}
            </ul>
          </div>
          <div class="lg:col-span-4 lg:col-start-9">
            <h3 class="text-2xl">Rioollucht opsporen</h3>
            <p class="mt-3 text-white/85">Ruikt u riool in huis, soms wel en soms niet, of juist de hele tijd? Dan kan er een breuk zitten, of werkt een stankafsluiter niet meer goed.</p>
            <p class="mt-3 text-white/85">We persen het riool vol met onschadelijke rook. Waar de rook naar buiten komt, zit het lek. Na de reparatie controleren we opnieuw met rook.</p>
          </div>
        </div>

        <div class="mt-16 border-t border-white/15 pt-12">
          <h3 class="text-2xl">Riool check-up op maat</h3>
          <p class="mt-3 max-w-2xl text-white/85">Een controle van het hele stelsel, zodat gebreken vroeg worden gevonden.</p>
          <ol class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {checkup.map((s, i) => (
              <li>
                <span class="font-display text-[2.75rem] leading-none font-extrabold text-gloed tabular-nums" aria-hidden="true">0{i + 1}</span>
                <p class="mt-2 font-display text-xl font-bold">{s.naam}</p>
                <p class="mt-1 text-sm text-white/85">{s.tekst}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Herkennen van rioolproblemen -->
    <section class="wrap py-16 lg:py-24">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-7">
          <h2 class="text-3xl">Hoe herkent u een rioolprobleem?</h2>
          <ol class="mt-8 space-y-4">
            {signalen.map((s, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] items-baseline gap-2 text-lg">
                <span class="font-display text-xl font-extrabold text-vuur-donker tabular-nums" aria-hidden="true">{i + 1}.</span>{s}
              </li>
            ))}
          </ol>
          <p class="mt-8 text-ink-soft">Vaak zit de oorzaak in het riool zelf: grond die zakt bij de gevel, wortels die de buis kapotdrukken, een leiding die tegen afschot ligt of gebroken beugels.</p>
        </div>
        <div class="md:col-span-4 md:col-start-9">
          <div class="aspect-[16/9] overflow-hidden rounded-2xl md:aspect-square"><Foto src={put} alt="Ronde gietijzeren putdeksel met rooster in een bestrating van betonklinkers" sizes="(min-width: 768px) 360px, 100vw" /></div>
          <a href={site.whatsapp} class="btn btn-vuur mt-5 w-full"><Icoon naam="wa" />Stuur een WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- Werkgebied -->
    <section id="werkgebied" class="scroll-mt-20 bg-beton py-16 lg:py-20">
      <div class="wrap grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Werkgebied</h2>
          <p class="mt-4 text-ink-soft">Vanuit Nieuw-Lekkerland, onder meer in deze plaatsen. Voor particulieren, bedrijven, VVE's en zorginstellingen.</p>
        </div>
        <ul class="flex flex-wrap content-start gap-2 lg:col-span-8">
          {werkgebied.map((w) => <li class="rounded-lg bg-white px-3 py-1.5 text-sm font-bold ring-1 ring-line">{w}</li>)}
        </ul>
      </div>
    </section>

    <!-- Contact en offerte -->
    <section id="contact" class="scroll-mt-20 bg-nacht py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Verstopt? Laat het ons weten.</h2>
          <p class="mt-5 text-white/85">Bij een verstopping is een appje of telefoontje het snelst. Voor reparatie, aanleg of inspectie kunt u ook het formulier gebruiken.</p>
          <div class="mt-8 flex flex-col gap-3">
            <a href={site.whatsapp} class="btn btn-vuur"><Icoon naam="wa" />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line text-white"><Icoon naam="tel" /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <dl class="mt-10 space-y-4">
            <div><dt class="text-sm text-white/75">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-gloed decoration-2 underline-offset-4">{site.mail}</a></dd></div>
            <div><dt class="text-sm text-white/75">Adres</dt><dd>{site.straat}, {site.postcode} {site.plaats}</dd></div>
            <div><dt class="text-sm text-white/75">Bereikbaar</dt><dd>24 uur per dag, 7 dagen per week</dd></div>
          </dl>
        </div>

        <form id="offerte" class="scroll-mt-20 rounded-2xl bg-white p-6 text-nacht shadow-sm md:p-8 lg:col-span-6 lg:col-start-7" method="post" action="#">
          <h3 class="text-2xl">Offerte aanvragen</h3>
          <p class="mt-2 text-sm text-ink-soft">Vul uw gegevens in, dan nemen we zo snel mogelijk contact op.</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <label class="font-bold">Naam<input class="veld" name="naam" autocomplete="name" required /></label>
            <label class="font-bold">Telefoon<input class="veld" name="telefoon" type="tel" autocomplete="tel" required /></label>
            <label class="font-bold sm:col-span-2">Adres en plaats<input class="veld" name="adres" autocomplete="street-address" /></label>
            <label class="font-bold sm:col-span-2">Waar gaat het om?
              <select class="veld" name="probleem">
                <option>Reparatie of aanleg riolering</option>
                <option>Camera-inspectie</option>
                <option>Rioollucht opsporen</option>
                <option>Riool check-up</option>
                <option>Verstopping</option>
                <option>Iets anders</option>
              </select>
            </label>
            <label class="font-bold sm:col-span-2">Bericht<textarea class="veld min-h-32" name="bericht" rows="4"></textarea></label>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-xl bg-beton p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="font-bold whitespace-nowrap tabular-nums underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-bold break-all underline">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-vuur mt-6">Verstuur aanvraag</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
