---
import { site, url } from '../data/site';
---
<footer class="op-donker bg-nacht-diep text-kalk">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="label text-eendenei">Schildersbedrijf</p>
      <p class="mt-1 font-kop text-3xl font-extrabold tracking-[-0.03em]">Breedveld</p>
      <p class="mt-4 max-w-sm text-sm text-kalk/80">Schilderwerk, latex spuiten, behangwerk en glaszetten in {site.plaats} en omgeving.</p>
    </div>
    <div class="text-sm md:col-span-4">
      <p class="font-semibold">Contact</p>
      <p class="mt-3 text-kalk/80">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.mobielHref} class="underline-offset-4 hover:underline">{site.mobiel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline-offset-4 hover:underline">{site.mail}</a></p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="font-semibold">Gegevens</p>
      <p class="mt-3 text-kalk/80">KvK {site.kvk}</p>
      <p class="mt-3"><a href={url('privacy/')} class="underline underline-offset-4">Privacyverklaring</a></p>
    </div>
  </div>
  <div class="wrap border-t border-kalk/15 py-5 text-xs text-kalk/70">
    <p>De foto's op deze site zijn sfeerbeelden van Unsplash.</p>
  </div>
</footer>
