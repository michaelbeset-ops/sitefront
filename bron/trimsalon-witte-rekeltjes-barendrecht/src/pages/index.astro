  .polaroid { background: #fff; padding: .6rem .6rem 0; border-radius: .9rem; box-shadow: 0 30px 60px -20px #000a; }
  .polaroid figcaption { padding: .55rem .2rem .7rem; font-family: var(--font-kop); font-size: .875rem; font-weight: 600; color: var(--color-inkt); }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: .6rem; background: var(--color-ijs); }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  @media (min-width: 1024px) {
    .stappen li:not(:last-child)::after { content: ''; position: absolute; top: 1.75rem; left: 4.5rem; right: -1.5rem; border-top: 2px dashed #2447b340; }
  }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: .7rem; background: var(--color-ijs); font-size: .9375rem; font-weight: 600; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #d6dff3; }
  .keuze input:checked + span { background: var(--color-blauw); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-blauw); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: .75rem; border: 1.5px solid #141b2d33; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #141b2d66; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-blauw); }
  .veld::placeholder { color: #737a8b; }
</style>
