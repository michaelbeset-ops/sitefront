---
import { site, url, tijden, waAfspraak } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const diensten = ['Volledige trimbeurt', 'Wassen en föhnen', 'Puppybeurt', 'Plukken en strippen', 'Ontwollen', 'Knippen en scheren'];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <span class="merk-teken" aria-hidden="true"><Icoon naam="poot" class="h-5 w-5" /></span>
        <span><b>Van de Witte Rekeltjes</b><small>Hondentrimsalon</small></span>
      </a>
      <p class="mt-6 max-w-xs">Hondentrimsalon aan huis in Barendrecht. Volledige vachtverzorging door gediplomeerd hondentrimster {site.eigenaar}, voor elke hond.</p>
      <a href={waAfspraak} class="knop knop-blauw knop-klein mt-6"><Icoon naam="wa" />Afspraak maken</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-kop font-semibold text-licht">Behandelingen</p>
      <ul class="mt-4 space-y-2">
        {diensten.map((c) => <li><a href={h('behandelingen')} class="no-underline transition-colors hover:text-hemel">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-kop font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-hemel">{site.tel}</a></li>
        <li><a href={waAfspraak} class="no-underline transition-colors hover:text-hemel">WhatsApp</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.maps} class="no-underline transition-colors hover:text-hemel">Route plannen</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-kop font-semibold text-licht">Openingstijden</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Openingstijden</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-hemel">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-sm">Alleen op afspraak.</p>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-hemel">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw eigen website en uw Google-bedrijfsprofiel, ter illustratie. Reviews letterlijk van Google (stand 3 oktober 2026).</p>}
  </div>
</footer>
