---
import { site, url, waHoi, links } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="op-vilt bg-vilt text-nikkel">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Werkplaats voor basklarinet en saxofoon. Onderhoud, verkoop en verhuur.</p>
    </div>
    <div class="md:col-span-3">
      <p class="label text-wit">Webshop</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={links.saxofoons} class="link">Saxofoons</a></li>
        <li><a href={links.basklarinetten} class="link">Basklarinetten</a></li>
        <li><a href={links.mondstukken} class="link">Mondstukken</a></li>
        <li><a href={links.workshops} class="link">Workshops</a></li>
        <li><a href={links.retour} class="link">Retourneren</a></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="label text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link">WhatsApp</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="label text-wit">Werkplaats</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3">Ieder woensdag 10.00 tot 17.30 uur</p>
      <p class="mt-3"><a href={site.reviews} class="link">{site.google.score} op Google, {site.google.aantal} reviews</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam} · <a href={links.voorwaarden} class="no-underline hover:text-mos">Algemene voorwaarden</a></p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-mos">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten, prijzen en foto’s van basensax.nl en jullie Google-profiel. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
