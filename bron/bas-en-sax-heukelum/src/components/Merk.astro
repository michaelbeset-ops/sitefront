---
// Woordmerk naar hun logo (2024): ronde stempel met stippelring en de lijn van een basklarinet, nagetekend.
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = true } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 no-underline ${licht ? 'text-wit' : 'text-inkt'}`} aria-label="Bas en Sax, naar de startpagina">
  <svg viewBox="0 0 48 48" class="h-11 w-11 flex-none" aria-hidden="true" fill="none" stroke="currentColor">
    <circle cx="24" cy="24" r="22.2" stroke-width="2" />
    <circle cx="24" cy="24" r="17.6" stroke-width="1.6" stroke-dasharray="2.2 2.2" />
    <path d="M15.6 15.8c2.4-1 4.3-1.5 5.7-1.5 1.4 0 2 .9 2 2.7v15.3M23.3 32.3c0 2.2-1.2 3.4-3 3.4-1.1 0-1.8-.7-1.8-1.9" stroke-width="1.7" stroke-linecap="round" />
    <path d="M23.3 33.2c1.4-.3 2.4-1.6 2.8-3.8l.6-3.9" stroke-width="1.7" stroke-linecap="round" />
    <ellipse cx="28.4" cy="22.2" rx="2.6" ry="3.6" stroke-width="1.7" />
  </svg>
  <span class="font-kop text-[1.6rem] leading-none tracking-[.02em]">Bas en Sax</span>
</a>
