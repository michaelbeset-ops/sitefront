---
// Eigen detail: een regel uit een grepentabel (dicht = toongat dicht), zoals hun grepentabel voor basklarinet.
// Elke sectie een ander greepje. Puur decoratief.
interface Props { g: string; class?: string }
const { g, class: cls = '' } = Astro.props;
---
<div class={`grepen ${cls}`} aria-hidden="true">
  {[...g].map((c) => (c === '|' ? <b /> : <i class={c === 'x' ? 'd' : ''} />))}
</div>
