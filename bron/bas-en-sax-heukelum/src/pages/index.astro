---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Grepen from '../components/Grepen.astro';
import { site, links, werkplaatsen, prijzen, reviews, waHoi } from '../data/site';

import hero from '../assets/hero-adolphe-sax.jpg';
import bariton from '../assets/bariton-adolphe-sax.jpg';
import pierret from '../assets/pierret-revisie.jpg';
import martin from '../assets/martin-handcraft.jpg';
import selmer from '../assets/selmer-paris-1955.jpg';
import paperclip from '../assets/paperclip-contrabas.jpg';
import kast from '../assets/mondstukkenkast.jpg';
import nek from '../assets/basklarinet-nek.jpg';

const [gerco, michel] = reviews;
const instrumenten = ['altsaxofoon', 'tenorsaxofoon', 'sopraansaxofoon', 'baritonsaxofoon', 'basklarinet', 'klarinet', 'contra-altklarinet', 'contrabasklarinet'];
const vragen = [
  ['lekt', 'het instrument lekt'],
  ['stroef', 'de kleppen lopen stroef of zitten vast'],
  ['beurt', 'hij is toe aan een onderhoudsbeurt'],
  ['revisie', 'hij is toe aan een revisie'],
  ['mondstuk', 'ik zoek er een mondstuk bij'],
  ['huren', 'ik wil er een huren'],
  ['kopen', 'ik wil er een kopen'],
];
const remakes = ['Otto Link Masterlink, jaren 30', 'Brilhart Eboline, jaren 50', 'Dukoff Crystallite, jaren 70', 'Lawton metal, jaren 80'];
---
<Base title="Bas en Sax, werkplaats voor basklarinet en saxofoon in Heukelum" description="Onderhoud, verkoop en verhuur van saxofoons en (bas)klarinetten. Specialiteit: vintage saxofoons en basklarinetten. Ieder woensdag open in Heukelum.">
  <main id="inhoud">

    <!-- 1. Hero: de gravure van een bariton van Adolphe Sax op hun groene werkbank -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-vilt text-wit">
      <Kop />
      <Image src={hero} alt="Gravure op de beker van een baritonsaxofoon van Adolphe Sax, nummer 39254, op de groene werkbank" widths={[640, 960, 1400, 2016]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-y-0 right-0 -z-20 h-full w-full object-cover object-[58%_50%] lg:w-[74%] lg:object-[50%_55%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0d1f18b3_0%,#0d1f1820_22%,#0d1f1880_50%,#0d1f18f2_82%)] lg:bg-[linear-gradient(90deg,#0d1f18_0%,#0d1f18_26%,#0d1f18b3_40%,#0d1f1814_68%,#0d1f1833_100%)]"></div>
      <div class="wrap pb-24 pt-32 md:pb-20">
        <p class="text-sm font-medium tracking-[.06em] text-mos">Werkplaats voor basklarinet en saxofoon · Heukelum</p>
        <h1 class="mt-5 max-w-[17ch] text-[2.05rem] min-[400px]:text-[2.3rem] sm:text-hero">Voor liefhebbers van (bas)klarinet en saxofoon</h1>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-wit/90 md:text-xl">Onderhoud, verkoop en verhuur. Specialiteit: vintage saxofoons en basklarinetten.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={waHoi} class="knop knop-wit"><Icoon naam="wa" />App ons</a>
          <a href={site.telHref} class="knop knop-rand-wit num"><Icoon naam="tel" />{site.tel}</a>
        </div>
        <div class="mt-12 flex flex-wrap items-end justify-between gap-x-10 gap-y-3 border-t border-lijn pt-5 text-sm text-wit/80">
          <p data-status-wrap class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-mos"></span><span data-status>Ieder woensdag open, 10.00 tot 17.30 uur</span></p>
          <p class="hidden max-w-md sm:block md:text-right">Op de werkbank: bariton van Adolphe Sax, nummer 39254</p>
        </div>
      </div>
    </section>

    <!-- 2. De werkplaats: drie vakmensen, op woensdag in Heukelum -->
    <section id="werkplaats" class="py-20 md:py-[5.5rem]">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <figure class="rijs min-w-0 lg:col-span-7">
          <Image src={bariton} alt="Altsaxofoon van Adolphe Sax junior op de groene werkbank" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[3/2] w-full rounded-sm object-cover object-[70%_50%]" />
          <figcaption class="mt-3 text-sm text-grijs">Een Adolphe Sax junior alt van kort na 1900, op de werkbank voor restauratie en revisie.</figcaption>
        </figure>
        <div class="rijs min-w-0 lg:col-span-5" style="--d:.1s">
          <Grepen g="xxx|xoo" class="text-blad" />
          <h2 class="mt-6 text-4xl">Drie werkplaatsen, één adres op woensdag</h2>
          <p class="mt-6 text-lg text-grijs">Bas en Sax is een samenwerking van Klarisax in Rhenen, de Saxofoonchirurg in Boven-Leeuwen en Johan Jonker Saxofoons in Heukelum.</p>
          <dl class="mt-10 border-t border-lijn-licht">
            {werkplaatsen.map((w) => (
              <div class="grid gap-x-6 gap-y-1 border-b border-lijn-licht py-5 sm:grid-cols-[1fr_auto]">
                <dt class="font-semibold">{w.wie} <span class="font-normal text-grijs">· {w.naam}</span></dt>
                <dd class="num sm:row-span-2 sm:text-right"><a href={w.telHref} class="link">{w.tel}</a></dd>
                <dd class="text-sm text-grijs">{w.wat}, {w.adres}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-6 text-sm text-grijs">Op woensdag is Nader in Heukelum voor reparaties en Johan vaak voor verkoop en verhuur.</p>
        </div>
      </div>
    </section>

    <!-- 3. Onderhoud: de prijslijst zoals op hun site -->
    <section id="onderhoud" class="op-vilt bg-vilt text-papier">
      <figure class="relative">
        <Image src={pierret} alt="Een Pierret-tenor uit de jaren 30 uit elkaar voor een revisie: kleppen en polsters naast de body" widths={[640, 1000, 1500, 1943]} sizes="100vw" class="h-[56vw] max-h-[26rem] min-h-[16rem] w-full object-cover" />
        <figcaption class="wrap absolute inset-x-0 bottom-0 pb-4 text-sm text-wit/85 [text-shadow:0_1px_8px_#000a]">Revisie van een Pierret Model 6 uit de jaren 30</figcaption>
      </figure>
      <div class="wrap grid gap-14 py-20 md:py-[5.5rem] lg:grid-cols-12 lg:gap-16">
        <div class="rijs min-w-0 lg:col-span-5">
          <Grepen g="xxo|ooo" class="text-mos" />
          <h2 class="mt-6 text-4xl">Van kleine beurt tot complete revisie</h2>
          <p class="mt-6 text-lg text-nikkel">We doen praktisch alle onderhoud aan saxofoons en (bas)klarinetten. Controles en advies doen we meestal gratis.</p>
          <div class="mt-10 border-t border-lijn pt-8">
            <h3 class="text-2xl">Wil je het zelf leren?</h3>
            <p class="mt-3 text-nikkel">Workshop: reviseer je eigen saxofoon. Een dag van 10.00 tot circa 17.00 uur, op donderdag of vrijdag.</p>
            <ol class="mt-4 text-nikkel">
              <li class="regel !border-lijn"><span>Kleine onderhoudsbeurt</span><span class="stip !border-[#ffffff40]"></span><span class="num text-wit">€ 250</span></li>
              <li class="regel !border-lijn"><span>Mechanisch herstelwerk</span><span class="stip !border-[#ffffff40]"></span><span class="num text-wit">€ 250</span></li>
              <li class="regel !border-lijn"><span>Polsters vervangen en stellen</span><span class="stip !border-[#ffffff40]"></span><span class="num text-wit">€ 250</span></li>
            </ol>
            <a href={links.workshops} class="link mt-5 inline-block text-sm font-semibold text-wit">Leerdoelen en benodigdheden</a>
          </div>
        </div>
        <div class="rijs min-w-0 lg:col-span-7" style="--d:.1s">
          <div class="overflow-hidden rounded-sm bg-papier p-5 text-inkt sm:p-8 md:p-10">
            <table class="num w-full text-left text-[.8125rem] sm:text-base">
              <caption class="pb-6 text-left">
                <span class="block font-kop text-2xl">Prijslijst onderhoud</span>
                <span class="mt-1 block text-sm text-grijs">Indicatief, in euro, voor moderne instrumenten</span>
              </caption>
              <thead>
                <tr class="border-b-2 border-inkt text-xs uppercase tracking-[.08em] text-grijs">
                  <th scope="col" class="py-3 pr-2 font-semibold">Instrument</th>
                  <th scope="col" class="py-3 px-1 text-right font-semibold">Klein</th>
                  <th scope="col" class="py-3 px-1 text-right font-semibold">Groot</th>
                  <th scope="col" class="py-3 pl-1 text-right font-semibold">Revisie</th>
                </tr>
              </thead>
              <tbody>
                {prijzen.map(([i, k, g, r]) => (
                  <tr class="border-b border-lijn-licht">
                    <th scope="row" class="py-3.5 pr-2 font-medium">{i}</th>
                    <td class="py-3.5 px-1 text-right">{k}</td>
                    <td class="py-3.5 px-1 text-right">{g}</td>
                    <td class="py-3.5 pl-1 text-right font-semibold">{r}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-6 text-sm text-grijs">Exclusief extra handelingen, bij groot onderhoud en revisie ook exclusief materiaal. Een kunststof klarinet wordt niet geolied en is 20 euro goedkoper. Bij vintage saxofoons met rolled of gesoldeerde toongaten lopen de kosten vaak op.</p>
            <a href={links.onderhoud} class="link mt-5 inline-block text-sm font-semibold">Alles over onderhoud en extra handelingen</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Collectie: vintage saxofoons en basklarinetten -->
    <section id="collectie" class="py-20 md:py-[5.5rem]">
      <div class="wrap">
        <div class="rijs grid gap-8 md:grid-cols-12 md:items-end">
          <div class="md:col-span-7">
            <Grepen g="xoo|ooo" class="text-blad" />
            <h2 class="mt-6 text-4xl">Vintage saxen en basklarinetten, klaar om te spelen</h2>
          </div>
          <div class="md:col-span-5">
            <p class="text-lg text-grijs">Tweedehands instrumenten koop je met terugkoopgarantie en 14 dagen bedenktijd. Liever eerst proberen? Kom op woensdag langs.</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={links.saxofoons} class="knop knop-blad">Saxofoons</a>
              <a href={links.basklarinetten} class="knop knop-rand">Basklarinetten</a>
            </div>
          </div>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-12 md:gap-6">
          <a href={links.tenor} class="rijs group md:col-span-7 no-underline text-inkt">
            <div class="overflow-hidden rounded-sm"><Image src={martin} alt="Martin Handcraft tenorsaxofoon uit 1924, close-up van de onderbocht en kleppen" widths={[640, 1000, 1400]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" /></div>
            <p class="mt-3 flex items-baseline justify-between gap-4"><span class="font-semibold">Martin Handcraft tenor, 1924</span><span class="text-sm text-grijs">Tenorsaxofoons <Icoon naam="pijl" class="inline h-4 w-4" /></span></p>
          </a>
          <a href={links.selmer} class="rijs group md:col-span-5 no-underline text-inkt" style="--d:.1s">
            <div class="overflow-hidden rounded-sm"><Image src={selmer} alt="Selmer Paris basklarinet uit 1955, nikkelen nek en donker hout" widths={[480, 800, 1100]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[3/2] w-full object-cover md:aspect-[1/1] transition-transform duration-700 group-hover:scale-[1.03]" /></div>
            <p class="mt-3 flex items-baseline justify-between gap-4"><span class="font-semibold">Selmer Paris basklarinet, 1955</span><span class="text-sm text-grijs">Bekijken <Icoon naam="pijl" class="inline h-4 w-4" /></span></p>
          </a>
          <a href={links.paperclip} class="rijs group md:col-span-12 no-underline text-inkt">
            <div class="overflow-hidden rounded-sm bg-wit"><Image src={paperclip} alt="Metalen contrabasklarinet in paperclip-model" widths={[640, 1200, 2048]} sizes="100vw" class="aspect-[2.4/1] w-full object-cover transition-transform duration-700 group-hover:scale-[1.02] md:aspect-[3.6/1]" /></div>
            <p class="mt-3 flex items-baseline justify-between gap-4"><span class="font-semibold">Paperclip contrabasklarinet</span><span class="text-sm text-grijs">Bekijken <Icoon naam="pijl" class="inline h-4 w-4" /></span></p>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. Huren -->
    <section id="huren" class="op-vilt bg-vilt-2 text-papier">
      <div class="grid lg:grid-cols-2">
        <div class="relative min-h-[18rem] lg:min-h-full">
          <Image src={nek} alt="Basklarinet van Selmer Paris met nikkelen nek, op wit" widths={[640, 1000, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[30%_50%]" />
        </div>
        <div class="px-5 py-16 sm:px-10 md:px-16 md:py-20 lg:px-20">
          <div class="rijs max-w-xl">
            <Grepen g="ooo|ooo" class="text-mos" />
            <h2 class="mt-6 text-4xl">Huur eens een bariton</h2>
            <p class="mt-6 text-lg text-nikkel">We houden van experimenten. Huur een paar maanden een basklarinet, een vintage sax of een contra-altklarinet.</p>
            <ul class="mt-10 border-t border-lijn">
              <li class="flex items-baseline justify-between gap-4 border-b border-lijn py-4"><span>Studiesaxofoon</span><span class="num text-wit">vanaf € 25 per maand</span></li>
              <li class="flex items-baseline justify-between gap-4 border-b border-lijn py-4"><span>Studiebasklarinet</span><span class="num text-wit">vanaf € 30 per maand</span></li>
              <li class="flex items-baseline justify-between gap-4 border-b border-lijn py-4"><span>Klarinet</span><span class="num text-wit">vanaf € 20 per maand</span></li>
            </ul>
            <p class="mt-8 text-nikkel">Huren kan vanaf één maand. Koop je het huurinstrument, dan krijg je de eerste 6 maanden huur terug.</p>
            <a href={links.huren} class="link mt-6 inline-block font-semibold text-wit">Huurprijs, borg en huurkoop</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Mondstukken en workshops -->
    <section id="mondstukken" class="py-20 md:py-[5.5rem]">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="rijs min-w-0 lg:col-span-5">
          <Grepen g="xxx|xxx" class="text-blad" />
          <h2 class="mt-6 text-4xl">Legendarische mondstukken, opnieuw gemaakt</h2>
          <p class="mt-6 text-lg text-grijs">We maken remakes van legendarische mondstukken die niet meer gemaakt worden.</p>
          <ul class="mt-8 border-t border-lijn-licht">
            {remakes.map((r) => <li class="border-b border-lijn-licht py-3">{r}</li>)}
          </ul>
          <p class="mt-6 text-sm text-grijs">Heb je zelf een interessante legende? Kom ermee langs, dan meten we hem in een kwartiertje op.</p>
          <a href={links.mondstukken} class="knop knop-blad mt-8">Mondstukken in de webshop</a>
        </div>
        <div class="lg:col-span-7">
          <figure class="rijs">
            <Image src={kast} alt="De mondstukkenkast met vakjes vol gebruikte en vintage mondstukken" widths={[640, 1000, 1400]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">De mondstukkenkast: van sopranino tot bassax en van klarinet tot contrabasklarinet</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 7. Werkbon (wow), reviews en bezoek -->
    <section id="werkbon" class="op-vilt bg-vilt text-papier">
      <div class="wrap grid gap-16 py-20 md:py-[5.5rem] lg:grid-cols-12">
        <div class="rijs min-w-0 lg:col-span-7">
          <Grepen g="xox|xoo" class="text-mos" />
          <h2 class="mt-6 text-4xl">Wat heb je?</h2>
          <p class="mt-4 text-nikkel">Vul je werkbon in. Hij gaat als bericht naar WhatsApp, met jouw instrument erin.</p>
          <form class="mt-10 rounded-sm border border-lijn p-6 sm:p-8 md:p-10" data-werkbon>
            <p class="text-xl leading-[2] md:text-[1.6rem]">
              Het gaat om een
              <label class="sr-only" for="wb-inst">Instrument</label>
              <select id="wb-inst" class="vak" data-v="inst">{instrumenten.map((i) => <option>{i}</option>)}</select>,
              merk of type
              <label class="sr-only" for="wb-merk">Merk of type</label>
              <input id="wb-merk" class="vak" data-v="merk" type="text" placeholder="bijv. Selmer" autocomplete="off" />,
              en
              <label class="sr-only" for="wb-vraag">Wat is er aan de hand</label>
              <select id="wb-vraag" class="vak" data-v="vraag">{vragen.map(([v, t]) => <option value={v}>{t}</option>)}</select>
            </p>
            <label class="mt-6 flex cursor-pointer items-center gap-3 text-nikkel">
              <input type="checkbox" class="h-5 w-5 accent-[#9fd0b6]" data-v="woensdag" checked />
              Ik kom het liefst op woensdag langs in Heukelum
            </label>
            <div class="mt-8 border-t border-lijn pt-6">
              <p class="label text-nikkel">Je bericht</p>
              <p class="mt-3 text-wit/90" data-bericht aria-live="polite"></p>
            </div>
            <a href={waHoi} class="knop knop-wit mt-8" data-stuur><Icoon naam="wa" />Stuur via WhatsApp</a>
          </form>
        </div>

        <div class="rijs grid content-start gap-12 lg:col-span-5" style="--d:.1s">
          <div>
            <p class="font-kop text-3xl leading-tight">Molenstraat 6, Heukelum</p>
            <p class="mt-4 text-nikkel">Ieder woensdag open van 10.00 tot 17.30 uur. Andere dagen op afspraak.</p>
            <p data-status-wrap class="mt-4 flex items-center gap-2.5 text-sm text-wit"><span class="h-2 w-2 rounded-full bg-mos"></span><span data-status>Ieder woensdag open</span></p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href={site.maps} class="knop knop-rand-wit"><Icoon naam="pin" />Route</a>
              <a href={site.telHref} class="knop knop-rand-wit num"><Icoon naam="tel" />{site.tel}</a>
            </div>
          </div>
          {[michel, gerco].map((r) => (
            <blockquote class="border-t border-lijn pt-6">
              <p class="text-nikkel">“{r.tekst}”</p>
              <footer class="mt-3 flex items-center gap-2 text-sm text-wit"><Icoon naam="g" class="h-4 w-4" />{r.naam}, {r.wanneer}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  const f = document.querySelector<HTMLFormElement>('[data-werkbon]');
  if (f) {
    const v = (n: string) => f.querySelector<HTMLInputElement & HTMLSelectElement>(`[data-v="${n}"]`)!;
    const zin: Record<string, string> = {
      lekt: 'Het instrument lekt.',
      stroef: 'De kleppen lopen stroef of zitten vast.',
      beurt: 'Hij is toe aan een onderhoudsbeurt.',
      revisie: 'Hij is toe aan een revisie.',
      mondstuk: 'Ik zoek er een mondstuk bij.',
      huren: 'Ik wil er een huren.',
      kopen: 'Ik wil er een kopen.',
    };
    const bouw = () => {
      const merk = v('merk').value.trim();
      const t = `Hallo Bas en Sax, het gaat om een ${v('inst').value}${merk ? ` (${merk})` : ''}. ${zin[v('vraag').value]}${v('woensdag').checked ? ' Ik kom graag op woensdag langs in Heukelum.' : ''}`;
      f.querySelector('[data-bericht]')!.textContent = t;
      f.querySelector<HTMLAnchorElement>('[data-stuur]')!.href = `${site.wa}?text=${encodeURIComponent(t)}`;
    };
    f.addEventListener('input', bouw); f.addEventListener('change', bouw);
    f.addEventListener('submit', (e) => e.preventDefault());
    bouw();
  }
</script>
