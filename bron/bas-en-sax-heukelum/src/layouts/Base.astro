---
import '../styles/global.css';
import kopUrl from '@fontsource/limelight/files/limelight-latin-400-normal.woff2?url';
import sansUrl from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import { site, url } from '../data/site';
import Balk from '../components/Balk.astro';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={kopUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-14 md:pb-0">
    {site.voorstel && (
      <div class="relative z-50 bg-papier text-vilt">
        <p class="wrap py-2 text-xs font-medium leading-snug" style="font-family: system-ui, sans-serif">
          Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website.{" "}
          <a href="https://www.sitefront.nl" class="font-bold underline underline-offset-2">sitefront.nl</a>
        </p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-sm focus:bg-papier focus:px-4 focus:py-2 focus:text-vilt">Naar de inhoud</a>
    <slot />
    <Balk />
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.rijs').forEach((el) => io.observe(el));

      // Ieder woensdag 10.00 tot 17.30 uur (eigen site). Nederlandse tijd.
      const nu = new Date();
      const deel = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', ...o }).format(nu);
      const dag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(deel({ weekday: 'short' }));
      const min = Number(deel({ hour: '2-digit', hourCycle: 'h23' })) * 60 + Number(deel({ minute: '2-digit' }));
      let tekst = ''; let open = false;
      if (dag === 3 && min >= 600 && min < 1050) { open = true; tekst = 'Nu open, tot 17.30 uur'; }
      else if (dag === 3 && min < 600) tekst = 'Vandaag open vanaf 10.00 uur';
      else if (dag === 2) tekst = 'Morgen open, 10.00 tot 17.30 uur';
      else tekst = 'Gesloten, woensdag weer open vanaf 10.00 uur';
      document.querySelectorAll<HTMLElement>('[data-status]').forEach((el) => { el.textContent = tekst; el.closest('[data-status-wrap]')?.setAttribute('data-open', String(open)); });
    </script>
  </body>
</html>
