---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-bord text-krijt-zacht">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk licht />
      <p class="mt-6 max-w-xs">Kaas, noten en zuidvruchten, verkocht met passie en plezier. Sinds 2015 aan de Walstraat in Vlissingen.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-krijt">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1"><a href={site.facebook} class="link link-licht">Facebook</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-3 md:col-start-10">
      <p class="font-bold text-krijt">Open</p>
      <ul class="mt-3 space-y-1">
        {tijden.filter((t) => t.open).map((t) => <li class="flex justify-between gap-4"><span>{t.naam}</span><span class="num whitespace-nowrap">{t.open} - {t.dicht}</span></li>)}
        <li class="flex justify-between gap-4"><span>Zo en ma</span><span>gesloten</span></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto’s van jullie eigen Facebook en Google-bedrijfsprofiel. Assortiment uit jullie eigen website (2022) en Facebook. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
