---
// Wordmark "Duikelman" met de regel "Kookgereedschap" (zo noemt de winkel zich op de contactpagina),
// en als beeldmerk een koperen pan van bovenaf.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const koper = licht ? '#d9895a' : '#a8532c';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg viewBox="0 0 40 28" class="h-7 w-10 flex-none" aria-hidden="true">
    <circle cx="14" cy="14" r="12" fill="none" stroke={koper} stroke-width="3" />
    <circle cx="14" cy="14" r="6.5" fill={koper} />
    <rect x="25" y="11.5" width="14" height="5" rx="2.5" fill={koper} />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.6rem] leading-[0.95] font-bold tracking-[-0.02em]">Duikelman</span>
    <span class={`mt-1 text-[0.6875rem] font-bold uppercase whitespace-nowrap tracking-[0.22em] ${licht ? 'text-zilver' : 'text-ink-soft'}`}>Kookgereedschap</span>
  </span>
</span>
