---
import { site, url, icoon, winkels } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const home = url('');
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-papier/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={home} class="text-ink no-underline"><Logo /><span class="sr-only"> (naar de homepage)</span></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-base font-semibold">
          <li><a href={`${home}#assortiment`} class="no-underline transition-colors hover:text-roest">Assortiment</a></li>
          <li><a href={`${home}#fornuizen`} class="no-underline transition-colors hover:text-roest">Fornuizen</a></li>
          <li><a href={`${home}#winkelwijzer`} class="no-underline transition-colors hover:text-roest">Winkelwijzer</a></li>
          <li><a href={`${home}#verhuur`} class="no-underline transition-colors hover:text-roest">Verhuur</a></li>
          <li><a href={`${home}#contact`} class="no-underline transition-colors hover:text-roest">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-donker !gap-2 !px-3.5 !py-2.5 whitespace-nowrap sm:!px-4"><Fragment set:html={icoon.tel} /><span class="sr-only sm:not-sr-only num">{site.tel}</span><span class="sm:hidden">Bel</span></a>
    </div>
  </header>
) : (
  <footer class="donker bg-antraciet py-14 text-zilver">
    <div class="wrap grid gap-10 text-sm md:grid-cols-12">
      <div class="md:col-span-4">
        <span class="text-white"><Logo licht /></span>
        <p class="mt-5">{site.straat}<br />{site.postcode} {site.plaats}</p>
        <p class="mt-3"><a href={site.telHref} class="num underline underline-offset-2">T {site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
      </div>
      <div class="md:col-span-5">
        <p class="kicker text-koperlicht">Ook in De Pijp</p>
        <ul class="mt-3 space-y-1.5">
          {winkels.slice(1).map((w) => <li><span class="text-white">{w.naam}</span>, {w.straat}</li>)}
        </ul>
      </div>
      <p class="md:col-span-3 md:text-right">KvK <span class="text-xs">{site.kvk}</span><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 text-xs text-zilver">Sfeerfoto's via Unsplash en productfoto's van de huidige website, ter illustratie. Bij oplevering vervangen we ze door nieuwe eigen foto's.</p>}
  </footer>
)}
