---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tarieven, route } from '../data/site';
import hero from '../assets/hero.jpg';
import mand from '../assets/mand.jpg';
import kat from '../assets/kat.jpg';
import spelen from '../assets/spelen.jpg';
---
<Base
  title={`${site.kort} | Dierenpension voor honden en katten, dagopvang`}
  description="Dierenpension voor honden en katten in Sliedrecht, sinds 1989. Dagopvang voor honden, privékamer voor katten, 24 uur per dag een medewerker aanwezig. Tarieven 2026 en reserveren."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Mededelingen van de oude homepage, als rustige strook boven de hero. -->
    <aside aria-label="Mededeling" class="border-b border-line bg-oker-vlak">
      <div class="wrap grid gap-2 py-3 text-sm md:grid-cols-12 md:gap-6">
        <p class="text-xs font-extrabold uppercase tracking-[0.12em] md:col-span-2 md:pt-0.5">Mededeling</p>
        <ul class="grid gap-1 md:col-span-10 md:grid-cols-2 md:gap-6">
          <li><strong>Geen honden meer van <span class="whitespace-nowrap">17 t/m 24 oktober.</span></strong></li>
          <li>Per 1 januari 2026 nemen wij minder honden aan voor de vakantieopvang. Reserveringen gaan op volgorde van binnenkomst. Dagopvang en kattenopvang blijven hetzelfde.</li>
        </ul>
      </div>
    </aside>

    <!-- Hero: tekst links, foto rechts die tot de rand doorloopt. -->
    <section class="relative overflow-hidden">
      <div class="wrap grid gap-10 pb-14 pt-10 lg:grid-cols-12 lg:gap-8 lg:pb-20 lg:pt-16">
        <div class="lg:col-span-6 lg:pr-4">
          <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-weide">Dierenpension in Sliedrecht, sinds 1989</p>
          <h1 class="mt-4 text-4xl">Uw hond of kat logeert bij ons terwijl u weg bent</h1>
          <p class="mt-6 max-w-xl text-lg text-ink-soft">Voor als u zelf op vakantie gaat, of als u tijdelijk even niet voor uw dier kunt zorgen. Honden en katten, en overdag dagopvang voor honden.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#reserveren" class="btn btn-weide">Reservering aanvragen</a>
            <a href={site.telHref} class="btn btn-line">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
          <dl class="mt-10 grid grid-cols-1 gap-x-8 gap-y-4 border-t border-line pt-6 sm:grid-cols-3">
            <div><dt class="text-xs font-bold uppercase tracking-[0.1em] text-ink-soft">Dag en nacht</dt><dd class="mt-1 font-bold">24 uur per dag een medewerker aanwezig</dd></div>
            <div><dt class="text-xs font-bold uppercase tracking-[0.1em] text-ink-soft">Google</dt><dd class="mt-1 font-bold"><span class="tabular-nums">{site.google.score}</span> uit 5, <span class="whitespace-nowrap">{site.google.aantal} reviews</span></dd></div>
            <div><dt class="text-xs font-bold uppercase tracking-[0.1em] text-ink-soft">Ligging</dt><dd class="mt-1 font-bold">2 minuten van de A15, afrit Sliedrecht-Oost</dd></div>
          </dl>
        </div>
        <div class="relative lg:col-span-6">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:absolute lg:inset-y-0 lg:left-0 lg:-right-[max(2rem,calc((100vw-74rem)/2+2rem))] lg:aspect-auto lg:rounded-r-none">
            <Foto src={hero} alt="Drie honden rennen samen over een grasveld, met een hek en gebouwen op de achtergrond" hero sizes="(min-width: 1024px) 50vw, 100vw" />
          </div>
        </div>
      </div>
    </section>

    <!-- Tarieven: regels links, prijslijst rechts als rustige tabel. -->
    <section id="tarieven" class="scroll-mt-20 border-t border-line bg-room py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Tarieven 2026</h2>
          <p class="mt-4 text-ink-soft">Prijzen per dag, geldig vanaf 1 januari 2026.</p>
          <ul class="mt-8 space-y-4 text-sm">
            <li class="border-l-2 border-weide pl-4">De dag van brengen en de dag van halen worden ieder apart berekend.</li>
            <li class="border-l-2 border-weide pl-4">Reserveringskosten: <span class="whitespace-nowrap tabular-nums font-bold">€ 5,00</span> per reservering.</li>
            <li class="border-l-2 border-weide pl-4">Meerdere honden of katten van dezelfde eigenaar: vanaf het tweede dier <strong>10% korting</strong> op het goedkoopste dier. Niet voor dagopvanghonden.</li>
            <li class="border-l-2 border-weide pl-4">Eigen voer meenemen mag, maar gaat niet van de pensionprijs af. De gangbare merken zijn hier altijd aanwezig.</li>
            <li class="border-l-2 border-weide pl-4">Haalt u uw dier eerder op dan afgesproken, dan krijgt u geen geld terug en wordt er niets verrekend.</li>
          </ul>
        </div>

        <div class="lg:col-span-7 lg:col-start-6">
          <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
            {tarieven.map((t) => (
              <div>
                <h3 class="border-b-2 border-ink pb-2 text-xl">{t.groep}</h3>
                <dl class="divide-y divide-line">
                  {t.regels.map((r) => (
                    <div class="flex items-baseline justify-between gap-4 py-3">
                      <dt>{r.naam}{r.noot && <span class="block text-sm text-ink-soft">{r.noot}</span>}</dt>
                      <dd class="whitespace-nowrap font-bold tabular-nums">{r.prijs}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>

          <div class="op-donker mt-10 grid gap-6 rounded-xl bg-weide-deep p-6 text-white sm:grid-cols-5 md:p-8">
            <div class="sm:col-span-3">
              <h3 class="text-xl text-oker">Toeslag hoogseizoen</h3>
              <p class="mt-2 text-white/85">Juli en augustus, en van 20 december t/m 7 januari. Per dier, per dag bovenop het tarief.</p>
            </div>
            <dl class="grid content-start gap-2 sm:col-span-2">
              <div class="flex justify-between gap-4 border-b border-white/20 pb-2"><dt>Hond</dt><dd class="whitespace-nowrap font-bold tabular-nums">+ € 3,00</dd></div>
              <div class="flex justify-between gap-4 border-b border-white/20 pb-2"><dt>Kat</dt><dd class="whitespace-nowrap font-bold tabular-nums">+ € 2,00</dd></div>
              <div class="flex justify-between gap-4"><dt>Privékamer kat</dt><dd class="whitespace-nowrap font-bold tabular-nums">+ € 10,00</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Katten: brede foto met tekstblok dat half overlapt. -->
    <section id="katten" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12">
        <div class="aspect-[3/2] overflow-hidden rounded-xl lg:col-span-7">
          <Foto src={kat} alt="Gestreepte kat die opgerold ligt te slapen op een houten vloer" sizes="(min-width: 1024px) 640px, 100vw" />
        </div>
        <div class="lg:col-span-5 lg:-ml-24 lg:rounded-xl lg:bg-haver lg:p-10 lg:shadow-sm lg:ring-1 lg:ring-line">
          <h2 class="text-3xl">Een eigen kamer voor uw katten</h2>
          <p class="mt-5 text-ink-soft">Steeds meer mensen willen hun katten liever samen en apart onderbrengen. Daarom kunt u een kamer reserveren voor de katten uit één gezin.</p>
          <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-line pt-5">
            <div><dt class="text-sm text-ink-soft">Per kamer, per dag</dt><dd class="font-display text-2xl font-semibold tabular-nums whitespace-nowrap">€ 65,00</dd></div>
            <div><dt class="text-sm text-ink-soft">Maximaal</dt><dd class="font-display text-2xl font-semibold">5 katten</dd></div>
          </dl>
          <p class="mt-4 text-sm text-ink-soft">Exclusief de toeslag van <span class="whitespace-nowrap tabular-nums">€ 10,00</span> per dag in het hoogseizoen. Een losse kat logeert voor <span class="whitespace-nowrap tabular-nums">€ 13,00</span> per dag.</p>
        </div>
      </div>
    </section>

    <!-- Dagopvang: donkergroen, stappen als genummerde lijst. -->
    <section id="dagopvang" class="op-donker scroll-mt-20 bg-weide-deep py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-oker">Dagopvang voor honden</p>
          <h2 class="mt-3 text-3xl">Wekelijks oppas nodig voor uw hond?</h2>
          <p class="mt-5 text-white/85">Het dagopvangtarief is beduidend lager dan een pensiondag, en zelfs goedkoper dan een uitlaatservice. Uw hond heeft de hele dag gezelschap van soortgenoten en de dierverzorgers, en draait mee in het programma van de pensionhonden. Hij wordt een paar keer per dag uitgelaten en krijgt eventueel eten op een tijdstip dat u aangeeft.</p>
          <div class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
            <p><span class="block text-sm text-white/75">Per dag</span><span class="font-display text-3xl font-semibold tabular-nums whitespace-nowrap">€ 15,00</span></p>
            <p><span class="block text-sm text-white/75">Solitair, per dag</span><span class="font-display text-3xl font-semibold tabular-nums whitespace-nowrap">€ 18,00</span></p>
          </div>
          <div class="mt-8 aspect-[3/2] overflow-hidden rounded-xl">
            <Foto src={spelen} alt="Twee golden retrievers in het gras, de een met een gele bal in de bek" sizes="(min-width: 1024px) 440px, 100vw" />
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <h3 class="text-2xl">Hoe het werkt</h3>
          <ol class="mt-6 space-y-0">
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-white/20 py-5">
              <span class="font-display text-2xl text-oker">1</span>
              <p>U krijgt van ons een persoonlijke tag. Daarmee komt u 7 dagen per week zelf het pension in.</p>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-white/20 py-5">
              <span class="font-display text-2xl text-oker">2</span>
              <p>U brengt en haalt uw hond op het tijdstip dat u het beste uitkomt.</p>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-white/20 py-5">
              <span class="font-display text-2xl text-oker">3</span>
              <p>U betaalt alleen de dagen dat uw hond echt in het pension is geweest.</p>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-y border-white/20 py-5">
              <span class="font-display text-2xl text-oker">4</span>
              <p>Voor een tag komt uw hond gemiddeld minimaal 2 keer per week naar de dagopvang.</p>
            </li>
          </ol>
          <p class="mt-8 text-white/85">Het pension ligt op 2 minuten van de afrit Sliedrecht-Oost aan de A15. Interesse? Maak geheel vrijblijvend een afspraak om het een en ander te bespreken.</p>
          <a href={site.telHref} class="btn btn-line mt-6">Afspraak maken: <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
        </div>
      </div>
    </section>

    <!-- Halen, brengen, rondleiding: twee tijdvakken als klok, met regels ernaast. -->
    <section id="halen-brengen" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-3xl">Halen en brengen</h2>
          <p class="mt-4 text-ink-soft">7 dagen per week, op twee vaste momenten.</p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl bg-room p-6 shadow-sm ring-1 ring-line">
              <p class="text-sm font-bold uppercase tracking-[0.1em] text-ink-soft">'s Ochtends</p>
              <p class="mt-2 font-display text-2xl font-semibold tabular-nums"><span class="whitespace-nowrap">10.00</span> tot <span class="whitespace-nowrap">11.00</span></p>
            </div>
            <div class="rounded-xl bg-room p-6 shadow-sm ring-1 ring-line">
              <p class="text-sm font-bold uppercase tracking-[0.1em] text-ink-soft">'s Middags</p>
              <p class="mt-2 font-display text-2xl font-semibold tabular-nums"><span class="whitespace-nowrap">17.00</span> tot <span class="whitespace-nowrap">18.00</span></p>
            </div>
          </div>
          <div class="mt-10 grid gap-8 sm:grid-cols-2">
            <div>
              <h3 class="text-xl">Rondleiding</h3>
              <p class="mt-2 text-ink-soft">Een rondleiding door het pension kan alleen op afspraak, en alleen op zaterdagochtend. In de schoolvakanties geven we geen rondleidingen.</p>
            </div>
            <div>
              <h3 class="text-xl">Altijd iemand in de buurt</h3>
              <p class="mt-2 text-ink-soft">Er is 24 uur per dag een van onze medewerkers aanwezig. Indien nodig kunnen we direct een beroep doen op een gediplomeerde dierenartsassistent.</p>
            </div>
          </div>
          <p class="mt-8 rounded-lg bg-stro px-5 py-4 text-sm">Wij vangen alleen honden en katten op. Voor vogels, konijnen en knaagdieren is geen opvang mogelijk.</p>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <div class="aspect-[4/5] overflow-hidden rounded-xl lg:mt-16">
            <Foto src={mand} alt="Twee bruine honden liggen opgekruld samen in een grijze hondenmand" sizes="(min-width: 1024px) 380px, 100vw" />
          </div>
        </div>
      </div>
    </section>

    <!-- Trimsalon: smalle strook, eigen ondernemer in het pension. -->
    <section id="trimsalon" class="scroll-mt-20 border-y border-line bg-stro py-12 lg:py-16">
      <div class="wrap grid gap-6 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Trimsalon in het pension</h2>
        </div>
        <p class="lg:col-span-5">Sinds 1 september 2025 zit trimsalon Scooby Doo in het pension. Trimster Denise Kloppert heeft haar salon verplaatst van Papendrecht naar Sliedrecht. Afspraken maakt u rechtstreeks met Denise.</p>
        <div class="lg:col-span-3 lg:text-right">
          <a href="tel:+31611199260" class="btn btn-weide">Bel Denise <span class="whitespace-nowrap tabular-nums">06 111 992 60</span></a>
          <p class="mt-3 text-sm"><a href="https://www.scoobydoopapendrecht.nl" rel="noopener" class="underline underline-offset-2">scoobydoopapendrecht.nl</a></p>
        </div>
      </div>
    </section>

    <!-- Reserveren: formulier met de velden van de oude site. -->
    <section id="reserveren" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Reservering aanvragen</h2>
          <p class="mt-4 text-ink-soft">Reserveringen behandelen we op volgorde van binnenkomst.</p>
          <p class="mt-4 text-ink-soft">Liever bellen? Dat kan op <a href={site.telHref} class="font-bold text-ink underline underline-offset-2 whitespace-nowrap">{site.tel}</a>.</p>
          <p class="mt-4 text-sm text-ink-soft">Reserveringskosten <span class="whitespace-nowrap tabular-nums">€ 5,00</span> per reservering.</p>
        </div>
        <form class="rounded-xl bg-room p-5 shadow-sm ring-1 ring-line sm:p-8 lg:col-span-8" method="post" onsubmit="return false">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block sm:col-span-2"><span class="label">Naam</span><input class="veld" name="naam" autocomplete="name" required /></label>
            <label class="block"><span class="label">Telefoon</span><input class="veld" type="tel" name="telefoon" autocomplete="tel" required /></label>
            <label class="block"><span class="label">E-mail</span><input class="veld" type="email" name="email" autocomplete="email" required /></label>
            <label class="block"><span class="label">Soort opvang</span>
              <select class="veld" name="soort">
                <option>Kleine hond</option>
                <option>Middelgrote hond</option>
                <option>Grote hond</option>
                <option>Hond solitair</option>
                <option>Kat</option>
                <option>Privékamer kat</option>
                <option>Dagopvang hond</option>
              </select>
            </label>
            <label class="block"><span class="label">Aantal dieren</span><input class="veld" type="number" name="aantal" min="1" max="10" value="1" inputmode="numeric" /></label>
            <label class="block sm:col-span-2"><span class="label">Naam, ras en grootte van uw dier(en)</span><input class="veld" name="dieren" /></label>
            <label class="block"><span class="label">Brengdatum</span><input class="veld" type="date" name="breng" required /></label>
            <label class="block"><span class="label">Haaldatum</span><input class="veld" type="date" name="haal" required /></label>
            <label class="block sm:col-span-2"><span class="label">Opmerking</span><textarea class="veld min-h-28" name="opmerking" rows="4"></textarea></label>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg bg-oker-vlak px-5 py-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="font-bold underline whitespace-nowrap">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-bold underline break-all">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-weide mt-6">Reservering versturen</button>
          )}
        </form>
      </div>
    </section>

    <!-- Route: twee richtingen, uitklapbaar. -->
    <section id="route" class="scroll-mt-20 border-t border-line bg-room py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Route</h2>
          <p class="mt-4 text-ink-soft">Het pension ligt op industrieterrein N.O. Kwadrant, 2 minuten van de A15. Het terrein is afgesloten met een hek; meld u bij de intercom.</p>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Open in Google Maps</a>
        </div>
        <div class="divide-y divide-line border-y border-line lg:col-span-7 lg:col-start-6">
          {route.map((r, i) => (
            <details class="group" open={i === 0}>
              <summary class="flex items-center justify-between gap-4 py-5">
                <h3 class="text-xl">{r.van}</h3>
                <span class="pijl grid size-9 shrink-0 place-items-center rounded-full bg-weide text-white" aria-hidden="true">
                  <svg viewBox="0 0 16 16" class="size-4"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" fill="none" /></svg>
                </span>
              </summary>
              <ol class="mb-6 space-y-3">
                {r.stappen.map((s, n) => (
                  <li class="grid grid-cols-[2rem_1fr] gap-3"><span class="font-bold tabular-nums text-weide">{n + 1}.</span><span>{s}</span></li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="op-donker scroll-mt-20 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Contact</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
        </div>
        <dl class="grid content-start gap-5 text-lg lg:col-span-6 lg:col-start-7">
          <div><dt class="text-sm text-white/75">Telefoon</dt><dd><a href={site.telHref} class="font-display text-3xl font-semibold whitespace-nowrap tabular-nums underline decoration-oker decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-white/75">Mobiel, alleen voor noodgevallen</dt><dd><a href={site.mobielHref} class="whitespace-nowrap tabular-nums underline decoration-oker decoration-2 underline-offset-4">{site.mobiel}</a><span class="block text-base text-white/80">In geval van nood zijn we 24 uur per dag telefonisch bereikbaar.</span></dd></div>
          <div><dt class="text-sm text-white/75">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-oker decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-white/75">Halen en brengen</dt><dd>7 dagen per week, <span class="whitespace-nowrap tabular-nums">10.00 tot 11.00</span> en <span class="whitespace-nowrap tabular-nums">17.00 tot 18.00</span></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
