---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-haver/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="flex flex-col leading-none text-ink no-underline">
        <span class="text-[0.625rem] font-extrabold uppercase tracking-[0.06em] sm:text-[0.6875rem] sm:tracking-[0.14em] text-ink-soft">Dierenverzorgingscentrum</span>
        <span class="mt-1 font-display text-xl font-semibold tracking-[-0.02em] sm:text-2xl">Sliedrecht</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-6 text-sm font-bold">
          <li><a href="#tarieven" class="no-underline transition-colors hover:text-weide">Tarieven</a></li>
          <li><a href="#katten" class="no-underline transition-colors hover:text-weide">Katten</a></li>
          <li><a href="#dagopvang" class="no-underline transition-colors hover:text-weide">Dagopvang</a></li>
          <li><a href="#trimsalon" class="no-underline transition-colors hover:text-weide">Trimsalon</a></li>
          <li><a href="#route" class="no-underline transition-colors hover:text-weide">Route</a></li>
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a href={site.telHref} class="btn btn-line hidden !px-4 !py-2 text-sm sm:inline-flex">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
        <a href="#reserveren" class="btn btn-weide !px-4 !py-2 text-sm">Reserveren</a>
      </div>
    </div>
  </header>
) : (
  <footer class="op-donker bg-ink py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg font-semibold text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK <span class="text-white/70">[[AANLEVEREN: KvK-nummer]]</span></p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
