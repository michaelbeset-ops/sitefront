<script>
  // Tabs voor de tarieven (pijltjestoetsen werken ook), en de opleidingskaarten openen het juiste tabblad.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const kies = (id: string, focus = false) => {
    tabs.forEach((t) => {
      const aan = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(aan));
      t.tabIndex = aan ? 0 : -1;
      if (aan && focus) t.focus();
    });
    document.querySelectorAll<HTMLElement>('[data-paneel]').forEach((p) => { p.hidden = p.dataset.paneel !== id; });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => kies(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      kies(n.dataset.tab!, true);
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-kies]').forEach((a) => a.addEventListener('click', () => kies(a.dataset.kies!)));
</script>

