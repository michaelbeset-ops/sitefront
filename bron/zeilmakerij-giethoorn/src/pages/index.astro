---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, mailMet, tijden } from '../data/site';
import meeuw from '../assets/kap-meeuw-duo.jpg';
import kapRood from '../assets/eigen-kap-rood.jpg';
import kapBlauw from '../assets/eigen-kap-blauw.jpg';
import veranda from '../assets/eigen-veranda.jpg';
import sloep from '../assets/eigen-sloep.jpg';
import cabrio from '../assets/eigen-cabriokap.jpg';
import loods from '../assets/eigen-loods.jpg';

// Letterlijk hun eigen lijsten (welkomstpagina en de Duitse pagina).
const nl = ['Sloep- en kruiserkappen', 'Cabrioletkappen', 'Sprayhoods', 'Bootzeilen', 'Dekkleden', 'Hoezen en stofferingen', 'Verandazeilen', 'Voortenten en luifels'];
const de = ['Schaluppen- und Kreuzer-Caps', 'Cabriolet Caps', 'Spray Hoods', 'Bootsverdecke', 'Abdeckplanen', 'Überzüge', 'Markisen und Sonnensegel', 'Vorzelte'];

const mailOfferte = mailMet('Offerte aanvragen', 'Goedendag,\n\nIk wil graag een offerte voor: [kap / sprayhood / dekkleed / hoes / voortent / reparatie].\nType boot of tent:\n\nNaam:\nTelefoon:\n');

const werk = [
  { src: kapRood, alt: 'Kruiser met een bordeauxrode kap op het water' },
  { src: cabrio, alt: 'Motorboot met een zwarte cabrioletkap met ramen' },
  { src: kapBlauw, alt: 'Kruiser met een donkerblauwe kap aan de wal' },
  { src: sloep, alt: 'Sloep met een lichte dekkap aan de steiger' },
  { src: veranda, alt: 'Groene veranda met zeilen en gordijnen aan het water' },
];
---
<Base title={`${site.naam} | Kappen, sprayhoods en dekkleden aan de Beulakerweg`} description="De Zeilmakerij Giethoorn maakt sloep- en kruiserkappen, sprayhoods, dekkleden, hoezen en voortenten, en repareert ze. Per auto via de N334 of per boot, met eigen aanlegplaats.">
  <Chrome deel="kop" taal />
  <main id="inhoud">

    <!-- Eerste scherm: nachtblauw, de afgedekte boot op het water, en onderaan de route: N334 boven, het kanaal onder, de zeilmakerij ertussen. -->
    <section class="relative flex flex-col overflow-hidden bg-nacht text-white lg:h-[calc(100svh-4.75rem-2rem)] lg:min-h-[40rem] lg:max-h-[58rem]">
      <div class="relative order-1 grid flex-1 lg:order-none lg:grid-cols-12">
        <div class="relative z-10 flex flex-col justify-center px-5 pb-7 pt-9 sm:px-12 lg:col-span-7 lg:py-14 lg:pl-12 xl:pl-[max(3rem,calc((100vw-90rem)/2+3rem))]">
          <h1 class="text-[2.05rem] leading-[1.1] sm:text-[3rem] lg:text-[clamp(3rem,4.6vw,4.9rem)]" data-de="Mit dem Auto<br />oder mit dem Boot.">Met de auto<br />of met de boot.</h1>
          <p class="mt-6 max-w-[33rem] text-lg leading-relaxed text-licht lg:mt-8" data-de="Caps, Spray Hoods, Abdeckplanen und Vorzelte nach Maß, und Reparaturen. An der N334 in Giethoorn, mit Anlegestelle am Kanal Beukers-Steenwijk.">Kappen, sprayhoods, dekkleden en voortenten op maat, en reparaties. Aan de N334 in Giethoorn, met een eigen aanlegplaats aan het kanaal Beukers-Steenwijk.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4 lg:mt-10">
            <a href={site.telHref} class="knop text-lg"><span data-de="Anrufen">Bel</span> <span class="tabular-nums">{site.tel}</span></a>
            <a href={mailOfferte} class="lijn text-licht hover:text-white" data-de="Angebot per E-Mail anfragen">Offerte aanvragen per mail</a>
          </div>
        </div>
      </div>

      <!-- De route: de N334 boven, het kanaal onder, de loods met de wimpel ertussen. -->
      <div class="relative order-2 h-[200px] shrink-0 bg-nacht [--pin:6.5rem] sm:[--pin:58%] lg:order-none" role="img" aria-label="Kaartje: de zeilmakerij ligt tussen de N334 en het kanaal Beukers-Steenwijk, bereikbaar per auto en per boot met eigen aanlegplaats">
        <p class="absolute left-5 top-1.5 text-xs font-semibold text-licht sm:left-12">N334 &middot; Beulakerweg</p>
        <div class="weg absolute inset-x-0 top-[28px] h-[44px]"></div>
        <div class="kanaal absolute inset-x-0 top-[122px] h-[50px]"></div>
        <p class="absolute left-5 top-[178px] text-xs font-semibold text-licht sm:left-12" data-de="Kanal Beukers-Steenwijk">Kanaal Beukers-Steenwijk</p>
        <svg class="rijden absolute top-[38px] h-[22px] w-[54px]" style="left: calc(var(--pin) - 5rem)" viewBox="0 0 44 18" aria-hidden="true"><path d="M3 13V9l5-1 5-5h14l7 5 7 1v4Z" fill="#fff"/><path d="M15 4.5h5v4h-9Zm7 0h4l5 4h-9Z" fill="#18275a"/><circle cx="11" cy="14" r="3.3" fill="#0b1638" stroke="#fff" stroke-width="1.6"/><circle cx="33" cy="14" r="3.3" fill="#0b1638" stroke="#fff" stroke-width="1.6"/></svg>
        <div class="absolute top-[74px] flex items-end gap-3" style="left: calc(var(--pin) - 1.4rem)">
          <svg viewBox="0 0 40 34" class="h-[46px] w-[54px] shrink-0" aria-hidden="true"><path d="M2 33V16L20 3l18 13v17Z" fill="#9aa5b8"/><path d="M2 16 20 3l18 13" fill="none" stroke="#c3cddf" stroke-width="2.2"/><rect x="13" y="17" width="12" height="16" fill="#e3e8ea"/><path d="M22 19c-2.5-1-5 1.5-7 .5l.8 2.4c2 .8 4.3-1.4 6-.6Zm-6.2 12c2.5 1 5-1.5 7-.5l-.8-2.4c-2-.8-4.3 1.4-6 .6Zm.8-9.5 4.8 6.6" fill="#e9572b" stroke="#e9572b" stroke-width=".9"/></svg>
          <p class="krona whitespace-nowrap pb-1 text-[.8rem] leading-tight text-wimpel">De Zeilmakerij<br /><span class="text-white">{site.straat}</span></p>
        </div>
        <div class="absolute top-[118px] h-[32px] w-[5px] bg-[#9aa5b8]" style="left: calc(var(--pin) + 2.4rem)" aria-hidden="true"></div>
        <svg class="varen absolute top-[136px] h-[24px] w-[64px]" style="left: calc(var(--pin) + 3.1rem)" viewBox="0 0 54 20" aria-hidden="true"><path d="M2 11h50l-6 7H8Z" fill="#fff"/><path d="M14 11V6c0-2 1.5-3 3.5-3H33l6 8Z" fill="#e9572b"/><path d="M18 6h6v3h-6Zm9 0h4l2 3h-6Z" fill="#0b1638" opacity=".55"/></svg>
        <p class="absolute top-[139px] whitespace-nowrap text-xs font-semibold text-white" style="left: calc(var(--pin) + 7.6rem)"><span data-de="Anlegestelle">aanlegplaats</span></p>
      </div>

      <figure class="relative order-3 h-[14rem] sm:h-[22rem] lg:absolute lg:bottom-[200px] lg:right-0 lg:top-0 lg:order-none lg:h-auto lg:w-[52%]">
        <Foto src={meeuw} alt="Een boot met een strak gespannen kap op het water, een meeuw op de punt" hero sizes="(min-width: 1024px) 52vw, 100vw" class="object-[60%_55%]" />
        <div class="absolute inset-y-0 left-0 hidden w-48 bg-gradient-to-r from-nacht to-transparent lg:block" aria-hidden="true"></div>
      </figure>
    </section>

    <!-- Wat ze maken: hun eigen lijst, groot gezet, met hun eigen (kleine) foto's als werkplaatsmuur. -->
    <section id="maken" class="scroll-mt-4 py-20 lg:py-28">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <h2 class="text-2xl" data-de="Nach Maß, für Schaluppe und Kreuzer.">Op maat, voor sloep en kruiser.</h2>
          <ul class="mt-9 border-t border-lijn text-[1.35rem] leading-tight lg:text-[1.55rem]" data-taal="nl">
            {nl.map((p) => <li class="flex items-center gap-4 border-b border-lijn py-3.5"><span class="h-2 w-2 shrink-0 bg-wimpel" aria-hidden="true"></span>{p}</li>)}
          </ul>
          <ul class="mt-9 hidden border-t border-lijn text-[1.35rem] leading-tight lg:text-[1.55rem]" data-taal="de" lang="de">
            {de.map((p) => <li class="flex items-center gap-4 border-b border-lijn py-3.5"><span class="h-2 w-2 shrink-0 bg-wimpel" aria-hidden="true"></span>{p}</li>)}
          </ul>
          <p class="mt-7 max-w-[28rem] text-grijs" data-de="Natürlich reparieren wir auch Vorzelte, Abdeckungen, Segel usw.">En natuurlijk repareren we ook voortenten, kappen en zeilen.</p>
          <p class="mt-7"><a href={mailOfferte} class="knop" data-de="Angebot anfragen">Offerte aanvragen</a></p>
        </div>
        <div class="lg:col-span-7">
          <div class="grid grid-cols-2 items-start gap-3 sm:grid-cols-3 lg:gap-4">
            {werk.map((w, i) => (
              <figure class={i === 1 ? 'sm:mt-16' : i === 3 ? 'sm:-mt-16' : ''}>
                <Image src={w.src} alt={w.alt} format="webp" quality={82} loading="lazy" class="block aspect-[4/3] w-full object-cover" />
              </figure>
            ))}
            <figcaption class="col-span-2 self-end text-sm text-grijs sm:col-span-1" data-de="Aus der Werkstatt.">Uit de werkplaats.</figcaption>
          </div>
        </div>
      </div>
    </section>

    <!-- Route en tijden, met hun eigen loods. -->
    <section id="route" class="scroll-mt-4 bg-white py-20 lg:py-28">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-6">
          <figure>
            <Image src={loods} alt="De grijze loods van De Zeilmakerij Giethoorn met de oranje wimpel op de deur" format="webp" quality={85} loading="lazy" class="block h-auto w-full max-w-[555px]" />
          </figure>
          <h2 class="mt-10 text-2xl">{site.straat}</h2>
          <p class="mt-2 text-lg text-grijs">{site.postcode} {site.plaats}</p>
          <p class="mt-6 max-w-[30rem]" data-de="Mit dem Auto über die N334. Mit dem Boot über den Kanal Beukers-Steenwijk: eine Anlegestelle ist vorhanden.">Met de auto over de N334. Met de boot over het kanaal Beukers-Steenwijk: er is een aanlegplaats.</p>
          <p class="mt-5"><a href={site.maps} class="lijn" data-de="Route in Google Maps">Route in Google Maps</a></p>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h2 class="text-2xl" data-de="Öffnungszeiten">Openingstijden</h2>
          <dl class="mt-8 border-t border-lijn">
            {tijden.map((d) => (
              <div class="dag flex justify-between gap-6 border-b border-lijn py-3" data-dag={d.dag}>
                <dt data-de={d.de}>{d.nl}</dt>
                <dd class={`text-right tabular-nums ${d.t ? '' : 'text-grijs'}`}>{d.t || <span data-de="geschlossen">gesloten</span>}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-10 space-y-3">
            <p><a href={site.telHref} class="krona whitespace-nowrap text-[1.7rem] tabular-nums no-underline hover:text-wimpel">{site.tel}</a></p>
            <p><a href={`mailto:${site.mail}`} class="lijn break-all">{site.mail}</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />

  <script>
    // Vandaag in de tijdentabel.
    const vandaag = document.querySelector<HTMLElement>(`.dag[data-dag="${new Date().getDay()}"]`);
    if (vandaag) { vandaag.classList.add('font-semibold'); vandaag.setAttribute('aria-current', 'date'); }

    // Deutsch / Nederlands: zoals op hun oude site, één knop.
    const knop = document.getElementById('taal');
    let duits = false;
    knop?.addEventListener('click', () => {
      duits = !duits;
      document.documentElement.lang = duits ? 'de' : 'nl';
      document.querySelectorAll<HTMLElement>('[data-de]').forEach((el) => {
        if (el.dataset.nl === undefined) el.dataset.nl = el.innerHTML;
        el.innerHTML = duits ? el.dataset.de! : el.dataset.nl!;
      });
      document.querySelectorAll<HTMLElement>('[data-taal]').forEach((el) => el.classList.toggle('hidden', el.dataset.taal !== (duits ? 'de' : 'nl')));
      knop.textContent = duits ? 'Nederlands' : 'Deutsch';
      knop.setAttribute('lang', duits ? 'nl' : 'de');
      knop.setAttribute('aria-label', duits ? 'Nederlands' : 'Deutsch');
    });
  </script>
</Base>
