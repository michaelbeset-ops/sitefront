---
// Typografisch woordmerk: "Patisserie" klein en gespatieerd, "by Barbara" in cursieve Bodoni, met een croissantje.
interface Props { class?: string; donker?: boolean }
const { class: cls = '', donker = false } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg aria-hidden="true" viewBox="0 0 40 28" class={`h-7 w-10 shrink-0 ${donker ? 'text-roos' : 'text-framboos'}`} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 20c2-7 9-13 17-13s15 6 17 13c-3 1.5-6 1.2-8-.5-2.5 2-6 2.8-9 2.8s-6.5-.8-9-2.8c-2 1.7-5 2-8 .5Z" />
    <path d="M13 9.5c1.2 3.2 1.6 7 1 10.5M27 9.5c-1.2 3.2-1.6 7-1 10.5M20 7v14" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`eyebrow !text-[0.625rem] !tracking-[0.3em] ${donker ? 'text-roos' : 'text-framboos'}`}>Patisserie</span>
    <span class="whitespace-nowrap font-display text-xl font-medium italic tracking-[-0.01em]">by Barbara</span>
  </span>
</span>
