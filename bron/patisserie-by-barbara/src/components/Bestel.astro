---
// Wow: taart of bestelling aanvragen. Kiest soort, aantal, ophaaldag binnen de openingstijden en wensen,
// en zet alles als net bericht klaar in WhatsApp. Verstuurt zelf niets; geen prijzen.
// Zonder JS: de velden staan er, de knop opent gewoon WhatsApp.
import { site, wa } from '../data/site';
const veld = 'mt-1.5 block w-full rounded-lg border border-lijn bg-white px-3.5 py-3 text-inkt shadow-sm transition-colors focus:border-framboos';
const soorten = [
  { v: 'taart', t: 'Taart op bestelling', s: 'Voor een aantal personen' },
  { v: 'ontbijt', t: 'Croissants en brioche voor een ontbijt', s: 'Per stuk' },
  { v: 'kantoor', t: 'Croissants en brioche voor op kantoor', s: 'Per stuk' },
];
const lekkers = ['Croissants', 'Kaascroissants', 'Brioche', 'Kanelbulle'];
---
<form id="bestel" class="rounded-2xl bg-papier p-5 text-inkt shadow-xl sm:p-8" novalidate>
  <fieldset>
    <legend class="eyebrow text-framboos">1. Wat wilt u bestellen</legend>
    <div class="mt-3 grid gap-3 md:grid-cols-3">
      {soorten.map((s, i) => (
        <label class="keuze flex cursor-pointer flex-col rounded-xl bg-white p-4 shadow-sm ring-1 ring-lijn transition-shadow">
          <span class="flex items-start gap-3">
            <input type="radio" name="soort" value={s.v} checked={i === 0} class="mt-1 h-4 w-4 shrink-0 accent-framboos" />
            <span><span class="block font-display text-lg font-semibold leading-tight">{s.t}</span><span class="mt-1 block text-sm text-inkt-zacht">{s.s}</span></span>
          </span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="mt-7 grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-semibold"><span data-aantal-label>Aantal personen</span>
      <input type="number" name="aantal" min="1" max="200" value="8" inputmode="numeric" class={veld} />
    </label>
    <fieldset class="hidden" data-lekkers>
      <legend class="text-sm font-semibold">Wat mag erbij</legend>
      <div class="mt-1.5 flex flex-wrap gap-2">
        {lekkers.map((l, i) => (
          <label class="chip"><input type="checkbox" name="lekker" value={l} checked={i < 2} class="sr-only" /><span>{l}</span></label>
        ))}
      </div>
    </fieldset>
  </div>

  <fieldset class="mt-7">
    <legend class="eyebrow text-framboos">2. Wanneer haalt u het op</legend>
    <div class="-mx-1 mt-3 flex gap-2 overflow-x-auto px-1 pb-2" data-dagen>
      <p class="text-sm text-inkt-zacht">Elke dag open: ma t/m do 09.00 - 16.00, vr 09.00 - 16.30, za 09.30 - 15.00, zo 10.00 - 15.00.</p>
    </div>
    <label class="mt-4 block max-w-xs text-sm font-semibold">Hoe laat ongeveer
      <select name="tijd" class={veld} data-tijd><option value="">Kies eerst een dag</option></select>
    </label>
  </fieldset>

  <div class="mt-7 grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-semibold sm:col-span-2"><span class="eyebrow text-framboos">3. Uw wensen</span>
      <textarea name="wensen" rows="3" class={veld} placeholder="Bijvoorbeeld de smaak, een tekst op de taart of een allergie"></textarea>
    </label>
    <label class="block text-sm font-semibold">Uw naam
      <input type="text" name="naam" autocomplete="name" class={veld} />
    </label>
  </div>

  <div class="mt-7 rounded-xl bg-roos-licht p-4 ring-1 ring-lijn sm:p-5">
    <p class="eyebrow text-inkt-zacht">Uw bericht</p>
    <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-inkt" aria-live="polite" data-voorbeeld>Hallo Barbara, ik wil graag iets bestellen.</p>
  </div>
  <a href={site.whatsapp} class="btn btn-framboos mt-5 w-full sm:w-auto sm:text-lg" data-knop><Fragment set:html={wa} />Open WhatsApp met dit bericht</a>
  <p class="mt-3 text-sm text-inkt-zacht">WhatsApp opent met het bericht klaar. U verstuurt het zelf en kunt het eerst nog aanpassen.</p>
</form>

<style>
  .keuze:has(input:checked) { box-shadow: inset 0 0 0 2px var(--color-framboos), var(--shadow-sm); }
  .keuze:hover { box-shadow: inset 0 0 0 1.5px var(--color-framboos); }
  .chip { position: relative; }
  .chip span, :global(.dag) { display: inline-flex; border-radius: var(--radius-full); padding: .5rem .95rem; font-size: var(--text-sm); font-weight: 600; background: var(--color-white); box-shadow: inset 0 0 0 1.5px var(--color-lijn); cursor: pointer; transition: background-color .2s ease, color .2s ease, box-shadow .2s ease; white-space: nowrap; }
  .chip:hover span, :global(.dag:hover) { box-shadow: inset 0 0 0 1.5px var(--color-framboos); }
  .chip input:checked + span { background: var(--color-pruim); color: var(--color-papier); box-shadow: none; }
  .chip input:focus-visible + span, :global(.dag:has(input:focus-visible)) { outline: 3px solid var(--color-framboos); outline-offset: 2px; }
  :global(.dag) { position: relative; flex-direction: column; align-items: flex-start; flex-shrink: 0; border-radius: var(--radius-lg); padding: .6rem .9rem; line-height: 1.25; }
  :global(.dag:has(input:checked)) { background: var(--color-pruim); color: var(--color-papier); box-shadow: none; }
  :global(.dag small) { font-size: var(--text-xs); font-weight: 500; }
</style>

<script>
  import { UREN, DAGEN, MAANDEN, hhmm, nuInAmsterdam, dag } from '../scripts/open';
  const f = document.getElementById('bestel') as HTMLFormElement;
  const rij = f.querySelector<HTMLElement>('[data-dagen]')!;
  const tijd = f.querySelector<HTMLSelectElement>('[data-tijd]')!;
  const voorbeeld = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
  const knop = f.querySelector<HTMLAnchorElement>('[data-knop]')!;
  const lekkersVak = f.querySelector<HTMLElement>('[data-lekkers]')!;
  const aantalLabel = f.querySelector<HTMLElement>('[data-aantal-label]')!;
  const aantal = f.elements.namedItem('aantal') as HTMLInputElement;
  const nu = nuInAmsterdam();
  const kort = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];

  // Ophaaldagen: vanaf morgen, twee weken vooruit. Elke dag open, met de tijden van die dag.
  rij.innerHTML = '';
  for (let i = 1; i <= 14; i++) {
    const d = dag(nu.ymd, i);
    const [van, tot] = UREN[d.wd];
    const l = document.createElement('label');
    l.className = 'dag';
    l.innerHTML = `<input type="radio" name="dag" value="${d.ymd}" class="sr-only"><span>${i === 1 ? 'Morgen' : kort[d.wd]} ${d.d} ${MAANDEN[d.m].slice(0, 3)}</span><small class="tabular-nums">${hhmm(van)} - ${hhmm(tot)}</small>`;
    l.querySelector('input')!.setAttribute('aria-label', `${DAGEN[d.wd]} ${d.d} ${MAANDEN[d.m]}, open ${hhmm(van)} tot ${hhmm(tot)}`);
    rij.append(l);
  }

  let tijdenVoor = '';
  function vulTijden(ymd: string) {
    const [van, tot] = UREN[dag(ymd).wd];
    const oud = tijd.value;
    tijd.innerHTML = '';
    for (let m = van; m <= tot - 30; m += 30) {
      const o = document.createElement('option');
      o.value = o.textContent = hhmm(m);
      tijd.append(o);
    }
    tijd.value = [...tijd.options].some((o) => o.value === oud) ? oud : tijd.options[Math.min(2, tijd.options.length - 1)].value;
    tijdenVoor = ymd;
  }

  let vorigeSoort = 'taart';
  function werkBij() {
    const soort = (f.elements.namedItem('soort') as RadioNodeList).value;
    const isTaart = soort === 'taart';
    if ((soort === 'taart') !== (vorigeSoort === 'taart')) aantal.value = isTaart ? '8' : '12';
    vorigeSoort = soort;
    aantalLabel.textContent = isTaart ? 'Aantal personen' : 'Aantal stuks';
    lekkersVak.classList.toggle('hidden', isTaart);
    const gekozen = f.querySelector<HTMLInputElement>('input[name="dag"]:checked');
    if (gekozen && tijdenVoor !== gekozen.value) vulTijden(gekozen.value);
    const n = Number(aantal.value) || 0;
    const lekkers = [...f.querySelectorAll<HTMLInputElement>('input[name="lekker"]:checked')].map((x) => x.value.toLowerCase());
    const wensen = (f.elements.namedItem('wensen') as HTMLTextAreaElement).value.trim();
    const naam = (f.elements.namedItem('naam') as HTMLInputElement).value.trim();
    const regels = ['Hallo Barbara,', ''];
    if (isTaart) {
      regels.push('Ik wil graag een taart op bestelling aanvragen.');
      if (n) regels.push(`Voor: ${n} ${n === 1 ? 'persoon' : 'personen'}`);
    } else {
      regels.push(`Ik wil graag croissants en brioche bestellen ${soort === 'kantoor' ? 'voor op kantoor' : 'voor een ontbijt'}.`);
      if (n) regels.push(`Aantal: ${n} stuks`);
      if (lekkers.length) regels.push(`Graag: ${lekkers.join(', ').replace(/, ([^,]*)$/, ' en $1')}`);
    }
    if (gekozen) { const d = dag(gekozen.value); regels.push(`Ophalen: ${DAGEN[d.wd]} ${d.d} ${MAANDEN[d.m]}${tijd.value ? `, rond ${tijd.value} uur` : ''}`); }
    else regels.push('Ophalen: (kies hierboven een dag)');
    if (wensen) regels.push(`Wensen: ${wensen}`);
    regels.push('', 'Kunt u laten weten of dit kan en wat het kost?');
    if (naam) regels.push(`Groet, ${naam}`);
    const tekst = regels.join('\n');
    voorbeeld.textContent = tekst;
    knop.href = `https://wa.me/31653445592?text=${encodeURIComponent(tekst)}`;
  }
  f.addEventListener('input', werkBij);
  f.addEventListener('change', werkBij);
  f.addEventListener('submit', (e) => e.preventDefault());
  werkBij();
</script>
