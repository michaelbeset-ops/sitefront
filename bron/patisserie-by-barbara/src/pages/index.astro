---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Bestel from '../components/Bestel.astro';
import { site, tijden, wa, telIcoon } from '../data/site';
import terras from '../assets/terras.jpg';
import latte from '../assets/latte.jpg';
import taart from '../assets/taart.jpg';
import taart2 from '../assets/taart-2.jpg';
import winkel from '../assets/winkel.jpg';
import croissants from '../assets/croissants.jpg';
import focaccia from '../assets/focaccia.jpg';
import kanelbulle from '../assets/kanelbulle.jpg';
import brioche from '../assets/brioche.jpg';

const pijl = `<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---
<Base title={`${site.naam} | Patisserie aan de Valkenburgerstraat, Amsterdam`} description="Patisserie by Barbara, Valkenburgerstraat 208H in Amsterdam. Croissants, focaccia, brioche, kanelbulle en taarten op bestelling. Elke dag open. Bestellen via WhatsApp 06 53 44 55 92.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO: licht en botergeel, grote eigen foto met de paarse latte als inzet -->
    <section class="relative overflow-hidden bg-boter">
      <div class="absolute -right-24 top-0 hidden h-full w-[46%] rounded-bl-[12rem] bg-roos lg:block" aria-hidden="true"></div>
      <div class="wrap relative grid gap-x-12 gap-y-8 pb-14 pt-10 lg:grid-cols-12 lg:pb-20 lg:pt-16">
        <div class="lg:col-span-6 lg:self-end">
          <p class="eyebrow text-framboos">Valkenburgerstraat 208H, Amsterdam</p>
          <h1 class="mt-4 text-4xl font-medium">Patisserie <em class="block font-medium text-framboos">by Barbara</em></h1>
          <p class="mt-5 max-w-lg text-lg text-inkt">Vers gebakken croissants, focaccia, brioche en kanelbulle. Taarten maken we op bestelling.</p>
        </div>

        <div class="relative lg:col-span-6 lg:col-start-7 lg:row-span-2">
          <figure class="relative overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[4/3] sm:aspect-[5/4] lg:aspect-[6/7]">
              <Foto src={terras} alt="Croissant, pain au chocolat en twee koppen koffie op een dienblad, op een tafeltje buiten aan de straat" class="object-[center_85%]" hero sizes="(min-width: 1024px) 560px, 100vw" />
            </div>
            <figcaption class="absolute right-3 top-3 rounded-full bg-papier/90 px-3 py-1.5 text-xs font-semibold text-inkt backdrop-blur-sm">Croissant en koffie</figcaption>
          </figure>
          <figure class="absolute -bottom-8 -right-1 w-[36%] max-w-56 overflow-hidden rounded-xl bg-papier p-1.5 shadow-xl sm:-right-4 lg:-bottom-12 lg:-right-10">
            <div class="aspect-square overflow-hidden rounded-lg"><Foto src={latte} alt="Paarse latte met een hartje in het schuim, naast een croissant in bakpapier" class="object-[30%_50%]" sizes="240px" /></div>
            <figcaption class="px-1.5 pb-1 pt-2 font-display text-sm font-semibold italic">De paarse latte</figcaption>
          </figure>
        </div>

        <div class="mt-6 lg:col-span-6 lg:mt-0">
          <div class="flex flex-wrap gap-3">
            <a href={site.whatsapp} class="btn btn-framboos text-lg"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-inkt"><Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <div class="mt-8 grid gap-4 border-t border-lijn pt-6 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-8">
            <p class="flex items-baseline gap-3">
              <span class="font-display text-3xl font-semibold leading-none">{site.google.score}</span>
              <span class="text-sm leading-snug text-inkt-zacht">op Google<br />{site.google.aantal} reviews</span>
            </p>
            <Status />
          </div>
        </div>
      </div>
    </section>

    <!-- UIT DE OVEN: populair bij gasten, geen menukaart bekend -->
    <section id="uit-de-oven" class="scroll-mt-16 bg-papier pb-16 pt-20 lg:pb-24 lg:pt-28" aria-labelledby="ovenkop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-framboos">Populair bij gasten</p>
            <h2 id="ovenkop" class="mt-3 text-3xl">Croissants, focaccia en brioche</h2>
          </div>
          <p class="text-inkt-zacht lg:col-span-5">Wat gasten in hun reviews het vaakst noemen. <span class="text-xs">[[AANLEVEREN: volledige menukaart met prijzen]]</span></p>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-12 md:gap-5">
          <figure class="kaart relative overflow-hidden rounded-xl shadow-sm md:col-span-7 md:row-span-2">
            <div class="aspect-[4/3] h-full md:aspect-auto"><Foto src={croissants} alt="Sfeerbeeld: croissants en pains au chocolat op een houten plank met chocolade en een deegroller" sizes="(min-width: 768px) 58vw, 100vw" /></div>
            <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-pruim/90 to-pruim/0 p-5 pt-16 text-papier sm:p-7 sm:pt-20">
              <span class="eyebrow text-roos">Het meest genoemd</span>
              <span class="mt-1 block font-display text-2xl font-semibold">Croissants, ook met kaas</span>
            </figcaption>
          </figure>
          <figure class="kaart relative overflow-hidden rounded-xl shadow-sm md:col-span-5">
            <div class="aspect-[3/2]"><Foto src={focaccia} alt="Sfeerbeeld: stukken focaccia met tomaat en kruiden" sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <figcaption class="absolute bottom-3 left-3 rounded-full bg-papier/95 px-4 py-1.5 font-display text-lg font-semibold">Focaccia</figcaption>
          </figure>
          <figure class="kaart relative overflow-hidden rounded-xl shadow-sm md:col-span-5">
            <div class="aspect-[3/2]"><Foto src={brioche} alt="Sfeerbeeld: opengebroken brioche op een bord" sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <figcaption class="absolute bottom-3 left-3 rounded-full bg-papier/95 px-4 py-1.5 font-display text-lg font-semibold">Brioche</figcaption>
          </figure>
          <figure class="kaart relative overflow-hidden rounded-xl shadow-sm md:col-span-5">
            <div class="aspect-[3/2] md:aspect-[4/3]"><Foto src={kanelbulle} alt="Sfeerbeeld: een kanelbulle op een wit bord" class="object-[center_45%]" sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <figcaption class="absolute bottom-3 left-3 rounded-full bg-papier/95 px-4 py-1.5 font-display text-lg font-semibold">Kanelbulle</figcaption>
          </figure>
          <div class="flex flex-col justify-between rounded-xl bg-boter p-6 shadow-sm ring-1 ring-lijn sm:p-8 md:col-span-7">
            <div>
              <p class="eyebrow text-framboos">Ook genoemd</p>
              <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 font-display text-xl font-semibold sm:text-2xl">
                <li>Bananenbrood</li>
                <li>Pistache</li>
                <li>Mortadella</li>
                <li>Soep</li>
              </ul>
            </div>
            <p class="mt-6 text-inkt-zacht">Benieuwd wat er vandaag ligt? Stuur even een WhatsApp.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- DRINKEN: paarse latte, eigen foto -->
    <section class="bg-roos-licht py-16 lg:py-24" aria-labelledby="drinkkop">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
        <figure class="overflow-hidden rounded-2xl shadow-md lg:col-span-6">
          <div class="aspect-[4/3]"><Foto src={latte} alt="Paarse latte met een hartje in het schuim, naast een croissant in bakpapier op een houten plankje" sizes="(min-width: 1024px) 560px, 100vw" /></div>
        </figure>
        <div class="lg:col-span-6">
          <p class="eyebrow text-framboos">Erbij</p>
          <h2 id="drinkkop" class="mt-3 text-3xl">Koffie, matcha, chai en de <em class="font-medium text-framboos">paarse latte</em></h2>
          <ul class="mt-8 divide-y divide-lijn border-y border-lijn text-lg">
            <li class="flex items-baseline justify-between gap-4 py-3.5"><span class="font-semibold">Koffie en cappuccino</span></li>
            <li class="flex items-baseline justify-between gap-4 py-3.5"><span class="font-semibold">Matcha</span></li>
            <li class="flex items-baseline justify-between gap-4 py-3.5"><span class="font-semibold">Chai</span></li>
            <li class="flex items-baseline justify-between gap-4 py-3.5"><span class="font-semibold">Paarse latte</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- TAARTEN + WOW -->
    <section id="bestellen" class="donker scroll-mt-16 bg-pruim py-16 text-papier lg:py-24" aria-labelledby="bestelkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-24">
            <p class="eyebrow text-roos">Taarten op bestelling</p>
            <h2 id="bestelkop" class="mt-3 text-3xl">Taart of bestelling aanvragen</h2>
            <p class="mt-5 text-papier/85">Gasten noemen het luchtige biscuit en de vele vulling. Kies wat u wilt, voor hoeveel mensen en wanneer u het ophaalt. Wij zetten het klaar als WhatsApp-bericht.</p>
            <div class="mt-8 grid grid-cols-2 gap-3">
              <figure class="overflow-hidden rounded-xl"><div class="aspect-[3/4]"><Foto src={taart} alt="Aardbeientaart met slagroomtoefjes, aangesneden, met een punt op een bordje en een kop thee" sizes="(min-width: 1024px) 180px, 50vw" /></div></figure>
              <figure class="mt-8 overflow-hidden rounded-xl"><div class="aspect-[3/4]"><Foto src={taart2} alt="Aangesneden aardbeientaart met lagen biscuit en vulling op een goudkleurig bord" class="object-[40%_40%]" sizes="(min-width: 1024px) 180px, 50vw" /></div></figure>
            </div>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-8">
          <Bestel />
        </div>
      </div>
    </section>

    <!-- WAT GASTEN NOEMEN -->
    <section class="bg-boter py-16 lg:py-24" aria-labelledby="gastenkop">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-framboos">Wat gasten noemen</p>
          <h2 id="gastenkop" class="mt-3 text-3xl">{site.google.score} op Google</h2>
          <p class="mt-3 text-inkt-zacht">Uit {site.google.aantal} reviews, samengevat.</p>
        </div>
        <ol class="grid gap-px overflow-hidden rounded-xl bg-lijn shadow-sm ring-1 ring-lijn sm:grid-cols-2 lg:col-span-8">
          <li class="bg-papier p-6"><span class="font-display text-lg italic text-framboos">01</span><p class="mt-2 text-lg font-semibold">Vers gebakken croissants, ook de kaascroissant</p></li>
          <li class="bg-papier p-6"><span class="font-display text-lg italic text-framboos">02</span><p class="mt-2 text-lg font-semibold">Focaccia, brioche en kanelbulle</p></li>
          <li class="bg-papier p-6"><span class="font-display text-lg italic text-framboos">03</span><p class="mt-2 text-lg font-semibold">Cappuccino, matcha, chai en de paarse latte</p></li>
          <li class="bg-papier p-6"><span class="font-display text-lg italic text-framboos">04</span><p class="mt-2 text-lg font-semibold">Taarten op bestelling met luchtig biscuit en veel vulling</p></li>
          <li class="bg-papier p-6 sm:col-span-2"><span class="font-display text-lg italic text-framboos">05</span><p class="mt-2 text-lg font-semibold">Barbara zelf, die gasten gastvrij noemen</p></li>
        </ol>
      </div>
    </section>

    <!-- BEZOEK -->
    <section id="bezoek" class="scroll-mt-16 bg-papier py-16 lg:py-24" aria-labelledby="bezoekkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <figure class="relative overflow-hidden rounded-2xl shadow-md lg:col-span-4">
          <div class="aspect-[4/5]"><Foto src={winkel} alt="In de winkel: de toonbank met vitrine, een koffiebord aan de botergele muur en een vaas pioenrozen" class="object-[center_35%]" sizes="(min-width: 1024px) 380px, 100vw" /></div>
          <figcaption class="absolute bottom-3 left-3 rounded-full bg-papier/95 px-3 py-1.5 text-xs font-semibold">In de winkel</figcaption>
        </figure>
        <div class="lg:col-span-4">
          <p class="eyebrow text-framboos">Valkenburgerstraat</p>
          <h2 id="bezoekkop" class="mt-3 text-3xl">Kom langs</h2>
          <address class="mt-6 text-lg not-italic">
            <strong class="font-display text-2xl font-semibold">{site.naam}</strong><br />
            {site.straat}<br />{site.postcode} {site.plaats}
          </address>
          <div class="mt-8 flex flex-col items-start gap-3">
            <a href={site.whatsapp} class="btn btn-framboos"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-inkt"><Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <a href={site.maps} class="mt-5 inline-flex items-center gap-2 font-semibold text-framboos underline underline-offset-4 transition-colors hover:text-framboos-diep">Route plannen <Fragment set:html={pijl} /></a>
        </div>
        <div class="lg:col-span-4">
          <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-lijn sm:p-7">
            <h3 class="text-2xl">Openingstijden</h3>
            <p class="mt-1 text-sm text-inkt-zacht">Elke dag open</p>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden per dag</caption>
              <tbody>
                {tijden.map((d) => (
                  <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                    <th scope="row" class="py-2.5 font-semibold">{d.dag}</th>
                    <td class="whitespace-nowrap py-2.5 text-right tabular-nums">{d.van} - {d.tot}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .kaart :global(img) { transition: transform .6s ease; }
  .kaart:hover :global(img) { transform: scale(1.03); }
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-framboos); }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  const wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short' }).format(new Date()));
  document.querySelector(`.dagrij[data-wd="${wd}"]`)?.classList.add('vandaag');
</script>
