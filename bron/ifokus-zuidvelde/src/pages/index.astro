---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Keien from '../components/Keien.astro';
import { site, url, groepen, vergelijkMail } from '../data/site';
---
<Base title={`${site.volledig} | Hypotheken en verzekeringen in Zuidvelde`} description="Hypotheken en verzekeringen voor particulieren, ondernemers en zzp'ers. Alle financiële zaken onder één dak, vanuit Zuidvelde in Drenthe.">
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- 1. Balans: de kop links, de drie keien rechts op een horizon die over de hele breedte loopt -->
    <section class="relative">
      <div class="wrap grid grid-cols-12 gap-x-6 lg:min-h-[calc(100svh-11.6rem)]">
        <div class="col-span-12 flex flex-col pt-5 md:pt-12 lg:col-span-8 lg:pb-14 lg:pt-[3.5vh]">
          <p class="sans text-[.86rem] text-grijs md:text-base">Hypotheken en verzekeringen <span class="mx-1 text-paars md:mx-1.5">/</span> Zuidvelde, Drenthe</p>
          <h1 class="mt-4 text-[clamp(2.6rem,12.4vw,3.6rem)] leading-[.98] md:mt-6 md:text-[clamp(3.6rem,7.6vw,7.2rem)] md:leading-[.94]">Balans in <br class="hidden md:block" /><em class="font-light text-paars">financiële</em> dienstverlening.</h1>
          <p class="mt-6 max-w-[33rem] text-lg leading-relaxed text-grijs md:mt-9 md:text-[1.38rem] md:leading-[1.55]">Alle financiële zaken onder één dak. Laat ons vrijblijvend uw huidige verzekeringen en financiële situatie vergelijken.</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4 md:mt-10">
            <a href={site.telHref} class="knop"><span>Bel</span><span class="tabular-nums">{site.tel}</span></a>
            <a href={vergelijkMail} class="sans lijn text-[1.02rem]">of vraag per mail een vergelijking aan</a>
          </div>
        </div>
        <div class="relative col-span-12 mt-3 flex items-end justify-end lg:col-span-4 lg:mt-0 lg:justify-end">
          <Keien class="relative z-10 -mb-[3px] h-[9.5rem] w-auto md:h-[16rem] lg:h-[min(33rem,64vh)]" id="hero" />
        </div>
      </div>
      <!-- de horizon -->
      <div class="border-t border-inkt/30">
        <div class="wrap sans flex flex-wrap items-center gap-x-5 gap-y-2 py-4 text-[.92rem] md:gap-x-8 md:text-[.95rem] text-grijs md:py-5">
          <span class="text-inkt">Voor</span>
          {groepen.map((g) => <a href={url(`#${g.id}`)} class="lijn">{g.naam === 'Zzp' ? "zzp'ers" : g.naam === 'Particulier' ? 'particulieren' : 'ondernemers'}</a>)}
        </div>
      </div>
    </section>

    <!-- 2. Het register: per groep wat iFokus regelt -->
    <section class="bg-kei-licht py-20 md:py-28" aria-labelledby="regelen">
      <div class="wrap">
        <div class="grid grid-cols-12 gap-x-6">
          <h2 id="regelen" class="col-span-12 text-2xl lg:col-span-6">Alles onder één dak.</h2>
          <p class="col-span-12 mt-4 max-w-xl text-grijs lg:col-span-5 lg:col-start-8 lg:mt-3">Van uw hypotheek tot de verzekering van uw werkmaterieel: u heeft één aanspreekpunt, dat het geheel overziet.</p>
        </div>
        <div class="mt-14 border-b border-lijn md:mt-20">
          {groepen.map((g) => (
            <div id={g.id} class="grid scroll-mt-8 grid-cols-12 gap-x-6 border-t border-lijn py-8 md:py-10">
              <h3 class="col-span-12 text-xl md:col-span-4">{g.naam}</h3>
              <ul class="col-span-12 mt-3 flex flex-wrap gap-x-2 text-lg leading-relaxed md:col-span-8 md:mt-0 md:text-[1.45rem] md:leading-[1.5]">
                {g.items.map((it, i) => <li>{it}{i < g.items.length - 1 && <span class="ml-2 text-paars/60" aria-hidden="true">/</span>}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Werkwijze: hun eigen zin groot, de afspraken uit hun dienstverleningsdocument klein ernaast -->
    <section id="werkwijze" class="bg-aubergine py-20 text-kei md:py-28">
      <div class="wrap grid grid-cols-12 gap-x-6 gap-y-12">
        <blockquote class="col-span-12 lg:col-span-7">
          <p class="text-[clamp(1.9rem,3.4vw,3.3rem)] font-light italic leading-[1.15] tracking-[-.015em]">“iFokus denkt niet in problemen maar in oplossingen, voor nu én in de toekomst.”</p>
        </blockquote>
        <div class="col-span-12 space-y-5 text-kei-donker lg:col-span-4 lg:col-start-9">
          <p>We beginnen met een uitgebreide inventarisatie: uw huidige situatie, uw wensen en uw mogelijkheden.</p>
          <p>Daarna krijgt u een persoonlijk advies, dat we samen met u doornemen.</p>
          <p>Wat advies kost, op basis van uren of tegen een vast tarief, leggen we vooraf met u vast.</p>
          <p class="sans pt-2 text-sm"><a href={site.dienstverlening} class="lijn text-wit hover:!text-kei-donker">Lees het dienstverleningsdocument</a> (pdf)</p>
        </div>
      </div>
    </section>

    <!-- 4. Contact -->
    <section id="contact" class="py-20 md:py-28" aria-labelledby="contact-kop">
      <div class="wrap grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 lg:col-span-7">
          <h2 id="contact-kop" class="text-2xl">Even overleggen?</h2>
          <p class="mt-8"><a href={site.telHref} class="text-[clamp(2.4rem,5vw,4.6rem)] font-light leading-none tabular-nums tracking-[-.02em] no-underline transition-colors hover:text-paars">{site.tel}</a></p>
          <p class="mt-5"><a href={vergelijkMail} class="lijn text-xl">{site.mail}</a></p>
        </div>
        <div class="col-span-12 flex items-end justify-between gap-8 border-t border-lijn pt-8 lg:col-span-4 lg:col-start-9 lg:border-t-0 lg:pt-0">
          <div class="sans text-grijs">
            <p class="text-inkt">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <p class="mt-3"><a href={site.maps} class="lijn">Route in Google Maps</a></p>
            <p class="mt-6 text-sm">Op Trustoo beoordeeld met een 10, uit 14 beoordelingen.</p>
          </div>
          <Keien class="h-28 w-auto shrink-0" id="voet" />
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
