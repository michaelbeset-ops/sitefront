---
import { site, url, vergelijkMail } from '../data/site';
import Keien from './Keien.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="relative z-30">
    <div class="wrap flex h-[4.5rem] items-center justify-between gap-6 md:h-[5.5rem]">
      <a href={url('')} class="flex items-center gap-2.5 no-underline" aria-label={`${site.naam}, naar de homepage`}>
        <Keien class="h-9 w-7 md:h-10 md:w-8" schaduw={false} korrel={false} id="logo" />
        <span class="sans text-[1.55rem] leading-none tracking-[-.01em] md:text-[1.75rem]">iFokus</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="sans flex gap-9 text-[.98rem] text-grijs">
          <li><a href={url('#particulier')} class="transition-colors hover:text-inkt">Particulier</a></li>
          <li><a href={url('#zakelijk')} class="transition-colors hover:text-inkt">Zakelijk</a></li>
          <li><a href={url('#zzp')} class="transition-colors hover:text-inkt">Zzp</a></li>
          <li><a href={url('#werkwijze')} class="transition-colors hover:text-inkt">Werkwijze</a></li>
          <li><a href={url('#contact')} class="transition-colors hover:text-inkt">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="sans whitespace-nowrap text-[1rem] tabular-nums text-inkt no-underline transition-colors hover:text-paars md:text-[1.05rem]">
        <span class="mr-2 inline-block h-2 w-2 rounded-full bg-paars align-middle"></span>{site.tel}
      </a>
    </div>
  </header>
) : (
  <footer class="border-t border-lijn">
    <div class="wrap grid gap-8 py-12 text-grijs md:grid-cols-12">
      <p class="text-xl leading-tight text-inkt md:col-span-5">{site.volledig}</p>
      <p class="sans text-sm md:col-span-3">{site.straat}<br />{site.postcode} {site.plaats}<br />KvK {site.kvk}</p>
      <p class="sans text-sm md:col-span-4 md:text-right">
        <a href={site.dienstverlening} class="lijn">Dienstverleningsdocument</a> (pdf)<br />
        <a href={url('privacy/')} class="lijn">Privacyverklaring</a><br />
        <a href={vergelijkMail} class="lijn">{site.mail}</a>
      </p>
    </div>
    {site.voorstel && <p class="wrap sans pb-8 text-xs text-grijs">De keien zijn nagetekend naar uw eigen logo. Ontwerpvoorstel, ter illustratie.</p>}
  </footer>
)}
