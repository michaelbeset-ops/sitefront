---
import '../styles/global.css';
import kopUrl from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import sansUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { site, url, tijden } from '../data/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={kopUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-[4.5rem] md:pb-0">
    {site.voorstel && (
      <div class="relative z-50 bg-geel text-inkt">
        <p class="wrap py-2 text-xs leading-snug" style="font-family: system-ui, sans-serif">
          Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website.{" "}
          <a href="https://www.sitefront.nl" class="font-bold underline underline-offset-2">sitefront.nl</a>
        </p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-wit focus:px-4 focus:py-2">Naar de inhoud</a>
    <slot />
    <script is:inline define:vars={{ tijden }}>
      (function () {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.rijs').forEach(function (el) { io.observe(el); });

        // Openingstijden: vandaag markeren en live open/dicht tonen (Nederlandse tijd).
        var nu = new Date();
        var deel = function (o) { return new Intl.DateTimeFormat('en-GB', Object.assign({ timeZone: 'Europe/Amsterdam' }, o)).format(nu); };
        var dag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(deel({ weekday: 'short' }));
        var min = Number(deel({ hour: '2-digit', hourCycle: 'h23' })) * 60 + Number(deel({ minute: '2-digit' }));
        var t = function (d) { return tijden.find(function (x) { return x.dag === d; }); };
        var vandaag = t(dag);
        var open = vandaag.van > 0 && min >= vandaag.van && min < vandaag.tot;
        var namen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
        var tekst;
        if (open) tekst = 'Nu open, tot ' + vandaag.dicht + ' uur';
        else if (vandaag.van > 0 && min < vandaag.van) tekst = 'Gesloten, vandaag open vanaf ' + vandaag.open + ' uur';
        else {
          var m = (dag + 1) % 7; if (m === 0) m = 1;
          tekst = 'Gesloten, ' + (m === (dag + 1) % 7 ? 'morgen' : namen[m]) + ' open vanaf ' + t(m).open + ' uur';
        }
        document.querySelectorAll('[data-status]').forEach(function (el) { el.textContent = tekst; var w = el.closest('[data-status-wrap]'); if (w) w.setAttribute('data-open', String(open)); });
        document.querySelectorAll('[data-dag="' + dag + '"]').forEach(function (r) { r.setAttribute('data-vandaag', ''); });
      })();
    </script>
  </body>
</html>
