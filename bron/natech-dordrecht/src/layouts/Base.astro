---
import '../styles/global.css';
// Voorladen voorkomt dat de grote kop verspringt als het font binnenkomt (CLS).
import display from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import body from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;
const og = new URL(u('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {voorstel && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content="nl_NL" />
  <meta name="theme-color" content="#14201a" />
  {[display, body].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('sitemap-index.xml')} />
</head>
<body>
  <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-accent text-paper px-4 py-2">Naar de inhoud</a>
  {voorstel && (
    <div class="bg-ink text-paper text-xs">
      <p class="mx-auto max-w-[84rem] px-4 sm:px-8 py-2">
        Ontwerpvoorstel van <a class="underline" href="https://www.sitefront.nl">Sitefront</a> voor Natech. Dit is niet de officiële website.
      </p>
    </div>
  )}

  <header class="sticky top-0 z-30 bg-paper/95 border-b border-line">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
      <a href={u()} class="display text-[1.3rem] sm:text-[1.6rem] leading-none whitespace-nowrap">NATECH</a>
      <nav aria-label="Hoofdmenu" class="flex items-center gap-7 text-sm font-medium">
        <a class="hidden lg:inline hover:text-accent" href={u('#machines')}>Machines</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#service')}>Service</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#contact')}>Contact</a>
        <a href="tel:+31786737201" class="inline-flex items-center gap-2 bg-ink text-paper px-3 sm:px-4 py-2 hover:bg-accent transition-colors">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>
          <span class="whitespace-nowrap"><span class="max-[379px]:sr-only">078 673 72 01</span><span class="min-[380px]:hidden">Bel</span></span>
        </a>
      </nav>
    </div>
  </header>

  <main id="inhoud">
    <slot />
  </main>

  <footer class="bg-night text-paper">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 pt-16 pb-10 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="display text-[2.2rem]">Natech</p>
        <p class="mt-4 max-w-sm text-sm text-night-soft">Advies, engineering en handel in machines voor de tuinbouw. Importeur van DEMTEC sinds 1998.</p>
      </div>
      <div class="md:col-span-4 text-sm leading-7">
        <p>Jade 224<br />3316 LJ Dordrecht</p>
        <p class="mt-3"><a class="hover:underline" href="tel:+31786737201">078 673 72 01</a><br /><a class="hover:underline" href="tel:+31653696509">06 53 69 65 09</a><br /><a class="hover:underline break-all" href="mailto:natech@zonnet.nl">natech@zonnet.nl</a></p>
      </div>
      <div class="md:col-span-3 text-sm leading-7">
        <p>Bel of mail voor een afspraak</p>
        <p class="mt-3"><a class="hover:underline" href={u('privacy/')}>Privacyverklaring</a></p>
        <p class="text-night-soft">KvK [[AANLEVEREN: KvK-nummer]]</p>
      </div>
    </div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 pb-8">
      <p class="border-t border-ink-soft pt-6 text-xs text-night-soft">© {new Date().getFullYear()} Natech</p>
    </div>
  </footer>
</body>
</html>
