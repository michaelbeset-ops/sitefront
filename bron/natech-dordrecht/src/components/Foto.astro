---
// Vaste bestanden in public/img/ (zie public/img/FOTOS.md en scripts/fotos-ophalen.mjs).
// Elke foto bestaat in twee breedtes, als webp en jpg: <naam>.{webp,jpg} en <naam>-<klein>.{webp,jpg}.
import fotos from '../fotos.json';

interface Props {
  naam: keyof typeof fotos;
  alt: string;
  sizes: string;
  class?: string;
  eager?: boolean;
}
const { naam, alt, sizes, class: cls = '', eager = false } = Astro.props;
const f = fotos[naam];
const dir = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/img`;
const set = (ext: string) => `${dir}/${naam}-${f.klein}.${ext} ${f.klein}w, ${dir}/${naam}.${ext} ${f.w}w`;
---
<picture class="contents">
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={`${dir}/${naam}.jpg`}
    srcset={set('jpg')}
    sizes={sizes}
    width={f.w}
    height={f.h}
    alt={alt}
    class={cls}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
  />
</picture>
