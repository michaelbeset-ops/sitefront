---
// Woordmerk nagetekend naar hun eigen logo: magenta wig, NATECH, limoen wig.
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<svg viewBox="0 0 170 56" role="img" aria-label="Natech">
  <polygon points="6,9 160,2 160,13 6,13" fill="#ad308c" />
  <text x="83" y="38" text-anchor="middle" font-family="Schibsted Grotesk, Arial, sans-serif" font-weight="900" font-size="27" letter-spacing="1" fill={licht ? '#f3f4f0' : '#16181a'}>NATECH</text>
  <polygon points="6,43 160,43 160,54 6,47" fill="#96c919" />
</svg>
