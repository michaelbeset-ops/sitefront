---
import { site, url, machines, waAlgemeen } from '../data/site';
import Logo from './Logo.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk"><Logo licht /></a>
      <p class="mt-6 max-w-xs">Advies, engineering en handel. Sinds 1998 dealer en importeur van DEMTEC-machines voor de tuinbouw.</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">DEMTEC-machines</p>
      <ul class="mt-4 space-y-2">{machines.map((d) => <li><a href={h('machines')} class="no-underline hover:text-limoen">{d}</a></li>)}<li><a href={h('service')} class="no-underline hover:text-limoen">Service en storingen</a></li></ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline hover:text-limoen">{site.tel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-limoen">{site.mail}</a></li>
        <li><a href={waAlgemeen} class="no-underline hover:text-limoen">WhatsApp</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Adres</p>
      <ul class="mt-4 space-y-2">
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li>{site.terrein}</li>
        <li><a href={site.maps} class="no-underline hover:text-limoen">Route plannen</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {new Date().getFullYear()} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-limoen">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Machinefoto’s van natechhandel.nl. Sfeerfoto’s via Unsplash, ter illustratie.</p>}
  </div>
</footer>
