---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;

// Productgroepen zoals ze op hun eigen site staan.
const machines = ['Overzetten en bufferen', 'Grond- en producttransport', 'Grondvoorraadbunkers', 'Compostzeefinstallaties'];
---
<Base
  title="Natech | DEMTEC-machines voor de tuinbouw, Dordrecht"
  description="Natech uit Dordrecht: advies, engineering en handel in tuinbouwmachines. Dealer en importeur van DEMTEC sinds 1998. Ook service, onderhoud en storingen."
>
  <!-- Hero: kasfoto met donker verloop links voor de tekst. Zakelijk en rustig voor een B2B-bezoeker. -->
  <section class="relative isolate bg-night text-paper">
    <div class="absolute inset-0 -z-10 [&_img]:h-full [&_img]:w-full [&_img]:object-cover">
      <Foto naam="hero" alt="Lange kas met rijen jonge plantjes" sizes="100vw" eager />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(20_32_26/0.92)_0%,rgb(20_32_26/0.75)_45%,rgb(20_32_26/0.15)_80%)]"></div>
    <div class="absolute inset-0 -z-10 bg-[rgb(20_32_26/0.55)] lg:hidden"></div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 min-h-[34rem] sm:min-h-[40rem] lg:min-h-[44rem] flex flex-col justify-center py-20">
      <p class="text-sm font-semibold tracking-[0.12em] uppercase text-accent-light">Sinds 1998 · Dordrecht</p>
      <h1 class="mt-4 text-4xl max-w-[14ch]">Machines voor de tuinbouw</h1>
      <p class="mt-6 max-w-lg text-lg text-paper/90">Natech is dealer en importeur van DEMTEC-machines. We adviseren over uw bedrijfsontwikkeling, leveren de machines en verzorgen service en onderhoud.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={u('#contact')} class="inline-flex bg-accent-light text-ink font-semibold px-5 py-3 hover:bg-paper transition-colors">Vraag een prijsopgave</a>
        <a href="tel:+31653696509" class="inline-flex border border-paper/70 px-5 py-3 hover:bg-paper hover:text-ink transition-colors">Bel Herman, 06 53 69 65 09</a>
      </div>
    </div>
  </section>

  <section id="machines" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="text-3xl">DEMTEC-machines</h2>
      <p class="mt-5 text-ink-soft">Door jarenlange ervaring in de mechanisatie van de tuinbouw weten we welke oplossing past bij uw bedrijf.</p>
    </div>
    <ul class="lg:col-span-8 min-w-0 grid sm:grid-cols-2 border-t-2 border-ink">
      {machines.map((m, i) => (
        <li class="py-7 pr-6 border-b border-line flex gap-5">
          <span class="display text-xl text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <span class="min-w-0"><span class="display text-xl block hyphens-auto [overflow-wrap:anywhere]">{m}</span><span class="mt-1 block text-sm text-ink-soft">[[AANLEVEREN: korte uitleg en foto]]</span></span>
        </li>
      ))}
    </ul>
  </section>

  <section id="service" class="bg-paper-2">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-5 order-2 lg:order-1">
        <h2 class="text-3xl">Service, onderhoud en storingen</h2>
        <p class="mt-6 text-ink-soft">Ook voor service, onderhoud, reparatie en storingen aan uw machines bent u bij Natech aan het goede adres.</p>
        <p class="mt-3 text-sm text-ink-soft">[[AANLEVEREN: servicegebied en hoe snel jullie bij een storing komen]]</p>
        <a href="tel:+31786737201" class="mt-8 inline-block font-semibold underline">Bel 078 673 72 01</a>
      </div>
      <div class="lg:col-span-7 order-1 lg:order-2 [&_img]:w-full [&_img]:h-auto">
        <Foto naam="grond" alt="Hand met potgrond" sizes="(min-width: 1024px) 55vw, 100vw" />
      </div>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 class="text-3xl">Contact</h2>
      <p class="mt-5 text-ink-soft">Voor meer informatie of een vrijblijvende prijsopgave.</p>
      <dl class="mt-8 grid gap-4">
        <div><dt class="text-sm text-ink-soft">Verkoop</dt><dd>Herman Naaktgeboren, <a class="font-semibold hover:text-accent" href="tel:+31653696509">06 53 69 65 09</a></dd></div>
        <div><dt class="text-sm text-ink-soft">Kantoor</dt><dd><a class="hover:text-accent" href="tel:+31786737201">078 673 72 01</a></dd></div>
        <div><dt class="text-sm text-ink-soft">E-mail</dt><dd><a class="hover:text-accent break-all" href="mailto:natech@zonnet.nl">natech@zonnet.nl</a></dd></div>
        <div><dt class="text-sm text-ink-soft">Adres</dt><dd>Jade 224, 3316 LJ Dordrecht<br /><span class="text-sm text-ink-soft">Bedrijventerrein Dordtse Kil III</span></dd></div>
      </dl>
    </div>
    <form class="lg:col-span-6 lg:col-start-7 grid gap-5" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-key]]" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2 text-sm">Naam<input name="naam" required autocomplete="name" class="bg-paper border border-line px-3 py-3 text-base" /></label>
        <label class="grid gap-2 text-sm">Bedrijf<input name="bedrijf" autocomplete="organization" class="bg-paper border border-line px-3 py-3 text-base" /></label>
      </div>
      <label class="grid gap-2 text-sm">Telefoon of e-mail<input name="contact" required class="bg-paper border border-line px-3 py-3 text-base" /></label>
      <label class="grid gap-2 text-sm">Uw vraag<textarea name="bericht" rows="4" class="bg-paper border border-line px-3 py-3 text-base"></textarea></label>
      {voorstel ? (
        <p class="border border-accent px-4 py-3 text-sm">Dit is een ontwerpvoorstel, dus het formulier verstuurt nog niets. Bel <a class="underline" href="tel:+31653696509">06 53 69 65 09</a> of mail <a class="underline" href="mailto:natech@zonnet.nl">natech@zonnet.nl</a>.</p>
      ) : (
        <button type="submit" class="justify-self-start bg-accent text-paper font-semibold px-6 py-3 hover:bg-accent-deep">Vraag prijsopgave aan</button>
      )}
      <p class="text-xs text-ink-soft">We gebruiken uw gegevens alleen voor uw aanvraag. Zie de <a class="underline" href={u('privacy/')}>privacyverklaring</a>.</p>
    </form>
  </section>
</Base>
