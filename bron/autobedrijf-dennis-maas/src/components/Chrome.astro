---
import { site, url } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const thuis = Astro.url.pathname.replace(/\/$/, '') === url('').replace(/\/$/, '');
const anker = (id: string) => (thuis ? `#${id}` : `${url('')}#${id}`);
const menu = [
  { id: 'welkom', label: 'Welkom' },
  { id: 'werkplaats', label: 'Werkplaats' },
  { id: 'occasions', label: 'Occasions' },
  { id: 'hulp', label: 'Aanvraag' },
  { id: 'contact', label: 'Route en contact' },
];
const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const wa = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.6-.3Z"/></svg>`;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="min-w-0 no-underline"><Logo /></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-6 text-sm font-semibold">
          {menu.map((m) => <li><a href={anker(m.id)} class="no-underline underline-offset-4 transition-colors hover:text-turkoois hover:underline">{m.label}</a></li>)}
        </ul>
      </nav>
      <div class="flex flex-none items-center gap-2">
        <a href={site.whatsapp} class="btn btn-line hidden !px-3.5 !py-2 text-turkoois sm:inline-flex"><Fragment set:html={wa} /><span class="text-sm">WhatsApp</span></a>
        <a href={site.telHref} class="btn btn-turkoois !px-3.5 !py-2 text-sm">
          <Fragment set:html={tel} />
          <span class="sm:hidden">Bel</span><span class="hidden whitespace-nowrap tabular-nums sm:inline">{site.tel}</span>
        </a>
      </div>
    </div>
  </header>
) : (
  <footer class="donker bg-diep py-14 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo licht />
        <p class="mt-5">{site.straat}<br />{site.postcode} {site.plaats}<br />KvK <span class="text-white/75">{site.kvk}</span></p>
      </div>
      <p class="md:col-span-4">
        Tel. <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br />
        Mob. <a href={site.mobielHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.mobiel}</a><br />
        <a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a>
      </p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 text-xs text-white/75">Sfeerfoto's via Unsplash en een foto van de huidige website, ter illustratie. Bij oplevering vervangen we ze door nieuwe eigen foto's.</p>}
  </footer>
)}
