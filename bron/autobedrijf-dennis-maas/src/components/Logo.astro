---
// Wordmark naar hun eigen logo en gevelbord: het dunne M-D-monogram met de groene weg-swoosh eronder,
// "AUTOBEDRIJF" klein en "DENNIS MAAS" vet in turkoois, zoals op de gevel.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2 leading-none ${cls}`}>
  <span class="sr-only">Autobedrijf Dennis Maas</span>
  <svg viewBox="0 0 52 40" class="h-8 w-auto flex-none sm:h-10" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 29 13 5l8 17 8-17 2 24" class={licht ? 'stroke-white' : 'stroke-ink'} stroke-width="2.6" />
    <path d="M29 5c16 0 18 24 2 24" class={licht ? 'stroke-mint' : 'stroke-turkoois'} stroke-width="2.6" />
    <path d="M2 36c10-5 18 1 27-2s14-7 21-5" class={licht ? 'stroke-mint' : 'stroke-groen'} stroke-width="3.4" />
    <path d="M2 36c10-5 18 1 27-2s14-7 21-5" class={licht ? 'stroke-petrol' : 'stroke-paper'} stroke-width=".8" stroke-dasharray="2.5 2.5" />
  </svg>
  <span aria-hidden="true" class="flex flex-col font-display">
    <span class={`text-[0.58rem] font-bold tracking-[0.3em] sm:text-[0.66rem] ${licht ? 'text-white/85' : 'text-ink'}`}>AUTOBEDRIJF</span>
    <span class={`mt-[3px] text-[1.2rem] sm:text-[1.42rem] font-black tracking-[0.01em] ${licht ? 'text-mint' : 'text-turkoois'}`}>DENNIS MAAS</span>
  </span>
</span>
