---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-white/10 bg-ink text-paper">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-2xl font-extrabold italic tracking-[-0.04em] no-underline">DSR <span class="text-red">Cars</span></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href="#voorraad" class="no-underline hover:text-white/70">Occasions</a></li>
          <li><a href="#werkplaats" class="no-underline hover:text-white/70">Werkplaats</a></li>
          <li><a href="#financiering" class="no-underline hover:text-white/70">Financiering</a></li>
          <li><a href="#contact" class="no-underline hover:text-white/70">Contact</a></li>
        </ul>
      </nav>
      <a href={site.mobielHref} class="btn btn-red !px-3.5 !py-2 text-sm">Bel Dris</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-paper/75">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-paper">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK {site.kvk}</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Auto's: jullie eigen advertentiefoto's via VWE. Overige sfeerfoto's via Unsplash, ter illustratie.</p>}
  </footer>
)}
