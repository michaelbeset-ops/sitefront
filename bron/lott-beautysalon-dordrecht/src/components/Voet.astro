---
import Logo from './Logo.astro';
import { site, url } from '../data/site';
---
<footer class="op-donker bg-inkt text-creme">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo class="text-[clamp(3.5rem,3rem+3vw,5rem)]" />
      <p class="mt-4 max-w-sm text-sm text-creme/80">Beautysalon aan de Voorstraat in {site.plaats}. Nagels, wenkbrauwen en wimpers.</p>
    </div>
    <div class="text-sm md:col-span-4">
      <p class="font-semibold">Langskomen</p>
      <p class="mt-3 text-creme/80">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.mobielHref} class="underline-offset-4 hover:underline">{site.mobiel}</a><br /><a href={site.boeken} class="underline-offset-4 hover:underline">Online een afspraak maken</a></p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="font-semibold">Meer</p>
      <p class="mt-3"><a href={site.route} class="underline underline-offset-4">Route in Google Maps</a><br /><a href={url('privacy/')} class="underline underline-offset-4">Privacyverklaring</a></p>
    </div>
  </div>
  <div class="wrap border-t border-creme/15 py-5 text-xs text-creme/70">
    <p>De foto's op deze site zijn sfeerbeelden van Unsplash.</p>
  </div>
</footer>
