---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Visgraat from '../components/Visgraat.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const route = 'https://www.google.com/maps/search/?api=1&query=Gijbelandsedijk+117+2974+VH+Brandwijk';

const onderwerpen = [
  ['vloer', 'Een vloer'],
  ['zonwering', 'Zonwering, horren of rolluiken'],
  ['renovatie', 'Vloer- of traprenovatie'],
  ['anders', 'Iets anders'],
];
const arrow = 'M5 12h14M13 6l6 6-6 6';
---
<Base
  title="Deelen Parket- en Zonwering | Vloeren en zonwering in Brandwijk"
  description="Parket, lamelparket, laminaat, binnen- en buitenzonwering, horren, rolluiken en vloerrenovatie. Showroom in Brandwijk, zaterdag open van 9.00 tot 15.00. Gratis offerte met vrijblijvend huisbezoek."
>
  <Header />
  <main id="inhoud">
    <!-- HERO: schermvullende foto, tekst eroverheen -->
    <section class="relative isolate flex min-h-[calc(100svh-4rem)] overflow-hidden bg-walnut text-paper on-dark">
      <Foto naam="hero" eager sizes="100vw" alt="Sfeerbeeld: eiken visgraatvloer in een lichte woonkamer" class="absolute inset-0 -z-20 h-full w-full" />
      <!-- donkere verloop onder de tekst: houdt contrast boven 4.5:1, ongeacht de foto -->
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-linear-to-t from-ink/95 via-ink/65 to-ink/25 lg:bg-linear-to-r lg:from-ink/90 lg:via-ink/60 lg:to-ink/10"></div>

      <div class="relative mx-auto w-full max-w-[1240px] px-4 sm:px-6 lg:px-10 pt-24 pb-10 lg:pt-28 lg:pb-14 flex flex-col justify-end">
        <div class="hidden lg:block lg:absolute lg:top-10 lg:right-10 self-start bg-walnut/95 rounded-sm shadow-soft max-w-[16rem] overflow-hidden">
          <Visgraat id="vg-bord" class="block w-full h-3" unit={4} />
          <div class="px-4 py-3">
            <p class="kicker text-oak">Showroom open</p>
            <p class="font-display font-extrabold tracking-[-0.02em] text-lg leading-tight mt-1">Zaterdag 9.00 tot 15.00</p>
            <p class="text-xs mt-1 text-oak-light">Doordeweeks op afspraak, ook 's avonds</p>
          </div>
        </div>

        <div class="order-1 lg:order-none">
          <p class="kicker text-oak">Brandwijk, Alblasserwaard</p>
          <h1 class="mt-4 text-hero max-w-[15ch]">Parket onder uw voeten, zonwering voor uw ramen.</h1>
          <p class="mt-6 text-lg max-w-[46ch] text-oak-light">
            Al ruim 25 jaar leggen wij parketvloeren en hangen we binnen- en buitenzonwering. Kom kijken in de showroom aan de Gijbelandsedijk, of we komen vrijblijvend bij u thuis voor advies en een gratis offerte.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn-rust" href="#offerte">Huisbezoek aanvragen
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
            </a>
            <a class="btn btn-line hover:!bg-paper/10" href="#showroom">Showroom: zaterdag 9.00 tot 15.00</a>
          </div>
        </div>

        <div class="order-3 lg:order-none mt-10 lg:mt-14 max-w-[820px]">
          <p class="text-sm font-semibold">Direct een offerte voor:</p>
          <ul class="mt-3 grid grid-cols-1 min-[480px]:grid-cols-3 border-t border-paper/30">
            {[['vloer', 'Vloer', 'Parket, lamelparket, laminaat'], ['zonwering', 'Zonwering', 'Binnen, buiten, horren, rolluiken'], ['renovatie', 'Renovatie', 'Schuren, repareren, trappen']].map(([k, t, s]) => (
              <li class="border-b border-paper/30 min-[480px]:border-b-0 min-[480px]:border-r last:border-r-0">
                <a href="#offerte" data-onderwerp={k} class="group block py-4 min-[480px]:px-4 min-[480px]:first:pl-0 hover:text-oak">
                  <span class="font-display font-extrabold tracking-[-0.03em] text-xl flex items-center justify-between gap-2">{t}
                    <svg class="transition-transform group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="2.2"/></svg>
                  </span>
                  <span class="block text-xs text-oak-light mt-1">{s}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- VLOEREN -->
    <section id="vloeren" class="border-t border-line">
      <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 py-16 lg:py-24 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div class="lg:sticky lg:top-24 self-start">
          <p class="kicker text-rust">01 · Vloeren</p>
          <h2 class="mt-3 text-3xl">Een vloer kiest u met de monsters in de hand.</h2>
          <p class="mt-5 text-muted max-w-[42ch]">In de showroom ligt een uitgebreide collectie. Twijfelt u? Dan komen we met monsterpanelen bij u thuis, zodat u ziet hoe het hout staat bij uw eigen licht en meubels.</p>
          <a class="btn btn-rust mt-7" href="#offerte" data-onderwerp="vloer">Offerte voor een vloer</a>
        </div>
        <div>
          <div class="grid gap-10 md:grid-cols-2">
            <article class="md:col-span-2">
              <h3 class="text-2xl">Parket</h3>
              <p class="mt-3 max-w-[60ch]">Massief of meerlaags, in een patroon of in lange delen. Leverbaar gerookt of verouderd, en afgewerkt met lak, olie, was of hardwax.</p>
              <ul class="lijst mt-5 grid sm:grid-cols-2 sm:gap-x-8 text-sm">
                <li><strong>Tapis</strong>: visgraat, blokmotief, Hongaarse punt</li>
                <li><strong>Bourgogne</strong>: vaste of wisselende breedte, ook grote visgraat</li>
                <li><strong>Massieve vloerdelen</strong>: 70 tot 230 mm breed</li>
                <li><strong>Mozaïek</strong>: voor diverse blokmotieven</li>
              </ul>
            </article>
            <article>
              <h3 class="text-xl">Lamelparket</h3>
              <p class="mt-3 text-sm">Een multiplex onderlaag met een massieve toplaag. Daardoor stabiel en geschikt voor vloerverwarming.</p>
              <ul class="lijst mt-4 text-sm">
                <li>Planken van 18 tot 26 cm breed</li>
                <li>Gerookt, gestoomd of verouderd</li>
                <li>Makkelijk schoon te houden</li>
              </ul>
            </article>
            <article>
              <h3 class="text-xl">Laminaat</h3>
              <p class="mt-3 text-sm">Een HDF-drager met een geharde toplaag, gelegd op een geluidsdempende ondervloer. Oogt als hout, vraagt weinig onderhoud.</p>
              <ul class="lijst mt-4 text-sm">
                <li>De volledige collectie van Quick-Step</li>
                <li>Met of zonder vellingkant</li>
                <li>Veel dessins, kleuren en diktes</li>
              </ul>
            </article>
          </div>
          <Foto naam="vloer-1" sizes="(min-width: 1024px) 720px, 100vw" alt="Sfeerbeeld: lange eiken vloerdelen in een woonkamer" class="mt-12 w-full aspect-[16/9] md:aspect-[2000/860] rounded-sm" />
        </div>
      </div>
    </section>

    <!-- ZONWERING -->
    <section id="zonwering" class="bg-walnut text-oak-light on-dark">
      <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 py-16 lg:py-24">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="kicker text-oak">02 · Zonwering</p>
            <h2 class="mt-3 text-3xl text-paper max-w-[18ch]">Van rolgordijn tot pergola, op maat gehangen.</h2>
          </div>
          <p class="max-w-[38ch] text-sm">Handbediend, elektrisch of weersafhankelijk. En geen scherm is ons te groot om te plaatsen.</p>
        </div>

        <Foto naam="zonwering-1" sizes="(min-width: 1240px) 1160px, 100vw" alt="Sfeerbeeld: knikarmscherm boven een terras" class="mt-10 w-full aspect-[16/9] md:aspect-[2000/860] rounded-sm" />

        <div class="mt-12 grid gap-12 md:grid-cols-2">
          <div>
            <h3 class="text-xl text-paper">Binnenzonwering</h3>
            <ul class="lijst mt-4 text-sm">
              <li><strong class="text-paper">Rolgordijnen</strong>, in veel kleuren en motieven, ook verduisterend</li>
              <li><strong class="text-paper">Verticale lamellen</strong> in stof, aluminium, pvc of geluiddempend acoustikdrape</li>
              <li><strong class="text-paper">Jaloezieën</strong> van Lega: aluminium 16 tot 50 mm, hout 50 of 63 mm</li>
              <li><strong class="text-paper">VELUX</strong>-zonwering voor dakramen</li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl text-paper">Buitenzonwering</h3>
            <ul class="lijst mt-4 text-sm">
              <li><strong class="text-paper">Knikarm- en terrasschermen</strong>, met vrije doorloop eronder</li>
              <li><strong class="text-paper">Markiezen en uitvalschermen</strong></li>
              <li><strong class="text-paper">Screens en zip screens</strong>, zicht naar buiten zonder inkijk</li>
              <li><strong class="text-paper">Serre, pergola en veranda</strong>: Serrano en Madeira</li>
            </ul>
          </div>
        </div>

        <div class="mt-14 grid gap-px bg-walnut-2 md:grid-cols-[1fr_1fr_1.1fr] rounded-sm overflow-hidden">
          <div class="bg-walnut py-6 md:pr-6">
            <h3 class="text-xl text-paper">Horren</h3>
            <p class="mt-2 text-sm">Rolhorren, inzethorren, plissé­horren en rolhordeuren. Ramen open, insecten buiten.</p>
          </div>
          <div class="bg-walnut py-6 md:px-6">
            <h3 class="text-xl text-paper">Rolluiken</h3>
            <p class="mt-2 text-sm">Houden warmte, kou en inkijk tegen, en dempen geluid. In vele kleuren en vier prijsklassen.</p>
          </div>
          <div class="bg-walnut py-6 md:pl-6 flex flex-col justify-between gap-5">
            <p class="text-sm">Bekijk de mogelijkheden in de showroom, of laat ons de maat opnemen bij u thuis.</p>
            <a class="btn btn-rust self-start" href="#offerte" data-onderwerp="zonwering">Offerte voor zonwering</a>
          </div>
        </div>
      </div>
    </section>

    <!-- RENOVATIE -->
    <section id="renovatie" class="bg-paper-2">
      <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 py-16 lg:py-24">
        <p class="kicker text-rust">03 · Renovatie</p>
        <h2 class="mt-3 text-3xl max-w-[20ch]">Gespecialiseerd in het renoveren van vloeren.</h2>
        <p class="mt-5 max-w-[56ch] text-muted">Bijna elke parketvloer is te schuren. Daarna ziet hij er weer als nieuw uit. We komen eerst kijken, dan krijgt u advies.</p>

        <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-0">
          <article class="lg:pr-12 lg:border-r border-line">
            <p class="font-display font-extrabold tracking-[-0.04em] text-hero leading-none text-rust">1 tot 2 dagen</p>
            <h3 class="mt-4 text-xl">Vloerrenovatie</h3>
            <p class="mt-2 text-sm max-w-[48ch]">Zo lang duurt het meestal. Wij schuren stofarm, repareren en helen aan waar nodig. Daarna afwerken met lak, olie of hardwax, en desgewenst inkleuren.</p>
          </article>
          <article class="lg:pl-12">
            <p class="font-display font-extrabold tracking-[-0.04em] text-hero leading-none text-rust">In een dag</p>
            <h3 class="mt-4 text-xl">Traprenovatie</h3>
            <p class="mt-2 text-sm max-w-[48ch]">Maken wij van uw oude trap een eiken trap. Andere houtsoorten en kleuren kunnen ook, net als laminaat in veel dessins.</p>
          </article>
        </div>

        <div class="mt-12 grid gap-3 grid-cols-2 sm:gap-4">
          <Foto naam="renovatie-1" sizes="(min-width: 1240px) 580px, 50vw" alt="Sfeerbeeld: geschuurde eiken vloer, close-up van de nerf" class="w-full aspect-[4/5] sm:aspect-[4/3] rounded-sm" />
          <Foto naam="renovatie-2" sizes="(min-width: 1240px) 580px, 50vw" alt="Sfeerbeeld: houten trap met eiken treden" class="w-full aspect-[4/5] sm:aspect-[4/3] rounded-sm" />
        </div>

        <div class="mt-12 grid gap-8 md:grid-cols-[1fr_1fr_auto] md:items-start border-t border-line pt-8">
          <div>
            <h3 class="text-lg">Onderhoud op voorraad</h3>
            <p class="mt-2 text-sm text-muted">Reinigers, polish, onderhoudsolie, hardwaxolie, was en lakken. Altijd op voorraad in de showroom.</p>
          </div>
          <div>
            <h3 class="text-lg">Reparatie van vloer of scherm</h3>
            <p class="mt-2 text-sm text-muted">Ook onderdelen voor zonwering: windwerk, band, staaldraad en elektrische bediening, achteraf in te bouwen.</p>
          </div>
          <a class="btn btn-rust" href="#offerte" data-onderwerp="renovatie">Vloer laten bekijken</a>
        </div>
      </div>
    </section>

    <!-- WERKWIJZE -->
    <section class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 py-16 lg:py-24">
      <h2 class="text-2xl max-w-[22ch]">Zo gaat een huisbezoek</h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['U belt, mailt of vult het formulier in.', 'Zeg erbij of het om een vloer, zonwering of renovatie gaat.'],
          ['We komen vrijblijvend langs.', 'Met monsterpanelen voor een nieuwe vloer, of om uw oude vloer eerst te bekijken.'],
          ['U krijgt advies en een offerte.', 'Gratis, en u zit nergens aan vast.'],
          ['Wij leggen, schuren of hangen.', 'Alleen met kwaliteitsproducten.'],
        ].map(([t, s], i) => (
          <li class="border-t-2 border-ink pt-4">
            <span class="font-display font-extrabold text-rust text-xl">{i + 1}</span>
            <p class="mt-2 font-semibold">{t}</p>
            <p class="mt-1 text-sm text-muted">{s}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- SHOWROOM -->
    <section id="showroom" class="border-t border-line">
      <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 py-16 lg:py-24 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14 items-center">
        <Foto naam="showroom" sizes="(min-width: 1024px) 620px, 100vw" alt="Sfeerbeeld: stalen van houten vloerdelen naast elkaar" class="w-full aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[420px] rounded-sm order-2 lg:order-1" />
        <div class="order-1 lg:order-2">
          <p class="kicker text-rust">Showroom</p>
          <h2 class="mt-3 text-3xl">Zaterdag staat de deur open.</h2>
          <p class="mt-5 text-muted max-w-[44ch]">Loop binnen in Brandwijk en bekijk vloeren en zonwering in het echt. Doordeweeks kan het ook, op afspraak en ook 's avonds.</p>

          <dl class="mt-8 bg-walnut text-oak-light on-dark rounded-sm p-6 sm:p-7 shadow-soft">
            <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 pb-4 border-b border-walnut-2">
              <dt class="font-semibold text-paper">Zaterdag</dt>
              <dd class="font-display font-extrabold text-paper text-lg">9.00 tot 15.00</dd>
            </div>
            <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-4 border-b border-walnut-2">
              <dt class="font-semibold text-paper">Maandag t/m vrijdag</dt>
              <dd>Op afspraak, ook 's avonds</dd>
            </div>
            <div class="pt-4">
              <dt class="sr-only">Adres</dt>
              <dd>Gijbelandsedijk 117, 2974 VH Brandwijk</dd>
            </div>
          </dl>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="btn btn-line" href={route} rel="noopener" target="_blank">Route plannen<span class="sr-only"> (opent Google Maps)</span></a>
            <a class="btn btn-line" href="tel:+31184642691">Afspraak: 0184 64 26 91</a>
          </div>
        </div>
      </div>
    </section>

    <!-- OFFERTE -->
    <section id="offerte" class="bg-paper-2 border-t border-line">
      <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 py-16 lg:py-24 grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="kicker text-rust">Gratis offerte</p>
          <h2 class="mt-3 text-3xl">Vraag een huisbezoek aan.</h2>
          <p class="mt-5 text-muted max-w-[40ch]">Vertel kort wat u zoekt. Wij nemen contact op en plannen een moment dat u past, overdag of 's avonds.</p>
          <div class="mt-8 space-y-3 text-sm">
            <p>Liever direct bellen?</p>
            <p><a class="font-display font-extrabold text-2xl tracking-[-0.03em] hover:text-rust" href="tel:+31650557586">06 50 55 75 86</a></p>
            <p><a class="font-semibold hover:text-rust" href="tel:+31184642691">0184 64 26 91</a> · <a class="font-semibold hover:text-rust underline underline-offset-2" href="mailto:info@deelenparket.nl">info@deelenparket.nl</a></p>
          </div>
        </div>

        <form class="bg-paper rounded-sm p-5 sm:p-8 shadow-soft" action={voorstel ? undefined : 'https://api.web3forms.com/submit'} method="post">
          {!voorstel && <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms access key]]" />}
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <fieldset>
            <legend class="font-semibold">Waar gaat het om?</legend>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              {onderwerpen.map(([v, l], i) => (
                <label class="flex items-center gap-3 border border-line rounded-sm px-3 py-3 cursor-pointer has-[:checked]:border-rust has-[:checked]:bg-paper-2 text-sm">
                  <input type="radio" name="onderwerp" value={v} checked={i === 0} class="accent-[#9c4119] size-4" />
                  {l}
                </label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-6">
            <legend class="font-semibold">Hoe wilt u verder?</legend>
            <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
              {['Huisbezoek', 'Afspraak in de showroom', 'Eerst even bellen'].map((l, i) => (
                <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="voorkeur" value={l} checked={i === 0} class="accent-[#9c4119] size-4" />{l}</label>
              ))}
            </div>
          </fieldset>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {[['naam', 'Naam', 'text', 'name'], ['telefoon', 'Telefoon', 'tel', 'tel'], ['email', 'E-mail', 'email', 'email'], ['plaats', 'Woonplaats', 'text', 'address-level2']].map(([n, l, t, a]) => (
              <label class="block text-sm font-semibold">{l}
                <input name={n} type={t} autocomplete={a} required={n === 'naam'} class="mt-1.5 block w-full bg-paper border border-line rounded-sm px-3 py-2.5 font-normal focus:border-rust" />
              </label>
            ))}
          </div>
          <label class="block mt-4 text-sm font-semibold">Wat wilt u laten doen?
            <textarea name="bericht" rows="4" class="mt-1.5 block w-full bg-paper border border-line rounded-sm px-3 py-2.5 font-normal focus:border-rust" placeholder="Bijvoorbeeld: eiken vloer in woonkamer, ongeveer 40 m2"></textarea>
          </label>
          {voorstel ? (
            <p class="mt-6 text-sm bg-oak-light rounded-sm p-4" role="note">
              Dit is een ontwerpvoorstel: dit formulier verstuurt nog niets. Mail of bel Deelen Parket- en Zonwering rechtstreeks via <a class="underline font-semibold" href="mailto:info@deelenparket.nl">info@deelenparket.nl</a> of <a class="underline font-semibold" href="tel:+31650557586">06 50 55 75 86</a>.
            </p>
          ) : (
            <div class="mt-6 flex flex-wrap items-center gap-4">
              <button type="submit" class="btn btn-rust">Aanvraag versturen</button>
              <p class="text-xs text-muted">We gebruiken uw gegevens alleen om contact op te nemen. Zie de <a class="underline" href={`${b}privacy/`}>privacyverklaring</a>.</p>
            </div>
          )}
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    // Knoppen bij een product zetten het onderwerp in het formulier alvast goed.
    document.querySelectorAll('[data-onderwerp]').forEach(function (a) {
      a.addEventListener('click', function () {
        var r = document.querySelector('input[name="onderwerp"][value="' + a.dataset.onderwerp + '"]');
        if (r) r.checked = true;
      });
    });
  </script>
</Base>
