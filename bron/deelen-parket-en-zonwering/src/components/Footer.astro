---
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer class="bg-ink text-oak-light on-dark">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 py-14 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display font-extrabold tracking-[-0.03em] text-2xl text-paper">Deelen Parket- en Zonwering</p>
      <p class="mt-3 max-w-[34ch] text-sm">Parket, lamelparket, laminaat, binnen- en buitenzonwering, horren, rolluiken en renovatie. Vanuit Brandwijk.</p>
    </div>
    <div class="text-sm">
      <p class="kicker text-oak mb-3">Adres</p>
      <p>Gijbelandsedijk 117<br />2974 VH Brandwijk</p>
      <p class="mt-3">KvK [[AANLEVEREN: KvK-nummer]]</p>
    </div>
    <div class="text-sm">
      <p class="kicker text-oak mb-3">Contact</p>
      <ul class="space-y-1">
        <li><a class="hover:text-paper underline-offset-2 hover:underline" href="tel:+31650557586">06 50 55 75 86</a></li>
        <li><a class="hover:text-paper underline-offset-2 hover:underline" href="tel:+31184642691">0184 64 26 91</a></li>
        <li><a class="hover:text-paper underline-offset-2 hover:underline" href="mailto:info@deelenparket.nl">info@deelenparket.nl</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-walnut-2">
    <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 py-5 flex flex-wrap gap-x-6 gap-y-2 text-xs">
      <span>© Deelen Parket- en Zonwering</span>
      <a class="underline underline-offset-2 hover:text-paper" href={`${b}privacy/`}>Privacyverklaring</a>
      <span>Foto's op deze site zijn sfeerbeelden, geen eigen projecten.</span>
    </div>
  </div>
</footer>
