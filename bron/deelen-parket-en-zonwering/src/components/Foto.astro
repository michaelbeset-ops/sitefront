---
// Gewone <img> met srcset uit fotos-spec.mjs. Bewust geen Astro <Image>: de
// bestanden in public/img/ worden los vervangen door scripts/fotos-ophalen.mjs.
import { fotos, bestand } from '../../scripts/fotos-spec.mjs';
interface Props { naam: keyof typeof fotos; alt: string; sizes: string; class?: string; eager?: boolean }
const { naam, alt, sizes, class: cls = '', eager = false } = Astro.props;
const spec = fotos[naam];
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = (w: number) => `${b}img/${bestand(naam, w)}`;
const srcset = spec.breedtes.map((w) => `${src(w)} ${w}w`).join(', ');
---
<img
  src={src(spec.breedtes[0])}
  srcset={srcset}
  sizes={sizes}
  width={spec.w}
  height={spec.h}
  alt={alt}
  class={`object-cover ${cls}`}
  style={`background-color:${spec.tint}`}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : undefined}
/>
