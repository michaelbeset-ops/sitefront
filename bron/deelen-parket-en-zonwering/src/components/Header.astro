---
const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const nav = [
  ['Vloeren', 'vloeren'],
  ['Zonwering', 'zonwering'],
  ['Renovatie', 'renovatie'],
  ['Showroom', 'showroom'],
  ['Offerte', 'offerte'],
];
---
<header class="sticky top-0 z-40 bg-paper/95 backdrop-blur-sm border-b border-line">
  <div class="mx-auto max-w-[1240px] px-4 sm:px-6 lg:px-10 h-16 flex items-center justify-between gap-4">
    <a href={b} class="flex items-center gap-3 min-w-0" aria-label="Deelen Parket &amp; Zonwering, naar de homepage">
      <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true" class="shrink-0">
        <rect width="30" height="30" rx="3" fill="#3b2718" />
        <path d="M6 20 L15 11 L24 20 M6 25 L15 16 L24 25" fill="none" stroke="#d9b98c" stroke-width="2.6" />
      </svg>
      <span class="font-display font-extrabold tracking-[-0.03em] leading-none text-lg truncate">
        Deelen <span class="hidden min-[400px]:inline font-semibold text-muted">Parket &amp; Zonwering</span>
      </span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-sm font-semibold">
        {nav.map(([l, h]) => <li><a class="hover:text-rust" href={`${b}#${h}`}>{l}</a></li>)}
      </ul>
    </nav>
    <a href="tel:+31650557586" class="btn btn-rust !py-2.5 !px-4 text-sm shrink-0">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      <span class="hidden sm:inline">06 50 55 75 86</span><span class="sm:hidden">Bellen</span>
    </a>
  </div>
</header>
