---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, soorten, reviews, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import lampen from '../assets/lampen.jpg';
import koffie from '../assets/koffie.jpg';
import welkom from '../assets/welkom.jpg';
import bord from '../assets/ig-bord.jpg';
import i1003 from '../assets/ig-1003.jpg';
import i0926 from '../assets/ig-0926.jpg';
import i0912 from '../assets/ig-0912.jpg';
import i0905 from '../assets/ig-0905.jpg';
import i0903 from '../assets/ig-0903.jpg';
import i0829 from '../assets/ig-0829.jpg';

const titel = 'Loods of Stuff | Brocante, antiek, vintage en design in Baarn';
const omschrijving = 'Een loods vol vintage, antiek, design, brocante en meer op bedrijvenpark Koot in Baarn. Elke week nieuwe spullen. Zaterdag open van 10 tot 17 uur, verder op afspraak.';

// Letterlijk uit hun eigen Instagram-berichten (datum = datum van het bericht).
const binnen = [
  { img: i1003, datum: '3 oktober', tekst: 'Gisteren een ontruiming gehad en dat zijn we nu aan het uitzoeken.', alt: 'Een houten stoel met gebogen armleuningen en een kussen, tussen kandelaars, een verkeersbord 30 en een klapstoel' },
  { img: i0926, datum: '26 september', tekst: 'Of je nu een thuiswerkplek een terug naar schoolplek een huiswerkmaakplek ja of gewoon een bureau zoekt.', alt: 'Een houten cilinderbureau met laatjes, met erop een oude telefoon, een koperen schaal en bloemen' },
  { img: i0912, datum: '12 september', tekst: 'Wat te denken van dit prachtige buro/kastje.', alt: 'Een mahoniehouten secretaire met een groen schrijfblad, tussen hanglampen, een zuiltje en een rieten stoel' },
  { img: i0905, datum: '5 september', tekst: 'We hebben zo veel leuks binnen gekregen afgelopen week.', alt: 'Een hoek van de loods met een grote messing kandelaar, spiegels, een klok en een verkeersbord 30' },
  { img: i0903, datum: '3 september', tekst: 'Een auto vol gave Brocante items.', alt: 'Een volle kofferbak met kratten, een bierdienblad, een oude helm, gieters en emaille' },
  { img: i0829, datum: '29 augustus', tekst: 'Alles uit Oostenrijk is uitgepakt.', alt: 'Een beschilderde houten papegaai, een groot gesneden houten beeld en een bordje Welcome tussen de spullen' },
];
const [emi, imre, mr] = reviews;
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: hun eigen foto van de loods, lampen aan de stalen balken -->
    <section class="relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col justify-end overflow-hidden bg-vilt text-wit md:min-h-[calc(100svh-5rem)]">
      <Image src={hero} alt="De binnenkant van de loods: tientallen hanglampen aan stalen balken, Perzische tapijten op de betonvloer en kasten vol glas, blik en speelgoed" quality={52} widths={[480, 640, 828, 1080, 1440]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_40%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#16161540_0%,#16161540_35%,#161615d9_68%,#161615f5_100%)] lg:bg-[linear-gradient(90deg,#161615e6_0%,#161615b3_34%,#16161540_62%,#16161510_85%),linear-gradient(0deg,#161615b3_0%,#16161500_45%)]" aria-hidden="true"></div>
      <div class="wrap grid items-end gap-y-10 pb-28 pt-20 min-[380px]:pb-32 md:pb-16 lg:grid-cols-12 lg:pb-20">
        <div class="lg:col-span-8">
          <p class="text-sm font-semibold text-wit/85">Brocante, antiek, vintage en design in Baarn</p>
          <h1 class="mt-4 max-w-[12ch] text-hero sm:mt-5">Een loods vol stuff.</h1>
          <p class="mt-5 max-w-[32rem] text-base text-wit/90 min-[380px]:text-lg sm:mt-7">Elke week komen er nieuwe spullen binnen. Kom zaterdag snuffelen, of spreek een andere dag af.</p>
          <div class="mt-7 flex flex-wrap gap-3 sm:mt-9">
            <a href={waMet('Hallo Loods of Stuff, ik wil graag een keer langskomen. Kan dat?')} class="knop"><Icoon naam="wa" />App de Loods</a>
            <a href="#bezoek" class="knop knop-lijn">Zo vind je ons</a>
          </div>
        </div>
        <div class="hidden justify-self-end lg:col-span-4 lg:block">
          <div class="bord px-7 py-5 text-[.95rem]">
            <p>Loods of Stuff</p>
            <p class="mt-2">Zaterdag 10 tot 17</p>
            <p>En op afspraak</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. NET BINNEN: hun Instagram-logboek, met hun eigen woorden op een prijskaartje -->
    <section id="binnen" class="py-20 md:py-28" aria-labelledby="binnen-titel">
      <div class="wrap">
        <div class="grid gap-y-5 lg:grid-cols-12 lg:gap-x-12">
          <h2 id="binnen-titel" class="rijs text-3xl lg:col-span-7">Elke week nieuwe stuff</h2>
          <p class="rijs max-w-md self-end text-lg text-grijs lg:col-span-5">Wat er binnenkomt, laat de Loods zien op Instagram. Dit kwam er de laatste weken bij.</p>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory scroll-pl-5 gap-4 overflow-x-auto px-5 pb-4 [scrollbar-width:thin] sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-x-5 sm:gap-y-12 sm:overflow-visible sm:px-0 sm:pb-0 md:mt-16 lg:grid-cols-3" aria-label="Berichten van de laatste weken">
          {binnen.map((b, i) => (
            <li class={`rijs w-[78%] flex-none snap-start sm:w-auto ${i % 3 === 1 ? 'lg:translate-y-14' : ''}`} style={`--d:${(i % 3) * 0.08}s`}>
              <figure>
                <Image src={b.img} alt={b.alt} quality={66} widths={[280, 360, 480]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
                <figcaption class="kaartje -mt-8 ml-4 mr-8 shadow-sm">
                  <span class="block text-xs text-grijs">{b.datum}</span>
                  <span class="mt-1 block">“{b.tekst}”</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="rijs mt-16 flex flex-wrap items-center gap-x-6 gap-y-3 lg:mt-28">
          <a href={site.insta} class="knop knop-vilt"><Icoon naam="insta" />Volg @loodsofstuff</a>
          <span class="text-grijs">Teksten letterlijk uit hun eigen berichten.</span>
        </p>
      </div>
    </section>

    <!-- 3. DE LOODS: drie rondjes, met hun letterbord -->
    <section id="loods" class="bg-vilt py-20 text-wit md:py-28" aria-labelledby="loods-titel">
      <div class="wrap">
        <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-12">
          <div class="lg:col-span-5">
            <h2 id="loods-titel" class="rijs text-3xl">“Je moet 3 rondjes doen om alles te zien.”</h2>
            <p class="rijs mt-4 text-sm text-mist">Emi, in een review op Google</p>
            <p class="rijs mt-8 max-w-md text-lg text-mist">Lampen aan de balken, tapijten op de vloer en daartussen meubels, glas, blik en speelgoed.</p>
            <div class="rijs bord mt-10 inline-block px-7 py-5 text-[.95rem]">
              <p>Loods of Stuff</p>
              {soorten.map((s) => <p>{s}</p>)}
            </div>
          </div>
          <figure class="rijs lg:col-span-7">
            <Image src={lampen} alt="Een hoek van de loods met schemerlampen, een weegschaal, een rode trommel, een barkruk en schilderijtjes op een Perzisch tapijt" quality={62} widths={[400, 600, 800, 1000]} sizes="(min-width: 1280px) 760px, (min-width: 1024px) 56vw, 92vw" class="aspect-[4/3] w-full rounded-sm object-cover lg:aspect-auto lg:h-[36rem]" />
          </figure>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-3 md:mt-5 md:grid-cols-12 md:gap-5">
          <figure class="rijs md:col-span-5">
            <Image src={koffie} alt="Een oud koffieblik, een Van Nelle-reclamebord, een zwaan van porselein, speelgoedauto's van Tonka en een lichtbak met Loods of Stuff" quality={62} widths={[200, 300, 450, 600]} sizes="(min-width: 1280px) 520px, (min-width: 768px) 40vw, 46vw" class="aspect-[3/4] w-full rounded-sm object-cover md:aspect-auto md:h-[40rem]" />
          </figure>
          <figure class="rijs md:col-span-7" style="--d:.08s">
            <Image src={welkom} alt="Een kast met een model van een motorboot, een bordje Welkom, een lichtbak met Loods of Stuff, porselein en een oud portret" quality={62} widths={[200, 300, 450, 600, 800]} sizes="(min-width: 1280px) 740px, (min-width: 768px) 56vw, 46vw" class="aspect-[3/4] w-full rounded-sm object-cover md:aspect-auto md:h-[40rem]" />
          </figure>
        </div>
      </div>
    </section>

    <!-- 4. IETS ZOEKEN: je vraag op het letterbord, dan door naar WhatsApp -->
    <section id="zoeken" class="py-20 md:py-28" aria-labelledby="zoek-titel">
      <div class="wrap">
        <form class="rijs grid overflow-hidden rounded-md bg-vilt text-wit shadow-sm lg:grid-cols-12" data-zoek>
          <div class="p-6 sm:p-10 lg:col-span-6 lg:p-14">
            <h2 id="zoek-titel" class="text-3xl">Op zoek naar iets?</h2>
            <p class="mt-5 max-w-md text-mist">Zet het op het bord en stuur het via WhatsApp. Een foto erbij kan ook.</p>
            <fieldset class="mt-9">
              <legend class="text-sm font-semibold text-mist">Wat wil je?</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                <label><input type="radio" name="soort" value="zoek" checked class="peer sr-only" /><span class="keus">Ik zoek iets</span></label>
                <label><input type="radio" name="soort" value="heb" class="peer sr-only" /><span class="keus">Ik heb spullen</span></label>
                <label><input type="radio" name="soort" value="ontruim" class="peer sr-only" /><span class="keus">Ontruiming</span></label>
              </div>
            </fieldset>
            <label class="mt-8 block">
              <span class="text-sm font-semibold text-mist" data-vraag>Wat zoek je?</span>
              <input type="text" name="wat" maxlength="60" autocomplete="off" class="mt-2 block w-full border-0 border-b-[1.5px] border-wit/70 bg-transparent px-0 py-3 text-lg font-semibold text-wit placeholder:font-normal placeholder:text-mist focus:border-rood-licht focus:outline-none" placeholder="bijvoorbeeld een schoolbureautje" />
            </label>
            <p class="mt-8 text-sm text-mist">Loods of Stuff verzorgt ook ontruimingen en gaat langs adressen voor mooie spullen.</p>
          </div>
          <div class="flex flex-col justify-center gap-8 bg-vilt-2 p-6 sm:p-10 lg:col-span-6 lg:p-14">
            <div class="bord px-6 py-7 text-base sm:px-9 sm:py-9 sm:text-xl" aria-hidden="true">
              <p data-r1>Loods of Stuff</p>
              <p class="text-rood-licht" data-r2>Gezocht</p>
              <p class="break-words" data-r3></p>
            </div>
            <div>
              <p class="text-sm font-semibold text-mist">Je bericht</p>
              <p class="mt-2 text-[.9375rem] leading-relaxed text-wit" data-bericht aria-live="polite"></p>
              <a href={site.wa} class="knop mt-6 w-full sm:w-auto" data-wa><Icoon naam="wa" />Stuur via WhatsApp</a>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 5. REVIEWS: letterlijk van Google -->
    <section id="reviews" class="border-t border-lijn bg-papier py-20 md:py-28" aria-labelledby="rev-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-7">
          <h2 id="rev-titel" class="text-3xl">Wie er al was</h2>
          <blockquote class="mt-10">
            <p class="type text-2xl leading-snug md:text-[1.9rem] md:leading-snug">{emi.tekst}</p>
          </blockquote>
          <figcaption class="mt-5 text-sm text-grijs">{emi.naam} op Google</figcaption>
        </figure>
        <div class="space-y-10 lg:col-span-4 lg:col-start-9 lg:pt-24">
          {[imre, mr].map((x, i) => (
            <figure class="rijs border-b border-lijn pb-10" style={`--d:${i * 0.08}s`}>
              <div class="flex gap-0.5 text-rood" role="img" aria-label="5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
              <blockquote class="mt-3 text-lg leading-relaxed">{x.tekst}</blockquote>
              <figcaption class="mt-3 text-sm text-grijs">{x.naam} op Google</figcaption>
            </figure>
          ))}
          <p class="flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" /><a href={site.google.url} class="link">Alle reviews op Google</a></p>
        </div>
      </div>
    </section>

    <!-- 6. BEZOEK: het bord op bedrijvenpark Koot, tijden en route -->
    <section id="bezoek" class="py-20 md:py-28" aria-labelledby="bezoek-titel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={bord} alt="De borden langs de weg bij bedrijvenpark Koot, Oud Eemnesserweg 5 A t/m N, met een stoepbord van Loods of Stuff dat de weg wijst" quality={66} widths={[280, 360, 480]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-sm text-grijs">De ingang van bedrijvenpark Koot. Volg het stoepbord.</figcaption>
        </figure>
        <div class="flex flex-col lg:col-span-6 lg:col-start-7 lg:pt-6">
          <h2 id="bezoek-titel" class="rijs text-3xl">Bedrijvenpark Koot, Baarn</h2>
          <p class="rijs mt-6 text-lg"><span class="font-semibold">{site.adres}</span><br />{site.postcode}</p>
          <p class="rijs mt-6 inline-flex w-fit items-center gap-2.5 rounded-full bg-wit px-4 py-2 text-sm font-semibold shadow-sm" data-status hidden><span class="h-2.5 w-2.5 rounded-full" data-stip></span><span data-statustekst></span></p>
          <dl class="mt-8 max-w-lg" data-tijden>
            {[['ma', 'Maandag'], ['di', 'Dinsdag'], ['wo', 'Woensdag'], ['do', 'Donderdag'], ['vr', 'Vrijdag'], ['za', 'Zaterdag'], ['zo', 'Zondag']].map(([k, d]) => (
              <div class="spec" data-dag={k}><dt class="font-semibold">{d}</dt><span aria-hidden="true"></span><dd class="num text-grijs">{k === 'za' ? '10:00 tot 17:00' : 'op afspraak'}</dd></div>
            ))}
          </dl>
          <p class="rijs mt-6 text-grijs">Pinnen en contactloos betalen kan.</p>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={site.route} class="knop knop-vilt"><Icoon naam="pin" />Route</a>
            <a href={waMet('Hallo Loods of Stuff, ik wil graag op afspraak langskomen. Wanneer komt het uit?')} class="knop"><Icoon naam="wa" />Afspraak maken</a>
            <a href={site.telHref} class="knop knop-lijn num !text-vilt !shadow-[inset_0_0_0_1.5px_#161615]"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Zoekvraag op het letterbord, en het WhatsApp-bericht dat erbij hoort.
  const f = document.querySelector<HTMLFormElement>('[data-zoek]');
  if (f) {
    const $ = (s: string) => f.querySelector<HTMLElement>(s)!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const basis = wa.href.split('?')[0];
    const teksten: Record<string, { vraag: string; kop: string; plek: string; zin: (w: string) => string }> = {
      zoek: { vraag: 'Wat zoek je?', kop: 'Gezocht', plek: 'bijvoorbeeld een schoolbureautje', zin: (w) => w ? `Hallo Loods of Stuff, ik zoek ${w}. Hebben jullie zoiets staan?` : 'Hallo Loods of Stuff, ik zoek iets. Hebben jullie zoiets staan?' },
      heb: { vraag: 'Wat heb je?', kop: 'Te koop', plek: 'bijvoorbeeld een messing kandelaar', zin: (w) => `Hallo Loods of Stuff, ik heb ${w || 'spullen'} die misschien iets voor jullie zijn. Ik stuur een paar foto's mee.` },
      ontruim: { vraag: 'Wat moet er leeg?', kop: 'Ontruiming', plek: 'bijvoorbeeld een zolder in Baarn', zin: (w) => `Hallo Loods of Stuff, ik zoek iemand voor een ontruiming${w ? `: ${w}` : ''}. Kunnen jullie een keer komen kijken?` },
    };
    const zet = () => {
      const d = new FormData(f);
      const t = teksten[String(d.get('soort'))];
      const w = String(d.get('wat') || '').trim();
      $('[data-vraag]').textContent = t.vraag;
      f.querySelector<HTMLInputElement>('[name=wat]')!.placeholder = t.plek;
      $('[data-r2]').textContent = t.kop;
      const r3 = $('[data-r3]'); r3.textContent = w || t.plek.replace('bijvoorbeeld ', '') + '?'; r3.style.opacity = w ? '1' : '.45';
      const tekst = t.zin(w);
      $('[data-bericht]').textContent = tekst;
      wa.href = `${basis}?text=${encodeURIComponent(tekst)}`;
    };
    f.addEventListener('input', zet);
    f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }

  // Vandaag markeren en live open/dicht (alleen zaterdag 10-17 vaste tijden).
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const dagen = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];
  const vandaag = dagen[nu.getDay()];
  document.querySelector(`[data-dag="${vandaag}"]`)?.classList.add('!border-vilt', 'font-bold', '[&_dd]:!text-vilt');
  const st = document.querySelector<HTMLElement>('[data-status]');
  if (st) {
    const m = nu.getHours() * 60 + nu.getMinutes();
    const open = vandaag === 'za' && m >= 600 && m < 1020;
    st.querySelector<HTMLElement>('[data-stip]')!.style.background = open ? '#2f8a4c' : '#c42d1b';
    st.querySelector<HTMLElement>('[data-statustekst]')!.textContent = open ? 'Nu open, tot 17:00' : vandaag === 'za' && m < 600 ? 'Vandaag open vanaf 10:00' : 'Nu dicht, zaterdag weer open';
    st.hidden = false;
  }
</script>
