---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['binnen', 'Net binnen'], ['loods', 'De loods'], ['zoeken', 'Iets zoeken'], ['reviews', 'Reviews'], ['bezoek', 'Bezoek']];
---
<header class="sticky top-0 z-40 border-b border-lijn bg-beton/95 backdrop-blur-md">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6 md:h-20">
    <a href={url('')} class="group flex items-center gap-3 text-vilt no-underline">
      <span class="bord grid h-11 w-11 min-[380px]:h-12 min-[380px]:w-12 flex-none place-items-center !border-[4px] text-[.62rem] leading-[1.15] !tracking-[.12em] md:h-14 md:w-14" aria-hidden="true"><span class="text-center">Loods<br />of<br />Stuff</span></span>
      <span class="flex flex-col leading-none">
        <span class="type whitespace-nowrap text-[1.25rem] min-[380px]:text-[1.45rem] md:text-[1.6rem]">Loods of Stuff</span>
        <span class="mt-1 hidden text-xs font-semibold text-grijs min-[380px]:block">brocante en vintage in Baarn</span>
      </span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-[.9375rem] font-semibold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-vilt no-underline transition-colors duration-200 hover:text-rood">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="num hidden text-[.9375rem] font-semibold text-vilt no-underline hover:text-rood xl:inline-flex xl:items-center xl:gap-2"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
      <a href={waHoi} class="knop hidden !min-h-11 !px-5 text-[.9375rem] md:inline-flex"><Icoon naam="wa" />App de Loods</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-sm text-vilt lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden border-t border-lijn bg-beton lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="type block border-b border-lijn py-4 text-xl text-vilt no-underline">{t}</a></li>)}
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-lijn bg-beton/95 p-2 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="flex min-h-12 items-center justify-center gap-2 rounded-sm border-[1.5px] border-vilt text-[.9375rem] font-bold text-vilt no-underline"><Icoon naam="tel" class="h-4 w-4" />Bellen</a>
  <a href={waHoi} class="flex min-h-12 items-center justify-center gap-2 rounded-sm bg-rood text-[.9375rem] font-bold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
