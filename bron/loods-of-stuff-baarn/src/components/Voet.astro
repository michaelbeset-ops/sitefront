---
import { site, url, waHoi, soorten } from '../data/site';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-vilt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <p class="type text-[1.9rem] leading-tight text-wit">Loods of Stuff</p>
      <p class="mt-5 max-w-xs">Een loods vol vintage, antiek, design, brocante en meer. Op bedrijvenpark Koot in Baarn.</p>
      <p class="mt-6 flex gap-4">
        <a href={site.insta} class="text-wit hover:text-rood-licht" aria-label="Loods of Stuff op Instagram"><Icoon naam="insta" class="h-6 w-6" /></a>
        <a href={site.fb} class="text-wit hover:text-rood-licht" aria-label="Loods of Stuff op Facebook"><Icoon naam="fb" class="h-6 w-6" /></a>
      </p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">In de loods</p>
      <ul class="mt-3 space-y-1">{soorten.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.adres}<br />{site.postcode}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <p class="mt-3 num">zaterdag<br />10:00 tot 17:00</p>
      <p class="mt-2">andere dagen op afspraak</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Loods of Stuff, Baarn · {site.google.score} op Google ({site.google.aantal} reviews)</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's komen van jullie eigen Google-profiel en Instagram. Teksten bij de foto's letterlijk uit jullie Instagram, reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
