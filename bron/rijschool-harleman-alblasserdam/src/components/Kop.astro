---
import { site, url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
const links = [
  { naam: 'Lessen', href: url('#lessen') },
  { naam: 'Zo werkt het', href: url('#route') },
  { naam: 'Contact', href: url('#contact') },
];
---
<header class:list={['z-20', licht ? 'bg-kalk text-nacht border-b border-lijn op-licht' : 'absolute inset-x-0 text-wit']}>
  <div class="wrap flex items-center justify-between gap-4 py-4 md:py-6">
    <a href={url('')} class="straatbord shrink-0" aria-label={`${site.naam}, naar de startpagina`}>
      <span class="text-lg md:text-xl">Rijschool <b class="font-extrabold">Harleman</b></span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden md:block">
      <ul class="flex items-center gap-8 font-kop text-lg font-semibold uppercase tracking-wide">
        {links.map((l) => <li><a class="underline-offset-8 hover:underline" href={l.href}>{l.naam}</a></li>)}
      </ul>
    </nav>
    <a href={site.telHref} class:list={['knop !min-h-11 !px-4 !text-base', licht ? 'knop-geel' : 'knop-rand']}>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg>
      <span class="hidden sm:inline">Bel</span><span class="sr-only sm:hidden">Bel {site.naam}</span>
    </a>
  </div>
</header>
