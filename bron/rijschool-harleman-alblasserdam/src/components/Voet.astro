---
import { site, url } from '../data/site';
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12 md:py-16">
    <div class="md:col-span-5">
      <p class="straatbord"><span class="text-xl">Rijschool <b class="font-extrabold">Harleman</b></span></p>
      <p class="mt-5 max-w-xs">Rijlessen voor rijbewijs B in {site.plaats}, handgeschakeld of automaat.</p>
    </div>
    <div class="md:col-span-4">
      <p class="label text-wit">Adres</p>
      <p class="mt-2">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-4"><a class="text-wit underline underline-offset-4" href={site.telHref}>{site.tel}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="label text-wit">Gegevens</p>
      <p class="mt-2">KvK {site.kvk}</p>
      <p class="mt-4"><a class="underline underline-offset-4 hover:text-wit" href={url('privacy/')}>Privacyverklaring</a></p>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <p class="wrap py-5 text-xs">© {new Date().getFullYear()} {site.naam}. De foto's op deze site zijn sfeerbeelden.</p>
  </div>
</footer>
