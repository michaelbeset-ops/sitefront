---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, slagen, fotos } from '../data/site';

const stappen = [
  { nr: '1', kop: 'Theorie', tekst: 'Het theorie-examen doe je bij het CBR. Zonder geldig theoriecertificaat mag je geen praktijkexamen doen.' },
  { nr: '2', kop: 'Rijlessen', tekst: `Je leert rijden bij ${site.naam}, in een handgeschakelde auto of in een automaat.` },
  { nr: '3', kop: 'Praktijkexamen', tekst: 'Het praktijkexamen rijd je bij het CBR. Geslaagd? Dan vraag je je rijbewijs aan bij de gemeente.' },
];

const telIcoon = 'M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2';
const appIcoon = 'M4 20l1.3-4A8 8 0 1 1 8.4 19z';
---
<Base title="Rijschool Harleman, rijles in Alblasserdam" description="Rijlessen voor rijbewijs B in Alblasserdam, handgeschakeld of automaat. Bel of app Rijschool Harleman op 06 51 20 93 35." hero>
  <Kop />
  <main id="inhoud">
    <!-- Hero: schermvullende foto, tekst linksonder, adres als straatnaambord rechts. -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-nacht text-wit">
      <img
        src={fotos.hero(1600)}
        srcset={`${fotos.hero(800)} 800w, ${fotos.hero(1200)} 1200w, ${fotos.hero(1600)} 1600w`}
        sizes="100vw"
        alt="Een zwarte auto rijdt over een rustige weg tussen hoge bomen"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        fetchpriority="high"
        width="1600" height="1067"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(14_26_46/0.94)_0%,rgb(14_26_46/0.6)_45%,rgb(14_26_46/0.25)_75%,rgb(14_26_46/0.45)_100%)]"></div>

      <div class="wrap grid gap-10 pt-32 pb-12 md:grid-cols-12 md:items-end md:pb-20">
        <div class="md:col-span-9">
          <p class="label binnen text-geel">Rijschool in {site.plaats}</p>
          <h1 class="binnen mt-4 text-4xl">Rijles in<br />Alblasserdam.</h1>
          <p class="binnen binnen-2 mt-6 max-w-xl text-lg text-kalk">Handgeschakeld of automaat. Bel of app {site.naam} en plan je eerste les.</p>
          <div class="binnen binnen-2 mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="knop knop-geel">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={telIcoon} /></svg>
              Bel {site.tel}
            </a>
            <a href={site.wa} class="knop knop-rand">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={appIcoon} /></svg>
              WhatsApp
            </a>
          </div>
        </div>
        <div class="md:col-span-3 md:justify-self-end">
          <a href={site.maps} class="straatbord transition-transform hover:-translate-y-0.5" aria-label={`Route naar ${site.straat}, ${site.plaats}`}>
            <span class="text-xl whitespace-nowrap md:text-2xl">{site.straat}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Lessen: tekst links op het raster, foto rechts loopt hoger door. -->
    <section id="lessen" class="op-licht scroll-mt-4 py-20 md:py-32">
      <div class="wrap grid gap-12 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-6 lg:col-span-6">
          <p class="label text-bord">Rijbewijs B</p>
          <h2 class="mt-4 text-3xl">Twee manieren<br />om te leren rijden.</h2>
          <p class="mt-6 max-w-md text-grijs">{site.naam} geeft rijles in de auto. Jij kiest of je leert in een auto met koppeling of in een automaat.</p>

          <ol class="mt-12 border-t-2 border-nacht">
            <li class="grid grid-cols-[3.5rem_1fr] gap-x-4 border-b border-lijn py-7 md:grid-cols-[5rem_1fr]">
              <span class="font-kop text-[3rem] leading-none font-extrabold text-bord md:text-[4rem]" aria-hidden="true">H</span>
              <div>
                <h3 class="text-2xl md:text-3xl">Handgeschakeld</h3>
                <p class="mt-2 text-grijs">Je leert rijden met koppeling en versnellingspook. Schakelen wordt vanzelf iets wat je zonder nadenken doet.</p>
              </div>
            </li>
            <li class="grid grid-cols-[3.5rem_1fr] gap-x-4 border-b border-lijn py-7 md:grid-cols-[5rem_1fr]">
              <span class="font-kop text-[3rem] leading-none font-extrabold text-bord md:text-[4rem]" aria-hidden="true">A</span>
              <div>
                <h3 class="text-2xl md:text-3xl">Automaat</h3>
                <p class="mt-2 text-grijs">Geen koppeling en geen schakelen. Je hoofd is vrij voor het verkeer om je heen.</p>
              </div>
            </li>
          </ol>
        </div>
        <div class="relative md:col-span-5 md:col-start-8">
          <img
            src={fotos.pook(900)}
            srcset={`${fotos.pook(600)} 600w, ${fotos.pook(900)} 900w`}
            sizes="(min-width: 768px) 40vw, 100vw"
            alt="Close-up van een versnellingspook in een auto"
            loading="lazy" decoding="async"
            width="900" height="1200"
            class="aspect-[4/5] w-full object-cover md:aspect-[3/4] md:-mt-8"
          />
        </div>
      </div>
    </section>

    <!-- Route: drie stappen langs een wegmarkering, horizontaal op groot scherm, verticaal op mobiel. -->
    <section id="route" class="scroll-mt-4 bg-nacht py-20 text-kalk md:py-32">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12">
          <p class="label text-geel md:col-span-12">Zo werkt het</p>
          <h2 class="text-3xl md:col-span-7">Zo haal je je<br />rijbewijs B.</h2>
          <p class="max-w-sm text-mist md:col-span-4 md:col-start-9 md:self-end">Drie stappen van eerste les tot rijbewijs. De theorie en het examen doe je bij het CBR, het rijden leer je in de lesauto.</p>
        </div>

        <div class="relative mt-16 md:mt-24">
        <div aria-hidden="true" class="streep-v absolute top-2 bottom-2 left-[0.6rem] w-1 md:hidden"></div>
        <div aria-hidden="true" class="streep absolute top-0 right-0 left-0 hidden h-1 md:block"></div>
        <ol class="grid gap-12 pl-10 md:grid-cols-3 md:gap-10 md:pl-0 md:pt-14">
          {stappen.map((s) => (
            <li class="relative">
              <span class="absolute top-1 -left-10 grid size-6 place-items-center rounded-full bg-geel font-kop text-sm font-extrabold text-nacht md:-top-[4.25rem] md:left-0 md:size-8 md:text-base" aria-hidden="true">{s.nr}</span>
              <h3 class="text-2xl text-wit md:text-[2.5rem]"><span class="sr-only">Stap {s.nr}. </span>{s.kop}</h3>
              <p class="mt-3 max-w-xs text-mist">{s.tekst}</p>
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>

    <!-- Cijfers: een groot getal met bron, foto ernaast. -->
    <section class="op-licht py-20 md:py-32">
      <div class="wrap grid gap-12 md:grid-cols-12 md:items-center md:gap-8">
        <div class="order-2 md:order-1 md:col-span-5">
          <img
            src={fotos.stuur(900)}
            srcset={`${fotos.stuur(600)} 600w, ${fotos.stuur(900)} 900w`}
            sizes="(min-width: 768px) 40vw, 100vw"
            alt="Handen aan het stuur van een auto tijdens het rijden"
            loading="lazy" decoding="async"
            width="900" height="675"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
        <div class="order-1 md:order-2 md:col-span-6 md:col-start-7">
          <p class="label text-bord">Slagingspercentage</p>
          <p class="mt-2 font-kop text-cijfer leading-[0.85] font-extrabold tracking-tight text-bord">{slagen.procent}<span class="text-[0.5em]">%</span></p>
          <h2 class="mt-4 text-2xl md:text-3xl">Geslaagd bij het eerste examen</h2>
          <p class="mt-4 max-w-md text-grijs">Gemeten over {slagen.examens} eerste examens bij het CBR, van {slagen.periode}. Bron theorio.nl.</p>
          <dl class="mt-10 grid grid-cols-2 border-t border-lijn pt-6">
            <div>
              <dt class="label text-grijs">Sinds</dt>
              <dd class="mt-1 font-kop text-[3rem] leading-none font-extrabold">{site.sinds}</dd>
            </div>
            <div>
              <dt class="label text-grijs">Rijbewijs</dt>
              <dd class="mt-1 font-kop text-[3rem] leading-none font-extrabold">B</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Prijzen: foto-band, eerlijk dat de prijzen bij de rijschool zelf liggen. -->
    <section class="relative isolate overflow-hidden bg-nacht text-wit">
      <img
        src={fotos.polder(1600)}
        srcset={`${fotos.polder(800)} 800w, ${fotos.polder(1200)} 1200w, ${fotos.polder(1600)} 1600w`}
        sizes="100vw"
        alt="Een lege weg door groen grasland onder een blauwe lucht"
        loading="lazy" decoding="async"
        width="1600" height="1067"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(14_26_46/0.92)_0%,rgb(14_26_46/0.75)_55%,rgb(14_26_46/0.3)_100%)]"></div>
      <div class="wrap py-24 md:py-36">
        <p class="label text-geel">Lesprijzen</p>
        <h2 class="mt-4 max-w-2xl text-3xl">Wat kost rijles?</h2>
        <p class="mt-6 max-w-md text-lg text-kalk">Lesprijzen en pakketten hoor je van {site.naam} zelf. Bel of stuur een appje, dan weet je meteen waar je aan toe bent.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.telHref} class="knop knop-geel">Bel {site.tel}</a>
          <a href={site.wa} class="knop knop-rand">WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- Contact: gegevens links, formulier rechts. -->
    <section id="contact" class="op-licht scroll-mt-4 py-20 md:py-32">
      <div class="wrap grid gap-14 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-5">
          <p class="label text-bord">Contact</p>
          <h2 class="mt-4 text-3xl">Plan je<br />eerste les.</h2>
          <dl class="mt-10 space-y-7">
            <div>
              <dt class="label text-grijs">Bellen of WhatsApp</dt>
              <dd class="mt-1"><a href={site.telHref} class="font-kop text-3xl font-extrabold underline-offset-4 hover:underline">{site.tel}</a></dd>
            </div>
            <div>
              <dt class="label text-grijs">Adres</dt>
              <dd class="mt-1 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</dd>
              <dd class="mt-2"><a href={site.maps} class="font-semibold text-bord underline underline-offset-4">Route plannen</a></dd>
            </div>
          </dl>
        </div>

        <div class="md:col-span-6 md:col-start-7">
          <form class="border-t-2 border-nacht pt-8" aria-describedby="formulier-uitleg" onsubmit="return false">
            <h3 class="text-2xl">Stuur een bericht</h3>
            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              <label class="block">
                <span class="text-sm font-semibold">Naam</span>
                <input class="veld mt-1.5" type="text" name="naam" autocomplete="name" disabled={site.voorstel} />
              </label>
              <label class="block">
                <span class="text-sm font-semibold">Telefoonnummer</span>
                <input class="veld mt-1.5" type="tel" name="telefoon" autocomplete="tel" disabled={site.voorstel} />
              </label>
            </div>
            <fieldset class="mt-5">
              <legend class="text-sm font-semibold">Ik wil leren rijden in een</legend>
              <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
                <label class="flex items-center gap-2"><input type="radio" name="soort" value="handgeschakeld" class="size-4 accent-bord" disabled={site.voorstel} /> handgeschakelde auto</label>
                <label class="flex items-center gap-2"><input type="radio" name="soort" value="automaat" class="size-4 accent-bord" disabled={site.voorstel} /> automaat</label>
              </div>
            </fieldset>
            <label class="mt-5 block">
              <span class="text-sm font-semibold">Bericht</span>
              <textarea class="veld mt-1.5 min-h-32" name="bericht" rows="4" disabled={site.voorstel}></textarea>
            </label>
            {site.voorstel ? (
              <p id="formulier-uitleg" class="mt-6 border-l-4 border-geel bg-wit p-4 text-sm text-grijs">Dit formulier staat uit in dit ontwerpvoorstel en verstuurt niets. Bel of app {site.naam} rechtstreeks op <a href={site.telHref} class="font-semibold text-nacht underline">{site.tel}</a>.</p>
            ) : (
              <p id="formulier-uitleg" class="mt-6 text-sm text-grijs">Je bericht gaat rechtstreeks naar {site.naam}.</p>
            )}
          </form>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>
