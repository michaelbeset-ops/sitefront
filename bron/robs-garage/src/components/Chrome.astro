---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const telIcoon = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
---
{deel === 'kop' ? (
  <header class="op-donker sticky top-0 z-40 border-b border-white/10 bg-ink text-white">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-baseline gap-2 font-display text-2xl font-bold uppercase leading-none tracking-[0.02em] text-white no-underline">
        Rob's<span class="border-b-2 border-silver pb-0.5 text-lg font-semibold tracking-[0.14em]">Garage</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href="#specialist" class="no-underline transition-colors hover:text-blue-light">Mercedes-Benz</a></li>
          <li><a href="#diensten" class="no-underline transition-colors hover:text-blue-light">Diensten</a></li>
          <li><a href="#werkwijze" class="no-underline transition-colors hover:text-blue-light">Werkwijze</a></li>
          <li><a href="#afspraak" class="no-underline transition-colors hover:text-blue-light">Afspraak en contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-blue !px-3.5 !py-2 !text-base">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d={telIcoon} /></svg>
        <span class="sm:hidden">Bel</span><span class="hidden sm:inline whitespace-nowrap tabular-nums">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="op-donker bg-ink py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-xl uppercase tracking-[0.02em] text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br /><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a> · <a href={`mailto:${site.mail}`} class="underline underline-offset-2">{site.mail}</a></p>
      <p class="md:col-span-4">Maandag t/m vrijdag <span class="whitespace-nowrap tabular-nums">08:00 tot 18:00</span><br />Zaterdag en zondag gesloten<br /><span class="text-xs">KvK [[AANLEVEREN: KvK-nummer]]</span></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 border-t border-white/10 pt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
