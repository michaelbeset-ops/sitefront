---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, diensten } from '../data/site';
import hero from '../assets/hero.jpg';
import werkplaats from '../assets/werkplaats.jpg';
import monteur from '../assets/monteur.jpg';
import diagnose from '../assets/diagnose.jpg';

const pijl = 'M5 12h14m-6-6 6 6-6 6';
const diensteOpties = ['Onderhoudsbeurt', 'APK-keuring', 'Reparatie', 'Motorrevisie', 'Versnellingsbak', 'Aircoservice', 'Banden of bandenopslag', 'Ruitreparatie', 'Schade en spuitwerk', 'Inbouw of accessoires', 'Occasion of verkoop van mijn auto', 'Iets anders'];
---
<Base
  title="Rob's Garage | Allround autobedrijf en Mercedes-Benz specialist in Capelle aan den IJssel"
  description="Reparatie, onderhoud, APK, motorrevisie, airco, banden en schadeherstel voor alle merken. Rob is gespecialiseerd in Mercedes-Benz. Hoofdweg 30, Capelle aan den IJssel."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: antraciet vlak, foto van de koplamp rechts; op mobiel de foto egaal afgedekt. -->
    <section class="op-donker relative isolate overflow-hidden bg-ink text-white">
      <div class="absolute inset-0 -z-10 lg:left-[42%]">
        <Foto src={hero} alt="Grijze Mercedes-Benz in een werkplaats met gereedschap en ventilatoren aan de muur" hero sizes="(min-width: 1024px) 60vw, 100vw" class="object-[35%_60%]" />
        <div class="absolute inset-0 bg-ink/80 lg:bg-transparent lg:bg-linear-to-r lg:from-ink lg:via-ink/30 lg:to-transparent"></div>
      </div>
      <div class="wrap grid py-14 sm:py-20 lg:grid-cols-12 lg:py-28">
        <div class="lg:col-span-7">
          <p class="label text-silver">Sinds 2004 <span aria-hidden="true" class="mx-2 inline-block h-px w-8 translate-y-[-0.3em] bg-silver"></span> <span class="whitespace-nowrap">Hoofdweg 30, Capelle</span></p>
          <h1 class="mt-5 text-4xl">Allround garage met een <span class="whitespace-nowrap">Mercedes-Benz</span> specialist</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">Onderhoud, APK en reparaties voor alle merken. Rob is opgeleid, gespecialiseerd en gecertificeerd voor alle Mercedes-Benz-modellen.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.afspraak} rel="noopener" class="btn btn-blue">
              Maak online een afspraak
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d={pijl} /></svg>
            </a>
            <a href={site.telHref} class="btn btn-line">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
          <dl class="mt-10 grid max-w-lg grid-cols-2 gap-6 border-t border-silver/40 pt-6 text-sm">
            <div><dt class="text-white/80">Google</dt><dd class="mt-1"><strong class="font-display text-2xl font-bold tabular-nums text-white">{site.google.score}</strong> <span class="text-white/80">uit 5, {site.google.aantal} reviews</span></dd></div>
            <div><dt class="text-white/80">Open</dt><dd class="mt-1 text-white">Ma t/m vr<br /><span class="whitespace-nowrap tabular-nums">08:00 tot 18:00</span></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Verhuisd: dunne strook, want dat staat bovenaan hun huidige site. -->
    <div class="border-b border-line bg-steel">
      <p class="wrap py-3 text-sm text-ink-soft"><strong class="text-ink">Een klein stukje verhuisd:</strong> u vindt ons nu op Hoofdweg 30, {site.postcode} {site.plaats}.</p>
    </div>

    <!-- Specialist en herkomst: tekst naast een smalle foto, tijdlijn eronder. -->
    <section id="specialist" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-6">
          <p class="label text-blue">Specialisme</p>
          <h2 class="mt-3 text-3xl"><span class="whitespace-nowrap">Mercedes-Benz,</span> en thuis in alle andere merken</h2>
          <div class="mt-7 space-y-4 text-ink-soft">
            <p>Van origine is Rob opgeleid en gespecialiseerd in het repareren van alle typen Mercedes-Benz. Met de bijbehorende diploma's is hij gecertificeerd om reparaties en onderhoud aan uw Mercedes uit te voeren.</p>
            <p>De werkplaats heeft de nieuwste uitlees- en diagnoseapparatuur, met het speciale gereedschap dat daarbij hoort. Onze medewerkers zijn ook gecertificeerd voor het onderhoud van alle andere automerken.</p>
          </div>
          <ul class="mt-8 grid gap-px overflow-hidden rounded-md bg-silver/60 text-sm sm:grid-cols-3">
            <li class="bg-paper p-4"><span class="block font-display text-lg font-bold uppercase text-ink">Opgeleid</span>voor alle Mercedes-Benz-modellen</li>
            <li class="bg-paper p-4"><span class="block font-display text-lg font-bold uppercase text-ink">Gecertificeerd</span>voor Mercedes en alle andere merken</li>
            <li class="bg-paper p-4"><span class="block font-display text-lg font-bold uppercase text-ink">Diagnose</span>met de nieuwste uitleesapparatuur</li>
          </ul>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="aspect-[4/3] overflow-hidden rounded-md shadow-sm lg:aspect-[4/5]"><Foto src={diagnose} alt="Handen met steeksleutels tussen kabels en leidingen in een rood geverfde motorruimte" sizes="(min-width: 1024px) 440px, 100vw" /></div>
        </div>
      </div>

      <ol class="mt-16 grid gap-8 border-t-2 border-ink pt-8 md:grid-cols-3 lg:mt-20">
        <li>
          <p class="font-display text-3xl font-bold tabular-nums text-blue">2004</p>
          <h3 class="mt-2 text-xl">De eerste garage</h3>
          <p class="mt-2 text-ink-soft">Rob's Garage begint op het Noordereiland in Rotterdam.</p>
        </li>
        <li>
          <p class="font-display text-3xl font-bold text-blue">Groei</p>
          <h3 class="mt-2 text-xl">Uitbreiding</h3>
          <p class="mt-2 text-ink-soft">Om de vele klanten met dezelfde kwaliteitsnormen, service en snelheid te helpen, werd uitbreiding nodig.</p>
        </li>
        <li>
          <p class="font-display text-3xl font-bold text-blue">Nu</p>
          <h3 class="mt-2 text-xl">Hoofdweg 30, Capelle</h3>
          <p class="mt-2 text-ink-soft">Benieuwd naar het bedrijf of zin in een kop koffie? Kom eens langs.</p>
        </li>
      </ol>
    </section>

    <!-- Diensten: groepen als genummerde lijst, foto's in een smalle kolom ernaast. -->
    <section id="diensten" class="scroll-mt-20 bg-steel py-16 lg:py-28">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 class="text-3xl lg:col-span-7">Wat we voor uw auto doen</h2>
          <p class="text-ink-soft lg:col-span-5">Van een onderhoudsbeurt tot schadeherstel en een occasion met garantie. Voor uw auto of bedrijfswagen, ongeacht het merk.</p>
        </div>
        <div class="mt-12 grid gap-12 lg:grid-cols-12">
          <div class="space-y-12 lg:col-span-8">
            {diensten.map((g, gi) => (
              <div class="grid gap-4 sm:grid-cols-4">
                <h3 class="text-xl sm:col-span-1"><span class="block font-display text-base tabular-nums text-blue">0{gi + 1}</span>{g.groep}</h3>
                <ul class="divide-y divide-silver border-y border-silver sm:col-span-3">
                  {g.items.map((d) => (
                    <li class="grid gap-1 py-4 md:grid-cols-5 md:gap-6">
                      <p class="font-semibold text-ink md:col-span-2">{d.naam}</p>
                      <p class="text-sm text-ink-soft md:col-span-3">{d.tekst}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="grid content-start gap-4 self-start sm:grid-cols-2 lg:sticky lg:top-24 lg:col-span-4 lg:grid-cols-1">
            <div class="aspect-[4/3] overflow-hidden rounded-md shadow-sm"><Foto src={werkplaats} alt="Donkere sedan in een werkplaats naast rekken vol olie, sleutels en ander gereedschap" sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" /></div>
            <div class="aspect-[4/3] overflow-hidden rounded-md shadow-sm lg:aspect-[3/4]"><Foto src={monteur} alt="Monteur met een slagmoersleutel bij het wiel van een auto op de brug" sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="object-[30%_50%]" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Werkwijze: donker, stappen als tijdlijn met een zilveren lijn. -->
    <section id="werkwijze" class="op-donker scroll-mt-20 bg-ink py-16 text-white lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-silver">Werkwijze</p>
          <h2 class="mt-3 text-3xl">U staat nooit voor verrassingen</h2>
          <p class="mt-6 text-white/85">Blijkt tijdens het onderhoud dat er een reparatie nodig is, dan voeren we die pas uit na overleg met u.</p>
          <p class="mt-4 text-white/85">Wat kost een onderhoudsbeurt? Dat hangt af van het merk en type auto, en van hoe goed hij tot nu toe onderhouden is. We geven u daar vooraf graag een duidelijk antwoord op.</p>
        </div>
        <ol class="relative space-y-10 border-l border-silver/50 pl-8 lg:col-span-6 lg:col-start-7">
          <li class="relative">
            <span aria-hidden="true" class="absolute -left-[2.35rem] top-1 grid size-5 place-items-center rounded-full bg-ink ring-2 ring-silver"></span>
            <h3 class="text-xl">1. Afspraak maken</h3>
            <p class="mt-2 text-white/85">Online via onze app, telefonisch of per mail.</p>
          </li>
          <li class="relative">
            <span aria-hidden="true" class="absolute -left-[2.35rem] top-1 grid size-5 place-items-center rounded-full bg-ink ring-2 ring-silver"></span>
            <h3 class="text-xl">2. Eerst de juiste diagnose</h3>
            <p class="mt-2 text-white/85">Bij een onderhoudsbeurt controleren we standaard een aantal specifieke punten, gestructureerd en met aandacht. Bij twijfel over de motor doen we eerst een compressietest.</p>
          </li>
          <li class="relative">
            <span aria-hidden="true" class="absolute -left-[2.35rem] top-1 grid size-5 place-items-center rounded-full bg-blue ring-2 ring-blue-light"></span>
            <h3 class="text-xl">3. Eerst contact met u</h3>
            <p class="mt-2 text-white/85">Vinden we kapotte onderdelen, dan nemen we altijd eerst contact met u op. Samen bespreken we de mogelijkheden en wat de kosten zijn.</p>
          </li>
          <li class="relative">
            <span aria-hidden="true" class="absolute -left-[2.35rem] top-1 grid size-5 place-items-center rounded-full bg-ink ring-2 ring-silver"></span>
            <h3 class="text-xl">4. Pas dan aan de slag</h3>
            <p class="mt-2 text-white/85">Na overleg voeren we de reparatie uit. Is uw auto ook aan de APK toe, dan combineert u die met het onderhoud.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- Afspraak en contact: formulier breed, gegevens en tijden in een smalle kolom. -->
    <section id="afspraak" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="label text-blue">Afspraak of offerte</p>
          <h2 class="mt-3 text-3xl">Plan uw bezoek aan de werkplaats</h2>
          <p class="mt-5 max-w-xl text-ink-soft">Plan direct een afspraak in onze online afspraakapp. Liever eerst een prijs of een vraag? Vul het formulier in, dan nemen we contact met u op.</p>
          <a href={site.afspraak} rel="noopener" class="btn btn-blue mt-7">
            Maak online een afspraak
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d={pijl} /></svg>
          </a>

          <form class="mt-12 grid gap-5 rounded-md bg-white p-5 shadow-sm ring-1 ring-line sm:grid-cols-2 sm:p-8" action="#" method="post" onsubmit="return false">
            <h3 class="text-xl sm:col-span-2">Werkplaatsafspraak of offerte aanvragen</h3>
            <label class="text-sm font-semibold">Naam<input class="veld font-normal" type="text" name="naam" autocomplete="name" required /></label>
            <label class="text-sm font-semibold">Telefoon<input class="veld font-normal" type="tel" name="telefoon" autocomplete="tel" required /></label>
            <label class="text-sm font-semibold sm:col-span-2">E-mail<input class="veld font-normal" type="email" name="email" autocomplete="email" /></label>
            <label class="text-sm font-semibold">Kenteken<input class="veld font-normal uppercase" type="text" name="kenteken" autocomplete="off" /></label>
            <label class="text-sm font-semibold">Merk en model<input class="veld font-normal" type="text" name="auto" /></label>
            <label class="text-sm font-semibold sm:col-span-2">Waarvoor komt u?
              <select class="veld font-normal" name="dienst">
                {diensteOpties.map((o) => <option>{o}</option>)}
              </select>
            </label>
            <label class="text-sm font-semibold sm:col-span-2">Bericht<textarea class="veld font-normal" name="bericht" rows="4"></textarea></label>
            {site.voorstel ? (
              <p class="rounded-sm bg-steel p-4 text-sm text-ink sm:col-span-2">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap font-semibold underline tabular-nums">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold underline">{site.mail}</a>.</p>
            ) : (
              <button type="submit" class="btn btn-blue sm:col-span-2 sm:justify-self-start">Verstuur aanvraag</button>
            )}
          </form>
        </div>

        <aside class="lg:col-span-4 lg:col-start-9" aria-label="Contactgegevens">
          <div class="rounded-md bg-ink p-6 text-white op-donker sm:p-8">
            <h2 class="text-2xl">Contact</h2>
            <address class="mt-5 not-italic text-white/85">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
            <a href={site.maps} rel="noopener" class="btn btn-line mt-5 !py-2.5 !text-base">Route plannen</a>
            <dl class="mt-8 space-y-4 border-t border-white/15 pt-6">
              <div><dt class="text-sm text-white/80">Telefoon</dt><dd><a href={site.telHref} class="whitespace-nowrap font-display text-2xl font-bold tabular-nums underline decoration-blue-light decoration-2 underline-offset-4">{site.tel}</a></dd></div>
              <div><dt class="text-sm text-white/80">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-blue-light decoration-2 underline-offset-4">{site.mail}</a></dd></div>
            </dl>
          </div>
          <h3 class="mt-10 text-xl">Openingstijden</h3>
          <table class="mt-3 w-full text-sm">
            <tbody class="divide-y divide-silver">
              {tijden.map((t) => (
                <tr>
                  <th scope="row" class="py-2.5 text-left font-normal text-ink-soft">{t.dag}</th>
                  <td class={`whitespace-nowrap py-2.5 text-right tabular-nums ${t.tijd === 'Gesloten' ? 'text-ink-soft' : 'font-semibold text-ink'}`}>{t.tijd}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </aside>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
