---
import { site, url, waHoi } from '../data/site';
const jaar = new Date().getFullYear();
---
<footer class="bg-lei text-krijt/75">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <a href={url('')} class="inline-flex flex-col items-center gap-1.5 text-krijt no-underline">
        <b class="block border border-krijt/80 px-3 py-1.5 font-sans text-lg font-semibold tracking-[.02em] text-krijt">VAN TIM</b>
        <small class="pl-[.42em] text-[.5625rem] font-medium uppercase tracking-[.42em]">since 1978</small>
      </a>
      <p class="mt-6 max-w-xs">Patisserie en brood van Tim van Beijnen, uit eigen bakkerij aan het Hoogeinde in Waalwijk.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-kop text-xl text-krijt">Bestellen</p>
      <p class="mt-3"><a href={site.webshop} class="link">Webshop vantim.nl</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
    </div>
    <div class="md:col-span-4">
      <p class="font-kop text-xl text-krijt">Afhalen</p>
      <p class="mt-3">{site.straat}, {site.postcode} {site.plaats}</p>
      <p class="mt-1">Vrijdag 8.30 - 13.00, zaterdag 8.00 - 11.00</p>
      <p class="mt-1"><a href={site.instagram} class="link">Instagram</a> · ★ {site.google.score} op Google ({site.google.aantal})</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.vol} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-krijt">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto’s van jullie Google-bedrijfsprofiel, Instagram en webshop. Assortiment en prijzen uit de webshop, reviews letterlijk van Google (stand 6 oktober 2026).</p>}
</footer>
