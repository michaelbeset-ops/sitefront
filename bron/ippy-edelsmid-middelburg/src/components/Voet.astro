---
import { site, url, waHoi } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-5">
      <Merk licht />
      <p class="mt-6 max-w-sm">Edelsmid atelier in het hart van Middelburg, sinds 2002. Van uw oude juwelen een nieuw verhaal.</p>
      <p class="mt-6 flex items-center gap-3">
        <a href={site.instagram} class="grid h-10 w-10 flex-none place-items-center rounded-full bg-nacht-2 text-licht transition-colors hover:bg-oker hover:text-inkt" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
        <a href={site.facebook} class="grid h-10 w-10 flex-none place-items-center rounded-full bg-nacht-2 text-licht transition-colors hover:bg-oker hover:text-inkt" aria-label="Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">In het atelier</p>
      <ul class="mt-4 space-y-2">
        <li><a href={h('verhalen')} class="no-underline transition-colors hover:text-oker">Oud goud, nieuw sieraad</a></li>
        <li><a href={h('atelier')} class="no-underline transition-colors hover:text-oker">Ontwerp op maat</a></li>
        <li><a href={h('atelier')} class="no-underline transition-colors hover:text-oker">Reparaties en aanpassingen</a></li>
        <li><a href={h('anke')} class="no-underline transition-colors hover:text-oker">Zeeuwse sieraden</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-4">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li>{site.straat}, {site.postcode} {site.plaats}</li>
        <li>Open op afspraak</li>
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-oker">{site.tel}</a> · <a href={waHoi} class="no-underline transition-colors hover:text-oker">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-oker">{site.mail}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats} · {site.google.score} uit {site.google.aantal} reviews op Google</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-oker">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw eigen Instagram en website. Reviews letterlijk van Google (stand 6 oktober 2026).</p>}
  </div>
</footer>
