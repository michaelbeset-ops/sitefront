---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi } from '../data/site';

import heroRing from '../assets/ig-rozenkwarts-saffier.jpg';
import koraal from '../assets/ig-bloedkoraal.jpg';
import herenring from '../assets/ig-herenring.jpg';
import ringDochter from '../assets/ig-ring-dochter.jpg';
import slot from '../assets/ig-zeeuws-slot.jpg';
import maansteen from '../assets/ig-maansteen.jpg';
import gesprek from '../assets/ig-gesprek.jpg';
import smelten from '../assets/ig-smelten.jpg';
import atelier from '../assets/site-atelier.jpg';
import muntring from '../assets/site-muntring.jpg';
import oorbellen from '../assets/ig-oorbellen-rozenkwarts.jpg';

// Alle verhalen hieronder komen uit de eigen Instagram-posts van IPPY (mei-september 2026), ingekort.
const verhalen = [
  { foto: maansteen, alt: 'Ring met een ovale regenboogmaansteen in een kastzetting, op een okergele achtergrond', was: 'Omgesmolten familiegoud.', werd: 'De bodemplaat onder een regenboogmaansteen, speciaal geslepen bij de slijper.', datum: 'Mei 2026', vorm: 'aspect-[4/5]', pos: 'object-[50%_62%]', mt: '' },
  { foto: herenring, alt: 'De nieuwe herenring op wit papier, met een gele draad', was: 'De witgouden trouwringen van zijn ouders en gouden sieraden uit eigen bezit.', werd: 'Een stoere, robuuste herenring.', datum: 'Juni 2026', vorm: 'aspect-[4/5]', pos: 'object-[50%_55%]', mt: 'lg:mt-28' },
  { foto: ringDochter, alt: 'Smalle gouden ring met een gedraaid randje op wit, met een gele draad', was: 'De trouwring van haar moeder, met diamant.', werd: 'Een nieuwe set ringen voor haar dochter.', datum: 'Juli 2026', vorm: 'aspect-[4/5]', pos: 'object-[50%_50%]', mt: 'lg:mt-10' },
  { foto: slot, alt: 'Fijne gouden kettingen, oorbellen en een armband met Zeeuwse knopjes en een slotje', was: 'Een oud Zeeuws slot, dat eerder al een armband werd.', werd: 'Subtiele sieraden om elke dag te dragen.', datum: 'September 2026', vorm: 'aspect-[4/5]', pos: 'object-[50%_40%]', mt: 'lg:mt-40' },
];

const kanIk = [
  { t: 'oude trouwringen', v: 'ik heb oude trouwringen' },
  { t: 'een erfstuk of familiesieraad', v: 'ik heb een erfstuk of familiesieraad' },
  { t: 'bloedkoraal of Zeeuwse sieraden', v: 'ik heb bloedkoraal of Zeeuwse sieraden' },
  { t: 'losse stenen of een diamant', v: 'ik heb losse stenen of een diamant' },
  { t: 'een sieraad dat niet lekker zit', v: 'ik heb een sieraad dat niet lekker zit' },
  { t: 'nog niets, alleen een idee', v: 'idee' },
];
const wordt = [
  { t: 'een ring', v: 'een ring' },
  { t: 'trouwringen', v: 'trouwringen' },
  { t: 'een hanger of collier', v: 'een hanger of collier' },
  { t: 'oorbellen', v: 'oorbellen' },
  { t: 'een armband', v: 'een armband' },
  { t: 'weer draagbaar', v: 'draagbaar' },
  { t: 'ik weet het nog niet', v: 'advies' },
];

const titel = 'IPPY Edelsmid | Van uw oude juwelen een nieuw verhaal, Middelburg';
const omschrijving = 'IPPY Edelsmid, Langeviele 52 in Middelburg: edelsmid Anke Fierloos ontwerpt en maakt sieraden op maat, van uw oude goud, familiesieraden of alleen een idee. Ook reparaties. Open op afspraak, app 06 42 11 86 17.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- HERO: licht, zoals hun eigen productfoto's; de ring met de gele draad -->
    <section class="relative grid min-h-[calc(100svh-4.5rem)] grid-cols-1 lg:max-h-[56rem] lg:grid-cols-12">
      <div class="wrap relative z-10 flex flex-col justify-center pb-14 pt-14 lg:col-span-7 lg:max-w-none lg:pb-20 lg:pl-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))] lg:pr-10 lg:pt-16">
        <h1 class="text-hero max-w-[15ch]">
          Van uw oude juwelen een
          <span class="relative inline-block whitespace-nowrap">nieuw verhaal
            <svg class="draad absolute -bottom-[.32em] left-0 h-[.42em] w-full overflow-visible" style="--sw:2.6" viewBox="0 0 400 40" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 26 C 70 40, 120 6, 190 20 S 300 40, 330 18 C 345 6, 370 4, 398 12" /></svg>
          </span>
        </h1>
        <p class="mt-9 max-w-[34rem] text-lg text-grijs md:text-xl">Edelsmid Anke Fierloos ontwerpt en maakt sieraden op aanvraag, in haar atelier aan de Langeviele. Van familiegoud, een oude trouwring of alleen een idee.</p>
        <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={waHoi} class="knop knop-inkt"><Icoon naam="wa" />Maak een afspraak</a>
          <a href={site.telHref} class="link num inline-flex items-center gap-2 font-semibold"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
        </div>
        <p class="mt-12 text-sm text-grijs">Langeviele 52, Middelburg <span class="mx-2 text-oker-diep" aria-hidden="true">/</span> Open op afspraak</p>
      </div>
      <figure class="relative order-first h-[44svh] min-h-[17rem] overflow-hidden bg-steen lg:order-none lg:col-span-5 lg:h-auto lg:min-h-0">
        <Image src={heroRing} alt="Gouden ring met een rozenkwarts en een zwarte saffier op wit papier, met een okergele draad erdoorheen" widths={[640, 960, 1300, 1800]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[46%_44%]" />
        <figcaption class="absolute bottom-4 right-5 text-xs text-grijs">Rozenkwarts en zwarte saffier, gemaakt van oud goud</figcaption>
      </figure>
    </section>

    <!-- VERHALEN: wat al generaties in de kast ligt -->
    <section id="verhalen" class="donker bg-nacht pb-24 pt-24 text-licht md:pb-32 md:pt-28">
      <div class="wrap grid grid-cols-1 items-center gap-x-14 gap-y-12 lg:grid-cols-12">
        <figure class="rijs min-w-0 lg:col-span-5">
          <Image src={koraal} alt="Een snoer bloedkoraal met een gouden slot, over een houten blokje op donker hout" widths={[480, 720, 1000]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_45%] max-lg:max-h-[34rem]" />
        </figure>
        <div class="min-w-0 lg:col-span-6 lg:col-start-7">
          <h2 class="rijs text-3xl">Wat al generaties in Zeeuwse kasten ligt</h2>
          <p class="rijs mt-7 max-w-xl text-lg text-licht-zacht">Veel Zeeuwen hebben bloedkoraal in de kast liggen waar niets mee wordt gedaan. Deze sieraden laten zien wat er mogelijk is.</p>
          <p class="rijs mt-10 font-kop text-[clamp(1.75rem,1.8vw+1rem,2.75rem)] leading-tight text-oker">Je geschiedenis herschikken.</p>
        </div>
      </div>

      <div class="wrap relative mt-24 md:mt-32">
        <svg class="draad pointer-events-none absolute -top-10 left-0 hidden h-40 w-full lg:block" viewBox="0 0 1200 160" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M0 120 C 160 40, 260 150, 420 90 S 700 10, 860 70 S 1100 150, 1200 40" /></svg>
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs max-w-xl text-2xl">Was het ene, werd het andere</h2>
          <a href={site.instagram} class="rijs link inline-flex items-center gap-2 font-semibold"><Icoon naam="insta" class="h-4 w-4" />Elke twee weken een nieuw verhaal op Instagram</a>
        </div>
        <div class="-mx-5 mt-12 flex snap-x snap-mandatory gap-x-5 overflow-x-auto px-5 pb-4 [scrollbar-width:thin] md:-mx-10 md:px-10 lg:mx-0 lg:grid lg:grid-cols-4 lg:gap-x-6 lg:overflow-visible lg:px-0 lg:pb-0" tabindex="0" aria-label="Verhalen uit het atelier">
          {verhalen.map((v, i) => (
            <article class:list={['rijs w-[76%] max-w-[22rem] flex-none snap-start lg:w-auto lg:max-w-none lg:min-w-0', v.mt]} style={`--d:${i * 0.08}s`}>
              <Image src={v.foto} alt={v.alt} widths={[360, 540, 760]} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 46vw, 100vw" class:list={['w-full rounded-sm object-cover', v.vorm, v.pos]} />
              <dl class="wasw mt-5">
                <dt>Was</dt><dd class="text-licht-zacht">{v.was}</dd>
                <dt class="!text-oker">Werd</dt><dd class="text-licht">{v.werd}</dd>
              </dl>
              <p class="mt-3 pl-[4.15rem] text-xs text-licht-zacht">{v.datum}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ATELIER: een goed gesprek is waar het begint -->
    <section id="atelier" class="bg-oker py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-x-14 gap-y-12 lg:grid-cols-12">
        <figure class="rijs min-w-0 lg:col-span-6">
          <Image src={gesprek} alt="In het atelier: de edelsmid in een gele trui bespreekt aan tafel een ontwerp met een klant, met schetsen en sieraden op tafel" widths={[560, 840, 1200]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[5/6] w-full rounded-sm object-cover object-[40%_40%] max-lg:aspect-[4/5]" />
        </figure>
        <div class="min-w-0 lg:col-span-6 lg:pt-6">
          <h2 class="rijs text-3xl">Een goed gesprek is waar het begint</h2>
          <p class="rijs mt-6 max-w-lg text-xl">Samen maken we van uw verhaal een idee, en uiteindelijk een mooi ontwerp.</p>
          <ul class="mt-12 border-t border-inkt/25">
            <li class="rijs border-b border-inkt/25 py-6">
              <h3 class="text-xl">Ook zonder eigen materiaal</h3>
              <p class="mt-2 max-w-lg">Soms is er alleen een verhaal. Met nieuw, zorgvuldig gekozen edelmetaal krijgt het ontwerp dan vorm.</p>
            </li>
            <li class="rijs border-b border-inkt/25 py-6" style="--d:.06s">
              <h3 class="text-xl">Reparaties en kleine aanpassingen</h3>
              <p class="mt-2 max-w-lg">Als uw sieraad net niet lekker zit, draagt u het niet. Ook voor de kleinste aanpassing kunt u bij IPPY terecht.</p>
            </li>
            <li class="rijs border-b border-inkt/25 py-6" style="--d:.12s">
              <h3 class="text-xl">Van oud goud een nieuwe vorm</h3>
              <p class="mt-2 max-w-lg">Uw oude goud wordt omgesmolten en in een nieuwe vorm gegoten.</p>
            </li>
          </ul>
          <figure class="rijs mt-10 flex items-center gap-5">
            <Image src={smelten} alt="Twee gouden trouwringen in een smeltkroesje op de werkbank" widths={[200, 320]} sizes="7rem" class="aspect-square w-28 flex-none rounded-sm object-cover" />
            <figcaption class="max-w-xs text-sm">Twee trouwringen, samen gesmolten tot één juweel voor hun dochter. Januari 2026.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- WOW: van ... naar ... -->
    <section id="uw-verhaal" class="py-24 md:py-32">
      <div class="wrap">
        <div class="grid grid-cols-1 gap-x-14 gap-y-6 lg:grid-cols-12">
          <h2 class="rijs text-3xl lg:col-span-6">Wat ligt er bij u in de kast?</h2>
          <p class="rijs max-w-lg text-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-3">Kies wat u heeft en wat het mag worden. Wij lezen mee en plannen samen met u een afspraak.</p>
        </div>

        <form class="relative mt-14" data-aanvraag aria-label="Aanvraag voor een sieraad">
          <svg class="pointer-events-none absolute inset-0 hidden h-full w-full overflow-visible md:block" aria-hidden="true"><path data-lijn d="" fill="none" stroke="#d6a531" stroke-width="2.5" stroke-linecap="round" /></svg>
          <div class="grid grid-cols-1 gap-x-[12%] gap-y-12 md:grid-cols-2">
            <fieldset class="min-w-0">
              <legend class="etiket text-grijs">Ik heb</legend>
              <div class="mt-4">
                {kanIk.map((k, i) => (
                  <div>
                    <input type="radio" name="heb" id={`heb-${i}`} value={k.v} class="peer sr-only" checked={i === 0} />
                    <label for={`heb-${i}`} class="keus" data-kant="l"><i aria-hidden="true"></i><span>{k.t}</span></label>
                  </div>
                ))}
              </div>
            </fieldset>
            <fieldset class="min-w-0">
              <legend class="etiket text-grijs">En het mag worden</legend>
              <div class="mt-4">
                {wordt.map((w, i) => (
                  <div>
                    <input type="radio" name="wordt" id={`wordt-${i}`} value={w.v} class="peer sr-only" checked={i === 0} />
                    <label for={`wordt-${i}`} class="keus" data-kant="r"><i aria-hidden="true"></i>{w.t}</label>
                  </div>
                ))}
              </div>
            </fieldset>
          </div>

          <div class="mt-14 grid grid-cols-1 items-end gap-x-14 gap-y-8 lg:grid-cols-12">
            <div class="max-w-xl rounded-md rounded-tl-none bg-[#e5f3dc] p-5 text-[.9375rem] leading-relaxed text-inkt lg:col-span-7" aria-live="polite">
              <p class="text-xs font-bold text-[#2d5f34]">Uw bericht aan Anke</p>
              <p class="mt-1" data-bericht>Hallo Anke, ik heb oude trouwringen. Ik zou daar graag een ring van laten maken. Kunnen we een afspraak maken om het te bespreken?</p>
            </div>
            <div class="lg:col-span-5">
              <a href={waHoi} class="knop knop-inkt" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
              <p class="mt-4 text-xs text-grijs">Er wordt pas iets verstuurd als u in WhatsApp op verzenden drukt. Liever mailen? <a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- OVER IPPY: Anke, Schoonhoven, Zeeuwse lijn -->
    <section id="anke" class="donker bg-nacht py-24 text-licht md:py-28">
      <div class="wrap grid grid-cols-1 gap-x-14 gap-y-14 lg:grid-cols-12">
        <figure class="rijs min-w-0 lg:col-span-5">
          <Image src={atelier} alt="Zwart-witfoto: een edelsmid aan de werkbank met de soldeerbrander" widths={[480, 737]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[8/7] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-xs text-licht-zacht">Aan de werkbank, uit ons eigen archief.</figcaption>
        </figure>
        <div class="min-w-0 lg:col-span-6 lg:col-start-7">
          <h2 class="rijs text-3xl">Sinds 2002 in het hart van Middelburg</h2>
          <p class="rijs mt-7 max-w-xl text-lg text-licht-zacht">Anke Fierloos studeerde aan de vakschool in Schoonhoven als juwelier en goud- en zilversmid. In mei 2002 opende ze IPPY. Ze ontwerpt zelf en maakt van oud goud en zilver nieuwe sieraden.</p>
          <div class="rijs mt-12 grid grid-cols-[7rem_1fr] items-center gap-6 border-t border-lijn-licht pt-8 sm:grid-cols-[9rem_1fr]">
            <Image src={muntring} alt="Zilveren ring met een oude munt als kop" widths={[200, 300]} sizes="9rem" class="aspect-square w-full rounded-sm object-cover" />
            <div>
              <h3 class="text-xl">Grietje en de muntenlijn</h3>
              <p class="mt-2 text-licht-zacht">Onze Zeeuwse sieradenlijn Grietje is een oude bekende en blijft een mooie klassieker. Net als de ringen uit onze oude muntenlijn.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- REVIEWS + BEZOEK -->
    <section id="bezoek" class="py-24 md:py-28">
      <div class="wrap grid grid-cols-1 gap-x-14 gap-y-14 lg:grid-cols-12">
        <figure class="rijs min-w-0 lg:col-span-7">
          <blockquote>
            <p class="font-kop text-[clamp(1.5rem,1.6vw+1rem,2.625rem)] leading-[1.25]">“Super vriendelijke mensen en de kwaliteit van de ambacht ligt heel hoog!</p>
            <p class="mt-5 max-w-xl text-lg text-grijs">Heb hier volledig een verlovingsring laten maken naar eigen wensen en laatst een eigen ring laten vermaken, zeer zeer tevreden over!”</p>
          </blockquote>
          <figcaption class="mt-6 text-sm text-grijs"><b class="font-semibold text-inkt">{reviews[0].naam}</b> · Google-review</figcaption>
        </figure>
        <div class="grid content-start gap-9 lg:col-span-5 lg:border-l lg:border-lijn lg:pl-12">
          {reviews.slice(1, 3).map((r, i) => (
            <figure class="rijs" style={`--d:${0.1 + i * 0.1}s`}>
              <span class="flex gap-0.5 text-oker" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
              <blockquote class="mt-3 text-lg leading-snug">“{r.tekst}”</blockquote>
              <figcaption class="mt-2.5 text-sm text-grijs"><b class="font-semibold text-inkt">{r.naam}</b> · Google-review</figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="wrap mt-24 md:mt-28">
        <div class="grid grid-cols-1 overflow-hidden rounded-sm bg-wit shadow-sm lg:grid-cols-12">
          <div class="relative p-8 sm:p-12 lg:col-span-7 lg:p-16">
            <h2 class="rijs text-3xl">Langeviele 52</h2>
            <p class="rijs mt-2 text-xl text-grijs">4331 LW Middelburg</p>
            <svg class="draad mt-8 h-6 w-48" viewBox="0 0 200 24" aria-hidden="true"><path pathLength="1" d="M2 14 C 40 2, 70 24, 110 12 S 160 4, 176 12 c 8 4 10 -8 2 -8 s -6 12 4 10" /></svg>
            <p class="rijs mt-6 max-w-md text-lg">Wij zijn open op afspraak. Zo heeft u alle rust en onze onverdeelde aandacht. App of bel, dan spreken we een moment af.</p>
            <div class="rijs mt-9 flex flex-wrap gap-3">
              <a href={waHoi} class="knop knop-inkt"><Icoon naam="wa" />WhatsApp</a>
              <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" />{site.tel}</a>
            </div>
            <p class="rijs mt-7 flex flex-wrap gap-x-7 gap-y-2 text-[.9375rem]">
              <a href={site.maps} class="link inline-flex items-center gap-2 font-semibold"><Icoon naam="pin" class="h-4 w-4" />Route plannen</a>
              <a href={`mailto:${site.mail}`} class="link inline-flex items-center gap-2 font-semibold"><Icoon naam="mail" class="h-4 w-4" />{site.mail}</a>
            </p>
          </div>
          <figure class="relative min-h-[20rem] lg:col-span-5">
            <Image src={oorbellen} alt="Oorbellen met handgeslepen rozenkwarts op een okergele achtergrond" widths={[480, 720, 1000]} sizes="(min-width: 1024px) 34vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[45%_55%]" />
          </figure>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script>
    import { waMet } from '../data/site';
    const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
    if (f) {
      const uit = f.querySelector<HTMLElement>('[data-bericht]')!;
      const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const lijn = f.querySelector<SVGPathElement>('[data-lijn]')!;
      const maak = () => {
        const d = new FormData(f);
        const heb = String(d.get('heb') || '');
        const wordt = String(d.get('wordt') || '');
        let t = 'Hallo Anke, ';
        t += heb === 'idee' ? 'ik heb nog geen eigen materiaal, alleen een idee.' : `${heb}.`;
        if (wordt === 'advies') t += ' Ik weet nog niet wat het moet worden en hoor graag uw advies.';
        else if (wordt === 'draagbaar') t += heb === 'idee' ? ' Ik hoor graag wat er mogelijk is.' : ' Ik zou het graag weer draagbaar laten maken.';
        else t += heb === 'idee' ? ` Ik zou graag ${wordt} laten maken.` : ` Ik zou daar graag ${wordt} van laten maken.`;
        t += ' Kunnen we een afspraak maken om het te bespreken?';
        uit.textContent = t;
        stuur.href = waMet(t);
        teken();
      };
      // De gele draad tussen de twee keuzes.
      const teken = () => {
        const l = f.querySelector<HTMLElement>('input[name=heb]:checked + .keus i');
        const r = f.querySelector<HTMLElement>('input[name=wordt]:checked + .keus i');
        if (!l || !r || getComputedStyle(lijn.parentElement!).display === 'none') return;
        const b = f.getBoundingClientRect();
        const lb = l.closest('.keus')!.querySelector('span')!.getBoundingClientRect();
        const a = l.getBoundingClientRect(), c = r.getBoundingClientRect();
        const x1 = lb.right - b.left + 14, y1 = a.top + a.height / 2 - b.top;
        const x2 = c.left - b.left - 10, y2 = c.top + c.height / 2 - b.top;
        const m = (x1 + x2) / 2;
        lijn.setAttribute('d', `M${x1} ${y1} C ${m} ${y1 + 30}, ${m} ${y2 - 30}, ${x2} ${y2}`);
      };
      f.addEventListener('change', maak); f.addEventListener('submit', (e) => e.preventDefault());
      addEventListener('resize', teken);
      document.fonts?.ready.then(teken);
      maak();
    }
  </script>
</Base>
