---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, url, mailMet, punters, romp } from '../data/site';
import schuur from '../assets/schuur.jpg';
import gangen from '../assets/gangen.jpg';
import romp_ from '../assets/romp.jpg';
import zeilen from '../assets/zeilen.jpg';
import rondvaart from '../assets/rondvaart.jpg';
import teWater from '../assets/te-water.jpg';

const ref = punters.find((p) => p.id === 'gieters')!;
const start = punters.find((p) => p.id === 'beulaker')!;
const rondvaartNamen = ['De Watertaxi', 'Malinska (België)', 'Jacoba van Beieren', 'Bob on Board', 'Napoleon', 'Djieuwke', 'De Weerribben Express', 'Purperreiger', 'De Grachthof', 'De Rietstulp', 'Lieve (Gent)'];
const cm = (n: number) => (n / 100).toFixed(2).replace('.', ',');
---
<Base title="Scheepswerf Schreur | Punterwerf in Giethoorn" description="Punterbouw Schreur aan het Binnenpad in Giethoorn: punters van massief eikenhout, rondvaartboten en onderhoud van de Gieterse vloot.">
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Opening: het groen van de schuurdeur loopt door in het tekstvlak. -->
    <section class="op-groen relative bg-deur text-kalk lg:grid lg:h-[calc(100svh-6.1rem)] lg:max-h-[54rem] lg:min-h-[38rem] lg:grid-cols-[minmax(0,6fr)_minmax(0,9fr)]">
      <figure class="relative h-[19rem] sm:h-[26rem] lg:order-2 lg:h-full">
        <Foto src={schuur} hero alt="Twee botenbouwers aan een houten punter in aanbouw, in de open deur van een oude groene houten schuur" sizes="(min-width: 1024px) 62vw, 100vw" class="object-[64%_60%] lg:object-[0%_60%]" />
        <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-24 bg-linear-to-r from-deur to-transparent lg:block" aria-hidden="true"></div>
        <figcaption class="absolute bottom-3 right-4 bg-teer/80 px-2.5 py-1 text-xs italic text-kalk">Een punter in de maak</figcaption>
      </figure>
      <div class="wrap flex flex-col justify-between gap-8 pb-10 pt-8 lg:order-1 lg:!max-w-none lg:pb-12 lg:pl-12 lg:pr-10 lg:pt-12 xl:pl-[max(3rem,calc((100vw-90rem)/2+3rem))]">
        <p class="text-sm italic text-mos">{site.straat}, {site.plaats}</p>
        <div>
          <h1 class="text-[clamp(2.7rem,5.7vw,5.3rem)] leading-[.93]">Elf generaties punter&shy;bouwers.</h1>
          <p class="mt-6 max-w-[30rem] leading-relaxed text-mos sm:text-lg">Gieterse punters van massief eikenhout, rondvaartboten in hout, staal en aluminium, en onderhoud van de Gieterse vloot.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={site.telHref} class="knop">Bel de werf <span class="whitespace-nowrap font-normal tabular-nums">{site.tel}</span></a>
            <a href={mailMet('Offerte aanvragen')} class="lijn text-sm">of vraag per mail een offerte aan</a>
          </div>
        </div>
        <p class="maat text-mos"><span class="whitespace-nowrap tabular-nums">Ma t/m vr 08:00-17:00</span></p>
      </div>
    </section>

    <!-- Het vak: hout, vuur, pennen en deutels. -->
    <section id="vak" class="wrap grid gap-10 py-20 lg:grid-cols-12 lg:gap-12 lg:py-28">
      <div class="lg:col-span-5 lg:pt-6">
        <h2 class="text-2xl">Frans eikenhout, gekromd boven een vuurtje.</h2>
        <p class="mt-6 max-w-[34rem] text-grijs">Zo bouwt de werf al generaties: met handgemaakte houten pennen en eikenhouten deutels, de <em>duvels</em>. Een eeuwenoud ambacht, in de authentieke punterwerkplaats.</p>
        <dl class="mt-10 border-t border-lijn text-sm">
          <div class="flex gap-4 border-b border-lijn py-3"><dt class="w-28 shrink-0 italic text-eik">Het hout</dt><dd>Frans eiken, kwalitatief het beste en mooi van nerf.</dd></div>
          <div class="flex gap-4 border-b border-lijn py-3"><dt class="w-28 shrink-0 italic text-eik">De gangen</dt><dd>Gekromd boven een vuurtje.</dd></div>
          <div class="flex gap-4 border-b border-lijn py-3"><dt class="w-28 shrink-0 italic text-eik">Deutelen</dt><dd>Grenen pen van 13 mm in een gat van 12 mm, onderaan in V-vorm uitgebeiteld, met een scherpe eikenhouten deutel erin.</dd></div>
        </dl>
      </div>
      <div class="grid grid-cols-5 gap-4 lg:col-span-7">
        <figure class="col-span-3 aspect-[3/4]"><Foto src={romp_} alt="Eikenhouten romp van een punter op de werkvloer, met een botenbouwer op de achtergrond" sizes="(min-width: 1024px) 34vw, 60vw" /></figure>
        <div class="col-span-2 flex flex-col justify-end gap-4">
          <figure class="aspect-[4/5]"><Foto src={gangen} alt="De gelakte eikenhouten gangen van een romp, van dichtbij" sizes="(min-width: 1024px) 22vw, 40vw" class="object-[30%_50%]" /></figure>
          <p class="text-sm italic text-grijs">De oudste verhuurpunter van de werf is meer dan 85 jaar oud en doet nog altijd dienst.</p>
        </div>
      </div>
    </section>

    <!-- De maatlijst: punters op schaal naast elkaar. -->
    <section id="punters" class="border-y border-lijn bg-wit py-20 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-5">
          <h2 class="text-2xl">Vergelijk ook de afmetingen.</h2>
          <p class="mt-5 max-w-[32rem] text-grijs">Een Beulakermeerpunter van Schreur is geen 6,60 bij 1,80 meter, maar 7,00 bij 2,00. Kies een type en leg hem naast de Gieterse punter.</p>
          <fieldset class="mt-8">
            <legend class="sr-only">Kies een punter</legend>
            <ul class="border-t border-lijn">
              {punters.map((p) => (
                <li class="type relative border-b border-lijn">
                  <input type="radio" name="punter" id={`p-${p.id}`} value={p.id} checked={p.id === start.id} data-l={p.l} data-b={p.b} data-naam={p.naam} data-bij={p.bij} data-d={romp(p.l, p.b, !!p.spiegel)} />
                  <label for={`p-${p.id}`} class="flex items-baseline gap-2 px-2 py-2 text-sm sm:gap-3 sm:text-[.95rem]">
                    <span class="min-w-0">{p.naam}</span><span class="stip" aria-hidden="true"></span><span class="whitespace-nowrap tabular-nums">{p.l} x {p.b} cm</span>
                  </label>
                </li>
              ))}
            </ul>
          </fieldset>
        </div>
        <div class="min-w-0 lg:col-span-7 lg:pl-6">
          <div class="relative border border-lijn bg-kalk p-3 sm:p-5">
            <svg id="plan" viewBox="-30 -150 940 300" class="block h-auto w-full" role="img" aria-labelledby="plan-titel">
              <title id="plan-titel">Bovenaanzicht op schaal: de gekozen punter over de Gieterse punter heen</title>
              <defs>
                <pattern id="meter" width="100" height="100" patternUnits="userSpaceOnUse" x="0" y="-150"><path d="M100 0H0V100" fill="none" stroke="#1b1c19" stroke-opacity=".12" stroke-width="1" /></pattern>
              </defs>
              <rect x="-30" y="-150" width="940" height="300" fill="url(#meter)" />
              <line x1="-30" y1="0" x2="910" y2="0" stroke="#1b1c19" stroke-opacity=".25" stroke-dasharray="14 6 3 6" />
              <path d={romp(ref.l, ref.b)} fill="none" stroke="#1b1c19" stroke-width="2" stroke-dasharray="8 6" />
              <path id="plan-romp" d={romp(start.l, start.b)} fill="#d9a66b" fill-opacity=".35" stroke="#8a4f1c" stroke-width="3" style="transition: d .35s ease" />
              {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((m) => <text x={m * 100 + 4} y="142" font-size="15" fill="#565a52" font-family="Georgia,serif">{m} m</text>)}
            </svg>
          </div>
          <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2" aria-live="polite">
            <p><span id="plan-naam" class="display text-xl">{start.naam}</span> <span id="plan-bij" class="text-sm italic text-grijs">{start.bij}</span></p>
            <p class="text-sm tabular-nums"><span id="plan-maat">{cm(start.l)} x {cm(start.b)} m</span> <span id="plan-verschil" class="italic text-eik">{start.l - ref.l >= 0 ? '+' : ''}{start.l - ref.l} cm lang, {start.b - ref.b >= 0 ? '+' : ''}{start.b - ref.b} cm breed</span></p>
          </div>
          <p class="mt-6 border-t border-lijn pt-4 text-sm text-grijs">Gestippeld: de Gieterse punter, 670 x 150 cm. Schematisch bovenaanzicht, op schaal. Alle boten handmatig van massief eikenhout, geïmpregneerd, diverse malen afgelakt en met roestvrijstalen beslag. Prijzen schommelen: <a href={site.telHref} class="lijn text-teer">bel de werf</a>.</p>
        </div>
      </div>
    </section>

    <!-- Rondvaartboten en onderhoud. -->
    <section id="rondvaart" class="grid lg:grid-cols-2">
      <figure class="h-[22rem] sm:h-[30rem] lg:h-auto lg:min-h-[44rem]"><Foto src={rondvaart} alt="Een eikenhouten rondvaartboot met kap aan de wal, tussen het groen" sizes="(min-width: 1024px) 50vw, 100vw" /></figure>
      <div class="flex flex-col justify-center px-5 py-16 md:px-12 lg:px-16 lg:py-24">
        <h2 class="text-2xl">Rondvaartboten, van eikenhouten bok tot elektrisch.</h2>
        <p class="mt-6 max-w-[34rem] text-grijs">Schreur bouwde er ruim 80 helemaal van eikenhout. Nu ook met een aluminium casco, afgetimmerd met eikenhout, en elektrische voortstuwing: fluisterstil, gemiddeld 8 uur varen. Van 8 tot 14,5 meter, helemaal naar de wensen van de opdrachtgever.</p>
        <p class="mt-8 text-sm italic text-eik">Gebouwd voor onder meer</p>
        <p class="mt-2 max-w-[36rem] text-sm leading-loose">{rondvaartNamen.join(' · ')}</p>
        <div class="mt-12 grid gap-6 border-t border-lijn pt-8 sm:grid-cols-[9rem_1fr] sm:items-start">
          <figure class="aspect-square w-36"><Foto src={teWater} alt="Botenbouwers duwen een nieuwe eikenhouten punter over het gras naar het water" sizes="144px" class="object-[60%_50%]" /></figure>
          <div class="text-sm">
            <h3 class="text-xl">Onderhoud, reparatie en rondhout</h3>
            <p class="mt-3 text-grijs">Een groot deel van de Gieterse vloot, van punter tot rondvaartboot, onderhoudt de werf zelf. Ook houten betimmering op kunststof of metalen boten, en houten masten in elke dikte en lengte.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Naar de werf. -->
    <section id="werf" class="op-groen relative bg-deur text-kalk">
      <figure class="h-[16rem] sm:h-[24rem] lg:h-[30rem]"><Foto src={zeilen} alt="Een punter met een rood zeil op open water, met riet aan de oever" sizes="100vw" class="object-[50%_55%]" /></figure>
      <div class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:py-24">
        <h2 class="text-3xl lg:col-span-6">U bent welkom op de werf.</h2>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-4 text-mos"><span class="whitespace-nowrap tabular-nums">Maandag t/m vrijdag 08:00-17:00</span></p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={mailMet('Offerte aanvragen')} class="knop">Vraag een offerte aan</a>
            <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">of bel {site.tel}</a>
          </div>
          <p class="mt-10 text-sm text-mos"><a href={site.maps} class="lijn">Route in Google Maps</a> · {site.google.score} op Google ({site.google.aantal} reviews)</p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  const romp = document.getElementById('plan-romp');
  const naam = document.getElementById('plan-naam');
  const bij = document.getElementById('plan-bij');
  const maat = document.getElementById('plan-maat');
  const verschil = document.getElementById('plan-verschil');
  const m = (n: number) => (n / 100).toFixed(2).replace('.', ',');
  const s = (n: number) => (n >= 0 ? '+' : '') + n;
  document.querySelectorAll<HTMLInputElement>('input[name="punter"]').forEach((i) =>
    i.addEventListener('change', () => {
      const l = +i.dataset.l!, b = +i.dataset.b!;
      romp?.setAttribute('d', i.dataset.d!);
      if (naam) naam.textContent = i.dataset.naam!;
      if (bij) bij.textContent = i.dataset.bij!;
      if (maat) maat.textContent = `${m(l)} x ${m(b)} m`;
      if (verschil) verschil.textContent = i.value === 'gieters' ? 'het vergelijkingspunt' : `${s(l - 670)} cm lang, ${s(b - 150)} cm breed`;
    }),
  );
</script>
