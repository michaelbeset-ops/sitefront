---
import { site, url, mailMet } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-lijn bg-kalk">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-baseline gap-3 text-teer no-underline">
        <span class="display text-[1.75rem] leading-none">Schreur</span>
        <span class="hidden text-xs italic text-grijs sm:inline">Punterwerf, Giethoorn</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-9 text-sm">
          <li><a href={url('#vak')} class="no-underline underline-offset-4 hover:underline">Het vak</a></li>
          <li><a href={url('#punters')} class="no-underline underline-offset-4 hover:underline">Punters</a></li>
          <li><a href={url('#rondvaart')} class="no-underline underline-offset-4 hover:underline">Rondvaartboten</a></li>
          <li><a href={url('#werf')} class="no-underline underline-offset-4 hover:underline">Naar de werf</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="knop !px-3.5 !py-2.5"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg><span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
    </div>
  </header>
) : (
  <footer class="op-groen bg-deur-diep text-kalk">
    <div class="wrap grid gap-10 pb-10 pt-14 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="display text-[3rem] leading-none">Schreur</p>
        <p class="mt-2 italic text-mos">Punterbouw Schreur en Scheepswerf Schreur: één werf, twee namen.</p>
      </div>
      <p class="md:col-span-4">
        {site.straat}<br />{site.postcode} {site.plaats}<br />
        <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a><br />
        <a href={mailMet('Vraag aan de werf')} class="lijn break-all">{site.mail}</a>
      </p>
      <p class="md:col-span-3 md:text-right">
        Erkend leerbedrijf (SBB)<br />
        KvK <span class="text-xs">[[AANLEVEREN: KvK-nummer]]</span><br />
        <a href={url('privacy/')} class="lijn">Privacyverklaring</a>
      </p>
    </div>
    {site.voorstel && <p class="wrap border-t border-lijn-licht pb-8 pt-6 text-xs text-mos">Foto's van de huidige website punterbouw.nl, ter illustratie.</p>}
  </footer>
)}
