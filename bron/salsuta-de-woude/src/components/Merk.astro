---
import { getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import logoLicht from '../assets/logo-licht.png';
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
const img = await getImage({ src: licht ? logoLicht : logo, width: 320, format: 'webp' });
---
<a href={url('')} class="merk" aria-label="Restaurant Salsuta, naar de homepage">
  <img src={img.src} width="160" height="60" alt="Salsuta" />
</a>
