---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, kaart, reviews, reviewBoot, waHoi, waMet } from '../data/site';

import terras from '../assets/luchtfoto-terras.jpg';
import haven from '../assets/luchtfoto-haven.jpg';
import vanafWater from '../assets/vanaf-water.jpg';
import pont from '../assets/pont.jpg';
import bar from '../assets/bar.jpg';
import pieter from '../assets/pieter.jpg';
import taart from '../assets/taart-carrousel.jpg';
import poke from '../assets/poke.jpg';
import tartaar from '../assets/steaktartaar.jpg';
import vis from '../assets/vis.jpg';
import cheesecake from '../assets/cheesecake.jpg';
import club from '../assets/clubsandwich.jpg';
import citroen from '../assets/citroentaart.jpg';

const waFeest = waMet('Hallo Salsuta, wij willen bij jullie iets vieren. Het gaat om: ');
const blad = `<svg viewBox="0 0 24 24" class="inline h-4 w-4 align-[-2px]" aria-hidden="true"><path fill="#7a9a00" d="M20 4c-9 0-15 4-15 11 0 1.7.5 3.2 1.3 4.4C8 14 12 10.5 16 8.5c-3.4 2.4-6.4 6-8 10.6.9.6 2 .9 3.2.9C18 20 20 12 20 4Z"/></svg><span class="sr-only">vegetarische optie</span>`;
---
<Base title="Restaurant Salsuta | Eten aan het water op De Woude" description="Restaurant en eetcafé Salsuta op het eiland De Woude: lunch, diner en klassieke cocktails aan het water. Twee minuten met de pont. Reserveren via WhatsApp 06 27 45 45 50.">
  <Kop />
  <main id="inhoud">

    <!-- Hero: grote letter op papier, daarna het eiland vanuit de lucht, met het pontbord eronder. -->
    <section class="relative">
      <div class="wrap grid items-end gap-x-10 gap-y-6 pb-10 pt-10 md:pt-14 lg:grid-cols-12 lg:pb-12">
        <h1 class="text-hero lg:col-span-7">Aan tafel op het <span class="veeg">eiland</span></h1>
        <div class="lg:col-span-5 lg:pb-2">
          <p class="max-w-md text-lg text-grijs">Koffie, lunch of een uitgebreid diner, binnen of op het terras aan het water. Je vaart er met de pont in twee minuten heen.</p>
          <p class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={waHoi} class="knop knop-inkt"><Icoon naam="wa" />Reserveer via WhatsApp</a>
            <a href="#route" class="link inline-flex items-center gap-2 font-semibold no-underline hover:underline">Zo kom je er <Icoon naam="pijl" class="h-4 w-4" /></a>
          </p>
        </div>
      </div>
      <div class="relative">
        <Image quality={68} src={terras} alt="Restaurant Salsuta van bovenaf: het terras met rode parasols aan het water, bootjes aan de steiger en de polder erachter" widths={[640, 1024, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="h-[56vw] max-h-[44rem] min-h-[20rem] w-full object-cover object-[50%_60%]" />
        <div class="donker absolute inset-x-0 bottom-0 bg-nacht/92 text-licht backdrop-blur-sm">
          <div class="wrap bord grid grid-cols-2 gap-x-6 gap-y-1 py-3.5 text-sm md:flex md:items-center md:gap-10">
            <p class="col-span-2 font-semibold text-limoen md:col-span-1">Veerpont naar De Woude</p>
            <p>Overtocht ± 2 minuten</p>
            <p>Retour € 1,10</p>
            <p class="col-span-2 md:col-span-1" data-pont>Laatste pont: zie tijden</p>
            <p class="col-span-2 hidden md:ml-auto md:block" data-status-wrap><span data-status>Open do t/m zo vanaf 10.00 uur</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- De naam: zout, suiker en smaak -->
    <section class="wrap grid gap-x-10 gap-y-12 py-20 md:py-28 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Sal, azúcar <br class="hidden lg:block" />y sabor.</h2>
        <p class="mt-6 max-w-sm text-lg text-grijs">Zout, suiker en smaak. Van de eerste letters komt de naam Salsuta.</p>
        <p class="mt-10 max-w-sm">Chef-kok Pieter Bais kookt een kaart van broodje kaas tot tataki van tonijn. Het gebak is huisgemaakt, door patissière Ivette Victoria.</p>
        <p class="mt-8"><a href="#kaart" class="link font-semibold">Bekijk de kaart</a></p>
      </div>
      <div class="relative lg:col-span-7">
        <Image quality={68} src={poke} alt="Poké bowl met zalm, avocado en groente op een houten tafel bij het raam" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/5] w-full object-cover sm:ml-auto sm:w-[78%] lg:aspect-[1/1]" />
        <Image quality={68} src={tartaar} alt="Steaktartaar met eidooier, brood en mayonaise op een leisteen bord" widths={[300, 520]} sizes="(min-width: 1024px) 18vw, 40vw" class="rijs mt-4 aspect-[3/4] w-[46%] object-cover sm:absolute sm:-bottom-12 sm:left-0 sm:mt-0 sm:w-[38%] sm:border-8 sm:border-papier" />
      </div>
    </section>

    <!-- Menukaart -->
    <section id="kaart" class="bg-wit py-20 md:py-28">
      <div class="wrap grid gap-x-12 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <h2 class="text-3xl">De kaart</h2>
            <p class="mt-4 text-grijs">Menukaart 2026, met prijzen in euro's.</p>
            <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="Onderdelen van de kaart" data-tabs>
              {kaart.map((k, i) => (
                <button type="button" role="tab" id={`tab-${k.id}`} aria-controls={`kaart-${k.id}`} aria-selected={i === 0 ? 'true' : 'false'} class="rounded-full border-[1.5px] border-inkt px-4 py-2 text-sm font-semibold transition-colors hover:bg-papier-2 aria-selected:bg-inkt aria-selected:text-licht">{k.titel}</button>
              ))}
            </div>
            <ul class="mt-10 space-y-3 text-sm text-grijs">
              <li><Fragment set:html={blad} /> = vegetarische optie</li>
              <li>Vlees van de week en vis van de afslag: vraag het ons.</li>
              <li>Klassieke cocktails van barman Oscar, van € 9 tot € 15.</li>
            </ul>
          </div>
        </div>
        <div class="lg:col-span-8">
          {kaart.map((k, i) => (
            <div id={`kaart-${k.id}`} role="tabpanel" aria-labelledby={`tab-${k.id}`} class:list={['kaartdeel', i > 0 && 'js-verberg']} data-paneel>
              <h3 class="border-b-2 border-inkt pb-3 text-2xl">{k.titel}</h3>
              <ul class="mt-2 grid gap-x-12 md:grid-cols-2">
                {k.regels.map((r) => (
                  <li class="border-b border-lijn py-4">
                    <p class="regel font-semibold"><span>{r.n} {r.v && <Fragment set:html={blad} />}</span><span class="stip" aria-hidden="true"></span><span class="num">{r.p}</span></p>
                    {r.b && <p class="mt-0.5 max-w-[30ch] text-sm text-grijs">{r.b}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Fotostrook eten -->
    <section aria-label="Foto's van gerechten" class="grid grid-cols-2 bg-wit md:h-[24rem] md:grid-cols-12">
      <Image quality={68} src={vis} alt="Gebakken vis met tomatensalsa en wortel op een blauw bord" widths={[400, 700]} sizes="(min-width: 768px) 30vw, 50vw" class="aspect-square h-full w-full object-cover md:col-span-4 md:aspect-auto" />
      <Image quality={68} src={club} alt="Clubsandwich met frites op het terras" widths={[400, 600]} sizes="(min-width: 768px) 25vw, 50vw" class="aspect-square h-full w-full object-cover md:col-span-3 md:aspect-[3/4]" />
      <Image quality={68} src={cheesecake} alt="Huisgemaakte cheesecake met rode vruchten op het terras, met geraniums en boten op de achtergrond" widths={[400, 800]} sizes="(min-width: 768px) 25vw, 50vw" class="aspect-square h-full w-full object-cover md:col-span-3 md:aspect-auto" />
      <Image quality={68} src={citroen} alt="Citroentaart met meringue op het terras" widths={[300, 500]} sizes="(min-width: 768px) 17vw, 50vw" class="aspect-square h-full w-full object-cover md:col-span-2 md:aspect-auto" />
    </section>

    <!-- Zo kom je er -->
    <section id="route" class="donker bg-nacht py-24 text-licht md:py-32">
      <div class="wrap grid gap-x-12 gap-y-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Zo kom je er</h2>
          <p class="mt-5 max-w-md text-lg text-licht-zacht">Salsuta ligt op het eiland De Woude. De laatste meters ga je over het water.</p>

          <ol class="mt-12 border-l-2 border-limoen pl-7">
            <li class="relative pb-9">
              <span class="absolute -left-[2.15rem] top-1 h-3 w-3 rounded-full bg-limoen" aria-hidden="true"></span>
              <p class="bord text-sm text-limoen">Aan de overkant</p>
              <h3 class="mt-1 text-xl">Parkeer bij de pont</h3>
              <p class="mt-1 text-licht-zacht">Bij de veerpont is meestal genoeg plek.</p>
            </li>
            <li class="relative pb-9">
              <span class="absolute -left-[2.15rem] top-1 h-3 w-3 rounded-full bg-limoen" aria-hidden="true"></span>
              <p class="bord text-sm text-limoen">± 2 minuten · retour € 1,10</p>
              <h3 class="mt-1 text-xl">Vaar over</h3>
              <p class="mt-1 text-licht-zacht">Geef aan dat je over wilt, dan word je meteen opgehaald.</p>
            </li>
            <li class="relative">
              <span class="absolute -left-[2.15rem] top-1 h-3 w-3 rounded-full bg-limoen" aria-hidden="true"></span>
              <p class="bord text-sm text-limoen">± 5 minuten lopen</p>
              <h3 class="mt-1 text-xl">Naar Woude 1a</h3>
              <p class="mt-1 text-licht-zacht">Langs het water naar het terras.</p>
            </li>
          </ol>
          <p class="mt-12 flex flex-wrap gap-x-7 gap-y-4">
            <a href={site.pontMaps} class="knop knop-limoen"><Icoon naam="pin" />Route naar de pont</a>
            <a href="#reserveren" class="link self-center font-semibold">Laatste pont per dag</a>
          </p>
        </div>

        <div class="lg:col-span-7">
          <!-- Eigen tekening van de oversteek, naar de ligging op de kaart (niet op schaal). -->
          <figure class="rounded-md bg-nacht-2 p-4 md:p-6">
            <svg viewBox="0 0 640 520" class="h-auto w-full" role="img" aria-labelledby="kaart-titel">
              <title id="kaart-titel">Tekening van de route: parkeren aan de oostkant, met de pont het kanaal over en vijf minuten lopen langs het water naar Salsuta.</title>
              <defs>
                <pattern id="golf" width="22" height="10" patternUnits="userSpaceOnUse"><path d="M0 6c3.5-3 7.5-3 11 0s7.5 3 11 0" fill="none" stroke="#f3f4ef" stroke-opacity=".12" stroke-width="1.2" /></pattern>
              </defs>
              <!-- eiland (west) en vaste wal (oost) -->
              <path d="M0 0h300c-14 120-10 250 4 520H0Z" fill="#1e2a1a" />
              <path d="M640 0H430c-10 150-6 330 14 520h196Z" fill="#1e2a1a" />
              <!-- kanaal -->
              <path d="M300 0h130c-10 150-6 330 14 520H304C290 250 286 120 300 0Z" fill="#2c3d44" />
              <path d="M300 0h130c-10 150-6 330 14 520H304C290 250 286 120 300 0Z" fill="url(#golf)" />
              <!-- haventje bij Salsuta -->
              <g stroke="#f3f4ef" stroke-opacity=".35" stroke-width="3" stroke-linecap="round"><path d="M296 120h40M296 150h34M296 180h40" /></g>
              <!-- weg langs de oostkant -->
              <path d="M520 0c-8 170-4 330 20 520" fill="none" stroke="#f3f4ef" stroke-opacity=".18" stroke-width="10" />
              <!-- wandelroute langs het water -->
              <path class="loop" d="M286 418C270 360 262 300 266 240S272 170 262 148" fill="none" stroke="#bad607" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="2 10" />
              <!-- pont -->
              <path class="vaart" d="M432 428C400 424 340 424 296 420" fill="none" stroke="#bad607" stroke-width="3.5" stroke-dasharray="12 9" />
              <rect x="350" y="410" width="34" height="18" rx="3" fill="#f3f4ef" />
              <!-- P -->
              <g transform="translate(468 400)"><rect width="40" height="40" rx="6" fill="#f3f4ef" /><text x="20" y="29" text-anchor="middle" font-family="Albert Sans Variable, sans-serif" font-weight="800" font-size="24" fill="#121412">P</text></g>
              <!-- Salsuta -->
              <g transform="translate(230 112)"><circle cx="32" cy="36" r="14" fill="#bad607" /><circle cx="32" cy="36" r="24" fill="none" stroke="#bad607" stroke-opacity=".4" stroke-width="2" /></g>
              <!-- labels -->
              <g font-family="Albert Sans Variable, sans-serif" fill="#f3f4ef" font-size="17" font-weight="600">
                <text x="34" y="140" font-family="Abril Fatface, serif" font-weight="400" font-size="30">Salsuta</text>
                <text x="34" y="166" fill="#b9bdb4" font-size="15" font-weight="500">Woude 1a</text>
                <text x="40" y="300" fill="#b9bdb4" font-size="15">± 5 min lopen</text>
                <text x="36" y="430" fill="#b9bdb4" font-size="15">aanleg pont</text>
                <text x="352" y="470" text-anchor="middle">pont ± 2 min</text>
                <text x="520" y="468" text-anchor="middle" fill="#b9bdb4" font-size="15">parkeren</text>
                <text x="70" y="40" fill="#b9bdb4" font-size="13" letter-spacing="2">EILAND DE WOUDE</text>
                <text x="372" y="250" fill="#b9bdb4" font-size="13" letter-spacing="2" transform="rotate(-88 372 250)">KANAAL</text>
              </g>
              <!-- noordpijl -->
              <g transform="translate(596 44)" fill="#f3f4ef"><path d="M0-18 7 6 0 1-7 6Z" /><text y="26" text-anchor="middle" font-family="Albert Sans Variable, sans-serif" font-size="12" font-weight="700">N</text></g>
            </svg>
            <figcaption class="mt-3 text-xs text-licht-zacht">Getekend naar de ligging op de kaart, niet op schaal.</figcaption>
          </figure>

          <div class="mt-6 grid gap-6 sm:grid-cols-5">
            <Image quality={68} src={pont} alt="De veerpont legt aan, met de slagboom nog dicht" widths={[360, 600]} sizes="(min-width: 1024px) 22vw, 40vw" class="aspect-[4/5] w-full object-cover sm:col-span-2" />
            <div class="self-end sm:col-span-3">
              <h3 class="text-2xl">Met de boot?</h3>
              <p class="mt-3 text-licht-zacht">Er is een steiger voor de deur. Zeg bij het reserveren dat je met de boot komt.</p>
              <blockquote class="mt-6 border-l-2 border-limoen pl-5">
                <p class="text-[.9375rem]">“{reviewBoot.tekst}”</p>
                <footer class="mt-2 text-xs text-licht-zacht">{reviewBoot.naam}, Google review</footer>
              </blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pieter en Ivette -->
    <section id="keuken" class="wrap grid gap-x-12 gap-y-12 py-20 md:py-28 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Image quality={68} src={pieter} alt="Chef-kok Pieter Bais in zijn keuken" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 38vw, 100vw" class="aspect-[4/5] w-full object-cover object-top lg:aspect-[3/4]" />
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:pt-10">
        <h2 class="text-3xl">Pieter kookt, <br />Ivette bakt.</h2>
        <p class="mt-8 text-lg">Pieter Bais kookte in Londen, Barcelona en Zwitserland en voer vier jaar als chef-kok mee op een vijfsterren cruiseschip. Zijn passie: de Italiaanse, Spaanse en Japanse keuken.</p>
        <p class="mt-5 text-grijs">Ivette Victoria leerde het vak van patissier in Venezuela. Haar taarten zijn huisgemaakt, van appeltaart tot patisserie-kunststukjes.</p>
        <div class="mt-12 grid grid-cols-5 items-end gap-5">
          <Image quality={68} src={taart} alt="Een hoge taart van Ivette in zwart-wit, met een draaimolen als bovenste laag" widths={[300, 520]} sizes="(min-width: 1024px) 18vw, 40vw" class="col-span-2 aspect-[3/4] w-full object-cover lg:aspect-auto lg:h-[19rem]" />
          <Image quality={68} src={bar} alt="De bar met koperen lampen, rode krukken en wandschilderijen" widths={[400, 700]} sizes="(min-width: 1024px) 26vw, 60vw" class="col-span-3 aspect-[4/5] w-full object-cover lg:aspect-auto lg:h-[19rem]" />
        </div>
      </div>
    </section>

    <!-- Feesten -->
    <section id="feesten" class="bg-limoen">
      <div class="grid lg:grid-cols-12">
        <Image quality={68} src={haven} alt="Salsuta en het haventje vanuit de lucht, met boten aan de steigers en weilanden erachter" widths={[640, 1024, 1400]} sizes="(min-width: 1024px) 58vw, 100vw" class="aspect-[4/3] h-full w-full object-cover lg:col-span-7" />
        <div class="px-5 py-16 md:px-10 lg:col-span-5 lg:px-14 lg:py-24">
          <h2 class="text-3xl">Iets te vieren?</h2>
          <p class="mt-6 max-w-md text-lg">Salsuta heeft een aparte ruimte voor feesten. Het menu stemmen we af op wat jullie lekker vinden.</p>
          <p class="mt-8 font-kop text-2xl leading-snug">Bruiloft / doopfeest / verjaardag / brunch / eindejaarsfeest met de zaak</p>
          <p class="mt-10"><a href={waFeest} class="knop knop-inkt"><Icoon naam="wa" />Vraag het via WhatsApp</a></p>
        </div>
      </div>
    </section>

    <!-- Reviews -->
    <section id="reviews" class="wrap py-20 md:py-28">
      <div class="grid gap-x-12 gap-y-12 lg:grid-cols-12">
        <figure class="lg:col-span-7">
          <blockquote>
            <p class="font-kop text-3xl leading-[1.05]">“Wat een leuk plekje om te eten, zo op een eiland!”</p>
          </blockquote>
          <figcaption class="mt-5 text-sm text-grijs">{reviews[1].naam}, Google review, {reviews[1].wanneer}</figcaption>
          <Image quality={68} src={vanafWater} alt="Salsuta gezien vanaf het water, met de rood-witte vuurtoren bij de haven" widths={[640, 1000, 1400]} sizes="(min-width: 1024px) 55vw, 100vw" class="mt-12 aspect-[16/10] w-full object-cover lg:aspect-[2/1]" />
        </figure>
        <div class="space-y-10 lg:col-span-5 lg:pt-4">
          {[reviews[0], reviews[2], reviews[3]].map((r) => (
            <blockquote class="border-t-2 border-inkt pt-5">
              <p class="flex gap-0.5 text-inkt" role="img" aria-label="5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</p>
              <p class="mt-3">“{r.tekst}”</p>
              <footer class="mt-3 text-sm text-grijs">{r.naam}, Google review, {r.wanneer}</footer>
            </blockquote>
          ))}
          <p><a href={site.maps} class="link inline-flex items-center gap-2 font-semibold"><Icoon naam="g" class="h-4 w-4" />Alle reviews op Google</a></p>
        </div>
      </div>
    </section>

    <!-- Reserveren + tijden -->
    <section id="reserveren" class="bg-wit py-20 md:py-28">
      <div class="wrap grid gap-x-14 gap-y-16 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-3xl">Reserveren</h2>
          <p class="mt-4 max-w-lg text-grijs">Vul de zin aan en stuur hem via WhatsApp. Voor het diner nemen we reserveringen aan tot 19.00 uur.</p>
          <form class="mt-10 text-xl leading-[2.4] md:text-2xl md:leading-[2.3]" data-zin novalidate>
            <p>
              Hallo Salsuta, ik wil graag reserveren op
              <label class="sr-only" for="z-datum">Datum</label><input id="z-datum" type="date" class="veld w-[12.5rem] text-xl" required />
              om <label class="sr-only" for="z-tijd">Tijd</label><select id="z-tijd" class="veld w-[7rem] text-xl">
                {['10.00', '11.00', '12.00', '12.30', '13.00', '13.30', '14.00', '17.00', '17.30', '18.00', '18.30', '19.00'].map((t) => <option selected={t === '18.00'}>{t}</option>)}
              </select> uur
              met <label class="sr-only" for="z-pers">Aantal personen</label><input id="z-pers" type="number" min="1" max="60" value="2" class="veld num w-[4.5rem] text-center text-xl" /> personen.
              We komen <label class="sr-only" for="z-hoe">Hoe je komt</label><select id="z-hoe" class="veld w-[14rem] text-xl">
                <option>met de pont</option><option>met de boot</option><option>op de fiets</option><option>wandelend</option>
              </select>.
            </p>
            <p class="mt-6 min-h-[1.5rem] text-base leading-normal text-grijs" aria-live="polite" data-zin-melding></p>
            <p class="mt-4 flex flex-wrap items-center gap-x-7 gap-y-4 text-base leading-normal">
              <button type="submit" class="knop knop-limoen"><Icoon naam="wa" />Stuur via WhatsApp</button>
              <span>of bel <a href={site.telHref} class="link num font-semibold">{site.tel}</a></span>
            </p>
          </form>
        </div>

        <div class="lg:col-span-5">
          <h3 class="text-2xl">Open en de laatste pont</h3>
          <p class="mt-3 flex items-center gap-2 text-sm font-semibold" data-status-wrap><span class="stip-status h-2 w-2 rounded-full bg-grijs" aria-hidden="true"></span><span data-status>Woensdag gesloten</span></p>
          <table class="mt-6 w-full text-[.9375rem]">
            <caption class="sr-only">Openingstijden en laatste pont</caption>
            <thead><tr class="border-b-2 border-inkt text-left text-xs text-grijs"><th scope="col" class="pb-2 font-semibold">Dag</th><th scope="col" class="pb-2 font-semibold">Open</th><th scope="col" class="pb-2 text-right font-semibold">Laatste pont</th></tr></thead>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:bg-limoen data-[vandaag]:font-semibold">
                  <th scope="row" class="py-2.5 pl-2 text-left font-normal">{t.naam}</th>
                  <td class="num py-2.5">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
                  <td class="num py-2.5 pr-2 text-right">{t.pont || '-'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-8">{site.straat}, {site.postcode} {site.plaats}</p>
          <p class="mt-1 text-sm text-grijs"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  :global(.js) .js-verberg { display: none; }
  [data-open='true'] .stip-status { background: #3f9b2f; box-shadow: 0 0 0 3px #3f9b2f33; }
  .vaart { animation: varen 2.4s linear infinite; }
  @keyframes varen { to { stroke-dashoffset: -42; } }
  input[type='number']::-webkit-inner-spin-button { opacity: .4; }
</style>

<script>
  import { site } from '../data/site';
  // Tabs van de kaart
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tabs] [role=tab]')];
  const panelen = [...document.querySelectorAll<HTMLElement>('[data-paneel]')];
  const kies = (i: number) => {
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
    panelen.forEach((p, j) => p.classList.toggle('js-verberg', i !== j));
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => kies(i));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { const n = (i + d + tabs.length) % tabs.length; kies(n); tabs[n].focus(); }
    });
  });

  // Reserveerzin: controleert de echte tijden en opent WhatsApp met het ingevulde bericht.
  const f = document.querySelector<HTMLFormElement>('[data-zin]');
  if (f) {
    const datum = f.querySelector<HTMLInputElement>('#z-datum')!;
    const tijd = f.querySelector<HTMLSelectElement>('#z-tijd')!;
    const pers = f.querySelector<HTMLInputElement>('#z-pers')!;
    const hoe = f.querySelector<HTMLSelectElement>('#z-hoe')!;
    const melding = f.querySelector<HTMLElement>('[data-zin-melding]')!;
    datum.min = new Date().toISOString().slice(0, 10);
    const dagen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
    const check = () => {
      melding.textContent = '';
      if (!datum.value) return true;
      const d = new Date(datum.value + 'T12:00:00').getDay();
      const u = Number(tijd.value.split('.')[0]);
      if (d === 3) { melding.textContent = 'Op woensdag zijn we dicht. Kies een andere dag.'; return false; }
      if ((d === 1 || d === 2) && u >= 15) { melding.textContent = `Op ${dagen[d]} zijn we open tot 15.00 uur.`; return false; }
      if (hoe.value === 'met de boot') melding.textContent = 'Dan staat in je bericht dat je met de boot komt.';
      return true;
    };
    [datum, tijd, hoe].forEach((el) => el.addEventListener('change', check));
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!datum.value) { melding.textContent = 'Kies eerst een datum.'; datum.focus(); return; }
      if (!check()) return;
      const d = new Date(datum.value + 'T12:00:00');
      const datumTekst = `${dagen[d.getDay()]} ${d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long' })}`;
      const tekst = `Hallo Salsuta, ik wil graag reserveren op ${datumTekst} om ${tijd.value} uur met ${pers.value || 2} personen. We komen ${hoe.value}. Mijn naam is `;
      window.open(`${site.wa}?text=${encodeURIComponent(tekst)}`, '_blank', 'noopener');
    });
  }
</script>
