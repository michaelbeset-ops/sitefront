---
import { url, waOfferte, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['diensten', 'Diensten'], ['werk', 'Ons werk'], ['werkwijze', 'Werkwijze'], ['daniel', 'Over Daniel'], ['reviews', 'Reviews'], ['offerte', 'Contact']];
---
<div class="bg-nacht text-licht">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[.8125rem]">
    <ul class="flex items-center gap-6 overflow-hidden whitespace-nowrap">
      <li class="flex items-center gap-1.5"><Icoon naam="vink" class="h-3.5 w-3.5 text-mos" />Specialist in platte daken</li>
      <li class="hidden items-center gap-1.5 sm:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-mos" />Offerte op maat</li>
      <li class="hidden items-center gap-1.5 lg:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-mos" />{site.google.score} op Google uit {site.google.aantal} reviews</li>
    </ul>
    <p class="hidden items-center gap-6 md:flex">
      <a href={`mailto:${site.mail}`} class="flex items-center gap-1.5 no-underline hover:text-mos"><Icoon naam="mail" class="h-3.5 w-3.5" />{site.mail}</a>
      <a href={site.telHref} class="num flex items-center gap-1.5 font-semibold no-underline hover:text-mos"><Icoon naam="tel" class="h-3.5 w-3.5" />{site.tel}</a>
    </p>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-lijn bg-kalk/95 backdrop-blur-md">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <Merk />
    <nav aria-label="Hoofdmenu" class="hidden xl:block">
      <ul class="flex gap-7 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-salie">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={site.telHref} class="num hidden font-semibold no-underline transition-colors hover:text-salie 2xl:inline">{site.tel}</a>
      <a href={waOfferte} class="knop knop-salie knop-klein hidden sm:inline-flex"><Icoon naam="wa" />Offerte via WhatsApp</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full bg-wit shadow-sm xl:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu" aria-label="Menu" class="hidden border-t border-lijn bg-kalk xl:hidden" data-menu>
    <ul class="wrap py-4">
      {nav.map(([id, t]) => <li><a href={h(id)} class="flex items-center justify-between border-b border-lijn py-3.5 font-kop text-lg font-semibold no-underline">{t}<Icoon naam="pijl" class="h-5 w-5 text-salie" /></a></li>)}
      <li class="pt-5"><a href={waOfferte} class="knop knop-salie w-full"><Icoon naam="wa" />Offerte via WhatsApp</a></li>
    </ul>
  </nav>
</header>

<!-- Mobiele onderbalk -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2.5 border-t border-lijn bg-kalk/95 p-2.5 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="knop knop-wit knop-klein shadow-sm"><Icoon naam="tel" />Bellen</a>
  <a href={waOfferte} class="knop knop-salie knop-klein"><Icoon naam="wa" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
