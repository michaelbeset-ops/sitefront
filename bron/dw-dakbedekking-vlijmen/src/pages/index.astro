---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, citaten, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import nieuwbouw from '../assets/nieuwbouw.jpg';
import isolatie from '../assets/isolatie.jpg';
import reparatie from '../assets/reparatie.jpg';
import onderhoud from '../assets/onderhoud.jpg';
import koepels from '../assets/koepels.jpg';
import koepels2 from '../assets/koepels2.jpg';
import aanbouw from '../assets/aanbouw.jpg';
import underlaag from '../assets/underlaag.jpg';
import igHoek from '../assets/ig-hoek.jpg';
import igKoepel from '../assets/ig-koepel.jpg';
import igKoepel2 from '../assets/ig-koepel2.jpg';
import igRand from '../assets/ig-rand.jpg';
import igStrak from '../assets/ig-strak.jpg';
import igAfvoer from '../assets/ig-afvoer.jpg';

const diensten = [
  { t: 'Nieuwbouw', d: 'Nieuwe dakbedekking op een woning, aanbouw, garage of schuur.', src: nieuwbouw, alt: 'Een net afgewerkt plat dak met nieuwe bitumen dakbedekking en ontluchtingskappen', pos: '60% 60%' },
  { t: 'Renovatie', d: 'De oude laag eraf, waar nodig isolatie erop en een nieuwe dakbedekking eroverheen.', src: igHoek, alt: 'Vernieuwde dakbedekking op een plat dak tegen een pannendak en een bakstenen gevel', pos: '50% 60%' },
  { t: 'Reparatie en dakschade', d: 'Lekkage of schade aan een plat dak of dakkapel, vakkundig verholpen.', src: reparatie, alt: 'Een dakdekker zet een nieuwe houten dakrand op een plat dak boven een garage', pos: '50% 45%' },
  { t: 'Onderhoud en reiniging', d: 'Een verweerd of vervuild dak laten nakijken en schoonmaken, zodat het langer meegaat.', src: onderhoud, alt: 'Een verweerd plat dak met vlekken en mos, klaar voor onderhoud', pos: '50% 50%' },
  { t: 'Lichtkoepels', d: 'Lichtkoepels geplaatst en netjes ingewerkt in de dakbedekking.', src: koepels, alt: 'Twee lichtkoepels op een plat dak met uitzicht over de stad', pos: '50% 45%' },
];

const lagen = [
  { n: 'Voor', t: 'Verweerde dakbedekking', src: underlaag, alt: 'Een oud plat dak met verkleurde, verweerde banen bitumen', pos: '40% 50%' },
  { n: 'Tijdens', t: 'Isolatie en ondergrond', src: isolatie, alt: 'Isolatieplaten met ringen vastgezet op een plat dak', pos: '55% 55%' },
  { n: 'Na', t: 'Nieuwe dakbedekking', src: aanbouw, alt: 'Een nieuw plat dak met een lichtkoepel, naast een pannendak', pos: '45% 60%' },
];

const werk = [
  { src: igStrak, alt: 'Strak afgewerkte dakrand van een nieuw plat dak' },
  { src: igKoepel, alt: 'Een lichtkoepel in een licht grijs plat dak' },
  { src: koepels2, alt: 'Lichtkoepels op een plat dak, hoog boven de stad' },
  { src: igKoepel2, alt: 'Een lichtkoepel op een plat dak in de avondzon' },
  { src: igAfvoer, alt: 'Ingewerkte ontluchting en regenpijp op een nieuw plat dak' },
  { src: igRand, alt: 'Een nieuw plat dak met opstaande rand aan de tuinkant' },
];

const stappen = [
  ['Bellen of appen', 'Bel of app Daniel. Een foto van uw dak helpt om direct een beeld te krijgen.'],
  ['Advies en offerte op maat', 'U hoort eerlijk wat er nodig is en krijgt een offerte die past bij uw dak.'],
  ['Vakwerk op het dak', 'Daniel en zijn team voeren het werk uit zoals het is afgesproken.'],
  ['Klaar en opgeleverd', 'U ziet het resultaat en weet waar u aan toe bent. Vragen achteraf? Gewoon bellen.'],
];

const kies = (d: string) => waMet(`Hallo Daniel, ik heb een vraag over ${d.toLowerCase()} van mijn dak.`);
const sterren = [1, 2, 3, 4, 5];
---
<Base title={`${site.naam} | Dakdekker in Vlijmen, specialist in platte daken`} description="Specialist in platte daken uit Vlijmen: nieuwbouw, renovatie, reparatie, onderhoud, reiniging en lichtkoepels. 4,9 op Google uit 52 reviews. Offerte op maat via WhatsApp of telefoon.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen werk op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" quality={68} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[58%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#12141240_0%,#121412a6_42%,#121412f5_100%)] lg:bg-[linear-gradient(180deg,#12141226_0%,#12141266_40%,#121412f2_92%),linear-gradient(90deg,#121412cc_0%,#12141200_60%)]" aria-hidden="true"></div>
      <div class="wrap w-full pb-14 pt-28 md:pb-16 lg:pt-32">
        <div class="grid items-end gap-12 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <p class="eyebrow">Dakdekker in Vlijmen</p>
            <h1 id="t-hero" class="mt-6 text-hero">Specialist in <span class="text-mos">platte daken.</span></h1>
            <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Nieuwbouw, renovatie, reparatie, onderhoud en reiniging. Vakwerk van Daniel Worang en zijn team, met een offerte op maat.</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#offerte" class="knop knop-salie">Offerte aanvragen<Icoon naam="pijl" /></a>
              <a href="#werk" class="knop knop-rand op-foto">Bekijk ons werk</a>
            </div>
          </div>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-t border-licht/20 pt-6 text-[.9375rem] lg:col-span-4 lg:grid-cols-1 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
            <div>
              <dt class="sr-only">Google</dt>
              <dd class="flex items-center gap-2"><span class="flex text-ster">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num font-kop text-lg text-licht">{site.google.score}</b></dd>
              <dd class="mt-1 text-licht/80">{site.google.aantal} reviews op Google</dd>
            </div>
            <div data-status-wrap>
              <dt class="sr-only">Bereikbaar</dt>
              <dd class="flex items-center gap-2"><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 7.00 tot 19.00 uur</span></dd>
              <dd class="mt-1 text-licht/80">Za 7.00 tot 13.00 uur</dd>
            </div>
            <div class="col-span-2 lg:col-span-1">
              <dt class="text-licht/80">Bellen of WhatsApp</dt>
              <dd><a href={site.telHref} class="num font-kop text-2xl font-semibold tracking-tight text-licht no-underline hover:text-mos">{site.tel}</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Werkzaamheden in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-full bg-steen px-4 py-2 text-sm font-medium no-underline transition-colors hover:bg-salie hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Wat we doen</p>
            <h2 id="t-diensten" class="mt-5 text-3xl">Alles voor uw platte dak, van nieuw tot onderhoud.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een nieuw dak, een lekkage of een dak dat aan onderhoud toe is: u krijgt advies over wat er echt nodig is.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href="#offerte" data-kies={b.t} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw" class="aspect-[16/9] w-full object-cover transition-transform sm:aspect-[3/2] duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-5 sm:p-6">
                  <div>
                    <h3 class="text-xl">{b.t}</h3>
                    <p class="mt-2 text-grijs">{b.d}</p>
                  </div>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-steen text-salie transition-colors group-hover:bg-salie group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
          <li class="rijs" style="--d:.12s">
            <div class="donker flex h-full flex-col justify-between gap-8 rounded-[var(--radius-md)] bg-nacht p-7 text-licht lg:p-8">
              <div>
                <span class="grid h-12 w-12 place-items-center rounded-full bg-salie text-wit"><Icoon naam="foto" class="h-6 w-6" /></span>
                <h3 class="mt-6 text-2xl">Twijfelt u wat uw dak nodig heeft?</h3>
                <p class="mt-3 text-licht-zacht">Stuur een paar foto’s via WhatsApp. Daniel kijkt met u mee en laat weten wat hij ervan denkt.</p>
              </div>
              <a href={kies('de staat')} class="knop knop-salie self-start"><Icoon naam="wa" />Foto’s sturen</a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-grijs">Gemiddelde score op Google</dt><dd class="num order-first font-kop text-[clamp(2.25rem,2.4vw+1.4rem,3.25rem)] font-bold leading-none tracking-[-0.04em] text-salie">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Google-reviews</dt><dd class="num order-first font-kop text-[clamp(2.25rem,2.4vw+1.4rem,3.25rem)] font-bold leading-none tracking-[-0.04em]">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Reviews met vijf sterren</dt><dd class="num order-first font-kop text-[clamp(2.25rem,2.4vw+1.4rem,3.25rem)] font-bold leading-none tracking-[-0.04em]">{site.google.vijf}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Dagen per week bereikbaar</dt><dd class="num order-first font-kop text-[clamp(2.25rem,2.4vw+1.4rem,3.25rem)] font-bold leading-none tracking-[-0.04em]">6</dd></div>
      </dl>
    </section>

    <!-- 5. Werk -->
    <section id="werk" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Ons werk</p>
            <h2 id="t-werk" class="mt-5 text-3xl">Laag voor laag, tot het dak weer jaren mee kan.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-licht-zacht">Foto’s van daken waar Daniel en zijn team aan hebben gewerkt, van de oude laag tot de afwerking. De drie fases hieronder komen uit verschillende projecten.</p>
            <a href={site.instagram} class="knop knop-rand knop-klein mt-6"><Icoon naam="insta" />Meer op Instagram</a>
          </div>
        </div>
        <ol class="mt-12 grid gap-4 md:grid-cols-3 lg:mt-14 lg:gap-5">
          {lagen.map((l, i) => (
            <li class="rijs relative overflow-hidden rounded-[var(--radius-md)] bg-nacht-2" style={`--d:${i * 0.07}s`}>
              <Image src={l.src} alt={l.alt} widths={[480, 720, 960]} sizes="(min-width: 1248px) 380px, (min-width: 768px) 31vw, 92vw" class="aspect-[4/3] w-full object-cover md:aspect-[16/11]" style={`object-position:${l.pos}`} />
              <div class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#121412f0,#12141200)] px-5 pb-5 pt-16">
                <p class="text-xs font-bold uppercase tracking-[.2em] text-mos"><span class="num">0{i + 1}</span> · {l.n}</p>
                <h3 class="mt-2 text-lg">{l.t}</h3>
              </div>
            </li>
          ))}
        </ol>
        <ul class="mt-4 grid grid-cols-3 gap-3 md:grid-cols-6 md:gap-4">
          {werk.map((w, i) => (
            <li class="rijs relative aspect-square overflow-hidden rounded-[var(--radius-sm)] bg-nacht-2" style={`--d:${(i % 6) * 0.04}s`}>
              <Image src={w.src} alt={w.alt} widths={[240, 400]} sizes="(min-width: 1248px) 190px, (min-width: 768px) 15vw, 30vw" class="tegel absolute inset-0 h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Van eerste belletje tot een dak dat klaar is.</h2>
          </div>
          <figure class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <blockquote class="font-kop text-lg font-medium leading-snug tracking-tight">“{citaten[0]}”</blockquote>
            <figcaption class="mt-2 text-sm text-grijs">Uit een Google-review</figcaption>
          </figure>
        </div>
        <ol class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative p-6 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2rem] font-bold leading-none text-salie">0{i + 1}</p>
              <h3 class="mt-6 text-lg sm:mt-8">{t}</h3>
              <p class="mt-2 text-grijs sm:mt-3">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over Daniel -->
    <section id="daniel" class="donker bg-nacht text-licht" aria-labelledby="t-daniel">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[28rem] lg:col-span-5">
          <Image src={reparatie} alt="Aan het werk: een nieuwe houten dakrand op een plat dak boven een garage" widths={[640, 960, 1200]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_40%]" />
          <p class="absolute bottom-4 left-4 rounded-full bg-salie px-4 py-1.5 text-sm font-semibold text-wit">Aan het werk</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-20 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Daniel</p>
          <h2 id="t-daniel" class="mt-5 text-3xl">U heeft Daniel zelf aan de lijn.</h2>
          <p class="mt-6 text-lg text-licht-zacht">DW Dakbedekking en Montage is het bedrijf van Daniel Worang uit Vlijmen. Hij en zijn team zijn gespecialiseerd in platte daken: van een nieuw dak op een aanbouw tot de reparatie van een dakkapel. Voor advies of een offerte belt of appt u rechtstreeks met Daniel.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-center gap-4 rounded-[var(--radius-sm)] bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-salie text-wit"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-base">Denkt met u mee</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Klanten noemen het meedenken steeds weer in hun reviews.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-[var(--radius-sm)] bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-salie text-wit"><Icoon naam="tel" class="h-5 w-5" /></span>
              <div><h3 class="text-base">Heldere communicatie</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">“Goede communicatie” staat in meerdere reviews.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-[var(--radius-sm)] bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-salie text-wit"><Icoon naam="hand" class="h-5 w-5" /></span>
              <div><h3 class="text-base">Afspraak is afspraak</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">“Eerlijk en betrouwbaar doen ze wat ze beloven”, schrijft een klant.</p></div>
            </li>
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-salie"><Icoon naam="wa" />App Daniel</a>
            <a href={site.telHref} class="knop knop-rand num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="bg-steen py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-bold">{site.google.score}</b><span class="flex text-ster">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class={`rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7 ${i === 0 ? 'md:col-span-2 lg:p-9' : ''}`} style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class={`mt-5 flex-1 leading-relaxed ${i === 0 ? 'text-lg md:font-kop md:text-[1.375rem] md:font-medium md:leading-snug md:tracking-tight' : 'text-[1.0625rem]'}`}>“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-steen font-kop font-semibold text-salie" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <!-- 9. Offerte: dak-check die eindigt in een WhatsApp-bericht -->
    <section id="offerte" class="py-20 lg:py-24" aria-labelledby="t-offerte">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-offerte" class="mt-5 text-3xl">Vertel ons over uw dak.</h2>
          <p class="mt-6 text-lg text-grijs">Beantwoord een paar korte vragen. Wij zetten het in een bericht voor Daniel; foto’s van uw dak stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid grid-cols-1 gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-full bg-salie text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-salie" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-full bg-steen text-salie"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Ma t/m vr 7.00 tot 19.00, za tot 13.00 uur</span></span><Icoon naam="pijl" class="h-5 w-5 text-salie" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-full bg-steen text-salie"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-salie" /></a></li>
          </ul>
          <div class="kaart mt-6 p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-lg">Bereikbaar</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za</span></p>
            </div>
            <table class="mt-3 w-full text-[.9375rem]">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-salie">
                    <th scope="row" class="py-1.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-1.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="mt-5 flex flex-col gap-4 border-t border-lijn pt-5 sm:flex-row sm:items-center sm:justify-between">
              <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-5 w-5 shrink-0 text-salie" /><span><b class="font-semibold">{site.straat}</b><br /><span class="text-grijs">{site.postcode} {site.plaats}</span></span></p>
              <a href={site.maps} class="knop knop-inkt knop-klein shrink-0">Route<Icoon naam="pijl" /></a>
            </div>
          </div>
        </div>

        <form class="kaart min-w-0 self-start p-6 sm:p-8 lg:col-span-7 lg:p-10" data-check aria-describedby="check-uitleg">
          <h3 class="text-2xl">Dak-check in vier vragen</h3>
          <p id="check-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp of uw mail zelf op verzenden drukt.</p>

          <fieldset class="mt-8">
            <legend class="text-sm font-semibold"><span class="num text-salie">1</span> Wat is er nodig?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Nieuwbouw', 'Renovatie', 'Reparatie en dakschade', 'Onderhoud en reiniging', 'Lichtkoepels', 'Weet ik nog niet'].map((b) => (
                <label class="keuze"><input type="radio" name="wat" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>

          <fieldset class="mt-7">
            <legend class="text-sm font-semibold"><span class="num text-salie">2</span> Om wat voor dak gaat het?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Plat dak op woning of aanbouw', 'Dakkapel', 'Garage of schuur', 'Bedrijfspand'].map((b) => (
                <label class="keuze"><input type="radio" name="dak" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>

          <fieldset class="mt-7">
            <legend class="text-sm font-semibold"><span class="num text-salie">3</span> Ongeveer hoe groot? <span class="font-normal text-grijs">(mag een schatting zijn)</span></legend>
            <div class="mt-3 flex flex-wrap items-center gap-2 sm:gap-3">
              <label class="flex items-center gap-2"><span class="sr-only">Lengte in meters</span><input name="l" type="number" inputmode="decimal" min="0" step="0.5" placeholder="Lengte" class="veld w-28" /><span class="text-grijs">m</span></label>
              <span class="text-grijs" aria-hidden="true">×</span>
              <label class="flex items-center gap-2"><span class="sr-only">Breedte in meters</span><input name="b" type="number" inputmode="decimal" min="0" step="0.5" placeholder="Breedte" class="veld w-28" /><span class="text-grijs">m</span></label>
              <p class="flex items-center gap-2 rounded-full bg-steen px-4 py-2 text-sm font-semibold"><Icoon naam="meet" class="h-4 w-4 text-salie" /><span data-m2>Oppervlakte: ?</span></p>
            </div>
          </fieldset>

          <fieldset class="mt-7">
            <legend class="text-sm font-semibold"><span class="num text-salie">4</span> Hoe snel moet het?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Er lekt nu water binnen', 'Binnen een paar weken', 'Ik oriënteer me nog'].map((b) => (
                <label class="keuze"><input type="radio" name="wanneer" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block"><span class="text-sm font-semibold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld Vlijmen" /></label>
          </div>

          <div class="mt-8 rounded-[var(--radius-sm)] bg-[#e7efe2] p-4 sm:p-5">
            <p class="text-xs font-bold uppercase tracking-[.16em] text-salie">Uw bericht aan Daniel</p>
            <p class="bericht mt-3 whitespace-pre-line rounded-[.75rem] rounded-tl-none bg-wit px-4 py-3 text-[.9375rem] leading-relaxed shadow-sm" data-bericht aria-live="polite"></p>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
            <button type="submit" class="knop knop-salie"><Icoon naam="wa" />Verstuur via WhatsApp</button>
            <a href={`mailto:${site.mail}`} class="link text-sm font-semibold" data-mail>Liever per e-mail</a>
          </div>
        </form>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-salie text-wit" aria-label="Offerte aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.5rem,1.6vw+1.1rem,2.25rem)]">Een dak dat weer jaren mee kan?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel of app Daniel voor advies en een offerte op maat.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-check]');
  const uit = document.querySelector<HTMLElement>('[data-bericht]');
  const m2el = document.querySelector<HTMLElement>('[data-m2]');
  const mail = document.querySelector<HTMLAnchorElement>('[data-mail]');
  const bericht = () => {
    if (!f) return '';
    const d = new FormData(f);
    const v = (n: string) => String(d.get(n) || '').trim();
    const l = parseFloat(v('l').replace(',', '.')), b = parseFloat(v('b').replace(',', '.'));
    const m2 = l > 0 && b > 0 ? Math.round(l * b * 10) / 10 : 0;
    if (m2el) m2el.textContent = m2 ? `Oppervlakte: ${String(m2).replace('.', ',')} m²` : 'Oppervlakte: ?';
    const r = ['Hallo Daniel, ik wil graag een offerte voor mijn dak.'];
    if (v('wat')) r.push('Nodig: ' + v('wat'));
    if (v('dak')) r.push('Soort dak: ' + v('dak'));
    if (m2) r.push(`Afmeting: ongeveer ${String(l).replace('.', ',')} x ${String(b).replace('.', ',')} m (${String(m2).replace('.', ',')} m²)`);
    if (v('wanneer')) r.push('Wanneer: ' + v('wanneer'));
    if (v('plaats')) r.push('Plaats: ' + v('plaats'));
    r.push('Ik stuur zo een paar foto’s van het dak.');
    if (v('naam')) r.push('Groet, ' + v('naam'));
    return r.join('\n');
  };
  const toon = () => {
    const t = bericht();
    if (uit) uit.textContent = t;
    if (mail) mail.href = 'mailto:info@dwdakbedekking.nl?subject=' + encodeURIComponent('Offerte-aanvraag dak') + '&body=' + encodeURIComponent(t);
  };
  if (f) {
    f.addEventListener('input', toon);
    f.addEventListener('change', toon);
    toon();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31647973046?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
  }
  // Dienstkaart kiest alvast de juiste dienst in de dak-check.
  document.querySelectorAll<HTMLElement>('[data-kies]').forEach((a) => a.addEventListener('click', () => {
    const i = f?.querySelector<HTMLInputElement>(`input[name=wat][value="${a.dataset.kies}"]`);
    if (i) { i.checked = true; toon(); }
  }));
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: 1; letter-spacing: -0.045em; }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #4fc27f; box-shadow: 0 0 0 4px #4fc27f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: 999px; background: var(--color-steen); }
  .status-pil .status-stip { background: #8b918a; }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.05); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: 999px; background: var(--color-steen); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #d6d8cc; }
  .keuze input:checked + span { background: var(--color-salie); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-salie); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: .625rem; border: 1.5px solid #14161333; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld.w-28 { width: 5.25rem; } @media (min-width: 640px) { .veld.w-28 { width: 7rem; } }
  .veld:hover { border-color: #14161366; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-salie); }
  .veld::placeholder { color: #7b8079; }
</style>
