---
// Woordmerk naar hun logo: "boom" in kleine letters met "INTERIEUR BV" eronder; de punt in logo-magenta.
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = true } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col items-start no-underline ${licht ? 'text-wit' : 'text-zwart'}`}>
  <span class="font-kop text-[2.1rem] leading-[.8] tracking-[-.02em]">boom<span class={licht ? 'text-roze-licht' : 'text-roze'}>.</span></span>
  <span class="mt-1.5 text-[.625rem] font-semibold uppercase leading-none tracking-[.32em]">Interieur bv</span>
</a>
