---
import { site, url } from '../data/site';
import Merk from './Merk.astro';
import Windroos from './Windroos.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-diep text-mist">
  <Windroos class="pointer-events-none absolute -right-24 -top-24 h-[26rem] w-[26rem] text-wit/[.06]" naald="#ffffff10" />
  <div class="wrap relative grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Jacht- en scheepsbetimmeringen, zakelijke interieurs en woninginterieurs. Maatwerk uit Hardinxveld-Giessendam.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Wat wij maken</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={h('jacht')} class="link link-licht">Jacht- en scheepsinterieurs</a></li>
        <li><a href={h('zakelijk')} class="link link-licht">Zakelijke interieurs</a></li>
        <li><a href={h('woning')} class="link link-licht">Woninginterieurs</a></li>
        <li><a href={h('aanvraag')} class="link link-licht">Project bespreken</a></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.vastHref} class="link link-licht num">{site.vast}</a></p>
      <p class="mt-1.5"><a href={site.mobielHref} class="link link-licht num">{site.mobiel}</a></p>
      <p class="mt-1.5"><a href={site.wa} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-licht break-all">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Werkplaats</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.maps} class="link link-licht">Route plannen</a></p>
    </div>
  </div>
  <div class="wrap relative flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap relative pb-20 text-xs md:pb-8">Teksten en foto's van boominterieurbv.nl. Adres en vast nummer volgens Google (stand 7 oktober 2026).</p>}
</footer>
