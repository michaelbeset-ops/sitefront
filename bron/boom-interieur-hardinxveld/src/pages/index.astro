---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Windroos from '../components/Windroos.astro';
import { site, waMet, mailMet } from '../data/site';

import hero from '../assets/hero.jpg';
import salon from '../assets/salon.jpg';
import stuur from '../assets/stuur.jpg';
import noten from '../assets/noten.jpg';
import windroos from '../assets/windroos.jpg';
import ingang from '../assets/ingang.jpg';
import marriott from '../assets/marriott.jpg';
import marriott2 from '../assets/marriott2.jpg';
import lamel from '../assets/lamel.jpg';
import balie from '../assets/balie.jpg';
import moreliving from '../assets/moreliving.jpg';
import keuken from '../assets/keuken.jpg';
import kast from '../assets/kast.jpg';
import trapkast from '../assets/trapkast.jpg';

// Aanvraag: alleen de drie routes die ze zelf noemen (scheepsinterieurs, overheidsgebouwen/zakelijk, (luxe) woningen).
const keuzes = {
  soort: ['een jacht- of scheepsinterieur', 'een zakelijk interieur', 'een woninginterieur'],
  fase: ['nieuwbouw', 'een refit', 'een renovatie'],
  tekening: ['heb ik een tekening', 'heb ik nog geen tekening', 'heb ik een schets of foto'],
};
const zin = (s = 0, waar = '', f = 0, t = 0) => `Goedendag, ik zoek ${keuzes.soort[s]}${waar ? ` voor ${waar}` : ''}. Het gaat om ${keuzes.fase[f]} en daarvoor ${keuzes.tekening[t]}. Kunnen we het project bespreken?`;

const titel = 'Boom Interieur B.V. | Jacht- en scheepsbetimmeringen | Hardinxveld-Giessendam';
const omschrijving = 'Scheepsinterieurs in teak en noten, zakelijke interieurs en woninginterieurs. Geen seriewerk, maar maatwerk. Nijverheidsstraat 28, Hardinxveld-Giessendam.';
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO -->
    <section class="relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-diep text-wit md:min-h-[100svh]">
      <Kop />
      <Image src={hero} alt="" quality={80} widths={[640, 960, 1280, 1800]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[44%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0e1a1cb3_0%,#0e1a1c26_28%,#0e1a1c99_58%,#0e1a1cf2_100%)] md:bg-[linear-gradient(90deg,#0e1a1cc7_0%,#0e1a1c80_45%,#0e1a1c00_80%),linear-gradient(180deg,#0e1a1c99_0%,#0e1a1c00_24%,#0e1a1c1a_50%,#0e1a1ce6_100%)]"></div>
      <div class="wrap mt-auto grid grid-cols-1 items-end gap-10 pb-12 pt-28 md:pb-16 lg:grid-cols-12">
        <div class="lg:col-span-9">
          <p class="text-sm font-medium text-wit/85 md:text-base">Jacht- en scheepsbetimmering uit Hardinxveld-Giessendam</p>
          <h1 class="mt-4 text-hero">Geen seriewerk, maar <em class="text-roze-licht">maatwerk</em>.</h1>
          <p class="mt-6 max-w-2xl text-base text-wit/90 sm:text-lg md:text-xl">Scheepsinterieurs in teak en noten. En sinds enkele jaren ook interieurs voor overheidsgebouwen en luxe woningen.</p>
          <div class="mt-8 flex flex-wrap gap-3 md:mt-10">
            <a href="#aanvraag" class="knop knop-wit">Wat wilt u laten maken?</a>
            <a href={site.wa} class="knop knop-rand-wit max-sm:hidden"><Icoon naam="wa" />WhatsApp</a>
          </div>
        </div>
        <div class="hidden items-center justify-end gap-4 text-sm text-wit/80 lg:col-span-3 lg:flex">
          <span class="max-w-[11rem] text-right leading-snug">Ruim 25 jaar ervaring in scheepsinterieurs</span>
          <Windroos class="h-16 w-16 shrink-0 text-wit/80" naald="var(--color-roze-licht)" />
        </div>
      </div>
    </section>

    <!-- 2. OVER: VAN STUI NAAR BOOM -->
    <section id="over" class="py-20 md:py-28">
      <div class="wrap grid grid-cols-1 items-center gap-y-16 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <h2 class="rijs text-4xl">Van Stui naar <em>Boom</em>.</h2>
          <p class="rijs mt-8 text-lg md:text-xl" style="--d:.1s">Ruim 25 jaar ervaring in scheepsinterieurs, opgebouwd onder de naam Stui jacht- en scheepsbetimmeringen. In 2011 hebben wij het bedrijf overgenomen; Boom Interieur is er de voortzetting van.</p>
          <p class="rijs mt-5 text-grijs" style="--d:.15s">Wat aan boord begon, doen we nu ook aan wal: hotels, kantoren, overheidsgebouwen en woningen.</p>
        </div>
        <figure class="rijs lg:col-span-6 lg:col-start-7" style="--d:.1s">
          <div class="px-3 py-3 sm:px-7 sm:py-7">
            <Image src={salon} alt="Salon van een jacht in teak: dinette met lichte banken, patrijspoorten en dakluiken" quality={74} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 44vw, 92vw" class="poort aspect-[16/10] w-full object-cover" />
          </div>
          <figcaption class="mt-6 text-center text-xs text-grijs">Jachtinterieur in teak</figcaption>
        </figure>
      </div>
      <div class="wrap mt-16 md:mt-20">
        <blockquote class="rijs mx-auto max-w-4xl border-t border-lijn-licht pt-10 text-center">
          <Windroos class="mx-auto h-10 w-10 text-zwart" />
          <p class="mt-6 font-kop text-3xl italic leading-[1.2]">“Wij werken volledig volgens de wens van onze klanten. Zij bepalen hoe het interieur eruit gaat zien.”</p>
        </blockquote>
      </div>
    </section>

    <!-- 3. JACHT- EN SCHEEPSINTERIEURS -->
    <section id="jacht" class="bg-diep py-20 text-wit md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-6 lg:grid-cols-12 lg:gap-x-12">
        <h2 class="rijs text-4xl lg:col-span-7">Jacht- en scheeps&shy;interieurs.</h2>
        <p class="rijs text-lg text-mist lg:col-span-4 lg:col-start-9 lg:pt-4" style="--d:.1s">Jacht- en scheepsinterieurs in teak en noten, van salon tot ingangspartij. Ons specialisme, al ruim 25 jaar.</p>
      </div>

      <div class="wrap mt-14 grid grid-cols-1 gap-x-6 gap-y-10 md:mt-20 md:grid-cols-12 md:gap-y-6">
        <figure class="rijs md:col-span-8">
          <Image src={noten} alt="Kajuit met tweepersoonsbed, wanden en kasten in noten met verlichte plint" quality={74} widths={[640, 960, 1200]} sizes="(min-width: 768px) 62vw, 100vw" class="aspect-[3/2] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-xs text-mist">Strak en eigentijds noten interieur</figcaption>
        </figure>
        <figure class="rijs md:col-span-4" style="--d:.1s">
          <Image src={windroos} alt="Houten salontafel met een ingelegde windroos, voor een witte bank in de salon" quality={74} widths={[400, 553]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[calc(100%-1.75rem)]" />
          <figcaption class="mt-3 text-xs text-mist">Salontafel met ingelegde windroos</figcaption>
        </figure>
        <figure class="rijs max-md:hidden md:col-span-5">
          <Image src={stuur} alt="Detail van het stuur met een glanzend gelakte teakhouten rand van het dashboard" quality={74} widths={[640, 960]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[16/10] w-full rounded-sm object-cover md:aspect-auto md:h-[calc(100%-1.75rem)]" />
          <figcaption class="mt-3 text-xs text-mist">Jachtinterieur uitgevoerd in teak</figcaption>
        </figure>
        <figure class="rijs md:col-span-7" style="--d:.1s">
          <Image src={ingang} alt="Openstaande teakhouten deur met glas en messing kruk aan boord van een motorjacht" quality={72} widths={[640, 960, 1400]} sizes="(min-width: 768px) 54vw, 100vw" class="aspect-[3/2] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-xs text-mist">Ingangspartij motorjacht</figcaption>
        </figure>
      </div>

      <div class="wrap mt-16 md:mt-20">
        <div class="rijs grid grid-cols-1 gap-6 border-t border-lijn pt-8 md:grid-cols-12 md:items-center">
          <p class="font-kop text-2xl md:col-span-8">Nieuwbouw, refit of één nieuwe kast aan boord: het begint met een gesprek.</p>
          <p class="md:col-span-4 md:text-right"><a href="#aanvraag" class="knop knop-rand-wit">Project bespreken<Icoon naam="pijl" /></a></p>
        </div>
      </div>
    </section>

    <!-- 4. ZAKELIJK -->
    <section id="zakelijk" class="py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-6 lg:grid-cols-12 lg:gap-x-12">
        <h2 class="rijs text-4xl lg:col-span-6">Zakelijke interieurs.</h2>
        <p class="rijs text-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-4" style="--d:.1s">Interieurwerk voor hotels, kantoren en overheidsgebouwen. Hetzelfde maatwerk als aan boord.</p>
      </div>

      <div class="wrap mt-14 md:mt-20">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
          <figure class="rijs md:col-span-7 md:row-span-2">
            <Image src={marriott} alt="Bovenaanzicht van een gebogen trap met houten lamellen rondom" quality={74} widths={[640, 960, 1280, 1664]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-full" />
          </figure>
          <figure class="rijs max-md:hidden md:col-span-5" style="--d:.1s">
            <Image src={marriott2} alt="Vrijstaande houten trap met lamellen in een hotellobby" quality={72} widths={[640, 960]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
          </figure>
          <figure class="rijs md:col-span-5" style="--d:.15s">
            <Image src={lamel} alt="Detail van de leuning en de houten lamellen van de trap" quality={72} widths={[640, 960]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
          </figure>
        </div>
        <p class="rijs mt-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <span class="font-kop text-2xl">Marriott hotel Amsterdam</span>
          <span class="text-sm text-grijs">Afgerond project</span>
        </p>
      </div>

      <div class="wrap mt-14 grid grid-cols-1 gap-x-12 gap-y-12 md:mt-16 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h3 class="rijs text-3xl">Meer uit het logboek.</h3>
          <div class="rijs mt-8 border-b border-lijn-licht" style="--d:.1s">
            <div class="log"><p class="font-kop text-xl">MFA de Rijer, Ridderkerk</p><p class="text-grijs">Meubel- en diverse timmerwerk, in opdracht van bouwbedrijf De Vries en Verburg.</p></div>
            <div class="log"><p class="font-kop text-xl">More Living</p><p class="text-grijs">Wandbetimmering en deuren in hout.</p></div>
            <div class="log"><p class="font-kop text-xl">Kantoorruimte</p><p class="text-grijs">Van afbreken tot de laatste afwerking.</p></div>
            <div class="log"><p class="font-kop text-xl">Marriott hotel Amsterdam</p><p class="text-grijs">Houten trappen met lamellen.</p></div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 lg:col-span-5 lg:pt-16">
          <figure class="rijs" style="--d:.1s">
            <Image src={balie} alt="Lange balie in licht hout in een gang van een multifunctionele accommodatie" quality={70} widths={[400, 640]} sizes="(min-width: 1024px) 20vw, 46vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">MFA de Rijer</figcaption>
          </figure>
          <figure class="rijs" style="--d:.15s">
            <Image src={moreliving} alt="Houten wand met dubbele deur en smalle glasstroken" quality={70} widths={[400, 640]} sizes="(min-width: 1024px) 20vw, 46vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">More Living</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 5. WONINGEN -->
    <section id="woning" class="bg-papier-2 py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-x-12 gap-y-12 lg:grid-cols-12">
        <div class="lg:col-span-4 lg:pt-6">
          <h2 class="rijs text-4xl">Woning&shy;interieurs.</h2>
          <p class="rijs mt-8 text-lg" style="--d:.1s">Een keukenwand, inbouwkasten en een kast onder het schuine dak: interieurwerk voor een luxe woning in Giessenburg.</p>
          <p class="rijs mt-5 text-grijs" style="--d:.15s">U kunt voor ieder interieur bij ons terecht.</p>
          <p class="rijs mt-8" style="--d:.2s"><a href="#aanvraag" class="link font-semibold">Uw interieur bespreken</a></p>
        </div>
        <div class="grid grid-cols-6 gap-4 md:gap-6 lg:col-span-8">
          <figure class="rijs col-span-6 sm:col-span-4 sm:row-span-2">
            <Image src={keuken} alt="Keukenwand op maat in licht hout met drie inbouwovens" quality={72} widths={[480, 720, 1090]} sizes="(min-width: 1024px) 40vw, (min-width: 640px) 62vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover sm:aspect-auto sm:h-full" />
          </figure>
          <figure class="rijs col-span-3 sm:col-span-2" style="--d:.1s">
            <Image src={kast} alt="Inbouwkast met open vakken en tv-nis in licht hout" quality={70} widths={[300, 549]} sizes="(min-width: 640px) 20vw, 46vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
          </figure>
          <figure class="rijs col-span-3 sm:col-span-2" style="--d:.15s">
            <Image src={trapkast} alt="Kast onder een schuin dak met deuren in magenta en paars" quality={70} widths={[300, 600]} sizes="(min-width: 640px) 20vw, 46vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
          </figure>
          <p class="col-span-6 text-xs text-grijs">Interieurwerk luxe woning Giessenburg</p>
        </div>
      </div>
    </section>

    <!-- 6. AANVRAAG -->
    <section id="aanvraag" class="relative isolate overflow-hidden bg-diep py-20 text-wit md:py-28" data-hulp>
      <Windroos class="pointer-events-none absolute -bottom-40 -right-40 -z-10 h-[44rem] w-[44rem] text-wit/[.07]" naald="#f0a3cb26" />
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <h2 class="rijs text-4xl">Wat wilt u laten <em>maken</em>?</h2>
          <p class="rijs mt-6 max-w-md text-lg text-mist" style="--d:.1s">Vier regels, dan staat uw bericht klaar. Een tekening of foto stuurt u daarna mee.</p>
        </div>
        <form class="rijs lg:col-span-7" style="--d:.1s" onsubmit="return false" aria-label="Aanvraag">
          <div class="border-b border-lijn">
            <div class="regel"><label for="k-soort" class="text-sm text-mist">Soort project</label><select id="k-soort" class="veld" data-k="soort">{keuzes.soort.map((t, i) => <option value={i}>{t}</option>)}</select></div>
            <div class="regel"><label for="k-waar" class="text-sm text-mist">Schip of pand</label><input id="k-waar" class="veld" data-k="waar" type="text" autocomplete="off" placeholder="bijv. motorjacht, 15 meter" /></div>
            <div class="regel"><label for="k-fase" class="text-sm text-mist">Fase</label><select id="k-fase" class="veld" data-k="fase">{keuzes.fase.map((t, i) => <option value={i}>{t}</option>)}</select></div>
            <div class="regel"><label for="k-tek" class="text-sm text-mist">Tekening</label><select id="k-tek" class="veld" data-k="tekening">{keuzes.tekening.map((t, i) => <option value={i}>{t}</option>)}</select></div>
          </div>
          <p class="mt-8 rounded-sm bg-diep-2 p-5 text-wit/90" data-bericht aria-live="polite">{zin()}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={waMet(zin())} class="knop knop-wit" data-wa><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <a href={mailMet('Project bespreken', zin())} class="knop knop-rand-wit" data-mail>Liever per e-mail</a>
          </div>
        </form>
      </div>
    </section>

    <!-- 7. CONTACT -->
    <section id="contact" class="py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <h2 class="rijs text-4xl">Bel, app of mail ons.</h2>
          <p class="rijs mt-10" style="--d:.1s"><a href={site.vastHref} class="num font-kop text-4xl text-zwart no-underline hover:text-roze">{site.vast}</a></p>
          <p class="rijs mt-3 text-grijs" style="--d:.1s">Mobiel en WhatsApp: <a href={site.mobielHref} class="link num font-semibold text-zwart">{site.mobiel}</a></p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.15s">
            <a href={site.vastHref} class="knop knop-diep"><Icoon naam="tel" />Bellen</a>
            <a href={site.wa} class="knop knop-rand"><Icoon naam="wa" />WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="knop knop-rand max-[380px]:w-full max-[380px]:whitespace-normal">{site.mail}</a>
          </div>
        </div>
        <div class="rijs lg:col-span-4 lg:col-start-9 lg:pt-4" style="--d:.1s">
          <p class="font-kop text-2xl">{site.naam}</p>
          <p class="mt-3 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-2 text-sm text-grijs">Bedrijventerrein De Peulen.</p>
          <a href={site.maps} class="link mt-5 inline-flex items-center gap-2 text-sm font-semibold"><Icoon naam="pin" class="h-4 w-4" />Route plannen</a>
          <div class="mt-10 border-t border-lijn-licht pt-6">
            <Windroos class="h-12 w-12 text-zwart" />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script define:vars={{ keuzes, wa: site.wa, mail: site.mail }}>
    const hulp = document.querySelector('[data-hulp]');
    if (hulp) {
      const bericht = hulp.querySelector('[data-bericht]');
      const waL = hulp.querySelector('[data-wa]');
      const mailL = hulp.querySelector('[data-mail]');
      const v = (k) => hulp.querySelector(`[data-k="${k}"]`).value;
      const maak = () => {
        const waar = v('waar').trim();
        const t = `Goedendag, ik zoek ${keuzes.soort[v('soort')]}${waar ? ` voor ${waar}` : ''}. Het gaat om ${keuzes.fase[v('fase')]} en daarvoor ${keuzes.tekening[v('tekening')]}. Kunnen we het project bespreken?`;
        bericht.textContent = t;
        waL.href = `${wa}?text=${encodeURIComponent(t)}`;
        mailL.href = `mailto:${mail}?subject=${encodeURIComponent('Project bespreken')}&body=${encodeURIComponent(t)}`;
      };
      hulp.querySelectorAll('select, input').forEach((s) => s.addEventListener('input', maak));
      hulp.querySelectorAll('select').forEach((s) => s.addEventListener('change', maak));
    }
  </script>
</Base>
