  <Voet />

  <script>
    // Live status showroom: zaterdag 9.30-14.30, behalve de laatste zaterdag van de maand; vrijdag op afspraak.
    const nu = new Date();
    const dag = nu.getDay();
    const uur = nu.getHours() + nu.getMinutes() / 60;
    const laatsteZaterdag = (d: Date) => d.getDay() === 6 && new Date(d.getFullYear(), d.getMonth(), d.getDate() + 7).getMonth() !== d.getMonth();
    document.querySelector(`tr[data-dag="${dag}"]`)?.classList.add('bg-gloed-zacht');
    const rij = document.querySelector<HTMLElement>(`tr[data-dag="${dag}"] th`);
    if (rij) rij.classList.add('pl-3');
    const open = dag === 6 && !laatsteZaterdag(nu) && uur >= 9.5 && uur < 14.5;
    const t = document.querySelector('[data-status-tekst]');
    const s = document.querySelector('[data-status-stip]');
    const k = document.querySelector('[data-status-kort]');
    if (t && s) {
      if (open) { t.textContent = 'Nu open tot 14.30'; s.className = 'h-2.5 w-2.5 rounded-full bg-[#3fa65a]'; }
      else { t.textContent = dag === 5 ? 'Vandaag op afspraak' : 'Nu gesloten. Op afspraak kan meer.'; s.className = 'h-2.5 w-2.5 rounded-full bg-gloed'; }
    }
    if (k && open) k.textContent = 'Showroom nu open tot 14.30';

    // Kachelwijzer -> vooraf ingevuld WhatsApp-bericht.
    const f = document.querySelector<HTMLFormElement>('[data-wijzer]');
    const uit = document.querySelector<HTMLElement>('[data-bericht]');
    const wa = document.querySelector<HTMLAnchorElement>('[data-wa]');
    const m2uit = document.querySelector<HTMLElement>('[data-m2-uit]');
    const schetsM2 = document.querySelector<SVGTextElement>('[data-schets-m2]');
    const pijp = document.querySelector<SVGPathElement>('[data-pijp-lijn]');
    const kap = document.querySelector<SVGPathElement>('[data-pijp-kap]');
    const pijpTekst = document.querySelector<SVGTextElement>('[data-pijp-tekst]');
    const bouw = () => {
      if (!f || !uit || !wa) return;
      const d = new FormData(f);
      const soort = String(d.get('soort'));
      const situatie = String(d.get('situatie'));
      const kanaal = String(d.get('kanaal'));
      const m2 = String(d.get('m2'));
      const plaats = String(d.get('plaats') || '').trim();
      const thuis = d.get('waar') === 'thuis';
      if (m2uit) m2uit.textContent = `${m2} m²`;
      if (schetsM2) schetsM2.textContent = `${m2} m²`;
      if (pijp && kap && pijpTekst) {
        const ja = kanaal === 'Ja', nee = kanaal === 'Nee';
        pijp.setAttribute('stroke-dasharray', ja ? '' : '6 8');
        pijp.setAttribute('stroke', nee ? '#ffffff55' : '#f0851f');
        kap.setAttribute('fill', nee ? '#ffffff55' : '#f0851f');
        pijpTekst.textContent = ja ? 'rookkanaal' : nee ? 'nog geen kanaal' : 'kanaal?';
        pijpTekst.setAttribute('fill', nee ? '#c9beb3' : '#f0851f');
      }
      const regels = [
        'Hallo Cornelis,',
        '',
        `Ik denk aan: ${soort.toLowerCase()}`,
        `Nu staat er: ${situatie.toLowerCase()}`,
        `Rookkanaal of schoorsteen: ${kanaal.toLowerCase()}`,
        `Ruimte: ongeveer ${m2} m²`,
        plaats ? `Woonplaats: ${plaats}` : '',
        '',
        thuis ? 'Ik heb liever advies bij mij thuis. Wanneer komt het uit?' : 'Ik kom graag langs in de showroom. Wanneer komt het uit?',
      ].filter((r, i, a) => r !== '' || (a[i - 1] ?? '') !== '');
      const tekst = regels.join('\n');
      uit.textContent = tekst;
      wa.href = `https://wa.me/31651690802?text=${encodeURIComponent(tekst)}`;
    };
    f?.addEventListener('input', bouw);
    f?.addEventListener('change', bouw);
    bouw();
  </script>
