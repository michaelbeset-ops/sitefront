---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const aanbod = ['Houtkachels', 'Open haard ombouwen', 'Speksteenkachels', 'Inbouw- en hanghaarden', 'Buitenhaarden', 'Rookkanalen'];
---
<footer class="bg-roet text-rook">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Kachel- en haardenshowroom van Cornelis Mekelenkamp in Sint-Annaland. Begonnen als schoorsteenveger, nu van advies tot plaatsing.</p>
      <a href={site.telHref} class="knop knop-gloed num mt-7 min-h-12 px-6"><Icoon naam="tel" class="h-5 w-5" />{site.tel}</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Aanbod</p>
      <ul class="mt-5 space-y-2.5">
        {aanbod.map((t) => <li><a href={h('aanbod')} class="no-underline transition-colors hover:text-gloed">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Showroom</p>
      <ul class="mt-5 space-y-2.5">
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li>Zaterdag 9.30 tot 14.30 uur<br />Vrijdag op afspraak</li>
        <li><a href={site.vastHref} class="num no-underline hover:text-gloed">{site.vast}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-gloed">{site.mail}</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2.5">
        <li><a href={waHoi} class="inline-flex items-center gap-2 no-underline hover:text-gloed"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a></li>
        <li><a href={site.route} class="inline-flex items-center gap-2 no-underline hover:text-gloed"><Icoon naam="pin" class="h-5 w-5" />Route</a></li>
        <li><a href={site.reviews} class="no-underline hover:text-gloed">Google <span class="num">{site.google.score}</span>, {site.google.aantal} reviews</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Teksten, projecten en eigen foto's van jullie website vuurnogvlam.nl en jullie Google-profiel. Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 15 oktober 2026).</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
