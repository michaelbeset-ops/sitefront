---
// Hun eigen logo (bron/site/img/2024_03_horizontaal-logo-op-zwart.png): vlam met blaadjes + VUUR! in wit, transparant.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="inline-block shrink-0 no-underline">
  <Image src={logo} alt="VUUR! Kachels en haarden" widths={[180, 360]} sizes="180px" class={klein ? 'h-10 w-auto' : 'h-11 w-auto sm:h-[3.25rem]'} loading="eager" />
  <span class="sr-only">, naar de homepage</span>
</a>
