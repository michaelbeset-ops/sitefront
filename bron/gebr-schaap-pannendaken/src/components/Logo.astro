---
// Nagemaakt naar hun logo: twee rode dakpannen die schuin boven de naam zweven, "GEBR." klein ervoor,
// "PANNENDAKEN" gespatieerd in rood, en "SCHAAP" zwaar en breed, met een grijs huisje als lijn erachter.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const zwart = licht ? '#ffffff' : '#171311';
const rood = licht ? '#f0694f' : '#c1231b';
---
<span class={`inline-flex leading-none ${cls}`}>
  <span class="sr-only">Gebr. Schaap Pannendaken</span>
  <svg viewBox="0 0 250 72" class="h-12 w-auto" aria-hidden="true" style="font-family: var(--font-body)">
    <!-- huisje -->
    <path d="M86 66V40l22-20 22 20v26" fill="none" stroke={licht ? '#ffffff66' : '#8c8680'} stroke-width="2.4" stroke-linejoin="round" />
    <!-- twee dakpannen -->
    <g transform="translate(47 4) rotate(-16)">
      <rect width="21" height="27" rx="2.5" fill={rood} />
      <path d="M0 6h21" stroke={licht ? '#171311' : '#ffffff'} stroke-opacity=".35" stroke-width="1.6" />
    </g>
    <g transform="translate(70 16) rotate(-8)">
      <rect width="21" height="27" rx="2.5" fill={rood} />
      <path d="M0 6h21" stroke={licht ? '#171311' : '#ffffff'} stroke-opacity=".35" stroke-width="1.6" />
    </g>
    <text x="1" y="45" font-size="13" font-weight="700" letter-spacing="1" fill={zwart}>GEBR.</text>
    <text x="119" y="30" font-size="12.5" font-weight="600" letter-spacing="2.1" fill={rood} style="font-stretch: 112%">PANNENDAKEN</text>
    <text x="0" y="69" font-size="33" font-weight="900" letter-spacing="-.5" fill={zwart} style="font-stretch: 125%" textLength="248" lengthAdjust="spacingAndGlyphs">SCHAAP</text>
  </svg>
</span>
