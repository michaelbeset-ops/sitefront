---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site } from '../data/site';
import { projecten, soortNamen, plaatsNamen, coords, type Soort, type Plaats } from '../data/projecten';
import heroFoto from '../assets/p/amsterdam-4.jpg';
import villa from '../assets/p/gerardsweg-5.jpg';
import dakkapellen from '../assets/dakkapellen.jpg';
import oudePannen from '../assets/oude-pannen.jpg';
import loosdrecht from '../assets/loosdrecht.jpg';
import particulierFoto from '../assets/p/loomanplein-1.jpg';
import bedrijfFoto from '../assets/p/irisstraat-1.jpg';
import ifd from '../assets/p/alkmaar-5.jpg';
import alkmaar from '../assets/p/alkmaar-4.jpg';
import ruurd from '../assets/ruurd.jpg';
import stephan from '../assets/stephan.jpg';
import restauratieFoto from '../assets/p/klaaskampen-3.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

// Vier disciplines van hun homepage (isolatie met de omschrijving van de expertisepagina).
const disciplines = [
  { naam: 'Renovatie', tekst: 'Van goot tot nok, ook monumentaal. Wij werken samen met grote opdrachtgevers zoals woningbouwcorporaties.' },
  { naam: 'Restauratie', tekst: 'Wij restaureren oude panden met de materialen en methodes van vroeger.' },
  { naam: 'Nieuwbouw', tekst: 'Gebr. Schaap heeft voor alle soorten nieuwbouwdaken passende dakbedekking.' },
  { naam: 'Isolatie', tekst: 'Aanbrengen van dakisolatie met dakplaten.' },
];

// Expertisepagina, letterlijk.
const expertise = [
  'Plaatsen van dakbedekking (ervaring met alle soorten dakpannen)',
  'Dakrenovatie (ook monumentaal)',
  'Monteren leipannen',
  'Plaatsen van dakkapellen, dakramen, dakvensters, lichtkoepels en dakaccessoires',
  'Vernieuwen schoorsteen',
  'Complexe dakconstructies (vernieuwen dakbedekking aangrenzend plat, dakkapellen, balkons)',
  'Reparaties',
  'Timmer- en metselwerk',
  'Lood- en zinkwerk',
  'Vernieuwen dakbeschot',
  'Aanbrengen dakisolatie (dakplaten)',
  'Vorsten afwerken met specie',
  'Verwerken zonnecollectoren',
];

// Waarom wij: hun pagina "Waarom Gebr. Schaap Pannendaken?".
const waarom = [
  { kop: 'Scherpe prijzen, geen concessies', tekst: 'De prijzen die wij hanteren zijn zeer scherp. Echter, wij doen geen concessies aan onze kwaliteitsnorm en de garantie die wij al jarenlang handhaven.' },
  { kop: 'Ruim boven de minimale eis', tekst: 'Wij gebruiken uitsluitend kwalitatief hoogwaardige materialen, ruim boven de minimale eis.' },
  { kop: 'Nooit meer dan nodig', tekst: 'U krijgt van ons advies op maat. Er wordt nooit meer vernieuwd dan nodig is, en afspraak is afspraak.' },
  { kop: 'Onafhankelijk gecontroleerd', tekst: 'De kwaliteit van uw nieuwe dak wordt gecontroleerd door bureau Kwaliteitsbewaking, waarbij wij zijn aangesloten. Wij zéggen niet alleen dat wij goed werk leveren: dit onafhankelijke bureau controleert het ook.' },
];

// ---------- Projectenkaart ----------
const soorten: Soort[] = ['nieuwbouw', 'renovatie', 'restauratie'];
const plaatsen: Plaats[] = ['alkmaar', 'amsterdam', 'bussum', 'hilversum', 'laren'];
const telSoort = (s: Soort) => projecten.filter((p) => p.soorten.includes(s)).length;
const telPlaats = (pl: Plaats) => projecten.filter((p) => p.plaats === pl).length;

// Eenvoudige projectie (graden naar pixels), noorden boven. Rondjes: afstand vanaf de werkplaats in 's-Graveland.
const K = 1000, LON0 = 4.6, LAT0 = 52.68, COS = Math.cos((52.45 * Math.PI) / 180);
const xy = ([lat, lon]: [number, number]) => [Math.round((lon - LON0) * COS * K), Math.round((LAT0 - lat) * K)] as const;
const basis = xy(coords.basis);
const pxPerKm = K / 111.2;
const ringen = [10, 25, 40].map((km) => ({ km, r: km * pxPerKm }));
const labelPos: Record<Plaats, { dx: number; dy: number; anker: 'start' | 'end' }> = {
  alkmaar: { dx: 18, dy: 7, anker: 'start' },
  amsterdam: { dx: 18, dy: 7, anker: 'start' },
  bussum: { dx: -14, dy: -12, anker: 'end' },
  hilversum: { dx: 6, dy: 32, anker: 'start' },
  laren: { dx: 16, dy: -8, anker: 'start' },
};

// Grote versies voor de lichtbak (hun galerijfoto's zijn 800 breed; niet opschalen).
const groot = await Promise.all(
  projecten.map((p) => Promise.all(p.fotos.map((f) => getImage({ src: f.src, width: Math.min(800, f.src.width), format: 'webp', quality: 76 })))),
);
---
<Base
  title="Gebr. Schaap Pannendaken | Specialist in pannen- en leidaken, 's-Graveland"
  description="Gebr. Schaap Pannendaken uit 's-Graveland: renovatie, restauratie en nieuwbouw van pannen- en leidaken, van goot tot nok. KOMO-gecertificeerd, 10 jaar garantie op uw nieuwe dak."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: roetzwart vlak, grote serif-kop, bewijzen als rij. Rechts hun eigen dakdekker met het Schaap-spandoek, over de rand. -->
    <section class="donker relative bg-roet text-white">
      <div class="wrap grid grid-cols-1 gap-10 pb-16 lg:grid-cols-12 lg:gap-12 lg:pt-12 lg:pb-12">
        <div class="relative -mx-5 sm:mx-0 lg:order-2 lg:col-span-7 lg:self-start lg:-mb-40">
          <div class="relative aspect-[4/3] overflow-hidden sm:rounded-xl lg:aspect-auto lg:h-[610px] lg:shadow-lg">
            <Foto src={heroFoto} alt="Een dakdekker van Gebr. Schaap legt nieuwe pannen aan de Schubertstraat in Amsterdam, met ons spandoek aan de steiger" hero widths={[480, 800]} sizes="(min-width: 1024px) 680px, 100vw" class="object-[92%_50%]" />
            <p class="absolute top-4 left-4 rounded-full bg-roet/85 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-sm">Renovatie Schubertstraat, Amsterdam</p>
          </div>
          <figure class="absolute -bottom-10 right-4 z-10 hidden w-40 overflow-hidden rounded-xl bg-white p-1.5 shadow-lg sm:block sm:w-52 lg:-bottom-12 lg:-left-14 lg:right-auto lg:w-64">
            <div class="aspect-[4/3] overflow-hidden rounded-lg"><Foto src={villa} alt="Villa aan de Johan Gerardsweg in Hilversum met een groot, donker schilddak" widths={[320, 480]} sizes="(min-width: 1024px) 244px, 200px" /></div>
            <figcaption class="px-1.5 pt-1.5 pb-0.5 text-xs font-semibold text-ink">Villa's aan de J. Gerardsweg, Hilversum</figcaption>
          </figure>
        </div>

        <div class="pt-8 lg:order-1 lg:col-span-5 lg:pt-10">
          <p class="kicker text-pan">Vakwerk in dakwerk, sinds 1969</p>
          <h1 class="mt-5 text-4xl">Specialist in pannen- en leidaken</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">Restauratie, renovatie en nieuwbouw, voor particulieren en bedrijven. Drie generaties kennis, ervaring en vakmanschap, vanuit 's-Graveland.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-pan"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href="#projecten" class="btn btn-line">Bekijk onze daken</a>
          </div>
          <dl class="mt-12 grid grid-cols-3 gap-x-3 border-t sm:gap-x-5 border-white/20 pt-6 text-sm">
            <div><dt class="text-white/75">Google</dt><dd class="mt-1"><strong class="block font-display text-xl leading-tight font-semibold sm:text-2xl">{site.google}</strong><span class="text-white/80">{site.reviews} reviews</span></dd></div>
            <div><dt class="text-white/75">Garantie</dt><dd class="mt-1"><strong class="block font-display text-xl leading-tight font-semibold sm:text-2xl">10 jaar</strong><span class="text-white/80">op uw nieuwe dak</span></dd></div>
            <div><dt class="text-white/75">Keurmerk</dt><dd class="mt-1"><strong class="block font-display text-xl leading-tight font-semibold sm:text-2xl">KOMO</strong><span class="text-white/80">gecertificeerd</span></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Expertise: kop links, vier disciplines genummerd rechts. Daaronder de volledige lijst naast een groot beeld. -->
    <section id="expertise" class="scroll-mt-20 pt-20 pb-16 lg:pt-28 lg:pb-24">
      <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-steen">Wat wij doen</p>
          <h2 class="mt-3 text-3xl">Van goot tot nok</h2>
          <p class="mt-6 text-lg">Gebr. Schaap verzorgt een complete renovatie of nieuwbouw van uw pannendak. Ook het loodgieterswerk in combinatie met het vernieuwen van een schoorsteen en het plaatsen van een dakkapel kunnen wij voor onze rekening nemen.</p>
          <p class="mt-4 text-ink-soft">Thuis in alle voorkomende dakwerkzaamheden, met ervaring in alle soorten dakpannen.</p>
        </div>
        <ol class="border-t border-line lg:col-span-7">
          {disciplines.map((d, i) => (
            <li class="grid gap-1 border-b border-line py-6 sm:grid-cols-[3rem_11rem_1fr] sm:gap-6">
              <span class="font-display text-lg font-semibold tabular-nums text-steen">0{i + 1}</span>
              <h3 class="text-2xl">{d.naam}</h3>
              <p class="text-ink-soft sm:pt-1">{d.tekst}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="wrap mt-16 grid grid-cols-1 gap-8 lg:mt-24 lg:grid-cols-12 lg:items-center">
        <figure class="lg:col-span-6">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[5/4]"><Foto src={dakkapellen} alt="Oranje pannendak met een rij dakkapellen met groene kozijnen" sizes="(min-width: 1024px) 600px, 100vw" widths={[480, 800, 1200]} /></div>
          <figcaption class="mt-3 text-sm text-ink-soft">Dakkapellen, dakramen en lichtkoepels plaatsen wij ook. (Sfeerfoto)</figcaption>
        </figure>
        <div class="rounded-xl bg-zand p-6 sm:p-8 lg:col-span-6 lg:-ml-20 lg:p-10 lg:shadow-sm">
          <h3 class="text-2xl">Schaap Pannendaken kan het volgende voor u realiseren</h3>
          <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
            {expertise.map((e) => (
              <li class="flex gap-3 text-sm"><svg viewBox="0 0 16 16" class="mt-1 h-4 w-4 flex-none text-rood" aria-hidden="true"><path d="M2 9l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{e}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Wow: projectenkaart. Zonder JS: alle projecten als kaarten, foto's als gewone links. -->
    <section id="projecten" class="donker scroll-mt-20 bg-roet py-16 text-white lg:py-24" data-projecten>
      <div class="wrap">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="kicker text-pan">Referenties</p>
            <h2 class="mt-3 text-3xl">Onze daken in de regio</h2>
          </div>
          <p class="text-white/85 lg:col-span-5 lg:self-end">Een kleine selectie van onze afgeronde projecten, van de Coornhertkade in Alkmaar tot de villa's aan de J. Gerardsweg. Kies een soort werk of een plaats.</p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-12">
          <!-- Kaart + filters -->
          <div class="lg:col-span-4">
            <div class="lg:sticky lg:top-24">
              <div class="overflow-hidden rounded-xl bg-antraciet p-4 shadow-lg">
                <svg viewBox="0 0 480 520" class="h-auto w-full overflow-hidden" data-kaart role="group" aria-label="Kaart met de plaatsen van onze projecten, gezien vanuit 's-Graveland">
                  <defs>
                    <pattern id="raster" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0v40" fill="none" stroke="#ffffff" stroke-opacity=".05" /></pattern>
                  </defs>
                  <rect width="480" height="520" fill="url(#raster)" />
                  {ringen.map((r) => (
                    <g>
                      <circle cx={basis[0]} cy={basis[1]} r={r.r} fill="none" stroke="#ffffff" stroke-opacity=".16" stroke-dasharray="3 5" />
                      <text x={basis[0] - r.r * 0.7} y={basis[1] - r.r * 0.7 - 6} fill="#ffffff" fill-opacity=".72" font-size="15" text-anchor="middle">{r.km} km</text>
                    </g>
                  ))}
                  {plaatsen.map((pl) => { const [x, y] = xy(coords[pl]); return <line x1={basis[0]} y1={basis[1]} x2={x} y2={y} stroke="#f0694f" stroke-opacity=".35" stroke-width="1.2" />; })}
                  <g>
                    <rect x={basis[0] - 6} y={basis[1] - 6} width="12" height="12" rx="2" fill="#ffffff" transform={`rotate(45 ${basis[0]} ${basis[1]})`} />
                    <text x={basis[0] - 12} y={basis[1] + 26} fill="#ffffff" font-size="17" font-weight="600" text-anchor="end">'s-Graveland</text>
                  </g>
                  {plaatsen.map((pl) => {
                    const [x, y] = xy(coords[pl]);
                    const l = labelPos[pl];
                    return (
                      <g class="pin" data-pin={pl}>
                        <circle class="ring" cx={x} cy={y} r="15" fill="transparent" stroke="transparent" />
                        <circle class="stip" cx={x} cy={y} r="8" fill="#ffffff" stroke="#171311" stroke-width="2" />
                        <text x={x + l.dx} y={y + l.dy} fill="#ffffff" font-size="21" font-weight="700" text-anchor={l.anker}>{plaatsNamen[pl]} <tspan fill-opacity=".7" font-weight="500">{telPlaats(pl)}</tspan></text>
                      </g>
                    );
                  })}
                </svg>
              </div>

              <div class="mt-6" hidden data-filters>
                <p class="text-sm font-semibold text-white/80" id="f-soort">Soort werk</p>
                <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="f-soort">
                  <button type="button" class="chip" data-soort="" aria-pressed="true">Alle <small>{projecten.length}</small></button>
                  {soorten.map((s) => <button type="button" class="chip" data-soort={s} aria-pressed="false">{soortNamen[s]} <small>{telSoort(s)}</small></button>)}
                </div>
                <p class="mt-5 text-sm font-semibold text-white/80" id="f-plaats">Plaats</p>
                <div class="mt-2 flex flex-wrap gap-2" role="group" aria-labelledby="f-plaats">
                  <button type="button" class="chip" data-plaats="" aria-pressed="true">Alle</button>
                  {plaatsen.map((pl) => <button type="button" class="chip" data-plaats={pl} aria-pressed="false">{plaatsNamen[pl]}</button>)}
                </div>
                <p class="mt-6 border-t border-white/15 pt-4 text-sm text-white/85" aria-live="polite" data-telling>{projecten.length} projecten</p>
              </div>
            </div>
          </div>

          <!-- Projectkaarten -->
          <div class="lg:col-span-8">
            <ul class="gap-6 sm:columns-2" data-lijst>
              {projecten.map((p, pi) => (
                <li data-project={p.id} data-soort={p.soorten.join(' ')} data-plaats={p.plaats} class="mb-6 break-inside-avoid">
                  <article class="overflow-hidden rounded-xl bg-antraciet shadow-sm">
                    <a href={groot[pi][p.hoofd].src} class="group block aspect-[4/3] overflow-hidden" data-foto={`${pi}-${p.hoofd}`}>
                      <Image src={p.fotos[p.hoofd].src} alt={p.fotos[p.hoofd].alt} widths={[400, Math.min(800, p.fotos[p.hoofd].src.width)]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" format="webp" quality={70} loading="lazy" class="block h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                    </a>
                    <div class="p-5 sm:p-6">
                      <p class="flex flex-wrap items-center gap-2 text-xs">
                        <span class="kicker text-pan">{plaatsNamen[p.plaats]}</span>
                        {p.soorten.map((s) => <span class="rounded-full border border-white/25 px-2 py-0.5 text-white/85">{soortNamen[s]}</span>)}
                      </p>
                      <h3 class="mt-3 text-xl">{p.naam}</h3>
                      <p class="mt-1 font-display text-lg text-white/85 italic">{p.sub}</p>
                      {p.tekst.map((t) => <p class="mt-3 text-sm text-white/80">{t}</p>)}
                      <ul class="flex flex-wrap gap-1.5 pt-5" aria-label={`Foto's van ${p.naam}`}>
                        {p.fotos.map((f, fi) => (
                          <li>
                            <a href={groot[pi][fi].src} data-foto={`${pi}-${fi}`} class="block h-11 w-14 overflow-hidden rounded-md ring-white/60 transition hover:ring-2" aria-label={`Foto ${fi + 1} van ${p.fotos.length}${f.bij ? `: ${f.bij}` : ''}`}>
                              <Image src={f.src} alt="" width={128} format="webp" quality={60} loading="lazy" class="block h-full w-full object-cover" />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
            <div class="rounded-xl border border-white/20 p-6" hidden data-leeg>
              <p class="font-display text-xl">Geen project in deze combinatie.</p>
              <button type="button" class="btn btn-line mt-4 !py-2" data-reset>Toon alle projecten</button>
            </div>
            <p class="mt-8 text-sm text-white/75">Wij zijn continu bezig met referenties toevoegen.</p>
          </div>
        </div>
      </div>

      <dialog class="lichtbak" aria-labelledby="lb-titel" data-lichtbak>
        <div class="relative">
          <img src="" alt="" class="block aspect-[4/3] max-h-[calc(100dvh-9rem)] w-full bg-antraciet object-contain" data-lb-img />
          <div class="flex flex-wrap items-center justify-between gap-3 p-4 sm:p-5">
            <div class="min-w-0">
              <p id="lb-titel" class="font-display text-lg font-semibold" data-lb-titel></p>
              <p class="text-sm text-white/80" data-lb-bij></p>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="btn btn-line !px-3 !py-2" data-lb-vorige><span class="sr-only">Vorige foto</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
              <span class="w-14 text-center text-sm tabular-nums" data-lb-teller></span>
              <button type="button" class="btn btn-line !px-3 !py-2" data-lb-volgende><span class="sr-only">Volgende foto</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
              <button type="button" class="btn btn-pan !px-4 !py-2" data-lb-sluit>Sluiten</button>
            </div>
          </div>
        </div>
      </dialog>
      <script type="application/json" id="lb-data" set:html={JSON.stringify(projecten.map((p, pi) => ({ naam: p.naam, fotos: p.fotos.map((f, fi) => ({ src: groot[pi][fi].src, alt: f.alt, bij: f.bij || '' })) })))} />
    </section>

    <script>
      // Projectenkaart: filter op soort werk en plaats (knoppen en kaartpunten), plus een lichtbak voor de projectfoto's.
      const sectie = document.querySelector<HTMLElement>('[data-projecten]');
      if (sectie) {
        const filters = sectie.querySelector<HTMLElement>('[data-filters]')!;
        const telling = sectie.querySelector<HTMLElement>('[data-telling]')!;
        const leeg = sectie.querySelector<HTMLElement>('[data-leeg]')!;
        const items = [...sectie.querySelectorAll<HTMLElement>('[data-project]')];
        const pins = [...sectie.querySelectorAll<SVGGElement>('[data-pin]')];
        const namen: Record<string, string> = { alkmaar: 'Alkmaar', amsterdam: 'Amsterdam', bussum: 'Bussum', hilversum: 'Hilversum', laren: 'Laren' };
        let soort = '';
        let plaats = '';
        filters.hidden = false;

        const toon = () => {
          let n = 0;
          items.forEach((li) => {
            const aan = (!soort || li.dataset.soort!.split(' ').includes(soort)) && (!plaats || li.dataset.plaats === plaats);
            li.hidden = !aan;
            if (aan) n++;
          });
          sectie.querySelectorAll<HTMLButtonElement>('[data-soort]').forEach((b) => { if (b.tagName === 'BUTTON') b.setAttribute('aria-pressed', String(b.dataset.soort === soort)); });
          sectie.querySelectorAll<HTMLButtonElement>('button[data-plaats]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.plaats === plaats)));
          pins.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.pin === plaats)));
          leeg.hidden = n > 0;
          telling.textContent = n === 1 ? '1 project' : `${n} projecten`;
        };

        sectie.querySelectorAll<HTMLButtonElement>('button[data-soort]').forEach((b) => b.addEventListener('click', () => { soort = b.dataset.soort || ''; toon(); }));
        sectie.querySelectorAll<HTMLButtonElement>('button[data-plaats]').forEach((b) => b.addEventListener('click', () => { plaats = b.dataset.plaats || ''; toon(); }));
        sectie.querySelector('[data-reset]')?.addEventListener('click', () => { soort = ''; plaats = ''; toon(); });
        pins.forEach((p) => {
          p.setAttribute('role', 'button');
          p.setAttribute('tabindex', '0');
          p.setAttribute('aria-pressed', 'false');
          p.setAttribute('aria-label', `${p.textContent!.trim().replace(/\s+/g, ' ')} ${p.textContent!.trim().endsWith(' 1') ? 'project' : 'projecten'}, filter op ${namen[p.dataset.pin!]}`);
          const kies = () => { plaats = plaats === p.dataset.pin ? '' : p.dataset.pin!; toon(); };
          p.addEventListener('click', kies);
          p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); kies(); } });
        });

        // Lichtbak
        const data: { naam: string; fotos: { src: string; alt: string; bij: string }[] }[] = JSON.parse(document.getElementById('lb-data')?.textContent || '[]');
        const dlg = sectie.querySelector<HTMLDialogElement>('[data-lichtbak]')!;
        const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
        const titel = dlg.querySelector<HTMLElement>('[data-lb-titel]')!;
        const bij = dlg.querySelector<HTMLElement>('[data-lb-bij]')!;
        const teller = dlg.querySelector<HTMLElement>('[data-lb-teller]')!;
        let pi = 0, fi = 0;
        const zet = () => {
          const p = data[pi], f = p.fotos[fi];
          img.src = f.src; img.alt = f.alt;
          titel.textContent = p.naam;
          bij.textContent = f.bij || f.alt;
          teller.textContent = `${fi + 1} / ${p.fotos.length}`;
        };
        const stap = (d: number) => { const n = data[pi].fotos.length; fi = (fi + d + n) % n; zet(); };
        sectie.querySelectorAll<HTMLAnchorElement>('a[data-foto]').forEach((a) => a.addEventListener('click', (e) => {
          if (typeof dlg.showModal !== 'function') return;
          e.preventDefault();
          [pi, fi] = a.dataset.foto!.split('-').map(Number);
          zet();
          dlg.showModal();
        }));
        dlg.querySelector('[data-lb-vorige]')!.addEventListener('click', () => stap(-1));
        dlg.querySelector('[data-lb-volgende]')!.addEventListener('click', () => stap(1));
        dlg.querySelector('[data-lb-sluit]')!.addEventListener('click', () => dlg.close());
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') stap(-1); if (e.key === 'ArrowRight') stap(1); });
      }
    </script>

    <!-- Particulieren en bedrijven: twee kolommen met eigen foto, zelfde belofte. -->
    <section class="py-16 lg:py-24">
      <div class="wrap">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="kicker text-steen">Voor wie</p>
            <h2 class="mt-3 text-3xl">Een zorgeloos dak: 10 jaar garantie</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5 lg:self-end">Voor zowel bedrijven als particuliere opdrachtgevers hebben wij de passende oplossing om tot een mooi, kwalitatief hoog en duurzaam resultaat te komen.</p>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10">
          <article class="overflow-hidden rounded-xl bg-white shadow-sm">
            <div class="aspect-[16/10] overflow-hidden"><Foto src={particulierFoto} alt="Wit herenhuis aan het Loomanplein in Bussum met een in ere hersteld rood pannendak" widths={[480, 800]} sizes="(min-width: 1024px) 580px, 100vw" /></div>
            <div class="p-6 sm:p-8">
              <p class="kicker text-steen">Particulieren</p>
              <h3 class="mt-2 text-2xl">Uw eigen huis verdient een goed dak</h3>
              <p class="mt-4 text-ink-soft">Kwaliteit is bij Schaap Pannendaken de gewoonste zaak. Of het nu gaat om reparatie, renovatie of een geheel nieuw dak: aan alles wordt de juiste aandacht gegeven.</p>
              <p class="mt-3 text-ink-soft">Een nieuw dak is voor u een grote beslissing. Samen met u nemen wij uw wensen door om, in combinatie met onze kennis en aan de hand van een nauwkeurige dakinspectie, tot een duidelijk plan te komen. Ons doel is een uitstekend resultaat dat staat als een huis.</p>
            </div>
          </article>
          <article class="overflow-hidden rounded-xl bg-white shadow-sm lg:mt-16">
            <div class="aspect-[16/10] overflow-hidden"><Foto src={bedrijfFoto} alt="Straat met jaren 30-woningen in de Bloemenbuurt in Hilversum, met nieuwe oranje pannendaken" widths={[480, 800]} sizes="(min-width: 1024px) 580px, 100vw" /></div>
            <div class="p-6 sm:p-8">
              <p class="kicker text-steen">Bedrijven en woningbouw</p>
              <h3 class="mt-2 text-2xl">Korte lijnen, volgens planning</h3>
              <p class="mt-4 text-ink-soft">Een ruime ervaring in kleine en grootschalige nieuwbouw- en renovatieprojecten. Wij werken volgens de planning, denken mee en gaan oplossingsgericht te werk. Duurzaamheid en kostenbewust bouwen zijn ook bij ons een begrip.</p>
              <ul class="mt-5 space-y-2 border-t border-line pt-5 text-sm">
                <li class="flex gap-3"><span class="mt-2 h-2 w-2 flex-none rounded-full bg-rood" aria-hidden="true"></span>Meerdere bouwstromen tegelijk, waardoor de bouwtijd wordt verkort.</li>
                <li class="flex gap-3"><span class="mt-2 h-2 w-2 flex-none rounded-full bg-rood" aria-hidden="true"></span>Geschoold, eigen personeel.</li>
                <li class="flex gap-3"><span class="mt-2 h-2 w-2 flex-none rounded-full bg-rood" aria-hidden="true"></span>Een eigen kraan.</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Waarom wij: brede strook met hun eigen dak in Loosdrecht, daarna vier redenen. -->
    <section id="waarom" class="scroll-mt-20 bg-zand pb-16 lg:pb-24">
      <div class="relative">
        <div class="h-56 overflow-hidden sm:h-72 lg:h-[26rem]"><Foto src={oudePannen} alt="Close-up van oude, verweerde rode dakpannen" widths={[800, 1400, 2000]} sizes="100vw" /></div>
        <div class="wrap relative -mt-20 lg:-mt-40">
          <div class="grid grid-cols-1 gap-8 rounded-xl bg-paper p-6 shadow-lg sm:p-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-5">
              <p class="kicker text-steen">Waarom Gebr. Schaap</p>
              <h2 class="mt-3 text-3xl">Een nieuw dak, dat wilt u toch maar 1 keer?</h2>
              <p class="mt-5 text-ink-soft">Onze jarenlange ervaring met particuliere opdrachtgevers heeft ons geleerd goed om te gaan met uw zorg. Veel mensen gingen u voor.</p>
              <figure class="mt-8">
                <div class="aspect-[1017/384] max-w-[1017px] overflow-hidden rounded-lg"><Foto src={loosdrecht} alt="Rood pannendak met dakkapel en gemetselde schoorsteen in Loosdrecht" widths={[480, 1017]} sizes="(min-width: 1024px) 420px, 100vw" /></div>
                <figcaption class="mt-2 text-sm text-ink-soft">Een dak in Loosdrecht.</figcaption>
              </figure>
            </div>
            <ol class="grid gap-x-8 sm:grid-cols-2 lg:col-span-7">
              {waarom.map((w, i) => (
                <li class="border-t border-line py-6">
                  <p class="font-display text-groot leading-none font-medium text-steen tabular-nums">{i + 1}</p>
                  <h3 class="mt-3 text-xl">{w.kop}</h3>
                  <p class="mt-2 text-ink-soft">{w.tekst}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- KOMO en IFD: donker, met de oorkonde als bewijs. -->
    <section id="komo" class="donker scroll-mt-20 bg-roet py-16 text-white lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-pan">Certificering</p>
          <h2 class="mt-3 text-3xl">Als het écht goed moet zijn</h2>
          <p class="mt-6 text-lg text-white/85">Schaap Pannendaken was als één van de eerste dakdekkersbedrijven KOMO-gecertificeerd. Wij werken volgens een vastgelegde methode waarin kwaliteit, betrouwbaarheid en garantie van groot belang zijn.</p>
          <p class="mt-4 text-white/80">Wij maken tevens gebruik van KOMO-gecertificeerde materialen. Zo geven zowel Schaap Pannendaken als de leverancier van de materialen u een garantie zoals KOMO dit omschrijft.</p>
          <h3 class="mt-10 text-xl">KOMO-kwaliteit biedt onder andere</h3>
          <ul class="mt-4 space-y-3 border-t border-white/15 pt-5">
            <li class="flex gap-3 text-white/85"><span class="mt-2.5 h-2 w-2 flex-none rounded-full bg-pan" aria-hidden="true"></span><span>Opdrachtgevers de zekerheid dat kwalitatief hoogwaardige bouwproducten, processen en diensten worden ingezet.</span></li>
            <li class="flex gap-3 text-white/85"><span class="mt-2.5 h-2 w-2 flex-none rounded-full bg-pan" aria-hidden="true"></span><span>De hele bouwketen handvatten om de faalkosten tot een minimum te beperken.</span></li>
            <li class="flex gap-3 text-white/85"><span class="mt-2.5 h-2 w-2 flex-none rounded-full bg-pan" aria-hidden="true"></span><span>Betrouwbare, relevante en transparante informatie over de kwaliteit van bouwproducten, bouwdelen, bouwprocessen en bouwwerken.</span></li>
          </ul>
          <p class="mt-4 text-xs text-white/70">Bron: KOMO-keurmerk</p>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="grid grid-cols-[1fr_1.1fr] gap-4">
            <figure class="self-end">
              <div class="aspect-[3/4] overflow-hidden rounded-xl bg-white p-2 shadow-lg"><Foto src={ifd} alt="De oorkonde van de IFD voor Gebr. Schaap Pannendaken, genomineerd in de categorie gevelbekleding" widths={[300, 480]} sizes="(min-width: 1024px) 220px, 45vw" class="rounded-md object-contain" /></div>
            </figure>
            <figure>
              <div class="aspect-[3/4] overflow-hidden rounded-xl shadow-lg"><Foto src={alkmaar} alt="Detail van de met dakpannen beklede balkons aan de Coornhertkade in Alkmaar" widths={[300, 600]} sizes="(min-width: 1024px) 240px, 50vw" /></div>
            </figure>
          </div>
          <div class="mt-6 rounded-xl border border-white/15 p-6">
            <p class="kicker text-pan">Genomineerd door de IFD</p>
            <p class="mt-3 text-white/85">Met de wandbekleding in dakpannen aan de Coornhertkade in Alkmaar genomineerd voor de prijs van de International Federation for the Roofing Trade, en geëindigd bij de laatste 5 van Europa.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Over ons: 1969, drie generaties, de leiding. -->
    <section id="over" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-steen">Wie zijn wij</p>
          <h2 class="mt-3 text-3xl">Hét dak boven úw hoofd</h2>
          <p class="mt-6 flex items-baseline gap-4 border-t border-line pt-6"><strong class="font-display text-groot leading-none font-medium text-steen tabular-nums">1969</strong><span class="text-ink-soft">opgericht, en sindsdien drie generaties kennis, ervaring en vakmanschap.</span></p>
          <p class="mt-6">Een modern bedrijf dat zich continu aan de tijd heeft aangepast, zonder het ambachtelijke element te verliezen. Wij restaureren oude panden met de materialen en methodes van vroeger, en hebben voor alle soorten nieuwbouwdaken passende dakbedekking.</p>
          <div class="mt-10 grid grid-cols-2 gap-5">
            <figure>
              <div class="aspect-[224/325] max-w-[224px] overflow-hidden rounded-xl bg-zand shadow-sm"><Foto src={stephan} alt="Portret van Stephan Schaap" widths={[224]} sizes="224px" /></div>
              <figcaption class="mt-3"><strong class="block font-display text-lg font-semibold">Stephan Schaap</strong><span class="text-sm text-ink-soft">Leiding</span></figcaption>
            </figure>
            <figure>
              <div class="aspect-[224/325] max-w-[224px] overflow-hidden rounded-xl bg-zand shadow-sm"><Foto src={ruurd} alt="Portret van Ruurd Dijs" widths={[224]} sizes="224px" /></div>
              <figcaption class="mt-3"><strong class="block font-display text-lg font-semibold">Ruurd Dijs</strong><span class="text-sm text-ink-soft">Leiding</span></figcaption>
            </figure>
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <figure>
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={restauratieFoto} alt="Trapgevels en dakkapellen van het gerestaureerde pand aan de Klaaskampen in Laren" widths={[480, 800]} sizes="(min-width: 1024px) 600px, 100vw" /></div>
            <figcaption class="mt-3 text-sm text-ink-soft">Restauratie aan de Klaaskampen in Laren: pand Bart Smit in ere hersteld.</figcaption>
          </figure>
          <dl class="mt-10 grid gap-6 border-t border-line pt-6 sm:grid-cols-3">
            <div><dt class="kicker text-steen">Keurmerk</dt><dd class="mt-2">KOMO-gecertificeerd, aangesloten bij bureau Kwaliteitsbewaking</dd></div>
            <div><dt class="kicker text-steen">Leiding</dt><dd class="mt-2">Stephan Schaap en Ruurd Dijs</dd></div>
            <div><dt class="kicker text-steen">Kantoor</dt><dd class="mt-2">Loodijk, 's-Graveland</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Contact: bellen voorop, formulier met hun eigen velden (verstuurt bij het voorstel niets). -->
    <section id="contact" class="scroll-mt-20 bg-zand py-16 lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-steen">Contact</p>
          <h2 class="mt-3 text-3xl">Bel ons, of stuur een bericht</h2>
          <p class="mt-5 text-lg">Op zoek naar een betrouwbaar dakdekkersbedrijf bij u in de buurt?</p><p class="mt-3 text-ink-soft">Vooraf advies inwinnen, of vragen over een bepaalde situatie? Onze medewerkers staan voor u klaar.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-rood"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line text-ink"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <div class="mt-10 grid gap-8 border-t border-line pt-8 sm:grid-cols-2">
            <div>
              <h3 class="text-lg">Kantoor</h3>
              <address class="mt-2 not-italic">{site.juridisch}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
              <a href={site.maps} rel="noopener" class="mt-3 inline-flex items-center gap-1.5 font-semibold text-steen underline underline-offset-4">Route plannen <Fragment set:html={pijl.replace('aria-hidden', 'class="h-4 w-4" aria-hidden')} /></a>
            </div>
            <div>
              <h3 class="text-lg">Postadres</h3>
              <p class="mt-2">{site.post[0]}<br />{site.post[1]}</p>
              <p class="mt-3"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
            </div>
          </div>
        </div>

        <form class="rounded-xl bg-white p-6 shadow-sm sm:p-8 lg:col-span-6 lg:col-start-7" action="#" onsubmit="return false">
          <h3 class="text-2xl">Stuur ons een bericht</h3>
          <p class="mt-1 text-sm text-ink-soft">Velden met * zijn verplicht.</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="veld sm:col-span-2"><label for="f-bedrijf">Bedrijfsnaam</label><input id="f-bedrijf" name="bedrijfsnaam" autocomplete="organization" /></div>
            <div class="veld sm:col-span-2"><label for="f-naam">Naam *</label><input id="f-naam" name="naam" autocomplete="name" required /></div>
            <div class="veld sm:col-span-2"><label for="f-adres">Adres *</label><input id="f-adres" name="adres" autocomplete="street-address" required /></div>
            <div class="veld"><label for="f-postcode">Postcode *</label><input id="f-postcode" name="postcode" autocomplete="postal-code" required /></div>
            <div class="veld"><label for="f-plaats">Plaats *</label><input id="f-plaats" name="plaats" autocomplete="address-level2" required /></div>
            <div class="veld"><label for="f-mail">E-mail *</label><input id="f-mail" name="email" type="email" autocomplete="email" required /></div>
            <div class="veld"><label for="f-tel">Telefoon</label><input id="f-tel" name="telefoon" type="tel" autocomplete="tel" /></div>
            <div class="veld sm:col-span-2"><label for="f-opm">Opmerkingen</label><textarea id="f-opm" name="opmerkingen" rows="4"></textarea></div>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg bg-zand p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="font-semibold whitespace-nowrap tabular-nums underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold break-all underline">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-rood mt-6">Versturen</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
