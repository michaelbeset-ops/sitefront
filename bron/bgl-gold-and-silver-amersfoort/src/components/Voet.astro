---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="border-t border-lijn bg-nacht text-zacht">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.875rem] md:grid-cols-12 md:py-20">
    <div class="text-ivoor md:col-span-5">
      <Merk />
      <p class="mt-6 max-w-xs text-zacht">Goudsmederij en juwelier aan de Kamp in Amersfoort.</p>
    </div>
    <div class="md:col-span-3">
      <p class="label label-blad">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">b.g.l.goldandsilver<wbr />@gmail.com</a></p>
    </div>
    <div class="md:col-span-4">
      <p class="label label-blad">Openingstijden</p>
      <dl class="mt-4 space-y-1">
        {tijden.filter((t) => t.o > 0).map((t) => (
          <div class="flex justify-between gap-6 sm:max-w-xs"><dt>{t.naam}</dt><dd class="num">{t.open} - {t.dicht}</dd></div>
        ))}
        <div class="flex justify-between gap-6 sm:max-w-xs"><dt>Zondag en maandag</dt><dd>gesloten</dd></div>
      </dl>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-blad">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Teksten van jullie eigen website (webarchief), foto’s van jullie eigen Google-profiel. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
