---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waMet } from '../data/site';

import ringenSteen from '../assets/ringen-steen.jpg';
import gehamerd from '../assets/gehamerd.jpg';
import camee from '../assets/camee.jpg';
import solitair from '../assets/solitair.jpg';
import zegelring from '../assets/zegelring.jpg';
import draad from '../assets/draad.jpg';

const waAfspraak = waMet('Hallo B.G.L. Gold & Silver, ik wil graag een afspraak maken om een sieraad te bespreken.');

// Uit hun eigen site (webarchief, pagina's Service en Producten). Toelichting zo letterlijk mogelijk.
const service = [
  ['Sieraden repareren', 'ook zilveren fotolijstjes en sloten van boeken'],
  ['Horlogebatterijen', 'vervangen, vaak ter plekke'],
  ['Horloges repareren', 'eerst een prijsopgave, dan beslist u'],
  ['Graveren', 'meer dan 100 lettertypen'],
  ['Goud en zilver inkoop', 'u krijgt gelijk geld mee'],
  ['Matteren of polijsten', 'glans of juist mat'],
  ['Sieraden schoonmaken', 'als er tijd is soms direct'],
  ['Oorbellen schieten', 'geen piercings'],
];

// Keuzes voor het WhatsApp-bericht: alleen wat zij zelf aanbieden.
const keuzes = [
  ['trouwringen', 'trouwringen laten maken'],
  ['ontwerp', 'een sieraad laten ontwerpen'],
  ['erfstuk', 'een erfstuk laten omwerken'],
  ['steen', 'een steen in een sieraad laten zetten'],
  ['reparatie', 'een sieraad laten repareren'],
  ['horloge', 'mijn horloge laten repareren'],
  ['graveren', 'iets laten graveren'],
  ['inkoop', 'goud of zilver verkopen'],
];

const titel = 'B.G.L. Gold & Silver | Goudsmid en juwelier aan de Kamp, Amersfoort';
const omschrijving = 'Goudsmederij en juwelier aan de Kamp 13 in Amersfoort: trouwringen en sieraden in opdracht, erfstukken omwerken, reparaties, graveren en goud- en zilverinkoop.';
const r = reviews;
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO: hun eigen foto van twee gehamerde ringen (Google-profiel, door de zaak zelf geplaatst) -->
    <section class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-nacht">
      <Kop />
      <div class="absolute inset-x-0 top-0 -z-10 h-[60%] lg:left-auto lg:h-full lg:w-[64%]">
        <Image src={gehamerd} alt="Twee roodgouden ringen met een gehamerd, gefacetteerd oppervlak, liggend op hoorn" quality={72} widths={[640, 960, 1280, 1600, 2048]} sizes="(min-width: 1024px) 64vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[38%_62%] lg:object-[40%_60%]" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,#0f0d0bcc_0%,#0f0d0b26_24%,#0f0d0b1a_45%,#0f0d0bcc_78%,#0f0d0b_100%)] lg:bg-[linear-gradient(180deg,#0f0d0b99_0%,#0f0d0b00_22%),linear-gradient(90deg,#0f0d0b_0%,#0f0d0b99_16%,#0f0d0b00_42%),linear-gradient(0deg,#0f0d0b_0%,#0f0d0b00_26%)]"></div>
      </div>
      <div class="wrap mt-auto pb-28 md:pb-20 lg:my-auto lg:pb-0 lg:pt-16">
        <p class="label label-blad">Goudsmid · Kamp 13, Amersfoort</p>
        <h1 class="mt-6 max-w-[11ch] text-hero leading-[.95]">Goudsmid aan de Kamp</h1>
        <p class="mt-7 max-w-md text-lg text-ivoor/90 [@media(max-height:700px)_and_(max-width:767px)]:hidden">Trouwringen, sieraden naar uw eigen ontwerp en reparaties. Het ontwerp maakt u samen met onze goudsmid.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={waAfspraak} class="knop knop-vol"><Icoon naam="wa" />Afspraak via WhatsApp</a>
          <a href={site.telHref} class="knop knop-stil max-sm:hidden"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
        </div>
        <p class="mt-10 flex items-center gap-3 text-xs text-zacht [@media(max-height:700px)_and_(max-width:767px)]:hidden" data-status-wrap><span class="h-1.5 w-1.5 rounded-full bg-blad"></span><span data-status>Di t/m za open, zo en ma gesloten</span></p>
      </div>
    </section>

    <!-- 2. TROUWRINGEN -->
    <section id="trouwringen" class="py-20 md:py-28">
      <div class="wrap grid items-center gap-y-16 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs raam self-start lg:col-span-7">
          <Image src={ringenSteen} alt="Twee gele gouden ringen op hoorn, een met een kleine heldere steen" quality={74} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 54vw, 100vw" class="aspect-[4/3] w-full object-cover object-[45%_50%] lg:aspect-[1/1]" />
        </figure>
        <div class="flex flex-col lg:col-span-4 lg:col-start-9">
          <h2 class="rijs text-3xl">Wat u niet kunt vinden, maken wij</h2>
          <p class="rijs mt-8 text-zacht">Wij verkopen trouwringen van verschillende merken, maar maken ook zelf trouwringen. U kunt zelf langskomen met een ontwerp, of samen met onze goudsmid een ontwerp maken.</p>
          <a href={waMet('Hallo B.G.L. Gold & Silver, wij gaan trouwen en willen graag langskomen voor trouwringen.')} class="rijs link mt-8 self-start text-sm">Langskomen voor trouwringen</a>
          <blockquote class="rijs mt-12 border-t border-lijn pt-8">
            <p class="font-kop text-xl leading-snug">“{r.marco.tekst}”</p>
            <footer class="mt-4 label">{r.marco.naam} · Google</footer>
          </blockquote>
        </div>
        
      </div>
    </section>

    <!-- 3. ERFSTUKKEN: groot typografisch moment naast de camee-ring -->
    <section id="erfstukken" class="relative border-y border-lijn bg-nacht-2">
      <div class="grid lg:grid-cols-2">
        <div class="relative min-h-[26rem] lg:order-2 lg:min-h-full">
          <Image src={camee} alt="Gouden ring met een camee en drie ronde bruinroze stenen, liggend op hoorn" quality={74} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[40%_50%]" />
        </div>
        <div class="px-5 py-20 md:px-12 md:py-24 lg:px-[max(3rem,calc((100vw-80rem)/2+3rem))] lg:pr-16 lg:py-28">
          <h2 class="rijs max-w-[13ch] text-3xl">De ringen van uw ouders, opnieuw gedragen</h2>
          <p class="rijs mt-8 max-w-md text-zacht">Erfde u de trouwringen van uw ouders of grootouders? Laat het goud omsmelten tot een ander sieraad, of zet de ringen tegen elkaar aan, zodat ze zoveel mogelijk intact blijven. Ook de gravure kan blijven.</p>
          <div class="mt-14 space-y-10 border-t border-lijn pt-10">
            {[r.wendy, r.florence].map((q, i) => (
              <blockquote class="rijs max-w-md" style={`--d:${i * 0.1}s`}>
                <p class="text-lg leading-relaxed text-ivoor">“{q.tekst}”</p>
                <footer class="mt-3 label">{q.naam} · Google</footer>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. WERK IN OPDRACHT: weinig foto's, groot, asymmetrisch -->
    <section id="werk" class="py-20 md:py-28" aria-labelledby="werk-titel">
      <div class="wrap">
        <div class="grid items-end gap-y-6 md:grid-cols-12 md:gap-x-10">
          <h2 id="werk-titel" class="rijs text-3xl md:col-span-6">Werk in opdracht</h2>
          <p class="rijs text-zacht md:col-span-5 md:col-start-8">Naar eigen wensen gemaakt. Dit zijn voorbeelden van wat onze goudsmid heeft gemaakt.</p>
        </div>
        <div class="mt-16 grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-5">
          <figure class="rijs col-span-2 md:col-span-7 md:row-span-2">
            <Image src={solitair} alt="Witgouden ring met een grote heldere steen en kleinere stenen in de schouders, op hoorn" quality={74} widths={[640, 960, 1280]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/5] h-full w-full object-cover object-[58%_50%] md:aspect-auto" />
          </figure>
          <figure class="rijs md:col-span-5" style="--d:.08s">
            <Image src={zegelring} alt="Gouden zegelring met gegraveerde initialen O en P, vastgehouden in een tang" quality={74} widths={[480, 720]} sizes="(min-width: 768px) 38vw, 50vw" class="aspect-square w-full object-cover md:aspect-[4/3]" />
          </figure>
          <figure class="rijs md:col-span-5" style="--d:.16s">
            <Image src={draad} alt="Ketting met bolletjes van gevlochten zilverdraad en een parel, over hoorn gedrapeerd" quality={74} widths={[480, 720]} sizes="(min-width: 768px) 38vw, 50vw" class="aspect-square w-full object-cover object-[30%_60%] md:aspect-[4/3]" />
          </figure>
          
        </div>
        <blockquote class="rijs mt-14 max-w-2xl md:ml-[calc(100%/12)]">
          <p class="font-kop text-2xl leading-snug">“{r.ageeth.tekst}”</p>
          <footer class="mt-4 label">{r.ageeth.naam} · Google</footer>
        </blockquote>
      </div>
    </section>

    <!-- 5. SERVICE: lijst met stippellijn, geen kaartjes -->
    <section id="service" class="border-t border-lijn py-20 md:py-28">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-4">
          <h2 class="rijs text-3xl">Ook voor reparatie en inkoop</h2>
          <p class="rijs mt-8 text-zacht">Soms zijn sieraden het waard om te laten repareren, bijvoorbeeld vanwege emotionele waarde.</p>
          <div class="mt-12 space-y-9">
            {[r.rina, r.david].map((q, i) => (
              <blockquote class="rijs" style={`--d:${i * 0.1}s`}>
                <p class="text-sm leading-relaxed text-ivoor/90">“{q.tekst}”</p>
                <footer class="mt-3 label">{q.naam} · Google</footer>
              </blockquote>
            ))}
          </div>
        </div>
        <ul class="lg:col-span-7 lg:col-start-6">
          {service.map(([naam, uitleg], i) => (
            <li class="rijs stip border-b border-lijn py-4 md:py-5" style={`--d:${(i % 4) * 0.05}s`}>
              <span class="font-kop text-xl leading-tight md:text-2xl">{naam}</span>
              <span class="mt-1 text-sm text-zacht md:mt-0 md:text-right">{uitleg}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. AFSPRAAK: één zin die een WhatsApp-bericht vult, met een gravure op de ring als voorbeeld -->
    <section id="ontwerp" class="border-y border-lijn bg-nacht-2 py-20 md:py-28">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="min-w-0 lg:col-span-6">
          <h2 class="rijs text-3xl">Vertel ons wat u in gedachten heeft</h2>
          <p class="rijs mt-6 max-w-lg text-zacht">Voor het ontwerpen van sieraden kunt u ook buiten de openingstijden een afspraak maken, via WhatsApp.</p>

          <form class="rijs mt-12" data-wow>
            <p class="font-kop text-2xl leading-[1.6] md:text-[1.875rem]">
              <label for="wens">Ik wil graag</label>{' '}
              <span class="relative block max-w-full align-baseline sm:inline-block">
                <select id="wens" name="wens" class="w-full max-w-full cursor-pointer appearance-none truncate sm:w-auto border-b border-blad bg-transparent pr-7 text-blad outline-none [text-overflow:ellipsis]">
                  {keuzes.map(([v, t]) => <option value={v} class="bg-nacht text-ivoor">{t}</option>)}
                </select>
                <svg class="pointer-events-none absolute right-0 top-1/2 h-4 w-4 -translate-y-1/2 text-blad" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </p>
            <label for="gravure" class="mt-10 block label">Gravure, bijvoorbeeld initialen of een datum (mag leeg)</label>
            <input id="gravure" name="gravure" maxlength="28" autocomplete="off" placeholder="M & J  12.09.2026" class="mt-3 w-full border-b border-lijn-2 bg-transparent py-3 text-lg text-ivoor outline-none placeholder:text-zacht/70 focus:border-blad" />
            <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
              <a href={waAfspraak} class="knop knop-vol" data-wa><Icoon naam="wa" />Verstuur via WhatsApp</a>
              <span class="text-xs text-zacht">Een foto van uw ontwerp of erfstuk kunt u in WhatsApp meesturen.</span>
            </div>
          </form>
        </div>

        <figure class="rijs lg:col-span-5 lg:col-start-8" aria-hidden="true">
          <svg viewBox="0 0 400 300" class="w-full">
            <defs>
              <linearGradient id="goud" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7a5c2a" />
                <stop offset=".35" stop-color="#e2c787" />
                <stop offset=".55" stop-color="#b38a45" />
                <stop offset=".8" stop-color="#ecd49a" />
                <stop offset="1" stop-color="#6e5225" />
              </linearGradient>
              <linearGradient id="binnen" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#d9bd7c" />
                <stop offset="1" stop-color="#8d6b33" />
              </linearGradient>
              <path id="boog" d="M 74 150 A 126 62 0 0 1 326 150" />
            </defs>
            <ellipse cx="200" cy="168" rx="170" ry="96" fill="url(#goud)" />
            <ellipse cx="200" cy="150" rx="150" ry="80" fill="url(#binnen)" />
            <ellipse cx="200" cy="172" rx="136" ry="66" fill="#171411" />
            <text font-family="Forum, Georgia, serif" font-size="21" letter-spacing="2" fill="#4a3615" fill-opacity=".85" text-anchor="middle">
              <textPath href="#boog" startOffset="50%" data-gravure-tekst>M &amp; J  12.09.2026</textPath>
            </text>
          </svg>
          <figcaption class="mt-4 text-center text-xs text-zacht">Zo ongeveer leest uw gravure aan de binnenkant.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 7. BEZOEK + REVIEWS -->
    <section id="bezoek" class="py-20 md:py-28">
      <div class="wrap grid gap-y-20 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl">Kamp 13, Amersfoort</h2>
          <p class="rijs mt-6 max-w-md text-zacht">Dichtbij het centrum, in het verlengde van de hoofdwinkelstraat.</p>
          <div class="rijs mt-10 flex items-center gap-3 text-sm" data-status-wrap><span class="h-1.5 w-1.5 rounded-full bg-blad"></span><span data-status>Di t/m za open</span></div>
          <table class="rijs mt-6 w-full max-w-md text-sm">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:text-blad">
                  <th scope="row" class="py-3 text-left font-normal">{t.naam}</th>
                  <td class="num py-3 text-right">{t.o > 0 ? `${t.open} - ${t.dicht}` : 'gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={site.route} class="knop"><Icoon naam="pin" />Route</a>
            <a href={site.telHref} class="knop knop-stil"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
          </div>
        </div>

        <div class="lg:col-span-5 lg:col-start-8 lg:pt-4">
          <a href={site.maps} class="rijs inline-flex items-center gap-3 text-xs text-zacht no-underline hover:text-blad"><Icoon naam="g" class="h-4 w-4" /><span><span class="num">{site.google.score}</span> op Google · {site.google.aantal} reviews</span></a>
          <div class="mt-8 divide-y divide-lijn border-y border-lijn">
            {[r.marjolein, r.jasper].map((q, i) => (
              <blockquote class="rijs py-8" style={`--d:${i * 0.1}s`}>
                <p class="font-kop text-xl leading-snug md:text-2xl">“{q.tekst}”</p>
                <footer class="mt-4 label">{q.naam} · Google</footer>
              </blockquote>
            ))}
          </div>
          <p class="rijs mt-8 text-sm text-zacht">Of mail naar <a href={`mailto:${site.mail}`} class="link text-ivoor">b.g.l.goldandsilver<wbr />@gmail.com</a></p>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Eén zin + optionele gravure vult het WhatsApp-bericht; de gravure verschijnt op de ring.
  const f = document.querySelector<HTMLFormElement>('[data-wow]');
  if (f) {
    const wens = f.querySelector<HTMLSelectElement>('#wens')!;
    const grav = f.querySelector<HTMLInputElement>('#gravure')!;
    const knop = f.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const ring = document.querySelector<SVGTextPathElement>('[data-gravure-tekst]');
    const voorbeeld = grav.placeholder;
    const zet = () => {
      const t = wens.options[wens.selectedIndex].text;
      const g = grav.value.trim();
      let m = `Hallo B.G.L. Gold & Silver, ik wil graag ${t}.`;
      if (g) m += ` Gravure: "${g}".`;
      m += ' Wanneer kan ik langskomen?';
      knop.href = `https://wa.me/31619515335?text=${encodeURIComponent(m)}`;
      if (ring) ring.textContent = g || voorbeeld;
    };
    f.addEventListener('input', zet);
    f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
