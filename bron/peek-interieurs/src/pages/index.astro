    <!-- 10. Reviews -->
    <section class="py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-6 py-5 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-10 w-10 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num text-3xl font-[820] leading-none text-inkt">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span></span>
              <span class="mt-1 block text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-6 md:grid-cols-3 lg:mt-14">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <figure class="kaart flex h-full flex-col p-8">
                <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</div>
                <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5">
                  <span class="grid h-11 w-11 flex-none place-items-center bg-kalk-2 text-lg font-bold">{r.naam[0]}</span>
                  <span><b class="block">{r.naam}</b><span class="text-[.9375rem] text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 11. Contact en tijden -->
    <section id="contact" class="border-t border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-contact">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Contact</p>
          <h2 id="t-contact" class="rijs mt-5 text-4xl">Heeft u vragen of wilt u een offerte?</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-steen">Bel, mail of app ons voor een vrijblijvende offerte of een afspraak in de showroom.</p>
          <p class="rijs mt-8"><a href={site.telHref} class="num text-[clamp(2.1rem,8vw,4.6rem)] font-[820] leading-none tracking-[-.03em] text-inkt no-underline transition-colors hover:text-merk">{site.tel}</a></p>
          <div class="rijs mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--d:.1s">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" />Bellen</a>
            <a href={`mailto:${site.mail}`} class="knop knop-rand">{site.mail}</a>
          </div>
          <div class="rijs mt-10 flex gap-4 border-t border-lijn-licht pt-8" style="--d:.14s">
            <Icoon naam="pin" class="mt-1 h-6 w-6 flex-none text-merk" />
            <div>
              <p class="font-extrabold">Showroom</p>
              <p class="mt-1 text-steen">{site.straat}, {site.postcode} {site.plaats}. Bezoeken op afspraak.</p>
              <a href={site.route} class="link mt-3 inline-block font-bold">Route plannen</a>
            </div>
          </div>
        </div>
        <div class="rijs lg:col-span-5" style="--d:.15s">
          <div class="kaart overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-lijn-licht px-6 py-5">
              <p class="text-xl font-extrabold">Openingstijden</p>
              <p class="flex items-center gap-2 text-[.9375rem] font-bold" data-status><span class="h-3 w-3 rounded-full bg-kalk-3" data-stip></span><span data-status-tekst>Op afspraak</span></p>
            </div>
            <table class="w-full">
              <caption class="sr-only">Openingstijden volgens Google</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr class="border-b border-lijn-licht last:border-0 data-[vandaag]:bg-merk-zacht data-[vandaag]:font-extrabold" data-dag={t.nr}>
                    <th scope="row" class="py-3 pl-5 pr-2 text-left font-[inherit] sm:px-6">{t.dag}</th>
                    <td class="num whitespace-nowrap py-3 pl-2 pr-5 text-right sm:px-6">{String(t.open[0]).padStart(2, '0')}:00 tot {t.open[1]}:00</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="border-t border-lijn-licht bg-kalk px-6 py-4 text-[.9375rem] text-steen">Tijden volgens Google. De showroom bezoekt u op afspraak.</p>
          </div>
        </div>
      </div>
