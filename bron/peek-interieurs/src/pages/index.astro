    <!-- 12. Slotbalk -->
    <section class="relative isolate overflow-hidden bg-inkt text-wit" aria-label="Afspraak maken">
      <Image src={sGordijn} alt="" widths={[800, 1400, 2000]} sizes="100vw" quality={60} class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_40%] opacity-45" />
      <div class="wrap flex flex-col items-start justify-between gap-6 py-16 md:flex-row md:items-center md:py-20">
        <p class="max-w-3xl text-[clamp(2rem,2.6vw+1rem,3.2rem)] font-[820] leading-none tracking-[-.03em]">Van vloeren tot <span class="text-merk-licht">raamdecoratie.</span></p>
        <a href={waHoi} class="knop knop-merk shrink-0"><Icoon naam="wa" />Afspraak in de showroom</a>
      </div>
