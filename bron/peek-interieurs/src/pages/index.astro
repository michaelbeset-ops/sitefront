    <section class="bg-merk text-wit" aria-label="Uit een review">
      <figure class="wrap py-20 md:py-24">
        <blockquote class="rijs max-w-5xl text-[clamp(1.8rem,3vw+.8rem,3.4rem)] font-[800] leading-[1.08] tracking-[-.025em]">“Niks is teveel, en een goede showroom waar alle tijd is voor advies.”</blockquote>
        <figcaption class="rijs mt-7 text-lg text-wit/90" style="--d:.08s">Google review</figcaption>
