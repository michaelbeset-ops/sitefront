  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  // Legplanner: patroon + plint tekenen, bericht opbouwen -> vooraf ingevuld WhatsApp.
  const f = document.querySelector<HTMLFormElement>('[data-plan]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const vloer = document.querySelector<SVGSVGElement>('[data-vloerbeeld]');
  const plint = document.querySelector<SVGSVGElement>('[data-plintbeeld]');
  const pl = document.querySelector<HTMLElement>('[data-patroon-label]');
  const pll = document.querySelector<HTMLElement>('[data-plint-label]');
  const NS = 'http://www.w3.org/2000/svg';
  const tinten = ['#c9a77c', '#bf9b6f', '#d3b48b', '#b89366', '#c4a275', '#cdae84'];
  let zaad = 7;
  const rnd = () => { zaad = (zaad * 9301 + 49297) % 233280; return zaad / 233280; };
  const rect = (g: Element, x: number, y: number, w: number, h: number, fill?: string) => {
    const r = document.createElementNS(NS, 'rect');
    r.setAttribute('x', String(x)); r.setAttribute('y', String(y)); r.setAttribute('width', String(w)); r.setAttribute('height', String(h));
    r.setAttribute('fill', fill || tinten[Math.floor(rnd() * tinten.length)]); r.setAttribute('stroke', '#7d6446'); r.setAttribute('stroke-width', '.6');
    g.appendChild(r); return r;
  };
  function teken(patroon: string) {
    if (!vloer) return;
    zaad = 7; vloer.innerHTML = '';
    const W = 400, H = 260;
    const bies = patroon.includes('bies');
    const inset = bies ? 26 : 0;
    const defs = document.createElementNS(NS, 'defs');
    defs.innerHTML = `<clipPath id="binnen"><rect x="${inset}" y="${inset}" width="${W - 2 * inset}" height="${H - 2 * inset}"/></clipPath>`;
    vloer.appendChild(defs);
    const g = document.createElementNS(NS, 'g'); g.setAttribute('clip-path', 'url(#binnen)'); vloer.appendChild(g);
    if (patroon.startsWith('visgraat')) {
      const w = 14, L = 56;
      const r = document.createElementNS(NS, 'g'); r.setAttribute('transform', `translate(${W / 2} ${H / 2}) rotate(45)`); g.appendChild(r);
      for (let j = -8; j <= 8; j++) for (let k = -22; k <= 22; k++) {
        const ox = k * w + j * L, oy = k * w - j * L;
        rect(r, ox, oy, L, w); rect(r, ox, oy + w, w, L);
      }
    } else if (patroon === 'rechte stroken') {
      const h = 22, l = 150;
      for (let y = 0, i = 0; y < H; y += h, i++) for (let x = -((i * 61) % l); x < W; x += l) rect(g, x, y, l, h);
    } else {
      const s = 64;
      for (let y = 0, i = 0; y < H; y += s, i++) for (let x = -(i % 2) * (s / 2); x < W; x += s) rect(g, x, y, s, s, ['#9fa3a1', '#a8acaa', '#969a98'][Math.floor(rnd() * 3)]);
    }
    if (bies) {
      const b = document.createElementNS(NS, 'g'); vloer.appendChild(b);
      rect(b, 0, 0, W, 22, '#c4a275'); rect(b, 0, H - 22, W, 22, '#c4a275'); rect(b, 0, 22, 22, H - 44, '#c4a275'); rect(b, W - 22, 22, 22, H - 44, '#c4a275');
      const l = document.createElementNS(NS, 'rect'); l.setAttribute('x', '23'); l.setAttribute('y', '23'); l.setAttribute('width', String(W - 46)); l.setAttribute('height', String(H - 46));
      l.setAttribute('fill', 'none'); l.setAttribute('stroke', '#1e2223'); l.setAttribute('stroke-width', '3.5'); b.appendChild(l);
    }
  }
  function tekenPlint(cm: number) {
    if (!plint) return;
    const h = cm * 2.2;
    plint.innerHTML = `<rect x="0" y="0" width="400" height="48" fill="#e9e9e4"/><rect x="0" y="${42 - h}" width="400" height="${h}" fill="#ffffff" stroke="#cfd0c9"/><rect x="0" y="42" width="400" height="6" fill="#c4a275"/>`;
  }
  if (f && vb && knop) {
    const zet = () => {
      const d = new FormData(f);
      const wat = String(d.get('wat'));
      const isVloer = wat === 'een nieuwe pvc vloer';
      f.querySelectorAll<HTMLElement>('[data-vloer]').forEach((el) => { el.style.display = isVloer ? '' : 'none'; });
      const patroon = String(d.get('patroon'));
      const p = String(d.get('plint'));
      const ruimte = String(d.get('ruimte') || '').trim();
      const m2 = String(d.get('m2') || '').replace(/[^\d,.]/g, '');
      const waar = String(d.get('waar'));
      teken(patroon); tekenPlint(Number(p));
      if (pl) pl.textContent = patroon.charAt(0).toUpperCase() + patroon.slice(1);
      if (pll) pll.textContent = `Aanzicht plint ${p} cm (illustratie)`;
      const r = [`Hallo Peek Interieurs, ik ben op zoek naar ${wat}.`];
      if (isVloer) r.push(`Legpatroon: ${patroon}, plint ${p} cm.`);
      if (ruimte || m2) r.push(`Ruimte: ${ruimte || 'nog niet bekend'}${m2 ? `, ongeveer ${m2} m²` : ''}.`);
      r.push(waar === 'thuis' ? 'Kunnen jullie bij mij op locatie komen kijken?' : 'Ik wil graag een afspraak in de showroom.');
      const t = r.join('\n');
      vb.textContent = t; knop.href = `${site.wa}?text=${encodeURIComponent(t)}`;
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
  // Vandaag in de tijdentabel + nu bereikbaar (tijden volgens Google).
  const tijd: Record<number, [number, number]> = { 0: [10, 16], 1: [7, 21], 2: [7, 21], 3: [7, 21], 4: [7, 21], 5: [7, 21], 6: [9, 18] };
  const nu = new Date(); const dag = nu.getDay(); const uur = nu.getHours() + nu.getMinutes() / 60;
  document.querySelector(`[data-dag="${dag}"]`)?.setAttribute('data-vandaag', '');
  const open = uur >= tijd[dag][0] && uur < tijd[dag][1];
  const st = document.querySelector('[data-status-tekst]'); const stip = document.querySelector<HTMLElement>('[data-stip]');
  if (st && stip) { st.textContent = open ? 'Nu bereikbaar' : 'Nu gesloten'; stip.style.background = open ? '#1a7f4b' : '#b3261e'; }
</script>
