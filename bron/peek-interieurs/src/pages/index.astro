---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, tijden, waHoi, waMet } from '../data/site';

// Eigen foto's van peekinterieurs.nl; een sfeerfoto van Unsplash. Zie src/assets/BRONNEN.txt en tools/prep.mjs.
import hero from '../assets/hero.jpg';
import pvc from '../assets/pvc.jpg';
import egaliseren from '../assets/egaliseren.jpg';
import trap from '../assets/trap.jpg';
import karpet from '../assets/karpet.jpg';
import raam from '../assets/raam.jpg';
import plint from '../assets/plint.jpg';
import bies from '../assets/bies.jpg';
import band from '../assets/band.jpg';
import vakman from '../assets/vakman.jpg';
import trapwerk from '../assets/trapwerk.jpg';
import showA from '../assets/showroom-a.jpg';
import showB from '../assets/showroom-b.jpg';
import showC from '../assets/showroom-c.jpg';
import pAnthony from '../assets/p-anthony.jpg';
import pKarpet from '../assets/p-karpet.jpg';
import pBussum from '../assets/p-bussum.jpg';
import pTrap from '../assets/p-traptapijt.jpg';
import pHoef from '../assets/p-hoef.jpg';
import sGordijn from '../assets/s-gordijn.jpg';

// Teksten van hun eigen pagina's (home, pvc-vloeren, egaliseren, traprenovatie, vloerafwerking, raamdecoratie, extra diensten).
const diensten = [
  { t: 'Pvc vloeren', d: 'Niet te onderscheiden van een echte houten of stenen vloer en ook nog eens gemakkelijk in onderhoud, sterk en duurzaam.', src: pvc, pos: '50% 70%', alt: 'Visgraat pvc-vloer bij openslaande deuren' },
  { t: 'Egaliseren', d: 'De basis voor elke mooie vlakke vloer is het egaliseren van de bestaande ondergrond.', src: egaliseren, pos: '50% 60%', alt: 'Geëgaliseerde ondervloer, klaar voor de nieuwe vloer' },
  { t: 'Traprenovatie', d: 'Creëer eenheid door de vloer door te leggen op de trap. Of kies tapijt: zacht en geluiddempend.', src: trap, pos: '50% 45%', alt: 'Trap bekleed met dezelfde pvc als de vloer, met zwarte strip' },
  { t: 'Tapijt en karpet', d: 'Wij zijn gespecialiseerd in bijna alle harde en zachte vloerbedekkingen.', src: karpet, pos: '50% 50%', alt: 'Karpet met een band langs de rand' },
  { t: 'Raamdecoratie en gordijnen', d: 'Jaloezieën, plisségordijnen, vouwgordijnen, (duo) rolgordijnen, gordijnen en shutters.', src: raam, pos: '50% 60%', alt: 'Plissé voor de ramen in de showroom' },
  { t: 'Plinten en onderhoud', d: 'MDF afwerkplinten van 16, 12, 9 en 6 cm. Ook voor vloeronderhoud en vloeren verwijderen.', src: plint, pos: '50% 55%', alt: 'Hoge witte plint op een pvc-vloer' },
];
const materialen = ['Pvc stroken', 'Pvc tegels', 'Visgraat', 'Tapijt', 'Tapijttegels', 'Linoleum', 'Vinyl', 'Rubber', 'Schoonloopmatten'];

const cijfers = [
  ['1983', 'Kees start zijn eigen bedrijf'],
  ['66 jaar', 'ervaring in totaal'],
  ['4000 m²', 'tapijt in het Paleis op de Dam'],
  [site.google.score, `op Google, ${site.google.aantal} reviews`],
];

// Werkwijze-pagina, letterlijk of licht ingekort.
const stappen = [
  ['Afspraak in de showroom', 'Overdag, in de avond of in het weekend. Geen wachttijden en een showroom voor u alleen.'],
  ['Koffie en advies', 'We beginnen met een bak koffie en wat lekkers. Liever bij u op locatie? Ook dat is geen enkel probleem.'],
  ['Stalen mee naar huis', 'Neem grote stalenborden mee om nog eens rustig te kijken of de kleur wel past.'],
  ['Offerte en planning', 'Akkoord met de vrijblijvende offerte? Dan bestellen wij de materialen en plannen we de werkzaamheden in.'],
];

// Bijschriften uit hun eigen projectpagina's.
const projecten = [
  { src: pBussum, t: 'Drie verdiepingen visgraat', p: 'Bussum', d: 'Visgraat pvc met border bies, de trappen bekleed met tapijt.', cls: 'lg:col-span-4 lg:row-span-2', ratio: 'aspect-[4/5] lg:aspect-auto lg:h-full' },
  { src: pAnthony, t: 'De bar van The Anthony', p: 'Utrecht', d: 'Hotel The Anthony: de bar voorzien van een nieuwe pvc vloer.', cls: 'lg:col-span-5', ratio: 'aspect-[4/3]' },
  { src: pKarpet, t: 'Karpet in een kantoorpand', p: 'Nieuwegein', d: 'Karpet van Van Besouw, geleverd en gelegd.', cls: 'lg:col-span-3', ratio: 'aspect-[4/3] lg:aspect-[3/4]' },
  { src: pTrap, t: 'Trap renovatie met tapijt', p: '', d: 'Zacht aan de voetjes, geluiddempend.', cls: 'lg:col-span-3', ratio: 'aspect-[4/3] lg:aspect-[3/4]' },
  { src: pHoef, t: 'Drie verdiepingen visgraat', p: 'Hoef en Haag', d: 'De trappen bekleed met dezelfde kleur pvc stroken, met een zwarte strip.', cls: 'lg:col-span-5', ratio: 'aspect-[4/3]' },
];

const sterren = [1, 2, 3, 4, 5];
---
<Base title="Peek Interieurs | Pvc vloeren, visgraat en raamdecoratie in Nieuwegein" description="Familiebedrijf sinds 1983 voor pvc vloeren, visgraat, egaliseren, traprenovatie, tapijt en raamdecoratie. Showroom in Nieuwegein op afspraak. Bel 06 12 60 05 91.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: eigen visgraatfoto, donker verloop, hun motto -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={hero} alt="" widths={[640, 960, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" quality={64} class="absolute inset-0 -z-20 h-full w-full object-cover object-[78%_85%] md:object-[62%_60%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1e2223b3_0%,#1e222340_30%,#1e2223d9_62%,#1e2223fa_100%)] md:bg-[linear-gradient(90deg,#1e2223f7_0%,#1e2223e0_36%,#1e222366_66%,#1e22231f_100%),linear-gradient(180deg,#1e2223b3_0%,#1e222300_30%,#1e222300_70%,#1e2223a6_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-28 pt-40 md:pb-20 lg:pt-52">
        <div class="max-w-[50rem]">
          <p class="eyebrow eyebrow-licht">Vloeren en raamdecoratie in Nieuwegein</p>
          <h1 id="inhoud" class="mt-6 text-hero">Je kan het maar een keer <span class="text-merk-licht">goed</span> doen.</h1>
          <p class="mt-7 max-w-xl text-xl leading-relaxed text-wit/95 md:text-[1.4rem]">Voor complete interieurprojecten van vloeren tot raamdecoratie. Van het egaliseren en uitkiezen tot het leggen en het onderhoud daarna.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />Afspraak in de showroom</a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />Bel {site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-3 text-[1rem] text-wit">
            <li class="flex items-center gap-2"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-5 w-5 text-merk-licht" />Advies altijd kosteloos</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-5 w-5 text-merk-licht" />Ook in de avond of het weekend</li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-24 right-5 hidden max-w-[14rem] text-right text-[.875rem] text-wit/75 md:bottom-8 md:right-10 md:block">Foto: peekinterieurs.nl</p>
    </section>
  </div>

  <main>
    <!-- 2. Cijfers + materialen -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="Peek Interieurs in cijfers">
      <div class="wrap">
        <dl class="grid grid-cols-2 lg:grid-cols-4">
          {cijfers.map(([g, t], i) => (
            <div class={`rijs border-lijn-licht py-9 md:py-12 ${i % 2 ? 'pl-5 md:pl-10' : 'pr-5'} ${i % 2 ? 'border-l' : ''} ${i > 1 ? 'border-t lg:border-t-0' : ''} ${i === 2 ? 'lg:border-l lg:pl-10' : ''}`} style={`--d:${i * 0.05}s`}>
              <dt class="sr-only">{t}</dt>
              <dd class="num text-[clamp(2.2rem,3.2vw+1rem,3.6rem)] font-[820] leading-none tracking-[-.035em]">{g}</dd>
              <dd class="mt-3 max-w-[13rem] text-steen">{t}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 3. Diensten: fotokaarten -->
    <section id="diensten" class="py-24 md:py-32" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-5 text-4xl">Van ondervloer tot plint, en de ramen erbij.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-4 lg:col-start-9" style="--d:.05s">Zo kunnen we de gewenste ruimte een complete metamorfose geven die het beste past bij uw smaak, budget en gebruik.</p>
        </div>
        <ul class="rijs mt-10 flex flex-wrap gap-2.5" aria-label="Vloerbedekkingen">
          {materialen.map((m) => <li class="chip">{m}</li>)}
        </ul>
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {diensten.map((v, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden">
                <div class="overflow-hidden">
                  <Image src={v.src} alt={v.alt} widths={[420, 640, 860]} sizes="(min-width: 1024px) 380px, (min-width: 768px) 46vw, 100vw" quality={68} class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${v.pos}`} />
                </div>
                <div class="flex flex-1 flex-col p-7">
                  <h3 class="text-[1.75rem]">{v.t}</h3>
                  <p class="mt-3 text-steen">{v.d}</p>
                  <a href="#legplanner" class="mt-auto inline-flex items-center gap-2 pt-7 font-extrabold text-merk no-underline transition-colors hover:text-merk-diep">Vraag het ons<Icoon naam="pijl" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Border en bies (donker) -->
    <section class="bies bies-donker bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-bies">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-5">
          <p class="rijs eyebrow eyebrow-licht">Visgraat</p>
          <h2 id="t-bies" class="rijs mt-5 text-4xl">Met een border en een bies van 1 cm.</h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-mist" style="--d:.06s">Zo legden we een visgraatvloer in Hoef en Haag: een border met een bies van 1 cm, afgewerkt met 15 cm hoge plinten. Of met band en bies.</p>
          <ul class="rijs mt-9 space-y-3 text-[1.0625rem]" style="--d:.1s">
            {[
              'Zeer stil en geluiddempend',
              'Uitermate geschikt voor vloerverwarming',
              'Strak tegen de plint of muur gelegd',
              'Beschadigde stroken relatief makkelijk te vervangen',
            ].map((x) => <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-merk-licht" />{x}</li>)}
          </ul>
          <p class="rijs mt-9 text-mist" style="--d:.14s">Wij kunnen alle merken leveren. In de showroom o.a. Therdex.</p>
        </div>
        <figure class="rijs grid grid-cols-5 gap-4 lg:col-span-7">
          <Image src={bies} alt="Visgraat pvc met een donkere bies langs de border, rond een kozijn" widths={[500, 800, 1080]} sizes="(min-width: 1024px) 34vw, 60vw" quality={70} class="col-span-3 aspect-[3/4] h-full w-full object-cover" />
          <div class="col-span-2 grid gap-4">
            <Image src={band} alt="Visgraat met band en bies in een keuken" widths={[300, 600]} sizes="(min-width: 1024px) 22vw, 38vw" quality={70} class="aspect-[3/4] h-full w-full object-cover" />
            <div class="flex flex-col justify-end bg-merk p-4 sm:p-5">
              <p class="text-[clamp(1.6rem,2.4vw+.6rem,2.8rem)] font-[820] leading-none tracking-[-.03em]">1 cm</p>
              <p class="mt-2 text-[.95rem] font-bold leading-snug text-wit/90">bies langs de border</p>
            </div>
          </div>
          <figcaption class="col-span-5 text-[.9375rem] text-mist">Eigen foto's: border en bies in Hoef en Haag (groot), band en bies (klein).</figcaption>
        </figure>
      </div>
    </section>

    <!-- 5. Wow: legplanner -> vooraf ingevuld WhatsApp -->
    <section id="legplanner" class="py-24 md:py-32" aria-labelledby="t-plan">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Legplanner</p>
            <h2 id="t-plan" class="mt-5 text-4xl">Leg uw vloer alvast.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:self-end" style="--d:.1s">Kies een patroon en een plint, en u ziet het meteen. Het bericht gaat via WhatsApp naar ons; versturen doet u zelf.</p>
        </div>

        <form class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-6 lg:mt-14 lg:grid-cols-12 lg:gap-8" data-plan>
          <div class="kaart min-w-0 space-y-8 p-5 sm:p-8 lg:col-span-6">
            <fieldset>
              <legend class="veld-label">Wat wilt u?</legend>
              <div class="grid grid-cols-2 gap-2.5">
                <label class="keuze"><input type="radio" name="wat" value="een nieuwe pvc vloer" checked />Nieuwe pvc vloer</label>
                <label class="keuze"><input type="radio" name="wat" value="een traprenovatie" />Traprenovatie</label>
                <label class="keuze"><input type="radio" name="wat" value="tapijt of karpet" />Tapijt of karpet</label>
                <label class="keuze"><input type="radio" name="wat" value="raamdecoratie" />Raamdecoratie</label>
              </div>
            </fieldset>
            <fieldset data-vloer>
              <legend class="veld-label">Legpatroon</legend>
              <div class="grid grid-cols-2 gap-2.5">
                <label class="keuze"><input type="radio" name="patroon" value="visgraat" checked />Visgraat</label>
                <label class="keuze"><input type="radio" name="patroon" value="visgraat met border en bies" />Met border en bies</label>
                <label class="keuze"><input type="radio" name="patroon" value="rechte stroken" />Rechte stroken</label>
                <label class="keuze"><input type="radio" name="patroon" value="tegels" />Tegels</label>
              </div>
            </fieldset>
            <fieldset data-vloer>
              <legend class="veld-label">Plint</legend>
              <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
                {['6', '9', '12', '16'].map((p) => <label class="keuze num"><input type="radio" name="plint" value={p} checked={p === '9'} />{p} cm</label>)}
              </div>
            </fieldset>
            <div class="grid gap-6 sm:grid-cols-[minmax(0,1fr)_9rem]">
              <div>
                <label for="ruimte" class="veld-label">Welke ruimte?</label>
                <input id="ruimte" name="ruimte" class="veld" placeholder="Bijvoorbeeld woonkamer en hal" />
              </div>
              <div>
                <label for="m2" class="veld-label">Ongeveer m²</label>
                <input id="m2" name="m2" class="veld num" inputmode="numeric" placeholder="40" />
              </div>
            </div>
            <fieldset>
              <legend class="veld-label">Waar zullen we kijken?</legend>
              <div class="grid grid-cols-2 gap-2.5">
                <label class="keuze"><input type="radio" name="waar" value="showroom" checked />In de showroom</label>
                <label class="keuze"><input type="radio" name="waar" value="thuis" />Bij mij op locatie</label>
              </div>
            </fieldset>
          </div>

          <div class="min-w-0 lg:col-span-6">
            <div class="sticky top-6 bg-inkt p-5 text-wit sm:p-8">
              <div class="relative overflow-hidden" aria-hidden="true">
                <svg viewBox="0 0 400 260" class="block h-auto w-full" data-vloerbeeld></svg>
                <p class="absolute left-3 top-3 bg-inkt/80 px-2.5 py-1 text-[.875rem] font-bold" data-patroon-label>Visgraat</p>
              </div>
              <div class="mt-3 flex items-end gap-4" aria-hidden="true">
                <svg viewBox="0 0 400 48" preserveAspectRatio="none" class="block h-12 w-full" data-plintbeeld></svg>
              </div>
              <p class="mt-1 text-[.875rem] text-mist" data-plint-label>Aanzicht plint 9 cm (illustratie)</p>
              <p class="mt-6 text-[.9375rem] font-bold text-mist">Uw bericht</p>
              <p class="mt-2 min-h-[6.5rem] whitespace-pre-line bg-inkt-2 px-4 py-4 text-[1.0625rem] leading-relaxed" data-voorbeeld aria-live="polite"></p>
              <a href={waHoi} class="knop knop-groen mt-5 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <p class="mt-4 text-[.9375rem] text-mist">Of bel: <a href={site.telHref} class="num font-bold text-wit no-underline hover:text-merk-licht">{site.tel}</a></p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 6. Over ons: familiebedrijf -->
    <section id="over" class="bg-wit py-24 md:py-32" aria-labelledby="t-over">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs relative lg:col-span-6">
          <Image src={vakman} alt="Vakman van Peek Interieurs aan het werk bij een wand, van achteren" widths={[500, 800, 1200]} sizes="(min-width: 1024px) 40vw, 90vw" quality={68} class="aspect-[4/5] w-full object-cover object-[50%_40%]" />
          <Image src={trapwerk} alt="Een trap wordt bekleed, van bovenaf gezien" widths={[300, 500]} sizes="(min-width: 1024px) 16vw, 36vw" quality={68} class="absolute -bottom-8 right-4 hidden aspect-square w-[38%] border-[6px] border-wit object-cover sm:block lg:-right-8" />
          <figcaption class="mt-4 text-[.9375rem] text-steen sm:max-w-[55%]">Eigen foto's van peekinterieurs.nl.</figcaption>
        </figure>
        <div class="lg:col-span-6">
          <p class="rijs eyebrow">Over ons</p>
          <h2 id="t-over" class="rijs mt-5 text-4xl">Het stoffeervak zit in het bloed.</h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-steen" style="--d:.06s">In 1983 is Kees zijn eigen bedrijf gestart. In 2004 werd Peek Interieurs een heus familiebedrijf: als vader en zoon runnen we het met veel plezier. Altijd dezelfde contactpersoon.</p>
          <blockquote class="rijs mt-9 border-l-[3px] border-merk pl-6 text-[1.3rem] font-[700] leading-snug" style="--d:.1s">De 4000 m² tapijt in het Paleis op de Dam is er eentje om extra trots op te zijn. Een ontmoeting en een handje van toen nog koningin Beatrix is een dankbaar moment.</blockquote>
          <ul class="rijs mt-10 grid gap-3 sm:grid-cols-3" style="--d:.14s">
            {[
              ['Afspraak is afspraak', 'Blijvend betrokken.'],
              ['100% tevreden', 'Wij zijn pas tevreden als u dat ook 100% bent.'],
              ['Advies kosteloos', 'Advies over uw situatie is altijd gratis.'],
            ].map(([t, d]) => (
              <li class="border border-lijn-licht bg-kalk p-5">
                <b class="block text-[1.0625rem]">{t}</b>
                <span class="mt-1 block text-[.9375rem] text-steen">{d}</span>
              </li>
            ))}
          </ul>
          <p class="rijs mt-9 text-[.9375rem] text-steen" style="--d:.18s"><b class="text-inkt">Projecten o.a.:</b> Leger des Heils Zeist, Dok24 Veenendaal, Zorggroep De Laren, Kardex Woerden, Hotel The Anthony, Anneroos kinderopvang.</p>
        </div>
      </div>
    </section>

    <!-- 7. Showroom op afspraak: werkwijze -->
    <section id="showroom" class="py-24 md:py-32" aria-labelledby="t-show">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Showroom op afspraak</p>
            <h2 id="t-show" class="mt-5 text-4xl">Een showroom voor u alleen.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-4 lg:col-start-9" style="--d:.05s">{site.straat}, {site.plaats}. Wij zijn heel flexibel.</p>
        </div>
        <ol class="mt-12 grid gap-px overflow-hidden border border-lijn-licht bg-lijn-licht sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs flex flex-col bg-kalk p-7 md:p-8" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-6 text-[1.5rem]">{t}</h3>
              <p class="mt-3 text-steen">{d}</p>
            </li>
          ))}
        </ol>
        <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-12">
          <Image src={showA} alt="Wand met Therdex-stalen in de showroom" widths={[400, 700, 1080]} sizes="(min-width: 768px) 46vw, 50vw" quality={68} class="rijs col-span-2 aspect-[16/10] h-full w-full object-cover md:col-span-6" />
