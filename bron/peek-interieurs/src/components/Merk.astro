---
// Nagezet naar hun logo (bron/site/img/peek-header-logo.png): PEEK groot en dun, INTERIEURS eronder, VLOEREN & RAAMDECORATIE
// klein, alles in een dun kader.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col items-start border px-2.5 pb-1.5 pt-1 leading-none no-underline sm:px-3 ${donker ? 'border-inkt text-inkt' : 'border-wit/85 text-wit'}`} style="font-family: var(--font-smal)">
  <span class="text-[2.05rem] font-[300] uppercase tracking-[.04em] sm:text-[2.4rem]">Peek</span>
  <span class="-mt-0.5 text-[.98rem] font-[300] uppercase tracking-[.09em] sm:text-[1.12rem]">Interieurs</span>
  <span class="mt-1 text-[.5rem] font-[500] uppercase tracking-[.14em] sm:text-[.56rem]">Vloeren &amp; raamdecoratie</span>
  <span class="sr-only">, naar de homepage</span>
</a>
