---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, wa, bestel, waMet } from '../data/site';
import { krans } from '../data/krans';
import zaal from '../assets/zaal.jpg';
import bakje from '../assets/bakje.jpg';
import kransFoto from '../assets/krans.jpg';
import fotowand from '../assets/fotowand.jpg';
import plank from '../assets/plank.jpg';
import mee from '../assets/mee.jpg';
import gevel from '../assets/gevel.jpg';

// De kaart: alleen wat de bron noemt (Heerlen Mijn Stad), zonder prijzen.
const tostis = [
  { naam: 'Klassieke tosti', wat: 'een klassieke tosti' },
  { naam: 'Tosti gehaktbal', wat: 'een tosti gehaktbal' },
  { naam: 'Tosti vettige herder', wat: 'een tosti vettige herder' },
  { naam: 'Tosti caprese', wat: 'een tosti caprese' },
  { naam: 'Tosti kip pesto', wat: 'een tosti kip pesto' },
];
const banier = 'TOSTIBAR'.split('');
const dagen = [
  { wd: 2, naam: 'Dinsdag', tijd: '11.00-16.00' },
  { wd: 3, naam: 'Woensdag', tijd: '11.00-16.00' },
  { wd: 4, naam: 'Donderdag', tijd: '11.00-16.00' },
  { wd: 5, naam: 'Vrijdag', tijd: '11.00-16.00' },
  { wd: 6, naam: 'Zaterdag', tijd: '11.00-16.00' },
  { wd: 0, naam: 'Zondag', tijd: 'gesloten' },
  { wd: 1, naam: 'Maandag', tijd: 'gesloten' },
];
---
<Base title={`${site.naam} | Tosti's in Heerlen, Saroleastraat 66`} description="Goed gevulde tosti's van Pat, om af te halen of binnen te eten, in een zaak vol werk van lokale kunstenaars. Dinsdag t/m zaterdag 11.00-16.00 uur.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. De voorste zaal -->
    <section class="relative flex flex-col overflow-hidden border-b border-plafond lg:block lg:min-h-[calc(100dvh-6.25rem)]" aria-labelledby="titel">
      <div class="wrap relative grid lg:min-h-[calc(100dvh-6.25rem)] lg:grid-cols-12">
        <div class="flex gap-4 pb-10 pt-0 sm:gap-6 lg:col-span-6 lg:pb-14 xl:col-span-6">
          <div class="banier hidden w-14 shrink-0 gap-[0.18em] self-start lg:flex pb-8 pt-10 text-[1.65rem]" aria-hidden="true">
            {banier.map((l) => <span>{l}</span>)}
          </div>
          <div class="flex flex-col pt-5 lg:justify-between lg:pt-16">
            <div>
              <p class="text-sm text-zacht">Saroleastraat 66, Heerlen</p>
              <h1 id="titel" class="mt-4 text-4xl">Tosti's in een klein museum</h1>
              <p class="mt-6 max-w-[27rem] text-lg leading-snug">Goed gevulde tosti's van Pat, met royale saus, tussen werk van lokale kunstenaars.</p>
              <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                <a href={bestel()} class="knop"><Fragment set:html={wa} />Bestel om af te halen</a>
                <a href={site.telHref} class="lijn text-sm">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
              </div>
            </div>
            <p class="mt-10 text-sm text-zacht lg:mt-0">Dinsdag t/m zaterdag, <span class="whitespace-nowrap tabular-nums">11.00-16.00</span>. Binnen eten kan ook.</p>
          </div>
        </div>
      </div>
      <figure class="relative order-first lg:absolute lg:inset-y-0 lg:right-0 lg:w-[52%]">
        <div class="banier absolute left-5 top-0 z-10 w-9 gap-[0.12em] pb-3 pt-4 text-[1.05rem] sm:left-10 lg:hidden" aria-hidden="true">
          {banier.map((l) => <span>{l}</span>)}
        </div>
        <div class="aspect-[3/2] sm:aspect-[16/9] lg:aspect-auto lg:h-full">
          <Foto src={zaal} hero class="object-[22%_50%]" alt="De voorste zaal van Pat's Tosti Bar: een fiets in een gouden lijst aan een bakstenen muur, een lampion, een rieten lamp, zwart-wit foto's en tafeltjes met kleedjes." sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <figcaption class="bordje wrap border-t-0 pt-2 lg:absolute lg:bottom-0 lg:left-0 lg:w-auto lg:max-w-xs lg:border-t lg:bg-wand lg:px-5 lg:pb-5 lg:pt-3">
          <b class="max-lg:!inline max-lg:!text-xs">De voorste zaal<span class="lg:hidden">.</span></b>{' '}<i>Fiets in een gouden lijst, lampion, rieten lamp.</i>
        </figcaption>
      </figure>
    </section>

    <!-- 2. De kaart -->
    <section id="kaart" class="op-donker scroll-mt-16 bg-plafond text-white" aria-labelledby="kaart-titel">
      <div class="grid lg:grid-cols-12">
        <figure class="lg:col-span-5">
          <div class="aspect-square sm:aspect-[4/3] lg:aspect-auto lg:h-full lg:min-h-[44rem]">
            <Foto src={bakje} alt="Een gegrilde tosti met een rijke vulling en saus in een kartonnen afhaalbakje, met een houten vork." sizes="(min-width: 1024px) 42vw, 100vw" />
          </div>
        </figure>
        <div class="wrap py-16 lg:col-span-7 lg:max-w-none lg:px-16 lg:py-24 xl:px-24">
          <h2 id="kaart-titel" class="text-3xl">De kaart</h2>
          <p class="mt-5 max-w-md text-mist">Pat experimenteert voortdurend met nieuwe tosti's. Tik er een aan en uw bestelling staat klaar in WhatsApp.</p>
          <ul class="mt-10 border-t border-plafond-2">
            {tostis.map((t) => (
              <li class="border-b border-plafond-2">
                <a href={bestel(t.wat)} class="regel kop py-3 text-[1.65rem] leading-none font-bold sm:text-2xl uppercase text-white">
                  <span>{t.naam}</span><span class="stip" aria-hidden="true"></span><span class="pijl">Bestel <span aria-hidden="true">&rarr;</span></span>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-10 grid gap-6 text-sm text-mist sm:grid-cols-2">
            <p><span class="font-semibold text-white">Ook op tafel</span><br />pulled pork, pastrami, croques, soep en smoothies.</p>
            <p><span class="font-semibold text-white">Voor iedereen</span><br />veganistische opties en een kindermenu.</p>
          </div>
          <p class="mt-8 text-xs text-mist">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
        </div>
      </div>
    </section>

    <!-- 3. De zaal: salonwand -->
    <section id="zaal" class="scroll-mt-16 py-20 lg:py-28" aria-labelledby="zaal-titel">
      <div class="wrap grid grid-cols-2 gap-x-5 gap-y-12 sm:gap-x-8 lg:grid-cols-12 lg:gap-x-10 lg:gap-y-14">
        <div class="col-span-2 lg:col-span-5 lg:pt-6">
          <h2 id="zaal-titel" class="text-3xl">Overal wat te bekijken</h2>
          <p class="mt-6 max-w-sm text-lg leading-snug text-zacht">De zaak is een klein museum geworden, met veel werk van lokale kunstenaars.</p>
        </div>
        <figure class="col-span-2 lg:col-span-6 lg:col-start-7 lg:row-span-2">
          <div class="lijst aspect-[3/4]"><Foto src={kransFoto} alt="Witte muur met een gouden lauwerkrans rond 045, een borstbeeld van een kompel, een oude groene telefoon, een schep en ingelijste foto's." sizes="(min-width: 1024px) 40vw, 100vw" /></div>
          <figcaption class="bordje mt-5 max-w-xs"><b>Muur met lauwerkrans</b><i>045, een kompel, een oude telefoon en een schep.</i></figcaption>
        </figure>
        <figure class="col-span-1 lg:col-span-4 lg:col-start-2 lg:-mt-4">
          <div class="lijst aspect-[3/4]"><Foto src={fotowand} alt="Achterste zaal met een wand vol ingelijste foto's onder een lichtsnoer, een tafeltje en barkrukken." sizes="(min-width: 1024px) 28vw, 100vw" /></div>
          <figcaption class="bordje mt-5 max-w-xs"><b>Fotowand achterin</b><i>Lijstjes onder een lichtsnoer.</i></figcaption>
        </figure>
        <figure class="col-span-2 lg:col-span-6 lg:col-start-1 lg:mt-6">
          <div class="lijst aspect-[3/2]"><Foto src={plank} alt="Een tosti met een royale vulling en saus op een houten plank, op een rood tafelkleedje, met een glas en bestek." sizes="(min-width: 1024px) 40vw, 100vw" /></div>
          <figcaption class="bordje mt-5 max-w-xs"><b>Binnen eten</b><i>Op een plank, aan tafel met een kleedje.</i></figcaption>
        </figure>
        <figure class="col-span-1 mt-10 lg:col-span-3 lg:col-start-8 lg:mt-24">
          <div class="lijst aspect-[3/4]"><Foto src={mee} alt="Een tosti met rauwe ham, roomkaas en rucola in een donkerblauw servet, buiten boven de stoep." sizes="(min-width: 1024px) 20vw, 100vw" /></div>
          <figcaption class="bordje mt-5 max-w-xs"><b>Om mee te nemen</b><i>In een servet, voor onderweg.</i></figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Pat -->
    <section id="pat" class="op-donker scroll-mt-16 bg-banier text-white" aria-labelledby="pat-titel">
      <div class="wrap grid items-center gap-10 py-16 md:grid-cols-12 lg:py-20">
        <div class="relative mx-auto aspect-square w-64 sm:w-80 md:col-span-5 md:w-full md:max-w-[26rem]">
          <div class="absolute inset-0" set:html={krans('', '', 30)} aria-hidden="true" />
          <h2 id="pat-titel" class="absolute inset-0 flex items-center justify-center pt-[0.12em] text-[clamp(4.5rem,9vw,8.5rem)]">Pat</h2>
        </div>
        <div class="md:col-span-7 md:col-start-6 lg:col-span-6 lg:col-start-7">
          <p class="max-w-md text-xl leading-snug">Patrick Byrman opende Pat's Tosti Bar in 2020. Gasten noemen hem super gastvrij, met passie voor zijn zaak.</p>
          <a href={waMet('Hoi Pat, welke nieuwe tosti heb je vandaag?')} class="lijn mt-8 inline-flex items-center gap-2 font-semibold"><Fragment set:html={wa} />Wat is er vandaag nieuw, Pat?</a>
        </div>
      </div>
    </section>

    <!-- 5. Bezoek -->
    <section id="bezoek" class="scroll-mt-16 py-20 lg:py-28" aria-labelledby="bezoek-titel">
      <div class="wrap grid gap-12 md:grid-cols-12 lg:gap-x-16">
        <figure class="md:col-span-5 lg:col-span-4 lg:col-start-2">
          <div class="lijst aspect-[3/5]"><Foto src={gevel} alt="De gevel van Saroleastraat 66 in Heerlen: een bordeauxrode banier met TOSTIBAR, een bord TOSTIBAR boven de deur en een luifel met tosti's, koffie, frisdrank." sizes="(min-width: 768px) 32vw, 100vw" /></div>
          <figcaption class="bordje mt-5"><b>Saroleastraat 66</b><i>Banier, bord en luifel: tosti's, koffie, frisdrank.</i></figcaption>
        </figure>
        <div class="md:col-span-7 lg:col-span-6 lg:col-start-7">
          <h2 id="bezoek-titel" class="text-3xl">Saroleastraat 66</h2>
          <p class="mt-4 text-lg">{site.postcode} {site.plaats}</p>
          <ul class="mt-10 max-w-md border-t border-plafond text-base" data-tijden>
            {dagen.map((d) => (
              <li data-dag={d.wd} class="flex justify-between gap-4 border-b border-wand-2 px-2 py-2.5 data-[vandaag]:bg-banier data-[vandaag]:font-semibold data-[vandaag]:text-white">
                <span>{d.naam}<span class="vandaag-label sr-only"></span></span>
                <span class={`whitespace-nowrap tabular-nums ${d.tijd === 'gesloten' ? 'text-zacht in-data-[vandaag]:text-white' : ''}`}>{d.tijd}</span>
              </li>
            ))}
          </ul>
          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={bestel()} class="knop"><Fragment set:html={wa} />Bestel om af te halen</a>
            <a href={site.telHref} class="lijn text-sm">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            <a href={site.maps} class="lijn text-sm">Route in Google Maps</a>
          </div>
          <p class="mt-10 text-sm text-zacht">{site.google.score} op Google, uit {site.google.aantal} reviews.</p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  // Markeer vandaag in de openingstijden (tijd in Heerlen).
  const wd = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' })).getDay();
  const li = document.querySelector(`[data-tijden] [data-dag="${wd}"]`);
  if (li) {
    li.setAttribute('data-vandaag', '');
    li.setAttribute('aria-current', 'date');
    const l = li.querySelector('.vandaag-label');
    if (l) l.textContent = ' (vandaag)';
  }
</script>
