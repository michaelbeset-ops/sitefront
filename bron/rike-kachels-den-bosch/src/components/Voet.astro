---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-roet text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk />
      <p class="mt-6 max-w-sm">Kachels, haarden en rookkanalen: installatie, onderhoud, inspectie, reparatie en advies. Gevestigd in {site.plaats}.</p>
    </div>
    <div class="md:col-span-4">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-4"><a href={waHoi} class="link num">{site.mob} (ook WhatsApp)</a></p>
      <p class="mt-1.5"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Gegevens</p>
      <p class="mt-4">{site.voluit}</p>
      <p class="mt-1.5 num">KvK {site.kvk}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.voluit}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-gloed">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en gegevens van rikebv.nl; foto's van jullie eigen website en Google-profiel. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
