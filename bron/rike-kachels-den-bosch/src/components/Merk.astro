---
// Woordmerk naar hun logo: de rode "i" (stip + schuin gedeelde steel) en RIKE zwaar; eronder hun eigen regel.
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
const kleur = licht ? 'text-inkt' : 'text-wit';
---
<a href={url('')} class={`flex items-center gap-3 no-underline ${kleur}`}>
  <svg viewBox="0 0 20 44" class="h-10 w-auto" aria-hidden="true">
    <circle cx="10" cy="7" r="6.2" fill="#c8101a" stroke="currentColor" stroke-width="1.2" />
    <path d="M3 17h14L3 27z" fill="currentColor" />
    <path d="M17 17v26H3V27z" fill="#c8101a" />
  </svg>
  <span class="flex flex-col">
    <span class="text-[1.55rem] font-extrabold leading-[.85] tracking-[.04em]">RIKE <span class="text-[.8rem] tracking-[.02em]">BV</span></span>
    <span class={`mt-1.5 text-[.72rem] font-bold leading-none tracking-[.06em] ${licht ? 'text-grijs' : 'text-as'}`}>INSTALLATIE EN ONDERHOUD</span>
  </span>
</a>
