---
import { site, url, icoon } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const home = url('');
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-papier/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={home} class="text-ink no-underline"><Logo /><span class="sr-only"> (naar de homepage)</span></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={`${home}#wegwijzer`} class="no-underline transition-colors hover:text-groen">Voor welk dier?</a></li>
          <li><a href={`${home}#kliniek`} class="no-underline transition-colors hover:text-groen">De kliniek</a></li>
          <li><a href={`${home}#team`} class="no-underline transition-colors hover:text-groen">Ons team</a></li>
          <li><a href={`${home}#contact`} class="no-underline transition-colors hover:text-groen">Tijden en route</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-groen !px-3.5 !py-2.5 whitespace-nowrap sm:!px-4"><Fragment set:html={icoon.tel} /><span class="hidden sm:inline num">{site.tel}</span><span class="sm:hidden">Bel</span></a>
    </div>
  </header>
) : (
  <footer class="donker bg-bos py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <span class="text-white"><Logo licht /></span>
        <p class="mt-5">{site.straat}, {site.postcode} {site.plaats}<br /><a href={site.telHref} class="num underline underline-offset-2">{site.tel}</a></p>
      </div>
      <p class="md:col-span-4">KvK <span class="num">{site.kvk}</span><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a><br />Op al onze behandelingen zijn de algemene voorwaarden van de KNMvD van toepassing.</p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a><br /><a href={site.dierengebit} rel="noopener" class="underline underline-offset-2">dierengebit.nl</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs text-white/75">Sfeerfoto's via Unsplash en foto's van de huidige website, ter illustratie. Bij oplevering vervangen we ze door nieuwe eigen foto's.</p>}
  </footer>
)}
