---
// Naar hun eigen logo: een zware groene W (in het origineel met kat, konijn en cavia erin) met daarnaast
// "DIERENKLINIEK WILHELMINAPARK" in kapitalen. Hier strakker nagetekend.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const groen = licht ? '#b7e0ad' : '#1d6b34';
---
<span class={`inline-flex items-center gap-2 sm:gap-2.5 ${cls}`}>
  <svg viewBox="0 0 40 30" class="h-7 w-9 flex-none sm:h-8 sm:w-[2.6rem]" aria-hidden="true">
    <path d="M0 1h8.2l3.6 16.8L16.2 1h7.6l4.4 16.8L31.8 1H40l-7.6 28h-7.6L20 11.2 15.2 29H7.6z" fill={groen} />
  </svg>
  <span class="flex flex-col font-display leading-none font-bold uppercase">
    <span class={`text-[0.6rem] tracking-[0.2em] sm:text-[0.66rem] ${licht ? 'text-white/80' : 'text-ink-soft'}`}>Dierenkliniek</span>
    <span class="mt-0.5 text-[0.95rem] tracking-[0.01em] sm:text-[1.2rem]">Wilhelminapark</span>
  </span>
</span>
