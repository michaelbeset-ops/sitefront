<script>
  // Wegwijzer als tabs; zonder JS blijven alle diersoorten gewoon onder elkaar staan.
  const lijst = document.querySelector<HTMLElement>('[data-tabs]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  if (lijst) {
    const tabs = Array.from(lijst.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panelen = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const kies = (i: number, focus = false, melden = true) => {
      tabs.forEach((t, j) => {
        const aan = i === j;
        t.setAttribute('aria-selected', String(aan));
        t.tabIndex = aan ? 0 : -1;
        panelen[j].hidden = !aan;
      });
      if (focus) tabs[i].focus();
      if (melden && status) status.textContent = `Adviezen voor: ${tabs[i].querySelector('span')?.firstChild?.textContent ?? ''}`;
    };
    lijst.hidden = false;
    kies(0, false, false);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => {
        kies(i);
        if (window.matchMedia('(max-width: 1023px)').matches) panelen[i].scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        let doel = -1;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') doel = (i + 1) % n;
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') doel = (i - 1 + n) % n;
        if (e.key === 'Home') doel = 0;
        if (e.key === 'End') doel = n - 1;
        if (doel >= 0) { e.preventDefault(); kies(doel, true); }
      });
    });
  }
</script>
