---
import { site, url, chips, mensen, waOfferte } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht"><Merk /></a>
      <p class="mt-6 max-w-xs">Straatmakersbedrijf uit Ridderkerk, sinds 1999. Bestratingen, riolering, grondwerk en siertuinen, ambachtelijk en machinaal.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-blauw" aria-label="Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
        <a href={`mailto:${site.mail}`} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-blauw" aria-label="E-mail"><Icoon naam="mail" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-2">
      <p class="font-kop font-bold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {chips.slice(0, 7).map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-lucht">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-kop font-bold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        {mensen.map((m) => <li><span class="block text-licht">{m.kort}</span><a href={m.href} class="num whitespace-nowrap no-underline transition-colors hover:text-lucht">{m.tel}</a></li>)}
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-lucht">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-words no-underline transition-colors hover:text-lucht">{site.mail}</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-kop font-bold text-licht">Bedrijfsgegevens</p>
      <ul class="mt-4 space-y-2">
        <li>{site.voluit}</li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li class="num">KvK {site.kvk}</li>
        <li><a href={site.maps} class="no-underline transition-colors hover:text-lucht">Bekijk op de kaart</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-lucht">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw Facebookpagina en uw huidige website, ter illustratie. Gegevens over de ondernemerspenning uit het Ridderkerks Dagblad (20 maart 2025).</p>}
  </div>
</footer>
