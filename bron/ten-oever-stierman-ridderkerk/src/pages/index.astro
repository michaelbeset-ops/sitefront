---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, chips, mensen, waOfferte } from '../data/site';
import kraan from '../assets/kraan.jpg';
import visgraat1 from '../assets/visgraat-1.jpg';
import visgraat2 from '../assets/visgraat-2.jpg';
import terras1 from '../assets/terras-1.jpg';
import terras2 from '../assets/terras-2.jpg';
import eigenaren from '../assets/eigenaren.jpg';
import oorkonde from '../assets/oorkonde.jpg';
import busBlauw from '../assets/bus-blauw.jpg';
import busKerst from '../assets/bus-kerst.jpg';
import a25 from '../assets/archief-25.jpg';
import a26 from '../assets/archief-26.jpg';
import a32 from '../assets/archief-32.jpg';
import a34 from '../assets/archief-34.jpg';
import a10 from '../assets/archief-10.jpg';
import a61 from '../assets/archief-61.jpg';

const diensten = [
  { t: 'Bestratingen', d: 'Klinkers, tegels en banden. Voor particulieren, VvE’s, makelaars en bedrijven.', i: 'stenen' },
  { t: 'Machinaal straten', d: 'Sinds 2007 met onze eigen kraan: straten, tegelen en banden zetten, volgens de arbo-voorwaarden.', i: 'kraan' },
  { t: 'Riolering', d: 'Wat onder de stenen zit, nemen we mee in hetzelfde werk. Eén partij voor onder en boven de grond.', i: 'buis' },
  { t: 'Grondwerk', d: 'Sinds 1999 gespecialiseerd in grond-, weg- en waterbouw. Met eigen shovel en minikraan.', i: 'schep' },
  { t: 'Siertuinen', d: 'Paden, cirkels en borders: ook bij particulieren maakten we mooie tuinen.', i: 'blad' },
  { t: 'Projecten', d: 'Bedrijfsterreinen, speeltuinen met rubbertegels en werk voor gemeentes, zelf aangenomen of als onderaannemer.', i: 'terrein' },
];

const stappen = [
  ['Bel of app', 'Vertel Ynze of Peter wat u wilt laten doen. Een foto van de situatie helpt al veel.'],
  ['Samen kijken', 'Waar nodig komen we langs om te meten en mee te denken over steen en verband.'],
  ['Offerte op maat', 'U krijgt een prijsopgave voor uw klus, zodat u vooraf weet waar u aan toe bent.'],
  ['Aan de slag', 'Met eigen bus, aanhanger en materieel. Ambachtelijk of machinaal, wat het werk vraagt.'],
];

const tijdlijn = [
  { jaar: '1999', t: 'Samen begonnen', d: 'Ynze ten Oever en Peter Stierman werkten allebei bij Aannemingsbedrijf LBS (later GMB) in Ridderkerk. Op 1 februari 1999 starten ze hun eigen straatmakersbedrijf.', fotos: [] },
  { jaar: '2005', t: 'Een hele woonwijk in Nieuw-Lekkerland', d: 'In 2005 en 2006 kreeg een complete woonwijk in Nieuw-Lekkerland nieuwe bestrating.', fotos: [{ src: a25, alt: 'Woonstraat in Nieuw-Lekkerland tijdens de herbestrating, februari 2006' }, { src: a26, alt: 'Stratenmakers aan het werk in een woonstraat in Nieuw-Lekkerland' }] },
  { jaar: '2007', t: 'Machinaal straten met eigen kraan', d: 'Sinds juli 2007 straten we ook machinaal. Tegelen en banden zetten kan er net zo goed mee. In hetzelfde jaar bestraatten we een dakterras in Ridderkerk.', fotos: [{ src: a32, alt: 'Kraan met legklem die een laag klinkers machinaal legt' }, { src: a34, alt: 'Machinaal straten met de kraan op een bouwplaats' }] },
  { jaar: '', t: 'Voor gemeentes en grote bouwbedrijven', d: 'Werk voor de gemeentes Ridderkerk, Papendrecht, Leidschenveen, Naaldwijk en Nieuw-Lekkerland, haventerreinen op de Maasvlakte en in Ridderkerk onder meer de Graaf Janstraat, Irenestraat en Nassaustraat.', fotos: [{ src: a10, alt: 'Banden zetten langs een nieuwe weg' }, { src: a61, alt: 'Speeltuin met groene rubbertegels en speeltoestellen' }] },
];
---
<Base title={`${site.voluit} | Bestrating in Ridderkerk`} description="Straatmakersbedrijf uit Ridderkerk, sinds 1999. Bestratingen, machinaal straten, riolering, grondwerk en siertuinen voor particulieren, VvE's, makelaars, aannemers en gemeentes.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: eigen foto van de kraan op de bouwplaats -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={kraan} alt="" widths={[640, 960, 1280, 1600, 2048]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[55%_60%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c122033_0%,#0c1220b8_45%,#0c1220f5_100%)] md:bg-[linear-gradient(90deg,#0c1220f2_0%,#0c1220c7_44%,#0c122026_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Straatmakersbedrijf in Ridderkerk</p>
          <h1 id="t-hero" class="mt-6 text-hero">Ambachtelijk en <span class="text-lucht">machinaal</span> bestraat.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Bestratingen, riolering, grondwerk en siertuinen. Al sinds 1999 voor particulieren, VvE’s, makelaars, aannemers en gemeentes.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="knop knop-blauw">Offerte aanvragen<Icoon naam="pijl" /></a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk ons werk</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><Icoon naam="penning" class="h-5 w-5 text-lucht" />Zilveren ondernemerspenning 2025</li>
            <li class="flex items-center gap-2"><Icoon naam="kraan" class="h-5 w-5 text-lucht" />Eigen kraan, shovel en minikraan</li>
            <li class="flex items-center gap-2"><Icoon naam="tel" class="h-5 w-5 text-lucht" /><a href={site.telHref} class="num font-semibold text-licht no-underline hover:text-lucht">{site.tel}</a></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto w-full max-w-[19rem] rounded-md bg-licht/10 p-2.5 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <Image src={visgraat2} alt="Gebakken klinkers in visgraatverband op een pad langs een woning" widths={[320, 640]} sizes="300px" loading="eager" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_60%]" />
            <figcaption class="flex items-center justify-between gap-3 px-2 pb-1 pt-3 text-sm">
              <span>Recent werk: klinkers in visgraatverband</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-sm border border-lijn bg-papier px-4 py-2 text-sm font-medium no-underline transition-colors hover:border-blauw hover:bg-blauw hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-[5.5rem]" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Onze diensten</p>
            <h2 id="t-dienst" class="mt-5 text-3xl">Van de grond eronder tot de laatste klinker.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Groot of klein, voor uw voortuin of een bedrijfsterrein: wij doen het werk zelf, met eigen mensen en materieel.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {diensten.map((d, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href="#offerte" data-klus={d.t} class="kaart dienst group relative flex h-full flex-col overflow-hidden p-6 no-underline transition-shadow duration-300 hover:shadow-md sm:p-7 lg:p-8">
                <span class="flex items-center gap-4 sm:block"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-md bg-blauw text-wit sm:h-14 sm:w-14"><Icoon naam={d.i} class="h-6 w-6 sm:h-7 sm:w-7" /></span>
                <h3 class="text-xl sm:mt-7">{d.t}</h3></span>
                <p class="mt-3 flex-1 text-grijs sm:mt-2.5">{d.d}</p>
                <span class="mt-5 inline-flex items-center gap-2 font-kop text-sm font-bold text-blauw">Offerte voor {d.t.toLowerCase()}<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
                <span class="visgraat-blauw absolute -right-6 -top-6 h-28 w-28 rotate-45 opacity-80" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Opgericht in Ridderkerk</dt><dd class="num order-first font-kop text-[clamp(2.5rem,3vw+1.4rem,3.5rem)] font-extrabold leading-none tracking-[-0.05em] text-blauw">1999</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Jaar onafgebroken in Ridderkerk</dt><dd class="num order-first font-kop text-[clamp(2.5rem,3vw+1.4rem,3.5rem)] font-extrabold leading-none tracking-[-0.05em]">25+</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Machinaal straten met eigen kraan</dt><dd class="num order-first font-kop text-[clamp(2.5rem,3vw+1.4rem,3.5rem)] font-extrabold leading-none tracking-[-0.05em]">2007</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Ingerichte bussen met aanhanger</dt><dd class="num order-first font-kop text-[clamp(2.5rem,3vw+1.4rem,3.5rem)] font-extrabold leading-none tracking-[-0.05em]">2</dd></div>
      </dl>
    </section>

    <!-- 5. Projecten -->
    <section id="projecten" class="donker bg-nacht py-24 text-licht lg:py-32" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-5 text-3xl">Strak gelegd, tot in de hoeken.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-licht-zacht">Een greep uit ons recente werk bij particulieren. Wilt u meer zien van wat we gemaakt hebben? Op verzoek sturen we u graag meer informatie.</p>
            <a href={site.facebook} class="knop knop-rand knop-klein mt-6"><Icoon naam="fb" />Volg ons op Facebook</a>
          </div>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:gap-4 lg:mt-14 lg:grid-cols-4 lg:grid-rows-[15.5rem_15.5rem]">
          <li class="rijs relative col-span-2 overflow-hidden rounded-md bg-nacht-2 lg:row-span-2">
            <Image src={visgraat1} alt="Lange oprit langs een woning, gestraat met grijs-zwarte klinkers in visgraatverband" widths={[600, 900, 1300]} sizes="(min-width: 1248px) 600px, (min-width: 1024px) 48vw, 92vw" class="tegel aspect-[4/5] h-full w-full object-cover object-[50%_55%] lg:aspect-auto" />
            <p class="label">Klinkers in visgraatverband</p>
          </li>
          <li class="rijs relative overflow-hidden rounded-md bg-nacht-2" style="--d:.06s">
            <Image src={terras2} alt="Nieuw terras van grote grijze tegels in een achtertuin met tuinhuis en haag" widths={[400, 640]} sizes="(min-width: 1248px) 290px, (min-width: 1024px) 24vw, 46vw" class="tegel aspect-square h-full w-full object-cover lg:aspect-auto object-[50%_60%]" />
            <p class="label">Terras van grote tegels</p>
          </li>
          <li class="rijs relative overflow-hidden rounded-md bg-nacht-2" style="--d:.12s">
            <Image src={terras1} alt="Grote grijze terrastegels strak gelegd langs de achtergevel van een woning" widths={[400, 640]} sizes="(min-width: 1248px) 290px, (min-width: 1024px) 24vw, 46vw" class="tegel aspect-square h-full w-full object-cover lg:aspect-auto object-[50%_55%]" />
            <p class="label">Strak langs de gevel</p>
          </li>
          <li class="rijs relative overflow-hidden rounded-md bg-nacht-2" style="--d:.06s">
            <Image src={visgraat2} alt="Pad van klinkers in visgraatverband tussen een woning en een haag" widths={[400, 640]} sizes="(min-width: 1248px) 290px, (min-width: 1024px) 24vw, 46vw" class="tegel aspect-square h-full w-full object-cover lg:aspect-auto object-[50%_45%]" />
            <p class="label">Pad naar de achtertuin</p>
          </li>
          <li class="rijs aspect-square lg:aspect-auto" style="--d:.12s">
            <a href="#sinds-1999" class="visgraat group flex h-full w-full flex-col justify-between rounded-md bg-blauw p-5 text-wit no-underline transition-colors hover:bg-blauw-diep sm:p-7">
              <span class="font-kop text-[clamp(2.25rem,3vw+1rem,3.25rem)] font-extrabold leading-none tracking-[-0.05em]">1999</span>
              <span class="flex items-end justify-between gap-3"><span class="font-kop text-base font-bold leading-snug sm:text-lg">Bekijk ons werk door de jaren heen</span><Icoon naam="pijl" class="h-6 w-6 shrink-0 transition-transform group-hover:translate-x-1" /></span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section class="py-20 lg:py-[5.5rem]" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo werken wij</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Korte lijnen, van eerste belletje tot laatste steen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">U heeft steeds dezelfde twee mensen aan de lijn: de eigenaren zelf.</p>
        </div>
        <ol class="mt-12 grid gap-3 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-0">
          {stappen.map(([t, d], i) => (
            <li class="rijs stap relative grid grid-cols-[3.25rem_1fr] gap-x-4 bg-wit p-6 shadow-sm outline outline-1 -outline-offset-1 outline-lijn sm:block lg:p-8" style={`--d:${i * 0.06}s`}>
              <p class="num row-span-2 font-kop text-[2.5rem] font-extrabold leading-none tracking-[-0.05em] text-blauw sm:text-[3.25rem]">0{i + 1}</p>
              <h3 class="text-xl sm:mt-6">{t}</h3>
              <p class="mt-2 text-grijs sm:mt-2.5">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-over">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-6">
          <figure class="relative overflow-hidden rounded-md">
            <Image src={eigenaren} alt="Ynze ten Oever en Peter Stierman met de oorkonde en de zilveren penning, samen met wethouder Henk van Os, voor hun bedrijfsbus" widths={[640, 1000]} sizes="(min-width: 1248px) 580px, (min-width: 1024px) 48vw, 92vw" class="aspect-[3/2] w-full object-cover object-[50%_35%]" />
            <figcaption class="absolute bottom-3 left-3 rounded-sm bg-blauw px-3 py-1.5 text-sm font-semibold text-wit">Uitreiking zilveren penning, maart 2025</figcaption>
          </figure>
          <div class="mt-3 grid grid-cols-2 gap-3">
            <Image src={busBlauw} alt="Lichtblauwe bedrijfsbus met de belettering Ambachtelijke en Machinale Bestratingen" widths={[400, 700]} sizes="(min-width: 1024px) 24vw, 46vw" class="aspect-[4/3] w-full rounded-md object-cover object-[50%_60%]" />
            <Image src={busKerst} alt="Grijze bedrijfsbus met kerstbelettering: Ten Oever en Stierman wensen iedereen fijne feestdagen" widths={[400, 700]} sizes="(min-width: 1024px) 24vw, 46vw" class="aspect-[4/3] w-full rounded-md object-cover object-[45%_50%]" />
          </div>
        </div>
        <div class="lg:col-span-6 lg:pt-2">
          <p class="eyebrow">Over ons</p>
          <h2 id="t-over" class="mt-5 text-3xl">Twee stratenmakers uit Ridderkerk.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Ynze ten Oever en Peter Stierman leerden het vak bij een Ridderkerks aannemingsbedrijf en begonnen in 1999 voor zichzelf. Jarenlang werkten ze voor grote bouwbedrijven en gemeentes, van nieuwbouwwijken tot haventerreinen op de Maasvlakte. Tegenwoordig werken ze steeds meer in en om Ridderkerk, voor particulieren, VvE’s, makelaars en aannemers.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="handdruk" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Twee vaste aanspreekpunten</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">U belt rechtstreeks met Ynze of Peter. Geen tussenpersonen.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="bus" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Alles in eigen beheer</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Twee ingerichte bussen met aanhangwagen, een kraan, shovel en minikraan, en een eigen bedrijfspand in Ridderkerk.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="terrein" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Van haventerrein tot achtertuin</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Wie een haventerrein strak krijgt, legt uw oprit of terras ook goed.</p></div>
            </li>
          </ul>
          <a href="#offerte" class="knop knop-blauw mt-9">Vraag een offerte aan<Icoon naam="pijl" /></a>
        </div>
      </div>
    </section>

    <!-- 8. Sinds 1999: tijdlijn met foto's van hun oude site -->
    <section id="sinds-1999" class="visgraat-blauw py-20 lg:py-[5.5rem]" aria-labelledby="t-tijd">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Sinds 1999</p>
            <h2 id="t-tijd" class="mt-5 text-3xl">Ruim 25 jaar straatwerk in de regio.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Uit ons archief: foto’s van projecten uit de beginjaren, gewoon zoals we ze toen maakten.</p>
        </div>
        <ol class="mt-12 border-t-2 border-inkt lg:mt-14">
          {tijdlijn.map((s, i) => (
            <li class="rijs grid gap-5 border-b border-lijn bg-papier/85 py-7 md:grid-cols-12 md:items-center md:gap-8 lg:py-8" style={`--d:${(i % 2) * 0.05}s`}>
              <p class="num font-kop text-[2.5rem] font-extrabold leading-none tracking-[-0.05em] text-blauw md:col-span-2 lg:text-[3rem]">{s.jaar || <span class="text-grijs/60" aria-label="Doorlopend">…</span>}</p>
              <div class={s.fotos.length ? 'md:col-span-5' : 'md:col-span-8'}>
                <h3 class="text-xl">{s.t}</h3>
                <p class="mt-2.5 text-grijs">{s.d}</p>
              </div>
              {s.fotos.length > 0 && (
                <div class="grid grid-cols-2 gap-3 md:col-span-5">
                  {s.fotos.map((f) => <Image src={f.src} alt={f.alt} class="aspect-[3/2] w-full rounded-sm object-cover" />)}
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 9. In het nieuws (geen tekstreviews online; wel deze erkenning) -->
    <section class="bg-steen py-20 lg:py-[5.5rem]" aria-labelledby="t-nieuws">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Erkenning</p>
          <h2 id="t-nieuws" class="mt-5 text-3xl">Erkend door de gemeente Ridderkerk.</h2>
          <p class="mt-6 text-lg text-grijs">Wethouder Henk van Os reikte op 12 maart 2025 de zilveren ondernemerspenning uit aan Ynze ten Oever en Peter Stierman. Die penning krijgen alleen bedrijven die langer dan 25 jaar onafgebroken in Ridderkerk gevestigd zijn.</p>
          <Image src={oorkonde} alt="Oorkonde van de gemeente Ridderkerk met de zilveren ondernemerspenning voor Ten Oever en Stierman V.O.F., gevestigd sinds 1 februari 1999" widths={[400, 700]} sizes="(min-width: 1024px) 400px, 92vw" class="mt-8 hidden aspect-[16/7] w-full max-w-md rounded-md object-cover object-[50%_42%] sm:block" />
        </div>
        <figure class="kaart relative overflow-hidden p-8 sm:p-10 lg:col-span-7 lg:p-12">
          <span class="visgraat-blauw absolute inset-y-0 right-0 w-1/3" aria-hidden="true"></span>
          <div class="relative">
            <p class="flex items-center gap-3 text-sm text-grijs"><span class="grid h-10 w-10 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="krant" class="h-5 w-5" /></span>Ridderkerks Dagblad, 20 maart 2025</p>
            <blockquote class="mt-8 font-kop text-[clamp(1.5rem,1.6vw+1rem,2.25rem)] font-bold leading-[1.2] tracking-[-0.025em]">“…de laatste jaren werken wij steeds meer in en om Ridderkerk…”</blockquote>
            <figcaption class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-lijn pt-6">
              <span><b class="block font-semibold">Ten Oever en Stierman</b><span class="text-sm text-grijs">in “Zilveren ondernemerspenning voor Ten Oever en Stierman”</span></span>
              <a href={site.artikel} class="knop knop-inkt knop-klein">Lees het artikel<Icoon naam="pijl" /></a>
            </figcaption>
          </div>
        </figure>
      </div>
    </section>

    <!-- 10. Contact + offertehulp -->
    <section id="contact" class="py-20 lg:py-[5.5rem]" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Contact</p>
          <h2 id="t-contact" class="mt-5 text-3xl">Laten we kijken wat er moet gebeuren.</h2>
          <p class="mt-6 text-lg text-grijs">Bel of app Ynze of Peter direct, of stel uw aanvraag samen met de offertehulp. Een foto van de situatie stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-3">
            {mensen.map((m, i) => (
              <li><a href={m.href} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class={`grid h-12 w-12 place-items-center rounded-md font-kop text-lg font-extrabold ${i === 0 ? 'bg-blauw text-wit' : 'bg-steen text-blauw'}`} aria-hidden="true">{m.kort[0]}</span><span class="flex-1"><b class="block font-semibold">{m.naam}</b><span class="num text-grijs">{m.tel}</span></span><Icoon naam="tel" class="h-5 w-5 text-blauw" /></a></li>
            ))}
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-steen text-blauw"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block text-grijs [overflow-wrap:anywhere]">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-blauw" /></a></li>
          </ul>
          <div class="mt-3 flex items-start gap-4 rounded-md bg-steen p-5">
            <Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-blauw" />
            <p><b class="font-semibold">{site.straat}<br />{site.postcode} {site.plaats}</b><br /><span class="text-grijs">Werkgebied: Ridderkerk en omgeving.</span> <a href={site.maps} class="link text-sm font-semibold">Kaart</a></p>
          </div>
        </div>

        <form id="offerte" class="kaart min-w-0 scroll-mt-28 p-6 sm:p-8 lg:col-span-7 lg:p-10" data-offerte aria-describedby="of-uitleg">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-2xl">Offerte aanvragen</h3>
            <span class="hidden rounded-sm bg-steen px-3 py-1 text-xs font-semibold text-grijs sm:inline">1 minuut</span>
          </div>
          <p id="of-uitleg" class="mt-2 text-grijs">Wij zetten uw antwoorden in een bericht. Er wordt niets verstuurd tot u dat zelf doet in WhatsApp of uw mailprogramma.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat moet er gebeuren?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Bestrating', 'Machinaal straten', 'Riolering', 'Grondwerk', 'Siertuin', 'Project of bedrijfsterrein'].map((b) => (
                <label class="keuze"><input type="checkbox" name="klus" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">U bent</span>
              <select name="wie" class="veld mt-2">
                <option>Particulier</option><option>VvE</option><option>Makelaar</option><option>Aannemer</option><option>Bedrijf</option><option>Gemeente</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Plaats van het werk</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld: Ridderkerk" /></label>
            <div class="sm:col-span-2">
              <div class="flex items-baseline justify-between gap-4"><label for="m2" class="text-sm font-semibold">Ongeveer hoeveel m²?</label><output for="m2" class="num font-kop text-lg font-extrabold text-blauw" data-m2-uit>40 m²</output></div>
              <input id="m2" name="m2" type="range" min="5" max="500" step="5" value="40" class="mt-3 w-full accent-[#0033a0]" />
              <label class="mt-2 flex items-center gap-2 text-sm text-grijs"><input type="checkbox" name="weetniet" class="h-4 w-4 accent-[#0033a0]" />Weet ik nog niet</label>
            </div>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: oude tegels eruit, nieuwe oprit in visgraatverband"></textarea></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Uw naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <button type="submit" class="knop knop-blauw"><Icoon naam="wa" />Verstuur via WhatsApp</button>
            <button type="button" class="knop knop-rand" data-mail><Icoon naam="mail" />Liever per e-mail</button>
          </div>
        </form>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="visgraat bg-blauw text-wit" aria-label="Offerte aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Iets te bestraten in en om Ridderkerk?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel Ynze of Peter, of vraag direct een offerte aan.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#offerte" class="knop knop-wit">Offerte aanvragen<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-rand op-foto num"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-offerte]');
  const r = f?.querySelector<HTMLInputElement>('input[name=m2]');
  const uit = f?.querySelector<HTMLOutputElement>('[data-m2-uit]');
  const wn = f?.querySelector<HTMLInputElement>('input[name=weetniet]');
  const toon = () => { if (r && uit) { uit.textContent = wn?.checked ? 'Weet ik nog niet' : `${r.value} m²`; r.disabled = !!wn?.checked; } };
  r?.addEventListener('input', toon); wn?.addEventListener('change', toon);

  // Dienstkaart aanklikken = die klus alvast aanvinken in de offertehulp.
  document.querySelectorAll<HTMLAnchorElement>('[data-klus]').forEach((a) => a.addEventListener('click', () => {
    const map: Record<string, string> = { Bestratingen: 'Bestrating', Siertuinen: 'Siertuin', Projecten: 'Project of bedrijfsterrein' };
    const v = map[a.dataset.klus || ''] || a.dataset.klus;
    const c = f?.querySelector<HTMLInputElement>(`input[name=klus][value="${v}"]`); if (c) c.checked = true;
  }));

  const bericht = () => {
    if (!f) return '';
    const d = new FormData(f);
    const v = (n: string) => String(d.get(n) || '').trim();
    const klussen = d.getAll('klus').map(String);
    const regels = ['Goedendag Ynze en Peter, ik wil graag een offerte aanvragen.'];
    if (klussen.length) regels.push('Werk: ' + klussen.join(', '));
    regels.push('Ik ben: ' + v('wie'));
    if (v('plaats')) regels.push('Plaats: ' + v('plaats'));
    regels.push('Oppervlakte: ' + (wn?.checked ? 'weet ik nog niet' : `ongeveer ${r?.value} m²`));
    if (v('wens')) regels.push('Toelichting: ' + v('wens'));
    if (v('naam')) regels.push('Groet, ' + v('naam'));
    return regels.join('\n');
  };
  f?.addEventListener('submit', (e) => { e.preventDefault(); window.open('https://wa.me/31622488572?text=' + encodeURIComponent(bericht()), '_blank', 'noopener'); });
  f?.querySelector('[data-mail]')?.addEventListener('click', () => { location.href = 'mailto:info@tenoeverenstierman.nl?subject=' + encodeURIComponent('Offerteaanvraag via de website') + '&body=' + encodeURIComponent(bericht()); });
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: .98; letter-spacing: -0.045em; }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel, li:hover > picture > .tegel { transform: scale(1.04); }
  .label { position: absolute; left: .75rem; bottom: .75rem; padding: .35rem .7rem; border-radius: 3px; background: #0c1220d9; color: #fff; font-size: .8125rem; font-weight: 600; backdrop-filter: blur(6px); }
  .stap + .stap { }
  @media (min-width: 1024px) { .stap:not(:first-child) { border-left: 0; } }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.6rem; padding: 0 1rem; border-radius: 3px; border: 1.5px solid #0c122026; background: #fff; font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s, border-color .2s; }
  .keuze span:hover { border-color: var(--color-blauw); }
  .keuze input:checked + span { background: var(--color-blauw); border-color: var(--color-blauw); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-blauw); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: 3px; border: 1.5px solid #0c122033; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #0c122066; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-blauw); }
  .veld::placeholder { color: #7a808b; }
  input[type=range]:disabled { opacity: .35; }
</style>
