---
// Woordmerk: "Hajdari" met de waterlijn eronder, zoals de bies op een gelakte romp.
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = true } = Astro.props;
---
<a href={url('')} class={`group inline-flex flex-col no-underline ${licht ? 'text-wit' : 'text-inkt'}`}>
  <span class="kop text-[1.6rem] font-bold leading-none tracking-[-.04em] md:text-[1.85rem]">Hajdari</span>
  <span class={`waterlijn mt-1.5 w-full ${licht ? 'waterlijn-licht' : ''}`} style="height:7px;background-size:100% 11px" aria-hidden="true"></span>
  <span class={`mt-1 text-[.7rem] font-medium leading-none tracking-[.02em] ${licht ? 'text-wit/80' : 'text-grijs'}`}>boot en polyester service</span>
</a>
