---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, grootCitaat, tijden, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import loods from '../assets/loods.jpg';
import spuiten from '../assets/spuiten.jpg';
import gaten from '../assets/gaten.jpg';
import vaarklaar from '../assets/vaarklaar.jpg';
import sjardonee from '../assets/sjardonee.jpg';
import avanti from '../assets/avanti.jpg';
import grete from '../assets/grete.jpg';
import rivier from '../assets/rivier.jpg';

const werk = [
  ['Schadeherstel', 'Gaten en beschadigingen herstellen en de boot weer strak afwerken.'],
  ['Lakwerk en schilderen', 'De romp of het hele schip in een nieuwe laklaag.'],
  ['Onderwaterschip', 'Schillen, behandelen en antifouling, klaar voor het seizoen.'],
  ['Polijsten en reinigen', 'Zodat de romp weer glanst.'],
  ['Polyester en gelcoat', 'Reparatie en spuitwerk aan polyester rompen.'],
  ['Jachtbouw', 'Ook daarvoor kun je bij ons terecht.'],
];
---
<Base title={`${site.naam} | Bootreparatie en polyesterwerk in Kerkdriel`} description="Schadeherstel, lakwerk, polijsten, onderwaterschip en polyesterwerk aan je boot. Hajdari Boot en Polyester Service, Paterstraat 7D in Kerkdriel.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: de boeg van onderaf, net uit de lak -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit">
      <Image src={hero} alt="Gelakte boeg van een motorjacht op de bok, van onderaf gezien tegen een blauwe lucht" widths={[640, 960, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_62%] md:object-[50%_45%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c172499_0%,#0c172400_28%,#0c172400_45%,#0c1724d9_88%)] md:bg-[linear-gradient(90deg,#0c1724e6_0%,#0c172499_38%,#0c172400_62%),linear-gradient(180deg,#0c172480_0%,#0c172400_25%)]" aria-hidden="true"></div>
      <div class="wrap pb-[9.5rem] pt-32 md:pb-20">
        <p class="text-[.97rem] font-medium text-wit/85">Boot- en polyesterservice in Kerkdriel</p>
        <h1 class="mt-4 max-w-[11ch] text-hero font-bold leading-[.92] tracking-[-.05em]">Weer strak in de lak.</h1>
        <p class="mt-7 max-w-md text-lg text-wit/90 md:text-xl">Schadeherstel, lakwerk, polijsten en polyesterwerk aan je boot. Sinds oktober vanaf de Paterstraat&nbsp;7D.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#schade" class="knop knop-wit">Schade doorgeven<Icoon naam="pijl" /></a>
          <a href={waMet('Hallo Hajdari, ik heb een vraag over mijn boot.')} class="knop knop-glas hidden sm:inline-flex"><Icoon naam="wa" />WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- 2. Werk: de loods en wat er gebeurt -->
    <section id="werk" class="py-24 md:py-28">
      <div class="wrap grid gap-y-14 md:grid-cols-12 md:gap-x-10">
        <div class="relative md:col-span-6 lg:col-span-5">
          <Image src={loods} alt="Marineblauw gelakte romp met rode bies in de loods, een medewerker met verf op de voorgrond" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 34vw, (min-width: 768px) 46vw, 100vw" class="rijs aspect-[3/4] w-full rounded-sm object-cover object-[55%_50%]" />
          <figure class="rijs absolute -bottom-10 right-4 w-[42%] max-w-[13rem] md:-right-10" style="--d:.15s">
            <Image src={spuiten} alt="Medewerker spuit de binnenkant van een polyester romp" widths={[300, 512]} sizes="13rem" class="aspect-[4/5] w-full rounded-sm object-cover shadow-[0_18px_40px_-18px_#0c172480] ring-4 ring-romp" />
            <figcaption class="mt-2 text-xs text-grijs">Romp Excellent 1000 in de maak.</figcaption>
          </figure>
        </div>
        <div class="md:col-span-6 md:col-start-7 lg:col-span-6 lg:col-start-7 md:pt-6">
          <h2 class="rijs text-3xl">Reparatie, onderhoud, lakwerk, renovatie.</h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs" style="--d:.1s">Van gaten en beschadigingen tot een boot die van top tot teen opnieuw in de lak gaat.</p>
          <dl class="mt-12 border-t border-lijn-licht">
            {werk.map(([t, z], i) => (
              <div class="rijs grid gap-1 border-b border-lijn-licht py-5 sm:grid-cols-[13rem_1fr] sm:gap-6" style={`--d:${0.05 * i}s`}>
                <dt class="kop text-lg font-semibold tracking-[-.02em]">{t}</dt>
                <dd class="text-grijs">{z}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <span class="waterlijn wrap !px-0" aria-hidden="true"></span>

    <!-- 3. Logboek: recent werk, in hun eigen woorden -->
    <section id="logboek" class="py-24 md:py-28">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs text-4xl">Logboek 2026</h2>
          <p class="rijs text-sm text-grijs">Uit de loods, zoals gepost op <a href={site.facebook} class="link">Facebook</a> en <a href={site.instagram} class="link">Instagram</a>.</p>
        </div>

        <article class="mt-16 grid gap-y-8 border-t-2 border-inkt pt-8 md:grid-cols-12 md:gap-x-10">
          <p class="kop num rijs text-3xl font-semibold tracking-[-.04em] text-marine md:col-span-2">15.08</p>
          <div class="rijs md:col-span-4">
            <h3 class="text-2xl">Van gatenkaas naar vaarklaar</h3>
            <p class="mt-4 text-grijs">“Deze boot kwam bij ons binnen met de nodige gaten en beschadigingen. Tja… varen is leuk, maar een ongelukje zit in een klein hoekje.”</p>
            <p class="mt-3 text-grijs">“Wij hebben de schade vakkundig aangepakt, alles netjes hersteld en de boot weer strak afgewerkt.”</p>
          </div>
          <div class="grid grid-cols-2 gap-3 md:col-span-6">
            <figure class="rijs"><Image src={gaten} alt="Beschadigingen en gaten in een witte romp" widths={[300, 590]} sizes="(min-width: 768px) 24vw, 46vw" class="aspect-[4/3] w-full rounded-sm object-cover" /><figcaption class="mt-2 text-xs text-grijs">Binnengekomen</figcaption></figure>
            <figure class="rijs" style="--d:.1s"><Image src={vaarklaar} alt="Dezelfde witte boot hersteld in de loods" widths={[300, 590]} sizes="(min-width: 768px) 24vw, 46vw" class="aspect-[4/3] w-full rounded-sm object-cover" /><figcaption class="mt-2 text-xs text-grijs">Weer netjes</figcaption></figure>
          </div>
        </article>

        <article class="mt-16 grid gap-y-8 border-t border-lijn-licht pt-8 md:grid-cols-12 md:gap-x-10">
          <p class="kop num rijs text-3xl font-semibold tracking-[-.04em] text-marine md:col-span-2">03.07</p>
          <figure class="rijs md:order-last md:col-span-6"><Image src={sjardonee} alt="Motorjacht Sjardonee met nieuwe laklaag in de botenlift" widths={[400, 590]} sizes="(min-width: 768px) 46vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" /></figure>
          <div class="rijs md:col-span-4">
            <h3 class="text-2xl">Sjardonee straalt weer</h3>
            <p class="mt-4 text-grijs">“Met trots hebben wij dit prachtige schip voorzien van een frisse nieuwe laklaag. Klaar voor vele mooie vaarseizoenen!”</p>
          </div>
        </article>

        <article class="mt-16 grid gap-y-8 border-t border-lijn-licht pt-8 md:grid-cols-12 md:gap-x-10">
          <p class="kop num rijs text-3xl font-semibold tracking-[-.04em] text-marine md:col-span-2">22.05</p>
          <div class="rijs md:col-span-4">
            <h3 class="text-2xl">Avanti te water</h3>
            <p class="mt-4 text-grijs">“Zowel onderwaterschip behandeld als de romp weer vers in de lak, klaar voor de zomer dus!”</p>
          </div>
          <figure class="rijs md:col-span-6"><Image src={avanti} alt="Witte sportboot weer te water" widths={[400, 590]} sizes="(min-width: 768px) 46vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" /></figure>
        </article>
      </div>
    </section>

    <!-- 4. Wow: schade doorgeven op de rompschets -->
    <section id="schade" class="bg-inkt py-24 text-wit md:py-36">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 class="rijs text-4xl">Waar zit het?</h2>
          <p class="rijs mt-6 max-w-md text-lg text-staal" style="--d:.1s">Tik op de boot aan waar het om gaat en zet je boot erbij. WhatsApp opent met je bericht klaar; een foto stuur je daar mee.</p>
          <div class="rijs mt-12 hidden max-w-sm rounded-md border border-lijn bg-inkt-2 p-5 lg:block" style="--d:.2s">
            <p class="text-xs font-semibold text-staal">Je bericht</p>
            <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-wit/90" data-voorbeeld aria-live="polite"></p>
          </div>
        </div>
        <form id="schadeform" class="rijs lg:col-span-7" style="--d:.1s" onsubmit="return false">
          <fieldset>
            <legend class="sr-only">Plek op de boot</legend>
            <svg class="romp w-full" viewBox="0 0 640 272" role="group" aria-label="Schets van een boot, kies een of meer plekken">
              <line class="wl" x1="0" y1="186" x2="640" y2="186" />
              <path class="z" data-zone="Bovenschip en kuip" role="checkbox" aria-checked="false" tabindex="0" aria-label="Bovenschip en kuip" d="M160 112 L186 62 L392 58 L466 98 Z" />
              <path class="z" data-zone="Stootrand" role="checkbox" aria-checked="false" tabindex="0" aria-label="Stootrand" d="M44 122 L602 92 L604 104 L46 134 Z" />
              <path class="z" data-zone="Romp" role="checkbox" aria-checked="false" tabindex="0" aria-label="Romp boven water" d="M46 134 L604 104 Q592 146 566 176 L58 176 Z" />
              <path class="z" data-zone="Waterlijn" role="checkbox" aria-checked="false" tabindex="0" aria-label="Waterlijn" d="M58 176 L566 176 Q561 184 554 192 L62 192 Z" />
              <path class="z" data-zone="Onderwaterschip" role="checkbox" aria-checked="false" tabindex="0" aria-label="Onderwaterschip" d="M62 192 L554 192 Q520 228 452 240 L132 240 Q80 234 66 214 Z" />
              <path class="lijn" d="M210 70 L380 67 M206 80 L250 79 M262 79 L310 78 M322 78 L370 77" />
              <text class="lbl" data-lbl="Bovenschip en kuip" x="232" y="44">Bovenschip</text>
              <text class="lbl" data-lbl="Stootrand" x="478" y="78">Stootrand</text>
              <text class="lbl" data-lbl="Romp" x="250" y="162">Romp</text>
              <text class="lbl" data-lbl="Waterlijn" x="636" y="264" text-anchor="end">Waterlijn</text>
              <text class="lbl" data-lbl="Onderwaterschip" x="232" y="226">Onderwaterschip</text>
            </svg>
          </fieldset>
          <p class="mt-3 min-h-[1.5rem] text-sm text-staal" data-gekozen aria-live="polite">Nog niets aangetikt.</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="boot" class="veld-label">Je boot</label>
              <input id="boot" name="boot" class="veld" placeholder="Merk, type of lengte" autocomplete="off" />
            </div>
            <div>
              <label for="wat" class="veld-label">Wat moet er gebeuren?</label>
              <select id="wat" name="wat" class="veld">
                <option>Schade herstellen</option>
                <option>Lakwerk of schilderen</option>
                <option>Onderwaterschip behandelen</option>
                <option>Polijsten en reinigen</option>
                <option>Polyester- of gelcoatwerk</option>
                <option>Iets anders</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="toel" class="veld-label">Toelichting <span class="font-normal">(mag kort)</span></label>
              <textarea id="toel" name="toel" class="veld" placeholder="Bijvoorbeeld: kras over de stuurboordzijde, boot ligt in Kerkdriel"></textarea>
            </div>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waMet('Hallo Hajdari, ik wil graag iets aan mijn boot laten doen.')} class="knop knop-wit" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <a href={site.telHref} class="num text-sm font-semibold text-staal no-underline hover:text-wit">of bel {site.tel}</a>
          </div>
        </form>
      </div>
    </section>

    <!-- 5. Ervaringen -->
    <section id="ervaringen" class="py-24 md:py-28">
      <div class="wrap grid gap-y-14 md:grid-cols-12 md:gap-x-10">
        <figure class="rijs md:col-span-5">
          <Image src={grete} alt="Marineblauw gelakt motorjacht Grete op de werf in de zon" widths={[480, 900, 1300]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[62%_50%]" />
        </figure>
        <div class="md:col-span-7 md:pt-4">
          <blockquote class="rijs">
            <p class="kop text-2xl font-medium leading-[1.3] tracking-[-.025em]">“{grootCitaat.tekst}”</p>
            <footer class="mt-6 text-sm text-grijs">{grootCitaat.naam}, Google review</footer>
          </blockquote>
          <div class="mt-14 grid gap-x-10 gap-y-10 border-t border-lijn-licht pt-10 sm:grid-cols-2">
            {reviews.map((r, i) => (
              <blockquote class="rijs" style={`--d:${0.06 * i}s`}>
                <p class="text-grijs">“{r.tekst}”</p>
                <footer class="mt-3 text-sm font-semibold">{r.naam}</footer>
              </blockquote>
            ))}
          </div>
          <p class="rijs mt-12 text-sm text-grijs"><a href={site.reviews} class="link">{site.google.score} op Google, {site.google.aantal} reviews</a></p>
        </div>
      </div>
    </section>

    <!-- 6. Nieuwe thuishaven: adres, tijden, contact -->
    <section id="contact" class="bg-inkt text-wit">
      <div class="relative isolate flex min-h-[60svh] items-end overflow-hidden md:min-h-[72vh]">
        <Image src={rivier} alt="Motorjacht vaart in de avondzon over de rivier" widths={[640, 1100, 1600, 2000]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_45%]" />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c172400_35%,#0c1724f2_100%)]" aria-hidden="true"></div>
        <div class="wrap pb-14 pt-40">
          <h2 class="rijs text-4xl">Nieuwe thuishaven.</h2>
          <p class="rijs mt-5 max-w-lg text-lg text-wit/90" style="--d:.1s">“Een nieuwe plek, maar dezelfde vertrouwde service, vakmanschap en passie voor boten!”</p>
        </div>
      </div>
      <span class="waterlijn waterlijn-licht wrap !px-0 opacity-70" aria-hidden="true"></span>
      <div class="wrap grid gap-y-14 py-20 md:grid-cols-12 md:gap-x-10 md:py-28">
        <div class="md:col-span-6">
          <address class="rijs not-italic">
            <p class="kop text-3xl font-semibold leading-tight tracking-[-.03em]">{site.straat}<br />{site.postcode}</p>
          </address>
          <p class="rijs mt-5 max-w-sm text-staal" style="--d:.1s">Bel of app even voordat je langskomt.</p>
          <div class="rijs mt-9 flex flex-wrap gap-3" style="--d:.15s">
            <a href={waMet('Hallo Hajdari, ik wil graag een keer langskomen met mijn boot.')} class="knop knop-wit"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-glas num"><Icoon naam="tel" />{site.tel}</a>
            <a href={site.route} class="knop knop-glas"><Icoon naam="pin" />Route</a>
          </div>
          <p class="mt-6 text-sm text-staal"><a href={`mailto:${site.mail}`} class="link link-licht break-all">{site.mail}</a></p>
        </div>
        <div class="rijs md:col-span-5 md:col-start-8" style="--d:.1s">
          <div class="flex items-baseline justify-between border-b-2 border-wit/80 pb-3">
            <p class="kop text-xl font-semibold">Openingstijden</p>
            <p class="text-sm font-semibold" data-status></p>
          </div>
          <table class="num w-full text-[1rem]">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map((t) => (
                <tr class="border-b border-lijn" data-dag={t.dag} data-van={t.van} data-tot={t.tot}>
                  <th scope="row" class="py-3 text-left font-medium text-staal">{t.naam}</th>
                  <td class="py-3 text-right text-staal">{t.van ? `${t.van} tot ${t.tot}` : 'gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <Voet />

  <script>
    import { waMet } from '../data/site';
    // Openingstijden: vandaag markeren + nu open/gesloten
    const nu = new Date();
    const min = nu.getHours() * 60 + nu.getMinutes();
    const m = (s: string) => { const [h, mm] = s.split(':').map(Number); return h * 60 + mm; };
    document.querySelectorAll<HTMLTableRowElement>('tr[data-dag]').forEach((tr) => {
      if (Number(tr.dataset.dag) !== nu.getDay()) return;
      tr.querySelectorAll('th, td').forEach((c) => { c.classList.remove('text-staal'); c.classList.add('text-wit', 'font-semibold'); });
      tr.querySelector('th')?.insertAdjacentHTML('beforeend', ' <span class="ml-1 text-xs font-semibold text-marine-licht">vandaag</span>');
      const st = document.querySelector('[data-status]');
      if (st) { const open = !!tr.dataset.van && min >= m(tr.dataset.van) && min < m(tr.dataset.tot || '0:0'); st.textContent = open ? 'Nu open' : 'Nu gesloten'; st.className = `text-sm font-semibold ${open ? 'text-marine-licht' : 'text-staal'}`; }
    });

    // Rompschets -> WhatsApp
    const f = document.querySelector<HTMLFormElement>('#schadeform');
    if (f) {
      const zones = [...f.querySelectorAll<SVGPathElement>('.z')];
      const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const gekozen = f.querySelector<HTMLElement>('[data-gekozen]')!;
      const voorbeeld = document.querySelector<HTMLElement>('[data-voorbeeld]');
      const bericht = () => {
        const plek = zones.filter((z) => z.classList.contains('aan')).map((z) => z.dataset.zone || '');
        const boot = (f.querySelector<HTMLInputElement>('#boot')!.value || '').trim();
        const wat = f.querySelector<HTMLSelectElement>('#wat')!.value;
        const toel = (f.querySelector<HTMLTextAreaElement>('#toel')!.value || '').trim();
        gekozen.textContent = plek.length ? `Gekozen: ${plek.join(', ')}` : 'Nog niets aangetikt.';
        f.querySelectorAll<SVGTextElement>('[data-lbl]').forEach((t) => t.classList.toggle('aan', plek.includes(t.dataset.lbl || '')));
        const r = ['Hallo Hajdari, ik wil graag iets aan mijn boot laten doen.', `Wat: ${wat}`];
        if (plek.length) r.push(`Plek: ${plek.join(', ')}`);
        if (boot) r.push(`Boot: ${boot}`);
        if (toel) r.push(`Toelichting: ${toel}`);
        r.push('Ik stuur een foto mee.');
        stuur.href = waMet(r.join('\n'));
        if (voorbeeld) voorbeeld.textContent = r.join('\n');
      };
      const wissel = (z: SVGPathElement) => { const aan = !z.classList.contains('aan'); z.classList.toggle('aan', aan); z.setAttribute('aria-checked', String(aan)); bericht(); };
      zones.forEach((z) => {
        z.addEventListener('click', () => wissel(z));
        z.addEventListener('keydown', (e) => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); wissel(z); } });
      });
      f.addEventListener('input', bericht);
      f.addEventListener('change', bericht);
      bericht();
    }
  </script>
</Base>
