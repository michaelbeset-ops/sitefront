---
// Woordmerk: geen eigen logo gevonden. STAAL en HOUT gestapeld, verbonden door een menie hoekprofiel (L-staal).
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['group inline-flex items-center gap-3 no-underline', licht ? 'text-wit' : 'text-inkt', cls]} aria-label="Staal en Hout, naar de homepage">
  <svg viewBox="0 0 40 40" class="h-10 w-10 flex-none" aria-hidden="true">
    <path d="M4 4h7v25h25v7H4Z" fill="#b0441d" />
    <path d="M15 4h21v21H15Z" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M19 10.5c4 1.6 9 1.6 13 0M19 16c4 1.6 9 1.6 13 0M19 21c3 1 6 1 9 0" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" class="transition-transform duration-500 group-hover:translate-x-px" />
  </svg>
  <span class="kop whitespace-nowrap pt-1.5 text-[1.375rem] uppercase leading-none tracking-[.05em]">Staal <span class:list={['mx-0.5 text-[.72em] font-semibold normal-case tracking-normal', licht ? 'text-menie-licht' : 'text-menie-donker']}>en</span> Hout</span>
</a>
