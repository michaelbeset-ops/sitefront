---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="raster-donker bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk licht />
      <p class="mt-6 max-w-xs">Klussen, onderhoud en advies in staal en hout. Vanuit {site.plaats}.</p>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3">{site.contact}</p>
      <p class="mt-1"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-4">{site.plaats}</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Op deze pagina</p>
      <ul class="mt-3 space-y-1">
        <li><a href={url('#werk')} class="link link-licht no-underline hover:underline">Staal en hout</a></li>
        <li><a href={url('#ponton')} class="link link-licht no-underline hover:underline">Het ponton</a></li>
        <li><a href={url('#aanvraag')} class="link link-licht no-underline hover:underline">Aanvraag</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Projectfoto's: LinkedIn-bericht van Lodewikus (april 2026) over het ponton voor Jachthaven Biesbosch. Werkplaatsbeelden zijn sfeerfoto's van Unsplash, niet van Staal en Hout.</p>}
</footer>
