---
// Nagetekend naar hun gevelbord (eigen foto op Google, sep 2023): zwart bord, witte kapitalen "ROOS JUWELIER"
// met de Arabische naam مجوهرات روز erboven.
import { url, site } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url("")} class={`inline-flex flex-col items-start no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class="ar text-[1.05rem] leading-none opacity-90 sm:text-[1.2rem]" lang="ar" aria-hidden="true">{site.arabisch}</span>
  <span class="mt-1.5 font-kop text-[1.3rem] font-extrabold uppercase leading-none tracking-[.02em] sm:text-[1.45rem]">Roos Juwelier<span class="sr-only">, naar de homepage</span></span>
</a>
