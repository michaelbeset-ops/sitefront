---
import { site, url, waHoi, dagen } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const collectie = ['Kettingen en sets', 'Armbanden', 'Oorbellen', 'Ringen', 'Hangers', 'Naamkettingen'];
const volgorde = [1, 2, 3, 4, 5, 6, 0];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.95rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Juwelier aan de Zwart Janstraat in {site.wijk}. Inkoop, verkoop en reparaties van goud.</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href={waHoi} class="knop knop-merk min-h-11 px-5"><Icoon naam="wa" />WhatsApp</a>
        <a href={site.insta} class="grid h-11 w-11 place-items-center rounded-[4px] border border-lijn text-wit transition-colors hover:border-wit" aria-label="Roos Juwelier op Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
        <a href={site.tiktok} class="grid h-11 w-11 place-items-center rounded-[4px] border border-lijn text-wit transition-colors hover:border-wit" aria-label="Roos Juwelier op TikTok"><Icoon naam="tiktok" class="h-5 w-5" /></a>
      </div>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Collectie</p>
      <ul class="mt-5 space-y-2">
        {collectie.map((t) => <li><a href={h('collectie')} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2">
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a> <span class="text-mist/80">(ook WhatsApp)</span></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.route} class="no-underline hover:text-merk-licht">Route plannen</a></li>
        <li><a href={site.insta} class="no-underline hover:text-merk-licht">@roosjuwelier</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Openingstijden</p>
      <ul class="num mt-5 space-y-1.5">
        {volgorde.map((d) => { const t = site.tijden[d]; return <li class="flex justify-between gap-6"><span>{dagen[d]}</span><span class={t ? 'text-wit' : ''}>{t ? `${t[0]}:00 tot ${t[1]}:00` : 'Gesloten'}</span></li>; })}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam} · {site.straat}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs">Foto's van jullie Google-profiel en Instagram (@roosjuwelier). Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 12 oktober 2026).</p>}
  <div class="h-14 md:hidden" aria-hidden="true"></div>
</footer>
