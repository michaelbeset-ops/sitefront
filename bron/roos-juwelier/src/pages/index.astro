---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, dagen, waHoi, waMet } from '../data/site';

// Beeld: Google-profiel van Roos Juwelier (eigen foto's en foto's van klanten), Instagram @roosjuwelier en
// één Unsplash-sfeerfoto. Zie src/assets/BRONNEN.txt.
import hero from '../assets/hero.jpg';
import cSet from '../assets/c-set.jpg';
import cArmband from '../assets/c-armband.jpg';
import cOorbel from '../assets/c-oorbel.jpg';
import cRing from '../assets/c-ring.jpg';
import cHanger from '../assets/c-hanger.jpg';
import cNaam from '../assets/c-naam.jpg';
import winkel from '../assets/winkel.jpg';
import vitrine from '../assets/vitrine.jpg';
import sReparatie from '../assets/s-reparatie.jpg';
import ig01 from '../assets/ig01.jpg';
import ig02 from '../assets/ig02.jpg';
import ig03 from '../assets/ig03.jpg';
import ig05 from '../assets/ig05.jpg';
import ig06 from '../assets/ig06.jpg';
import ig07 from '../assets/ig07.jpg';
import ig08 from '../assets/ig08.jpg';
import ig10 from '../assets/ig10.jpg';

const vraag = (wat: string) => waMet(`Hallo Roos Juwelier, ik ben op zoek naar ${wat}. Hebben jullie iets voor mij?`);

// Collectie: soorten zoals op hun Google-foto's en Instagram te zien zijn.
const collectie = [
  { t: 'Kettingen en sets', d: 'Ketting met bijpassende oorbellen, zoals op de bustes in de winkel.', src: cSet, alt: 'Gouden ketting met bijpassende oorbellen op een zwarte buste', bron: 'Google, klantfoto', wa: 'een ketting of set' },
  { t: 'Armbanden', d: 'Schakelarmbanden, bangles en fijne armbandjes, rijen vol in de vitrine.', src: cArmband, alt: 'Rijen gouden armbanden in de vitrine', bron: 'Google, klantfoto', wa: 'een armband' },
  { t: 'Oorbellen', d: 'Van kleine knopjes tot lange hangers, per paar op de plateaus.', src: cOorbel, alt: 'Plateaus met gouden oorbellen in allerlei vormen', bron: 'Google, klantfoto', wa: 'oorbellen' },
  { t: 'Ringen', d: 'Gouden ringen met fijn bewerkte bladmotieven, en veel meer in de vitrine.', src: cRing, alt: 'Drie gouden ringen met opengewerkte bladmotieven', bron: 'Eigen foto, Google', wa: 'een ring' },
  { t: 'Hangers', d: 'Een hanger aan een fijne ketting, in een rood doosje.', src: cHanger, alt: 'Gouden hanger van moeder met kind aan een ketting, in een rood doosje', bron: 'Google, klantfoto', wa: 'een hanger' },
  { t: 'Naamkettingen', d: 'Een naam in goud. Een klant liet deze maken en deelde de foto op Google.', src: cNaam, alt: 'Gouden naamketting met een naam in Arabisch schrift', bron: 'Google, klantfoto', wa: 'een naamketting' },
];
const ook = ['Trouwringen', 'Kinderarmbandjes', 'Handsieraden', 'Syrisch goud', 'Iraaks goud', 'Goud uit de Golf', 'Turks goud'];

const stappen = [
  ['Kijk rond', 'Op Instagram laten we geregeld nieuwe stukken zien. Zie je iets moois? Bewaar de foto.'],
  ['Vraag het na', 'Stuur de foto of je wens via WhatsApp, of bel. Dan hoor je of het er is.'],
  ['Kom kijken', 'De winkel is open van 12:00 tot 18:00, alleen woensdag dicht.'],
  ['Passen en meenemen', 'Pas het in de winkel. Moet een armband korter, vraag het gerust.'],
];

// Wow: kies een stuk van hun Instagram (omslagbeelden van hun posts, met datum).
const igStukken = [
  { id: 'ig01', src: ig01, t: 'Ring in rood doosje', datum: '27 september 2026' },
  { id: 'ig02', src: ig02, t: 'Bangles', datum: '22 september 2026' },
  { id: 'ig03', src: ig03, t: 'Set: ketting en oorbellen', datum: '12 september 2026' },
  { id: 'ig05', src: ig05, t: 'Kinderarmbandje', datum: '20 augustus 2026' },
  { id: 'ig06', src: ig06, t: 'Armband', datum: '18 augustus 2026' },
  { id: 'ig07', src: ig07, t: 'Set met lange ketting', datum: '12 augustus 2026' },
  { id: 'ig08', src: ig08, t: 'Handsieraad', datum: '11 augustus 2026' },
  { id: 'ig10', src: ig10, t: 'Ring met bloem', datum: '25 juni 2026' },
];
const soorten = ['een ketting', 'een set', 'een armband', 'oorbellen', 'een ring', 'trouwringen', 'een hanger', 'een naamketting', 'een kinderarmbandje'];
const stijlen = ['Syrische stijl', 'Iraakse stijl', 'Golfstijl', 'Turkse stijl', 'elke stijl'];
const voor = ['voor mezelf', 'als cadeau', 'voor een bruiloft', 'voor een verloving', 'voor een kind'];
const sterren = [1, 2, 3, 4, 5];
const volgorde = [1, 2, 3, 4, 5, 6, 0];
const igKlein = Object.fromEntries(await Promise.all(igStukken.map(async (s) => [s.id, (await getImage({ src: s.src, width: 240, quality: 74 })).src])));
---
<Base title="Roos Juwelier | Gouden sieraden in Rotterdam-Noord, Zwart Janstraat" description="Roos Juwelier (مجوهرات روز) aan de Zwart Janstraat in Rotterdam: inkoop, verkoop en reparaties van goud. Gouden sieraden in Syrische, Iraakse, Turkse en Golfstijl. Open 12:00 tot 18:00, woensdag gesloten.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: de winkel van binnen (klantfoto Google, nov 2025), met donker verloop -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={hero} alt="" widths={[640, 960, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" quality={66} class="absolute inset-0 -z-20 h-full w-full object-cover object-[64%_40%] md:object-[60%_45%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#121011c7_0%,#12101166_30%,#121011d9_62%,#121011fa_100%)] md:bg-[linear-gradient(90deg,#121011f5_0%,#121011cc_38%,#12101147_70%,#12101126_100%),linear-gradient(180deg,#121011b3_0%,#12101100_30%,#12101100_68%,#121011d1_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-24 pt-36 md:pb-20 lg:pt-48">
        <div class="max-w-3xl">
          <p class="eyebrow eyebrow-licht">Juwelier in {site.wijk}</p>
          <h1 id="inhoud" class="mt-6 text-hero">Inkoop, verkoop en reparatie van <span class="text-merk-licht">goud</span>.</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-wit/90 md:text-[1.3rem]">Gouden sieraden in Syrische, Iraakse, Turkse en Golfstijl. Kom kijken aan de Zwart Janstraat, of vraag via WhatsApp of het er is.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#zoeken" class="knop knop-merk">Sieraad zoeken<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.95rem] text-wit/90">
            <li class="flex items-center gap-2"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-wit">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-merk-licht" /><span data-status>Open 12:00 tot 18:00, woensdag gesloten</span></li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-7 right-10 hidden text-xs text-wit/60 lg:block">De winkel aan de Zwart Janstraat (foto: Google)</p>
    </section>
  </div>

  <main>
    <!-- 2. Het gevelbord: hun eigen tekst in twee schriften -->
    <section class="border-t border-lijn bg-inkt text-wit" aria-label="Van ons gevelbord">
      <div class="wrap grid items-center gap-x-10 gap-y-4 py-9 md:grid-cols-2 md:py-11">
        <p class="font-kop text-[clamp(1.35rem,1.4vw+1rem,2rem)] font-extrabold leading-tight tracking-[-.03em]">Inkoop, Verkoop en Reparaties van Goud</p>
        <p class="ar text-[clamp(1.2rem,1.2vw+.9rem,1.75rem)] leading-[1.7] text-wit/85 md:text-right" lang="ar">بيع وشراء المصوغات الذهبية<br />سوري - عراقي - خليجي - تركي</p>
      </div>
    </section>

    <!-- 3. Cijfers: alleen echte cijfers (Google, eigen tijden, Instagram) -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-x-6 gap-y-9 py-11 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-steen">op Google, uit {site.google.aantal} reviews</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-extrabold leading-none tracking-[-.05em] text-merk">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">dagen per week open, alleen woensdag dicht</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-extrabold leading-none tracking-[-.05em]">6</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">elke openingsdag, van middag tot zes uur</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-extrabold leading-none tracking-[-.05em]">12 tot 18</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">stijlen goud: Syrisch, Iraaks, Golf en Turks</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-extrabold leading-none tracking-[-.05em]">4</dd></div>
      </dl>
    </section>

    <!-- 4. Collectie: fotokaarten met foto's van hun Google-profiel -->
    <section id="collectie" class="py-24 md:py-32" aria-labelledby="t-coll">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Collectie</p>
            <h2 id="t-coll" class="mt-5 text-4xl">Een vitrine vol <span class="text-merk">goud</span>.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Kettingen op bustes, plateaus vol oorbellen en ringen. Dit is een greep; in de winkel ligt veel meer.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {collectie.map((c, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden transition-shadow duration-300 hover:shadow-[0_12px_32px_#12101117]">
                <div class="relative overflow-hidden">
                  <Image src={c.src} alt={c.alt} widths={[420, 640, 820]} sizes="(min-width: 1024px) 400px, (min-width: 768px) 46vw, 100vw" quality={72} class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                  <span class="absolute bottom-3 left-3 rounded-[3px] bg-inkt/80 px-2 py-1 text-xs font-medium text-wit">{c.bron}</span>
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-[1.75rem]">{c.t}</h3>
                  <p class="mt-3 text-steen">{c.d}</p>
                  <a href={vraag(c.wa)} class="mt-auto inline-flex items-center gap-2 pt-6 font-bold text-merk no-underline transition-colors hover:text-merk-diep">Vraag het via WhatsApp<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="rijs mt-12 flex flex-col gap-5 lg:flex-row lg:items-start lg:gap-10">
          <p class="shrink-0 pt-2 font-bold">Ook in de winkel</p>
          <ul class="flex flex-wrap gap-2.5">
            {ook.map((t) => <li class="chip">{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- 5. Inkoop en reparatie: donker, met sfeerfoto -->
    <section id="inkoop" class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-inkoop">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <Image src={sReparatie} alt="Handen die met een tangetje aan een sieraad werken" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 50vw, 100vw" quality={68} class="aspect-[4/3] w-full rounded-[4px] object-cover lg:aspect-[4/5]" />
          <figcaption class="mt-4 text-sm text-mist">Sfeerfoto via Unsplash, ter illustratie.</figcaption>
        </figure>
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Inkoop en reparatie</p>
          <h2 id="t-inkoop" class="rijs mt-5 text-4xl">Niet alleen <span class="text-merk-licht">verkoop</span>.</h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-wit/90" style="--d:.06s">Zo staat het op ons gevelbord: inkoop, verkoop en reparaties van goud.</p>
          <ul class="rijs mt-10 divide-y divide-lijn border-y border-lijn" style="--d:.1s">
            <li class="flex gap-5 py-7">
              <span class="grid h-12 w-12 flex-none place-items-center rounded-full border border-lijn text-merk-licht"><Icoon naam="weeg" class="h-6 w-6" /></span>
              <div><h3 class="text-2xl">Inkoop</h3><p class="mt-2 text-mist">Goud dat je niet meer draagt? Neem het mee naar de winkel en vraag wat het waard is.</p></div>
            </li>
            <li class="flex gap-5 py-7">
              <span class="grid h-12 w-12 flex-none place-items-center rounded-full border border-lijn text-merk-licht"><Icoon naam="tang" class="h-6 w-6" /></span>
              <div><h3 class="text-2xl">Reparatie</h3><p class="mt-2 text-mist">Reparaties van goud, zoals een armband die korter moet.</p></div>
            </li>
          </ul>
          <blockquote class="rijs mt-9 border-l-4 border-merk pl-6" style="--d:.14s">
            <p class="text-lg text-wit/90">“… heeft mijn armband binnen 2 dagen verkort. Ben heel blij met de service en het resultaat!”</p>
            <footer class="mt-2 text-sm text-mist">Sieta S., Google review</footer>
          </blockquote>
          <a href={waMet('Hallo Roos Juwelier, ik heb een vraag over inkoop of reparatie van goud.')} class="rijs knop knop-merk mt-10" style="--d:.18s"><Icoon naam="wa" />Stel je vraag via WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- 6. Zo werkt het -->
    <section class="border-b border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo werkt het</p>
            <h2 id="t-werk" class="mt-5 text-4xl">Van foto tot sieraad.</h2>
          </div>
        </div>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
          {stappen.map(([t, d], i) => (
            <li class="rijs flex flex-col border-t-2 border-inkt pt-7" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-6 text-2xl">{t}</h3>
              <p class="mt-3 text-steen">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Wow: zoekzin + stuk van Instagram kiezen -> vooraf ingevuld WhatsApp-bericht -->
    <section id="zoeken" class="bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-zoek">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow eyebrow-licht">Sieraad zoeken</p>
            <h2 id="t-zoek" class="mt-5 text-4xl">Zeg wat je zoekt.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-mist lg:col-span-5 lg:col-start-8 lg:self-end" style="--d:.1s">Maak de zin af of kies een stuk van onze Instagram. Je bericht staat daarna klaar in WhatsApp.</p>
        </div>

        <form class="mt-12 grid gap-x-12 gap-y-12 md:mt-16 lg:grid-cols-12" data-zoek data-ig={JSON.stringify(igKlein)}>
          <div class="min-w-0 lg:col-span-7">
            <p class="zin">
              Ik zoek <label class="zin-keuze"><span class="sr-only">Wat zoek je?</span><select name="soort">{soorten.map((s, i) => <option value={s} selected={i === 2}>{s}</option>)}</select></label>
              in <label class="zin-keuze"><span class="sr-only">Welke stijl?</span><select name="stijl">{stijlen.map((s, i) => <option value={s} selected={i === 0}>{s}</option>)}</select></label>,
              <label class="zin-keuze"><span class="sr-only">Voor wie of welke gelegenheid?</span><select name="voor">{voor.map((s, i) => <option value={s} selected={i === 1}>{s}</option>)}</select></label>.
            </p>

            <fieldset class="mt-12">
              <legend class="veld-label">Of: zoiets als dit stuk van Instagram</legend>
              <div class="grid grid-cols-4 gap-2.5 sm:gap-3">
                {igStukken.map((s) => (
                  <label class="ig">
                    <input type="checkbox" name="ig" value={s.id} data-t={s.t} data-datum={s.datum} />
                    <Image src={s.src} alt="" width={240} quality={74} />
                    <span class="ig-vink" aria-hidden="true"><Icoon naam="vink" class="h-4 w-4" /></span>
                    <span class="ig-label">{s.t}</span><span class="sr-only">{`${s.t}, post van ${s.datum}`}</span>
                  </label>
                ))}
              </div>
              <p class="mt-3 text-xs text-mist">Omslagbeelden van posts op @roosjuwelier, juni tot september 2026.</p>
            </fieldset>

            <div class="mt-9">
              <label for="extra" class="veld-label">Nog iets? (maat, lengte, de naam voor een naamketting)</label>
              <input id="extra" name="extra" class="veld" placeholder="bv. ringmaat 17" autocomplete="off" />
            </div>
          </div>

          <div class="min-w-0 lg:col-span-5">
            <div class="lg:sticky lg:top-8">
              <div class="flex items-center gap-4 rounded-[4px] bg-inkt-2 p-4">
                <img data-gekozen-img src={igKlein['ig02']} alt="" width="64" height="92" class="hidden h-[92px] w-16 flex-none rounded-[3px] object-cover" />
                <div data-gekozen-leeg class="grid h-[92px] w-16 flex-none place-items-center rounded-[3px] border border-dashed border-lijn text-merk-licht"><Icoon naam="ring" class="h-7 w-7" /></div>
                <p class="text-sm text-mist" data-gekozen-tekst>Geen stuk van Instagram gekozen.</p>
              </div>
              <p class="veld-label mt-8">Jouw bericht</p>
              <p class="min-h-[8rem] whitespace-pre-line rounded-[4px] border-l-4 border-merk bg-inkt-2 px-5 py-4 text-[.98rem] leading-relaxed text-wit/90" data-voorbeeld aria-live="polite"></p>
              <a href={waHoi} class="knop knop-merk mt-5 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <p class="mt-3 text-center text-xs text-mist">Heb je zelf een foto van wat je zoekt? Stuur die in WhatsApp mee.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-9 w-9 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-extrabold leading-none">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-sm text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="kaart flex h-full flex-col p-7">
                <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
                <blockquote class="mt-5 flex-1 text-[1.05rem] leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5 text-sm">
                  <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-ivoor-2 font-bold">{r.naam[0]}</span>
                  <span><b class="block font-bold">{r.naam}</b><span class="text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. De winkel: eigen foto van de gevel, tijden met vandaag gemarkeerd -->
    <section id="winkel" class="border-t border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-winkel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={winkel} alt="De gevel van Roos Juwelier met het zwarte bord en de etalage vol goud" widths={[420, 640, 900]} sizes="(min-width: 1024px) 38vw, 100vw" quality={72} class="aspect-[4/5] w-full rounded-[4px] object-cover object-[50%_30%]" />
          <figcaption class="mt-3 text-sm text-steen">{site.straat}, eigen foto op Google.</figcaption>
        </figure>
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">De winkel</p>
          <h2 id="t-winkel" class="rijs mt-5 text-4xl">Kom langs aan de Zwart Janstraat.</h2>
          <p class="rijs mt-8"><a href={site.telHref} class="num font-kop text-[clamp(2.1rem,4.6vw,3.8rem)] font-extrabold leading-none tracking-[-.05em] text-inkt no-underline transition-colors hover:text-merk">{site.tel}</a></p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.08s">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.insta} class="knop knop-rand"><Icoon naam="insta" />@roosjuwelier</a>
          </div>
          <div class="rijs kaart mt-10 overflow-hidden" style="--d:.12s">
            <div class="grid sm:grid-cols-2 sm:divide-x sm:divide-lijn-licht">
              <div class="flex gap-4 border-b border-lijn-licht p-6 sm:border-b-0">
                <Icoon naam="pin" class="mt-0.5 h-5 w-5 flex-none text-merk" />
                <div><p class="font-bold">{site.naam}</p><p class="mt-1 text-steen">{site.straat}<br />{site.postcode} {site.plaats}</p></div>
              </div>
              <div class="flex gap-4 p-6">
                <Icoon naam="klok" class="mt-0.5 h-5 w-5 flex-none text-merk" />
                <div class="w-full">
                  <p class="font-bold" data-status-kort>Openingstijden</p>
                  <ul class="num mt-2 space-y-1 text-[.95rem] text-steen">
                    {volgorde.map((d) => { const t = site.tijden[d]; return <li class="flex justify-between gap-4 rounded-[3px] px-2 -mx-2" data-dag={d}><span>{dagen[d]}</span><span>{t ? `${t[0]}:00 tot ${t[1]}:00` : 'Gesloten'}</span></li>; })}
                  </ul>
                </div>
              </div>
            </div>
            <a href={site.route} class="flex items-center justify-between gap-3 bg-inkt px-6 py-4 font-bold text-wit no-underline transition-colors hover:bg-merk">Route plannen<Icoon naam="pijl" class="h-5 w-5" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Slotbalk met de vitrine -->
    <section class="relative isolate overflow-hidden bg-merk text-wit" aria-label="Sieraad zoeken">
      <Image src={vitrine} alt="" widths={[640, 1200, 1600]} sizes="100vw" quality={60} class="absolute inset-0 -z-20 h-full w-full object-cover opacity-25 mix-blend-multiply" />
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center md:py-16">
        <p class="font-kop text-3xl font-extrabold leading-none tracking-[-.04em]">Op zoek naar goud?</p>
        <a href="#zoeken" class="knop knop-inkt shrink-0">Sieraad zoeken<Icoon naam="pijl" /></a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';

  // Live status: ma, di, do t/m zo 12:00 tot 18:00, woensdag gesloten.
  const nu = new Date();
  const d = nu.getDay();
  const uur = nu.getHours() + nu.getMinutes() / 60;
  const t = site.tijden[d];
  const morgen = site.tijden[(d + 1) % 7];
  let tekst = 'Open 12:00 tot 18:00, woensdag gesloten';
  if (t && uur >= t[0] && uur < t[1]) tekst = `Nu open, tot ${t[1]}:00`;
  else if (t && uur < t[0]) tekst = `Vandaag open vanaf ${t[0]}:00`;
  else if (morgen) tekst = `${t ? 'Nu gesloten' : 'Vandaag gesloten'}, morgen open vanaf ${morgen[0]}:00`;
  else tekst = `${t ? 'Nu gesloten' : 'Vandaag gesloten'}, donderdag weer open`;
  const s = document.querySelector('[data-status]');
  const sk = document.querySelector('[data-status-kort]');
  if (s) s.textContent = tekst;
  if (sk) sk.textContent = tekst;
  document.querySelector(`[data-dag="${d}"]`)?.classList.add('bg-ivoor-2', 'font-bold', 'text-inkt');

  // Sieraad zoeken
  const f = document.querySelector<HTMLFormElement>('[data-zoek]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const gImg = document.querySelector<HTMLImageElement>('[data-gekozen-img]');
  const gLeeg = document.querySelector<HTMLElement>('[data-gekozen-leeg]');
  const gTekst = document.querySelector<HTMLElement>('[data-gekozen-tekst]');
  if (f && vb && knop) {
    const ig = JSON.parse(f.dataset.ig || '{}') as Record<string, string>;
    const zet = () => {
      const d = new FormData(f);
      const soort = String(d.get('soort'));
      const stijl = String(d.get('stijl'));
      const voor = String(d.get('voor'));
      const extra = String(d.get('extra') || '').trim();
      const gekozen = [...f.querySelectorAll<HTMLInputElement>('input[name="ig"]:checked')];
      const stijlTekst = stijl;
      const r = [`Hallo Roos Juwelier, ik zoek ${soort} in ${stijlTekst}, ${voor}.`];
      if (gekozen.length) r.push(`Zoiets als ${gekozen.length > 1 ? 'deze stukken' : 'dit stuk'} van jullie Instagram: ${gekozen.map((g) => `${g.dataset.t!.toLowerCase()} (post van ${g.dataset.datum})`).join(', ')}.`);
      if (extra) r.push(extra.endsWith('.') ? extra : `${extra}.`);
      r.push('Hebben jullie dat in de winkel?');
      const tx = r.join('\n');
      vb.textContent = tx;
      knop.href = `${site.wa}?text=${encodeURIComponent(tx)}`;
      if (gImg && gLeeg && gTekst) {
        if (gekozen.length) {
          gImg.src = ig[gekozen[gekozen.length - 1].value]; gImg.classList.remove('hidden'); gLeeg.classList.add('hidden');
          gTekst.textContent = gekozen.length > 1 ? `${gekozen.length} stukken van Instagram gekozen.` : `${gekozen[0].dataset.t}, post van ${gekozen[0].dataset.datum}.`;
        } else { gImg.classList.add('hidden'); gLeeg.classList.remove('hidden'); gTekst.textContent = 'Geen stuk van Instagram gekozen.'; }
      }
    };
    // Keuzes in de zin zo breed als het gekozen woord.
    const meet = document.createElement('span');
    meet.className = 'zin'; meet.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;left:-9999px;top:0';
    document.body.appendChild(meet);
    const pas = () => f.querySelectorAll<HTMLSelectElement>('.zin-keuze select').forEach((sel) => { meet.textContent = sel.selectedOptions[0].text; sel.style.width = `calc(${meet.offsetWidth}px + 1.25em)`; });
    f.addEventListener('input', () => { zet(); pas(); }); f.addEventListener('change', () => { zet(); pas(); });
    f.addEventListener('submit', (e) => e.preventDefault());
    zet(); pas(); document.fonts?.ready.then(pas);
  }
</script>
