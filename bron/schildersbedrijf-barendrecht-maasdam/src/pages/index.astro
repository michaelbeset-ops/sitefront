---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, aanbeveling, waOfferte } from '../data/site';
import hero from '../assets/hero.jpg';
import buiten from '../assets/buiten.jpg';
import binnen from '../assets/binnen.jpg';
import horeca from '../assets/horeca.jpg';
import renovlies from '../assets/renovlies.jpg';
import lijstwerk from '../assets/lijstwerk.jpg';
import gevel from '../assets/gevel.jpg';
import badkamer from '../assets/badkamer.jpg';
import deur from '../assets/deur.jpg';
import gang from '../assets/gang.jpg';
import sigma from '../assets/sigma.jpg';
import tuinzijde from '../assets/tuinzijde.jpg';
import aanbouw from '../assets/aanbouw.jpg';
import erker from '../assets/erker.jpg';
import schuren from '../assets/schuren.jpg';
import bus from '../assets/bus.jpg';

const diensten = [
  { t: 'Buitenschilderwerk', d: 'Kozijnen, deuren en gevels. Tijdig onderhoud bespaart u extra werk en kosten.', src: buiten, alt: 'Wit geschilderde woning met een aanbouw vol glazen deuren in donkergrijs hoogglans', pos: '50% 55%' },
  { t: 'Binnenschilderwerk', d: 'Wanden en plafonds sausen of spuiten, deuren en kozijnen lakken.', src: binnen, alt: 'Lege, strak wit geschilderde woonkamer met zwarte kozijnen', pos: '50% 50%' },
  { t: 'Behang en glasvezel', d: 'Alle soorten behang. Glasvezel is stootvast, goed reinigbaar en in elke kleur af te werken.', src: horeca, alt: 'Eetzaal met een donkergrijs geschilderde wand, gele stoelen en een koperen hanglamp', pos: '50% 55%' },
  { t: 'Renovlies', d: 'Een egale basis voor uw wanden, in nieuwbouw en bij renovatie.', src: renovlies, alt: 'Rollen renovlies op een werktafel, op de achtergrond een schilder aan de wand', pos: '50% 60%' },
  { t: 'Klein timmerwerk', d: 'Ramen, kozijnen en onderhoud, inclusief houtrotreparatie.', src: lijstwerk, alt: 'Gootlijst met klossen, net wit geschilderd', pos: '50% 45%' },
  { t: 'Kitwerk', d: 'Het aanbrengen of vervangen van kitnaden.', src: aanbouw, alt: 'Wit geschilderde aanbouw met blauwe kozijnen en deuren, ernaast een stalen trap', pos: '50% 62%' },
];

const projecten = [
  { src: gevel, alt: 'Bakstenen herenhuizen met wit geschilderde kozijnen en lijstwerk', label: 'Gevel en kozijnen', cls: 'col-span-2 row-span-2 aspect-square md:aspect-auto', w: [600, 900, 1200], s: '(min-width: 1248px) 580px, (min-width: 768px) 48vw, 92vw' },
  { src: badkamer, alt: 'Badkamer met lichtgrijze wanden, vrijstaand bad en houten vloer', label: 'Badkamer', cls: 'aspect-square', pos: '50% 40%' },
  { src: deur, alt: 'Schilder aan het werk aan een binnendeur met glas-in-lood, op een zwart-witte tegelvloer', label: 'Binnendeur', cls: 'aspect-square', pos: '50% 35%' },
  { src: gang, alt: 'Lange gang in een nieuwbouwwoning, wanden met renovlies, wit afgewerkt', label: 'Nieuwbouw', cls: 'aspect-square', pos: '50% 50%' },
  { src: sigma, alt: 'Emmer muurverf met een verfroller op een trapje', label: 'Aan het werk', cls: 'aspect-square', pos: '50% 50%' },
  { src: tuinzijde, alt: 'Woning met wit geschilderde gevel en donkere luiken, voortuin vol witte hortensia’s', label: 'Buitenschilderwerk', cls: 'col-span-2 aspect-[2/1]', pos: '50% 45%' },
  { src: erker, alt: 'Bakstenen gevel met een wit geschilderde erker en kozijnen', label: 'Kozijnen en erker', cls: 'col-span-2 aspect-[2/1]', pos: '50% 50%' },
];

const stappen = [
  ['Bellen of appen', 'Vertel kort wat er geschilderd moet worden. Foto’s meesturen mag altijd.'],
  ['Vrijblijvende offerte', 'We maken een afspraak en komen het werk bekijken.'],
  ['Alles op papier', 'Een schriftelijke offerte met het werk, de materialen, de startdatum en de duur. Dertig dagen geldig.'],
  ['Uitvoering', 'Binnen normale werktijden, uitsluitend met hoogwaardige producten.'],
  ['Oplevering', 'Op de afgesproken datum, met garantie volgens de algemene voorwaarden.'],
];

const waarden = [
  ['schild', 'Eerlijkheid', 'Wij zullen u altijd een eerlijk advies geven.'],
  ['kwast', 'Kwaliteit', 'Wij werken uitsluitend met hoogwaardige producten.'],
  ['hand', 'Verantwoordelijkheid', 'Wij nemen ons werk serieus, uw wensen staan centraal.'],
  ['oog', 'Ondernemerschap', 'Een uitstekend resultaat, waar u jaren plezier van hebt.'],
];
---
<Base title={`${site.naam} | Schilder in Maasdam, Hoeksche Waard en Barendrecht`} description="Schildersbedrijf uit Maasdam voor binnen- en buitenschilderwerk, behang, glasvezel en renovlies, klein timmerwerk en kitwerk. Particulier en zakelijk. Vrijblijvende offerte: 06 51 42 07 77.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_30%] md:object-[70%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0b183000_0%,#0b183080_30%,#0b1830e6_62%,#0b1830f7_100%)] md:bg-[linear-gradient(90deg,#0b1830f2_0%,#0b1830d1_40%,#0b183026_78%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Schilder in de Hoeksche Waard<span class="hidden sm:inline">&nbsp;en Barendrecht</span></p>
          <h1 id="t-hero" class="mt-6 text-hero">Schilderwerk waar u <span class="streek">jaren</span> plezier van hebt.</h1>
          <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Binnen- en buitenschilderwerk, behang, glasvezel en renovlies, klein timmerwerk en kitwerk. Voor particulieren en bedrijven.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="knop knop-kobalt"><Icoon naam="doc" />Vrijblijvende offerte</a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><Icoon naam="duim" class="h-4 w-4 text-hemel" /><b class="text-licht">{site.fb.aanbevolen} aanbevolen</b> op Facebook</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za 8.00 tot 17.00 uur</span></li>
            <li class="flex items-center gap-2"><Icoon naam="pin" class="h-4 w-4 text-hemel" />Vanuit {site.plaats}</li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:flex lg:justify-end">
          <a href={site.telHref} class="group block w-full max-w-[19rem] rounded-sm bg-licht p-6 text-inkt no-underline shadow-md transition-transform duration-300 hover:-translate-y-1">
            <p class="text-sm font-semibold uppercase tracking-[.16em] text-kobalt">Direct contact</p>
            <p class="num mt-3 font-kop text-[2rem] font-bold leading-none tracking-[-0.01em]">{site.tel}</p>
            <p class="mt-3 text-[.9375rem] text-grijs">Bel of app voor een afspraak. Wij komen kijken en maken een vrijblijvende offerte.</p>
            <span class="mt-5 flex items-center gap-2 text-[.9375rem] font-semibold text-kobalt">Nu bellen<Icoon naam="pijl" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-sm border border-lijn bg-papier px-4 py-2 text-sm font-medium no-underline transition-colors hover:border-kobalt hover:bg-kobalt hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-8">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-5 text-3xl">Bij schilderwerk komt meer kijken dan een kleurtje.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Uitstraling is belangrijk, maar goed onderhoud zorgt dat u er langer van geniet. Binnen en buiten, voor woning en bedrijfspand.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href="#offerte" data-kies={b.t} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-square sm:aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                  <span class="num absolute left-0 top-0 bg-kobalt px-2.5 py-1 font-kop text-xs sm:px-3 sm:py-1.5 sm:text-sm font-semibold text-wit">0{i + 1}</span>
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-4 sm:p-6">
                  <div>
                    <h3 class="text-[1.0625rem] hyphens-auto sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden sm:grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-kobalt-zacht text-kobalt transition-colors group-hover:bg-kobalt group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-sm border-l-4 border-kobalt bg-steen px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Ook waterschade behandelen, lambrisering en structuurwerk.</b> <span class="text-grijs">Twijfelt u wat uw klus nodig heeft? Vraag het gerust.</span></p>
          <a href={waOfferte} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="wa" />Stel uw vraag</a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Aanbevolen op Facebook</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.03em] text-kobalt">{site.fb.aanbevolen}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Volgers op Facebook</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.03em]">{site.fb.volgers}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Jaar schilderwerk</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.03em]">10+</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Dagen per week bereikbaar</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.03em]">6</dd></div>
      </dl>
    </section>

    <!-- 5. Projecten -->
    <section id="projecten" class="donker bg-nacht py-20 text-licht lg:py-28" aria-labelledby="t-projecten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-projecten" class="mt-5 text-3xl">Van gevel tot badkamer.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-licht-zacht">Een greep uit eigen werk: woningen, een badkamer, nieuwbouw met renovlies en houtwerk aan de gevel.</p>
            <a href={site.facebook} class="knop knop-rand knop-klein mt-6"><Icoon naam="fb" />Meer op Facebook</a>
          </div>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-16">
          {projecten.map((p, i) => (
            <li class={`rijs relative overflow-hidden rounded-sm bg-nacht-2 ${p.cls}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={p.src} alt={p.alt} widths={p.w ?? [320, 480, 640, 900]} sizes={p.s ?? (p.cls.includes('col-span-2') ? '(min-width: 1248px) 580px, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 290px, (min-width: 768px) 24vw, 46vw')} class="tegel absolute inset-0 h-full w-full object-cover" style={p.pos ? `object-position:${p.pos}` : undefined} />
              <span class="absolute bottom-0 left-0 bg-nacht/85 px-3 py-1.5 text-[.8125rem] font-medium text-licht backdrop-blur-sm">{p.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-24" aria-labelledby="t-werkwijze">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-werkwijze" class="mt-5 text-3xl">Van eerste telefoontje tot oplevering.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Heldere afspraken vooraf, zodat u precies weet waar u aan toe bent.</p>
        </div>
        <ol class="mt-12 grid gap-px overflow-hidden rounded-sm bg-lijn sm:grid-cols-2 lg:mt-16 lg:grid-cols-5">
          {stappen.map(([t, d], i) => (
            <li class={`rijs bg-wit p-6 sm:p-7 ${i === 4 ? 'sm:col-span-2 lg:col-span-1' : ''}`} style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.5rem] font-bold leading-none text-kobalt">0{i + 1}</p>
              <h3 class="mt-6 text-xl">{t}</h3>
              <p class="mt-2.5 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[30rem] lg:col-span-5">
          <Image src={schuren} alt="Schilder van Schildersbedrijf Barendrecht schuurt een wand in een nieuwbouwwoning" widths={[640, 960, 1080]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[40%_50%]" />
          <p class="absolute bottom-0 left-0 bg-kobalt px-4 py-2 text-sm font-semibold text-wit">Gevestigd in {site.plaats}</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over ons</p>
          <h2 id="t-over" class="mt-5 text-3xl">Een klein, ondernemend schildersbedrijf.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Schildersbedrijf Barendrecht werkt vanuit {site.plaats} voor particulieren en bedrijven, in de Hoeksche Waard, Barendrecht en omgeving. Van een gedateerde woonkamer tot de gevel van een herenhuis: we denken mee, geven advies en leveren werk af waar u jaren plezier van hebt.</p>
          <ul class="mt-9 grid gap-3 sm:grid-cols-2">
            {waarden.map(([ic, t, d]) => (
              <li class="rounded-sm bg-nacht-2 p-5">
                <span class="grid h-10 w-10 place-items-center rounded-sm bg-kobalt text-wit"><Icoon naam={ic} class="h-5 w-5" /></span>
                <h3 class="mt-4 text-lg">{t}</h3>
                <p class="mt-1 text-[.9375rem] text-licht-zacht">{d}</p>
              </li>
            ))}
          </ul>
          <a href="#offerte" class="knop knop-kobalt mt-9"><Icoon naam="doc" />Vraag een offerte aan</a>
        </div>
      </div>
    </section>

    <!-- 8. Wat klanten zeggen -->
    <section id="reviews" class="bg-steen py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="rijs">
          <p class="eyebrow">Ervaringen</p>
          <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
        </div>
        <div class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-12 lg:gap-6">
          <figure class="rijs kaart relative flex flex-col p-7 sm:p-10 lg:col-span-8 lg:p-12">
            <svg viewBox="0 0 48 36" class="h-9 w-12 text-kobalt" fill="currentColor" aria-hidden="true"><path d="M0 36V22C0 9.6 6.4 2.3 19 0l2 5.4C13.6 7.3 10.2 11 9.6 16H19v20H0Zm27 0V22C27 9.6 33.4 2.3 46 0l2 5.4C40.6 7.3 37.2 11 36.6 16H46v20H27Z"/></svg>
            <blockquote class="mt-7 flex-1 font-kop text-[clamp(1.5rem,1.4vw+1.1rem,2.25rem)] font-medium leading-[1.25] tracking-[-0.01em]">
              {aanbeveling.tekst.map((z) => <p class="mt-3 first:mt-0">{z}</p>)}
            </blockquote>
            <figcaption class="mt-9 flex items-center gap-3 border-t border-lijn pt-6">
              <span class="grid h-11 w-11 place-items-center rounded-sm bg-kobalt-zacht font-kop font-bold text-kobalt" aria-hidden="true">{aanbeveling.naam[0]}</span>
              <span class="flex-1 text-sm leading-snug"><b class="block text-base font-semibold">{aanbeveling.naam}</b><span class="text-grijs">Aanbeveling op Facebook, {aanbeveling.wanneer}</span></span>
              <Icoon naam="fb" class="h-6 w-6 text-[#1877f2]" />
            </figcaption>
          </figure>
          <div class="flex flex-col gap-5 lg:col-span-4 lg:gap-6">
            <a href={site.fbReviews} class="rijs kaart group flex flex-1 flex-col justify-between p-7 no-underline transition-shadow hover:shadow-md" style="--d:.05s">
              <span class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-sm bg-[#1877f2] text-wit"><Icoon naam="fb" class="h-6 w-6" /></span><span class="text-sm text-grijs">Facebook</span></span>
              <span class="mt-8 block">
                <b class="num block font-kop text-[3.5rem] font-bold leading-none tracking-[-0.03em] text-kobalt">{site.fb.aanbevolen}</b>
                <span class="mt-2 block text-lg font-semibold">aanbevolen</span>
                <span class="mt-1 flex items-center gap-1.5 text-grijs">{site.fb.aantal} beoordelingen bekijken<Icoon naam="pijl" class="h-4 w-4 text-kobalt transition-transform group-hover:translate-x-1" /></span>
              </span>
            </a>
            <div class="rijs rounded-sm bg-nacht p-7 text-licht" style="--d:.1s">
              <p class="font-kop text-xl font-semibold">Klant geweest?</p>
              <p class="mt-2 text-[.9375rem] text-licht-zacht">Een korte review helpt anderen in de buurt een goede schilder te vinden.</p>
              <a href={site.google} class="link mt-4 inline-flex items-center gap-2 font-semibold text-licht"><Icoon naam="g" class="h-4 w-4" />Review schrijven op Google</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Werkgebied en bereikbaarheid -->
    <section id="werkgebied" class="py-20 lg:py-24" aria-labelledby="t-werkgebied">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Werkgebied</p>
          <h2 id="t-werkgebied" class="mt-5 text-3xl">Hoeksche Waard en Barendrecht.</h2>
          <p class="mt-6 text-lg text-grijs">Wij werken in {site.werkgebied}. Twijfelt u of uw adres erbij hoort? Bel of app gerust.</p>
          <div class="kaart mt-10 p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Bereikbaar</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za bereikbaar</span></p>
            </div>
            <table class="mt-4 w-full">
              <caption class="sr-only">Bereikbaarheid van Schildersbedrijf Barendrecht</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-kobalt">
                    <th scope="row" class="py-2.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="flex flex-col gap-5 lg:col-span-7">
          <figure class="relative flex-1 overflow-hidden rounded-sm">
            <Image src={bus} alt="De witte bus van Schildersbedrijf Barendrecht met blauwe belettering, voor nieuwe rijtjeswoningen" widths={[600, 900, 1161]} sizes="(min-width: 1248px) 700px, (min-width: 1024px) 56vw, 92vw" class="h-full min-h-[20rem] w-full object-cover object-[50%_62%]" />
          </figure>
          <div class="kaart flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-kobalt" /><span><b class="font-semibold">Gevestigd in {site.plaats}</b><br /><span class="text-grijs">Werkgebied: Hoeksche Waard, Barendrecht en omgeving</span></span></p>
            <a href={site.telHref} class="knop knop-inkt knop-klein num shrink-0"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Offerte: WhatsApp-bericht samenstellen -->
    <section id="contact" class="bg-steen py-20 lg:py-24" aria-labelledby="t-offerte">
      <div id="offerte" class="wrap grid scroll-mt-28 grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Vrijblijvend</p>
          <h2 id="t-offerte" class="mt-5 text-3xl">Offerte aanvragen.</h2>
          <p class="mt-6 text-lg text-grijs">Kies wat er moet gebeuren en waar. Wij maken er een bericht van; daarna plannen we een afspraak om het werk te bekijken.</p>
          <ul class="mt-10 grid grid-cols-1 gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-kobalt text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-kobalt" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-kobalt-zacht text-kobalt"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Ma t/m za, 8.00 tot 17.00 uur</span></span><Icoon naam="pijl" class="h-5 w-5 text-kobalt" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-kobalt-zacht text-kobalt"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-kobalt" /></a></li>
          </ul>
        </div>
        <form class="kaart min-w-0 p-6 sm:p-8 lg:col-span-7 lg:p-10" data-offerte aria-describedby="of-uitleg">
          <h3 class="text-2xl">Uw aanvraag</h3>
          <p id="of-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp of uw e-mail zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat moet er gebeuren? <span class="font-normal text-grijs">(meerdere mogelijk)</span></legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {diensten.map((d) => (
                <label class="keuze"><input type="checkbox" name="werk" value={d.t} class="sr-only" /><span>{d.t}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-7">
            <legend class="text-sm font-semibold">Soort pand</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Woning', 'Bedrijfspand'].map((p) => (
                <label class="keuze"><input type="radio" name="pand" value={p} class="sr-only" /><span>{p}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld Barendrecht" /></label>
            <label class="block"><span class="text-sm font-semibold">Wanneer</span>
              <select name="wanneer" class="veld mt-2">
                <option value="">Weet ik nog niet</option>
                <option>Zo snel mogelijk</option>
                <option>Binnen drie maanden</option>
                <option>Later dit jaar</option>
              </select>
            </label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: kozijnen en deuren aan de voorkant, twee verdiepingen"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <button type="submit" class="knop knop-kobalt"><Icoon naam="wa" />Open in WhatsApp</button>
            <button type="button" class="knop knop-rand" data-mail><Icoon naam="mail" />Of per e-mail</button>
          </div>
          <p class="mt-4 text-sm text-grijs">Foto’s van het werk kunt u daarna in WhatsApp meesturen.</p>
        </form>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="bg-kobalt text-wit" aria-label="Offerte aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Toe aan nieuw schilderwerk?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel of app voor een vrijblijvende offerte.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp ons</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-offerte]');
  const bericht = () => {
    const d = new FormData(f!);
    const v = (n: string) => String(d.get(n) || '').trim();
    const werk = d.getAll('werk').map(String);
    const r = ['Goedendag, ik wil graag een vrijblijvende offerte.'];
    if (werk.length) r.push('Werkzaamheden: ' + werk.join(', ').toLowerCase());
    if (v('pand')) r.push('Pand: ' + v('pand').toLowerCase());
    if (v('plaats')) r.push('Plaats: ' + v('plaats'));
    if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
    if (v('wens')) r.push('Toelichting: ' + v('wens'));
    if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam'));
    return r.join('\n');
  };
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31651420777?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
    f.querySelector('[data-mail]')?.addEventListener('click', () => {
      location.href = 'mailto:info@schildersbedrijf-barendrecht.nl?subject=' + encodeURIComponent('Offerteaanvraag schilderwerk') + '&body=' + encodeURIComponent(bericht());
    });
    // Klik op een dienstkaart: dienst alvast aanvinken in het formulier.
    document.querySelectorAll<HTMLAnchorElement>('[data-kies]').forEach((a) => a.addEventListener('click', () => {
      const cb = f.querySelector<HTMLInputElement>(`input[name="werk"][value="${a.dataset.kies}"]`);
      if (cb) cb.checked = true;
    }));
  }
</script>

