---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, diensten, reviews, genoemd, openingstijden, foto, srcset } from '../data/site';

const heroSet = srcset(foto.hero, [640, 960, 1280, 1600]);
---
<Base
  title="Stukadoor in Hoogvliet | Stuca-Paint"
  description="Stuca-Paint uit Hoogvliet stuct en saust muren en plafonds. Glad stucwerk, spack- en latexspuiten, spachtelputz en lijsten. 9,4 uit 85 Google-reviews. Bel 06 25 37 59 73."
  heroFoto={foto.hero(1280)}
  heroSrcset={heroSet}
>
  <Kop />
  <main id="inhoud">
    <!-- Hero: schermvullende foto van handen met spanen aan de muur. Kop links onderin, het cijfer rechts als bewijs. -->
    <section class="op-donker relative isolate flex min-h-[100svh] items-end overflow-hidden bg-bitumen text-kalk">
      <img
        src={foto.hero(1280)}
        srcset={heroSet}
        sizes="100vw"
        alt=""
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgb(29_26_23/0.95)_0%,rgb(29_26_23/0.72)_45%,rgb(29_26_23/0.35)_100%)]"></div>
      <div class="wrap grid gap-10 pb-12 pt-32 md:pb-16 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-9">
          <span class="rei" aria-hidden="true"></span>
          <p class="label mt-5 text-oker">Stukadoor in {site.plaats}, sinds 2000</p>
          <h1 class="mt-4 text-5xl uppercase">Strak stucwerk van vader en zoon</h1>
          <p class="mt-6 max-w-xl text-lg text-kalk/90">Stuca-Paint stuct en saust muren en plafonds. Glad stucwerk, spack- en latexspuiten, spachtelputz en lijsten. Met garantie.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.mobielHref} class="knop knop-oker whitespace-nowrap">Bel {site.mobiel}</a>
            <a href="#werk" class="knop knop-lijn">Wat we doen</a>
          </div>
        </div>
        <a href="#reviews" class="group block border-t-2 border-oker pt-4 lg:col-span-3 lg:justify-self-end lg:text-right">
          <span class="smal block text-[4.5rem] font-extrabold leading-none text-oker">{site.score}</span>
          <span class="mt-1 block text-sm text-kalk/90 group-hover:underline">uit {site.aantalReviews} Google-reviews</span>
        </a>
      </div>
    </section>

    <!-- Blikvanger: de review over stucen en sausen in een bewoonde woning. Twee woorden uit die review dragen de sectie. -->
    <section class="py-20 lg:py-32" aria-labelledby="bewoond-kop">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-end">
        <div class="rij lg:col-span-7">
          <span class="rei" aria-hidden="true"></span>
          <p class="label mt-5 text-klei">Uit een Google-review van mei 2025</p>
          <h2 id="bewoond-kop" class="mt-4 text-3xl uppercase">Gestuukt en gesaust in een bewoonde woning</h2>
          <figure class="mt-10">
            <blockquote>
              <p class="smal text-[clamp(3rem,1.6rem+7vw,7.25rem)] font-extrabold uppercase leading-[0.88] tracking-[-0.03em] text-klei">“Slim en zorg&shy;vuldig”</p>
            </blockquote>
            <figcaption class="mt-8 max-w-lg text-grijs">
              Een klant liet muren en plafonds stucen en sausen terwijl er gewoon in huis gewoond werd. Ze schreef dat Ruud en Mike, vader en zoon, het slim en zorgvuldig aanpakten.
              <span class="mt-3 block text-sm font-semibold text-bitumen">karra garra op Google, 24 mei 2025</span>
            </figcaption>
          </figure>
        </div>
        <figure class="rij lg:col-span-5">
          <img
            src={foto.bewoond(900)}
            srcset={srcset(foto.bewoond, [480, 720, 900, 1200])}
            sizes="(min-width: 1024px) 38vw, 100vw"
            alt="Keuken tijdens een verbouwing, de kastjes afgeplakt met plastic en papier"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy" decoding="async"
          />
          <figcaption class="mt-2 text-xs text-grijs">Sfeerbeeld</figcaption>
        </figure>
      </div>
    </section>

    <!-- Diensten als een lijst met smalle koppen, geen kaartjes. Links blijft de kop staan terwijl je scrolt. -->
    <section id="werk" class="scroll-mt-4 border-t border-lijn bg-kalk py-20 lg:py-32" aria-labelledby="werk-kop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-10">
            <span class="rei" aria-hidden="true"></span>
            <h2 id="werk-kop" class="mt-6 text-4xl uppercase">Wat we doen</h2>
            <p class="mt-5 max-w-sm text-grijs">Van kale muur tot gesausd plafond. Op het werk zit garantie.</p>
            <figure class="mt-10 hidden lg:block">
              <img
                src={foto.saus(700)}
                srcset={srcset(foto.saus, [480, 700, 1000])}
                sizes="28vw"
                alt="Verfroller in een bak met witte verf"
                class="aspect-[4/3] w-full object-cover"
                loading="lazy" decoding="async"
              />
              <figcaption class="mt-2 text-xs text-grijs">Sfeerbeeld</figcaption>
            </figure>
          </div>
        </div>
        <ul class="lg:col-span-7 lg:col-start-6" role="list">
          {diensten.map((d) => (
            <li class="rij grid gap-x-8 gap-y-1 border-t border-bitumen py-6 first:border-t-2 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
              <div>
                <h3 class="text-2xl uppercase">{d.naam}</h3>
                <p class="mt-1 text-sm font-semibold text-klei">{d.extra}</p>
              </div>
              <p class="text-grijs">{d.uitleg}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Reviews: het cijfer groot als bewijs, de citaten ernaast. -->
    <section id="reviews" class="op-donker scroll-mt-4 bg-bitumen py-20 text-kalk lg:py-32" aria-labelledby="reviews-kop">
      <div class="wrap grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <span class="rei" aria-hidden="true"></span>
          <h2 id="reviews-kop" class="mt-6 text-3xl uppercase">Wat klanten schrijven</h2>
          <p class="smal mt-8 text-[clamp(6rem,4rem+8vw,11rem)] font-extrabold leading-[0.8] tracking-[-0.04em] text-oker">{site.score}</p>
          <p class="mt-4 text-kalk/90">uit {site.aantalReviews} Google-reviews. Op stukadoorgids.nl met de badge Top Score 2026.</p>
          <a href={site.reviewsBron} class="mt-4 inline-block text-sm font-semibold text-oker underline underline-offset-4">Alle reviews op stukadoorgids.nl</a>
        </div>
        <div class="grid gap-12 lg:col-span-7 lg:col-start-6">
          <ul class="grid gap-10" role="list">
            {reviews.map((r) => (
              <li class="rij">
                <figure class="border-l-2 border-oker pl-5">
                  <blockquote class="text-xl font-semibold leading-snug sm:text-2xl">“{r.tekst}”</blockquote>
                  <figcaption class="mt-3 text-sm text-kalk/80">{r.naam} op Google, {r.datum}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
          <div class="rij border-t border-kalk/20 pt-10">
            <h3 class="text-xl uppercase text-oker">Wat klanten ook noemen</h3>
            <dl class="mt-6 grid gap-8 sm:grid-cols-2">
              {genoemd.map((g) => (
                <div>
                  <dt class="text-lg font-bold">{g.kop}</dt>
                  <dd class="mt-2 text-kalk/85">{g.tekst}</dd>
                  <dd class="mt-2 text-xs text-kalk/70">{g.wie}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Over: de muur met spaansporen als beeld, de feiten als een rijtje op de bouwplaat. -->
    <section id="over" class="scroll-mt-4 py-20 lg:py-32" aria-labelledby="over-kop">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center">
        <figure class="rij lg:col-span-5">
          <img
            src={foto.muur(900)}
            srcset={srcset(foto.muur, [480, 720, 900, 1200])}
            sizes="(min-width: 1024px) 38vw, 100vw"
            alt="Gladde grijze muur met lichte sporen van de spaan"
            class="aspect-[4/3] w-full object-cover lg:aspect-[3/4]"
            loading="lazy" decoding="async"
          />
          <figcaption class="mt-2 text-xs text-grijs">Sfeerbeeld</figcaption>
        </figure>
        <div class="rij lg:col-span-6 lg:col-start-7">
          <span class="rei" aria-hidden="true"></span>
          <h2 id="over-kop" class="mt-6 text-4xl uppercase">Een familiebedrijf uit Hoogvliet</h2>
          <p class="mt-6 max-w-xl text-lg">Stuca-Paint staat sinds {site.sinds} ingeschreven als stukadoorsbedrijf in {site.plaats}. In de reviews komen steeds dezelfde twee namen terug, Ruud en Mike, vader en zoon.</p>
          <p class="mt-4 max-w-xl text-grijs">Een klus begint met een bezoek voor de offerte. Een klant schreef dat hij toen precies hoorde wat hij zelf moest voorbereiden en wat het ging kosten.</p>
          <dl class="mt-10 grid max-w-xl grid-cols-2 gap-x-8 border-t-2 border-bitumen">
            <div class="border-b border-lijn py-4"><dt class="text-xs font-bold uppercase tracking-[0.04em] text-grijs">Ingeschreven</dt><dd class="smal mt-1 text-2xl font-extrabold">Sinds 2000</dd></div>
            <div class="border-b border-lijn py-4"><dt class="text-xs font-bold uppercase tracking-[0.04em] text-grijs">Google</dt><dd class="smal mt-1 text-2xl font-extrabold">{site.score} uit {site.aantalReviews}</dd></div>
            <div class="border-b border-lijn py-4"><dt class="text-xs font-bold uppercase tracking-[0.04em] text-grijs">Adres</dt><dd class="mt-1 font-semibold">{site.straat}, {site.plaats}</dd></div>
            <div class="border-b border-lijn py-4"><dt class="text-xs font-bold uppercase tracking-[0.04em] text-grijs">KvK</dt><dd class="mt-1 font-semibold">{site.kvk}</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Contact: gegevens links, het formulier als werkbon rechts. -->
    <section id="contact" class="scroll-mt-4 border-t border-lijn bg-teer py-20 text-kalk op-donker lg:py-32" aria-labelledby="contact-kop">
      <div class="wrap grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="rei" aria-hidden="true"></span>
          <h2 id="contact-kop" class="mt-6 text-4xl uppercase">Wat moet er gebeuren?</h2>
          <p class="mt-6 max-w-md text-kalk/85">Bel of mail, en vertel om welke muren of plafonds het gaat. Dan komt er iemand langs voor de offerte.</p>
          <div class="mt-10 grid gap-8">
            <div>
              <p class="text-sm text-kalk/75">Bellen</p>
              <a href={site.mobielHref} class="smal mt-1 block whitespace-nowrap text-4xl font-extrabold text-oker underline-offset-4 hover:underline">{site.mobiel}</a>
            </div>
            <div>
              <p class="text-sm text-kalk/75">Mailen</p>
              <a href={`mailto:${site.mail}`} class="mt-1 block break-all font-semibold underline underline-offset-4">{site.mail}</a>
            </div>
            <div>
              <p class="text-sm text-kalk/75">Adres</p>
              <p class="mt-1">{site.straat}<br />{site.postcode} {site.stad}</p>
              <a href={site.route} class="mt-2 inline-block text-sm font-semibold underline underline-offset-4">Route in Google Maps</a>
            </div>
            <div>
              <p class="text-sm text-kalk/75">Bereikbaar</p>
              <dl class="mt-1">
                {openingstijden.map((o) => (
                  <div class="flex flex-wrap justify-between gap-x-6 border-b border-kalk/20 py-2"><dt>{o.dag}</dt><dd class="font-semibold">{o.tijd}</dd></div>
                ))}
              </dl>
            </div>
          </div>
        </div>

        <form class="werkbon bg-kalk p-6 text-bitumen sm:p-9 lg:col-span-6 lg:col-start-7 lg:self-start" onsubmit="return false" aria-labelledby="werkbon-kop" aria-describedby="formulier-noot">
          <div class="flex items-end justify-between gap-4 border-b-[3px] border-bitumen pb-3">
            <h3 id="werkbon-kop" class="text-3xl uppercase">Werkbon</h3>
            <span class="smal text-right text-sm font-extrabold uppercase leading-tight">Stuca-Paint<br />{site.plaats}</span>
          </div>
          <div class="mt-2 grid sm:grid-cols-2 sm:gap-x-8">
            <label class="werkbon-veld"><span>Naam</span><input name="naam" autocomplete="name" /></label>
            <label class="werkbon-veld"><span>Telefoon</span><input name="telefoon" type="tel" autocomplete="tel" /></label>
          </div>
          <label class="werkbon-veld"><span>E-mail</span><input name="email" type="email" autocomplete="email" /></label>
          <label class="werkbon-veld"><span>Adres van de klus</span><input name="adres" autocomplete="street-address" /></label>
          <label class="werkbon-veld border-b-0"><span>Wat moet er gebeuren?</span><textarea name="bericht" rows="4" placeholder="Bijvoorbeeld het plafond in de woonkamer sausklaar, ongeveer 30 m²"></textarea></label>
          {site.voorstel ? (
            <p id="formulier-noot" class="mt-6 border-l-4 border-oker bg-pleister px-4 py-3 text-sm text-grijs">Dit is een ontwerpvoorstel, de werkbon verstuurt nog niets. Bel <a href={site.mobielHref} class="whitespace-nowrap font-semibold text-bitumen underline">{site.mobiel}</a> of mail naar <a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] font-semibold text-bitumen underline">{site.mail}</a>.</p>
          ) : (
            <p id="formulier-noot" class="mt-6 text-sm text-grijs">U krijgt zo snel mogelijk antwoord.</p>
          )}
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>
