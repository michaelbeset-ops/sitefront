---
import { site, url, whatsapp, kennisMail } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="relative z-30 bg-papier">
    <div class="wrap flex h-16 items-center justify-between gap-6 md:h-[4.75rem]">
      <a href={url('')} class="flex flex-col no-underline" aria-label={`${site.naam}, naar de homepage`}>
        <span class="text-[1.65rem] leading-none tracking-[-.02em] md:text-[1.9rem]"><span class="text-cyaan-tekst">Xpertise</span>Wonen</span>
        <span class="mono mt-0.5 hidden text-[.62rem] text-grijs md:block">Zorgvastgoed &amp; Woningmarkt Professionals</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-9 text-[1.1rem]">
          <li><a href={url('#plattegrond')} class="transition-colors hover:text-cyaan-tekst">Diensten</a></li>
          <li><a href={url('#werk')} class="transition-colors hover:text-cyaan-tekst">Kernactiviteiten</a></li>
          <li><a href={url('#contact')} class="transition-colors hover:text-cyaan-tekst">Contact</a></li>
        </ul>
      </nav>
      <a href={whatsapp} class="inline-flex items-center gap-2 rounded-lg border border-cyaan-tekst/40 px-3 py-1.5 text-[1.05rem] text-cyaan-tekst no-underline transition-colors hover:bg-was">
        <span class="h-2 w-2 rounded-full bg-cyaan"></span>WhatsApp
      </a>
    </div>
  </header>
) : (
  <footer class="border-t border-lijn">
    <div class="wrap grid gap-8 py-12 md:grid-cols-12">
      <p class="text-[1.9rem] leading-none tracking-[-.02em] md:col-span-5"><span class="text-cyaan-tekst">Xpertise</span>Wonen</p>
      <p class="text-grijs md:col-span-4">{site.straat}<br />{site.postcode} {site.plaats}<br /><a href={kennisMail} class="lijn break-all">{site.mail}</a></p>
      <p class="text-grijs md:col-span-3 md:text-right"><a href={url('privacy/')} class="lijn">Privacyverklaring</a><br />KvK [[AANLEVEREN: KvK-nummer]]</p>
    </div>
    {site.voorstel && <p class="wrap mono pb-8 text-grijs">Foto's van uw eigen website. Ontwerpvoorstel, ter illustratie.</p>}
  </footer>
)}
