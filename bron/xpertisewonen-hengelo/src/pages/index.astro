---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import ludan from '../assets/ludan.jpg';
import kantoor from '../assets/kantoor.jpg';
import { site, url, whatsapp, kennisMail, kamers } from '../data/site';
const wa = `<svg viewBox="0 0 24 24" class="h-[1.1em] w-[1.1em]" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/></svg>`;
const activiteiten = [
  'Programmabegeleiding op het gebied van wonen, zorg en welzijn',
  'Vastgoedstrategieën voor zorgaanbieders, woningcorporaties en investeerders',
  'Beleidsontwikkeling voor gemeenten',
  'Gebiedsgericht onderzoek naar langer zelfstandig thuis wonen',
  'Locatie- en haalbaarheidsonderzoek',
  'Levensloopbestendige en duurzame woningen (nul op de meter)',
];
---
<Base title={`${site.naam} | Wonen, woonzorg en zorgvastgoed, Hengelo`} description="XpertiseWonen in Hengelo: onderzoek, advies, innovatie en projectmatige of interim inzet op het snijvlak van wonen en zorg.">
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- 1. Kop links op tekenpapier, de oprichter rechts tot aan de rand -->
    <section class="grid border-t border-lijn lg:min-h-[calc(100svh-6.85rem)] lg:grid-cols-12">
      <figure class="relative h-[15.5rem] overflow-hidden sm:h-[22rem] lg:order-2 lg:col-span-6 lg:h-auto">
        <Foto src={ludan} alt="Ludan Schmid in pak voor een bakstenen huis, met in elke hand een verhuisdoos." hero sizes="(min-width: 1024px) 50vw, 100vw" class="object-[56%_30%]" />
        <figcaption class="mono absolute bottom-0 left-0 bg-papier px-3 py-2 text-inkt md:px-4">Ludan Schmid, oprichter</figcaption>
      </figure>
      <div class="flex flex-col justify-between px-5 pb-8 pt-7 md:px-12 lg:order-1 lg:col-span-6 lg:pb-10 lg:pl-[max(3rem,calc((100vw-90rem)/2+3rem))] lg:pt-[6vh]">
        <div>
          <p class="mono text-cyaan-tekst">Wonen, woonzorg en zorgvastgoed <span class="text-grijs">/ Hengelo</span></p>
          <h1 class="mt-4 text-[clamp(2.9rem,13vw,3.6rem)] md:mt-6 md:text-[clamp(3.6rem,6.2vw,6.4rem)]">Thuis op de markt van wonen en woonzorg.</h1>
          <p class="mt-5 max-w-[32rem] text-lg leading-snug text-grijs md:mt-8 md:text-[1.45rem]">Onderzoek, advies, innovatie en projectmatige of interim inzet, op het snijvlak van de woningmarkt en de zorg.</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 md:mt-10">
            <a href={whatsapp} class="knop"><Fragment set:html={wa} />App Ludan</a>
            <a href={site.telHref} class="lijn text-[1.12rem]">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
        </div>
        <!-- het eigen detail: twee kamers, wonen en zorg, met een deur in de gedeelde muur -->
        <a href={url('#plattegrond')} class="group mt-10 hidden items-end gap-5 no-underline md:flex" aria-label="Naar de vier diensten">
          <svg viewBox="0 0 220 92" class="h-[5.75rem] w-[13.75rem] text-cyaan" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-linecap="square">
              <path d="M2 2h216v88H2z" stroke-width="3" />
              <path d="M110 2v30M110 62v28" stroke-width="3" />
              <path d="M110 32a30 30 0 0 1 30 30" stroke-width="1" stroke-dasharray="3 3" />
              <path d="M110 32l30 0" stroke-width="1.5" />
            </g>
            <text x="20" y="52" class="mono" font-size="11" fill="#262b30">wonen</text>
            <text x="160" y="52" class="mono" font-size="11" fill="#262b30">zorg</text>
          </svg>
          <span class="mono pb-1 text-grijs transition-colors group-hover:text-cyaan-tekst">Het snijvlak: bekijk de plattegrond</span>
        </a>
      </div>
    </section>

    <!-- 2. De plattegrond: vier diensten als vier kamers -->
    <section id="plattegrond" class="ruit border-y border-lijn py-20 md:py-28" aria-labelledby="pl-kop">
      <div class="wrap">
        <div class="grid grid-cols-12 gap-x-6 gap-y-6">
          <h2 id="pl-kop" class="col-span-12 text-2xl lg:col-span-6">Twee complexe werelden, één adres.</h2>
          <p class="col-span-12 max-w-xl text-grijs lg:col-span-5 lg:col-start-8 lg:pt-2">Het scheiden van wonen en zorg raakt de zorg, de huisvesting en het zorgvastgoed, en ook de woningmarkt. Samen met XpertiseZorg overzien we beide kanten.</p>
        </div>
        <div class="relative mt-14 grid border-[3px] border-cyaan bg-papier md:mt-20 md:grid-cols-2">
          {kamers.map((k, i) => (
            <div class:list={['relative p-6 md:p-10 lg:p-12', i % 2 === 0 && 'md:border-r-[3px] md:border-cyaan', i < 2 && 'md:border-b-[3px] md:border-cyaan', i < 3 && 'max-md:border-b-[3px] max-md:border-cyaan']}>
              <p class="mono text-cyaan-tekst">Ruimte {i + 1}</p>
              <h3 class="mt-3 text-xl">{k.naam}</h3>
              <p class="mt-4 max-w-md text-grijs">{k.tekst}</p>
              {i === 0 && <span class="absolute -right-[4px] top-1/2 hidden h-16 w-[5px] -translate-y-1/2 bg-papier md:block" aria-hidden="true"></span>}
            </div>
          ))}
        </div>
        <p class="mono mt-4 flex justify-between text-grijs"><span>XpertiseWonen, plattegrond</span><span>4 ruimten, 1 gedeelde deur</span></p>
      </div>
    </section>

    <!-- 3. Kernactiviteiten naast het kantoor -->
    <section id="werk" class="py-20 md:py-28" aria-labelledby="werk-kop">
      <div class="wrap grid grid-cols-12 gap-x-6 gap-y-12">
        <div class="col-span-12 lg:col-span-6">
          <h2 id="werk-kop" class="text-2xl">Van bewoner, via cliënt, naar klant.</h2>
          <p class="mt-6 max-w-lg text-grijs">De route die symbool staat voor de mentaliteitsverandering in de zorg; de mede door ons ontwikkelde training Verzorgd Verhuren helpt daarbij. Verder werken we aan:</p>
          <ul class="mt-8 border-t border-lijn">
            {activiteiten.map((a) => <li class="flex gap-4 border-b border-lijn py-3.5"><span class="mt-[.7em] h-px w-5 shrink-0 bg-cyaan"></span><span>{a}</span></li>)}
          </ul>
        </div>
        <figure class="col-span-12 lg:col-span-5 lg:col-start-8">
          <div class="aspect-[4/5] overflow-hidden"><Foto src={kantoor} alt="Het pand aan de Enschedesestraat in Hengelo: gele baksteen, grote witte ramen en een tuin met een boom." sizes="(min-width: 1024px) 40vw, 100vw" /></div>
          <figcaption class="mono mt-3 text-grijs">{site.straat}, {site.plaats}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Contact -->
    <section id="contact" class="bg-was py-20 md:py-28" aria-labelledby="contact-kop">
      <div class="wrap grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 lg:col-span-7">
          <h2 id="contact-kop" class="text-2xl">Een vraagstuk dat u realistisch en doelgericht wilt aanpakken?</h2>
          <p class="mt-6 max-w-lg text-grijs">Maak vrijblijvend kennis. U spreekt meteen met {site.eigenaar}.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={whatsapp} class="knop"><Fragment set:html={wa} />WhatsApp</a>
            <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a>
            <a href={kennisMail} class="lijn break-all">{site.mail}</a>
          </div>
        </div>
        <div class="col-span-12 border-t border-cyaan pt-6 lg:col-span-4 lg:col-start-9">
          <p class="mono text-cyaan-tekst">Adres</p>
          <p class="mt-2 text-lg">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-3"><a href={site.maps} class="lijn">Route in Google Maps</a></p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
