---
// Woordmerk naar hun logo: schuin, COBO in oranje, TRAILERS in grijs.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = 'text-[1.35rem] md:text-[1.6rem]' } = Astro.props;
---
<a href={url('')} class={`kop schuin block whitespace-nowrap leading-none tracking-[-0.01em] no-underline ${cls}`} aria-label="COBOTRAILERS, naar de homepage">
  <span class={licht ? 'text-cobo-diep' : 'text-cobo'}>COBO</span><span class={licht ? 'text-[#6f7275]' : 'text-zilver'}>TRAILERS</span>
</a>
