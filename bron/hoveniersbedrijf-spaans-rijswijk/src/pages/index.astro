---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waAfspraak, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import heroMobiel from '../assets/hero-m.jpg';
import tekening1 from '../assets/tekening-1.jpg';
import tekening2 from '../assets/tekening-2.jpg';
import lounge from '../assets/terras-lounge.jpg';
import border from '../assets/border.jpg';
import overkapping from '../assets/overkapping.jpg';
import hoekbank from '../assets/hoekbank.jpg';
import vlonder from '../assets/vlonder.jpg';
import grindpad from '../assets/grindpad.jpg';
import stadstuin from '../assets/stadstuin.jpg';
import vlondertrap from '../assets/vlondertrap.jpg';
import rik from '../assets/rik.jpg';
import bus from '../assets/bus.jpg';

const heroM = await getImage({ src: heroMobiel, widths: [480, 720], format: 'webp', quality: 45 });

const vraag = (d: string) => waMet(`Hallo Rik, ik heb een vraag over ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Aanleg', s: 'Van tekening naar praktijk', d: 'Het ontwerp ligt er, het echte werk gaat beginnen. Tijdens de aanleg houdt Rik u op de hoogte van de vorderingen.', src: lounge, alt: 'Terras met grote grijze tegels, een loungebank met kussens en borders met bloeiende planten', pos: '50% 60%' },
  { t: 'Onderhoud', s: 'Alles in en om de tuin', d: 'Snoeiwerk, maaiwerk en onkruid wieden. Ook als de tuin niet door hem is aangelegd.', src: border, alt: 'Border met paarse sierui, witte klokjes en lavendel naast een tuinbank', pos: '50% 50%' },
  { t: 'Bouwprojecten', s: 'Schuur, schutting, terras en meer', d: "Tuinkasten, schuurtjes, schuttingen, veranda's, pergola's, vijvers, hekken en muurtjes.", src: overkapping, alt: 'Zwarte houten overkapping met een open zijkant, een houten vlonder en grijze tegels', pos: '50% 55%' },
  { t: 'Tuinmeubilair op maat', s: 'Banken, tafels, stoelen en zo', d: 'Met de hand naar uw wens gemaakt, voornamelijk van hout. Nergens te koop.', src: hoekbank, alt: 'Houten hoekbank met bergruimte, op maat gemaakt voor een stadstuin', pos: '50% 55%' },
];

const werk = [
  { src: vlonder, alt: 'Nieuwe hardhouten vlonder in een organische vorm, nat glanzend na een regenbui', cls: 'col-span-2 row-span-2' },
  { src: grindpad, alt: 'Grindpad onder een houten pergola, met aan weerszijden weelderige beplanting', cls: 'row-span-2' },
  { src: stadstuin, alt: 'Stadstuin achter een wit herenhuis met slingerende paden en volle borders', cls: '' },
  { src: vlondertrap, alt: 'Houten trap van losse vlonderdelen tegen een glooiend gazon', cls: '' },
];

const stappen = [
  ['Persoonlijk gesprek', 'Hoeveel werk is er aan de tuin, past hij bij de stijl van uw huis, hoeveel onderhoud wilt u en wat is uw budget?'],
  ['Altijd eerst een tekening', 'Uw wensen staan centraal. Rik vult ze aan met zijn professionele kijk op tuinen en zet het op papier.'],
  ['Aanleg met duidelijke afspraken', 'U blijft op de hoogte van de vorderingen. In samenspraak houden we de overlast zo klein mogelijk.'],
  ['Netjes achterlaten', 'Spullen opruimen en het stoepje aanvegen na het werk, ook als er de volgende dag verder wordt gewerkt.'],
];

const vragen = [
  { n: 'werk', l: 'Wat wilt u laten doen?', o: ['Een volledig nieuwe tuin', 'Mijn huidige tuin renoveren', 'Onderhoud', 'Een bouwproject', 'Tuinmeubilair op maat'] },
  { n: 'stijl', l: 'Hoe moet de tuin aansluiten op uw huis?', o: ['Juist harmonie', 'Graag een groot contrast', 'Weet ik nog niet'] },
  { n: 'onderhoud', l: 'Hoeveel onderhoud wilt u?', o: ['Zo onderhoudsvrij mogelijk', 'Ik houd van tuinieren', 'Iets ertussenin'] },
  { n: 'deel', l: 'Om welk deel gaat het?', o: ['Voortuin', 'Achtertuin', 'Voor- én achtertuin'] },
];
---
<Base title={`${site.naam} | Hovenier in Rijswijk en Delft`} description="Hoveniersbedrijf Spaans: tuinontwerp, aanleg en onderhoud, kleine bouwprojecten en tuinmeubilair op maat. Rik Spaans, Sionsweg 10 Rijswijk. 4,6 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <picture>
        <source media="(max-width: 767px)" srcset={heroM.srcSet.attribute} sizes="100vw" type="image/webp" />
        <Image src={hero} alt="" widths={[960, 1400, 2000]} sizes="100vw" quality={50} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_45%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#13201a99_0%,#13201ac8_40%,#13201af5_100%)] md:bg-[linear-gradient(90deg,#13201af2_0%,#13201ad0_40%,#13201a26_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-9">
          <p class="eyebrow">Hovenier in Rijswijk en Delft</p>
          <h1 id="t-hero" class="mt-5 max-w-[15ch] text-hero">Een tuin van kwaliteit voor jaren van <span class="text-blad">tuinplezier.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Ontwerp, aanleg en onderhoud, tot kleine bouwprojecten en op maat gemaakt tuinmeubilair. Met oprechte aandacht voor uw wensen.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#planner" class="knop knop-groen">Plan een kennismaking<Icoon naam="pijl" /></a>
            <a href="#werk" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 17.00 uur</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-3 lg:block">
          <figure class="ml-auto w-full max-w-[16rem] -rotate-2 rounded-md bg-wit p-3 pb-4 text-inkt shadow-md">
            <Image src={tekening2} alt="Handgetekend tuinontwerp met terras, borders, bomen en een schuur, door Rik Spaans" widths={[320, 600]} sizes="260px" loading="lazy" class="aspect-[4/5] w-full rounded-sm object-cover object-top" />
            <figcaption class="flex items-center gap-2 px-1 pt-3 text-sm font-medium"><Icoon naam="potlood" class="h-4 w-4 text-groen" />Altijd eerst een tekening</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Werkzaamheden in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-full bg-mos px-3.5 py-1.5 text-[.875rem] font-medium no-underline transition-colors hover:bg-groen hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-20" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Dit doe ik voor u</p>
            <h2 id="t-dienst" class="mt-4 text-3xl">Van eerste schets tot het laatste snoeiwerk.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een nieuwe tuin, een renovatie, die roos die gesnoeid moet worden of dat schuurtje dat al jaren aan vervanging toe is.</p>
        </div>

        <div class="mt-12 grid gap-4 lg:mt-14 lg:grid-cols-12 lg:gap-6">
          <!-- Ontwerp: de tekening als hoofdkaart -->
          <a href={vraag('een tuinontwerp')} class="rijs donker group relative flex flex-col overflow-hidden rounded-md bg-nacht text-licht no-underline lg:col-span-5 lg:row-span-2">
            <div class="grid flex-1 grid-cols-2 gap-3 p-4 pb-0 sm:gap-4 sm:p-6 sm:pb-0 lg:min-h-0">
              <Image src={tekening1} alt="Handgetekend ontwerp van een achtertuin in Rijswijk met gazon, borders en twee terrassen" widths={[300, 500]} sizes="(min-width: 1024px) 220px, 45vw" class="aspect-[3/4] h-full w-full rotate-[-1.5deg] rounded-sm bg-wit object-cover object-top lg:aspect-auto transition-transform duration-500 group-hover:rotate-0" />
              <Image src={tekening2} alt="Handgetekend ontwerp met tegelpaden, borders, bomen en een schuur" widths={[300, 500]} sizes="(min-width: 1024px) 220px, 45vw" class="mt-6 aspect-[3/4] h-[calc(100%-1.5rem)] w-full rotate-[1.5deg] rounded-sm bg-wit object-cover object-top lg:aspect-auto transition-transform duration-500 group-hover:rotate-0" />
            </div>
            <div class="flex flex-col justify-end p-6 pt-8 sm:p-8">
              <p class="eyebrow">Een tuin op maat</p>
              <h3 class="mt-3 text-2xl">Ontwerp</h3>
              <p class="mt-3 text-licht-zacht">Een tuin ontwerpen is maatwerk. Daarom maakt Rik altijd eerst een tekening, samen met u, zodat uw tuin echt uw tuin wordt.</p>
              <span class="mt-6 inline-flex items-center gap-2 font-semibold text-blad">Vraag een ontwerp aan<Icoon naam="pijl" class="h-5 w-5 transition-transform group-hover:translate-x-1" /></span>
            </div>
          </a>

          <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:gap-6">
            {diensten.map((b, i) => (
              <li class="rijs" style={`--d:${(i % 2) * 0.06}s`}>
                <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                  <div class="overflow-hidden">
                    <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 340px, (min-width: 640px) 45vw, 92vw" quality={60} class="aspect-[16/9] w-full object-cover transition-transform sm:aspect-[16/10] duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                  </div>
                  <div class="flex flex-1 items-end justify-between gap-4 p-5 sm:p-6">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[.14em] text-groen">{b.s}</p>
                      <h3 class="mt-1.5 text-xl">{b.t}</h3>
                      <p class="mt-2 text-[.9375rem] text-grijs">{b.d}</p>
                    </div>
                    <span class="hidden h-10 w-10 shrink-0 place-items-center rounded-sm bg-mos text-groen transition-colors group-hover:bg-groen group-hover:text-wit sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 4. Projecten -->
    <section id="werk" class="bg-mos py-20 lg:py-20" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-8">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-werk" class="mt-4 text-3xl">Uw tuin is mijn belangrijkste visitekaartje.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-grijs">Een greep uit tuinen die Hoveniersbedrijf Spaans heeft aangelegd. Recent werk verschijnt op Instagram.</p>
            <a href={site.instagram} class="knop knop-rand knop-klein mt-6"><Icoon naam="insta" />Volg op Instagram</a>
          </div>
        </div>
        <ul class="mt-12 grid auto-rows-[10rem] grid-cols-2 gap-3 sm:auto-rows-[13rem] md:grid-cols-4 md:gap-4 lg:mt-14 lg:auto-rows-[15rem]">
          {werk.map((w, i) => (
            <li class={`rijs relative overflow-hidden rounded-md bg-nacht-2 ${w.cls}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={[400, 700, 1000]} sizes="(min-width: 768px) 48vw, 92vw" quality={60} class="tegel absolute inset-0 h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-20" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Mijn werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Samen maken we de beste tuin.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Door te praten en ideeën uit te wisselen komen we tot een beter resultaat. Zo betrekt Rik u bij elke stap.</p>
        </div>
        <ol class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 lg:mt-14 lg:grid-cols-4 lg:gap-6">
          {stappen.map(([t, d], i) => (
            <li class="rijs relative border-t-2 border-groen pt-6" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2rem] font-semibold leading-none text-groen sm:text-[2.5rem]">0{i + 1}</p>
              <h3 class="mt-4 text-lg sm:mt-5 sm:text-xl">{t}</h3>
              <p class="mt-2 text-[.9375rem] text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. Wow: kennismaking voorbereiden -->
    <section id="planner" class="donker bg-nacht py-20 text-licht lg:py-20" aria-labelledby="t-planner">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Kennismaking plannen</p>
          <h2 id="t-planner" class="mt-4 text-3xl">Bereid het gesprek over uw tuin voor.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Dit zijn de punten die Rik in het eerste gesprek altijd met u doorneemt. Klik aan wat bij u past: er rolt een WhatsApp-bericht uit waarmee hij meteen weet waar het over gaat.</p>
          <p class="mt-8 flex items-start gap-3 text-licht-zacht"><Icoon naam="blad" class="mt-0.5 h-5 w-5 shrink-0 text-blad" /><span>Een tuin mét veel planten kan ook zeer onderhoudsvrij zijn. En voor elk budget is een tuin mogelijk.</span></p>
          <figure class="mt-10 border-l-2 border-blad pl-6">
            <blockquote class="font-kop text-[1.375rem] font-medium leading-snug tracking-[-0.01em]">“Eén prijs voor een tuin is er niet. Goedkoop vind ik prima, maar kwaliteit van uw tuin staat voorop.”</blockquote>
            <figcaption class="mt-4 flex items-center gap-3">
              <Image src={rik} alt="" widths={[120]} sizes="48px" class="h-12 w-12 rounded-full object-cover object-[18%_30%]" />
              <span class="text-sm"><b class="block font-semibold text-licht">Rik Spaans</b><span class="text-licht-zacht">over prijzen</span></span>
            </figcaption>
          </figure>
        </div>
        <form class="min-w-0 rounded-md bg-nacht-2 p-6 ring-1 ring-lijn-licht sm:p-8 lg:col-span-7 lg:p-10" data-planner aria-describedby="pl-uitleg">
          {vragen.map((v, i) => (
            <fieldset class={i ? 'mt-7' : ''}>
              <legend class="flex items-center gap-3 text-sm font-semibold"><span class="num grid h-6 w-6 place-items-center rounded-full bg-groen text-xs text-wit">{i + 1}</span>{v.l}</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                {v.o.map((o, j) => (
                  <label class="keuze"><input type="radio" name={v.n} value={o} class="sr-only" checked={i === 0 && j === 0} /><span>{o}</span></label>
                ))}
              </div>
            </fieldset>
          ))}
          <div class="mt-8 rounded-sm bg-nacht p-5 text-[.9375rem]">
            <p class="text-xs font-semibold uppercase tracking-[.14em] text-blad">Uw bericht aan Rik</p>
            <p class="mt-3 whitespace-pre-line text-licht" data-voorbeeld aria-live="polite"></p>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-groen"><Icoon naam="wa" />Verstuur via WhatsApp</button>
            <p id="pl-uitleg" class="text-sm text-licht-zacht">Er gaat pas iets weg als u in WhatsApp op verzenden drukt.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 7. Over Rik -->
    <section id="over" class="py-20 lg:py-20" aria-labelledby="t-over">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-14">
        <div class="relative lg:col-span-5">
          <Image src={rik} alt="Rik Spaans naast zijn witte bedrijfsbus met het groene spiraallogo" widths={[500, 800, 1100]} sizes="(min-width: 1024px) 460px, 92vw" class="aspect-[4/5] w-full rounded-md object-cover object-[22%_50%]" />
          <p class="absolute -bottom-5 left-5 rounded-sm bg-groen px-5 py-3 text-wit shadow-md"><span class="num block font-kop text-2xl font-semibold leading-none">1 april 2012</span><span class="text-sm">start eigen bedrijf</span></p>
        </div>
        <div class="lg:col-span-7">
          <p class="eyebrow">Over Rik Spaans</p>
          <h2 id="t-over" class="mt-4 text-3xl">Al van kleins af aan wilde hij hovenier worden.</h2>
          <div class="mt-6 space-y-4 text-lg text-grijs">
            <p>Toen heette dat nog tuinman. Na de tuinbouwschool in Maasland volgde Rik de vierjarige MBO-opleiding tuin, park en landschap in Rijswijk, met stages in binnen- en buitenland.</p>
            <p>Daarna werkte hij vijf jaar bij een erkend hoveniersbedrijf bij Delft, waar hij al snel meewerkend voorman werd. Op 1 april 2012 begon hij Hoveniersbedrijf Spaans.</p>
          </div>
          <ul class="mt-8 grid gap-3 sm:grid-cols-3">
            <li class="kaart p-5"><Icoon naam="praat" class="h-6 w-6 text-groen" /><h3 class="mt-3 text-lg sm:mt-4">Oprechte aandacht</h3><p class="mt-1.5 text-[.9375rem] text-grijs">Voor uw wensen, vanaf het eerste gesprek.</p></li>
            <li class="kaart p-5"><Icoon naam="bezem" class="h-6 w-6 text-groen" /><h3 class="mt-4 text-lg">Netjes en verzorgd</h3><p class="mt-1.5 text-[.9375rem] text-grijs">Een opgeruimde werkplek, ook voor de buren.</p></li>
            <li class="kaart p-5"><Icoon naam="kwaliteit" class="h-6 w-6 text-groen" /><h3 class="mt-4 text-lg">Kwaliteit voorop</h3><p class="mt-1.5 text-[.9375rem] text-grijs">In de aanleg én in de materialen.</p></li>
          </ul>
          <p class="mt-8 text-sm text-grijs"><b class="font-semibold text-inkt">Cursussen o.a.:</b> plantenkennis, snoeivaardigheden, maaitechnieken, onkruidbestrijding op verhardingen, Basisveiligheid VCA.</p>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="bg-mos py-20 lg:py-20" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-bold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class={`rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7 ${i > 2 ? 'md:hidden' : ''}`} style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-mos font-kop font-bold text-groen" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
