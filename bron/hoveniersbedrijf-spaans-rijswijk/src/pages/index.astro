<script>
  const f = document.querySelector<HTMLFormElement>('[data-planner]');
  const uit = document.querySelector<HTMLElement>('[data-voorbeeld]');
  if (f && uit) {
    const bericht = () => {
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hallo Rik, ik wil graag een afspraak maken voor een kennismaking over mijn tuin.'];
      if (v('werk')) r.push('Wat: ' + v('werk'));
      if (v('stijl')) r.push('Stijl: ' + v('stijl').toLowerCase());
      if (v('onderhoud')) r.push('Onderhoud: ' + v('onderhoud').toLowerCase());
      if (v('deel')) r.push('Deel: ' + v('deel').toLowerCase());
      return r.join('\n');
    };
    const toon = () => { uit.textContent = bericht(); };
    f.addEventListener('change', toon);
    toon();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31621494099?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
  }
</script>

