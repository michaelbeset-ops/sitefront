---
import { site, url, tijden, waAfspraak } from '../data/site';
import Icoon from './Icoon.astro';
import Teken from './Teken.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const diensten = ['Tuinontwerp', 'Aanleg', 'Onderhoud', 'Bouwprojecten', 'Tuinmeubilair op maat'];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <Teken />
        <span><b>Spaans</b><small>Hoveniersbedrijf</small></span>
      </a>
      <p class="mt-6 max-w-xs">Ontwerp, aanleg en onderhoud, tot kleine bouwprojecten en op maat gemaakt tuinmeubilair. Het eigen bedrijf van Rik Spaans, sinds 2012.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.instagram} class="grid h-10 w-10 place-items-center rounded-sm bg-nacht-2 text-licht transition-colors hover:bg-groen" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
        <a href={waAfspraak} class="grid h-10 w-10 place-items-center rounded-sm bg-nacht-2 text-licht transition-colors hover:bg-groen" aria-label="WhatsApp"><Icoon naam="wa" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {diensten.map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-blad">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-blad">{site.tel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-blad">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.maps} class="no-underline transition-colors hover:text-blad">Route plannen</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Bereikbaar</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Openingstijden</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-blad">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-blad">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw huidige website en uw Google-bedrijfsprofiel, ter illustratie. Reviews letterlijk van Google (stand 4 oktober 2026).</p>}
  </div>
</footer>
