---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Kleurenbalk from '../components/Kleurenbalk.astro';
import { Image } from 'astro:assets';
import fmsc from '../assets/fmsc-screenshot.png';
import { site, url, whatsapp, vraagMail, diensten } from '../data/site';
const wa = `<svg viewBox="0 0 24 24" class="h-[1.15em] w-[1.15em]" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/></svg>`;
const certs = [
  ['FileMaker Pro', 'Associate, Specialist, Expert'],
  ['FileMaker Server', 'Associate, Specialist, Expert'],
  ['Claris Connect', 'Associate, Specialist, Expert'],
  ['Claris Studio', 'Get started, Mastering'],
  ['AI in FileMaker Pro', 'Basic concepts, Fundamentals I en II'],
];
---
<Base title={`${site.naam} | Technische automatisering voor mkb en grafische markt, Eindhoven`} description="Onafhankelijk technisch adviesbureau in Eindhoven voor het mkb en de grafische markt: Apple en Windows, netwerk en beveiliging, FileMaker op maat.">
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- 1. De drukproef: kop links, hun eigen app als geplaatst beeld met snijtekens, onderaan de kleurenbalk -->
    <section class="wrap flex flex-col pt-7 md:pt-10 lg:min-h-[calc(100svh-6.85rem)]">
      <p class="mono flex flex-wrap gap-x-5 text-grijs"><span>Technisch adviesbureau</span><span>Bandalaan 22, Eindhoven</span><span class="hidden md:inline">Mac &amp; Windows</span></p>
      <div class="grid flex-1 grid-cols-12 items-center gap-x-6 gap-y-12 pb-10 pt-6 md:pt-8 lg:pb-12">
        <div class="col-span-12 lg:col-span-7">
          <h1 class="text-[clamp(2.7rem,11.6vw,3.5rem)] md:text-[clamp(3.5rem,7vw,6.6rem)]">Specialisten in technische automatisering<span class="text-rood">.</span></h1>
          <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-grijs md:mt-8 md:text-[1.32rem] md:leading-[1.55]">Onafhankelijk technisch adviesbureau voor het mkb en de grafische markt. Apple en Windows, netwerk en beveiliging, FileMaker op maat.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4 md:mt-10">
            <a href={whatsapp} class="knop"><Fragment set:html={wa} />WhatsApp ons</a>
            <a href={site.telHref} class="lijn text-[1.06rem]">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
        </div>
        <figure class="col-span-12 hidden sm:block lg:col-span-5">
          <div class="snij mx-auto max-w-[30rem] bg-wit px-5 pb-3 pt-5 md:px-7">
            <Image src={fmsc} alt="Venster van FMS Controller: de FileMaker Server draait, met verbonden clients, gehoste databases en knoppen om te starten en te stoppen." widths={[400, 552]} sizes="(min-width: 1024px) 26rem, 80vw" format="webp" quality={80} loading="eager" fetchpriority="high" class="mx-auto block h-auto w-full max-h-[58vh] object-contain" />
          </div>
          <figcaption class="mono mx-auto mt-6 flex max-w-[30rem] justify-between gap-4 whitespace-nowrap text-grijs"><span>FMS Controller 1.2.0</span><span>eigen app, gratis voor macOS</span></figcaption>
        </figure>
      </div>
      <Kleurenbalk class="pb-6" />
    </section>

    <!-- 2. Diensten: links de houding, rechts de lijst -->
    <section id="diensten" class="py-20 md:py-28" aria-labelledby="diensten-kop">
      <div class="wrap grid grid-cols-12 gap-x-6 gap-y-12">
        <div class="col-span-12 lg:col-span-5">
          <h2 id="diensten-kop" class="text-2xl">Apple en Windows, in één omgeving.</h2>
          <p class="mt-6 max-w-md text-grijs">We zijn niet gebonden aan een platform, besturingssysteem of merk. Op enkele uitzonderingen na leveren we geen apparatuur of software, dus ons advies is objectief.</p>
          <p class="mt-4 max-w-md text-grijs">We richten ons vooral op reclamebureaus en de grafische industrie, en net zo goed op ander mkb.</p>
        </div>
        <ol class="col-span-12 border-t border-inkt lg:col-span-6 lg:col-start-7">
          {diensten.map((d, i) => (
            <li class="flex gap-5 border-b border-lijn py-4 md:py-[1.1rem]">
              <span class="mono w-7 shrink-0 pt-1 text-rood">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[1.08rem] leading-snug md:text-[1.15rem]">{d}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 3. FileMaker: zwart vel, certificering als colofon -->
    <section id="filemaker" class="bg-inkt py-20 text-papier md:py-28" aria-labelledby="fm-kop">
      <div class="wrap grid grid-cols-12 gap-x-6 gap-y-12">
        <div class="col-span-12 lg:col-span-6">
          <h2 id="fm-kop" class="text-2xl">FileMaker op maat, door Claris gecertificeerd.</h2>
          <p class="mt-6 max-w-lg text-papier/75">Van een eenvoudig adressenbestand tot een volwaardig CRM of facturatiepakket, met koppelingen naar webshops en boekhoudpakketten.</p>
          <p class="mt-8"><a href={site.software} class="lijn hover:!text-geel">Bekijk onze eigen Mac-apps</a> <span class="text-papier/60">(FMS Controller, WayPoint Manager)</span></p>
        </div>
        <dl class="col-span-12 border-t border-lijn-licht lg:col-span-5 lg:col-start-8">
          {certs.map(([k, v]) => (
            <div class="grid grid-cols-[1fr_auto] gap-4 border-b border-lijn-licht py-4">
              <dt class="font-medium">{k}</dt><dd class="mono self-center text-right text-papier/70">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 4. Support en contact -->
    <section id="support" class="py-20 md:py-28" aria-labelledby="support-kop">
      <div class="wrap grid grid-cols-12 gap-x-6 gap-y-10">
        <h2 id="support-kop" class="col-span-12 text-2xl lg:col-span-5">Iets kapot? Vaak kijken we op afstand mee.</h2>
        <div class="col-span-12 space-y-4 text-grijs md:col-span-6 lg:col-span-3 lg:col-start-7">
          <p class="font-medium text-inkt">Op afstand</p>
          <p>Met TeamViewer nemen we uw muis en toetsenbord over en zien we wat er misgaat. Instellingen wijzigen of een kleine installatie kan dan meteen op afstand.</p>
        </div>
        <div class="col-span-12 space-y-4 text-grijs md:col-span-6 lg:col-span-3">
          <p class="font-medium text-inkt">Op locatie</p>
          <p>Moet er een onderdeel vervangen worden, of ligt de internetverbinding eruit, dan komen we langs.</p>
        </div>
      </div>
      <div id="contact" class="wrap mt-20 md:mt-28">
        <div class="snij bg-wit p-6 md:p-12">
          <div class="grid grid-cols-12 gap-x-6 gap-y-8">
            <div class="col-span-12 lg:col-span-7">
              <p class="text-xl font-bold tracking-[-.02em]">Dringend, zoals een storing of installatie? Bel of app direct.</p>
              <p class="mt-6"><a href={site.telHref} class="text-[clamp(2.3rem,5.4vw,4.4rem)] font-bold leading-none tracking-[-.04em] tabular-nums no-underline transition-colors hover:text-rood">{site.tel}</a></p>
              <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
                <a href={whatsapp} class="knop"><Fragment set:html={wa} />WhatsApp</a>
                <a href={vraagMail} class="lijn">{site.mail}</a>
              </div>
            </div>
            <div class="col-span-12 text-grijs lg:col-span-4 lg:col-start-9">
              <p>Mailt u, dan streven we naar een antwoord binnen twee werkdagen.</p>
              <p class="mt-6 text-inkt">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</p>
              <p class="mt-3"><a href={site.maps} class="lijn">Route in Google Maps</a></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
