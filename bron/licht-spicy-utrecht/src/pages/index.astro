---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, menu, rijst, toetjes, waHoi } from '../data/site';
import hero from '../assets/hero.jpg';
import kavitha from '../assets/kavitha.png';
import paneer from '../assets/paneer.jpg';
import biryani from '../assets/biryani.jpg';
import pannen from '../assets/pannen.jpg';
import kaartjes from '../assets/kaartjes.jpg';
import indiaVlees from '../assets/india-vlees.png';
import indiaVeg from '../assets/india-veg.png';

const plus = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
---
<Base title="Licht spicy | Zuid-Indiase catering in Utrecht" description="Zuid-Indiase catering uit Utrecht. Kavitha kookt vers, met verse ingrediënten en smaakvolle kruiden, voor uw feest, op het werk of thuis.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen bak gefrituurde bloemkool met groene pepers en kerrieblad -->
    <section class="relative flex min-h-[100svh] items-end overflow-hidden bg-blad text-wit">
      <Image src={hero} alt="Een stalen bak vol goudbruin gefrituurde bloemkool met groene pepers en kerrieblad" widths={[640, 960, 1440, 1920, 2400]} quality={55} sizes="100vw" class="absolute inset-0 h-full w-full object-cover object-[60%_50%]" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,#0f1d15cc_0%,#0f1d1526_28%,#0f1d1540_50%,#0f1d15f2_100%)] md:bg-[linear-gradient(100deg,#0f1d15f0_0%,#0f1d15b3_38%,#0f1d1526_70%),linear-gradient(180deg,#0f1d15b3_0%,transparent_25%)]"></div>
      <div class="wrap relative pb-36 pt-40 md:pb-28">
        <p class="flex items-center gap-3 text-sm font-semibold text-wit/90"><span class="h-px w-8 bg-peper-licht"></span>Zuid-Indiase catering in Utrecht</p>
        <h1 class="mt-5 max-w-[14ch] text-hero">De Zuid&#8209;Indiase keuken, <span class="text-peper-licht">naar u toe.</span></h1>
        <p class="mt-6 max-w-xl text-lg text-wit/90 md:text-xl">Kavitha kookt met verse ingrediënten en smaakvolle kruiden. Voor uw feest, op het werk of thuis.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#aanvragen" class="knop knop-vol">Catering aanvragen<Icoon naam="pijl" /></a>
          <a href={waHoi} class="knop knop-licht"><Icoon naam="wa" />WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- 2. Kavitha + hun eigen slogan -->
    <section id="kavitha" class="overflow-hidden bg-papier py-24 md:py-36">
      <div class="wrap grid items-center gap-y-14 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-7">
          <p class="rijs font-kop text-reus leading-[.9] text-peper">Extra spicy?<br /><span class="text-inkt">No worries!</span></p>
          <div class="rijs mt-12 max-w-xl md:ml-[12%]" style="--d:.1s">
            <p class="text-lg leading-relaxed text-grijs">Vanuit haar passie voor de keuken van haar moederland India brengt Kavitha de Zuid-Indiase keuken naar u toe. Met veel plezier en kunde kookt ze de heerlijkste gerechten, met verse ingrediënten en smaakvolle kruiden.</p>
            <p class="mt-6 font-kop text-2xl text-inkt">Toegankelijk en inspirerend tegelijk.</p>
          </div>
        </div>
        <figure class="rijs relative mx-auto w-full max-w-[26rem] md:col-span-5" style="--d:.15s">
          <Image src={kavitha} alt="Kavitha in de keuken, uitgeknipt in de vorm van India" widths={[360, 540, 719]} sizes="(min-width: 768px) 26rem, 90vw" class="h-auto w-full" />
          <figcaption class="mt-3 text-center text-sm text-grijs">Kavitha in de keuken</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. Gerechten: editoriale fotogrid -->
    <section id="gerechten" class="bg-wit py-24 md:py-36">
      <div class="wrap">
        <h2 class="rijs max-w-[16ch] text-3xl">Vers bereid en op locatie geserveerd.</h2>
        <div class="mt-14 grid gap-4 md:grid-cols-12 md:gap-6">
          <figure class="rijs md:col-span-6 md:row-span-2">
            <Image src={paneer} quality={65} alt="Chili paneer met paprika, ui en lente-ui" widths={[480, 720, 1080, 1348]} sizes="(min-width: 768px) 46vw, 100vw" class="aspect-[4/5] h-auto w-full rounded-md object-cover md:h-full md:aspect-auto" />
            <figcaption class="mt-3 text-sm text-grijs">Chili paneer</figcaption>
          </figure>
          <figure class="rijs md:col-span-6" style="--d:.1s">
            <Image src={biryani} quality={62} alt="Bakjes biryani met gele rijst en groenten, klaar om mee te geven" widths={[480, 720, 1200]} sizes="(min-width: 768px) 46vw, 100vw" class="aspect-[4/3] h-auto w-full rounded-md object-cover object-[50%_40%]" />
            <figcaption class="mt-3 text-sm text-grijs">Biryani, per bakje</figcaption>
          </figure>
          <div class="grid grid-cols-5 gap-4 md:col-span-6 md:gap-6">
            <figure class="rijs col-span-2" style="--d:.15s">
              <Image src={pannen} alt="Pannen met naan en een gele curry" widths={[240, 480]} sizes="(min-width: 768px) 18vw, 40vw" class="aspect-[3/5] h-auto w-full rounded-md object-cover" />
              <figcaption class="mt-3 text-sm text-grijs">Naan en curry</figcaption>
            </figure>
            <div class="rijs col-span-3 flex flex-col justify-end pb-9" style="--d:.2s">
              <p class="text-grijs">Op uw bedrijf of bij u thuis. Ook voor hapjes op een feest kunt u bij ons terecht.</p>
              <p class="mt-5"><a href="#menukaart" class="link font-bold text-peper">Naar de menukaart</a></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Menukaart: aantikken = op de aanvraag -->
    <section id="menukaart" class="op-blad bg-blad py-24 text-mist md:py-36">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <h2 class="text-3xl text-wit md:col-span-6">Menukaart</h2>
          <p class="max-w-md md:col-span-5 md:col-start-8">Tik aan wat u lekker lijkt. Het komt vanzelf in uw aanvraag, en samen stellen we het menu samen.</p>
        </div>

        <div class="mt-16 grid gap-x-16 gap-y-16 lg:grid-cols-2">
          {menu.map((kol) => (
            <div>
              <div class="flex items-end gap-5 border-b border-lijn-n pb-6">
                <Image src={kol.kop === 'vlees' ? indiaVlees : indiaVeg} alt={kol.naam} widths={[160, 320]} sizes="160px" class="h-36 w-auto md:h-44" />
              </div>
              {kol.groepen.map((g) => (
                <div class="mt-10">
                  <h3 class="font-kop text-xl text-wit">{g.titel}</h3>
                  <ul class="mt-2">
                    {g.items.map(([n, u]) => (
                      <li><button type="button" class="gerecht" aria-pressed="false" data-gerecht={n}><span class="naam">{n}</span><span class="uitleg">{u}</span><span class="plus" set:html={plus} /></button></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))}
        </div>

        <div class="mt-20 grid gap-x-16 gap-y-12 border-t border-lijn-n pt-14 lg:grid-cols-2">
          <div>
            <h3 class="font-kop text-xl text-wit">Rijst en biryani</h3>
            <ul class="mt-2">
              {rijst.map(([n, u]) => <li><button type="button" class="gerecht" aria-pressed="false" data-gerecht={n}><span class="naam">{n}</span><span class="uitleg">{u}</span><span class="plus" set:html={plus} /></button></li>)}
            </ul>
          </div>
          <div>
            <h3 class="font-kop text-xl text-wit">Nagerechten</h3>
            <ul class="mt-2">
              {toetjes.map(([n, u]) => <li><button type="button" class="gerecht" aria-pressed="false" data-gerecht={n}><span class="naam">{n}</span><span class="uitleg">{u}</span><span class="plus" set:html={plus} /></button></li>)}
            </ul>
            <p class="mt-10"><a href="#aanvragen" class="knop knop-vol"><span data-teller>Menu aanvragen</span><Icoon naam="pijl" /></a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Op locatie: de kaartjes van hun kraam + reviews -->
    <section id="op-locatie" class="bg-papier py-24 md:py-36">
      <div class="wrap">
        <figure class="rijs">
          <Image src={kaartjes} alt="Handgeschilderde kaartjes op hun kraam: bajji en pakoda, curry, biryani, tandoori en lassi" widths={[640, 973]} sizes="(min-width: 1280px) 973px, 100vw" class="mx-auto h-auto w-full max-w-[973px] rounded-md" />
          <figcaption class="mx-auto mt-3 max-w-[973px] text-sm text-grijs">De kaartjes van onze kraam, met de hand beschilderd.</figcaption>
        </figure>

        <div class="mt-20 grid gap-y-14 md:mt-28 md:grid-cols-12 md:gap-x-10">
          <div class="md:col-span-5">
            <h2 class="rijs text-3xl">Op het werk, thuis of op het feest.</h2>
            <p class="rijs mt-6 max-w-sm text-grijs" style="--d:.1s">Alles wordt vers bereid, gebracht en bij u op locatie geserveerd.</p>
            <p class="rijs mt-8 flex items-center gap-2 text-sm" style="--d:.15s"><Icoon naam="g" class="h-4 w-4" /><a href={site.reviews} class="link">{site.google.score} op Google, {site.google.aantal} reviews</a></p>
          </div>
          <div class="md:col-span-7">
            <blockquote class="rijs">
              <p class="font-kop text-2xl leading-snug text-inkt">“{reviews[0].tekst}”</p>
              <footer class="mt-4 text-sm text-grijs">{reviews[0].naam}, Google review</footer>
            </blockquote>
            <div class="mt-14 grid gap-10 border-t border-lijn-2 pt-10 sm:grid-cols-2">
              {reviews.slice(1).map((r, i) => (
                <blockquote class="rijs" style={`--d:${0.1 + i * 0.1}s`}>
                  <p class="text-grijs">“{r.tekst}”</p>
                  <footer class="mt-3 text-sm font-bold text-inkt">{r.naam}<span class="font-normal text-grijs">, Google review</span></footer>
                </blockquote>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Aanvragen: één kaart die een WhatsApp-bericht klaarzet -->
    <section id="aanvragen" class="bg-peper py-24 text-wit md:py-32">
      <div class="wrap grid gap-y-12 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-5">
          <h2 class="text-3xl">Catering aanvragen</h2>
          <p class="mt-6 max-w-sm text-lg text-wit/90">Vul in wat u al weet. De rest bespreken we via WhatsApp.</p>
          <p class="mt-10 text-sm text-wit/90">Bellen kan ook: <a href={site.telHref} class="link num font-bold text-wit">{site.tel}</a><br />of mail <a href={`mailto:${site.mail}`} class="link font-bold text-wit">{site.mail}</a></p>
        </div>
        <form class="rounded-md bg-wit p-6 text-inkt shadow-[0_30px_60px_-30px_#0f1d15b3] sm:p-9 md:col-span-7" data-aanvraag novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div><label for="f-datum" class="label">Datum</label><input id="f-datum" name="datum" type="date" class="veld" /></div>
            <div><label for="f-pers" class="label">Aantal personen</label><input id="f-pers" name="personen" type="number" min="1" inputmode="numeric" placeholder="bijv. 30" class="veld" /></div>
            <div>
              <label for="f-gel" class="label">Gelegenheid</label>
              <select id="f-gel" name="gelegenheid" class="veld">
                <option>Verjaardag</option><option>Diner of etentje</option><option>Op het werk</option><option>Housewarming</option><option>Feestdagen</option><option>Iets anders</option>
              </select>
            </div>
            <div>
              <label for="f-hoe" class="label">Bezorgen of afhalen</label>
              <select id="f-hoe" name="hoe" class="veld">
                <option>Bezorgen en opdienen</option><option>Alleen bezorgen</option><option>Afhalen</option><option>Weet ik nog niet</option>
              </select>
            </div>
          </div>
          <div class="mt-6">
            <p class="label">Gerechten uit de menukaart</p>
            <p class="text-sm text-grijs" data-keuze>Nog niets gekozen. Kies in de <a href="#menukaart" class="link text-peper">menukaart</a>, of laat u adviseren.</p>
          </div>
          <div class="mt-6"><label for="f-opm" class="label">Opmerking</label><textarea id="f-opm" name="opmerking" rows="2" class="veld min-h-0 resize-y" placeholder="bijv. half vegetarisch, of extra pittig"></textarea></div>
          <button type="submit" class="knop knop-vol mt-7 w-full sm:w-auto"><Icoon naam="wa" />Verstuur via WhatsApp</button>
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  const gekozen = new Set<string>();
  const keuze = document.querySelector<HTMLElement>('[data-keuze]');
  const teller = document.querySelector<HTMLElement>('[data-teller]');
  const leeg = keuze?.innerHTML ?? '';
  const toon = () => {
    if (keuze) keuze.innerHTML = gekozen.size ? '' : leeg;
    if (keuze && gekozen.size) keuze.textContent = [...gekozen].join(', ');
    if (teller) teller.textContent = gekozen.size ? `Aanvragen met ${gekozen.size} ${gekozen.size === 1 ? 'gerecht' : 'gerechten'}` : 'Menu aanvragen';
  };
  document.querySelectorAll<HTMLButtonElement>('[data-gerecht]').forEach((b) => b.addEventListener('click', () => {
    const n = b.dataset.gerecht!; const aan = !gekozen.has(n);
    aan ? gekozen.add(n) : gekozen.delete(n);
    b.setAttribute('aria-pressed', String(aan)); toon();
  }));
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(f); const r = ['Hoi Licht spicy! Ik wil graag catering aanvragen.'];
    const datum = String(d.get('datum') || '');
    if (datum) r.push(`Datum: ${new Date(datum + 'T12:00').toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}`);
    if (d.get('personen')) r.push(`Aantal personen: ${d.get('personen')}`);
    r.push(`Gelegenheid: ${d.get('gelegenheid')}`, `Bezorgen/afhalen: ${d.get('hoe')}`);
    if (gekozen.size) r.push(`Gerechten: ${[...gekozen].join(', ')}`);
    if (String(d.get('opmerking') || '').trim()) r.push(`Opmerking: ${String(d.get('opmerking')).trim()}`);
    window.open(`${site.wa}?text=${encodeURIComponent(r.join('\n'))}`, '_blank', 'noopener');
  });
</script>
