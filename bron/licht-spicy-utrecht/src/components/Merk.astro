---
import { Image } from 'astro:assets';
import { url } from '../data/site';
import logo from '../assets/logo.png';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="inline-flex items-center no-underline" aria-label="Licht spicy, naar de homepage">
  <Image src={logo} alt="Licht spicy" width={174} height={60} widths={[174, 348]} sizes="174px" class={klein ? 'h-12 w-auto' : 'h-11 w-auto drop-shadow-[0_1px_10px_#0f1d15] md:h-14'} loading="eager" />
</a>
