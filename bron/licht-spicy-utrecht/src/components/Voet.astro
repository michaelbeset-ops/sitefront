---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="op-blad bg-blad text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk klein />
      <p class="mt-6 max-w-xs">Zuid-Indiase catering uit {site.plaats}, vers gekookt door Kavitha.</p>
    </div>
    <div class="md:col-span-4">
      <p class="font-kop text-lg text-wit">Contact</p>
      <p class="mt-4"><a href={waHoi} class="link">WhatsApp</a> of <a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-1">{site.plaats}</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-kop text-lg text-wit">Snel naar</p>
      <p class="mt-4"><a href={url('#menukaart')} class="link">Menukaart</a></p>
      <p class="mt-1"><a href={url('#aanvragen')} class="link">Catering aanvragen</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-n py-7 text-xs">
    <p>© {jaar} {site.vol}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-peper-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten, menukaart en foto’s van jullie eigen website en Google-profiel. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
