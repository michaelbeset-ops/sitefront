---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const huur = [['Geremde bagagewagens', 'wagens'], ['Ongeremde bagagewagens', 'wagens'], ['Topbox en fietsendragers', 'extra'], ['Autoambulance', 'vervoeren'], ['Motortrailer', 'vervoeren']];
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht class="text-wit" />
      <p class="mt-6 max-w-xs">Bagagewagens, een autoambulance en een motortrailer te huur in Leidschendam. Voor particulieren en professionals.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-[700] text-wit">Te huur</p>
      <ul class="mt-3 space-y-1">{huur.map(([t, id]) => <li><a href={url(`#${id}`)} class="no-underline hover:underline">{t}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-[700] text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-[700] text-wit">Open</p>
      <ul class="mt-3 space-y-2">{tijden.map((t) => <li>{t.dag}<br /><span class="num text-wit">{t.tekst}</span></li>)}</ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam} · {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's en teksten komen van de subpagina's van arion-aanhangwagens.nl (de homepage zelf geeft een foutmelding). Reviews letterlijk van Google, stand 9 oktober 2026. Prijzen bewust weggelaten.</p>}
</footer>
