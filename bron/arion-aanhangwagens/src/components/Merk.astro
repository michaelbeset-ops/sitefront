---
// Woordmerk naar hun logo: twee schuine strepen (rood en blauw) + ARION + AANHANGWAGENS, schuin en breed.
import { url } from '../data/site';
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
---
<a href={url('')} class:list={['merk inline-flex items-center gap-2.5 no-underline', cls]}>
  <svg viewBox="0 0 44 22" class="h-[1.35rem] w-auto flex-none" aria-hidden="true">
    <path d="M13 0h9L9 22H0z" fill="var(--color-logorood)" />
    <path d="M28 0h16L31 22H15z" fill={licht ? '#ffffff' : 'var(--color-blauw)'} class="merk-blauw" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="text-[1.45rem] font-[860] italic tracking-[-0.02em]" style="font-stretch:125%">ARION</span>
    <span class="mt-[.12rem] text-[.56rem] font-[760] italic tracking-[.14em]" style="font-stretch:118%">AANHANGWAGENS</span>
  </span>
</a>
