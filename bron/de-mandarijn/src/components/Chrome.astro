---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 bg-jade text-paper">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-2xl font-extrabold tracking-[-0.035em] no-underline">De Mandarijn</a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href="#afhalen" class="no-underline hover:text-mandarin">Afhalen</a></li>
          <li><a href="#menu" class="no-underline hover:text-mandarin">Menu</a></li>
          <li><a href="#feesten" class="no-underline hover:text-mandarin">Feesten en catering</a></li>
          <li><a href="#contact" class="no-underline hover:text-mandarin">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-mandarin !px-4 !py-2 text-sm">Bel</a>
    </div>
  </header>
) : (
  <footer class="bg-jade py-10 text-paper/75">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-xl text-paper">{site.naam}</strong><br />{site.straat} ({site.toevoeging}), {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
  </footer>
)}
