---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site } from '../data/site';
const tijden = [
  ['Maandag', '16.00 tot 21.30'],
  ['Dinsdag', 'Gesloten'],
  ['Woensdag', 'Gesloten'],
  ['Donderdag', '16.00 tot 21.30'],
  ['Vrijdag', '16.00 tot 21.30'],
  ['Zaterdag', '12.00 tot 21.30'],
  ['Zondag', '12.00 tot 21.30'],
];
---
<Base
  title="De Mandarijn | Chinees restaurant, afhalen en catering in Zwijndrecht"
  description="Al bijna dertig jaar traditionele Chinese keuken in Winkelcentrum Walburg, Zwijndrecht. Meer dan 150 gerechten om af te halen, een wisselend seizoensmenu, en feesten tot 75 personen."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="bg-jade pb-16 pt-12 text-paper lg:pb-24 lg:pt-20">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="font-semibold text-mandarin">Winkelcentrum Walburg, Zwijndrecht</p>
          <h1 class="mt-4 text-4xl">Al bijna dertig jaar traditioneel Chinees</h1>
          <p class="mt-6 max-w-xl text-lg text-paper/80">
            Eeuwenoude recepten en tradities, met verse ingrediënten en kruiden. Eet bij ons in het restaurant,
            haal meer dan 150 gerechten af, of laat ons de catering van je feest verzorgen.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-mandarin">Bestellen: {site.tel}</a>
            <a href="#menu" class="btn btn-line">Bekijk het menu</a>
          </div>
        </div>
        <aside aria-labelledby="open" class="self-end rounded-[1.25rem] bg-white/5 p-6 ring-1 ring-white/10 lg:col-span-4 lg:col-start-9">
          <h2 id="open" class="text-2xl">Open</h2>
          <table class="mt-3 w-full">
            <caption class="sr-only">Openingstijden restaurant en afhalen</caption>
            <tbody>
              {tijden.map(([d, t]) => (
                <tr class="border-b border-white/10 last:border-0"><th scope="row" class="py-1.5 text-left font-semibold">{d}</th><td class={`py-1.5 text-right tabular-nums ${t === 'Gesloten' ? 'text-paper/55' : ''}`}>{t}</td></tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 text-sm text-paper/70">Alle feestdagen open van 12.00 tot 21.30 uur. [[AANLEVEREN: klopt woensdag gesloten? De afhaalpagina noemt alleen dinsdag.]]</p>
          <p class="mt-3 rounded-lg bg-mandarin/15 p-3 text-sm">Wegens vakantie gesloten van 5 tot en met 28 oktober. Vanaf donderdag 29 oktober zijn we weer open.</p>
        </aside>
      </div>
    </section>

    <section id="afhalen" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Afhalen</h2>
        <p class="mt-5 text-lg">Meer dan 150 gerechten om thuis of op het werk van te genieten. De keuken is open tot 21.30 uur.</p>
        <p class="mt-4">Bel je bestelling even door, dan staat hij klaar als je komt.</p>
      </div>
      <div class="grid content-start gap-4 lg:col-span-6 lg:col-start-7">
        <a href={site.telHref} class="flex items-baseline justify-between gap-4 border-b-2 border-ink pb-3 no-underline">
          <span class="font-display text-[2.2rem] font-extrabold leading-none tracking-[-0.03em]">{site.tel}</span><span class="text-sm text-ink-soft">bellen</span>
        </a>
        <a href={site.tel2Href} class="flex items-baseline justify-between gap-4 border-b-2 border-ink pb-3 no-underline">
          <span class="font-display text-[2.2rem] font-extrabold leading-none tracking-[-0.03em]">{site.tel2}</span><span class="text-sm text-ink-soft">of dit nummer</span>
        </a>
        <p class="text-sm text-ink-soft">[[AANLEVEREN: afhaalprijslijst als tekst, nu alleen als PDF]]</p>
      </div>
    </section>

    <section id="menu" class="scroll-mt-20 bg-paper-deep py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="photo-slot aspect-[4/3] rounded-[1.25rem] lg:col-span-5" role="img" aria-label="Plek voor een foto van een gerecht">[[AANLEVEREN: foto gerecht, liggend]]</div>
        <div class="self-center lg:col-span-6 lg:col-start-7">
          <h2 class="text-3xl">Vaste kaart en seizoensmenu</h2>
          <p class="mt-5 text-lg">Naast de vaste kaart staat er elk seizoen een wisselend menu met specialiteiten van onze koks. Traditioneel Chinees, of juist een verrassende nieuwe variant.</p>
          <ul class="mt-6 flex flex-wrap gap-2 text-sm font-semibold">
            <li class="rounded-full bg-white px-3 py-1.5">Keuzemenu</li>
            <li class="rounded-full bg-white px-3 py-1.5">Seizoensmenu</li>
            <li class="rounded-full bg-white px-3 py-1.5">Kerstdiner</li>
          </ul>
          <p class="mt-4 text-sm text-ink-soft">[[AANLEVEREN: menu's als tekst op de site in plaats van losse PDF's]]</p>
        </div>
      </div>
    </section>

    <section id="feesten" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Feest in het restaurant, of catering op locatie</h2>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7">
        <div class="border-t-2 border-mandarin-deep pt-4">
          <p class="font-display text-[3.25rem] font-extrabold leading-none">75</p>
          <p class="mt-2 font-semibold">gasten in ons restaurant</p>
          <p class="mt-3 text-ink-soft">Je kunt De Mandarijn afhuren voor je feest. Wij zorgen voor een avond die tot in de puntjes verzorgd is.</p>
        </div>
        <div class="border-t-2 border-ink pt-4">
          <p class="font-display text-[3.25rem] font-extrabold leading-none">Catering</p>
          <p class="mt-2 font-semibold">in Zwijndrecht en omstreken</p>
          <p class="mt-3 text-ink-soft">Een feestje thuis of iets te vieren op de zaak? Vraag een prijsopgave aan, we denken graag met je mee.</p>
        </div>
        <a href={site.telHref} class="btn btn-jade justify-self-start sm:col-span-2">Vraag naar de mogelijkheden</a>
      </div>
    </section>

    <section id="contact" class="scroll-mt-20 bg-jade py-16 text-paper lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Waar je ons vindt</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}, {site.toevoeging}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
        </div>
        <dl class="grid content-start gap-4 text-lg lg:col-span-6 lg:col-start-7">
          <div><dt class="text-sm text-paper/60">Reserveren en bestellen</dt><dd><a href={site.telHref} class="font-display text-3xl font-extrabold underline decoration-mandarin decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-paper/60">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="underline decoration-mandarin decoration-2 underline-offset-4">{site.mail}</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
