  .paar-knop:hover { background: #38342d; }
  .paar-knop[aria-pressed='true'] { background: var(--color-herfst); color: var(--color-nacht); box-shadow: none; }

  .vn-na { clip-path: inset(0 0 0 var(--pos)); }
  .vn-lijn { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; margin-left: -1.5px; background: #fff; pointer-events: none; box-shadow: 0 0 12px #0006; }
  .vn-greep { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 3rem; height: 3rem; margin: -1.5rem 0 0 -1.5rem; border-radius: 999px; background: #fff; color: var(--color-inkt); box-shadow: 0 6px 18px #0005; }
  .vn-label { position: absolute; top: .75rem; padding: .25rem .65rem; border-radius: var(--radius-sm); background: #1d1b17cc; color: #fff; font-size: .8125rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; pointer-events: none; }
  .vn-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; }
  .vn-beeld:has(.vn-range:focus-visible) { outline: 3px solid var(--color-herfst); outline-offset: 3px; }

  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-sm); background: var(--color-zand); font-size: .9375rem; font-weight: 600; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #e2d7c4; }
  .keuze input:checked + span { background: var(--color-roest); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-roest); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-sm); border: 1.5px solid #1d1b1733; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
