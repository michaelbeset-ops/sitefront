  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: 999px; background: var(--color-zand); }
  .status-pil .status-stip { background: var(--color-grijs); }
  .status-pil[data-open='true'] .status-stip { background: #2f9e67; }
  .dag[data-vandaag] { background: var(--color-roest); color: #fff; }
