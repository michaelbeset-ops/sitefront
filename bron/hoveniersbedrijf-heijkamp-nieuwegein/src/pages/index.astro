            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-zand text-roest"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Ma t/m za, 8.00 tot 18.00 uur</span></span><Icoon naam="pijl" class="h-5 w-5 text-roest" /></a></li>
          </ul>
          <div class="kaart mt-6 p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Bereikbaar</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za</span></p>
