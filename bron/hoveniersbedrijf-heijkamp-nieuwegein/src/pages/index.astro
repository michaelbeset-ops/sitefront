  </main>
  <Voet />
</Base>

<script>
  // Voor/na-schuif: keuze van de tuin en de positie van de lijn.
  const figs = [...document.querySelectorAll<HTMLElement>('[data-vn]')];
  figs.forEach((f) => {
    const r = f.querySelector<HTMLInputElement>('.vn-range');
    r?.addEventListener('input', () => f.style.setProperty('--pos', r.value + '%'));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-paar]').forEach((k) => {
    k.addEventListener('click', () => {
      const i = k.dataset.paar;
      document.querySelectorAll('[data-paar]').forEach((b) => b.setAttribute('aria-pressed', String(b === k)));
      figs.forEach((f) => f.classList.toggle('hidden', f.dataset.vn !== i));
    });
  });

  // WhatsApp-bericht samenstellen.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hallo Dick, ik wil graag een vrijblijvende offerte.'];
      if (v('wie')) r.push('Ik ben: ' + v('wie').toLowerCase());
      if (v('wat')) r.push('Het gaat om: ' + v('wat').toLowerCase());
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('wens')) r.push('Mijn wens: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31654363739?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

