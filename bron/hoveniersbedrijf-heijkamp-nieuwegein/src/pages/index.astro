                  <span class="num block text-xs leading-tight text-grijs" aria-hidden="true">{t.open ? <>{t.open}<br />{t.dicht}</> : 'dicht'}</span>
                  <span class="sr-only">{t.naam}: {t.open ? `${t.open} tot ${t.dicht} uur` : 'gesloten'}</span>
                </li>
              ))}
            </ul>
            <div class="mt-5 flex flex-col gap-4 border-t border-lijn pt-5 sm:flex-row sm:items-center sm:justify-between">
              <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-roest" /><span><b class="font-semibold">{site.straat}</b><br /><span class="text-grijs">{site.postcode} {site.plaats}</span></span></p>
