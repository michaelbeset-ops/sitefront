---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Sterren from '../components/Sterren.astro';
import { site, tijden, chips, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import heroM from '../assets/hero-m.jpg';
import achtertuin from '../assets/achtertuin.jpg';
import terras from '../assets/terras.jpg';
import aanleg from '../assets/aanleg.jpg';
import leisteen from '../assets/leisteen.jpg';
import onderhoud from '../assets/onderhoud.jpg';
import bestrating from '../assets/bestrating.jpg';
import schutting from '../assets/schutting.jpg';
import japans from '../assets/japans.jpg';
import vlonder from '../assets/vlonder.jpg';
import vijvertuin from '../assets/vijvertuin.jpg';
import coniferen from '../assets/coniferen.jpg';
import bedrijf from '../assets/bedrijf.jpg';
import bloesem from '../assets/bloesem.jpg';
import bord from '../assets/bord.jpg';
import vn1v from '../assets/vn1-voor.jpg';
import vn1n from '../assets/vn1-na.jpg';
import vn2v from '../assets/vn2-voor.jpg';
import vn2n from '../assets/vn2-na.jpg';
import vn3v from '../assets/vn3-voor.jpg';
import vn3n from '../assets/vn3-na.jpg';

const heroMob = await getImage({ src: heroM, width: 640, quality: 45, format: 'webp' });
const heroMob2 = await getImage({ src: heroM, width: 800, quality: 40, format: 'webp' });

const vraag = (d: string) => waMet(`Hallo Dick, ik wil graag een vrijblijvende offerte voor ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Tuinaanleg', src: aanleg, alt: 'Door ons aangelegde tuin met sierbestrating in een ronde vorm en borders met beplanting', punten: ['Tuinontwerp', 'Sierbestrating en erfafscheiding', 'Vijver en vlonder', 'Gazon en beplanting', 'Verlichting en drainage', 'Schuur of blokhut plaatsen'] },
  { t: 'Tuinrenovatie', src: leisteen, alt: 'Pad van leisteen in wildverband, door ons gelegd langs een border', punten: ['Herstel van een vervallen tuin', 'Herstel van een verkeerd aangelegde tuin', 'Herindelen van een tuin', 'Ophogen van bestrating'] },
  { t: 'Tuinonderhoud', src: onderhoud, alt: 'Een weelderige tuin met vijver en bloeiende planten, door ons onderhouden', punten: ['Voorjaars- en winterklaar maken', 'Onderhoud gazon', 'Boomverzorging en snoeien', 'Hagen knippen', 'Onkruid verwijderen'] },
];

const werk = [
  { src: bestrating, alt: 'Voortuin met strakke donkere tegels en borders' },
  { src: schutting, alt: 'Nieuwe houten schutting met bestrating ervoor' },
  { src: japans, alt: 'Japanse tuin met vijver, keien en grind' },
  { src: vlonder, alt: 'Nieuwe vlonder langs het water' },
  { src: vijvertuin, alt: 'Tuin met vijver, terras en veel bloeiende planten' },
  { src: coniferen, alt: 'Strak gesnoeide coniferen in een bloeiende tuin' },
];

const paren = [
  { t: 'Voortuin', voor: vn1v, na: vn1n, altV: 'Voortuin vóór de renovatie: overwoekerde struiken over het pad', altN: 'Dezelfde voortuin na de renovatie: nieuw pad, strakke border en houten afscheiding' },
  { t: 'Voortuin met schutting', voor: vn2v, na: vn2n, altV: 'Voortuin vóór de renovatie: wilde struiken en een losse kliko-ombouw', altN: 'Dezelfde plek na de renovatie: nieuwe houten schutting en bestrating' },
  { t: 'Tuin met hagen', voor: vn3v, na: vn3n, altV: 'Tuin vóór de renovatie: dichtgegroeide struiken achter een hek', altN: 'Na de renovatie: een pad van klinkers tussen strak geknipte hagen' },
];

const stappen = [
  ['U belt of appt', 'Vertel kort wat u voor ogen heeft. Vrijblijvend, en wij rekenen geen voorrijkosten.'],
  ['Advies aan huis', 'Dick Heijkamp komt zelf bij u langs. Overdag, of als dat beter uitkomt ’s avonds of in het weekend.'],
  ['Voorstel op maat', 'Na het gesprek ontvangt u een passend voorstel. Voor iedere beurs is er een oplossing.'],
  ['Wij gaan aan de slag', 'Met hoogwaardige materialen en beplanting, zodat u lang plezier hebt van uw tuin.'],
];

const referenties = ['Sport- en Evenementencomplex Merwestein', '’t Veerhuis Congres en Partycentrum', 'Belevingstuin en Ontmoetingstuin De Geinsche Hof', 'Bewegingstuin Vreeswijk', 'Van Vogelpoel Bloemenplaza, Tull en ’t Waal', 'V.v.E. Merwekade en V.v.E. Merwedehof'];

const bomen = [
  ['Amandelboom', 'eeuwige liefde'],
  ['Berk', 'vriendelijk, bescheiden en elegant'],
  ['Hazelaar', 'wijsheid'],
  ['Linde (leivorm)', 'bescherming en verbondenheid'],
];
---
<Base title={`${site.naam} | Hovenier in Nieuwegein sinds 1993`} description="Tuinaanleg, tuinrenovatie en tuinonderhoud in Nieuwegein en omstreken, voor particulieren en bedrijven. Sinds 1993, persoonlijk advies van Dick Heijkamp, geen voorrijkosten.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <picture>
        <source media="(max-width: 767px)" srcset={`${heroMob.src} 640w, ${heroMob2.src} 800w`} sizes="100vw" />
        <Image src={hero} alt="" widths={[1200, 1600, 1920]} sizes="100vw" quality={42} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_60%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1d1b1740_0%,#1d1b17b8_45%,#1d1b17f2_100%)] md:bg-[linear-gradient(90deg,#1d1b17f0_0%,#1d1b17c4_44%,#1d1b1726_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Hovenier in Nieuwegein sinds 1993</p>
          <h1 id="t-hero" class="mt-5 text-hero">Betrokken van begin tot eind, <span class="text-herfst">weer of geen weer.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Tuinaanleg, tuinrenovatie en tuinonderhoud in Nieuwegein en omstreken. Voor particulieren, bedrijven en VvE’s. Dick Heijkamp komt zelf bij u langs voor advies.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-roest"><Icoon naam="wa" />Offerte via WhatsApp</a>
            <a href="#voor-na" class="knop knop-rand op-foto">Bekijk voor en na</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><Sterren leeg="text-licht/30" /><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-herfst" />Geen voorrijkosten</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za 8.00 tot 18.00 uur</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto w-full max-w-[19rem] rounded-lg bg-licht/10 p-2.5 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <Image src={aanleg} alt="Door Heijkamp aangelegde tuin met sierbestrating met afgeronde borders" widths={[300, 600]} sizes="290px" class="aspect-[4/3] w-full rounded-md object-cover" />
            <figcaption class="flex items-center justify-between gap-3 px-2 pb-1 pt-3 text-sm">
              <span>Eigen werk: sierbestrating met afgeronde borders</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Werkzaamheden in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-2.5 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-sm bg-zand px-3.5 py-2 text-sm font-semibold no-underline transition-colors hover:bg-roest hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-16 lg:py-20" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-8">
            <p class="eyebrow">Wat wij doen</p>
            <h2 id="t-dienst" class="mt-4 text-3xl">Aanleg, renovatie en onderhoud, in de breedste zin van het woord.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-3 lg:col-start-10" style="--d:.05s">Staat uw wens er niet bij? Neem toch contact op. Hoogstwaarschijnlijk kunnen wij u toch van dienst zijn.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-14 lg:gap-6">
          {diensten.map((d, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden">
                <div class="overflow-hidden">
                  <Image src={d.src} alt={d.alt} widths={[400, 600]} sizes="(min-width: 1248px) 380px, (min-width: 768px) 31vw, 92vw" class="aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-2xl">{d.t}</h3>
                  <ul class="mt-4 flex-1 space-y-2">
                    {d.punten.map((p) => <li class="flex gap-2.5 text-grijs"><Icoon naam="vink" class="mt-1 h-4 w-4 shrink-0 text-roest" />{p}</li>)}
                  </ul>
                  <a href={vraag(d.t)} class="mt-7 inline-flex items-center gap-2 self-start font-bold text-roest no-underline transition-colors hover:text-roest-diep">Offerte voor {d.t.toLowerCase()}<Icoon naam="pijl" class="h-5 w-5 transition-transform group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <ul class="mt-6 grid grid-cols-3 gap-2 sm:gap-3 lg:grid-cols-6" aria-label="Uit onze fotogalerij">
          {werk.map((w, i) => (
            <li class="rijs relative aspect-square overflow-hidden rounded-md bg-zand" style={`--d:${(i % 6) * 0.04}s`}>
              <Image src={w.src} alt={w.alt} widths={[200, 400]} sizes="(min-width: 1248px) 190px, (min-width: 1024px) 15vw, 30vw" class="tegel absolute inset-0 h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Voor en na (wow) -->
    <section id="voor-na" class="donker bg-nacht py-20 text-licht lg:py-28" aria-labelledby="t-vn">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Voor en na</p>
          <h2 id="t-vn" class="mt-4 text-3xl">Zie het verschil zelf.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Drie renovaties uit onze eigen fotogalerij. Schuif over de foto om te zien hoe het was, en hoe het werd.</p>
          <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Kies een tuin">
            {paren.map((p, i) => <button type="button" class="paar-knop" aria-pressed={i === 0 ? 'true' : 'false'} data-paar={i}>{p.t}</button>)}
          </div>
          <div class="mt-10 rounded-lg bg-nacht-2 p-6">
            <p class="font-kop text-xl font-bold text-licht">Ook uw tuin aanpakken?</p>
            <p class="mt-2 text-licht-zacht">Stuur een foto van uw tuin via WhatsApp. Dick kijkt mee en komt vrijblijvend langs voor advies.</p>
            <a href={waMet('Hallo Dick, mijn tuin kan wel een opknapbeurt gebruiken. Ik stuur een foto mee. Kunt u een keer komen kijken?')} class="knop knop-roest mt-6 max-w-full whitespace-normal py-3 text-left"><Icoon naam="wa" />Stuur een foto van uw tuin</a>
          </div>
        </div>
        <div class="lg:col-span-7">
          {paren.map((p, i) => (
            <figure class:list={['vn mx-auto max-w-[37.5rem]', i !== 0 && 'hidden']} data-vn={i} style="--pos:50%">
              <div class="vn-beeld relative aspect-[4/3] overflow-hidden rounded-lg bg-nacht-2">
                <Image src={p.voor} alt={p.altV} widths={[600]} sizes="(min-width: 640px) 600px, 92vw" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                <div class="vn-na absolute inset-0">
                  <Image src={p.na} alt={p.altN} widths={[600]} sizes="(min-width: 640px) 600px, 92vw" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                </div>
                <span class="vn-label left-3">Voor</span>
                <span class="vn-label right-3">Na</span>
                <span class="vn-lijn" aria-hidden="true"><span class="vn-greep"><Icoon naam="schuif" class="h-5 w-5" /></span></span>
                <input type="range" min="0" max="100" value="50" class="vn-range" aria-label={`Schuif tussen voor en na: ${p.t.toLowerCase()}`} />
              </div>
              <figcaption class="mt-4 flex items-center justify-between gap-4 text-sm text-licht-zacht"><span>Renovatie: {p.t.toLowerCase()}</span><span class="hidden sm:inline">Foto’s: Hoveniersbedrijf D. Heijkamp</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section class="py-16 lg:py-20" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo werken wij</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Door goed overleg een passend voorstel.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een adviserende rol vinden wij zeer belangrijk. Daarom begint elke klus met een gesprek bij u thuis.</p>
        </div>
        <ol class="mt-12 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative overflow-hidden p-6 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.5rem] font-bold leading-none text-roest">0{i + 1}</p>
              <h3 class="mt-4 text-xl">{t}</h3>
              <p class="mt-2.5 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. Bedrijven -->
    <section id="bedrijven" class="bg-zand py-16 lg:py-20" aria-labelledby="t-bedr">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="relative lg:col-span-6">
          <Image src={terras} alt="Sfeerfoto: strak aangelegd terras met trappen, natuurstenen muurtjes en hagen" widths={[640, 960, 1280]} sizes="(min-width: 1248px) 560px, (min-width: 1024px) 46vw, 92vw" class="aspect-[4/3] w-full rounded-lg object-cover shadow-md" />
          <figure class="absolute -bottom-8 right-4 w-[46%] max-w-[17rem] rounded-md bg-wit p-2 shadow-md sm:right-6">
            <Image src={bedrijf} alt="Door Heijkamp aangelegde bedrijfstuin met bomen en een grasveld" widths={[300, 600]} sizes="270px" class="aspect-[3/2] w-full rounded-sm object-cover" />
            <figcaption class="px-1 pb-0.5 pt-2 text-xs text-grijs">Eigen werk voor een zakelijke klant</figcaption>
          </figure>
        </div>
        <div class="pt-6 lg:col-span-6 lg:pl-6 lg:pt-0">
          <p class="eyebrow">Bedrijven, VvE’s en instellingen</p>
          <h2 id="t-bedr" class="mt-4 text-3xl">Onderhoud met een contract, of op afroep.</h2>
          <p class="mt-6 text-lg text-grijs">Wij verzorgen tuinaanleg, renovatie en onderhoud voor bedrijven, Verenigingen van Eigenaren en instellingen. Voordat u een contract afsluit, komt Dick Heijkamp persoonlijk langs, noteert uw wensen en maakt een offerte op maat.</p>
          <ul class="mt-7 grid gap-3 sm:grid-cols-3">
            <li class="kaart p-5"><Icoon naam="factuur" class="h-6 w-6 text-roest" /><h3 class="mt-3 text-lg">Factuur per kwartaal</h3><p class="mt-1 text-sm text-grijs">Bij een onderhouds&shy;contract.</p></li>
            <li class="kaart p-5"><Icoon naam="sneeuw" class="h-6 w-6 text-roest" /><h3 class="mt-3 text-lg">Snel ter plaatse</h3><p class="mt-1 text-sm text-grijs">Bij bladval, gladheid of zwerfvuil.</p></li>
            <li class="kaart p-5"><Icoon naam="pin" class="h-6 w-6 text-roest" /><h3 class="mt-3 text-lg">Altijd in de buurt</h3><p class="mt-1 text-sm text-grijs">Gevestigd in Nieuwegein, geen voorrijkosten.</p></li>
          </ul>
          <p class="mt-8 text-sm text-grijs"><b class="font-semibold text-inkt">Onder andere voor:</b> {referenties.join(' · ')}.</p>
        </div>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[28rem] lg:col-span-5">
          <Image src={achtertuin} alt="Sfeerfoto: achtertuin met gazon, terras, tuinhuis en borders" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
          <figure class="absolute bottom-5 left-5 w-[52%] max-w-[15rem] rounded-md bg-wit p-2 shadow-md">
            <Image src={bord} alt="Het bord van Hoveniersbedrijf D. Heijkamp met een kale boom en een herfstboom" widths={[240, 400]} sizes="240px" class="aspect-[3/2] w-full rounded-sm object-cover" />
          </figure>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-20 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over ons</p>
          <h2 id="t-over" class="mt-4 text-3xl">In 1993 gestart als eenmanszaak.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Inmiddels is het bedrijf gegroeid, maar Dick Heijkamp houdt het persoonlijk contact met zijn klanten hoog in het vaandel. Wellicht kent u ons werk al: wij legden tuinen aan bij diverse zorgcentra in Nieuwegein en omstreken, die wij ook onderhouden.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-roest text-wit"><Icoon naam="huis" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Persoonlijk advies</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Dick bezoekt zijn klanten zelf, ook ’s avonds of in het weekend.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-roest text-wit"><Icoon naam="leer" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">SBB erkend leerbedrijf</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Onze medewerkers zijn en/of worden vakkundig geschoold.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-roest text-wit"><Icoon naam="blad" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Oog voor de natuur</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Naast onze passie voor tuinen verliezen wij het belang van de natuur niet uit het oog.</p></div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-16" aria-labelledby="t-reviews">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-4">
          <p class="eyebrow">Reviews</p>
          <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          <a href={site.reviews} class="kaart mt-8 inline-flex items-center gap-4 px-5 py-4 no-underline transition-shadow hover:shadow-md">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-bold">{site.google.score}</b><Sterren leeg="text-zand" /></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <figure class="rijs kaart p-7 sm:p-10 lg:col-span-5">
          <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span>
          <blockquote class="mt-5 font-kop text-[clamp(1.25rem,1vw+1rem,1.625rem)] font-semibold leading-snug">“{reviews[0].tekst}”</blockquote>
          <figcaption class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
            <span class="grid h-10 w-10 place-items-center rounded-md bg-zand font-kop font-bold text-roest" aria-hidden="true">{reviews[0].naam[0]}</span>
            <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{reviews[0].naam}</b><span class="text-grijs">Google review, {reviews[0].wanneer}</span></span>
            <Icoon naam="g" class="h-5 w-5" />
          </figcaption>
        </figure>
