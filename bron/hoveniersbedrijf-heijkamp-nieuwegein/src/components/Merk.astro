---
// Beeldmerk naar hun eigen bord: links een kale winterboom op een blauwe grondlijn, rechts een rood-oranje herfstboom.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 44 34" aria-hidden="true">
  <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 30V15M12 21l-5-5M12 18l5-6M7 16l-3-1M7 16l-1-4M17 12l1-4M17 12l3 0M12 15l-1-6M11 9l-2-2M11 9l2-3" />
    <path d="M31 30V20M31 24l-3-3M31 23l3-3" />
  </g>
  <path d="M3 31h17" stroke="var(--color-winter)" stroke-width="2.4" stroke-linecap="round" />
  <path d="M23.5 31h16" stroke="var(--color-roest)" stroke-width="2.4" stroke-linecap="round" />
  <g fill="var(--color-roest)">
    <circle cx="31" cy="12" r="6.2" /><circle cx="25.6" cy="16.2" r="4.4" /><circle cx="36.4" cy="16.2" r="4.4" />
  </g>
  <g fill="#e98a2b"><circle cx="28" cy="9.4" r="2.6" /><circle cx="35" cy="12" r="2" /><circle cx="27.4" cy="17.4" r="1.7" /></g>
</svg>
