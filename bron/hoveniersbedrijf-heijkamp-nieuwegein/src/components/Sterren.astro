---
// 4,4 sterren: vier volle en een ster die voor 40% gevuld is.
import Icoon from './Icoon.astro';
interface Props { class?: string; leeg?: string }
const { class: cls = 'h-4 w-4', leeg = 'text-lijn' } = Astro.props;
---
<span class="flex text-ster" role="img" aria-label="4,4 van 5 sterren">
  {[1, 2, 3, 4].map(() => <Icoon naam="ster" class={cls} />)}
  <span class={`relative inline-block ${cls}`}><Icoon naam="ster" class={`absolute inset-0 ${cls} ${leeg}`} /><span class="absolute inset-0 w-[40%] overflow-hidden"><Icoon naam="ster" class={cls} /></span></span>
</span>
