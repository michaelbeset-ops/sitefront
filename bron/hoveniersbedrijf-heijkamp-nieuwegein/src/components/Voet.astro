---
import { site, url, tijden, waOfferte } from '../data/site';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const diensten = [['diensten', 'Tuinaanleg'], ['diensten', 'Tuinrenovatie'], ['diensten', 'Tuinonderhoud'], ['bedrijven', 'Onderhoudscontracten'], ['herinneringsboom', 'Herinneringsboom']];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <Merk />
        <span><small>Hoveniersbedrijf</small><b>D. Heijkamp</b></span>
      </a>
      <p class="mt-6 max-w-xs">Tuinaanleg, tuinrenovatie en tuinonderhoud in Nieuwegein en omstreken. Voor particulieren en bedrijven, sinds 1993.</p>
      <p class="mt-5 inline-flex rounded-sm border border-lijn-licht px-3 py-1.5 text-xs font-semibold uppercase tracking-[.14em] text-licht">SBB erkend leerbedrijf</p>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {diensten.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-herfst">{t}</a></li>)}
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-herfst">{site.tel}</a></li>
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-herfst">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-herfst">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Bereikbaar</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Openingstijden</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-herfst">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-herfst">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw huidige website en sfeerfoto’s via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 4 oktober 2026).</p>}
  </div>
</footer>
