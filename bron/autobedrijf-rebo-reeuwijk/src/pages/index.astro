  .plaat-veld { width: 100%; min-width: 0; background: transparent; border: 0; padding: 0 1rem; font-family: var(--font-kop); font-weight: 700; font-size: 1.75rem; letter-spacing: .08em; text-transform: uppercase; color: #131416; }
