  .contact-rij:hover { background: #2a2c30; box-shadow: inset 0 0 0 1px var(--color-geel); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: .375rem; background: var(--color-beton-2); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #dcd9cf; }
  .keuze input:checked + span { background: var(--color-inkt); color: var(--color-geel); }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-inkt); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: .375rem; border: 1.5px solid #13141633; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #13141666; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-inkt); }
  .veld::placeholder { color: #7d7f84; text-transform: none; }
</style>
