---
import Logo from './Logo.astro';
import { site, url, keuringApp } from '../data/site';
import { waIcoon } from '../data/iconen';
---
<header class="op-bord border-t border-white/10 bg-antraciet text-wit">
  <div class="flex h-[4.25rem] items-center justify-between gap-4 px-4 md:h-[5rem] md:px-12 xl:px-[max(3rem,calc((100vw-88rem)/2+3rem))]">
    <a href={url('')} class="text-[.95rem] no-underline md:text-[1.15rem]" aria-label={`${site.naam}, naar de homepage`}><Logo /></a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-10 text-[1.05rem] font-medium">
        <li><a href={url('#werk')} class="no-underline decoration-groen decoration-2 underline-offset-8 hover:underline">Keuren en repareren</a></li>
        <li><a href={url('#contact')} class="no-underline decoration-groen decoration-2 underline-offset-8 hover:underline">Contact</a></li>
      </ul>
    </nav>
    <a href={keuringApp} class="knop !px-3 !py-2.5 !text-[1rem] md:!px-4"><Fragment set:html={waIcoon} /><span class="max-[419px]:sr-only">WhatsApp</span><span class="sr-only"> {site.tel}</span></a>
  </div>
</header>
