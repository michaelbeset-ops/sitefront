---
// Hun gevelbord nagetekend: een grote groene G. met een groene lijn erdoorheen, ROSSENAAR erboven, Technisch adviesbureau eronder.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`relative inline-grid grid-cols-[auto_auto] items-center gap-x-[.45em] leading-none ${cls}`}>
  <span aria-hidden="true" class="absolute left-[-.35em] right-0 top-1/2 h-[2px] -translate-y-1/2 bg-groen"></span>
  <span aria-hidden="true" class="relative row-span-2 text-[3.3em] font-medium leading-[.78] tracking-[-.04em] text-groen">G<span class="text-[.55em]">.</span></span>
  <span class="relative self-end pb-[.32em] text-[1em] font-semibold uppercase tracking-[.14em]">Rossenaar</span>
  <span class="relative self-start pt-[.38em] text-[.82em] font-normal">Technisch adviesbureau</span>
</span>
