---
import Logo from './Logo.astro';
import { site, url } from '../data/site';
---
<footer class="border-t border-white/10 bg-antraciet text-mist">
  <div class="wrap flex flex-col gap-8 py-10 md:flex-row md:items-end md:justify-between">
    <span class="text-[1rem] text-wit"><Logo /></span>
    <p class="text-sm md:text-right">Google: {site.google.score} uit {site.google.aantal} beoordelingen · KvK [[AANLEVEREN: KvK-nummer]] · <a href={url('privacy/')} class="lijn">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap border-t border-white/10 pb-8 pt-6 text-sm">Foto van uw eigen website, ter illustratie. Het keuringslabel is een voorbeeld.</p>}
</footer>
