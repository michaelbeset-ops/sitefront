---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Label from '../components/Label.astro';
import { site, keuringApp, reparatieApp, mailHref } from '../data/site';
import { waIcoon } from '../data/iconen';
import pand from '../assets/pand.jpg';

const keuren = ['Handgereedschap volgens NEN 3140', 'Draagbaar klimmateriaal', 'Registratie en certificering'];
const repareren = ['Gipsspuiten en spackspuiten', 'Compressoren', 'Diamantzagen', 'Diamantboren: slijpen, boren en herbezetten'];
---
<Base title="G. Rossenaar Technisch Adviesbureau | NEN 3140-keuring op locatie | Purmerend" description="NEN 3140-keuring van handgereedschap en draagbaar klimmateriaal, op locatie. Reparatie en onderhoud van gipsspuiten, spackspuiten, compressoren en diamantgereedschap. Impuls 129, Purmerend.">
  <Kop />
  <main id="inhoud">
    <!-- Eerste scherm: licht vlak met de belofte, rechts het antraciet van hun gevelbord met het keuringslabel. -->
    <section class="grid lg:min-h-[calc(100dvh-7.25rem)] lg:grid-cols-12" aria-labelledby="kop">
      <div class="flex flex-col justify-center px-5 pb-10 pt-10 md:px-12 md:pt-16 lg:col-span-7 lg:px-16 lg:pb-16 lg:pt-12 xl:pl-[max(4rem,calc((100vw-88rem)/2+3rem))]">
        <p class="mono text-staal">{site.straat}, {site.plaats}</p>
        <h1 id="kop" class="mt-5 text-[clamp(2.2rem,10vw,3.6rem)] lg:text-[clamp(3rem,5.1vw,4.85rem)]"><span class="whitespace-nowrap">NEN 3140-keuring</span> van uw gereedschap, <span class="text-groen-diep">op uw werkplek.</span></h1>
        <p class="mt-7 max-w-[36rem] text-[1.15rem] leading-[1.55] text-staal md:text-[1.3rem]">
          In overleg komen wij bij u keuren, zodat uw mensen zo min mogelijk stilstaan. Kleine reparaties doen we ter plekke.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={keuringApp} class="knop"><Fragment set:html={waIcoon} />Keuring inplannen</a>
          <p class="text-[1.05rem]">of bel <a href={site.telHref} class="lijn whitespace-nowrap font-semibold tabular-nums">{site.tel}</a></p>
        </div>
      </div>

      <div class="op-bord relative flex flex-col items-center justify-center gap-6 bg-antraciet px-5 pb-10 pt-10 lg:col-span-5 lg:px-12 lg:pt-12">
        <Label class="w-full max-w-[22rem] lg:max-w-[25rem]" />
        <p class="mono max-w-[25rem] text-center !text-[.8rem] text-mist">Keuringslabel, ter illustratie</p>
      </div>
    </section>

    <div class="g-lijn"></div>

    <!-- Wat we doen: twee registers, met hun pand en bus. -->
    <section id="werk" class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-12" aria-labelledby="werk-kop">
      <figure class="lg:col-span-4">
        <Image src={pand} alt="Het pand aan de Impuls in Purmerend met het gevelbord en de bedrijfsbus van G. Rossenaar." widths={[401]} format="webp" quality={80} class="block h-auto w-full max-w-[25rem] rounded-sm" />
        <figcaption class="mono mt-3 text-staal">Impuls 129, Purmerend. Sinds 1999.</figcaption>
      </figure>
      <div class="lg:col-span-8 lg:pl-8">
        <h2 id="werk-kop" class="text-[clamp(2.1rem,3.6vw,3.4rem)]">Keuren, repareren, onderhouden.</h2>
        <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12">
          <div>
            <h3 class="border-b-[3px] border-groen pb-3 text-[1.5rem]">Keuren en certificeren</h3>
            <ul class="mt-2">{keuren.map((k) => <li class="border-b border-lijn py-3.5 text-[1.15rem]">{k}</li>)}</ul>
            <p class="mt-5 text-staal">Wij hebben de juiste certificaten in huis.</p>
          </div>
          <div>
            <h3 class="border-b-[3px] border-antraciet pb-3 text-[1.5rem]">Reparatie en onderhoud</h3>
            <ul class="mt-2">{repareren.map((k) => <li class="border-b border-lijn py-3.5 text-[1.15rem]">{k}</li>)}</ul>
            <p class="mt-5"><a href={reparatieApp} class="lijn">Machine voor reparatie? Stuur een WhatsApp.</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Waarom: hun eigen uitleg over de NEN 3140, groot gezet. -->
    <section class="bg-wit" aria-labelledby="waarom-kop">
      <div class="wrap grid gap-8 py-16 md:py-24 lg:grid-cols-12">
        <p class="mono text-staal lg:col-span-3">NEN 3140 en de Arbowet</p>
        <div class="lg:col-span-9">
          <h2 id="waarom-kop" class="text-[clamp(1.9rem,3.4vw,3.2rem)] font-medium leading-[1.08]">Alle machines en arbeidsmiddelen in uw bedrijf moeten minimaal <span class="font-semibold text-groen-diep">jaarlijks</span> door een deskundige worden gekeurd.</h2>
          <p class="mt-7 max-w-2xl text-[1.2rem] text-staal">Naast de fabrikant (CE-markering) is de werkgever daarvoor verantwoordelijk. De NEN 3140 schrijft voor dat arbeidsmiddelen periodiek worden gekeurd, geïnspecteerd en waar nodig gekalibreerd.</p>
        </div>
      </div>
    </section>

    <!-- Contact: het antraciet van het bord. -->
    <section id="contact" class="op-bord bg-antraciet text-wit" aria-labelledby="contact-kop">
      <div class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 id="contact-kop" class="text-[clamp(2.3rem,4.4vw,4rem)]">Keuring inplannen?</h2>
          <p class="mt-5 max-w-lg text-[1.2rem] text-mist">Stuur een WhatsApp met het aantal stuks en de locatie. Wij stemmen de dag met u af.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={keuringApp} class="knop"><Fragment set:html={waIcoon} />WhatsApp {site.tel}</a>
            <a href={site.telHref} class="lijn text-[1.05rem]">Bellen</a>
            <a href={mailHref} class="lijn text-[1.05rem]">Mailen</a>
          </div>
        </div>
        <dl class="grid content-start gap-6 border-t border-white/15 pt-8 text-[1.1rem] lg:col-span-5 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
          <div><dt class="mono !text-[.8rem] text-mist">Adres</dt><dd class="mt-1">{site.straat}<br />{site.postcode} {site.plaats}<br /><a href={site.maps} class="lijn text-mist">Route in Google Maps</a></dd></div>
          <div><dt class="mono !text-[.8rem] text-mist">Mobiel</dt><dd class="mt-1"><a href={site.telHref} class="lijn tabular-nums">{site.tel}</a></dd></div>
          <div><dt class="mono !text-[.8rem] text-mist">E-mail</dt><dd class="mt-1"><a href={mailHref} class="lijn break-all">{site.mail}</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Voet />
</Base>
