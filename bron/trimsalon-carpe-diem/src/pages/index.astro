---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, behandelingen, tips } from '../data/site';
import hero from '../assets/hero.jpg';
import handdoek from '../assets/handdoek.jpg';
import bad from '../assets/bad.jpg';
---
<Base
  title="Hondentrimsalon Carpe Diem | Trimsalon in Zwijndrecht, op afspraak"
  description="Erkende hondentrimsalon in Zwijndrecht, aangesloten bij de VVTN. Plukken, ontwollen, knippen, scheren en puppybehandeling. Uw hond is altijd alleen in de salon. Bel of app voor een afspraak."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Tekst links op gebroken wit, foto rechts op een verschoven perzik vlak. -->
    <section class="wrap grid items-center gap-10 py-12 lg:grid-cols-12 lg:gap-8 lg:py-20">
      <div class="lg:col-span-6">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-teal">Hondentrimsalon in Zwijndrecht</p>
        <h1 class="mt-4 text-4xl">Uw hond alleen in de salon, met alle aandacht</h1>
        <p class="mt-6 max-w-xl text-lg text-ink-soft">Er zijn geen andere honden aanwezig tijdens de behandeling, tenzij u met meerdere honden van uzelf komt. Zo is uw hond in een rustige omgeving. Behandeling alleen op afspraak.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.telHref} class="btn btn-teal">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          <a href={site.whatsapp} rel="noopener" class="btn btn-line">App via WhatsApp</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft">
          <li><strong class="text-ink tabular-nums">{site.google.score}</strong> uit 5 op Google ({site.google.aantal} reviews)</li>
          <li>Top trimsalon van de VVTN</li>
        </ul>
      </div>
      <div class="relative lg:col-span-6 lg:col-start-7">
        <div aria-hidden="true" class="absolute -bottom-4 -right-2 left-8 top-8 rounded-[2rem] bg-peach md:-bottom-5 md:-right-5"></div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-[2rem] shadow-[0_1px_3px_#14302e26]">
          <Foto src={hero} alt="Klein wit hondje op een trimtafel, iemand knipt de vacht bij zijn kin met een schaar" hero sizes="(min-width: 1024px) 560px, 100vw" />
        </div>
      </div>
    </section>

    <!-- Behandelingen als genummerde rij op perzik: namen groot, prijs rechts. -->
    <section id="behandelingen" class="scroll-mt-20 bg-peach py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5 lg:pr-6">
          <h2 class="text-3xl">Behandelingen</h2>
          <p class="mt-4 text-ink-soft">In de salon wordt gewerkt met moderne materialen en professionele producten. Hygiëne en veiligheid staan voorop.</p>
          <div class="mt-8 hidden aspect-[4/3] overflow-hidden rounded-[1.5rem] lg:block">
            <Foto src={bad} alt="Nat krullend hondje in een roestvrijstalen wasbak met kraan en douchekop" sizes="420px" />
          </div>
        </div>
        <div class="lg:col-span-7 lg:col-start-6 lg:self-start">
          <ol class="border-t border-ink/20">
            {behandelingen.map((b, i) => (
              <li class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-ink/20 py-5 md:py-6">
                <span class="w-8 font-display text-sm font-semibold tabular-nums text-teal">0{i + 1}</span>
                <h3 class="min-w-0 flex-1 text-xl sm:text-2xl md:text-[2.25rem]">{b}</h3>
                <span class="basis-full whitespace-nowrap pl-[3.25rem] text-xs text-ink-soft tabular-nums sm:basis-auto sm:pl-0">[[AANLEVEREN: prijs]]</span>
              </li>
            ))}
          </ol>
          <p class="mt-6 text-sm text-ink-soft">[[AANLEVEREN: prijzen per behandeling, eventueel per ras of formaat]]</p>
          <div class="mt-8 rounded-[1.5rem] bg-paper p-6 md:flex md:items-center md:justify-between md:gap-6">
            <p class="font-display text-xl font-semibold leading-tight">Alles gaat op afspraak.</p>
            <a href={site.telHref} class="btn btn-teal mt-4 md:mt-0">Afspraak maken</a>
          </div>
          <div class="mt-8 aspect-[16/10] overflow-hidden rounded-[1.5rem] lg:hidden">
            <Foto src={bad} alt="Nat krullend hondje in een roestvrijstalen wasbak met kraan en douchekop" sizes="100vw" />
          </div>
        </div>
      </div>
    </section>

    <!-- Over Sonja: foto links, verhaal in ik-vorm rechts, feiten in een korte lijst. -->
    <section id="sonja" class="wrap grid scroll-mt-20 gap-10 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
      <div class="order-last lg:order-none lg:col-span-5">
        <div class="aspect-[4/3] overflow-hidden rounded-[2rem] lg:aspect-[4/5]">
          <Foto src={handdoek} alt="Oranje pomeriaan met een roze handdoek om zijn kop, iemand houdt een kam bij zijn wang" sizes="(min-width: 1024px) 460px, 100vw" />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7 lg:self-center">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-teal">Over de salon</p>
        <h2 class="mt-3 text-3xl">Ik ben Sonja Verbeek</h2>
        <div class="mt-6 space-y-4 text-lg">
          <p>Ik ben eigenaresse van Hondentrimsalon Carpe Diem en gediplomeerd trimster. Ik doe dit werk met groot plezier. Het is voor mij telkens weer een uitdaging dat uw hond netjes de salon verlaat.</p>
          <p class="text-ink-soft">Uw hond krijgt alle aandacht, want hij of zij is altijd alleen in de salon. Mijn salon is voorzien van verwarming en airco.</p>
        </div>
        <dl class="mt-10 grid gap-6 border-t border-line pt-8 sm:grid-cols-3">
          <div><dt class="text-sm text-ink-soft">Geopend</dt><dd class="mt-1 font-display text-xl font-semibold">mei 2007</dd></div>
          <div><dt class="text-sm text-ink-soft">Aangesloten bij</dt><dd class="mt-1 font-display text-xl font-semibold">de VVTN</dd></div>
          <div><dt class="text-sm text-ink-soft">Erkend als</dt><dd class="mt-1 font-display text-xl font-semibold leading-tight">Top trimsalon van de VVTN</dd></div>
        </dl>
      </div>
    </section>

    <!-- Checklist in twee kolommen met afvinkvakjes, de oude "Mededelingen". -->
    <section id="voor-de-trimbeurt" class="scroll-mt-20 border-t border-line py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12">
          <h2 class="text-3xl lg:col-span-5">Voor de trimbeurt</h2>
          <p class="text-lg text-ink-soft lg:col-span-6 lg:col-start-7 lg:self-end">Een paar dingen die de behandeling voor uw hond makkelijker maken.</p>
        </div>
        <ol class="mt-12 grid gap-x-10 gap-y-2 md:grid-cols-2">
          {tips.map((t) => (
            <li class="flex gap-4 rounded-2xl p-4 transition-colors hover:bg-peach/60">
              <span aria-hidden="true" class="mt-1 grid size-6 shrink-0 place-items-center rounded-md border-2 border-teal">
                <svg viewBox="0 0 16 16" class="size-3.5 text-teal"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <div>
                <h3 class="text-lg">{t.kop}</h3>
                <p class="mt-1 text-ink-soft">{t.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="contact" class="scroll-mt-20 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Maak een afspraak</h2>
          <p class="mt-4 text-lg text-white/80">Bel of stuur een WhatsApp-bericht. Behandeling volgens afspraak.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-peach">Bellen</a>
            <a href={site.whatsapp} rel="noopener" class="btn btn-line">WhatsApp</a>
          </div>
        </div>
        <dl class="grid content-start gap-6 text-lg sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
          <div class="sm:col-span-2"><dt class="text-sm text-white/75">Telefoon en WhatsApp</dt><dd><a href={site.telHref} class="whitespace-nowrap font-display text-3xl font-bold tabular-nums underline decoration-peach decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div class="sm:col-span-2"><dt class="text-sm text-white/75">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-peach decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-white/75">Adres</dt><dd><address class="not-italic">{site.straat}<br />{site.postcode} {site.plaats}</address><a href={site.maps} rel="noopener" class="mt-1 inline-block text-base underline underline-offset-4">Route plannen</a></dd></div>
          <div><dt class="text-sm text-white/75">Openingstijden</dt><dd class="text-base text-white/80">[[AANLEVEREN: dagen en tijden]]</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
