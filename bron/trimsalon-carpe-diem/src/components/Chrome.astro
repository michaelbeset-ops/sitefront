---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-baseline gap-2 no-underline">
        <span class="font-display text-2xl font-bold leading-none tracking-[-0.02em] text-teal">Carpe Diem</span>
        <span class="hidden text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft sm:inline">trimsalon</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href={url('#behandelingen')} class="no-underline transition-colors hover:text-teal">Behandelingen</a></li>
          <li><a href={url('#sonja')} class="no-underline transition-colors hover:text-teal">Over Sonja</a></li>
          <li><a href={url('#voor-de-trimbeurt')} class="no-underline transition-colors hover:text-teal">Voor de trimbeurt</a></li>
          <li><a href={url('#contact')} class="no-underline transition-colors hover:text-teal">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-teal !px-4 !py-2 text-sm">Bellen</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right">Aangesloten bij de VVTN<br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
