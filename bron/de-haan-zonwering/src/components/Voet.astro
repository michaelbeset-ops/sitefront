---
import { site, url, waHoi, tijden, uur } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const producten = ['Terrasschermen', 'Screens', 'Rolluiken', 'Markiezen', 'Uitvalschermen', 'Pergola zonwering', 'Serrezonwering', 'Horren en hordeuren'];
---
<footer class="bg-antr text-mist">
  <div class="doekbaan" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Uw specialist in zonwering &amp; rolluiken. Altijd gratis en vrijblijvend advies, bij u thuis.</p>
      <a href={waHoi} class="knop knop-oker mt-7 min-h-12 px-5"><Icoon naam="wa" />App Wim</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Producten</p>
      <ul class="mt-5 space-y-2.5">
        {producten.map((t) => <li><a href={h('producten')} class="no-underline transition-colors hover:text-oker-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2.5">
        <li>{site.naam}, {site.plaats}</li>
        <li><a href={site.telHref} class="num no-underline hover:text-oker-licht">Wim {site.tel}</a></li>
        <li><a href={site.tel2Href} class="num no-underline hover:text-oker-licht">Marjolein {site.tel2}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-oker-licht">{site.mail}</a></li>
        <li class="flex flex-wrap gap-x-5 gap-y-2 pt-1">
          <a href={site.insta} class="inline-flex items-center gap-2 no-underline hover:text-oker-licht"><Icoon naam="insta" class="h-5 w-5" />Instagram</a>
          <a href={site.fb} class="inline-flex items-center gap-2 no-underline hover:text-oker-licht"><Icoon naam="fb" class="h-5 w-5" />Facebook</a>
        </li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Openingstijden</p>
      <ul class="num mt-5 space-y-1.5 text-[.9375rem]">
        {tijden.map((t) => <li class="flex justify-between gap-3"><span>{t.dag.slice(0, 2)}</span><span>{t.open ? `${uur(t.open[0])}-${uur(t.open[1])}` : 'gesloten'}</span></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Teksten en eigen foto's van jullie website dehaan-zonwering.nl en Instagram. Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 15 oktober 2026).</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
