---
// Strak woordmerk naar hun logo (bron/site/img/De_Haan.png): een waaier van okerkleurige baleinen boven "De Haan Zonwering",
// met de ondertitel "Uw specialist in zonwering & rolluiken". Hun echte logo is te klein en te korrelig om groot te tonen.
import { url } from '../data/site';
interface Props { donker?: boolean; klein?: boolean }
const { donker = false, klein = false } = Astro.props;
---
<a href={url('')} class={`group inline-flex items-center gap-3 no-underline ${donker ? 'text-antr' : 'text-wit'}`}>
  <svg viewBox="0 0 52 40" class={klein ? 'h-9 w-auto' : 'h-10 w-auto sm:h-12'} aria-hidden="true">
    <g fill="#d9a01f">
      <path d="M3 34 11 4h4L8 34z" /><path d="M10 34 19 4h4l-8 30z" /><path d="M17 34 27 4h4l-9 30z" />
      <path d="M24 34 35 4h4L29 34z" /><path d="M31 34 43 4h4L36 34z" /><path d="M38 34 51 4h1v2L43 34z" />
    </g>
    <path d="M0 36h52v3H0z" fill="currentColor" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`font-[800] tracking-[-.02em] ${klein ? 'text-[1.3rem]' : 'text-[1.3rem] sm:text-[1.6rem]'}`} style="font-family: var(--font-kop)">De Haan <span class="text-oker">Zonwering</span></span>
    <span class={`mt-1.5 hidden text-[.6rem] font-[650] uppercase tracking-[.14em] min-[420px]:block sm:text-[.68rem] ${donker ? 'text-steen' : 'text-wit/75'}`}>Uw specialist in zonwering &amp; rolluiken</span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>
