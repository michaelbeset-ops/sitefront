---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, tijden, uur, waHoi } from '../data/site';

// Eigen foto's van dehaan-zonwering.nl; sfeerfoto's van Unsplash. Zie src/assets/BRONNEN.txt en tools/prep.mjs.
import sHero from '../assets/s-hero.jpg';
import sHeroM from '../assets/s-hero-m.jpg';
import sDoek from '../assets/s-doek.jpg';
import terras from '../assets/terras.jpg';
import pergola from '../assets/pergola.jpg';
import screens from '../assets/screens.jpg';
import rolluik from '../assets/rolluik.jpg';
import markies from '../assets/markies.jpg';
import uitval from '../assets/uitval.jpg';
import serre from '../assets/serre.jpg';
import bus from '../assets/bus.jpg';
import cassette from '../assets/cassette.jpg';
import gStreep from '../assets/g-streep.jpg';
import gMarkies from '../assets/g-markies.jpg';
import gScreens from '../assets/g-screens.jpg';
import gVeranda from '../assets/g-veranda.jpg';
import gWit from '../assets/g-wit.jpg';
import gTuinhuis from '../assets/g-tuinhuis.jpg';

const heroM = await getImage({ src: sHeroM, widths: [480, 760], format: 'webp', quality: 66 });
const heroD = await getImage({ src: sHero, widths: [1200, 1600, 2000, 2400], format: 'webp', quality: 64 });

const chips = ['Terrasschermen', 'Uitvalschermen', 'Screens', 'Markiezen', 'Rolluiken', 'Raamdecoratie', 'Serrezonwering', 'Pergola zonwering', 'Horren'];

// Echte cijfers uit hun productpagina's en Google.
const cijfers = [
  [site.google.score, `op Google, uit ${site.google.aantal} reviews`],
  ['5 jaar', 'volledige garantie op terrasschermen, screens en rolluiken'],
  ['13,5 m', 'zo breed is het terrasscherm type 3400 leverbaar'],
  ['20+', 'kleuren screendoek'],
];

// Ingekort uit hun eigen productpagina's (bron/site/producten__*.txt).
const producten = [
  { id: 'terrasschermen', t: 'Terrasschermen', d: 'Volledig gesloten cassette, tot 13,5 meter breed en met een uitval tot 3,5 meter. Acryldoek van Dickson en desgewenst led-verlichting.', g: '5 jaar volledige garantie', src: terras, pos: '50% 40%', alt: 'Terrasscherm met crèmewit doek op een dakterras' },
  { id: 'screens', t: 'Screens', d: 'Swela-doek met een glasvezel kern: oersterk, onbrandbaar en weersbestendig. Ook als windvast zipscreen.', g: '5 jaar volledige garantie', src: screens, pos: '60% 40%', alt: 'Antraciet screens voor de ramen van een appartementengebouw' },
  { id: 'rolluiken', t: 'Rolluiken', d: 'Dubbelwandige aluminium lamellen, gevuld met polyurethaanschuim. Isoleert tegen warmte, kou en geluid.', g: '5 jaar volledige garantie', src: rolluik, pos: '40% 30%', alt: 'Witte rolluiken aan een rode bakstenen woning' },
  { id: 'markiezen', t: 'Markiezen', d: 'Een prachtig stukje nostalgie. In hout, aluminium of een combinatie, met doeken van Dickson, Sunvas en Sattler.', g: '5 jaar garantie, doek uitgezonderd', src: markies, pos: '50% 55%', alt: 'Grijze markiezen boven de ramen van een bakstenen woning' },
  { id: 'uitvalschermen', t: 'Uitvalschermen', d: 'Windvaste armen met RVS-veer en een volledig gesloten cassette. Ideaal voor hoger gelegen ramen.', g: '5 jaar volledige garantie', src: uitval, pos: '50% 50%', alt: 'Zonneschermen met streepdoek aan een bungalow' },
  { id: 'pergola', t: 'Pergola zonwering', d: 'Voor grote terrassen. Een unieke ritssluiting houdt het doek windstabiel; dimbare led-verlichting kan erbij.', g: 'Ook als serrezonwering', src: pergola, pos: '40% 50%', alt: 'Pergola zonwering met led-verlichting boven een terras, in de avond' },
];

const stappen = [
  ['Bel of app', 'Bel of app Wim of Marjolein, of stel hierboven uw aanvraag samen.'],
  ['Advies bij u thuis', 'Wij komen geheel vrijblijvend bij u langs. Het advies is altijd gratis.'],
  ['Vrijblijvende offerte', 'U krijgt een offerte op maat van uw raam, deur of terras.'],
  ['Plaatsen en service', 'Wij plaatsen de zonwering. Ook voor reparatie kunt u bij ons terecht.'],
];

// Bijschrift = de productpagina waar de foto op hun eigen site staat.
const werk = [
  { src: gStreep, t: 'Pergola zonwering', cls: 'col-span-2 lg:col-span-7 lg:row-span-2', ratio: 'aspect-[4/3] lg:aspect-auto lg:h-full', pos: '50% 40%', w: 1024 },
  { src: gVeranda, t: 'Terrasscherm met led', cls: 'lg:col-span-5', ratio: 'aspect-[4/3]', pos: '50% 50%', w: 1400 },
  { src: gMarkies, t: 'Markiezen', cls: 'lg:col-span-5', ratio: 'aspect-[4/3]', pos: '50% 60%', w: 640 },
  { src: gScreens, t: 'Screens', cls: 'lg:col-span-4', ratio: 'aspect-[4/3]', pos: '50% 60%', w: 1400 },
  { src: gTuinhuis, t: 'Screens in een tuinhuis', cls: 'lg:col-span-4', ratio: 'aspect-[4/3]', pos: '50% 55%', w: 1400 },
  { src: gWit, t: 'Markiezen', cls: 'col-span-2 sm:col-span-1 lg:col-span-4', ratio: 'aspect-[16/9] sm:aspect-[4/3]', pos: '50% 60%', w: 640 },
];

// Letterlijk of licht ingekort van hun eigen productpagina's.
const vragen = [
  ['Hoeveel garantie krijg ik?', 'Op terrasschermen, uitvalschermen, screens en rolluiken geven wij 5 jaar volledige garantie. Op markiezen 5 jaar, met uitzondering van het doek. De horren van Unilux hebben 5 jaar garantie op de constructie.'],
  ['Kan ik de zonwering met mijn telefoon bedienen?', 'Ja. Met de Somfy TaHoma of Connexoon, of de hub van Brel, bedient u elk gemotoriseerd product in huis via uw smartphone, tablet of laptop. Een schakelaar of afstandsbediening kan natuurlijk ook.'],
  ['Welke kleuren zijn er?', 'Terrasschermen hebben standaard een omkasting in crèmewit (RAL 9001) of wit (RAL 9016); black metallic tegen een kleine meerprijs. Elke andere RAL-kleur is ook mogelijk. Rolluiken zijn standaard leverbaar in meer dan 10 RAL-kleuren.'],
  ['Wat doe ik met rolluiken bij vorst?', 'Bij droog vriezend weer is er niets aan de hand. Maar is het vochtig, bijvoorbeeld door mist, dan kunnen de lamellen vastvriezen. Bedien het rolluik dan niet: vorstschade valt niet onder de garantie.'],
];

const merken = ['Somfy', 'Simu', 'Brel', 'Dickson', 'Swela', 'Sattler', 'Sunvas', 'Unilux'];

// Aanvraag: keuzes.
const soorten = ['Terrasscherm', 'Screen', 'Rolluik', 'Markies', 'Uitvalscherm', 'Pergola zonwering', 'Serrezonwering', 'Hor of hordeur', 'Reparatie'];
const plekken = ['Raam', 'Deur of schuifpui', 'Terras', 'Balkon', 'Dakraam of serre'];
const bedieningen = ['Elektrisch', 'Met de hand', 'Via smartphone', 'Weet ik nog niet'];

const sterren = [1, 2, 3, 4, 5];
---
<Base title="De Haan Zonwering | Zonwering en rolluiken in Sleeuwijk" description="Terrasschermen, screens, rolluiken, markiezen, uitvalschermen en horren. Altijd gratis en vrijblijvend advies bij u thuis. Bel Wim: 06 20 40 26 06.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-antr text-wit" aria-labelledby="inhoud">
      <picture>
        <source media="(max-width: 767px)" srcset={heroM.srcSet.attribute} sizes="100vw" />
        <source media="(min-width: 768px)" srcset={heroD.srcSet.attribute} sizes="100vw" />
        <img src={heroD.src} alt="" width="2400" height="1600" loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_50%] md:-scale-x-100 md:object-[50%_45%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#26282cd9_0%,#26282c59_30%,#26282cd1_60%,#26282cfa_100%)] md:bg-[linear-gradient(90deg,#26282cf2_0%,#26282cc7_36%,#26282c33_64%,#26282c0d_100%),linear-gradient(180deg,#26282cb3_0%,#26282c00_30%,#26282c00_70%,#26282cb3_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-24 pt-32 md:pb-20 md:pt-40 lg:pt-52">
        <div class="max-w-[52rem]">
          <p class="eyebrow eyebrow-licht">Zonwering en rolluiken in {site.plaats}</p>
          <h1 id="inhoud" class="mt-6 text-hero">Uw specialist in <span class="text-oker">zonwering</span> &amp; rolluiken.</h1>
          <p class="mt-7 max-w-[38rem] text-[clamp(1.125rem,.6vw+1rem,1.4rem)] leading-relaxed text-wit/90">Voor een vrijblijvende offerte kunt u altijd contact met ons opnemen. Wij komen dan geheel vrijblijvend bij u langs.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#aanvraag" class="knop knop-oker">Zonwering aanvragen<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />Bel Wim: {site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-[1rem] font-semibold text-wit/90">
            <li><a href={site.reviews} class="flex items-center gap-2 text-wit/90 no-underline hover:text-wit"><span class="flex text-oker" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span class="num">{site.google.score}</span> op Google · {site.google.aantal} reviews</a></li>
            <li class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-wit/50" data-stip></span><span data-nu>Openingstijden</span></li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-oker" />5 jaar garantie</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- 2. Productchips + cijfers -->
    <section class="bg-wit" aria-label="Wat wij leveren">
      <div class="doekbaan doekbaan-donker" aria-hidden="true"></div>
      <div class="wrap py-10">
        <ul class="flex flex-wrap gap-2.5" aria-label="Producten">
          {chips.map((c) => <li class="chip">{c}</li>)}
        </ul>
      </div>
      <div class="border-t border-lijn-licht">
        <dl class="wrap grid grid-cols-2 gap-x-6 gap-y-10 py-12 md:py-16 lg:grid-cols-4">
          {cijfers.map(([n, t], i) => (
            <div class={`rijs ${i ? 'lg:border-l lg:border-lijn-licht lg:pl-8' : ''}`} style={`--d:${i * 0.06}s`}>
              <dt class="sr-only">{t}</dt>
              <dd class="num text-[clamp(2.4rem,3vw+1.2rem,3.6rem)] font-[800] leading-none tracking-[-.04em]" style="font-family: var(--font-kop)">{n}</dd>
              <dd class="mt-3 max-w-[16rem] text-[1rem] text-steen">{t}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 3. Producten -->
    <section id="producten" class="py-20 md:py-28" aria-labelledby="t-prod">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-8">
            <p class="eyebrow">Producten</p>
            <h2 id="t-prod" class="mt-5 max-w-[44rem] text-4xl">Zonwering voor elk raam, elke deur en elk terras.</h2>
          </div>
          <p class="rijs text-lg text-steen lg:col-span-4 lg:col-start-9 lg:pb-2" style="--d:.06s">Met de bediening die bij u past: schakelaar, afstandsbediening of smartphone.</p>
        </div>
        <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {producten.map((p, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden">
                <div class="relative aspect-[16/10] overflow-hidden">
                  <Image src={p.src} alt={p.alt} widths={[480, 720, Math.min(p.src.width, 960)]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" quality={70} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${p.pos}`} />
                  <span class="absolute left-4 top-4 rounded-full bg-antr/85 px-3 py-1.5 text-[.8125rem] font-bold text-wit backdrop-blur-sm">{p.g}</span>
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-2xl">{p.t}</h3>
                  <p class="mt-3 flex-1 text-steen">{p.d}</p>
                  <a href="#aanvraag" class="mt-5 inline-flex items-center gap-2 font-bold text-antr no-underline transition-colors hover:text-oker-tekst" data-kies={p.t}>Aanvragen<Icoon naam="pijl" class="h-5 w-5 transition-transform group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>

        <!-- Serre + horren -->
        <div class="mt-6 grid gap-6 lg:grid-cols-2">
          <article class="rijs kaart grid overflow-hidden sm:grid-cols-2">
            <Image src={serre} alt="Serrezonwering onder een glazen dak" widths={[480, 720, 960]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw" quality={70} class="aspect-[4/3] h-full w-full object-cover sm:aspect-auto" />
            <div class="p-7">
              <h3 class="text-2xl">Serrezonwering</h3>
              <p class="mt-3 text-steen">Voor glaskoepels en overkappingen, binnen of buiten. Een veerconstructie houdt het doek in iedere positie strak.</p>
            </div>
          </article>
          <article class="rijs kaart flex flex-col justify-between p-7 sm:p-9" style="--d:.06s">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="text-2xl">Horren en hordeuren</h3>
                <span class="rounded-full bg-oker-zacht px-3 py-1.5 text-[.8125rem] font-bold text-oker-tekst">Unilux Premium Dealer</span>
              </div>
              <p class="mt-3 text-steen">“Lekker uw ramen en deuren openen zonder insecten binnen?!” Voor een vaste hor, een rolhor of een complete hordeur bent u bij ons aan het juiste adres.</p>
            </div>
            <ul class="mt-6 flex flex-wrap gap-2">
              {['Raamrolhorren', 'Vaste raamhorren', 'Plisséhordeuren', 'Schuifhordeuren', 'Dakvensters'].map((h) => <li class="rounded-full border border-linnen-3 px-3 py-1 text-[.9375rem] font-semibold">{h}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 4. Aanvraag (wow) -->
    <section id="aanvraag" class="relative isolate overflow-hidden bg-antr py-24 text-wit md:py-32" aria-labelledby="t-aanvraag">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow eyebrow-licht">Aanvraag</p>
            <h2 id="t-aanvraag" class="mt-5 text-4xl">Stel uw zonwering samen.</h2>
          </div>
          <p class="rijs text-lg text-mist lg:col-span-4 lg:col-start-9" style="--d:.06s">Kies wat u zoekt, waar het komt en hoe breed. U ziet meteen een schets, en Wim krijgt uw vraag in één WhatsApp-bericht.</p>
        </div>

        <form class="mt-14 grid gap-10 lg:grid-cols-12 lg:gap-12" data-aanvraag>
          <div class="space-y-9 lg:col-span-7">
            <fieldset>
              <legend class="veld-label"><span class="num mr-2 text-oker-licht">1</span>Wat zoekt u?</legend>
              <div class="flex flex-wrap gap-2.5">
                {soorten.map((s, i) => <label class="keuze"><input type="radio" name="soort" value={s} checked={i === 0} />{s}</label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label"><span class="num mr-2 text-oker-licht">2</span>Waar komt het?</legend>
              <div class="flex flex-wrap gap-2.5">
                {plekken.map((s, i) => <label class="keuze"><input type="radio" name="waar" value={s} checked={i === 2} />{s}</label>)}
              </div>
            </fieldset>
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <label for="breedte" class="veld-label"><span class="num mr-2 text-oker-licht">3</span>Breedte, ongeveer</label>
                <output class="num text-2xl font-[800] text-oker-licht" style="font-family: var(--font-kop)" for="breedte" data-breedte-uit>450 cm</output>
              </div>
              <input id="breedte" name="breedte" type="range" min="50" max="1350" step="10" value="450" class="schuif" data-breedte />
              <label class="mt-3 inline-flex cursor-pointer items-center gap-2.5 text-mist"><input type="checkbox" name="onbekend" class="h-5 w-5 accent-[#d9a01f]" />Nog niet gemeten</label>
            </div>
            <fieldset>
              <legend class="veld-label"><span class="num mr-2 text-oker-licht">4</span>Bediening</legend>
              <div class="flex flex-wrap gap-2.5">
                {bedieningen.map((s, i) => <label class="keuze"><input type="radio" name="bediening" value={s} checked={i === 0} />{s}</label>)}
              </div>
            </fieldset>
            <div class="grid gap-5 sm:grid-cols-2">
              <div><label for="naam" class="veld-label">Uw naam</label><input id="naam" name="naam" class="veld" autocomplete="name" placeholder="Voornaam" /></div>
              <div><label for="plaats" class="veld-label">Plaats</label><input id="plaats" name="plaats" class="veld" autocomplete="address-level2" placeholder="Bijvoorbeeld Sleeuwijk" /></div>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-8">
              <div class="overflow-hidden rounded-[1.25rem] bg-linnen text-antr">
                <svg viewBox="0 0 640 420" class="block h-auto w-full" role="img" aria-label="Schets van uw keuze" data-schets></svg>
                <p class="flex items-center justify-between gap-3 border-t border-lijn-licht px-5 py-3 text-[.9375rem] font-semibold text-steen"><span data-schets-label>Terrasscherm, terras</span><span>Schets, niet op schaal</span></p>
              </div>
              <div class="mt-5 rounded-[1.25rem] border border-lijn bg-antr-2 p-5">
                <p class="text-[.875rem] font-bold uppercase tracking-[.12em] text-mist">Uw bericht aan Wim</p>
                <p class="mt-3 whitespace-pre-line text-[1rem] leading-relaxed" data-bericht></p>
              </div>
              <a href={waHoi} class="knop knop-groen mt-5 w-full" data-verstuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
              <p class="mt-3 text-[.9375rem] text-mist">Er wordt pas iets verstuurd als u het bericht zelf in WhatsApp verstuurt.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section class="py-20 md:py-28" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="rijs max-w-3xl">
          <p class="eyebrow">Zo werkt het</p>
          <h2 id="t-werk" class="mt-5 text-4xl">Altijd gratis en vrijblijvend advies.</h2>
        </div>
        <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart flex gap-5 p-6 sm:block sm:p-7" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num text-[2.6rem] sm:text-[3.6rem]">0{i + 1}</span>
              <div><h3 class="text-xl sm:mt-6">{t}</h3>
              <p class="mt-2 text-steen sm:mt-3">{d}</p></div>
            </li>
          ))}
        </ol>
        <div class="rijs mt-6 flex flex-col items-start justify-between gap-5 rounded-[1.25rem] bg-oker px-7 py-6 text-antr md:flex-row md:items-center">
          <p class="text-xl font-[800]" style="font-family: var(--font-kop)">Liever meteen iemand spreken?</p>
          <div class="flex flex-wrap gap-3">
            <a href={site.telHref} class="knop knop-antr num min-h-12"><Icoon naam="tel" />Wim {site.tel}</a>
            <a href={site.tel2Href} class="knop knop-antr num min-h-12"><Icoon naam="tel" />Marjolein {site.tel2}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Referenties -->
    <section id="referenties" class="bg-wit py-20 md:py-28" aria-labelledby="t-ref">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Referenties</p>
            <h2 id="t-ref" class="mt-5 text-4xl">Uit onze referenties.</h2>
          </div>
          <a href={site.insta} class="rijs link justify-self-start font-bold lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">Meer op Instagram</a>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-12 lg:gap-5">
          {werk.map((w, i) => (
            <li class={`rijs ${w.cls}`} style={`--d:${(i % 3) * 0.05}s`}>
              <figure class={`group relative overflow-hidden rounded-[1.25rem] ${w.ratio}`}>
                <Image src={w.src} alt={w.t} widths={[480, 720, Math.min(w.w, 1100)]} sizes="(min-width: 1024px) 50vw, (min-width: 640px) 50vw, 100vw" quality={70} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" style={`object-position:${w.pos}`} />
                <figcaption class="absolute bottom-2 left-2 rounded-full bg-antr/85 px-3 py-1 text-[.8125rem] font-bold text-wit backdrop-blur-sm sm:bottom-3 sm:left-3 sm:px-3.5 sm:py-1.5 sm:text-[.875rem]">{w.t}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="bg-antr py-24 text-wit md:py-32" aria-labelledby="t-over">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:items-center">
        <div class="rijs lg:col-span-6">
          <div class="relative">
            <Image src={bus} alt="De bus van De Haan Zonwering met het logo en het telefoonnummer" widths={[480, 720, 1024]} sizes="(min-width: 1024px) 560px, 100vw" quality={72} class="aspect-[16/10] w-full rounded-[1.25rem] object-cover" />
            <Image src={cassette} alt="Cassette van een terrasscherm met led-spots aan de gevel" widths={[320, 480]} sizes="220px" quality={70} class="absolute -bottom-8 right-4 hidden aspect-square w-[42%] rounded-[1.25rem] border-[6px] border-antr object-cover sm:block" />
          </div>
        </div>
        <div class="lg:col-span-6 lg:pl-6">
          <p class="rijs eyebrow eyebrow-licht">Over ons</p>
          <h2 id="t-over" class="rijs mt-5 text-4xl">Wim en Marjolein de Haan.</h2>
          <p class="rijs mt-6 text-lg text-mist">De Haan Zonwering is het bedrijf van Wim en Marjolein uit {site.plaats}. U belt of appt met een van hen zelf, en zij komen bij u langs voor advies.</p>
          <ul class="mt-9 space-y-4">
            {[
              ['Snel ter plaatse', 'Wim en Marjolein waren er binnen een kwartier en hebben het vakkundig gerepareerd!', 'Lida H.'],
              ['Ook voor reparatie', 'Ons oude rolluik kraakte aan alle kanten en is door hen gerepareerd! Loopt weer soepel.', 'W.B.'],
              ['Snel antwoord', 'Ook bij aanvraag van een offerte en/of informatie wordt er snel en professioneel gereageerd.', 'Johan J.'],
            ].map(([t, q, n], i) => (
              <li class="rijs flex gap-4 rounded-[1.25rem] border border-lijn bg-antr-2 p-5" style={`--d:${i * 0.06}s`}>
                <Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-oker" />
                <div><p class="font-bold">{t}</p><p class="mt-1 text-mist">“{q}” <span class="whitespace-nowrap text-[.9375rem]">{n}, Google</span></p></div>
              </li>
            ))}
          </ul>
          <div class="rijs mt-9 border-t border-lijn pt-7">
            <p class="text-[.875rem] font-bold uppercase tracking-[.12em] text-mist">Motoren en doeken van</p>
            <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-lg font-[800] text-wit/85" style="font-family: var(--font-kop)">
              {merken.map((m) => <li>{m}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Goed om te weten -->
    <section class="py-20 md:py-28" aria-labelledby="t-faq">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="rijs lg:col-span-4">
          <p class="eyebrow">Goed om te weten</p>
          <h2 id="t-faq" class="mt-5 text-3xl">Veelgestelde vragen.</h2>
          <a href={waHoi} class="knop knop-oker mt-8"><Icoon naam="wa" />Andere vraag? App Wim</a>
        </div>
        <div class="lg:col-span-8">
          {vragen.map(([v, a], i) => (
            <details class="rijs group border-b border-lijn-licht py-2 first:border-t" style={`--d:${i * 0.05}s`} open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-xl font-[750] [&::-webkit-details-marker]:hidden" style="font-family: var(--font-kop)">
                {v}
                <span class="grid h-10 w-10 flex-none place-items-center rounded-full border border-linnen-3 transition-transform duration-300 group-open:rotate-45" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg></span>
              </summary>
              <p class="max-w-2xl pb-6 text-lg text-steen">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. Reviews -->
    <section id="reviews" class="bg-wit py-20 md:py-28" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-6 py-5 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-10 w-10 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num text-3xl font-[800] leading-none text-antr">{site.google.score}</b><span class="flex text-oker" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span></span>
              <span class="mt-1 block text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-14 lg:grid-cols-6">
          {reviews.map((r, i) => (
            <li class={`rijs ${i < 2 ? 'lg:col-span-3' : 'lg:col-span-2'}`} style={`--d:${(i % 3) * 0.06}s`}>
              <figure class={`flex h-full flex-col rounded-[1.25rem] p-8 ${i === 0 ? 'bg-antr text-wit' : 'kaart'}`}>
                <div class="flex gap-0.5 text-oker" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</div>
                <blockquote class={`mt-5 flex-1 leading-relaxed ${i === 0 ? 'text-[1.1875rem]' : 'text-[1.0625rem]'}`}>“{r.tekst}”</blockquote>
                <figcaption class={`mt-6 flex items-center gap-3 border-t pt-5 ${i === 0 ? 'border-lijn' : 'border-lijn-licht'}`}>
                  <span class={`grid h-11 w-11 flex-none place-items-center rounded-full text-lg font-bold ${i === 0 ? 'bg-oker text-antr' : 'bg-linnen-2'}`}>{r.naam[0]}</span>
                  <span><b class="block">{r.naam}</b><span class={`text-[.9375rem] ${i === 0 ? 'text-mist' : 'text-steen'}`}>Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 10. Contact en tijden -->
    <section id="contact" class="py-20 md:py-28" aria-labelledby="t-contact">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Contact</p>
          <h2 id="t-contact" class="rijs mt-5 text-4xl">Bel, app of mail.</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-steen">Voor een vrijblijvende offerte kunt u altijd contact met ons opnemen.</p>
          <div class="rijs mt-9 grid gap-4 sm:grid-cols-2">
            <a href={site.telHref} class="kaart group block p-6 no-underline transition-shadow hover:shadow-md">
              <span class="text-[.9375rem] font-bold uppercase tracking-[.12em] text-oker-tekst">Wim</span>
              <span class="num mt-2 block text-[clamp(1.6rem,2vw+1rem,2.2rem)] font-[800] leading-none tracking-[-.03em] text-antr" style="font-family: var(--font-kop)">{site.tel}</span>
            </a>
            <a href={site.tel2Href} class="kaart group block p-6 no-underline transition-shadow hover:shadow-md">
              <span class="text-[.9375rem] font-bold uppercase tracking-[.12em] text-oker-tekst">Marjolein</span>
              <span class="num mt-2 block text-[clamp(1.6rem,2vw+1rem,2.2rem)] font-[800] leading-none tracking-[-.03em] text-antr" style="font-family: var(--font-kop)">{site.tel2}</span>
            </a>
          </div>
          <div class="rijs mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--d:.1s">
            <a href={waHoi} class="knop knop-groen"><Icoon naam="wa" />WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="knop knop-rand">{site.mail}</a>
          </div>
          <div class="rijs mt-10 flex gap-4 border-t border-lijn-licht pt-8" style="--d:.14s">
            <Icoon naam="pin" class="mt-1 h-6 w-6 flex-none text-oker-tekst" />
            <div>
              <p class="font-extrabold">{site.naam}, {site.plaats}</p>
              <p class="mt-1 text-steen">Wij komen bij u langs. KvK {site.kvk}.</p>
            </div>
          </div>
        </div>
        <div class="rijs lg:col-span-5" style="--d:.15s">
          <div class="kaart overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-lijn-licht px-6 py-5">
              <p class="text-xl font-extrabold">Openingstijden</p>
              <p class="flex items-center gap-2 text-[.9375rem] font-bold"><span class="h-3 w-3 rounded-full bg-linnen-3" data-stip></span><span data-nu>Vandaag</span></p>
            </div>
            <table class="w-full">
              <caption class="sr-only">Openingstijden volgens Google</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr class="border-b border-lijn-licht last:border-0 data-[vandaag]:bg-oker-zacht data-[vandaag]:font-extrabold" data-dag={t.nr}>
                    <th scope="row" class="py-3 pl-5 pr-2 text-left font-[inherit] sm:px-6">{t.dag}</th>
                    <td class="num whitespace-nowrap py-3 pl-2 pr-5 text-right sm:px-6">{t.open ? `${uur(t.open[0])} tot ${uur(t.open[1])}` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="border-t border-lijn-licht bg-linnen px-6 py-4 text-[.9375rem] text-steen">Tijden volgens Google.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="relative isolate overflow-hidden bg-antr text-wit" aria-label="Advies aanvragen">
      <Image src={sDoek} alt="" widths={[800, 1400, 2000]} sizes="100vw" quality={60} class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_35%] opacity-40" />
      <div class="wrap flex flex-col items-start justify-between gap-6 py-20 md:flex-row md:items-center md:py-24">
        <p class="max-w-3xl text-[clamp(2rem,2.6vw+1rem,3.3rem)] font-[800] leading-none tracking-[-.035em]" style="font-family: var(--font-kop)">Altijd gratis en <span class="text-oker">vrijblijvend</span> advies.</p>
        <a href={waHoi} class="knop knop-oker shrink-0"><Icoon naam="wa" />App Wim</a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site, tijden } from '../data/site';
  // Aanvraag: schets tekenen en bericht opbouwen -> vooraf ingevuld WhatsApp.
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  const svg = document.querySelector<SVGSVGElement>('[data-schets]');
  const label = document.querySelector<HTMLElement>('[data-schets-label]');
  const bericht = document.querySelector<HTMLElement>('[data-bericht]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const uit = document.querySelector<HTMLOutputElement>('[data-breedte-uit]');
  const schuif = document.querySelector<HTMLInputElement>('[data-breedte]');
  const A = '#26282c', O = '#d9a01f', M = '#d6cdbb';

  function schets(soort: string, waar: string, cm: number, onbekend: boolean) {
    const w = Math.round(110 + ((Math.min(Math.max(cm, 50), 1350) - 50) / 1300) * 440);
    const x0 = 320 - w / 2;
    const vloer = 352;
    const groot = waar === 'Terras' || waar === 'Balkon' || waar === 'Deur of schuifpui';
    // opening in de gevel
    const oy = waar === 'Raam' ? 150 : waar === 'Dakraam of serre' ? 170 : 130;
    const oh = waar === 'Raam' ? 120 : waar === 'Dakraam of serre' ? 182 : vloer - 130;
    const ow = Math.max(80, w - 40);
    const ox = 320 - ow / 2;
    let s = `<defs>
      <pattern id="streep" width="28" height="10" patternUnits="userSpaceOnUse"><rect width="14" height="10" fill="${O}"/><rect x="14" width="14" height="10" fill="#f6e7c4"/></pattern>
      <pattern id="gaas" width="7" height="7" patternUnits="userSpaceOnUse"><path d="M0 0h7v7" fill="none" stroke="${A}" stroke-opacity=".35" stroke-width=".8"/></pattern>
      <pattern id="steen" width="40" height="20" patternUnits="userSpaceOnUse"><path d="M0 19.5h40M20 0v10M0 10h40M0 9.5h40" stroke="${A}" stroke-opacity=".06" stroke-width="1"/></pattern>
    </defs>
    <rect width="640" height="420" fill="#f6f2ea"/>
    <rect x="24" y="36" width="592" height="${vloer - 36}" fill="url(#steen)" stroke="${A}" stroke-opacity=".18"/>
    <path d="M0 ${vloer}h640" stroke="${A}" stroke-width="2"/>`;
    if (waar === 'Dakraam of serre') {
      s += `<path d="M${ox} ${oy}L${ox + 30} ${oy - 70}H${ox + ow - 30}L${ox + ow} ${oy}Z" fill="#ffffff" stroke="${A}" stroke-width="2"/>`;
      for (let i = 1; i < 6; i++) { const t = i / 6; s += `<path d="M${ox + ow * t} ${oy}L${ox + 30 + (ow - 60) * t} ${oy - 70}" stroke="${A}" stroke-opacity=".4"/>`; }
    }
    // gevelopening (raam/deur/pui)
    s += `<rect x="${ox}" y="${oy}" width="${ow}" height="${oh}" fill="#ffffff" stroke="${A}" stroke-width="2.5"/>`;
    const vakken = Math.max(1, Math.round(ow / 110));
    for (let i = 1; i < vakken; i++) s += `<path d="M${ox + (ow / vakken) * i} ${oy}v${oh}" stroke="${A}" stroke-width="2"/>`;
    if (groot) s += `<path d="M${ox - 30} ${vloer}h${ow + 60}" stroke="${O}" stroke-width="6"/>`;
    // product
    const top = oy - 22;
    if (soort === 'Screen' || soort === 'Rolluik' || soort === 'Reparatie') {
      const neer = Math.round(oh * 0.62);
      s += `<rect x="${ox - 8}" y="${top}" width="${ow + 16}" height="20" rx="4" fill="${A}"/>`;
      s += `<path d="M${ox - 4} ${top + 20}v${oh + 2}M${ox + ow + 4} ${top + 20}v${oh + 2}" stroke="${A}" stroke-width="5"/>`;
      if (soort === 'Screen') s += `<rect x="${ox}" y="${top + 20}" width="${ow}" height="${neer}" fill="${A}" fill-opacity=".72"/>`;
      else { s += `<rect x="${ox}" y="${top + 20}" width="${ow}" height="${neer}" fill="${M}"/>`; for (let y = top + 28; y < top + 20 + neer; y += 9) s += `<path d="M${ox} ${y}h${ow}" stroke="${A}" stroke-opacity=".35"/>`; }
      s += `<rect x="${ox}" y="${top + 16 + neer}" width="${ow}" height="6" fill="${A}"/>`;
      if (soort === 'Reparatie') s += `<circle cx="${ox + ow - 8}" cy="${top + 4}" r="26" fill="${O}"/><path d="M${ox + ow - 18} ${top + 14}l16-16m-4 0a7 7 0 1 0 6-6" stroke="${A}" stroke-width="4" fill="none" stroke-linecap="round"/>`;
    } else if (soort === 'Hor of hordeur') {
      s += `<rect x="${ox + 6}" y="${oy + 6}" width="${ow - 12}" height="${oh - 12}" fill="url(#gaas)" stroke="${A}" stroke-width="4"/>`;
    } else if (soort === 'Markies') {
      const mh = 70, mt = oy - 64;
      s += `<path d="M${ox - 6} ${mt + mh}V${mt + 18}Q${ox - 6} ${mt} ${ox + 20} ${mt}H${ox + ow - 20}Q${ox + ow + 6} ${mt} ${ox + ow + 6} ${mt + 18}V${mt + mh}Z" fill="url(#streep)" stroke="${A}" stroke-width="2.5"/>`;
      const n = Math.max(3, Math.round((ow + 12) / 34)), b = (ow + 12) / n;
      let p = `M${ox - 6} ${mt + mh}`; for (let i = 0; i < n; i++) p += `a${b / 2} ${b / 2.6} 0 0 0 ${b} 0`;
      s += `<path d="${p}Z" fill="${O}" stroke="${A}" stroke-width="2"/>`;
      for (let i = 1; i < 5; i++) s += `<path d="M${ox - 6} ${mt + 14 * i}H${ox + ow + 6}" stroke="${A}" stroke-opacity=".25"/>`;
    } else if (soort === 'Uitvalscherm') {
      const ct = oy - 30;
      s += `<rect x="${ox - 8}" y="${ct}" width="${ow + 16}" height="18" rx="4" fill="${A}"/>`;
      s += `<path d="M${ox - 4} ${ct + 18}L${ox - 4} ${ct + 92}H${ox + ow + 4}L${ox + ow + 4} ${ct + 18}Z" fill="url(#streep)" stroke="${A}" stroke-width="2"/>`;
      s += `<path d="M${ox - 4} ${ct + 92}h${ow + 8}" stroke="${A}" stroke-width="6"/>`;
      s += `<path d="M${ox - 4} ${oy + oh - 10}L${ox - 4} ${ct + 92}M${ox + ow + 4} ${oy + oh - 10}L${ox + ow + 4} ${ct + 92}" stroke="${A}" stroke-width="3" stroke-dasharray="2 0"/>`;
    } else if (soort === 'Pergola zonwering') {
      const py = 70;
      s += `<rect x="${x0}" y="${py}" width="${w}" height="16" fill="${A}"/>`;
      s += `<path d="M${x0 + 6} ${py + 16}V${vloer}M${x0 + w - 6} ${py + 16}V${vloer}" stroke="${A}" stroke-width="10"/>`;
      s += `<rect x="${x0 + 11}" y="${py + 16}" width="${w - 22}" height="34" fill="url(#streep)" stroke="${A}" stroke-width="1.5"/>`;
      s += `<path d="M${x0 + 20} ${py + 13}H${x0 + w - 20}" stroke="#ffd56b" stroke-width="3" stroke-dasharray="4 10"/>`;
    } else if (soort === 'Serrezonwering') {
      s += `<path d="M${ox + 8} ${oy - 4}L${ox + 34} ${oy - 62}H${ox + ow - 34}L${ox + ow - 8} ${oy - 4}Z" fill="url(#streep)" fill-opacity=".85" stroke="${A}" stroke-width="2"/>`;
    } else {
      // terrasscherm: cassette, doek in vooraanzicht, voorlijst en volant
      const ct = waar === 'Raam' ? oy - 60 : 66;
      s += `<rect x="${x0}" y="${ct}" width="${w}" height="20" rx="5" fill="${A}"/>`;
      s += `<path d="M${x0 + 6} ${ct + 20}L${x0 - 10} ${ct + 104}H${x0 + w + 10}L${x0 + w - 6} ${ct + 20}Z" fill="url(#streep)" stroke="${A}" stroke-width="2"/>`;
      s += `<rect x="${x0 - 14}" y="${ct + 102}" width="${w + 28}" height="10" rx="3" fill="${A}"/>`;
      s += `<rect x="${x0 - 12}" y="${ct + 112}" width="${w + 24}" height="16" fill="${O}" stroke="${A}" stroke-width="1.5"/>`;
    }
    // maatlijn
    const mx = soort === 'Pergola zonwering' || soort === 'Terrasscherm' ? x0 : ox;
    const mw = soort === 'Pergola zonwering' || soort === 'Terrasscherm' ? w : ow;
    s += `<g stroke="${A}" stroke-width="2"><path d="M${mx} 370h${mw}"/><path d="M${mx} 362v16M${mx + mw} 362v16"/></g>`;
    s += `<rect x="${320 - 64}" y="386" width="128" height="26" rx="13" fill="${A}"/><text x="320" y="404" text-anchor="middle" font-family="Public Sans Variable, sans-serif" font-weight="700" font-size="15" fill="#fff">${onbekend ? 'nog meten' : '± ' + cm + ' cm'}</text>`;
    return s;
  }

  if (f && svg && bericht && knop) {
    const zet = () => {
      const d = new FormData(f);
      const soort = String(d.get('soort'));
      const waar = String(d.get('waar'));
      const cm = Number(d.get('breedte'));
      const onbekend = d.get('onbekend') === 'on';
      const bed = String(d.get('bediening'));
      const naam = String(d.get('naam') || '').trim();
      const plaats = String(d.get('plaats') || '').trim();
      if (uit) uit.textContent = onbekend ? 'nog meten' : `${cm} cm`;
      if (schuif) { schuif.style.setProperty('--p', `${((cm - 50) / 1300) * 100}%`); schuif.disabled = onbekend; schuif.style.opacity = onbekend ? '.4' : '1'; }
      svg.innerHTML = schets(soort, waar, cm, onbekend);
      if (label) label.textContent = `${soort}, ${waar.toLowerCase()}`;
      const r = [soort === 'Reparatie' ? 'Hallo Wim, ik heb een reparatie aan mijn zonwering.' : `Hallo Wim, ik heb interesse in: ${soort.toLowerCase()}.`];
      r.push(`Waar: ${waar.toLowerCase()}.`);
      r.push(onbekend ? 'Breedte: nog niet gemeten.' : `Breedte: ongeveer ${cm} cm.`);
      if (soort !== 'Reparatie' && soort !== 'Hor of hordeur') r.push(`Bediening: ${bed.toLowerCase()}.`);
      if (naam || plaats) r.push(`${naam ? `Naam: ${naam}` : ''}${naam && plaats ? ', ' : ''}${plaats ? `plaats: ${plaats}` : ''}.`);
      r.push('Kunnen jullie vrijblijvend langskomen?');
      const t = r.join('\n');
      bericht.textContent = t; knop.href = `${site.wa}?text=${encodeURIComponent(t)}`;
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    // "Aanvragen" op een productkaart zet die keuze klaar.
    const map: Record<string, string> = { Terrasschermen: 'Terrasscherm', Screens: 'Screen', Rolluiken: 'Rolluik', Markiezen: 'Markies', Uitvalschermen: 'Uitvalscherm', 'Pergola zonwering': 'Pergola zonwering' };
    document.querySelectorAll<HTMLAnchorElement>('[data-kies]').forEach((a) => a.addEventListener('click', () => {
      const v = map[a.dataset.kies || '']; const i = f.querySelector<HTMLInputElement>(`input[name="soort"][value="${v}"]`);
      if (i) { i.checked = true; zet(); }
    }));
    zet();
  }

  // Vandaag in de tijdentabel + nu open (tijden volgens Google).
  const nu = new Date(); const dag = nu.getDay(); const u = nu.getHours() + nu.getMinutes() / 60;
  const t = tijden.find((x) => x.nr === dag);
  document.querySelector(`[data-dag="${dag}"]`)?.setAttribute('data-vandaag', '');
  const fmt = (h: number) => `${String(Math.floor(h)).padStart(2, '0')}:${h % 1 ? '30' : '00'}`;
  const open = !!t?.open && u >= t.open[0] && u < t.open[1];
  const tekst = open ? `Nu open tot ${fmt(t!.open![1])}` : t?.open && u < t.open[0] ? `Vandaag open vanaf ${fmt(t.open[0])}` : 'Nu gesloten';
  document.querySelectorAll('[data-nu]').forEach((e) => (e.textContent = tekst));
  document.querySelectorAll<HTMLElement>('[data-stip]').forEach((e) => (e.style.background = open ? '#3fb57a' : '#d9a01f'));
</script>
