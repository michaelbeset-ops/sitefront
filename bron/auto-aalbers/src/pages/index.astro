---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden } from '../data/site';
import heroFoto from '../assets/hero.jpg';
import pand from '../assets/pand.jpg';
import onderdeauto from '../assets/onderdeauto.jpg';
import diagnose from '../assets/diagnose.jpg';
import inbouw from '../assets/inbouw.jpg';
import lak from '../assets/lak.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

// Diensten: de rij uit hun kop, met de uitleg van hun pagina "Informatie".
const diensten = [
  { naam: 'APK en onderhoud', tekst: 'APK-keuringen en al uw onderhoud, met de modernste diagnoseapparatuur, voor alle automerken.' },
  { naam: 'Reparaties', tekst: 'Een universele garage voor al uw reparaties. Reparaties voeren we vakkundig en snel uit.' },
  { naam: 'Elektronische testapparatuur', tekst: 'Met onze moderne universele test- en diagnoseapparatuur sporen wij iedere moeilijke elektronische storing op, en verhelpen die.' },
  { naam: 'Aircoservice', tekst: 'Met een airco-servicebeurt vullen en recyclen wij het koudemiddel in de airco van uw auto, bestelbus of kleine vrachtwagen.' },
  { naam: 'Bandenservice', tekst: 'Wij leveren iedere gewenste band, zomer of winter, en monteren en balanceren die vakkundig. Vraag naar de opslag voor uw banden.' },
  { naam: 'Schadeherstel', tekst: 'Ook voor schadeherstel kunt u bij ons terecht.' },
  { naam: 'Vervangend vervoer', tekst: 'Wij kunnen u voorzien van vervangend vervoer tijdens de reparatie.' },
  { naam: 'Audio en navigatie', tekst: 'Wij leveren audio- en navigatieapparatuur en bouwen deze vakkundig voor u in.' },
  { naam: 'Inkoop en verkoop', tekst: 'Inkoop en verkoop van auto’s. Bij een occasion betaalt u geen afleveringskosten, tenzij anders vermeld.' },
];

// Duidelijke afspraken: letterlijk de vier zinnen van hun informatiepagina.
const afspraken = [
  'Zowel bij een kleine als grote onderhoudsbeurt wordt met u van tevoren besproken wat wij precies gaan doen en wat de geschatte kosten zullen zijn.',
  'U kunt altijd een maximumbedrag aangeven voor de reparatie.',
  'Wij zullen u van tevoren informeren als wij dit bedrag gaan overschrijden.',
  'Natuurlijk zullen wij proberen hieronder te blijven bij het uitvoeren van uw reparatie.',
];

const soorten = ['APK', 'Onderhoud', 'Airco', 'Reparatie', 'Schade'];
const dagen = [
  { id: 'maandag', kort: 'Ma' },
  { id: 'dinsdag', kort: 'Di' },
  { id: 'woensdag', kort: 'Wo' },
  { id: 'donderdag', kort: 'Do' },
  { id: 'vrijdag', kort: 'Vr' },
];
---
<Base
  title="Automobielbedrijf Aalbers | Universele garage in Ruurlo"
  description="Automobielbedrijf Aalbers aan de Spoorstraat 46 in Ruurlo: APK en onderhoud, reparaties, aircoservice, banden, schadeherstel, inbouw van audio en navigatie, inkoop en verkoop."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: warm antraciet, grote kop, bewijzen in een rij. Rechts een staande foto die over de rand valt, met ons pand als inzet. -->
    <section class="donker relative overflow-x-clip bg-roet text-white">
      <div class="pointer-events-none absolute inset-y-0 left-0 w-1.5 bg-rood" aria-hidden="true"></div>
      <div class="wrap grid grid-cols-1 gap-10 pb-12 lg:grid-cols-12 lg:gap-12 lg:pt-16 lg:pb-12">
        <div class="relative -mx-5 sm:mx-0 lg:order-2 lg:col-span-5 lg:col-start-8 lg:self-start lg:-mb-44">
          <figure>
            <div class="aspect-[16/10] overflow-hidden sm:aspect-[4/3] sm:rounded-xl lg:aspect-auto lg:h-[720px] lg:shadow-lg xl:h-[780px]">
              <Foto src={heroFoto} alt="Een monteur in werkkleding en handschoenen pakt een wiel beet van een auto die op de brug staat" hero widths={[480, 800, 1200]} sizes="(min-width: 1024px) 480px, 100vw" class="object-[80%_50%]" />
            </div>
          </figure>
          <figure class="absolute -bottom-8 left-4 z-10 w-36 overflow-hidden rounded-xl bg-white p-1.5 shadow-lg sm:left-6 sm:w-56 lg:-bottom-6 lg:-left-16 lg:w-[272px]">
            <div class="aspect-[537/403] overflow-hidden rounded-lg"><Foto src={pand} alt="Ons pand aan de Spoorstraat, met rode letters op de blauwe gevelrand, de werkplaatsdeuren en auto's op het terrein" widths={[260, 537]} sizes="(min-width: 1024px) 260px, 210px" /></div>
            <figcaption class="px-1.5 pt-1.5 pb-0.5 text-xs font-medium text-ink">{site.straat}, {site.plaats}</figcaption>
          </figure>
        </div>

        <div class="pt-10 lg:order-1 lg:col-span-7 lg:pt-4">
          <p class="kicker text-vonk">Automobielbedrijf in Ruurlo</p>
          <h1 class="mt-4 text-4xl">Een universele garage voor al uw reparaties</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">APK-keuringen en onderhoud met de modernste diagnoseapparatuur, voor alle automerken. Ook voor de inkoop en verkoop van auto’s, en de inbouw van audio en navigatie.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-rood"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href="#apk" class="btn btn-line">APK plannen <Fragment set:html={pijl} /></a>
          </div>
          <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/20 pt-6 text-sm sm:grid-cols-3">
            <div><dt class="text-white/75">Google</dt><dd><strong class="font-display text-2xl font-extrabold">{site.google}</strong> <span class="whitespace-nowrap text-white/80">({site.reviews} reviews)</span></dd></div>
            <div><dt class="text-white/75">Ma t/m vr</dt><dd class="font-display text-lg font-bold whitespace-nowrap tabular-nums">8.00 - 17.30</dd></div>
            <div><dt class="text-white/75">Zaterdag, alleen verkoop</dt><dd class="font-display text-lg font-bold whitespace-nowrap tabular-nums">9.00 - 13.00</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Diensten: kop links, raster van negen genummerde vakken rechts. -->
    <section id="diensten" class="scroll-mt-20 pt-24 pb-16 lg:pt-44 lg:pb-24">
      <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker text-rood">Diensten</p>
          <h2 class="mt-3 text-3xl">Alles voor uw auto</h2>
          <p class="mt-6 text-lg text-ink-soft">Zowel particuliere als zakelijke klanten weten de weg te vinden naar onze werkplaats.</p>
          <a href={site.telHref} class="btn btn-rood mt-8"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
        </div>
        <ol class="grid grid-cols-1 overflow-hidden rounded-xl border border-line bg-white shadow-sm sm:grid-cols-2 lg:col-span-8 xl:grid-cols-3">
          {diensten.map((d, i) => (
            <li class="group relative border-line p-6 transition-colors not-last:border-b hover:bg-papier sm:border-r sm:[&:nth-child(2n)]:border-r-0 xl:[&:nth-child(2n)]:border-r xl:[&:nth-child(3n)]:border-r-0 sm:[&:nth-last-child(-n+2)]:border-b-0 xl:[&:nth-last-child(-n+3)]:border-b-0">
              <span class="font-display text-sm font-bold tabular-nums text-rood">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-lg">{d.naam}</h3>
              <p class="mt-2 text-sm text-ink-soft">{d.tekst}</p>
            </li>
          ))}
        </ol>
      </div>

      <!-- Twee beelden, versprongen: inbouw groot, eigen werkplaatsfoto op eigen maat. -->
      <div class="wrap mt-16 grid grid-cols-1 gap-6 lg:mt-20 lg:grid-cols-12 lg:items-end">
        <figure class="lg:col-span-7">
          <div class="aspect-[2000/930] overflow-hidden rounded-xl shadow-sm"><Foto src={inbouw} alt="Een lachende monteur werkt aan de bedrading achter het dashboard van een auto met open portier" sizes="(min-width: 1024px) 700px, 100vw" /></div>
          <figcaption class="mt-3 text-sm text-ink-soft">Audio- en navigatieapparatuur, vakkundig ingebouwd.</figcaption>
        </figure>
        <figure class="max-w-[820px] lg:col-span-5 lg:mb-10">
          <div class="aspect-[820/269] overflow-hidden rounded-xl shadow-sm"><Foto src={onderdeauto} alt="Een monteur met handschoenen en looplamp werkt onder een auto op de brug" widths={[480, 820]} sizes="(min-width: 1024px) 480px, 100vw" /></div>
          <figcaption class="mt-3 text-sm text-ink-soft">Onder de auto, in onze werkplaats.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Duidelijke afspraken: hun belofte over kosten, groot en rustig. -->
    <section id="afspraken" class="scroll-mt-20 bg-zand py-16 lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-rood">Werkwijze</p>
          <h2 class="mt-3 text-3xl">Duidelijke afspraken</h2>
          <p class="mt-8 font-display text-2xl leading-tight font-bold [font-stretch:108%]">U kunt altijd een <span class="text-rood">maximumbedrag</span> aangeven voor de reparatie.</p>
          <figure class="mt-10 max-w-[820px]">
            <div class="aspect-[820/290] overflow-hidden rounded-xl shadow-sm"><Foto src={diagnose} alt="Twee monteurs lezen met een diagnosekastje de gegevens van een auto uit, bij het geopende portier" widths={[480, 820]} sizes="(min-width: 1024px) 560px, 100vw" /></div>
            <figcaption class="mt-3 text-sm text-ink-soft">Uitlezen met universele test- en diagnoseapparatuur.</figcaption>
          </figure>
        </div>
        <ol class="lg:col-span-5 lg:col-start-8 lg:self-center">
          {afspraken.map((a, i) => (
            <li class="relative grid grid-cols-[2.75rem_1fr] gap-4 pb-8 last:pb-0">
              {i < afspraken.length - 1 && <span class="absolute top-11 bottom-1 left-[1.3rem] w-px bg-ink/20" aria-hidden="true"></span>}
              <span class="grid h-11 w-11 place-items-center rounded-full bg-rood font-display font-bold text-white tabular-nums">{i + 1}</span>
              <p class="pt-2 text-lg">{a}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Wow: APK-herinnering en afspraak. Zonder JS blijft het een leesbaar formulier met bel- en mailroute. -->
    <section id="apk" class="donker scroll-mt-20 bg-roet py-16 text-white lg:py-24" data-apk>
      <div class="wrap">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="kicker text-vonk">APK-planner</p>
            <h2 class="mt-3 text-3xl">Wanneer moet uw auto weer door de APK?</h2>
          </div>
          <p class="text-white/85 lg:col-span-5 lg:self-end">Vul uw kenteken en de vervaldatum in, kies wat er moet gebeuren en welke dag u het beste uitkomt. U ziet meteen uw aanvraag, klaar om te bellen of te mailen.</p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-12">
          <form class="space-y-8 lg:col-span-6" data-form action="#" onsubmit="return false">
            <div class="veld">
              <label for="a-kenteken">Kenteken</label>
              <div class="kenteken mt-2">
                <span class="eu" aria-hidden="true">NL</span>
                <input id="a-kenteken" name="kenteken" inputmode="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="10" placeholder="AB-123-C" />
              </div>
            </div>
            <div class="veld">
              <label for="a-datum">Vervaldatum APK</label>
              <input id="a-datum" name="vervaldatum" type="date" />
              <p class="mt-2 text-sm text-white/75">Niet bij de hand? U vindt hem bij de <a href={site.rdw} rel="noopener" class="underline underline-offset-2">voertuiggegevens van de RDW</a>.</p>
            </div>
            <fieldset>
              <legend class="font-display text-sm font-bold">Wat moet er gebeuren?</legend>
              <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-5">
                {soorten.map((s, i) => (
                  <label class="keuze !px-2"><input type="radio" class="sr-only" name="dienst" value={s} checked={i === 0} />{s}</label>
                ))}
              </div>
            </fieldset>
            <fieldset>
              <legend class="font-display text-sm font-bold">Voorkeursdag</legend>
              <div class="mt-3 grid grid-cols-5 gap-2 sm:max-w-sm">
                {dagen.map((d) => (
                  <label class="keuze !px-2"><input type="radio" class="sr-only" name="dag" value={d.id} /><span aria-hidden="true">{d.kort}</span><span class="sr-only">{d.id}</span></label>
                ))}
              </div>
              <p class="mt-2 text-sm text-white/75">De garage is open van maandag t/m vrijdag. Op zaterdag alleen verkoop.</p>
            </fieldset>
            <div class="rounded-xl bg-antraciet p-5">
              <label class="flex cursor-pointer items-start gap-3">
                <input type="checkbox" name="herinnering" class="mt-1 h-5 w-5 flex-none accent-rood" data-herinnering />
                <span><strong class="font-display">Stuur mij een herinnering</strong><br /><span class="text-sm text-white/80">Een seintje voordat uw APK verloopt.</span></span>
              </label>
              <div class="veld mt-4" hidden data-mailveld>
                <label for="a-mail">Uw e-mailadres</label>
                <input id="a-mail" name="email" type="email" autocomplete="email" />
              </div>
            </div>
          </form>

          <div class="lg:col-span-6">
            <div class="sticky top-24 overflow-hidden rounded-xl bg-papier text-ink shadow-lg" data-uitkomst>
              <div class="flex items-center justify-between gap-4 border-b border-line bg-white px-6 py-4 sm:px-8">
                <p class="kicker text-rood">Uw aanvraag</p>
                <span class="kenteken !max-w-none !shadow-[inset_0_0_0_1.5px_#1d1a17]" aria-hidden="true"><span class="eu !w-6 !pb-1 !text-[.6rem]">NL</span><span class="px-2.5 py-0.5 font-display text-lg font-extrabold tracking-[.05em] [font-stretch:112%]" data-plaat>- - -</span></span>
              </div>
              <div class="p-6 sm:p-8" aria-live="polite">
                <p class="font-display text-2xl leading-tight font-bold [font-stretch:108%]" data-kop>Bel of mail ons voor een afspraak.</p>
                <p class="mt-2 text-ink-soft" data-status>Vul hiernaast uw kenteken en de vervaldatum van uw APK in.</p>
                <dl class="mt-6 border-t border-line text-sm">
                  <div class="flex justify-between gap-4 border-b border-line py-3"><dt class="text-ink-soft">Kenteken</dt><dd class="font-semibold tabular-nums" data-v="kenteken">Nog niet ingevuld</dd></div>
                  <div class="flex justify-between gap-4 border-b border-line py-3"><dt class="text-ink-soft">APK verloopt</dt><dd class="text-right font-semibold tabular-nums" data-v="datum">Nog niet ingevuld</dd></div>
                  <div class="flex justify-between gap-4 border-b border-line py-3"><dt class="text-ink-soft">Wat</dt><dd class="font-semibold" data-v="dienst">APK</dd></div>
                  <div class="flex justify-between gap-4 border-b border-line py-3"><dt class="text-ink-soft">Voorkeursdag</dt><dd class="font-semibold" data-v="dag">Geen voorkeur</dd></div>
                  <div class="flex justify-between gap-4 border-b border-line py-3"><dt class="text-ink-soft">Herinnering</dt><dd class="text-right font-semibold" data-v="herinnering">Nee</dd></div>
                </dl>
                {site.voorstel && (
                  <p class="mt-6 rounded-lg bg-zand p-4 text-sm">Dit is een ontwerpvoorstel: de planner verstuurt nog niets en onthoudt niets. Bel <a href={site.telHref} class="font-semibold whitespace-nowrap tabular-nums underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold [overflow-wrap:anywhere] underline">{site.mail}</a>.</p>
                )}
                <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                  <a href={site.telHref} class="btn btn-rood"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
                  <a href={`mailto:${site.mail}?subject=Afspraak`} class="btn btn-line text-ink" data-mailknop><Fragment set:html={mail} />Mail deze aanvraag</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      // APK-planner: rekent alleen de dagen tot de vervaldatum uit en zet de keuzes op een rij. Verstuurt niets.
      const sectie = document.querySelector<HTMLElement>('[data-apk]');
      if (sectie) {
        const form = sectie.querySelector<HTMLFormElement>('[data-form]')!;
        const q = <T extends HTMLElement>(s: string) => sectie.querySelector<T>(s)!;
        const plaat = q('[data-plaat]');
        const kop = q('[data-kop]');
        const status = q('[data-status]');
        const v = (k: string) => q(`[data-v="${k}"]`);
        const mailveld = q('[data-mailveld]');
        const mailknop = q<HTMLAnchorElement>('[data-mailknop]');
        const invoer = q<HTMLInputElement>('#a-kenteken');
        const datumVeld = q<HTMLInputElement>('#a-datum');
        const mailadres = sectie.querySelector('[data-mailknop]')!.getAttribute('href')!.split('?')[0];
        const lang = new Intl.DateTimeFormat('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

        // Kenteken: hoofdletters, streepjes tussen letter- en cijfergroepen (vier op rij wordt 2 + 2).
        const opmaak = (ruw: string) => {
          const s = ruw.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8);
          const groepen = s.match(/[A-Z]+|[0-9]+/g) || [];
          return groepen.flatMap((g) => (g.length === 4 ? [g.slice(0, 2), g.slice(2)] : [g])).join('-');
        };

        const teken = () => {
          const kenteken = invoer.value;
          const data = new FormData(form);
          const dienst = String(data.get('dienst') || 'APK');
          const dag = String(data.get('dag') || '');
          const herinnering = data.get('herinnering') === 'on';
          mailveld.hidden = !herinnering;

          plaat.textContent = kenteken || '- - -';
          v('kenteken').textContent = kenteken || 'Nog niet ingevuld';
          v('dienst').textContent = dienst;
          v('dag').textContent = dag ? dag[0].toUpperCase() + dag.slice(1) : 'Geen voorkeur';

          let dagenOver: number | null = null;
          if (datumVeld.value) {
            const [j, m, d] = datumVeld.value.split('-').map(Number);
            const verval = new Date(j, m - 1, d);
            const vandaag = new Date(); vandaag.setHours(0, 0, 0, 0);
            dagenOver = Math.round((verval.getTime() - vandaag.getTime()) / 86400000);
            v('datum').textContent = lang.format(verval);
            const seintje = new Date(verval); seintje.setDate(seintje.getDate() - 30);
            v('herinnering').textContent = herinnering
              ? (dagenOver > 30 ? `Rond ${lang.format(seintje)}` : 'Ja')
              : 'Nee';
          } else {
            v('datum').textContent = 'Nog niet ingevuld';
            v('herinnering').textContent = herinnering ? 'Ja' : 'Nee';
          }

          if (dagenOver === null) {
            kop.textContent = kenteken ? `${dienst} voor ${kenteken}` : 'Bel of mail ons voor een afspraak.';
            status.textContent = 'Vul de vervaldatum van uw APK in, dan ziet u hoeveel tijd u nog heeft.';
          } else if (dagenOver < 0) {
            kop.textContent = 'Uw APK is verlopen.';
            status.textContent = `De vervaldatum is ${-dagenOver === 1 ? '1 dag' : `${-dagenOver} dagen`} geleden. Bel ons voor een afspraak.`;
          } else if (dagenOver === 0) {
            kop.textContent = 'Uw APK verloopt vandaag.';
            status.textContent = 'Bel ons voor een afspraak.';
          } else if (dagenOver <= 30) {
            kop.textContent = `Nog ${dagenOver === 1 ? '1 dag' : `${dagenOver} dagen`}.`;
            status.textContent = 'Tijd om een afspraak te maken.';
          } else {
            kop.textContent = `Nog ${dagenOver} dagen.`;
            status.textContent = herinnering ? 'U heeft nog ruim de tijd. Wilt u toch al een afspraak, bel of mail dan gerust.' : 'U heeft nog ruim de tijd. Zet de herinnering aan, of maak alvast een afspraak.';
          }

          const regels = [
            'Graag een afspraak.',
            '',
            `Kenteken: ${kenteken || '-'}`,
            `APK verloopt: ${v('datum').textContent}`,
            `Wat: ${dienst}`,
            `Voorkeursdag: ${v('dag').textContent}`,
            `Herinnering: ${v('herinnering').textContent}`,
            ...(herinnering && (data.get('email') as string) ? [`E-mail voor de herinnering: ${data.get('email')}`] : []),
          ];
          mailknop.href = `${mailadres}?subject=${encodeURIComponent(`${dienst}${kenteken ? ` ${kenteken}` : ''}`)}&body=${encodeURIComponent(regels.join('\n'))}`;
        };

        invoer.addEventListener('input', () => {
          const pos = invoer.value.length === invoer.selectionStart;
          invoer.value = opmaak(invoer.value);
          if (pos) invoer.setSelectionRange(invoer.value.length, invoer.value.length);
        });
        form.addEventListener('input', teken);
        form.addEventListener('change', teken);
        teken();
      }
    </script>

    <!-- Occasions en inkoop: geen voorraad op hun site, dus bellen of langskomen. -->
    <section id="occasions" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center">
        <figure class="relative lg:col-span-7">
          <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm"><Foto src={lak} alt="Glanzende rode lak op de flank van een auto, met de straat en andere auto's erin weerspiegeld" sizes="(min-width: 1024px) 720px, 100vw" /></div>
          <p class="absolute bottom-4 left-4 rounded-lg bg-roet/90 px-3 py-2 text-sm font-medium text-white">Inkoop, verkoop en schadeherstel</p>
        </figure>
        <div class="lg:col-span-5">
          <p class="kicker text-rood">Occasions</p>
          <h2 class="mt-3 text-3xl">Auto kopen of verkopen</h2>
          <p class="mt-6 text-lg">Bij aanschaf van een occasion worden <strong>geen afleveringskosten</strong> bij u in rekening gebracht, tenzij anders is vermeld of aangegeven.</p>
          <p class="mt-4 text-ink-soft">Benieuwd wat er nu staat, of wilt u uw auto verkopen? Bel ons of kom langs.</p>
          <dl class="mt-8 grid grid-cols-2 gap-4">
            <div class="rounded-xl bg-white p-4 shadow-sm sm:p-5"><dt class="text-sm text-ink-soft">Ma t/m vr</dt><dd class="mt-1 font-display text-lg font-bold whitespace-nowrap tabular-nums sm:text-xl">8.00 - 17.30</dd></div>
            <div class="rounded-xl bg-white p-4 shadow-sm sm:p-5"><dt class="text-sm text-ink-soft">Zaterdag</dt><dd class="mt-1 font-display text-lg font-bold whitespace-nowrap tabular-nums sm:text-xl">9.00 - 13.00</dd></div>
          </dl>
          <a href={site.telHref} class="btn btn-rood mt-8"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
        </div>
      </div>
    </section>

    <!-- Contact: dieprood vlak. -->
    <section id="contact" class="donker scroll-mt-20 bg-kers py-16 text-white lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-white/85">Contact</p>
          <h2 class="mt-3 text-4xl">Langskomen of bellen</h2>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-wit"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <address class="mt-10 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <p class="mt-4 text-white/90">Fax <span class="whitespace-nowrap tabular-nums">{site.fax}</span><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-4">{site.mail}</a></p>
          <a href={site.maps} rel="noopener" class="mt-5 inline-block font-semibold underline decoration-2 underline-offset-4">Route plannen</a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="text-xl">Openingstijden garage en verkoop</h3>
          <dl class="mt-4 border-t border-white/25">
            {tijden.map((t) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-white/25 py-3">
                <dt>{t.dag}{t.noot && <span class="block text-sm text-white/80">{t.noot}</span>}</dt>
                <dd class="font-semibold whitespace-nowrap tabular-nums">{t.tijd}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-8 flex items-baseline gap-3 border-t border-white/25 pt-6"><strong class="font-display text-reus leading-none font-extrabold">{site.google}</strong><span class="text-white/90">op Google, uit {site.reviews} reviews</span></p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
