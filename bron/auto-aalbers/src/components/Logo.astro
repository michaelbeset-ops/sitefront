---
// Wordmark naar hun oude logo "Auto Aalbers Ruurlo" (rood) en de rode letters op de gevel:
// een rood beeldmerk met een A boven een wegstreep, "Aalbers" breed en vet, "Auto · Ruurlo" klein erboven.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <span class="sr-only">Automobielbedrijf Aalbers, Ruurlo</span>
  <svg viewBox="0 0 32 32" class="h-9 w-9 flex-none" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="#a3141f" />
    <path d="M8 25 14.2 7h3.6L24 25h-4l-1.3-4h-5.4L12 25Zm6.4-7.4h3.2L16 12.3Z" fill="#ffffff" />
    <path d="M4 27.5h24" stroke="#f6f1ea" stroke-width="1.6" stroke-dasharray="3 2.2" />
  </svg>
  <span aria-hidden="true" class="flex flex-col font-display">
    <span class={`text-[0.62rem] font-bold tracking-[0.2em] uppercase [font-stretch:125%] ${licht ? 'text-white/80' : 'text-rood'}`}>Auto · Ruurlo</span>
    <span class={`mt-[3px] text-[1.45rem] font-extrabold tracking-[-0.02em] [font-stretch:118%] ${licht ? 'text-white' : 'text-ink'}`}>Aalbers</span>
  </span>
</span>
