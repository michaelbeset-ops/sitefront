---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Maten from '../components/Maten.astro';
import { site, tijden, reviews, producten, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import heroM from '../assets/hero-m.jpg';
import leyweg from '../assets/denhaag-leyweg.jpg';
import beverwijk from '../assets/beverwijk.jpg';
import poeldijk from '../assets/poeldijk.jpg';
import poeldijkWater from '../assets/poeldijk-water.jpg';
import lounge from '../assets/schuifwand-lounge.jpg';
import glasdak from '../assets/glasdak.jpg';
import pand from '../assets/pand-gevel.jpg';

const hD = await getImage({ src: hero, widths: [1280, 1600, 2016], format: 'webp', quality: 68 });
const hM = await getImage({ src: heroM, widths: [480, 768, 1080], format: 'webp', quality: 64 });

const [groot, ...klein] = reviews;
const waBezoek = waMet('Hallo Comfort Wonen, ik wil graag langskomen aan de Ravenswade. Wanneer schikt het?');
const titel = "Comfort Wonen | Veranda's, glazen schuifwanden en kozijnen uit Nieuwegein";
const omschrijving = "Aluminium veranda's, glazen schuifwanden, tuinkamers, schuifpuien en kozijnen, altijd op maat gemaakt. Comfort Wonen, Ravenswade 108 in Nieuwegein.";
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. Opening: hun eigen veranda met glazen schuifwanden, over de volle breedte -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-antraciet text-wit">
      <picture>
        <source media="(min-width: 768px)" srcset={hD.srcSet.attribute} sizes="100vw" type="image/webp" />
        <source srcset={hM.srcSet.attribute} sizes="100vw" type="image/webp" />
        <img src={hD.src} alt="Antraciet veranda met glazen schuifwanden over de hele breedte van een tuin, met loungebank en eettafel erachter" width="2016" height="908" loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 -z-10 h-full w-full object-cover object-[40%_60%] md:object-[55%_55%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1d2226b3_0%,#1d222626_28%,#1d222640_52%,#1d2226f0_100%)] md:bg-[linear-gradient(180deg,#1d222699_0%,#1d222600_25%),linear-gradient(0deg,#1d2226f2_0%,#1d2226b3_34%,#1d222600_70%)]"></div>
      <div class="wrap pb-28 pt-32 md:pb-14">
        <p class="rijs text-[.9375rem] font-semibold text-wit/85">Veranda's en kozijnen uit Nieuwegein</p>
        <h1 class="rijs mt-4 max-w-[14ch] text-hero" style="--d:.08s">Het <span class="text-cyaan">hele jaar</span> van uw tuin genieten.</h1>
        <div class="mt-8 grid gap-8 md:grid-cols-12 md:items-end">
          <p class="rijs max-w-[34rem] text-lg text-wit/90 md:col-span-6 md:text-xl" style="--d:.16s">Aluminium veranda's, glazen schuifwanden en tuinkamers. Altijd op maat voor u gemaakt.</p>
          <div class="rijs flex flex-wrap gap-3 md:col-span-6 md:justify-end" style="--d:.24s">
            <a href="#maten" class="knop">Maten doorgeven<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-lijn num hidden sm:inline-flex"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
        <p class="maat rijs mt-12 hidden !text-wit/60 md:flex" aria-hidden="true">glazen schuifwanden over de volle breedte</p>
      </div>
    </section>

    <!-- 2. Het werk: groot en eerlijk, hun eigen foto's -->
    <section id="werk" class="pt-20 md:pt-32">
      <div class="wrap grid gap-y-6 md:grid-cols-12 md:gap-x-8">
        <h2 class="rijs text-3xl md:col-span-7">Zo staat het bij klanten in de tuin.</h2>
        <p class="rijs max-w-sm text-grijs md:col-span-4 md:col-start-9 md:self-end" style="--d:.1s">Eigen projecten, onder meer in Den Haag, Poeldijk en Beverwijk.</p>
      </div>

      <div class="wrap mt-12 grid gap-4 md:mt-16 md:grid-cols-12 md:gap-5">
        <figure class="rijs md:col-span-7">
          <Image quality={66} src={leyweg} alt="Rijtjeshuis met een antraciet veranda en glazen schuifwanden aan de voorkant en de zijkanten" widths={[640, 960, 1400]} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_28%]" />
          <figcaption class="mt-3 text-sm text-grijs">Den Haag, bij de Leyweg</figcaption>
        </figure>
        <figure class="rijs md:col-span-5 md:mt-24" style="--d:.1s">
          <Image quality={66} src={beverwijk} alt="Veranda met glazen schuifwanden en dubbele tuindeuren erachter, net opgeleverd" widths={[480, 800, 1100]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_22%]" />
          <figcaption class="mt-3 text-sm text-grijs">Beverwijk</figcaption>
        </figure>
      </div>

      <figure class="rijs mt-14 md:mt-24">
        <Image quality={64} src={poeldijkWater} alt="Rij nieuwbouwwoningen aan het water, één met een veranda met glazen dak boven het terras" widths={[640, 1024, 1440]} sizes="100vw" class="aspect-[4/3] w-full object-cover object-[50%_58%] md:aspect-[21/8]" />
        <figcaption class="wrap mt-3 text-sm text-grijs">Poeldijk, aan het water</figcaption>
      </figure>

      <div class="wrap mt-14 grid gap-4 md:mt-24 md:grid-cols-12 md:gap-5">
        <figure class="rijs md:col-span-4">
          <Image quality={66} src={poeldijk} alt="Veranda met glazen dak en glazen wanden op een terras boven het water" widths={[480, 800, 1100]} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[45%_50%]" />
          <figcaption class="mt-3 text-sm text-grijs">Poeldijk</figcaption>
        </figure>
        <figure class="rijs md:col-span-8" style="--d:.1s">
          <Image quality={70} src={lounge} alt="Loungeset en tafel onder een veranda, aan de zijkant een glazen schuifwand" widths={[640, 1024]} sizes="(min-width: 768px) 66vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-[16/11]" />
          <figcaption class="mt-3 text-sm text-grijs">Glazen schuifwand, half open</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. Assortiment: als regels op antraciet, met de onderkant van een glazen dak ernaast -->
    <section id="assortiment" class="mt-24 bg-antraciet py-20 text-wit md:mt-36 md:py-32">
      <div class="wrap grid gap-y-14 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-5">
          <h2 class="rijs text-3xl">Aluminium en glas, op maat.</h2>
          <p class="rijs mt-6 max-w-sm text-mist" style="--d:.1s">Wat wij leveren wordt altijd op maat voor u gemaakt.</p>
          <figure class="rijs mt-12 hidden md:block" style="--d:.15s">
            <Image quality={66} src={glasdak} alt="Van onderen gezien: de liggers en het glazen dak van een veranda" widths={[480, 960]} sizes="40vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
          </figure>
        </div>
        <ul class="md:col-span-6 md:col-start-7 md:pt-2">
          {producten.map((p, i) => (
            <li class="regel rijs" style={`--d:${i * 0.05}s`}>
              <span class="text-2xl font-extrabold tracking-[-0.03em]">{p}</span>
              {p === 'Glazen schuifwanden' && <span class="text-sm text-mist">met railsysteem</span>}
            </li>
          ))}
          <li class="border-t border-lijn-licht pt-8">
            <a href="#maten" class="link link-licht font-semibold">Maten doorgeven voor een offerte</a>
          </li>
        </ul>
      </div>
    </section>

    <!-- 4. Wow: maten doorgeven, de schets tekent mee, eindigt in WhatsApp -->
    <section id="maten" class="py-20 md:py-32">
      <div class="wrap">
        <div class="grid gap-y-6 md:grid-cols-12 md:gap-x-8">
          <h2 class="rijs text-3xl md:col-span-6">Geef uw maten door.</h2>
          <p class="rijs max-w-sm text-grijs md:col-span-5 md:col-start-8 md:self-end" style="--d:.1s">Een schatting is genoeg om mee te beginnen. U verstuurt het zelf, via WhatsApp naar <span class="num whitespace-nowrap">{site.tel}</span>.</p>
        </div>
        <div class="mt-12 md:mt-16"><Maten /></div>
      </div>
    </section>

    <!-- 5. Reviews: één groot citaat, twee kleine -->
    <section id="reviews" class="bg-glas-2 py-20 md:py-32">
      <div class="wrap grid gap-y-12 md:grid-cols-12 md:gap-x-10">
        <figure class="rijs md:col-span-8">
          <blockquote class="text-[clamp(1.75rem,2.6vw+.9rem,3.25rem)] font-extrabold leading-[1.08] tracking-[-0.035em]">“{groot.tekst}”</blockquote>
          <figcaption class="mt-6 text-sm font-semibold text-grijs">{groot.naam}, Google review</figcaption>
        </figure>
        <div class="space-y-10 md:col-span-4 md:pt-3">
          {klein.map((r, i) => (
            <figure class="rijs border-t border-lijn pt-6" style={`--d:${0.1 + i * 0.08}s`}>
              <blockquote class="text-lg leading-snug">“{r.tekst}”</blockquote>
              <figcaption class="mt-3 text-sm font-semibold text-grijs">{r.naam}, Google review</figcaption>
            </figure>
          ))}
          <p class="flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews</p>
        </div>
      </div>
    </section>

    <!-- 6. Bezoek: hun pand aan de Ravenswade, tijden, route -->
    <section id="bezoek" class="py-20 md:py-32">
      <div class="wrap grid gap-y-12 md:grid-cols-12 md:gap-x-10">
        <figure class="rijs md:col-span-5">
          <Image quality={70} src={pand} alt="Het pand van Comfort Wonen aan de Ravenswade, met het logo boven de deur" widths={[480, 738]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[30%_45%]" />
        </figure>
        <div class="md:col-span-6 md:col-start-7 md:pt-6">
          <h2 class="rijs text-3xl">Ravenswade 108, Nieuwegein.</h2>
          <p class="rijs mt-5 max-w-md text-grijs" style="--d:.08s">Herkenbaar aan het Comfort-logo boven de deur.</p>
          <p class="mt-9 flex items-center gap-2 text-sm font-bold" data-nu><span class="h-2 w-2 rounded-full bg-grijs" data-stip></span><span data-nu-tekst>Openingstijden</span></p>
          <table class="num mt-4 w-full max-w-md text-[.9375rem]">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {[1, 2, 3, 4, 5, 6, 0].map((d) => (
                <tr class="border-t border-lijn" data-dag={d}>
                  <th scope="row" class="py-2.5 text-left font-medium">{tijden[d][0]}</th>
                  <td class="py-2.5 text-right">{tijden[d][1] ?? 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={site.maps} class="knop knop-donker">Route plannen<Icoon naam="pijl" /></a>
            <a href={waBezoek} class="knop"><Icoon naam="wa" />Langskomen afspreken</a>
          </div>
          <p class="mt-6 text-sm text-grijs">Liever vast bellen? <a href={site.vastHref} class="link num">{site.vast}</a></p>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { tijden } from '../data/site';
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const d = nu.getDay();
  document.querySelector(`[data-dag="${d}"]`)?.classList.add('font-bold', 'text-cyaan-diep');
  const t = tijden[d][1];
  const m = nu.getHours() * 60 + nu.getMinutes();
  const minuten = (s: string) => { const [h, mm] = s.split(':').map(Number); return h * 60 + mm; };
  const open = !!t && m >= minuten(t.split('-')[0]) && m < minuten(t.split('-')[1]);
  const tekst = document.querySelector('[data-nu-tekst]');
  const stip = document.querySelector('[data-stip]');
  if (tekst) tekst.textContent = open ? `Nu open, tot ${t!.split('-')[1]}` : 'Nu gesloten';
  if (stip && open) stip.classList.replace('bg-grijs', 'bg-cyaan');
</script>
