---
import { site, url, waHoi, producten, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-antraciet text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-wit md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-mist">Aluminium veranda's, glazen schuifwanden en kozijnen, op maat gemaakt. Vanuit de Ravenswade in Nieuwegein.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Assortiment</p>
      <ul class="mt-3 space-y-1">{producten.map((p) => <li><a href={url('#assortiment')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <span class="text-xs">(mobiel)</span></p>
      <p class="mt-1"><a href={site.vastHref} class="link link-licht num">{site.vast}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a> · <a href={site.facebook} class="link link-licht">Facebook</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <p class="num mt-3">Ma t/m vr 9-17<br />Za 10-18<br />Zo gesloten</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Comfort Wonen BV, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen Facebook-pagina, Google-profiel en de oude comfortwonen.eu. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
