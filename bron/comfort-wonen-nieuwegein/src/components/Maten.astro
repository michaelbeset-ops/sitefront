---
// Wow: geef je maten door. Een plattegrondje (veranda, tuinkamer, carport) of vooraanzicht (schuifpui, kozijn)
// tekent live mee met maatlijnen, en eindigt in een vooraf ingevuld WhatsApp-bericht. Verstuurt zelf niets.
import { site } from '../data/site';
import Icoon from './Icoon.astro';
const soorten = [
  ['veranda', 'Veranda'],
  ['schuifwand', 'Veranda met glazen schuifwanden'],
  ['tuinkamer', 'Tuinkamer'],
  ['carport', 'Carport'],
  ['schuifpui', 'Aluminium schuifpui'],
  ['kozijn', 'Kozijn of deur'],
];
---
<div class="grid gap-x-12 gap-y-10 lg:grid-cols-12" data-maten data-wa={site.wa}>
  <div class="lg:col-span-7">
    <div class="relative rounded-sm bg-wit p-4 md:p-8">
      <svg viewBox="0 0 640 345" class="h-auto w-full" role="img" aria-labelledby="schets-titel" data-schets>
        <title id="schets-titel">Schets met de ingevulde maten</title>
        <defs>
          <pattern id="arcering" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="8" stroke="#161a1d" stroke-width="1" opacity=".35" /></pattern>
        </defs>
        <g data-tekening></g>
      </svg>
      <p class="mt-2 text-xs text-grijs" data-uitleg>Bovenaanzicht. Schets ter indicatie, niet op schaal.</p>
    </div>
  </div>

  <form class="lg:col-span-5" data-form novalidate>
    <fieldset>
      <legend class="text-sm font-bold">Wat wilt u laten maken?</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {soorten.map(([v, t], i) => (
          <label class="cursor-pointer">
            <input type="radio" name="soort" value={v} class="peer sr-only" checked={i === 1} data-label={t} />
            <span class="keus">{t}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="mt-8 grid gap-6">
      <label class="block">
        <span class="flex items-baseline justify-between text-sm font-bold"><span>Breedte</span><output class="num text-lg" data-uit="b">600 cm</output></span>
        <input type="range" class="schuif mt-1" name="b" min="100" max="1200" step="10" value="600" />
      </label>
      <label class="block">
        <span class="flex items-baseline justify-between text-sm font-bold"><span data-tweede-naam>Diepte</span><output class="num text-lg" data-uit="d">350 cm</output></span>
        <input type="range" class="schuif mt-1" name="d" min="100" max="600" step="10" value="350" />
      </label>
      <label class="block">
        <span class="text-sm font-bold">Waar woont u?</span>
        <input class="veld" name="plaats" autocomplete="address-level2" placeholder="Bijvoorbeeld Nieuwegein" />
      </label>
    </div>

    <a href={site.wa} class="knop mt-9 w-full" data-stuur><Icoon naam="wa" />Maten sturen via WhatsApp</a>
    <p class="mt-4 text-sm text-grijs">Stuur er in WhatsApp gerust een foto van de tuin of de gevel bij.</p>
  </form>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-maten]');
  if (root) {
    const f = root.querySelector<HTMLFormElement>('[data-form]')!;
    const g = root.querySelector<SVGGElement>('[data-tekening]')!;
    const uitleg = root.querySelector<HTMLElement>('[data-uitleg]')!;
    const tweede = root.querySelector<HTMLElement>('[data-tweede-naam]')!;
    const stuur = root.querySelector<HTMLAnchorElement>('[data-stuur]')!;
    const ub = root.querySelector<HTMLOutputElement>('[data-uit="b"]')!;
    const ud = root.querySelector<HTMLOutputElement>('[data-uit="d"]')!;
    const rb = f.elements.namedItem('b') as HTMLInputElement;
    const rd = f.elements.namedItem('d') as HTMLInputElement;
    const ns = 'http://www.w3.org/2000/svg';
    const INKT = '#161a1d', CYAAN = '#01aef2', DIEP = '#08679a', GRIJS = '#5b636a';
    const el = (n: string, a: Record<string, string | number>, t?: string) => { const e = document.createElementNS(ns, n); for (const k in a) e.setAttribute(k, String(a[k])); if (t) e.textContent = t; g.appendChild(e); return e; };
    const maatH = (x1: number, x2: number, y: number, t: string) => {
      el('line', { x1, y1: y, x2, y2: y, stroke: DIEP, 'stroke-width': 1.2 });
      el('line', { x1, y1: y - 7, x2: x1, y2: y + 7, stroke: DIEP, 'stroke-width': 1.2 });
      el('line', { x1: x2, y1: y - 7, x2, y2: y + 7, stroke: DIEP, 'stroke-width': 1.2 });
      const m = (x1 + x2) / 2, kort = x2 - x1 < 130;
      if (!kort) el('rect', { x: m - 54, y: y - 16, width: 108, height: 32, fill: '#fff' });
      el('text', { x: m, y: kort ? y + 30 : y + 7, 'text-anchor': 'middle', 'font-size': 22, 'font-weight': 700, fill: DIEP, 'font-family': 'inherit' }, t);
    };
    const maatV = (y1: number, y2: number, x: number, t: string) => {
      el('line', { x1: x, y1, x2: x, y2, stroke: DIEP, 'stroke-width': 1.2 });
      el('line', { x1: x - 7, y1, x2: x + 7, y2: y1, stroke: DIEP, 'stroke-width': 1.2 });
      el('line', { x1: x - 7, y1: y2, x2: x + 7, y2, stroke: DIEP, 'stroke-width': 1.2 });
      const m = (y1 + y2) / 2; el('rect', { x: x - 52, y: m - 16, width: 104, height: 32, fill: '#fff' });
      el('text', { x, y: m + 7, 'text-anchor': 'middle', 'font-size': 22, 'font-weight': 700, fill: DIEP, 'font-family': 'inherit' }, t);
    };
    const teken = () => {
      const soort = (f.querySelector('input[name=soort]:checked') as HTMLInputElement).value;
      const b = +rb.value, d = +rd.value;
      const voor = soort === 'schuifpui' || soort === 'kozijn';
      g.replaceChildren();
      const maxB = 470, maxD = voor ? 270 : 250;
      const s = voor ? Math.min(maxB / (soort === 'kozijn' ? 420 : 700), maxD / 320) : Math.min(maxB / 1200, maxD / 600);
      const w = Math.min(b * s, maxB), h = Math.min(d * s, maxD);
      const x0 = 70 + (maxB - w) / 2;
      if (!voor) {
        const y0 = 70;
        // gevel van het huis (of de erfgrens bij een carport)
        el('rect', { x: 40, y: y0 - 26, width: 530, height: 26, fill: 'url(#arcering)', stroke: INKT, 'stroke-width': 1.5 });
        el('text', { x: 46, y: y0 - 34, 'font-size': 17, 'font-weight': 600, fill: GRIJS }, soort === 'carport' ? 'gevel of erfgrens' : 'achtergevel');
        el('rect', { x: x0, y: y0, width: w, height: h, fill: soort === 'carport' ? '#e4e8eb' : '#01aef214', stroke: INKT, 'stroke-width': 2 });
        // dakliggers
        const n = Math.max(2, Math.round(b / 90));
        for (let i = 1; i < n; i++) el('line', { x1: x0 + (w / n) * i, y1: y0, x2: x0 + (w / n) * i, y2: y0 + h, stroke: INKT, 'stroke-width': .8, opacity: .35 });
        // goot + staanders
        el('rect', { x: x0 - 3, y: y0 + h - 6, width: w + 6, height: 9, fill: INKT });
        const st = b > 600 ? [0, .5, 1] : [0, 1];
        st.forEach((p) => el('rect', { x: x0 + p * w - 7, y: y0 + h - 8, width: 14, height: 14, fill: INKT }));
        if (soort === 'schuifwand' || soort === 'tuinkamer') {
          const zij = soort === 'tuinkamer';
          const lijn = (x1: number, y1: number, x2: number, y2: number) => { el('line', { x1, y1, x2, y2, stroke: CYAAN, 'stroke-width': 5, 'stroke-linecap': 'round' }); };
          lijn(x0 + 8, y0 + h + 10, x0 + w - 8, y0 + h + 10);
          const p = Math.max(3, Math.round(b / 95));
          for (let i = 1; i < p; i++) el('line', { x1: x0 + (w / p) * i, y1: y0 + h + 5, x2: x0 + (w / p) * i, y2: y0 + h + 15, stroke: INKT, 'stroke-width': 1.5 });
          if (zij) { lijn(x0 - 10, y0 + 6, x0 - 10, y0 + h - 4); lijn(x0 + w + 10, y0 + 6, x0 + w + 10, y0 + h - 4); }
        }
        maatH(x0, x0 + w, y0 + h + 46, `${b} cm`);
        maatV(y0, y0 + h, x0 + w + 52, `${d} cm`);
        uitleg.textContent = 'Bovenaanzicht. Schets ter indicatie, niet op schaal.';
      } else {
        const y0 = 50;
        el('rect', { x: x0, y: y0, width: w, height: h, fill: '#01aef214', stroke: INKT, 'stroke-width': 7 });
        const p = soort === 'schuifpui' ? Math.max(2, Math.round(b / 160)) : Math.max(1, Math.round(b / 110));
        for (let i = 1; i < p; i++) el('line', { x1: x0 + (w / p) * i, y1: y0, x2: x0 + (w / p) * i, y2: y0 + h, stroke: INKT, 'stroke-width': 5 });
        if (soort === 'schuifpui') for (let i = 0; i < p; i++) { const cx = x0 + (w / p) * (i + .5); el('path', { d: `M${cx - 14} ${y0 + h / 2}h28m-8 -6 8 6-8 6`, stroke: GRIJS, 'stroke-width': 1.5, fill: 'none' }); }
        el('line', { x1: 40, y1: y0 + h + 4, x2: 580, y2: y0 + h + 4, stroke: INKT, 'stroke-width': 1.5 });
        maatH(x0, x0 + w, y0 + h + 44, `${b} cm`);
        maatV(y0, y0 + h, x0 + w + 52, `${d} cm`);
        uitleg.textContent = 'Vooraanzicht. Schets ter indicatie, niet op schaal.';
      }
      tweede.textContent = voor ? 'Hoogte' : 'Diepte';
      ub.value = `${b} cm`; ud.value = `${d} cm`;
      const naam = (f.querySelector('input[name=soort]:checked') as HTMLInputElement).dataset.label!.toLowerCase();
      const plaats = (f.elements.namedItem('plaats') as HTMLInputElement).value.trim();
      const tekst = `Hallo Comfort Wonen, ik wil graag een offerte voor een ${naam}. Ongeveer ${b} cm breed en ${d} cm ${voor ? 'hoog' : 'diep'}.${plaats ? ` Ik woon in ${plaats}.` : ''} Ik stuur een foto mee.`;
      stuur.href = `${root.dataset.wa}?text=${encodeURIComponent(tekst)}`;
    };
    f.addEventListener('input', teken);
    f.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'soort') {
        const voor = t.value === 'schuifpui' || t.value === 'kozijn';
        const teHoog = +rd.value > 300;
        rd.max = voor ? '320' : '600';
        if (voor && teHoog) rd.value = t.value === 'kozijn' ? '220' : '240';
        if (t.value === 'kozijn' && +rb.value > 400) rb.value = '180';
        if (t.value === 'schuifpui' && +rb.value > 700) rb.value = '400';
        teken();
      }
    });
    f.addEventListener('submit', (e) => e.preventDefault());
    teken();
  }
</script>
