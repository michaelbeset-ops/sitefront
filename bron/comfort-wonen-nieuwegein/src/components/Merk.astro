---
// Woordmerk naar hun logo: de zeshoekige C met de E erin (cyaan), daarnaast de naam.
import { url } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['flex items-center gap-3 text-current no-underline', cls]}>
  <svg viewBox="0 0 40 44" class="h-9 w-auto flex-none" aria-hidden="true">
    <path d="M30 6.5 20 1 4 10v24l16 9 10-5.5" fill="none" stroke="#01aef2" stroke-width="5.5" stroke-linejoin="round" />
    <path d="M17 14h19l-6 4.5H17zM17 19.75h13v4.5H17zM17 25.5h13l6 4.5H17z" fill="#01aef2" />
  </svg>
  <span class="leading-none">
    <span class="block text-[1.125rem] font-extrabold tracking-[-0.02em]">Comfort Wonen</span>
    <span class="mt-1 block text-[.75rem] font-semibold opacity-75">Veranda's en kozijnen</span>
  </span>
</a>
