---
import { site, url, waMet, offerteMail } from '../data/site';
import Merk from './Merk.astro';
---
<footer id="contact" class="donker scroll-mt-16 bg-antraciet text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-y-16 pb-20 pt-28 lg:grid-cols-12 lg:gap-x-8 lg:pb-28 lg:pt-40">
    <div class="lg:col-span-6">
      <h2 id="t-contact" class="text-3xl">Een keuken of badkamer in gedachten?</h2>
      <p class="mt-8 max-w-[30rem] text-lg leading-relaxed text-licht-zacht">Stuur Johan een WhatsApp, het liefst met een paar foto's van de ruimte. Of vraag per mail een offerte aan.</p>
      <p class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={waMet('ik wil graag een offerte. Het gaat om ')} class="knop knop-licht">Stuur een WhatsApp</a>
        <a href={offerteMail} class="ui lijn">Offerte per mail</a>
      </p>
    </div>

    <div class="grid grid-cols-2 gap-x-8 gap-y-10 text-[.9375rem] lg:col-span-5 lg:col-start-8 lg:self-end">
      <div>
        <p class="ui text-licht-zacht">Bellen</p>
        <p class="mt-3 space-y-1">
          <a href={site.telHref} class="lijn num whitespace-nowrap">{site.tel}</a>
        </p>
        <p class="mt-3 text-licht-zacht">Ook via WhatsApp</p>
      </div>
      <div>
        <p class="ui text-licht-zacht">Adres</p>
        <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
        <a href={site.maps} class="lijn mt-3 inline-block text-licht-zacht">Kaart ↗</a>
      </div>
      <div class="col-span-2">
        <p class="ui text-licht-zacht">Mail</p>
        <p class="mt-3"><a href={`mailto:${site.mail}`} class="lijn [overflow-wrap:anywhere]">{site.mail}</a></p>
      </div>
      <div class="col-span-2 border-t border-lijn-licht pt-8">
        <p class="ui text-licht-zacht">Werktijden</p>
        <p class="num mt-3">Maandag tot en met vrijdag, 08.00 tot 17.00 uur</p>
      </div>
    </div>
  </div>

  <div class="wrap flex items-end gap-[3vw] overflow-hidden pb-10" aria-hidden="true">
    <Merk class="voetmerk-teken shrink-0 text-licht-zacht" />
    <p class="voetmerk woordmerk">J. HOEKSMA</p>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p class="num">{site.naam}, sinds 1996. KvK {site.kvk}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={site.linkedin} class="lijn-in">LinkedIn</a>
      <a href={site.facebook} class="lijn-in">Facebook</a>
      <a href={site.voorwaarden} class="lijn-in">Algemene voorwaarden</a>
      <a href={url('privacy/')} class="lijn-in">Privacyverklaring</a>
    </p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Alle projectfoto's zijn eigen werk van {site.naam}, overgenomen van hoeksmamontage.nl. Teksten en gegevens van die website en het Google-bedrijfsprofiel.</p>}
</footer>

<style>
  .voetmerk { font-size: clamp(2.2rem, 10.5vw, 10.5rem); font-weight: 300; letter-spacing: .2em; margin-right: -.2em; line-height: .78; }
  :global(.voetmerk-teken) { width: clamp(2rem, 8.2vw, 8.25rem); height: auto; aspect-ratio: 1; }
</style>
