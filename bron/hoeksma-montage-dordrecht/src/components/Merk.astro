---
// Beeldmerk naar hun eigen logo: vierkant met twee evenwijdige diagonalen, als een lijn op tekening.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 40 40" class={cls} fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true" vector-effect="non-scaling-stroke">
  <rect x=".75" y=".75" width="38.5" height="38.5" />
  <path d="M.75 .75 39.25 39.25M11 .75 39.25 29" />
</svg>
