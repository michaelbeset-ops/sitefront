---
// Nagemaakt naar hun logo: "TAB" vet in marineblauw, een lichtblauwe lijn die er dwars doorheen loopt,
// twee streepjes en een naar links wijzende pijlpunt; daaronder "Technisch Adviesburo Betuwe".
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const letters = licht ? '#ffffff' : '#003366';
---
<span class={`inline-flex items-center gap-3 leading-none ${cls}`}>
  <span class="sr-only">Technisch Adviesburo Betuwe</span>
  <svg viewBox="0 0 132 44" class="h-9 w-auto flex-none" aria-hidden="true">
    <text x="0" y="38" font-family="Archivo Variable, sans-serif" font-weight="800" font-size="44" letter-spacing="-2.5" fill={letters}>TAB</text>
    <rect x="0" y="19" width="104" height="3.2" fill="#0099ff" />
    <rect x="84" y="17.6" width="7" height="6" fill={letters} />
    <rect x="94" y="17.6" width="7" height="6" fill={letters} />
    <path d="M104 20.6 131 4v33.2Z" fill="#0099ff" />
  </svg>
  <span aria-hidden="true" class={`hidden border-l pl-3 font-display text-[0.8rem] font-semibold leading-[1.15] sm:block ${licht ? 'border-white/25 text-white/85' : 'border-line text-ink-soft'}`}>Technisch<br />Adviesburo Betuwe</span>
</span>
