    <script>
      // Wegwijzer: toont het paneel bij de gekozen vraag en zet de aangevinkte punten als checklist in de e-mail. Verstuurt niets zelf.
      const sectie = document.querySelector<HTMLElement>('[data-wegwijzer]');
      if (sectie) {
        const keuzes = sectie.querySelector<HTMLFieldSetElement>('[data-keuzes]')!;
        const panelen = [...sectie.querySelectorAll<HTMLElement>('[data-paneel]')];
        const uitkomst = sectie.querySelector<HTMLElement>('[data-uitkomst]')!;
        keuzes.hidden = false;
        sectie.querySelectorAll<HTMLElement>('[data-hint]').forEach((h) => (h.hidden = false));
        const toon = (id: string) => panelen.forEach((p) => (p.hidden = p.dataset.paneel !== id));
        toon((keuzes.querySelector('input:checked') as HTMLInputElement).value);
        keuzes.addEventListener('change', (e) => {
          toon((e.target as HTMLInputElement).value);
          if (innerWidth < 1024) {
            const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
            uitkomst.scrollIntoView({ behavior: rustig ? 'auto' : 'smooth', block: 'start' });
          }
        });
        panelen.forEach((p) => {
          const link = p.querySelector<HTMLAnchorElement>('[data-mail]')!;
          const basis = link.href.split('?')[0];
          const onderwerp = `Projectaanvraag: ${link.dataset.mail}`;
          const werkBij = () => {
            const mee = [...p.querySelectorAll<HTMLInputElement>('[data-mee]:checked')].map((c) => `- ${c.value}`);
            const body = mee.length ? `Ik stuur mee:\n${mee.join('\n')}\n\n` : '';
            link.href = `${basis}?subject=${encodeURIComponent(onderwerp)}${body ? `&body=${encodeURIComponent(body)}` : ''}`;
          };
          p.addEventListener('change', werkBij);
        });
      }
    </script>

