          </div>
        </div>
        <div class="lg:col-span-7">
          <ul class="columns-2 gap-6 text-sm sm:columns-3">
            {gebouwen.map((g) => <li class="break-inside-avoid border-b border-line py-1.5 [overflow-wrap:anywhere]">{g}</li>)}
          </ul>
          <details class="group mt-10 rounded-xl border border-line bg-paper">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-display font-bold [&::-webkit-details-marker]:hidden">
              <span>Alle {disciplines.length} disciplines van A tot Z</span>
              <svg viewBox="0 0 24 24" class="h-5 w-5 flex-none transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </summary>
            <ul class="columns-2 gap-6 border-t border-line px-6 py-5 text-sm sm:columns-3">
              {disciplines.map((d) => <li class="break-inside-avoid py-0.5 [overflow-wrap:anywhere]">{d}</li>)}
            </ul>
          </details>
        </div>
      </div>
    </section>

    <!-- Software: eigen rekenpakket, zonder oude acties en prijzen. -->
    <section id="software" class="scroll-mt-16 bg-mist py-20 lg:py-28">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-helder">Softwareberekeningen</p>
          <h2 class="mt-3 text-3xl">Meer dan 60 berekeningen voor de installatietechniek</h2>
          <p class="mt-5 text-ink-soft">TAB ontwikkelt ook software voor de installatietechniek: berekeningen in Microsoft Excel die u zelf kunt aanpassen.</p>
          <ul class="mt-5 flex flex-wrap gap-2 text-sm">{software.map((s) => <li class="rounded-md bg-white px-2.5 py-1 shadow-sm">{s}</li>)}</ul>
          <div class="mt-8 flex items-center gap-5">
            <Image src={cd} alt="Cd-rom met het TAB-logo en de tekst Software Berekeningen Installatietechniek, op gras" widths={[180]} sizes="112px" class="h-28 w-28 flex-none rounded-lg object-cover" />
            <p class="text-sm text-ink-soft">Informatie en bestellen via de e-mail:<br /><a href={`mailto:${site.mail}?subject=${encodeURIComponent('Softwareberekeningen TAB')}`} class="break-all font-semibold text-helder underline underline-offset-2">{site.mail}</a></p>
          </div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:col-span-7">
          <div class="rounded-xl bg-white p-6 shadow-sm sm:col-span-2">
            <h3 class="text-lg">Een greep uit de berekeningen</h3>
            <ul class="mt-3 grid gap-x-6 text-sm sm:grid-cols-2">{softwareVoorbeelden.map((s) => <li class="border-b border-line py-1.5">{s}</li>)}</ul>
          </div>
          <div class="rounded-xl bg-white p-6 shadow-sm">
            <h3 class="text-lg">Vrij voor de gebruiker</h3>
            <ul class="mt-3 space-y-1.5 text-sm">{vrij.map((s) => <li class="flex gap-2.5"><span class="mt-[0.55rem] h-[3px] w-3 flex-none bg-signaal" aria-hidden="true"></span>{s}</li>)}</ul>
          </div>
          <div class="rounded-xl bg-white p-6 shadow-sm">
            <h3 class="text-lg">CO₂-dosering glastuinbouw</h3>
            <ul class="mt-3 space-y-1.5 text-sm">{co2.map((s) => <li class="flex gap-2.5"><span class="mt-[0.55rem] h-[3px] w-3 flex-none bg-signaal" aria-hidden="true"></span>{s}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Over TAB: korte tijdlijn, eigenschappen en voorwaarden. -->
    <section id="over" class="scroll-mt-16 py-20 lg:py-28">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-helder">Over TAB</p>
          <h2 class="mt-3 text-3xl">Zelfstandig, onafhankelijk, vanuit Tiel</h2>
          <ol class="mt-8 border-l-2 border-signaal">
            <li class="relative pb-8 pl-7"><span class="absolute top-2 -left-[7px] h-3 w-3 rounded-full bg-signaal" aria-hidden="true"></span><p class="font-display text-cijfer leading-none font-bold text-marine tabular-nums">1999</p><p class="mt-2 text-ink-soft">Op 15 januari 1999 start Technisch Adviesburo Betuwe in Tiel.</p></li>
            <li class="relative pb-8 pl-7"><span class="absolute top-2 -left-[7px] h-3 w-3 rounded-full bg-signaal" aria-hidden="true"></span><p class="font-display text-cijfer leading-none font-bold text-marine tabular-nums">2002</p><p class="mt-2 text-ink-soft">Alle medewerkers VCA** gecertificeerd.</p></li>
            <li class="relative pl-7"><span class="absolute top-2 -left-[7px] h-3 w-3 rounded-full bg-signaal" aria-hidden="true"></span><p class="font-display text-cijfer leading-none font-bold text-marine">Nu</p><p class="mt-2 text-ink-soft">Hoofdzakelijk actief op de Nederlandse, Duitse en Belgische markt.</p></li>
          </ol>
        </div>
        <div class="grid gap-6 lg:col-span-7">
          <div class="rounded-xl bg-white p-6 shadow-sm lg:p-8">
            <h3 class="text-xl">Bijzondere eigenschappen van TAB</h3>
            <ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2">
              {eigenschappen.map((e) => <li class="flex gap-3 text-sm"><svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 flex-none text-helder" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m4 10.5 4 4 8-9" /></svg><span>{e}</span></li>)}
            </ul>
          </div>
          <div class="rounded-xl border border-line p-6 lg:p-8">
            <h3 class="text-xl">Voorwaarden</h3>
            <dl class="mt-4 divide-y divide-line text-sm">
              {voorwaarden.map((v) => <div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-4"><dt class="font-semibold">{v.k}</dt><dd class="text-ink-soft">{v.v}</dd></div>)}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="donker raster scroll-mt-16 bg-nacht py-20 text-white lg:py-28">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="kicker text-ijs">Contact</p>
          <h2 class="mt-3 text-3xl">Vragen of een project? Neem vrijblijvend contact op.</h2>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-ijs"><Fragment set:html={tel} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            <a href={site.whatsapp} class="btn btn-line text-white"><Fragment set:html={wa} />WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="btn btn-line text-white"><Fragment set:html={mail} />Mail</a>
          </div>
          <dl class="mt-10 grid gap-6 sm:grid-cols-2">
            <div><dt class="text-sm text-white/70">Adres</dt><dd class="mt-1 text-lg">{site.straat}<br />{site.postcode} {site.plaats}<br /><a href={site.maps} class="mt-1 inline-block text-base font-semibold text-ijs underline underline-offset-4">Route plannen</a></dd></div>
            <div><dt class="text-sm text-white/70">Telefoon</dt><dd class="mt-1 text-lg"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-4">{site.tel}</a><br />GSM <a href={site.gsmHref} class="whitespace-nowrap tabular-nums underline underline-offset-4">{site.gsm}</a><br /><span class="text-base text-white/80">Fax <span class="whitespace-nowrap tabular-nums">{site.fax}</span></span></dd></div>
            <div class="sm:col-span-2"><dt class="text-sm text-white/70">E-mail</dt><dd class="mt-1 text-lg"><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-4">{site.mail}</a></dd></div>
          </dl>
        </div>
        <div class="lg:col-span-5">
          <div class="rounded-xl bg-white p-6 text-ink shadow-lg lg:p-8">
            <h3 class="text-xl">Telefonisch bereikbaar</h3>
            <dl class="mt-4 divide-y divide-line">
              <div class="flex justify-between gap-4 py-3"><dt>Maandag t/m zaterdag</dt><dd class="font-semibold whitespace-nowrap tabular-nums">9.00 - 18.00</dd></div>
              <div class="flex justify-between gap-4 py-3"><dt>Zondag en feestdagen</dt><dd class="font-semibold">Niet bereikbaar</dd></div>
            </dl>
            <p class="mt-5 rounded-lg bg-mist p-4 text-sm">Geheel vrijblijvende prijsopgave per project binnen 24 uur.</p>
            <p class="mt-4 text-sm text-ink-soft">KvK {site.kvk} &middot; Btw {site.btw}</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
