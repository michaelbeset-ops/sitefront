---
import { site, url } from '../data/site';
---
<footer class="op-donker bg-groen text-gips">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <span class="lijst text-roze" aria-hidden="true"></span>
      <p class="mt-5 font-kop text-3xl font-extrabold">Stukadoorsbedrijf P. van der Velden</p>
      <p class="mt-4 max-w-sm text-sm text-gips/80">Stucwerk, sierlijsten, restauratie en schilderwerk vanuit {site.plaats}. Sinds 2004.</p>
    </div>
    <div class="text-sm md:col-span-4">
      <p class="font-semibold">Contact</p>
      <p class="mt-3 text-gips/80">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.mobielHref} class="underline-offset-4 hover:underline">{site.mobiel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline-offset-4 hover:underline">{site.mail}</a></p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="font-semibold">Open</p>
      <p class="mt-3 text-gips/80">Ma t/m vr 8.30 tot 17.00 uur<br />Za en zo gesloten</p>
      <p class="mt-3"><a href={url('privacy/')} class="underline underline-offset-4">Privacyverklaring</a></p>
    </div>
  </div>
  <div class="wrap border-t border-gips/15 py-5 text-xs text-gips/75">
    <p>De foto's op deze site zijn sfeerbeelden van Unsplash.</p>
  </div>
</footer>
