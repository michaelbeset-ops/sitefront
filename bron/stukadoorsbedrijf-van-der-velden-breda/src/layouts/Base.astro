---
import '../styles/global.css';
import kopFont from '@fontsource-variable/alegreya/files/alegreya-latin-wght-normal.woff2?url';
import tekstFont from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import { site, url } from '../data/site';

interface Props { title: string; description: string; heroFoto?: string; heroSrcset?: string }
const { title, description, heroFoto, heroSrcset } = Astro.props;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1c2b25" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    {heroFoto && <link rel="preload" as="image" href={heroFoto} imagesrcset={heroSrcset} imagesizes="100vw" fetchpriority="high" />}
    <link rel="preload" as="font" type="font/woff2" href={kopFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={tekstFont} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-[4.5rem] md:pb-0">
    {site.voorstel && (
      <div class="op-donker bg-inkt text-gips">
        <p class="wrap py-2 text-xs leading-snug">Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website. <a href="https://www.sitefront.nl" class="font-semibold text-roze underline underline-offset-2">sitefront.nl</a></p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-gips focus:px-4 focus:py-2">Naar de inhoud</a>
    <slot />
    <!-- Op mobiel blijven bellen en mailen altijd binnen bereik van de duim. -->
    <nav aria-label="Snel contact" class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1.4fr_1fr] gap-2 border-t border-lijn bg-papier p-2.5 md:hidden">
      <a href={site.mobielHref} class="knop knop-steen whitespace-nowrap px-3">Bel Pascal</a>
      <a href={`mailto:${site.mail}`} class="knop knop-lijn whitespace-nowrap px-3 text-groen">Mail</a>
    </nav>
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.rij').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
