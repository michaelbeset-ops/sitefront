---
// Strak woordmerk (ze hebben geen logo): "Rijwielbedrijf" klein, "A. Schouw" vet en schuin, met een spaakwiel als beeldmerk.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <svg viewBox="0 0 48 48" class="h-10 w-10 flex-none sm:h-11 sm:w-11" aria-hidden="true">
    <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="3.2" />
    <circle cx="24" cy="24" r="16.5" fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="1" />
    <g stroke="currentColor" stroke-width="1.3" stroke-opacity=".8">
      <path d="M24 7.5v33M7.5 24h33M12.3 12.3l23.4 23.4M35.7 12.3 12.3 35.7" />
    </g>
    <circle cx="24" cy="24" r="4.6" fill="#c43d14" />
  </svg>
  <span class="flex flex-col">
    <span class="kop text-[.78rem] font-semibold not-italic tracking-[.2em] opacity-80">Rijwielbedrijf</span>
    <span class="kop mt-1 text-[1.72rem] font-[900] leading-[.85] sm:text-[1.9rem]">A. Schouw</span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>
