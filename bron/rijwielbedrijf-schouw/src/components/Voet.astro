---
import { site, url, waHoi, tijden, uur } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const werk = [['werkplaats', 'Reparatie'], ['werkplaats', 'Onderhoud en servicebeurt'], ['werkplaats', 'Advies bij een nieuwe fiets'], ['ridley', 'Ridley: race, gravel en mtb'], ['werkbon', 'Afspraak via WhatsApp']];
const open = [1, 3, 4].map((i) => tijden[i]);
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.95rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Fietsenwinkel en werkplaats aan de Spoorlaan in {site.plaats}. Officieel Ridley-dealer.</p>
      <a href={waHoi} class="knop knop-merk mt-7 min-h-11 px-5"><Icoon naam="wa" />WhatsApp</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-wit">Werkplaats en winkel</p>
      <ul class="mt-5 space-y-2">
        {werk.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <ul class="mt-5 space-y-2">
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a> <span class="text-mist/80">(ook WhatsApp)</span></li>
        <li><a href={site.vastHref} class="num no-underline hover:text-merk-licht">{site.vast}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-merk-licht">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.route} class="no-underline hover:text-merk-licht">Route plannen</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-wit">Open</p>
      <ul class="mt-5 space-y-2">
        {open.map((t) => <li class="flex justify-between gap-4"><span>{t.dag.slice(0, 2)}</span><span class="num text-wit">{uur(t.open!)} - {uur(t.dicht!)}</span></li>)}
      </ul>
      <p class="mt-4 text-[.88rem]">Overige dagen gesloten.</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam} V.O.F., {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  <p class="wrap pb-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google, tijden volgens Google, dealerschap volgens ridley-bikes.com (stand 11 oktober 2026).</p>
  <div class="h-14 md:hidden" aria-hidden="true"></div>
</footer>
