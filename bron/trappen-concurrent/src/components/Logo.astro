---
// Naar hun eigen logo: rode C in een zwart kader met wit vlak, en ernaast "DE TRAPPEN / CONCURRENT" in blokletters.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <span class="sr-only">De Trappen Concurrent</span>
  <svg viewBox="0 0 40 40" class="h-10 w-10 flex-none" aria-hidden="true">
    <rect x="0" y="0" width="40" height="40" rx="7" fill={licht ? '#ffffff' : '#171211'} />
    <rect x="5" y="5" width="30" height="30" rx="2.5" fill={licht ? '#171211' : '#ffffff'} />
    <path d="M30 10.5H16.2a5.7 5.7 0 0 0-5.7 5.7v7.6a5.7 5.7 0 0 0 5.7 5.7H30v-6.2H17.4v-6.6H30Z" fill="#e1141c" />
  </svg>
  <span aria-hidden="true" class={`flex flex-col font-display text-[1.32rem] font-extrabold tracking-[0.02em] uppercase leading-[0.86] ${licht ? 'text-white' : 'text-ink'}`}>
    <span>De Trappen</span><span>Concurrent</span>
  </span>
</span>
