---
import { site, url, waMet } from '../data/site';
import Merk from './Merk.astro';
interface Props { contact?: boolean }
const { contact = true } = Astro.props;
const doelen = ['afvallen', 'sterker worden', 'een betere conditie', 'hardlopen', 'medische fitness', 'iets anders'];
const basis = 'ik wil graag een gratis intakegesprek plannen.';
---
<footer id="contact" class="donker scroll-mt-20 bg-wijn text-licht" aria-labelledby={contact ? 't-contact' : undefined}>
  {contact && (
    <div class="wrap grid gap-y-16 pb-20 pt-28 lg:grid-cols-12 lg:gap-x-8 lg:pb-28 lg:pt-40">
      <div class="lg:col-span-7">
        <h2 id="t-contact" class="text-3xl">Begin met een gratis intake.</h2>
        <p class="mt-8 max-w-[32rem] text-lg leading-relaxed text-licht-zacht">Een geheel vrijblijvend gesprek over jouw doel. Kies hieronder waar je aan wilt werken.</p>

        <form class="doel mt-12" data-doel novalidate>
          <label for="doel" class="zin text-xl">
            <span>Ik wil werken aan</span>
            <span class="kies">
              <select id="doel" name="doel" data-doel-keuze>
                {doelen.map((d) => <option value={d}>{d}</option>)}
              </select>
              <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </span>
          </label>
          <p class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
            <a href={waMet(`${basis} Ik wil werken aan afvallen.`)} class="knop knop-licht" data-doel-wa>Stuur via WhatsApp</a>
            <a href={site.telHref} class="ui num lijn whitespace-nowrap">Bel {site.tel}</a>
          </p>
          <p class="mt-6 text-sm text-licht-zacht" aria-live="polite" data-doel-voorbeeld>Je bericht: "Hallo, {basis} Ik wil werken aan afvallen."</p>
        </form>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-10 text-[.9375rem] lg:col-span-4 lg:col-start-9 lg:self-end">
        <div class="col-span-2">
          <p class="ui text-licht-zacht">Studio</p>
          <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <a href={site.maps} class="lijn mt-3 inline-block text-licht-zacht">Route in Google Maps ↗</a>
        </div>
        <div>
          <p class="ui text-licht-zacht">Bellen en WhatsApp</p>
          <p class="mt-3"><a href={site.telHref} class="lijn num whitespace-nowrap">{site.tel}</a></p>
        </div>
        <div class="col-span-2">
          <p class="ui text-licht-zacht">Liever bellen?</p>
          <p class="mt-3"><a href={`tel:${site.tel.replace(/\s/g, '')}`} class="lijn num">{site.tel}</a></p>
        </div>
      </div>
    </div>
  )}

  <div class="wrap flex items-end justify-between gap-6 overflow-hidden pb-10 pt-4" aria-hidden="true">
    <p class="voetmerk">Personal Trainingen</p>
    <Merk class="voetmerk-teken shrink-0 text-licht" />
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p class="num">{site.naam} B.V., {site.plaats}. KvK {site.kvk}. {site.google} op Google, uit {site.googleAantal} reviews.</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={url('privacy/')} class="lijn-in">Privacyverklaring</a>
    </p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Foto's van uw Google-bedrijfsprofiel, ter illustratie. Teksten en gegevens van uw eigen website (via het webarchief) en dat profiel.</p>}
</footer>

<style>
  .voetmerk { font-size: clamp(2.1rem, 9.4vw, 9.5rem); font-weight: 400; letter-spacing: -.045em; line-height: .8; white-space: nowrap; color: var(--color-licht); }
  :global(.voetmerk-teken) { height: clamp(2.1rem, 8vw, 8rem); width: auto; }

  .zin { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem .6rem; letter-spacing: -.02em; }
  .kies { position: relative; display: inline-flex; align-items: baseline; }
  .kies select { appearance: none; -webkit-appearance: none; background: transparent; color: var(--color-licht); font: inherit; letter-spacing: inherit; border: 0; border-bottom: 1px solid var(--color-licht); border-radius: 0; padding: 0 1.6rem .15rem 0; cursor: pointer; max-width: 100%; transition: border-color .3s var(--ease-zacht); }
  .kies select:hover { border-bottom-color: var(--color-licht-zacht); }
  .kies select:focus-visible { outline: 2px solid var(--color-licht); outline-offset: 4px; }
  .kies option { color: var(--color-inkt); background: var(--color-papier); }
  .kies svg { position: absolute; right: .1rem; bottom: .6em; width: .7rem; height: auto; pointer-events: none; }
</style>

<script>
  // Kies een doel: het WhatsApp-bericht verandert mee, zodat de intake meteen over het goede gaat.
  const form = document.querySelector<HTMLFormElement>('[data-doel]');
  if (form) {
    const keuze = form.querySelector<HTMLSelectElement>('[data-doel-keuze]')!;
    const wa = form.querySelector<HTMLAnchorElement>('[data-doel-wa]')!;
    const voorbeeld = form.querySelector<HTMLElement>('[data-doel-voorbeeld]')!;
    const basis = wa.href.split('?')[0];
    const zet = () => {
      const doel = keuze.value;
      const tekst = 'Hallo, ik wil graag een gratis intakegesprek plannen.' + (doel === 'iets anders' ? ' Het gaat om: ' : ` Ik wil werken aan ${doel}.`);
      wa.href = `${basis}?text=${encodeURIComponent(tekst)}`;
      voorbeeld.textContent = `Je bericht: "${tekst.trim()}"`;
    };
    keuze.addEventListener('change', zet);
    form.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
