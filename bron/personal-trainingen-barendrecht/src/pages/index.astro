  .veld { display: block; width: 100%; border-radius: 4px; border: 1.5px solid #15131433; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #15131466; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-rood); }
  .veld::placeholder { color: #857d7f; }
