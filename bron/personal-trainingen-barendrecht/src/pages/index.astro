---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, waMet } from '../data/site';
import studio from '../assets/studio.jpg';
import pand from '../assets/pand.jpg';
import antoon from '../assets/antoon.jpg';

const aanbod = [
  ['Personal training', 'Eén op één of in een small group van maximaal drie, met je eigen vaste coach en een voeding- en trainschema op jouw doel afgestemd.'],
  ['Medische fitness', 'In de speciaal ingerichte medische en obesitas studio. Ook voor astma- en COPD-patiënten en senioren.'],
  ['Hardlopen', 'Eén op één of in een groep van maximaal zes. Van beginners tot trail running, met advies over voeding, loopkleding en blessurepreventie.'],
  ['Size Less', 'Afvallen zonder streng dieet, pillen of poeders. De nadruk ligt op training; de voeding staat daarvoor in dienst.'],
];
const ook = ['krachttraining', 'spieropbouw', 'conditietraining', 'bodyshaping', 'wedding-fit', 'afslankbegeleiding', 'voedingsadvies', 'MyLine'];

const stappen = [
  ['Intakegesprek', 'Geheel vrijblijvend en gratis.'],
  ['Conditietest', ''],
  ['Body-analyse', ''],
  ['Plan van aanpak', ''],
  ['Voeding- en trainschema', 'Afgestemd op je conditie, lichaamsbouw, leeftijd, gezondheid en doel.'],
  ['Evaluatie', 'Om de twee weken een evaluatiegesprek.'],
];

const opleidingen = [
  ['Opleidingen', 'Fit!Vak A en B, LAPT, CIOS, NASM, Les Mills, MyLine'],
  ['Specialisaties', 'Paramedische fitness, mental coaching, gedrag en motivatie'],
  ['Erkenning', 'Erkend leerbedrijf SBB, niveau 4. Bij het RIVM geregistreerd als erkend GLI-trainingsbedrijf.'],
];
---
<Base title="Personal Trainingen Barendrecht | Personal training één op één, Zwolseweg 26" description="Personal training één op één of in een small group, medische fitness, hardlopen en Size Less. In de privéstudio aan de Zwolseweg 26 in Barendrecht. Gratis intakegesprek.">
  <Kop overBeeld />
  <main id="inhoud">

    <!-- 1. Eerste scherm: het wijnrood van hun gevel over de volle breedte en hoogte, hun eigen studio als staand beeld ernaast. -->
    <section class="hero donker relative isolate overflow-hidden bg-wijn text-licht" aria-labelledby="titel" data-beeld>
      <div class="hero-vlak absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-tekst">
          <h1 id="titel" class="text-4xl">Personal training, één op één.</h1>
          <p class="mt-6 max-w-[31rem] leading-relaxed text-licht-zacht md:mt-8 md:text-lg">Met je eigen vaste coach, in de privéstudio aan de Zwolseweg in Barendrecht. Alleen, of in een small group van maximaal drie.</p>
          <p class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5 md:mt-11">
            <a href={waMet('ik wil graag een gratis intakegesprek plannen.')} class="knop knop-licht">Plan een gratis intake</a>
            <a href="#werkwijze" class="ui lijn whitespace-nowrap">Zo werkt het</a>
          </p>
        </div>
        <figure class="hero-beeld">
          <div class="hero-foto overflow-hidden bg-wijn-diep">
            <Image src={studio} alt="De studio: een rek met dumbbells voor de spiegelwand, rechts een kabelstation." widths={[400, 685]} sizes="(min-width: 1024px) 40vw, 100vw" format="webp" quality={76} loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[30%_50%]" />
          </div>
          <figcaption class="ui mt-4 hidden justify-between text-licht-zacht lg:flex"><span>De studio</span><span class="num">Zwolseweg 26</span></figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. Aanbod: waarom mensen stoppen, en wat ze hier kunnen doen, als rustige lijst. -->
    <section id="aanbod" class="wrap scroll-mt-20 py-28 lg:py-40" aria-labelledby="t-aanbod">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-5">
          <h2 id="t-aanbod" class="text-3xl">Veel mensen beginnen eraan, en stoppen dan weer.</h2>
          <p class="mt-8 max-w-[28rem] text-lg leading-relaxed text-grijs">Omdat ze niet weten hoe de oefeningen moeten, geen resultaat zien of een blessure krijgen door verkeerd trainen. Daar is personal training voor.</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <ul class="border-t border-lijn">
            {aanbod.map(([t, d]) => (
              <li class="grid gap-y-2 border-b border-lijn py-8 md:grid-cols-[12rem_1fr] md:gap-x-8">
                <h3 class="text-xl">{t}</h3>
                <p class="text-grijs">{d}</p>
              </li>
            ))}
          </ul>
          <p class="mt-8 text-sm leading-relaxed text-grijs">Ook voor {ook.slice(0, -1).join(', ')} en {ook.at(-1)}.</p>
        </div>
      </div>
    </section>

    <!-- 3. Werkwijze: hun eigen stappenplan, groot gezet. -->
    <section id="werkwijze" class="scroll-mt-20 border-t border-lijn bg-wit py-28 lg:py-40" aria-labelledby="t-werk">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-4">
          <h2 id="t-werk" class="text-3xl">Het stappenplan.</h2>
          <p class="mt-8 max-w-[24rem] text-grijs">Zo werk je naar je doel toe. Je schema's, voeding en voortgang staan ook in je eigen app.</p>
        </div>
        <ol class="stappen lg:col-span-7 lg:col-start-6">
          {stappen.map(([t, d], i) => (
            <li class="stap">
              <span class="num stap-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="stap-kop">{t}</h3>
                {d && <p class="mt-2 text-grijs">{d}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4. De studio: hun eigen pand met het logo op de gevel, met adres en tijden. -->
    <section id="studio" class="scroll-mt-20 pb-28 pt-28 lg:pb-40 lg:pt-40" aria-labelledby="t-studio">
      <div class="wrap">
        <figure class="pand overflow-hidden bg-steen">
          <Image src={pand} alt="Het pand aan de Zwolseweg 26: rood omlijste gevel met grote ramen en het bord Personal Trainingen Barendrecht." widths={[640, 960, 1290]} sizes="(min-width: 1440px) 1290px, 100vw" format="webp" quality={72} class="h-full w-full object-cover object-[40%_55%]" />
        </figure>
        <div class="mt-14 grid gap-y-12 lg:mt-20 lg:grid-cols-12 lg:gap-x-8">
          <div class="lg:col-span-5">
            <h2 id="t-studio" class="text-3xl">Zwolseweg 26, Barendrecht.</h2>
            <p class="mt-8 max-w-[28rem] text-lg leading-relaxed text-grijs">De privéstudio is speciaal ingericht voor personal training, medische fitness en obesitas.</p>
            <p class="mt-8"><a href={site.maps} class="ui lijn">Route in Google Maps ↗</a></p>
          </div>
          <div class="self-end lg:col-span-6 lg:col-start-7">
          <dl class="border-t border-lijn">
            {site.tijden.map(([d, t]) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-lijn py-5">
                <dt>{d}</dt>
                <dd class="num whitespace-nowrap text-grijs">{t}</dd>
              </div>
            ))}
          </dl>
          <p class="pt-5 text-sm text-grijs">Andere tijd nodig? Bel of app even.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Antoon: portret, achtergrond en opleidingen; daarna wat klanten in hun reviews schrijven. -->
    <section id="antoon" class="scroll-mt-20 border-t border-lijn bg-wit py-28 lg:py-40" aria-labelledby="t-antoon">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
        <figure class="lg:col-span-4">
          <div class="portret overflow-hidden bg-steen">
            <Image src={antoon} alt="Zwart-witportret van Antoon in een wit poloshirt." widths={[360, 500]} sizes="(min-width: 1024px) 26vw, 80vw" format="webp" quality={78} class="h-full w-full object-cover object-top" />
          </div>
        </figure>
        <div class="lg:col-span-7 lg:col-start-6">
          <h2 id="t-antoon" class="text-3xl">Antoon, oprichter en personal trainer.</h2>
          <p class="mt-8 max-w-[34rem] text-lg leading-relaxed text-grijs">Vanaf zijn 25e actief in fitness en krachttraining, op wedstrijdniveau. Daarna voeding, trainingsschema's en duursport: marathons, triatlons, racefietsen en mountainbiken.</p>
          <dl class="mt-12 border-t border-lijn">
            {opleidingen.map(([k, v]) => (
              <div class="grid gap-y-1 border-b border-lijn py-5 md:grid-cols-[10rem_1fr] md:gap-x-6">
                <dt class="ui pt-1 text-grijs">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-12 max-w-[34rem] leading-relaxed text-grijs">
            <span class="text-inkt">Op Google, {site.google} uit {site.googleAantal} reviews.</span> Klanten schrijven over begeleiding die wordt afgestemd op hun wensen, over persoonlijke aandacht tijdens en buiten de sessies, en over weer fit en sterk worden na een hernia.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .hero { min-height: calc(100svh - var(--balk, 0px)); display: flex; }
  .hero-vlak { background:
    radial-gradient(120% 90% at 85% 10%, #6a1016 0%, transparent 60%),
    radial-gradient(90% 70% at 0% 100%, #3a070a 0%, transparent 70%); }
  .hero-grid { display: flex; flex-direction: column; justify-content: flex-end; gap: 2.5rem; padding-top: 6rem; padding-bottom: 2.5rem; width: 100%; }
  .hero-beeld { order: -1; flex: 1 1 auto; display: flex; flex-direction: column; min-height: 11rem; }
  .hero-foto { flex: 1 1 auto; position: relative; }
  .hero-foto :global(img) { position: absolute; inset: 0; }
  @media (min-width: 1024px) {
    .hero-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; align-items: end; padding-top: 8.5rem; padding-bottom: 4.5rem; }
    .hero-tekst { grid-column: 1 / span 7; padding-bottom: .25rem; }
    .hero-beeld { order: 0; grid-column: 8 / span 5; align-self: stretch; }
  }

  .stappen { border-top: 1px solid var(--color-lijn); counter-reset: s; }
  .stap { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1.75rem 0; border-bottom: 1px solid var(--color-lijn); }
  @media (min-width: 768px) { .stap { grid-template-columns: 6rem 1fr; gap: 2rem; } }
  .stap-nr { color: var(--color-rood); font-size: var(--text-xl); line-height: 1.2; letter-spacing: -.02em; }
  .stap-kop { font-size: var(--text-2xl); line-height: 1.1; }

  .pand { aspect-ratio: 4 / 3; }
  @media (min-width: 768px) { .pand { aspect-ratio: 1290 / 720; } }
  .portret { aspect-ratio: 500 / 560; max-width: 500px; }
</style>
