---
// Woordmerk naar hun logo: PEET'S in wit, V2 in het rood van de adelaar, SERVICE. Met de V van twee cilinders.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`flex items-center gap-2.5 no-underline ${donker ? 'text-inkt' : 'text-wit'}`} aria-label="Peet's V2 Service, naar de homepage">
  <span class="kop whitespace-nowrap text-[1.45rem] leading-none tracking-[.01em] sm:text-[1.65rem]">Peet's <span class={donker ? 'text-rood' : 'text-rood-licht'}>V2</span> Service</span>
</a>
