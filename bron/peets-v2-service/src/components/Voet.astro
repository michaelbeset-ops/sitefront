---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-zwart text-chroom">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk />
      <p class="mt-6 max-w-xs">Service, onderhoud en reparatie van V&#8209;twin motoren in Kwintsheul. Sinds {site.sinds}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Op de site</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={url('#werkplaats')} class="link link-licht">De werkplaats</a></li>
        <li><a href={url('#werkbon')} class="link link-licht">Werkbon appen</a></li>
        <li><a href={site.reviews} class="link link-licht">Reviews op Google</a></li>
        <li><a href={site.facebook} class="link link-licht">Facebook</a></li>
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode}</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <a href={waHoi} class="link link-licht">(ook WhatsApp)</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Foto's van jullie Facebook en van klanten op het Google-profiel (in jullie werkplaats), kentekens onherkenbaar gemaakt. Reviews letterlijk van Google (stand 10 oktober 2026).</p>}
</footer>
