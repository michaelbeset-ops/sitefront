---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, onderwerpen, dagen, tijd, uur, waHoi, waMet } from '../data/site';

// Eigen foto's (Google-profiel en hun Canva-site) en drie sfeerfoto's (Unsplash), zie src/assets/BRONNEN.txt.
import hal from '../assets/hal.jpg';
import werkplaats from '../assets/werkplaats.jpg';
import omafiets from '../assets/omafiets.jpg';
import vouwfiets from '../assets/vouwfiets.jpg';
import voltage from '../assets/voltage.jpg';
import buitenbanden from '../assets/buitenbanden.jpg';
import ringslot from '../assets/ringslot.jpg';
import sRace from '../assets/s-racefiets.jpg';
import sMtb from '../assets/s-mtb.jpg';
import sStad from '../assets/s-stad.jpg';

const vraag = (wat: string) => waMet(`Hallo Tilburg Mobile Bikes, hebben jullie nu ${wat} staan?`);

// De vier soorten uit hun pagina "Onze occasions".
const soorten = [
  { l: 'A', t: 'Stadsfietsen', d: 'Dames, heren en omafietsen. Onder €100, onder €200 en boven €200.', src: omafiets, pos: '50% 60%', wa: 'een stadsfiets', alt: 'Omafiets in de winkel van Tilburg Mobile Bikes', eigen: true },
  { l: 'B', t: 'Vouwfietsen', d: 'Opvouwbare fietsen die je zo inklapt en meeneemt.', src: vouwfiets, pos: '50% 62%', wa: 'een vouwfiets', alt: 'Zwarte vouwfiets in de winkel van Tilburg Mobile Bikes', eigen: true },
  { l: 'C', t: 'Mountainbikes', d: 'Voor het bos en het onverharde pad.', src: sMtb, pos: '60% 40%', wa: 'een mountainbike', alt: 'Mountainbiker in een bos (sfeerfoto)', eigen: false },
  { l: 'D', t: 'Racefietsen', d: 'Rijwielen en racefietsen voor de weg.', src: sRace, pos: '50% 50%', wa: 'een racefiets', alt: 'Racefiets tegen een houten wand (sfeerfoto)', eigen: false },
];

const zeker = [
  { t: 'Gecontroleerd', d: 'Elke fiets is gecontroleerd en waar nodig gereviseerd.' },
  { t: 'Samen nakijken', d: 'Bij aankoop controleer je de fiets samen met ons.' },
  { t: 'Rijklaar mee', d: 'Klanten noemen een fiets "met verlichting en een slot".' },
];

const reparaties = ['Kleine beurt', 'Grote beurt', 'Banden vervangen', 'Wiel richten', 'Versnellingen', 'Remmen', 'Pedalen', 'Verlichting', 'Standaard', 'Schoonmaken'];
const onderdelen = ['Banden', 'Zadels', 'Verlichting', 'Fietsbellen', 'Kettingsloten', 'Versnellingskabels', 'Remkabels', 'Bandenplaksets', 'Noodkoffers'];

const stappen = [
  ['Stuur een WhatsApp', 'Zeg wat je zoekt of wat er mis is. Je krijgt snel en persoonlijk antwoord.'],
  ['Plan een tijd', 'Elke dag tussen 08:00 en 21:00, ook in het weekend.'],
  ['Kom kijken', 'Naar de Groenstraat, of je laat je ophalen met het taxibusje.'],
  ['Samen controleren', 'Je kijkt de fiets samen met ons na en maakt een proefrit.'],
];

const vragen = [
  { v: 'Kan ik zonder afspraak langskomen?', a: 'Liever niet. We werken alleen op afspraak, omdat we niet altijd in de garage zijn. Stuur even een WhatsApp, dan spreek je een tijd af.' },
  { v: 'Repareren jullie ook e-bikes?', a: 'Nee. Reparaties aan e-bikes en fatbikes doen we niet. Met andere fietsen kun je wel terecht.' },
  { v: 'Zit er garantie op een tweedehands fiets?', a: 'Elke fiets wordt voor de verkoop technisch geïnspecteerd en je controleert hem samen bij aankoop. Op fietsen vanaf €350 geldt een beperkte garantie van een maand op verborgen gebreken. Vraag naar de voorwaarden.' },
  { v: 'Hoe werkt het taxibusje?', a: 'Ons busje haalt je op om fietsen te komen bekijken en testen, met plek voor 2 personen. Binnen Tilburg betaal je een vast bedrag per rit, daarbuiten per kilometer. Betaling vooraf.' },
  { v: 'Can I ask in English?', a: 'Yes. Just send your WhatsApp message in English.' },
];

const sterren = [1, 2, 3, 4, 5];
---
<Base title="Tilburg Mobile Bikes | Tweedehands fietsen, reparatie en ophaalservice in Tilburg" description="Tilburg Mobile Bikes aan de Groenstraat in Tilburg: 300+ tweedehands fietsen, reparatie, onderdelen en een ophaal- en brengservice. Elke dag op afspraak van 08:00 tot 21:00.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: hun eigen hal vol fietsen -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-bos text-wit" aria-labelledby="inhoud">
      <Image src={hal} alt="" widths={[640, 960, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" quality={56} class="absolute inset-0 -z-20 h-full w-full object-cover object-[58%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c241dd9_0%,#0c241d70_26%,#0c241de0_58%,#0c241dfc_100%)] md:bg-[linear-gradient(90deg,#0c241df7_0%,#0c241de0_38%,#0c241d66_70%,#0c241d33_100%),linear-gradient(180deg,#0c241dcc_0%,#0c241d00_30%,#0c241d00_70%,#0c241dcc_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-24 pt-36 md:pb-20 lg:pt-48">
        <div class="max-w-3xl">
          <p class="eyebrow eyebrow-licht">Tweedehands fietsen in {site.plaats}</p>
          <h1 id="inhoud" class="mt-5 text-hero"><span class="block">Een hal vol fietsen.</span> Eén is <span class="text-merk-licht">de jouwe.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-wit/90 md:text-[1.3rem]">Stadsfietsen, vouwfietsen, mountainbikes en racefietsen, plus reparatie en onderdelen. Elke fiets is gecontroleerd en waar nodig gereviseerd.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#zoeken" class="knop knop-merk">Fiets zoeken<Icoon naam="pijl" /></a>
            <a href={waHoi} class="knop knop-wit"><Icoon naam="wa" />Stuur een WhatsApp</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.95rem] text-wit/90">
            <li class="flex items-center gap-2"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-wit">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-merk-licht" /><span data-status>Elke dag op afspraak, 08:00 - 21:00</span></li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-6 right-6 hidden items-center gap-2 rounded-full bg-bos/70 px-4 py-2 text-xs font-medium text-wit/85 backdrop-blur md:flex"><Icoon naam="foto" class="h-4 w-4 text-merk-licht" />De hal aan de Groenstraat</p>
    </section>
  </div>

  <main>
    <!-- 2. Cijfers: alleen echte cijfers -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-y-9 py-11 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-steen">Gemiddeld op Google</dt><dd class="kop num order-first text-[clamp(2.6rem,2.4vw+1.7rem,3.8rem)] leading-none text-merk">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">Reviews op Google</dt><dd class="kop num order-first text-[clamp(2.6rem,2.4vw+1.7rem,3.8rem)] leading-none">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">Tweedehands fietsen</dt><dd class="kop num order-first text-[clamp(2.6rem,2.4vw+1.7rem,3.8rem)] leading-none">300+</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">Dagen per week op afspraak</dt><dd class="kop num order-first text-[clamp(2.6rem,2.4vw+1.7rem,3.8rem)] leading-none">7</dd></div>
      </dl>
    </section>

    <!-- 3. Fietsen: de vier soorten als gangen in de hal -->
    <section id="fietsen" class="py-24 md:py-32" aria-labelledby="t-fiets">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Uit de hal</p>
            <h2 id="t-fiets" class="mt-4 text-4xl">Voor elke rit een <span class="text-merk">fiets.</span></h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-4 lg:col-start-9" style="--d:.05s">Interesse? Neem contact op of kom langs voor een proefrit, op afspraak.</p>
        </div>
        <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
          {soorten.map((v, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden transition-shadow duration-300 hover:shadow-[0_18px_40px_-18px_#0c241d55]">
                <div class="relative overflow-hidden">
                  <Image src={v.src} alt={v.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 23vw, (min-width: 640px) 46vw, 100vw" quality={70} class="aspect-[4/3] w-full object-cover transition-transform sm:aspect-[4/5] duration-700 group-hover:scale-[1.04]" style={`object-position:${v.pos}`} />
                  <p class="halbord absolute left-4 top-4"><b>{v.l}</b><span>Gang {v.l}</span></p>
                  {!v.eigen && <p class="absolute bottom-3 right-3 rounded-full bg-bos/70 px-2.5 py-1 text-[.72rem] text-wit/85">Sfeerfoto</p>}
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-[1.65rem]">{v.t}</h3>
                  <p class="mt-2.5 text-steen">{v.d}</p>
                  <a href={vraag(v.wa)} class="mt-auto inline-flex items-center gap-2 pt-6 font-semibold text-merk no-underline transition-colors hover:text-merk-diep">Vraag wat er staat<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <ul class="mt-6 grid gap-4 md:grid-cols-3 lg:gap-6">
          {zeker.map((z, i) => (
            <li class="rijs flex items-start gap-4 rounded-[20px] bg-papier-2 p-6" style={`--d:${i * 0.05}s`}>
              <span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-merk text-wit"><Icoon naam="vink" class="h-5 w-5" /></span>
              <div><p class="kop text-[1.2rem]">{z.t}</p><p class="mt-1 text-steen">{z.d}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Ophaal- en brengservice -->
    <section id="ophalen" class="overflow-hidden bg-bos py-24 text-wit md:py-32" aria-labelledby="t-op">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Ophaal- en brengservice</p>
          <h2 id="t-op" class="rijs mt-4 text-4xl">Wij komen naar <span class="text-merk-licht">jou.</span></h2>
          <p class="rijs mt-7 max-w-lg text-lg leading-relaxed text-wit/85" style="--d:.06s">Fiets kapot en geen mogelijkheid om langs te komen? Wij regelen alles voor je.</p>
          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            <article class="rijs rounded-[20px] border border-lijn bg-bos-2 p-6 sm:p-7" style="--d:.08s">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-merk-licht text-bos"><Icoon naam="sleutel" class="h-6 w-6" /></span>
              <h3 class="mt-5 text-[1.5rem]">Fiets kapot</h3>
              <ul class="mt-4 space-y-2.5 text-wit/85">
                {['Binnen 24 uur halen we je fiets op', 'Je krijgt meteen een leenfiets mee', 'Na reparatie brengen we hem terug'].map((t) => <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-4 w-4 flex-none text-merk-licht" />{t}</li>)}
              </ul>
            </article>
            <article class="rijs rounded-[20px] border border-lijn bg-bos-2 p-6 sm:p-7" style="--d:.12s">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-merk-licht text-bos"><Icoon naam="busje" class="h-6 w-6" /></span>
              <h3 class="mt-5 text-[1.5rem]">Taxibusje</h3>
              <ul class="mt-4 space-y-2.5 text-wit/85">
                {['We halen je op om fietsen te bekijken en te testen', 'Plek voor 2 personen', 'Binnen Tilburg een vast bedrag per rit'].map((t) => <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-4 w-4 flex-none text-merk-licht" />{t}</li>)}
              </ul>
            </article>
          </div>
          <a href={waMet('Hallo Tilburg Mobile Bikes, kunnen jullie mijn fiets ophalen?')} class="rijs knop knop-merk mt-10" style="--d:.14s"><Icoon naam="wa" />Ophalen aanvragen</a>
        </div>
        <figure class="rijs relative lg:col-span-6" style="--d:.1s">
          <Image src={sStad} alt="Twee fietsers op een stadsstraat bij zonsondergang (sfeerfoto)" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" quality={66} class="aspect-[4/5] w-full rounded-[20px] object-cover object-[62%_50%] sm:aspect-[4/3] lg:aspect-[4/5]" />
          <blockquote class="absolute inset-x-4 bottom-4 rounded-[16px] bg-wit p-5 text-bos shadow-[0_24px_50px_-24px_#000] sm:inset-x-auto sm:bottom-6 sm:left-6 sm:max-w-sm sm:p-6">
            <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
            <p class="mt-3 leading-relaxed">“Binnen vijf minuten na mijn telefoontje over mn lekke band stond hij al klaar om mijn fiets op te halen.”</p>
            <footer class="mt-3 text-sm text-steen">Quentin G., op Google</footer>
          </blockquote>
          <figcaption class="mt-3 text-sm text-mist">Sfeerfoto, ter illustratie.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 5. Werkplaats en onderdelen -->
    <section id="werkplaats" class="py-24 md:py-32" aria-labelledby="t-werk">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <Image src={werkplaats} alt="Fiets in de montagestandaard in de werkplaats, met stapels banden op de planken" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" quality={68} class="aspect-[4/3] w-full rounded-[20px] object-cover lg:aspect-[5/6]" />
          <figcaption class="mt-3 text-sm text-steen">De werkplaats aan de Groenstraat.</figcaption>
        </figure>
        <div class="lg:col-span-6 lg:pt-4">
          <p class="rijs eyebrow">Werkplaats</p>
          <h2 id="t-werk" class="rijs mt-4 text-4xl">Reparatie, beurt en <span class="text-merk">onderdelen.</span></h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-steen" style="--d:.06s">Van een lekke band tot een grote beurt. Kom langs op afspraak, of laat je fiets ophalen.</p>
          <ul class="rijs mt-8 flex flex-wrap gap-2.5" style="--d:.08s">
            {reparaties.map((r) => <li class="chip chip-licht">{r}</li>)}
          </ul>
          <p class="rijs mt-6 flex items-start gap-3 rounded-[14px] border border-lijn-licht bg-wit px-5 py-4 text-[.98rem]" style="--d:.1s"><Icoon naam="schild" class="mt-0.5 h-5 w-5 flex-none text-merk" /><span><b>Let op:</b> geen reparaties aan e-bikes en fatbikes.</span></p>

          <div class="rijs mt-12 border-t border-lijn-licht pt-10" style="--d:.12s">
            <h3 class="text-[1.6rem]">Onderdelen uit eigen voorraad</h3>
            <div class="mt-6 grid grid-cols-[auto_1fr] gap-5 sm:gap-6">
              <div class="grid grid-cols-2 gap-3">
                <Image src={buitenbanden} alt="Stapel buitenbanden" widths={[200, 320]} sizes="(min-width: 640px) 140px, 30vw" quality={70} class="aspect-square w-[30vw] max-w-[140px] rounded-[14px] object-cover" />
                <Image src={ringslot} alt="Doos met ringsloten" widths={[200, 320]} sizes="(min-width: 640px) 140px, 30vw" quality={70} class="aspect-square w-[30vw] max-w-[140px] rounded-[14px] object-cover" />
              </div>
              <ul class="hidden flex-wrap content-start gap-x-4 gap-y-1.5 text-steen sm:flex">
                {onderdelen.map((o) => <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-merk"></span>{o}</li>)}
              </ul>
            </div>
            <ul class="mt-6 flex flex-wrap gap-x-4 gap-y-1.5 text-steen sm:hidden">
              {onderdelen.map((o) => <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-merk"></span>{o}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section class="border-y border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-stap">
      <div class="wrap">
        <div class="rijs">
          <p class="eyebrow">Zo gaat het</p>
          <h2 id="t-stap" class="mt-4 text-4xl">Van appje tot <span class="text-merk">proefrit.</span></h2>
        </div>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
          {stappen.map(([t, d], i) => (
            <li class="rijs relative flex flex-col rounded-[20px] border border-lijn-licht bg-papier p-7" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-6 text-[1.45rem]">{t}</h3>
              <p class="mt-2.5 text-steen">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Wow: fietszoeker. Kies, en het bericht staat klaar in WhatsApp. -->
    <section id="zoeken" class="bg-bos py-24 text-wit md:py-32" aria-labelledby="t-zoek">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <p class="rijs eyebrow eyebrow-licht">Fiets zoeken of reparatie</p>
          <h2 id="t-zoek" class="rijs mt-4 text-4xl">Zeg wat je <span class="text-merk-licht">zoekt.</span></h2>
          <p class="rijs mt-7 max-w-sm text-lg leading-relaxed text-wit/85" style="--d:.06s">Kies wat je zoekt of wat er mis is. Je bericht staat klaar in WhatsApp; je verstuurt het zelf.</p>
          <p class="rijs mt-8 flex items-center gap-3 text-mist" style="--d:.1s"><Icoon naam="taal" class="h-5 w-5 text-merk-licht" />Liever in het Engels? Zet je bericht op EN.</p>
        </div>

        <div class="rijs grid gap-5 lg:col-span-8 xl:grid-cols-[1.25fr_1fr]" style="--d:.08s">
          <form class="rounded-[24px] bg-papier p-5 text-bos sm:p-8" data-zoeker>
            <div class="flex gap-1 rounded-full bg-bos-2 p-1" role="tablist" aria-label="Waarvoor">
              <button type="button" class="tab" role="tab" aria-selected="true" data-tab="fiets">Fiets zoeken</button>
              <button type="button" class="tab" role="tab" aria-selected="false" data-tab="rep">Reparatie</button>
            </div>

            <div data-paneel="fiets">
              <fieldset class="mt-7">
                <legend class="veld-label">Welke fiets?</legend>
                <div class="flex flex-wrap gap-2.5">
                  {['Damesfiets', 'Herenfiets', 'Omafiets', 'Vouwfiets', 'Mountainbike', 'Racefiets', 'Transportfiets'].map((f, i) => <label class="keuze"><input type="radio" name="soort" value={f} checked={i === 0} />{f}</label>)}
                </div>
              </fieldset>
              <div class="mt-7">
                <label for="lengte" class="veld-label flex items-baseline justify-between">Je lengte <output class="num text-merk" data-lengte-uit>175 cm</output></label>
                <input id="lengte" name="lengte" type="range" min="130" max="205" step="1" value="175" class="schuif" />
              </div>
              <fieldset class="mt-6">
                <legend class="veld-label">Budget</legend>
                <div class="flex flex-wrap gap-2.5">
                  {['Onder €100', 'Onder €200', 'Boven €200', 'Weet ik nog niet'].map((b, i) => <label class="keuze"><input type="radio" name="budget" value={b} checked={i === 3} />{b}</label>)}
                </div>
              </fieldset>
              <label class="keuze mt-6"><input type="checkbox" name="taxi" value="ja" />Haal me op met het taxibusje</label>
            </div>

            <div data-paneel="rep" hidden>
              <fieldset class="mt-7">
                <legend class="veld-label">Wat is er mis?</legend>
                <div class="flex flex-wrap gap-2.5">
                  {['Lekke band', 'Remmen', 'Versnellingen', 'Verlichting', 'Ketting', 'Kleine beurt', 'Grote beurt'].map((k) => <label class="keuze"><input type="checkbox" name="klus" value={k} />{k}</label>)}
                </div>
              </fieldset>
              <label class="keuze mt-6"><input type="checkbox" name="ophalen" value="ja" />Graag ophalen, met leenfiets</label>
              <p class="mt-4 text-sm text-steen">Geen reparaties aan e-bikes en fatbikes.</p>
            </div>

            <fieldset class="mt-7 border-t border-lijn-licht pt-6">
              <legend class="veld-label pt-6">Wanneer?</legend>
              <div class="flex flex-wrap gap-2.5">
                {['Vandaag', 'Morgen', 'Dit weekend', 'Maakt niet uit'].map((d, i) => <label class="keuze"><input type="radio" name="wanneer" value={d} checked={i === 3} />{d}</label>)}
              </div>
            </fieldset>
            <div class="mt-6 flex items-center justify-between gap-4">
              <span class="veld-label mb-0">Taal van je bericht</span>
              <div class="flex gap-2">
                <label class="keuze min-h-10 px-4"><input type="radio" name="taal" value="nl" checked />NL</label>
                <label class="keuze min-h-10 px-4"><input type="radio" name="taal" value="en" />EN</label>
              </div>
            </div>
          </form>

          <!-- Voorbeeld: zo ziet het bericht eruit in WhatsApp -->
          <div class="flex flex-col overflow-hidden rounded-[24px] bg-wit text-bos shadow-[0_30px_60px_-30px_#000]">
            <div class="flex items-center gap-3 bg-[#0c3b2e] px-5 py-4 text-wit">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-wit text-merk"><Icoon naam="fiets" class="h-6 w-6" /></span>
              <span class="leading-tight"><b class="block">{site.naam}</b><span class="text-xs text-wit/75">WhatsApp, {site.tel}</span></span>
            </div>
            <div class="chat flex min-h-[22rem] flex-1 flex-col gap-3 p-4 sm:p-5">
              <p class="max-w-[88%] rounded-[4px_14px_14px_14px] bg-wit px-4 py-3 text-[.95rem] leading-relaxed text-[#111b21] shadow-[0_1px_1px_#0b141a26]">Heb je een vraag of wil je direct een afspraak maken? Stuur ons gerust een bericht via WhatsApp, wij reageren snel en persoonlijk!</p>
              <p class="mx-auto mt-auto rounded-md bg-wit/80 px-3 py-1 text-xs text-steen">Jouw bericht, nog niet verstuurd</p>
              <p class="bubbel whitespace-pre-line px-4 py-3 text-[.97rem] leading-relaxed" data-voorbeeld aria-live="polite"></p>
            </div>
            <div class="p-4 sm:p-5">
              <a href={waHoi} class="knop knop-merk w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Open in WhatsApp</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section class="py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-4 text-4xl">Wat klanten <span class="text-merk">zeggen.</span></h2>
            <p class="mt-6 text-steen">Op Google schrijven klanten vaak over:</p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {onderwerpen.map(([w, n]) => <li class="chip chip-licht min-h-9 px-3.5 text-[.92rem]">{w} <span class="num text-steen">{n}×</span></li>)}
            </ul>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-9 w-9 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="kop num text-[1.9rem] leading-none">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-sm text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {reviews.map((r, i) => (
            <li class={`rijs ${i === 0 ? 'md:col-span-2 lg:col-span-1 lg:row-span-2' : ''}`} style={`--d:${(i % 3) * 0.06}s`}>
              <figure class={`flex h-full flex-col p-7 ${i === 0 ? 'rounded-[20px] bg-bos text-wit' : 'kaart'}`}>
                <div class={`flex gap-0.5 ${i === 0 ? 'text-merk-licht' : 'text-merk'}`} role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
                <blockquote class={`mt-5 flex-1 leading-relaxed ${i === 0 ? 'kop text-[1.5rem] font-[650] leading-[1.25] tracking-[-.015em] lg:text-[1.75rem]' : ''}`}>“{r.tekst}”</blockquote>
                <figcaption class={`mt-6 flex items-center gap-3 border-t pt-5 text-sm ${i === 0 ? 'border-lijn' : 'border-lijn-licht'}`}>
                  <span class={`grid h-9 w-9 flex-none place-items-center rounded-full font-bold ${i === 0 ? 'bg-merk-licht text-bos' : 'bg-papier-2'}`}>{r.naam[0]}</span>
                  <span><b class="block font-semibold">{r.naam}</b><span class={i === 0 ? 'text-mist' : 'text-steen'}>Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. Goed om te weten -->
    <section class="border-t border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-faq">
      <div class="wrap grid gap-y-10 lg:grid-cols-12 lg:gap-x-14">
        <div class="rijs lg:col-span-4">
          <p class="eyebrow">Goed om te weten</p>
          <h2 id="t-faq" class="mt-4 text-4xl">Vragen, <span class="text-merk">kort.</span></h2>
          <p class="mt-6 max-w-sm text-steen">Staat je vraag er niet bij? Stuur een WhatsApp naar <a href={waHoi} class="link num font-semibold text-bos">{site.tel}</a>.</p>
        </div>
        <div class="rijs lg:col-span-8" style="--d:.06s">
          {vragen.map((q, i) => (
            <details class="group border-b border-lijn-licht py-1 first:border-t" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.15rem] font-semibold [&::-webkit-details-marker]:hidden">
                {q.v}
                <span class="grid h-9 w-9 flex-none place-items-center rounded-full border border-papier-3 text-merk transition-transform duration-300 group-open:rotate-45" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg></span>
              </summary>
              <p class="max-w-2xl pb-6 text-steen">{q.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. Afspraak en route -->
    <section id="contact" class="py-24 md:py-32" aria-labelledby="t-contact">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="min-w-0 lg:col-span-6">
          <p class="rijs eyebrow">Afspraak & route</p>
          <h2 id="t-contact" class="rijs mt-4 text-4xl">Groenstraat, <span class="text-merk">Voltage-terrein.</span></h2>
          <figure class="rijs relative mt-10" style="--d:.06s">
            <Image src={voltage} alt="Ingang van het Voltage-terrein aan de Groenstraat, met het logo van Tilburg Mobile Bikes" widths={[600, 900, 1146]} sizes="(min-width: 1024px) 46vw, 100vw" quality={70} class="aspect-[4/3] w-full rounded-[20px] object-cover object-[60%_50%]" />
            <figcaption class="absolute bottom-4 left-4 right-4 flex flex-wrap items-center justify-between gap-3 rounded-[14px] bg-wit/95 px-5 py-4 backdrop-blur">
              <span><b class="block">{site.straat}, {site.terrein}</b><span class="text-sm text-steen">{site.postcode} {site.plaats}</span></span>
              <a href={site.route} class="knop knop-bos min-h-11 px-5 text-[.98rem]">Route<Icoon naam="pijl" /></a>
            </figcaption>
          </figure>
        </div>
        <div class="rijs min-w-0 lg:col-span-6 lg:pt-24" style="--d:.12s">
          <div class="kaart overflow-hidden">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-lijn-licht px-6 py-5">
              <p class="kop text-[1.5rem] leading-none">Elke dag op afspraak</p>
              <p class="flex items-center gap-2 text-sm font-semibold"><span class="h-2.5 w-2.5 rounded-full bg-papier-3" data-stip></span><span data-nu-tekst>08:00 - 21:00</span></p>
            </div>
            <ul class="grid grid-cols-7 gap-1.5 p-4 sm:gap-2 sm:p-6">
              {[1, 2, 3, 4, 5, 6, 0].map((i) => (
                <li class="flex flex-col items-center rounded-[12px] bg-papier px-1 py-3 text-center" data-dag={i}>
                  <span class="text-[.8rem] font-semibold">{dagen[i].slice(0, 2)}</span>
                  <span class="num mt-1 hidden text-xs text-steen sm:block">{uur(tijd.van).slice(0, 2)}-{uur(tijd.tot).slice(0, 2)}</span>
                </li>
              ))}
            </ul>
            <p class="num px-6 pb-1 text-[.98rem] font-semibold sm:hidden">Maandag t/m zondag, 08:00 - 21:00</p>
            <p class="border-t border-lijn-licht px-6 py-5 text-[.98rem] text-steen max-sm:mt-4">Kom niet zonder afspraak langs: er is niet altijd iemand in de garage. Stuur eerst een WhatsApp.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <p class="mt-5 text-sm text-steen">Snelste antwoord via WhatsApp, ook in het Engels.</p>
        </div>
      </div>
    </section>

    <!-- 11. Slotbalk met hun eigen slogan -->
    <section class="bg-merk text-wit" aria-label="Afspraak">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center md:py-14">
        <p class="kop text-[clamp(1.9rem,2.6vw+1rem,2.9rem)] leading-none">Keep it green, keep it moving!</p>
        <a href="#zoeken" class="knop knop-bos shrink-0">Fiets zoeken<Icoon naam="pijl" /></a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site, tijd } from '../data/site';
  // Beschikbaar volgens hun eigen site: elke dag 08:00 - 21:00, op afspraak.
  const nu = new Date(); const d = nu.getDay(); const h = nu.getHours() + nu.getMinutes() / 60;
  const bereikbaar = h >= tijd.van && h < tijd.tot;
  const zin = bereikbaar ? 'Vandaag nog op afspraak, tot 21:00' : h < tijd.van ? 'Vandaag op afspraak vanaf 08:00' : 'Morgen weer op afspraak vanaf 08:00';
  const st = document.querySelector('[data-status]'); if (st) st.textContent = zin;
  const nt = document.querySelector('[data-nu-tekst]'); if (nt) nt.textContent = bereikbaar ? 'Nu beschikbaar' : 'Weer vanaf 08:00';
  const stip = document.querySelector<HTMLElement>('[data-stip]'); if (stip) stip.style.background = bereikbaar ? '#2f7a1f' : '#a3b0a8';
  const vandaag = document.querySelector<HTMLElement>(`[data-dag="${d}"]`);
  if (vandaag) { vandaag.style.background = '#0c241d'; vandaag.style.color = '#fff'; vandaag.querySelector<HTMLElement>('.num')!.style.color = '#7fcf4a'; }

  // Fietszoeker: wordt een WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-zoeker]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const uit = document.querySelector<HTMLOutputElement>('[data-lengte-uit]');
  let modus: 'fiets' | 'rep' = 'fiets';
  const EN: Record<string, string> = {
    Damesfiets: "women's bike", Herenfiets: "men's bike", Omafiets: 'granny bike', Vouwfiets: 'folding bike', Mountainbike: 'mountain bike', Racefiets: 'road bike', Transportfiets: 'transport bike',
    'Onder €100': 'under €100', 'Onder €200': 'under €200', 'Boven €200': 'over €200',
    'Lekke band': 'flat tyre', Remmen: 'brakes', Versnellingen: 'gears', Verlichting: 'lights', Ketting: 'chain', 'Kleine beurt': 'small service', 'Grote beurt': 'full service',
    Vandaag: 'today', Morgen: 'tomorrow', 'Dit weekend': 'this weekend',
  };
  if (f && vb && knop) {
    const tekst = () => {
      const fd = new FormData(f);
      const en = fd.get('taal') === 'en';
      const t = (s: string) => (en ? EN[s] || s : s.toLowerCase());
      const wanneer = String(fd.get('wanneer') || '');
      const r = [en ? 'Hello Tilburg Mobile Bikes,' : 'Hallo Tilburg Mobile Bikes,'];
      if (modus === 'fiets') {
        const soort = String(fd.get('soort') || ''); const lengte = String(fd.get('lengte') || ''); const budget = String(fd.get('budget') || '');
        r.push(en ? `I'm looking for a ${t(soort)}. I am ${lengte} cm tall.` : `Ik zoek een ${t(soort)}. Ik ben ${lengte} cm lang.`);
        if (budget && budget !== 'Weet ik nog niet') r.push(en ? `Budget: ${t(budget)}.` : `Budget: ${t(budget)}.`);
        if (fd.get('taxi')) r.push(en ? 'Could you pick me up with the taxi van to come and look?' : 'Kunnen jullie me ophalen met het taxibusje om te komen kijken?');
      } else {
        const klus = fd.getAll('klus').map(String);
        r.push(en ? `My bike needs repair${klus.length ? `: ${klus.map(t).join(', ')}` : ''}.` : `Mijn fiets moet gerepareerd worden${klus.length ? `: ${klus.map(t).join(', ')}` : ''}.`);
        if (fd.get('ophalen')) r.push(en ? 'Please pick it up, with a loan bike.' : 'Graag ophalen, met een leenfiets.');
      }
      r.push(wanneer && wanneer !== 'Maakt niet uit' ? (en ? `Preferably ${t(wanneer)}.` : `Het liefst ${t(wanneer)}.`) : (modus === 'rep' && fd.get('ophalen') ? (en ? 'When could you pick it up?' : 'Wanneer kunnen jullie hem ophalen?') : (en ? 'When can I come by?' : 'Wanneer kan ik langskomen?')));
      return r.join('\n');
    };
    const zet = () => { const tk = tekst(); vb.textContent = tk; knop.href = `${site.wa}?text=${encodeURIComponent(tk)}`; if (uit) uit.textContent = `${(f.elements.namedItem('lengte') as HTMLInputElement).value} cm`; };
    f.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => {
      modus = b.dataset.tab as 'fiets' | 'rep';
      f.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      f.querySelectorAll<HTMLElement>('[data-paneel]').forEach((p) => (p.hidden = p.dataset.paneel !== modus));
      zet();
    }));
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
