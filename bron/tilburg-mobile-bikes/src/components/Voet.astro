---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const werk = [['fietsen', 'Tweedehands fietsen'], ['ophalen', 'Ophalen en terugbrengen'], ['ophalen', 'Taxibusje: kom kijken en testen'], ['werkplaats', 'Reparatie en onderdelen'], ['zoeken', 'Fiets zoeken via WhatsApp']];
---
<footer class="bg-bos text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.95rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Tweedehands fietsen, reparatie en onderdelen in {site.plaats}. Keep it green, keep it moving!</p>
      <div class="mt-7 flex items-center gap-3">
        <a href={waHoi} class="knop knop-merk min-h-11 px-5"><Icoon naam="wa" />WhatsApp</a>
        <a href={site.insta} class="grid h-11 w-11 place-items-center rounded-full border border-lijn text-wit transition-colors hover:border-merk-licht hover:text-merk-licht" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
      </div>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-wit">Wat we doen</p>
      <ul class="mt-5 space-y-2">
        {werk.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <ul class="mt-5 space-y-2">
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a> <span class="text-mist/80">(liefst WhatsApp)</span></li>
        <li>{site.straat}, {site.terrein}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.route} class="no-underline hover:text-merk-licht">Route plannen</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-wit">Op afspraak</p>
      <p class="mt-5">Maandag t/m zondag</p>
      <p class="num text-wit">08:00 - 21:00</p>
      <p class="mt-4 text-[.88rem]">Niet zonder afspraak langskomen.</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  <p class="wrap pb-8 text-xs">Foto's van de hal, de werkplaats en de fietsen: Tilburg Mobile Bikes. Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google; tijden en diensten volgens hun eigen site (stand 13 oktober 2026).</p>
  <div class="h-14 md:hidden" aria-hidden="true"></div>
</footer>
