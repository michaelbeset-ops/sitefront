---
// Hun eigen logo (rond, van de Canva-site) met de naam ernaast.
import { Image } from 'astro:assets';
import { url } from '../data/site';
import logo from '../assets/logo.png';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 leading-none no-underline ${donker ? 'text-bos' : 'text-wit'}`}>
  <Image src={logo} alt="" width={112} height={112} densities={[1, 2]} class="h-12 w-12 flex-none rounded-full bg-wit shadow-[0_0_0_2px_#ffffff26] sm:h-14 sm:w-14" loading="eager" />
  <span class="flex flex-col">
    <span class="kop text-[1.3rem] leading-[.95] sm:text-[1.42rem]">Tilburg</span>
    <span class="kop text-[1.3rem] leading-[.95] sm:text-[1.42rem]">Mobile <span class={donker ? 'text-merk' : 'text-merk-licht'}>Bikes</span></span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>
