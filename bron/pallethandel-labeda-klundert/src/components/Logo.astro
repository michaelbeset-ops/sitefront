---
import Pallet from './Pallet.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-3 ${cls}`}>
  <Pallet class="h-[1.15em] w-auto text-groen-licht" />
  <span class="leading-none">
    <span class="block font-kop text-[1.9em] font-extrabold uppercase leading-[.8] tracking-[.02em]">Labeda</span>
    <span class="mt-1 block text-[.62em] font-semibold uppercase tracking-[.22em] opacity-80">Pallethandel</span>
  </span>
</span>
