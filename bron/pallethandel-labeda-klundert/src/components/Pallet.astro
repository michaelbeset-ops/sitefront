---
// Zijaanzicht van een pallet: dekplank, drie blokken, onderplank. Gebruikt als woordmerk-teken en sectieverdeler.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 120 40" fill="currentColor" aria-hidden="true">
  <rect x="0" y="0" width="120" height="9" />
  <rect x="4" y="11" width="20" height="18" />
  <rect x="50" y="11" width="20" height="18" />
  <rect x="96" y="11" width="20" height="18" />
  <rect x="0" y="31" width="120" height="9" />
</svg>
