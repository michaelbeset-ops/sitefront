---
import { site, url, tijden } from '../data/site';
import Logo from './Logo.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-asfalt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <span class="text-lg text-wit"><Logo /></span>
      <p class="mt-6 max-w-xs">Inkoop, verkoop en reparatie van nieuwe en gebruikte houten pallets. Met eigen transport, vanaf {site.terrein}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Pallets</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={url('#aanvraag')} class="link">Pallets kopen</a></li>
        <li><a href={url('#aanvraag')} class="link">Pallets verkopen of laten ophalen</a></li>
        <li><a href={url('#wat')} class="link">Reparatie</a></li>
        <li><a href={url('#ht')} class="link">Heat treated (ISPM 15)</a></li>
        <li><a href={url('#transport')} class="link">Transport</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a> <span class="text-mist/80">(ook WhatsApp)</span></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
      <p class="mt-1.5"><a href={site.maps} class="link">Route</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <p class="mt-4">Ma t/m vr<br /><span class="num">{tijden[0].open} - {tijden[0].dicht}</span></p>
      <p class="mt-3">Za en zo gesloten</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.bv} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-groen-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en foto’s van pallethandellabeda.nl, aangevuld met één sfeerfoto van Unsplash (de palletwand bij Kopen, verkopen, repareren). Openingstijden volgens Google (stand 7 oktober 2026).</p>}
</footer>
