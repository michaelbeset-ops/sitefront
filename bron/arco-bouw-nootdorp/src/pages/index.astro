---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import uitbouw from '../assets/uitbouw.jpg';
import kap from '../assets/kap.jpg';
import keuken from '../assets/keuken.jpg';
import renovatie from '../assets/renovatie.jpg';
import steiger from '../assets/steiger.jpg';
import schilder from '../assets/schilder.jpg';
import busje from '../assets/busje.jpg';
import bouwplaats from '../assets/bouwplaats.jpg';
import balklaag from '../assets/balklaag.jpg';
import vloer from '../assets/vloer.jpg';

const vraag = (b: string) => waMet(`Goedendag Arcobouw, ik heb een vraag over ${b.toLowerCase()}. Kunt u een keer langskomen voor een vrijblijvende beoordeling?`);

const diensten = [
  { t: 'Aanbouw en uitbouw', d: 'Het vergroten van uw woning of bedrijfspand. Ook de bouwvergunning kunnen we voor u verzorgen.', src: uitbouw, alt: 'Achterkant van een woning met een nieuwe uitbouw in grijze bouwstenen en openslaande deuren, in aanbouw', pos: '50% 60%', label: 'Verbouwing' },
  { t: 'Dakopbouw en dakkapel', d: 'Een dakopbouw maken of een dakkapel plaatsen, voor meer ruimte onder het dak.', src: kap, alt: 'Houten dakspanten tegen een blauwe lucht', pos: '50% 50%', label: 'Verbouwing' },
  { t: 'Keuken en badkamer', d: 'Een keuken plaatsen naar uw eigen ontwerp, of uw badkamer installeren of aanpassen.', src: keuken, alt: 'Lichte keuken met witte kastjes, zeshoekige wandtegels en een fornuis', pos: '50% 50%', label: 'Verbouwing' },
  { t: 'Wanden doorbreken', d: 'Tussenwanden doorbreken of een schuur bouwen. We bekijken meteen de constructieve mogelijkheden.', src: renovatie, alt: 'Kamer tijdens een verbouwing, met stempels onder het plafond en puin op de vloer', pos: '50% 55%', label: 'Verbouwing' },
  { t: 'Renovatie', d: 'Dak-, gevel- en kozijnrenovatie en hoogrendementsglas, tot een complete woning- of bedrijfsrenovatie.', src: steiger, alt: 'Werk op de steiger: een vakman bij een nieuwe dakrand met planken en isolatieplaten', pos: '40% 50%', label: 'Renovatie', eigen: true },
  { t: 'Onderhoud en schade', d: 'Schilderwerk, dakisolatie, kozijnen, goten en gevels. Bij inbraak-, water- of brandschade brengen we een noodvoorziening aan.', src: schilder, alt: 'Schilder op een ladder bij de ramen van een witte gevel', pos: '50% 35%', label: 'Onderhoud' },
];

const stappen = [
  ['U neemt contact op', 'Bel, mail of stuur een WhatsApp met uw plannen of uw vraag over onderhoud.'],
  ['Wij komen bij u langs', 'Voor een vrijblijvende beoordeling en een deskundig advies op maat.'],
  ['Planning en kosten vooraf', 'Een duidelijke planning en kostenberekening. U weet van tevoren waar u aan toe bent.'],
  ['Uitvoering', 'Door ons eigen team van professionals, waar nodig met vaste onderaannemers.'],
];

const werk = [
  { src: busje, alt: 'Een Arcobouw-bus met het logo en de tekst Nootdorp', pos: '12% 50%' },
  { src: balklaag, alt: 'Nieuwe houten balklaag met een rode stalen ligger', pos: '50% 40%' },
  { src: vloer, alt: 'Een vers gestorte betonvloer achter een woning, binnen een houten bekisting', pos: '50% 50%' },
];

const klussen = ['Aanbouw of uitbouw', 'Dakopbouw of dakkapel', 'Keuken', 'Badkamer', 'Renovatie', 'Onderhoud of schilderwerk', 'Schade herstellen'];
---
<Base title={`${site.naam} (Arcobouw) | Aannemer in Nootdorp`} description="Arcobouw, aannemersbedrijf in Nootdorp: aanbouw, uitbouw, dakopbouw, keukens en badkamers, renovatie en onderhoud. Vrijblijvende beoordeling bij u thuis.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen bussen voor de werkplaats -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[64%_55%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#161a4a40_0%,#161a4ac7_40%,#161a4af7_100%)] md:bg-[linear-gradient(90deg,#161a4af5_0%,#161a4acc_38%,#161a4a26_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-12 pt-14 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Aannemersbedrijf in Nootdorp</p>
          <h1 id="t-hero" class="mt-5 text-hero">Verbouwen <span class="text-roze">zonder verrassingen</span> achteraf.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Aanbouw, dakopbouw, renovatie of onderhoud. Arcobouw zorgt voor een duidelijke planning en kostenberekening, zodat u vooraf weet waar u aan toe bent.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-steen"><Icoon naam="wa" />Vrijblijvende beoordeling</a>
            <a href="#diensten" class="knop knop-rand op-foto hidden sm:inline-flex">Bekijk de diensten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4].map(() => <Icoon naam="ster" class="h-4 w-4" />)}<Icoon naam="ster" class="h-4 w-4 opacity-40" /></span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 16.30 uur</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto w-full max-w-[19rem] rounded-md bg-nacht/80 p-6 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <p class="text-sm text-licht-zacht">Direct contact</p>
            <a href={site.telHref} class="num mt-1 block font-kop text-[1.9rem] leading-tight text-licht no-underline hover:text-roze">{site.tel}</a>
            <p class="mt-3 border-t border-lijn-licht pt-3 text-sm text-licht-zacht">Werkplaats <span class="whitespace-nowrap">{site.straat}</span>, {site.plaats}<br />Ma t/m vr 8.00 tot 16.30 uur</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Werkzaamheden in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-2.5 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-sm border border-lijn bg-papier px-3.5 py-1.5 text-sm font-semibold no-underline transition-colors hover:border-steen hover:bg-steen hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-28" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Wat wij doen</p>
            <h2 id="t-dienst" class="mt-4 text-3xl">Verbouwing, renovatie en onderhoud. Arcobouw kan het allemaal voor u verzorgen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Voor uw woning of uw bedrijfspand. Kies een dienst en stel uw vraag direct via WhatsApp.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw" class="aspect-[16/9] sm:aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                  <span class="absolute left-0 top-4 bg-nacht px-3 py-1 text-xs font-bold uppercase tracking-[.14em] text-licht">{b.label}</span>
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 border-t-[3px] border-steen p-5 sm:p-6">
                  <div>
                    <h3 class="text-xl">{b.t}</h3>
                    <p class="mt-2 text-[.9875rem] text-grijs">{b.d}</p>
                  </div>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-beton text-steen transition-colors group-hover:bg-steen group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-md bg-nacht px-6 py-6 text-licht sm:flex-row sm:items-center md:px-8 donker">
          <p class="flex items-start gap-4 text-lg"><Icoon naam="doc" class="mt-1 h-6 w-6 shrink-0 text-roze" /><span><b class="font-semibold">Bouwvergunning nodig?</b> <span class="text-licht-zacht">Ook dit traject kunnen we voor u verzorgen.</span></span></p>
          <a href={waMet('Goedendag Arcobouw, ik heb een vraag over een bouwvergunning voor mijn plannen.')} class="knop knop-wit knop-klein shrink-0"><Icoon naam="wa" />Vraag het ons</a>
        </div>
      </div>
    </section>

    <!-- 4. Werkwijze -->
    <section id="werkwijze" class="border-y border-lijn bg-beton py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">U weet van tevoren waar u aan toe bent.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Arcobouw denkt graag met u mee en is transparant over de kosten. En afspraak is afspraak.</p>
        </div>
        <ol class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative p-4 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2rem] leading-none text-steen sm:text-[2.5rem]">0{i + 1}</p>
              <h3 class="mt-4 text-[1.0625rem] sm:mt-6 sm:text-xl">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. Over Arcobouw -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:col-span-5">
          <Image src={bouwplaats} alt="Bouwplaats van bovenaf gezien, met een bouwhek met het Arcobouw-doek en een vakman aan het werk" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_45%]" />
          <p class="absolute bottom-0 left-0 bg-steen px-4 py-2 text-sm font-semibold text-wit">Arcobouw aan het werk</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Arcobouw</p>
          <h2 id="t-over" class="mt-4 text-3xl">Wij bouwen niet alleen aan het bouwwerk, ook aan de relatie.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Ons team bestaat uit professionals met ieder een eigen specialisme. De communicatielijnen zijn kort, zodat we flexibel en slagvaardig werken en de werkzaamheden niet langer duren dan noodzakelijk. Een tevreden klant is de beste reclame.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-steen text-wit"><Icoon naam="hand" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Afspraak is afspraak</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Klanten schrijven het ook: afspraken werden altijd netjes nagekomen.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-steen text-wit"><Icoon naam="euro" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Transparant over de kosten</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Een duidelijke kostenberekening vooraf. Op al ons werk zijn de AVA 1992 van toepassing.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-steen text-wit"><Icoon naam="huis" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Betrokken in de buurt</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Elk jaar steunen we lokale verenigingen, jeugdinstellingen en activiteiten. En er is regelmatig plek voor stagiaires.</p></div>
            </li>
          </ul>
        </div>
      </div>
      <div class="wrap pb-20 lg:pb-24 lg:pt-4">
        <div class="flex flex-wrap items-end justify-between gap-4 border-t border-lijn-licht pt-10">
          <h3 class="text-2xl">Uit ons werk</h3>
          <a href={site.reviews} class="link text-sm font-semibold">Meer foto’s op ons Google-profiel</a>
        </div>
        <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
          {werk.map((w, i) => (
            <li class={`rijs relative overflow-hidden rounded-md bg-nacht-2 ${i === 0 ? 'col-span-2 aspect-[16/10] md:col-span-1 md:aspect-[4/5]' : 'aspect-[4/5]'}`} style={`--d:${i * 0.06}s`}>
              <Image src={w.src} alt={w.alt} widths={[400, 640, 900]} sizes="(min-width: 768px) 30vw, 92vw" class="tegel absolute inset-0 h-full w-full object-cover" style={`object-position:${w.pos}`} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Reviews -->
    <section id="reviews" class="py-20 lg:py-28" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4].map(() => <Icoon naam="ster" class="h-4 w-4" />)}<Icoon naam="ster" class="h-4 w-4 opacity-30" /></span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-12">
          {reviews.map((r, i) => (
            <li class={`rijs kaart flex flex-col p-6 md:p-8 ${i === 0 ? 'lg:col-span-5' : 'lg:col-span-4'}`} style={`--d:${i * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-sm bg-beton font-kop text-steen" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
          <li class="rijs donker flex flex-col justify-between rounded-md bg-steen p-6 text-wit md:p-8 lg:col-span-3" style="--d:.12s">
            <p class="font-kop text-[4.5rem] leading-none"><span class="num">{site.google.vijf}</span><span class="text-[2rem] text-wit/80">/{site.google.aantal}</span></p>
            <div class="mt-8">
              <p class="text-xl font-semibold">reviews met vijf sterren</p>
              <p class="mt-2 text-wit/90">Op het Google-profiel van Arco Aannemersbedrijf.</p>
              <a href={site.reviews} class="mt-6 inline-flex items-center gap-2 font-semibold text-wit underline underline-offset-4">Alle reviews<Icoon naam="pijl" class="h-4 w-4" /></a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- 7. Contact: klusplanner die een WhatsApp-bericht maakt -->
    <section id="contact" class="border-t border-lijn bg-beton py-20 lg:py-28" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Vertel ons over uw plannen.</h2>
          <p class="mt-6 text-lg text-grijs">Kies wat u wilt laten doen. Wij maken er een WhatsApp-bericht van; foto’s van de situatie stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-steen text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-steen" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-beton text-steen"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="num text-grijs">{site.tel} of {site.vast}</span></span><Icoon naam="pijl" class="h-5 w-5 text-steen" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-beton text-steen"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="break-all text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-steen" /></a></li>
          </ul>
          <div class="kaart mt-3 p-5 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-lg">Bereikbaar</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr</span></p>
            </div>
            <table class="mt-3 w-full text-[.9375rem]">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-steen">
                    <th scope="row" class="py-1.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-1.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-lijn pt-4">
              <p class="flex items-start gap-2 text-[.9375rem]"><Icoon naam="pin" class="mt-0.5 h-5 w-5 shrink-0 text-steen" /><span>{site.straat}, {site.postcode} {site.plaats}</span></p>
              <a href={site.maps} class="link text-sm font-semibold">Route</a>
            </div>
          </div>
        </div>
        <form class="kaart self-start p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw bericht aan Arcobouw</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat wilt u laten doen?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {klussen.map((b, i) => (
                <label class="keuze"><input type="radio" name="klus" value={b} class="sr-only" checked={i === 0} /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-7 sm:grid-cols-2">
            <fieldset>
              <legend class="text-sm font-semibold">Voor</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                {['Mijn woning', 'Een bedrijfspand'].map((b, i) => <label class="keuze"><input type="radio" name="pand" value={b} class="sr-only" checked={i === 0} /><span>{b}</span></label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="text-sm font-semibold">Hoe ver bent u?</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                {['Nog een idee', 'Plannen zijn concreet'].map((b, i) => <label class="keuze"><input type="radio" name="fase" value={b} class="sr-only" checked={i === 0} /><span>{b}</span></label>)}
              </div>
            </fieldset>
            <label class="block"><span class="text-sm font-semibold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld Nootdorp" /></label>
            <label class="block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
          </div>
          <div class="mt-7 rounded-sm border-l-[3px] border-steen bg-papier px-5 py-4" aria-live="polite">
            <p class="text-xs font-bold uppercase tracking-[.14em] text-steen">Wat wij dan doen</p>
            <p class="mt-1.5" data-hint>Wij denken graag met u mee. We komen langs voor een vrijblijvende beoordeling en bekijken meteen de constructieve mogelijkheden.</p>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-steen"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Liever bellen? <a href={site.telHref} class="link num whitespace-nowrap">{site.tel}</a></p>
          </div>
        </form>
      </div>
    </section>

    <!-- 8. Slotbalk -->
    <section class="bg-steen text-wit" aria-label="Offerte aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Verbouwingsplannen?</h2>
          <p class="mt-2 text-lg text-wit/90">Wij komen graag bij u langs voor een vrijblijvende beoordeling.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp ons</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const hint = document.querySelector<HTMLElement>('[data-hint]');
  if (f) {
    const v = (n: string) => String(new FormData(f).get(n) || '').trim();
    // Teksten uit hun eigen site (verbouwing, onderhoud).
    const zet = () => {
      if (!hint) return;
      if (v('klus') === 'Schade herstellen') hint.textContent = 'Bij inbraak-, water- of brandschade kunnen we een noodvoorziening aanbrengen en zorgen we ervoor dat de schade zo snel mogelijk hersteld wordt.';
      else if (v('fase') === 'Nog een idee') hint.textContent = 'Wij denken graag met u mee. We komen langs voor een vrijblijvende beoordeling en bekijken meteen de constructieve mogelijkheden.';
      else hint.textContent = 'We komen langs voor een vrijblijvende beoordeling. Daarna krijgt u een duidelijke planning en kostenberekening. Bouwvergunning nodig? Ook dat traject kunnen we verzorgen.';
    };
    f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = ['Goedendag Arcobouw, ik wil graag een vrijblijvende beoordeling.'];
      r.push('Klus: ' + v('klus') + (v('pand') ? ' (' + v('pand').toLowerCase() + ')' : ''));
      if (v('fase')) r.push('Stand: ' + v('fase').toLowerCase());
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31621587655?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

