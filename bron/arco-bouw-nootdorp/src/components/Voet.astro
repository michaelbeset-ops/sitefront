---
import { Image } from 'astro:assets';
import { site, url, tijden, waOfferte } from '../data/site';
import logoLicht from '../assets/logo-licht.png';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const diensten = ['Aanbouw en uitbouw', 'Dakopbouw en dakkapel', 'Keukens en badkamers', 'Renovatie', 'Onderhoud', 'Schadeherstel'];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="inline-block" aria-label={`${site.naam}, naar de homepage`}>
        <Image src={logoLicht} alt="" widths={[132, 264]} sizes="132px" class="h-[3.1rem] w-auto" />
      </a>
      <p class="mt-6 max-w-xs">Aannemersbedrijf voor verbouwing, renovatie en onderhoud van woningen en bedrijfspanden. Werkplaats aan de Ambachtshof in Nootdorp.</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {diensten.map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-roze">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-roze">{site.tel}</a></li>
        <li><a href={site.vastHref} class="num whitespace-nowrap no-underline transition-colors hover:text-roze">{site.vast}</a></li>
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-roze">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-roze">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Bereikbaar</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Openingstijden</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-roze">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
      <p class="flex flex-wrap gap-x-6 gap-y-1"><span>Op al onze werkzaamheden zijn de AVA 1992 van toepassing</span><a href={url('privacy/')} class="no-underline hover:text-roze">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw Google-bedrijfsprofiel en sfeerfoto’s via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 3 oktober 2026).</p>}
  </div>
</footer>
