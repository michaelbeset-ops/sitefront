---
// Contact + offerteformulier. Verstuurt zelf niets: opent WhatsApp (of e-mail) met een ingevuld bericht.
import { Image } from 'astro:assets';
import Icoon from './Icoon.astro';
import { site, waOfferte } from '../data/site';
import garagedeur from '../assets/garagedeur.jpg';
const opties = ['Rolluiken', 'Garagedeur', 'Zonnescherm', 'Screens', 'Uitvalscherm of markies', 'Veranda of overkapping', 'Binnenzonwering', 'Service of reparatie', 'Iets anders'];
---
<section id="contact" class="bg-steen py-24 md:py-32" aria-labelledby="t-contact">
  <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <p class="eyebrow">Contact</p>
      <h2 id="t-contact" class="mt-4 text-3xl">Vraag een vrijblijvende offerte aan.</h2>
      <p class="mt-5 max-w-md text-grijs">Stel uw vraag of geef direct uw specificaties door. U ontvangt dan een geheel vrijblijvende offerte. Een foto van de gevel of het raam helpt.</p>
      <ul class="mt-9 space-y-3">
        <li><a href={waOfferte} class="kaart flex items-center gap-4 p-4 no-underline transition-shadow hover:shadow-md"><span class="grid h-11 w-11 flex-none place-items-center rounded-sm bg-groen text-inkt"><Icoon naam="wa" class="h-5 w-5" /></span><span><b class="block">WhatsApp</b><span class="num text-sm text-grijs">{site.tel}</span></span></a></li>
        <li><a href={site.telHref} class="kaart flex items-center gap-4 p-4 no-underline transition-shadow hover:shadow-md"><span class="grid h-11 w-11 flex-none place-items-center rounded-sm bg-nacht text-groen"><Icoon naam="tel" class="h-5 w-5" /></span><span><b class="block">Bellen</b><span class="num text-sm text-grijs">{site.tel}</span></span></a></li>
        <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-4 no-underline transition-shadow hover:shadow-md"><span class="grid h-11 w-11 flex-none place-items-center rounded-sm bg-nacht text-groen"><Icoon naam="mail" class="h-5 w-5" /></span><span><b class="block">E-mail</b><span class="text-sm text-grijs">{site.mail}</span></span></a></li>
      </ul>
      <div class="mt-3 flex items-center gap-4 overflow-hidden rounded-md bg-nacht text-licht">
        <Image src={garagedeur} alt="" widths={[200]} sizes="100px" class="h-28 w-24 flex-none object-cover" />
        <div class="py-3 pr-4">
          <p class="font-semibold">{site.straat}, {site.postcode} {site.plaats}</p>
          <a href={site.maps} class="mt-1 inline-flex items-center gap-1.5 text-sm text-groen no-underline hover:underline">Route plannen<Icoon naam="pijl" class="h-4 w-4" /></a>
        </div>
      </div>
    </div>

    <form class="kaart p-6 sm:p-9 lg:col-span-7" data-offerte novalidate>
      <h3 class="text-2xl">Uw aanvraag</h3>
      <p class="mt-2 text-sm text-grijs">Dit formulier maakt een bericht voor u klaar. Er wordt pas iets verstuurd als u dat zelf doet in WhatsApp of uw mail.</p>
      <fieldset class="mt-7 min-w-0">
        <legend class="text-sm font-semibold">Waar gaat het om?</legend>
        <div class="mt-3 flex flex-wrap gap-2">
          {opties.map((o, i) => (
            <label class="optie"><input type="checkbox" name="wat" value={o} class="sr-only" checked={i === 0} /><span>{o}</span></label>
          ))}
        </div>
      </fieldset>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <label class="veld"><span>Naam</span><input name="naam" autocomplete="name" /></label>
        <label class="veld"><span>Plaats</span><input name="plaats" autocomplete="address-level2" /></label>
      </div>
      <label class="veld mt-4"><span>Toelichting <em class="font-normal not-italic text-grijs">(maten, kleur, bediening)</em></span><textarea name="extra" rows="3" placeholder="Bijvoorbeeld: 2 ramen aan de achterkant, ongeveer 1,8 m breed, elektrisch."></textarea></label>
      <div class="mt-6 rounded-sm bg-papier p-4 text-sm">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-grijs">Voorbeeld van uw bericht</p>
        <p class="mt-2 whitespace-pre-line" data-voorbeeld aria-live="polite"></p>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={waOfferte} class="knop knop-groen" data-stuur-wa><Icoon naam="wa" />Verder in WhatsApp</a>
        <a href={`mailto:${site.mail}`} class="knop knop-rand" data-stuur-mail><Icoon naam="mail" />Per e-mail</a>
      </div>
    </form>
  </div>
</section>

<style>
  .optie { cursor: pointer; }
  .optie span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 .9rem; border-radius: var(--radius-sm); background: var(--color-papier); box-shadow: inset 0 0 0 1px var(--color-lijn); font-size: .9375rem; font-weight: 500; transition: background-color .2s, color .2s, box-shadow .2s; }
  .optie:hover span { box-shadow: inset 0 0 0 1.5px var(--color-inkt); }
  .optie input:checked + span { background: var(--color-inkt); color: var(--color-licht); box-shadow: none; }
  .optie input:focus-visible + span { outline: 3px solid var(--color-groen-diep); outline-offset: 2px; }
  .veld { display: block; }
  .veld > span { display: block; font-size: .875rem; font-weight: 600; }
  .veld input, .veld textarea { margin-top: .4rem; width: 100%; border-radius: var(--radius-sm); background: var(--color-papier); padding: .8rem .9rem; font: inherit; box-shadow: inset 0 0 0 1px var(--color-lijn); transition: box-shadow .2s; }
  .veld input:focus, .veld textarea:focus { outline: none; box-shadow: inset 0 0 0 2px var(--color-groen-diep); }
</style>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-offerte]');
  if (f) {
    const wa = f.querySelector<HTMLAnchorElement>('[data-stuur-wa]')!;
    const mail = f.querySelector<HTMLAnchorElement>('[data-stuur-mail]')!;
    const vb = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
    const basisWa = wa.href.split('?')[0], basisMail = mail.href;
    const bouw = () => {
      const fd = new FormData(f);
      const wat = (fd.getAll('wat') as string[]).map((w) => w.toLowerCase());
      const naam = String(fd.get('naam') || '').trim(), plaats = String(fd.get('plaats') || '').trim(), extra = String(fd.get('extra') || '').trim();
      const regels = [`Hallo Kurt, ik wil graag een vrijblijvende offerte${wat.length ? ` voor: ${wat.join(', ')}` : ''}.`];
      if (extra) regels.push(extra);
      if (naam || plaats) regels.push(`${naam}${naam && plaats ? ', ' : ''}${plaats}`);
      const tekst = regels.join('\n\n');
      vb.textContent = tekst;
      wa.href = `${basisWa}?text=${encodeURIComponent(tekst)}`;
      mail.href = `${basisMail}?subject=${encodeURIComponent('Offerteaanvraag via de website')}&body=${encodeURIComponent(tekst)}`;
    };
    f.addEventListener('input', bouw); f.addEventListener('change', bouw);
    f.addEventListener('submit', (e) => e.preventDefault());
    bouw();
  }
</script>
