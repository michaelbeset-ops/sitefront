---
import { site, url, merken, waOfferte } from '../data/site';
import Icoon from './Icoon.astro';
import Merkteken from './Merkteken.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const producten = ['Rolluiken', 'Garagedeuren', 'Zonneschermen en screens', "Veranda's en overkappingen", 'Binnenzonwering'];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <Merkteken class="h-8 w-auto" licht />
        <span><b>KJS</b><small>Rolluiken · Zonwering</small></span>
      </a>
      <p class="mt-6 max-w-xs">Rolluiken, garagedeuren, zonwering en veranda's vanuit Ossendrecht. Advies, inmeten en montage door vakmensen.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-sm bg-nacht-2 text-licht transition-colors hover:bg-groen hover:text-inkt" aria-label="Facebook"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1Z"/></svg></a>
        <a href={site.instagram} class="grid h-10 w-10 place-items-center rounded-sm bg-nacht-2 text-licht transition-colors hover:bg-groen hover:text-inkt" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Producten</p>
      <ul class="mt-4 space-y-2">
        {producten.map((c) => <li><a href={h('producten')} class="no-underline transition-colors hover:text-groen">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-groen">{site.tel}</a></li>
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-groen">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="no-underline transition-colors hover:text-groen">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.maps} class="no-underline transition-colors hover:text-groen">Route plannen</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-2">
      <p class="font-semibold text-licht">Merken</p>
      <ul class="mt-4 space-y-2">
        {merken.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-groen">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto's van uw Facebook-pagina en sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 4 oktober 2026).</p>}
  </div>
</footer>
