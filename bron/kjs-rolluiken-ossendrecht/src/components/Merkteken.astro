---
// Lamellen-teken naar hun logo: vijf lamellen, links donker, rechts licht, met een knik in het midden.
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
const a = licht ? '#f3f4f0' : '#15181b';
const b = licht ? '#8c939a' : '#9aa0a6';
const rijen = [0, 1, 2, 3, 4];
---
<svg viewBox="0 0 46 40" class={cls} aria-hidden="true">
  {rijen.map((i) => {
    const y = 2 + i * 7.6;
    return (
      <g>
        <path d={`M1 ${y + 1.6} L24 ${y} L24 ${y + 4.6} L1 ${y + 6}Z`} fill={a} />
        <path d={`M24 ${y} L45 ${y + 1.6} L45 ${y + 6} L24 ${y + 4.6}Z`} fill={b} />
      </g>
    );
  })}
</svg>
