---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['assortiment', 'Assortiment'], ['showroom', 'Showroom'], ['planner', 'Tegelplanner'], ['werkwijze', 'Werkwijze'], ['reviews', 'Reviews'], ['bezoek', 'Bezoek']];
// Uit hun eigen (gearchiveerde) site.
const usp = ['Al sinds 1983', 'Leveren en aanbrengen', 'Vakkundige tegelzetters'];
---
<header class={thuis ? 'absolute inset-x-0 z-40' : 'relative z-40 bg-inkt'}>
  <div class="hidden border-b border-lijn lg:block">
    <div class="wrap flex h-11 items-center justify-between gap-6 text-[.9375rem] font-semibold text-wit/90">
      <ul class="flex gap-8">
        {usp.map((e) => <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-klei-licht" />{e}</li>)}
      </ul>
      <p class="flex gap-6"><a href={site.telHref} class="num text-wit/90 no-underline hover:text-klei-licht">{site.tel}</a><a href={`mailto:${site.mail}`} class="text-wit/90 no-underline hover:text-klei-licht">{site.mail}</a></p>
    </div>
  </div>
  <div class="wrap flex h-24 items-center justify-between gap-3 md:h-28 md:gap-6">
    <Merk />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-[1.0625rem] font-bold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-wit/90 no-underline transition-colors duration-200 hover:text-klei-licht">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={site.telHref} class="num hidden items-center gap-2 whitespace-nowrap font-bold text-wit no-underline hover:text-klei-licht 2xl:flex"><Icoon naam="tel" class="h-5 w-5 text-klei-licht" />{site.tel}</a>
      <a href={h('planner')} class="knop knop-klei hidden min-h-12 px-5 text-[1rem] md:inline-flex">Tegels aanvragen</a>
      <button type="button" class="grid h-12 w-12 place-items-center border border-wit/40 text-wit lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden bg-inkt lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn py-4 text-3xl font-[800] text-wit no-underline" style="font-family: var(--font-serif)">{t}</a></li>)}
      <li class="pt-6"><a href={site.telHref} class="num text-xl font-bold text-wit no-underline">{site.tel}</a></li>
      <li class="pt-3"><a href={waHoi} class="font-bold text-klei-licht no-underline">WhatsApp</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 bg-inkt shadow-[0_-4px_16px_#1f1c1a40] md:hidden">
  <a href={site.telHref} class="flex min-h-16 items-center justify-center gap-2.5 bg-klei text-[1.125rem] font-extrabold text-wit no-underline"><Icoon naam="tel" class="h-6 w-6" />Bellen</a>
  <a href={waHoi} class="flex min-h-16 items-center justify-center gap-2.5 text-[1.125rem] font-extrabold text-wit no-underline"><Icoon naam="wa" class="h-6 w-6 text-[#5fd68f]" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
