---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const aanbod = ['Wandtegels', 'Vloertegels', 'Natuursteen', 'Vloerverwarming', 'Tegelzetten', 'Tegelplanner'];
---
<footer class="voegen-donker bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Al sinds 1983 het vertrouwde adres voor wand- en vloertegels en natuursteen, op Goeree-Overflakkee.</p>
      <a href={site.telHref} class="knop knop-klei num mt-7 min-h-12 px-5"><Icoon naam="tel" />{site.tel}</a>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Aanbod</p>
      <ul class="mt-5 space-y-2.5">
        {aanbod.map((t) => <li><a href={h(t === 'Tegelplanner' ? 'planner' : 'assortiment')} class="no-underline transition-colors hover:text-klei-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Showroom</p>
      <ul class="mt-5 space-y-2.5">
        <li>{site.postcode} {site.plaats}</li>
        <li><a href={site.route} class="no-underline hover:text-klei-licht">Route via Google Maps</a></li>
        <li><a href={site.telHref} class="num no-underline hover:text-klei-licht">{site.tel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-klei-licht">{site.mail}</a></li>
        <li><a href={waHoi} class="inline-flex items-center gap-2 no-underline hover:text-klei-licht"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Openingstijden</p>
      <ul class="num mt-5 space-y-1.5">
        {tijden.map((t) => <li class="flex justify-between gap-4"><span>{t.dag}</span><span class="text-wit/90">{t.tekst}</span></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><a href={site.reviews} class="no-underline hover:text-wit">Google <span class="num">{site.google.score}</span>, {site.google.aantal} reviews</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Teksten van jullie vorige website (via het webarchief), eigen foto's van jullie Google-profiel. Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 15 oktober 2026).</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
