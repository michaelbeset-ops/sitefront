---
// Nagezet naar hun logo (bron/archief/logo.png): zwart vlak, schreefletter "Tegelhandel PEEMAN", "sinds1983" en een TP-monogram.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 no-underline ${donker ? 'text-inkt' : 'text-wit'}`} style="font-family: var(--font-serif)">
  <span class="grid h-12 w-12 flex-none place-items-center bg-inkt text-wit ring-1 ring-wit/35 sm:h-14 sm:w-14" aria-hidden="true">
    <span class="relative block h-8 w-7 sm:h-9 sm:w-8">
      <span class="absolute left-0 top-0 text-[1.9rem] font-[500] leading-none sm:text-[2.2rem]">T</span>
      <span class="absolute left-[.55rem] top-0 text-[1.9rem] font-[500] leading-none sm:left-[.65rem] sm:text-[2.2rem]">P</span>
    </span>
  </span>
  <span class="flex flex-col leading-none">
    <span class="text-[1.05rem] font-[600] sm:text-[1.15rem]">Tegelhandel</span>
    <span class="mt-0.5 text-[1.45rem] font-[700] uppercase tracking-[.01em] sm:text-[1.65rem]">Peeman</span>
    <span class="mt-1.5 text-[.68rem] font-[600] uppercase tracking-[.2em] opacity-85" style="font-family: var(--font-sans)">sinds 1983</span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>
