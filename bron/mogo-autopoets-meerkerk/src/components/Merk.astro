---
// Woordmerk nagemaakt naar hun logo: wit vlak met dunne staalblauwe "borstel"-lijntjes, zwart blok met MOGO,
// eronder "Autopoetsbedrijf" in een schreefletter.
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class:list={['merk', klein && 'scale-90 origin-left']}>
  <span class="merk-blok">
    <span class="merk-icoon" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="h-[1.375rem] w-[1.375rem]" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 21V6.5M8.5 21V6.5M5 6.5 4 4M5 6.5 6.6 3.8M8.5 6.5 7.4 4M8.5 6.5l1.6-2.7" />
        <path d="M15 21V5M18.5 21V8M15 9l-2-2M15 9l2-2.2M15 12.5l-1.8-1.6M15 12.5l1.9-1.7M18.5 8l-1.3-2.4M18.5 8l1.4-2.4" />
      </svg>
    </span>
    <span class="merk-naam">MOGO</span>
  </span>
  <span class="merk-sub">Autopoetsbedrijf</span>
</a>
