<script>
  // Projecten: tabs en foto's wisselen.
  const root = document.querySelector<HTMLElement>('[data-proj]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const kies = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const aan = x === t;
        x.setAttribute('aria-selected', String(aan));
        x.tabIndex = aan ? 0 : -1;
        const p = document.getElementById(x.getAttribute('aria-controls') || '');
        if (p) p.hidden = !aan;
      });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => kies(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          kies(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
        }
      });
    });
    root.querySelectorAll<HTMLElement>('[role=tabpanel]').forEach((p) => {
      const groot = [...p.querySelectorAll<HTMLElement>('[data-groot]')];
      const duimen = [...p.querySelectorAll<HTMLButtonElement>('[data-duim]')];
      duimen.forEach((d) => d.addEventListener('click', () => {
        const n = d.dataset.duim;
        groot.forEach((g) => (g.hidden = g.dataset.groot !== n));
        duimen.forEach((x) => x.setAttribute('aria-pressed', String(x === d)));
      }));
    });
  }

  // Contactformulier: maakt een WhatsApp-bericht, verstuurt zelf niets.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    const plaats = f.querySelector<HTMLElement>('[data-plaats]');
    f.addEventListener('change', () => { if (plaats) plaats.hidden = new FormData(f).get('waar') !== 'Op locatie'; });
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hoi MoGo, ik wil graag een afspraak maken.'];
      if (v('voertuig')) r.push('Voertuig: ' + v('voertuig') + (v('model') ? ` (${v('model')})` : ''));
      else if (v('model')) r.push('Voertuig: ' + v('model'));
      const wat = d.getAll('wat').map(String);
      if (wat.length) r.push('Graag: ' + wat.join(', ').toLowerCase());
      if (v('waar')) r.push('Waar: ' + v('waar') + (v('waar') === 'Op locatie' && v('plaats') ? ` in ${v('plaats')}` : ''));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31621980563?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

