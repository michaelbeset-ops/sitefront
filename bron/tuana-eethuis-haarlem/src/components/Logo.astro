---
// Woordmerk naar hun gevelbord: "Tuana" in saffraan, "Eethuis" in een paprikarood ovaal.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2 leading-none ${cls}`}>
  <span class="font-display text-2xl font-extrabold tracking-[0.04em] text-saffraan">TUANA</span>
  <span class="rounded-full bg-paprika px-2.5 py-1 font-body text-[0.6875rem] font-extrabold uppercase tracking-[0.14em] text-white">Eethuis</span>
</span>
