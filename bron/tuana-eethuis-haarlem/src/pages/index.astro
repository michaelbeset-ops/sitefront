---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Bestel from '../components/Bestel.astro';
import { Image } from 'astro:assets';
import { site, populair, wa } from '../data/site';
import pide from '../assets/pide.jpg';
import lahmacun from '../assets/lahmacun.jpg';
import durum from '../assets/durum.jpg';
import bakker from '../assets/bakker.jpg';
import lahmbord from '../assets/lahmbord.jpg';
import zaak from '../assets/zaak.jpg';
import simit from '../assets/simit.png';

const dagen = [
  { dag: 'Maandag', wd: 1, tijd: '09.00 - 20.00' },
  { dag: 'Dinsdag', wd: 2, tijd: '09.00 - 20.00' },
  { dag: 'Woensdag', wd: 3, tijd: '09.00 - 20.00' },
  { dag: 'Donderdag', wd: 4, tijd: '09.00 - 20.00' },
  { dag: 'Vrijdag', wd: 5, tijd: '09.00 - 20.00' },
  { dag: 'Zaterdag', wd: 6, tijd: '09.00 - 20.00' },
  { dag: 'Zondag', wd: 0, tijd: '11.00 - 20.00' },
];
const punten = [
  { kop: 'Turkse pizza', tekst: 'Het gerecht dat in de reviews het vaakst genoemd wordt, met de broodjes en de döner.' },
  { kop: 'Vers brood', tekst: 'Gasten noemen het verse brood van de bakker.' },
  { kop: 'Goede prijs', tekst: 'De prijs komt in veel reviews terug.' },
  { kop: 'Lieve eigenaar', tekst: 'Vriendelijk personeel en een snelle service.' },
  { kop: 'Met passie gemaakt', tekst: 'Zo omschrijven gasten het eten.' },
];
const pijl = '<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const bel = '<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>';
---
<Base title={`${site.naam} | Turkse pizza, döner en vers brood in Haarlem`} description="Tuana Eethuis, Schoterweg 28 in Haarlem. Turkse pizza, döner, kapsalon, broodjes en vers brood. Bestel via WhatsApp en haal het op. 4,7 op Google.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative overflow-x-clip bg-oven text-deeg">
      <div class="wrap grid gap-10 pt-5 lg:grid-cols-12 lg:gap-12 lg:pt-12">
        <div class="lg:col-span-6 lg:pb-20">
          <p class="eyebrow text-saffraan">Tuana Eethuis, Schoterweg Haarlem</p>
          <h1 class="mt-4 text-4xl">Vers brood, Turkse pizza <em class="font-semibold text-saffraan">en döner</em></h1>
          <p class="mt-6 max-w-lg text-lg text-deeg/85">Stel uw bestelling samen, stuur hem via WhatsApp en haal hem op aan de Schoterweg.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#bestellen" class="btn btn-wa text-lg"><Fragment set:html={wa} />Bestel via WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-deeg"><Fragment set:html={bel} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <div class="mt-8 grid gap-5 border-t border-lijn-licht pt-6 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-8">
            <dl>
              <dt class="text-sm text-deeg/75">Google</dt>
              <dd class="mt-1 flex items-baseline gap-2 font-display text-[3.25rem] font-bold leading-none">{site.google.score}<span class="font-body text-sm font-normal text-deeg/75">uit {site.google.aantal} reviews</span></dd>
            </dl>
            <Status />
          </div>
        </div>
        <div class="relative order-first lg:order-none lg:col-span-6">
          <figure class="relative overflow-hidden rounded-2xl shadow-xl lg:absolute lg:inset-x-0 lg:top-0 lg:-bottom-28 lg:z-10">
            <div class="aspect-[16/11] sm:aspect-[16/10] lg:aspect-auto lg:h-full">
              <Foto src={pide} alt="Sfeerbeeld: pide met gehakt, paprika en tomaat, in stukken gesneden op een bord" class="object-[center_40%]" hero sizes="(min-width: 1024px) 600px, 100vw" />
            </div>
            <figcaption class="absolute right-4 top-4 rounded-lg bg-oven/85 px-3 py-1.5 text-xs font-semibold text-deeg backdrop-blur-sm">Pide</figcaption>
          </figure>
          <figure class="absolute -bottom-8 right-3 z-20 w-28 rotate-[-3deg] overflow-hidden rounded-xl border-4 border-meel bg-meel shadow-xl sm:w-40 lg:-left-14 lg:bottom-auto lg:right-auto lg:top-72 lg:w-52">
            <Image src={zaak} alt="Onze zaak aan de Schoterweg: gevel met het geel-rode Tuana Eethuis-bord" widths={[240, 420]} sizes="210px" format="webp" quality={72} class="block aspect-[4/5] w-full object-cover object-top" />
            <figcaption class="px-1 py-1 text-center text-[0.6875rem] font-bold text-inkt sm:py-1.5 sm:text-xs">Schoterweg 28</figcaption>
          </figure>
        </div>
      </div>
      <div class="h-12 lg:h-0" aria-hidden="true"></div>
    </section>

    <!-- POPULAIR -->
    <section id="populair" class="licht scroll-mt-16 bg-meel pb-16 pt-14 lg:pb-24 lg:pt-44" aria-labelledby="popkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-paprika">Populair bij gasten</p>
          <h2 id="popkop" class="mt-3 text-3xl">Wat gasten het vaakst noemen</h2>
          <p class="mt-4 max-w-md text-inkt-zacht">Op volgorde van hoe vaak het in de Google-reviews genoemd wordt.</p>
          <p class="mt-3 text-xs text-inkt-zacht">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
        </div>
        <ol class="grid gap-x-8 sm:grid-cols-2 lg:col-span-7">
          {populair.map((g, i) => (
            <li class="flex items-baseline gap-4 border-b border-lijn py-4">
              <span class="w-7 shrink-0 font-display text-lg font-semibold italic tabular-nums text-paprika">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display text-2xl font-semibold">{g}</span>
            </li>
          ))}
          <li class="flex items-baseline gap-4 border-b border-lijn py-4">
            <span class="w-7 shrink-0 font-display text-lg font-semibold italic text-paprika" aria-hidden="true">+</span>
            <span class="font-display text-2xl font-semibold">Vers brood</span>
          </li>
        </ol>
      </div>
      <div class="wrap mt-12 grid gap-4 sm:grid-cols-2 md:grid-cols-12 md:gap-5 lg:mt-16">
        <figure class="relative overflow-hidden rounded-xl shadow-sm sm:col-span-2 md:col-span-7">
          <div class="aspect-[4/3] md:aspect-auto md:h-full md:min-h-[30rem]"><Foto src={lahmacun} alt="Sfeerbeeld: dunne Turkse pizza met gekruid gehakt op een bord" sizes="(min-width: 768px) 60vw, 100vw" /></div>
          <figcaption class="absolute bottom-4 left-4 rounded-lg bg-oven/85 px-3 py-1.5 text-sm font-semibold text-deeg backdrop-blur-sm">Turkse pizza</figcaption>
        </figure>
        <div class="grid gap-4 md:col-span-5 md:gap-5 sm:col-span-2 sm:grid-cols-2 md:grid-cols-1">
          <figure class="relative overflow-hidden rounded-xl shadow-sm">
            <div class="aspect-[3/2] md:aspect-auto md:h-full"><Foto src={durum} alt="Sfeerbeeld: opgerolde wrap in folie met patat en ingelegde pepers" sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <figcaption class="absolute bottom-4 left-4 rounded-lg bg-oven/85 px-3 py-1.5 text-sm font-semibold text-deeg backdrop-blur-sm">Döner en patat</figcaption>
          </figure>
          <figure class="relative overflow-hidden rounded-xl shadow-sm">
            <div class="aspect-[3/2] md:aspect-auto md:h-full"><Foto src={lahmbord} alt="Sfeerbeeld: Turkse pizza's met salade, citroen en patat op een metalen schaal" sizes="(min-width: 768px) 40vw, 100vw" /></div>
          </figure>
        </div>
      </div>
    </section>

    <!-- VERS BROOD -->
    <section class="bg-oven-2 py-16 text-deeg lg:py-24" aria-labelledby="broodkop">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="relative lg:col-span-7">
          <figure class="overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[4/3]"><Foto src={bakker} alt="Sfeerbeeld: bakker legt versgebakken pide's uit de steenoven op een marmeren werkblad" sizes="(min-width: 1024px) 700px, 100vw" /></div>
          </figure>
        </div>
        <div class="lg:col-span-5">
          <p class="eyebrow text-saffraan">Van de bakker</p>
          <h2 id="broodkop" class="mt-3 text-3xl">Vers brood van de bakker</h2>
          <p class="mt-5 text-lg text-deeg/85">In de reviews komt het steeds terug: het verse brood. Tuana is eethuis en bakker in één.</p>
          <figure class="mt-8 flex items-center gap-5">
            <div class="w-32 shrink-0 overflow-hidden rounded-xl border-4 border-oven-3 shadow-sm sm:w-40">
              <Image src={simit} alt="Simit, sesambroodringen, aan een stang in de zaak" widths={[160, 320]} sizes="160px" format="webp" quality={72} class="block aspect-square w-full object-cover" />
            </div>
            <figcaption class="text-sm text-deeg/80">Simit aan de stang. Foto van het eigen Google-profiel.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- BESTELLEN (wow) -->
    <section id="bestellen" class="scroll-mt-16 bg-oven py-16 text-deeg lg:py-24" aria-labelledby="bestelkop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-saffraan">Bestel via WhatsApp</p>
            <h2 id="bestelkop" class="mt-3 text-3xl">Stel uw bestelling samen en haal hem op</h2>
          </div>
          <p class="text-lg text-deeg/85 lg:col-span-5">Kies uw gerechten, het aantal en de ophaaltijd. Daarna opent WhatsApp met uw bestelling als bericht.</p>
        </div>
        <div class="mt-10"><Bestel /></div>
      </div>
    </section>

    <!-- WAT KLANTEN NOEMEN -->
    <section class="licht bg-deeg py-16 lg:py-24" aria-labelledby="klantkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-paprika">Samengevat uit de reviews</p>
          <h2 id="klantkop" class="mt-3 text-3xl">Wat klanten noemen</h2>
          <div class="mt-8 flex items-end gap-4">
            <span class="font-display text-[4.5rem] font-bold leading-none text-inkt">{site.google.score}</span>
            <span class="pb-2">
              <span class="flex gap-0.5 text-paprika" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor"><path d="m10 1.5 2.6 5.5 6 .7-4.4 4.1 1.1 6L10 14.9 4.7 17.8l1.1-6L1.4 7.7l6-.7z"/></svg>)}</span>
              <span class="mt-1 block text-sm text-inkt-zacht">uit {site.google.aantal} reviews op Google</span>
            </span>
          </div>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
          {punten.map((p) => (
            <li class="rounded-xl bg-meel p-6 shadow-sm ring-1 ring-lijn">
              <h3 class="text-xl">{p.kop}</h3>
              <p class="mt-2 text-inkt-zacht">{p.tekst}</p>
            </li>
          ))}
          <li class="flex flex-col justify-between rounded-xl bg-paprika p-6 text-white shadow-sm">
            <p class="font-display text-xl font-semibold leading-snug">Zin gekregen?</p>
            <a href="#bestellen" class="mt-4 inline-flex items-center gap-2 font-bold underline underline-offset-4">Stel uw bestelling samen <Fragment set:html={pijl} /></a>
          </li>
        </ul>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="licht scroll-mt-16 bg-meel py-16 lg:py-24" aria-labelledby="contactkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <p class="eyebrow text-paprika">Openingstijden en route</p>
          <h2 id="contactkop" class="mt-3 text-3xl">Aan de Schoterweg in Haarlem</h2>
          <div class="mt-8 grid gap-8 sm:grid-cols-2">
            <div>
              <address class="not-italic text-lg">
                <strong class="font-display text-2xl font-semibold">{site.naam}</strong><br />
                {site.straat}<br />{site.postcode} {site.plaats}
              </address>
              <p class="mt-3"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline-offset-4 hover:underline">T {site.tel}</a></p>
              <div class="mt-6 flex flex-col gap-3">
                <a href={site.whatsapp} class="btn btn-wa"><Fragment set:html={wa} />Stuur een WhatsApp</a>
                <a href={site.telHref} class="btn btn-lijn text-inkt hover:!bg-oven hover:!text-deeg hover:!shadow-none"><Fragment set:html={bel} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
                <a href={site.maps} class="btn btn-paprika">Route plannen <Fragment set:html={pijl} /></a>
              </div>
            </div>
            <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-lijn">
              <h3 class="text-xl">Openingstijden</h3>
              <table class="mt-3 w-full text-left">
                <caption class="sr-only">Openingstijden per dag</caption>
                <tbody>
                  {dagen.map((d) => (
                    <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                      <th scope="row" class="py-2.5 font-semibold">{d.dag}</th>
                      <td class="whitespace-nowrap py-2.5 text-right tabular-nums">{d.tijd}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <figure class="lg:col-span-5">
          <div class="overflow-hidden rounded-2xl shadow-xl">
            <Image src={zaak} alt="Onze zaak aan de Schoterweg 28: etalage en open deur onder het Tuana Eethuis-bord" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 460px, 100vw" format="webp" quality={70} loading="lazy" class="block aspect-[4/5] w-full object-cover object-top" />
          </div>
          <figcaption class="mt-3 text-sm text-inkt-zacht">Herkenbaar aan het geel-rode bord.</figcaption>
        </figure>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-paprika); font-weight: 700; }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  import { nuInHaarlem } from '../scripts/open';
  document.querySelector(`.dagrij[data-wd="${nuInHaarlem().wd}"]`)?.classList.add('vandaag');
</script>
