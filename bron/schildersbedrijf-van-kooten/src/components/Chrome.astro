---
import { site, url } from '../data/site';
import WaIcon from './WaIcon.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="flex flex-col leading-none no-underline">
        <span class="font-display text-xl font-extrabold tracking-[-0.04em] text-petrol">van Kooten</span>
        <span class="mt-1 text-xs font-medium tracking-wide text-ink-soft">schildersbedrijf</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-medium">
          <li><a href={url('#schilderwerk')} class="no-underline hover:text-petrol">Schilderwerk</a></li>
          <li><a href={url('#project')} class="no-underline hover:text-petrol">Zakelijk</a></li>
          <li><a href={url('#werkgebied')} class="no-underline hover:text-petrol">Werkgebied</a></li>
          <li><a href={url('#offerte')} class="no-underline hover:text-petrol">Offerte</a></li>
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a href={site.telHref} class="btn btn-line-ink hidden !px-4 !py-2 text-sm shadow-[inset_0_0_0_2px_var(--color-line)] sm:inline-flex">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
        <a href={site.whatsapp} class="btn btn-petrol !px-3.5 !py-2 text-sm"><WaIcon />WhatsApp</a>
      </div>
    </div>
  </header>
) : (
  <footer class="op-donker bg-ink py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}<br />{site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:col-span-4"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a><br /><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
