---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import WaIcon from '../components/WaIcon.astro';
import { site, werkgebied } from '../data/site';
import hero from '../assets/hero.jpg';
import roller from '../assets/roller.jpg';
import kleuren from '../assets/kleuren.jpg';
import gereedschap from '../assets/gereedschap.jpg';

const binnen = [
  { wat: 'Muren', noot: '' },
  { wat: 'Plafonds', noot: '' },
  { wat: 'Deuren', noot: '' },
  { wat: 'Kozijnen', noot: 'ook na een renovatie' },
];
---
<Base
  title="Schildersbedrijf J. van Kooten | Schilderwerk binnen en buiten in Dordrecht"
  description="Binnen- en buitenschilderwerk voor particulieren en bedrijven in Dordrecht, Zwijndrecht, Papendrecht, Sliedrecht en omgeving. 5,0 op Google. Stuur een WhatsApp of bel 06 10 23 17 95."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: foto van een schilder op de ladder, tekst links op een egale inktlaag (mobiel) of een verloop (desktop). -->
    <section class="op-donker relative isolate overflow-hidden bg-ink text-white">
      <div class="absolute inset-0 -z-10 lg:left-1/2 xl:left-[38%] [&_img]:object-[40%_50%]"><Foto src={hero} alt="Schilder op een ladder die een witte gevel bijwerkt, onder een blauwe lucht" hero sizes="100vw" /></div>
      <div class="absolute inset-0 -z-10 bg-ink/75 lg:bg-transparent lg:bg-[linear-gradient(90deg,#13222a_0%,#13222a_50%,#13222acc_56%,#13222a00_70%)] xl:bg-[linear-gradient(90deg,#13222a_0%,#13222a_38%,#13222acc_46%,#13222a00_62%)]"></div>
      <div class="wrap py-16 sm:py-20 lg:py-32">
        <div class="max-w-2xl lg:max-w-xl xl:max-w-2xl">
          <p class="text-sm font-medium tracking-wide text-white/90">Dordrecht en omgeving</p>
          <h1 class="mt-4 text-4xl">Schilderwerk, binnen en <span class="streek text-white">buiten</span></h1>
          <p class="mt-6 max-w-xl text-lg text-white/90">Muren, plafonds, deuren en kozijnen, en de buitenkant van uw huis. Voor particulieren, en ook voor bedrijven en instellingen.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.whatsapp} class="btn btn-signal"><WaIcon />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
          <p class="mt-8 flex flex-wrap gap-x-5 gap-y-1 text-sm text-white/90">
            <span><strong class="font-display text-white">5,0</strong> op Google, 11 reviews</span>
            <span>ma t/m vr <span class="whitespace-nowrap tabular-nums">07:00 tot 18:00</span></span>
          </p>
        </div>
      </div>
    </section>

    <!-- Schilderwerk: twee genummerde lijsten naast een staande foto. -->
    <section id="schilderwerk" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <h2 class="max-w-lg text-3xl">Wat we voor u schilderen</h2>
          <div class="mt-10 grid gap-10 sm:grid-cols-2">
            <div>
              <h3 class="flex items-baseline gap-3 text-xl"><span class="font-display text-sm font-bold text-petrol">01</span>Binnen</h3>
              <ul class="mt-4 divide-y divide-line border-y border-line">
                {binnen.map((b) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-3 py-3">
                    <span class="font-display text-lg font-semibold">{b.wat}</span>
                    {b.noot && <span class="text-sm text-ink-soft">{b.noot}</span>}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="flex items-baseline gap-3 text-xl"><span class="font-display text-sm font-bold text-petrol">02</span>Buiten</h3>
              <ul class="mt-4 divide-y divide-line border-y border-line">
                <li class="py-3"><span class="font-display text-lg font-semibold">De buitenkant van uw huis</span></li>
              </ul>
              <p class="mt-3 text-xs text-ink-soft">[[AANLEVEREN: welk buitenwerk precies, bijvoorbeeld kozijnen, gevels, boeidelen]]</p>
            </div>
          </div>
          <p class="mt-10 max-w-xl text-ink-soft">Uit de reviews blijkt dat klanten ons terugvragen voor een volgende klus. Op Google staan we op <strong class="text-ink">5,0 uit 5</strong> (11 reviews), op Facebook beveelt <strong class="text-ink">94%</strong> ons aan.</p>
        </div>
        <div class="lg:col-span-5">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[4/5]"><Foto src={roller} alt="Hand met een verfroller die een muur wit schildert, half geverfd" sizes="(min-width: 1024px) 460px, 100vw" /></div>
        </div>
      </div>
    </section>

    <!-- Uitgelicht project: het grote getal met een verfstreep, tekst ernaast. -->
    <section id="project" class="op-donker scroll-mt-20 bg-petrol-deep py-16 text-white lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="text-sm font-medium tracking-wide text-white/90">Zakelijk project, Gemeente Dordrecht</p>
          <p class="mt-4 font-display text-5xl font-extrabold leading-none tracking-[-0.05em] whitespace-nowrap tabular-nums">4.000 m²</p>
          <span class="streep mt-4" aria-hidden="true"></span>
          <p class="mt-3 text-sm text-white/80">wanden, opgeleverd in september 2026</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <h2 class="text-3xl">Wanden die tegen een stootje kunnen</h2>
          <div class="mt-6 space-y-4 text-lg text-white/90">
            <p>Voor de Gemeente Dordrecht hebben we 4.000 m² aan wanden afgewerkt met een vloercoating. Daardoor zijn ze extra slijtvast en bestand tegen intensief gebruik en beschadigingen, en blijven ze langer netjes.</p>
            <p>Daarnaast hebben we de geperforeerde platen gelakt, voor een strakke afwerking.</p>
          </div>
          <p class="mt-8"><a href={site.whatsapp} class="font-display font-bold underline decoration-signal decoration-2 underline-offset-4">Ook iets voor uw bedrijf? Stuur een WhatsApp</a></p>
        </div>
      </div>
    </section>

    <!-- Werkgebied en tijden: foto links, plaatsnamen als grote lopende tekst rechts. -->
    <section id="werkgebied" class="scroll-mt-20 bg-kalk py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="order-2 lg:order-1 lg:col-span-5">
          <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm lg:aspect-[4/5]"><Foto src={gereedschap} alt="Kwasten met verfresten in een bak naast een verfblik, op een schap" sizes="(min-width: 1024px) 460px, 100vw" /></div>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-6 lg:col-start-7">
          <h2 class="text-3xl">Werkgebied</h2>
          <ul class="mt-6 flex flex-wrap gap-x-2 gap-y-1 font-display text-xl font-bold leading-snug sm:text-2xl">
            {werkgebied.map((p, i) => (
              <li>{p}{i < werkgebied.length - 1 && <span class="ml-2 font-normal text-petrol" aria-hidden="true">/</span>}</li>
            ))}
          </ul>
          <dl class="mt-10 grid gap-4 border-t border-line pt-6 sm:grid-cols-2">
            <div><dt class="text-sm text-ink-soft">Maandag t/m vrijdag</dt><dd class="font-display text-lg font-bold whitespace-nowrap tabular-nums">07:00 tot 18:00</dd></div>
            <div><dt class="text-sm text-ink-soft">Zaterdag en zondag</dt><dd class="font-display text-lg font-bold">Gesloten</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Offerte: snel contact links, klein formulier rechts. -->
    <section id="offerte" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Offerte aanvragen</h2>
          <p class="mt-5 text-lg text-ink-soft">Stuur een WhatsApp of bel met wat er geschilderd moet worden. Liever eerst iets opschrijven? Vul dan het formulier in.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:flex-col lg:items-start">
            <a href={site.whatsapp} class="btn btn-petrol"><WaIcon />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line btn-line-ink">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
          <p class="mt-6 text-ink-soft">Of mail naar <a href={`mailto:${site.mail}`} class="break-all text-ink underline decoration-petrol decoration-2 underline-offset-4">{site.mail}</a></p>
          <p class="mt-4 text-xs text-ink-soft">[[AANLEVEREN: hoe een offerte verloopt, bijvoorbeeld langskomen om op te nemen, en of die vrijblijvend is]]</p>
          <div class="mt-10 hidden aspect-[3/2] overflow-hidden rounded-xl shadow-sm lg:block"><Foto src={kleuren} alt="Kleurenwaaier met een platte kwast en een verfroller op een houten tafel" sizes="460px" /></div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <form class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line md:p-8" action="#" method="post" onsubmit="return false">
            <div class="grid gap-5 sm:grid-cols-2">
              <div><label for="naam" class="text-sm font-medium">Naam</label><input id="naam" name="naam" autocomplete="name" class="veld mt-1.5" /></div>
              <div><label for="telefoon" class="text-sm font-medium">Telefoon</label><input id="telefoon" name="telefoon" type="tel" autocomplete="tel" class="veld mt-1.5" /></div>
              <div><label for="plaats" class="text-sm font-medium">Plaats</label><input id="plaats" name="plaats" autocomplete="address-level2" class="veld mt-1.5" /></div>
              <div><label for="soort" class="text-sm font-medium">Soort werk</label>
                <select id="soort" name="soort" class="veld mt-1.5">
                  <option>Binnen</option>
                  <option>Buiten</option>
                  <option>Binnen en buiten</option>
                  <option>Zakelijk</option>
                </select>
              </div>
              <div class="sm:col-span-2"><label for="bericht" class="text-sm font-medium">Wat moet er geschilderd worden?</label><textarea id="bericht" name="bericht" rows="4" class="veld mt-1.5"></textarea></div>
            </div>
            {site.voorstel ? (
              <p class="mt-6 rounded-xl bg-kalk p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap font-bold underline">{site.tel}</a>, stuur een <a href={site.whatsapp} class="font-bold underline">WhatsApp</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all font-bold underline">{site.mail}</a>.</p>
            ) : (
              <button type="submit" class="btn btn-petrol mt-6">Offerte aanvragen</button>
            )}
          </form>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
