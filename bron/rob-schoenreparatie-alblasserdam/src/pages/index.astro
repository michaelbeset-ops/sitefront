---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, tijden, waHallo } from '../data/site';
import sleutels from '../assets/sleutels-hero.jpg';
import sleutel from '../assets/sleutel.jpg';
import pak from '../assets/pak.jpg';
import schoen from '../assets/schoen.jpg';

const vakken = [
  { t: 'Schoenreparatie', d: 'Breng uw schoenen langs. Rob ziet meteen wat haalbaar is, in tijd en in kosten.', a: 'de reparaties die u het meest doet' },
  { t: 'Sleutelservice', d: 'Sleutels laten bijmaken doet u aan dezelfde balie.', a: 'welke sleutels u bijmaakt' },
  { t: 'Stomerij', d: 'Kleding brengen en weer ophalen, gewoon in Makado.', a: 'stomerijdiensten en levertijd' },
];
---
<Base title={`${site.naam}: schoenen, sleutels en stomerij | Alblasserdam`} description="Schoenreparatie, sleutelservice en stomerij bij Rob in Makado Winkelcentrum, Alblasserdam. Stuur een WhatsApp naar 06 12 00 13 30.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Eerste scherm: volle hoogte, sleutels op zwart -->
    <section class="donker relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={sleutels} alt="" widths={[640, 960, 1440, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_50%]" />
      <div class="absolute inset-0 -z-10 bg-nacht/70 md:bg-transparent md:[background:linear-gradient(90deg,#0c1013f2_0%,#0c1013d9_34%,#0c101366_62%,#0c101333_100%)]" aria-hidden="true"></div>
      <div class="wrap grid gap-y-12 pb-12 pt-36 md:grid-cols-12 md:gap-x-8 md:pb-16 lg:pb-20">
        <div class="md:col-span-11 lg:col-span-10">
          <h1 id="t-hero" class="max-w-[15em] text-4xl">Schoenen, sleutels en stomerij.<span class="block text-licht-zacht">Bij Rob in Makado.</span></h1>
          <p class="mt-8 max-w-[29rem] text-licht-zacht">Eén balie in Makado Winkelcentrum, Alblasserdam. Stuur Rob een appje met een foto, of loop gewoon even langs.</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-9 gap-y-5">
            <a href={waHallo} class="knop knop-vol">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"/></svg>
              Stuur Rob een WhatsApp
            </a>
            <a href="#tijden" class="lijn text-sm">Openingstijden</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Drie vakken, één balie -->
    <section id="balie" aria-labelledby="t-balie">
      <div class="wrap grid gap-y-14 py-24 md:grid-cols-12 md:gap-x-8 lg:py-40">
        <div class="rijs md:col-span-5 md:sticky md:top-12 md:self-start">
          <h2 id="t-balie" class="text-3xl">Drie vakken, één balie.</h2>
          <p class="mt-7 max-w-sm text-grijs">Schoenen, sleutels en kleding kunt u in één keer kwijt, midden in het winkelcentrum.</p>
        </div>
        <ul class="md:col-span-7 lg:col-span-6 lg:col-start-7">
          {vakken.map((v, i) => (
            <li class="rijs border-t border-lijn py-10 first:border-t-0 first:pt-0 md:first:pt-3" style={`--d:${i * 0.06}s`}>
              <h3 class="text-2xl">{v.t}</h3>
              <p class="mt-4 max-w-md text-grijs">{v.d}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="wrap grid gap-y-6 pb-24 md:grid-cols-12 md:gap-x-8 lg:pb-40">
        <figure class="rijs md:col-span-7">
          <Image src={sleutel} alt="Een ongeslepen sleutel op een donkere, glanzende ondergrond" widths={[640, 960, 1280]} sizes="(min-width: 768px) 55vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="ui mt-4 text-grijs">Sleutelservice</figcaption>
        </figure>
        <figure class="rijs md:col-span-5 md:mt-40" style="--d:.08s">
          <Image src={pak} alt="Gereinigde kleding in plastic hoezen aan een rek" widths={[480, 720, 960]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[4/5] w-full object-cover object-[30%_50%]" />
          <figcaption class="ui mt-4 text-grijs">Stomerij</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. Over Rob -->
    <section id="rob" class="donker bg-nacht text-licht" aria-labelledby="t-rob">
      <div class="grid md:grid-cols-2">
        <figure class="relative min-h-[22rem] md:min-h-[44rem]">
          <Image src={schoen} alt="Close-up van een bruine leren veterschoen" widths={[640, 960, 1440]} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
        </figure>
        <div class="flex items-center px-5 py-24 md:px-10 lg:px-20 lg:py-36">
          <div class="max-w-[34rem]">
            <h2 id="t-rob" class="rijs text-3xl">Eerlijk over wat nog loont.</h2>
            <div class="rijs mt-8 space-y-5 text-licht-zacht" style="--d:.05s">
              <p>ROB is een eenmanszaak: Rob doet het werk zelf en maakt af waar hij mee bezig is. Is een reparatie de moeite niet meer waard, dan zegt hij dat gewoon.</p>
              <p>Klanten noemen hem een vakman die meedenkt in oplossingen, snel werkt tegen een schappelijke prijs en altijd in is voor een praatje.</p>
            </div>
            <p class="rijs mt-10 border-t border-lijn-licht pt-6 text-sm text-licht-zacht" style="--d:.1s"><span class="num text-licht">{site.google.score}</span> op Google, uit <span class="num">{site.google.aantal}</span> reviews</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Openingstijden en een vraag via WhatsApp -->
    <section id="tijden" aria-labelledby="t-tijden">
      <div class="wrap grid gap-y-20 py-24 md:grid-cols-12 md:gap-x-8 lg:py-40">
        <div class="md:col-span-6 lg:col-span-5">
          <h2 id="t-tijden" class="rijs text-2xl">Openingstijden</h2>
          <p class="rijs mt-6 min-h-[1.6em] text-grijs" data-status aria-live="polite"></p>
          <table class="rijs mt-8 w-full text-left">
            <caption class="sr-only">Openingstijden per dag</caption>
            <tbody>
              {tijden.map((t) => (
                <tr class="border-b border-lijn" data-dag={t.d}>
                  <th scope="row" class="py-4 pr-6 font-normal">{t.dag}</th>
                  <td class="num whitespace-nowrap py-4 text-right">
                    {t.blokken.length ? t.blokken.map(([a, b]) => <span class="block">{a} tot {b}</span>) : <span class="text-grijs">Gesloten</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-5 text-xs text-grijs">Tijden zoals op Google.</p>
        </div>

        <form class="rijs md:col-span-6 md:col-start-7 lg:col-span-6 lg:col-start-7" data-wa style="--d:.06s" aria-labelledby="t-vraag">
          <h3 id="t-vraag" class="text-2xl">Eerst even vragen?</h3>
          <p class="mt-4 max-w-md text-grijs">Kies waar het over gaat en zet er kort bij wat u wilt weten. WhatsApp opent met uw bericht klaar; een foto stuurt u daar mee.</p>
          <fieldset class="mt-9">
            <legend class="ui text-grijs">Het gaat over</legend>
            <div class="keus mt-4 grid grid-cols-3 border border-inkt">
              <label><input type="radio" name="over" value="schoenreparatie" checked /><span>Schoenen</span></label>
              <label><input type="radio" name="over" value="een sleutel" /><span>Sleutels</span></label>
              <label><input type="radio" name="over" value="de stomerij" /><span>Stomerij</span></label>
            </div>
          </fieldset>
          <label class="veld mt-8 block"><span class="ui text-grijs">Uw vraag</span>
            <textarea name="vraag" rows="3" placeholder="Bijvoorbeeld: wat kost het en wanneer is het klaar?"></textarea>
          </label>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={waHallo} class="knop knop-vol" data-wa-knop>Open in WhatsApp</a>
            <a href={site.telHref} class="lijn num text-sm">Of bel {site.tel}</a>
          </div>
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { tijden } from '../data/site';
  // Status van vandaag, in Nederlandse tijd.
  const el = document.querySelector<HTMLElement>('[data-status]');
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const d = nu.getDay(), m = nu.getHours() * 60 + nu.getMinutes();
  const min = (s: string) => +s.slice(0, 2) * 60 + +s.slice(3);
  document.querySelector(`tr[data-dag="${d}"]`)?.classList.add('vandaag');
  if (el) {
    const vandaag = tijden.find((t) => t.d === d)!;
    const open = vandaag.blokken.find(([a, b]) => m >= min(a) && m < min(b));
    if (open) el.textContent = `Nu open, tot ${open[1]}.`;
    else {
      const later = vandaag.blokken.find(([a]) => min(a) > m);
      if (later) el.textContent = `Nu gesloten. Vandaag weer open om ${later[0]}.`;
      else for (let i = 1; i <= 7; i++) {
        const t = tijden.find((x) => x.d === (d + i) % 7)!;
        if (t.blokken.length) { el.textContent = `Nu gesloten. ${i === 1 ? 'Morgen' : t.dag} weer open om ${t.blokken[0][0]}.`; break; }
      }
    }
  }

  // WhatsApp-bericht samenstellen.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const k = document.querySelector<HTMLAnchorElement>('[data-wa-knop]');
  if (f && k) {
    const basis = k.href.split('?')[0];
    const bouw = () => {
      const fd = new FormData(f);
      const r = [`Hallo Rob, ik heb een vraag over ${fd.get('over')}.`];
      const v = String(fd.get('vraag') || '').trim();
      if (v) r.push(v);
      k.href = basis + '?text=' + encodeURIComponent(r.join('\n'));
    };
    bouw();
    f.addEventListener('input', bouw);
    f.addEventListener('change', bouw);
    f.addEventListener('submit', (e) => { e.preventDefault(); bouw(); k.click(); });
  }
</script>

<style>
  .keus label { position: relative; display: block; cursor: pointer; }
  .keus label + label { border-left: 1px solid var(--color-inkt); }
  .keus input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .keus span { display: flex; align-items: center; justify-content: center; min-height: 3.25rem; padding: 0 .5rem; font-size: var(--text-sm); transition: background-color .35s var(--ease-zacht), color .35s var(--ease-zacht); }
  .keus input:checked + span { background: var(--color-inkt); color: var(--color-papier); }
  .keus label:hover input:not(:checked) + span { background: var(--color-vlak); }
  .keus input:focus-visible + span { outline: 2px solid var(--color-staal); outline-offset: -5px; }
  .veld textarea { display: block; width: 100%; margin-top: .5rem; padding: .6rem 0; background: transparent; color: inherit; border: 0; border-bottom: 1px solid var(--color-inkt); border-radius: 0; font: inherit; resize: vertical; }
  .veld textarea::placeholder { color: #565d64b3; }
  .veld textarea:focus { outline: none; border-bottom-color: var(--color-staal); box-shadow: 0 1px 0 var(--color-staal); }
  :global(tr.vandaag th), :global(tr.vandaag td) { font-weight: 600; color: var(--color-staal); }
</style>
