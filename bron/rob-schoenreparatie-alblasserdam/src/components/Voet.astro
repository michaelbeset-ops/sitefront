---
import { site, url, tijden, blokTekst, waHallo } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <b>ROB</b><small><span>Schoenreparatie</span><span class="text-amber">Sleutels &amp; stomerij</span></small>
      </a>
      <p class="mt-6 max-w-xs">Schoenreparatie, sleutelservice en stomerij aan één balie in {site.plek}, Alblasserdam.</p>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {['Schoenreparatie', 'Sleutels bijmaken', 'Stomerij'].map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-amber">{c}</a></li>)}
        <li><a href={h('werkwijze')} class="no-underline transition-colors hover:text-amber">Werkwijze</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-amber">{site.tel}</a></li>
        <li><a href={waHallo} class="no-underline transition-colors hover:text-amber">WhatsApp</a></li>
        <li>{site.plek}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.maps} class="no-underline transition-colors hover:text-amber">Route plannen</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Openingstijden</p>
      <table class="mt-4 w-full max-w-[17rem]">
        <caption class="sr-only">Openingstijden</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.d} class="align-top data-[vandaag]:font-semibold data-[vandaag]:text-amber">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.kort}</th>
              <td class="num py-0.5 text-right">{t.blokken.length ? t.blokken.map((b) => <span class="block">{blokTekst([b])}</span>) : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.volledig}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-amber">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Sfeerfoto’s via Unsplash, ter illustratie: uw Google-profiel heeft nog geen eigen foto’s. Reviews letterlijk van Google (stand 2 oktober 2026).</p>}
  </div>
</footer>
