---
import { site, url, waHallo } from '../data/site';
---
<footer id="contact" class="donker bg-nacht text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-y-14 pb-16 pt-24 md:grid-cols-12 md:gap-x-8 lg:pb-24 lg:pt-36">
    <div class="rijs md:col-span-7">
      <h2 id="t-contact" class="text-3xl">Loop even langs in Makado.</h2>
      <div class="mt-10 flex flex-wrap items-center gap-x-9 gap-y-5">
        <a href={waHallo} class="knop knop-vol">Stuur Rob een WhatsApp</a>
        <a href={site.telHref} class="lijn num text-sm">Bel {site.tel}</a>
      </div>
    </div>

    <div class="grid gap-10 border-t border-lijn-licht pt-12 text-sm sm:grid-cols-3 md:col-span-12">
      <div>
        <p class="ui text-licht-zacht">Adres</p>
        <p class="mt-4">{site.plek}<br />{site.postcode} {site.plaats}</p>
        <a href={site.maps} class="lijn mt-4 inline-block">Route in Google Maps</a>
      </div>
      <div>
        <p class="ui text-licht-zacht">Contact</p>
        <p class="mt-4 space-y-1">
          <a href={waHallo} class="lijn-in block w-fit">WhatsApp</a>
          <a href={site.telHref} class="lijn-in num block w-fit">{site.tel}</a>
        </p>
      </div>
      <div>
        <p class="ui text-licht-zacht">Open</p>
        <p class="mt-4">Ma, di, do, vr en za.<br />Woensdag en zondag gesloten.</p>
        <a href={url('#tijden')} class="lijn mt-4 inline-block">Alle tijden</a>
      </div>
    </div>
  </div>

  <div class="wrap overflow-hidden" aria-hidden="true">
    <svg class="voetmerk" viewBox="0 0 1000 300" role="presentation" focusable="false"><text x="500" y="262" text-anchor="middle" textLength="1000" lengthAdjust="spacingAndGlyphs">ROB</text></svg>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p>{site.volledig}, {site.plaats}.</p>
    <p><a href={url('privacy/')} class="lijn-in">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Sfeerfoto's via Unsplash, ter illustratie; uw Google-profiel heeft nog geen eigen foto's. Bij oplevering vervangen we ze door foto's van uw zaak. Gegevens en tijden van uw Google-bedrijfsprofiel (stand 2 oktober 2026).</p>}
</footer>

<style>
  .voetmerk { display: block; width: 100%; height: auto; margin-top: 1rem; }
  .voetmerk text { font-family: var(--font-sans); font-size: 330px; font-weight: 800; font-stretch: 125%; fill: var(--color-licht); fill-opacity: .07; }
</style>
