---
import { url, waHallo } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<header class:list={['z-40', thuis ? 'donker absolute inset-x-0 text-licht' : 'border-b border-lijn']}>
  <div class="wrap flex h-[4.75rem] items-center justify-between gap-6 md:h-24">
    <a href={url('')} class="merk">
      <b>ROB</b><small>Schoenen<br />Sleutels<br />Stomerij</small>
    </a>
    <nav aria-label="Hoofdmenu" class="ui flex items-center gap-8">
      <ul class="hidden gap-8 md:flex">
        <li><a href={h('balie')} class="lijn-in">Wat Rob doet</a></li>
        <li><a href={h('rob')} class="lijn-in">Over Rob</a></li>
        <li><a href={h('tijden')} class="lijn-in">Openingstijden</a></li>
      </ul>
      <a href={waHallo} class="lijn">WhatsApp</a>
    </nav>
  </div>
</header>
