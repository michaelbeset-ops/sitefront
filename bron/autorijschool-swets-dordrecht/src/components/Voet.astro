---
import { site, url } from '../data/site';
---
<footer class="donker bg-asfalt text-licht">
  <div class="streep"></div>
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-kop text-3xl font-black tracking-tight">Swets</p>
      <p class="mt-2 max-w-xs text-sm text-licht-zacht">Autorijschool in Dordrecht. Rijlessen van 60 minuten met een vaste instructeur.</p>
    </div>
    <div class="text-sm">
      <p class="font-kop font-extrabold">Adres</p>
      <p class="mt-2 text-licht-zacht">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="text-sm">
      <p class="font-kop font-extrabold">Contact</p>
      <ul class="mt-2 space-y-1 text-licht-zacht">
        <li><a href={site.tel1Href} class="num hover:text-licht">{site.tel1}</a></li>
        <li><a href={site.tel2Href} class="num hover:text-licht">{site.tel2}</a></li>
        <li><a href={`mailto:${site.mail}`} class="hover:text-licht">{site.mail}</a></li>
        <li><a href={site.facebook} class="hover:text-licht" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap justify-between gap-3 py-5 text-xs text-licht-zacht">
      <p>Rijschoolnummer CBR {site.rijschoolnummer}</p>
      <a href={url('privacy/')} class="underline underline-offset-2 hover:text-licht">Privacyverklaring</a>
    </div>
  </div>
</footer>

<!-- Op mobiel staat bellen altijd binnen duimbereik. -->
<div class="donker fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-lijn-licht bg-asfalt p-2 md:hidden">
  <a href={site.tel1Href} class="knop knop-roze min-h-12 px-3 text-base">Bellen</a>
  <a href={`mailto:${site.mail}`} class="knop knop-rand min-h-12 px-3 text-base text-licht">Mailen</a>
</div>
