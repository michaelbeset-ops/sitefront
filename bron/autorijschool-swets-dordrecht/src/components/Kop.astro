---
import { site, url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
const home = url('');
const links = [
  { href: `${home}#lessen`, tekst: 'Lessen' },
  { href: `${home}#tarieven`, tekst: 'Tarieven' },
  { href: `${home}#examen`, tekst: 'Theorie en examen' },
  { href: `${home}#contact`, tekst: 'Contact' },
];
---
<header class:list={['z-30 w-full', licht ? 'relative bg-asfalt text-licht donker' : 'absolute inset-x-0 text-licht donker']}>
  <div class="wrap flex items-center justify-between gap-6 py-5">
    <a href={home} class="flex items-center gap-3 no-underline">
      <span aria-hidden="true" class="grid h-10 w-10 place-items-center rounded-sm bg-roze font-kop text-2xl font-black leading-none text-inkt">S</span>
      <span class="leading-none">
        <span class="block font-kop text-xl font-black tracking-tight">Swets</span>
        <span class="mt-1 block text-[.6875rem] font-bold uppercase tracking-[.18em] text-licht-zacht">Autorijschool Dordrecht</span>
      </span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex items-center gap-8 font-kop text-[.9375rem] font-bold">
        {links.map((l) => <li><a href={l.href} class="no-underline decoration-roze decoration-2 underline-offset-8 hover:underline">{l.tekst}</a></li>)}
      </ul>
    </nav>
    <a href={site.tel1Href} class="knop knop-rand hidden min-h-11 px-4 py-2 text-[.9375rem] md:inline-flex">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
      <span class="num">{site.tel1}</span>
    </a>
  </div>
</header>
