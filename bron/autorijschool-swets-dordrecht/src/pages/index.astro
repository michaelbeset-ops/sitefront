---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, slagen, pluspunten, lessen, overig, euro, fotos } from '../data/site';

const srcset = (f: (w?: number) => string, ws: number[]) => ws.map((w) => `${f(w)} ${w}w`).join(', ');
---
<Base title="Autorijschool Swets, rijles in Dordrecht" description="Rijles in Dordrecht met een vaste instructeur, man of vrouw naar keuze. Lessen van 60 minuten, privéles en geld terug voor lessen die je na het slagen niet gebruikt." hero>
  <Kop />
  <main id="inhoud">
    <!-- Hero: schermvullende foto, tekst linksonder. -->
    <section class="donker relative isolate flex min-h-[92svh] flex-col justify-end overflow-hidden bg-asfalt text-licht">
      <img src={fotos.hero(1600)} srcset={srcset(fotos.hero, [800, 1200, 1600])} sizes="100vw" alt="" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#18191c99_0%,#18191c33_30%,#18191cb3_62%,#18191cf2_100%)] md:bg-[linear-gradient(90deg,#18191cf0_0%,#18191cb8_42%,#18191c33_75%),linear-gradient(180deg,#18191c99_0%,transparent_28%)]"></div>
      <div class="wrap pb-12 pt-36 md:pb-20">
        <p class="label">Autorijschool in Dordrecht</p>
        <h1 class="mt-5 max-w-[13ch] text-hero">Rijles met een vaste instructeur.</h1>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-licht/90">Lessen van een vol uur, privé, in een rookvrije auto. Je kiest zelf of je les krijgt van een man of een vrouw.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.tel1Href} class="knop knop-roze">Bel<span class="num">{site.tel1}</span></a>
          <a href="#tarieven" class="knop knop-rand text-licht">Bekijk de tarieven</a>
        </div>
      </div>
      <div class="streep"></div>
    </section>

    <!-- Het sterkste feit van de rijschool krijgt de meeste ruimte. -->
    <section class="py-20 md:py-28" aria-labelledby="slagen-kop">
      <div class="wrap grid gap-12 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5">
          <p class="label">Slagen</p>
          <h2 id="slagen-kop" class="mt-5 text-3xl">Meer dan de helft slaagt in één keer.</h2>
          <p class="mt-6 max-w-md text-grijs">Bij het eerste praktijkexamen slaagde in {slagen.jaar} {slagen.swets} procent van onze leerlingen. Het gemiddelde in Dordrecht lag op {slagen.dordrecht} procent.</p>
        </div>
        <div class="md:col-span-7 md:pl-8" data-groei>
          <p class="font-kop text-cijfer font-black leading-[.8] tracking-[-.05em]"><span class="num">{slagen.swets}</span><span class="text-[.45em] tracking-normal">%</span></p>
          <dl class="mt-10 space-y-6">
            <div>
              <dt class="flex justify-between font-kop text-sm font-extrabold"><span>Autorijschool Swets</span><span class="num">{slagen.swets}%</span></dt>
              <dd class="mt-2 h-4 bg-vlak"><span class="balk block h-full bg-inkt" style={`width:${slagen.swets}%`}></span></dd>
            </div>
            <div>
              <dt class="flex justify-between font-kop text-sm font-extrabold text-grijs"><span>Gemiddeld in Dordrecht</span><span class="num">{slagen.dordrecht}%</span></dt>
              <dd class="mt-2 h-4 bg-vlak"><span class="balk block h-full bg-grijs" style={`width:${slagen.dordrecht}%`}></span></dd>
            </div>
          </dl>
          <p class="mt-5 text-xs text-grijs">Eerste praktijkexamen, {slagen.examens} examens in {slagen.jaar}. Bron rijschoolspecialist.nl.</p>
        </div>
      </div>
    </section>

    <!-- Lessen: foto links, de pluspunten als genummerde lijst. -->
    <section id="lessen" class="donker bg-asfalt py-20 text-licht md:py-28" aria-labelledby="lessen-kop">
      <div class="wrap grid gap-12 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5">
          <div class="md:sticky md:top-10">
            <p class="label">Zo krijg je les</p>
            <h2 id="lessen-kop" class="mt-5 text-3xl">Een uur, één instructeur, alleen jij.</h2>
            <img src={fotos.weg(900)} srcset={srcset(fotos.weg, [600, 900, 1200])} sizes="(min-width: 768px) 40vw, 100vw" alt="Een auto op een lege weg" loading="lazy" decoding="async" class="mt-10 aspect-[4/5] w-full max-w-md rounded-sm object-cover" />
          </div>
        </div>
        <ol class="md:col-span-7 md:pl-8">
          {pluspunten.map((p, i) => (
            <li class="grid grid-cols-[3.25rem_1fr] gap-x-4 border-t border-lijn-licht py-7 first:border-t-0 first:pt-0 sm:grid-cols-[4.5rem_1fr]">
              <span aria-hidden="true" class="num font-kop text-2xl font-black leading-none text-roze">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-xl">{p.kop}</h3>
                <p class="mt-2 text-licht-zacht">{p.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Tarieven als prijsbord met stippellijnen. -->
    <section id="tarieven" class="py-20 md:py-28" aria-labelledby="tarieven-kop">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <div class="md:col-span-7">
            <p class="label">Tarieven</p>
            <h2 id="tarieven-kop" class="mt-5 text-3xl">Wat rijles bij ons kost.</h2>
          </div>
          <p class="max-w-sm text-grijs md:col-span-5 md:justify-self-end">Elke les duurt 60 minuten. Neem je meer lessen tegelijk, dan betaal je per les minder.</p>
        </div>

        <div class="mt-14 grid gap-14 md:grid-cols-2 md:gap-16">
          <div>
            <h3 class="text-xl">Rijlessen</h3>
            <ul class="mt-4 border-t-2 border-inkt">
              {lessen.map((l) => (
                <li class="prijsregel">
                  <span class="font-kop text-lg font-extrabold">{l.naam}{l.sub && <span class="ml-2 font-sans text-sm font-normal text-grijs">{l.sub}</span>}</span>
                  <span aria-hidden="true" class="stip"></span>
                  <span class="num font-kop text-lg font-black">{euro(l.prijs)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-xl">Theorie en examens</h3>
            <ul class="mt-4 border-t-2 border-inkt">
              {overig.map((l) => (
                <li class="prijsregel">
                  <span class="font-kop text-lg font-extrabold">{l.naam}</span>
                  <span aria-hidden="true" class="stip"></span>
                  <span class="num font-kop text-lg font-black">{euro(l.prijs)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-14 flex flex-col gap-5 bg-roze p-7 sm:flex-row sm:items-center sm:justify-between md:p-9">
          <p class="max-w-xl font-kop text-xl font-extrabold leading-snug tracking-tight md:text-2xl">Geslaagd en nog lessen over? Die krijg je terugbetaald.</p>
          <a href={site.tel1Href} class="knop shrink-0 bg-inkt text-licht hover:bg-asfalt-2">Bel voor je eerste les</a>
        </div>
      </div>
    </section>

    <!-- Theorie en examen. -->
    <section id="examen" class="bg-vlak py-20 md:py-28" aria-labelledby="examen-kop">
      <div class="wrap grid gap-12 md:grid-cols-12 md:gap-10">
        <div class="order-2 md:order-1 md:col-span-5">
          <img src={fotos.examen(900)} srcset={srcset(fotos.examen, [600, 900, 1200])} sizes="(min-width: 768px) 40vw, 100vw" alt="Een examinator met een klembord wijst naar een auto" loading="lazy" decoding="async" class="aspect-[4/5] w-full rounded-sm object-cover" />
        </div>
        <div class="order-1 md:order-2 md:col-span-7 md:pl-8 md:pt-6">
          <p class="label">Theorie en examen</p>
          <h2 id="examen-kop" class="mt-5 text-3xl">Klaar voor het CBR.</h2>
          <div class="mt-10 space-y-8">
            <div class="border-l-4 border-inkt pl-6">
              <h3 class="text-xl">Theorie-examen</h3>
              <p class="mt-2 text-grijs">Je theorie-examen regel je via mijn.cbr.nl. Houd daarbij ons rijschoolnummer bij de hand.</p>
              <p class="mt-4 inline-flex flex-wrap items-baseline gap-x-3 gap-y-1 bg-papier px-4 py-3">
                <span class="text-sm text-grijs">Ons rijschoolnummer</span>
                <span class="num font-kop text-2xl font-black tracking-wide">{site.rijschoolnummer}</span>
              </p>
              <p class="mt-4 text-grijs">Wil je eerst leren voor de theorie? Volg dan onze theoriecursus voor {euro(60)}.</p>
            </div>
            <div class="border-l-4 border-inkt pl-6">
              <h3 class="text-xl">Praktijkexamen</h3>
              <p class="mt-2 text-grijs">Voor je praktijkexamen kun je eerst een tussentijdse toets doen. Zo weet je hoe een examen bij het CBR verloopt. Vraag je instructeur wat voor jou slim is.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Afsluitende oproep op een foto van stadsverkeer. -->
    <section class="donker relative isolate overflow-hidden bg-asfalt text-licht" aria-labelledby="start-kop">
      <img src={fotos.stad(1600)} srcset={srcset(fotos.stad, [800, 1200, 1600])} sizes="100vw" alt="" loading="lazy" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover" />
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#18191cf2_0%,#18191cc7_55%,#18191c66_100%)]"></div>
      <div class="wrap py-24 md:py-32">
        <h2 id="start-kop" class="max-w-[16ch] text-3xl">Zin om te beginnen? Bel of mail ons.</h2>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.tel1Href} class="knop knop-roze">Bel<span class="num">{site.tel1}</span></a>
          <a href={`mailto:${site.mail}`} class="knop knop-rand text-licht">Mail ons</a>
        </div>
      </div>
    </section>

    <!-- Contact. Het formulier is in dit voorstel uitgeschakeld. -->
    <section id="contact" class="py-20 md:py-28" aria-labelledby="contact-kop">
      <div class="wrap grid gap-14 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5">
          <p class="label">Contact</p>
          <h2 id="contact-kop" class="mt-5 text-3xl">Bel, mail of stuur een bericht.</h2>
          <dl class="mt-10 space-y-6">
            <div>
              <dt class="font-kop text-sm font-extrabold uppercase tracking-[.12em] text-grijs">Bellen</dt>
              <dd class="mt-1 space-y-1">
                <a href={site.tel1Href} class="num block font-kop text-2xl font-black tracking-tight underline-offset-4 hover:underline">{site.tel1}</a>
                <a href={site.tel2Href} class="num block font-kop text-2xl font-black tracking-tight underline-offset-4 hover:underline">{site.tel2}</a>
              </dd>
            </div>
            <div>
              <dt class="font-kop text-sm font-extrabold uppercase tracking-[.12em] text-grijs">Mailen</dt>
              <dd class="mt-1"><a href={`mailto:${site.mail}`} class="text-lg underline underline-offset-4">{site.mail}</a></dd>
            </div>
            <div>
              <dt class="font-kop text-sm font-extrabold uppercase tracking-[.12em] text-grijs">Adres</dt>
              <dd class="mt-1 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</dd>
              <dd class="mt-2"><a href={site.maps} class="text-sm underline underline-offset-4" rel="noopener">Route plannen</a></dd>
            </div>
            <div>
              <dt class="font-kop text-sm font-extrabold uppercase tracking-[.12em] text-grijs">Volgen</dt>
              <dd class="mt-1"><a href={site.facebook} class="text-lg underline underline-offset-4" rel="noopener">Facebook</a></dd>
            </div>
          </dl>
        </div>

        <form class="md:col-span-7 md:pl-8" onsubmit="return false" aria-describedby="formulier-noot">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="font-kop text-sm font-extrabold">Naam</span>
              <input type="text" name="naam" autocomplete="name" class="mt-2 block w-full rounded-sm border-2 border-inkt bg-wit px-4 py-3" />
            </label>
            <label class="block">
              <span class="font-kop text-sm font-extrabold">Telefoon</span>
              <input type="tel" name="telefoon" autocomplete="tel" class="mt-2 block w-full rounded-sm border-2 border-inkt bg-wit px-4 py-3" />
            </label>
            <label class="block sm:col-span-2">
              <span class="font-kop text-sm font-extrabold">E-mail</span>
              <input type="email" name="email" autocomplete="email" class="mt-2 block w-full rounded-sm border-2 border-inkt bg-wit px-4 py-3" />
            </label>
            <fieldset class="sm:col-span-2">
              <legend class="font-kop text-sm font-extrabold">Voorkeur voor je instructeur</legend>
              <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
                <label class="inline-flex items-center gap-2"><input type="radio" name="instructeur" value="man" class="h-5 w-5 accent-[#18191c]" /> Man</label>
                <label class="inline-flex items-center gap-2"><input type="radio" name="instructeur" value="vrouw" class="h-5 w-5 accent-[#18191c]" /> Vrouw</label>
                <label class="inline-flex items-center gap-2"><input type="radio" name="instructeur" value="geen" class="h-5 w-5 accent-[#18191c]" checked /> Maakt niet uit</label>
              </div>
            </fieldset>
            <label class="block sm:col-span-2">
              <span class="font-kop text-sm font-extrabold">Bericht</span>
              <textarea name="bericht" rows="5" class="mt-2 block w-full rounded-sm border-2 border-inkt bg-wit px-4 py-3"></textarea>
            </label>
          </div>
          <p id="formulier-noot" class="mt-6 border-l-4 border-roze bg-wit px-5 py-4 text-sm text-grijs">Dit formulier is een voorbeeld en verstuurt nog niets. Bel <a href={site.tel1Href} class="num font-bold text-inkt underline">{site.tel1}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-bold text-inkt underline">{site.mail}</a>.</p>
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>
