---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Wa from '../components/Wa.astro';
import { site } from '../data/site';
import hero from '../assets/hero.jpg';
import polijsten from '../assets/polijsten.jpg';
import spuitcabine from '../assets/spuitcabine.jpg';
import schade from '../assets/schade.jpg';

const stappen = [
  { kop: "Maak een paar foto's", tekst: 'Van dichtbij en van iets verder weg, zodat de schade en de plek op de auto goed te zien zijn.' },
  { kop: 'Stuur ze via WhatsApp', tekst: `Naar ${site.tel}. Zet er uw naam bij en het merk en model van de auto.` },
  { kop: 'U krijgt een prijsopgave', tekst: 'Komt het u uit, dan spreekt u samen af wanneer de auto langs kan komen.' },
];
---
<Base
  title="Autoschade Gouda | Autoschade laten herstellen aan de Nijverheidsstraat"
  description="Autoschadebedrijf in Gouda, Nijverheidsstraat 39. Kleine schades en krassen hersteld. Stuur foto's van de schade via WhatsApp voor een prijsopgave: 06 85 64 33 03."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Donkere hero: op mobiel foto met egale overlay, op desktop foto rechts die in het zwart overloopt. -->
    <section class="relative isolate overflow-hidden bg-ink text-white">
      <div class="absolute inset-0 -z-10 lg:left-auto lg:w-[62%]">
        <Foto src={hero} alt="Man met pet spuit water op het oranje voorscherm van een sportauto in een werkplaats" hero sizes="(min-width: 1024px) 62vw, 100vw" class="object-[30%_center]" />
        <div class="absolute inset-0 bg-ink/80 lg:bg-transparent lg:bg-[linear-gradient(90deg,#16161a_0%,#16161ae6_22%,#16161a33_60%,#16161a00_100%)]"></div>
      </div>
      <div class="wrap py-14 sm:py-20 lg:py-28">
        <div class="max-w-xl">
          <p class="font-display text-lg font-semibold text-lak">Autoschadebedrijf in Gouda</p>
          <h1 class="mt-4 text-4xl">Autoschade laten herstellen in Gouda</h1>
          <p class="mt-6 text-lg text-white/90">Krassen of een andere kleine schade? Stuur foto's van de schade via WhatsApp voor een prijsopgave. Liever eerst even overleggen, dan belt u gewoon.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.whatsapp} class="btn btn-lak"><Wa class="h-6 w-6" />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line text-white">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
        </div>
        <dl class="mt-12 grid max-w-xl gap-x-6 min-[360px]:grid-cols-2 gap-y-5 border-t border-line-dark pt-6 text-sm">
          <div><dt class="text-white/75">Google, 7 reviews</dt><dd class="mt-1 font-display text-xl font-bold tabular-nums">5,0 uit 5</dd></div>
          <div><dt class="text-white/75">Adres</dt><dd class="mt-1 font-display text-lg font-bold leading-tight sm:text-xl">Nijverheidsstraat 39</dd></div>
        </dl>
      </div>
    </section>

    <!-- Werkwijze: tijdlijn links, schadefoto rechts. -->
    <section id="werkwijze" class="scroll-mt-16 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-6">
          <p class="font-display font-bold text-ink-soft">Werkwijze</p>
          <h2 class="mt-3 text-3xl">Eerst een foto, dan een prijs</h2>
          <p class="mt-5 max-w-lg text-lg text-ink-soft">Stuur foto's van de schade via WhatsApp voor een prijsopgave. Zo weet u waar u aan toe bent voordat u met de auto langskomt.</p>
          <ol class="mt-10">
            {stappen.map((s, i) => (
              <li class="relative grid grid-cols-[2.75rem_1fr] gap-4 pb-8 last:pb-0">
                {i < stappen.length - 1 && <span class="absolute bottom-1 left-[1.375rem] top-12 w-px bg-line" aria-hidden="true"></span>}
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink font-display text-lg font-extrabold text-lak tabular-nums" aria-hidden="true">{i + 1}</span>
                <div class="pt-1.5">
                  <h3 class="text-xl">{s.kop}</h3>
                  <p class="mt-1.5 text-ink-soft">{s.tekst}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[4/5]"><Foto src={schade} alt="Rode auto met een flinke deuk in het achterscherm en de bumper, vastgezet op een oprijwagen" sizes="(min-width: 1024px) 420px, 100vw" /></div>
          <a href={site.whatsapp} class="btn btn-ink mt-5 w-full"><Wa class="h-6 w-6 text-lak" />Foto's sturen via WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- Herstel: brede foto, daaronder wat we doen en wat nog aangevuld moet worden. -->
    <section id="herstel" class="scroll-mt-16 bg-white py-16 lg:py-24">
      <div class="wrap">
        <div class="aspect-[4/3] overflow-hidden rounded-xl sm:aspect-[21/9]"><Foto src={polijsten} alt="Handen polijsten de motorkap van een donkere auto met een polijstmachine" sizes="(min-width: 1184px) 1120px, 100vw" /></div>
        <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-6">
            <p class="font-display font-bold text-ink-soft">Wat we herstellen</p>
            <h2 class="mt-3 text-3xl">Kleine schades en krassen</h2>
            <p class="mt-5 text-lg text-ink-soft">Bijvoorbeeld krassen in de lak of een kleine schade aan de auto. Stuur een foto, dan hoort u wat het herstel kost.</p>
            <p class="todo mt-4">[[AANLEVEREN: welke andere schades u herstelt, bijvoorbeeld grotere schade of spuitwerk]]</p>
          </div>
          <div class="lg:col-span-5 lg:col-start-8">
            <h3 class="text-xl">Goed om te weten</h3>
            <dl class="mt-4 divide-y divide-line border-y border-line">
              <div class="py-4"><dt class="font-display font-bold">Verzekering</dt><dd class="todo mt-1">[[AANLEVEREN: of u schade via de verzekeraar afhandelt, en met welke verzekeraars]]</dd></div>
              <div class="py-4"><dt class="font-display font-bold">Vervangend vervoer</dt><dd class="todo mt-1">[[AANLEVEREN: of er een vervangende auto is tijdens het herstel]]</dd></div>
              <div class="py-4"><dt class="font-display font-bold">Garantie</dt><dd class="todo mt-1">[[AANLEVEREN: garantie op het herstel]]</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Lakgele band met de ene actie die telt. -->
    <section class="bg-lak text-ink">
      <div class="wrap flex flex-col gap-6 py-12 md:flex-row md:items-center md:justify-between">
        <h2 class="max-w-xl text-3xl">Schade aan de auto? Stuur eerst een foto.</h2>
        <a href={site.whatsapp} class="btn btn-ink shrink-0"><Wa class="h-6 w-6 text-lak" />Stuur een WhatsApp</a>
      </div>
    </section>

    <!-- Adres, openingstijden en contact op donker, met de spuitcabine als sfeerbeeld. -->
    <section id="adres" class="scroll-mt-16 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="order-2 lg:order-1 lg:col-span-6">
          <div class="aspect-[4/3] overflow-hidden rounded-xl"><Foto src={spuitcabine} alt="Auto met schade aan de voorkant: gedeukte motorkap en losse koplamp" sizes="(min-width: 1024px) 540px, 100vw" /></div>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-5 lg:col-start-8">
          <p class="font-display font-bold text-lak">Adres en contact</p>
          <h2 class="mt-3 text-3xl">Aan de Nijverheidsstraat in Gouda</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6 text-white">Route plannen</a>

          <h3 class="mt-12 text-xl">Openingstijden</h3>
          <p class="mt-2 text-sm text-white/75">[[AANLEVEREN: openingstijden per dag]]</p>

          <h3 class="mt-10 text-xl">Contact</h3>
          <dl class="mt-3 grid gap-4">
            <div><dt class="text-sm text-white/75">Telefoon en WhatsApp</dt><dd><a href={site.telHref} class="whitespace-nowrap font-display text-3xl font-extrabold tabular-nums underline decoration-lak decoration-2 underline-offset-[6px]">{site.tel}</a></dd></div>
            <div><dt class="text-sm text-white/75">E-mail</dt><dd class="text-sm text-white/75">[[AANLEVEREN: e-mailadres]]</dd></div>
          </dl>
          <a href={site.whatsapp} class="btn btn-lak mt-8 w-full sm:w-auto"><Wa class="h-6 w-6" />Stuur een WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
