---
import { site, url } from '../data/site';
import Wa from './Wa.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line-dark bg-ink/95 text-white backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-xl font-extrabold leading-none tracking-[-0.03em] text-white no-underline sm:text-2xl">Autoschade<span class="text-lak"> Gouda</span></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-medium text-white/85">
          <li><a href={url('#werkwijze')} class="no-underline transition-colors hover:text-lak">Werkwijze</a></li>
          <li><a href={url('#herstel')} class="no-underline transition-colors hover:text-lak">Herstel</a></li>
          <li><a href={url('#adres')} class="no-underline transition-colors hover:text-lak">Adres</a></li>
        </ul>
      </nav>
      <a href={site.whatsapp} class="btn btn-lak !gap-2 !px-3.5 !py-2 !text-sm" aria-label={`WhatsApp ${site.tel}`}><Wa class="h-5 w-5" /><span class="hidden sm:inline">WhatsApp</span></a>
    </div>
  </header>
) : (
  <footer class="border-t border-line-dark bg-ink py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br /><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br />KvK <span class="text-white/70">[[AANLEVEREN: KvK-nummer]]</span></p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
