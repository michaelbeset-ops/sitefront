---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, producten, ral, wijzer, review, waAdvies, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import rolluiken from '../assets/rolluiken.jpg';
import screens from '../assets/screens.jpg';
import knikarm from '../assets/knikarm.jpg';
import uitval from '../assets/uitval.jpg';
import markies from '../assets/markies.jpg';
import solidare from '../assets/solidare.jpg';
import oliva from '../assets/oliva.jpg';
import greup from '../assets/greup.jpg';
import gestoffeerd from '../assets/gestoffeerd.jpg';
import nieuwemarkies from '../assets/nieuwemarkies.jpg';
import ritsxl from '../assets/ritsxl.jpg';
import bijgebouw from '../assets/bijgebouw.jpg';
import gota from '../assets/gota.jpg';
import kastenwand from '../assets/kastenwand.jpg';
import solar from '../assets/solar.jpg';
import hoogte from '../assets/hoogte.jpg';
import rolluiksolar from '../assets/rolluiksolar.jpg';
import markiesbekleden from '../assets/markiesbekleden.jpg';
import pergola2 from '../assets/pergola2.jpg';

const kaarten = [
  { id: 'rolluiken', t: 'Rolluiken', d: 'Tegen inbraak, licht, warmte, kou, geluid en inkijk.', src: rolluiken, alt: 'Witte rolluiken, half neergelaten voor de ramen van een bakstenen woning', pos: '50% 45%' },
  { id: 'screens', t: 'Screens', d: 'Ritsscreens weren de warmte, u blijft naar buiten kijken.', src: screens, alt: 'Drie grijze ritsscreens onder een houten overkapping aan een terras', pos: '50% 40%' },
  { id: 'knikarm', t: 'Knikarmschermen', d: 'Zes modellen, van compact tot extra breed.', src: knikarm, alt: 'Grijs-wit gestreept knikarmscherm boven het terras en de achterpui van een woning', pos: '50% 30%' },
  { id: 'uitval', t: 'Uitvalschermen', d: 'Schaduw voor het raam, met vrije doorkijk naar buiten.', src: uitval, alt: 'Groen-wit gestreepte uitvalschermen voor de ramen van een witte woning', pos: '50% 35%' },
  { id: 'markiezen', t: 'Markiezen', d: 'Nieuw, of uw bestaande markies opnieuw bekleed.', src: markies, alt: 'Blauw-wit gestreepte markiezen boven de ramen van een bakstenen huis', pos: '50% 50%' },
  { id: 'terras', t: 'Terrasoverkapping', d: 'Windvaste pergola-zonwering, ook vrijstaand.', src: solidare, alt: 'Antracieten Solidare Pergola boven een terras in een nieuwe tuin', pos: '50% 45%' },
];

const projecten = [
  { src: oliva, t: 'Knikarmschermen Oliva', alt: 'Drie gestreepte knikarmschermen naast elkaar langs de achtergevel van een woning', cls: 'col-span-2 row-span-2' },
  { src: ritsxl, t: 'Ritsscreen XL', alt: 'Een grote, gesloten grijze ritsscreen voor een raampartij', cls: 'row-span-2' },
  { src: gestoffeerd, t: 'Markiezen opnieuw gestoffeerd', alt: 'Antraciet beklede markiezen boven de ramen van een bakstenen woning met bolboompjes', cls: '' },
  { src: bijgebouw, t: 'Rolluiken bijgebouw', alt: 'Twee witte rolluiken voor een bijgebouw achter een strak aangelegde tuin', cls: '' },
  { src: gota, t: 'Knikarmscherm Gota', alt: 'Zwart-wit gestreept knikarmscherm, van onderen gezien', cls: '' },
  { src: hoogte, t: 'Reparatie op hoogte', alt: 'Een rode hoogwerker naast een gevel tijdens een reparatie', cls: 'row-span-2' },
  { src: nieuwemarkies, t: 'Nieuwe markiezen', alt: 'Grijze markiezen boven de ramen van een hoog bakstenen huis', cls: '' },
  { src: solar, t: 'Ritsscreens Solar', alt: 'Ritsscreens voor drie hoge ramen in een donkere houten gevel', cls: '' },
  { src: kastenwand, t: 'Rolluiken voor kastenwand', alt: 'Lichte rolluiken als deuren voor een lange kastenwand binnen', cls: '' },
  { src: pergola2, t: 'Pergola met zijscreen', alt: 'Pergola met gestreept doek en een gesloten zijscreen naast de openslaande deuren van een woning', cls: 'col-span-2' },
];

const stappen = [
  ['Gratis advies bij u thuis', 'We komen langs, bekijken de situatie en denken mee. De afspraak en het advies zijn gratis.'],
  ['Offerte op maat', 'U krijgt altijd een offerte die voor uw situatie op maat is gemaakt.'],
  ['Eigen assemblage', 'Direct van de fabrikant, geen tussenhandel. Rolluiken meten we in, zagen we en assembleren we zelf.'],
  ['Montage door ons team', 'Ons eigen montageteam plaatst alles. Met 5 jaar garantie op motoren en 3 jaar op schermen en rolluiken.'],
];

const merken = ['Somfy', 'Heroal', 'AVZ', 'Tibelly', 'Dickson', 'Smits', 'Aurora', 'ALX'];
const waModel = (product: string, model: string) => product === 'markies' ? (model === 'Nieuwe markies' ? 'Hallo Perfect Zonwering, ik heb interesse in een nieuwe markies. Kunnen we een afspraak maken voor advies en een offerte?' : 'Hallo Perfect Zonwering, ik wil graag mijn markies opnieuw laten bekleden. Kunnen we een afspraak maken voor advies en een offerte?') : `Hallo Perfect Zonwering, ik heb interesse in de ${model} (${product}). Kunnen we een afspraak maken voor advies en een offerte?`;
---
<Base title={`${site.naam} | Zonwering en rolluiken in Zuid-Beijerland`} description="Perfect Zonwering in Zuid-Beijerland, sinds 1994: rolluiken, screens, knikarmschermen, uitvalschermen, markiezen en terrasoverkappingen op maat. Gratis advies bij u thuis.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen pergola -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_55%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#121316b3_0%,#121316bf_45%,#121316f2_100%)] md:bg-[linear-gradient(90deg,#121316f0_0%,#121316c7_38%,#12131640_72%,#12131610_100%)]" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 hidden h-1/2 bg-[linear-gradient(0deg,#121316e6_0%,#12131600_100%)] md:block" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-10 pb-20 pt-28 md:pb-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Zonwering en rolluiken in Zuid-Beijerland</p>
          <h1 id="t-hero" class="mt-5 text-hero">Zonwering en rolluiken, <span class="text-zalm">perfect</span> op maat.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Sinds 1994 uw specialist. Gratis advies bij u thuis en altijd een offerte die voor u op maat is gemaakt.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="knop knop-rood">Gratis advies aanvragen<Icoon naam="pijl" /></a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2 text-[.9375rem] font-medium text-licht/90">
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-zalm" />5 jaar garantie op motoren</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-zalm" />Eigen montageteam</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-zalm" />Direct van de fabrikant</li>
          </ul>
        </div>
        <div class="hidden text-right lg:col-span-4 lg:block">
          <p class="flex items-center justify-end gap-2 text-[.9375rem] text-licht/90" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.00 tot 17.00 uur</span></p>
          <a href={site.telHref} class="num mt-2 inline-block text-[1.75rem] font-extrabold tracking-[-0.03em] text-licht no-underline hover:text-zalm">{site.tel}</a>
          <p class="mt-1 text-sm text-lila">{site.straat}, {site.plaats}</p>
        </div>
      </div>
    </section>
    <div class="festoen" aria-hidden="true"></div>

    <!-- 2. Feitenrij -->
    <section aria-label="Perfect Zonwering in het kort">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col pr-4"><dt class="mt-2 text-sm text-grijs">Sinds dit jaar actief, binnen en buiten de Hoeksche Waard</dt><dd class="num order-first text-[clamp(2.5rem,3vw+1.4rem,3.6rem)] font-extrabold leading-none tracking-[-0.05em] text-rood">1994</dd></div>
        <div class="flex flex-col pr-4 lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Garantie op onze motoren</dt><dd class="num order-first text-[clamp(2.5rem,3vw+1.4rem,3.6rem)] font-extrabold leading-none tracking-[-0.05em]">5 jaar</dd></div>
        <div class="flex flex-col pr-4 lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Garantie op schermen en rolluiken</dt><dd class="num order-first text-[clamp(2.5rem,3vw+1.4rem,3.6rem)] font-extrabold leading-none tracking-[-0.05em]">3 jaar</dd></div>
        <div class="flex flex-col pr-4 lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Afspraak en advies op maat, bij u thuis</dt><dd class="order-first text-[clamp(2.5rem,3vw+1.4rem,3.6rem)] font-extrabold leading-none tracking-[-0.05em]">Gratis</dd></div>
      </dl>
    </section>

    <!-- 3. Producten -->
    <section id="producten" class="border-t border-lijn bg-wit py-20 lg:py-24" aria-labelledby="t-prod">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 id="t-prod" class="rijs text-3xl lg:col-span-7">Zonwering en rolluiken voor uw huis of bedrijf.</h2>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Uitsluitend A-kwaliteit, direct van de fabrikant. Daardoor maatwerk met een zeer scherpe prijs.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {kaarten.map((k, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href="#wijzer" data-naar={k.id} class="group flex h-full flex-col no-underline">
                <div class="overflow-hidden rounded-md bg-steen">
                  <Image src={k.src} alt={k.alt} widths={[400, 600, 800]} sizes="(min-width: 1248px) 380px, (min-width: 1024px) 31vw, 46vw" class="aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${k.pos}`} />
                </div>
                <div class="flex flex-1 items-start justify-between gap-4 border-b-2 border-inkt pb-4 pt-4 transition-colors group-hover:border-rood sm:pt-5">
                  <div>
                    <h3 class="text-[1.0625rem] hyphens-auto sm:text-[1.375rem]">{k.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:text-base">{k.d}</p>
                  </div>
                  <Icoon naam="pijl" class="mt-1 hidden h-6 w-6 shrink-0 text-rood transition-transform group-hover:translate-x-1 sm:block" />
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:mt-14 lg:gap-6">
          <div class="rijs flex items-center gap-5 rounded-md bg-papier p-4 pr-6">
            <Image src={rolluiksolar} alt="Twee brede crèmewitte rolluiken onder de dakrand van een woning" widths={[200, 320]} sizes="128px" class="h-28 w-28 shrink-0 rounded-sm object-cover sm:h-32 sm:w-32" />
            <div><h3 class="text-lg">Op zonne-energie</h3><p class="mt-1 text-[.9375rem] text-grijs">Met een Somfy Solar motor heeft u geen bedrading meer naar binnen en bespaart u energie.</p></div>
          </div>
          <div class="rijs flex items-center gap-5 rounded-md bg-papier p-4 pr-6" style="--d:.06s">
            <Image src={markiesbekleden} alt="Zwart-wit gestreepte markies die opnieuw bekleed wordt" widths={[200, 320]} sizes="128px" class="h-28 w-28 shrink-0 rounded-sm object-cover sm:h-32 sm:w-32" />
            <div><h3 class="text-lg">Reparatie en herstel</h3><p class="mt-1 text-[.9375rem] text-grijs">Opnieuw bekleden, repareren of herstellen: dat doen we zelf, ook op hoogte.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Productwijzer -->
    <section id="wijzer" class="bg-steen py-20 lg:py-24" aria-labelledby="t-wijzer">
      <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Productwijzer</p>
          <h2 id="t-wijzer" class="mt-4 text-3xl">Kies uw model en kleur.</h2>
          <p class="mt-5 text-lg text-grijs">Met de maximale maat, de standaardkleuren en de bediening. Kies een kleur en vraag meteen een offerte aan.</p>
          <div class="-mx-5 mt-9 min-w-0 overflow-x-auto px-5 [scrollbar-width:none] lg:mx-0 lg:overflow-visible lg:px-0">
            <div role="tablist" aria-label="Productgroep" class="flex gap-2 lg:flex-col lg:gap-1">
              {wijzer.map((g, i) => (
                <button type="button" role="tab" id={`tab-${g.id}`} aria-controls={`paneel-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={g.id} class="tab shrink-0">
                  <span>{g.titel}</span><span class="tab-aantal num">{g.modellen.length} {g.modellen.length === 1 ? 'model' : 'modellen'}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-7">
          {wijzer.map((g, i) => {
            const foto = kaarten.find((k) => k.id === g.id)!;
            return (
              <div role="tabpanel" id={`paneel-${g.id}`} aria-labelledby={`tab-${g.id}`} data-paneel={g.id} class={`paneel kaart overflow-hidden ${i === 0 ? '' : 'verborgen'}`}>
                <Image src={foto.src} alt={foto.alt} widths={[500, 800, 1100]} sizes="(min-width: 1248px) 660px, (min-width: 1024px) 54vw, 92vw" class="aspect-[16/7] w-full object-cover" style={`object-position:${foto.pos}`} />
                <div class="p-6 md:p-8">
                  {g.modellen.length > 1 && (
                    <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label={`Modellen ${g.titel.toLowerCase()}`}>
                      {g.modellen.map((m, j) => <button type="button" class="model-knop" aria-pressed={j === 0 ? 'true' : 'false'} data-modelknop={j}>{m.naam}</button>)}
                    </div>
                  )}
                  {g.modellen.map((m, j) => (
                    <div class={`model ${j === 0 ? '' : 'verborgen'}`} data-model={j}>
                      <h3 class="text-2xl">{m.naam}</h3>
                      <p class="mt-2 text-grijs">{m.tekst}</p>
                      {(m.maat || m.bediening) && (
                        <dl class="mt-5 grid gap-x-8 gap-y-3 border-t border-lijn pt-5 text-sm sm:grid-cols-2">
                          {m.maat && <div><dt class="text-grijs">Maximale maat</dt><dd class="num mt-0.5 font-bold">{m.maat}</dd></div>}
                          {m.bediening && <div><dt class="text-grijs">Bediening</dt><dd class="mt-0.5 font-bold">{m.bediening}</dd></div>}
                        </dl>
                      )}
                      <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                        {m.kleuren.length > 0 ? (
                          <fieldset>
                            <legend class="text-sm text-grijs">Kleur: <b class="font-bold text-inkt" data-kleurnaam>kies een standaardkleur</b></legend>
                            <div class="mt-2.5 flex flex-wrap gap-2">
                              {m.kleuren.map((c) => (
                                <label class="kleur" title={ral[c].naam}>
                                  <input type="radio" name={`k-${g.id}-${j}`} value={ral[c].naam} class="sr-only" />
                                  <span style={`background:${ral[c].hex}`}><span class="sr-only">{ral[c].naam}</span></span>
                                </label>
                              ))}
                            </div>
                          </fieldset>
                        ) : <p class="text-sm text-grijs">Doek uit de collectie van Tibelly of Dickson.</p>}
                        <a href={waMet(waModel(g.product, m.naam))} data-wa-basis={waModel(g.product, m.naam)} class="knop knop-rood knop-klein shrink-0 self-start sm:self-auto"><Icoon naam="wa" />Offerte aanvragen</a>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            );
          })}
          <p class="mt-4 text-sm text-grijs">Kleuren op een scherm zijn een benadering.</p>
        </div>
      </div>
    </section>

    <!-- 6. Projecten -->
    <section id="projecten" class="donker bg-nacht py-24 text-licht lg:py-32" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-4 text-3xl">Door ons gerealiseerd.</h2>
          </div>
          <p class="rijs text-lg text-lila lg:col-span-4 lg:col-start-9" style="--d:.05s">Een greep uit ons werk bij particulieren en bedrijven, van een enkel rolluik tot een complete pergola.</p>
        </div>
        <ul class="mt-12 grid auto-rows-[9.5rem] grid-cols-2 gap-3 sm:auto-rows-[12rem] md:grid-cols-4 md:gap-4 lg:mt-14 lg:auto-rows-[12.5rem]">
          {projecten.map((p, i) => (
            <li class={`rijs group relative overflow-hidden rounded-md bg-nacht-2 ${p.cls}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={p.src} alt={p.alt} widths={[400, 700, 1000]} sizes={p.cls.includes('col-span-2') ? '(min-width: 1248px) 600px, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 300px, (min-width: 768px) 24vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
              <p class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#121316d9,#12131600)] px-4 pb-3 pt-10 text-sm font-semibold text-licht">{p.t}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-24" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 id="t-werk" class="rijs text-3xl lg:col-span-7">Van eerste gesprek tot montage, in eigen hand.</h2>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Wij assembleren zelf en monteren met ons eigen team. Zo houden we alles in eigen hand.</p>
        </div>
        <ol class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs border-t-2 border-inkt pt-6" style={`--d:${i * 0.06}s`}>
              <p class="num text-[2.5rem] font-extrabold leading-none tracking-[-0.05em] text-rood">0{i + 1}</p>
              <h3 class="mt-5 text-xl">{t}</h3>
              <p class="mt-2 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8. Over ons -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:col-span-6">
          <Image src={greup} alt="Zwarte markiezen boven de ramen van een grand café, met plantenbakken op het plein ervoor" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_60%]" />
          <p class="absolute bottom-4 left-4 rounded-md bg-rood px-3.5 py-1.5 text-sm font-bold text-wit">Ook voor bedrijven en instellingen</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over ons</p>
          <h2 id="t-over" class="mt-4 text-3xl">Sinds 1994 een begrip in de Hoeksche Waard.</h2>
          <p class="mt-6 text-lg text-lila">Perfect Zonwering is een begrip bij particulieren, maar zeker ook bij bedrijven en instellingen, binnen en buiten de Hoeksche Waard. Dankzij jarenlange ervaring weten we precies hoe uw wensen uitgevoerd kunnen worden.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-rood text-wit"><Icoon naam="schild" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Uitsluitend A-kwaliteit</h3><p class="mt-0.5 text-[.9375rem] text-lila">Kwaliteitsmerken en kwaliteitsproducten, met garantie.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-rood text-wit"><Icoon naam="fabriek" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Direct van de fabrikant</h3><p class="mt-0.5 text-[.9375rem] text-lila">Geen tussenhandel, dus maatwerk voor een zeer scherpe prijs.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
