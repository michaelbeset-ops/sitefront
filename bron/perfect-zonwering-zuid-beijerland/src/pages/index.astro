<script>
  // Productwijzer: tabs.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const kies = (id: string, focus = false) => {
    tabs.forEach((t) => { const aan = t.dataset.tab === id; t.setAttribute('aria-selected', String(aan)); t.tabIndex = aan ? 0 : -1; if (aan && focus) t.focus(); });
    document.querySelectorAll<HTMLElement>('[data-paneel]').forEach((p) => p.classList.toggle('verborgen', p.dataset.paneel !== id));
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => kies(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (d) { e.preventDefault(); kies(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-naar]').forEach((a) => a.addEventListener('click', () => kies(a.dataset.naar!)));

  // Modelkeuze binnen een productgroep.
  document.querySelectorAll<HTMLElement>('[data-paneel]').forEach((p) => {
    const knoppen = p.querySelectorAll<HTMLButtonElement>('[data-modelknop]');
    knoppen.forEach((k) => k.addEventListener('click', () => {
      knoppen.forEach((x) => x.setAttribute('aria-pressed', String(x === k)));
      p.querySelectorAll<HTMLElement>('[data-model]').forEach((m) => m.classList.toggle('verborgen', m.dataset.model !== k.dataset.modelknop));
    }));
  });

  // Kleurkeuze verwerken in het WhatsApp-bericht van dat model.
  document.querySelectorAll<HTMLElement>('[data-model]').forEach((m) => {
    const link = m.querySelector<HTMLAnchorElement>('[data-wa-basis]');
    const naam = m.querySelector<HTMLElement>('[data-kleurnaam]');
    m.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => r.addEventListener('change', () => {
      if (naam) naam.textContent = r.value;
      if (link) link.href = 'https://wa.me/31622061276?text=' + encodeURIComponent(link.dataset.waBasis!.replace('. Kunnen', ` in ${r.value}. Kunnen`));
    }));
  });

  // Offerteformulier: maakt een WhatsApp-bericht, verstuurt zelf niets.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hallo Perfect Zonwering, ik wil graag een offerte aanvragen.'];
      if (v('product')) r.push('Voor: ' + v('product').toLowerCase());
      if (v('plaats')) r.push('Woonplaats: ' + v('plaats'));
      if (v('wens')) r.push('Opmerking: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31622061276?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: .98; letter-spacing: -0.045em; }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-lila); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .3rem .75rem; border-radius: var(--radius-md); background: var(--color-wit); }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }

  .tab { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.9rem; padding: 0 1rem; border-radius: var(--radius-md); font-weight: 700; font-size: 1rem; text-align: left; white-space: nowrap; background: var(--color-wit); color: var(--color-inkt); cursor: pointer; transition: background-color .2s, color .2s; }
  @media (min-width: 1024px) { .tab { min-height: 3.4rem; padding: 0 1.25rem; font-size: 1.0625rem; background: transparent; border-left: 3px solid transparent; border-radius: 0 var(--radius-md) var(--radius-md) 0; } }
  .tab:hover { background: var(--color-wit); }
  .tab[aria-selected='true'] { background: var(--color-inkt); color: var(--color-licht); }
  @media (min-width: 1024px) { .tab[aria-selected='true'] { background: var(--color-wit); color: var(--color-inkt); border-left-color: var(--color-rood); box-shadow: var(--shadow-sm); } }
  .tab-aantal { font-size: .8125rem; font-weight: 600; opacity: .6; }
  :global(.js) .paneel.verborgen, :global(.js) .model.verborgen { display: none; }
  .model-knop { min-height: 2.5rem; padding: 0 .95rem; border-radius: var(--radius-md); background: var(--color-steen); font-size: .9375rem; font-weight: 700; cursor: pointer; transition: background-color .2s, color .2s; }
  .model-knop:hover { background: #ddd8d0; }
