            <label class="block"><span class="text-sm font-bold">Woonplaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-bold">Opmerking, maatvoering, kleur of bediening <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="4" class="veld mt-2" placeholder="Bijvoorbeeld: knikarmscherm van ongeveer 5 meter breed, antraciet, met afstandsbediening"></textarea></label>
          </div>
