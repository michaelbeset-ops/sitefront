  .kleur { cursor: pointer; }
  .kleur > span { display: block; width: 2.1rem; height: 2.1rem; border-radius: 999px; box-shadow: inset 0 0 0 1px #12131633; transition: box-shadow .2s, transform .2s; }
  .kleur:hover > span { transform: scale(1.08); }
  .kleur input:checked + span { box-shadow: inset 0 0 0 1px #12131633, 0 0 0 2px var(--color-wit), 0 0 0 4px var(--color-rood); }
  .kleur input:focus-visible + span { outline: 3px solid var(--color-rood); outline-offset: 4px; }

  .keuze span { display: inline-flex; align-items: center; min-height: 2.6rem; padding: 0 1rem; border-radius: var(--radius-md); background: var(--color-wit); box-shadow: inset 0 0 0 1px var(--color-lijn); font-size: .9375rem; font-weight: 600; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: var(--color-steen); }
  .keuze input:checked + span { background: var(--color-rood); color: #fff; box-shadow: none; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-rood); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-md); border: 1.5px solid #12131633; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #12131666; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-rood); }
  .veld::placeholder { color: #85828c; }
</style>
