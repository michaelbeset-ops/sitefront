---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Bestel from '../components/Bestel.astro';
import Wa from '../components/Wa.astro';
import { site, tijden, populair } from '../data/site';
import hero from '../assets/hero.jpg';
import interieur from '../assets/interieur.jpg';
import kip from '../assets/kip.jpg';
import broodje from '../assets/broodje.jpg';
import thee from '../assets/thee.jpg';
import feestje from '../assets/feestje.jpg';
import ontbijt from '../assets/ontbijt.jpg';
import koffie from '../assets/koffie.jpg';

const noemen = [
  'Goed gevulde broodjes en royale porties',
  'Alles halal',
  'Een onderscheidend menu',
  'Goede koffie en ice tea',
  'Tiramisu, ook om mee naar huis te nemen',
  'Snelle, vriendelijke service',
  'Een gezellige zaak, met terras voor én achter',
  'Ook voor feestjes en bestellingen',
];
const pijl = '<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base title={`${site.naam} | Lunchrestaurant aan de Markt in Panningen`} description="Bij Nadia, Markt 22 in Panningen: ontbijt, lunch en goed gevulde broodjes, alles halal. Terras aan de voor- en achterkant. Bestel of reserveer via WhatsApp.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative overflow-hidden bg-olijf text-room">
      <div class="wrap relative grid gap-x-10 gap-y-8 pb-12 pt-9 lg:grid-cols-12 lg:pb-0 lg:pt-14">
        <div class="lg:col-span-5">
          <p class="eyebrow text-citroen">Lunchrestaurant aan de Markt, Panningen</p>
          <h1 class="mt-4 text-4xl font-semibold lg:mt-5">
            <span class="block whitespace-nowrap italic">Bij Nadia</span>
            <span class="mt-3 block text-2xl font-medium leading-tight tracking-[-0.01em] text-citroen-zacht lg:mt-4">Ontbijt, lunch en goed gevulde broodjes</span>
          </h1>
        </div>

        <div class="relative lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1">
          <figure class="relative overflow-hidden rounded-2xl shadow-xl lg:rounded-b-none">
            <div class="aspect-[4/3] lg:aspect-auto lg:h-[min(44rem,calc(100vh-7.5rem))] lg:min-h-[34rem]">
              <Foto src={hero} alt="Een goed gevuld broodje met plakken worst, sla en saus, op de toonbank van Bij Nadia" class="object-[center_72%]" hero sizes="(min-width: 1024px) 58vw, 100vw" />
            </div>
          </figure>
          <figure class="absolute -bottom-5 left-3 w-[30%] max-w-[11rem] overflow-hidden rounded-xl border-4 border-olijf shadow-xl sm:left-6 lg:-left-12 lg:bottom-12">
            <div class="aspect-[3/4]"><Foto src={interieur} alt="Binnen bij Nadia: houten tafels met bloemen, hanglampen en een bank langs het raam" sizes="180px" /></div>
          </figure>
          <p class="absolute right-3 top-3 grid h-20 w-20 rotate-[8deg] place-items-center rounded-full bg-citroen text-center font-display text-base font-semibold italic leading-tight text-olijf shadow-md sm:right-5 sm:top-5 sm:h-28 sm:w-28 sm:text-xl">Alles<br />halal</p>
          <div class="absolute bottom-3 right-3 flex items-center gap-3 rounded-xl bg-papier px-4 py-3 text-inkt shadow-md sm:bottom-5 sm:right-5">
            <p class="font-display text-3xl font-semibold leading-none sm:text-4xl">{site.google.score}</p>
            <p class="text-xs leading-snug sm:text-sm"><span class="block text-blad" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>{site.google.aantal} Google-reviews</p>
          </div>
        </div>

        <div class="pt-2 lg:col-span-5 lg:pb-14 lg:pt-0">
          <p class="max-w-md text-lg text-room/85">Alles halal. Goede koffie, ice tea en tiramisu, ook om mee te nemen. Met een terras aan de voor- én achterkant.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#bestel" class="btn btn-citroen"><Wa />Bestel of reserveer</a>
            <a href={site.telHref} class="btn btn-lijn text-room"><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <div class="mt-8 max-w-md"><Status /></div>
        </div>
      </div>
    </section>

    <!-- WAT GASTEN NOEMEN -->
    <section class="licht bg-room py-16 lg:py-24" aria-labelledby="noemen">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-blad">Wat gasten noemen</p>
          <h2 id="noemen" class="mt-3 text-3xl">{site.google.score} uit {site.google.aantal} reviews</h2>
          <p class="mt-4 text-inkt-zacht">Samengevat uit de Google-reviews van Bij Nadia.</p>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-xl bg-lijn shadow-sm ring-1 ring-lijn sm:grid-cols-2 lg:col-span-8">
          {noemen.map((n) => (
            <li class="flex items-start gap-3 bg-papier p-5">
              <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-1 h-4 w-4 shrink-0"><ellipse cx="10" cy="11" rx="7" ry="5.4" transform="rotate(-20 10 11)" fill="#f7d648" stroke="#2f5d2a" stroke-width="1"/></svg>
              <span class="font-semibold leading-snug">{n}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- POPULAIR -->
    <section id="populair" class="licht scroll-mt-16 bg-papier py-16 lg:py-24" aria-labelledby="popkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <figure class="overflow-hidden rounded-2xl shadow-md lg:col-span-5 lg:row-span-2">
          <div class="aspect-[4/5] h-full"><Foto src={kip} alt="Broodje met gekruide stukjes kip en sla op een houten plank" sizes="(min-width: 1024px) 40vw, 100vw" /></div>
        </figure>
        <div class="lg:col-span-7">
          <p class="eyebrow text-blad">Van de kaart</p>
          <h2 id="popkop" class="mt-3 text-3xl">Populair bij gasten</h2>
          <p class="mt-4 max-w-xl text-inkt-zacht">De broodjes worden het vaakst genoemd. Dit bestellen gasten graag:</p>
          <ol class="mt-8 border-t border-lijn">
            {populair.map((p, i) => (
              <li class="flex items-baseline gap-4 border-b border-lijn py-4">
                <span class="w-7 shrink-0 font-body text-sm font-bold tabular-nums text-blad">{String(i + 1).padStart(2, '0')}</span>
                <span class="min-w-0 flex-1 font-display text-2xl font-medium italic leading-tight">{p.naam}</span>
                <span class="hidden shrink-0 text-sm text-inkt-zacht sm:block">{p.soort}</span>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-xs text-inkt-zacht">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
        </div>
        <div class="grid grid-cols-2 gap-4 lg:col-span-7">
          <figure class="overflow-hidden rounded-xl shadow-sm"><div class="aspect-square"><Foto src={broodje} alt="Broodje met krokante kip, sla en saus op een houten plank" sizes="(min-width: 1024px) 28vw, 50vw" /></div></figure>
          <figure class="overflow-hidden rounded-xl shadow-sm"><div class="aspect-square"><Foto src={thee} alt="Zilveren theepot met twee glaasjes thee en suikerklontjes op een bewerkt dienblad" sizes="(min-width: 1024px) 28vw, 50vw" /></div></figure>
        </div>
      </div>
    </section>

    <!-- ONTBIJT, LUNCH EN TERRAS -->
    <section class="bg-olijf py-16 text-room lg:py-24" aria-labelledby="terraskop">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12">
        <div class="relative lg:col-span-7">
          <figure class="overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[3/2]"><Foto src={ontbijt} alt="Sfeerbeeld: ontbijt met gebakken eieren en een kop koffie buiten aan tafel" sizes="(min-width: 1024px) 58vw, 100vw" /></div>
          </figure>
          <figure class="absolute -bottom-8 right-4 hidden w-[38%] overflow-hidden rounded-xl border-4 border-olijf shadow-xl sm:block lg:-right-8">
            <div class="aspect-[4/3]"><Foto src={koffie} alt="Sfeerbeeld: cappuccino met een croissant" sizes="300px" /></div>
          </figure>
        </div>
        <div class="lg:col-span-5">
          <p class="eyebrow text-citroen">Ontbijt en lunch</p>
          <h2 id="terraskop" class="mt-3 text-3xl">Een terras aan de voor- én achterkant</h2>
          <p class="mt-5 text-room/85">Van ontbijt tot lunch, binnen aan tafel of buiten op een van de twee terrassen. Met goede koffie of een ice tea erbij.</p>
          <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-lijn-licht">
            <div class="bg-olijf-2 p-4"><dt class="text-sm text-room/75">Di t/m za vanaf</dt><dd class="mt-1 whitespace-nowrap font-display text-2xl font-semibold tabular-nums">09.30</dd></div>
            <div class="bg-olijf-2 p-4"><dt class="text-sm text-room/75">Zondag vanaf</dt><dd class="mt-1 whitespace-nowrap font-display text-2xl font-semibold tabular-nums">11.00</dd></div>
          </dl>
          <a href="#bestel" class="btn btn-citroen mt-8" data-kies="tafel">Reserveer een tafel <Fragment set:html={pijl} /></a>
        </div>
      </div>
    </section>

    <!-- FEESTJE -->
    <section class="licht bg-room py-16 lg:py-24" aria-labelledby="feestkop">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="order-2 lg:order-1 lg:col-span-5">
          <p class="eyebrow text-blad">Feestje of bestelling</p>
          <h2 id="feestkop" class="mt-3 text-3xl">Iets te vieren? Bestel bij Nadia</h2>
          <p class="mt-5 text-inkt-zacht">Gasten bestellen ook voor feestjes. Geef via WhatsApp door voor wanneer en voor hoeveel personen, dan hoort u van ons.</p>
          <a href="#bestel" class="btn btn-blad mt-8" data-kies="feestje">Bestelling voor een feestje <Fragment set:html={pijl} /></a>
        </div>
        <figure class="order-1 overflow-hidden rounded-2xl shadow-md lg:order-2 lg:col-span-7">
          <div class="aspect-[4/3]"><Foto src={feestje} alt="Een bestelling van Bij Nadia op een gedekte tafel: schaal met broodjes, croissants en gebak, met bakjes salade en flesjes sap" sizes="(min-width: 1024px) 58vw, 100vw" /></div>
        </figure>
      </div>
    </section>

    <!-- BESTEL OF RESERVEER -->
    <section id="bestel" class="scroll-mt-16 bg-olijf-2 py-16 text-room lg:py-24" aria-labelledby="bestelkop">
      <div class="wrap">
        <div class="max-w-2xl">
          <p class="eyebrow text-citroen">Bestel of reserveer</p>
          <h2 id="bestelkop" class="mt-3 text-3xl">Zet het klaar in WhatsApp</h2>
          <p class="mt-5 text-room/85">Kies ontbijt, lunch of een feestje, afhalen of aan tafel, en wanneer. Uw bericht staat meteen klaar.</p>
        </div>
        <div class="mt-10"><Bestel /></div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="licht scroll-mt-16 bg-papier py-16 lg:py-24" aria-labelledby="contactkop">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-blad">Route en contact</p>
          <h2 id="contactkop" class="mt-3 text-3xl">Aan de Markt in Panningen</h2>
          <address class="mt-6 not-italic text-lg">
            <strong class="font-display text-2xl font-semibold italic">{site.naam}</strong><br />
            {site.straat}<br />{site.postcode} {site.plaats}
          </address>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.wa} class="btn btn-wa"><Wa />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-inkt hover:!bg-olijf hover:!text-room hover:!shadow-none"><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <a href={site.maps} class="mt-6 inline-flex items-center gap-2 font-semibold text-blad underline underline-offset-4">Route plannen <Fragment set:html={pijl} /></a>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-xl bg-room p-6 shadow-sm ring-1 ring-lijn sm:p-8">
            <h3 class="text-2xl">Openingstijden</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden per dag</caption>
              <tbody>
                {tijden.map((d) => (
                  <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                    <th scope="row" class="py-3 font-semibold">{d.dag}</th>
                    <td class={`whitespace-nowrap py-3 text-right tabular-nums ${d.van ? 'font-semibold' : 'text-inkt-zacht'}`}>{d.van ? `${d.van.replace(':', '.')} - ${d.tot!.replace(':', '.')}` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-blad); }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  import { nuInPanningen, wdVan } from '../scripts/open';
  document.querySelector(`.dagrij[data-wd="${wdVan(nuInPanningen().ymd)}"]`)?.classList.add('vandaag');
  // Knoppen die het bestelblok alvast op "aan tafel" of "feestje" zetten.
  document.querySelectorAll<HTMLAnchorElement>('[data-kies]').forEach((a) => a.addEventListener('click', () => {
    const k = a.dataset.kies;
    const input = document.querySelector<HTMLInputElement>(k === 'feestje' ? 'input[name="wat"][value="feestje"]' : 'input[name="hoe"][value="tafel"]');
    if (!input) return;
    if (k === 'tafel') { const w = document.querySelector<HTMLInputElement>('input[name="wat"][value="feestje"]'); if (w?.checked) document.querySelector<HTMLInputElement>('input[name="wat"][value="lunch"]')!.checked = true; }
    input.checked = true;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  }));
</script>
