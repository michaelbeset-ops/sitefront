---
// Wow-functie "Bestel of reserveer": ontbijt of lunch, afhalen of aan tafel (binnen, terras voor of achter),
// of een bestelling voor een feestje. Kiest dag en tijd binnen de openingstijden en zet alles klaar als
// WhatsApp-bericht. Er gaat pas iets weg als de gast in WhatsApp zelf op verzenden drukt.
import { site, populair } from '../data/site';
import Wa from './Wa.astro';
const veld = 'mt-1.5 block w-full rounded-lg border border-lijn bg-white px-3.5 py-3 text-inkt shadow-sm transition-colors focus:border-blad';
const keuze = 'keuze relative flex cursor-pointer items-center justify-center rounded-lg bg-white px-3 py-3 text-center text-sm font-semibold shadow-sm ring-1 ring-lijn transition-all hover:ring-blad';
---
<form id="bestel-form" class="grid gap-8 lg:grid-cols-12 lg:gap-10" novalidate>
  <div class="licht grid gap-7 rounded-2xl bg-papier text-inkt p-5 shadow-xl ring-1 ring-lijn sm:p-8 lg:col-span-7">
    <fieldset>
      <legend class="flex items-baseline gap-3 font-display text-xl font-semibold"><span class="font-body text-sm font-bold text-blad">1</span>Waarvoor?</legend>
      <div class="mt-3 grid grid-cols-1 gap-2 min-[400px]:grid-cols-3">
        <label class={keuze}><input type="radio" name="wat" value="ontbijt" class="sr-only" />Ontbijt</label>
        <label class={keuze}><input type="radio" name="wat" value="lunch" class="sr-only" checked />Lunch</label>
        <label class={keuze}><input type="radio" name="wat" value="feestje" class="sr-only" />Voor een feestje</label>
      </div>
    </fieldset>

    <fieldset data-hoe>
      <legend class="flex items-baseline gap-3 font-display text-xl font-semibold"><span class="font-body text-sm font-bold text-blad">2</span>Afhalen of aan tafel?</legend>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <label class={keuze}><input type="radio" name="hoe" value="afhalen" class="sr-only" checked />Afhalen</label>
        <label class={keuze}><input type="radio" name="hoe" value="tafel" class="sr-only" />Aan tafel</label>
      </div>
      <div class="mt-3 grid grid-cols-1 gap-2 min-[400px]:grid-cols-3" data-plek hidden>
        <label class={keuze}><input type="radio" name="plek" value="binnen" class="sr-only" checked />Binnen</label>
        <label class={keuze}><input type="radio" name="plek" value="voor" class="sr-only" />Terras voor</label>
        <label class={keuze}><input type="radio" name="plek" value="achter" class="sr-only" />Terras achter</label>
      </div>
    </fieldset>

    <p class="-mt-3 hidden rounded-lg bg-room px-4 py-3 text-sm" data-feest-uitleg>Voor een feestje geeft u hier uw bestelling door. Vertel bij opmerkingen wat u in gedachten heeft.</p>

    <fieldset>
      <legend class="flex items-baseline gap-3 font-display text-xl font-semibold"><span class="font-body text-sm font-bold text-blad">3</span>Populair bij gasten</legend>
      <ul class="mt-3 divide-y divide-lijn overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-lijn">
        {populair.map((p) => (
          <li class="flex items-center justify-between gap-3 px-4 py-3" data-item={p.id} data-naam={p.naam}>
            <span class="min-w-0">
              <span class="block font-semibold leading-snug">{p.naam}</span>
              <span class="block text-xs text-inkt-zacht">{p.soort}</span>
            </span>
            <span class="flex shrink-0 items-center gap-1">
              <button type="button" class="stap grid h-9 w-9 place-items-center rounded-full text-lg font-bold text-blad ring-1 ring-lijn transition-colors hover:bg-room" data-min aria-label={`Eén ${p.naam} minder`}>&minus;</button>
              <label class="sr-only" for={`n-${p.id}`}>Aantal {p.naam}</label>
              <input id={`n-${p.id}`} name={`n-${p.id}`} type="number" inputmode="numeric" min="0" max="99" value="0" class="h-9 w-11 rounded-md border-0 bg-transparent text-center font-semibold tabular-nums" />
              <button type="button" class="stap grid h-9 w-9 place-items-center rounded-full bg-blad text-lg font-bold text-white transition-colors hover:bg-olijf" data-plus aria-label={`Eén ${p.naam} erbij`}>+</button>
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-2 text-xs text-inkt-zacht">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
    </fieldset>

    <fieldset>
      <legend class="flex items-baseline gap-3 font-display text-xl font-semibold"><span class="font-body text-sm font-bold text-blad">4</span>Wanneer?</legend>
      <div class="mt-3 grid gap-4 sm:grid-cols-3">
        <label class="block text-sm font-semibold">Dag
          <input type="date" name="datum" class={veld} />
        </label>
        <label class="block text-sm font-semibold">Tijd
          <select name="tijd" class={veld}><option value="">Kies eerst een dag</option></select>
        </label>
        <label class="block text-sm font-semibold">Personen
          <input type="number" name="personen" min="1" max="200" value="2" inputmode="numeric" class={veld} />
        </label>
      </div>
      <p class="mt-3 text-sm text-inkt-zacht" data-dagmelding aria-live="polite">Dinsdag t/m zaterdag vanaf 09.30 uur, zondag vanaf 11.00 uur. Maandag gesloten.</p>
    </fieldset>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block text-sm font-semibold">Uw naam
        <input type="text" name="naam" autocomplete="name" class={veld} />
      </label>
      <label class="block text-sm font-semibold sm:col-span-2">Opmerkingen <span class="font-normal text-inkt-zacht">(wensen, iets anders van de kaart)</span>
        <textarea name="opmerking" rows="3" class={veld}></textarea>
      </label>
    </div>
  </div>

  <div class="lg:col-span-5">
    <div class="lg:sticky lg:top-24">
      <p class="eyebrow text-citroen">Uw bericht</p>
      <div class="mt-3 rounded-2xl bg-[#e9e2c9] p-4 shadow-xl sm:p-5">
        <div class="relative ml-auto max-w-[95%] rounded-xl rounded-tr-sm bg-[#dcf5c4] px-4 py-3 text-[0.95rem] leading-relaxed text-inkt shadow-sm">
          <p class="whitespace-pre-line break-words" data-bericht aria-live="polite">Hallo, ik wil graag lunch bestellen om af te halen.</p>
        </div>
      </div>
      <a href={site.wa} class="btn btn-citroen mt-5 w-full !py-4 text-lg" data-wa><Wa />Open in WhatsApp</a>
      <p class="mt-3 text-sm text-room/80">U ziet het bericht eerst in WhatsApp en verstuurt het zelf. Liever bellen? <a href={site.telHref} class="whitespace-nowrap font-semibold tabular-nums text-citroen underline underline-offset-2">{site.tel}</a></p>
      <p class="mt-2 text-sm text-citroen-zacht" data-waarschuwing aria-live="polite"></p>
    </div>
  </div>
</form>

<style>
  .keuze:has(input:checked) { background: var(--color-blad); color: var(--color-white); box-shadow: none; }
  .keuze:has(input:focus-visible) { outline: 3px solid var(--color-blad); outline-offset: 2px; }
  input[type='number']::-webkit-inner-spin-button { opacity: .4; }
</style>

<script>
  import { UREN, kwartieren, wdVan, dagNaam, nuInPanningen, plusDagen, punt } from '../scripts/open';
  const f = document.getElementById('bestel-form') as HTMLFormElement;
  const $ = <T extends Element>(s: string) => f.querySelector<T>(s)!;
  const el = (n: string) => f.elements.namedItem(n) as HTMLInputElement;
  const bericht = $<HTMLElement>('[data-bericht]');
  const knop = $<HTMLAnchorElement>('[data-wa]');
  const melding = $<HTMLElement>('[data-dagmelding]');
  const waarsch = $<HTMLElement>('[data-waarschuwing]');
  const tijd = f.elements.namedItem('tijd') as HTMLSelectElement;
  const datum = el('datum');
  const basis = knop.href;
  const nu = nuInPanningen();

  // Eerste open dag als standaard (vandaag als er nog tijd is).
  datum.min = nu.ymd;
  let start = nu.ymd;
  for (let i = 0; i < 8; i++) {
    const d = plusDagen(nu.ymd, i), k = kwartieren(wdVan(d)).filter((t) => i > 0 || t > nu.hm);
    if (k.length) { start = d; break; }
  }
  datum.value = start;

  const radio = (n: string) => (f.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value ?? '');

  function vulTijden() {
    const d = datum.value, oud = tijd.value;
    tijd.innerHTML = '';
    if (!d) { tijd.add(new Option('Kies eerst een dag', '')); tijd.disabled = true; return; }
    const wd = wdVan(d), u = UREN[wd];
    let lijst = kwartieren(wd);
    if (d === nu.ymd) lijst = lijst.filter((t) => t > nu.hm);
    if (d < nu.ymd) { melding.textContent = 'Die dag is al voorbij. Kies een andere dag.'; lijst = []; }
    else if (!u) melding.textContent = 'Op maandag zijn wij gesloten. Kies een andere dag.';
    else if (!lijst.length) melding.textContent = 'Vandaag kan het niet meer. Kies een andere dag.';
    else melding.textContent = `${dagNaam(d).replace(/^./, (c) => c.toUpperCase())}: open van ${punt(u[0])} tot ${punt(u[1])} uur.`;
    if (!lijst.length) { tijd.add(new Option('Gesloten', '')); tijd.disabled = true; return; }
    tijd.disabled = false;
    const wat = radio('wat');
    for (const t of lijst) tijd.add(new Option(`${punt(t)} uur`, t));
    tijd.value = lijst.includes(oud) ? oud : (wat === 'lunch' ? (lijst.find((t) => t >= '12:00') ?? lijst[0]) : lijst[0]);
  }

  function werkBij() {
    const wat = radio('wat');
    const feest = wat === 'feestje';
    const hoe = feest ? 'feest' : radio('hoe');
    const plek = radio('plek');
    $<HTMLElement>('[data-hoe]').hidden = feest;
    $<HTMLElement>('[data-feest-uitleg]').classList.toggle('hidden', !feest);
    $<HTMLElement>('[data-plek]').hidden = hoe !== 'tafel';

    const items = [...f.querySelectorAll<HTMLElement>('[data-item]')]
      .map((li) => ({ naam: li.dataset.naam!, n: Math.max(0, Math.min(99, Number(li.querySelector('input')!.value) || 0)) }))
      .filter((x) => x.n > 0);
    const pers = Number(el('personen').value) || 0;
    const naam = el('naam').value.trim();
    const opm = (f.elements.namedItem('opmerking') as HTMLTextAreaElement).value.trim();
    const plekTekst = { binnen: 'binnen', voor: 'op het terras aan de voorkant', achter: 'op het terras aan de achterkant' }[plek] ?? 'binnen';
    const moment = wat === 'ontbijt' ? 'het ontbijt' : 'de lunch';

    let kop: string;
    if (feest) kop = 'Hallo, ik wil graag een bestelling doen voor een feestje.';
    else if (hoe === 'tafel') kop = `Hallo, ik wil graag een tafel reserveren voor ${moment}, ${plekTekst}.`;
    else kop = `Hallo, ik wil graag ${wat === 'ontbijt' ? 'ontbijt' : 'lunch'} bestellen om af te halen.`;

    const d = datum.value, t = tijd.value;
    const regels = [kop, ''];
    if (d && t) regels.push(`${hoe === 'afhalen' ? 'Ophalen' : 'Dag'}: ${dagNaam(d)} om ${punt(t)} uur`);
    if (hoe === 'tafel' || feest) regels.push(`Aantal personen: ${pers}`);
    if (items.length) { regels.push('', hoe === 'tafel' ? 'Graag alvast:' : 'Bestelling:'); items.forEach((x) => regels.push(`- ${x.n}x ${x.naam}`)); }
    if (opm) regels.push('', `Opmerking: ${opm}`);
    if (naam) regels.push('', `Groet, ${naam}`);
    const tekst = regels.join('\n');
    bericht.textContent = tekst;

    const ok = Boolean(d && t);
    knop.href = `${basis}?text=${encodeURIComponent(tekst)}`;
    knop.setAttribute('aria-disabled', String(!ok));
    knop.classList.toggle('opacity-60', !ok);
    waarsch.textContent = ok ? '' : 'Kies een dag en tijd waarop wij open zijn.';
  }

  knop.addEventListener('click', (e) => { if (knop.getAttribute('aria-disabled') === 'true') e.preventDefault(); });
  f.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-min],[data-plus]');
    if (!b) return;
    const inp = b.closest('li')!.querySelector('input')!;
    inp.value = String(Math.max(0, Math.min(99, (Number(inp.value) || 0) + (b.hasAttribute('data-plus') ? 1 : -1))));
    werkBij();
  });
  f.addEventListener('input', (e) => { if (e.target === datum || (e.target as HTMLInputElement).name === 'wat') vulTijden(); werkBij(); });
  f.addEventListener('change', (e) => { if (e.target === datum) vulTijden(); werkBij(); });
  f.addEventListener('submit', (e) => e.preventDefault());
  vulTijden();
  werkBij();
</script>
