---
// Typografisch woordmerk: "Bij Nadia" in Fraunces cursief met een citroen als beeldmerk (geen bestaand logo bekend).
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg aria-hidden="true" viewBox="0 0 32 32" class="h-8 w-8 shrink-0"><ellipse cx="15" cy="18" rx="11" ry="8.5" transform="rotate(-20 15 18)" fill="#f7d648" stroke={licht ? '#2f5d2a' : 'none'} stroke-width="1.2"/><path d="M8.5 20.5c2.5 2.6 7 3.4 11 1.6" fill="none" stroke="#e1b61f" stroke-width="1.3" stroke-linecap="round"/><path d="M19.2 8.6c2-3 5.2-3.7 7.4-3-1 2.8-3.8 4.3-7.4 3z" fill="#7fae4a"/></svg>
  <span class="flex flex-col leading-none">
    <span class={`eyebrow !text-[0.625rem] !tracking-[0.26em] ${licht ? 'text-inkt-zacht' : 'text-citroen-zacht'}`}>Panningen</span>
    <span class="whitespace-nowrap font-display text-xl font-semibold italic tracking-[-0.01em]">Bij Nadia</span>
  </span>
</span>
