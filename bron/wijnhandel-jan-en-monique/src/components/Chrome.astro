---
import { site, url } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const thuis = Astro.url.pathname.replace(/\/$/, '') === url('').replace(/\/$/, '');
const anker = (id: string) => (thuis ? `#${id}` : `${url('')}#${id}`);
const nav = [
  { id: 'verkenner', t: 'Assortiment' },
  { id: 'borrel', t: 'Borrel en receptie' },
  { id: 'proeverij', t: 'Proeverij' },
  { id: 'contact', t: 'Contact' },
];
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-creme/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="text-wijn no-underline"><Logo class="h-11 sm:h-12" /></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm font-semibold">
          {nav.map((n) => <li><a href={anker(n.id)} class="no-underline decoration-wijn decoration-2 underline-offset-8 transition-colors hover:text-wijn hover:underline">{n.t}</a></li>)}
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-wijn !px-4 !py-2.5">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        <span class="sm:hidden">Bel</span><span class="hidden whitespace-nowrap tabular-nums sm:inline">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="donker bg-nacht py-14 text-white/80">
    <div class="wrap grid gap-10 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo class="w-56 text-messing" />
        <p class="mt-6">{site.straat}<br />{site.postcode} {site.plaats}<br />KvK <span class="text-white/75">{site.kvk}</span></p>
      </div>
      <p class="md:col-span-4"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 text-xs">Sfeerfoto's via Unsplash en foto's van de huidige website, ter illustratie. Bij oplevering vervangen we ze door nieuwe eigen foto's.</p>}
  </footer>
)}
