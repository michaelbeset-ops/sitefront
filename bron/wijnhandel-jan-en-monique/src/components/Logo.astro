---
// Hun eigen logo (ovaal met druiventrossen en wijnranken) als masker: dezelfde vorm, gekleurd in de huisstijl.
// De tekst in het ovaal is uitgespaard, dus die krijgt vanzelf de achtergrondkleur.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} role="img" aria-label="Wijnhandel & Slijterij Jan & Monique"></span>
