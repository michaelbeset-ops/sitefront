---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Logo from '../components/Logo.astro';
import { site, tijden } from '../data/site';
import hero from '../assets/hero.jpg';
import proeverijFoto from '../assets/proeverij.jpg';
import borrelFoto from '../assets/borrel.jpg';
import pand from '../assets/pand.jpg';
import whiskyWand from '../assets/whisky-wand.jpg';
import roseSchap from '../assets/rose-schap.jpg';
import muifel from '../assets/muifel.jpg';
import loneWolf from '../assets/lone-wolf-gold.jpg';
import taylors from '../assets/taylors-50.jpg';
import teeling from '../assets/teeling.jpg';
import islay from '../assets/islay.jpg';
import vink from '../assets/vink.jpg';
import monteCristo from '../assets/monte-cristo.jpg';
import rutte from '../assets/rutte.jpg';
import moonshine from '../assets/moonshine.jpg';
import bernardus from '../assets/bernardus.jpg';

// Verkenner: per schap de producten zoals zij ze zelf op hun site noemen (Wijn, Whisky, Gedistilleerd, Speciaal bier, Geschenken, Wijnproeverij).
const schappen = [
  {
    id: 'wijn', naam: 'Wijn', sub: 'Rosé, wit, rood en port', foto: roseSchap, w: [600, 1000, 1400],
    alt: 'Een schap in onze winkel met rosé uit de Provence: Ultimate Provence, MiP en AIX',
    bij: 'Rosé uit de Provence in ons schap',
    intro: 'In onze winkel een ongekend aantal wijnen uit alle wijnlanden ter wereld. Een greep:',
    items: [
      ['AIX rosé', 'Vin de Provence, heerlijke lichte rosé.'],
      ['Mip, UP en Aix', 'Provence rosé, ook als magnum van 1,5 liter.'],
      ['Rosé Plage du Sud', ''],
      ['Bernardus', 'Chardonnay en Pinot Noir uit Californië.'],
      ['Boschendal', 'Een mooie serie Boschendal wijnen.'],
      ['Viu Manent Gran Reserva', "Uit Chili, een mooie serie gran reserva's."],
      ["Taylor's Port 50 years", '50 jaar oude port.'],
    ],
    extra: 'Verder onder andere de wijnen van Viu Manent, Virgini, Simonsig, Louis Jadot, Pouilly-Fumé en Chablis.',
  },
  {
    id: 'whisky', naam: 'Whisky', sub: 'Van Highland tot Islay', foto: whiskyWand, w: [600, 1000, 1400],
    alt: "Vijf flessen malt whisky van Douglas Laing's op een houten plankje in onze winkel: Big Peat, Rock Island, Scallywag, Timorous Beastie en The Epicurean",
    bij: 'Vijf malt whisky’s op een plankje, van Islay tot Lowland',
    intro: 'Wilt u informatie over een whisky, laat het ons weten. Een greep uit het schap:',
    items: [
      ['Teeling', 'Ierse whiskey, een mooie serie. U kunt ze bij ons proeven.'],
      ['Teeling Renaissance 18 jaar', 'Gerijpt op pineau des charentes vaten.'],
      ['Teeling 25 years', 'Single cask, gerijpt op rumvaten.'],
      ['Penderyn Legend', 'Single malt whisky uit Wales.'],
      ['Vink Whisky', 'Dutch whisky, limited batch. Gedistilleerd in Zaandam.'],
      ['Brewdog', 'Een mooie samenwerking met Brewdog, Zuidam en Duncan Taylor.'],
      ['Plankje met 5 soorten malt whisky', 'Van Highland tot Islay. Een mooie set, met gratis plankje.'],
    ],
    extra: 'Ook onder andere The Glenlivet 18 jaar, Glenfiddich 15 jaar en diverse whisky’s van Islay.',
  },
  {
    id: 'gedistilleerd', naam: 'Gedistilleerd', sub: 'Jenever, gin, likeur, cognac', foto: loneWolf, w: [600, 1000, 1440],
    alt: 'Flessen Lone Wolf gin van Brewdog en Gold vodka in ons schap',
    bij: 'Lone Wolf gin en Gold vodka',
    intro: 'Van jenever van exclusieve kwaliteit tot likeur uit Dordrecht:',
    items: [
      ['Barak 51', 'Jenever met geschiedenis.'],
      ["Bobby's Gin", 'Limited, in een mooie houten kist. 5 jaar gerijpt.'],
      ['Brewdog Lone Wolf gin', 'In verschillende smaken.'],
      ['Gold vodka', 'Nieuw in ons assortiment.'],
      ['Hennessy cognac', ''],
      ["O'Donnell Moonshine", 'In verschillende smaken.'],
      ['Peaky Blinders', 'Gin en whisky.'],
      ['Rutte likeur', 'Uit Dordrecht, van Distilleerderij Rutte.'],
      ['Voerman Vieux', 'Dutch Spice brandy.'],
    ],
    extra: '',
  },
  {
    id: 'bier', naam: 'Speciaal bier', sub: 'Stout, vatgerijpt, Muifel', foto: muifel, w: [600, 1000, 1400],
    alt: 'Een rij flessen speciaalbier van Brouwerij Muifel in ons schap',
    bij: 'De serie van Brouwerij Muifel',
    intro: 'Speciaal bier om te proeven, te geven of mee te nemen naar de barbecue:',
    items: [
      ['Monte Cristo', 'Donkere stout, vol van smaak en op sherryvaten gerijpt.'],
      ['Muifel', 'Een mooie serie Muifel bieren.'],
      ['To Øl', 'Goliat en Confidence.'],
      ['Wild Mill', 'Perfecte bieren voor en bij de barbecue. Dark en op PX-vaten gerijpt.'],
    ],
    extra: '',
  },
  {
    id: 'geschenken', naam: 'Geschenken', sub: 'Inpakken, cadeaubon, relatiegeschenk', foto: taylors, w: [560, 1124],
    alt: "Een fles Taylor's 50 jaar oude port naast zijn houten kist en een glas port",
    bij: "Taylor's Port 50 years, in kist",
    intro: 'Wijn, jenever, whisky, cognac of een flesje bier: wij pakken uw geschenk feestelijk in.',
    items: [
      ['Cadeaubon', 'Geen stukje papier, maar een leuk bewerkt plankje. In de waarden van € 10 t/m € 25.'],
      ['Franse wijn wit/rood in kist', 'Voorbeeld van een relatiegeschenk.'],
      ['Italiaanse wijn, twee rode wijnen in kist', 'Voorbeeld van een relatiegeschenk.'],
      ['Italiaanse wijn wit/rood in kist', 'Voorbeeld van een relatiegeschenk.'],
    ],
    extra: 'Relatie- en kerstgeschenken stellen we samen naar uw wens. Kom langs, dan laten we zien wat de mogelijkheden zijn.',
  },
  {
    id: 'proeven', naam: 'Proeverij', sub: 'Bier, whisky en wijn', foto: proeverijFoto, w: [600, 1000, 1400],
    alt: 'Vier proefglazen met wijn en port, van licht naar donker, op een houten vat',
    bij: 'Sfeerbeeld',
    intro: 'Op afspraak verzorgen wij bier-, whisky- en wijnproeverijen voor kleine groepen.',
    items: [
      ['Wijnproeverij', ''],
      ['Whiskyproeverij', ''],
      ['Bierproeverij', ''],
    ],
    extra: 'Vraag vrijblijvend informatie aan, of kom langs in de slijterij en vertel uw wensen.',
  },
];

const schap = [
  { src: teeling, w: [480, 720], alt: 'Een wand met flessen en kokers van Teeling Irish whiskey in onze winkel', bij: 'Teeling, Ierse whiskey' },
  { src: islay, w: [480, 800], alt: 'Whisky uit Schotland in kokers en dozen, onder andere Bowmore 18 en Lagavulin', bij: 'Islay en Schotland' },
  { src: vink, w: [480, 800], alt: 'Een fles Vink whisky voor de oranje doos', bij: 'Vink, Dutch whisky', cls: 'object-[15%_50%]' },
  { src: monteCristo, w: [480, 800], alt: 'Drie flessen Monte Cristo stout', bij: 'Monte Cristo stout' },
  { src: rutte, w: [480, 800], alt: 'Een rij flessen likeur van Distilleerderij Rutte', bij: 'Rutte, uit Dordrecht' },
  { src: moonshine, w: [480, 800], alt: "Potten O'Donnell Moonshine met twee bekers", bij: "O'Donnell Moonshine" },
];

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>`;
---
<Base
  title="Wijnhandel & Slijterij Jan & Monique | Wijn, whisky en speciaal bier in Ridderkerk"
  description="Knusse wijnhandel en slijterij aan de Prinses Margrietstraat 2 in Ridderkerk. Wijn, whisky, gedistilleerd, speciaal bier, geschenken en proeverijen op afspraak."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: logo in messing en grote kop links, rechts een grote sfeerfoto die over de rand valt, met hun eigen whiskyschap als inzet. -->
    <section class="donker relative bg-nacht text-white">
      <div class="wrap grid gap-12 pt-10 sm:pt-14 lg:grid-cols-12 lg:gap-10 lg:pt-16">
        <div class="lg:col-span-6 lg:pb-32">
          <Logo class="w-56 text-messing sm:w-72" />
          <p class="kicker mt-8 text-messing">Ridderkerk, Prinses Margrietstraat 2</p>
          <h1 class="mt-4 text-4xl">Een knusse wijnhandel en slijterij, in oude stijl</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">Wijn uit alle wijnlanden ter wereld, whisky, jenever van exclusieve kwaliteit, speciaal bier en geschenken. En bij Jan &amp; Monique mag u proeven.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-messing"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href="#verkenner" class="btn btn-line">Waar bent u naar op zoek?</a>
          </div>
          <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/15 pt-6 text-sm sm:grid-cols-4">
            <div><dt class="text-white/75">Google</dt><dd><strong class="font-display text-2xl font-semibold">{site.google}</strong> <span class="text-white/80 whitespace-nowrap">({site.reviews} reviews)</span></dd></div>
            <div><dt class="text-white/75">Di t/m do</dt><dd class="font-display text-lg font-semibold whitespace-nowrap tabular-nums">10.00 - 17.30</dd></div>
            <div><dt class="text-white/75">Vrijdag</dt><dd class="font-display text-lg font-semibold whitespace-nowrap tabular-nums">10.00 - 18.00</dd></div>
            <div><dt class="text-white/75">Zaterdag</dt><dd class="font-display text-lg font-semibold whitespace-nowrap tabular-nums">10.00 - 16.00</dd></div>
          </dl>
          <p class="mt-4 text-sm text-white/75">Buiten openingstijden uw bestelling ophalen? Neem contact met ons op.</p>
        </div>
        <div class="relative lg:static lg:col-span-6">
          <figure class="relative -mb-24 overflow-hidden rounded-xl shadow-lg sm:-mb-32 lg:absolute lg:inset-y-0 lg:right-0 lg:left-1/2 lg:mb-0 lg:rounded-none lg:shadow-none">
            <div class="aspect-[4/3] lg:aspect-auto lg:h-full"><Foto src={hero} alt="Whisky wordt uit een fles in een proefglas geschonken, met twee glazen ernaast" hero sizes="(min-width: 1024px) 50vw, 100vw" widths={[480, 800, 1200, 1600, 2000]} class="object-[48%_50%] lg:object-[42%_50%]" /></div>
            <div class="absolute inset-0 hidden bg-[linear-gradient(90deg,var(--color-nacht)_0%,#2e0d1a99_14%,transparent_40%),linear-gradient(0deg,#2e0d1a8c_0%,transparent_30%)] lg:block" aria-hidden="true"></div>
          </figure>
          <figure class="absolute -bottom-40 left-3 w-44 overflow-hidden rounded-xl bg-zand shadow-lg ring-4 ring-creme sm:-bottom-52 sm:w-60 lg:-bottom-24 lg:left-[calc(50%+2.5rem)] lg:w-72">
            <div class="aspect-[4/3]"><Foto src={whiskyWand} alt="Vijf malt whisky's van Douglas Laing's op een houten plankje in onze winkel" widths={[360, 600]} sizes="(min-width: 1024px) 288px, 240px" /></div>
            <figcaption class="bg-creme px-3 py-2 text-xs font-bold text-ink sm:text-sm">Uit onze winkel: whisky van Islay tot Lowland</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Over: van Cor en Ina naar Jan en Monique. Tijdlijn en hun eigen pand. -->
    <section id="over" class="wrap scroll-mt-20 pt-56 pb-16 sm:pt-64 lg:pt-40 lg:pb-28">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-wijn">Over de zaak</p>
          <h2 class="mt-3 text-3xl">Van Cor en Ina naar <span class="italic">Jan &amp; Monique</span></h2>
          <p class="mt-6 text-lg">De slijterij en wijnhandel is zoveel mogelijk in oude stijl voortgezet, met hier en daar wat aanpassingen.</p>
          <p class="mt-4 text-ink-soft">Het assortiment is nagenoeg onveranderd gebleven. Enkele dingen zijn aangepast, waarbij gekeken is naar de behoeften van de klant.</p>
          <figure class="mt-10 max-w-[360px]">
            <div class="aspect-[360/174] overflow-hidden rounded-xl shadow-sm"><Foto src={pand} alt="Ons pand aan de Prinses Margrietstraat 2, met de luifel boven de winkel en een bestelbus ervoor" widths={[360]} sizes="360px" /></div>
            <figcaption class="mt-2 text-sm text-ink-soft">Ons pand aan de Prinses Margrietstraat 2.</figcaption>
          </figure>
        </div>
        <ol class="lg:col-span-6 lg:col-start-7 lg:pt-6">
          <li class="relative border-l-2 border-wijn/30 pb-12 pl-8">
            <span class="absolute top-1 -left-[9px] h-4 w-4 rounded-full border-2 border-wijn bg-creme" aria-hidden="true"></span>
            <p class="kicker text-ink-soft">Daarvoor</p>
            <h3 class="mt-2 text-2xl">Cor en Ina van de Staaij</h3>
            <p class="mt-2 text-ink-soft">De slijterij aan de Prinses Margrietstraat in Ridderkerk.</p>
          </li>
          <li class="relative border-l-2 border-wijn/30 pb-12 pl-8">
            <span class="absolute top-1 -left-[9px] h-4 w-4 rounded-full border-2 border-wijn bg-creme" aria-hidden="true"></span>
            <p class="kicker text-ink-soft tabular-nums">1 september 2011</p>
            <h3 class="mt-2 text-2xl">Jan en Monique den Boef nemen over</h3>
            <p class="mt-2 text-ink-soft">En zetten de zaak zoveel mogelijk in oude stijl voort.</p>
          </li>
          <li class="relative border-l-2 border-transparent pl-8">
            <span class="absolute top-1 -left-[9px] h-4 w-4 rounded-full bg-wijn" aria-hidden="true"></span>
            <p class="kicker text-wijn">Nu</p>
            <h3 class="mt-2 text-2xl">Nog meer ingaan op de wensen van de klant</h3>
            <ul class="mt-5 grid gap-3 sm:grid-cols-3">
              {[
                ['Proeven', 'Wijn, maar ook whisky en diverse soorten jenever.'],
                ['Geschenken', 'Relatiegeschenken en kerstpakketten naar wens.'],
                ['Biertap', 'Te huur, met benodigdheden voor een avond of receptie.'],
              ].map(([k, t]) => (
                <li class="rounded-xl bg-white p-4 shadow-sm"><p class="font-display text-lg font-semibold text-wijn">{k}</p><p class="mt-1 text-sm text-ink-soft">{t}</p></li>
              ))}
            </ul>
          </li>
        </ol>
      </div>
    </section>

    <!-- Wow: de verkenner. Zonder JS staan alle schappen gewoon onder elkaar. -->
    <section id="verkenner" class="scroll-mt-16 bg-zand py-16 lg:py-24" data-verkenner>
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-wijn">Het assortiment</p>
            <h2 class="mt-3 text-3xl">Waar bent u naar op zoek?</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5">Kies een schap en zie wat er onder andere staat, met foto's uit onze eigen winkel. Zoekt u een bepaald merk, neem gerust contact met ons op.</p>
        </div>

        <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:gap-10">
          <div role="tablist" aria-label="Schappen" aria-orientation="vertical" class="grid grid-cols-2 gap-2.5 self-start sm:grid-cols-3 lg:col-span-4 lg:grid-cols-1 lg:gap-3" hidden data-tabs>
            {schappen.map((s, i) => (
              <button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`paneel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tab">
                <span class="nr">0{i + 1}</span>
                <span class="min-w-0"><span class="block">{s.naam}</span><span class="hidden text-xs font-normal opacity-80 lg:block">{s.sub}</span></span>
              </button>
            ))}
          </div>

          <div class="space-y-14 lg:col-span-8" data-panelen>
            {schappen.map((s) => (
              <article id={`paneel-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} tabindex="0" class="scroll-mt-24">
                <figure class="relative overflow-hidden rounded-xl bg-creme shadow-sm">
                  <div class="aspect-[16/10]"><Foto src={s.foto} alt={s.alt} widths={s.w} sizes="(min-width: 1216px) 760px, (min-width: 1024px) 62vw, 100vw" /></div>
                  <figcaption class="absolute top-3 left-3 max-w-[calc(100%-1.5rem)] rounded-md bg-nacht/85 px-2.5 py-1 text-xs text-white sm:text-sm">{s.bij}</figcaption>
                </figure>
                <div class="relative mx-3 -mt-10 rounded-xl bg-white p-5 shadow-sm sm:mx-6 sm:p-7">
                  <h3 class="text-2xl">{s.naam}</h3>
                  <p class="mt-2 text-ink-soft">{s.intro}</p>
                  <ul class="mt-5 grid gap-x-8 border-t border-line sm:grid-cols-2">
                    {s.items.map(([n, t]) => (
                      <li class="border-b border-line py-3">
                        <p class="font-bold">{n}</p>
                        {t && <p class="mt-0.5 text-sm text-ink-soft">{t}</p>}
                      </li>
                    ))}
                  </ul>
                  {s.extra && <p class="mt-5 text-sm">{s.extra}</p>}
                  {s.id === 'proeven'
                    ? <a href="#proeverij" class="btn btn-wijn mt-6">Proeverij aanvragen<Fragment set:html={pijl} /></a>
                    : <a href={site.telHref} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-wijn underline decoration-2 underline-offset-4 transition-colors hover:text-nacht">Vraag ernaar: <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <script>
      // Verkenner: maakt van de losse schappen tabbladen. Pijltjestoetsen wisselen, de rest blijft gewone HTML.
      const v = document.querySelector<HTMLElement>('[data-verkenner]');
      if (v) {
        const lijst = v.querySelector<HTMLElement>('[data-tabs]')!;
        const tabs = [...lijst.querySelectorAll<HTMLButtonElement>('[role=tab]')];
        const panelen = [...v.querySelectorAll<HTMLElement>('[role=tabpanel]')];
        v.querySelector('[data-panelen]')!.classList.remove('space-y-14');
        lijst.hidden = false;
        const kies = (i: number, focus = false) => {
          tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
          panelen.forEach((p, j) => { p.hidden = i !== j; });
          if (focus) tabs[i].focus();
        };
        tabs.forEach((t, i) => {
          t.addEventListener('click', () => {
            kies(i);
            if (window.matchMedia('(max-width: 1023px)').matches) panelen[i].scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          t.addEventListener('keydown', (e) => {
            const n = tabs.length;
            const map: Record<string, number> = { ArrowDown: (i + 1) % n, ArrowRight: (i + 1) % n, ArrowUp: (i - 1 + n) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 };
            if (e.key in map) { e.preventDefault(); kies(map[e.key], true); }
          });
        });
        kies(0);
      }
    </script>

    <!-- Borrel en receptie: donker vlak, sfeerfoto met eigen flessenfoto als inzet, champagnes als lijst. -->
    <section id="borrel" class="donker scroll-mt-16 bg-pruim py-16 text-white lg:py-24">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12">
        <div class="relative lg:col-span-6">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-lg lg:aspect-[5/6]"><Foto src={borrelFoto} alt="Handen die met glazen witte wijn proosten aan tafel" widths={[600, 900, 1200]} sizes="(min-width: 1216px) 560px, (min-width: 1024px) 46vw, 100vw" /></div>
          <figure class="absolute -bottom-8 right-3 w-36 overflow-hidden rounded-xl shadow-lg ring-4 ring-pruim sm:w-48 lg:-right-8">
            <div class="aspect-square"><Foto src={bernardus} alt="Flessen Bernardus Chardonnay en Pinot Noir uit Californië" widths={[384]} sizes="192px" /></div>
          </figure>
        </div>
        <div class="min-w-0 lg:col-span-5 lg:col-start-8">
          <p class="kicker text-messing">Wijnhandel</p>
          <h2 class="mt-3 text-3xl">Voor uw bedrijfsborrel of receptie</h2>
          <p class="mt-6 text-lg text-white/85">Het begrip wijnhandel kan zeer ruim gelezen worden. Wij leveren ook voor uw bedrijfsborrel of receptie, denk ook aan de vrijdagmiddagborrel.</p>
          <ul class="mt-8 grid gap-x-6 sm:grid-cols-2">
            {['Wijn en champagne', 'Frisdrank', 'Biertap te huur', 'Andere benodigdheden'].map((a) => (
              <li class="flex items-center gap-3 border-b border-white/15 py-3"><span class="h-2 w-2 flex-none rounded-full bg-messing" aria-hidden="true"></span>{a}</li>
            ))}
          </ul>
          <div class="mt-10 rounded-xl border border-messing/40 p-5 sm:p-6">
            <p class="kicker text-messing">Champagne, onder andere</p>
            <p class="mt-3 font-display text-xl leading-snug">Laurent Perrier <span class="text-messing" aria-hidden="true">·</span> Moët &amp; Chandon <span class="text-messing" aria-hidden="true">·</span> Veuve Clicquot <span class="text-messing" aria-hidden="true">·</span> Mumm</p>
            <p class="mt-4 text-sm text-white/80">Andere wijnen en champagnes kunnen wij voor u bestellen. Zoekt u een bepaald merk, neem gerust contact met ons op.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Uit de schappen: eigen foto's, versprongen raster. -->
    <section class="wrap py-16 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b border-line pb-6">
        <div>
          <p class="kicker text-wijn">Uit de winkel</p>
          <h2 class="mt-3 text-3xl">Wat er in de schappen staat</h2>
        </div>
        <p class="max-w-md text-ink-soft">Onder andere Teeling, whisky van Islay, Vink uit Zaandam en likeur van Rutte uit Dordrecht.</p>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
        {schap.map((f, i) => (
          <li class={i % 3 === 1 ? 'lg:translate-y-10' : ''}>
            <figure class="group">
              <div class="aspect-[4/5] overflow-hidden rounded-xl bg-zand shadow-sm"><Foto src={f.src} alt={f.alt} widths={f.w} sizes="(min-width: 1216px) 370px, (min-width: 1024px) 31vw, 48vw" class={`transition-transform duration-500 group-hover:scale-[1.03] ${f.cls ?? ""}`} /></div>
              <figcaption class="mt-2.5 text-sm font-bold">{f.bij}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <!-- Proeverij aanvragen: formulier dat bij het voorstel niets verstuurt. -->
    <section id="proeverij" class="donker scroll-mt-16 bg-nacht py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-messing">Wijnproeverij</p>
          <h2 class="mt-3 text-3xl">Proeven met een kleine groep</h2>
          <p class="mt-6 text-lg text-white/85">Op afspraak verzorgen wij bier-, whisky- en wijnproeverijen voor kleine groepen. Vraag vrijblijvend informatie aan, of kom langs in de slijterij en vertel uw wensen.</p>
          <div class="mt-10 aspect-[3/2] overflow-hidden rounded-xl shadow-lg"><Foto src={proeverijFoto} alt="Vier proefglazen met wijn en port, van licht naar donker, op een houten vat" widths={[500, 800, 1000]} sizes="(min-width: 1216px) 460px, (min-width: 1024px) 38vw, 100vw" /></div>
        </div>
        <form class="rounded-xl bg-white/[0.06] p-5 ring-1 ring-white/15 sm:p-8 lg:col-span-6 lg:col-start-7" data-proefform>
          <h3 class="text-2xl">Proeverij aanvragen</h3>
          <p class="mt-2 text-sm text-white/80">Vul in wat u al weet. Wij nemen contact met u op.</p>
          <fieldset class="mt-6">
            <legend class="text-sm font-bold">Wat wilt u proeven?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Wijn', 'Whisky', 'Bier'].map((s, i) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full px-4 py-2 text-sm font-bold ring-1 ring-white/30 transition-colors has-[:checked]:bg-messing has-[:checked]:text-nacht has-[:checked]:ring-messing has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-messing">
                  <input type="radio" name="soort" value={s} class="sr-only" checked={i === 0} />{s}
                </label>
              ))}
            </div>
          </fieldset>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <div><label for="p-naam" class="text-sm font-bold">Naam</label><input id="p-naam" name="naam" autocomplete="name" class="veld mt-1.5" /></div>
            <div><label for="p-contact" class="text-sm font-bold">Telefoon of e-mail</label><input id="p-contact" name="contact" autocomplete="email" class="veld mt-1.5" /></div>
            <div><label for="p-aantal" class="text-sm font-bold">Aantal personen</label><input id="p-aantal" name="aantal" type="number" min="1" inputmode="numeric" class="veld mt-1.5" /></div>
            <div><label for="p-datum" class="text-sm font-bold">Voorkeursdatum</label><input id="p-datum" name="datum" type="date" class="veld mt-1.5 [color-scheme:dark]" /></div>
          </div>
          <div class="mt-5"><label for="p-wensen" class="text-sm font-bold">Uw wensen</label><textarea id="p-wensen" name="wensen" rows="3" class="veld mt-1.5"></textarea></div>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg border border-messing/50 p-4 text-sm text-white/90">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-messing mt-6">Aanvraag versturen</button>
          )}
        </form>
      </div>
    </section>
    <script>
      document.querySelector('[data-proefform]')?.addEventListener('submit', (e) => e.preventDefault());
    </script>

    <!-- Contact: adres en knoppen links, openingstijden met vandaag gemarkeerd rechts. -->
    <section id="contact" class="wrap scroll-mt-16 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-6">
          <p class="kicker text-wijn">Contact</p>
          <h2 class="mt-3 text-3xl">Kom eens langs in Ridderkerk</h2>
          <address class="mt-8 font-display text-xl leading-snug not-italic sm:text-2xl">{site.straat}<br />{site.postcode} {site.plaats}</address>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-wijn"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line text-wijn hover:!bg-wijn hover:!text-white"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <p class="mt-6 break-all"><a href={`mailto:${site.mail}`} class="underline decoration-wijn/40 decoration-2 underline-offset-4">{site.mail}</a></p>
          <a href={site.maps} rel="noopener" class="mt-3 inline-block font-bold text-wijn underline decoration-2 underline-offset-4">Route plannen</a>
          <div class="donker mt-10 rounded-xl bg-wijn p-6 text-white shadow-sm">
            <p class="kicker text-messing">Buiten openingstijden</p>
            <p class="mt-2 text-lg">Het is ook mogelijk om buiten de openingstijden uw bestelling op te halen. Neem hiervoor contact met ons op.</p>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-5 lg:col-start-8">
          <h3 class="text-2xl">Openingstijden slijterij</h3>
          <dl class="mt-5 rounded-xl bg-white px-5 shadow-sm" data-tijden>
            {tijden.map((t, i) => (
              <div data-dag={(i + 1) % 7} class="flex justify-between gap-4 border-b border-line py-3.5 last:border-b-0">
                <dt>{t.dag}</dt>
                <dd class={`whitespace-nowrap tabular-nums font-bold ${t.tijd === 'Gesloten' ? 'font-normal text-ink-soft' : ''}`}>{t.tijd}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-6 text-sm text-ink-soft"><strong class="font-display text-2xl font-semibold text-ink">{site.google}</strong> op Google, {site.reviews} reviews</p>
        </div>
      </div>
    </section>
    <script>
      // Markeer vandaag in de openingstijden.
      const rij = document.querySelector<HTMLElement>(`[data-tijden] [data-dag="${new Date().getDay()}"]`);
      if (rij) {
        rij.classList.add('text-wijn');
        const dt = rij.querySelector('dt')!;
        const s = document.createElement('span');
        s.className = 'ml-2 rounded-md bg-wijn px-1.5 py-0.5 text-xs font-bold text-white';
        s.textContent = 'Vandaag';
        dt.append(s);
      }
    </script>
  </main>
  <Chrome deel="voet" />
</Base>
