---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-baseline gap-2 whitespace-nowrap no-underline">
        <span class="font-display text-xl font-semibold uppercase tracking-[0.18em] text-taupe">MaTaJoy</span>
        <span class="label hidden text-ink-soft sm:inline">Kapsalon</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 font-display text-sm font-semibold uppercase tracking-[0.12em]">
          <li><a href={`${url('')}#aanpak`} class="no-underline transition-colors hover:text-taupe">Aanpak</a></li>
          <li><a href={`${url('')}#prijzen`} class="no-underline transition-colors hover:text-taupe">Prijzen</a></li>
          <li><a href={`${url('')}#hout`} class="no-underline transition-colors hover:text-taupe">Houtwerk</a></li>
          <li><a href={`${url('')}#contact`} class="no-underline transition-colors hover:text-taupe">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-taupe !px-4 !pb-2 !pt-2.5 !text-xs">Bel<span class="sr-only sm:not-sr-only"> voor een afspraak</span></a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-lg font-semibold uppercase tracking-[0.18em] text-white">MaTaJoy</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:col-span-4">Telefoon <a href={site.telHref} class="whitespace-nowrap underline underline-offset-2">{site.tel}</a><br /><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
