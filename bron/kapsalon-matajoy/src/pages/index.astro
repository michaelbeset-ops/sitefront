---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, houtwerk } from '../data/site';
import hero from '../assets/hero.jpg';
import salon from '../assets/salon.jpg';
import hout from '../assets/hout.jpg';

const stappen = ['Uw wens', 'De vorm van uw gezicht', 'De conditie van uw haar'];
const vakken = ['Knippen', 'Kleuren', 'Omvormen'];
---
<Base
  title="Kapsalon MaTaJoy | Knippen, kleuren en omvormen in Ouderkerk aan den IJssel"
  description="Kapsalon MaTaJoy in Ouderkerk aan den IJssel: knippen, kleuren en omvormen voor dames, heren en kinderen. Werkt met Goldwell. Vrijdag open tot 21.00 uur. Afspraak via 0180 683 130."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Tekst links op zand, foto rechts; de week als strook eronder. -->
    <section class="bg-sand">
      <div class="wrap grid gap-10 pb-10 pt-12 lg:grid-cols-12 lg:gap-12 lg:pb-14 lg:pt-20">
        <div class="lg:col-span-6 lg:self-center">
          <p class="label text-taupe">Kapsalon in Ouderkerk aan den IJssel</p>
          <h1 class="mt-5 text-4xl">Knippen, kleuren en omvormen. Het begint bij advies en overleg.</h1>
          <span class="streep mt-8" aria-hidden="true"></span>
          <p class="mt-6 max-w-xl text-lg text-ink-soft">Ervaren kapsters voor dames, heren en kinderen. Wij helpen u graag met een goed en gekleurd advies.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={site.telHref} class="btn btn-taupe">Bel voor een afspraak</a>
            <a href={site.telHref} class="whitespace-nowrap font-display text-xl font-semibold tracking-[0.06em] tabular-nums no-underline">{site.tel}</a>
          </div>
          <p class="mt-6 text-sm text-ink-soft"><strong class="text-ink">{site.google.score}</strong> uit 5 op Google, {site.google.aantal} reviews</p>
        </div>
        <div class="relative lg:col-span-6">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[5/6]">
            <Foto src={hero} alt="Kapper brengt met een kwast haarverf aan op een lok lang donker haar, op een plankje, tussen stroken folie" hero sizes="(min-width: 1024px) 560px, 100vw" />
          </div>
          <span class="absolute -bottom-3 left-8 h-1.5 w-24 rounded-full bg-wood" aria-hidden="true"></span>
        </div>
      </div>
      <div class="border-t border-line bg-paper">
        <div class="wrap py-6">
          <h2 class="label text-ink-soft">Openingstijden</h2>
          <ul class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-line sm:grid-cols-3 lg:grid-cols-6">
            {tijden.map((t) => (
              <li class={`px-4 py-3 ${t.avond ? 'bg-taupe text-white' : 'bg-paper'}`}>
                <span class={`label block ${t.avond ? 'text-white' : 'text-ink-soft'}`}>{t.dag}</span>
                <span class={`mt-1 block whitespace-nowrap tabular-nums ${t.tijd ? '' : 'text-ink-soft'}`}>{t.tijd ?? 'Gesloten'}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Aanpak: drie dingen waar we naar kijken, dan drie vakken. -->
    <section id="aanpak" class="scroll-mt-20 bg-sage py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-12">
          <p class="label text-taupe">Onze aanpak</p>
          <h2 class="mt-4 max-w-3xl text-3xl">Deskundigheid op maat, advies en overleg</h2>
        </div>
        <div class="lg:col-span-4">
          <p class="text-lg text-ink-soft">Daar begint volgens MaTaJoy alles mee. We kijken eerst naar drie dingen.</p>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <ol class="grid gap-6 sm:grid-cols-3 sm:gap-0">
            {stappen.map((s, i) => (
              <li class="border-t-2 border-taupe pt-5 sm:pr-6">
                <span class="font-display text-sm font-semibold tabular-nums tracking-[0.2em] text-taupe">0{i + 1}</span>
                <h3 class="mt-2 text-xl">{s}</h3>
              </li>
            ))}
          </ol>
          <div class="mt-14 rounded-xl bg-paper p-6 shadow-sm md:p-10">
            <p class="text-ink-soft">Met de nieuwste knip-, kleur- en omvormtechnieken leggen we daarna een perfecte basis voor een goed vallend kapsel.</p>
            <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-1 font-display text-2xl font-light md:text-[2.25rem]">
              {vakken.map((v) => <li>{v}</li>)}
            </ul>
            <p class="label mt-6 text-taupe">Voor dames, heren en kinderen</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Goldwell en trends: foto breed links, tekst smal rechts. -->
    <section class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:items-center lg:gap-12 lg:py-24">
      <div class="aspect-[3/2] overflow-hidden rounded-xl lg:col-span-7">
        <Foto src={salon} alt="Lichte kapsalon gezien via een ronde spiegel, met zwarte kappersstoelen, grote ramen en een rij haarproducten op de voorgrond" sizes="(min-width: 1024px) 640px, 100vw" />
      </div>
      <div class="lg:col-span-5">
        <p class="label text-taupe">Producten</p>
        <h2 class="mt-4 text-3xl">We werken met Goldwell</h2>
        <p class="mt-6">Goldwell biedt een uitgebreid scala aan productlijnen, ontwikkeld met geavanceerde technologieën.</p>
        <p class="mt-4 text-ink-soft">En uiteraard blijft MaTaJoy op de hoogte van de laatste trends op haargebied.</p>
      </div>
    </section>

    <!-- Prijzen: netjes klaargezet, bedragen nog aan te leveren. -->
    <section id="prijzen" class="scroll-mt-20 bg-sand py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="label text-taupe">Tarieven</p>
          <h2 class="mt-4 text-3xl">Prijzen</h2>
          <p class="mt-6 text-sm text-ink-soft">[[AANLEVEREN: prijslijst]]</p>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <div class="rounded-xl bg-paper p-6 shadow-sm md:p-10">
            <dl class="divide-y divide-line">
              {['Dames', 'Heren', 'Kinderen'].map((groep) => (
                <div class="flex items-baseline justify-between gap-4 py-4">
                  <dt class="label text-taupe">{groep}</dt>
                  <dd class="text-sm text-ink-soft">[[AANLEVEREN: prijzen]]</dd>
                </div>
              ))}
            </dl>
            <p class="mt-6 text-sm text-ink-soft">Voor knippen, kleuren en omvormen. Een afspraak maakt u telefonisch: <a href={site.telHref} class="whitespace-nowrap underline underline-offset-2">{site.tel}</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Houtwerk: het verrassende blok, donker en warm. -->
    <section id="hout" class="scroll-mt-20 bg-ink text-white">
      <div class="h-2 bg-wood" aria-hidden="true"></div>
      <div class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:items-center lg:gap-12 lg:py-24">
        <div class="lg:order-2 lg:col-span-6">
          <p class="label text-wood-light">Ook in de salon</p>
          <h2 class="mt-4 text-3xl">Handgemaakte houten woonaccessoires</h2>
          <p class="mt-6 text-white/85">In de kapsalon staat een kleine collectie houtwerk. Alle stukken zijn handgemaakt en uniek, en het assortiment wisselt geregeld.</p>
          <ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-3 min-[400px]:grid-cols-2">
            {houtwerk.map((h) => (
              <li class="border-l-2 border-wood-light pl-3 font-display text-lg tracking-[0.04em]">{h}</li>
            ))}
          </ul>
          <p class="mt-8 text-white/85">Loop gerust eens binnen om een kijkje te nemen.</p>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-xl lg:order-1 lg:col-span-6">
          <Foto src={hout} alt="Houten snijplank met een mes en een vleesvork met houten heften op een donkere houten tafel" sizes="(min-width: 1024px) 560px, 100vw" />
        </div>
      </div>
    </section>

    <!-- Contact: bellen voorop, vrijdagavond uitgelicht. -->
    <section id="contact" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-5">
        <p class="label text-taupe">Contact</p>
        <h2 class="mt-4 text-3xl">Een afspraak maakt u telefonisch</h2>
        <a href={site.telHref} class="mt-8 inline-block whitespace-nowrap font-display text-3xl font-semibold tabular-nums no-underline decoration-wood decoration-2 underline-offset-8 hover:underline">{site.tel}</a>
        <address class="mt-8 not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
        <p class="mt-4 text-sm text-ink-soft">E-mail: [[AANLEVEREN: e-mailadres]]</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.maps} rel="noopener" class="btn btn-line">Route plannen</a>
          <a href={site.facebook} rel="noopener" class="btn btn-line">Facebook</a>
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <div class="rounded-xl bg-sage p-6 md:p-8">
          <p class="label text-taupe">Vrijdagavond</p>
          <p class="mt-3 font-display text-2xl font-light">Op vrijdag open tot <span class="whitespace-nowrap font-semibold tabular-nums">21.00 uur</span></p>
        </div>
        <h3 class="label mt-10 text-ink-soft">Openingstijden</h3>
        <dl class="mt-3 divide-y divide-line">
          {tijden.map((t) => (
            <div class={`flex justify-between gap-4 py-3 ${t.avond ? 'font-semibold' : ''}`}>
              <dt>{t.dag}</dt>
              <dd class={`whitespace-nowrap tabular-nums ${t.tijd ? '' : 'text-ink-soft'}`}>{t.tijd ?? 'Gesloten'}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
