---
// Nagetekend logo: het kapelletje met boog (dak licht, voet saliegroen) en 'T KAPELLETJE met een boog als A.
import { url } from '../data/site';
interface Props { klein?: boolean; licht?: boolean }
const { licht = false } = Astro.props;
const cid = 'kapel-' + Math.random().toString(36).slice(2, 8);
---
<a href={url('')} class="merk">
  <svg class="merk-mark" viewBox="0 0 120 140" aria-hidden="true">
    <defs>
      <clipPath id={cid}><path d="M57 0h6v5h2v9l35 42h3v6h3v78H84V90a24 24 0 0 0-48 0v50H14V62h3v-6h3l35-42V5h2Z" /></clipPath>
    </defs>
    <g clip-path={`url(#${cid})`}>
      <rect width="120" height="140" fill={licht ? '#e7e4dc' : '#d9d6cc'} />
      <rect y="66" width="120" height="74" fill="#8a9a7c" />
      <path d="M0 128 120 82v14L0 142Z" fill="#b4c0a8" />
      <path d="M0 74 60 30l60 44v6L60 38 0 82Z" fill="#fff" opacity=".35" />
    </g>
  </svg>
  <span class="sr-only">’t Kapelletje, restaurant en terras</span>
  <span aria-hidden="true">
    <span class="merk-woord"><sup>’T</sup>K<svg class="merk-a" viewBox="0 0 20 24" aria-hidden="true"><path d="M3 24V11a7 7 0 0 1 14 0v13" fill="none" stroke="currentColor" stroke-width="3.6" /></svg>PELLETJE</span>
    <small>RESTAURANT &amp; TERRAS</small>
  </span>
</a>
