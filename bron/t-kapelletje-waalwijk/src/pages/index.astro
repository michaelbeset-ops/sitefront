---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi } from '../data/site';
import { kaart } from '../data/menu';

import terrasZon from '../assets/terras-zon.jpg';
import terrasLunch from '../assets/terras-lunch.jpg';
import tafel from '../assets/tafel-raam.jpg';
import sangria from '../assets/sangria.jpg';
import steak from '../assets/sfeer-steak.jpg';

const titel = "Restaurant 't Kapelletje | Lunch, diner en terras in Waalwijk";
const omschrijving = "Restaurant & terras 't Kapelletje, Kloosterweg 71 in Waalwijk. Lunch, diner of een borrel, elke dag behalve dinsdag vanaf 9.30 uur. Bekijk de menukaart en reserveer via WhatsApp of telefoon.";
const [groot, ...rest] = reviews;
const personen = Array.from({ length: 12 }, (_, i) => i + 1);
const tijdenKeuze: string[] = [];
for (let m = 570; m <= 1260; m += 30) tijdenKeuze.push(`${Math.floor(m / 60)}.${String(m % 60).padStart(2, '0')}`);
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- HERO: licht, de kapelboog als venster op het terras -->
    <section class="relative overflow-hidden">
      <div class="wrap grid items-end gap-y-10 pb-14 pt-6 lg:min-h-[calc(100svh-6.75rem)] lg:max-h-[60rem] lg:grid-cols-12 lg:gap-x-10 lg:pb-16 lg:pt-10">
        <figure class="relative lg:order-2 lg:col-span-6 lg:col-start-7 lg:self-stretch">
          <div class="boog relative h-[min(46svh,24rem)] bg-kalk-2 sm:h-[30rem] lg:absolute lg:inset-0 lg:h-auto">
            <Image src={terrasZon} alt="Het terras van 't Kapelletje in de zon: tafels met bloemen, grijze stoelen, zwarte parasols en bomen" quality={72} widths={[420, 640, 900, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[62%_50%]" />
          </div>
          <figcaption class="mt-3 text-right text-xs text-grijs lg:absolute lg:-bottom-8 lg:right-0 lg:mt-0">Ons terras, 1 mei</figcaption>
        </figure>
        <div class="lg:order-1 lg:col-span-6 lg:pb-6">
          <p class="flex items-center gap-2 text-sm font-semibold text-grijs"><Icoon naam="pin" class="h-4 w-4 text-salie" />{site.straat}, {site.plaats}</p>
          <h1 class="mt-6 text-hero">Restaurant &amp; terras naast het <span class="text-salie">kapelletje</span></h1>
          <p class="mt-8 max-w-[34rem] text-lg text-grijs md:text-xl">Een sfeervolle plek waar gastvrijheid, gezelligheid en lekker eten samenkomen. Kom langs voor lunch, diner of een gezellige borrel.</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href="#reserveren" class="knop knop-salie">Tafel reserveren<Icoon naam="pijl" /></a>
            <a href="#kaart" class="link font-semibold">Bekijk de menukaart</a>
          </div>
          <p class="mt-12 border-t border-lijn pt-5 text-sm text-grijs">Elke dag behalve dinsdag vanaf 9.30 uur. Bel <a href={site.telHref} class="num whitespace-nowrap font-semibold text-inkt no-underline hover:text-salie">{site.tel}</a> of app <a href={waHoi} class="num whitespace-nowrap font-semibold text-inkt no-underline hover:text-salie">{site.mob}</a>.</p>
        </div>
      </div>
    </section>

    <!-- VERHAAL: vijftien jaar plannen -->
    <section id="over" class="bg-kalk-2 py-24 md:py-32">
      <div class="wrap grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs relative lg:col-span-5">
          <Image src={tafel} alt="Tafel voor twee bij het raam, met de menukaart van 't Kapelletje, een vaasje bloemen en uitzicht op het groen" quality={72} widths={[400, 640, 900]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_45%]" />
        </figure>
        <div class="lg:col-span-6 lg:col-start-7">
          <h2 class="rijs text-3xl">Vijftien jaar plannen, sinds oktober 2025 open</h2>
          <p class="rijs mt-7 max-w-xl text-lg text-grijs">Naast het bedehuisje aan de Meerdijk opende in oktober 2025 restaurant en terras ’t Kapelletje. Binnen een warme, nieuwe zaak; buiten een terras tussen het groen.</p>
          <blockquote class="rijs mt-12 border-l-2 border-salie pl-6">
            <p class="font-kop text-2xl leading-tight">“Of u nu langskomt voor een kop koffie, een ontspannen lunch, een heerlijk diner of een gezellige borrel, wij heten u van harte welkom.”</p>
            <footer class="mt-4 text-sm text-grijs">Team ’t Kapelletje, op Facebook</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- MENUKAART: als hun zwarte kaartmap -->
    <section id="kaart" class="donker bg-inkt py-24 text-licht md:py-32">
      <div class="wrap">
        <div class="grid items-end gap-y-6 lg:grid-cols-12 lg:gap-x-10">
          <div class="lg:col-span-7"><svg viewBox="0 0 120 140" class="mb-8 h-14 w-auto" aria-hidden="true"><path d="M57 0h6v5h2v9l35 42h3v6h3v78H84V90a24 24 0 0 0-48 0v50H14V62h3v-6h3l35-42V5h2Z" fill="#a9b99b"/><path d="M57 0h6v5h2v9l35 42h3v6H14v-6h3l35-42V5h2Z" fill="#e7e4dc"/></svg><h2 class="rijs text-reus">De kaart</h2></div>
          <p class="rijs max-w-md text-lg text-licht-zacht lg:col-span-5 lg:pb-4">Van een broodje kroket tot chateaubriand voor twee. Alle prijzen zoals op onze eigen kaart.</p>
        </div>

        <div class="mt-14 grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
          <div class="min-w-0 lg:col-span-8" data-kaart>
            <div role="tablist" aria-label="Onderdelen van de menukaart" class="tabrij -mx-5 flex gap-2 overflow-x-auto px-5 pb-2 sm:mx-0 sm:flex-wrap sm:px-0">
              {kaart.map((t, i) => (
                <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`paneel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}
                  class="flex-none rounded-full border border-lijn-licht px-4 py-2 text-[.9375rem] font-semibold text-licht-zacht transition-colors hover:border-blad hover:text-licht aria-selected:border-blad aria-selected:bg-blad aria-selected:text-inkt">{t.label}</button>
              ))}
            </div>
            {kaart.map((t, i) => (
              <div role="tabpanel" id={`paneel-${t.id}`} aria-labelledby={`tab-${t.id}`} data-paneel={t.id} class:list={['paneel mt-10 grid gap-y-10 md:grid-cols-2 md:gap-x-12']} tabindex="0">
                <h3 class="sr-only">{t.label}</h3>
                {t.groepen.map((kolom) => (
                  <div class="space-y-10">
                    {kolom.map((g) => (
                      <div>
                        <h4 class="border-b border-lijn-licht pb-2 text-xs font-bold uppercase tracking-[.16em] text-blad">{g.kop}</h4>
                        {g.noot && <p class="mt-3 text-sm italic text-licht-zacht">{g.noot}</p>}
                        <ul class="mt-4 space-y-2.5">
                          {g.items.map((it) => (
                            <li>
                              <div class="gerecht">
                                <span class="min-w-0 font-medium">{it.n}{it.v && <span class="ml-1.5 align-[.1em] text-[.6875rem] font-bold text-blad" title="vegetarisch">VEGA</span>}</span>
                                <span class="stip" aria-hidden="true"></span>
                                <span class="num whitespace-nowrap">{it.p}</span>
                              </div>
                              {it.x && <p class="text-sm italic leading-snug text-licht-zacht">{it.x}</p>}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            ))}
            <p class="mt-12 text-sm text-licht-zacht">Kaart zoals gedeeld op onze Facebookpagina. Prijzen in euro’s, VEGA = vegetarisch. De drankenkaart staat er ook.</p>
          </div>

          <aside class="lg:col-span-4">
            <figure class="rijs relative hidden lg:block">
              <div class="boog aspect-[3/4]">
                <Image src={steak} alt="Sfeerbeeld: gegrild vlees met frites op een wit bord" quality={68} widths={[400, 640]} sizes="(min-width: 1024px) 28vw, 100vw" class="h-full w-full object-cover" />
              </div>
              <figcaption class="mt-2 text-xs text-licht-zacht">Sfeerbeeld</figcaption>
            </figure>
            <blockquote class="rijs mt-10">
              <p class="font-kop text-2xl leading-tight">“P.s. haal de gevulde ossenhaas nooit van de kaart af aub”</p>
              <footer class="mt-3 text-sm text-licht-zacht">Joep H., buurman uit Meerdijk, op Google</footer>
            </blockquote>
          </aside>
        </div>
      </div>
    </section>

    <!-- TERRAS: groot, met de sangria er overheen -->
    <section id="terras" class="donker relative text-licht">
      <div class="relative h-[34rem] overflow-hidden sm:h-[40rem] lg:h-[46rem]">
        <Image src={terrasLunch} alt="Gasten lunchen op het zonnige terras van 't Kapelletje, tussen bakstenen pilaren en groen" quality={70} widths={[640, 1000, 1600, 2000]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_55%]" />
        <div class="absolute inset-0 bg-gradient-to-t from-inkt/90 via-inkt/40 to-inkt/0" aria-hidden="true"></div>
        <div class="wrap relative flex h-full items-end pb-14 lg:pb-20">
          <div class="max-w-2xl">
            <h2 class="rijs text-3xl">Zon, sangria en een groot terras</h2>
            <p class="rijs mt-6 max-w-lg text-lg text-licht/90">“Met dit prachtige weer ontvangen we jullie graag op ons mooie terras.” Zoals we op 1 mei schreven.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="relative bg-kalk">
      <div class="wrap grid gap-y-10 pb-24 md:pb-32 lg:grid-cols-12 lg:gap-x-10">
        <figure class="relative mt-12 w-[72%] max-w-[22rem] lg:col-span-4 lg:col-start-9 lg:-mt-56 lg:w-full lg:max-w-none">
          <Image src={sangria} alt="Een glas huisgemaakte sangria met sinaasappel en munt op het terras" quality={72} widths={[360, 600, 800]} sizes="(min-width: 1024px) 28vw, 72vw" class="aspect-[4/5] w-full rounded-sm object-cover shadow-md ring-8 ring-kalk" />
        </figure>
        <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:pt-16">
          <p class="font-kop text-2xl leading-tight">“Onze heerlijke, huisgemaakte sangria, met liefde bereid door onze barvrouw.”</p>
          <p class="mt-5 max-w-md text-grijs">Ook op de kaart: Aperol Spritz, Limoncello Spritz, een Mojito en Hertog Jan van de tap.</p>
        </div>
      </div>
    </section>

    <!-- REVIEWS: één grote stem, drie kleine -->
    <section id="gasten" class="border-t border-lijn bg-kalk py-24 md:py-32">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-7">
          <h2 class="sr-only">Reviews op Google</h2>
          <figure class="rijs">
            <blockquote class="font-kop text-3xl leading-[1.05]">“{groot.tekst}”</blockquote>
            <figcaption class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-grijs">
              <span class="flex text-salie" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
              <span class="font-semibold text-inkt">{groot.naam}</span><span>Google review, {groot.wanneer}</span>
            </figcaption>
          </figure>
        </div>
        <ul class="divide-y divide-lijn border-y border-lijn lg:col-span-5">
          {rest.map((r, i) => (
            <li class="rijs py-7" style={`--d:${i * 0.08}s`}>
              <p class="text-lg leading-relaxed">“{r.tekst}”</p>
              <p class="mt-3 flex flex-wrap items-center gap-x-3 text-sm text-grijs">
                <span class="flex text-salie" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-3.5 w-3.5" />)}</span>
                <span class="font-semibold text-inkt">{r.naam}</span><span>{r.wanneer}</span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- RESERVEREN + ROUTE -->
    <section id="reserveren" class="bg-kalk-2 py-24 md:py-32">
      <div class="wrap grid gap-y-16 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <h2 class="rijs text-3xl">Een tafel reserveren</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-grijs">Vul de zin aan en stuur hem via WhatsApp. Op drukke avonden is reserveren verstandig.</p>

          <form class="mt-10 rounded-md bg-wit p-6 shadow-sm sm:p-9" data-tafel onsubmit="return false">
            <p class="zin text-xl leading-[2.4] sm:text-2xl">
              Wij komen met
              <label class="sr-only" for="t-pers">Aantal personen</label>
              <select id="t-pers" name="personen" class="zin-veld num">{personen.map((n) => <option value={n} selected={n === 2}>{n}</option>)}<option value="meer dan 12">13+</option></select>
              personen op
              <label class="sr-only" for="t-datum">Datum</label>
              <input id="t-datum" name="datum" type="date" class="zin-veld num" />
              rond
              <label class="sr-only" for="t-tijd">Tijd</label>
              <select id="t-tijd" name="tijd" class="zin-veld num">{tijdenKeuze.map((t) => <option value={t} selected={t === '18.00'}>{t}</option>)}</select>
              uur, het liefst
              <label class="sr-only" for="t-plek">Plek</label>
              <select id="t-plek" name="plek" class="zin-veld"><option value="binnen">binnen</option><option value="op het terras">op het terras</option><option value="maakt niet uit" selected>waar plek is</option></select>.
              Mijn naam is
              <label class="sr-only" for="t-naam">Uw naam</label>
              <input id="t-naam" name="naam" type="text" autocomplete="name" placeholder="uw naam" class="zin-veld w-[11rem]" />.
            </p>
            <p class="mt-4 min-h-[1.5rem] text-sm font-semibold text-salie" data-melding aria-live="polite"></p>
            <div class="mt-6 border-t border-lijn pt-6">
              <p class="text-xs font-semibold text-grijs">Uw bericht</p>
              <p class="mt-2 text-[.9375rem] leading-relaxed" data-bericht aria-live="polite">Hallo ’t Kapelletje, wij willen graag een tafel reserveren voor 2 personen rond 18.00 uur.</p>
            </div>
            <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
              <a href={waHoi} class="knop knop-salie" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
              <a href={site.telHref} class="link num whitespace-nowrap font-semibold">of bel {site.tel}</a>
            </div>
          </form>
        </div>

        <div id="route" class="lg:col-span-5 lg:pt-3">
          <h2 class="rijs text-2xl">Openingstijden &amp; route</h2>
          <p class="mt-5 flex items-center gap-2.5 text-sm font-semibold" data-status-wrap>
            <span class="stip-status h-2.5 w-2.5 flex-none rounded-full bg-grijs" aria-hidden="true"></span>
            <span data-status>Elke dag behalve dinsdag vanaf 9.30 uur</span>
          </p>
          <table class="mt-6 w-full">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-bold data-[vandaag]:text-salie">
                  <th scope="row" class="py-2.5 text-left font-normal">{t.naam}</th>
                  <td class="num whitespace-nowrap py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <address class="mt-10 not-italic">
            <p class="font-kop text-2xl">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <p class="mt-3 text-grijs">Gratis parkeren bij het restaurant.</p>
          </address>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={site.maps} class="knop knop-rand knop-klein"><Icoon naam="pin" />Route plannen</a>
            <a href={site.telHref} class="knop knop-rand knop-klein num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SLOT -->
    <section class="donker bg-salie-diep text-licht">
      <div class="wrap flex flex-col items-start justify-between gap-8 py-16 md:flex-row md:items-center md:py-20">
        <p class="font-kop text-3xl">Tot snel bij ’t Kapelletje</p>
        <a href={waHoi} class="knop knop-licht"><Icoon naam="wa" />App ons op {site.mob}</a>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  [data-status-wrap][data-open='true'] .stip-status { background: #3f9a5c; box-shadow: 0 0 0 3px #3f9a5c33; }
  .tabrij { scrollbar-width: none; }
  .tabrij::-webkit-scrollbar { display: none; }
  :global(.js) .paneel[hidden] { display: none; }
  .zin-veld { display: inline-block; max-width: 100%; border: 0; border-bottom: 2px solid var(--color-salie); background: transparent; padding: 0 .2rem; margin-inline: .1rem; font: inherit; font-weight: 600; color: var(--color-salie-diep); line-height: 1.3; border-radius: 0; cursor: pointer; transition: background-color .2s; }
  .zin-veld:hover, .zin-veld:focus { background: #4a5b4214; outline: none; }
  .zin-veld:focus-visible { outline: 3px solid var(--color-salie); outline-offset: 2px; }
  input.zin-veld { cursor: text; }
  input.zin-veld::placeholder { color: #565c54; font-weight: 500; }
</style>

<script>
  // Menukaart-tabs (zonder JS staat de hele kaart onder elkaar).
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panelen = [...document.querySelectorAll<HTMLElement>('[data-paneel]')];
  const kies = (id: string, focus = false) => {
    tabs.forEach((t) => { const aan = t.dataset.tab === id; t.setAttribute('aria-selected', String(aan)); t.tabIndex = aan ? 0 : -1; if (aan && focus) t.focus(); });
    panelen.forEach((p) => { p.hidden = p.dataset.paneel !== id; });
  };
  if (tabs.length) {
    kies(tabs[0].dataset.tab!);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => kies(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); kies(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true); }
      });
    });
  }

  // Reserveren: de zin wordt een WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-tafel]');
  if (f) {
    const uit = f.querySelector<HTMLElement>('[data-bericht]')!;
    const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
    const melding = f.querySelector<HTMLElement>('[data-melding]')!;
    const datum = f.querySelector<HTMLInputElement>('#t-datum')!;
    const basis = stuur.href.split('?')[0];
    const vandaag = new Date(); vandaag.setMinutes(vandaag.getMinutes() - vandaag.getTimezoneOffset());
    datum.min = vandaag.toISOString().slice(0, 10);
    const dagen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
    const maanden = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
    const maak = () => {
      const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value.trim();
      let wanneer = '';
      melding.textContent = '';
      if (v('datum')) {
        const d = new Date(v('datum') + 'T12:00:00');
        wanneer = ` op ${dagen[d.getDay()]} ${d.getDate()} ${maanden[d.getMonth()]}`;
        if (d.getDay() === 2) melding.textContent = 'Op dinsdag zijn we gesloten. Kies gerust een andere dag.';
      }
      const plek = v('plek') === 'maakt niet uit' ? '' : `, het liefst ${v('plek')}`;
      const naam = v('naam') ? ` Groet, ${v('naam')}` : '';
      const p = v('personen');
      const tekst = `Hallo ’t Kapelletje, wij willen graag een tafel reserveren voor ${p} ${p === '1' ? 'persoon' : 'personen'}${wanneer} rond ${v('tijd')} uur${plek}.${naam}`;
      uit.textContent = tekst;
      stuur.href = `${basis}?text=${encodeURIComponent(tekst)}`;
    };
    f.addEventListener('input', maak); f.addEventListener('change', maak); maak();
  }
</script>
