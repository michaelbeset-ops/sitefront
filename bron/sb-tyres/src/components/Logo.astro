---
// Wordmark naar hun gevelbord: groot vet "SB", daarnaast "TYRES" gespatieerd en eronder "banden- en velgenspecialist".
// Het beeldmerk (band in geel) is nieuw, als favicon en herkenning.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <span class="sr-only">SB Tyres, banden- en velgenspecialist</span>
  <svg viewBox="0 0 32 32" class="h-9 w-9 flex-none" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill={licht ? '#f5c518' : '#0f1011'} />
    <circle cx="16" cy="16" r="10.5" fill="none" stroke={licht ? '#0f1011' : '#f5c518'} stroke-width="4" />
    <circle cx="16" cy="16" r="3" fill={licht ? '#0f1011' : '#f5c518'} />
  </svg>
  <span aria-hidden="true" class="flex flex-col font-display">
    <span class="flex items-baseline gap-1.5">
      <span class={`text-[1.65rem] font-extrabold tracking-[-0.03em] ${licht ? 'text-white' : 'text-ink'}`}>SB</span>
      <span class={`text-[0.95rem] font-bold tracking-[0.2em] ${licht ? 'text-geel' : 'text-ink'}`}>TYRES</span>
    </span>
    <span class={`mt-0.5 text-[0.62rem] max-[359px]:hidden font-semibold tracking-[0.1em] uppercase ${licht ? 'text-white/75' : 'text-ink-soft'}`}>Banden- en velgenspecialist</span>
  </span>
</span>
