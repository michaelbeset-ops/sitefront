---
import { url, waHoi, site, shop } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['assortiment', 'Assortiment'], ['keuzehulp', 'Keuzehulp'], ['maatwerk', 'Maatwerk'], ['afhalen', 'Afhalen'], ['contact', 'Contact']];
---
<header class="sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-md">
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-6 md:h-[4.75rem]">
    <Merk />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-[.9375rem] font-semibold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="whitespace-nowrap text-inkt no-underline transition-colors duration-200 hover:text-zeil">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3 sm:gap-5">
      <a href={site.telHref} class="num hidden whitespace-nowrap text-[.9375rem] font-semibold text-inkt no-underline hover:text-zeil xl:inline-flex xl:items-center xl:gap-2"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
      <a href={shop.home} class="knop hidden !min-h-11 !px-5 text-[.9375rem] md:inline-flex">Naar de webshop<Icoon naam="pijl" /></a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-sm text-inkt lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden border-t border-lijn bg-papier lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="kop block border-b border-lijn py-4 text-xl text-inkt no-underline">{t}</a></li>)}
      <li><a href={shop.home} class="kop block border-b border-lijn py-4 text-xl text-zeil no-underline">Naar de webshop</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-lijn bg-papier/95 p-2 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="flex min-h-12 items-center justify-center gap-2 rounded-sm text-[.9375rem] font-bold text-inkt no-underline shadow-[inset_0_0_0_1.5px_var(--color-inkt)]"><Icoon naam="tel" class="h-4 w-4" />Bellen</a>
  <a href={waHoi} class="flex min-h-12 items-center justify-center gap-2 rounded-sm bg-zeil text-[.9375rem] font-bold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
