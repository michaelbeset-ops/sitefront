---
import { site, url, waHoi, shop } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const groepen: [string, string][] = [['PE afdekzeilen', shop.pe], ['PVC afdekzeilen', shop.pvc], ['Maatwerk', shop.maatwerk], ['Aanhangwagennetten', shop.aanhanger], ['Steigernetten', shop.steiger], ['Bouwhekzeilen', shop.bouwhekzeil], ['Accessoires', shop.accessoires]];
const info: [string, string][] = [['Besteladvies', shop.besteladvies], ['Maat berekenen', shop.maatBerekenen], ['Verzending en levertijd', shop.verzending], ['Annuleren en retourneren', shop.retour], ['Wie zijn wij?', shop.wie]];
---
<footer class="bg-nacht text-mist">
  <div class="rand rand-dun" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Afdekzeilen, PVC-zeilen, netten, maatwerk en accessoires. Uit voorraad, vanuit Dordrecht.</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Webshop</p>
      <ul class="mt-3 space-y-1">{groepen.map(([t, h]) => <li><a href={h} class="link link-licht no-underline hover:underline">{t}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Klantenservice</p>
      <ul class="mt-3 space-y-1">{info.map(([t, h]) => <li><a href={h} class="link link-licht no-underline hover:underline">{t}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}<br />Afhalen op afspraak</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, een handelsnaam van {site.bedrijf} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Productfoto's en locatiefoto van afdekproducten.nl zelf. Teksten en advies uit jullie eigen besteladvies en klantenservicepagina's. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
