---
// Woordmerk naar hun logo: drie gestapelde lagen in drie blauwen, met AFDEKPRODUCTEN.NL in een zware letter.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['group inline-flex items-center gap-2 no-underline sm:gap-2.5', licht ? 'text-wit' : 'text-inkt', cls]} aria-label="Afdekproducten.nl, naar de homepage">
  <svg viewBox="0 0 40 34" class="h-7 w-auto flex-none sm:h-8 transition-transform duration-500 group-hover:-translate-y-0.5" aria-hidden="true">
    <path d="M20 21.5 37 26.2a1.3 1.3 0 0 1 0 1.9l-15.4 5.4a4.6 4.6 0 0 1-3.2 0L3 28.1a1.3 1.3 0 0 1 0-1.9Z" fill="#005487" />
    <path d="M20 11.6 37 16.3a1.3 1.3 0 0 1 0 1.9l-15.4 5.4a4.6 4.6 0 0 1-3.2 0L3 18.2a1.3 1.3 0 0 1 0-1.9Z" fill="#006aa3" stroke={licht ? '#07324b' : '#f2f5f7'} stroke-width="1.4" />
    <path d="M18.4.6a4.6 4.6 0 0 1 3.2 0L37 6a1.3 1.3 0 0 1 0 1.9l-15.4 5.4a4.6 4.6 0 0 1-3.2 0L3 7.9A1.3 1.3 0 0 1 3 6Z" fill="#2aabe3" stroke={licht ? '#07324b' : '#f2f5f7'} stroke-width="1.4" />
  </svg>
  <span class="kop whitespace-nowrap text-[.9375rem] min-[360px]:text-[1.0625rem] leading-none tracking-[-0.035em] sm:text-[1.1875rem]">AFDEKPRODUCTEN<span class:list={[licht ? 'text-laag' : 'text-zeil']}>.NL</span></span>
</a>
