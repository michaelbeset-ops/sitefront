---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="licht sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={url('')} class="font-display text-xl leading-none font-bold tracking-[-0.02em] text-wijn no-underline sm:text-2xl">De Chinese Muur</a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={`${url('')}#afhalen`} class="no-underline hover:text-bordeaux">Afhalen</a></li>
          <li><a href={`${url('')}#restaurant`} class="no-underline hover:text-bordeaux">Restaurant</a></li>
          <li><a href={`${url('')}#catering`} class="no-underline hover:text-bordeaux">Catering</a></li>
          <li><a href={`${url('')}#contact`} class="no-underline hover:text-bordeaux">Contact</a></li>
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a href={site.telHref} class="btn btn-line-donker hidden size-10 p-0 text-sm min-[360px]:inline-flex sm:h-auto sm:w-auto sm:px-4 sm:py-2" aria-label={`Bel ${site.tel}`}>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
          <span class="hidden sm:inline num">{site.tel}</span>
        </a>
        <a href={site.bestellen} rel="noopener" class="btn btn-bordeaux px-4 py-2 text-sm">Bestellen</a>
      </div>
    </div>
  </header>
) : (
  <footer class="bg-wijn-deep py-12 text-paper/85">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-6"><strong class="font-display text-xl font-semibold text-paper">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br /><a href={site.telHref} class="num underline underline-offset-2">{site.tel}</a><br /><span class="text-oker-soft">KvK [[AANLEVEREN: KvK-nummer]]</span></p>
      <ul class="space-y-1 md:col-span-6 md:text-right">
        <li><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a></li>
        <li><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></li>
      </ul>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs text-paper/75">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
