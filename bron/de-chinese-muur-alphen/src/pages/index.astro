---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import AfhaalMenu from '../components/AfhaalMenu.astro';
import { Image } from 'astro:assets';
import { site, tijden, catering, cateringBasis } from '../data/site';
import hero from '../assets/hero.jpg';
import interieur from '../assets/interieur.jpg';

const belIcoon = 'M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z';
---
<Base
  title="De Chinese Muur | Chinees-Indisch restaurant in Alphen aan den Rijn"
  description="Chinees-Indische gerechten en Chinese specialiteiten van de familie Hu, Van Nesstraat 3 in Alphen aan den Rijn. Eten in het restaurant, afhalen, bezorgen of catering. Elke dag open vanaf 16:00."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: bordeaux vlak met de tekst, de gedekte tafel loopt rechts tot de rand. Op mobiel eerst de foto, dan de tekst. -->
    <section class="bg-wijn text-paper">
      <div class="lg:grid lg:grid-cols-12">
        <div class="h-56 overflow-hidden sm:h-72 lg:order-2 lg:col-span-5 lg:h-auto lg:min-h-[34rem]">
          <Foto src={hero} alt="Tafel met schalen Aziatische gerechten: gebakken rijst met kroepoek en ei, saté in saus, soep en witte rijst" hero sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div class="relative px-5 py-10 sm:px-8 lg:col-span-7 lg:flex lg:flex-col lg:justify-center lg:py-20 lg:pr-36 lg:pl-[max(2rem,calc((100vw-74rem)/2+2rem))]">
          <p lang="zh-Hant" aria-hidden="true" class="cjk absolute top-1/2 right-12 hidden -translate-y-1/2 text-[3.4rem] text-oker [writing-mode:vertical-rl] lg:block">長城酒樓</p>
          <p class="kicker text-oker">Chinees Indisch Restaurant in Alphen aan den Rijn</p>
          <h1 class="mt-4 text-4xl">Chinees-Indisch en Chinese specialiteiten, van de familie Hu</h1>
          <p class="mt-5 max-w-xl text-lg text-paper/85">Al tientallen jaren in Alphen aan den Rijn. Eet bij ons in het restaurant, haal af of laat bezorgen.</p>
          <div class="mt-8 flex flex-col gap-3 min-[400px]:flex-row min-[400px]:flex-wrap">
            <a href={site.bestellen} rel="noopener" class="btn btn-oker">Online bestellen</a>
            <a href={site.telHref} class="btn btn-line text-paper">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor"><path d={belIcoon} /></svg>
              Bel <span class="num">{site.tel}</span>
            </a>
          </div>
          <dl class="mt-9 grid grid-cols-2 gap-4 border-t border-paper/20 pt-6 text-sm sm:max-w-md">
            <div><dt class="text-paper/75">Google</dt><dd class="mt-1 text-paper"><strong class="font-display text-2xl font-semibold text-oker">4,0</strong> <span class="num">(305 reviews)</span></dd></div>
            <div><dt class="text-paper/75">Elke dag open</dt><dd class="mt-1 text-paper">vanaf <strong class="num font-display text-2xl font-semibold text-oker">16:00</strong></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <AfhaalMenu />

    <!-- Restaurant: eigen foto van de zaal links, tekst en twee prijsregels rechts, op een tweede licht vlak. -->
    <section id="restaurant" class="licht scroll-mt-16 bg-schelp py-14 lg:py-20">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
        <figure class="lg:col-span-6">
          <div class="max-w-[640px] overflow-hidden rounded-xl shadow-[0_1px_2px_#24151a33]">
            <Image src={interieur} alt="Het restaurant van De Chinese Muur" widths={[480, 640]} sizes="(min-width: 700px) 640px, 100vw" format="webp" quality={78} loading="lazy" class="block h-auto w-full" />
          </div>
        </figure>
        <div class="lg:col-span-6">
          <p class="kicker text-bordeaux">Restaurant</p>
          <h2 class="mt-3 text-3xl">Aan tafel, à la carte of met het keuzemenu</h2>
          <p class="mt-5 text-lg text-ink-soft">Wordt de keuze u te moeilijk, of houdt u van een verrassing? Ons personeel en onze koks bevelen graag een gerecht aan dat bij uw smaak past, en maken het voor u klaar.</p>
          <ul class="mt-8 divide-y divide-line border-y border-line">
            <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5">
              <h3 class="text-xl">5-gangen keuzemenu</h3>
              <p class="num font-display text-xl font-bold text-bordeaux">€33 p.p.</p>
            </li>
            <li class="py-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-xl">Lopend buffet</h3>
                <p class="num font-display text-xl font-bold text-bordeaux">€20 p.p.</p>
              </div>
              <p class="mt-2 text-ink-soft">Op aanvraag, voor groepen vanaf 10 personen en alleen op reservering. Samen met onze chef bepaalt u welke en hoeveel gerechten erin komen. Vraag gerust een vrijblijvende offerte; we stellen het zeer op prijs als u even langskomt om de mogelijkheden te bespreken.</p>
            </li>
          </ul>
          <a href={site.telHref} class="btn btn-bordeaux mt-8">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor"><path d={belIcoon} /></svg>
            Reserveren: <span class="num">{site.tel}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Catering: donker vlak. Wat in elk menu zit staat één keer, per menu alleen wat erbij komt. -->
    <section id="catering" class="scroll-mt-16 bg-wijn py-14 text-paper lg:py-20">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker text-oker">Catering</p>
          <h2 class="mt-3 text-3xl">Voor uw personeels- of familiefeest</h2>
          <p class="mt-5 text-paper/85">Drie cateringmenu’s om u op weg te helpen, vanaf 10 personen. Gerechten wijzigen of toevoegen kan, net als een menu op maat. Op aanvraag leent u ook servies en bestek, of huurt u personeel in.</p>
          <a href={site.telHref} class="btn btn-oker mt-7">Bel <span class="num">{site.tel}</span></a>
        </div>
        <div class="lg:col-span-8">
          <p class="rounded-xl bg-wijn-deep px-5 py-4"><span class="kicker text-oker-soft">In elk menu</span><br />{cateringBasis.join(', ').replace(/^./, (c) => c.toUpperCase())}.</p>
          <div class="mt-px grid gap-px overflow-hidden rounded-xl bg-paper/15 md:grid-cols-3">
            {catering.map((m) => (
              <article class="bg-wijn p-5 md:p-6">
                <h3 class="text-xl">{m.naam}</h3>
                <p class="mt-1"><span class="num font-display text-3xl font-bold text-oker">{m.prijs}</span> <span class="text-sm text-paper/85">per persoon</span></p>
                <p class="kicker mt-4 text-xs text-oker-soft">Plus</p>
                <ul class="mt-1.5 space-y-1">{m.extra.map((g) => <li>{g}</li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact: tijden als tabel, adres en bereikbaarheid ernaast. -->
    <section id="contact" class="licht scroll-mt-16 py-14 lg:py-20">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-bordeaux">Contact</p>
          <h2 class="mt-3 text-3xl">Open vanaf vier uur ’s middags</h2>
          <table class="mt-8 w-full text-left">
            <caption class="sr-only">Openingstijden</caption>
            <tbody class="divide-y divide-line border-y border-line">
              {tijden.map((t) => (
                <tr>
                  <th scope="row" class="py-4 pr-4 font-normal">{t.dag}</th>
                  <td class="num py-4 text-right font-semibold">{t.open} – {t.dicht}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-5 text-sm text-ink-soft">Voor een reservering of vraag op korte termijn kunt u het beste bellen.</p>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
          <div>
            <h3 class="text-xl">Adres</h3>
            <address class="mt-3 not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
            <a href={site.maps} rel="noopener" class="btn btn-line-donker mt-5 px-4 py-2 text-sm">Route plannen</a>
          </div>
          <div>
            <h3 class="text-xl">Telefoon</h3>
            <p class="mt-3"><a href={site.telHref} class="num font-display text-2xl font-bold text-bordeaux underline decoration-2 underline-offset-4">{site.tel}</a></p>
            <p class="mt-2 text-ink-soft">Mobiel: <a href={site.mobielHref} class="num text-ink underline underline-offset-2">{site.mobiel}</a></p>
          </div>
          <div>
            <h3 class="text-xl">Parkeren en OV</h3>
            <p class="mt-3 text-ink-soft">Gratis parkeren voor de deur en rondom het restaurant. Met het openbaar vervoer bent u er makkelijk vanaf het station.</p>
          </div>
          <div>
            <h3 class="text-xl">Bezorgen</h3>
            <p class="mt-3 text-ink-soft">Binnen Alphen boven <span class="num">€ 15</span> (kosten <span class="num">€ 3,00</span>), buiten Alphen vanaf <span class="num">€ 30</span> (kosten <span class="num">€ 4,50</span>). U vindt ons ook op Thuisbezorgd.nl.</p>
            <p class="mt-3"><a href={site.bestellen} rel="noopener" class="font-semibold text-bordeaux underline underline-offset-2">Online bestellen</a> · <a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
