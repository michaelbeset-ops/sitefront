---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, staffel, hapmenu, rijsttafels, catering } from '../data/site';
import hero from '../assets/hero.jpg';
import nasi from '../assets/nasi.jpg';
import sate from '../assets/sate.jpg';
import bami from '../assets/bami.jpg';
import zoetzuur from '../assets/zoetzuur.jpg';

const belIcoon = 'M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z';
---
<Base
  title="De Chinese Muur | Chinees-Indisch restaurant in Alphen aan den Rijn"
  description="Chinees-Indische gerechten en Chinese specialiteiten van de familie Hu, Van Nesstraat 3 in Alphen aan den Rijn. Eten in het restaurant, afhalen, bezorgen of catering. Elke dag open vanaf 16:00."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: bordeaux vlak met de tekst, de gedekte tafel loopt rechts tot de rand. Op mobiel eerst de foto, dan de tekst. -->
    <section class="bg-wijn text-paper">
      <div class="lg:grid lg:grid-cols-12">
        <div class="h-56 overflow-hidden sm:h-72 lg:order-2 lg:col-span-5 lg:h-auto lg:min-h-[34rem]">
          <Foto src={hero} alt="Tafel met schalen Aziatische gerechten: gebakken rijst met kroepoek en ei, saté in saus, soep en witte rijst" hero sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div class="px-5 py-10 sm:px-8 lg:col-span-7 lg:flex lg:flex-col lg:justify-center lg:py-20 lg:pr-12 lg:pl-[max(2rem,calc((100vw-74rem)/2+2rem))]">
          <p class="kicker text-oker">Van Nesstraat 3, Alphen aan den Rijn</p>
          <h1 class="mt-4 text-4xl">Chinees-Indisch en Chinese specialiteiten, van de familie Hu</h1>
          <p class="mt-5 max-w-xl text-lg text-paper/85">Al tientallen jaren in Alphen aan den Rijn. Eet bij ons in het restaurant, haal af of laat bezorgen.</p>
          <div class="mt-8 flex flex-col gap-3 min-[400px]:flex-row min-[400px]:flex-wrap">
            <a href={site.bestellen} rel="noopener" class="btn btn-oker">Online bestellen</a>
            <a href={site.telHref} class="btn btn-line text-paper">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor"><path d={belIcoon} /></svg>
              Bel <span class="num">{site.tel}</span>
            </a>
          </div>
          <dl class="mt-9 grid grid-cols-2 gap-4 border-t border-paper/20 pt-6 text-sm sm:max-w-md">
            <div><dt class="text-paper/75">Google</dt><dd class="mt-1 text-paper"><strong class="font-display text-2xl font-semibold text-oker">4,0</strong> <span class="num">(305 reviews)</span></dd></div>
            <div><dt class="text-paper/75">Elke dag open</dt><dd class="mt-1 text-paper">vanaf <strong class="num font-display text-2xl font-semibold text-oker">16:00</strong></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Afhalen: de staffel als trap, het hapmenu als donkere kaart ernaast. -->
    <section id="afhalen" class="licht scroll-mt-16 py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-bordeaux">Afhalen en bezorgen</p>
            <h2 class="mt-3 text-3xl">Bij grote afhaalbestellingen iets extra</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5">Haalt u zelf af, dan krijgt u bij een grotere bestelling gratis kroepoek of miniloempia’s. Bestel online of bel ons.</p>
        </div>

        <div class="mt-12 grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <ol class="space-y-3">
              {staffel.map((s, i) => (
                <li class={`flex items-center gap-4 rounded-xl bg-schelp px-5 py-4 ${['', 'sm:ml-8', 'sm:ml-16'][i]}`}>
                  <span class="w-20 shrink-0"><span class="block text-xs text-ink-soft">boven</span>
                  <span class="num block font-display text-2xl leading-tight font-bold text-bordeaux">{s.grens}</span></span>
                  <span class="font-semibold">{s.krijgt}</span>
                </li>
              ))}
            </ol>
            <p class="mt-4 text-sm text-ink-soft">Geldt bij afhalen, niet bij bezorgen.</p>

            <div class="mt-10 rounded-xl border-l-4 border-bordeaux bg-white px-5 py-5 shadow-[0_1px_2px_#24151a1f]">
              <h3 class="text-xl">Belt u ons? Controleer even het nummer</h3>
              <p class="mt-2 text-ink-soft">Wij zijn De Chinese Muur in Alphen aan den Rijn, niet die in Boskoop. Een verkeerd doorgebelde bestelling is zonde, en vervelend voor de keuken. Ons nummer is <a href={site.telHref} class="num font-semibold text-bordeaux underline underline-offset-2">{site.tel}</a>.</p>
            </div>

            <div class="mt-10 grid gap-6 sm:grid-cols-2">
              <div>
                <h3 class="text-xl">Bezorgen</h3>
                <dl class="mt-3 divide-y divide-line border-y border-line text-sm">
                  <div class="flex justify-between gap-4 py-3"><dt>Binnen Alphen</dt><dd class="text-right">boven <span class="num">€15</span>, kosten <span class="num">€3</span></dd></div>
                  <div class="flex justify-between gap-4 py-3"><dt>Buiten Alphen</dt><dd class="text-right">vanaf <span class="num">€30</span>, kosten <span class="num">€4,50</span></dd></div>
                </dl>
                <p class="mt-3 text-sm text-ink-soft">U vindt ons ook op Thuisbezorgd.nl.</p>
              </div>
              <div>
                <h3 class="text-xl">Rijst erbij</h3>
                <p class="mt-3 text-sm text-ink-soft">Bij al onze gerechten zit een klein bakje witte rijst. Nasi of bami (ook vegetarisch) kost <span class="num">€1,50</span> extra, Indische nasi <span class="num">€3,50</span>. Bij sommige gecombineerde gerechten zit nasi of bami al in de prijs.</p>
              </div>
            </div>
          </div>

          <div class="grid content-start gap-6 lg:col-span-5">
            <article class="rounded-xl bg-wijn p-6 text-paper sm:p-8">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-2xl">Hapmenu voor 2 personen</h3>
                <p class="num font-display text-2xl font-bold text-oker">{hapmenu.prijs}</p>
              </div>
              <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
                <div>
                  <p class="kicker text-oker-soft">Voorgerechten</p>
                  <ul class="mt-2 space-y-1">{hapmenu.voor.map((g) => <li>{g}</li>)}</ul>
                </div>
                <div>
                  <p class="kicker text-oker-soft">Hoofdgerechten</p>
                  <ul class="mt-2 space-y-1">{hapmenu.hoofd.map((g) => <li>{g}</li>)}</ul>
                </div>
              </div>
              <p class="mt-6 border-t border-paper/20 pt-4 text-sm text-paper/85">Inclusief nasi, bami of witte rijst.</p>
              <a href={site.bestellen} rel="noopener" class="btn btn-oker mt-6 w-full">Bestel het hapmenu</a>
            </article>
            <div class="grid grid-cols-2 gap-4">
              <div class="aspect-square overflow-hidden rounded-xl"><Foto src={sate} alt="Bord met satéstokjes, gebakken uitjes en lente-ui, met pindasaus en rode pepers" sizes="(min-width: 1024px) 220px, 50vw" /></div>
              <div class="aspect-square overflow-hidden rounded-xl"><Foto src={nasi} alt="Bord gebakken rijst met ei en garnalen, met een lepel" sizes="(min-width: 1024px) 220px, 50vw" /></div>
            </div>
          </div>
        </div>

        <div class="mt-16 grid gap-6 border-t border-line pt-10 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h3 class="text-2xl">Rijsttafels om te delen</h3>
            <p class="mt-2 text-ink-soft">Menu’s met veel verschillende soorten gerechten, om af te halen.</p>
          </div>
          <ul class="grid gap-x-8 sm:grid-cols-2 lg:col-span-8">
            {rijsttafels.map((r) => <li class="border-b border-line py-3 font-display text-lg">{r}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Restaurant: foto links, tekst en twee prijsregels rechts, op een tweede licht vlak. -->
    <section id="restaurant" class="licht scroll-mt-16 bg-schelp py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="aspect-[4/3] overflow-hidden rounded-xl lg:col-span-5 lg:aspect-[4/5]">
          <Foto src={zoetzuur} alt="Driehoekig bord met kip in glanzende oranje saus, broccoli en schijfjes sinaasappel, met een bakje witte rijst" sizes="(min-width: 1024px) 460px, 100vw" />
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="kicker text-bordeaux">Restaurant</p>
          <h2 class="mt-3 text-3xl">Aan tafel, à la carte of met het keuzemenu</h2>
          <p class="mt-5 text-lg text-ink-soft">Wordt de keuze u te moeilijk, of houdt u van een verrassing? Ons personeel en onze koks bevelen graag een gerecht aan dat bij uw smaak past, en maken het voor u klaar.</p>
          <ul class="mt-8 divide-y divide-line border-y border-line">
            <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5">
              <h3 class="text-xl">5-gangen keuzemenu</h3>
              <p class="num font-display text-xl font-bold text-bordeaux">€33 p.p.</p>
            </li>
            <li class="py-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-xl">Lopend buffet</h3>
                <p class="num font-display text-xl font-bold text-bordeaux">€20 p.p.</p>
              </div>
              <p class="mt-2 text-ink-soft">Op aanvraag, voor groepen vanaf 10 personen en alleen op reservering. Samen met onze chef bepaalt u welke en hoeveel gerechten erin komen. Vraag gerust een vrijblijvende offerte; we stellen het zeer op prijs als u even langskomt om de mogelijkheden te bespreken.</p>
            </li>
          </ul>
          <a href={site.telHref} class="btn btn-bordeaux mt-8">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor"><path d={belIcoon} /></svg>
            Reserveren: <span class="num">{site.tel}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Catering: donker vlak, drie menu's naast elkaar als kolommen met een okeren prijs. -->
    <section id="catering" class="scroll-mt-16 bg-wijn py-16 text-paper lg:py-24">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-oker">Catering</p>
            <h2 class="mt-3 text-3xl">Voor uw personeels- of familiefeest</h2>
            <p class="mt-5 max-w-xl text-lg text-paper/85">Drie cateringmenu’s om u op weg te helpen. Gerechten wijzigen of toevoegen kan, net als een menu op maat. Op aanvraag leent u ook servies en bestek, of huurt u personeel in.</p>
          </div>
          <div class="hidden aspect-[4/3] overflow-hidden rounded-xl lg:col-span-4 lg:col-start-9 lg:block">
            <Foto src={bami} alt="Gebakken noedels met groente op een houten plank, met eetstokjes" sizes="(min-width: 1024px) 380px, 100vw" />
          </div>
        </div>

        <div class="mt-12 grid gap-px overflow-hidden rounded-xl bg-paper/15 md:grid-cols-3">
          {catering.map((m) => (
            <article class="bg-wijn p-6 md:p-7">
              <h3 class="text-2xl">{m.naam}</h3>
              <p class="mt-2"><span class="num font-display text-3xl font-bold text-oker">{m.prijs}</span> <span class="text-paper/85">per persoon</span></p>
              <p class="text-sm text-paper/75">vanaf 10 personen</p>
              <p class="kicker mt-6 text-oker-soft">Voorgerechten</p>
              <ul class="mt-2 space-y-1">{m.voor.map((g) => <li>{g}</li>)}</ul>
              <p class="kicker mt-5 text-oker-soft">Hoofdgerechten</p>
              <ul class="mt-2 space-y-1">{m.hoofd.map((g) => <li>{g}</li>)}</ul>
              <p class="mt-5 text-sm text-paper/75">Inclusief nasi, bami en witte rijst.</p>
            </article>
          ))}
        </div>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-paper/85">Liever een cateringmenu op maat? Bel ons om het te bespreken.</p>
          <a href={site.telHref} class="btn btn-oker shrink-0">Bel <span class="num">{site.tel}</span></a>
        </div>
      </div>
    </section>

    <!-- Contact: tijden als tabel, adres en bereikbaarheid ernaast. -->
    <section id="contact" class="licht scroll-mt-16 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-bordeaux">Contact</p>
          <h2 class="mt-3 text-3xl">Open vanaf vier uur ’s middags</h2>
          <table class="mt-8 w-full text-left">
            <caption class="sr-only">Openingstijden</caption>
            <tbody class="divide-y divide-line border-y border-line">
              {tijden.map((t) => (
                <tr>
                  <th scope="row" class="py-4 pr-4 font-normal">{t.dag}</th>
                  <td class="num py-4 text-right font-semibold">{t.open} – {t.dicht}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-5 text-sm text-ink-soft">Voor een reservering of vraag op korte termijn kunt u het beste bellen.</p>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
          <div>
            <h3 class="text-xl">Adres</h3>
            <address class="mt-3 not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
            <a href={site.maps} rel="noopener" class="btn btn-line-donker mt-5 px-4 py-2 text-sm">Route plannen</a>
          </div>
          <div>
            <h3 class="text-xl">Telefoon</h3>
            <p class="mt-3"><a href={site.telHref} class="num font-display text-2xl font-bold text-bordeaux underline decoration-2 underline-offset-4">{site.tel}</a></p>
            <p class="mt-2 text-ink-soft">Mobiel: <a href={site.mobielHref} class="num text-ink underline underline-offset-2">{site.mobiel}</a></p>
          </div>
          <div>
            <h3 class="text-xl">Parkeren en OV</h3>
            <p class="mt-3 text-ink-soft">Gratis parkeren voor de deur en rondom het restaurant. Met het openbaar vervoer bent u er makkelijk vanaf het station.</p>
          </div>
          <div>
            <h3 class="text-xl">Online</h3>
            <ul class="mt-3 space-y-2">
              <li><a href={site.bestellen} rel="noopener" class="font-semibold text-bordeaux underline underline-offset-2">Online bestellen</a></li>
              <li><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Volg ons op Facebook</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
