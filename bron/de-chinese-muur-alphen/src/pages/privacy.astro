---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site, url } from '../data/site';
---
<Base title={`Privacyverklaring | ${site.naam}`} description={`Hoe ${site.naam} in Alphen aan den Rijn omgaat met uw gegevens.`}>
  <Chrome deel="kop" />
  <main id="inhoud" class="licht wrap max-w-3xl py-14 lg:py-20">
    <p><a href={url('')} class="underline underline-offset-2">Terug naar de homepage</a></p>
    <h1 class="mt-4 text-3xl">Privacyverklaring</h1>
    <div class="mt-8 space-y-6">
      <section>
        <h2 class="text-xl">Wie wij zijn</h2>
        <p class="mt-2">{site.naam}, {site.straat}, {site.postcode} {site.plaats}. Telefoon: <a href={site.telHref} class="num underline">{site.tel}</a>. <span class="text-sm text-ink-soft">KvK [[AANLEVEREN: KvK-nummer]]</span></p>
      </section>
      <section>
        <h2 class="text-xl">Welke gegevens</h2>
        <p class="mt-2">Als u belt om te bestellen, te reserveren of catering te bespreken, krijgen wij uw naam, telefoonnummer en bij bezorging uw adres. Die gebruiken we alleen om uw bestelling of reservering af te handelen. Bestelt u online, dan loopt dat via de bestelpagina van Foodticket; daar geldt ook hun eigen privacyverklaring.</p>
      </section>
      <section>
        <h2 class="text-xl">Hoe lang</h2>
        <p class="mt-2">We bewaren uw gegevens niet langer dan nodig. <span class="text-sm text-ink-soft">[[AANLEVEREN: bevestiging bewaartermijn]]</span></p>
      </section>
      <section>
        <h2 class="text-xl">Cookies</h2>
        <p class="mt-2">Deze website plaatst geen cookies en gebruikt geen statistieken, advertenties of ingesloten kaarten. Daarom ziet u ook geen cookiemelding. Links naar andere diensten, zoals de bestelpagina, Google Maps of Facebook, openen een pagina van die dienst.</p>
      </section>
      <section>
        <h2 class="text-xl">Uw rechten</h2>
        <p class="mt-2">U mag altijd vragen welke gegevens wij van u hebben, en vragen om ze aan te passen of te verwijderen. Bel ons daarvoor op <span class="num">{site.tel}</span>. Bent u het niet eens met hoe wij met uw gegevens omgaan, dan kunt u een klacht indienen bij de Autoriteit Persoonsgegevens.</p>
      </section>
    </div>
  </main>
  <Chrome deel="voet" />
</Base>
