---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waAfspraak, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import werkplaats from '../assets/werkplaats.jpg';
import monteur from '../assets/monteur.jpg';
import mini from '../assets/mini.jpg';
import mo from '../assets/mo.jpg';
import pand from '../assets/pand.jpg';
import bus from '../assets/bus.jpg';
import vlaggen from '../assets/vlaggen.jpg';

const vraag = (t: string) => waMet(`Hallo Mo, ik heb een vraag over: ${t.toLowerCase()}.`);

const diensten = [
  { id: 'onderhoud', t: 'Onderhoud en reparaties', d: 'Een kleine of grote beurt volgens de fabrieksvoorschriften, en reparaties.', src: monteur, alt: 'Monteur van MOTECH aan het werk onder de motorkap', pos: '60% 40%', href: '#onderhoud', knop: 'Bekijk de pakketten' },
  { id: 'apk', t: 'APK-keuring', d: 'Gekeurd volgens het RDW-handboek. Vinden we iets, dan nemen we eerst contact met u op.', src: werkplaats, alt: 'De werkplaats van MOTECH met drie auto’s op de bruggen', pos: '50% 30%', href: '#apk', knop: 'Wanneer moet ik?' },
  { id: 'occasions', t: 'Occasions', d: 'Tijd voor een andere auto? Ons actuele aanbod staat op Marktplaats.', src: mini, alt: 'Een groene klassieke Mini in de werkplaats van MOTECH', pos: '35% 60%', href: site.marktplaats, knop: 'Bekijk het aanbod' },
];

const klein = [
  { icoon: 'euro', t: 'Auto verkopen', d: 'Nieuw, met een paar deukjes of hij doet niets meer: wij hebben interesse.', href: '#verkopen' },
  { icoon: 'export', t: 'Export', d: 'Exportbevoegd. Exportdocumenten, tijdelijk kenteken en exportverzekering.', href: '#verkopen' },
  { icoon: 'band', t: 'Banden en airco', d: 'Montage van zomer- of winterbanden. Airco controleren en afvullen.', href: '#onderhoud' },
];

const pakketten = [
  { t: 'Kleine beurt', prijs: '65', items: ['Olie', 'Oliefilter', 'Technische controle', 'Bandenspanning en staat'] },
  { t: 'Grote beurt', prijs: '150', best: true, items: ['Olie', 'Oliefilter', 'Luchtfilter', 'Interieurfilter', 'Brandstoffilter', 'Technische controle', 'Bandenspanning en staat', 'Vloeistoffen aanvullen', 'Bougies vervangen (alleen benzinemotoren)'] },
  { t: 'Grote beurt plus', prijs: '250', items: ['Olie', 'Oliefilter', 'Luchtfilter', 'Interieurfilter', 'Brandstoffilter', 'Technische controle', 'Bandenspanning en staat', 'Vloeistoffen aanvullen', 'Versnellingsbakolie verversen', 'Remvloeistof verversen', 'Remsysteem controleren en reinigen', 'Airco controleren en afvullen'] },
];

const stappen = [
  ['Bel, app of kom langs', 'Even telefonisch contact is het snelst. Langskomen om het werk vooraf te overleggen mag altijd.'],
  ['Vooraf een prijsindicatie', 'Voor werkzaamheden aan uw auto krijgt u altijd vooraf een prijsindicatie.'],
  ['In de werkplaats', 'Onderhoud volgens de richtlijnen van de fabrikant. Extra kosten alleen in overleg.'],
  ['Heldere uitleg', 'U hoort wat er is gedaan, wat nu nodig is en wat nog even kan wachten.'],
];

const nu = new Date().getFullYear();
const jaren = Array.from({ length: nu - 1969 }, (_, i) => nu - i);
---
<Base title={`${site.naam} | Universeelgarage in Arkel`} description="Autobedrijf MOTECH in Arkel: onderhoud, APK-keuring (RDW-erkend keurstation), reparaties, occasions, auto verkopen en export. 4,8 op Google. Bel of app 06 41 60 66 80.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen werkplaats op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-marine text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1a2044b3_0%,#1a2044d9_45%,#1a2044f5_100%)] md:bg-[linear-gradient(90deg,#1a2044f7_0%,#1a2044d9_45%,#1a204459_100%)]" aria-hidden="true"></div>
      <svg class="pointer-events-none absolute -bottom-6 right-[-8%] -z-10 hidden w-[62%] text-roze/35 md:block" viewBox="0 0 168 50" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M3 41C9 31 22 26.5 39 25.5 51 14 67 5.5 88 5.5c19 0 33 7.5 43 16.5 16 1.5 29 7.5 34 19" stroke-width=".7" /></svg>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-24 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Universeelgarage in Arkel</p>
          <h1 id="t-hero" class="mt-5 text-hero">Goede service, <span class="text-roze">uitstekende</span> prijs.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Onderhoud, APK, reparaties, occasions, inkoop en export. Al vanaf 2012 uw garage in Arkel, Gorinchem en omstreken.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-rood"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#onderhoud" class="knop knop-rand op-foto">Bekijk de onderhoudspakketten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.30 tot 17.30 uur</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto w-full max-w-[19rem] rounded-lg bg-licht/10 p-2.5 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <Image src={mo} alt="Mhamed El Mousati, eigenaar van MOTECH, in een trui met het MOTECH-logo" widths={[320, 600]} sizes="300px" loading="eager" class="aspect-[4/5] w-full rounded-md object-cover object-[50%_20%]" />
            <figcaption class="px-2 pb-1 pt-3 text-sm">
              <b class="block font-kop text-base text-licht">Mhamed El Mousati</b>
              <span class="text-licht-zacht">Eigenaar, 1e monteur en APK-keurmeester</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips: de diensten van hun vlaggen -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-md bg-staal px-4 py-2 font-kop text-sm font-semibold no-underline transition-colors hover:bg-marine hover:text-licht">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-4 text-3xl">Alles voor uw auto, onder één dak.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een full-service werkwijze: van de kleine beurt tot de APK, van inkoop tot export.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-14 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={b.href} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1248px) 380px, (min-width: 768px) 31vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 flex-col p-6 md:p-7">
                  <h3 class="text-xl">{b.t}</h3>
                  <p class="mt-2 flex-1 text-grijs">{b.d}</p>
                  <span class="mt-6 inline-flex items-center gap-2 font-kop font-bold text-rood">{b.knop}<Icoon naam="pijl" class="h-5 w-5 transition-transform group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-5 grid gap-5 md:grid-cols-3 lg:gap-6">
          {klein.map((k, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={k.href} class="group flex h-full items-start gap-5 rounded-lg border border-lijn bg-staal/60 p-6 no-underline transition-colors hover:bg-wit md:p-7">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-md bg-marine text-licht transition-colors group-hover:bg-rood"><Icoon naam={k.icoon} class="h-6 w-6" /></span>
                <span><h3 class="text-lg">{k.t}</h3><span class="mt-1.5 block text-[.9375rem] text-grijs">{k.d}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Onderhoudspakketten -->
    <section id="onderhoud" class="donker bg-marine py-24 text-licht lg:py-28" aria-labelledby="t-pakketten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Onderhoudspakketten</p>
            <h2 id="t-pakketten" class="mt-4 text-3xl">Vriendelijk voor u en uw portemonnee.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Drie pakketten met een vanaf-prijs, zodat u vooraf weet waar u aan toe bent. Afwijken van een pakket kan natuurlijk altijd.</p>
        </div>
        <ul class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-3 lg:items-stretch lg:gap-6">
          {pakketten.map((p, i) => (
            <li class={`rijs relative flex flex-col rounded-lg p-7 md:p-8 ${p.best ? 'bg-wit text-inkt shadow-md lg:-my-4 lg:py-12' : 'bg-marine-2'}`} style={`--d:${i * 0.06}s`}>
              {p.best && <p class="absolute -top-3.5 left-7 rounded-sm bg-rood px-3 py-1 font-kop text-xs font-bold uppercase tracking-[.16em] text-wit">Beste keus</p>}
              <h3 class="text-2xl">{p.t}</h3>
              <p class="mt-5 flex items-baseline gap-2"><span class={`text-sm ${p.best ? 'text-grijs' : 'text-licht-zacht'}`}>vanaf</span><span class="num whitespace-nowrap font-kop text-[3.25rem] font-extrabold leading-none tracking-[-0.02em]">€&#8239;{p.prijs}</span></p>
              <ul class={`mt-7 flex-1 space-y-2.5 border-t pt-6 text-[.9375rem] ${p.best ? 'border-lijn' : 'border-lijn-licht text-licht-zacht'}`}>
                {p.items.map((it) => <li class="flex gap-3"><Icoon naam="vink" class={`mt-1 h-4 w-4 shrink-0 ${p.best ? 'text-rood' : 'text-roze'}`} />{it}</li>)}
              </ul>
              <a href={waMet(`Hallo Mo, ik wil graag een afspraak maken voor een ${p.t.toLowerCase()}.`)} class={`knop mt-8 w-full ${p.best ? 'knop-rood' : 'knop-rand'}`}><Icoon naam="wa" />Plan een {p.t.toLowerCase()}</a>
            </li>
          ))}
        </ul>
        <p class="rijs mt-12 max-w-3xl text-licht-zacht">Daarnaast hanteren we een uurtarief en tarieven voor bandenopslag. Vraag er gerust naar.</p>
      </div>
    </section>

    <!-- 5. APK-wijzer -->
    <section id="apk" class="py-20 lg:py-24" aria-labelledby="t-apk">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">APK-keuring</p>
          <h2 id="t-apk" class="mt-4 text-3xl">Wanneer moet uw auto door de APK?</h2>
          <p class="mt-6 text-lg text-grijs">MOTECH is een RDW-erkend keurstation. De keurmeester loopt alle punten na uit het RDW-handboek. Vindt hij een probleem, dan nemen we altijd eerst contact met u op: extra kosten gaan in overleg.</p>
          <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-2.5 text-[.9375rem]">
            {['Remmen', 'Verlichting', 'Stuurinrichting', 'Wielophanging', 'Wielen en banden', 'Uitlaat en uitlaatgassen', 'Autogordels', 'Spiegels en voorruit'].map((p) => <li class="flex items-center gap-2.5"><Icoon naam="vink" class="h-4 w-4 shrink-0 text-rood" />{p}</li>)}
          </ul>
        </div>
        <div class="lg:col-span-7">
          <form class="kaart overflow-hidden" data-apk aria-labelledby="t-wijzer">
            <div class="flex items-center gap-4 bg-marine px-6 py-5 text-licht sm:px-8">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-rood text-wit"><Icoon naam="keuring" class="h-6 w-6" /></span>
              <div><h3 id="t-wijzer" class="text-xl">APK-wijzer</h3><p class="text-sm text-licht-zacht">Twee vragen, dan weet u hoe vaak uw auto gekeurd moet worden.</p></div>
            </div>
            <div class="p-6 sm:p-8">
              <fieldset>
                <legend class="text-sm font-semibold">Brandstof</legend>
                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                  <label class="keuze"><input type="radio" name="brandstof" value="benzine" class="sr-only" checked /><span>Benzine of elektrisch</span></label>
                  <label class="keuze"><input type="radio" name="brandstof" value="diesel" class="sr-only" /><span>Diesel of LPG</span></label>
                </div>
              </fieldset>
              <label class="mt-6 block"><span class="text-sm font-semibold">Bouwjaar</span>
                <select name="jaar" class="veld mt-2">
                  {jaren.map((j) => <option value={j} selected={j === nu - 6}>{j}</option>)}
                </select>
              </label>
              <div class="uitkomst mt-7 rounded-md bg-staal p-5 sm:p-6" aria-live="polite" data-uitkomst>
                <p class="font-kop text-xl font-bold" data-kop>Benzine of elektrisch</p>
                <ul class="mt-3 space-y-1.5 text-[.9375rem] text-grijs" data-regels>
                  <li>Eerste keuring na 4 jaar, daarna om de 2 jaar, vanaf 8 jaar elk jaar.</li>
                  <li>Diesel of LPG: eerste keuring na 3 jaar, daarna elk jaar.</li>
                </ul>
              </div>
              <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
                <a href={waMet('Hallo Mo, ik wil graag een APK-afspraak maken.')} class="knop knop-rood" data-apk-wa><Icoon naam="wa" />Plan mijn APK</a>
                <p class="text-sm text-grijs">Keuren mag tot 2 maanden vóór de vervaldatum.</p>
              </div>
            </div>
          </form>
          <p class="mt-4 text-sm text-grijs">Een indicatie op basis van het bouwjaar, volgens de regels op onze APK-pagina. De precieze vervaldatum staat bij de RDW.</p>
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section class="bg-staal py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo werken we</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Vooraf weten waar u aan toe bent.</h2>
          </div>
          <blockquote class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg">“Geen poespas met offertes, spreekt alles van te voren met je af.”</p>
            <footer class="mt-2 text-sm text-grijs">Zow Z., Google review</footer>
          </blockquote>
        </div>
        <ol class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative overflow-hidden p-6 sm:p-7" style={`--d:${i * 0.06}s`}>
              <span class="stap-streep" aria-hidden="true"></span>
              <p class="num font-kop text-[2.5rem] font-extrabold leading-none text-rood">0{i + 1}</p>
              <h3 class="mt-6 text-xl">{t}</h3>
              <p class="mt-2.5 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over Mo -->
    <section id="over" class="donker bg-marine text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[24rem] sm:min-h-[32rem] lg:col-span-5">
          <Image src={pand} alt="De werkplaats aan de Vlietskade, met het MOTECH-bord boven de roldeur" widths={[640, 970]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[30%_50%]" />
          <p class="absolute bottom-4 left-4 rounded-sm bg-rood px-3.5 py-1.5 font-kop text-sm font-bold text-wit">Vlietskade 9015, Arkel</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Even voorstellen</p>
          <h2 id="t-over" class="mt-4 text-3xl">Voor technische vragen kunt u bij Mo terecht.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Mhamed El Mousati begon ooit als monteur voor Renault en groeide door tot 1e monteur en keurmeester. Na tien jaar in loondienst begon hij zijn eigen autobedrijf: MOTECH. Een servicegericht bedrijf dat staat voor persoonlijk en direct contact.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-marine-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-rood text-wit"><Icoon naam="sleutel" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">1e monteur en technisch specialist</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">En zelf APK-keurmeester.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-marine-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-rood text-wit"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Persoonlijk en direct contact</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Alle contactaanvragen worden door de hoofdmonteur afgehandeld.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-marine-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-rood text-wit"><Icoon naam="kop" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">De koffie staat klaar</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Ook voor vragen bent u welkom om langs te komen.</p></div>
            </li>
          </ul>
          <a href={waAfspraak} class="knop knop-rood mt-8"><Icoon naam="wa" />App Mo</a>
        </div>
      </div>
    </section>

    <!-- 8. Auto verkopen en export -->
    <section id="verkopen" class="py-20 lg:py-24" aria-labelledby="t-verkopen">
      <div class="wrap grid gap-5 lg:grid-cols-12 lg:gap-6">
        <div class="rijs kaart flex flex-col p-7 md:p-10 lg:col-span-7">
          <p class="eyebrow">Auto verkopen</p>
          <h2 id="t-verkopen" class="mt-4 text-3xl">Direct geld voor uw auto.</h2>
          <p class="mt-6 text-lg text-grijs">Gloednieuw, wat ouder of hij start helemaal niet meer: MOTECH koopt uw auto in, voor een zo eerlijk mogelijke prijs. Wij hebben alleen het kenteken, de kilometerstand en uw contactgegevens nodig. Stuurt u die door, dan heeft u binnen 24 uur een reactie met een bod.</p>
          <ol class="mt-8 grid gap-3 sm:grid-cols-3">
            {['Kenteken', 'Kilometerstand', 'Uw telefoon of e-mail'].map((t, i) => (
              <li class="flex items-center gap-3 rounded-md bg-staal px-4 py-3.5"><span class="num font-kop text-xl font-extrabold text-rood">0{i + 1}</span><span class="font-kop font-semibold leading-tight">{t}</span></li>
            ))}
          </ol>
          <div class="mt-auto pt-8">
            <a href={waMet('Hallo Mo, ik wil mijn auto verkopen.\nKenteken: \nKilometerstand: ')} class="knop knop-marine"><Icoon naam="wa" />Vraag een bod aan</a>
          </div>
        </div>
        <div class="rijs flex flex-col overflow-hidden rounded-lg bg-marine text-licht lg:col-span-5" style="--d:.06s">
          <div class="donker p-7 md:p-10">
            <p class="eyebrow">Export</p>
            <h3 class="mt-4 text-2xl">Uw voertuig exporteren</h3>
            <p class="mt-4 text-licht-zacht">MOTECH is exportbevoegd. Er zijn twee mogelijkheden:</p>
            <ul class="mt-5 space-y-4 text-[.9375rem]">
              <li class="border-l-2 border-roze pl-4"><b class="font-kop text-licht">Zelf rijden naar de bestemming</b><span class="mt-1 block text-licht-zacht">Exportdocumenten, tijdelijk kenteken en exportverzekering: wij leveren ze alle drie.</span></li>
