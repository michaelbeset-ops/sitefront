<script>
  // APK-wijzer: regels zoals op hun eigen APK-pagina.
  const f = document.querySelector<HTMLFormElement>('[data-apk]');
  if (f) {
    const kop = f.querySelector<HTMLElement>('[data-kop]')!;
    const regels = f.querySelector<HTMLElement>('[data-regels]')!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-apk-wa]')!;
    const nu = new Date().getFullYear();
    const reken = () => {
      const d = new FormData(f);
      const diesel = d.get('brandstof') === 'diesel';
      const jaar = Number(d.get('jaar'));
      const oud = nu - jaar;
      const soort = diesel ? 'diesel of LPG' : 'benzine of elektrisch';
      let titel: string; const r: string[] = [];
      if (diesel) {
        if (oud < 3) { titel = `Eerste APK in ${jaar + 3}`; r.push('Diesel en LPG: de eerste keuring is na 3 jaar.', 'Daarna moet de auto elk jaar door de APK.'); }
        else { titel = 'Elk jaar een APK'; r.push('Diesel en LPG: vanaf de eerste keuring elk jaar.'); }
      } else {
        if (oud < 4) { titel = `Eerste APK in ${jaar + 4}`; r.push('Benzine en elektrisch: de eerste keuring is na 4 jaar.', `Daarna om de 2 jaar, en vanaf ${jaar + 8} elk jaar.`); }
        else if (oud < 8) { titel = 'Om de 2 jaar een APK'; r.push(`Vanaf ${jaar + 8} is de auto 8 jaar oud en moet hij elk jaar.`); }
        else { titel = 'Elk jaar een APK'; r.push('Auto’s van 8 jaar of ouder moeten elk jaar gekeurd worden.'); }
      }
      if (oud >= 50) r.push('Oldtimers van 50 jaar of ouder zijn onder bepaalde voorwaarden vrijgesteld.');
      kop.textContent = titel;
      regels.innerHTML = '';
      r.forEach((t) => { const li = document.createElement('li'); li.textContent = t; regels.appendChild(li); });
      wa.href = 'https://wa.me/31641606680?text=' + encodeURIComponent(`Hallo Mo, ik wil graag een APK-afspraak maken voor mijn auto (${soort}, bouwjaar ${jaar}).`);
    };
    f.addEventListener('change', reken);
    f.addEventListener('submit', (e) => e.preventDefault());
    reken();
  }

  const c = document.querySelector<HTMLFormElement>('[data-wa]');
  if (c) {
    c.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(c);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hallo Mo, ik wil graag een afspraak maken.'];
      if (v('wat')) r.push('Waarvoor: ' + v('wat'));
      if (v('auto')) r.push('Auto: ' + v('auto'));
      if (v('dag')) r.push('Het liefst op: ' + v('dag').toLowerCase());
      if (v('wens')) r.push(v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31641606680?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

