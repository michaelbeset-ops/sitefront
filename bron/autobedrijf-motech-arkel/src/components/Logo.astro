---
// Hun logo nagetekend: de rode autolijn die over "Autobedrijf MOTECH" heen loopt, met twee wielkasten eronder.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<svg class={`logo ${licht ? 'logo-licht' : ''} ${cls}`} viewBox="0 0 200 62" fill="none" aria-hidden="true">
  <path class="lijn" d="M4 52C6 41 16 35 34 32.5 50 16 73 6 100 6s49 9 64 24c18 2.5 30 10 32 22" stroke-width="2.6" stroke-linecap="round" />
  <path class="lijn" d="M17 59c4-8 17-8 21 0M162 59c4-8 17-8 21 0" stroke-width="3" stroke-linecap="round" />
  <text x="100" y="27" text-anchor="middle" class="klein">AUTOBEDRIJF</text>
  <text x="100" y="52" text-anchor="middle" class="groot">MOTECH</text>
</svg>

<style>
  .logo { display: block; width: 10.75rem; height: auto; }
  .lijn { stroke: var(--color-rood); }
  .klein { font-family: var(--font-kop); font-size: 8.5px; font-weight: 600; letter-spacing: 3.4px; fill: var(--color-inkt); }
  .groot { font-family: var(--font-kop); font-size: 26px; font-weight: 800; letter-spacing: 2px; fill: var(--color-inkt); }
  .logo-licht .lijn { stroke: var(--color-roze); }
  .logo-licht .klein, .logo-licht .groot { fill: var(--color-licht); }
</style>
