---
// Wordmark naar hun eigen logo: klein "De", daarnaast "Katten" boven "praktijk" in hun turquoise, en als beeldmerk
// het kroontje met drie bolletjes dat hun getekende kat draagt ("...waar de kat koning is").
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const hoofd = licht ? '#86d5cd' : '#0e6a6f';
const bol = licht ? '#d8b265' : '#0e6a6f';
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <span class="sr-only">De Kattenpraktijk</span>
  <svg viewBox="0 0 34 31" class="h-8 w-9 flex-none" aria-hidden="true">
    <path d="M4 25 5.8 11.5l6 6.2L17 8.6l5.2 9.1 6-6.2L30 25Z" fill={hoofd} />
    <circle cx="5.6" cy="8.4" r="2.7" fill={bol} />
    <circle cx="17" cy="4.4" r="2.9" fill={bol} />
    <circle cx="28.4" cy="8.4" r="2.7" fill={bol} />
    <rect x="4" y="26.4" width="26" height="2.8" rx="1.4" fill={licht ? '#d8b265' : '#aa977f'} />
  </svg>
  <span aria-hidden="true" class="flex items-end gap-1 font-body">
    <span class={`mb-[2px] text-[0.95rem] font-medium ${licht ? 'text-white/80' : 'text-ink-soft'}`}>De</span>
    <span class="flex flex-col">
      <span class="text-[1.2rem] font-semibold tracking-[-0.01em]" style={`color:${hoofd}`}>Katten</span>
      <span class="-mt-[4px] text-[1.2rem] font-semibold tracking-[-0.01em]" style={`color:${hoofd}`}>praktijk</span>
    </span>
  </span>
</span>
