---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, assortiment, overig, reviews, waHoi, waMet } from '../data/site';

import kube from '../assets/kube.jpg';
import showroomRika from '../assets/showroom-rika.jpg';
import pelletRij from '../assets/pellet-rij.jpg';
import mczGhea from '../assets/mcz-ghea.jpg';
import scotty from '../assets/austroflamm-scotty.jpg';

// Keuzehulp: alleen soorten die ze zelf verkopen (menu, Over ons, showroompagina, nieuws over de Rika-combikachel).
const keuzes = {
  soort: ['pelletkachel', 'houtkachel', 'speksteenkachel', 'combikachel voor pellets en hout', 'inbouwhaard', 'gashaard'],
  ruimte: ['de woonkamer', 'een open woonkeuken', 'het hele huis, aangesloten op de cv'],
  kanaal: ['al een rookkanaal', 'nog geen rookkanaal', 'geen idee of er een rookkanaal is'],
};
const eersteBericht = waMet(`Hallo Paul en Frank, ik zoek een ${keuzes.soort[0]} voor ${keuzes.ruimte[0]} en ik heb ${keuzes.kanaal[0]}. Willen jullie bij mij thuis komen kijken voor advies?`);

const titel = 'De Laat Kachels & Haarden | Pellet- en houtkachels in Hooge Mierde';
const omschrijving = 'Pelletkachels, houtkachels, speksteenkachels, inbouwhaarden en gastoestellen. Showroom aan de Kailakkers 2c in Hooge Mierde, vrijdag 10-17 en elke eerste zaterdag van de maand 10-13. Verkoop en plaatsing door Paul en Frank de Laat.';
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO: schermvullend, hun Norsk Kleber Kube met vuur -->
    <section class="relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-roet text-wit md:min-h-[100svh]">
      <Kop />
      <Image src={kube} alt="Speksteenkachel Norsk Kleber Kube met brandend houtvuur in een lichte woonkamer met eikenhouten vloer" quality={74} widths={[640, 960, 1280]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[80%_50%] md:object-[70%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#141311b3_0%,#14131126_30%,#141311b3_62%,#141311f2_100%)] md:bg-[linear-gradient(90deg,#141311f0_0%,#141311c7_38%,#14131133_68%,#14131100_100%),linear-gradient(0deg,#141311cc_0%,#14131100_30%)]"></div>
      <div class="wrap mt-auto pb-16 pt-28 md:my-auto md:pb-16">
        <p class="label text-vlam">Kachels &amp; haarden · Hooge Mierde</p>
        <h1 class="mt-5 max-w-[11ch] text-hero">Vuur is onze passie.</h1>
        <p class="mt-5 max-w-xl text-base text-wit/90 sm:text-lg md:text-xl">Pellet- en houtkachels, inbouwhaarden en gastoestellen. Paul en Frank de Laat adviseren, verkopen en plaatsen zelf.</p>
        <div class="mt-7 flex flex-wrap gap-3 md:mt-9">
          <a href={waHoi} class="knop knop-vlam"><Icoon naam="wa" />Advies via WhatsApp</a>
          <a href="#assortiment" class="knop knop-wit max-sm:hidden">Bekijk het assortiment</a>
        </div>
      </div>
      <div class="wrap flex flex-wrap items-end justify-between gap-x-8 gap-y-2 pb-7 text-sm text-wit/80 max-md:hidden">
        <p data-status-wrap class="flex items-center gap-2.5"><span class="h-2 w-2 rounded-full bg-vlam" aria-hidden="true"></span><span data-status>Showroom: vrijdag 10.00 tot 17.00 uur, eerste zaterdag van de maand 10.00 tot 13.00 uur</span></p>
        <p>Norsk Kleber Kube, speksteen</p>
      </div>
    </section>

    <!-- 2. DE BROERS: zelf verkocht, zelf geplaatst -->
    <section id="broers" class="py-20 md:py-32">
      <div class="wrap grid grid-cols-1 gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <h2 class="rijs text-4xl lg:col-span-7">Zelf verkocht.<br /><span class="text-vlam-diep">Zelf geplaatst.</span></h2>
        <div class="rijs space-y-5 text-grijs lg:col-span-5 lg:pt-3" style="--d:.1s">
          <p class="text-lg text-inkt">Persoonlijk contact staat bij ons hoog in het vaandel; de verkoop gebeurt door onszelf, evenals de plaatsing van de kachel.</p>
          <p>Met kennis en vakmanschap adviseren wij onze klanten, van de verschillende mogelijkheden en merken, van aankoop tot installatie. U hoeft nergens voor te zorgen, wij regelen alles voor u!</p>
          <p class="font-semibold text-inkt">Paul en Frank de Laat</p>
        </div>
      </div>
      <figure class="rijs wrap mt-14 md:mt-20">
        <Image src={showroomRika} alt="Showroom met een rij zwarte Rika-pelletkachels, gele fauteuils rond een tafel en houtkachels met rookkanaal tegen de achterwand" quality={72} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1280px) 1200px, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_75%] md:aspect-[21/9]" />
        <figcaption class="mt-3 text-xs text-grijs">De Rika-hoek in de showroom, 2024</figcaption>
      </figure>
      <div class="wrap mt-14 grid grid-cols-1 gap-y-10 md:mt-20 lg:grid-cols-12 lg:gap-x-12">
        <blockquote class="rijs lg:col-span-7">
          <p class="font-kop text-2xl uppercase leading-[1.08] md:text-[2.15rem]">“Dit zijn mensen die weten waarover ze spreken en denken met je mee.”</p>
          <footer class="mt-4 text-sm text-grijs">{reviews.jimmy.naam}, Google review</footer>
        </blockquote>
        <div class="rijs border-l-2 border-vlam pl-6 lg:col-span-4 lg:col-start-9" style="--d:.1s">
          <p class="font-semibold">Op uw verzoek komen wij bij u thuis om de situatie ter plaatse te komen bekijken en u geheel vrijblijvend te adviseren.</p>
          <a href="#keuzehulp" class="link link-diep mt-4 inline-block text-sm font-bold">Vraag een huisbezoek aan</a>
        </div>
      </div>
    </section>

    <!-- 3. ASSORTIMENT: catalogusregels die naar hun eigen productpagina's gaan -->
    <section id="assortiment" class="bg-kalk-2 py-20 md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 class="rijs text-4xl lg:text-[3rem]">Voor elke porte&shy;monnee.</h2>
          <p class="rijs mt-6 max-w-md text-grijs" style="--d:.1s">De Laat Kachels &amp; Haarden staat voor kwaliteit, service en betrouwbaarheid. Wij hebben een ruime keuze van de beste merken voor elke portemonnee.</p>
          <div class="rijs mt-10 grid grid-cols-2 gap-3" style="--d:.15s">
            <figure>
              <Image src={mczGhea} alt="Grijze MCZ-pelletkachel met brandend vuur naast een rek met potten en een koperen pot met pellets" quality={74} widths={[320, 480, 640]} sizes="(min-width: 1024px) 18vw, 48vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
              <figcaption class="mt-2 text-xs text-grijs">MCZ, pelletkachel</figcaption>
            </figure>
            <figure class="mt-10">
              <Image src={scotty} alt="Witte Austroflamm-pelletkachel met vuur in een lichte kamer met paneelwanden" quality={74} widths={[320, 480, 640]} sizes="(min-width: 1024px) 18vw, 48vw" class="aspect-[3/4] w-full rounded-sm object-cover object-[45%_50%]" />
              <figcaption class="mt-2 text-xs text-grijs">Austroflamm, pelletkachel</figcaption>
            </figure>
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-2">
          {assortiment.map((g, i) => (
            <div class={`rijs ${i ? 'mt-12' : ''}`}>
              <a href={g.href} class="group flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b-2 border-inkt pb-3 no-underline">
                <h3 class="text-3xl transition-colors group-hover:text-vlam-diep">{g.titel}</h3>
                <span class="whitespace-nowrap text-sm font-bold text-vlam-diep">alle modellen</span>
              </a>
              <ul>
                {g.merken.map(([m, href]) => (
                  <li><a href={href} class="regel text-lg font-semibold"><span>{m}</span><Icoon naam="pijl" class="h-4 w-4 flex-none text-vlam-diep" /></a></li>
                ))}
              </ul>
            </div>
          ))}
          <div class="rijs mt-12">
            <p class="font-semibold">Verder in de winkel</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {overig.map(([t, href]) => <li><a href={href} class="inline-flex min-h-11 items-center rounded-sm border border-lijn-licht bg-kalk px-4 text-sm font-semibold no-underline transition-colors hover:border-inkt">{t}</a></li>)}
            </ul>
            <p class="mt-6 text-sm text-grijs">Prijzen en details per model staan in de productcatalogus op <a href={site.shop} class="link link-diep font-semibold text-inkt">delaatkachels.nl</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. KEUZEHULP: één zin, tik de oranje woorden om te wisselen, eindigt in WhatsApp -->
    <section id="keuzehulp" class="bg-roet py-20 text-wit md:py-28" data-hulp>
      <div class="wrap">
        <p class="rijs text-lg text-as"><span class="font-semibold text-wit">Welke kachel past bij u?</span> Tik op de oranje woorden tot de zin klopt.</p>
        <p class="rijs mt-10 font-kop text-[1.7rem] uppercase leading-[1.15] [text-wrap:wrap] sm:text-3xl md:text-[3.4rem]" style="--d:.1s" aria-live="polite">
          Ik zoek een <span role="button" tabindex="0" class="tik" data-tik="soort">{keuzes.soort[0]}<span class="tik-pijl" aria-hidden="true"></span><span class="sr-only"> (tik om te wisselen)</span></span>
          voor <span role="button" tabindex="0" class="tik" data-tik="ruimte">{keuzes.ruimte[0]}<span class="tik-pijl" aria-hidden="true"></span><span class="sr-only"> (tik om te wisselen)</span></span>
          en ik heb <span role="button" tabindex="0" class="tik" data-tik="kanaal">{keuzes.kanaal[0]}<span class="tik-pijl" aria-hidden="true"></span><span class="sr-only"> (tik om te wisselen)</span></span>.
        </p>
        <div class="rijs mt-12 grid grid-cols-1 gap-8 border-t border-lijn pt-8 lg:grid-cols-12" style="--d:.15s">
          <fieldset class="lg:col-span-5">
            <legend class="text-sm font-semibold text-as">Hoe wilt u verder?</legend>
            <div class="mt-3 flex flex-wrap gap-2" role="radiogroup">
              <label class="flex min-h-11 cursor-pointer items-center gap-2.5 rounded-sm border border-lijn-2 px-4 text-sm font-semibold has-[:checked]:border-vlam has-[:checked]:bg-roet-3"><input type="radio" name="hoe" value="thuis" checked class="accent-[#e2702b]" />Kom bij mij thuis kijken</label>
              <label class="flex min-h-11 cursor-pointer items-center gap-2.5 rounded-sm border border-lijn-2 px-4 text-sm font-semibold has-[:checked]:border-vlam has-[:checked]:bg-roet-3"><input type="radio" name="hoe" value="showroom" class="accent-[#e2702b]" />Ik kom naar de showroom</label>
            </div>
          </fieldset>
          <div class="lg:col-span-7">
            <p class="text-sm font-semibold text-as">Uw bericht aan Paul en Frank</p>
            <p class="mt-3 rounded-sm bg-roet-2 p-5 text-wit/90" data-bericht>Hallo Paul en Frank, ik zoek een pelletkachel voor de woonkamer en ik heb al een rookkanaal. Willen jullie bij mij thuis komen kijken voor advies?</p>
            <a href={eersteBericht} class="knop knop-vlam mt-5" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. ONDERHOUD, PELLETS EN STOOKHOUT -->
    <section id="onderhoud" class="py-20 md:py-28">
      <div class="wrap grid grid-cols-1 items-center gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <Image src={pelletRij} alt="Drie zwarte Rika-pelletkachels op een eikenhouten vloer, met informatiebordjes ernaast" quality={72} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-xs text-grijs">Rika-pelletkachels in de showroom, 2024</figcaption>
        </figure>
        <div class="lg:col-span-6">
          <h2 class="rijs text-4xl">Plan nu uw onderhoud.</h2>
          <p class="rijs mt-6 text-lg" style="--d:.1s">Plan het onderhoud van uw pelletkachel zodat u er van de winter weer warmpjes bijzit.</p>
          <a href={site.onderhoud} class="rijs knop knop-inkt mt-8" style="--d:.15s"><Icoon naam="klok" />Online afspraak maken</a>
          <blockquote class="rijs mt-12 border-l-2 border-vlam pl-6" style="--d:.2s">
            <p class="text-grijs">“{reviews.tom.tekst}”</p>
            <footer class="mt-3 text-sm font-semibold">{reviews.tom.naam}, Google review</footer>
          </blockquote>
          <div class="rijs mt-10 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-lijn-licht pt-6" style="--d:.25s">
            <p class="font-semibold">Wij blijven houtpellets verkopen.</p>
            <a href={overig[1][1]} class="link link-diep text-sm font-bold">Houtpellets</a>
            <a href={overig[2][1]} class="link link-diep text-sm font-bold">Stookhout</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. REVIEWS -->
    <section class="bg-kalk-2 py-20 md:py-28">
      <div class="wrap">
        <div class="rijs flex flex-wrap items-end justify-between gap-6">
          <h2 class="text-4xl">Heel proper afgewerkt.</h2>
          <a href={site.reviews} class="inline-flex items-center gap-2.5 text-sm font-semibold no-underline hover:text-vlam-diep"><Icoon naam="g" class="h-5 w-5" />{site.google.aantal} reviews op Google</a>
        </div>
        <div class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-3">
          {[reviews.tinne, reviews.l, reviews.toon].map((r, i) => (
            <blockquote class="rijs border-t-2 border-inkt pt-6" style={`--d:${i * .08}s`}>
              <p class="flex gap-0.5 text-vlam-diep" role="img" aria-label="5 van 5 sterren">{[0, 1, 2, 3, 4].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</p>
              <p class="mt-4 text-lg">“{r.tekst}”</p>
              <footer class="mt-5 text-sm text-grijs"><span class="font-semibold text-inkt">{r.naam}</span> · {r.wanneer}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. SHOWROOM: adres, het vrijdag-en-eerste-zaterdag-ritme als kalender -->
    <section id="showroom" class="bg-roet py-20 text-wit md:py-28">
      <div class="wrap grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <p class="rijs font-semibold text-vlam">Sinds 1 maart 2026 op een nieuw adres</p>
          <h2 class="rijs mt-5 text-4xl" style="--d:.05s">Kailakkers 2c,<br />Hooge Mierde</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-wit/85" style="--d:.1s">Nieuwsgierig? Kom eens een kijkje nemen in onze showroom. Laat u eens vrijblijvend informeren. De koffie staat voor u klaar.</p>
          <p class="rijs mt-8 flex items-start gap-3 font-semibold" data-status-wrap style="--d:.15s"><span class="mt-2 h-2.5 w-2.5 flex-none rounded-full bg-vlam" aria-hidden="true"></span><span data-status>Vrijdag 10.00 tot 17.00 uur, eerste zaterdag van de maand 10.00 tot 13.00 uur</span></p>
          <div class="rijs mt-9 flex flex-wrap gap-3" style="--d:.2s">
            <a href={site.maps} class="knop knop-vlam"><Icoon naam="pin" />Plan uw route</a>
            <a href={site.telHref} class="knop knop-wit"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
          </div>
          <p class="rijs mt-6 text-sm text-as" style="--d:.25s">Of bel <a href={site.tel2Href} class="link num text-wit">{site.tel2}</a>, mail <a href={`mailto:${site.mail}`} class="link text-wit">{site.mail}</a>, of kijk wat er in de <a href={site.uitverkoop} class="link text-wit">magazijnuitverkoop</a> staat.</p>
        </div>
        <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.1s">
          <div class="rounded-md bg-roet-2 p-6">
            <p class="font-kop text-xl uppercase" data-kal-titel>Deze maand</p>
            <div class="kal mt-5" data-kal role="list" aria-label="Openingsdagen van de showroom deze maand"></div>
            <dl class="mt-6 space-y-3 border-t border-lijn pt-5 text-sm">
              <div class="flex items-center gap-3"><span class="h-4 w-4 flex-none rounded-sm bg-roet-3" aria-hidden="true"></span><dt class="font-semibold">Elke vrijdag</dt><dd class="ml-auto num text-as">10.00 tot 17.00</dd></div>
              <div class="flex items-center gap-3"><span class="h-4 w-4 flex-none rounded-sm bg-vlam" aria-hidden="true"></span><dt class="font-semibold">Eerste zaterdag</dt><dd class="ml-auto num text-as">10.00 tot 13.00</dd></div>
            </dl>
          </div>
          <p class="mt-4 text-sm text-as">Liever eerst iets vragen? Stuur een <a href={waHoi} class="link text-wit">WhatsApp</a>.</p>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script define:vars={{ keuzes, wa: site.wa }}>
    const hulp = document.querySelector('[data-hulp]');
    if (hulp) {
      const stand = { soort: 0, ruimte: 0, kanaal: 0 };
      const bericht = hulp.querySelector('[data-bericht]');
      const stuur = hulp.querySelector('[data-stuur]');
      const maak = () => {
        const hoe = hulp.querySelector('input[name="hoe"]:checked')?.value;
        const slot = hoe === 'showroom' ? 'Ik kom graag naar de showroom in Hooge Mierde om te kijken.' : 'Willen jullie bij mij thuis komen kijken voor advies?';
        const t = `Hallo Paul en Frank, ik zoek een ${keuzes.soort[stand.soort]} voor ${keuzes.ruimte[stand.ruimte]} en ik heb ${keuzes.kanaal[stand.kanaal]}. ${slot}`;
        bericht.textContent = t;
        stuur.href = `${wa}?text=${encodeURIComponent(t)}`;
      };
      hulp.querySelectorAll('[data-tik]').forEach((b) => {
        const wissel = () => {
          const s = b.dataset.tik; stand[s] = (stand[s] + 1) % keuzes[s].length;
          b.firstChild.textContent = keuzes[s][stand[s]];
          maak();
        };
        b.addEventListener('click', wissel);
        b.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); wissel(); } });
      });
      hulp.querySelectorAll('input[name="hoe"]').forEach((r) => r.addEventListener('change', maak));
    }
  </script>
</Base>
