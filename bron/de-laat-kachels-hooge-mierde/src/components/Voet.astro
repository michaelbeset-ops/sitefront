---
import { site, url, waHoi, overig } from '../data/site';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const jaar = new Date().getFullYear();
---
<footer class="bg-roet text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Pellet- en houtkachels, inbouwhaarden en gastoestellen. Verkocht en geplaatst door Paul en Frank de Laat.</p>
    </div>
    <div class="md:col-span-3">
      <p class="label text-wit">Assortiment</p>
      <ul class="mt-4 space-y-1.5">
        {overig.map(([t, href]) => <li><a href={href} class="link">{t}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="label text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={site.tel2Href} class="link num">{site.tel2}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="label text-wit">Showroom</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3">Vrijdag 10.00 tot 17.00 uur<br />Eerste zaterdag van de maand 10.00 tot 13.00 uur</p>
      <p class="mt-3"><a href={site.facebook} class="link">Facebook</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, handelsnaam van Trendstore online V.O.F. · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-vlam">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en foto’s van delaatkachels.nl en jullie Facebookpagina; productfoto’s zoals op jullie eigen site. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
