---
// Woordmerk naar hun logo: DE LAAT groot, KACHELS & HAARDEN eronder in oranje, met de vlam nagetekend.
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = true } = Astro.props;
---
<a href={url('')} class={`group inline-flex items-center gap-2.5 no-underline ${licht ? 'text-wit' : 'text-inkt'}`}>
  <svg viewBox="0 0 40 48" class="h-11 w-9 flex-none" aria-hidden="true">
    <path fill="#e2702b" d="M21.5 1.5c1.6 6.4-1.3 9.8-4.4 13.3-3.2 3.6-6.6 7.4-6.1 14 .2 2.5 1 4.6 2.2 6.3-4.4-1.6-7.7-5.9-7.7-11.4 0-5.3 2.9-8.3 5.6-11.2-.2 3.2.7 5.5 2.5 6.6-.6-6.6 2.6-12.1 7.9-17.6Z"/>
    <path fill="#e2702b" d="M25.6 12.4c3.6 4.3 5.6 8.6 4.6 13.4-.6 2.9-2.3 5.2-4.4 6.6.6-2.6.1-5.1-1.6-7.1-.4 2.7-1.7 4.4-3.7 5.3.9-5.8 4.6-10.4 5.1-18.2Z"/>
    <path fill="currentColor" opacity=".9" d="M6.5 37.5c3.6 4.7 9 7.4 15 7.4 6.4 0 11.9-3.1 15.3-8.2l-3.4-1.6c-2.6 3.5-6.8 5.8-11.7 5.8-4.5 0-8.6-2-11.3-5.3l-3.9 1.9Z"/>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-kop text-[1.45rem] tracking-[.01em]">DE LAAT</span>
    <span class="mt-1 text-[.625rem] font-bold uppercase tracking-[.2em] text-vlam">Kachels &amp; Haarden</span>
  </span>
</a>
