---
// Woordmerk: een gekkopootje in het groen van hun logo (de groene gekko), "Repti-Farm" zwaar en hun eigen slogan
// "Alles voor uw huisdier" klein eronder, zoals op hun logo.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const tenen: [number, number][] = [[4.6, 10.4], [7.2, 5.6], [12, 3.6], [16.8, 5.6], [19.4, 10.4]];
---
<span class:list={['merk', cls]}>
  <span class="merk-teken" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor">
      <ellipse cx="12" cy="15.6" rx="4.4" ry="3.9" stroke="none" />
      {tenen.map(([x, y]) => <line x1="12" y1="15" x2={x} y2={y} stroke-width="1.9" stroke-linecap="round" />)}
      {tenen.map(([x, y]) => <circle cx={x} cy={y} r="1.75" stroke="none" />)}
    </svg>
  </span>
  <span class="merk-tekst"><b>Repti-Farm</b><small>Alles voor uw huisdier</small></span>
</span>

<style>
  .merk { display: inline-flex; align-items: center; gap: .7rem; line-height: 1; white-space: nowrap; }
  .merk-teken { display: grid; place-items: center; width: 2.7rem; height: 2.7rem; border-radius: 12px; background: var(--color-groen); color: #fff; transform: rotate(-8deg); }
  .merk-teken svg { width: 1.6rem; height: 1.6rem; }
  .merk-tekst b { display: block; font-family: var(--font-kop); font-weight: 850; font-size: 1.45rem; letter-spacing: -0.035em; }
  .merk-tekst small { display: block; margin-top: .25rem; font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; color: var(--color-groen); }
  :global(.donker) .merk-tekst small { color: var(--color-lamp); }
</style>
