---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="donker bg-kelder text-mist">
  <div class="wrap grid gap-x-10 gap-y-10 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-kalk md:col-span-5">
      <Merk />
      <p class="mt-5 max-w-xs text-mist">Dierenspeciaalzaak in Ridderkerk. Alles voor uw huisdier, en een kelder vol terraria.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-medium text-kalk">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
    </div>
    <div class="md:col-span-4">
      <p class="font-medium text-kalk">Adres</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.facebook} class="link">Volg ons op Facebook</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-donker py-7 text-xs">
    <p>© {jaar} {site.vol} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-loof">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie oude website en Facebook, en van bezoekers op jullie Google-profiel (alleen foto's die in de winkel zijn gemaakt), ter illustratie. Reviews letterlijk van Google (stand 6 oktober 2026).</p>}
</footer>
