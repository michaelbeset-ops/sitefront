            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-full bg-groen-zacht text-groen"><Icoon naam="mail" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Mail</b><span class="break-all text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
