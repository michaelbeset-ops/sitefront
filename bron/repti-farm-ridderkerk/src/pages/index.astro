<script>
  // Voedseldieren-check: keuzes worden een kort WhatsApp-bericht; de dagen volgen de echte openingstijden.
  const form = document.querySelector<HTMLFormElement>('[data-voer]');
  if (form) {
    const wa = form.querySelector<HTMLAnchorElement>('[data-voer-wa]')!;
    const uit = form.querySelector<HTMLElement>('[data-voer-tekst]')!;
    const sel = form.querySelector<HTMLSelectElement>('[data-dagen]')!;
    const basis = wa.href.split('?')[0];
    const lijst = (a: string[]) => (a.length < 2 ? a.join('') : a.slice(0, -1).join(', ') + ' en ' + a[a.length - 1]);
    const veld = (n: string) => String((form.elements.namedItem(n) as HTMLInputElement | null)?.value || '').trim();

    // Volgende vijf openingsdagen (di t/m za), met vandaag alleen als de winkel nog open gaat of is.
    const rooster: Record<number, [number, number]> = { 2: [600, 1080], 3: [600, 1080], 4: [600, 1080], 5: [600, 1200], 6: [600, 1020] };
    const namen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
    const nu = new Date();
    const deel = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', ...o }).format(nu);
    const dag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(deel({ weekday: 'short' }));
    const min = Number(deel({ hour: '2-digit', hourCycle: 'h23' })) * 60 + Number(deel({ minute: '2-digit' }));
    const opties: [string, string][] = [];
    for (let i = 0; i < 8 && opties.length < 4; i++) {
      const d = (dag + i) % 7; const r = rooster[d];
      if (!r || (i === 0 && min >= r[1] - 30)) continue;
      const uur = `${r[1] / 60}.00`;
      const label = i === 0 ? `Vandaag (open tot ${uur})` : i === 1 ? `Morgen, ${namen[d]}` : `${namen[d][0].toUpperCase()}${namen[d].slice(1)}${d === 5 ? ' (tot 20.00)' : ''}`;
      opties.push([i === 0 ? 'vandaag' : i === 1 ? 'morgen' : namen[d], label]);
    }
    sel.replaceChildren(new Option('Weet ik nog niet', ''), ...opties.map(([w, l]) => new Option(l, w)));

    const maak = () => {
      const keuze = [...form.querySelectorAll<HTMLInputElement>('input[name=voer]:checked')].map((i) => i.value);
      const wat = keuze.length ? lijst(keuze) : 'voedseldieren';
      const voor = veld('dier') ? ` voor mijn ${veld('dier')}` : '';
      let tekst = `Hallo Repti-Farm, hebben jullie ${wat}${voor} op voorraad?`;
      if (veld('dag')) tekst += ` Dan kom ik ${veld('dag') === 'vandaag' || veld('dag') === 'morgen' ? veld('dag') : `${veld('dag')}`} langs.`;
      uit.textContent = tekst;
      wa.href = `${basis}?text=${encodeURIComponent(tekst)}`;
    };
    form.addEventListener('input', maak);
    form.addEventListener('change', maak);
    form.addEventListener('submit', (e) => e.preventDefault());
    maak();
  }
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: .98; letter-spacing: -0.045em; }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: 999px; background: var(--color-zand); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #ddd5c4; }
  .keuze input:checked + span { background: var(--color-groen); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-groen); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: 10px; border: 1.5px solid #121c1633; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #121c1666; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-groen); }
  .veld::placeholder { color: #737a74; }
</style>
