---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Gekko from '../components/Gekko.astro';
import { site, tijden, reviews, voedseldieren, waMet, waHoi } from '../data/site';

import hero from '../assets/hero.jpg';
import winkel from '../assets/winkel.jpg';
import schildpadden from '../assets/schildpadden.jpg';
import terrarium from '../assets/terrarium.jpg';
import jongeAgamen from '../assets/jonge-agamen.jpg';
import agaam from '../assets/agaam.jpg';
import voer from '../assets/voedseldieren.jpg';
import pand from '../assets/pand.jpg';
import trap from '../assets/trap.jpg';

// Nieuw in de winkel volgens hun eigen Facebookberichten (datum = bericht).
const nieuw = [
  ['Roodoogmakikikkers', 'nakweek', 'juli 2025'],
  ['Grote miljoenpoten', 'diverse soorten', 'januari 2025'],
  ['Dendrobates tinctorius', 'nakweek', 'december 2024'],
  ['Haakneusslangen', 'nakweek', 'februari 2024'],
  ['Springspinnen', '', 'augustus 2023'],
];

// "Wat zoek je?": één keuze, één regel, dan WhatsApp. Teksten in hun eigen toon (je/jullie, zoals op Facebook).
const keuzes = [
  { id: 'dier', label: 'Een dier', vraag: 'Welk dier?', voorbeeld: 'bijv. een baardagaam', zin: 'Hoi Hennie, ik zoek een dier: {x}. Hebben jullie dat op dit moment?', leeg: 'Hoi Hennie, ik zoek een dier. Wat hebben jullie op dit moment?' },
  { id: 'terrarium', label: 'Een terrarium', vraag: 'Voor welk dier?', voorbeeld: 'bijv. een koningspython', zin: 'Hoi Hennie, ik zoek een terrarium voor {x}. Wat raden jullie aan?', leeg: 'Hoi Hennie, ik zoek een terrarium. Wat raden jullie aan?' },
  { id: 'voer', label: 'Voedseldieren', vraag: 'Welke?', voorbeeld: 'bijv. krekels', zin: 'Hoi Hennie, hebben jullie vandaag {x} op voorraad?', leeg: 'Hoi Hennie, welke voedseldieren hebben jullie vandaag op voorraad?' },
  { id: 'advies', label: 'Advies', vraag: 'Waarover?', voorbeeld: 'bijv. warmte in het terrarium', zin: 'Hoi Hennie, ik heb een vraag over {x}.', leeg: 'Hoi Hennie, ik heb een vraag.' },
];

const titel = 'Repti-Farm | Dierenspeciaalzaak in Ridderkerk';
const omschrijving = 'Repti-Farm in Ridderkerk: gespecialiseerd in reptielen, terraria en voedseldieren, en alles voor hond, kat, knaagdier, vogel en vijver. Prinses Margrietstraat 36, 06 19 64 48 64.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. HERO: licht, grote kop, één terrariumruit -->
    <section class="relative pb-16 pt-6 md:pb-24 lg:flex lg:min-h-[calc(100svh-8.5rem)] lg:items-center lg:py-10">
      <div class="wrap grid items-center gap-y-10 lg:grid-cols-12 lg:gap-x-10">
        <div class="relative z-10 min-w-0 lg:col-span-6">
          <p class="text-grijs">Dierenspeciaalzaak in Ridderkerk, sinds {site.sinds}</p>
          <h1 class="mt-5 text-hero text-gevel">Gespecialiseerd in <span class="text-inkt">reptielen.</span></h1>
          <p class="mt-7 max-w-md text-lg text-grijs">Maar ook alles voor uw hond, kat, knaagdier, vogel en vijver.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href="#zoek" class="knop">Wat zoek je?<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="link num font-medium">{site.tel}</a>
          </div>
        </div>
        <figure class="min-w-0 lg:col-span-6">
          <div class="ruit aspect-[4/3] lg:aspect-[6/5]">
            <Image src={hero} alt="Een grote slang opgerold op schors in een glazen terrarium, onder de warmtelamp" quality={76} widths={[640, 900, 1200]} sizes="(min-width: 1024px) 46vw, 100vw" loading="eager" fetchpriority="high" class="object-[40%_50%]" />
          </div>
          <figcaption class="mt-3 text-xs text-grijs">Onder de warmtelamp, in een van de terraria</figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. DE WINKEL -->
    <section id="winkel" class="pb-24 md:pb-32">
      <div class="wrap grid items-center gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs lg:col-span-7">
          <Image src={winkel} alt="De winkel van binnen: schappen vol voer en benodigdheden, en de toonbank met de kassa" quality={74} widths={[640, 960, 1300]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[16/10] w-full rounded-sm object-cover object-[30%_50%]" />
        </figure>
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl">Boven: alles voor uw huisdier</h2>
          <p class="rijs mt-7 font-kop text-[1.9rem] font-bold leading-[1.08] text-gevel">Honden- en kattenvoer, kippen- en vogelvoer, hooi en stro, speeltjes, boeken en een visafdeling.</p>
          <p class="rijs mt-6 text-grijs">Op de visafdeling vind je van alles om je aquarium in te richten, van bodembedekking en pompen tot aquariumplanten.</p>
        </div>
      </div>
    </section>

    <!-- Trapje naar beneden -->
    <svg class="trap -mb-px" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 10V0h20v2h20v2h20v2h20v2h20v2z" /></svg>

    <!-- 3. DE KELDER -->
    <section id="kelder" class="donker bg-kelder pb-24 pt-14 text-kalk md:pb-32 md:pt-20">
      <div class="wrap">
        <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-12">
          <h2 class="rijs text-[clamp(3.2rem,5vw+1.4rem,7rem)] lg:col-span-7">Een trapje naar beneden</h2>
          <blockquote class="rijs self-end lg:col-span-5 lg:pb-3">
            <p class="font-kop text-[1.75rem] font-bold leading-[1.1]">“Een klein trapje naar beneden brengt je naar een ruimte met veel reptielen terrariums.”</p>
            <footer class="mt-3 text-sm text-mist">Silviano M. · Google</footer>
          </blockquote>
        </div>

        <div class="mt-16 grid gap-6 md:mt-20 md:grid-cols-12 md:gap-x-8">
          <figure class="rijs md:col-span-7">
            <div class="ruit aspect-[4/3]"><Image src={schildpadden} alt="Jonge landschildpadden in een ingericht terrarium met stenen, planten en een waterbak" quality={72} widths={[640, 960, 1200]} sizes="(min-width: 768px) 56vw, 100vw" class="object-[40%_40%]" /></div>
            <figcaption class="mt-3 text-xs text-mist">Jonge landschildpadden</figcaption>
          </figure>
          <figure class="rijs md:col-span-4 md:col-start-9 md:mt-24" style="--d:.08s">
            <div class="ruit aspect-[3/4]"><Image src={jongeAgamen} alt="Een groep jonge agamen op een stuk schors in een terrarium met een cactus" quality={72} widths={[480, 760]} sizes="(min-width: 768px) 30vw, 100vw" class="object-[50%_35%]" /></div>
            <figcaption class="mt-3 text-xs text-mist">Jonge agamen</figcaption>
          </figure>
          <figure class="rijs md:col-span-5 md:col-start-2 md:-mt-6">
            <div class="ruit aspect-[4/3]"><Image src={terrarium} alt="Een python in een ingericht terrarium met een boomstam, planten en een schuilplaats" quality={72} widths={[640, 900]} sizes="(min-width: 768px) 40vw, 100vw" /></div>
          </figure>
          <figure class="rijs max-md:hidden md:col-span-5 md:col-start-8 md:mt-10" style="--d:.08s">
            <div class="ruit aspect-[4/3]"><Image src={agaam} alt="Een woestijnterrarium met zand, planten en een hagedis tegen de achterwand, onder een felle lamp" quality={72} widths={[640, 900]} sizes="40vw" /></div>
          </figure>
        </div>

        <div class="mt-20 grid gap-y-14 border-t border-lijn-donker pt-14 md:mt-24 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-5">
            <p class="font-kop text-[2.1rem] font-bold leading-[1.05]">Aan de andere zijde van de kelder, nog meer terraria, met andere bewoners.</p>
            <p class="mt-6 max-w-md text-mist">Alles om een terrarium goed in te richten: terraria, ook de De Luxe-lijn, warmtestenen, warmtematten, warmtekabels, keramische warmtestralers en drink- en voederschalen. En we richten terraria ook compleet voor je in.</p>
            <figure class="mt-10 flex items-end gap-5">
              <Image src={trap} alt="De houten trap in de winkel, met bamboe en terraria ernaast" quality={80} widths={[300, 450]} sizes="200px" class="w-36 shrink-0 rounded-sm opacity-90 md:w-48" />
              <figcaption class="min-w-0 max-w-[12rem] flex-1 text-xs text-mist">De trap, op een foto van onze oude website</figcaption>
            </figure>
          </div>
          <div class="lg:col-span-6 lg:col-start-7">
            <h3 class="rijs text-2xl font-extrabold text-loof">Eerder nieuw in de winkel</h3>
            <ul class="mt-6">
              {nieuw.map(([dier, extra, wanneer], i) => (
                <li class="rijs flex items-baseline justify-between gap-6 border-b border-lijn-donker py-4" style={`--d:${i * 0.05}s`}>
                  <span><span class="font-kop text-[1.6rem] font-bold leading-none">{dier}</span>{extra && <span class="ml-3 whitespace-nowrap text-sm text-mist max-sm:hidden">{extra}</span>}</span>
                  <span class="shrink-0 text-xs text-mist sm:text-sm">{wanneer}</span>
                </li>
              ))}
            </ul>
            <p class="rijs mt-6 text-sm text-mist">Wat er nu in de kelder zit, wisselt. <a href={waMet('Hoi Hennie, welke dieren hebben jullie op dit moment in de winkel?')} class="link text-kalk">Vraag het even via WhatsApp</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. VOEDSELDIEREN: de lijst is het beeld -->
    <section id="voedseldieren" class="py-24 md:py-32">
      <div class="wrap grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-8">
          <h2 class="rijs text-3xl">Voedseldieren</h2>
          <p class="rijs mt-4 text-grijs">Levend en uit de diepvries.</p>
          <p class="rijs mt-10 font-kop text-[clamp(2.4rem,3.4vw+1rem,4.6rem)] font-extrabold leading-[1] text-gevel">
            {voedseldieren.map((v, i) => <>{v}{i < voedseldieren.length - 1 && <span class="px-[.2em] font-light text-grijs/60" aria-hidden="true">/</span>}{i < voedseldieren.length - 1 && ' '}</>)}
          </p>
          <a href={waMet('Hoi Hennie, hebben jullie vandaag krekels op voorraad?')} class="rijs knop mt-12"><Icoon naam="wa" />Is het er vandaag? App even</a>
        </div>
        <figure class="rijs lg:col-span-4">
          <div class="ruit aspect-[3/4]"><Image src={voer} alt="Kakkerlakken als voedseldier tussen schors, onder een warme lamp" quality={72} widths={[480, 760]} sizes="(min-width: 1024px) 30vw, 100vw" class="object-[50%_60%]" /></div>
        </figure>
      </div>
    </section>

    <!-- 5. WAT ZOEK JE? (de wow): één keuze, één regel, WhatsApp -->
    <section id="zoek" class="donker bg-gevel py-24 text-kalk md:py-32">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <Gekko class="h-14 w-14 text-loof" />
          <h2 class="mt-8 text-[clamp(3.4rem,5vw+1.4rem,7rem)]">Wat zoek je?</h2>
          <p class="mt-6 max-w-sm text-kalk/80">Kies wat je zoekt en stuur Hennie meteen een berichtje. Er wordt pas iets verstuurd als jij in WhatsApp op verzenden drukt.</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7" data-zoek>
          <div class="flex flex-col items-start" role="group" aria-label="Wat zoek je?">
            {keuzes.map((k, i) => (
              <button type="button" class="keus" aria-pressed={i === 0 ? 'true' : 'false'} data-keus={k.id} data-vraag={k.vraag} data-voorbeeld={k.voorbeeld} data-zin={k.zin} data-leeg={k.leeg}>{k.label}</button>
            ))}
          </div>
          <label class="mt-10 block">
            <span class="text-sm text-kalk/80" data-vraag-tekst>{keuzes[0].vraag}</span>
            <input type="text" maxlength="60" autocomplete="off" class="mt-2 block w-full border-0 border-b border-kalk/40 bg-transparent px-0 py-3 text-xl text-kalk placeholder:text-kalk/45 focus:border-loof focus:outline-none" placeholder={keuzes[0].voorbeeld} data-invoer />
          </label>
          <p class="mt-6 min-h-[3.2em] text-sm text-kalk/80" aria-live="polite"><span class="sr-only">Je bericht: </span><span data-bericht>{keuzes[0].leeg}</span></p>
          <a href={waMet(keuzes[0].leeg)} class="knop mt-4" data-stuur><Icoon naam="wa" />Stuur via WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- 6. HENNIE EN DE KLANTEN -->
    <section id="over" class="py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-12">
          <h2 class="rijs text-[clamp(3.2rem,5vw+1.4rem,7rem)] lg:col-span-6">Sinds 2003 een begrip</h2>
          <div class="rijs self-end lg:col-span-5 lg:col-start-8">
            <p class="text-grijs">Op 22 november 2023 bestond Repti-Farm twintig jaar. Eén ding moet je weten, schreef een vaste klant:</p>
            <blockquote class="mt-4 font-kop text-[1.6rem] font-bold leading-[1.12] text-gevel">“Enige waar je rekening mee moet houden is dat je niet binnen 5 min weg bent, daar is te eigenaar te druk en gezellig voor!”</blockquote>
            <p class="mt-3 text-sm text-grijs">Silviano M. · Google</p>
          </div>
        </div>
        <div class="mt-16 grid gap-x-12 gap-y-12 border-t border-lijn pt-12 md:mt-20 md:grid-cols-3">
          {reviews.map((r, i) => (
            <figure class="rijs" style={`--d:${i * 0.08}s`}>
              <blockquote class="font-kop text-[1.6rem] font-bold leading-[1.12]">“{r.tekst}”</blockquote>
              <figcaption class="mt-4 text-sm text-grijs">{r.naam} · Google</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. LANGSKOMEN -->
    <section id="langskomen" class="bg-kalk-2 py-24 md:py-32">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs lg:col-span-6">
          <Image src={pand} alt="De winkel aan de straat: groen gevelbord met Dierenspeciaalzaak en Alles voor uw huisdier, etalages en planten bij de deur" quality={80} widths={[480, 800]} sizes="(min-width: 1024px) 46vw, 100vw" class="w-full rounded-sm" />
        </figure>
        <div class="lg:col-span-5 lg:col-start-8">
          <h2 class="rijs text-3xl">Langskomen</h2>
          <p class="rijs mt-6 font-kop text-[2rem] font-bold leading-[1.05]">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <table class="rijs mt-8 w-full max-w-sm text-[.9375rem]">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-semibold data-[vandaag]:text-gevel">
                  <th scope="row" class="py-2 text-left font-[inherit]">{t.naam}</th>
                  <td class="num py-2 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="rijs mt-4 text-sm text-grijs"><span class="block font-medium text-inkt" data-status></span>Aangepaste tijden rond feestdagen en vakanties zetten we op <a href={site.facebook} class="link">Facebook</a>.</p>
          <div class="rijs mt-9 flex flex-wrap gap-3">
            <a href={waHoi} class="knop"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.maps} class="knop bg-transparent text-gevel ring-1 ring-gevel/40 hover:bg-gevel hover:text-kalk"><Icoon naam="pin" />Route</a>
          </div>
          <p class="rijs mt-8 flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews</p>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script>
    const doos = document.querySelector<HTMLElement>('[data-zoek]');
    if (doos) {
      const knoppen = [...doos.querySelectorAll<HTMLButtonElement>('[data-keus]')];
      const invoer = doos.querySelector<HTMLInputElement>('[data-invoer]')!;
      const vraag = doos.querySelector<HTMLElement>('[data-vraag-tekst]')!;
      const bericht = doos.querySelector<HTMLElement>('[data-bericht]')!;
      const stuur = doos.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const basis = stuur.href.split('?')[0];
      let actief = knoppen[0];
      const zet = () => {
        const x = invoer.value.trim();
        const tekst = x ? actief.dataset.zin!.replace('{x}', x) : actief.dataset.leeg!;
        bericht.textContent = tekst;
        stuur.href = `${basis}?text=${encodeURIComponent(tekst)}`;
      };
      knoppen.forEach((k) => k.addEventListener('click', () => {
        actief = k;
        knoppen.forEach((b) => b.setAttribute('aria-pressed', String(b === k)));
        vraag.textContent = k.dataset.vraag!;
        invoer.placeholder = k.dataset.voorbeeld!;
        invoer.value = '';
        zet();
      }));
      invoer.addEventListener('input', zet);
    }
  </script>
</Base>
