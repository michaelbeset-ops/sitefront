---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Plek from '../components/Plek.astro';
import { site, wa, telIcoon } from '../data/site';
import taartpunt from '../assets/taartpunt.jpg';
import taart from '../assets/taart.jpg';
import taartjes from '../assets/taartjes.jpg';
import trap from '../assets/trap.jpg';
import hoek from '../assets/hoek.jpg';
import pand from '../assets/pand.jpg';
import servies from '../assets/servies.jpg';

const dagen = [
  { dag: 'Maandag', wd: 1, tijd: 'Gesloten' },
  { dag: 'Dinsdag', wd: 2, tijd: 'Gesloten' },
  { dag: 'Woensdag', wd: 3, tijd: 'Gesloten' },
  { dag: 'Donderdag', wd: 4, tijd: '11.00 - 17.00' },
  { dag: 'Vrijdag', wd: 5, tijd: '11.00 - 17.00' },
  { dag: 'Zaterdag', wd: 6, tijd: '11.00 - 17.00' },
  { dag: 'Zondag', wd: 0, tijd: '11.00 - 17.00' },
];
const noemen = [
  { kop: 'Vers gebakken appeltaart', tekst: 'Met slagroom. Veruit het vaakst genoemd: de specialiteit van het huis.' },
  { kop: 'Goede koffie en thee', tekst: 'Koffie, cappuccino en thee bij de taart.' },
  { kop: 'Een verstopt plekje', tekst: 'Klein en een beetje verstopt, in het centrum van Leiden.' },
  { kop: 'Sfeer uit de 17e eeuw', tekst: 'Een bijzonder mooie plek, schrijven gasten.' },
  { kop: 'Een vriendelijke eigenaar', tekst: 'Komt in de reviews steeds terug.' },
  { kop: 'Een parel', tekst: 'Zo noemen meerdere gasten Madame Marie.' },
];
---
<Base title={`${site.naam} | Appeltaart en koffie in de Kloksteeg, Leiden`} description="Madame Marie, koffiebar in de Kloksteeg 2 in Leiden. Vers gebakken appeltaart met slagroom, koffie en thee. Donderdag t/m zondag 11.00 - 17.00 uur. WhatsApp of bel 06 38 61 95 68.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative overflow-hidden bg-eik text-kalk">
      <div class="wrap grid gap-8 pb-8 pt-9 sm:gap-10 sm:pb-10 sm:pt-12 lg:grid-cols-12 lg:gap-8 lg:pb-16 lg:pt-16">
        <div class="lg:col-span-8">
          <p class="eyebrow text-korst">Kloksteeg 2, Leiden</p>
          <h1 class="mt-5 text-4xl font-semibold">Madame <em class="font-medium text-korst-zacht">Marie</em></h1>
          <p class="mt-6 max-w-xl text-lg text-kalk/85">Vers gebakken appeltaart met slagroom, goede koffie en thee. In een klein, verstopt plekje in het centrum van Leiden.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#plek" class="btn btn-app text-lg"><Fragment set:html={wa} />Is er plek voor ons?</a>
            <a href={site.telHref} class="btn btn-lijn text-kalk"><Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">Bel<span class="max-[419px]:sr-only"> {site.tel}</span></span></a>
          </div>
        </div>
        <div class="grid content-end gap-5 sm:grid-cols-2 lg:col-span-4 lg:grid-cols-1 lg:border-l lg:border-lijn-licht lg:pl-8">
          <dl class="grid grid-cols-2 gap-5 sm:col-span-2 lg:col-span-1">
            <div>
              <dt class="text-sm text-kalk/75">Google</dt>
              <dd class="mt-1 font-display text-3xl font-semibold leading-none lg:text-[2.9rem]">{site.google.score} <span class="mt-1 block font-body text-sm font-normal text-kalk/75 lg:mt-2">({site.google.aantal} reviews)</span></dd>
            </div>
            <div>
              <dt class="text-sm text-kalk/75">Do t/m zo</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-3xl font-semibold leading-none tabular-nums lg:text-[2.9rem]">11 - 17</dd>
            </div>
          </dl>
          <div class="hidden sm:col-span-2 sm:block lg:col-span-1"><Status /></div>
        </div>
      </div>
      <div class="relative">
        <div class="absolute inset-x-0 bottom-0 h-1/3 bg-kalk" aria-hidden="true"></div>
        <div class="wrap relative">
          <figure class="relative overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[4/3] sm:aspect-[16/8]">
              <Foto src={taartpunt} alt="Een punt appeltaart vol grote stukken appel, met slagroom, op een rood-wit bordje naast een kopje" class="object-[center_55%]" hero sizes="(min-width: 1216px) 1152px, 100vw" />
            </div>
            <figcaption class="absolute bottom-4 left-4 rounded-lg bg-eik/85 px-3 py-1.5 text-xs font-semibold text-kalk backdrop-blur-sm">Appeltaart met slagroom, van het huis</figcaption>
          </figure>
          <figure class="absolute -bottom-10 right-8 hidden w-56 rotate-2 overflow-hidden rounded-xl border-[6px] border-kalk bg-kalk shadow-xl lg:block xl:right-16 xl:w-64">
            <div class="aspect-[4/5]"><Foto src={pand} alt="De gevel van Madame Marie in de Kloksteeg: oude bakstenen, sprossenramen en een krijtbord op de keitjes" sizes="256px" /></div>
            <figcaption class="px-2 pb-1 pt-2 text-center font-display text-lg font-semibold italic text-inkt">Kloksteeg 2</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- WAT GASTEN NOEMEN -->
    <section class="licht bg-kalk pb-16 pt-16 lg:pb-24 lg:pt-28" aria-labelledby="noemen">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-delfts">Wat gasten noemen</p>
          <h2 id="noemen" class="mt-3 text-3xl">Uit {site.google.aantal} Google-reviews</h2>
          <div class="mt-8 flex items-end gap-4 border-t border-lijn pt-6">
            <p class="font-display text-[5.5rem] font-semibold italic leading-[0.8] text-delfts tabular-nums">135</p>
            <p class="pb-1 text-inkt-zacht">keer wordt de appeltaart genoemd. De slagroom 35 keer.</p>
          </div>
          <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-perkament px-4 py-2 text-sm font-bold"><span aria-hidden="true" class="text-delfts">&#9733;</span> {site.google.score} op Google, {site.google.aantal} reviews</p>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-xl bg-lijn shadow-sm ring-1 ring-lijn sm:grid-cols-2 lg:col-span-8">
          {noemen.map((n, i) => (
            <li class="bg-white/70 p-6 transition-colors hover:bg-white">
              <span class="font-display text-lg italic text-delfts">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-1 text-2xl">{n.kop}</h3>
              <p class="mt-2 text-inkt-zacht">{n.tekst}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- APPELTAART / POPULAIR -->
    <section id="taart" class="scroll-mt-16 bg-eik-2 text-kalk" aria-labelledby="taartkop">
      <div class="grid lg:grid-cols-2">
        <figure class="relative min-h-[26rem] lg:min-h-[44rem]">
          <div class="absolute inset-0"><Foto src={taart} alt="Een hele appeltaart met een dak van deegslierten, hoog op een tinnen taartplateau" class="object-[center_40%]" sizes="(min-width: 1024px) 50vw, 100vw" /></div>
        </figure>
        <div class="flex items-center">
          <div class="w-full max-w-xl px-5 py-14 sm:px-10 lg:px-14 lg:py-20">
            <p class="eyebrow text-korst">Populair bij gasten</p>
            <h2 id="taartkop" class="mt-3 text-3xl">Hoog, vol appel, met <em class="font-medium text-korst-zacht">slagroom</em></h2>
            <p class="mt-5 text-lg text-kalk/85">De appeltaart is waar gasten voor komen, vers gebakken. Erbij: koffie, cappuccino of thee.</p>
            <ul class="mt-8 divide-y divide-lijn-licht border-y border-lijn-licht">
              {['Appeltaart met slagroom', 'Koffie', 'Cappuccino', 'Thee'].map((g) => (
                <li class="flex items-baseline justify-between gap-4 py-3.5">
                  <span class="font-display text-2xl font-semibold leading-tight">{g}</span>
                  <span class="shrink-0 text-sm text-luik">in de reviews</span>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-xs text-kalk/75">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
            <div class="mt-8 flex items-center gap-5 rounded-xl bg-eik-3 p-4 shadow-sm">
              <svg aria-hidden="true" viewBox="0 0 32 32" class="h-12 w-12 shrink-0 text-korst" fill="none" stroke="currentColor"><circle cx="16" cy="16" r="13.5" stroke-width="1.4" /><circle cx="16" cy="16" r="10.5" stroke-width="1" /><clipPath id="taartklein"><circle cx="16" cy="16" r="10.5" /></clipPath><g clip-path="url(#taartklein)" stroke-width="1.2"><path d="M2 12 20 30M2 5l25 25M6 2l24 24M13 2l17 17M2 20l20-18M2 27 27 2M5 30 30 5M12 30 30 12" /></g></svg>
              <p class="text-kalk/90">Een hele appeltaart mee naar huis? <a href="#plek" class="font-bold text-korst underline underline-offset-4 transition-colors hover:text-korst-zacht">Vraag het via WhatsApp</a>.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HET PLEKJE -->
    <section class="licht bg-perkament py-16 lg:py-24" aria-labelledby="plekjekop">
      <div class="wrap grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow text-delfts">Het plekje</p>
          <h2 id="plekjekop" class="mt-3 text-3xl">Verstopt in de Kloksteeg, met de sfeer van de <em class="font-medium">17e eeuw</em></h2>
        </div>
        <p class="text-lg text-inkt-zacht lg:col-span-5 lg:col-start-8">Gekalkte muren, een smalle trap, oude schilderijen, blauw-wit servies en een kaarsje op tafel. Zo ziet het er binnen uit.</p>
      </div>
      <div class="wrap mt-10 grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-5 lg:mt-14">
        <figure class="col-span-2 overflow-hidden rounded-xl shadow-sm md:col-span-5 md:row-span-2">
          <div class="aspect-[4/5] h-full md:aspect-auto"><Foto src={trap} alt="Binnen bij Madame Marie: witte muren, een houten trap, een grote hanglamp, een oud schilderij en taarten op een tafel" sizes="(min-width: 768px) 42vw, 100vw" /></div>
        </figure>
        <figure class="overflow-hidden rounded-xl shadow-sm md:col-span-4">
          <div class="aspect-[3/4]"><Foto src={hoek} alt="Een houten tafeltje met twee stoelen en een brandende kaars op een zwart-grijze tegelvloer, met een oude kachel ernaast" sizes="(min-width: 768px) 33vw, 50vw" /></div>
        </figure>
        <figure class="overflow-hidden rounded-xl shadow-sm md:col-span-3">
          <div class="aspect-[3/4] h-full md:aspect-auto"><Foto src={taartjes} alt="Kleine appeltaartjes op een blauw-wit bord" sizes="(min-width: 768px) 25vw, 50vw" /></div>
        </figure>
        <figure class="col-span-2 overflow-hidden rounded-xl shadow-sm md:col-span-7">
          <div class="aspect-[16/9]"><Foto src={servies} alt="Blauw-wit servies en een glas thee op een oude houten tafel" class="object-[center_45%]" sizes="(min-width: 768px) 58vw, 100vw" /></div>
        </figure>
      </div>
    </section>

    <!-- WOW: IS ER PLEK VOOR ONS? -->
    <section id="plek" class="scroll-mt-16 bg-delfts-diep py-16 text-kalk lg:py-24" aria-labelledby="plekkop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-korst">Via WhatsApp</p>
            <h2 id="plekkop" class="mt-3 text-3xl">Is er plek voor ons?</h2>
          </div>
          <p class="text-lg text-kalk/85 lg:col-span-5">Kies de dag, de tijd en met hoeveel u komt. De knop zet het in een WhatsApp-bericht aan Madame Marie. Open van donderdag t/m zondag, 11.00 tot 17.00 uur.</p>
        </div>
        <div class="mt-8 sm:hidden"><Status /></div>
        <div class="mt-6 sm:mt-10"><Plek /></div>
      </div>
    </section>

    <!-- ROUTE EN TIJDEN -->
    <section id="route" class="licht scroll-mt-16 bg-kalk py-16 lg:py-24" aria-labelledby="routekop">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-delfts">Tijden en route</p>
          <h2 id="routekop" class="mt-3 text-3xl">Donderdag t/m zondag open</h2>
          <address class="mt-6 text-lg not-italic">
            <strong class="font-display text-2xl font-semibold italic">{site.naam}</strong><br />
            {site.straat}<br />{site.postcode} {site.plaats}
          </address>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.wa} class="btn btn-app"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-inkt hover:!bg-eik hover:!text-kalk hover:!shadow-none"><Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <a href={site.maps} class="mt-5 inline-flex items-center gap-2 font-bold text-delfts underline underline-offset-4 transition-colors hover:text-inkt">Route plannen in Google Maps <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <figure class="mt-10 overflow-hidden rounded-xl shadow-sm">
            <div class="aspect-[4/3] lg:aspect-[16/10]"><Foto src={pand} alt="De gevel van Madame Marie in de Kloksteeg met een krijtbord op de keitjes" class="object-[center_60%]" sizes="(min-width: 1024px) 480px, 100vw" /></div>
          </figure>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-lijn sm:p-8">
            <h3 class="text-2xl">Openingstijden</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden per dag</caption>
              <tbody>
                {dagen.map((d) => (
                  <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                    <th scope="row" class="py-3 font-semibold">{d.dag}</th>
                    <td class={`whitespace-nowrap py-3 text-right tabular-nums ${d.tijd === 'Gesloten' ? 'text-inkt-zacht' : 'font-bold'}`}>{d.tijd}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="mt-5 rounded-xl bg-eik p-5 text-kalk shadow-sm sm:p-6">
            <p class="eyebrow text-korst">Google</p>
            <p class="mt-2 font-display text-2xl font-semibold"><span class="tabular-nums">{site.google.score}</span> uit <span class="tabular-nums">{site.google.aantal}</span> reviews</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-delfts); }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  import { nuInLeiden } from '../scripts/open';
  const wd = nuInLeiden().dag.wd;
  document.querySelector(`.dagrij[data-wd="${wd}"]`)?.classList.add('vandaag');
</script>
