---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, waMet } from '../data/site';
import taart from '../assets/taart.jpg';
import punt from '../assets/punt.jpg';
import taartjes from '../assets/taartjes.jpg';
import hoek from '../assets/hoek.jpg';
import trap from '../assets/trap.jpg';
import servies from '../assets/servies.jpg';
import gevel from '../assets/gevel-prent.jpg';

const groet = 'Goedendag Madame Marie, ';
const tijden = [
  { wd: 4, dag: 'Donderdag', open: true },
  { wd: 5, dag: 'Vrijdag', open: true },
  { wd: 6, dag: 'Zaterdag', open: true },
  { wd: 0, dag: 'Zondag', open: true },
  { wd: 1, dag: 'Maandag', open: false },
  { wd: 2, dag: 'Dinsdag', open: false },
  { wd: 3, dag: 'Woensdag', open: false },
];
const fleuron = `<svg viewBox="0 0 60 12" class="mx-auto h-3 w-16" aria-hidden="true"><path d="M0 6h22M38 6h22" stroke="currentColor" stroke-width="1"/><path d="M30 1c-3 3-3 7 0 10 3-3 3-7 0-10ZM24 6c3-2 5-2 6 0-1 2-3 2-6 0ZM36 6c-3-2-5-2-6 0 1 2 3 2 6 0Z" fill="currentColor"/></svg>`;
---
<Base
  title={`${site.naam} | Appeltaart en koffie in de Kloksteeg, Leiden`}
  description="Vers gebakken appeltaart met slagroom, koffie, cappuccino en thee. Een klein, verstopt plekje in de Kloksteeg in Leiden. Donderdag t/m zondag open van 11.00 tot 17.00."
>
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- De muur: grote taart links tot de rand, titel rechts, tegelplint eronder. -->
    <section aria-labelledby="titel">
      <div class="grid lg:min-h-[max(36rem,calc(100svh-4rem-2.2rem-clamp(64px,6.4vw,92px)))] lg:grid-cols-12">
        <div class="relative h-[min(50svh,30rem)] lg:col-span-5 lg:h-auto">
          <Foto src={taart} hero alt="Een hele appeltaart met een hoge, gevlochten deegbovenkant op een metalen taartschaal, voor een oude houten deur." sizes="(min-width: 1024px) 42vw, 62vw" class="absolute inset-0 object-[50%_62%]" />
        </div>
        <div class="flex flex-col justify-between gap-8 px-5 pb-10 md:px-10 lg:col-span-7 lg:py-14 lg:pl-16 xl:pl-24 xl:pr-[max(2.5rem,calc((100vw-86rem)/2+2.5rem))]">
          <p class="fell hidden text-lg italic lg:block">Koffiebar in de Kloksteeg, Leiden</p>
          <div>
            <h1 id="titel" class="relative z-10 mt-8 text-4xl lg:mt-0 lg:-ml-[1.15em]">Appel&shy;taart</h1>
            <p class="fell mt-3 text-2xl italic leading-tight">met slagroom, en koffie erbij.</p>
            <p class="mt-8 max-w-[34ch] text-inkt-zacht">Vers gebakken, in een klein en verstopt huis midden in Leiden, met de sfeer van de 17e eeuw.</p>
            <a href={waMet(`${groet}is er vandaag nog appeltaart?`)} data-taartvraag class="vraag mt-8 inline-block text-2xl leading-tight">Is er vandaag nog appeltaart?</a>
          </div>
          <p class="text-sm">Donderdag t/m zondag, <span class="whitespace-nowrap tabular-nums">11.00 - 17.00</span></p>
        </div>
      </div>
      <div class="plint" style="--tegel:clamp(64px,6.4vw,92px)" aria-hidden="true"></div>
    </section>

    <!-- De kaart: de punt taart over de volle breedte, de menukaart schuift erover. -->
    <section id="kaart" aria-labelledby="kaart-titel" class="pb-20 lg:pb-32">
      <div class="h-[52svh] max-h-[880px] min-h-[18rem] lg:h-[88svh]">
        <Foto src={punt} alt="Een punt appeltaart met grote stukken appel en kaneel, slagroom ernaast, op een rood-wit bordje. Links een groen kopje, rechts een glas water." sizes="100vw" class="object-[50%_45%]" />
      </div>
      <div class="wrap relative grid gap-12 lg:grid-cols-12">
        <div class="-mt-20 self-start border border-lijn bg-papier px-6 py-10 text-center sm:px-10 lg:col-span-6 lg:-mt-48 lg:px-16 lg:py-16">
          <h2 id="kaart-titel" class="text-3xl">De kaart</h2>
          <div class="mt-6" set:html={fleuron} />
          <ul class="fell mt-8 space-y-7">
            <li><span class="block text-2xl">Appeltaart</span><span class="mt-1 block text-lg italic text-inkt-zacht">vers gebakken, met slagroom</span></li>
            <li><span class="block text-2xl">Koffie</span><span class="mt-1 block text-lg italic text-inkt-zacht">en cappuccino</span></li>
            <li><span class="block text-2xl">Thee</span></li>
          </ul>
          <div class="mt-8" set:html={fleuron} />
          <p class="mt-6 text-xs text-inkt-zacht">[[AANLEVEREN: volledige kaart met prijzen]]</p>
        </div>
        <figure class="lg:col-span-4 lg:col-start-8 lg:mt-24">
          <div class="aspect-[4/5] overflow-hidden">
            <Foto src={taartjes} alt="Kleine appeltaartjes met een gevlochten deegdekje op een blauw-wit bord." sizes="(min-width: 1024px) 30vw, 70vw" />
          </div>
          <figcaption class="fell mt-3 text-lg italic">Ook in het klein, op blauw-wit.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Het huis: kalkwit, schilderijen, servies. Verspringende foto's. -->
    <section id="huis" aria-labelledby="huis-titel" class="bg-kalk py-20 lg:py-32">
      <div class="wrap grid gap-x-12 gap-y-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="huis-titel" class="text-3xl">Klein en verstopt, midden in Leiden.</h2>
          <p class="mt-6 max-w-[38ch] text-inkt-zacht">Kalkwitte muren, oude schilderijen, blauw-wit servies en een kaars op tafel.</p>
          <figure class="mt-14 lg:mt-44">
            <div class="aspect-[4/5] overflow-hidden">
              <Foto src={trap} alt="Interieur met een houten trap, een grote hanglamp, een oud schilderij van twee kinderen en taarten op een tafel met bloemen." sizes="(min-width: 1024px) 36vw, 70vw" />
            </div>
            <figcaption class="fell mt-3 text-lg italic">De trap naar boven.</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <figure>
            <div class="aspect-[3/4] overflow-hidden">
              <Foto src={hoek} alt="Een hoek met kalkwitte muren: twee schilderijen, een houten deur met 'Staff only', appeltaarten op taartschalen, een kandelaar en een brandende kaars op een tafeltje." sizes="(min-width: 1024px) 44vw, 70vw" />
            </div>
            <figcaption class="fell mt-3 text-lg italic">Taarten, een kandelaar en twee schilderijen.</figcaption>
          </figure>
          <figure class="mt-14 lg:ml-[16%]">
            <div class="aspect-[6/5] overflow-hidden">
              <Foto src={servies} alt="Gestapelde blauw-witte borden met een vorkje op een oude houten tafel, ernaast een glas thee met verse blaadjes." sizes="(min-width: 1024px) 36vw, 70vw" />
            </div>
            <figcaption class="fell mt-3 text-lg italic">Blauw-wit servies, door elkaar.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Kloksteeg 2: de gevel als tegeltableau, de tijden ernaast. -->
    <section id="steeg" aria-labelledby="steeg-titel" class="py-20 lg:py-32">
      <div class="wrap grid items-start gap-14 lg:grid-cols-12">
        <figure class="lg:col-span-5">
          <div class="tableau">
            <div class="relative aspect-[5/7] overflow-hidden">
              <Foto src={gevel} alt="De gevel van Kloksteeg 2 in blauw-wit: ramen met kleine ruitjes, een donkere voordeur, planten in potten en een krijtbord op de keien." sizes="(min-width: 1024px) 36vw, 70vw" />
              <div class="voegen absolute inset-0" aria-hidden="true"></div>
            </div>
          </div>
          <figcaption class="fell mt-3 text-lg italic">Kloksteeg 2, met het krijtbord buiten.</figcaption>
        </figure>

        <div class="lg:col-span-6 lg:col-start-7 lg:pt-6">
          <h2 id="steeg-titel" class="whitespace-nowrap text-[clamp(3rem,6.4vw,6.5rem)]">Kloksteeg <span class="tabular-nums">2</span></h2>
          <p class="fell mt-4 text-xl italic">2311 SL Leiden</p>
          <p class="mt-3 text-sm"><a href={site.maps} class="underline underline-offset-4">Route in Google Maps</a></p>

          <h3 class="mt-14 text-2xl">Open</h3>
          <ul class="mt-5 border-t border-lijn">
            {tijden.map((t) => (
              <li data-wd={t.wd} class:list={['flex items-baseline justify-between gap-4 border-b border-lijn py-3', !t.open && 'text-inkt-zacht']}>
                <span class="fell text-xl">{t.dag}<span class="vandaag-teken ml-3 hidden align-middle font-body text-xs font-semibold">vandaag</span></span>
                <span class="whitespace-nowrap text-sm tabular-nums">{t.open ? '11.00 - 17.00' : 'gesloten'}</span>
              </li>
            ))}
          </ul>

          <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waMet(`${groet}hebben jullie vandaag een tafeltje voor ons? We zijn met ... personen.`)} data-tafel class="knop">Een tafel vragen via WhatsApp</a>
            <p class="text-sm">of bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-4">{site.tel}</a></p>
          </div>
          <p class="mt-10 text-xs text-inkt-zacht">{site.google.score} op Google, uit {site.google.aantal} beoordelingen.</p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  import { OPEN_DAGEN, TOT, nuInLeiden } from '../scripts/open';
  import { site } from '../data/site';
  const DAGEN = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
  const nu = nuInLeiden();
  const vandaagOpen = OPEN_DAGEN.includes(nu.dag.wd) && nu.min < TOT * 60 - 30;
  let wanneer = 'vandaag';
  if (!vandaagOpen) {
    let n = 1;
    while (!OPEN_DAGEN.includes((nu.dag.wd + n) % 7)) n++;
    wanneer = n === 1 ? 'morgen' : DAGEN[(nu.dag.wd + n) % 7];
  }
  const link = (t: string) => `${site.wa}?text=${encodeURIComponent('Goedendag Madame Marie, ' + t)}`;
  const vraag = document.querySelector<HTMLAnchorElement>('[data-taartvraag]');
  if (vraag) {
    const t = vandaagOpen ? 'is er vandaag nog appeltaart?' : `is er ${wanneer} appeltaart?`;
    vraag.href = link(t);
    vraag.textContent = t.charAt(0).toUpperCase() + t.slice(1);
  }
  const tafel = document.querySelector<HTMLAnchorElement>('[data-tafel]');
  if (tafel) tafel.href = link(`hebben jullie ${wanneer} een tafeltje voor ons? We zijn met ... personen.`);
  const rij = document.querySelector(`[data-wd="${nu.dag.wd}"]`);
  rij?.querySelector('.vandaag-teken')?.classList.remove('hidden');
</script>
