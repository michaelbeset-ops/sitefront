---
import { site, url, wa, telIcoon } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-lijn-licht bg-eik/95 text-kalk backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="no-underline"><Logo /></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={url('#taart')} class="no-underline transition-colors hover:text-korst">Appeltaart</a></li>
          <li><a href={url('#plek')} class="no-underline transition-colors hover:text-korst">Is er plek?</a></li>
          <li><a href={url('#route')} class="no-underline transition-colors hover:text-korst">Tijden en route</a></li>
        </ul>
      </nav>
      <a href={site.wa} class="btn btn-app !px-3.5 !py-2 text-sm"><Fragment set:html={wa} /><span class="max-[379px]:sr-only">WhatsApp</span></a>
    </div>
  </header>
) : (
  <footer class="bg-eik pb-10 pt-14 text-kalk/85">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo class="text-kalk" />
        <p class="mt-5">{site.straat}<br />{site.postcode} {site.plaats}</p>
      </div>
      <p class="md:col-span-4">
        <a href={site.wa} class="underline-offset-2 hover:underline">WhatsApp</a> of bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline-offset-2 hover:underline">{site.tel}</a><br />
        <span class="whitespace-nowrap">Do t/m zo</span> <span class="whitespace-nowrap tabular-nums">11.00 - 17.00</span><br />
        <span class="text-kalk/75">KvK <span class="text-xs">[[AANLEVEREN: KvK-nummer]]</span></span>
      </p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 border-t border-lijn-licht pt-6 text-xs text-kalk/75">Foto's van uw Google-bedrijfsprofiel, ter illustratie.</p>}
  </footer>
)}
