---
// Wow: "Is er plek voor ons?" Kies dag (alleen do t/m zo), tijd (11.00-16.30), aantal personen en eventueel de vraag
// of er een hele appeltaart besteld kan worden. De knop opent WhatsApp met een net bericht; de gast verstuurt het zelf.
// Zonder JS: vaste dagen en een gewone WhatsApp-knop.
import { site, wa } from '../data/site';
const tijden: string[] = [];
for (let m = 11 * 60; m <= 16 * 60 + 30; m += 30) tijden.push(`${String(Math.floor(m / 60)).padStart(2, '0')}.${m % 60 ? '30' : '00'}`);
const veld = 'mt-1.5 block w-full rounded-lg border border-lijn bg-white px-3.5 py-3 text-inkt shadow-sm transition-colors focus:border-delfts';
---
<form id="plekform" class="licht grid overflow-hidden rounded-2xl bg-kalk text-inkt shadow-xl lg:grid-cols-12" novalidate>
  <div class="p-5 sm:p-8 lg:col-span-7">
    <fieldset>
      <legend class="text-sm font-bold">Welke dag?</legend>
      <div class="mt-2 grid grid-cols-4 gap-2 sm:grid-cols-4" data-dagen>
        {['donderdag', 'vrijdag', 'zaterdag', 'zondag'].map((d, i) => (
          <label class="dag">
            <input type="radio" name="dag" value={d} class="sr-only" checked={i === 2} />
            <span class="block text-xs font-bold uppercase tracking-[0.14em]">{d.slice(0, 2)}</span>
            <span class="block font-display text-lg font-semibold capitalize leading-tight">{d}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <label class="block text-sm font-bold">Hoe laat ongeveer?
        <select name="tijd" class={veld}>
          {tijden.map((t) => <option value={t} selected={t === '14.00'}>{t} uur</option>)}
        </select>
      </label>
      <div>
        <span class="block text-sm font-bold" id="perslabel">Met hoeveel personen?</span>
        <div class="mt-1.5 flex items-stretch overflow-hidden rounded-lg border border-lijn bg-white shadow-sm">
          <button type="button" class="stap px-4 text-xl font-bold text-delfts transition-colors hover:bg-perkament" data-stap="-1" aria-label="Eén persoon minder">&minus;</button>
          <input type="number" name="personen" min="1" max="20" value="2" inputmode="numeric" aria-labelledby="perslabel" class="w-full min-w-0 border-x border-lijn py-3 text-center font-bold tabular-nums text-inkt" />
          <button type="button" class="stap px-4 text-xl font-bold text-delfts transition-colors hover:bg-perkament" data-stap="1" aria-label="Eén persoon meer">+</button>
        </div>
      </div>
    </div>

    <label class="mt-5 flex cursor-pointer items-start gap-3 rounded-xl bg-perkament px-4 py-3.5 text-sm ring-1 ring-lijn transition-shadow hover:shadow-sm">
      <input type="checkbox" name="taart" class="mt-1 h-4 w-4 shrink-0 accent-delfts" />
      <span><strong class="font-bold">Ook vragen: kunnen we een hele appeltaart bestellen om mee te nemen?</strong><br /><span class="text-inkt-zacht">Die vraag komt dan onder het bericht.</span></span>
    </label>

    <label class="mt-5 block text-sm font-bold">Uw naam <span class="font-normal text-inkt-zacht">(mag leeg blijven)</span>
      <input type="text" name="naam" autocomplete="given-name" class={veld} />
    </label>
  </div>

  <div class="flex flex-col bg-perkament p-5 sm:p-8 lg:col-span-5">
    <p class="eyebrow text-delfts">Uw bericht</p>
    <div class="mt-3 flex-1">
      <p aria-live="polite" data-bericht class="bubbel relative whitespace-pre-line rounded-xl rounded-tl-none bg-white p-4 text-[0.98rem] leading-relaxed shadow-sm">Hallo Madame Marie,

Is er plek voor ons op zaterdag rond 14.00 uur? We zijn met 2 personen.

Groet</p>
    </div>
    <a href={site.wa} data-knop class="btn btn-app mt-5 w-full text-lg"><Fragment set:html={wa} />Open WhatsApp met dit bericht</a>
    <p class="mt-3 text-sm text-inkt-zacht">WhatsApp opent met het bericht klaar. U kunt het nog aanpassen voordat u het verstuurt. Liever bellen: <a href={site.telHref} class="whitespace-nowrap font-bold tabular-nums text-delfts underline underline-offset-2">{site.tel}</a>.</p>
  </div>
</form>

<style>
  .dag { display: block; cursor: pointer; border-radius: var(--radius-lg); background: var(--color-white); padding: .6rem .5rem; text-align: center; box-shadow: inset 0 0 0 1px var(--color-lijn), var(--shadow-sm); transition: background-color .2s ease, color .2s ease, box-shadow .2s ease, transform .2s ease; }
  .dag:hover { transform: translateY(-1px); box-shadow: inset 0 0 0 1.5px var(--color-delfts), var(--shadow-sm); }
  .dag:has(input:checked) { background: var(--color-delfts); color: var(--color-white); box-shadow: none; }
  .dag:has(input:focus-visible) { outline: 3px solid var(--color-delfts); outline-offset: 3px; }
  .bubbel::before { content: ''; position: absolute; left: -8px; top: 0; border-width: 0 10px 10px 0; border-style: solid; border-color: transparent var(--color-white) transparent transparent; }
</style>

<script>
  import { komendeDagen, dagNaam, dagKort, maandKort, nuInLeiden } from '../scripts/open';
  const f = document.getElementById('plekform') as HTMLFormElement;
  const bak = f.querySelector<HTMLElement>('[data-dagen]')!;
  const bericht = f.querySelector<HTMLElement>('[data-bericht]')!;
  const knop = f.querySelector<HTMLAnchorElement>('[data-knop]')!;
  const tijd = f.elements.namedItem('tijd') as HTMLSelectElement;
  const pers = f.elements.namedItem('personen') as HTMLInputElement;
  const nu = nuInLeiden();

  // Echte data: de eerstvolgende acht open dagen (do t/m zo).
  const dagen = komendeDagen(8);
  bak.classList.remove('sm:grid-cols-4');
  bak.classList.add('sm:grid-cols-8');
  bak.innerHTML = dagen.map((d, i) => `
    <label class="dag">
      <input type="radio" name="dag" value="${d.ymd}" class="sr-only" ${i === 0 ? 'checked' : ''} aria-label="${d.ymd === nu.dag.ymd ? 'vandaag, ' : ''}${dagNaam(d)}" />
      <span class="block text-xs font-bold uppercase tracking-[0.14em]">${d.ymd === nu.dag.ymd ? 'vandaag' : dagKort(d)}</span>
      <span class="block font-display text-2xl font-semibold leading-none tabular-nums">${d.d}</span>
      <span class="block text-xs">${maandKort(d)}</span>
    </label>`).join('');

  function gekozen() {
    const v = (f.querySelector('input[name="dag"]:checked') as HTMLInputElement | null)?.value;
    return dagen.find((d) => d.ymd === v) ?? dagen[0];
  }

  function tijdenBijwerken() {
    const vandaag = gekozen().ymd === nu.dag.ymd;
    let eerste: HTMLOptionElement | null = null;
    for (const o of Array.from(tijd.options)) {
      const [u, m] = o.value.split('.').map(Number);
      o.disabled = vandaag && u * 60 + m <= nu.min;
      if (!o.disabled && !eerste) eerste = o;
    }
    if (tijd.selectedOptions[0]?.disabled && eerste) tijd.value = eerste.value;
  }

  function bouw() {
    tijdenBijwerken();
    const d = gekozen();
    const n = Math.min(20, Math.max(1, Number(pers.value) || 1));
    const naam = (f.elements.namedItem('naam') as HTMLInputElement).value.trim();
    const taart = (f.elements.namedItem('taart') as HTMLInputElement).checked;
    const wanneer = d.ymd === nu.dag.ymd ? `vandaag (${dagNaam(d)})` : dagNaam(d);
    const regels = [
      'Hallo Madame Marie,',
      '',
      n === 1
        ? `Is er plek voor mij op ${wanneer} rond ${tijd.value} uur? Ik kom alleen.`
        : `Is er plek voor ons op ${wanneer} rond ${tijd.value} uur? We zijn met ${n} personen.`,
    ];
    if (taart) regels.push('', `Nog een vraag: ${n === 1 ? 'kan ik' : 'kunnen we'} ook een hele appeltaart bestellen om mee te nemen? Zo ja, hoe gaat dat?`);
    regels.push('', naam ? `Groet, ${naam}` : 'Groet');
    const tekst = regels.join('\n');
    bericht.textContent = tekst;
    knop.href = `https://wa.me/31638619568?text=${encodeURIComponent(tekst)}`;
  }

  f.querySelectorAll<HTMLButtonElement>('[data-stap]').forEach((b) => b.addEventListener('click', () => {
    pers.value = String(Math.min(20, Math.max(1, (Number(pers.value) || 1) + Number(b.dataset.stap))));
    bouw();
  }));
  f.addEventListener('input', bouw);
  f.addEventListener('change', bouw);
  f.addEventListener('submit', (e) => e.preventDefault());
  bouw();
</script>
