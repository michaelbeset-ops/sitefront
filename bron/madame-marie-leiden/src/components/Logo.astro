---
// Typografisch woordmerk (geen bestaand logo gevonden): een appeltaart met roosterdeeg als beeldmerk,
// "Madame Marie" in Cormorant Garamond cursief.
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
const lijn = licht ? 'text-delfts' : 'text-korst';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg aria-hidden="true" viewBox="0 0 32 32" class={`h-8 w-8 shrink-0 ${lijn}`} fill="none" stroke="currentColor">
    <circle cx="16" cy="16" r="13.5" stroke-width="1.6" />
    <circle cx="16" cy="16" r="10.5" stroke-width="1" />
    <clipPath id="taartvlak"><circle cx="16" cy="16" r="10.5" /></clipPath>
    <g clip-path="url(#taartvlak)" stroke-width="1.3">
      <path d="M2 12 20 30M2 5l25 25M6 2l24 24M13 2l17 17M2 20l20-18M2 27 27 2M5 30 30 5M12 30 30 12" />
    </g>
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`eyebrow !text-[0.625rem] !tracking-[0.3em] ${licht ? 'text-inkt-zacht' : 'text-luik'}`}>Koffiebar, Leiden</span>
    <span class="mt-0.5 whitespace-nowrap font-display text-xl font-semibold italic tracking-[-0.01em] min-[380px]:text-[1.4rem]">Madame Marie</span>
  </span>
</span>
