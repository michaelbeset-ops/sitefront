---
// Live "nu open / gaat open op ..."-status. Zonder JS: de vaste openingstijden.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class={`status rounded-xl border border-lijn-licht bg-eik-2 p-5 shadow-sm ${cls}`} data-status="basis">
  <p class="eyebrow flex items-center gap-2 text-korst-zacht"><span class="stip h-2 w-2 rounded-full bg-korst" aria-hidden="true"></span><span data-kort>Openingstijden</span></p>
  <div aria-live="polite">
    <p class="mt-2 font-display text-xl font-semibold leading-snug text-kalk" data-tekst>Donderdag t/m zondag van 11.00 tot 17.00 uur.</p>
    <p class="mt-1 text-sm text-kalk/80" data-verder>Maandag, dinsdag en woensdag gesloten.</p>
  </div>
</div>

<style is:global>
  .status[data-status='open'] .stip { background: #7fd3a1; animation: gloed 2.4s ease-in-out infinite; }
  .status[data-status='dicht'] .stip { background: var(--color-kalk); opacity: .55; }
  @keyframes gloed { 50% { box-shadow: 0 0 0 5px #7fd3a133; } }
</style>

<script is:inline>
  // Direct na de status uitgevoerd (geen verspringing) en elke minuut opnieuw. Zelfde regels als src/scripts/open.ts.
  (function () {
    var OPEN = [4, 5, 6, 0], VAN = 660, TOT = 1020;
    var DAG = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
    var MND = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
    function zet() {
      var p = {};
      new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
      var d = new Date(Date.UTC(+p.year, +p.month - 1, +p.day));
      var min = +p.hour * 60 + +p.minute, wd = d.getUTCDay(), r;
      var nog = TOT - min;
      if (OPEN.indexOf(wd) > -1 && min >= VAN && min < TOT) {
        r = ['open', 'Nu open', 'Nu open, tot 17.00 uur.', nog <= 60 ? 'Nog ' + nog + ' minuten open vandaag.' : 'Vandaag van 11.00 tot 17.00 uur.'];
      } else if (OPEN.indexOf(wd) > -1 && min < VAN) {
        r = ['straks', 'Vandaag open', 'Gaat vandaag open om 11.00 uur.', 'Open tot 17.00 uur.'];
      } else {
        for (var i = 0; i < 8; i++) { d.setUTCDate(d.getUTCDate() + 1); if (OPEN.indexOf(d.getUTCDay()) > -1) break; }
        var dag = DAG[d.getUTCDay()] + ' ' + d.getUTCDate() + ' ' + MND[d.getUTCMonth()];
        r = i === 0
          ? ['dicht', 'Nu gesloten', 'Gaat morgen open, om 11.00 uur.', dag.charAt(0).toUpperCase() + dag.slice(1) + ', van 11.00 tot 17.00 uur.']
          : ['dicht', 'Nu gesloten', 'Gaat open op ' + dag + '.', 'Van 11.00 tot 17.00 uur. Maandag t/m woensdag gesloten.'];
      }
      document.querySelectorAll('.status').forEach(function (el) {
        el.dataset.status = r[0];
        el.querySelector('[data-kort]').textContent = r[1];
        el.querySelector('[data-tekst]').textContent = r[2];
        el.querySelector('[data-verder]').textContent = r[3];
      });
    }
    zet();
    if (!window.__statusTik) window.__statusTik = setInterval(zet, 60000);
  })();
</script>
