---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['diensten', 'Diensten'], ['europa', 'Europa'], ['wagenpark', 'Wagenpark'], ['over', 'Over ons'], ['contact', 'Contact']];
---
<header class:list={['kopbalk sticky top-0 z-40 transition-[background-color,color,box-shadow] duration-300', thuis ? 'is-over' : '']} data-kop>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6 md:h-20">
    <Merk class="kop-merk" />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[.9375rem] font-semibold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="kop-link no-underline transition-opacity duration-200 hover:opacity-70">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="kop-link num hidden text-[.9375rem] font-semibold no-underline hover:opacity-70 xl:inline-flex xl:items-center xl:gap-2"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
      <a href={h('aanvraag')} class="kop-knop knop hidden !min-h-11 !px-5 text-[.9375rem] md:inline-flex">Transport aanvragen</a>
      <button type="button" class="kop-link grid h-11 w-11 place-items-center rounded-full lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden border-t border-lijn bg-kade text-inkt lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="kop block border-b border-lijn py-4 text-xl font-semibold text-inkt no-underline">{t}</a></li>)}
      <li><a href={h('aanvraag')} class="kop block border-b border-lijn py-4 text-xl font-semibold text-inkt no-underline">Transport aanvragen</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-lijn bg-kade/95 p-2 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="flex min-h-12 items-center justify-center gap-2 rounded-full border-[1.5px] border-marine text-[.9375rem] font-bold text-marine no-underline"><Icoon naam="tel" class="h-4 w-4" />Bellen</a>
  <a href={waHoi} class="flex min-h-12 items-center justify-center gap-2 rounded-full bg-marine text-[.9375rem] font-bold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<style>
  .kopbalk { background: color-mix(in srgb, var(--color-kade) 96%, transparent); color: var(--color-inkt); box-shadow: 0 1px 0 var(--color-lijn); backdrop-filter: blur(10px); }
  .kopbalk :global(.kop-merk) { color: var(--color-marine); }
  /* Boven de foto: transparant en wit, tot er gescrold wordt of het menu open is. */
  .kopbalk.is-over:not(.vast) { position: absolute; top: auto; inset-inline: 0; background: linear-gradient(180deg, #0e18208c, #0e182000); color: var(--color-wit); box-shadow: none; backdrop-filter: none; }
  .kopbalk.is-over:not(.vast) :global(.kop-merk) { color: var(--color-wit); }
  .kopbalk.is-over:not(.vast) .kop-knop { background: var(--color-wit); color: var(--color-marine); }
  .kopbalk.is-over.vast { position: fixed; inset-inline: 0; top: 0; animation: zak .35s var(--ease-zacht); }
  @keyframes zak { from { transform: translateY(-100%); } }
</style>

<script>
  const kop = document.querySelector<HTMLElement>('[data-kop]');
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  let open = false;
  const zet = () => kop?.classList.toggle('vast', open || scrollY > 40);
  if (kop?.classList.contains('is-over')) { addEventListener('scroll', zet, { passive: true }); zet(); }
  if (k && m) {
    const toggle = (o: boolean) => { open = o; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); zet(); };
    k.addEventListener('click', () => toggle(k.getAttribute('aria-expanded') !== 'true'));
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
  }
</script>
