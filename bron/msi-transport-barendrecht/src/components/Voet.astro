---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const diensten = ['Dry containers', 'Reefer met genset', 'Flat rack en open top', 'Flexibags', 'Shunten', 'Afvalstoffen', 'Opslag', 'Gasmeting'];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Containertransport over de weg, vanuit Barendrecht door heel Europa. De planning is 24/7 bereikbaar.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Diensten</p>
      <ul class="mt-3 space-y-1">{diensten.map((d) => <li><a href={url('#diensten')} class="no-underline hover:underline">{d}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link num text-wit">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-4 break-all"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.planning}`} class="link">{site.planning}</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.financieel}`} class="link">{site.financieel}</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Adres</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-4 num">KvK {site.kvk}<br />BTW {site.btw}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · NIWO- en VIHB-vergunning</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen website, kentekens onherkenbaar gemaakt. Review letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
