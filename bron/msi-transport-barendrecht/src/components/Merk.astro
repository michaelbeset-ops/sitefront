---
// Woordmerk naar hun logo: de weg in een open cirkel, en MSI dat verticaal door TRANSPORT loopt.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['merk group inline-flex items-center gap-2.5 no-underline', licht ? 'text-wit' : 'text-marine', cls]}>
  <span class="sr-only">MSI Transport BV, naar de homepage</span>
  <svg viewBox="0 0 100 100" class="h-11 w-11 flex-none transition-transform duration-500 group-hover:-rotate-6" aria-hidden="true" fill="currentColor">
    <path d="M80 27A36 36 0 1 0 80 73" fill="none" stroke="currentColor" stroke-width="9" />
    <path d="M37 100h10l2.6-94z" /><path d="M49.6 100h10L50.4 6z" />
    <path d="M1 55v8l95-42z" /><path d="M1 65v9l95-52z" />
  </svg>
  <span class="kop grid grid-cols-[auto_auto_auto] items-center font-semibold leading-none" aria-hidden="true">
    <span class="text-[.82rem] tracking-[.06em]">TRAN</span>
    <span class="flex flex-col items-center px-px">
      <span class="text-[.82rem]">M</span>
      <span class="-my-0.5 text-[1.45rem] font-bold">S</span>
      <span class="text-[.82rem]">I</span>
    </span>
    <span class="text-[.82rem] tracking-[.06em]">PORT</span>
  </span>
</a>
