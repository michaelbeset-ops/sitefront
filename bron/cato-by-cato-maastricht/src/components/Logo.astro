---
// Woordmerk naar het rode labeltje in de zaak: CATO, en daaronder CATO op z'n kop.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <span aria-hidden="true" class="grid h-10 w-10 shrink-0 place-content-center rounded-lg bg-tomaat font-display text-[0.62rem] font-extrabold leading-[0.95] tracking-wide text-white shadow-sm">
    <span>CATO</span><span class="rotate-180">CATO</span>
  </span>
  <span class="font-display text-xl font-bold leading-none tracking-tight">Cato <span class="font-medium italic text-[0.85em] opacity-80">by</span> cato</span>
</span>
