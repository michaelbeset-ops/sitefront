---
import { site, url } from '../data/site';
import Logo from './Logo.astro';
import Wa from './Wa.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-lijn-licht bg-petrol/95 text-havermout backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="no-underline"><Logo /></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={url('#bak')} class="no-underline transition-colors hover:text-kurkuma">Stel je bak samen</a></li>
          <li><a href={url('#gasten')} class="no-underline transition-colors hover:text-kurkuma">Wat gasten noemen</a></li>
          <li><a href={url('#contact')} class="no-underline transition-colors hover:text-kurkuma">Openingstijden</a></li>
        </ul>
      </nav>
      <a href={site.wa} class="btn btn-wa !px-4 !py-2 text-sm"><Wa class="h-4 w-4" /><span class="sr-only min-[380px]:not-sr-only">WhatsApp</span></a>
    </div>
  </header>
) : (
  <footer class="bg-petrol pb-10 pt-14 text-havermout/85">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo class="text-havermout" />
        <p class="mt-5">{site.straat}<br />{site.postcode} {site.plaats}</p>
      </div>
      <p class="md:col-span-4"><a href={site.wa} class="underline-offset-2 hover:underline">WhatsApp</a> of bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline-offset-2 hover:underline">{site.tel}</a><br /><span class="text-havermout/75">KvK <span class="text-xs">[[AANLEVEREN: KvK-nummer]]</span></span></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 border-t border-lijn-licht pt-6 text-xs text-havermout/75">Foto's van uw Google-bedrijfsprofiel en sfeerfoto's via Unsplash, ter illustratie.</p>}
  </footer>
)}
