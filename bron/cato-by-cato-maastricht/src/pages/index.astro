---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Bak from '../components/Bak.astro';
import Wa from '../components/Wa.astro';
import { site, noemen, themas } from '../data/site';
import bowlAfhaal from '../assets/bowl-afhaal.jpg';
import bowlBonen from '../assets/bowl-bonen.jpg';
import bowlKikkererwt from '../assets/bowl-kikkererwt.jpg';
import binnen from '../assets/binnen.jpg';
import hoekje from '../assets/hoekje.jpg';
import toonbank from '../assets/toonbank.jpg';
import pand from '../assets/pand.jpg';

const dagen = [
  { dag: 'Maandag', wd: 1, tijd: '12:00 - 20:30' },
  { dag: 'Dinsdag', wd: 2, tijd: '12:00 - 20:30' },
  { dag: 'Woensdag', wd: 3, tijd: '12:00 - 20:30' },
  { dag: 'Donderdag', wd: 4, tijd: '12:00 - 20:30' },
  { dag: 'Vrijdag', wd: 5, tijd: '12:00 - 20:30' },
  { dag: 'Zaterdag', wd: 6, tijd: '12:00 - 18:00' },
  { dag: 'Zondag', wd: 0, tijd: 'Gesloten' },
];
const pijl = '<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base title={`${site.naam} | Gezond, betaalbaar comfortfood in Maastricht`} description="Cato by cato, Stenenbrug 9A in Maastricht: gezond, betaalbaar comfortfood met veel vega. Kies je base (linzen, couscous of bulgur) en bestel via WhatsApp. Ma t/m vr 12:00 - 20:30, za 12:00 - 18:00.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative overflow-hidden bg-petrol text-havermout">
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 top-24 hidden h-[28rem] w-[28rem] rounded-full bg-petrol-2 lg:block"></div>
      <div class="wrap relative grid gap-8 pb-14 pt-0 lg:grid-cols-12 lg:gap-10 lg:pb-20 lg:pt-14">
        <div class="order-2 lg:order-1 lg:col-span-7 lg:pt-4">
          <p class="eyebrow text-kurkuma">Afhaalrestaurant, Stenenbrug 9A Maastricht</p>
          <h1 class="mt-5 text-4xl">Gezond, betaalbaar <span class="text-kurkuma">comfort&shy;food</span></h1>
          <p class="mt-6 max-w-xl text-lg text-havermout/85">Veel vega, veel keuze en goed gekruid. Kies zelf je base: linzen, couscous of bulgur. Ook lekker om thuis op te warmen.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#bak" class="btn btn-wa"><Wa class="h-5 w-5" /> Stel je bak samen</a>
            <a href={site.telHref} class="btn btn-lijn text-havermout"><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <div class="mt-10 grid gap-5 border-t border-lijn-licht pt-8 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-8">
            <dl>
              <dt class="text-sm text-havermout/75">Google</dt>
              <dd class="mt-1 flex items-baseline gap-2 font-display text-3xl font-bold leading-none">{site.google.score}<span class="font-body text-sm font-normal text-havermout/75">uit {site.google.aantal} reviews</span></dd>
            </dl>
            <Status />
          </div>
        </div>
        <div class="relative order-1 -mx-5 md:mx-0 lg:order-2 lg:col-span-5">
          <figure class="relative overflow-hidden md:rounded-2xl md:shadow-xl">
            <div class="aspect-[16/9] md:aspect-[4/3] lg:aspect-[4/5]">
              <Foto src={bowlAfhaal} alt="Sfeerbeeld: kleurrijke bowl in een afhaalbakje met quinoa, hummus, rode kool, wortel en kiemgroente" class="object-[center_8%] md:object-[60%_45%]" hero sizes="(min-width: 1024px) 480px, 100vw" />
            </div>
            <figcaption class="absolute right-3 top-3 rounded-full bg-petrol/85 px-3 py-1 text-xs font-semibold text-havermout backdrop-blur-sm">Sfeerbeeld</figcaption>
          </figure>
          <figure class="absolute -bottom-12 -right-6 hidden w-56 rotate-3 overflow-hidden rounded-xl bg-havermout p-1.5 shadow-xl transition-transform duration-300 hover:rotate-0 xl:block">
            <div class="aspect-[4/3] overflow-hidden rounded-lg"><Foto src={binnen} alt="Binnen bij Cato by cato: de toonbank onder slingers van bankbiljetten, met gele kratten en losse tafeltjes" sizes="224px" /></div>
            <figcaption class="px-1.5 pb-0.5 pt-1.5 text-xs font-semibold text-inkt">Binnen bij Cato</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- POPULAIR -->
    <section class="licht bg-havermout py-16 lg:py-24" aria-labelledby="populair">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-tomaat">Populair bij gasten</p>
          <h2 id="populair" class="mt-3 text-3xl">Jij kiest de base</h2>
          <p class="mt-4 text-inkt-zacht">Gasten noemen het vaakst de linzen, de couscous en de bulgur, goed gekruid en met veel vega.</p>
          <ul class="mt-6 flex flex-wrap gap-2">
            <li class="rounded-full bg-kurkuma px-4 py-1.5 font-display font-bold">Linzen</li>
            <li class="rounded-full bg-zand px-4 py-1.5 font-display font-bold">Couscous</li>
            <li class="rounded-full bg-roze px-4 py-1.5 font-display font-bold">Bulgur</li>
          </ul>
          <p class="mt-6 text-xs text-inkt-zacht">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
          <a href="#bak" class="btn btn-tomaat mt-8">Stel je bak samen <Fragment set:html={pijl} /></a>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:col-span-8">
          <figure class="col-span-2 overflow-hidden rounded-2xl shadow-sm sm:col-span-1 sm:row-span-2">
            <div class="aspect-[4/3] h-full sm:aspect-auto"><Foto src={bowlBonen} alt="Sfeerbeeld: kom met quinoa, bonen in tomatensaus en gekruide groene groente" class="object-[40%_center]" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" /></div>
          </figure>
          <figure class="overflow-hidden rounded-2xl shadow-sm">
            <div class="aspect-square"><Foto src={bowlKikkererwt} alt="Sfeerbeeld: bowl met broccoli, geroosterde kikkererwten, zoete aardappel en quinoa" class="object-[52%_center]" sizes="(min-width: 1024px) 400px, 50vw" /></div>
          </figure>
          <figure class="relative overflow-hidden rounded-2xl shadow-sm">
            <div class="aspect-square"><Foto src={toonbank} alt="De toonbank van Cato by cato met een oude weegschaal en bakjes met het Cato by cato-label" class="object-[20%_center]" sizes="(min-width: 1024px) 400px, 50vw" /></div>
            <figcaption class="absolute bottom-2 left-2 rounded-full bg-petrol/85 px-3 py-1 text-xs font-semibold text-havermout">De toonbank</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- STEL JE BAK SAMEN -->
    <section id="bak" class="licht scroll-mt-16 bg-zand py-16 lg:py-24" aria-labelledby="bakkop">
      <div class="wrap">
        <div class="grid gap-4 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-tomaat-diep">Bestellen via WhatsApp</p>
            <h2 id="bakkop" class="mt-3 text-3xl">Stel je bak samen</h2>
          </div>
          <p class="text-inkt-zacht lg:col-span-5">Kies je base, vega of niet, het aantal porties en wanneer je ophaalt. Je krijgt een kant-en-klaar WhatsApp-bericht.</p>
        </div>
        <div class="mt-10"><Bak /></div>
      </div>
    </section>

    <!-- WAT GASTEN NOEMEN -->
    <section id="gasten" class="scroll-mt-16 bg-petrol py-16 text-havermout lg:py-24" aria-labelledby="gastkop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-kurkuma">Wat gasten noemen</p>
          <h2 id="gastkop" class="mt-3 text-3xl">Dé plek voor studenten</h2>
          <div class="mt-8 flex items-end gap-4">
            <span class="font-display text-[clamp(4.5rem,9vw,7rem)] font-extrabold leading-[0.8] text-kurkuma">{site.google.score}</span>
            <span class="pb-1 text-havermout/80">uit <span class="whitespace-nowrap tabular-nums">{site.google.aantal}</span><br />Google-reviews</span>
          </div>
          <figure class="mt-10 overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[4/3]"><Foto src={hoekje} alt="Zithoek bij Cato by cato met een oud fornuis, een orchidee, een roze stoel en houten tafels" class="object-[center_55%]" sizes="(min-width: 1024px) 460px, 100vw" /></div>
          </figure>
        </div>
        <div class="lg:col-span-7">
          <ol class="divide-y divide-lijn-licht border-y border-lijn-licht">
            {noemen.map((n, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-x-3 py-5 sm:grid-cols-[3rem_14rem_1fr] sm:items-baseline">
                <span class="font-display text-sm font-bold text-roze tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-xl">{n.kop}</h3>
                <p class="col-start-2 mt-1 text-havermout/80 sm:col-start-3 sm:mt-0">{n.tekst}</p>
              </li>
            ))}
          </ol>
          <p class="mt-8 text-sm text-havermout/75">Zo vaak genoemd in de reviews</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {themas.map(([t, n]) => (
              <li class="rounded-full border border-lijn-licht bg-petrol-2 px-3 py-1 text-sm">{t} <span class="font-bold tabular-nums text-kurkuma">{n}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="licht scroll-mt-16 bg-havermout py-16 lg:py-24" aria-labelledby="contactkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <figure class="relative overflow-hidden rounded-2xl shadow-sm lg:col-span-5">
          <div class="aspect-[4/3] h-full lg:aspect-auto"><Foto src={pand} alt="Het hoekpand van Cato by cato aan de Stenenbrug in Maastricht" class="object-[center_60%]" sizes="(min-width: 1024px) 460px, 100vw" /></div>
          <figcaption class="absolute bottom-3 left-3 rounded-full bg-petrol/85 px-3 py-1 text-xs font-semibold text-havermout">Stenenbrug 9A</figcaption>
        </figure>
        <div class="lg:col-span-7">
          <p class="eyebrow text-tomaat">Langskomen</p>
          <h2 id="contactkop" class="mt-3 text-3xl">Op de hoek van de Stenenbrug</h2>
          <div class="mt-8 grid gap-8 md:grid-cols-2">
          <div>
            <address class="not-italic text-lg">
              <strong class="font-display text-2xl font-bold">{site.naam}</strong><br />
              {site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-inkt-zacht">{site.hoek}</span>
            </address>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={site.wa} class="btn btn-wa"><Wa class="h-5 w-5" /> Stuur een WhatsApp</a>
              <a href={site.telHref} class="btn btn-tomaat"><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            </div>
            <a href={site.maps} class="mt-5 inline-flex items-center gap-2 font-semibold text-tomaat underline underline-offset-4 transition-colors hover:text-tomaat-diep">Route plannen <Fragment set:html={pijl} /></a>
          </div>
          <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-lijn">
            <h3 class="text-2xl">Openingstijden</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden per dag</caption>
              <tbody>
                {dagen.map((d) => (
                  <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                    <th scope="row" class="py-2.5 font-semibold">{d.dag}</th>
                    <td class={`whitespace-nowrap py-2.5 text-right tabular-nums ${d.tijd === 'Gesloten' ? 'text-inkt-zacht' : ''}`}>{d.tijd}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-tomaat); font-weight: 700; }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  import { nuInMaastricht } from '../scripts/open';
  document.querySelector(`.dagrij[data-wd="${nuInMaastricht().dag.wd}"]`)?.classList.add('vandaag');
</script>
