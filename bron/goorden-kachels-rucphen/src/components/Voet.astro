---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-roet text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Gebruikte en nieuwe kachels en haarden, onderhoud en reparatie. Sinds 1993.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link num">{site.mob} (ook WhatsApp)</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Showroom</p>
      <ul class="mt-4 space-y-1.5">
        {tijden.map((t) => <li class="num">{t.dag} {t.tijd}</li>)}
      </ul>
      <p class="mt-3">Andere dagen (ook in de avonden en zondag) geheel vrijblijvend op afspraak.</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Google</p>
      <p class="mt-4"><a href={site.reviews} class="link num">{site.google.score} uit {site.google.aantal} reviews</a></p>
      <p class="mt-3 num">KvK {site.kvk}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, Rucphen</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-vuur">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en gegevens van goordenkachels.nl; foto's van jullie eigen Google-profiel en website. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
