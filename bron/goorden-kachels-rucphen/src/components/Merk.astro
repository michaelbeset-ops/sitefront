---
// Woordmerk naar hun logo: GOORDEN zwaar in grijs/wit, eronder "Kachels & Zonnehemels" in oranje.
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<a href={url('')} class="flex flex-col no-underline">
  <span class={`text-[1.6rem] font-bold leading-[.9] tracking-[.02em] ${licht ? 'text-inkt' : 'text-wit'}`} style="font-stretch: 100%">GOORDEN</span>
  <span class={`mt-1 text-[.8rem] font-medium leading-none tracking-[.01em] ${licht ? 'text-vuur-diep' : 'text-vuur'}`}>Kachels &amp; Zonnehemels</span>
</a>
