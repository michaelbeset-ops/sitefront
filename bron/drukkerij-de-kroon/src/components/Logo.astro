---
// Hun logo nagemaakt: monogram "dK" (d grijs, K rood) met een kroontje erboven, daarnaast "Drukkerij" in rood,
// "de" in grijs en "Kroon" in rood, met de regel "niet alleen voor drukwerk" eronder.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const grijs = licht ? '#bdbdbd' : '#a3a3a3';
const rood = licht ? '#f08b90' : '#c8282f';
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <span class="sr-only">Drukkerij de Kroon</span>
  <svg viewBox="0 0 46 40" class="h-10 w-auto flex-none" aria-hidden="true">
    <path d="M17 9.5 15.6 3.2l3.4 2.6L22 1l3 4.8 3.4-2.6L27 9.5Z" fill={rood} />
    <rect x="17" y="10.2" width="10" height="1.8" rx=".5" fill={grijs} />
    <path d="M12.8 14h4.6v24h-4.4v-1.8a6.9 6.9 0 0 1-5.5 2.3C3.3 38.5 0 35 0 29.6s3.3-9 7.5-9a6.9 6.9 0 0 1 5.3 2.2Zm-4.3 10.6c-2.3 0-3.9 2-3.9 5s1.6 5 3.9 5 4.1-2 4.1-5-1.7-5-4.1-5Z" fill={grijs} />
    <path d="M20.5 14h5.1v10.1L34.3 14h6.1l-9.6 10.6L41.4 38h-6.3l-7.8-10-1.7 1.9V38h-5.1Z" fill={rood} />
  </svg>
  <span aria-hidden="true" class="flex flex-col font-body">
    <span class="text-[1.05rem] sm:text-[1.2rem] font-extrabold tracking-[-0.01em] whitespace-nowrap"><span style={`color:${rood}`}>Drukkerij</span> <span style={`color:${licht ? grijs : '#6b6b6b'}`}>de</span><span style={`color:${rood}`}>Kroon</span></span>
    <span class={`mt-1 self-end text-[0.7rem] font-medium tracking-[0.02em] ${licht ? 'text-white/75' : 'text-ink-soft'}`}>niet alleen voor drukwerk</span>
  </span>
</span>
