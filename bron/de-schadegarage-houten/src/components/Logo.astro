---
// Nagemaakt naar hun eigen logo (rode boogtekst "De Schade Garage" met "Houten" eronder), strakker gezet.
// De boog is vlakker dan in het origineel, zodat hij ook klein in de header leesbaar blijft.
interface Props { class?: string; id?: string }
const { class: cls = '', id = 'boog' } = Astro.props;
---
<svg viewBox="0 0 260 74" role="img" aria-label="De Schade Garage Houten" class={cls}>
  <path id={id} d="M12 52 Q130 4 248 52" fill="none" />
  <text font-family="var(--font-display)" font-weight="700" font-size="27" fill="currentColor" letter-spacing="-0.5">
    <textPath href={`#${id}`} startOffset="50%" text-anchor="middle" textLength="226" lengthAdjust="spacingAndGlyphs">De Schade Garage</textPath>
  </text>
  <text x="130" y="68" text-anchor="middle" font-family="var(--font-display)" font-weight="700" font-size="17" letter-spacing="3" fill="currentColor">HOUTEN</text>
</svg>
