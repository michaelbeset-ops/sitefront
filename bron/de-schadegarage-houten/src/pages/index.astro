---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Logo from '../components/Logo.astro';
import SchadeDoorgeven from '../components/SchadeDoorgeven.astro';
import { Image } from 'astro:assets';
import { site, diensten, noemen } from '../data/site';
import pand from '../assets/pand.jpg';
import deuk from '../assets/deuk.jpg';
import werkplaats from '../assets/werkplaats.jpg';
import sfeer from '../assets/sfeer.jpg';
import auto from '../assets/auto.jpg';
const bel = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
const mail = 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.6V17h16V7.6l-8 5.2z';
const altDeuk = 'Voorkant van een zilvergrijze auto met zware aanrijdingsschade: ingedeukte motorkap, losgeslagen koplamp en bumper';
---
<Base
  title="De Schadegarage Houten | Schadeherstel, bumpers, uitdeuken en APK"
  description="Schade Garage Houten aan de Peppelkade: schadeherstel, bumperreparaties, uitdeuken zonder spuiten en onderhoud / APK. Gratis leenauto als er een beschikbaar is. Ma t/m vr 8:00 tot 17:00 uur."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: donker vlak met sfeerfoto, grote kop en de bewijzen op een rij. -->
    <section class="relative isolate overflow-hidden bg-ink text-white">
      <div class="absolute inset-0 -z-10 lg:left-[32%]">
        <Foto src={sfeer} alt="Man poetst de glanzende zwarte motorkap van een sportauto in een werkplaats met lichtstrepen" hero sizes="(min-width: 1024px) 68vw, 100vw" class="object-[72%_40%]" />
        <div class="absolute inset-0 bg-ink/70 lg:bg-transparent lg:bg-[linear-gradient(90deg,var(--color-ink)_0%,color-mix(in_srgb,var(--color-ink)_78%,transparent)_30%,color-mix(in_srgb,var(--color-ink)_15%,transparent)_70%,transparent_100%)]"></div>
        <div class="absolute inset-0 hidden bg-[radial-gradient(ellipse_at_100%_15%,color-mix(in_srgb,var(--color-ink)_80%,transparent),transparent_40%)] lg:block"></div>
        <div class="absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(0deg,var(--color-ink),transparent)]"></div>
      </div>
      <div class="wrap pb-36 pt-14 sm:pb-44 lg:pb-40 lg:pt-16">
        <div class="max-w-2xl">
          <p class="eyebrow text-vuur-light">Peppelkade 13A, Houten</p>
          <h1 class="mt-5 text-[clamp(2.25rem,7.5vw+0.6rem,6.4rem)] leading-[0.92]">Schadeherstel in&nbsp;Houten</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">Schadeherstel, bumperreparaties, uitdeuken zonder spuiten en onderhoud / APK. {site.slogan}.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-vuur hover:!bg-white hover:!text-ink"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bel} /></svg><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            <a href="#schade" class="btn btn-line hover:!bg-white hover:!text-ink">Schade doorgeven</a>
          </div>
        </div>
        <dl class="mt-12 grid max-w-3xl gap-y-5 lg:max-w-[35rem] border-t border-white/20 pt-6 sm:grid-cols-[auto_1fr] sm:gap-x-12">
          <div><dt class="text-sm text-white/75">Google</dt><dd class="mt-1 font-display text-2xl font-bold tabular-nums">{site.google} <span class="whitespace-nowrap font-body text-sm font-normal text-white/75">({site.reviews} reviews)</span></dd></div>
          <div><dt class="text-sm text-white/75">Ma t/m vr</dt><dd class="mt-1 whitespace-nowrap font-display text-2xl font-bold tabular-nums">8:00 tot 17:00</dd></div>
          <div class="sm:col-span-2"><dt class="text-sm text-white/75">Leenauto</dt><dd class="mt-1 font-display text-lg font-semibold leading-snug"><a href="#leenauto" class="no-underline transition-colors hover:text-vuur-light">Gratis, als er een beschikbaar is</a></dd></div>
        </dl>
      </div>
    </section>

    <!-- Eigen pand als kaart die over de rand van de hero valt; ernaast wat klanten op Google noemen. -->
    <section class="pb-16 lg:pb-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-x-14">
        <figure class="relative -mt-28 self-start sm:-mt-36 lg:col-span-6 lg:col-start-7 lg:row-start-1 lg:-mt-80">
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-steel shadow-sm ring-8 ring-paper sm:aspect-[16/10]">
            <Foto src={pand} alt="Ons pand aan de Peppelkade in Houten: grijze bedrijfshal met borden van De Schadegarage en een open garagedeur met een rode auto" sizes="(min-width: 1024px) 680px, 100vw" class="object-[58%_60%]" />
          </div>
          <figcaption class="absolute bottom-4 left-4 rounded-lg bg-vuur px-4 py-2.5 text-white shadow-sm sm:bottom-6 sm:left-6 sm:px-5 sm:py-3">
            <span class="block text-xs font-semibold uppercase tracking-[.08em]">Ons pand</span>
            <span class="block font-display text-lg font-bold leading-tight sm:text-xl">Peppelkade 13A</span>
          </figcaption>
        </figure>
        <div class="lg:col-span-5 lg:row-start-1 lg:pt-14">
          <p class="eyebrow text-vuur">{site.google} uit 5 op Google, {site.reviews} reviews</p>
          <h2 class="mt-4 text-3xl">Wat klanten noemen</h2>
          <p class="mt-4 text-sm text-ink-soft">Samengevat uit de reviews op Google.</p>
        </div>
        <ul class="grid border-t border-line md:grid-cols-3 md:gap-x-10 lg:col-span-12">
          {noemen.map((n) => (
            <li class="grid grid-cols-[1.75rem_1fr] gap-x-3 border-b border-line py-6 md:border-b-0">
              <svg viewBox="0 0 24 24" class="mt-1 size-5 text-vuur" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" /></svg>
              <div><h3 class="text-xl">{n.kop}</h3><p class="mt-1 text-ink-soft">{n.tekst}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Diensten: genummerde lijst naast een grote werkplaatsfoto met een schadefoto als inzet. -->
    <section id="diensten" class="scroll-mt-20 bg-white py-16 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-6">
          <p class="eyebrow text-vuur">Onder één dak</p>
          <h2 class="mt-4 text-3xl">Wat we doen</h2>
          <ol class="mt-10">
            {diensten.map((d, i) => (
              <li class="grid grid-cols-[3rem_1fr] gap-x-4 border-t border-line py-7 sm:grid-cols-[4.5rem_1fr]">
                <span class="font-display text-2xl font-semibold tabular-nums text-vuur" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="text-2xl">{d.naam}</h3>
                  <p class="mt-2 text-ink-soft">{d.tekst}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="relative lg:col-span-6 lg:pt-6">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[5/4]">
            <Foto src={werkplaats} alt="Witte sportauto in een donkere werkplaats, de voorkant gedemonteerd en de motorkap open" sizes="(min-width: 1024px) 560px, 100vw" class="object-[42%_50%]" />
          </div>
          <div class="relative -mt-16 ml-auto mr-4 w-[58%] overflow-hidden rounded-xl shadow-sm ring-8 ring-white sm:-mt-24 lg:-mt-28 lg:mr-0 lg:w-[50%]">
            <div class="aspect-[4/3]">
              <Foto src={deuk} alt={altDeuk} sizes="(min-width: 1024px) 290px, 58vw" class="object-[35%_50%]" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <SchadeDoorgeven />

    <!-- Leenauto: hun sterkste punt als donkere balk met grote letters. -->
    <section id="leenauto" class="scroll-mt-16 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-14">
        <div class="lg:col-span-7">
          <p class="eyebrow text-vuur-light">Terwijl uw auto bij ons staat</p>
          <h2 class="mt-4 text-[clamp(3rem,9vw+0.5rem,7.5rem)] leading-[0.9]">Gratis <span class="text-vuur-light">leenauto</span></h2>
          <p class="mt-5 font-display text-xl font-semibold text-white/85 sm:text-2xl">als er een beschikbaar is</p>
        </div>
        <div class="lg:col-span-5 lg:pb-2">
          <p class="max-w-lg text-lg text-white/85">Staat uw auto bij ons, dan kunt u gebruikmaken van een gratis leenauto, als er een beschikbaar is. Bel voor een afspraak.</p>
          <a href={site.telHref} class="btn btn-wit mt-7"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bel} /></svg><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
        </div>
      </div>
    </section>

    <!-- Openingstijden en route, met hun eigen auto als kleine inzet op ware grootte. -->
    <section id="open" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-7">
          <h2 class="text-3xl">Openingstijden</h2>
          <dl class="mt-8 grid gap-y-2 border-t-2 border-ink pt-6 sm:grid-cols-[1fr_auto] sm:items-baseline">
            <dt class="font-display text-xl font-semibold">Maandag t/m vrijdag</dt>
            <dd class="whitespace-nowrap font-display text-2xl font-bold tabular-nums">8:00 tot 17:00 uur</dd>
          </dl>
          <div class="mt-12 border-t border-line pt-8">
            <h3 class="text-xl">Route</h3>
            <address class="mt-3 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
            <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Plan uw route</a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:flex lg:items-start lg:justify-end lg:pt-2">
          <div class="w-fit rounded-xl bg-white p-2 shadow-sm">
            <Image src={auto} alt="Auto met de naam van De Schadegarage erop" widths={[262]} sizes="262px" format="webp" quality={80} loading="eager" class="block h-auto w-[262px] max-w-full rounded-lg" />
          </div>
        </div>
      </div>
    </section>

    <!-- Contact: het rode slotvlak met hun logo en het nummer als grootste element. -->
    <section id="contact" class="scroll-mt-16 bg-vuur py-16 text-white lg:py-24 [&_:focus-visible]:outline-white">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <Logo id="boog-voet" class="w-full max-w-[18rem]" />
          <h2 class="mt-8 text-3xl">Bel of mail voor een afspraak</h2>
          <p class="mt-4 text-lg">{site.slogan}.</p>
        </div>
        <div class="grid content-start gap-6 lg:col-span-7 lg:pt-4">
          <dl class="grid gap-6">
            <div><dt class="eyebrow">Telefoon</dt><dd class="mt-1"><a href={site.telHref} class="whitespace-nowrap font-display text-4xl font-bold tabular-nums tracking-[-0.04em] underline decoration-2 underline-offset-[6px]">{site.tel}</a></dd></div>
            <div><dt class="eyebrow">E-mail</dt><dd class="mt-1"><a href={`mailto:${site.mail}`} class="break-all font-display text-xl font-semibold underline decoration-2 underline-offset-4 sm:text-2xl">{site.mail}</a></dd></div>
          </dl>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row">
            <a href={site.telHref} class="btn btn-wit"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bel} /></svg>Nu bellen</a>
            <a href={`mailto:${site.mail}`} class="btn btn-line hover:!bg-white hover:!text-ink"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={mail} /></svg>E-mail sturen</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
