---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, diensten } from '../data/site';
import hero from '../assets/hero.jpg';
import schade from '../assets/schade.jpg';
import poetsen from '../assets/poetsen.jpg';
import wiel from '../assets/wiel.jpg';
const bel = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
const mail = 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.6V17h16V7.6l-8 5.2z';
const altSchade = 'Voorkant van een zilvergrijze auto met zware aanrijdingsschade: ingedeukte motorkap, losgeslagen koplamp en bumper';
---
<Base
  title="De Schadegarage Houten | Schadeherstel, bumpers, uitdeuken en APK"
  description="Schade Garage Houten aan de Peppelkade: schadeherstel, bumperreparaties, uitdeuken zonder spuiten en onderhoud / APK. Gratis leenauto. Ma t/m vr 8:00 tot 17:00 uur."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: tekst links, werkplaatsfoto rechts tot aan de rand. Op mobiel eerst de foto, dan meteen de belknop. -->
    <section class="lg:grid lg:grid-cols-12 lg:items-stretch">
      <div class="aspect-[16/10] overflow-hidden lg:order-2 lg:col-span-6 lg:aspect-auto lg:min-h-[36rem]">
        <Foto src={hero} alt="Man zit geknield naast de achterbumper van een donkere auto in een werkplaats, delen van de bumper zijn geplamuurd" hero sizes="(min-width: 1024px) 50vw, 100vw" class="object-[70%_50%]" />
      </div>
      <div class="wrap py-9 lg:col-span-6 lg:mr-0 lg:max-w-none lg:py-16 lg:pl-[max(2rem,calc((100vw-76rem)/2+2rem))] lg:pr-12">
        <p class="eyebrow text-vuur">Peppelkade 13A, Houten</p>
        <h1 class="mt-4 text-4xl">Schade aan uw auto? Wij herstellen het.</h1>
        <p class="mt-5 text-lg text-ink-soft">Schadeherstel, bumperreparaties, uitdeuken zonder spuiten en onderhoud / APK. {site.slogan}.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={site.telHref} class="btn btn-vuur"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bel} /></svg><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          <a href={`mailto:${site.mail}`} class="btn btn-line"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={mail} /></svg>Stuur een e-mail</a>
        </div>
        <p class="mt-7 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-soft">
          <span><strong class="text-ink">{site.google}</strong> op Google ({site.reviews} reviews)</span>
          <span class="whitespace-nowrap tabular-nums">Ma t/m vr 8:00 tot 17:00 uur</span>
        </p>
      </div>
    </section>

    <!-- Diensten: genummerde lijst naast een staande foto, geen kaartjes. -->
    <section id="diensten" class="scroll-mt-20 border-t border-line bg-white py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Wat we doen</h2>
          <p class="mt-4 max-w-md text-ink-soft">Vier diensten, onder één dak aan de Peppelkade.</p>
          <div class="mt-8 hidden aspect-[4/5] overflow-hidden rounded-xl lg:block">
            <Foto src={schade} alt={altSchade} sizes="(min-width: 1024px) 440px, 100vw" class="object-[35%_50%]" />
          </div>
        </div>
        <ol class="lg:col-span-7">
          {diensten.map((d, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-x-4 border-t border-line py-7 first:border-t-0 first:pt-0 sm:grid-cols-[4.5rem_1fr] lg:first:pt-2">
              <span class="font-display text-2xl font-semibold tabular-nums text-vuur" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-2xl">{d.naam}</h3>
                <p class="mt-2 text-ink-soft">{d.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="aspect-[16/10] overflow-hidden rounded-xl lg:hidden">
          <Foto src={schade} alt={altSchade} sizes="100vw" class="object-[35%_50%]" />
        </div>
      </div>
    </section>

    <!-- Leenauto: hun sterkste punt krijgt een eigen donker vlak met grote letters. -->
    <section id="leenauto" class="scroll-mt-16 overflow-hidden bg-ink text-white">
      <div class="lg:grid lg:grid-cols-12">
        <div class="wrap py-16 lg:col-span-6 lg:mr-0 lg:max-w-none lg:py-24 lg:pl-[max(2rem,calc((100vw-76rem)/2+2rem))] lg:pr-12">
          <p class="eyebrow text-vuur-light">Terwijl uw auto bij ons staat</p>
          <h2 class="mt-4 text-4xl">Gratis <span class="text-vuur-light">leenauto</span></h2>
          <p class="mt-6 max-w-lg text-lg text-white/85">Bij De Schadegarage kunt u gebruikmaken van een gratis leenauto. Bel voor een afspraak.</p>
          <a href={site.telHref} class="btn btn-wit mt-8"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bel} /></svg><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
        </div>
        <div class="aspect-[16/10] lg:col-span-6 lg:aspect-auto">
          <Foto src={poetsen} alt="Handen in zwarte werkhandschoenen bewerken een glanzend paars carrosseriedeel" sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
      </div>
    </section>

    <!-- Openingstijden en route: tijden groot, adres eronder, foto ernaast. -->
    <section id="open" class="scroll-mt-20 bg-steel py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-7">
          <h2 class="text-3xl">Openingstijden</h2>
          <dl class="mt-8 grid gap-y-2 border-t-2 border-ink pt-6 sm:grid-cols-[1fr_auto] sm:items-baseline">
            <dt class="font-display text-xl font-semibold">Maandag t/m vrijdag</dt>
            <dd class="whitespace-nowrap font-display text-2xl font-bold tabular-nums">8:00 tot 17:00 uur</dd>
          </dl>
          <div class="mt-12 border-t border-line pt-8">
            <h3 class="text-xl">Route</h3>
            <address class="mt-3 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
            <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Plan uw route</a>
          </div>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-xl lg:col-span-5 lg:aspect-auto">
          <Foto src={wiel} alt="Koplamp en voorwiel met lichtmetalen velg van een bruine auto, op straat" sizes="(min-width: 1024px) 440px, 100vw" class="object-[60%_50%]" />
        </div>
      </div>
    </section>

    <!-- Contact: het oranjerode slotvlak met het nummer als grootste element. -->
    <section id="contact" class="scroll-mt-16 bg-vuur py-16 text-white lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Bel of mail voor een afspraak</h2>
          <p class="mt-4 text-lg">{site.slogan}.</p>
        </div>
        <div class="grid content-start gap-6 lg:col-span-7">
          <dl class="grid gap-6">
            <div><dt class="eyebrow">Telefoon</dt><dd class="mt-1"><a href={site.telHref} class="whitespace-nowrap font-display text-4xl font-bold tabular-nums tracking-[-0.04em] underline decoration-2 underline-offset-[6px]">{site.tel}</a></dd></div>
            <div><dt class="eyebrow">E-mail</dt><dd class="mt-1"><a href={`mailto:${site.mail}`} class="break-all font-display text-xl font-semibold underline decoration-2 underline-offset-4 sm:text-2xl">{site.mail}</a></dd></div>
          </dl>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row">
            <a href={site.telHref} class="btn btn-wit"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={bel} /></svg>Nu bellen</a>
            <a href={`mailto:${site.mail}`} class="btn btn-line hover:!bg-white hover:!text-ink"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={mail} /></svg>E-mail sturen</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
