---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site } from '../data/site';
import laag from '../assets/fh16-laag.jpg';
import schuin from '../assets/fh16-schuin.jpg';
import erf from '../assets/erf-nat.jpg';

// Alleen wat openbaar bekend of op hun eigen foto's te zien is.
const materieel = [
  ['Trekker', 'Volvo FH16 750'],
  ['Oplegger', 'Nooteboom'],
  ['Semi-dieplader', 'Broshuis'],
  ['Op de bumper', 'Convoi exceptionnel'],
];
---
<Base title="Van Wijgerden Transport | Speciaal transport uit Molenaarsgraaf" description="Van Wijgerden Transport B.V. uit Molenaarsgraaf: speciaal transport, opgericht in 1982. Polderweg Oost 16. Bel 0184 642 085.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. Op het erf, vanaf het asfalt gezien: de FH16 groot, de kop in de lucht, het convooibord als belknop. -->
    <section class="relative isolate flex min-h-[calc(100svh-6.5rem)] flex-col justify-between overflow-hidden bg-nacht text-wit md:min-h-[calc(100svh-6.75rem)]" aria-labelledby="kop">
      <div class="absolute inset-x-0 bottom-0 top-[13.5rem] -z-10 md:top-0">
        <Foto src={laag} alt="De zilverwitte Volvo FH16 met blauwe airbrushstrepen en het gele bord Convoi exceptionnel, laag vanaf het erf gefotografeerd tegen een blauwe lucht." hero sizes="(min-width: 768px) 100vw, 180vw" class="absolute inset-0 object-[74%_50%] md:object-[50%_62%]" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,#0e2560_0%,#0e256000_22%,#1c1f2400_62%,#1c1f24c0_100%)] md:bg-[linear-gradient(90deg,#0e2560cc_0%,#0e256066_34%,#0e256000_56%)]" aria-hidden="true"></div>
      </div>

      <div class="wrap pt-8 md:pt-[clamp(2.5rem,8vh,5.5rem)]">
        <h1 id="kop" class="max-w-[12ch] text-[clamp(3.6rem,8.6vw,8.4rem)] drop-shadow-[0_2px_18px_#0e256066]">Speciaal transport</h1>
        <p class="mt-5 max-w-[24rem] text-lg leading-snug text-wit md:mt-7 md:max-w-[27rem] md:text-[1.3rem]">Uit Molenaarsgraaf, sinds 1982. Van de Alblasserwaard tot in de Rotterdamse haven.</p>
      </div>

      <div class="wrap flex flex-col items-start gap-4 pb-8 pt-10 md:flex-row md:items-end md:gap-8 md:pb-12">
        <a href={site.telHref} class="bord">
          <span class="bord-klein">Transport aanvragen</span>
          <span class="bord-groot">{site.tel}</span>
        </a>
        <p class="max-w-[19rem] text-[.95rem] leading-snug text-wit md:mb-1">Vertel wat er mee moet: afmetingen, gewicht, van waar naar waar.</p>
      </div>
    </section>

    <!-- 2. Materieel: één grote foto, de feiten als regels op de cabinedeur. -->
    <section id="materieel" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="materieel-kop">
      <div class="wrap grid gap-10 md:grid-cols-12 md:gap-8">
        <figure class="md:col-span-7 md:row-span-2">
          <div class="aspect-[4/3] overflow-hidden"><Foto src={schuin} alt="De Volvo FH16 750 schuin van voren op het erf, met daarachter de Nooteboom-oplegger en een groene loods." sizes="(min-width: 768px) 56vw, 100vw" /></div>
        </figure>
        <div class="md:col-span-5 md:pl-6">
          <h2 id="materieel-kop" class="text-2xl">Het materieel</h2>
          <p class="mt-5 max-w-[26rem] text-lg leading-relaxed text-grind">Truckstar schreef erover: een FH16 750 voor Van Wijgerden. Hij staat hier op het eigen erf aan de Polderweg Oost.</p>
        </div>
        <dl class="self-end md:col-span-5 md:pl-6">
          {materieel.map(([k, v]) => (
            <div class="grid grid-cols-[8.5rem_1fr] items-baseline gap-4 border-t border-lijn py-3 last:border-b">
              <dt class="text-sm text-grind">{k}</dt>
              <dd class="cond text-[1.55rem] font-medium uppercase leading-none">{v}</dd>
            </div>
          ))}
          <p class="mt-4 text-sm text-grind">[[AANLEVEREN: wagenpark, maximale lengte, breedte en gewicht]]</p>
        </dl>
      </div>
    </section>

    <!-- 3. Werkgebied: het erf na een regenbui, breed; de route als weg met middenstreep. -->
    <section id="haven" class="op-nacht scroll-mt-20 bg-nacht text-wit" aria-labelledby="haven-kop">
      <div class="relative h-[15rem] overflow-hidden md:h-[26rem]">
        <Foto src={erf} alt="Het natte erf van Van Wijgerden in de ochtendzon, met de FH16 en een rij opleggers." sizes="100vw" class="object-[60%_45%]" />
      </div>
      <div class="wrap py-16 md:py-24">
        <h2 id="haven-kop" class="sr-only">Werkgebied</h2>
        <div class="cond grid items-center gap-4 text-[clamp(2.2rem,4.6vw,4.4rem)] font-bold uppercase leading-none md:grid-cols-[auto_1fr_auto] md:gap-8">
          <span>Molenaarsgraaf</span>
          <span class="h-3 bg-[repeating-linear-gradient(90deg,var(--color-bord)_0_2.2rem,transparent_2.2rem_3.6rem)] max-md:my-2 max-md:w-full" aria-hidden="true"></span>
          <span class="text-lucht">Rotterdamse haven</span>
        </div>
        <p class="mt-10 max-w-[34rem] text-lg leading-relaxed text-lucht">Thuisbasis in de Alblasserwaard, aan het werk in de haven van Rotterdam. Waar de lading verder heen moet, bespreken we aan de telefoon.</p>
      </div>
    </section>

    <!-- 4. Contact. -->
    <section id="contact" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="contact-kop">
      <div class="wrap grid gap-12 md:grid-cols-12">
        <div class="md:col-span-6">
          <h2 id="contact-kop" class="text-3xl">Bel ons</h2>
          <a href={site.telHref} class="bord mt-8">
            <span class="bord-klein">Van Wijgerden Transport</span>
            <span class="bord-groot">{site.tel}</span>
          </a>
        </div>
        <div class="grid gap-10 sm:grid-cols-2 md:col-span-6 md:pt-4">
          <div>
            <p class="text-lg leading-relaxed">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <p class="mt-3"><a href={site.maps} class="lijn">Route naar het erf</a></p>
          </div>
          <div class="text-grind">
            <p>E-mail: [[AANLEVEREN: e-mailadres voor aanvragen]]</p>
            <p class="mt-3">KvK {site.kvk}</p>
            <p class="mt-6 text-sm">Google-reviews: {site.google.score} uit {site.google.aantal}</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
