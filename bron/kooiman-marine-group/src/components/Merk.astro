---
// Hun eigen logo (SVG van werkenbijkooiman.nl): boog + KOOIMAN + achtkleurige waterlijn + MARINE GROUP. Wit wordt currentColor.
import ruw from './logo.svg?raw';
import { url } from '../data/site';
interface Props { class?: string; licht?: boolean }
const { class: cls = 'h-14 w-auto md:h-16', licht = true } = Astro.props;
const svg = ruw
  .replace('<svg ', `<svg class="${cls}" role="img" aria-label="Kooiman Marine Group" `)
  .replace(/fill="#fff"/g, 'fill="currentColor"').replace(/stroke="#fff"/g, 'stroke="currentColor"')
  .replace(/<clipPath[\s\S]*?<\/clipPath>/, '').replace(/clip-path="[^"]*"/, '');
---
<a href={url('')} class={`inline-flex no-underline ${licht ? 'text-wit' : 'text-marine'}`} set:html={svg} />
