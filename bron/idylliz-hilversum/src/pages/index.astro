---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi } from '../data/site';

import hero from '../assets/hero-464-wikkelring.jpg';
import peridoot from '../assets/540-peridoot.jpg';
import aquamarijn from '../assets/539-aquamarijn.jpg';
import vijfKleuren from '../assets/505-vijf-kleuren-goud.jpg';
import statement from '../assets/536-statement.jpg';
import roos from '../assets/462-roos.jpg';
import dots from '../assets/473-dots.jpg';
import creolen from '../assets/531-creolen.jpg';
import roodborstjes from '../assets/522-roodborstjes.jpg';
import omaMoeder from '../assets/516-trouwringen-oma-moeder.jpg';
import erfgoud from '../assets/526-trouwringen-erfgoud.jpg';
import grillig from '../assets/528-grillige-ring.jpg';
import schuifmaat from '../assets/atelier-schuifmaat.jpg';
import draad from '../assets/atelier-draad.jpg';
import zetten from '../assets/atelier-zetten.jpg';

const titel = 'Idylliz, edelsmid atelier in Hilversum | Handgesmede sieraden van zilver en goud';
const omschrijving = 'Lize Bouwman smeedt ringen, trouwringen en oorbellen van zilver en goud, ook van jouw eigen oude goud. Op afspraak in haar atelier aan de bosrand van Hilversum.';
const [ilona, jacqueline, jansje] = reviews.los;

// Keuzes voor de zin; alles komt uit haar eigen blog (wat ze maakt, waarvan, en hoe).
const heb = ['goud van een dierbare', 'oude trouwringen', 'een losse steen', 'nog niets, alleen een idee'];
const wil = ['een wikkelring', 'een ring met een steen', 'trouwringen', 'oorbellen', 'een hanger', 'een armband'];
const van = ['zilver', 'goud', 'zilver met goud', 'overleg'];
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: No. 464, gouden wikkelring met edelstenen, haar eigen foto -->
    <section class="relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col justify-end overflow-hidden bg-inkt text-wit md:min-h-[calc(100svh-5rem)]">
      <Image src={hero} alt="Een gouden wikkelring met fijn pareldraad en kleine gekleurde stenen in gouden zetkastjes, op een stuk boomschors" quality={66} widths={[420, 600, 800, 1080, 1440, 1800]} sizes="100vw" loading="eager" decoding="sync" fetchpriority="high" class="absolute inset-x-0 top-0 -z-20 h-[64%] w-full object-cover object-[50%_30%] md:h-full md:object-[50%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1b201c4d_0%,#1b201c00_20%,#1b201c00_34%,#1b201cd9_52%,#1b201c_62%)] md:bg-[linear-gradient(180deg,#1b201c40_0%,#1b201c00_24%,#1b201c00_44%,#1b201cb3_66%,#1b201cf2_84%)]" aria-hidden="true"></div>
      <div class="wrap pb-24 pt-60 md:pb-12 md:pt-56 lg:pb-14">
        <p class="text-base text-wit/85">Edelsmid atelier in Hilversum</p>
        <h1 class="mt-2 text-hero md:whitespace-nowrap">Lieflijk doch <em class="text-mos-licht">stoer.</em></h1>
        <div class="mt-5 grid items-end gap-y-7 lg:grid-cols-12 lg:gap-x-10">
          <p class="max-w-[36rem] leading-relaxed text-wit/90 lg:col-span-6 md:text-xl">Handgesmede sieraden van zilver en goud, samen met jou ontworpen door Lize Bouwman. Ook van goud dat al gedragen is.</p>
          <div class="flex flex-wrap gap-3 lg:col-span-6 lg:justify-end">
            <a href={waHoi} class="knop"><Icoon naam="wa" />App voor een afspraak</a>
            <a href="#werk" class="knop knop-lijn hidden sm:inline-flex">Bekijk het werk</a>
          </div>
        </div>
      </div>
      <p class="absolute right-5 top-5 text-right text-sm text-wit/85 md:right-10 md:top-8 lg:right-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))]"><span class="nr text-xl text-wit">464</span><span class="hidden sm:inline"><br />Gouden wikkelring met edelsteen</span></p>
    </section>

    <!-- 2. LIZE: haar eigen woorden, groot gezet -->
    <section id="atelier" class="py-20 md:py-32" aria-labelledby="lize-titel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-7">
          <h2 id="lize-titel" class="rijs text-3xl leading-[1.12]">Lieflijk met een stoere twist. Of andersom. Van fijn pareldraad tot grof gehamerd.</h2>
          <div class="rijs mt-10 grid gap-8 sm:grid-cols-2" style="--d:.08s">
            <p class="text-lg text-grijs">Mijn naam is Lize Bouwman en als zelfstandig edelsmid ontwerp ik graag samen met jou een sieraad dat echt bij je past.</p>
            <p class="text-lg text-grijs">Ik werk met zilver en goud. Het is ook mogelijk eigen goud te hergebruiken. Ik hou van het persoonlijk contact, het samen vormgeven.</p>
          </div>
          <p class="rijs mt-8 text-sm text-grijs" style="--d:.12s">Lize Bouwman, uit "Over Idylliz" op haar blog</p>
        </div>
        <figure class="rijs lg:col-span-5" style="--d:.1s">
          <Image src={schuifmaat} alt="Een hand met een zilveren ring met aquamarijn wordt opgemeten met een schuifmaat op de werktafel" quality={72} widths={[360, 540, 720, 900]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-sm text-grijs">Op de werktafel in het atelier</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. HET REGISTER: genummerde stukken, met haar eigen titels -->
    <section id="werk" class="bg-wit py-20 md:py-28" aria-labelledby="werk-titel">
      <div class="wrap">
        <div class="grid gap-y-5 lg:grid-cols-12 lg:gap-x-12">
          <h2 id="werk-titel" class="rijs text-3xl lg:col-span-6">Elk stuk krijgt een nummer</h2>
          <p class="rijs max-w-md self-end text-lg text-grijs lg:col-span-5 lg:col-start-8">Bijna alles is in opdracht gemaakt. Dit zijn er acht uit het register; de rest staat op het blog.</p>
        </div>

        <div class="mt-12 grid grid-cols-2 gap-x-3 gap-y-10 md:mt-16 md:grid-cols-12 md:gap-x-6 md:gap-y-14">
          <figure class="rijs col-span-2 md:col-span-7">
            <Image src={peridoot} alt="Een gouden ring met een grote groene peridoot in suikerbroodslijpvorm op een grijze stenen rand" quality={72} widths={[400, 600, 800, 1000]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_62%] md:aspect-auto md:h-[34rem]" />
            <figcaption class="register"><span class="nr">540</span><span><span class="font-bold">Groene Peridoot. Sugar loaf.</span> <span class="text-grijs">Een nieuwe steen in een gouden zetting, voor iemand die al tijden haar steentje kwijt was.</span></span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-5" style="--d:.08s">
            <Image src={aquamarijn} alt="Een brede zilveren ring met een ruwe, gebarsten structuur en een langwerpige lichtblauwe aquamarijn" quality={72} widths={[400, 600, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover md:aspect-auto md:h-[34rem]" />
            <figcaption class="register"><span class="nr">539</span><span><span class="font-bold">In between.</span> <span class="text-grijs">Aquamarijn tussen gebarsten zilver. Vrij werk, tussen de opdrachten door.</span></span></figcaption>
          </figure>

          <figure class="rijs md:col-span-4">
            <Image src={vijfKleuren} alt="Een wikkelring van losse ringetjes in witgoud, geelgoud, rosegoud en roodgoud" quality={70} widths={[300, 450, 600]} sizes="(min-width: 768px) 30vw, 50vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
            <figcaption class="register"><span class="nr">505</span><span class="text-sm"><span class="font-bold">Vijf kleuren goud.</span> <span class="text-grijs">Elke ring staat voor een persoon uit het gezin.</span></span></figcaption>
          </figure>
          <figure class="rijs md:col-span-4 md:mt-24" style="--d:.08s">
            <Image src={statement} alt="Een gouden statement ring met drie vierkante stenen in lichtgroen, oranje en rood" quality={70} widths={[300, 450, 600]} sizes="(min-width: 768px) 30vw, 50vw" class="aspect-[3/4] w-full rounded-sm object-cover object-[50%_35%]" />
            <figcaption class="register"><span class="nr">536</span><span class="text-sm"><span class="font-bold">Statement ring.</span> <span class="text-grijs">Van het gouden horlogebandje van haar vader, met de steen van haar moeder.</span></span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-4" style="--d:.14s">
            <Image src={roos} alt="Een zilveren ring met een handgemaakte roos, tussen rode rozenknoppen" quality={70} widths={[300, 450, 600, 800]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_40%] md:aspect-[3/4]" />
            <figcaption class="register"><span class="nr">462</span><span class="text-sm"><span class="font-bold">Ring met roos.</span> <span class="text-grijs">Twee meeldraden, voor haar en haar echtgenoot.</span></span></figcaption>
          </figure>

          <figure class="rijs md:col-span-4">
            <Image src={dots} alt="Vier zilveren ringen van massieve bollen op een houten tafel" quality={70} widths={[300, 450, 600]} sizes="(min-width: 768px) 30vw, 50vw" class="aspect-square w-full rounded-sm object-cover" />
            <figcaption class="register"><span class="nr">473</span><span class="text-sm font-bold">Dots</span></figcaption>
          </figure>
          <figure class="rijs md:col-span-4" style="--d:.06s">
            <Image src={creolen} alt="Kleine zilveren creolen met een draadje goud op een roze pioenroos" quality={70} widths={[300, 450, 600]} sizes="(min-width: 768px) 30vw, 50vw" class="aspect-square w-full rounded-sm object-cover" />
            <figcaption class="register"><span class="nr">531</span><span class="text-sm font-bold">Creolen, eerst een ring</span></figcaption>
          </figure>
          <figure class="rijs col-span-2 md:col-span-4" style="--d:.12s">
            <Image src={roodborstjes} alt="Oorbellen met roodborstjes van geoxideerd zilver en druppels koraal, op herfstbladeren" quality={70} widths={[400, 600, 800, 1000]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_55%] md:aspect-square" />
            <figcaption class="register"><span class="nr">522</span><span class="text-sm font-bold">Roodborstjes oorbellen</span></figcaption>
          </figure>
        </div>

        <p class="rijs mt-14"><a href={site.blog} class="link inline-flex items-center gap-2 text-lg font-bold">Alle stukken op het blog <Icoon naam="pijl" class="h-5 w-5" /></a></p>
      </div>
    </section>

    <!-- 4. OUD GOUD: hergebruik, haar specialiteit -->
    <section id="oud-goud" class="bg-inkt py-20 text-wit md:py-32" aria-labelledby="goud-titel">
      <div class="wrap">
        <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-12">
          <h2 id="goud-titel" class="rijs text-3xl lg:col-span-6">Van goud dat al gedragen is</h2>
          <blockquote class="rijs max-w-xl self-end lg:col-span-6" style="--d:.08s">
            <p class="kop text-2xl leading-snug text-wit/90">"Het idee dat het goud eerder gedragen is door een dierbaar persoon blijft voelbaar."</p>
          </blockquote>
        </div>

        <div class="mt-14 grid gap-y-12 md:mt-20 md:grid-cols-12 md:gap-x-8">
          <figure class="rijs md:col-span-7">
            <Image src={omaMoeder} alt="Een brede gouden wikkelring met drie saffieren in verschillende kleuren, op een zandsteen" quality={72} widths={[480, 720, 960, 1200]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-auto md:h-[44rem]" />
            <figcaption class="register register-licht"><span class="nr">516</span><span class="text-mist">"Twee mooie stevige trouwringen van haar oma en moeder mocht ik veranderen tot een prachtig juweel. De graveringen die haar zo dierbaar waren kon ik intact houden."</span></figcaption>
          </figure>
          <div class="grid gap-y-12 md:col-span-5 md:content-start">
            <figure class="rijs" style="--d:.08s">
              <Image src={erfgoud} alt="Twee gladde gouden trouwringen, een stevige en een fijne, op een oude houten werkbank" quality={70} widths={[360, 540, 720]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[3/2] w-full rounded-sm object-cover object-[50%_55%]" />
              <figcaption class="register register-licht"><span class="nr">526</span><span class="text-sm text-mist">"Voor een jong stel maakte ik deze twee mooie simpele trouwringen van het goud van haar grootouders."</span></figcaption>
            </figure>
            <figure class="rijs" style="--d:.14s">
              <Image src={grillig} alt="Een grillige gouden ring in een zwart fluwelen ringdoosje" quality={70} widths={[360, 540, 720]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[3/2] w-full rounded-sm object-cover object-[50%_45%]" />
              <figcaption class="register register-licht"><span class="nr">528</span><span class="text-sm text-mist">"Gemaakt van het goud dat haar oma altijd droeg." Ze bleef erbij terwijl Lize het ter plekke omsmolt.</span></figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. ZO GAAT HET: op afspraak, samen kiezen, maken -->
    <section class="py-20 md:py-32" aria-labelledby="werkwijze-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 id="werkwijze-titel" class="rijs text-3xl">Zo ontstaat een ring</h2>
          <ol class="mt-10 border-b border-lijn">
            <li class="rijs grid grid-cols-[3.25rem_1fr] gap-x-3 border-t border-lijn py-6">
              <span class="kop text-3xl leading-none text-mos">1</span>
              <div><p class="text-lg font-bold">Eerst even appen</p><p class="mt-1 text-grijs">Het atelier is aan huis en geen winkel. Lize werkt alleen op afspraak.</p></div>
            </li>
            <li class="rijs grid grid-cols-[3.25rem_1fr] gap-x-3 border-t border-lijn py-6" style="--d:.06s">
              <span class="kop text-3xl leading-none text-mos">2</span>
              <div><p class="text-lg font-bold">Samen aan tafel</p><p class="mt-1 text-grijs">Hoeveel wikkelingen, hoe breed, welke dikte draad, welke steen. Met voorbeelden en zilveren ringen uit voorraad erbij.</p></div>
            </li>
            <li class="rijs grid grid-cols-[3.25rem_1fr] gap-x-3 border-t border-lijn py-6" style="--d:.12s">
              <span class="kop text-3xl leading-none text-mos">3</span>
              <div><p class="text-lg font-bold">Smelten, smeden, zetten</p><p class="mt-1 text-grijs">Jouw oude goud wordt nieuw draad of plaat. Een wikkelring krijgt pas tijdens het maken echt zijn vorm.</p></div>
            </li>
            <li class="rijs grid grid-cols-[3.25rem_1fr] gap-x-3 border-t border-lijn py-6" style="--d:.18s">
              <span class="kop text-3xl leading-none text-mos">4</span>
              <div><p class="text-lg font-bold">Met haar eigen teken</p><p class="mt-1 text-grijs">Lize slaat haar meesterteken in haar sieraden: de laatste letters van Idylliz, die samen een pijltje vormen.</p></div>
            </li>
          </ol>
        </div>
        <div class="grid grid-cols-2 gap-3 self-start md:gap-5 lg:col-span-6 lg:col-start-7">
          <figure class="rijs">
            <Image src={draad} alt="Vingers houden lange gedraaide draden van zilver en goud vast" quality={70} widths={[300, 450, 600]} sizes="(min-width: 1024px) 24vw, 50vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">Zilver en goud in elkaar gedraaid</figcaption>
          </figure>
          <figure class="rijs mt-16 md:mt-24" style="--d:.1s">
            <Image src={zetten} alt="Een brede zilveren ring met vijf glad gezette steentjes, vastgeklemd in een zetkogel" quality={70} widths={[300, 450, 600]} sizes="(min-width: 1024px) 24vw, 50vw" class="aspect-[3/4] w-full rounded-sm object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">Stenen glad zetten in de kogel</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 6. REVIEWS: letterlijk van Google -->
    <section id="reviews" class="bg-wit py-20 md:py-28" aria-labelledby="reviews-titel">
      <div class="wrap">
        <h2 id="reviews-titel" class="sr-only">Wat klanten zeggen</h2>
        <figure class="rijs mx-auto max-w-4xl text-center">
          <blockquote class="kop text-2xl leading-snug md:text-[2.15rem] md:leading-[1.3]">"{reviews.groot.tekst}"</blockquote>
          <figcaption class="mt-6 text-grijs">{reviews.groot.naam}, over hun trouwringen</figcaption>
        </figure>
        <div class="mt-16 grid gap-x-10 gap-y-10 border-t border-lijn pt-10 md:grid-cols-3">
          {[ilona, jacqueline, jansje].map((r, i) => (
            <figure class="rijs" style={`--d:${i * 0.06}s`}>
              <blockquote class="text-grijs">"{r.tekst}"</blockquote>
              <figcaption class="mt-4 font-bold">{r.naam}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-10 flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" /><a href={site.google.url} class="link">Alle reviews op Google</a></p>
      </div>
    </section>

    <!-- 7. AFSPRAAK: één zin, die een WhatsApp-bericht wordt -->
    <section id="afspraak" class="py-20 md:py-32" aria-labelledby="afspraak-titel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2 id="afspraak-titel" class="rijs text-3xl">Wat wil je laten maken?</h2>
          <p class="rijs mt-6 max-w-sm text-lg text-grijs">Kies in de zin wat past. Je krijgt een kant-en-klaar bericht in WhatsApp, Lize appt je terug voor een afspraak.</p>
          <div class="rijs mt-10 space-y-2 text-grijs">
            <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-1 h-5 w-5 flex-none text-mos" />Atelier aan de bosrand van Hilversum</p>
            <p class="flex items-start gap-3"><Icoon naam="klok" class="mt-1 h-5 w-5 flex-none text-mos" />Alleen op afspraak, er is een kleine wachttijd</p>
            <p class="flex items-start gap-3"><Icoon naam="tel" class="mt-1 h-5 w-5 flex-none text-mos" /><a href={site.telHref} class="link num">{site.tel}</a></p>
          </div>
        </div>

        <form class="zin rijs border-t-2 border-inkt pt-8 lg:col-span-7 lg:col-start-6" data-zin style="--d:.08s">
          <p class="kop text-2xl leading-[1.75] md:text-[2.1rem] md:leading-[1.7]">
            Ik heb{' '}
            <label class="sr-only" for="heb">Wat heb je al</label>
            <select id="heb" name="heb">{heb.map((o) => <option>{o}</option>)}</select>
            {' '}en wil daar graag{' '}
            <label class="sr-only" for="wil">Wat wil je laten maken</label>
            <select id="wil" name="wil">{wil.map((o) => <option>{o}</option>)}</select>
            {' '}van laten maken, het liefst in{' '}
            <label class="sr-only" for="van">Welk materiaal</label>
            <select id="van" name="van">{van.map((o) => <option>{o}</option>)}</select>.
          </p>
          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            <div>
              <label for="naam" class="text-sm font-bold">Je naam</label>
              <input id="naam" name="naam" class="veld" autocomplete="given-name" placeholder="Voornaam" />
            </div>
            <div>
              <label for="maat" class="text-sm font-bold">Ringmaat, als je die weet</label>
              <input id="maat" name="maat" class="veld" inputmode="decimal" placeholder="bijvoorbeeld 17,5" />
            </div>
          </div>
          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waHoi} class="knop" data-zin-knop><Icoon naam="wa" />Stuur naar Lize</a>
            <p class="text-sm text-grijs">Reparaties neemt Lize op dit moment niet aan.</p>
          </div>
          <p class="mt-8 rounded-sm bg-wit p-5 text-[.9375rem] leading-relaxed text-grijs" aria-live="polite" data-zin-voorbeeld></p>
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-zin]');
  const knop = f?.querySelector<HTMLAnchorElement>('[data-zin-knop]');
  const vb = f?.querySelector<HTMLElement>('[data-zin-voorbeeld]');
  if (f && knop && vb) {
    const basis = knop.href.split('?')[0];
    const maak = () => {
      const d = new FormData(f);
      const heb = String(d.get('heb'));
      const naam = String(d.get('naam') || '').trim();
      const maat = String(d.get('maat') || '').trim();
      const begin = heb.startsWith('nog niets') ? `ik heb nog niets, alleen een idee: ik wil graag ${d.get('wil')} laten maken` : `ik heb ${heb} en wil daar graag ${d.get('wil')} van laten maken`;
      const tekst = `Hallo Lize, ${begin}, het liefst in ${d.get('van')}.${maat ? ` Mijn ringmaat is ${maat}.` : ''} Wanneer zou ik langs kunnen komen in het atelier?${naam ? ` Groet, ${naam}` : ''}`;
      knop.href = `${basis}?text=${encodeURIComponent(tekst)}`;
      vb.textContent = tekst;
    };
    f.addEventListener('input', maak);
    f.addEventListener('change', maak);
    f.addEventListener('submit', (e) => e.preventDefault());
    maak();
  }
</script>
