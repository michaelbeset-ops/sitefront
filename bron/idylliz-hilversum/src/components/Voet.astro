---
import { site, url, waHoi } from '../data/site';
const jaar = new Date().getFullYear();
const lijst = ['Ringen en wikkelringen', 'Trouwringen', 'Oorbellen en hangers', 'Armbanden', 'Nieuw sieraad van oud goud', 'Eigen steen laten zetten'];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <p class="kop text-3xl leading-none text-wit">Idylliz</p>
      <p class="mt-5 max-w-xs">Handgesmede sieraden van zilver en goud. Lieflijk doch stoer. Van Lize Bouwman, edelsmid in Hilversum.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Laten maken</p>
      <ul class="mt-3 space-y-1">{lijst.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={waHoi} class="link link-licht">WhatsApp</a> (liefst)</p>
      <p class="mt-1"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-1"><a href={site.blog} class="link link-licht">Het blog met al het werk</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Atelier</p>
      <p class="mt-3">Aan de bosrand van Hilversum</p>
      <p class="mt-2">Alleen op afspraak</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Idylliz, Hilversum · KvK {site.kvk} · <a href={site.google.url} class="link link-licht">{site.google.score} op Google, {site.google.aantal} reviews</a></p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's, nummers en citaten komen van het eigen blog idylliz.blogspot.com. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
