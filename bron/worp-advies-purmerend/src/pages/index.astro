---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site, url, afspraakMail, vakken, klanten, sectoren } from '../data/site';
---
<Base title={`${site.bv} | Administratie, fiscaal en juridisch advies in Purmerend`} description="Administratie, belastingaangiften, salaris en juridisch advies voor ondernemers in Purmerend en omgeving. Een klein kantoor met een persoonlijke aanpak.">
  <div class="relative overflow-hidden bg-nacht text-wit">
    <!-- de schuine streep uit het logo, over het hele eerste scherm -->
    <svg class="pointer-events-none absolute inset-0 h-full w-full" preserveAspectRatio="none" viewBox="0 0 100 100" aria-hidden="true">
      <line x1="56" y1="104" x2="72" y2="-4" stroke="#26a9bb" stroke-width="2.4" vector-effect="non-scaling-stroke" class="hidden lg:block" />
      <line x1="64" y1="104" x2="100" y2="34" stroke="#26a9bb" stroke-width="2" vector-effect="non-scaling-stroke" class="lg:hidden" />
    </svg>
    <Chrome deel="kop" />
    <main id="inhoud" class="contents">
      <!-- 1. Ieder zijn vak: links het motto, rechts van de streep hun drie vakken -->
      <section class="wrap relative grid grid-cols-12 gap-x-6 pb-10 pt-8 md:pt-14 lg:min-h-[calc(100svh-7.4rem)] lg:pb-14">
        <div class="col-span-12 flex flex-col lg:col-span-7">
          <p class="text-salie">Administratie, fiscaal en juridisch advies <span class="text-streep">/</span> Purmerend</p>
          <h1 class="mt-5 text-[clamp(5rem,26vw,7rem)] leading-[.86] md:mt-6 md:text-[clamp(7rem,13.2vw,12.5rem)]">Ieder zijn <em class="text-streep">vak.</em></h1>
          <p class="mt-7 max-w-[31rem] text-lg leading-relaxed text-salie md:mt-10 md:text-[1.3rem]">Maximaal ondernemerschap betekent volgens ons dat u ruimte en tijd heeft om te doen waar u goed in bent. De rest besteedt u uit.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4 md:mt-10 lg:mt-auto lg:pt-10">
            <a href={afspraakMail} class="knop">Maak een vrijblijvende afspraak</a>
            <a href={site.telHref} class="lijn text-[1.05rem]">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
        </div>
        <div class="col-span-12 mt-12 flex flex-col justify-end lg:col-span-4 lg:col-start-9 lg:mt-0">
          <ul class="serif text-[2.4rem] italic leading-[1.15] md:text-[3.3rem]">
            {vakken.map((v) => <li><a href={url(`#${v.id}`)} class="no-underline transition-colors hover:text-streep">{v.naam}</a></li>)}
          </ul>
          <p class="mt-6 max-w-xs text-sm text-salie">Meer dan 20 jaar ervaring in de financiële wereld, met een klein team specialisten.</p>
        </div>
      </section>
    </main>
  </div>

  <!-- 2. Wie kiezen voor Worp: hun eigen vijf punten, groot gezet -->
  <section class="py-20 md:py-28" aria-labelledby="wie-kop">
    <div class="wrap grid grid-cols-12 gap-x-6 gap-y-10">
      <h2 id="wie-kop" class="col-span-12 text-2xl lg:col-span-4">Wie worden klant bij ons?</h2>
      <ol class="col-span-12 lg:col-span-8">
        {klanten.map((k, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] items-baseline border-t border-lijn py-5 md:grid-cols-[4rem_1fr] md:py-6">
            <span class="serif text-xl italic text-streep-tekst">{i + 1}</span>
            <p class="serif text-[1.65rem] leading-[1.15] md:text-[2.3rem]"><span class="text-grijs">Ondernemers die</span> {k}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. De vakken als grootboek: links het vak, rechts per regel wat we doen -->
  <section class="border-t border-lijn bg-wit py-20 md:py-28" aria-labelledby="vak-kop">
    <div class="wrap">
      <div class="grid grid-cols-12 gap-x-6 gap-y-6">
        <h2 id="vak-kop" class="col-span-12 text-2xl lg:col-span-6">Wat we voor u doen.</h2>
        <p class="col-span-12 max-w-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-3">Opdrachten buiten ons vak nemen we niet aan. Dan verwijzen we u door naar een adviseur die daar écht in thuis is.</p>
      </div>
      <div class="mt-14 border-b-2 border-inkt md:mt-20">
        {vakken.map((v) => (
          <div id={v.id} class="grid scroll-mt-6 grid-cols-12 gap-x-6 border-t-2 border-inkt py-8 md:py-10">
            <h3 class="col-span-12 text-xl md:col-span-4">{v.naam}<span class="text-streep-tekst">/</span></h3>
            <dl class="col-span-12 mt-4 md:col-span-8 md:mt-0">
              {v.regels.map(([t, d], i) => (
                <div class:list={['grid gap-1 py-3 md:grid-cols-[15rem_1fr] md:gap-6', i > 0 && 'border-t border-lijn']}>
                  <dt class="font-medium">{t}</dt><dd class="text-grijs">{d}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-4xl text-grijs"><span class="text-inkt">Onder onze klanten:</span> {sectoren.map((s, i) => <Fragment><span class="whitespace-nowrap">{s}</span>{i < sectoren.length - 1 && <span class="text-streep-tekst"> / </span>}</Fragment>)}</p>
    </div>
  </section>

  <!-- 4. Contact -->
  <section id="contact" class="py-20 md:py-28" aria-labelledby="contact-kop">
    <div class="wrap grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 lg:col-span-7">
        <h2 id="contact-kop" class="text-2xl">Een mens aan de telefoon.</h2>
        <p class="mt-8"><a href={site.telHref} class="serif text-[clamp(2.8rem,6vw,5.4rem)] leading-none tabular-nums no-underline transition-colors hover:text-streep-tekst">{site.tel}</a></p>
        <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={afspraakMail} class="knop !bg-nacht !text-wit hover:!bg-streep-tekst">Afspraak per mail</a>
          <a href={afspraakMail} class="lijn">{site.mail}</a>
        </div>
      </div>
      <div class="col-span-12 border-t border-lijn pt-6 lg:col-span-4 lg:col-start-9 lg:border-t-0 lg:pt-3">
        <p class="text-lg">{site.bv}<br />{site.straat}<br />{site.postcode} {site.plaats}</p>
        <p class="mt-3"><a href={site.maps} class="lijn">Route in Google Maps</a></p>
        <p class="mt-6 text-sm text-grijs">Ook particulieren helpen we graag, bijvoorbeeld met de aangifte inkomstenbelasting.</p>
      </div>
    </div>
  </section>
  <Chrome deel="voet" />
</Base>
