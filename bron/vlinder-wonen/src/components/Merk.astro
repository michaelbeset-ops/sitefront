---
// Woordmerk naar hun logo: blauwe vlinder + "Vlinder Wonen" met hun eigen regel "Vrede in vorm en kleur" (Google-foto van eigenaar).
import { url } from '../data/site';
import Vlinder from './Vlinder.astro';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <Vlinder class={`h-9 w-9 flex-none sm:h-10 sm:w-10 ${donker ? 'text-merk' : 'text-merk-licht'}`} />
  <span class="flex flex-col">
    <span class="font-kop text-[1.35rem] font-black leading-none tracking-[-.03em] sm:text-[1.55rem]">Vlinder Wonen</span>
    <span class={`mt-1 text-[.7rem] font-medium leading-none tracking-[.06em] sm:text-[.75rem] ${donker ? 'text-steen' : 'text-mist'}`}>Vrede in vorm en kleur</span>
  </span>
</a>
