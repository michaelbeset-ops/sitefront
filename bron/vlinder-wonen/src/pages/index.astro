---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Vlinder from '../components/Vlinder.astro';
import { site, reviews, waHoi, waMet, tijden, dagNamen, uur } from '../data/site';

// Hero, raamdecoratie en trap: Unsplash-sfeerfoto's (ter illustratie). De rest komt van hun eigen Google-profiel.
// Zie src/assets/BRONNEN.txt.
import hero from '../assets/hero.jpg';
import heroM from '../assets/hero-m.jpg';
import pand from '../assets/pand.jpg';
import cBedden from '../assets/c-bedden.jpg';
import cBanken from '../assets/c-banken.jpg';
import cTafels from '../assets/c-tafels.jpg';
import cKasten from '../assets/c-kasten.jpg';
import cVloeren from '../assets/c-vloeren.jpg';
import cRaam from '../assets/c-raam.jpg';
import cTapijt from '../assets/c-tapijt.jpg';
import cTrap from '../assets/c-trap.jpg';
import bGroot from '../assets/b-groot.jpg';
import bRoze from '../assets/b-roze.jpg';
import bZwart from '../assets/b-zwart.jpg';
import sHal from '../assets/s-hal.jpg';
import sBedden from '../assets/s-bedden.jpg';
import sHoek from '../assets/s-hoek.jpg';
import sLaminaat from '../assets/s-laminaat.jpg';

const hd = await getImage({ src: hero, widths: [960, 1400, 2000, 2400], format: 'webp', quality: 64 });
const hm = await getImage({ src: heroM, widths: [480, 780, 900], format: 'webp', quality: 62 });
const vraag = (wat: string) => waMet(`Hallo Vlinder Wonen, ik heb een vraag over ${wat}.`);

// Assortiment: alleen wat in hun eigen bronnen staat (oude site, Instagram, Google).
const assortiment = [
  { t: 'Bedden en boxsprings', d: 'Boxsprings, ook met opbergruimte, en matrassen.', src: cBedden, alt: 'Grijze boxspring met hoog hoofdbord in een lichte slaapkamer', wa: 'een bed of boxspring', sfeer: false },
  { t: 'Banken', d: 'Hoekbanken, ook met slaapfunctie of opbergruimte.', src: cBanken, alt: 'Beige velours hoekbank op een vloerkleed in de winkel', wa: 'een bank of hoekbank', sfeer: false },
  { t: 'Tafels en stoelen', d: 'Eet-, salon-, bijzet- en countertafels, en stoelen.', src: cTafels, alt: 'Cognac barstoel met zwart onderstel', wa: 'tafels of stoelen', sfeer: false },
  { t: 'Kasten en opberging', d: 'Kasten en meubels om netjes op te bergen.', src: cKasten, alt: 'Wandtafel van hout en zwart staal met opbergboxen', wa: 'een kast', sfeer: false },
  { t: 'Laminaat en PVC', d: 'Laminaat en PVC-vloeren, uit te zoeken in de winkel.', src: cVloeren, alt: 'Lichte vloer in visgraat in een woonkamer', wa: 'een vloer', sfeer: false },
  { t: 'Raamdecoratie', d: 'Gordijnen, plissé en lamellen.', src: cRaam, alt: '', wa: 'raamdecoratie', sfeer: true },
  { t: 'Tapijten en vloerkleden', d: 'Van moderne designs tot warme, zachte kleden.', src: cTapijt, alt: 'Wand met vloerkleden en stalen laminaat in de winkel', wa: 'een tapijt of vloerkleed', sfeer: false },
  { t: 'Traprenovatie', d: 'Een strakke, moderne trap, zoals jij hem wilt.', src: cTrap, alt: '', wa: 'traprenovatie', sfeer: true },
];

// Uit hun Instagram-berichten.
const matrassen = ['Bambi', 'Kapok Naturel', 'Sleepure', 'Magnasand Therapy', 'Marsella Bedding'];

// Uit de uitleg op hun oude website (archief jan 2026) en reviews.
const slaap = [
  ['Pocketvering', 'Veren in losse zakjes. Je merkt minder van elkaars bewegingen.'],
  ['Visco traagschuim', 'Vormt zich naar lichaamswarmte en gewicht.'],
  ['Opbergruimte', 'Boxsprings met ruimte onder het bed.'],
];

const stappen = [
  ['Kom langs of app', 'Kijk rond in de winkel, of stuur eerst je vraag of een foto via WhatsApp.'],
  ['Rustig kiezen', 'Klanten noemen het advies eerlijk en deskundig. Neem er gerust de tijd voor.'],
  ['Levertijd afspreken', 'Samen spreek je af wanneer het komt. Een deel is direct leverbaar.'],
  ['Bezorgen of ophalen', 'Laat het thuis bezorgen, of haal het zelf op in de winkel.'],
];

// Woonwens: per soort een eigen vraag. Alleen om het bericht te vullen.
const wensen = [
  { id: 'Bed of boxspring', vraag: 'Maat', opties: ['90 x 200', '140 x 200', '160 x 200', '180 x 200', 'Weet ik nog niet'] },
  { id: 'Matras', vraag: 'Maat', opties: ['90 x 200', '140 x 200', '160 x 200', '180 x 200', 'Weet ik nog niet'] },
  { id: 'Bank', vraag: 'Soort', opties: ['Hoekbank', 'Hoekbank met slaapfunctie', 'Met opbergruimte', 'Rechte bank'] },
  { id: 'Tafel of stoelen', vraag: 'Soort', opties: ['Eettafel', 'Salontafel', 'Bijzettafel', 'Stoelen'] },
  { id: 'Vloer', vraag: 'Soort', opties: ['Laminaat', 'PVC', 'Weet ik nog niet'] },
  { id: 'Raamdecoratie', vraag: 'Soort', opties: ['Gordijnen', 'Plissé', 'Lamellen'] },
  { id: 'Tapijt', vraag: 'Plek', opties: ['Woonkamer', 'Slaapkamer', 'Anders'] },
  { id: 'Trap', vraag: 'Wens', opties: ['Trap renoveren', 'Eerst advies'] },
];
const sterren = [1, 2, 3, 4, 5];
const volgorde = [1, 2, 3, 4, 5, 6, 0];
---
<Base title="Vlinder Wonen | Meubelwinkel in Spijkenisse, alles voor thuis" description="Vlinder Wonen aan de Breestoep in Spijkenisse: bedden en boxsprings, banken, tafels, kasten, laminaat en PVC, raamdecoratie, tapijten en traprenovatie. Bezorgen of zelf ophalen. 5,0 op Google.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: Unsplash-sfeerfoto van een boxspring met blauw hoofdbord, nachtblauw verloop -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <picture>
        <source media="(max-width: 767px)" srcset={hm.srcSet.attribute} sizes="100vw" />
        <source media="(min-width: 768px)" srcset={hd.srcSet.attribute} sizes="100vw" />
        <img src={hd.src} alt="" width="2400" height="1800" loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_100%] md:object-[50%_62%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c1324cc_0%,#0c132433_16%,#0c13248c_38%,#0c1324e6_60%,#0c1324_100%)] md:bg-[linear-gradient(90deg,#0c1324f5_0%,#0c1324c4_36%,#0c132440_70%,#0c13241a_100%),linear-gradient(180deg,#0c1324b3_0%,#0c132400_30%,#0c132400_70%,#0c1324cc_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-32 pt-44 md:pb-20 lg:pt-48">
        <div class="max-w-3xl">
          <p class="eyebrow eyebrow-licht">Meubelwinkel in {site.plaats}</p>
          <h1 id="inhoud" class="mt-6 text-hero">Alles voor <span class="text-merk-licht">thuis.</span><br />Onder één dak.</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-wit/90 md:text-[1.3rem]">Bedden en boxsprings, banken, tafels, vloeren, gordijnen en tapijten. Kom kijken aan de Breestoep, of stuur een appje.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#woonwens" class="knop knop-merk">Stel je woonwens samen<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.95rem] text-wit/90">
            <li class="flex items-center gap-2"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-wit">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-merk-licht" /><span data-status>Di t/m za open vanaf 10.00 uur</span></li>
            <li class="flex items-center gap-2"><Icoon naam="pakje" class="h-4 w-4 text-merk-licht" />Bezorgen of zelf ophalen</li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-7 right-10 hidden text-xs text-wit/60 lg:block">Sfeerfoto ter illustratie</p>
    </section>
  </div>

  <main>
    <!-- 2. Chips: alles onder één dak -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="Onder één dak">
      <div class="wrap flex flex-col gap-5 py-9 lg:flex-row lg:items-center lg:gap-10">
        <p class="shrink-0 font-kop text-xl font-black tracking-[-.02em]">Onder één dak</p>
        <ul class="flex flex-wrap gap-2.5">
          {assortiment.map((a) => <li><a href="#assortiment" class="chip transition-colors hover:border-merk">{a.t}</a></li>)}
        </ul>
      </div>
    </section>

    <!-- 3. Assortiment: fotokaarten -->
    <section id="assortiment" class="py-24 md:py-32" aria-labelledby="t-ass">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Assortiment</p>
            <h2 id="t-ass" class="mt-5 text-4xl">Van bed tot vloer.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Meubels, vloeren en raamdecoratie in één winkel. Tik op een soort en stel je vraag direct via WhatsApp.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-5">
          {assortiment.map((c, i) => (
            <li class="rijs" style={`--d:${(i % 4) * 0.05}s`}>
              <a href={vraag(c.wa)} class="group relative isolate flex aspect-[5/4] flex-col justify-end sm:aspect-[4/5] overflow-hidden rounded-[18px] bg-inkt p-6 text-wit no-underline">
                <Image src={c.src} alt={c.alt} widths={[360, 560, 760]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 46vw, 100vw" quality={70} class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]" />
                <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c132400_30%,#0c1324b8_62%,#0c1324f2_100%)]" aria-hidden="true"></span>
                {c.sfeer && <span class="absolute right-4 top-4 rounded-full bg-inkt/70 px-2.5 py-1 text-[.7rem] text-wit/80">Sfeerfoto</span>}
                <h3 class="text-[1.55rem]">{c.t}</h3>
                <p class="mt-2 text-[.98rem] leading-snug text-wit/85">{c.d}</p>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-merk-licht">Vraag ernaar<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Bedden (donker): waar de meeste reviews over gaan -->
    <section id="bedden" class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-bed">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Slaapkamer</p>
          <h2 id="t-bed" class="rijs mt-5 text-4xl">Goed slapen begint bij het <span class="text-merk-licht">bed.</span></h2>
          <p class="rijs mt-7 max-w-lg text-lg leading-relaxed text-wit/85">De meeste reviews gaan over bedden. In de winkel staan boxsprings met en zonder opbergruimte, waaronder de bedden van Bambi.</p>
          <ul class="rijs mt-10 grid gap-4 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3" style="--d:.06s">
            {slaap.map(([t, d]) => (
              <li class="rounded-[16px] border border-lijn bg-inkt-2 p-5">
                <Vlinder class="h-6 w-6 text-merk-licht" />
                <p class="mt-4 font-kop text-xl font-black tracking-[-.02em]">{t}</p>
                <p class="mt-1.5 text-[.95rem] leading-snug text-mist">{d}</p>
              </li>
            ))}
          </ul>
          <div class="rijs mt-10" style="--d:.1s">
            <p class="text-sm font-bold text-mist">Matrassen en merken uit de winkel</p>
            <ul class="mt-4 flex flex-wrap gap-2.5">{matrassen.map((m) => <li class="chip chip-donker">{m}</li>)}</ul>
          </div>
          <figure class="rijs mt-12 border-l-2 border-merk-licht pl-6" style="--d:.12s">
            <blockquote class="font-kop text-2xl font-black leading-tight tracking-[-.025em]">“Zowel het comfort als de afwerking zijn uitstekend.”</blockquote>
            <figcaption class="mt-3 text-sm text-mist">Feden T., Google review</figcaption>
          </figure>
        </div>
        <div class="relative lg:col-span-6">
          <div class="rijs poort mx-auto aspect-square w-full max-w-[34rem]" style="--poortrand:#8db5ff26">
            <Image src={bGroot} alt="Boxspring met gecapitonneerd hoofdbord in een lichte slaapkamer" widths={[480, 760, 1100]} sizes="(min-width: 1024px) 540px, 92vw" quality={72} class="h-full w-full object-cover" />
          </div>
          <div class="mt-5 grid grid-cols-2 gap-4 lg:-mt-16 lg:pl-6">
            <Image src={bRoze} alt="Roze boxspring met hoofdbord in een kinderkamer" widths={[320, 520]} sizes="(min-width: 1024px) 260px, 46vw" quality={70} class="rijs aspect-[4/3] w-full rounded-[16px] object-cover ring-4 ring-inkt" />
            <Image src={bZwart} alt="Boxspring met golvend hoofdbord en nachtkastjes" widths={[320, 520]} sizes="(min-width: 1024px) 260px, 46vw" quality={70} class="rijs aspect-[4/3] w-full rounded-[16px] object-cover ring-4 ring-inkt" style="--d:.06s" />
          </div>
          <a href={vraag('een bed of boxspring')} class="knop knop-merk mt-8 lg:ml-6"><Icoon naam="wa" />Vraag naar bedden</a>
        </div>
      </div>
    </section>

    <!-- 5. De winkel: eigen foto's -->
    <section id="winkel" class="py-24 md:py-32" aria-labelledby="t-winkel">
      <div class="wrap">
        <div class="grid gap-y-12 lg:grid-cols-12 lg:items-center lg:gap-x-14">
          <div class="rijs lg:col-span-5">
            <div class="poort mx-auto aspect-square w-full max-w-[28rem]" style="--poortrand:#2456c41f">
              <Image src={pand} alt="De winkel van Vlinder Wonen onder het grote ronde raam aan de Breestoep" widths={[440, 700, 960]} sizes="(min-width: 1024px) 440px, 90vw" quality={72} class="h-full w-full object-cover object-[45%_50%]" />
            </div>
          </div>
          <div class="lg:col-span-7">
            <p class="rijs eyebrow">De winkel</p>
            <h2 id="t-winkel" class="rijs mt-5 text-4xl">Kom kijken aan de Breestoep.</h2>
            <p class="rijs mt-7 max-w-xl text-lg leading-relaxed text-steen">Je vindt ons onder het grote ronde raam in {site.centrum}. Banken, bedden, vloeren en tapijten staan er naast elkaar, dus je ziet meteen wat bij elkaar past.</p>
            <figure class="rijs mt-8 max-w-xl rounded-[16px] bg-wit p-6 shadow-[0_1px_2px_#0c13240d]" style="--d:.06s">
              <blockquote class="text-lg leading-relaxed">“Door de mooie etalage uitgenodigd om naar binnen te gaan door de verkoper prima geholpen.”</blockquote>
              <figcaption class="mt-3 text-sm text-steen">Jan Kees D., Google review</figcaption>
            </figure>
            <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.1s">
              <a href={site.route} class="knop knop-merk"><Icoon naam="pin" />Route plannen</a>
              <a href="#contact" class="knop knop-rand">Openingstijden</a>
            </div>
          </div>
        </div>

        <div class="mt-16 grid grid-cols-2 gap-4 lg:mt-24 lg:grid-cols-4 lg:gap-5">
          <Image src={sHal} alt="Banken en boxsprings in de winkel, met een rond raam op de achtergrond" widths={[360, 560, 760]} sizes="(min-width: 1024px) 300px, 50vw" quality={70} class="rijs aspect-[4/3] w-full rounded-[18px] object-cover" />
          <Image src={sBedden} alt="Rij boxsprings voor een rond raam" widths={[360, 560, 760]} sizes="(min-width: 1024px) 300px, 50vw" quality={70} class="rijs aspect-[4/3] w-full rounded-[18px] object-cover" style="--d:.05s" />
          <Image src={sLaminaat} alt="Stalen laminaat en een wand met vloerkleden" widths={[360, 560, 760]} sizes="(min-width: 1024px) 300px, 50vw" quality={70} class="rijs aspect-[4/3] w-full rounded-[18px] object-cover" style="--d:.1s" />
          <Image src={sHoek} alt="Lichte hoekbank voor een wand met boxsprings" widths={[360, 560, 760]} sizes="(min-width: 1024px) 300px, 50vw" quality={70} class="rijs aspect-[4/3] w-full rounded-[18px] object-cover" style="--d:.15s" />
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section class="border-y border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="rijs max-w-2xl">
          <p class="eyebrow">Zo gaat het</p>
          <h2 id="t-werk" class="mt-5 text-4xl">Van idee tot thuis.</h2>
        </div>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
          {stappen.map(([t, d], i) => (
            <li class="rijs flex flex-col rounded-[18px] bg-linnen p-7" style={`--d:${i * 0.06}s`}>
              <span class="grid h-14 w-14 place-items-center rounded-full bg-merk font-kop text-xl font-black text-wit num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-7 text-2xl">{t}</h3>
              <p class="mt-3 text-steen">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Wow: woonwens samenstellen, met live WhatsApp-voorbeeld -->
    <section id="woonwens" class="bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-wens">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow eyebrow-licht">Woonwens</p>
            <h2 id="t-wens" class="mt-5 text-4xl">Stel je vraag in een halve minuut.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-mist lg:col-span-5 lg:col-start-8 lg:self-end" style="--d:.1s">Kies wat je zoekt en vul aan wat je weet. Rechts zie je je bericht, dat daarna klaarstaat in WhatsApp.</p>
        </div>

        <form class="mt-12 grid gap-x-12 gap-y-12 md:mt-16 lg:grid-cols-12" data-wens data-wensen={JSON.stringify(wensen)}>
          <div class="space-y-9 lg:col-span-7">
            <fieldset>
              <legend class="veld-label">Wat zoek je?</legend>
              <div class="flex flex-wrap gap-2.5">
                {wensen.map((w, i) => <label class="keuze"><input type="radio" name="soort" value={w.id} checked={i === 0} />{w.id}</label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label" data-vraag>Maat</legend>
              <div class="flex flex-wrap gap-2.5" data-opties></div>
            </fieldset>
            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label for="kleur" class="veld-label">Kleur of stijl (mag leeg)</label>
                <input id="kleur" name="kleur" class="veld" placeholder="bv. lichtgrijs, velvet" />
              </div>
              <div>
                <label for="naam" class="veld-label">Je naam (mag leeg)</label>
                <input id="naam" name="naam" class="veld" autocomplete="given-name" />
              </div>
            </div>
            <div class="grid gap-7 sm:grid-cols-2">
              <fieldset>
                <legend class="veld-label">Liefst</legend>
                <div class="flex flex-wrap gap-2.5">
                  {['Bezorgen', 'Zelf ophalen', 'Weet ik nog niet'].map((r, i) => <label class="keuze"><input type="radio" name="levering" value={r} checked={i === 2} />{r}</label>)}
                </div>
              </fieldset>
              <div>
                <label for="dag" class="veld-label">Langskomen op</label>
                <select id="dag" name="dag" class="veld">
                  <option value="">Nog niet</option>
                  {[2, 3, 4, 5, 6].map((d) => <option value={dagNamen[d].toLowerCase()}>{dagNamen[d]}</option>)}
                </select>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-8">
              <div class="overflow-hidden rounded-[22px] border border-lijn bg-[#0b141a]">
                <div class="flex items-center gap-3 bg-[#1f2c34] px-4 py-3">
                  <span class="grid h-10 w-10 place-items-center rounded-full bg-inkt"><Vlinder class="h-6 w-6 text-merk-licht" /></span>
                  <span class="leading-tight"><b class="block text-[.98rem]">Vlinder Wonen</b><span class="text-xs text-mist num">{site.tel}</span></span>
                </div>
                <div class="min-h-[15rem] bg-[#0b141a] bg-[radial-gradient(#ffffff08_1px,transparent_1px)] bg-[length:14px_14px] p-4 sm:p-5">
                  <p class="bel ml-auto max-w-[92%] rounded-[14px_14px_4px_14px]" data-voorbeeld aria-live="polite"></p>
                </div>
              </div>
              <a href={waHoi} class="knop knop-merk mt-5 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <p class="mt-3 text-center text-xs text-mist">Er gaat pas iets weg als je het zelf in WhatsApp verstuurt. Een foto van je kamer mag erbij.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start rounded-[16px] px-5 py-4 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-9 w-9 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="font-kop text-2xl font-black leading-none">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-sm text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="kaart flex h-full flex-col rounded-[18px] p-7">
                <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
                <blockquote class="mt-5 flex-1 leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5 text-sm">
                  <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-merk/10 font-bold text-merk">{r.naam[0]}</span>
                  <span><b class="block font-bold">{r.naam}</b><span class="text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. Openingstijden en contact (donker) -->
    <section id="contact" class="bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-contact">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="min-w-0 lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Contact</p>
          <h2 id="t-contact" class="rijs mt-5 text-3xl sm:text-4xl">Langskomen of appen.</h2>
          <p class="rijs mt-8"><a href={site.telHref} class="num font-kop text-[clamp(2.1rem,4.6vw,3.8rem)] font-black leading-none tracking-[-.045em] text-wit no-underline transition-colors hover:text-merk-licht">{site.tel}</a></p>
          <p class="rijs mt-3 text-mist">Bellen of WhatsApp, voor een vraag over een bed, bank, vloer of iets anders.</p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.08s">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.route} class="knop knop-wit"><Icoon naam="pin" />Route plannen</a>
          </div>
          <div class="rijs mt-10 flex items-start gap-4" style="--d:.12s">
            <Icoon naam="pin" class="mt-1 h-5 w-5 flex-none text-merk-licht" />
            <p><b class="font-bold">{site.naam}</b><br /><span class="text-mist">{site.straat}, {site.postcode} {site.plaats}<br />In {site.centrum}</span></p>
          </div>
          <p class="rijs mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-mist" style="--d:.14s">
            <a href={site.instagram} class="link">Instagram @vlinderwonen</a><a href={site.facebook} class="link">Facebook</a>
          </p>
        </div>
        <div class="rijs min-w-0 lg:col-span-6" style="--d:.08s">
          <div class="overflow-hidden rounded-[18px] border border-lijn bg-inkt-2">
            <div class="flex items-center justify-between gap-4 border-b border-lijn px-4 py-5 sm:px-6">
              <p class="font-kop text-xl font-black tracking-[-.02em]">Openingstijden</p>
              <p class="flex items-center gap-2 text-sm font-bold" data-status-kort><span class="h-2.5 w-2.5 rounded-full bg-mist" data-stip></span><span>Openingstijden</span></p>
            </div>
            <table class="w-full text-left">
              <tbody>
                {volgorde.map((d) => (
                  <tr class="border-b border-lijn last:border-0" data-dag={d}>
                    <th scope="row" class="py-3.5 pl-4 pr-2 font-medium sm:px-6">{dagNamen[d]}</th>
                    <td class={`num py-3.5 pl-2 pr-4 text-right sm:px-6 ${tijden[d] ? 'text-wit' : 'text-mist'}`}>{tijden[d] ? `${uur(tijden[d]![0])} tot ${uur(tijden[d]![1])} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-sm text-mist">Donderdag koopavond tot 20.00 uur.</p>
        </div>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-merk text-wit" aria-label="Vraag stellen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center md:py-14">
        <p class="font-kop text-3xl font-black leading-none tracking-[-.035em]">Twijfel je tussen twee modellen? App even.</p>
        <a href={waHoi} class="knop knop-inkt shrink-0"><Icoon naam="wa" />WhatsApp</a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site, tijden, uur as fmt } from '../data/site';

  // Live status volgens de Google-tijden.
  const nu = new Date();
  const dag = nu.getDay();
  const u = nu.getHours() + nu.getMinutes() / 60;
  const t0 = tijden[dag];
  const open = !!t0 && u >= t0[0] && u < t0[1];
  const s = document.querySelector('[data-status]');
  const sk = document.querySelector('[data-status-kort] span:last-child');
  const stip = document.querySelector<HTMLElement>('[data-stip]');
  const rij = document.querySelector<HTMLElement>(`[data-dag="${dag}"]`);
  if (rij) { rij.classList.add('bg-inkt-3'); rij.querySelector('th')?.classList.add('font-bold'); }
  let t = 'Nu gesloten';
  if (open && t0) t = `Nu open, tot ${fmt(t0[1])} uur`;
  else if (t0 && u < t0[0]) t = `Vandaag open vanaf ${fmt(t0[0])} uur`;
  if (s && (open || (t0 && u < t0[0]))) s.textContent = t;
  if (sk) sk.textContent = t;
  if (stip) stip.style.background = open ? '#3fbf7f' : '#a7b0c4';

  // Woonwens
  type Wens = { id: string; vraag: string; opties: string[] };
  const f = document.querySelector<HTMLFormElement>('[data-wens]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const optBox = document.querySelector<HTMLElement>('[data-opties]');
  const vraagEl = document.querySelector<HTMLElement>('[data-vraag]');
  if (f && vb && knop && optBox && vraagEl) {
    const wensen = JSON.parse(f.dataset.wensen || '[]') as Wens[];
    let vorige = '';
    const zet = () => {
      const d = new FormData(f);
      const w = wensen.find((x) => x.id === d.get('soort')) || wensen[0];
      if (w.id !== vorige) {
        vraagEl.textContent = w.vraag;
        optBox.innerHTML = '';
        w.opties.forEach((o, i) => {
          const l = document.createElement('label'); l.className = 'keuze';
          const inp = document.createElement('input'); inp.type = 'radio'; inp.name = 'optie'; inp.value = o; inp.checked = i === 0;
          l.append(inp, o); optBox.append(l);
        });
        vorige = w.id;
      }
      const d2 = new FormData(f);
      const optie = String(d2.get('optie') || '');
      const kleur = String(d2.get('kleur') || '').trim();
      const naam = String(d2.get('naam') || '').trim();
      const lev = String(d2.get('levering'));
      const dg = String(d2.get('dag') || '');
      const r = [`Hallo Vlinder Wonen${naam ? `, met ${naam}` : ''}.`];
      r.push(`Ik zoek: ${w.id.toLowerCase()}.`);
      if (optie && !/weet ik nog niet/i.test(optie)) r.push(`${w.vraag}: ${optie.toLowerCase()}.`);
      if (kleur) r.push(`Kleur of stijl: ${kleur}.`);
      if (lev === 'Bezorgen') r.push('Ik wil het graag laten bezorgen.');
      if (lev === 'Zelf ophalen') r.push('Ik haal het zelf op.');
      if (dg) r.push(`Ik kom graag ${dg} kijken in de winkel.`);
      r.push('Kunnen jullie me verder helpen?');
      const tekst = r.join('\n');
      vb.textContent = tekst;
      knop.href = `${site.wa}?text=${encodeURIComponent(tekst)}`;
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
