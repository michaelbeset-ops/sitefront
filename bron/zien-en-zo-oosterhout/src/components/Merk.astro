---
// Nagezet naar hun logo (bron/site/img/logo-nieuw-1.png): wit vierkant met twee schuine balken en een blokje,
// "zien & zo" in een stevige schreef, daaronder "van der Heijden" gespatieerd.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
const binnen = donker ? '#ffffff' : '#141312';
---
<a href={url('')} class={`inline-flex items-center gap-3 leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <svg viewBox="0 0 40 40" class="h-11 w-11 flex-none sm:h-12 sm:w-12" aria-hidden="true">
    <rect width="40" height="40" fill="currentColor" />
    <path d="M6 29 L18 10 H24 L12 29 Z M16.5 29 L28.5 10 H34.5 L22.5 29 Z" fill={binnen} />
    <rect x="27.5" y="24" width="6" height="5" fill={binnen} />
  </svg>
  <span class="flex flex-col">
    <span class="text-[1.6rem] font-[600] tracking-[-.01em] sm:text-[1.8rem]" style="font-family: var(--font-kop)">zien &amp; zo</span>
    <span class="mt-1 text-[.8rem] font-[400] tracking-[.14em] sm:text-[.9rem]">van der Heijden</span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>
