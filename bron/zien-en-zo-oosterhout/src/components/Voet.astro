---
import { site, url, waHoi, tijden, uur } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const diensten = ['Oogmeting en bril-check', 'Brillen en monturen', 'Brillenglazen en multifocaal', 'Contactlenzen', 'Kinderogen en myopie', 'Zonnebrillen op sterkte'];
---
<footer class="bg-inkt text-mist">
  <div class="streep opacity-80" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1.0625rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Uw particuliere opticien sinds 1956, aan de {site.adres} in {site.plaats}.</p>
      <a href={site.telHref} class="knop knop-merk num mt-7 min-h-12 px-5"><Icoon naam="tel" />{site.tel}</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-wit">Diensten</p>
      <ul class="mt-5 space-y-2.5">
        {diensten.map((t) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-merk">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <ul class="mt-5 space-y-2.5">
        <li>{site.adres}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.telHref} class="num no-underline hover:text-merk">{site.tel}</a></li>
        <li><a href={waHoi} class="num no-underline hover:text-merk">WhatsApp {site.mobiel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-merk">{site.mail}</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-wit">Open</p>
      <ul class="num mt-5 space-y-1.5">
        {tijden.filter((t) => t.nr !== 0).map((t) => <li class="flex justify-between gap-4"><span class="capitalize">{t.kort}</span><span class={t.open ? 'text-wit' : ''}>{t.open ? `${uur(t.open[0])}-${uur(t.open[1])}` : 'gesloten'}</span></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Teksten, logo en beeld van jullie website vanderheijden-opticiens.nl en jullie Google-profiel. Reviews letterlijk van Google (stand 12 oktober 2026).</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
