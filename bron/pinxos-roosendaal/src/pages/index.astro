---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, tijden, hm, waFeest } from '../data/site';

import heroD from '../assets/hero.jpg';
import heroM from '../assets/hero-m.jpg';
import rBask from '../assets/r-baskenland.jpg';
import rSev from '../assets/r-sevilla.jpg';
import rLat from '../assets/r-latijns.jpg';
import vitrine from '../assets/vitrine.jpg';
import plankPintxos from '../assets/plank-pintxos.jpg';
import paella from '../assets/paella.jpg';
import paraplu from '../assets/paraplu.jpg';
import steeg from '../assets/steeg.jpg';
import tuin from '../assets/tuin.jpg';
import schuur from '../assets/schuur.jpg';
import bar from '../assets/bar.jpg';
import neon from '../assets/neon.jpg';
import wegwijzers from '../assets/wegwijzers.jpg';

const hd = await getImage({ src: heroD, widths: [960, 1280, 1600], format: 'webp', quality: 72 });
const hmImg = await getImage({ src: heroM, widths: [640, 960, 1280], format: 'webp', quality: 70 });

// Afstanden letterlijk van hun eigen bordjespaal (foto bron/google/menu/02.jpg).
const borden = [
  ['San Sebastián', '1.215'], ['Bilbao', '1.313'], ['Barcelona', '1.433'], ['Madrid', '1.669'], ['Valencia', '1.771'],
  ['Ibiza', '2.029'], ['Córdoba', '2.053'], ['Sevilla', '2.128'], ['Málaga', '2.187'], ['Cádiz', '2.245'],
];

const route = [
  { nr: '01', waar: 'Baskenland', titel: 'Pintxos', tekst: 'Broodjes met lekkere ingrediënten erop geprikt. In Baskenland eet je ze staand aan de bar, met een drankje erbij.', img: rBask, alt: 'Plank met pintxos: brie met rode bessen, gegrilde aubergine en zalm' },
  { nr: '02', waar: 'Sevilla', titel: 'Tapas om te delen', tekst: 'Bestel niet teveel tegelijk. Zo eet je in verschillende gangen en geniet je langer.', img: rSev, alt: 'Patatas bravas met aioli en albóndigas in tomatensaus' },
  { nr: '03', waar: 'Latijns-Amerika', titel: 'Met een twist', tekst: 'Spaanse pintxos en tapas met een Latijns-Amerikaanse twist.', img: rLat, alt: 'Gesneden ribeye met groene Spaanse pepers' },
];

// Uit hun eigen menukaart (pinxos.nl, 2025). Zonder prijzen.
const kaart = [
  { kop: 'Tapas', items: [
    ['Pan de Tomate', 'Getoast stokbrood met tomaten, olijfolie en knoflook'],
    ['Croquetas Ibérico', 'Ambachtelijke Ibérico kroketjes, op Spaanse wijze bereid'],
    ['Patatas Bravas', 'Met huisgemaakte aioli en pikante bravas saus'],
    ['Dátiles con Bacón', 'Dadels omwikkeld met gerookte bacon en honing'],
    ['Albóndigas', 'Huisgemaakte gehaktballetjes in tomatensaus'],
    ['Empanada Pollo', 'Huisgemaakte Argentijnse kip empanada’s'],
  ] },
  { kop: 'Pescado', items: [
    ['Gambas a la Plancha', 'Gegrilde Argentijnse gamba’s met knoflook en olijfolie'],
    ['Pulpo', 'Gegrilde octopus op een bedje aardappelpuree'],
    ['Ceviche Peruano', 'Zeebaars, mango, avocado en passievrucht'],
    ['Bacalao al Pil Pil', 'Kabeljauw op Baskische wijze bereid'],
  ] },
  { kop: 'Carne', items: [
    ['Secreto Ibérico', 'Het geheim van het Ibérico varken'],
    ['Ribeye', 'Graangevoerde Uruguayaanse ribeye'],
    ['Pollo al Chimichurri', 'Gegrilde kippenbout met huisgemaakte chimichurri'],
  ] },
  { kop: 'Postres', items: [
    ['Churros', 'Chocolade churros met slagroom'],
    ['Crema Catalana', 'Catalaanse crème brûlée'],
    ['Carlito’s Way', 'Ibérico ham, manchego en dadelbrood, met een glaasje PX Sherry'],
  ] },
];

const week = [...tijden.slice(1), tijden[0]];
---
<Base title="Pinxos | pintxos & tapasbar in Roosendaal" description="Pintxos uit de vitrine, tapas om te delen en een binnentuin met Spaanse sfeer. Raadhuisstraat 62B, Roosendaal. Open woensdag tot en met zondag.">
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit">
      <Kop />
      <picture>
        <source media="(max-width: 767px)" srcset={hmImg.srcSet.attribute} sizes="100vw" />
        <img src={hd.src} srcset={hd.srcSet.attribute} sizes="100vw" alt="Pintxos op stokbrood met zalm, brie en rode bessen en gegrilde aubergine" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_60%] md:object-[50%_50%]" fetchpriority="high" decoding="async" width="1600" height="900" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0a163899_0%,#0a163826_30%,#0a1638bf_62%,#0a1638f2_100%)] md:bg-[linear-gradient(90deg,#0a1638f2_0%,#0a1638cc_38%,#0a163833_70%,#0a16380d_100%),linear-gradient(0deg,#0a1638cc_0%,transparent_35%)]"></div>
      <div class="wrap pb-20 pt-32 md:pb-20 md:pt-44">
        <p class="eyebrow eyebrow-licht">Pintxos &amp; tapasbar in Roosendaal</p>
        <h1 class="mt-6 max-w-[13ch] text-hero">Een smaakvolle <span class="text-limoen">vlucht.</span></h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-wit/90 sm:text-lg md:mt-6 md:text-xl">Op een verborgen plekje in het centrum van Roosendaal. Langs de pintxosbars van Baskenland, de tapastentjes van Sevilla en de swingende straatjes van Latijns-Amerika.</p>
        <div class="mt-8 flex flex-wrap gap-3 md:mt-9">
          <a href="#reserveren" class="knop knop-limoen">Tafel aanvragen <Icoon naam="pijl" /></a>
          <a href="#kaart" class="knop knop-wit">Bekijk de kaart</a>
        </div>
        <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-lijn pt-5 text-[.9rem] text-wit/85 md:mt-10 md:pt-6 md:text-[.95rem]">
          <li class="flex items-center gap-2"><span class="flex text-limoen" aria-hidden="true">{[1,2,3,4,5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span><b class="text-wit">{site.google.score}</b> op Google · {site.google.aantal} reviews</span></li>
          <li class="flex items-center gap-2"><Icoon naam="klok" class="h-[1.1rem] w-[1.1rem] text-limoen" /><span data-status>Woensdag t/m zondag open</span></li>
          <li class="hidden md:list-item"><a href={site.telHref} class="num flex items-center gap-2 text-wit/85 no-underline hover:text-limoen"><Icoon naam="tel" class="h-[1.1rem] w-[1.1rem] text-limoen" />{site.tel}</a></li>
        </ul>
      </div>
    </section>

    <!-- WEGWIJZERS -->
    <div class="overflow-hidden bg-inkt py-5" aria-label="Wegwijzer bij Pinxos: afstanden vanaf Roosendaal">
      <ul class="wegwijzer flex w-max gap-3">
        {[...borden, ...borden].map(([s, km], i) => <li aria-hidden={i >= borden.length ? 'true' : undefined} class={`bord ${i % 3 === 0 ? 'bord-limoen' : i % 3 === 1 ? 'bord-wit' : 'bord-inkt'}`}>{s} <small class="num">{km} km</small></li>)}
      </ul>
    </div>

    <!-- ROUTE -->
    <section id="pintxos" class="licht py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-8 md:grid-cols-12 md:items-end">
          <h2 class="text-4xl md:col-span-7">Van Baskenland tot Latijns-Amerika</h2>
          <p class="max-w-md text-lg text-grijs md:col-span-5">Spaanse pintxos en tapas met een Latijns-Amerikaanse twist. Met huisgemaakte sangria, een exclusieve wijn, een koud Spaans biertje of een bijzondere cocktail.</p>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {route.map((r, i) => (
            <article class="rijs group" style={`--d:${i * .1}s`}>
              <div class="foto foto-hover relative aspect-[4/5]">
                <Image src={r.img} alt={r.alt} widths={[420, 640, 900]} sizes="(min-width: 768px) 32vw, 100vw" quality={72} class="h-full w-full" />
                <span class="bord bord-limoen absolute left-0 top-6 !rounded-none">{r.waar}</span>
              </div>
              <div class="mt-6 flex gap-5">
                <span class="font-kop text-2xl font-extrabold text-kalk-3">{r.nr}</span>
                <div>
                  <h3 class="text-2xl">{r.titel}</h3>
                  <p class="mt-2 text-grijs">{r.tekst}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- VITRINE -->
    <section class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <p class="eyebrow eyebrow-licht">Pintxo betekent prikker</p>
          <h2 class="mt-5 text-4xl">De pintxos&shy;vitrine</h2>
          <p class="mt-6 max-w-md text-lg text-mist">Vandaar de prikker door de O van ons logo. De T hebben we lekker eigenwijs weggelaten.</p>
          <ol class="mt-12 space-y-8">
            <li class="flex gap-6"><span class="stap-nr">01</span><div><h3 class="text-xl">Loop zelf naar de vitrine</h3><p class="mt-1.5 text-mist">Tijdens het borrelen of eten, wanneer je zin hebt.</p></div></li>
            <li class="flex gap-6"><span class="stap-nr">02</span><div><h3 class="text-xl">Neem een gevulde plank mee</h3><p class="mt-1.5 text-mist">Elke dag een andere samenstelling.</p></div></li>
            <li class="flex gap-6"><span class="stap-nr">03</span><div><h3 class="text-xl">Of neem ze mee naar huis</h3><p class="mt-1.5 text-mist">In een afhaaldoos, zodat het thuis ook een feestje wordt.</p></div></li>
          </ol>
        </div>
        <div class="grid grid-cols-5 gap-4 lg:col-span-7">
          <div class="foto col-span-2 hidden aspect-[3/4] self-end sm:block"><Image src={vitrine} alt="Lange houten plank met pintxos op prikkers" widths={[300, 500, 800]} sizes="(min-width: 1024px) 22vw, 40vw" quality={72} class="h-full w-full" /></div>
          <div class="foto col-span-5 aspect-[4/5] sm:col-span-3"><Image src={plankPintxos} alt="Pintxos met zalm, brie en rode bessen op een plank" widths={[400, 700, 1100]} sizes="(min-width: 1024px) 34vw, 60vw" quality={72} class="h-full w-full" /></div>
        </div>
      </div>
    </section>

    <!-- KAART -->
    <section id="kaart" class="licht py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-8 md:grid-cols-12 md:items-end">
          <div class="md:col-span-7">
            <h2 class="text-4xl">Van de kaart</h2>
          </div>
          <p class="max-w-md text-lg text-grijs md:col-span-5">Onze tapas komen niet allemaal tegelijk op tafel. Ze worden op willekeurige tijd vers bereid en geserveerd.</p>
        </div>
        <div class="mt-14 grid gap-x-14 gap-y-14 md:grid-cols-2">
          {kaart.map((g) => (
            <div class="rijs">
              <h3 class="flex items-center gap-4 border-b-2 border-inkt pb-3 text-3xl">{g.kop}</h3>
              <ul class="mt-6 space-y-5">
                {g.items.map(([n, u]) => <li><p class="gerecht">{n}</p><p class="gerecht-uitleg">{u}</p></li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-16 grid gap-6 lg:grid-cols-12">
          <div class="kaart-blok flex flex-col justify-between gap-6 rounded-[var(--radius-md)] bg-limoen p-8 md:p-10 lg:col-span-5">
            <div>
              <h3 class="text-3xl">Glutenvrij?</h3>
              <p class="mt-4 max-w-md">Onze keuken kan glutenvrije pintxos voor jullie maken. Hou er wel rekening mee dat wij veel met brood werken: sporen van gluten kunnen we niet 100% uitsluiten.</p>
            </div>
            <p class="text-sm font-medium">Allergenen? Vraag het gerust aan een van onze medewerkers.</p>
          </div>
          <div class="relative grid overflow-hidden rounded-[var(--radius-md)] bg-inkt text-wit sm:grid-cols-2 lg:col-span-7">
            <div class="flex flex-col justify-center p-8 md:p-10">
              <h3 class="text-3xl">Paella-dagen</h3>
              <p class="mt-4 text-mist">Paella staat niet standaard op de kaart. Daar prikken we speciale dagen voor, zodat alles vers bereid kan worden. Willemijn leerde paella maken in Spanje.</p>
            </div>
            <div class="aspect-[4/3] sm:aspect-auto"><Image src={paella} alt="Paella met gamba's en mosselen, van bovenaf" widths={[400, 700]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 50vw, 100vw" quality={72} class="h-full w-full object-cover" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- PLEKKEN -->
    <section id="plekken" class="bg-inkt py-24 text-wit md:py-32">
      <div class="wrap">
        <div class="grid gap-8 md:grid-cols-12 md:items-end">
          <h2 class="text-4xl md:col-span-7">Een ongedwongen vakantiesfeer</h2>
          <p class="max-w-md text-lg text-mist md:col-span-5">Een romantische binnentuin, winter- en zomerproof. Een Spaans buitensteegje. En natuurlijk onze pintxosbar.</p>
        </div>
        <div class="mt-14 grid auto-rows-[11rem] grid-cols-2 gap-3 md:auto-rows-[13rem] md:grid-cols-4 md:gap-4">
          <figure class="foto relative col-span-2 row-span-2 md:col-span-2 md:row-span-3"><Image src={paraplu} alt="Het steegje met gekleurde paraplu's en lichtjes" widths={[500, 800, 1100]} sizes="(min-width: 768px) 48vw, 100vw" quality={72} class="h-full w-full" /><figcaption class="absolute bottom-4 left-4 rounded-full bg-inkt/80 px-4 py-1.5 text-sm font-medium backdrop-blur-sm">Het steegje</figcaption></figure>
          <figure class="foto relative row-span-2"><Image src={tuin} alt="De binnentuin bij avond, met lichtsnoeren" widths={[360, 560]} sizes="(min-width: 768px) 24vw, 50vw" quality={72} class="h-full w-full" /><figcaption class="absolute bottom-4 left-4 rounded-full bg-inkt/80 px-4 py-1.5 text-sm font-medium backdrop-blur-sm">De binnentuin</figcaption></figure>
          <figure class="foto relative row-span-2"><Image src={steeg} alt="Houten tafel met twee glazen bier in het steegje" widths={[360, 560]} sizes="(min-width: 768px) 24vw, 50vw" quality={72} class="h-full w-full" /></figure>
          <figure class="foto relative col-span-2 row-span-1 md:col-span-2"><Image src={bar} alt="De bar van Pinxos met lichtjes" widths={[500, 800, 1200]} sizes="(min-width: 768px) 48vw, 100vw" quality={72} class="h-full w-full object-[50%_55%]" /><figcaption class="absolute bottom-4 left-4 rounded-full bg-inkt/80 px-4 py-1.5 text-sm font-medium backdrop-blur-sm">De bar</figcaption></figure>
        </div>
      </div>
    </section>

    <!-- FEESTEN -->
    <section id="feesten" class="licht relative py-24 md:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="grid grid-cols-2 gap-4 lg:col-span-6">
          <div class="foto h-full min-h-[18rem]"><Image src={schuur} alt="Tafel met rode stoelen voor een kleurrijke muurschildering" widths={[300, 500, 700]} sizes="(min-width: 1024px) 24vw, 50vw" quality={72} class="h-full w-full" /></div>
          <div class="flex flex-col gap-4">
            <div class="foto aspect-[16/9] bg-inkt"><Image src={neon} alt="Het verlichte PINXOS-bord" widths={[300, 500, 700]} sizes="(min-width: 1024px) 24vw, 50vw" quality={72} class="h-full w-full" /></div>
            <div class="foto aspect-[4/5]"><Image src={wegwijzers} alt="Handgeschilderde wegwijzers naar Spaanse steden" widths={[300, 500, 700]} sizes="(min-width: 1024px) 24vw, 50vw" quality={72} class="h-full w-full object-[50%_25%]" /></div>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-6 lg:pl-6">
          <h2 class="text-4xl">Iets te vieren?</h2>
          <p class="mt-6 max-w-lg text-lg text-grijs">Feesten, vergaderen, een proeverij of cocktailworkshop. Wist je trouwens dat je bij ons zelfs officieel kunt trouwen?</p>
          <ul class="mt-9 grid gap-x-8 gap-y-5 sm:grid-cols-2">
            <li class="border-t-2 border-inkt pt-4"><h3 class="text-xl">Het proeflokaal</h3><p class="mt-1.5 text-[.95rem] text-grijs">Een oude varkensschuur, omgebouwd voor wijn-, rum-, gin-tonic- en bierproeverijen.</p></li>
            <li class="border-t-2 border-inkt pt-4"><h3 class="text-xl">De bovenverdieping</h3><p class="mt-1.5 text-[.95rem] text-grijs">In Spaanse sferen, voor vergaderingen, cursussen en bijeenkomsten.</p></li>
            <li class="border-t-2 border-inkt pt-4"><h3 class="text-xl">Feesten en partijen</h3><p class="mt-1.5 text-[.95rem] text-grijs">In de binnentuin, het steegje of de ruimte grenzend aan de tuin.</p></li>
            <li class="border-t-2 border-inkt pt-4"><h3 class="text-xl">Vrijblijvende offerte</h3><p class="mt-1.5 text-[.95rem] text-grijs">We bespreken alle details en maken een offerte op maat.</p></li>
          </ul>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={waFeest} class="knop knop-inkt whitespace-normal text-center"><Icoon naam="wa" />Vraag naar de mogelijkheden</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" />Bel ons</a>
          </div>
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews" class="licht border-t border-lijn-licht bg-kalk-2/60 py-24 md:py-32">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-8">
          <h2 class="text-4xl">Wat gasten zeggen</h2>
          <a href={site.reviews} class="flex items-center gap-3 rounded-full border border-lijn-licht bg-wit px-5 py-3 text-[.95rem] font-medium text-inkt no-underline shadow-sm transition-colors hover:border-inkt">
            <Icoon naam="g" class="h-5 w-5" /> {site.google.aantal} reviews op Google <Icoon naam="pijl" class="h-4 w-4" />
          </a>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <figure class="rijs flex flex-col rounded-[var(--radius-md)] border border-lijn-licht bg-wit p-7 shadow-sm" style={`--d:${(i % 3) * .08}s`}>
              <div class="flex text-inkt" role="img" aria-label="5 van 5 sterren">{[1,2,3,4,5].map(() => <Icoon naam="ster" class="h-[1.05rem] w-[1.05rem]" />)}</div>
              <blockquote class="mt-5 flex-1 text-[1.02rem] leading-relaxed">“{r.tekst}”</blockquote>
              <figcaption class="mt-6 flex items-center justify-between gap-3 border-t border-lijn-licht pt-4 text-sm">
                <span class="font-semibold">{r.naam}</span>
                <span class="flex items-center gap-1.5 text-grijs"><Icoon naam="g" class="h-4 w-4" />{r.wanneer}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- RESERVEREN -->
    <section id="reserveren" class="bg-inkt py-24 text-wit md:py-32">
      <div class="wrap grid gap-14 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-7">
          <h2 class="text-4xl">Tafel <span class="text-limoen">aanvragen</span></h2>
          <p class="mt-5 max-w-lg text-lg text-mist">Kies een dag en tijd. Je bericht staat klaar in WhatsApp, wij bevestigen je tafel.</p>
          <form class="mt-10 grid gap-6" data-res novalidate>
            <fieldset class="min-w-0">
              <legend class="veld-label">Wat wil je doen?</legend>
              <div class="flex flex-wrap gap-2">
                <label class="keuze"><input type="radio" name="soort" value="tafel" checked />Tafel reserveren</label>
                <label class="keuze"><input type="radio" name="soort" value="afhalen" />Pintxos afhalen</label>
              </div>
            </fieldset>
            <div class="grid gap-5 sm:grid-cols-3">
              <div><label for="r-datum" class="veld-label">Datum</label><input id="r-datum" name="datum" type="date" class="veld num" required /></div>
              <div><label for="r-tijd" class="veld-label">Tijd</label><select id="r-tijd" name="tijd" class="veld num"></select></div>
              <div data-alleen-tafel><label for="r-pers" class="veld-label">Personen</label><select id="r-pers" name="pers" class="veld num">{Array.from({ length: 11 }, (_, i) => i + 1).map((n) => <option value={n} selected={n === 2}>{n}</option>)}<option value="12+">12 of meer</option></select></div>
            </div>
            <p class="-mt-2 hidden text-sm text-limoen" data-dicht role="status"></p>
            <fieldset class="min-w-0" data-alleen-tafel>
              <legend class="veld-label">Voorkeur</legend>
              <div class="flex flex-wrap gap-2">
                {['Geen voorkeur', 'Binnentuin', 'Het steegje', 'Binnen'].map((p, i) => <label class="keuze"><input type="radio" name="plek" value={p} checked={i === 0} />{p}</label>)}
              </div>
            </fieldset>
            <div class="grid gap-5 sm:grid-cols-2">
              <div><label for="r-naam" class="veld-label">Naam</label><input id="r-naam" name="naam" class="veld" autocomplete="name" placeholder="Je naam" /></div>
              <div><label for="r-opm" class="veld-label">Opmerking</label><input id="r-opm" name="opm" class="veld" placeholder="Bijv. glutenvrij of iets te vieren" /></div>
            </div>
            <div class="grid items-start gap-6 sm:grid-cols-[1fr_auto]">
              <div class="bubbel max-w-md" data-bubbel aria-live="polite"></div>
              <a href={site.wa} class="knop knop-limoen" data-wa><Icoon naam="wa" />Verstuur via WhatsApp</a>
            </div>
          </form>
        </div>
        <aside class="min-w-0 lg:col-span-5 lg:pl-6">
          <div class="rounded-[var(--radius-md)] border border-lijn bg-inkt-2 p-7 md:p-9">
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-2xl">Openingstijden</h3>
              <span class="rounded-full bg-limoen px-3 py-1 text-xs font-semibold text-inkt empty:hidden" data-nu></span>
            </div>
            <table class="num mt-6 w-full text-[.98rem]">
              <thead class="sr-only"><tr><th>Dag</th><th>Open</th><th>Afhalen</th></tr></thead>
              <tbody>
                {week.map((d) => (
                  <tr class="border-b border-lijn last:border-0" data-dag={tijden.indexOf(d)}>
                    <td class="py-2.5 pr-3">{d.dag}</td>
                    <td class="py-2.5 text-right">{d.open ? `${hm(d.open)} tot ${hm(d.dicht!)}` : <span class="text-mist">gesloten</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-5 text-sm text-mist">Afhalen: woensdag, donderdag en zondag 17:00 tot 20:00, vrijdag en zaterdag 17:00 tot 22:30.</p>
          </div>
          <div class="mt-6 flex gap-5 rounded-[var(--radius-md)] border border-lijn p-7 md:p-9">
            <Icoon naam="pin" class="mt-1 h-6 w-6 flex-none text-limoen" />
            <div>
              <p class="font-kop text-xl font-bold">{site.straat}</p>
              <p class="text-mist">{site.postcode} {site.plaats}, midden in het centrum</p>
              <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                <a href={site.route} class="link font-medium text-limoen">Route plannen</a>
                <a href={site.telHref} class="link num font-medium text-wit">{site.tel}</a>
              </div>
            </div>
          </div>
          
        </aside>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .wegwijzer { animation: rij 60s linear infinite; }
  @keyframes rij { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .wegwijzer { animation: none; } }
</style>

<script>
  import { tijden, hm, site } from '../data/site';
  const DAGEN = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
  const MAANDEN = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];

  // Tijd in Nederland, los van de klok van de bezoeker.
  const nl = () => { const p = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()); const g = (t: string) => p.find((x) => x.type === t)!.value; return { dag: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(g('weekday')), min: +g('hour') * 60 + +g('minute') }; };

  function status() {
    const { dag, min } = nl();
    const gister = tijden[(dag + 6) % 7];
    if (gister.dicht && gister.dicht > 1440 && min < gister.dicht - 1440) return { open: true, tekst: `Nu open tot ${hm(gister.dicht)}` };
    const t = tijden[dag];
    if (t.open && min >= t.open && min < t.dicht!) return { open: true, tekst: `Nu open tot ${hm(t.dicht!)}` };
    if (t.open && min < t.open) return { open: false, tekst: `Vandaag open vanaf ${hm(t.open)}` };
    for (let i = 1; i <= 7; i++) { const d = (dag + i) % 7; if (tijden[d].open) return { open: false, tekst: `${i === 1 ? 'Morgen' : DAGEN[d][0].toUpperCase() + DAGEN[d].slice(1)} weer open vanaf ${hm(tijden[d].open!)}` }; }
    return { open: false, tekst: '' };
  }
  const s = status();
  const st = document.querySelector('[data-status]'); if (st && s.tekst) st.textContent = s.tekst;
  const nu = document.querySelector('[data-nu]'); if (nu) nu.textContent = s.open ? 'Nu open' : 'Nu gesloten';
  document.querySelector(`[data-dag="${nl().dag}"]`)?.classList.add('font-semibold', 'text-limoen');

  // Reserveren: bericht live opbouwen en klaarzetten in WhatsApp.
  const f = document.querySelector<HTMLFormElement>('[data-res]');
  if (f) {
    const datum = f.querySelector<HTMLInputElement>('#r-datum')!;
    const tijd = f.querySelector<HTMLSelectElement>('#r-tijd')!;
    const dicht = f.querySelector<HTMLElement>('[data-dicht]')!;
    const bubbel = f.querySelector<HTMLElement>('[data-bubbel]')!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const vandaag = new Date(); datum.min = iso(vandaag);
    const eerst = new Date(); while (!tijden[eerst.getDay()].open) eerst.setDate(eerst.getDate() + 1);
    datum.value = iso(eerst);
    const soort = () => (f.querySelector<HTMLInputElement>('input[name=soort]:checked')!.value);

    function vulTijden() {
      const d = new Date(datum.value + 'T12:00'); const t = tijden[d.getDay()]; const vorig = tijd.value;
      const af = soort() === 'afhalen';
      const van = af ? t.afOpen : t.open; const tot = af ? t.afDicht : (t.dicht ? Math.min(t.dicht - 60, 22 * 60) : undefined);
      tijd.innerHTML = '';
      if (isNaN(d.getTime()) || !van || !tot) { dicht.textContent = isNaN(d.getTime()) ? 'Kies een datum.' : `Op ${DAGEN[d.getDay()]} zijn we gesloten. We zijn open van woensdag tot en met zondag.`; dicht.classList.remove('hidden'); tijd.disabled = true; return; }
      dicht.classList.add('hidden'); tijd.disabled = false;
      for (let m = van; m <= tot; m += 30) tijd.add(new Option(hm(m), hm(m)));
      if ([...tijd.options].some((o) => o.value === vorig)) tijd.value = vorig; else if (!af && tijd.options.length > 2) tijd.selectedIndex = Math.min(4, tijd.options.length - 1);
    }
    function bericht() {
      const v = new FormData(f); const af = soort() === 'afhalen';
      f.querySelectorAll<HTMLElement>('[data-alleen-tafel]').forEach((e) => e.classList.toggle('hidden', af));
      const d = new Date(datum.value + 'T12:00'); const dag = isNaN(d.getTime()) ? '' : `${DAGEN[d.getDay()]} ${d.getDate()} ${MAANDEN[d.getMonth()]}`;
      const r = [af ? 'Hola Pinxos! Ik wil graag pintxos afhalen.' : 'Hola Pinxos! Ik wil graag een tafel reserveren.', '',
        `Datum: ${dag}`, `Tijd: ${tijd.disabled ? '' : tijd.value}`];
      if (!af) { r.push(`Personen: ${v.get('pers')}`); if (v.get('plek') !== 'Geen voorkeur') r.push(`Voorkeur: ${String(v.get('plek')).toLowerCase()}`); }
      if (String(v.get('naam')).trim()) r.push(`Naam: ${String(v.get('naam')).trim()}`);
      if (String(v.get('opm')).trim()) r.push(`Opmerking: ${String(v.get('opm')).trim()}`);
      const tekst = r.join('\n'); bubbel.textContent = tekst;
      wa.href = `${site.wa}?text=${encodeURIComponent(tekst)}`;
    }
    f.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('#r-datum, input[name=soort]')) vulTijden(); bericht(); });
    f.addEventListener('input', bericht);
    vulTijden(); bericht();
  }
</script>
