---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['pintxos', 'Pintxos'], ['kaart', 'De kaart'], ['plekken', 'Tuin & steeg'], ['feesten', 'Feesten'], ['reserveren', 'Tijden']];
---
<header class={thuis ? 'absolute inset-x-0 top-0 z-40' : 'relative z-40 bg-inkt'}>
  <div class="wrap flex h-20 items-center justify-between gap-3 md:h-24 md:gap-6">
    <Merk class="h-9 md:h-11" />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[1rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-wit/90 no-underline transition-colors duration-200 hover:text-limoen">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-4">
      <a href={site.telHref} class="num hidden font-medium text-wit/90 no-underline hover:text-limoen xl:inline">{site.tel}</a>
      <a href={h('reserveren')} class="knop knop-limoen hidden min-h-11 px-5 md:inline-flex">Tafel aanvragen</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-wit lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden bg-inkt lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {[...nav, ['reserveren', 'Tafel aanvragen']].map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn py-4 font-kop text-3xl font-extrabold tracking-[-.03em] text-wit no-underline">{t}</a></li>)}
      <li class="pt-6"><a href={site.telHref} class="num font-medium text-mist no-underline">{site.tel}</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 bg-inkt md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn text-[1rem] font-semibold text-wit no-underline"><Icoon naam="tel" class="h-5 w-5 text-limoen" />Bellen</a>
  <a href={waHoi} class="flex min-h-14 items-center justify-center gap-2.5 bg-limoen text-[1rem] font-semibold text-inkt no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
