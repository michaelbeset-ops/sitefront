---
// Hun eigen logo (SVG van pinxos.nl): het rode bord met de prikker door de O.
import logo from '../assets/logo.svg?raw';
import { url } from '../data/site';
interface Props { class?: string }
const { class: cls = 'h-10 md:h-12' } = Astro.props;
---
<a href={url('')} class={`block shrink-0 no-underline [&_svg]:h-full [&_svg]:w-auto ${cls}`} aria-label="Pinxos, naar de beginpagina"><Fragment set:html={logo} /></a>
