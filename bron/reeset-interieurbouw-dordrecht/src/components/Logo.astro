---
// Woordmerk naar hun eigen logo: het huis van één lijn met twee oplopende panelen, REESET in ruime kapitalen.
import { url } from '../data/site';
interface Props { klein?: boolean; href?: string }
const { klein = false, href = url('') } = Astro.props;
---
<a href={href} class="group inline-flex items-center gap-3 text-wit no-underline">
  <svg viewBox="0 0 34 33" class={klein ? 'h-8 w-8' : 'h-9 w-9 md:h-10 md:w-10'} fill="none" stroke="#d6ad60" stroke-width="1.7" stroke-linejoin="miter" aria-hidden="true">
    <path d="M2 32V11.6L17 2l15 9.6V32" />
    <path d="M8 32V19.6l6.4-4.4V32Z" />
    <path d="M18.6 32V7.6l6.2 4.4V32Z" />
  </svg>
  <span class="leading-none">
    <span class="block text-[1.15rem] font-semibold tracking-[.34em] md:text-[1.3rem]">REESET</span><span class="sr-only"> </span>
    <span class="mt-1.5 block whitespace-nowrap text-[.5625rem] font-medium tracking-[.2em] text-as uppercase sm:text-[.625rem] sm:tracking-[.28em]">Interieur Design Studio</span>
  </span>
</a>
