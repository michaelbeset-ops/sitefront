---
import { site, url, waHoi, diensten } from '../data/site';
import Logo from './Logo.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-eiken text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-24">
    <div class="md:col-span-4">
      <Logo />
      <p class="mt-7 max-w-xs">Ontwerp, advies en projectbegeleiding van maatwerkinterieurs. Van eerste idee tot gerealiseerd interieur.</p>
      <p class="mt-5 flex gap-6"><a href={site.instagram} class="link">Instagram</a><a href={site.linkedin} class="link">LinkedIn</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Ontwerp en advies</p>
      <ul class="mt-4 space-y-1.5">{diensten.map((d) => <li>{d}</li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link">WhatsApp <span class="num">{site.mobiel}</span></a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Studio</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3">Maandag tot en met vrijdag<br /><span class="num">09.00 tot 17.00 uur</span></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.bv} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-messing">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten van reeset-interieurbouw.nl en jullie Instagram; alle projectfoto's en portretten van jullie eigen site. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
