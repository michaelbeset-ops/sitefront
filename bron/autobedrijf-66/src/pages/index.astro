</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const km = document.querySelector<HTMLElement>('[data-km]');
  const plaat = f?.querySelector<HTMLInputElement>('[name=kenteken]');
  const bericht = () => {
    const d = new FormData(f!);
    const v = (n: string) => String(d.get(n) || '').trim();
    const wat = v('wat');
    const k = v('kenteken').toUpperCase();
    const r: string[] = [];
    if (wat === 'Mijn auto verkopen') {
      r.push('Hoi Autobedrijf 66, ik wil mijn auto verkopen.');
      if (k) r.push('Kenteken: ' + k);
      if (v('km')) r.push('Kilometerstand: ' + v('km'));
      r.push('Foto’s stuur ik zo.');
    } else if (wat === 'Een auto kopen') {
      r.push('Hoi Autobedrijf 66, ik zoek een auto. Wat hebben jullie op dit moment staan?');
      if (k) r.push('Mijn huidige kenteken: ' + k);
    } else {
      r.push(`Hoi Autobedrijf 66, ik heb interesse in ${wat.toLowerCase()}.`);
      if (k) r.push('Kenteken: ' + k);
      r.push('Een foto van mijn auto stuur ik zo.');
    }
    if (v('naam')) r.push('Groet, ' + v('naam'));
    return r.join('\n');
  };
  const toon = () => {
    if (!f || !vb) return;
    const wat = String(new FormData(f).get('wat') || '');
    km?.classList.toggle('hidden', wat !== 'Mijn auto verkopen');
    vb.textContent = bericht();
  };
  if (f) {
    plaat?.addEventListener('input', () => { plaat.value = plaat.value.toUpperCase(); });
    f.addEventListener('input', toon);
    f.addEventListener('change', toon);
    toon();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31651750325?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
  }
</script>

