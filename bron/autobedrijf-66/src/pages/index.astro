---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi, waMet } from '../data/site';
import showroom from '../assets/showroom.jpg';
import showroomMini from '../assets/showroom-mini.jpg';
import showroomAchter from '../assets/showroom-achter.jpg';
import pand from '../assets/pand.jpg';
import wrapSuv from '../assets/wrap-suv.jpg';
import ppf from '../assets/ppf.jpg';
import ig1 from '../assets/ig-DekAGjoDSF9.jpg';
import ig2 from '../assets/ig-Dej2dlCDdiC.jpg';
import ig3 from '../assets/ig-Dej1lEYDXJd.jpg';
import ig4 from '../assets/ig-Dej0m-fDQYX.jpg';
import ig5 from '../assets/ig-DejzCZfDRAc.jpg';
import ig6 from '../assets/ig-Dejx45kDRos.jpg';
import ig7 from '../assets/ig-DZ2VYagjWTY.jpg';
import ig8 from '../assets/ig-DWpHPzODRT0.jpg';
import ig9 from '../assets/ig-Ddo79QSDUFk.jpg';

const chips = ['Occasions', 'Auto inkoop', 'Wraps', 'PPF', 'Tint', 'Custom'];

const aanbod = [
  { t: 'Occasions', d: 'Gebruikte auto’s van onder meer MINI, Opel, Volkswagen en Kia. Het aanbod wisselt steeds.', src: showroomMini, alt: 'Rode MINI met witte strepen vooraan in de showroom, met daarachter een rij occasions', href: site.voorraad, knop: 'Bekijk de voorraad' },
  { t: 'Auto verkopen', d: 'Autobedrijf 66 koopt auto’s in. Stuur je kenteken en kilometerstand via WhatsApp.', src: showroomAchter, alt: 'Occasions in de achterste hal van de showroom', href: '#appje', knop: 'Stuur je kenteken' },
  { t: 'Wraps, PPF en tint', d: 'Een nieuwe kleur met folie, beschermfolie op de lak of getinte ramen.', src: wrapSuv, alt: 'SUV met een matte paarse wrap in een donkere studio (sfeerfoto)', href: '#wraps', knop: 'Meer over wraps' },
];

const binnen = [
  { src: ig1, alt: 'Occasion voor het pand van Autobedrijf 66' },
  { src: ig2, alt: 'Occasion voor het pand van Autobedrijf 66' },
  { src: ig3, alt: 'Occasion voor het pand van Autobedrijf 66' },
  { src: ig4, alt: 'Occasion voor het pand van Autobedrijf 66' },
  { src: ig5, alt: 'Occasion voor het pand van Autobedrijf 66' },
  { src: ig6, alt: 'Occasion voor het pand van Autobedrijf 66' },
  { src: ig7, alt: 'Occasion voor het pand van Autobedrijf 66' },
  { src: ig8, alt: 'Occasion voor het pand van Autobedrijf 66' },
  { src: ig9, alt: 'Occasion voor het pand van Autobedrijf 66' },
];

const stappen = [
  ['Kijk wat er staat', 'Op Auto Voor Jou of Instagram. Iets gezien? Stuur een appje.'],
  ['Kom kijken', 'Doordeweeks van 9.00 tot 17.00 uur, zaterdag van 10.00 tot 15.00 uur.'],
  ['Duidelijke uitleg', 'Klanten noemen in hun reviews de uitleg duidelijk en de verkoper eerlijk.'],
  ['Contant of per maand', 'Bij elke auto op Auto Voor Jou zie je ook een bedrag per maand.'],
];

const folie = [
  { naam: 'Wraps', d: 'Je auto in een andere kleur of met een eigen design, met folie.', icoon: 'kwast' },
  { naam: 'PPF', d: 'Transparante beschermfolie op de lak, tegen steenslag en krassen.', icoon: 'schild' },
  { naam: 'Tint', d: 'Getinte ramen voor meer privacy en minder zon in de auto.', icoon: 'auto' },
  { naam: 'Custom', d: 'Iets eigens in gedachten? Stuur een foto van je auto en je idee.', icoon: 'praat' },
];

const keuzes = ['Mijn auto verkopen', 'Een auto kopen', 'Een wrap', 'PPF', 'Tint', 'Custom werk'];
---
<Base title={`${site.naam} | Occasions, inkoop, wraps en PPF in Dordrecht`} description="Autobedrijf 66 aan de Daltonstraat 8 in Dordrecht. Occasions, auto inkoop, wraps, PPF en tint. Ma t/m vr 9.00 tot 17.00, za 10.00 tot 15.00 uur.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen showroom op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={showroom} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[30%_60%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#10111240_0%,#101112b8_45%,#101112f5_100%)] md:bg-[linear-gradient(90deg,#101112f2_0%,#101112c4_45%,#10111233_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Autobedrijf in Dordrecht</p>
          <h1 id="t-hero" class="mt-5 text-hero">Occasions, inkoop en <span class="text-rood-licht">wraps.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Aan de Daltonstraat in Dordrecht. Koop hier je volgende auto, verkoop je huidige, of geef hem een nieuwe look met een wrap, PPF of tint.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waHoi} class="knop knop-rood"><Icoon naam="wa" />Stuur een WhatsApp</a>
            <a href="#aanbod" class="knop knop-rand op-foto">Bekijk het aanbod</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 9.00 tot 17.00, za 10.00 tot 15.00 uur</span></li>
            <li class="flex items-center gap-2"><Icoon naam="pin" class="h-4 w-4 text-rood-licht" />{site.straat}, {site.plaats}</li>
            <li class="flex items-center gap-2"><Icoon naam="tel" class="h-4 w-4 text-rood-licht" /><a href={site.telHref} class="num font-semibold text-licht no-underline hover:text-rood-licht">{site.tel}</a></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto w-full max-w-[18rem] rounded-lg bg-licht/10 p-2.5 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <Image src={pand} alt="Het pand van Autobedrijf 66 met de lichtbak boven de ramen" widths={[320, 600]} sizes="290px" loading="eager" class="aspect-[4/5] w-full rounded-md object-cover object-top" />
            <figcaption class="flex items-center justify-between gap-3 px-2 pb-1 pt-3 text-sm">
              <span>Ons pand aan de Daltonstraat</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Wat we doen">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#aanbod" class="shrink-0 rounded-sm bg-grijsvlak px-4 py-2 text-sm font-bold no-underline transition-colors hover:bg-rood hover:text-white">{c}</a>)}
      </div>
    </section>

    <!-- 3. Aanbod -->
    <section id="aanbod" class="py-20 lg:py-24" aria-labelledby="t-aanbod">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Wat we doen</p>
            <h2 id="t-aanbod" class="mt-4 text-3xl">Kopen, verkopen of een nieuwe look.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Naast occasions doen we ook wraps, PPF en tint. Alles onder één dak aan de Daltonstraat.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-14 lg:gap-6">
          {aanbod.map((a, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={a.href} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={a.src} alt={a.alt} widths={[480, 720, 960]} sizes="(min-width: 1280px) 390px, (min-width: 768px) 31vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-2xl">{a.t}</h3>
                  <p class="mt-2 flex-1 text-grijs">{a.d}</p>
                  <span class="mt-6 inline-flex items-center gap-2 font-bold text-rood">{a.knop}<Icoon naam="pijl" class="h-5 w-5 transition-transform group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Net binnen (eigen Instagram-foto's) -->
    <section id="binnen" class="donker bg-nacht py-24 text-licht lg:py-28" aria-labelledby="t-binnen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Net binnen</p>
            <h2 id="t-binnen" class="mt-4 text-3xl">Vers voor de deur gezet.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-licht-zacht">Nieuwe auto’s zie je het eerst op Instagram. De actuele voorraad met prijzen staat op Auto Voor Jou.</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={site.voorraad} class="knop knop-rood knop-klein">Actuele voorraad<Icoon naam="pijl" /></a>
              <a href={site.instagram} class="knop knop-rand knop-klein"><Icoon naam="insta" />Instagram</a>
            </div>
          </div>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14">
          {binnen.map((b, i) => (
            <li class={`rijs relative overflow-hidden rounded-md bg-nacht-2 ${i === 0 ? 'col-span-2 row-span-2' : ''} ${i > 4 ? 'hidden md:block' : ''}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={b.src} alt={b.alt} widths={[320, 640]} sizes={i === 0 ? '(min-width: 768px) 48vw, 92vw' : '(min-width: 768px) 23vw, 46vw'} class="tegel h-full w-full object-cover aspect-[4/3]" />
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-licht-zacht">Foto’s van Instagram, september en oktober 2026. Of een auto nog te koop is, hoor je via WhatsApp.</p>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo gaat het</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van appje tot sleutel.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Gewoon langskomen kan, even appen vooraf is handig als je voor één auto komt.</p>
        </div>
        <ol class="mt-12 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart p-5 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-xl font-black text-rood">0{i + 1}</p>
              <h3 class="mt-4 text-xl sm:mt-8">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. Wraps, PPF, tint en custom -->
    <section id="wraps" class="donker bg-nacht text-licht" aria-labelledby="t-wraps">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:col-span-6">
          <Image src={ppf} alt="Beschermfolie wordt rond een koplamp aangebracht (sfeerfoto)" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
          <p class="absolute bottom-4 left-4 rounded-sm bg-rood px-4 py-1.5 text-sm font-bold text-white">Wraps · PPF · Tint · Custom</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-80rem)/2+2.5rem))]">
          <p class="eyebrow">Folie en custom</p>
          <h2 id="t-wraps" class="mt-4 text-3xl">Een nieuwe kleur, zonder spuitcabine.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Wil je je auto beschermen of er iets eigens van maken? Stuur een foto van je auto en vertel wat je in gedachten hebt.</p>
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {folie.map((f) => (
              <li class="flex gap-4 rounded-md bg-nacht-2 px-5 py-5">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-rood text-white"><Icoon naam={f.icoon} class="h-5 w-5" /></span>
                <div><h3 class="text-lg">{f.naam}</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">{f.d}</p></div>
              </li>
            ))}
          </ul>
          <a href={waMet('Hoi Autobedrijf 66, ik heb interesse in een wrap, PPF of tint. Ik stuur zo een foto van mijn auto.')} class="knop knop-rood mt-8"><Icoon naam="wa" />Stuur een foto van je auto</a>
        </div>
      </div>
    </section>

    <!-- 7. Reviews (alleen 5-sterren, letterlijk; geen score) -->
    <section id="reviews" class="bg-grijsvlak py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">“Nog nooit zo’n eerlijke autoverkoper.”</h2>
          </div>
          <a href={site.reviews} class="rijs link self-start font-bold md:self-auto" style="--d:.05s">Alle reviews op Google</a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${i * 0.06}s`}>
              <span class="flex text-ster" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-grijsvlak font-kop font-extrabold text-rood" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-bold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8. Wow: kenteken invullen, kant-en-klaar WhatsApp-bericht -->
    <section id="appje" class="py-20 lg:py-24" aria-labelledby="t-appje">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Snel geregeld</p>
          <h2 id="t-appje" class="mt-4 text-3xl">Kenteken erin, appje klaar.</h2>
          <p class="mt-6 text-lg text-grijs">Auto verkopen, een wrap of tint? Vul in wat je wilt, dan staat je WhatsApp-bericht aan Autobedrijf 66 meteen klaar. Foto’s stuur je er daarna gewoon achteraan.</p>
          <ul class="mt-10 grid gap-3">
            <li><a href={waHoi} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-rood text-white"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-bold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>
            <li><a href={site.tel2Href} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-grijsvlak text-rood"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-bold">Bellen</b><span class="num text-grijs">{site.tel2} of {site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-grijsvlak text-rood"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-bold">Mailen</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>
          </ul>
        </div>
        <form class="kaart min-w-0 p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Je bericht aan Autobedrijf 66</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot je in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-bold">Ik wil</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {keuzes.map((k, i) => (
                <label class="keuze"><input type="radio" name="wat" value={k} class="sr-only" checked={i === 0} /><span>{k}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2 [&>*]:min-w-0">
            <label class="block sm:col-span-2"><span class="text-sm font-bold">Kenteken <span class="font-normal text-grijs">(van je eigen auto)</span></span>
              <span class="plaat mt-2">
                <span class="plaat-nl" aria-hidden="true">NL</span>
                <input name="kenteken" maxlength="10" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="AB-123-C" class="plaat-veld" />
              </span>
            </label>
            <label class="block" data-km><span class="text-sm font-bold">Kilometerstand</span><input name="km" inputmode="numeric" class="veld mt-2" placeholder="Bijvoorbeeld 120.000" /></label>
            <label class="block"><span class="text-sm font-bold">Je naam</span><input name="naam" autocomplete="given-name" class="veld mt-2" /></label>
          </div>
          <div class="mt-7 rounded-md bg-grijsvlak p-5">
            <p class="text-xs font-bold uppercase tracking-[.12em] text-grijs">Voorbeeld van je bericht</p>
            <p class="mt-2 whitespace-pre-line text-[.9375rem]" data-voorbeeld aria-live="polite"></p>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-rood"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Zondag zijn we dicht.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 9. Openingstijden en route -->
    <section id="contact" class="border-t border-lijn bg-wit py-20 lg:py-24" aria-labelledby="t-route">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Openingstijden en route</p>
          <h2 id="t-route" class="mt-4 text-3xl">Kom langs.</h2>
          <p class="mt-6 text-lg text-grijs">Je herkent het pand aan de lichtbak met ons logo boven de ramen.</p>
          <div class="kaart mt-10 p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Openingstijden</h3>
              <p class="status-pil text-sm font-bold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za open</span></p>
            </div>
            <table class="mt-4 w-full">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-bold data-[vandaag]:text-rood">
                    <th scope="row" class="py-2.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="flex flex-col gap-5 lg:col-span-7">
          <figure class="relative flex-1 overflow-hidden rounded-lg">
            <Image src={pand} alt="Het pand van Autobedrijf 66 met de lichtbak, de ramen met occasions en inkoop en verkoop, en auto's ervoor" widths={[600, 900, 1200]} sizes="(min-width: 1280px) 700px, (min-width: 1024px) 56vw, 92vw" class="h-full max-h-[34rem] min-h-[20rem] w-full object-cover object-[50%_40%]" />
          </figure>
          <div class="kaart flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
