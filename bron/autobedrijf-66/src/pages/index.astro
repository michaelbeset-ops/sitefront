---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;

const autovoorjou = 'https://autovoorjou.nl/dealers/autobedrijf-66-1014';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Daltonstraat+8+3316+GD+Dordrecht';

const tijden = [
  ['Maandag t/m vrijdag', '09:00 – 17:00'],
  ['Zaterdag', '10:00 – 15:00'],
  ['Zondag', 'Gesloten'],
];

const custom = [
  ['Wraps', 'Je auto in een andere kleur of met een eigen design, met folie in plaats van spuitwerk.'],
  ['PPF', 'Transparante beschermfolie op de lak, tegen steenslag en krassen.'],
  ['Tint', 'Getinte ramen voor meer privacy en minder zon in de auto.'],
  ['Custom', '[[AANLEVEREN: wat valt er onder custom (velgen, details, verlichting)?]]'],
];
---
<Base
  title="Autobedrijf 66 | Occasions, inkoop en wraps in Dordrecht"
  description="Autobedrijf 66 aan de Daltonstraat 8 in Dordrecht. Occasions, auto inkoop, wraps, PPF en tint. Ma t/m vr 09:00 tot 17:00, za 10:00 tot 15:00."
>
  <!-- Hero: schermvullende foto, kop linksonder op een donkere verloop-laag zodat hij op elke foto leesbaar blijft. -->
  <section class="relative isolate bg-night text-paper">
    <div class="absolute inset-0 -z-10 [&_img]:h-full [&_img]:w-full [&_img]:object-cover">
      <Foto naam="hero" alt="SUV met matte paarse wrap" sizes="100vw" eager />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(18_18_18/0.9)_8%,rgb(18_18_18/0.45)_55%,rgb(18_18_18/0.1))]"></div>
    <div class="mx-auto max-w-[86rem] px-4 sm:px-8 min-h-[34rem] sm:min-h-[40rem] lg:min-h-[46rem] flex flex-col justify-end pt-20 pb-12 sm:pb-16">
      <h1 class="text-4xl max-w-[14ch]">Occasions, inkoop en wraps</h1>
      <div class="mt-8 grid gap-8 lg:grid-cols-12 items-end">
        <p class="lg:col-span-6 text-lg text-paper/90">Aan de Daltonstraat in Dordrecht. Koop hier je volgende auto, verkoop je huidige, of geef hem een nieuwe kleur met folie.</p>
        <div class="lg:col-span-5 lg:col-start-8 flex flex-wrap gap-3 lg:justify-end">
          <a href={u('#occasions')} class="inline-flex bg-accent text-paper font-semibold px-5 py-3 hover:bg-accent-deep transition-colors">Bekijk occasions</a>
          <a href={u('#inkoop')} class="inline-flex border border-paper/70 px-5 py-3 hover:bg-paper hover:text-ink transition-colors">Auto verkopen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Occasions: staande foto links, tekst asymmetrisch rechts. -->
  <section id="occasions" class="mx-auto max-w-[86rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12 items-center">
    <div class="lg:col-span-5 [&_img]:w-full [&_img]:h-auto">
      <Foto naam="occasion" alt="Auto met open deuren in een werkplaats" sizes="(min-width: 1024px) 38vw, 100vw" />
    </div>
    <div class="lg:col-span-6 lg:col-start-7">
      <p class="text-sm font-semibold text-accent">Occasions</p>
      <h2 class="mt-3 text-3xl">Wat er nu te koop staat</h2>
      <p class="mt-6 text-ink-soft max-w-xl">Gebruikte auto's van onder meer Ford, Citroën, Kia en MINI. Het aanbod wisselt. Bij elke auto zie je ook wat je per maand betaalt als je financiert via Auto Voor Jou.</p>
      <p class="mt-3 text-sm text-ink-soft">[[AANLEVEREN: rijklaar, garantie of APK bij aflevering?]]</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={autovoorjou} class="inline-flex bg-ink text-paper font-semibold px-5 py-3 hover:bg-accent transition-colors">Bekijk het aanbod</a>
        <a href="https://www.instagram.com/autobedrijf66_/" class="inline-flex border border-ink px-5 py-3 hover:bg-ink hover:text-paper transition-colors">Nieuw binnen op Instagram</a>
      </div>
    </div>
  </section>

  <!-- Inkoop: donkere band met een kort formulier, want verkopers willen snel een bod. -->
  <section id="inkoop" class="bg-night text-paper">
    <div class="mx-auto max-w-[86rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-sm font-semibold text-accent-light">Inkoop</p>
        <h2 class="mt-3 text-3xl">Je auto verkopen?</h2>
        <p class="mt-6 text-night-soft max-w-md">Autobedrijf 66 koopt auto's in. Vul je kenteken en kilometerstand in, dan nemen we contact met je op. Bellen mag ook.</p>
        <p class="mt-3 text-sm text-night-soft">[[AANLEVEREN: welke auto's jullie inkopen en hoe snel je een bod krijgt]]</p>
        <p class="mt-8"><a class="display text-2xl hover:text-accent-light" href="tel:+31621398284">06 21 39 82 84</a></p>
      </div>
      <form class="lg:col-span-6 lg:col-start-7 grid gap-5" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-key]]" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">Kenteken
            <input name="kenteken" required autocapitalize="characters" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper uppercase" />
          </label>
          <label class="grid gap-2 text-sm">Kilometerstand
            <input name="kilometerstand" inputmode="numeric" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper" />
          </label>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">Naam
            <input name="naam" required autocomplete="name" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper" />
          </label>
          <label class="grid gap-2 text-sm">Telefoon
            <input name="telefoon" type="tel" required autocomplete="tel" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper" />
          </label>
        </div>
        <label class="grid gap-2 text-sm">Bijzonderheden (optioneel)
          <textarea name="bericht" rows="3" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper"></textarea>
        </label>
        {voorstel ? (
          <p class="border border-accent-light px-4 py-3 text-sm">Dit is een ontwerpvoorstel, dus het formulier verstuurt nog niets. Bel <a class="underline" href="tel:+31621398284">06 21 39 82 84</a> of mail <a class="underline break-all" href="mailto:autobedrijf66@gmail.com">autobedrijf66@gmail.com</a>.</p>
        ) : (
          <button type="submit" class="justify-self-start bg-accent text-paper font-semibold px-6 py-3 hover:bg-accent-deep transition-colors">Vraag een bod aan</button>
        )}
        <p class="text-xs text-night-soft">We gebruiken je gegevens alleen voor dit bod. Zie de <a class="underline" href={u('privacy/')}>privacyverklaring</a>.</p>
      </form>
    </div>
  </section>

  <!-- Wraps, PPF, tint, custom: brede foto boven een typografische lijst, geen kaartjes. -->
  <section id="custom" class="mx-auto max-w-[86rem] px-4 sm:px-8 py-20 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-12 items-end">
      <div class="lg:col-span-5">
        <p class="text-sm font-semibold text-accent">Wraps · PPF · Tint · Custom</p>
        <h2 class="mt-3 text-3xl">Een nieuwe kleur, zonder spuitcabine</h2>
      </div>
      <p class="lg:col-span-5 lg:col-start-8 text-ink-soft">Kom langs met je idee, of stuur een bericht met wat je in gedachten hebt. [[AANLEVEREN: ook voor auto's die niet bij jullie gekocht zijn?]]</p>
    </div>
    <div class="mt-12 [&_img]:w-full [&_img]:h-auto">
      <Foto naam="wrap" alt="Beschermfolie wordt rond een koplamp aangebracht" sizes="(min-width: 1376px) 1312px, 100vw" />
    </div>
    <dl class="mt-12 grid gap-x-12 md:grid-cols-2 border-t-2 border-ink">
      {custom.map(([naam, uitleg]) => (
        <div class="py-6 border-b border-line grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-4">
          <dt class="display text-xl">{naam}</dt>
          <dd class="text-ink-soft">{uitleg}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Contact en openingstijden. -->
  <section id="contact" class="bg-paper-2">
    <div class="mx-auto max-w-[86rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Langskomen</h2>
        <p class="mt-6">Daltonstraat 8<br />3316 GD Dordrecht</p>
        <p class="mt-1 text-sm text-ink-soft">Op bedrijventerrein Dordtse Kil, vlak bij de A16.</p>
        <a href={route} class="mt-4 inline-block font-semibold underline">Plan je route</a>
        <p class="mt-8 leading-8">
          <a class="font-semibold hover:text-accent" href="tel:+31621398284">06 21 39 82 84</a><br />
          <a class="hover:text-accent" href="tel:+31651750325">06 51 75 03 25</a><br />
          <a class="hover:text-accent break-all" href="mailto:autobedrijf66@gmail.com">autobedrijf66@gmail.com</a>
        </p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <h3 class="text-2xl">Openingstijden</h3>
        <dl class="mt-6 border-t-2 border-ink">
          {tijden.map(([dag, tijd]) => (
            <div class="flex justify-between gap-4 py-3 border-b border-line">
              <dt>{dag}</dt>
              <dd class={tijd === 'Gesloten' ? 'text-ink-soft' : 'font-semibold tabular-nums'}>{tijd}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-8 text-sm text-ink-soft">Nieuw binnen en net opgeleverd werk zie je het eerst op <a class="underline text-ink" href="https://www.instagram.com/autobedrijf66_/">Instagram</a> en <a class="underline text-ink" href="https://www.tiktok.com/@autobedrijf66">TikTok</a>.</p>
      </div>
    </div>
  </section>
</Base>
