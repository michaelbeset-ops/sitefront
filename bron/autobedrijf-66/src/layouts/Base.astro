---
import '../styles/global.css';
// Voorladen voorkomt dat de grote kop verspringt als het font binnenkomt (CLS).
import display from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import body from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;
const og = new URL(u('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {voorstel && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content="nl_NL" />
  <meta name="theme-color" content="#121212" />
  {[display, body].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('sitemap-index.xml')} />
  {!voorstel && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'AutoDealer',
      name: 'Autobedrijf 66',
      telephone: '+31621398284',
      email: 'autobedrijf66@gmail.com',
      address: { '@type': 'PostalAddress', streetAddress: 'Daltonstraat 8', postalCode: '3316 GD', addressLocality: 'Dordrecht', addressCountry: 'NL' },
      openingHours: ['Mo-Fr 09:00-17:00', 'Sa 10:00-15:00'],
    })} />
  )}
</head>
<body>
  <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-accent text-paper px-4 py-2">Naar de inhoud</a>
  {voorstel && (
    <div class="bg-ink text-paper text-xs">
      <p class="mx-auto max-w-[86rem] px-4 sm:px-8 py-2">
        Ontwerpvoorstel van <a class="underline" href="https://www.sitefront.nl">Sitefront</a> voor Autobedrijf 66. Dit is niet de officiële website.
      </p>
    </div>
  )}

  <header class="sticky top-0 z-30 bg-paper/95 border-b border-line">
    <div class="mx-auto max-w-[86rem] px-4 sm:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
      <a href={u()} class="flex items-baseline gap-1 leading-none">
        <span class="display text-[1.35rem] sm:text-[1.6rem] tracking-[-0.03em]">Autobedrijf</span>
        <span class="display text-[1.8rem] sm:text-[2.1rem] text-accent">66</span>
      </a>
      <nav aria-label="Hoofdmenu" class="flex items-center gap-7 text-sm font-medium">
        <a class="hidden lg:inline hover:text-accent" href={u('#occasions')}>Occasions</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#inkoop')}>Auto verkopen</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#custom')}>Wraps &amp; PPF</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#contact')}>Contact</a>
        <a href="tel:+31621398284" class="inline-flex items-center gap-2 bg-ink text-paper px-3 sm:px-4 py-2 hover:bg-accent transition-colors">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>
          <span class="whitespace-nowrap"><span class="max-[359px]:sr-only">06 21 39 82 84</span><span class="min-[360px]:hidden">Bel</span></span>
        </a>
      </nav>
    </div>
  </header>

  <main id="inhoud">
    <slot />
  </main>

  <footer class="bg-night text-paper">
    <div class="mx-auto max-w-[86rem] px-4 sm:px-8 pt-16 pb-10 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="display text-[2.4rem]">Autobedrijf <span class="text-accent-light">66</span></p>
        <p class="mt-4 max-w-sm text-sm text-night-soft">Inkoop en verkoop van auto's. Wraps, PPF, tint en custom werk. Daltonstraat 8, Dordrecht.</p>
      </div>
      <div class="md:col-span-4 text-sm leading-7">
        <p>Daltonstraat 8<br />3316 GD Dordrecht</p>
        <p class="mt-3">
          <a class="hover:underline" href="tel:+31621398284">06 21 39 82 84</a><br />
          <a class="hover:underline" href="tel:+31651750325">06 51 75 03 25</a><br />
          <a class="hover:underline break-all" href="mailto:autobedrijf66@gmail.com">autobedrijf66@gmail.com</a>
        </p>
      </div>
      <div class="md:col-span-3 text-sm leading-7">
        <p><a class="hover:underline" href="https://www.instagram.com/autobedrijf66_/">Instagram</a></p>
        <p><a class="hover:underline" href="https://www.tiktok.com/@autobedrijf66">TikTok</a></p>
        <p class="mt-3"><a class="hover:underline" href={u('privacy/')}>Privacyverklaring</a></p>
        <p class="text-night-soft">KvK [[AANLEVEREN: KvK-nummer]]</p>
      </div>
    </div>
    <div class="mx-auto max-w-[86rem] px-4 sm:px-8 pb-8">
      <p class="border-t border-ink-soft pt-6 text-xs text-night-soft">© {new Date().getFullYear()} Autobedrijf 66</p>
    </div>
  </footer>
</body>
</html>
