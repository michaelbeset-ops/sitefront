---
import '../styles/global.css';
// Voorladen voorkomt dat de grote kop verspringt als het font binnenkomt.
import kopUrl from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import sansUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { site, url, tijden } from '../data/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const og = new URL(url('og.jpg'), Astro.site).href;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={kopUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    {!site.voorstel && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'AutoDealer',
        name: site.naam,
        telephone: '+31651750325',
        email: site.mail,
        address: { '@type': 'PostalAddress', streetAddress: site.straat, postalCode: site.postcode, addressLocality: site.plaats, addressCountry: 'NL' },
        openingHours: ['Mo-Fr 09:00-17:00', 'Sa 10:00-15:00'],
        sameAs: [site.instagram],
      })} />
    )}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-[4.5rem] md:pb-0">
    {site.voorstel && (
      <div class="relative z-50 bg-rood text-white">
        <p class="wrap py-2 text-xs leading-snug" style="font-family: system-ui, sans-serif">
          Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website.{" "}
          <a href="https://www.sitefront.nl" class="font-bold underline underline-offset-2">sitefront.nl</a>
        </p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-sm focus:bg-wit focus:px-4 focus:py-2">Naar de inhoud</a>
    <slot />
    <script define:vars={{ tijden }}>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.rijs').forEach((el) => io.observe(el));

      // Openingstijden: vandaag markeren en live open/dicht tonen (Nederlandse tijd).
      const nu = new Date();
      const deel = (o) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', ...o }).format(nu);
      const dag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(deel({ weekday: 'short' }));
      const min = Number(deel({ hour: '2-digit', hourCycle: 'h23' })) * 60 + Number(deel({ minute: '2-digit' }));
      const t = tijden.find((x) => x.dag === dag);
      const open = !!t && t.van > 0 && min >= t.van && min < t.tot;
      const namen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
      let tekst;
      if (open) tekst = `Nu open, tot ${t.dicht} uur`;
      else if (t && t.van > 0 && min < t.van) tekst = `Gesloten, vandaag open vanaf ${t.open} uur`;
      else {
        let m = (dag + 1) % 7; while (!tijden.find((x) => x.dag === m).van) m = (m + 1) % 7;
        const v = tijden.find((x) => x.dag === m);
        tekst = `Gesloten, ${m === (dag + 1) % 7 ? 'morgen' : namen[m]} open vanaf ${v.open} uur`;
      }
      document.querySelectorAll('[data-status]').forEach((el) => { el.textContent = tekst; el.closest('[data-status-wrap]')?.setAttribute('data-open', String(open)); });
      document.querySelectorAll(`[data-dag="${dag}"]`).forEach((r) => r.setAttribute('data-vandaag', ''));
    </script>
  </body>
</html>
