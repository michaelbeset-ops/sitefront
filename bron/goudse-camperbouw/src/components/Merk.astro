---
// Woordmerk naar hun logo: het rode hefdak, GOUDSE en Camperbouw.
import { url } from '../data/site';
import Hefdak from './Hefdak.astro';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`flex items-end gap-2 no-underline sm:gap-2.5 ${donker ? 'text-inkt' : 'text-wit'}`} aria-label="Goudse Camperbouw, naar de homepage">
  <Hefdak class="h-6 w-auto sm:h-7 md:h-8" />
  <span class="kop whitespace-nowrap text-[1.4rem] leading-[.8] sm:text-[1.6rem] md:text-[1.85rem]"><span class={donker ? 'text-rood' : 'text-rood-licht'}>Goudse</span> Camperbouw</span>
</a>
