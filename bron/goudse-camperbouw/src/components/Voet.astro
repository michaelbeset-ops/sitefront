---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-zwart text-staal">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Gespecialiseerd in het ombouwen van bestelwagens tot campers.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Wat we doen</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={url('#hefdak')} class="link link-licht">Hefdaken</a></li>
        <li><a href={url('#bouwen')} class="link link-licht">Bus ombouwen tot camper</a></li>
        <li><a href={url('#maatwerk')} class="link link-licht">Tafels en meubels op maat</a></li>
        <li><a href={site.facebook} class="link link-licht">Facebook</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode}</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <a href={waHoi} class="link link-licht">(ook WhatsApp)</a></p>
      <p class="mt-1.5 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Open</p>
      <p class="num mt-4">ma t/m do 09:00 tot 17:00</p>
      <p class="mt-1.5">vr gesloten</p>
      <p class="num mt-1.5">za 09:00 tot 17:00</p>
      <p class="num mt-1.5">zo 13:00 tot 17:00</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en foto's van jullie Facebook-pagina en Google-profiel (foto's van eigenaar). Reviews letterlijk van Google (stand 9 oktober 2026).</p>}
</footer>
