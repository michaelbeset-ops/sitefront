---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Hefdak from '../components/Hefdak.astro';
import { site, reviews, grootCitaat, tijden, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import explorer from '../assets/explorer.jpg';
import expert from '../assets/expert.jpg';
import vito from '../assets/vito.jpg';
import wand from '../assets/wand.jpg';
import tafels from '../assets/tafels.jpg';

// Onderdelen: alleen wat in reviews of op hun eigen Facebook genoemd wordt.
const delen = [
  ['hefdak', 'Hefdak'],
  ['raam', 'Hefdak met raam'],
  ['dak', 'Dak verhogen'],
  ['dakraam', 'Dakraam'],
  ['keuken', 'Keuken'],
  ['kast', 'Kast op maat'],
  ['bed', 'Bank die uitklapt tot bed'],
  ['tafel', 'Tafel op maat'],
  ['wand', 'Wandbekleding en vloer'],
] as const;
const soorten = [
  ['ombouwen', 'Mijn bus ombouwen tot camper'],
  ['hefdak', 'Alleen een hefdak'],
  ['meubel', 'Tafel of meubel op maat'],
  ['kopen', 'Een camper kopen'],
] as const;
const nr = (id: string) => delen.findIndex(([d]) => d === id) + 1;
---
<Base title="Goudse Camperbouw | Bus ombouwen tot camper, hefdaken | Haastrecht" description="Goudse Camperbouw in Haastrecht is gespecialiseerd in het ombouwen van bestelwagens tot campers. Ook hefdaken en tafels op maat.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: hun eigen omslagfoto, een bus met uitgeklapt hefdak -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-zwart text-wit">
      <Image src={hero} alt="Donkere bus met uitgeklapt hefdak op een erf, met een groene loods erachter" widths={[640, 1024, 1385]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover object-[54%_50%] md:object-[50%_42%]" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#16191ad9_0%,#16191a33_22%,#16191a59_45%,#16191ae0_70%,#16191af7_100%)] md:bg-[linear-gradient(90deg,#16191ae6_0%,#16191a99_34%,#16191a14_62%),linear-gradient(0deg,#16191ad9_0%,transparent_45%)]"></div>
      <div class="wrap pb-14 pt-36 md:pb-20">
        <p class="text-base font-semibold text-staal">Camperbouw in Haastrecht</p>
        <h1 id="inhoud" class="mt-3 max-w-[11ch] text-hero">Van bestel&shy;wagen tot <span class="text-rood-licht">camper</span></h1>
        <div class="mt-8 flex flex-col gap-8 md:mt-10 md:flex-row md:items-end md:justify-between">
          <div class="max-w-xl">
            <p class="text-lg leading-relaxed text-wit/90 md:text-xl">Gespecialiseerd in het ombouwen van bestelwagens tot campers. Ook hefdaken en meubels op maat.</p>
            <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
              <a href="#bouwen" class="knop knop-rood">Teken je camper<Icoon naam="pijl" /></a>
              <a href={site.telHref} class="num link link-licht font-semibold text-wit">of bel {site.tel}</a>
            </div>
          </div>
          <p class="tape hidden self-end md:block">Hefdak, uitgeklapt</p>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- 2. Het hefdak -->
    <section id="hefdak" class="py-24 md:py-36">
      <div class="wrap grid gap-y-8 md:grid-cols-12 md:gap-x-8">
        <h2 class="rijs text-4xl md:col-span-6">Het hefdak.</h2>
        <p class="rijs max-w-md text-lg text-potlood md:col-span-5 md:col-start-8 md:self-end" style="--d:.1s">Sta-ruimte en licht in je bus. Ook plat, of met een raam erin.</p>
      </div>

      <figure class="rijs wrap mt-14 md:mt-20">
        <div class="maat mb-4" aria-hidden="true"><Hefdak class="h-5 w-auto text-inkt" /></div>
        <Image src={explorer} alt="Zilvergrijze bus met hoog dak en daarop een uitgeklapt hefdak met schaarstangen" widths={[640, 1024, 1600]} sizes="(min-width: 1344px) 1264px, 100vw" class="aspect-[16/7] w-full rounded-sm object-cover object-[50%_40%] md:aspect-[16/6.5]" />
        <figcaption class="mt-4"><span class="tape">Hefdak op een bus</span></figcaption>
      </figure>

      <div class="wrap mt-16 grid gap-y-14 md:mt-24 md:grid-cols-12 md:gap-x-8">
        <figure class="rijs min-w-0 md:col-span-7">
          <Image src={expert} alt="Witte bestelwagen met uitgeklapt hefdak in de werkplaats, met een houten vide erboven" widths={[480, 800, 1200]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[16/10] w-full rounded-sm object-cover" />
          <figcaption class="mt-4"><span class="tape">In de werkplaats</span></figcaption>
        </figure>
        <figure class="rijs min-w-0 md:col-span-5 md:mt-40" style="--d:.12s">
          <Image src={vito} alt="Donkere bus met blauw hefdak, uitgeklapt, in de werkplaats" widths={[480, 800, 1059]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[2/1] w-full rounded-sm object-cover" />
          <figcaption class="mt-4 flex flex-wrap items-baseline justify-between gap-3">
            <span class="tape">De schaarstangen</span>
            <a href={waMet('Hallo Goudse Camperbouw, ik wil graag een hefdak op mijn bus. Mijn bus is een: ')} class="link text-sm font-semibold">Vraag naar een hefdak</a>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. Wow: de bouwtekening die meegroeit -> WhatsApp -->
    <section id="bouwen" class="papier border-y border-lijn-licht py-24 md:py-32" aria-labelledby="bouwen-kop">
      <div class="wrap">
        <div class="grid gap-y-6 md:grid-cols-12 md:gap-x-8">
          <h2 id="bouwen-kop" class="rijs text-4xl md:col-span-6">Teken je camper.</h2>
          <p class="rijs max-w-md text-lg text-potlood md:col-span-5 md:col-start-8 md:self-end" style="--d:.1s">Kies je bus en wat erin moet. Daarna nemen we je plannen samen door.</p>
        </div>

        <form id="tekening" class="mt-14 grid gap-y-12 md:mt-20 lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-12" novalidate>
          <!-- De tekening -->
          <div class="lg:col-span-7 lg:row-start-1">
            <div>
              <svg class="tek w-full" viewBox="0 0 400 210" role="img" aria-labelledby="tek-titel">
                <title id="tek-titel">Zijaanzicht van een bus; gekozen onderdelen kleuren rood</title>
                <!-- verhoogd dak -->
                <path class="d d-vul" data-deel="dak" d="M46 66 V50 Q46 46 50 46 H284 Q292 46 296 54 L300 66 Z" fill="none" stroke-width="1.5" stroke-dasharray="4 3" />
                <!-- hefdak (klapt op als gekozen) -->
                <g class="dak-op" data-deel="hefdak raam">
                  <path class="d d-vul" data-deel="hefdak raam" d="M84 66 L96 26 H252 L262 32 L258 66" fill="none" stroke-width="1.6" />
                  <path class="d" data-deel="hefdak raam" d="M104 64 L134 30 M134 64 L104 30 M214 64 L244 30 M244 64 L214 30" stroke-width="1.3" />
                  <rect class="d d-vul" data-deel="raam" x="150" y="36" width="52" height="18" rx="2" fill="none" stroke-width="1.5" />
                </g>
                <!-- dakraam -->
                <rect class="d d-vul" data-deel="dakraam" x="266" y="60" width="22" height="6" rx="1" fill="none" stroke-width="1.5" />
                <!-- carrosserie -->
                <path d="M40 160 V72 Q40 66 46 66 H292 Q302 66 308 74 L340 112 L362 119 Q370 122 370 132 V160 Z" fill="#ffffff" stroke="#16191a" stroke-width="2" stroke-linejoin="round" />
                <path d="M300 76 L330 112 H300 Z" fill="none" stroke="#16191a" stroke-width="1.4" stroke-linejoin="round" />
                <path d="M290 72 V160" stroke="#16191a" stroke-width="1.2" />
                <!-- wand en vloer -->
                <path class="d" data-deel="wand" d="M50 150 H284" stroke-width="3" />
                <path class="d" data-deel="wand" d="M50 76 H284 M50 76 V150" stroke-width="1.2" stroke-dasharray="2 3" fill="none" />
                <!-- bank / bed -->
                <path class="d d-vul" data-deel="bed" d="M56 124 H140 V150 H56 Z M56 96 H66 V124 H56 Z" fill="none" stroke-width="1.5" />
                <path class="d" data-deel="bed" d="M60 137 H136" stroke-width="1" stroke-dasharray="3 3" />
                <path class="d" data-deel="bed" d="M140 120 H196 V126 H140" fill="none" stroke-width="1.2" stroke-dasharray="4 3" />
                <!-- tafel -->
                <path class="d" data-deel="tafel" d="M150 116 H186 M168 116 V150 M160 150 H176" stroke-width="2" fill="none" />
                <!-- keuken -->
                <path class="d d-vul" data-deel="keuken" d="M210 112 H280 V150 H210 Z" fill="none" stroke-width="1.5" />
                <path class="d" data-deel="keuken" d="M224 112 V106 Q224 102 230 102 H234 M245 131 H280 M245 112 V150" stroke-width="1.3" fill="none" />
                <!-- kast -->
                <path class="d d-vul" data-deel="kast" d="M210 78 H280 V96 H210 Z" fill="none" stroke-width="1.5" />
                <path class="d" data-deel="kast" d="M245 78 V96" stroke-width="1.1" />
                <!-- wielen -->
                <g fill="#eef0ef" stroke="#16191a" stroke-width="2"><circle cx="100" cy="162" r="19" /><circle cx="316" cy="162" r="19" /></g>
                <g fill="#16191a"><circle cx="100" cy="162" r="6" /><circle cx="316" cy="162" r="6" /></g>
                <path d="M10 182 H392" stroke="#16191a" stroke-width="1" />
                <!-- nummers met aanwijslijnen -->
                {[
                  ['hefdak', 112, 12, 112, 30], ['raam', 176, 12, 176, 36], ['dak', 30, 40, 46, 52], ['dakraam', 300, 44, 284, 60],
                  ['kast', 312, 88, 280, 88], ['keuken', 300, 140, 280, 136], ['bed', 30, 120, 56, 128], ['tafel', 168, 196, 168, 150], ['wand', 232, 196, 232, 150],
                ].map(([id, x, y, lx, ly]) => (
                  <g data-deel={String(id)}>
                    <path d={`M${x} ${y} L${lx} ${ly}`} stroke="#16191a59" stroke-width="1" />
                    <circle class="nr" data-deel={String(id)} cx={x} cy={y} r="8.5" stroke-width="1.2" />
                    <text class="nrt" data-deel={String(id)} x={x} y={Number(y) + 3.8} text-anchor="middle">{nr(String(id))}</text>
                  </g>
                ))}
              </svg>
              <p class="maat mt-6" aria-hidden="true">zijaanzicht, niet op schaal</p>
            </div>
          </div>

          <!-- De keuzes -->
          <div class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1">
            <fieldset>
              <legend class="kop text-2xl">Wat wil je?</legend>
              <div class="soort mt-4">
                {soorten.map(([v, t], i) => (
                  <label><input type="radio" name="soort" value={v} checked={i === 0} /><i></i>{t}</label>
                ))}
              </div>
            </fieldset>

            <div class="mt-10">
              <label for="bus" class="veld-label" data-bus-label>Welke bus heb je?</label>
              <input id="bus" name="bus" class="veld" autocomplete="off" placeholder="Merk, type en bouwjaar" />
            </div>

            <fieldset class="mt-10" data-delen>
              <legend class="kop text-2xl">Wat moet erin?</legend>
              <div class="mt-3">
                {delen.map(([id, t], i) => (
                  <label class="deel"><input type="checkbox" name="deel" value={id} data-tekst={t} /><b>{i + 1}</b><span>{t}</span></label>
                ))}
              </div>
            </fieldset>

            <div class="mt-10">
              <label for="noot" class="veld-label">Nog iets?</label>
              <textarea id="noot" name="noot" class="veld" rows="3" placeholder="Bijvoorbeeld hoe je wilt slapen, of een foto die je meestuurt"></textarea>
            </div>
            <div class="mt-6">
              <label for="naam" class="veld-label">Je naam</label>
              <input id="naam" name="naam" class="veld" autocomplete="name" />
            </div>

          </div>
          <div class="border-t-2 border-inkt pt-6 lg:col-span-7 lg:row-start-2 lg:self-start lg:max-w-xl">
              <p class="veld-label">Je bericht</p>
              <p class="whitespace-pre-line text-[.97rem] leading-relaxed" data-voorbeeld aria-live="polite"></p>
              <a href={waMet('Hallo Goudse Camperbouw, ik wil mijn bus laten ombouwen tot camper.')} class="knop knop-rood mt-6 w-full" data-stuur><Icoon naam="wa" />Stuur via WhatsApp</a>
              <p class="mt-3 text-xs text-potlood">Opent WhatsApp. Er wordt pas iets verstuurd als je het daar zelf verstuurt.</p>
            </div>
        </form>
      </div>
    </section>

    <!-- 4. Ervaringen -->
    <section id="ervaringen" class="bg-zwart py-24 text-wit md:py-36">
      <div class="wrap">
        <figure class="rijs md:grid md:grid-cols-12 md:gap-x-8">
          <blockquote class="md:col-span-10">
            <p class="text-3xl leading-[1.18] font-medium tracking-[-0.01em]">“{grootCitaat.tekst}”</p>
          </blockquote>
          <figcaption class="mt-8 text-sm text-staal md:col-span-12">{grootCitaat.naam}, over de ombouw van hun bus</figcaption>
        </figure>

        <div class="mt-20 grid gap-x-12 md:mt-28 md:grid-cols-2">
          {reviews.map((r, i) => (
            <figure class="rijs regel-donker py-8" style={`--d:${(i % 2) * 0.08}s`}>
              <blockquote><p class="text-lg leading-relaxed text-wit/90">“{r.tekst}”</p></blockquote>
              <figcaption class="mt-4 text-sm text-staal">{r.naam}</figcaption>
            </figure>
          ))}
        </div>
        <p class="regel-donker pt-8 text-sm text-staal">
          <a href={site.reviews} class="link link-licht inline-flex items-center gap-2"><Icoon naam="g" class="h-4 w-4" /><span class="num">{site.google.score} op Google, {site.google.aantal} reviews</span></a>
        </p>
      </div>
    </section>

    <!-- 5. Maatwerk voor thuis (hun recente Facebook-posts) -->
    <section id="maatwerk" class="py-24 md:py-36">
      <div class="wrap grid gap-y-8 md:grid-cols-12 md:gap-x-8">
        <h2 class="rijs text-4xl md:col-span-7">Ook op maat voor thuis.</h2>
      </div>
      <div class="wrap mt-14 grid gap-y-12 md:mt-20 md:grid-cols-12 md:gap-x-8">
        <figure class="rijs min-w-0 md:col-span-7">
          <Image src={wand} alt="Grote zwarte wand op maat met nissen en een uitsparing voor de tv, in de werkplaats" widths={[480, 800, 1200, 1600]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
          <figcaption class="mt-4"><span class="tape">Een wand op maat, in de werkplaats</span></figcaption>
        </figure>
        <div class="min-w-0 md:col-span-4 md:col-start-9">
          <figure class="rijs" style="--d:.1s">
            <Image src={tafels} alt="Twee witte tafels met golvend blad en geribbelde voet in de werkplaats" widths={[400, 700, 1000]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
          </figure>
          <blockquote class="rijs mt-10" style="--d:.15s">
            <p class="text-xl leading-snug">“De tafel is volledig aan te passen naar jouw wensen: formaat, kleur en afwerking.”</p>
            <footer class="mt-3 text-sm text-potlood">Goudse Camperbouw op Facebook</footer>
          </blockquote>
          <p class="mt-8"><a href={waMet('Hallo Goudse Camperbouw, ik heb interesse in een tafel op maat. Wat ik zoek: ')} class="knop knop-rand"><Icoon naam="wa" />Vraag naar een tafel op maat</a></p>
        </div>
      </div>
    </section>

    <!-- 6. Contact, route en tijden -->
    <section id="contact" class="papier border-t border-lijn-licht py-24 md:py-32">
      <div class="wrap grid gap-y-14 md:grid-cols-12 md:gap-x-8">
        <div class="md:col-span-6">
          <h2 class="rijs text-4xl">Langskomen in Haastrecht.</h2>
          <p class="rijs mt-6 max-w-md text-lg text-potlood" style="--d:.1s">Bel of app even, dan maken we een afspraak.</p>
          <address class="rijs mt-10 not-italic" style="--d:.15s">
            <p class="kop text-3xl leading-none">{site.straat}<br />{site.postcode}</p>
          </address>
          <div class="rijs mt-10 flex flex-wrap gap-3" style="--d:.2s">
            <a href={waMet('Hallo Goudse Camperbouw, ik wil graag een keer langskomen.')} class="knop knop-rood"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand num"><Icoon naam="tel" />{site.tel}</a>
            <a href={site.route} class="knop knop-rand"><Icoon naam="pin" />Route</a>
          </div>
          <p class="mt-6 text-sm text-potlood"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
        </div>
        <div class="rijs md:col-span-5 md:col-start-8" style="--d:.1s">
          <div class="flex items-baseline justify-between border-b-2 border-inkt pb-3">
            <p class="kop text-2xl">Open</p>
            <p class="text-sm font-semibold" data-status></p>
          </div>
          <table class="num w-full text-[1rem]">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map((t) => (
                <tr class="border-b border-lijn-licht" data-dag={t.dag} data-van={t.van} data-tot={t.tot}>
                  <th scope="row" class="py-3 text-left font-medium">{t.naam}</th>
                  <td class="py-3 text-right">{t.van ? `${t.van} tot ${t.tot}` : 'gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-6 text-sm text-potlood">Ook op <a href={site.facebook} class="link">Facebook</a>.</p>
        </div>
      </div>
    </section>
  </main>

  <Voet />

  <script>
    import { waMet } from '../data/site';
    // Openingstijden: vandaag markeren + nu open/gesloten
    const nu = new Date();
    const min = nu.getHours() * 60 + nu.getMinutes();
    const m = (s: string) => { const [h, mm] = s.split(':').map(Number); return h * 60 + mm; };
    document.querySelectorAll<HTMLTableRowElement>('tr[data-dag]').forEach((tr) => {
      if (Number(tr.dataset.dag) !== nu.getDay()) return;
      tr.classList.add('font-bold');
      tr.querySelector('th')?.insertAdjacentHTML('beforeend', ' <span class="ml-1 text-xs font-semibold text-rood">vandaag</span>');
      const st = document.querySelector('[data-status]');
      if (st) { const open = !!tr.dataset.van && min >= m(tr.dataset.van) && min < m(tr.dataset.tot || '0:0'); st.textContent = open ? 'Nu open' : 'Nu gesloten'; st.className = `text-sm font-semibold ${open ? 'text-rood' : 'text-potlood'}`; }
    });

    // Bouwtekening
    const f = document.querySelector<HTMLFormElement>('#tekening');
    if (f) {
      const svg = f.querySelector<SVGSVGElement>('svg.tek')!;
      const voorbeeld = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
      const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const busLabel = f.querySelector<HTMLElement>('[data-bus-label]')!;
      const delenSet = f.querySelector<HTMLFieldSetElement>('[data-delen]')!;
      const zin: Record<string, string> = {
        ombouwen: 'ik wil mijn bus laten ombouwen tot camper.',
        hefdak: 'ik wil graag een hefdak op mijn bus.',
        meubel: 'ik wil graag een tafel of meubel op maat laten maken.',
        kopen: 'ik ben op zoek naar een camper. Hebben jullie er een te koop?',
      };
      const tekenen = () => {
        const soort = (f.querySelector<HTMLInputElement>('input[name=soort]:checked')?.value) || 'ombouwen';
        const gekozen = [...f.querySelectorAll<HTMLInputElement>('input[name=deel]:checked')];
        const ids = new Set(gekozen.map((c) => c.value));
        if (soort === 'hefdak' && !ids.has('raam')) ids.add('hefdak');
        svg.querySelectorAll<SVGElement>('[data-deel]').forEach((el) => {
          const aan = (el.dataset.deel || '').split(' ').some((d) => ids.has(d));
          el.classList.toggle('aan', aan);
        });
        delenSet.hidden = soort === 'meubel' || soort === 'kopen';
        busLabel.textContent = soort === 'kopen' ? 'Wat voor camper zoek je?' : soort === 'meubel' ? 'Wat wil je laten maken?' : 'Welke bus heb je?';
        const bus = (f.querySelector<HTMLInputElement>('#bus')?.value || '').trim();
        const noot = (f.querySelector<HTMLTextAreaElement>('#noot')?.value || '').trim();
        const naam = (f.querySelector<HTMLInputElement>('#naam')?.value || '').trim();
        const r = [`Hallo Goudse Camperbouw, ${zin[soort]}`];
        if (bus) r.push(`${soort === 'kopen' ? 'Wat ik zoek' : soort === 'meubel' ? 'Wat ik zoek' : 'Mijn bus'}: ${bus}`);
        if (!delenSet.hidden && gekozen.length) r.push(`Wensen: ${gekozen.map((c) => (c.dataset.tekst || '').toLowerCase()).join(', ')}`);
        if (noot) r.push(noot);
        if (naam) r.push(`Groet, ${naam}`);
        const tekst = r.join('\n');
        voorbeeld.textContent = tekst;
        stuur.href = waMet(tekst);
      };
      f.addEventListener('input', tekenen);
      f.addEventListener('change', tekenen);
      f.addEventListener('submit', (e) => e.preventDefault());
      tekenen();
    }
  </script>
</Base>
