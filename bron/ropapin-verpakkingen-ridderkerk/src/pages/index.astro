---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, wa, vademecum, assortiment } from '../data/site';

import rollenBand from '../assets/rollen-band.jpg';
import rollenBandStaand from '../assets/rollen-band-staand.jpg';
import rollenZilver from '../assets/rollen-zilver.jpg';
import hout from '../assets/hout-gestapeld.jpg';
import rekfolie from '../assets/rekfolie.jpg';
import karton from '../assets/karton.jpg';
import blauwePallet from '../assets/blauwe-pallet.jpg';
import pand from '../assets/pand.jpg';
import interpack from '../assets/interpack.jpg';

const heroMobiel = await getImage({ src: rollenBandStaand, widths: [480, 640], format: 'webp', quality: 62 });
const heroBreed = await getImage({ src: rollenBand, widths: [960, 1280, 1632], sizes: '100vw', format: 'webp', quality: 72 });

const voorbeeldStart = 'Goedendag Arnold,\n\nIk heb een verpakkingsvraag.\n\nKunt u met mij meedenken?';
const waArnold = wa('Goedendag Arnold, ik heb een vraag over verpakkingsmateriaal.');

const titel = 'Ropapin Verpakkingen | Verpakkingsmaterialen en palletstabilisatie, Ridderkerk';
const omschrijving = 'Groothandel in verpakkingsmaterialen voor industriële verbruikers en verpakkingshandelaren. Specialist in palletstabilisatie, 30 jaar ervaring, levering op aanvraag. Florijnstraat 6H, Ridderkerk.';

// Wow: welke van hun eigen groepen horen bij welk probleem. Alleen hun eigen assortimentsnamen.
const problemen = [
  { id: 'zakken', tekst: 'Pallets zakken in of schuiven', groepen: [5, 0, 4] },
  { id: 'schade', tekst: 'Schade tijdens transport', groepen: [2, 1, 5] },
  { id: 'folie', tekst: 'We gebruiken te veel folie', groepen: [0, 4] },
  { id: 'vast', tekst: 'Ik zoek een vaste leverancier', groepen: [0, 1, 2, 3, 4, 5] },
];
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO: hun eigen foto van rollen, vastgezet met groen omsnoeringsband -->
    <section class="relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-nacht text-wit md:min-h-[100svh]">
      <Kop />
      <picture>
        <source media="(max-width: 767px)" srcset={heroMobiel.srcSet.attribute} sizes="100vw" />
        <source media="(min-width: 768px)" srcset={heroBreed.srcSet.attribute} sizes="100vw" />
        <img src={heroBreed.src} width="1632" height="1224" alt="Zware zwarte rollen op houten balken, elk vastgezet met groen omsnoeringsband" loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover object-[30%_60%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0c100ecc_0%,#0c100e33_24%,#0c100e99_56%,#0c100ef2_100%)] md:bg-[linear-gradient(90deg,#0c100ef0_0%,#0c100ea6_40%,#0c100e1a_75%),linear-gradient(0deg,#0c100ecc_0%,#0c100e00_40%)]"></div>

      <div class="wrap mt-auto pb-10 pt-28 md:pb-14">
        <p class="text-base font-semibold text-groen-licht md:text-lg"><span class="sm:hidden">Verpakkingsmaterialen</span><span class="max-sm:hidden">Groothandel in verpakkingsmaterialen</span> · Ridderkerk</p>
        <h1 class="mt-4 max-w-[11ch] text-hero">Geen dozen&shy;schuivers.</h1>
        <p class="mt-6 max-w-xl text-lg text-wit/90 md:text-xl">Verpakkingsoplossingen op maat voor industriële verbruikers en verpakkingshandelaren. Ons specialisme: palletstabilisatie.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#verpakken" class="knop knop-groen">Wat wilt u verpakken?<Icoon naam="pijl" /></a>
          <a href={waArnold} class="knop knop-wit"><Icoon naam="wa" />WhatsApp Arnold</a>
        </div>
      </div>

      <div class="relative">
        <div class="band" aria-hidden="true"></div>
      </div>
      <div class="bg-nacht">
        <div class="wrap flex flex-wrap items-center justify-between gap-x-10 gap-y-1.5 py-4 text-sm text-wit/85 md:py-5">
          <p>Werkdagen <span class="num">08.00 tot 17.00</span> · {site.straat}, {site.plaats}</p>
          <p class="max-sm:hidden">Arnold <a href={site.arnold.href} class="num font-bold text-wit no-underline hover:text-groen-licht">{site.arnold.tel}</a> · Dirk <a href={site.dirk.href} class="num font-bold text-wit no-underline hover:text-groen-licht">{site.dirk.tel}</a></p>
        </div>
      </div>
    </section>

    <!-- 2. DAAG ONS UIT: hun eigen uitnodiging, groot gezet -->
    <section class="overflow-hidden py-20 md:py-32">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-7">
          <h2 class="rijs text-4xl">Daag ons uit.<br /><span class="text-groen-diep">Waar kunnen wij u bij helpen?</span></h2>
          <p class="rijs mt-8 max-w-xl text-lg text-grijs" style="--d:.1s">Kleine of grote aantallen, één product of al uw verpakkingsmaterialen. Wij denken actief en creatief mee over de meest efficiënte oplossing voor uw verpakkingsproces.</p>
          <p class="rijs mt-5 max-w-xl text-grijs" style="--d:.15s">Niet de goedkoopste producten, wel de beste producten met een scherpe prijs. Daarvoor werken wij samen met vele nationale en internationale leveranciers.</p>
          <div class="rijs mt-14 border-t-2 border-inkt pt-6" style="--d:.2s">
            <p class="flex flex-wrap gap-x-5 font-kop text-[clamp(2.4rem,5vw,4.2rem)] leading-none" aria-hidden="true"><span>NL</span><span class="text-groen-diep">BE</span><span>LU</span><span class="text-groen-diep">DE</span></p>
            <p class="mt-3 text-sm text-grijs">Onze klanten zitten in Nederland, België, Luxemburg en Duitsland.</p>
          </div>
        </div>
        <figure class="rijs relative lg:col-span-5 lg:-mr-24 lg:mt-6" style="--d:.1s">
          <Image src={hout} alt="Gestapelde houten planken en spaanblokken, gebundeld met groen band" quality={62} widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover" />
        </figure>
      </div>
    </section>

    <!-- 3. ASSORTIMENT: hun zes groepen als stencil-index -->
    <section id="assortiment" class="bg-folie py-20 md:py-32">
      <div class="wrap grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <h2 class="rijs text-4xl">Wat wij leveren.</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-grijs" style="--d:.1s">Geen webshop. Wij leveren op aanvraag, precies dat wat u nodig heeft.</p>
          <ol class="rijs mt-12" style="--d:.15s">
            {assortiment.map((a, i) => (
              <li class="regel"><span class="nr num">{String(i + 1).padStart(2, '0')}</span><span class="nm">{a}</span></li>
            ))}
          </ol>
          <div class="rijs mt-12 flex flex-col gap-6 sm:flex-row sm:items-center" style="--d:.2s">
            <a href={vademecum} class="knop knop-inkt"><Icoon naam="mail" />Vademecum aanvragen</a>
            <p class="max-w-sm text-sm text-grijs">Het hele assortiment staat in ons vademecum. Wij mailen het u kosteloos en proberen uw mail dezelfde dag nog te beantwoorden.</p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3 self-start lg:col-span-5 lg:mt-36 lg:grid-cols-1 lg:gap-4">
          <figure class="rijs" style="--d:.1s">
            <Image src={karton} alt="Stapel golfkarton van opzij gezien, de golven duidelijk zichtbaar" quality={60} widths={[400, 640, 900]} sizes="(min-width: 1024px) 34vw, 50vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">Kartonnage</figcaption>
          </figure>
          <figure class="rijs" style="--d:.2s">
            <Image src={rekfolie} alt="Hoek van een pallet, strak ingepakt in rekwikkelfolie" quality={62} widths={[400, 600]} sizes="(min-width: 1024px) 34vw, 50vw" class="aspect-[4/3] w-full rounded-sm object-cover lg:aspect-[16/9]" />
            <figcaption class="mt-2 text-xs text-grijs">Rekwikkelfolie</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 4. PALLETSTABILISATIE: het specialisme, donker en groot -->
    <section id="palletstabilisatie" class="relative isolate overflow-hidden bg-inkt text-wit">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="relative min-h-[60vh] lg:min-h-[52rem]">
          <Image src={rollenZilver} alt="Natte zilverkleurige rollen, vastgezet met twee groene omsnoeringsbanden" quality={62} widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[60%_40%]" />
        </div>
        <div class="flex flex-col justify-center px-5 py-20 md:px-10 lg:px-16 lg:py-28 xl:pl-20">
          <h2 class="rijs text-[clamp(2.2rem,3.4vw+.6rem,3.9rem)]">Ons specialisme:<br /><span class="text-groen-licht">pallet&shy;stabilisatie.</span></h2>
          <p class="rijs mt-8 max-w-lg text-lg text-wit/85" style="--d:.1s">Lading die stil blijft staan, van de vloer tot de klant. Met 30 jaar ervaring stellen wij daarnaast een compleet pakket op maat samen.</p>
          <figure class="rijs mt-12 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-6" style="--d:.15s">
            <Image src={blauwePallet} alt="Blauwe kunststof pallets, samengebonden met groen band en een metalen hoekbeschermer" quality={60} widths={[360, 560]} sizes="(min-width: 1024px) 22vw, 60vw" class="aspect-[4/3] w-full max-w-sm rounded-sm object-cover" />
            <figcaption class="max-w-[11rem] pb-1 text-sm text-mist">Uit ons assortiment: band, gesp en hoekbescherming.</figcaption>
          </figure>
        </div>
      </div>
      <div class="band" aria-hidden="true"></div>
    </section>

    <!-- 5. WOW: wat wilt u verpakken? Een palletlabel dat eindigt in WhatsApp aan Arnold -->
    <section id="verpakken" class="bg-nacht py-20 text-wit md:py-32">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-4">
          <h2 class="rijs text-[clamp(2.2rem,3.2vw+.5rem,3.6rem)]">Wat wilt u verpakken?</h2>
          <p class="rijs mt-6 max-w-sm text-lg text-wit/85" style="--d:.1s">Vul het label in. Arnold krijgt uw vraag via WhatsApp en denkt met u mee.</p>
          <p class="rijs mt-6 max-w-sm text-sm text-mist" style="--d:.15s">Liever bellen? Arnold <a href={site.arnold.href} class="link num text-wit">{site.arnold.tel}</a> of Dirk <a href={site.dirk.href} class="link num text-wit">{site.dirk.tel}</a>, werkdagen van 08.00 tot 17.00.</p>
          <div class="rijs mt-12 hidden lg:block" style="--d:.2s">
            <p class="text-sm font-semibold text-mist">Uw bericht aan Arnold</p>
            <p class="mt-3 whitespace-pre-line border-l-4 border-band bg-inkt-2 p-5 text-sm leading-relaxed text-wit/90" data-voorbeeld>{voorbeeldStart}</p>
          </div>
        </div>

        <form class="rijs label lg:col-span-8" style="--d:.1s" data-label novalidate>
          <div class="label-kop">
            <p class="font-kop text-xl uppercase md:text-2xl">Verpakkingsvraag</p>
            <p class="num hidden text-right text-xs font-semibold uppercase tracking-[.08em] text-grijs sm:block">Aan: Arnold de Ruijter<br />Ropapin, Ridderkerk</p>
          </div>

          <div class="vak">
            <label class="block">
              <span class="vak-titel"><b>1</b>Wat gaat er op de pallet of in de verpakking?</span>
              <input name="wat" class="invoer" type="text" autocomplete="off" placeholder="Bijv. dozen met blikwerk, rollen, losse onderdelen" />
            </label>
          </div>

          <fieldset class="vak">
            <legend class="vak-titel float-left w-full"><b>2</b>Waar loopt u tegenaan?</legend>
            <div class="vink clear-both pt-1">
              {problemen.map((p) => (
                <label><input type="checkbox" name="probleem" value={p.id} data-tekst={p.tekst} data-groepen={p.groepen.join(',')} />{p.tekst}</label>
              ))}
            </div>
          </fieldset>

          <div class="vak grid gap-x-6 gap-y-5 sm:grid-cols-2">
            <label class="block">
              <span class="vak-titel"><b>3</b>Aantallen</span>
              <input name="aantal" class="invoer" type="text" autocomplete="off" placeholder="Bijv. 40 pallets per week" />
            </label>
            <fieldset>
              <legend class="vak-titel"><b>4</b>Hoe vaak</legend>
              <div class="vink !grid-cols-2">
                <label><input type="radio" name="vaak" value="eenmalig" />Eenmalig</label>
                <label><input type="radio" name="vaak" value="regelmatig" />Regelmatig</label>
              </div>
            </fieldset>
          </div>

          <div class="vak">
            <label class="block">
              <span class="vak-titel"><b>5</b>Uw naam en bedrijf</span>
              <input name="naam" class="invoer" type="text" autocomplete="organization" placeholder="Optioneel" />
            </label>
          </div>

          <div class="relative bg-folie px-5 pb-6 pt-8 md:px-7">
            <div class="band band-dun absolute inset-x-0 top-0" aria-hidden="true"></div>
            <p class="text-sm font-bold">Hier kijken we dan naar:</p>
            <p class="mt-1 min-h-[1.6em] font-kop text-lg uppercase leading-snug text-groen-diep" data-groepen-uit aria-live="polite">Vink hierboven aan waar u tegenaan loopt.</p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a href={waArnold} class="knop knop-groen" data-wa><Icoon naam="wa" />Stuur naar Arnold</a>
              <a href={vademecum} class="knop knop-rand"><Icoon naam="mail" />Liever eerst het vademecum</a>
            </div>
            <p class="mt-4 text-xs text-grijs">Deze pagina verstuurt zelf niets. WhatsApp opent met uw bericht klaar; u verstuurt het zelf.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 6. OVER ONS: gewoon zoals het hoort -->
    <section id="over" class="py-20 md:py-32">
      <div class="wrap grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <h2 class="rijs text-4xl">Gewoon zoals<br />het hoort.</h2>
          <p class="rijs mt-8 max-w-xl text-lg text-grijs" style="--d:.1s">Arnold de Ruijter, oprichter, is al meer dan 30 jaar actief in de verpakkingsmaterialen branche. Samen met Dirk Nomen werkt hij liever met direct contact dan met een webshop: per mail, telefoon of op bezoek.</p>

          <div class="rijs mt-14 border-l-4 border-band pl-6" style="--d:.2s">
            <p class="max-w-md text-2xl leading-snug">“Verstand van producten, professioneel, meedenkend, een aanrader!”</p>
            <p class="mt-3 flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />Anja K., Google-review</p>
          </div>
        </div>
        <div class="lg:col-span-5">
          <figure class="rijs" style="--d:.1s">
            <Image src={interpack} alt="Man in colbert met een Interpack Düsseldorf-fotolijst, op de verpakkingsbeurs" quality={68} widths={[400, 720]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-square w-full rounded-sm object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">Op de Interpack in Düsseldorf.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 7. CONTACT: hun pand aan de Florijnstraat -->
    <section id="contact" class="bg-folie">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="relative min-h-[26rem] lg:order-2 lg:min-h-full">
          <Image src={pand} alt="Bedrijfsunit 6h aan de Florijnstraat in Ridderkerk met de bus van Ropapin voor de deur" quality={62} widths={[480, 720, 960]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_62%]" />
        </div>
        <div class="px-5 py-20 md:px-10 lg:px-16 lg:py-28 xl:pl-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))]">
          <h2 class="rijs text-4xl">Bel, app<br />of kom langs.</h2>
          <p class="rijs mt-6 text-lg" style="--d:.1s" data-open>Werkdagen van 08.00 tot 17.00.</p>
          <dl class="rijs mt-10 grid gap-y-7 sm:grid-cols-2 sm:gap-x-10" style="--d:.15s">
            <div>
              <dt class="font-bold">Arnold de Ruijter</dt>
              <dd class="mt-1"><a href={site.arnold.href} class="link link-diep num">{site.arnold.tel}</a></dd>
              <dd class="mt-1"><a href={waArnold} class="link link-diep">WhatsApp</a></dd>
            </div>
            <div>
              <dt class="font-bold">Dirk Nomen</dt>
              <dd class="mt-1"><a href={site.dirk.href} class="link link-diep num">{site.dirk.tel}</a></dd>
            </div>
            <div>
              <dt class="font-bold">E-mail</dt>
              <dd class="mt-1"><a href={`mailto:${site.mail}`} class="link link-diep break-all">{site.mail}</a></dd>
            </div>
            <div>
              <dt class="font-bold">Adres</dt>
              <dd class="mt-1">{site.straat}<br />{site.postcode} {site.plaats}</dd>
            </div>
          </dl>
          <div class="rijs mt-12 flex flex-wrap gap-3" style="--d:.2s">
            <a href={waArnold} class="knop knop-groen"><Icoon naam="wa" />WhatsApp Arnold</a>
            <a href={site.maps} class="knop knop-rand"><Icoon naam="pin" />Route</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { assortiment } from '../data/site';
  const f = document.querySelector<HTMLFormElement>('[data-label]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-wa]');
  const uit = document.querySelector<HTMLElement>('[data-groepen-uit]');
  const voorbeeld = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const tel = '31630198253';
  const bouw = () => {
    if (!f || !knop || !uit) return;
    const d = new FormData(f);
    const wat = String(d.get('wat') || '').trim();
    const aantal = String(d.get('aantal') || '').trim();
    const vaak = String(d.get('vaak') || '');
    const naam = String(d.get('naam') || '').trim();
    const vinkjes = [...f.querySelectorAll<HTMLInputElement>('input[name="probleem"]:checked')];
    const groepen = [...new Set(vinkjes.flatMap((v) => (v.dataset.groepen || '').split(',').map(Number)))].sort((a, b) => a - b);
    uit.textContent = groepen.length ? groepen.map((i) => assortiment[i]).join(' · ') : 'Vink hierboven aan waar u tegenaan loopt.';
    const r = ['Goedendag Arnold,', '', 'Ik heb een verpakkingsvraag.', ''];
    if (wat) r.push(`Wat: ${wat}`);
    if (vinkjes.length) r.push(`Waar ik tegenaan loop: ${vinkjes.map((v) => (v.dataset.tekst || '').toLowerCase()).join(', ')}`);
    if (aantal) r.push(`Aantallen: ${aantal}`);
    if (vaak) r.push(`Hoe vaak: ${vaak}`);
    r.push('', 'Kunt u met mij meedenken?');
    if (naam) r.push('', `Groet, ${naam}`);
    knop.href = `https://wa.me/${tel}?text=${encodeURIComponent(r.join('\n'))}`;
    if (voorbeeld) voorbeeld.textContent = r.join('\n');
  };
  f?.addEventListener('input', bouw);
  f?.addEventListener('change', bouw);
  f?.addEventListener('submit', (e) => e.preventDefault());

  // Open of dicht: werkdagen 08.00 tot 17.00 (Nederlandse tijd).
  const o = document.querySelector<HTMLElement>('[data-open]');
  if (o) {
    const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
    const dag = nu.getDay(), m = nu.getHours() * 60 + nu.getMinutes();
    const werkdag = dag >= 1 && dag <= 5;
    if (werkdag && m >= 480 && m < 1020) o.innerHTML = '<span class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-band align-middle"></span>Nu bereikbaar, tot 17.00.';
    else o.textContent = 'Nu gesloten. Werkdagen van 08.00 tot 17.00.';
  }
</script>
