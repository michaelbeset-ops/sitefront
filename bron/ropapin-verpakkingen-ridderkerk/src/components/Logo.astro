---
// Woordmerk naar hun logo: R, de O als ring met het groene blad, PAPIN, en daaronder "verpakkingen" gespatieerd.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex flex-col leading-none ${cls}`}>
  <span class="flex items-center font-kop text-[1.7rem] tracking-[.02em] md:text-[1.95rem]">
    R<span class="sr-only">O</span><svg viewBox="0 0 40 40" class="mx-[.04em] h-[.8em] w-[.8em]" aria-hidden="true"><circle cx="20" cy="20" r="15.5" fill="none" stroke="currentColor" stroke-width="6" /><path d="M10 31 C 14 20, 22 12, 32 8 C 28 18, 20 26, 10 31 Z" fill="#5ccfa5" /><path d="M11 30 31 9" stroke="currentColor" stroke-width="1.4" opacity=".5" /></svg>PAPIN
  </span>
  <span class="mt-1 pl-[.1em] text-[.72rem] font-medium tracking-[.42em] md:text-[.8rem]">verpakkingen</span>
</span>
