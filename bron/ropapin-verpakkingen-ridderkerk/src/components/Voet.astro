---
import { site, url, assortiment, vademecum } from '../data/site';
import Logo from './Logo.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-nacht text-mist">
  <div class="band band-dun" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <span class="text-wit"><Logo /></span>
      <p class="mt-6 max-w-xs">Groothandel in verpakkingsmaterialen voor industriële verbruikers en verpakkingshandelaren. Geen webshop: wij leveren op aanvraag.</p>
      <p class="mt-5"><a href={vademecum} class="link">Vademecum aanvragen</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Assortiment</p>
      <ul class="mt-4 space-y-1.5">
        {assortiment.map((a) => <li>{a}</li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3">Arnold: <a href={site.arnold.href} class="link num">{site.arnold.tel}</a></p>
      <p class="mt-1.5">Dirk: <a href={site.dirk.href} class="link num">{site.dirk.tel}</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <p class="mt-4">Werkdagen<br /><span class="num">08.00 tot 17.00</span></p>
      <p class="mt-3"><a href={site.maps} class="link">Route</a></p>
      <p class="mt-1.5"><a href={site.facebook} class="link">Facebook</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-groen-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en foto’s van ropapin-verpakkingen.nl, wathebbienou.nl, jullie Google-profiel en Facebookpagina (stand 7 oktober 2026).</p>}
</footer>
