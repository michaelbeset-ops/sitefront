---
import { url, site, wa } from '../data/site';
import Icoon from './Icoon.astro';
import Logo from './Logo.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['assortiment', 'Assortiment'], ['palletstabilisatie', 'Palletstabilisatie'], ['over', 'Over ons'], ['contact', 'Contact']];
const waKort = wa('Goedendag Arnold, ik heb een vraag over verpakkingsmateriaal.');
---
<header class={thuis ? 'absolute inset-x-0 top-0 z-40' : 'relative z-40 bg-inkt'}>
  <div class="wrap flex h-20 items-center justify-between gap-6 md:h-24">
    <a href={url('')} class="text-wit no-underline"><Logo /></a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-base font-semibold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-wit/85 no-underline transition-colors duration-200 hover:text-groen-licht">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.arnold.href} class="num hidden items-center gap-2 text-base font-semibold text-wit no-underline transition-colors hover:text-groen-licht xl:flex"><Icoon naam="tel" class="h-4 w-4 text-groen-licht" />{site.arnold.tel}</a>
      <a href={waKort} class="knop knop-groen hidden min-h-11 px-4 md:inline-flex"><Icoon naam="wa" />WhatsApp</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-wit lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden bg-inkt lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn py-4 font-kop text-3xl uppercase text-wit no-underline">{t}</a></li>)}
      <li class="pt-6"><a href={h('verpakken')} class="font-semibold text-groen-licht no-underline">Wat wilt u verpakken?</a></li>
      <li class="pt-3"><a href={site.arnold.href} class="num font-semibold text-mist no-underline">Arnold: {site.arnold.tel}</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 bg-inkt md:hidden">
  <a href={site.arnold.href} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn text-base font-bold text-wit no-underline"><Icoon naam="tel" class="h-5 w-5 text-groen-licht" />Bellen</a>
  <a href={waKort} class="flex min-h-14 items-center justify-center gap-2.5 bg-groen text-base font-bold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
