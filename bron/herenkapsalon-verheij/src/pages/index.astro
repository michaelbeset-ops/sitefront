---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, prijzen, geschiedenis } from '../data/site';
import hero from '../assets/hero.jpg';
import knippen from '../assets/knippen.jpg';
import scheren from '../assets/scheren.jpg';
---
<Base
  title="Herenkapsalon Verheij | Herenkapper in Sliedrecht sinds 1959"
  description="Herenkapper aan de Christiaan Huygensstraat in Sliedrecht, sinds 1959. Knippen en traditioneel scheren, op afspraak. Dinsdag t/m zaterdag open vanaf 07:00."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: salonfoto met een egale donkere laag, openingstijden als bord ernaast. -->
    <section class="relative isolate overflow-hidden bg-ink text-cream">
      <div class="absolute inset-0 -z-10">
        <Foto src={hero} alt="Lege barbershop met drie zwarte leren kappersstoelen voor een bakstenen muur met spiegels en hanglampen" hero sizes="100vw" />
        <div class="absolute inset-0 bg-ink/80 lg:bg-transparent lg:bg-[linear-gradient(90deg,#1c1c1cf2_0%,#1c1c1ce0_45%,#1c1c1c8c_100%)]"></div>
      </div>
      <div class="wrap grid gap-12 py-14 md:py-20 lg:grid-cols-12 lg:items-end lg:py-28">
        <div class="lg:col-span-7">
          <p class="kicker text-copper-light">Herenkapper in Sliedrecht</p>
          <h1 class="mt-5 text-4xl">Sinds 1959 aan de Christiaan Huygensstraat</h1>
          <p class="mt-6 max-w-xl text-lg text-cream/90">Gespecialiseerd in het knippen van heren van alle leeftijden. En wilt u zich eens door een kapper laten scheren, dan kan dat hier ook, op de traditionele manier.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={site.afspraak} rel="noopener" class="btn btn-copper text-lg">Maak online een afspraak</a>
            <a href={site.telHref} class="whitespace-nowrap underline decoration-copper-light decoration-1 underline-offset-4 transition-colors hover:text-copper-light">of bel {site.tel}</a>
          </div>
          <p class="mt-8 text-sm text-cream/80"><strong class="text-cream">9,5</strong> uit 10 van 19 klanten op onze eigen site <span aria-hidden="true" class="mx-2 text-copper-light">/</span> <strong class="text-cream">4,7</strong> op Google</p>
        </div>

        <div class="rounded-sm bg-cream p-6 text-ink shadow-[0_1px_2px_#0000004d] sm:p-8 lg:col-span-5 lg:col-start-8">
          <p class="kicker text-copper">Dinsdag t/m zaterdag open vanaf</p>
          <p class="mt-1 font-display text-clock leading-none tabular-nums">07:00</p>
          <p class="mt-2 text-sm text-ink-soft">Wij werken op afspraak, vijf dagen in de week.</p>
          <table class="mt-6 w-full text-sm">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {tijden.map((t) => (
                <tr class="border-t border-line">
                  <th scope="row" class="py-2 text-left font-normal">{t.dag}</th>
                  <td class="py-2 text-right whitespace-nowrap tabular-nums">{t.open ? <>{t.open} tot <strong class={t.dicht === '20:00' ? 'text-copper' : ''}>{t.dicht}</strong></> : <span class="text-ink-soft">gesloten</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Mededeling van de eigen site. -->
    <aside aria-label="Mededeling" class="border-b border-line bg-cream">
      <div class="wrap flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-4">
        <p class="kicker shrink-0 text-copper">Let op</p>
        <p><strong class="font-semibold">25 september tot en met 3 oktober</strong> zijn wij beperkt open. <a href={site.afspraak} rel="noopener" class="font-semibold text-copper-deep underline underline-offset-4">Bekijk de online agenda</a></p>
      </div>
    </aside>

    <!-- Knippen: tekst smal links, foto breed rechts. -->
    <section id="knippen" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5 lg:pt-6">
          <p class="kicker text-copper">Knippen</p>
          <h2 class="mt-4 text-3xl">Het kapsel dat u wilt, in overleg gemaakt</h2>
          <div class="mt-6 space-y-4 text-ink-soft">
            <p>Onze gediplomeerde herenkappers maken samen met u het gewenste kapsel. Van een traditioneel klassiek model tot een meer eigentijds model, en we adviseren u daar graag bij.</p>
            <p>Geen productiewerk: u krijgt de tijd en aandacht die nodig is voor een goed afgewerkt, houdbaar kapsel. Desgewenst wassen we uw haar, en voor het stylen gebruiken we producten van DEPOT®.</p>
          </div>
          <a href="#prijzen" class="mt-8 inline-block font-semibold text-copper underline decoration-1 underline-offset-4 transition-colors hover:text-copper-deep">Bekijk de prijzen</a>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-sm lg:col-span-7">
          <Foto src={knippen} alt="Kapper knipt met schaar en kam het korte haar in de nek van een man" sizes="(min-width: 1024px) 680px, 100vw" />
        </div>
      </div>
    </section>

    <!-- Scheren: donker vlak, zwart-witfoto, werkwijze als drie stappen. -->
    <section id="scheren" class="scroll-mt-16 bg-ink text-cream">
      <div class="grid lg:grid-cols-2">
        <div class="aspect-[4/3] overflow-hidden lg:aspect-auto">
          <Foto src={scheren} alt="Zwart-witfoto: bij een man met baard wordt de hals met een scheerkwast ingezeept" sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div class="px-5 py-16 md:px-8 lg:px-16 lg:py-24">
          <p class="kicker text-copper-light">Scheren</p>
          <h2 class="mt-4 max-w-md text-3xl">Traditioneel geschoren, voor een gelegenheid of zomaar</h2>
          <ol class="mt-10 max-w-lg space-y-7">
            <li class="grid grid-cols-[2.5rem_1fr] gap-3">
              <span class="font-display text-2xl leading-none text-copper-light">1</span>
              <p>Met een varkensharen kwast brengen we de scheerzeep in draaiende bewegingen aan, minimaal vier minuten. Zo worden de baardharen week.</p>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-3">
              <span class="font-display text-2xl leading-none text-copper-light">2</span>
              <p>Eerst scheren we met de haargroei mee, daarna tegen de groeirichting in.</p>
            </li>
            <li class="grid grid-cols-[2.5rem_1fr] gap-3">
              <span class="font-display text-2xl leading-none text-copper-light">3</span>
              <p>Tot slot een aftershavebalsem die de gevoelige huid verzorgt en hydrateert.</p>
            </li>
          </ol>
          <a href={site.afspraak} rel="noopener" class="btn btn-line mt-10">Afspraak voor scheren</a>
        </div>
      </div>
    </section>

    <!-- Prijzen: als een prijsbord met stippellijnen, beoordeling ernaast. -->
    <section id="prijzen" class="scroll-mt-16 bg-cream py-16 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="kicker text-copper">Prijslijst</p>
          <h2 class="mt-4 text-3xl">Wat het kost</h2>
          <p class="mt-6 text-ink-soft">Wij werken op afspraak. U kunt een afspraak maken op alle dagen dat we open zijn.</p>
          <a href={site.afspraak} rel="noopener" class="btn btn-copper mt-8">Maak online een afspraak</a>
          <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-line pt-8">
            <div><dt class="text-sm text-ink-soft">Klantwaardering</dt><dd class="mt-1 font-display text-2xl tabular-nums">9,5 <span class="font-body text-sm text-ink-soft">uit 10</span></dd><dd class="text-xs text-ink-soft">19 klanten, eigen site</dd></div>
            <div><dt class="text-sm text-ink-soft">Google</dt><dd class="mt-1 font-display text-2xl tabular-nums">4,7 <span class="font-body text-sm text-ink-soft">uit 5</span></dd></div>
          </dl>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <table class="w-full">
            <caption class="sr-only">Prijzen per behandeling</caption>
            <thead class="sr-only"><tr><th scope="col">Behandeling</th><th scope="col">Prijs</th></tr></thead>
            <tbody>
              {prijzen.map((p) => (
                <tr>
                  <th scope="row" class="py-3 text-left font-normal">
                    <span class="flex items-baseline gap-3">
                      <span>{p.naam}{p.noot && <span class="ml-2 text-sm text-ink-soft">({p.noot})</span>}</span>
                      <span class="leader" aria-hidden="true"></span>
                    </span>
                  </th>
                  <td class="py-3 pl-3 text-right align-bottom whitespace-nowrap tabular-nums">{p.va && <span class="mr-1 text-sm text-ink-soft">v.a.</span>}<span class="font-semibold">€ {p.prijs}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Geschiedenis als tijdlijn: jaartallen en namen alleen zoals op de eigen site. -->
    <section id="geschiedenis" class="wrap scroll-mt-16 py-16 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
          <p class="kicker text-copper">Geschiedenis</p>
          <h2 class="mt-4 text-3xl">Meer dan zestig jaar dezelfde straat</h2>
          <p class="mt-6 text-ink-soft">Het onderscheid tussen dames- en herenkappers is bijna verdwenen. Juist daarom waarderen veel mensen een zaak die alleen heren knipt. Een aantal klanten komt hier al vanaf het prille begin.</p>
        </div>
        <ol class="relative border-l border-copper/40 lg:col-span-7 lg:col-start-6">
          {geschiedenis.map((g) => (
            <li class="relative pb-12 pl-8 last:pb-0 sm:pl-10">
              <span class="absolute top-2 -left-[5px] h-[9px] w-[9px] rounded-full bg-copper" aria-hidden="true"></span>
              <p class="font-display text-2xl leading-none text-copper">{g.jaar}</p>
              <h3 class="mt-3 text-xl">{g.kop}</h3>
              <p class="mt-2 text-ink-soft">{g.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Team en DEPOT naast elkaar: namen typografisch, geen stockfoto als persoon. -->
    <section id="team" class="scroll-mt-16 border-t border-line">
      <div class="wrap grid gap-14 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-6">
          <p class="kicker text-copper">Wij stellen ons voor</p>
          <h2 class="mt-4 text-3xl">Twee herenkappers</h2>
          <p class="mt-6 text-ink-soft">Bij kapsalon Verheij werken twee herenkappers, één fulltime en één parttime.</p>
          <ul class="mt-10 grid gap-8 sm:grid-cols-2">
            <li class="border-t-2 border-ink pt-4">
              <h3 class="text-2xl">Arie</h3>
              <p class="mt-2 text-sm text-ink-soft">Eigenaar. Kwam in 1987 in dienst en nam de zaak in 1992 over.</p>
            </li>
            <li class="border-t-2 border-ink pt-4">
              <h3 class="text-2xl">Daniëlle</h3>
              <p class="mt-2 text-xs text-ink-soft">[[AANLEVEREN: korte introductie Daniëlle]]</p>
            </li>
          </ul>
          <p class="mt-8 text-xs text-ink-soft">[[AANLEVEREN: foto van Arie en Daniëlle in de salon]]</p>
        </div>

        <div id="depot" class="scroll-mt-20 rounded-sm bg-ink p-7 text-cream sm:p-10 lg:col-span-5 lg:col-start-8">
          <p class="kicker text-copper-light">In de winkel</p>
          <h2 class="mt-4 text-2xl">DEPOT® voor haar, scheren en baard</h2>
          <p class="mt-5 text-cream/90">Wij gebruiken en verkopen de producten van DEPOT®: voor het haar, voor scheren en baard- en snorverzorging, voor het lichaam, en een lijn geuren.</p>
          <p class="mt-4 text-cream/90">De producten liggen op voorraad in de winkel en zijn geschikt als cadeau. Zoekt u iets specifieks, vraag het ons gerust.</p>
          <a href={`mailto:${site.mail}`} class="mt-6 inline-block break-all underline decoration-copper-light underline-offset-4 transition-colors hover:text-copper-light">{site.mail}</a>
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-16 bg-ink py-16 text-cream lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-copper-light">Contact</p>
          <h2 class="mt-4 text-3xl">Tot ziens in de stoel</h2>
          <address class="mt-8 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.afspraak} rel="noopener" class="btn btn-copper">Maak online een afspraak</a>
            <a href={site.maps} rel="noopener" class="btn btn-line">Route plannen</a>
          </div>
        </div>
        <dl class="grid content-start gap-6 lg:col-span-5 lg:col-start-8">
          <div><dt class="text-sm text-cream/80">Telefoon</dt><dd><a href={site.telHref} class="font-display text-3xl whitespace-nowrap underline decoration-copper-light decoration-1 underline-offset-[6px]">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-cream/80">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-copper-light underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-cream/80">Instagram</dt><dd><a href={site.instagram} rel="noopener" class="underline decoration-copper-light underline-offset-4">@herenkapsalonverheij</a></dd></div>
          <div><dt class="text-sm text-cream/80">Open</dt><dd>Dinsdag t/m vrijdag <span class="whitespace-nowrap tabular-nums">07:00 tot 17:30</span>, donderdag tot <span class="whitespace-nowrap tabular-nums">20:00</span>, zaterdag <span class="whitespace-nowrap tabular-nums">07:00 tot 13:30</span>. Maandag gesloten.</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
