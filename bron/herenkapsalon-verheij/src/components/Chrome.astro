---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const home = (hash: string) => url(hash);
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line-dark bg-ink text-cream">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-xl leading-none text-cream no-underline sm:text-2xl">Verheij<span class="ml-2 hidden font-body text-xs font-semibold uppercase tracking-[0.16em] text-copper-light min-[400px]:inline">herenkapper</span></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm">
          <li><a href={home('#knippen')} class="no-underline transition-colors hover:text-copper-light">Knippen en scheren</a></li>
          <li><a href={home('#prijzen')} class="no-underline transition-colors hover:text-copper-light">Prijzen</a></li>
          <li><a href={home('#geschiedenis')} class="no-underline transition-colors hover:text-copper-light">Sinds 1959</a></li>
          <li><a href={home('#depot')} class="no-underline transition-colors hover:text-copper-light">DEPOT</a></li>
          <li><a href={home('#contact')} class="no-underline transition-colors hover:text-copper-light">Contact</a></li>
        </ul>
      </nav>
      <a href={site.afspraak} rel="noopener" class="btn btn-copper !px-4 !py-2 text-sm">Afspraak maken</a>
    </div>
  </header>
) : (
  <footer class="border-t border-line-dark bg-ink py-12 text-cream/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-xl font-semibold text-cream">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK <span class="text-cream/70">[[AANLEVEREN: KvK-nummer]]</span></p>
      <p class="md:col-span-4">Aangesloten bij de Koninklijke Algemene Nederlandse Kappersorganisatie (ANKO) en de Geschillencommissie.</p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
