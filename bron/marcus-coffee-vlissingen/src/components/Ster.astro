---
// Achtpuntige zellige-ster (khatam): twee vierkanten over elkaar. Verwijst naar de Marokkaanse tegels en het zilveren theeblad.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 24 24" class={`ster ${cls}`} fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
  <rect x="5" y="5" width="14" height="14" />
  <rect x="5" y="5" width="14" height="14" transform="rotate(45 12 12)" />
  <circle cx="12" cy="12" r="2.2" />
</svg>
