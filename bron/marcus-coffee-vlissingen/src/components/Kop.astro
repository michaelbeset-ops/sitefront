---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['theekaart', 'Theekaart'], ['koffie', 'Koffie & taart'], ['lunch', 'Ontbijt & lunch'], ['dinernight', 'Dinernight'], ['bezoek', 'Bezoek']];
---
<header class={`op-inkt z-40 text-krijt ${thuis ? 'absolute inset-x-0 top-0' : 'relative bg-inkt'}`}>
  <div class="wrap flex h-22 items-center justify-between gap-6 md:h-24">
    <Merk />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-krijt/90 no-underline transition-colors duration-300 hover:text-munt-licht">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="num hidden text-[.9375rem] font-medium text-krijt/90 no-underline transition-colors hover:text-munt-licht xl:block">{site.tel}</a>
      <a href={waHoi} class="knop knop-munt hidden min-h-11 px-5 text-[.9375rem] md:inline-flex"><Icoon naam="wa" />Reserveren</a>
      <button type="button" class="grid h-11 w-11 place-items-center lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h18M3 16h18" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden bg-inkt lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn-inkt py-4 font-kop text-3xl no-underline">{t}</a></li>)}
      <li class="pt-6"><a href={site.telHref} class="num text-sm text-zacht no-underline">{site.tel}</a></li>
    </ul>
  </nav>
</header>

<div class="op-inkt fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-lijn-inkt bg-inkt/95 text-krijt backdrop-blur-md md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn-inkt text-[.9375rem] font-semibold no-underline"><Icoon naam="tel" class="h-[1.1rem] w-[1.1rem] text-munt-licht" />Bellen</a>
  <a href={waHoi} class="flex min-h-14 items-center justify-center gap-2.5 text-[.9375rem] font-semibold no-underline"><Icoon naam="wa" class="h-[1.1rem] w-[1.1rem] text-munt-licht" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
