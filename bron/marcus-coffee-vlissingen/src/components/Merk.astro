---
// Hun eigen logo: de twee bonen met stoom en het woord MARCUS, paden uit hun logo-SVG.
import { boon, woord } from '../data/logo';
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="inline-flex items-center gap-3 no-underline" aria-label="Marcus coffee, tea blends & lifestyle: naar de homepage">
  <svg viewBox="12480 2840 4120 6510" class={klein ? 'h-9 w-auto' : 'h-11 w-auto'} fill="currentColor" aria-hidden="true">
    {boon.map((d) => <path d={d} />)}
  </svg>
  <span class="flex flex-col leading-none">
    <svg viewBox="2790 10650 23500 2990" class={klein ? 'h-[1.05rem] w-auto' : 'h-[1.3rem] w-auto'} fill="currentColor" aria-hidden="true"><path d={woord} /></svg>
    <span class="mt-1.5 whitespace-nowrap text-[.5rem] font-semibold uppercase tracking-[.14em] opacity-80 min-[400px]:text-[.5625rem] min-[400px]:tracking-[.2em]">Coffee, tea blends &amp; lifestyle</span>
  </span>
</a>
