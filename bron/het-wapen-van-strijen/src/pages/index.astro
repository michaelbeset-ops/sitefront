---
import Foto from '../components/Foto.astro';
import hero from '../assets/hero.jpg';
import tap from '../assets/tap.jpg';
import zaal from '../assets/zaal.jpg';
import raam from '../assets/raam.jpg';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site } from '../data/site';
const feesten = ['Thema-avonden', 'Personeelsfeesten', 'Bruiloften', 'Verjaardagen', 'Recepties', 'Jubilea'];
---
<Base
  title="Herberg Het Wapen van Strijen | Café, restaurant en pension aan de Molenstraat"
  description="Eten, borrelen en feesten in een monumentaal pand uit 1759 midden in Strijen. À la carte, dagschotels, feestcafé op vrijdag en zaterdag, en zalen voor uw feest."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="wrap grid gap-10 pb-14 pt-10 lg:grid-cols-12 lg:pb-20 lg:pt-16">
      <div class="lg:col-span-7">
        <p class="font-display text-lg italic text-brass">Molenstraat 7, midden in Strijen</p>
        <h1 class="mt-3 text-4xl">Eten, borrelen en feesten in een pand uit 1759</h1>
        <p class="mt-6 max-w-xl text-lg text-ink-soft">
          Het Wapen van Strijen is café, restaurant en herberg in één. Het monumentale pand werd na de brand van Strijen in 1759 herbouwd.
          Bij ons kunt u lunchen, dineren, aan de bar een speciaalbiertje drinken of in het weekend dansen tot diep in de nacht.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.telHref} class="btn btn-wine">Reserveer: {site.tel}</a>
          <a href="#restaurant" class="btn btn-line">Bekijk de kaart</a>
        </div>
      </div>
      <aside aria-labelledby="open" class="self-end border-t-4 border-wine bg-white p-6 lg:col-span-4 lg:col-start-9">
        <h2 id="open" class="text-2xl">Wanneer we open zijn</h2>
        <p class="mt-3">[[AANLEVEREN: actuele openingstijden café en keuken. De oude site noemt dinsdag tot en met zondag vanaf 15.00 uur, maar ook een keuken van 12.00 tot 21.00 uur, 7 dagen per week]]</p>
        <p class="mt-4 font-semibold">Feestcafé: vrijdag en zaterdag van 22.00 tot 03.00 uur.</p>
      </aside>
      <div class="aspect-[16/9] lg:col-span-12 lg:aspect-[21/8] overflow-hidden"><Foto src={hero} alt="Warm verlicht caféinterieur met houten tafels en een lange bar" hero sizes="(min-width: 1184px) 1120px, 100vw" /></div>
    </section>

    <section id="restaurant" class="scroll-mt-4 bg-white py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Het restaurant</h2>
          <p class="mt-5 text-lg">
            Kies uit de à-la-cartekaart, of ga voor de dagschotel die op doordeweekse dagen elke dag wisselt, voor een schappelijke prijs.
            Lunchen kan ook. In de zomer eet u buiten in onze eettuin, ook voor een barbecue.
          </p>
          <p class="mt-4 text-ink-soft">Liever thuis eten? De gerechten en de dagmenu's kunt u ook afhalen.</p>
        </div>
        <div class="grid gap-6 lg:col-span-6 lg:col-start-7">
          <div class="border-l-4 border-brass bg-paper p-6">
            <h3 class="text-xl">À la carte</h3>
            <p class="mt-2 text-ink-soft">[[AANLEVEREN: actuele menukaart als tekst, niet als PDF]]</p>
          </div>
          <div class="border-l-4 border-brass bg-paper p-6">
            <h3 class="text-xl">Lunch</h3>
            <p class="mt-2 text-ink-soft">[[AANLEVEREN: lunchkaart, de oude site toont nog die van 2019]]</p>
          </div>
          <div class="border-l-4 border-brass bg-paper p-6">
            <h3 class="text-xl">Daghap en dagmenu</h3>
            <p class="mt-2">Elke dag een andere Hollandse hap of een dagmenu. Vraag ernaar aan de bar.</p>
            <p class="mt-1 text-sm text-ink-soft">[[AANLEVEREN: actuele prijzen daghap en dagmenu]]</p>
          </div>
        </div>
      </div>
    </section>

    <section id="cafe" class="wrap scroll-mt-4 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6">
        <div class="mb-8 aspect-[16/10] overflow-hidden"><Foto src={tap} alt="Een biertje wordt getapt aan de bar" sizes="(min-width: 1024px) 560px, 100vw" /></div>
        <h2 class="text-3xl">Het café</h2>
        <p class="mt-5 text-lg">
          Aan onze bar heerst nog volop die Bourgondische sfeer. Leffe, Hoegaarden witbier, een Palmpje of ons huismerk Jupiler,
          en regelmatig een ander speciaalbier. Ook wijn en een flinke rij likeuren.
        </p>
        <p class="mt-4">
          Het vijfuurtje na het werk is in Strijen al jaren een begrip. Kom met uw gezelschap een borrel doen met een bittergarnituur,
          en eet daarna eventueel door in het restaurant.
        </p>
      </div>
      <div class="bg-wine p-8 text-paper lg:col-span-5 lg:col-start-8 lg:p-10">
        <p class="font-display text-lg italic text-brass-light">Feestcafé 't Wapen</p>
        <h3 class="mt-2 text-2xl">Vrijdag en zaterdag, van 22.00 tot 03.00 uur</h3>
        <p class="mt-5 text-paper/85">
          De beste dj's uit de regio: top 40, dance, après-ski, Hollandse meezingers, rock en echte oldies.
          Op het podium staan regelmatig bands. Tosti's en pizza's bestelt u aan de bar tot half drie.
        </p>
        <p class="mt-4 text-paper/85">Te druk? Voorin de kroeg kunt u gewoon rustig kletsen.</p>
      </div>
    </section>

    <section id="feesten" class="scroll-mt-4 border-y border-line bg-paper-deep py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Iets te vieren?</h2>
          <div class="mt-6 aspect-[4/3] overflow-hidden"><Foto src={zaal} alt="Sfeervol verlichte zaal met gedekte tafels" sizes="(min-width: 1024px) 460px, 100vw" /></div>
          <p class="mt-5 text-lg">U kunt het Wapen afhuren of een deel ervan gebruiken voor uw eigen feest.</p>
          <a href={site.telHref} class="btn btn-wine mt-8">Bel voor de mogelijkheden</a>
        </div>
        <ul class="grid gap-x-8 gap-y-3 self-center font-display text-xl font-bold sm:grid-cols-2 sm:text-2xl lg:col-span-6 lg:col-start-7">
          {feesten.map((f) => <li class="border-b border-line pb-3">{f}</li>)}
        </ul>
      </div>
    </section>

    <section id="pension" class="wrap scroll-mt-4 grid gap-10 py-16 lg:grid-cols-12 lg:py-24">
      <div class="aspect-[4/3] lg:col-span-5 overflow-hidden"><Foto src={raam} alt="Rustig zitje bij grote ramen" sizes="(min-width: 1024px) 460px, 100vw" /></div>
      <div class="self-center lg:col-span-6 lg:col-start-7">
        <h2 class="text-3xl">Overnachten in de herberg</h2>
        <p class="mt-5 text-lg">
          Sinds 1989 heeft het Wapen een pension: negen kamers op de eerste verdieping, met twee toiletten en twee douches.
          Ontbijt is inbegrepen. Blijft u langer dan een week, dan kunnen we uw was doen tegen een vergoeding.
        </p>
        <p class="mt-4">Parkeren kan binnen 20 meter van de deur, en alle winkels liggen op 200 meter lopen.</p>
        <p class="mt-4 text-sm text-ink-soft">[[AANLEVEREN: of het pension nu weer kamers verhuurt, en de actuele prijs per nacht]]</p>
      </div>
    </section>

    <section id="contact" class="scroll-mt-4 bg-white py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Reserveren gaat het snelst telefonisch</h2>
          <p class="mt-5"><a href={site.telHref} class="font-display text-2xl font-extrabold underline decoration-brass decoration-2 underline-offset-4">{site.tel}</a></p>
          <p class="mt-3"><a href={`mailto:${site.mail}`} class="underline underline-offset-2">{site.mail}</a></p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <address class="text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Open in Google Maps</a>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
