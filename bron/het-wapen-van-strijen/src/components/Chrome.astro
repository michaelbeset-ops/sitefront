---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="border-b border-line bg-paper">
    <div class="wrap flex items-center justify-between gap-4 py-4">
      <a href={url('')} class="no-underline">
        <span class="block font-display text-xl font-extrabold leading-none tracking-[-0.03em]">Het Wapen van Strijen</span>
        <span class="text-xs text-ink-soft">Café, restaurant en pension in Strijen</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href="#restaurant" class="no-underline hover:text-brass">Restaurant</a></li>
          <li><a href="#cafe" class="no-underline hover:text-brass">Café</a></li>
          <li><a href="#feesten" class="no-underline hover:text-brass">Feesten</a></li>
          <li><a href="#pension" class="no-underline hover:text-brass">Pension</a></li>
          <li><a href="#contact" class="no-underline hover:text-brass">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-wine !px-4 !py-2.5 text-sm">Reserveren</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-paper/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-paper">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a><br />Op reserveringen gelden de UVH-voorwaarden.</p>
    </div>
  </footer>
)}
