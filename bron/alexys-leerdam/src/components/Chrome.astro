---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-3xl font-bold italic tracking-[-0.02em] no-underline">Alexy's</a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm">
          <li><a href="#menu" class="no-underline hover:text-terra">Menukaart</a></li>
          <li><a href="#afhalen" class="no-underline hover:text-terra">Afhalen</a></li>
          <li><a href="#groepen" class="no-underline hover:text-terra">Groepen</a></li>
          <li><a href="#contact" class="no-underline hover:text-terra">Contact</a></li>
        </ul>
      </nav>
      <a href={site.reserveren} rel="noopener" class="btn btn-sea !px-4 !py-2 text-sm">Reserveren</a>
    </div>
  </header>
) : (
  <footer class="bg-sea py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-2xl italic text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
