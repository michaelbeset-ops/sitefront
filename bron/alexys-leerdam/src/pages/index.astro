---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, menu } from '../data/site';
import hero from '../assets/hero.jpg';
import terras from '../assets/terras.jpg';
import salade from '../assets/salade.jpg';
import avond from '../assets/avond.jpg';
const tijden = [
  ['Woensdag t/m zondag', 'vanaf 14.00'],
  ['Maandag en dinsdag', 'gesloten*'],
];
---
<Base
  title="Alexy's | Grieks restaurant in het hartje van Leerdam"
  description="Sinds 2003 Griekse specialiteiten aan de Fonteinstraat in Leerdam. Meze, giros, moussaka en lam van de grill. Reserveren, afhalen en groepen vanaf 20 personen."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="wrap grid items-center gap-12 pb-16 pt-10 lg:grid-cols-12 lg:pb-24 lg:pt-16">
      <div class="lg:col-span-6">
        <p class="text-sm font-medium tracking-wide text-terra">Fonteinstraat 17, Leerdam · sinds 2003</p>
        <h1 class="mt-4 text-4xl">Een klein stukje Griekenland in Leerdam</h1>
        <p class="mt-6 max-w-lg text-lg text-ink-soft">
          Sinds 2003 bereiden we met veel aandacht de specialiteiten van het mooie Griekenland. Kom en geniet ervan. Kali andamossy!
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.reserveren} rel="noopener" class="btn btn-sea">Reserveer een tafel</a>
          <a href={site.afhalen} rel="noopener" class="btn btn-line">Bestel om af te halen</a>
        </div>
        <p class="mt-8 text-sm text-ink-soft"><strong class="text-ink">4,6</strong> op Google, uit 378 reviews</p>
      </div>
      <!-- Een Griekse boog als uitsnede: wit gekalkt, zoals een deur op een eiland. -->
      <div class="lg:col-span-6">
        <div class="mx-auto aspect-[4/5] max-w-md overflow-hidden rounded-t-full border-[10px] border-white shadow-[0_1px_2px_#0b254522]">
          <Foto src={hero} alt="Tafel vol Griekse meze, pita en dipjes" hero sizes="(min-width: 1024px) 450px, 90vw" />
        </div>
      </div>
    </section>

    <section class="bg-sea py-10 text-white">
      <div class="wrap grid gap-6 md:grid-cols-3 md:items-center">
        <h2 class="text-2xl text-terra-light">Wanneer we open zijn</h2>
        <dl class="space-y-1">
          {tijden.map(([d, t]) => <div class="flex justify-between gap-4 border-b border-white/15 py-1"><dt>{d}</dt><dd class="whitespace-nowrap">{t}</dd></div>)}
        </dl>
        <p class="text-sm text-white/80">* Behalve op feestdagen. Met een groep vanaf 20 personen kunt u ook op maandag en dinsdag bij ons terecht.</p>
      </div>
    </section>

    <section id="menu" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Menukaart</h2>
          <p class="mt-5 text-ink-soft">Van koude meze tot lam van de grill. Heeft u een allergie? Laat het ons even weten.</p>
          <div class="mt-8 hidden aspect-[3/4] overflow-hidden rounded-t-full lg:block"><Foto src={salade} alt="Griekse salade met feta, tomaat en komkommer" sizes="380px" /></div>
          <p class="mt-6 text-sm text-ink-soft">[[AANLEVEREN: prijzen per gerecht]]</p>
        </div>
        <div class="grid gap-12 sm:grid-cols-2 lg:col-span-8">
          {menu.map((g) => (
            <div>
              <h3 class="border-b-2 border-terra pb-2 text-2xl">{g.kop}</h3>
              <ul class="mt-4 space-y-3">
                {g.items.map(([n, b]) => <li><span class="font-medium">{n}</span><br /><span class="text-sm text-ink-soft">{b}</span></li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="afhalen" class="scroll-mt-20 bg-sand py-16 lg:py-24">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12">
        <div class="aspect-[4/3] overflow-hidden rounded-t-[12rem] lg:col-span-6"><Foto src={terras} alt="Blauwe stoeltjes en een tafel met ruitjeskleed aan zee" sizes="(min-width: 1024px) 560px, 100vw" /></div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h2 class="text-3xl">Thuis Grieks eten</h2>
          <p class="mt-5 text-lg">Bestel online en haal uw bestelling op aan de Fonteinstraat. Handig voor een avond thuis, of als u met een groep eet.</p>
          <a href={site.afhalen} rel="noopener" class="btn btn-terra mt-8">Bestel om af te halen</a>
        </div>
      </div>
    </section>

    <section id="groepen" class="wrap scroll-mt-20 grid gap-10 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6">
        <h2 class="text-3xl">Met een groep?</h2>
        <p class="mt-5 text-lg">Vanaf 20 personen bent u ook op maandag en dinsdag welkom, als het restaurant normaal gesloten is. Bel ons om de mogelijkheden te bespreken.</p>
        <a href={site.telHref} class="btn btn-sea mt-8">Bel {site.tel}</a>
      </div>
      <div class="aspect-[16/10] overflow-hidden rounded-t-[10rem] lg:col-span-5 lg:col-start-8"><Foto src={avond} alt="Kan en glazen op tafel bij zonsondergang aan zee" sizes="(min-width: 1024px) 460px, 100vw" /></div>
    </section>

    <section id="contact" class="scroll-mt-20 bg-sea py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">In het hartje van Leerdam</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
        </div>
        <dl class="grid content-start gap-4 text-lg lg:col-span-6 lg:col-start-7">
          <div><dt class="text-sm text-white/70">Reserveren</dt><dd><a href={site.telHref} class="font-display text-4xl font-bold underline decoration-terra-light decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-white/70">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="underline decoration-terra-light decoration-2 underline-offset-4">{site.mail}</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
