---
import '../styles/global.css';
import raamUrl from '@fontsource/squada-one/files/squada-one-latin-400-normal.woff2?url';
import bodyUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import { site, url } from '../data/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={raamUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh">
    {site.voorstel && (
      <div class="bg-inkt text-wit">
        <p class="wrap py-2 font-[system-ui,sans-serif] text-xs leading-snug">
          Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website.{" "}
          <a href="https://www.sitefront.nl" class="font-bold underline underline-offset-2">sitefront.nl</a>
        </p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-glas focus:px-4 focus:py-2">Naar de inhoud</a>
    <slot />
  </body>
</html>
