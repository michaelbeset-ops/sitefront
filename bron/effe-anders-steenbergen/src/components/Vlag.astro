---
// Vlagbaan zoals bovenaan hun menukaart en op hun raam: groen-wit-rood-wit-groen met een gele ster aan beide uiteinden.
import { ster } from '../data/site';
interface Props { h?: string; class?: string }
const { h = '22px', class: cls = '' } = Astro.props;
---
<div class={`vlag ${cls}`} style={`--h:${h}`} aria-hidden="true">
  <span class="st left-[max(1.25rem,calc((100vw-88rem)/2+1.25rem))] md:left-[max(2.5rem,calc((100vw-88rem)/2+2.5rem))]" set:html={ster}></span>
  <span class="st right-[max(1.25rem,calc((100vw-88rem)/2+1.25rem))] md:right-[max(2.5rem,calc((100vw-88rem)/2+2.5rem))]" set:html={ster}></span>
</div>
