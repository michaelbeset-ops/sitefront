---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi, tijden, dagNamen, uur } from '../data/site';

// Eigen foto's: Google-profiel "Van eigenaar" en hun Instagram. Sfeerfoto's: Unsplash. Zie src/assets/BRONNEN.txt.
import hero from '../assets/hero.jpg';
import baklava from '../assets/baklava.jpg';
import rond from '../assets/rond.jpg';
import kunefe from '../assets/kunefe.jpg';
import tepsis from '../assets/tepsis.jpg';
import pistache from '../assets/pistache.jpg';
import assortiment from '../assets/assortiment.jpg';
import tepsi from '../assets/tepsi.jpg';
import uLahmacun from '../assets/u-lahmacun.jpg';
import uThee from '../assets/u-thee.jpg';

const sterren = [1, 2, 3, 4, 5];

// Patisserie: namen en omschrijvingen uit hun eigen Google-menu en bezorgkaart (bron/google/menu-google.txt,
// bron/web/archief-2024-menu.txt). Geen prijzen.
const vitrine = [
  { t: 'Baklava', d: 'Knapperig filodeeg, gevuld met pistachenoten en een verrukkelijke siroop.', src: baklava, alt: 'Twee stukken baklava met pistache op een schaal, met Turkse thee' },
  { t: 'Havuç dilimi', d: 'Puntige baklava, gevuld met pistachenoten en overgoten met siroop.', src: rond, alt: 'Ronde tepsi met baklava in punten gesneden' },
  { t: 'Künefe', d: 'Knapperige deegsliertjes gevuld met mozzarella, overgoten met siroop en pistachenoten.', src: kunefe, alt: 'Warme künefe met draden gesmolten kaas en pistache' },
];
const ookZoet = [
  ['Katmer', 'Dun deeg met pistachenoten, ghee boter en huisgemaakte room. Klein voor 1 persoon, groot voor 2 tot 3 personen.'],
  ['Kadayıf', 'Knapperige deegsliertjes gevuld met pistachenoten, overgoten met siroop.'],
  ['Huisgemaakte taart', 'Bereid met zorg en liefde.'],
];

// Hartige keuken: hun eigen bezorgkaart (archief 2024) en de populaire gerechten op Google.
const keuken = [
  ['Lahmacun', 'Peterselie, citroen en hete pepers, op traditionele wijze bereid.'],
  ['Beyran', 'Pittige soep met gekookt lamsvlees, rijst en knoflook. Met brood en hete pepers.'],
  ['Tatar mantısı', 'Yoghurtgerecht met dumplings gevuld met kalfsgehakt, ui, zwarte peper, kikkererwten en een saus van gedroogde munt.'],
  ['İçli köfte', 'Ovale bulgurbal gevuld met kalfsgehakt, ui, walnoten en zwarte peper.'],
  ['Çiğ köfte', 'Vegetarische balletjes van bulgur, ui, tomaten- of paprikapasta en isot-peper. Met citroen, sla, komkommer, tomaat en hete pepers.'],
];

const stappen = [
  ['Stel samen', 'Kies hieronder wat je wilt ophalen, met aantallen.'],
  ['Kies een moment', 'Donderdag tot en met zondag, vanaf 15.00 uur.'],
  ['Verstuur via WhatsApp', 'Je bericht staat klaar. Jij drukt zelf op verzenden.'],
  ['Ophalen', 'Aan de Schiedamsedijk 76A, als je bestelling is bevestigd.'],
];

// Bestellen: alleen wat op hun eigen kaart staat.
const bestelZoet = ['Baklava, 3 stuks', 'Havuç dilimi', 'Katmer klein (1 persoon)', 'Katmer groot (2 tot 3 personen)', 'Künefe', 'Kadayıf', 'Huisgemaakte taart'];
const bestelHartig = ['Lahmacun', 'Beyran', 'Tatar mantısı', 'İçli köfte', 'Çiğ köfte'];
const dagen = [4, 5, 6, 0];
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base title="Latadia Patisserie | Baklava, katmer en lahmacun uit Gaziantep, in Rotterdam" description="Latadia Patisserie aan de Schiedamsedijk in Rotterdam: baklava, katmer, künefe en de hartige keuken van Gaziantep. Handgemaakt door onze moeders. Donderdag tot en met zondag vanaf 15.00 uur.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: hun eigen foto van tepsi's vol baklava -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={hero} alt="" widths={[640, 960, 1400, 2000, 2358]} sizes="100vw" loading="eager" fetchpriority="high" quality={60} class="absolute inset-0 -z-20 h-full w-full object-cover object-[30%_50%] md:object-[50%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1a1611c4_0%,#1a161166_30%,#1a1611d6_62%,#1a1611fa_100%)] md:bg-[linear-gradient(90deg,#1a1611f2_0%,#1a1611cc_38%,#1a161140_70%,#1a161126_100%),linear-gradient(180deg,#1a1611b3_0%,#1a161100_30%,#1a161100_70%,#1a1611c7_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-24 pt-36 md:pb-20 lg:pt-48">
        <div class="max-w-3xl">
          <p class="eyebrow eyebrow-licht">Patisserie uit Gaziantep, in {site.plaats}</p>
          <h1 id="inhoud" class="mt-6 text-hero">Van onze <span class="accent accent-licht">familietafel</span> naar de jouwe.</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-wit/90 md:text-[1.3rem]">Baklava, katmer en künefe, en de hartige keuken van Gaziantep. Handgemaakt door onze moeders, aan de Schiedamsedijk.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#bestellen" class="knop knop-merk">Bestelling samenstellen<Icoon naam="pijl" /></a>
            <a href="#patisserie" class="knop knop-wit">Bekijk de kaart</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.95rem] text-wit/90">
            <li class="flex items-center gap-2"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-wit">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-merk-licht" /><span data-status>Donderdag tot en met zondag vanaf 15.00</span></li>
            <li class="flex items-center gap-2"><Icoon naam="tel" class="h-4 w-4 text-merk-licht" /><a href={site.telHref} class="num text-wit/90 no-underline hover:text-wit">{site.tel}</a></li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- 2. In het kort: alleen echte cijfers en feiten uit Google en hun Instagram -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-x-6 gap-y-9 py-11 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-steen">op Google, uit {site.google.aantal} reviews</dt><dd class="num order-first font-kop text-[clamp(2rem,2vw+1.3rem,3.2rem)] font-black leading-none text-merk">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">uur open, donderdag tot en met zondag</dt><dd class="num order-first font-kop text-[clamp(2rem,2vw+1.3rem,3.2rem)] font-black leading-none">15.00</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">daar liggen onze roots</dt><dd class="order-first font-kop text-[clamp(2rem,2vw+1.3rem,3.2rem)] font-black leading-none">Gaziantep</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">reservering nodig: loop gerust binnen</dt><dd class="order-first font-kop text-[clamp(2rem,2vw+1.3rem,3.2rem)] font-black leading-none">Geen</dd></div>
      </dl>
    </section>

    <!-- 3. Patisserie: fotokaarten met hun eigen foto's -->
    <section id="patisserie" class="py-24 md:py-32" aria-labelledby="t-pat">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Patisserie</p>
            <h2 id="t-pat" class="mt-5 text-4xl">Pistache, ghee en <span class="accent">dun deeg.</span></h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">De zoete kant van Gaziantep, vers uit onze eigen keuken. Voor bij de thee, of om mee naar huis te nemen.</p>
        </div>

        <ul class="mt-14 grid gap-6 md:grid-cols-3 lg:mt-16 lg:gap-7">
          {vitrine.map((v, i) => (
            <li class="rijs" style={`--d:${i * 0.07}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden">
                <div class="overflow-hidden">
                  <Image src={v.src} alt={v.alt} widths={[420, 640, 900]} sizes="(min-width: 768px) 31vw, 100vw" quality={72} class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] md:aspect-[4/5]" />
                </div>
                <div class="flex flex-1 flex-col p-7">
                  <h3 class="text-[1.9rem]">{v.t}</h3>
                  <p class="mt-3 flex-1 text-steen">{v.d}</p>
                  <a href="#bestellen" class="mt-6 inline-flex items-center gap-2 font-bold text-merk no-underline" data-voeg={v.t === 'Baklava' ? 'Baklava, 3 stuks' : v.t}>Zet in je bestelling<Icoon naam="pijl" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>

        <div class="mt-16 grid gap-10 lg:grid-cols-12 lg:gap-14">
          <figure class="rijs lg:col-span-5">
            <Image src={pistache} alt="Bakplaat vol pistache-lekkernijen" widths={[400, 600, 768]} sizes="(min-width: 1024px) 36vw, (min-width: 640px) 90vw, 100vw" quality={58} class="aspect-[16/9] w-full rounded-[18px] object-cover sm:aspect-[4/3] lg:aspect-[5/4]" />
            <figcaption class="mt-3 text-sm text-steen">Uit onze keuken, foto van Latadia.</figcaption>
          </figure>
          <div class="lg:col-span-7">
            <h3 class="rijs text-3xl">Ook op de kaart</h3>
            <div class="mt-6">
              {ookZoet.map(([t, d], i) => (
                <div class="rijs gerecht" style={`--d:${i * 0.05}s`}>
                  <h3>{t}</h3>
                  <p class="text-steen">{d}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Ons verhaal: donker, hun eigen tekst (Instagram) en drie kaders met letterlijke reviewzinnen -->
    <section id="verhaal" class="bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-ver">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-5">
          <Image src={tepsis} alt="Tepsi's vol baklava, rond en recht gesneden" widths={[420, 640, 900, 1200]} sizes="(min-width: 1024px) 38vw, 100vw" quality={72} class="aspect-square w-full rounded-[18px] object-cover" />
          <figcaption class="mt-3 text-sm text-mist">Tepsi's uit onze keuken, foto van Latadia.</figcaption>
        </figure>
        <div class="lg:col-span-7 lg:pt-6">
          <p class="rijs eyebrow eyebrow-licht">Ons verhaal</p>
          <h2 id="t-ver" class="rijs mt-5 text-4xl">Handgemaakt door <span class="accent accent-licht">onze moeders.</span></h2>
          <p class="rijs mt-8 max-w-2xl text-xl leading-relaxed text-wit/90">Geïnspireerd door onze roots in Gaziantep. Van onze familietafel naar de jouwe. Niets bijzonders, gewoon goed eten.</p>
          <ul class="mt-12 grid gap-5 sm:grid-cols-3">
            {[
              ['Een kleine kaart', 'Liever een beperkte kaart met gerechten die echt goed worden gemaakt…', 'Aysu'],
              ['Familie in de keuken', '…moeder en haar zus staan zelf in de keuken.', 'Gülèn K.'],
              ['Even in Turkije', '…dat wij ons een beetje in Turkije waanden.', 'Suzanne'],
            ].map(([t, q, n], i) => (
              <li class="rijs flex flex-col rounded-[18px] border border-lijn bg-inkt-2 p-6" style={`--d:${i * 0.06}s`}>
                <span class="text-sm font-bold uppercase tracking-[.14em] text-merk-licht">{t}</span>
                <p class="mt-3 flex-1 font-kop text-[1.25rem] font-extrabold italic leading-snug">“{q}”</p>
                <p class="mt-4 text-sm text-mist">{n}, Google review</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 5. Keuken: hartige gerechten, sfeerfoto van Unsplash -->
    <section id="keuken" class="bg-room-2 py-24 md:py-32" aria-labelledby="t-keu">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-6">
          <p class="rijs eyebrow">Keuken</p>
          <h2 id="t-keu" class="rijs mt-5 text-4xl">Lahmacun, beyran en <span class="accent">mantı.</span></h2>
          <p class="rijs mt-6 max-w-lg text-lg text-steen">Naast de patisserie: de hartige klassiekers uit Gaziantep. Vraag in de zaak of via WhatsApp wat er vandaag is.</p>
          <div class="mt-10">
            {keuken.map(([t, d], i) => (
              <div class="rijs gerecht" style={`--d:${i * 0.04}s`}>
                <h3>{t}</h3>
                <p class="text-steen">{d}</p>
              </div>
            ))}
          </div>
          <p class="rijs mt-8 flex flex-wrap gap-x-3 gap-y-1 border-t border-lijn-licht pt-6 text-steen"><b class="text-inkt">Om te drinken:</b> Turkse thee, ayran en citroenlimonade.</p>
        </div>
        <div class="lg:col-span-6">
          <div class="lg:sticky lg:top-10">
            <figure class="rijs">
              <Image src={uLahmacun} alt="Lahmacun in punten gesneden, met citroen en peterselie" widths={[420, 640, 960, 1300]} sizes="(min-width: 1024px) 44vw, 100vw" quality={70} class="aspect-[4/5] w-full rounded-[18px] object-cover" />
              <figcaption class="mt-3 text-sm text-steen">Sfeerfoto ter illustratie (Unsplash).</figcaption>
            </figure>
            <div class="rijs mt-6 flex items-center justify-between gap-4 rounded-[18px] bg-inkt px-6 py-5 text-wit">
              <p class="font-medium">Liever thuis? Latadia bezorgt via Thuisbezorgd.</p>
              <Icoon naam="pakje" class="h-6 w-6 flex-none text-merk-licht" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Zo werkt afhalen -->
    <section class="bg-wit py-24 md:py-28" aria-labelledby="t-hoe">
      <div class="wrap">
        <p class="rijs eyebrow">Afhalen</p>
        <h2 id="t-hoe" class="rijs mt-5 text-4xl">Zo werkt <span class="accent">bestellen.</span></h2>
        <ol class="mt-12 grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-8 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs border-t-2 border-inkt pt-6" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num">0{i + 1}</span>
              <h3 class="mt-4 text-xl sm:text-2xl">{t}</h3>
              <p class="mt-2 text-steen">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Wow: bestelling samenstellen, vooraf ingevuld WhatsApp -->
    <section id="bestellen" class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-best">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow eyebrow-licht">Bestellen</p>
            <h2 id="t-best" class="mt-5 text-4xl">Stel je <span class="accent accent-licht">bestelling</span> samen.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-mist lg:col-span-5 lg:col-start-8">Kies wat je wilt ophalen en wanneer. Je bestelling komt als bericht klaar te staan in WhatsApp.</p>
        </div>

        <form class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-14" data-bestel>
          <div class="lg:col-span-7">
            <fieldset>
              <legend class="font-kop text-2xl font-extrabold">Zoet</legend>
              <div class="mt-4 md:grid md:grid-cols-2 md:gap-x-10">
                {bestelZoet.map((t) => (
                  <div class="rij" data-rij={t}>
                    <span class="rij-naam font-medium">{t}</span>
                    <span class="teller">
                      <button type="button" data-min aria-label={`Eén ${t} minder`} disabled>−</button>
                      <output class="num" id={`n-${slug(t)}`} aria-live="polite">0</output>
                      <button type="button" data-plus aria-label={`Eén ${t} erbij`}>+</button>
                    </span>
                  </div>
                ))}
              </div>
            </fieldset>
            <fieldset class="mt-10">
              <legend class="font-kop text-2xl font-extrabold">Hartig</legend>
              <div class="mt-4 md:grid md:grid-cols-2 md:gap-x-10">
                {bestelHartig.map((t) => (
                  <div class="rij" data-rij={t}>
                    <span class="rij-naam font-medium">{t}</span>
                    <span class="teller">
                      <button type="button" data-min aria-label={`Eén ${t} minder`} disabled>−</button>
                      <output class="num" id={`n-${slug(t)}`} aria-live="polite">0</output>
                      <button type="button" data-plus aria-label={`Eén ${t} erbij`}>+</button>
                    </span>
                  </div>
                ))}
              </div>
            </fieldset>

            <div class="mt-10 grid gap-7 sm:grid-cols-2">
              <fieldset>
                <legend class="veld-label">Welke dag?</legend>
                <div class="flex flex-wrap gap-2.5">
                  {dagen.map((d) => <label class="keuze"><input type="radio" name="dag" value={dagNamen[d]} data-dag={d} />{dagNamen[d]}</label>)}
                </div>
              </fieldset>
              <div>
                <label for="tijd" class="veld-label">Hoe laat ongeveer?</label>
                <select id="tijd" name="tijd" class="veld num" data-tijd></select>
              </div>
              <div>
                <label for="naam" class="veld-label">Op welke naam?</label>
                <input id="naam" name="naam" class="veld" autocomplete="given-name" placeholder="Je voornaam" />
              </div>
              <div>
                <label for="extra" class="veld-label">Nog iets?</label>
                <input id="extra" name="extra" class="veld" placeholder="Bijvoorbeeld een vraag over de taart" />
              </div>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-8">
              <div class="bon px-7 pb-8 pt-7">
                <div class="flex items-center justify-between border-b border-dashed border-room-3 pb-4">
                  <p class="text-xs font-bold uppercase tracking-[.22em] text-steen">Latadia, afhalen</p>
                  <p class="num text-xs font-bold text-steen" data-moment></p>
                </div>
                <ul class="num mt-4 min-h-[3rem] space-y-1.5" data-lijst aria-live="polite"></ul>
                <p class="mt-4 border-t border-dashed border-room-3 pt-4 text-sm text-steen" data-leeg>Nog niets gekozen. Tik op + bij wat je lekker vindt.</p>
              </div>
              <p class="veld-label mt-10">Jouw bericht</p>
              <p class="min-h-[6.5rem] whitespace-pre-line rounded-[10px] border-l-4 border-merk-licht bg-inkt-2 px-5 py-4 text-[.98rem] leading-relaxed text-wit/90" data-voorbeeld aria-live="polite"></p>
              <a href={waHoi} class="knop knop-merk mt-5 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <p class="mt-3 text-center text-xs text-mist">Je bestelling is pas zeker als Latadia hem bevestigt.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat gasten <span class="accent">zeggen.</span></h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-9 w-9 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-black leading-none">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-sm text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="kaart flex h-full flex-col p-7">
                <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
                <blockquote class="mt-5 flex-1 leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5 text-sm">
                  <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-room-2 font-bold">{r.naam[0]}</span>
                  <span><b class="block font-bold">{r.naam}</b><span class="text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. Bezoek: tijden met vandaag gemarkeerd, adres, route -->
    <section id="bezoek" class="border-t border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-bez">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <div class="grid grid-cols-2 gap-4">
            <Image src={assortiment} alt="Tepsi's met verschillende soorten baklava" widths={[300, 480, 720]} sizes="(min-width: 1024px) 19vw, 50vw" quality={60} class="rijs aspect-[4/5] w-full rounded-[18px] object-cover lg:aspect-[3/5]" />
            <Image src={uThee} alt="Glas Turkse thee op een schoteltje" widths={[300, 480, 720]} sizes="(min-width: 1024px) 19vw, 50vw" quality={70} class="rijs mt-10 aspect-[4/5] w-full rounded-[18px] object-cover lg:aspect-[3/5]" style="--d:.06s" />
          </div>
          <p class="mt-3 text-sm text-steen">Links: foto van Latadia. Rechts: sfeerfoto ter illustratie (Unsplash).</p>
        </div>
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Bezoek</p>
          <h2 id="t-bez" class="rijs mt-5 text-4xl">Kom langs aan de <span class="accent">Schiedamsedijk.</span></h2>
          <p class="rijs mt-8"><a href={site.telHref} class="num font-kop text-[clamp(2.1rem,4.6vw,3.8rem)] font-black leading-none text-inkt no-underline transition-colors hover:text-merk">{site.tel}</a></p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.08s">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.route} class="knop knop-rand"><Icoon naam="pin" />Route plannen</a>
          </div>
          <div class="rijs kaart mt-10 overflow-hidden" style="--d:.12s">
            <div class="grid sm:grid-cols-2">
              <div class="flex gap-4 border-b border-lijn-licht p-6 sm:border-b-0 sm:border-r">
                <Icoon naam="pin" class="mt-0.5 h-5 w-5 flex-none text-merk" />
                <div><p class="font-bold">{site.volledig}</p><p class="mt-1 text-steen">{site.straat}<br />{site.postcode} {site.plaats}</p><p class="mt-3 text-steen">We werken zonder reserveringen: loop gerust binnen.</p></div>
              </div>
              <div class="flex gap-4 p-6">
                <Icoon naam="klok" class="mt-0.5 h-5 w-5 flex-none text-merk" />
                <div class="w-full">
                  <p class="font-bold" data-status-kort>Openingstijden</p>
                  <ul class="num mt-2 space-y-1 text-steen">
                    {[1, 2, 3, 4, 5, 6, 0].map((d) => { const t = tijden[d]; return <li class="-mx-2 flex justify-between gap-4 rounded-md px-2" data-dagrij={d}><span>{dagNamen[d]}</span><span>{t ? `${uur(t[0])} - ${uur(t[1])}` : 'Gesloten'}</span></li>; })}
                  </ul>
                </div>
              </div>
            </div>
            <a href={site.route} class="flex items-center justify-between gap-3 bg-inkt px-6 py-4 font-bold text-wit no-underline transition-colors hover:bg-merk">Route naar Schiedamsedijk 76A<Icoon naam="pijl" class="h-5 w-5" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-merk text-wit" aria-label="Bestelling samenstellen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center md:py-14">
        <p class="font-kop text-3xl font-black leading-none">Zin in <span class="italic">baklava?</span></p>
        <a href="#bestellen" class="knop knop-inkt shrink-0">Bestelling samenstellen<Icoon naam="pijl" /></a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site, tijden, dagNamen, uur } from '../data/site';

  // Live status
  const nu = new Date();
  const dag = nu.getDay();
  const u = nu.getHours() + nu.getMinutes() / 60;
  const t = tijden[dag];
  const open = !!t && u >= t[0] && u < t[1];
  const volgende = () => { for (let i = 1; i <= 7; i++) { const d = (dag + i) % 7; if (tijden[d]) return d; } return 4; };
  let tekst: string;
  if (open) tekst = `Nu open, tot ${uur(t![1])} uur`;
  else if (t && u < t[0]) tekst = `Vandaag open vanaf ${uur(t[0])} uur`;
  else { const v = volgende(); tekst = `Nu gesloten, ${dagNamen[v].toLowerCase()} weer open vanaf ${uur(tijden[v]![0])}`; }
  const s = document.querySelector('[data-status]'); if (s) s.textContent = tekst;
  const sk = document.querySelector('[data-status-kort]'); if (sk) sk.textContent = tekst;
  document.querySelector(`[data-dagrij="${dag}"]`)?.classList.add('bg-room-2', 'font-bold', 'text-inkt');

  // Bestellen
  const f = document.querySelector<HTMLFormElement>('[data-bestel]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const lijst = document.querySelector<HTMLElement>('[data-lijst]');
  const leeg = document.querySelector<HTMLElement>('[data-leeg]');
  const moment = document.querySelector<HTMLElement>('[data-moment]');
  const tijdSel = document.querySelector<HTMLSelectElement>('[data-tijd]');
  if (f && vb && knop && lijst && leeg && moment && tijdSel) {
    const aantallen = new Map<string, number>();
    const rijen = [...f.querySelectorAll<HTMLElement>('[data-rij]')];

    // Standaarddag: vandaag als het een open dag is en er nog tijd is, anders de volgende open dag.
    const startDag = t && u < t[1] - 0.5 ? dag : volgende();
    const radio = f.querySelector<HTMLInputElement>(`input[data-dag="${startDag}"]`); if (radio) radio.checked = true;

    const vulTijden = () => {
      const d = Number(f.querySelector<HTMLInputElement>('input[name="dag"]:checked')?.dataset.dag ?? 4);
      const tt = tijden[d]!;
      const oud = tijdSel.value;
      tijdSel.innerHTML = '';
      for (let x = tt[0]; x <= tt[1] - 0.5; x += 0.5) {
        if (d === dag && x <= u) continue;
        const o = document.createElement('option'); o.value = o.textContent = `${uur(x)} uur`; tijdSel.append(o);
      }
      if ([...tijdSel.options].some((o) => o.value === oud)) tijdSel.value = oud;
    };

    const zet = () => {
      lijst.innerHTML = '';
      const gekozen = [...aantallen.entries()].filter(([, n]) => n > 0);
      gekozen.forEach(([naam, n]) => { const li = document.createElement('li'); li.className = 'flex justify-between gap-4'; li.innerHTML = `<span></span><b>${n}x</b>`; li.firstElementChild!.textContent = naam; lijst.append(li); });
      leeg.hidden = gekozen.length > 0;
      const d = new FormData(f);
      const dagTxt = String(d.get('dag') || '');
      const tijd = String(d.get('tijd') || '');
      moment.textContent = `${dagTxt.slice(0, 2).toLowerCase()} ${tijd.replace(' uur', '')}`;
      const naam = String(d.get('naam') || '').trim();
      const extra = String(d.get('extra') || '').trim();
      const r = [gekozen.length ? 'Hallo Latadia, ik wil graag een bestelling afhalen:' : 'Hallo Latadia, ik heb een vraag over afhalen.'];
      gekozen.forEach(([x, n]) => r.push(`- ${n}x ${x}`));
      if (gekozen.length) r.push(`Ophalen: ${dagTxt.toLowerCase()} rond ${tijd}.`);
      if (naam) r.push(`Op naam van ${naam}.`);
      if (extra) r.push(extra);
      if (gekozen.length) r.push('Kunnen jullie dit bevestigen?');
      const txt = r.join('\n');
      vb.textContent = txt;
      knop.href = `${site.wa}?text=${encodeURIComponent(txt)}`;
    };

    rijen.forEach((rij) => {
      const naam = rij.dataset.rij!;
      const out = rij.querySelector('output')!;
      const min = rij.querySelector<HTMLButtonElement>('[data-min]')!;
      const stel = (n: number) => { n = Math.max(0, Math.min(20, n)); aantallen.set(naam, n); out.textContent = String(n); min.disabled = n === 0; rij.classList.toggle('gekozen', n > 0); zet(); };
      min.addEventListener('click', () => stel((aantallen.get(naam) || 0) - 1));
      rij.querySelector('[data-plus]')!.addEventListener('click', () => stel((aantallen.get(naam) || 0) + 1));
      (rij as any).stel = stel;
    });

    // "Zet in je bestelling" vanuit de fotokaarten
    document.querySelectorAll<HTMLAnchorElement>('[data-voeg]').forEach((a) => a.addEventListener('click', () => {
      const rij = rijen.find((r) => r.dataset.rij === a.dataset.voeg) as any;
      if (rij && !(aantallen.get(rij.dataset.rij) > 0)) rij.stel(1);
    }));

    f.addEventListener('change', (e) => { if ((e.target as HTMLInputElement).name === 'dag') vulTijden(); zet(); });
    f.addEventListener('input', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    vulTijden(); zet();
  }
</script>
