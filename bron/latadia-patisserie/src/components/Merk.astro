---
// Woordmerk naar hun logo (lichtreclame en Instagram): "LATADIA" in ruim gespatieerde kapitalen met een
// tweelingblad. Nagetekend, geen origineel bestand.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-2.5 no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <svg viewBox="0 0 32 32" class="h-8 w-8 flex-none" aria-hidden="true">
    <path d="M15.2 27.5c-6.6-1-10.4-6.6-9.4-15.2 6.9.9 10.6 5.7 9.4 15.2Z" fill="#9fbf4f" />
    <path d="M16.6 27.5C15.6 18 19.4 12 26.4 9.6c1.2 8.6-3.1 16.5-9.8 17.9Z" fill="#b9d36e" />
    <path d="M15.6 27.4c-.4-5.2-2.4-9.3-6-12.4M16.4 27.3c.9-5.6 3.7-10.2 7.6-14" fill="none" stroke="#1a1611" stroke-opacity=".45" stroke-width="1" stroke-linecap="round" />
  </svg>
  <span class="leading-none">
    <span class="sr-only">Latadia Patisserie, naar de homepage</span><span aria-hidden="true" class="block text-[1.3rem] font-semibold tracking-[.32em] sm:text-[1.42rem]">LATADIA</span>
    <span aria-hidden="true" class={`mt-1 block text-[.62rem] font-semibold uppercase tracking-[.42em] ${donker ? 'text-steen' : 'text-wit/70'}`}>Patisserie</span>
  </span>
</a>
