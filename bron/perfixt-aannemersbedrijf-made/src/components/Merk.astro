---
// Hun eigen logo-icoon (huisje met hamer, uit het logo op perfixt.weebly.com) + woordmerk in de koppenletter.
import { Image } from 'astro:assets';
import icoon from '../assets/logo-icoon.png';
import icoonWit from '../assets/logo-icoon-wit.png';
interface Props { wit?: boolean }
const { wit = false } = Astro.props;
---
<Image src={wit ? icoonWit : icoon} alt="" widths={[48, 96]} sizes="42px" loading="eager" />
<span><b>PER<span>FIXT</span></b><small><span class="sr-only"> </span>Aannemersbedrijf</small></span>
