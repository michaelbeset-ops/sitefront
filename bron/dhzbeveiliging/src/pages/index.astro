---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, assortiment, groot, reviews, waHoi, waMet } from '../data/site';
import heroBreed from '../assets/hero-breed.jpg';
import heroHoog from '../assets/hero-hoog.jpg';
import codeklavier from '../assets/codeklavier.jpg';
import bullet from '../assets/bullet.jpg';
import domeWit from '../assets/dome-wit.jpg';
import domePlafond from '../assets/dome-plafond.jpg';
import ajax from '../assets/ajax-buiten.jpg';

// Het bediendeel: de onderwerpen komen uit hun eigen site (installeren, uitbreiden, accu's, doormelden, camera's)
// en uit wat klanten in hun Google-reviews beschrijven (accu vervangen, sirene die blijft loeien).
const vragen = [
  { id: 'nieuw', t: 'Nieuw alarmsysteem', lcd: 'NIEUW SYSTEEM', zin: 'ik zoek een nieuw alarmsysteem en wil graag advies.' },
  { id: 'uitbreiden', t: 'Bestaand systeem uitbreiden', lcd: 'UITBREIDEN', zin: 'ik wil mijn bestaande alarmsysteem uitbreiden.' },
  { id: 'accu', t: 'Accu vervangen', lcd: 'ACCU', zin: 'ik heb een nieuwe accu nodig voor mijn alarmsysteem.' },
  { id: 'sirene', t: 'Sirene stopt niet', lcd: 'SIRENE', zin: 'mijn sirene blijft afgaan en ik krijg hem niet uit.' },
  { id: 'ip', t: 'Doormelden via internet', lcd: 'DOORMELDEN IP', zin: 'mijn alarm meldt door via de analoge telefoonlijn en ik wil over op internet.' },
  { id: 'camera', t: 'Camerabewaking', lcd: 'CAMERA', zin: 'ik zoek advies over camerabewaking.' },
  { id: 'installeren', t: 'Laten installeren', lcd: 'INSTALLATIE', zin: 'ik wil mijn alarmsysteem laten installeren door jullie monteurs.' },
];
const startTekst = `Hallo Bart, ${vragen[0].zin} Het gaat om een woning.`;
---
<Base title="DHZbeveiliging | Alarmsystemen en camerabewaking, Papendrecht" description="Professionele alarmsystemen, detectoren en camerabewaking voor huis en kantoor. Zelf aanleggen of laten installeren. Sinds 1996, Papendrecht.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: hun eigen foto, zwarte Dahua-dome op baksteen -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-nacht text-wit">
      <Picture src={heroBreed} alt="Zwarte Dahua-camera aan een bakstenen gevel" widths={[900, 1400, 1920]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 hidden h-full w-full object-cover object-[70%_50%] md:block" />
      <Picture src={heroHoog} alt="" widths={[600, 900]} sizes="100vw" formats={['avif', 'webp']} loading="eager" class="absolute inset-0 -z-20 h-full w-full object-cover object-[45%_40%] md:hidden" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,#0c1424f5_0%,#0c1424e0_50%,#0c142480_78%,#0c142466_100%)] md:bg-[linear-gradient(100deg,#0c1424f5_0%,#0c1424c7_38%,#0c142426_72%,#0c142400_100%)]" aria-hidden="true"></div>
      <div class="wrap pb-28 pt-36 md:pb-28 lg:pb-32">
        <p class="mono text-sm text-merk-licht">Alarmsystemen en camerabewaking · {site.plaats}</p>
        <h1 class="mt-5 max-w-[11ch] text-hero">Doe het zelf. <span class="dun text-merk-licht">Of laat het doen.</span></h1>
        <p class="mt-7 max-w-xl text-lg text-wit/85 md:text-xl">Professionele alarmsystemen en camerabewaking voor huis en kantoor. Zelf aanleggen, of laten installeren door onze eigen beveiligingsmonteurs.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#advies" class="knop knop-licht">Advies via WhatsApp<Icoon naam="pijl" /></a>
          <a href={site.shop} class="knop knop-wit">Naar de webshop</a>
        </div>
      </div>
    </section>
  </div>

  <main id="inhoud">
    <!-- 2. Doe Het Zelf: wie ze zijn -->
    <section class="py-24 md:py-28">
      <div class="wrap grid gap-y-14 md:grid-cols-12 md:gap-x-10">
        <div class="rijs md:col-span-7">
          <h2 class="text-4xl leading-[.92]" aria-label="Doe Het Zelf">
            <span class="block"><b class="font-bold">D</b><span class="dun">oe</span></span>
            <span class="block"><b class="font-bold">H</b><span class="dun">et</span></span>
            <span class="block"><b class="font-bold">Z</b><span class="dun">elf</span><span class="text-merk">.</span></span>
          </h2>
          <div class="mt-12 max-w-xl space-y-5 text-lg text-steen">
            <p><span class="font-semibold text-inkt">Bart Verlaan</span> begon DHZbeveiliging.nl in 1996. Alarmsystemen en onderdelen voor professioneel gebruik, voor het mkb, zzp'ers en particulieren die hoge eisen stellen aan hun beveiliging.</p>
            <p>Zelf geen tijd? Dan installeren onze eigen monteurs het voor u. Staat het niet in de webshop, neem dan contact op voor de beveiliging van uw keuze.</p>
          </div>
        </div>
        <figure class="rijs md:col-span-5 md:pt-10" style="--d:.1s">
          <Image src={codeklavier} alt="Rvs codeklavier met drie lampjes aan een gevel" widths={[500, 800, 1100]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-md object-cover object-[58%_50%] md:aspect-[1/1]" />
        </figure>
      </div>
    </section>

    <!-- 3. Het assortiment als lijst, met links naar hun webshop -->
    <section id="assortiment" class="bg-wit py-24 md:py-28">
      <div class="wrap grid gap-y-12 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-5">
          <div class="md:sticky md:top-10">
            <h2 class="rijs text-3xl">Het assortiment</h2>
            <p class="rijs mt-5 max-w-sm text-steen">Alleen producten waar veel vraag naar is, van gerenommeerde fabrikanten.</p>
            <a href={site.shop} class="rijs knop knop-merk mt-8">Naar de webshop<Icoon naam="pijl" /></a>
            <Image src={bullet} alt="Witte Dahua bullet-camera" widths={[500, 800]} sizes="(min-width: 768px) 36vw, 100vw" class="rijs mt-12 hidden aspect-[4/3] w-full rounded-md object-cover md:block" />
          </div>
        </div>
        <ul class="md:col-span-7">
          {assortiment.map((a) => (
            <li class="rijs border-t border-lijn-licht last:border-b">
              <a href={a.link} class="group grid grid-cols-[1fr_auto] items-center gap-x-6 py-5 no-underline md:py-5">
                <span>
                  <span class="block text-xl font-semibold tracking-tight text-inkt transition-colors group-hover:text-merk md:text-2xl">{a.naam}</span>
                  <span class="mt-1.5 block text-[.97rem] text-steen">{a.zin}</span>
                </span>
                <Icoon naam="pijl" class="h-5 w-5 text-merk transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="wrap mt-16 grid gap-4 md:mt-20 md:grid-cols-12">
        <figure class="rijs md:col-span-7">
          <Image src={domeWit} alt="Witte Dahua-dome onder een overstek" widths={[700, 1100, 1600]} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover md:aspect-[16/11]" />
        </figure>
        <div class="grid gap-4 md:col-span-5">
          <Image src={domePlafond} alt="Kleine dome-camera in de hoek van een plafond" widths={[500, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="rijs aspect-[4/3] w-full rounded-md object-cover md:aspect-auto md:h-full" style="--d:.08s" />
          <Image src={ajax} alt="Witte Ajax-detector op houten gevelbekleding" widths={[500, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="rijs aspect-[4/3] w-full rounded-md object-cover object-[60%_40%] md:aspect-auto md:h-full" style="--d:.16s" />
        </div>
      </div>
    </section>

    <!-- 4. Analoog naar internet (Chiron), letterlijk hun eigen uitleg -->
    <section id="doormelden" class="bg-merk py-24 text-wit md:py-28">
      <div class="wrap grid items-center gap-y-14 md:grid-cols-12 md:gap-x-10">
        <div class="rijs md:col-span-7">
          <h2 class="text-4xl">Geen analoge lijn meer? <span class="dun text-merk-licht">Uw alarm moet blijven doormelden.</span></h2>
          <p class="mt-8 max-w-xl text-lg text-wit/80">Analoge telefoonlijnen worden niet meer aangelegd, en een alarmsysteem kan niet zomaar doormelden via internet. Met één Chiron IP-module meldt een bestaand systeem weer door, zonder dat er aan de installatie iets verandert.</p>
          <a href="https://dhzbeveiliging.nl/chiron-iris-touch-ip-converters/" class="link link-licht mt-8 inline-block font-medium">Chiron Iris Touch in de webshop</a>
        </div>
        <div class="rijs md:col-span-5" style="--d:.1s" aria-hidden="true">
          <div class="mono grid gap-3 text-sm">
            <div class="flex items-center justify-between rounded-md border border-lijn px-5 py-4"><span>alarmsysteem</span><span class="text-wit/50">bestaand</span></div>
            <div class="flex items-center gap-4 pl-6 text-wit/45"><span class="h-8 border-l border-dashed border-wit/40"></span><span class="line-through">analoge lijn</span></div>
            <div class="flex items-center justify-between rounded-md bg-wit px-5 py-4 text-merk"><span class="font-medium">Chiron IP-module</span><span>erbij</span></div>
            <div class="flex items-center gap-4 pl-6 text-merk-licht"><span class="h-8 border-l-2 border-merk-licht"></span><span>internet / GPRS</span></div>
            <div class="flex items-center justify-between rounded-md border border-lijn px-5 py-4"><span>meldkamer</span><span class="text-merk-licht">ontvangen</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Wow: het bediendeel, vraag via WhatsApp -->
    <section id="advies" class="bg-nacht py-24 text-wit md:py-28">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="rijs lg:col-span-4 lg:pt-6">
          <h2 class="text-4xl">Vraag het Bart.</h2>
          <p class="mt-6 max-w-sm text-lg text-mist">Tik aan wat er speelt. Het display zet uw vraag klaar voor WhatsApp, versturen doet u zelf.</p>
          <p class="mt-8 text-mist">Of bel <a href={site.telHref} class="link link-licht num whitespace-nowrap font-medium text-wit">{site.tel}</a></p>
        </div>
        <form class="paneel rijs p-4 sm:p-6 md:p-8 lg:col-span-8" data-paneel style="--d:.1s" onsubmit="return false">
          <div class="lcd mono px-5 py-5 text-[1rem] leading-relaxed md:px-7 md:text-[1.1rem] md:py-6" aria-live="polite">
            <p class="flex justify-between gap-4 text-xs text-lcd/60"><span>DHZ</span><span data-lcd-kop>WONING · NIEUW SYSTEEM</span></p>
            <p class="mt-3 min-h-[4.8em]" data-lcd-tekst>{startTekst}<span class="cursor" aria-hidden="true"></span></p>
          </div>
          <fieldset class="mt-7">
            <legend class="text-sm font-medium text-mist">Voor</legend>
            <div class="mt-3 grid grid-cols-2 gap-2.5 sm:max-w-sm">
              <label class="toets"><input type="radio" name="voor" value="woning" checked /><span class="led"></span>Woning</label>
              <label class="toets"><input type="radio" name="voor" value="bedrijf" /><span class="led"></span>Bedrijf</label>
            </div>
          </fieldset>
          <fieldset class="mt-6">
            <legend class="text-sm font-medium text-mist">Het gaat om</legend>
            <div class="mt-3 grid gap-2.5 min-[370px]:grid-cols-2 xl:grid-cols-3">
              {vragen.map((v, i) => <label class="toets"><input type="radio" name="vraag" value={v.id} checked={i === 0} data-lcd={v.lcd} data-zin={v.zin} /><span class="led"></span>{v.t}</label>)}
            </div>
          </fieldset>
          <div class="mt-6 grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end">
            <label class="block">
              <span class="text-sm font-medium text-mist">Merk of type van uw systeem (als u het weet)</span>
              <input type="text" class="veld" name="merk" maxlength="60" placeholder="Bijvoorbeeld Galaxy Flex" data-merk />
            </label>
            <a href={waMet(startTekst)} class="knop knop-licht" data-wa><Icoon naam="wa" />Open in WhatsApp</a>
          </div>
        </form>
      </div>
    </section>

    <!-- 6. Reviews -->
    <section id="reviews" class="py-24 md:py-28">
      <div class="wrap grid gap-y-14 md:grid-cols-12 md:gap-x-10">
        <figure class="rijs md:col-span-7">
          <blockquote class="text-3xl font-medium leading-[1.12] tracking-[-.03em]">“{groot.tekst}”</blockquote>
          <figcaption class="mt-6 text-steen">{groot.naam}, Google review</figcaption>
        </figure>
        <div class="md:col-span-5 md:pt-3">
          <a href={site.reviews} class="rijs inline-flex items-center gap-2.5 text-sm font-medium text-steen no-underline hover:text-merk"><Icoon naam="g" class="h-4 w-4" /><span class="num">{site.google.score} op Google · {site.google.aantal} reviews</span></a>
          <ul class="mt-6">
            {reviews.map((r, i) => (
              <li class="rijs border-t border-lijn-licht py-6" style={`--d:${i * 0.08}s`}>
                <p class="text-steen">“{r.tekst}”</p>
                <p class="mt-3 text-sm font-semibold">{r.naam}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 7. Contact en afhalen -->
    <section id="contact" class="bg-wit">
      <div class="wrap grid gap-y-12 py-24 md:grid-cols-12 md:gap-x-10 md:py-28">
        <div class="rijs md:col-span-7">
          <h2 class="text-4xl">Afhalen in {site.plaats}? <span class="dun text-merk">Bel even van tevoren.</span></h2>
          <p class="mt-7 max-w-lg text-lg text-steen">Bestellen kan dag en nacht in de webshop. Voor vragen: bel, app of mail.</p>
          <a href={site.telHref} class="num mt-10 block text-3xl font-semibold tracking-tight text-inkt no-underline transition-colors hover:text-merk">{site.tel}</a>
          <p class="mt-3"><a href={`mailto:${site.mail}`} class="link text-lg">{site.mail}</a></p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.shop} class="knop border-[1.5px] border-inkt/25 text-inkt hover:border-inkt">Naar de webshop</a>
          </div>
        </div>
        <div class="rijs md:col-span-4 md:col-start-9 md:pt-4" style="--d:.1s">
          <p class="text-sm font-semibold">Post en retouren</p>
          <p class="mt-2 text-steen">DHZbeveiliging.nl<br />{site.post[0]}<br />{site.post[1]}</p>
          <p class="mt-8 text-sm font-semibold">Contant betalen</p>
          <p class="mt-2 text-steen">Kan bij afhalen, na afspraak.</p>
        </div>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-paneel]');
  if (f) {
    const kop = f.querySelector<HTMLElement>('[data-lcd-kop]')!;
    const tekst = f.querySelector<HTMLElement>('[data-lcd-tekst]')!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const merk = f.querySelector<HTMLInputElement>('[data-merk]')!;
    const nr = wa.href.split('?')[0];
    const zet = () => {
      const voor = (f.querySelector<HTMLInputElement>('input[name=voor]:checked')?.value) || 'woning';
      const v = f.querySelector<HTMLInputElement>('input[name=vraag]:checked');
      const m = merk.value.trim();
      const zin = `Hallo Bart, ${v?.dataset.zin || ''} Het gaat om ${voor === 'bedrijf' ? 'een bedrijfspand' : 'een woning'}.${m ? ` Mijn systeem: ${m}.` : ''}`;
      kop.textContent = `${voor.toUpperCase()} · ${v?.dataset.lcd || ''}`;
      tekst.textContent = zin;
      const c = document.createElement('span'); c.className = 'cursor'; c.setAttribute('aria-hidden', 'true'); tekst.append(c);
      wa.href = `${nr}?text=${encodeURIComponent(zin)}`;
    };
    f.addEventListener('change', zet);
    merk.addEventListener('input', zet);
  }
</script>
