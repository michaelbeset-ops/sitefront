---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, assortiment, reviews, waHoi, waMet } from '../data/site';
import sfeer from '../assets/sfeer-woning.jpg';
import sfeerHoog from '../assets/sfeer-woning-hoog.jpg';
import codeklavier from '../assets/codeklavier.jpg';
import bullet from '../assets/bullet.jpg';
import domeWit from '../assets/dome-wit.jpg';
import domeZwart from '../assets/dome-zwart.jpg';
import domePlafond from '../assets/dome-plafond.jpg';
import ajax from '../assets/ajax-buiten.jpg';

// Het bediendeel: de onderwerpen komen uit hun eigen site (installeren, uitbreiden, accu's, doormelden, camera's)
// en uit wat klanten in hun Google-reviews beschrijven (accu vervangen, sirene die blijft loeien).
const vragen = [
  { id: 'nieuw', t: 'Nieuw alarmsysteem', lcd: 'NIEUW SYSTEEM', zin: 'ik zoek een nieuw alarmsysteem en wil graag advies.' },
  { id: 'uitbreiden', t: 'Bestaand systeem uitbreiden', lcd: 'UITBREIDEN', zin: 'ik wil mijn bestaande alarmsysteem uitbreiden.' },
  { id: 'accu', t: 'Accu vervangen', lcd: 'ACCU', zin: 'ik heb een nieuwe accu nodig voor mijn alarmsysteem.' },
  { id: 'sirene', t: 'Sirene stopt niet', lcd: 'SIRENE', zin: 'mijn sirene blijft afgaan en ik krijg hem niet uit.' },
  { id: 'ip', t: 'Doormelden via internet', lcd: 'DOORMELDEN IP', zin: 'mijn alarm meldt door via de analoge telefoonlijn en ik wil over op internet.' },
  { id: 'camera', t: 'Camerabewaking', lcd: 'CAMERA', zin: 'ik zoek advies over camerabewaking.' },
  { id: 'installeren', t: 'Laten installeren', lcd: 'INSTALLATIE', zin: 'ik wil mijn alarmsysteem laten installeren door jullie monteurs.' },
];
const startTekst = `Hallo Bart, ${vragen[0].zin} Het gaat om een woning.`;

// Diensten: alle drie uit hun eigen homepage en assortiment. Foto's: hun eigen Google-foto's.
const diensten = [
  { t: 'Zelf aanleggen', z: 'Professionele alarmsystemen en onderdelen uit de webshop, zodat u het zelf aansluit.', foto: codeklavier, alt: 'Rvs codeklavier met drie lampjes aan een gevel', pos: 'object-[58%_50%]', href: site.shop, k: 'Naar de webshop' },
  { t: 'Laten installeren', z: 'Zelf geen tijd? Dan installeren onze eigen beveiligingsmonteurs het voor u.', foto: domePlafond, alt: 'Kleine dome-camera in de hoek van een plafond', pos: 'object-center', href: waMet('Hallo Bart, ik wil mijn alarmsysteem laten installeren door jullie monteurs.'), k: 'Vraag naar de mogelijkheden' },
  { t: 'Camerabewaking', z: 'Bullet- en dome-camera’s en 4K PoE-recorders, voor huis en kantoor.', foto: domeZwart, alt: 'Zwarte dome-camera aan een bakstenen gevel', pos: 'object-[40%_50%]', href: 'https://dhzbeveiliging.nl/camerabewaking/', k: 'Bekijk camerabewaking' },
];

// Werkwijze: zo loopt het bij hen, volgens hun eigen site en de reviews.
const stappen = [
  { t: 'Vraag het Bart', z: 'Twijfelt u welk systeem of onderdeel u nodig hebt? Bel, app of mail.' },
  { t: 'Bestellen', z: 'Dag en nacht in de webshop. Staat het er niet in, vraag dan naar de beveiliging van uw keuze.' },
  { t: 'Bezorgen of afhalen', z: 'Thuisbezorgd, of afhalen in Papendrecht na een telefoontje.' },
  { t: 'Aanleggen', z: 'Zelf, of door onze eigen monteurs. Loopt u vast, dan is een belletje genoeg.' },
];

const fotoAssortiment = [
  { i: 0, foto: ajax, alt: 'Witte Ajax-detector op houten gevelbekleding', pos: 'object-[60%_40%]' },
  { i: 9, foto: bullet, alt: 'Witte bullet-camera aan een gevel', pos: 'object-center' },
];
const tekstAssortiment = assortiment.filter((_, i) => i !== 0 && i !== 9);
---
<Base title="DHZbeveiliging | Alarmsystemen en camerabewaking, Papendrecht" description="Professionele alarmsystemen, detectoren en camerabewaking voor huis en kantoor. Zelf aanleggen of laten installeren. Sinds 1996, Papendrecht.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: sfeerfoto (Unsplash, ter illustratie), woning bij avond -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-nacht text-wit">
      <Picture src={sfeer} alt="" widths={[1000, 1500, 2000]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 hidden h-full w-full object-cover object-[60%_55%] md:block" />
      <Picture src={sfeerHoog} alt="" widths={[600, 900, 1100]} sizes="100vw" formats={['avif', 'webp']} loading="eager" class="absolute inset-0 -z-20 h-full w-full object-cover object-center md:hidden" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,#0c1424fa_0%,#0c1424e0_45%,#0c142466_72%,#0c142433_100%)] md:bg-[linear-gradient(100deg,#0c1424f7_0%,#0c1424db_36%,#0c142466_68%,#0c142433_100%)]" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-nacht/70 to-transparent" aria-hidden="true"></div>
      <div class="wrap pb-24 pt-36 md:pb-24 lg:pb-28 lg:pt-48">
        <p class="eyebrow flex items-center gap-3 text-merk-licht"><span class="hidden h-px w-8 bg-merk-licht sm:block" aria-hidden="true"></span>Alarmsystemen en camerabewaking · {site.plaats}</p>
        <h1 class="mt-6 max-w-[12ch] text-hero">Doe het zelf. Of laat het <span class="text-merk-licht">doen.</span></h1>
        <p class="mt-7 max-w-xl text-lg text-wit/85 md:text-xl">Professionele alarmsystemen en camerabewaking voor huis en kantoor. Zelf aanleggen, of laten installeren door onze eigen beveiligingsmonteurs.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#advies" class="knop knop-fel"><Icoon naam="wa" />Advies via WhatsApp</a>
          <a href={site.shop} class="knop knop-wit">Naar de webshop<Icoon naam="pijl" /></a>
        </div>
        <ul class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-[.95rem] text-wit/80">
          <li><a href={site.reviews} class="flex items-center gap-2 text-wit/85 no-underline hover:text-wit"><span class="sterren" aria-hidden="true">★★★★★</span><span class="num"><b class="font-semibold text-wit">{site.google.score}</b> op Google · {site.google.aantal} reviews</span></a></li>
          <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-merk-licht" />Sinds 1996</li>
          <li><a href={site.telHref} class="num flex items-center gap-2 font-semibold text-wit no-underline hover:text-merk-licht"><Icoon naam="tel" class="h-4 w-4 text-merk-licht" />{site.tel}</a></li>
        </ul>
      </div>
    </section>
  </div>

  <main id="inhoud">
    <!-- 2. Chips: het assortiment in een oogopslag -->
    <div class="border-b border-lijn-licht bg-wit">
      <ul class="wrap flex gap-2.5 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center">
        {assortiment.map((a) => <li class="shrink-0"><a href={a.link} class="block rounded-full border border-lijn-licht px-4 py-2 text-[.92rem] font-medium text-inkt no-underline transition-colors hover:border-merk hover:text-merk">{a.naam}</a></li>)}
      </ul>
    </div>

    <!-- 3. Over: Doe Het Zelf, sinds 1996 -->
    <section class="py-24 md:py-28">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs relative lg:col-span-6">
          <Image src={domeWit} alt="Witte dome-camera onder een overstek" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[4/3] w-full rounded-2xl object-cover" />
          <div class="absolute -bottom-6 left-5 rounded-xl bg-merk px-6 py-5 text-wit shadow-[0_20px_40px_-18px_#0c142499] md:left-8">
            <p class="flex items-center gap-2.5 font-semibold"><Icoon naam="vink" class="h-5 w-5 text-merk-licht" />Eigen beveiligingsmonteurs</p>
          </div>
        </figure>
        <div class="rijs min-w-0 lg:col-span-6" style="--d:.1s">
          <p class="eyebrow text-merk">DHZ = Doe Het Zelf</p>
          <h2 class="mt-5 text-4xl">Beveiliging die u <span class="text-merk">zelf</span> aanlegt.</h2>
          <div class="mt-7 max-w-xl space-y-5 text-lg text-steen">
            <p><span class="font-semibold text-inkt">Bart Verlaan</span> begon DHZbeveiliging.nl in 1996. Alarmsystemen en onderdelen voor professioneel gebruik, voor het mkb, zzp'ers en particulieren die hoge eisen stellen aan hun beveiliging.</p>
            <p>Zelf geen tijd? Dan installeren onze eigen monteurs het voor u. Staat het niet in de webshop, neem dan contact op voor de beveiliging van uw keuze.</p>
          </div>
          <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-lijn-licht pt-8">
            <div><dt class="sr-only">Google-score</dt><dd class="font-kop text-3xl font-extrabold tracking-tight num">{site.google.score}</dd><dd class="mt-1 text-sm text-steen">op Google</dd></div>
            <div><dt class="sr-only">Reviews</dt><dd class="font-kop text-3xl font-extrabold tracking-tight num">{site.google.aantal}</dd><dd class="mt-1 text-sm text-steen">Google-reviews</dd></div>
            <div><dt class="sr-only">Sinds</dt><dd class="font-kop text-3xl font-extrabold tracking-tight num">1996</dd><dd class="mt-1 text-sm text-steen">opgestart</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 4. Diensten als fotokaarten -->
    <section id="diensten" class="bg-wit py-24 md:py-28">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <div class="rijs md:col-span-7">
            <p class="eyebrow text-merk">Wat we doen</p>
            <h2 class="mt-5 text-4xl">Zelf doen, of <span class="text-merk">laten doen.</span></h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen md:col-span-5" style="--d:.08s">Professionele apparatuur voor huis en kantoor. U kiest hoe ver u het zelf doet.</p>
        </div>
        <ul class="mt-14 grid gap-6 md:grid-cols-3">
          {diensten.map((d, i) => (
            <li class="rijs" style={`--d:${i * 0.08}s`}>
              <a href={d.href} class="kaart group flex h-full flex-col overflow-hidden no-underline">
                <div class="overflow-hidden">
                  <Image src={d.foto} alt={d.alt} widths={[500, 800, 1000]} sizes="(min-width: 768px) 32vw, 100vw" class={`aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] ${d.pos}`} />
                </div>
                <div class="flex flex-1 flex-col p-7">
                  <h3 class="text-2xl text-inkt">{d.t}</h3>
                  <p class="mt-3 text-steen">{d.z}</p>
                  <span class="mt-auto flex items-center gap-2 pt-6 font-semibold text-merk">{d.k}<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Assortiment: 2 fotokaarten + 8 tekstkaarten, links naar hun webshop -->
    <section id="assortiment" class="py-24 md:py-28">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <div class="rijs md:col-span-7">
            <p class="eyebrow text-merk">Het assortiment</p>
            <h2 class="mt-5 text-4xl">Van gerenommeerde <span class="text-merk">fabrikanten.</span></h2>
          </div>
          <div class="rijs md:col-span-5" style="--d:.08s">
            <p class="max-w-md text-lg text-steen">Alleen producten waar veel vraag naar is. Alles te bestellen in de webshop.</p>
            <a href={site.shop} class="knop knop-merk mt-6">Naar de webshop<Icoon naam="pijl" /></a>
          </div>
        </div>
        <ul class="mt-14 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
          {fotoAssortiment.map(({ i, foto, alt, pos }, n) => {
            const a = assortiment[i];
            return (
              <li class="rijs col-span-2" style={`--d:${n * 0.08}s`}>
                <a href={a.link} class="kaart group relative block h-full overflow-hidden no-underline">
                  <Image src={foto} alt={alt} widths={[600, 900, 1300]} sizes="(min-width: 1024px) 48vw, 100vw" class={`aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] ${pos}`} />
                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-nacht/95 via-nacht/70 to-transparent p-6 pt-20 text-wit md:p-8 md:pt-24">
                    <h3 class="text-2xl">{a.naam}</h3>
                    <p class="mt-2 max-w-md text-[.97rem] text-wit/80">{a.zin}</p>
                  </div>
                </a>
              </li>
            );
          })}
          {tekstAssortiment.map((a, n) => (
            <li class="rijs" style={`--d:${(n % 4) * 0.06}s`}>
              <a href={a.link} class="kaart group flex h-full flex-col p-4 no-underline sm:p-6">
                <h3 class="text-lg text-inkt transition-colors group-hover:text-merk sm:text-xl">{a.naam}</h3>
                <p class="mt-2.5 hidden text-[.95rem] text-steen sm:block">{a.zin}</p>
                <span class="mt-auto pt-5"><Icoon naam="pijl" class="block h-5 w-5 text-merk transition-transform duration-300 group-hover:translate-x-1" /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6a. Analoog naar internet (Chiron), letterlijk hun eigen uitleg -->
    <section id="doormelden" class="bg-merk py-24 text-wit md:py-28">
      <div class="wrap grid items-center gap-y-14 md:grid-cols-12 md:gap-x-10">
        <div class="rijs md:col-span-7">
          <p class="eyebrow text-merk-licht">Doormelden via internet</p>
          <h2 class="mt-5 text-4xl">Geen analoge lijn meer? <span class="text-merk-licht">Uw alarm moet blijven doormelden.</span></h2>
          <p class="mt-8 max-w-xl text-lg text-wit/80">Analoge telefoonlijnen worden niet meer aangelegd, en een alarmsysteem kan niet zomaar doormelden via internet. Met één Chiron IP-module meldt een bestaand systeem weer door, zonder dat er aan de installatie iets verandert.</p>
          <a href="https://dhzbeveiliging.nl/chiron-iris-touch-ip-converters/" class="link link-licht mt-8 inline-block font-medium">Chiron Iris Touch in de webshop</a>
        </div>
        <div class="rijs md:col-span-5" style="--d:.1s" aria-hidden="true">
          <div class="mono grid gap-3 text-sm">
            <div class="flex items-center justify-between rounded-md border border-lijn px-5 py-4"><span>alarmsysteem</span><span class="text-wit/50">bestaand</span></div>
            <div class="flex items-center gap-4 pl-6 text-wit/45"><span class="h-8 border-l border-dashed border-wit/40"></span><span class="line-through">analoge lijn</span></div>
            <div class="flex items-center justify-between rounded-md bg-wit px-5 py-4 text-merk"><span class="font-medium">Chiron IP-module</span><span>erbij</span></div>
            <div class="flex items-center gap-4 pl-6 text-merk-licht"><span class="h-8 border-l-2 border-merk-licht"></span><span>internet / GPRS</span></div>
            <div class="flex items-center justify-between rounded-md border border-lijn px-5 py-4"><span>meldkamer</span><span class="text-merk-licht">ontvangen</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze in genummerde stappen -->
    <section id="werkwijze" class="bg-wit py-24 md:py-28">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <div class="rijs md:col-span-7">
            <p class="eyebrow text-merk">Zo werkt het</p>
            <h2 class="mt-5 text-4xl">Van vraag tot <span class="text-merk">werkend alarm.</span></h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen md:col-span-5" style="--d:.08s">Ook na de aankoop helpt Bart u aan de telefoon verder.</p>
        </div>
        <ol class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {stappen.map((s, i) => (
            <li class="rijs kaart relative flex flex-col bg-papier p-7" style={`--d:${i * 0.08}s`}>
              <span class="font-kop text-[3rem] font-black leading-none tracking-tight text-merk num">0{i + 1}</span>
              <h3 class="mt-6 text-xl text-inkt">{s.t}</h3>
              <p class="mt-2.5 text-[.97rem] text-steen">{s.z}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Wow: het bediendeel, vraag via WhatsApp -->
    <section id="advies" class="bg-nacht py-24 text-wit md:py-28">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="rijs lg:col-span-4 lg:pt-6">
          <p class="eyebrow text-merk-licht">Advies via WhatsApp</p>
          <h2 class="mt-5 text-4xl">Vraag het <span class="text-merk-licht">Bart.</span></h2>
          <p class="mt-6 max-w-sm text-lg text-mist">Tik aan wat er speelt. Het display zet uw vraag klaar voor WhatsApp, versturen doet u zelf.</p>
          <p class="mt-8 text-mist">Of bel <a href={site.telHref} class="link link-licht num whitespace-nowrap font-medium text-wit">{site.tel}</a></p>
        </div>
        <form class="paneel rijs p-4 sm:p-6 md:p-8 lg:col-span-8" data-paneel style="--d:.1s" onsubmit="return false">
          <div class="lcd mono px-5 py-5 text-[1rem] leading-relaxed md:px-7 md:text-[1.1rem] md:py-6" aria-live="polite">
            <p class="flex justify-between gap-4 text-xs text-lcd/60"><span>DHZ</span><span data-lcd-kop>WONING · NIEUW SYSTEEM</span></p>
            <p class="mt-3 min-h-[4.8em]" data-lcd-tekst>{startTekst}<span class="cursor" aria-hidden="true"></span></p>
          </div>
          <fieldset class="mt-7">
            <legend class="text-sm font-medium text-mist">Voor</legend>
            <div class="mt-3 grid grid-cols-2 gap-2.5 sm:max-w-sm">
              <label class="toets"><input type="radio" name="voor" value="woning" checked /><span class="led"></span>Woning</label>
              <label class="toets"><input type="radio" name="voor" value="bedrijf" /><span class="led"></span>Bedrijf</label>
            </div>
          </fieldset>
          <fieldset class="mt-6">
            <legend class="text-sm font-medium text-mist">Het gaat om</legend>
            <div class="mt-3 grid gap-2.5 min-[370px]:grid-cols-2 xl:grid-cols-3">
              {vragen.map((v, i) => <label class="toets"><input type="radio" name="vraag" value={v.id} checked={i === 0} data-lcd={v.lcd} data-zin={v.zin} /><span class="led"></span>{v.t}</label>)}
            </div>
          </fieldset>
          <div class="mt-6 grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end">
            <label class="block">
              <span class="text-sm font-medium text-mist">Merk of type van uw systeem (als u het weet)</span>
              <input type="text" class="veld" name="merk" maxlength="60" placeholder="Bijvoorbeeld Galaxy Flex" data-merk />
            </label>
            <a href={waMet(startTekst)} class="knop knop-licht" data-wa><Icoon naam="wa" />Open in WhatsApp</a>
          </div>
        </form>
      </div>
    </section>

    <!-- 8. Reviews: Google-badge + kaarten -->
    <section id="reviews" class="py-24 md:py-28">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <div class="rijs md:col-span-7">
            <p class="eyebrow text-merk">Reviews</p>
            <h2 class="mt-5 text-4xl">Wat klanten <span class="text-merk">zeggen.</span></h2>
          </div>
          <div class="rijs md:col-span-5 md:flex md:justify-end" style="--d:.08s">
            <a href={site.reviews} class="kaart inline-flex items-center gap-4 px-5 py-4 no-underline">
              <Icoon naam="g" class="h-8 w-8" />
              <span>
                <span class="flex items-center gap-2"><b class="font-kop text-2xl font-extrabold text-inkt num">{site.google.score}</b><span class="sterren" aria-hidden="true">★★★★★</span></span>
                <span class="block text-sm text-steen">{site.google.aantal} reviews op Google</span>
              </span>
            </a>
          </div>
        </div>
        <ul class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex flex-col p-7" style={`--d:${(i % 3) * 0.08}s`}>
              <p class="flex items-center justify-between"><span class="sterren" aria-label="5 sterren">★★★★★</span><Icoon naam="g" class="h-5 w-5" /></p>
              <p class="mt-5 text-inkt">“{r.tekst}”</p>
              <p class="mt-auto flex items-center gap-3 pt-6">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-merk text-sm font-bold text-wit" aria-hidden="true">{r.naam.charAt(0)}</span>
                <span><span class="block font-semibold">{r.naam}</span><span class="block text-sm text-steen">Google review · {r.wanneer}</span></span>
              </p>
            </li>
          ))}
          <li class="rijs flex flex-col justify-between rounded-2xl bg-merk p-7 text-wit" style="--d:.16s">
            <div>
              <p class="font-kop text-[3.4rem] font-black leading-none tracking-tight num">{site.google.score}</p>
              <p class="mt-2 sterren text-lg" aria-hidden="true">★★★★★</p>
              <p class="mt-4 text-wit/80">Gemiddeld uit {site.google.aantal} Google-reviews.</p>
            </div>
            <a href={site.reviews} class="mt-8 flex items-center gap-2 font-semibold text-wit no-underline hover:text-merk-licht">Alle reviews op Google<Icoon naam="pijl" class="h-4 w-4" /></a>
          </li>
        </ul>
      </div>
    </section>

    <!-- 9. Contact en afhalen -->
    <section id="contact" class="bg-wit py-24 md:py-28">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="rijs lg:col-span-6">
          <p class="eyebrow text-merk">Contact</p>
          <h2 class="mt-5 text-4xl">Afhalen in {site.plaats}? <span class="text-merk">Bel even van tevoren.</span></h2>
          <p class="mt-7 max-w-lg text-lg text-steen">Bestellen kan dag en nacht in de webshop. Voor vragen: bel, app of mail.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waHoi} class="knop knop-fel"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
        <div class="rijs min-w-0 lg:col-span-6" style="--d:.1s">
          <div class="kaart overflow-hidden bg-papier">
            <ul class="divide-y divide-lijn-licht">
              <li class="flex gap-5 p-6 md:px-8"><Icoon naam="tel" class="mt-1 h-5 w-5 flex-none text-merk" /><div><p class="text-sm font-semibold text-inkt">Telefoon en WhatsApp</p><p class="mt-1"><a href={site.telHref} class="link num text-lg font-semibold">{site.tel}</a></p></div></li>
              <li class="flex gap-5 p-6 md:px-8"><Icoon naam="praat" class="mt-1 h-5 w-5 flex-none text-merk" /><div class="min-w-0"><p class="text-sm font-semibold text-inkt">E-mail</p><p class="mt-1"><a href={`mailto:${site.mail}`} class="link break-all text-lg">{site.mail}</a></p></div></li>
              <li class="flex gap-5 p-6 md:px-8"><Icoon naam="klok" class="mt-1 h-5 w-5 flex-none text-merk" /><div><p class="text-sm font-semibold text-inkt">Afhalen</p><p class="mt-1 text-steen">Na een telefoontje bent u van harte welkom. Contant betalen kan bij afhalen, na afspraak.</p></div></li>
              <li class="flex gap-5 p-6 md:px-8"><Icoon naam="pin" class="mt-1 h-5 w-5 flex-none text-merk" /><div><p class="text-sm font-semibold text-inkt">Post en retouren</p><p class="mt-1 text-steen">DHZbeveiliging.nl, {site.post[0]}, {site.post[1]}</p><p class="mt-2"><a href={site.reviews} class="link text-sm font-semibold text-merk">Bekijk op Google Maps</a></p></div></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-merk text-wit">
      <div class="wrap flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between md:py-20">
        <h2 class="rijs max-w-2xl text-3xl">Loopt u vast met uw alarm? <span class="text-merk-licht">Een belletje is genoeg.</span></h2>
        <div class="rijs flex flex-wrap gap-3" style="--d:.08s">
          <a href={site.telHref} class="knop knop-licht"><Icoon naam="tel" />Bellen</a>
          <a href={waHoi} class="knop knop-wit"><Icoon naam="wa" />WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-paneel]');
  if (f) {
    const kop = f.querySelector<HTMLElement>('[data-lcd-kop]')!;
    const tekst = f.querySelector<HTMLElement>('[data-lcd-tekst]')!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const merk = f.querySelector<HTMLInputElement>('[data-merk]')!;
    const nr = wa.href.split('?')[0];
    const zet = () => {
      const voor = (f.querySelector<HTMLInputElement>('input[name=voor]:checked')?.value) || 'woning';
      const v = f.querySelector<HTMLInputElement>('input[name=vraag]:checked');
      const m = merk.value.trim();
      const zin = `Hallo Bart, ${v?.dataset.zin || ''} Het gaat om ${voor === 'bedrijf' ? 'een bedrijfspand' : 'een woning'}.${m ? ` Mijn systeem: ${m}.` : ''}`;
      kop.textContent = `${voor.toUpperCase()} · ${v?.dataset.lcd || ''}`;
      tekst.textContent = zin;
      const c = document.createElement('span'); c.className = 'cursor'; c.setAttribute('aria-hidden', 'true'); tekst.append(c);
      wa.href = `${nr}?text=${encodeURIComponent(zin)}`;
    };
    f.addEventListener('change', zet);
    merk.addEventListener('input', zet);
  }
</script>
