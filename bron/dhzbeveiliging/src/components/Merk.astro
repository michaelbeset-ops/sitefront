---
// Woordmerk naar hun logo: vet "DHZ" en dun "beveiliging".
import { url } from '../data/site';
interface Props { class?: string }
const { class: cls = 'text-wit' } = Astro.props;
---
<a href={url('')} class={`inline-flex items-baseline no-underline ${cls}`} aria-label="DHZbeveiliging, naar de homepage">
  <span class="text-[1.75rem] font-bold leading-none tracking-[-.06em]">DHZ</span><span class="dun text-[1.4rem] leading-none">beveiliging</span>
</a>
