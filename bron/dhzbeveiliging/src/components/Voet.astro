---
import { site, url, assortiment, klantenservice, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Doe Het Zelf beveiliging. Alarmsystemen en camerabewaking, sinds 1996.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Assortiment</p>
      <ul class="mt-4 space-y-1.5">
        {assortiment.slice(0, 6).map((a) => <li><a href={a.link} class="link link-licht">{a.naam}</a></li>)}
        <li><a href={site.shop} class="link link-licht">Alles in de webshop</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <a href={waHoi} class="link link-licht">(ook WhatsApp)</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-1.5">{site.post[0]}<br />{site.post[1]}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Klantenservice</p>
      <ul class="mt-4 space-y-1.5">
        {klantenservice.map(([t, l]) => <li><a href={l} class="link link-licht">{t}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} DHZbeveiliging.nl, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Foto's van jullie eigen Google-profiel, teksten en assortiment van dhzbeveiliging.nl. Reviews letterlijk van Google (stand 11 oktober 2026).</p>}
</footer>
