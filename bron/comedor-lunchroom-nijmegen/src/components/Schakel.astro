---
interface Props { class?: string; donker?: boolean }
const { class: cls = '', donker = false } = Astro.props;
---
<div class:list={['schakel', cls, donker && 'schakel-donker']} role="group" aria-label="Kies je vestiging">
  <button type="button" data-kies="nijmegen" aria-pressed="true">Nijmegen</button>
  <button type="button" data-kies="arnhem" aria-pressed="false">Arnhem</button>
</div>
<style>
  .schakel-donker { background: var(--color-pui-2); }
  .schakel-donker :global(button) { color: var(--color-licht-zacht); }
  .schakel-donker :global(button[aria-pressed='true']) { background: var(--color-licht); color: var(--color-inkt); }
  .schakel-donker :global(button:hover:not([aria-pressed='true'])) { color: #fff; }
</style>
