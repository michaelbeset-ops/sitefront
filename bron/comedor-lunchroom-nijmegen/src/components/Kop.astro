---
import { url, nij, waHoi } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
import Schakel from './Schakel.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['kaart', 'Menukaart'], ['zaken', 'Vestigingen'], ['ons', 'Over ons'], ['reviews', 'Reviews']];
---
<header class="donker sticky top-0 z-40 bg-pui text-licht">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4 md:h-20">
    <Merk class="h-10 w-auto md:h-12" />
    <nav aria-label="Hoofdmenu" class="hidden xl:block">
      <ul class="flex gap-8 text-[.9375rem] font-bold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-rood-licht">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <Schakel donker class="hidden md:inline-grid" />
      <a href={nij.telHref} data-v-tel class="knop knop-rood knop-klein hidden sm:inline-flex"><Icoon naam="tel" /><span class="num" data-v-tekst="tel">{nij.tel}</span></a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-sm border border-lijn-licht xl:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu" aria-label="Menu" class="hidden border-t border-lijn-licht bg-pui xl:hidden" data-menu>
    <div class="wrap py-4">
      <Schakel donker class="md:hidden" />
      <ul class="mt-2">
        {nav.map(([id, t]) => <li><a href={h(id)} class="flex items-center justify-between border-b border-lijn-licht py-3.5 font-kop text-2xl no-underline">{t}<Icoon naam="pijl" class="h-5 w-5 text-rood-licht" /></a></li>)}
      </ul>
      <p class="pt-5"><a href={waHoi(nij)} data-v-wa class="knop knop-rood w-full"><Icoon naam="wa" /><span>App Comedor <span data-v-tekst="plaats">Nijmegen</span></span></a></p>
    </div>
  </nav>
  <div class="luifel" aria-hidden="true"></div>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2.5 border-t border-lijn bg-papier/95 p-2.5 backdrop-blur-md md:hidden">
  <a href={nij.telHref} data-v-tel class="knop knop-inkt knop-klein"><Icoon naam="tel" /><span>Bel <span data-v-tekst="plaats">Nijmegen</span></span></a>
  <a href={waHoi(nij)} data-v-wa class="knop knop-rood knop-klein"><Icoon naam="wa" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
