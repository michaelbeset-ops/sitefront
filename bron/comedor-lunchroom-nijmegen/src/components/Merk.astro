---
import { getImage } from 'astro:assets';
import wit from '../assets/logo-wit.png';
import inkt from '../assets/logo-inkt.png';
import { url } from '../data/site';
interface Props { kleur?: 'wit' | 'inkt'; class?: string }
const { kleur = 'wit', class: cls = 'h-11 w-auto' } = Astro.props;
const img = await getImage({ src: kleur === 'wit' ? wit : inkt, width: 360, format: 'png' });
---
<a href={url('')} class="inline-flex flex-none items-center no-underline" aria-label="Comedor Lunchroom, naar de homepage">
  <img src={img.src} width="1200" height="441" alt="Comedor" class={cls} />
</a>
