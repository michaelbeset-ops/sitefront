---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, prijs, spellen, standaard, cateraars, reviews, waHoi } from '../data/site';

import hero from '../assets/hero.jpg';
import stroberg from '../assets/stroberg.jpg';
import koestal from '../assets/koestal.jpg';
import keuken from '../assets/keuken.jpg';
import kubb from '../assets/spel-kubb.jpg';
import avond from '../assets/avond.jpg';
import hek from '../assets/hek.jpg';
import oudLucht from '../assets/oud-lucht.jpg';

// De rolverdeling van het erf (Het erf, Eten en Huisregels op hun site).
const rollen = [
  ['De Stroberg', 'Tafels, stoelen, kopjes, glazen, borden en bestek voor ongeveer 50 mensen. Keuken met vaatwasser, magnetron, gaspitje, wifi en twee terrasverwarmers.'],
  ['De oude koestal', 'Zitplekjes en spelletjes: tafelvoetbal, tafeltennis, sjoelbakken. Frituren mag hier, met uw eigen frituur.'],
  ['De hooiberg', 'Met trampoline. Heerlijk om in te spelen; het hooi blijft in de hooiberg.'],
  ['De vuurplek', 'Hout voor de vuurplek is aanwezig, net als een zelfgemaakte BBQ.'],
  ['Het melklokaal', "Twee wc's, waarvan één met douche."],
];
const euro = (n: number) => `€ ${n.toLocaleString('nl-NL')}`;
---
<Base title="Boerderij Hollywoud, Montfoort | Erf huren voor uw eigen feest" description="Huur het erf van boerderij Hollywoud in Montfoort met de Stroberg, de hooiberg, de vuurplek en de oude koestal. Eigen eten mee, BBQ en hout gratis, tot 24:00.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen foto van de Stroberg met het bord -->
    <section id="top" class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-teer text-wit">
      <Image quality={70} src={hero} alt="De Stroberg met rieten dak op het erf van Hollywoud, met het bord Hollywoud Stroberg in het weiland" widths={[640, 960, 1400, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[58%_60%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(13,16,14,.55)_0%,rgba(13,16,14,.15)_30%,rgba(13,16,14,.25)_55%,rgba(13,16,14,.82)_100%)]"></div>
      <div class="wrap pb-28 pt-28 md:pb-20 md:pt-36">
        <p class="text-[.9375rem] font-medium">Recreatieboerderij · Blokland 112, Montfoort</p>
        <h1 class="mt-4 max-w-[14ch] text-hero">Maak hier uw eigen feest</h1>
        <p class="mt-5 max-w-[38rem] text-base leading-relaxed sm:text-lg text-wit/90 md:text-xl">Huur het erf met de Stroberg, de hooiberg, de vuurplek en de oude koestal. Uw eigen eten mee; de BBQ en het hout zijn gratis.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#aanvragen" class="knop knop-rood"><Icoon naam="wa" />Datum aanvragen</a>
          <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
        </div>
        <p class="mt-10 border-t border-wit/25 pt-5 text-sm text-wit/80">Tot 24:00 · alleen feesten zonder harde muziek · het erf grenst aan een stiltegebied</p>
      </div>
    </section>

    <!-- 2. Het erf: de rolverdeling -->
    <section id="erf" class="pt-24 md:pt-24">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="rijs lg:col-span-5">
          <h2 class="text-3xl">Op het erf</h2>
          <p class="mt-6 max-w-md text-lg text-grijs">U zet de inrichting naar uw hand: tafels naar buiten, de boel versieren, de BBQ aan. Door de landelijke ligging en de grote buitenruimte is het erf geschikt voor jong en oud.</p>
          <dl class="mt-10">
            {rollen.map(([n, r]) => (
              <div class="border-t border-lijn py-3.5">
                <dt class="titel font-kop text-xl"><span>{n}</span></dt>
                <dd class="mt-1.5 text-[.9375rem] text-grijs">{r}</dd>
              </div>
            ))}
          </dl>
        </div>
        <figure class="rijs lg:sticky lg:top-8 lg:col-span-7 lg:self-start" style="--d:.1s">
          <Image quality={70} src={stroberg} alt="De Stroberg, een zwart houten gebouw met rieten dak, tussen knotwilgen aan het water" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[4/3] w-full object-cover object-[40%_50%] lg:aspect-[1420/900]" />
        </figure>
      </div>
      <figure class="rijs mt-16 md:mt-24">
        <Image quality={70} src={koestal} alt="De oude koestal gedekt met een lange tafel, witte stoelen, lampionnen en lichtjes onder de houten spanten" widths={[640, 1000, 1600, 2400]} sizes="100vw" class="h-[46svh] max-h-[560px] min-h-[320px] w-full object-cover" />
        <figcaption class="wrap mt-4 text-sm text-grijs">De oude koestal, gedekt voor een diner.</figcaption>
      </figure>
    </section>

    <!-- 3. Eten: zelf meenemen -->
    <section id="eten" class="py-24 md:py-24">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
        <figure class="rijs lg:col-span-6">
          <Image quality={70} src={keuken} alt="De keuken in de Stroberg onder het rieten dak, met koffieapparaat en vaatwasser" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-square w-full object-cover" />
        </figure>
        <div class="rijs lg:col-span-6" style="--d:.1s">
          <h2 class="text-3xl">Eten en drinken neemt u zelf mee</h2>
          <p class="mt-6 text-lg text-grijs">In de Stroberg staat een keuken met (warm) water, een vaatwasser en een groot koffieapparaat. Er staan twee koelkasten in de Stroberg en twee koelkasten en een vriezer in de koestal.</p>
          <p class="mt-4 text-grijs">Geen gasfornuis; wel een klein gaspitje en een magnetron om iets op te warmen.</p>
          <div class="mt-10 border-t border-lijn pt-6">
            <p class="font-semibold">Liever laten koken? Cateraars waar gasten tevreden over waren:</p>
            <p class="mt-3 leading-loose text-grijs">
              {cateraars.map(([n, u], i) => <><a href={u} class="link" rel="noopener">{n}</a>{i < cateraars.length - 1 && <span aria-hidden="true"> · </span>}</>)}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Spellen -->
    <section id="spellen" class="bg-papier-2 py-24 md:py-24">
      <div class="wrap">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
          <h2 class="rijs text-3xl lg:col-span-7">Oud-Hollandse spellen, zelf gemaakt</h2>
          <p class="rijs text-lg text-grijs lg:col-span-5" style="--d:.1s">Leuk om teams te maken en die beurtelings tegen elkaar te laten spelen. Bij elk spel zijn dan bijvoorbeeld 5 punten te verdienen.</p>
        </div>
      </div>
      <figure class="rijs wrap mt-14">
        <Image quality={70} src={kubb} alt="Het kubbspel uitgezet op het gras: houten blokken, werpstokken en de koning" widths={[640, 1000, 1600, 2400]} sizes="(min-width: 1280px) 1184px, 100vw" class="aspect-[3/2] w-full sm:aspect-[2.5/1] object-cover" />
      </figure>
      <div class="wrap mt-12 grid gap-12 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-7">
          <p class="font-semibold">Te huur, alle dertien zelf gemaakt</p>
          <ul class="mt-4 columns-2 gap-6 text-base sm:columns-3 sm:gap-8 sm:text-lg">
            {spellen.map((s) => <li class="break-inside-avoid border-b border-lijn py-2">{s}</li>)}
          </ul>
        </div>
        <div class="lg:col-span-5">
          <dl class="border-y-2 border-inkt">
            <div class="titel py-3 text-lg"><dt>Eén spel</dt><dd class="num font-semibold">€ 5</dd></div>
            <div class="titel border-t border-lijn py-3 text-lg"><dt>Vijf spellen</dt><dd class="num font-semibold">€ 20</dd></div>
            <div class="titel border-t border-lijn py-3 text-lg"><dt>Alle 13 spellen</dt><dd class="num font-semibold">€ 35</dd></div>
          </dl>
          <p class="mt-6 text-grijs"><span class="font-semibold text-inkt">Altijd aanwezig:</span> {standaard.join(', ')}.</p>
        </div>
      </div>
    </section>

    <!-- 5. Aanvragen: de wow-functie -->
    <section id="aanvragen" class="relative isolate overflow-hidden bg-teer py-24 text-papier md:py-24">
      <Image quality={70} src={avond} alt="" widths={[640, 1000, 1600, 2400]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover object-[30%_50%] opacity-70" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(25,30,26,.9)_0%,rgba(25,30,26,.55)_50%,rgba(25,30,26,.75)_100%)]"></div>
      <div class="wrap grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-16">
        <div class="min-w-0 lg:col-span-5">
          <h2 class="text-3xl">Is uw datum nog vrij?</h2>
          <p class="mt-6 text-lg text-mist">Vul in wat u van plan bent. U ziet meteen de huurprijs en stuurt de vraag via WhatsApp.</p>
          <dl class="mt-10 text-[1.0625rem]">
            <div class="titel border-t border-lijn-licht py-3 [&::after]:border-lijn-licht"><dt>Erf voor een feest</dt><dd class="num font-semibold">{euro(prijs.feest)}</dd></div>
            <div class="titel border-t border-lijn-licht py-3 [&::after]:border-lijn-licht"><dt>Trouwfeest (opbouw, trouwen, afbouw)</dt><dd class="num font-semibold">{euro(prijs.trouw)}</dd></div>
            <div class="titel border-y border-lijn-licht py-3 [&::after]:border-lijn-licht"><dt>Vergaderen, workshop, teamactiviteit</dt><dd class="font-semibold">in overleg</dd></div>
          </dl>
          <p class="mt-4 text-sm text-mist">Vanaf 1 januari 2027 wordt de prijs € 25 hoger: {euro(prijs.feest2027)} voor het erf en {euro(prijs.trouw2027)} voor een trouwfeest.</p>
        </div>
        <form class="min-w-0 lg:col-span-6 lg:col-start-7" data-aanvraag novalidate>
          <div class="border border-lijn-licht bg-teer/80 p-5 backdrop-blur-sm md:p-10">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <label class="block min-w-0">
                <span class="mb-2 block text-sm font-semibold">Datum</span>
                <input type="date" name="datum" class="veld num" data-datum />
              </label>
              <label class="block min-w-0">
                <span class="mb-2 block text-sm font-semibold">Aantal gasten (ongeveer)</span>
                <input type="number" name="gasten" min="1" max="500" inputmode="numeric" placeholder="bijv. 40" class="veld num" data-gasten />
              </label>
              <label class="block sm:col-span-2">
                <span class="mb-2 block text-sm font-semibold">Wat viert of doet u?</span>
                <select name="soort" class="veld" data-soort>
                  <option value="feest">Verjaardag</option>
                  <option value="feest">Familiedag</option>
                  <option value="feest">Kinderfeestje</option>
                  <option value="feest">Babyshower</option>
                  <option value="feest">Familiereünie</option>
                  <option value="trouw">Trouwfeest</option>
                  <option value="overleg">Workshop</option>
                  <option value="overleg">Teamactiviteit</option>
                  <option value="overleg">Vergadering</option>
                </select>
              </label>
              <label class="block sm:col-span-2">
                <span class="mb-2 block text-sm font-semibold">Oud-Hollandse spellen erbij?</span>
                <select name="spellen" class="veld" data-spellen>
                  <option value="0">Nee, dank u</option>
                  <option value="5">Eén spel (€ 5)</option>
                  <option value="20">Vijf spellen (€ 20)</option>
                  <option value="35">Alle 13 spellen (€ 35)</option>
                </select>
              </label>
            </div>
            <div class="mt-8 border-t border-lijn-licht pt-6" aria-live="polite">
              <p class="text-sm text-mist" data-regel>Erf voor een feest</p>
              <p class="mt-1 font-kop text-[2.25rem] leading-none text-papier num" data-bedrag>{euro(prijs.feest)}</p>
              <p class="mt-3 text-sm text-mist">Tot maximaal 24:00, buiten zonder harde muziek. Eten en drinken neemt u zelf mee.</p>
            </div>
            <a href={waHoi} class="knop knop-rood mt-8 w-full whitespace-normal text-center" data-wa><Icoon naam="wa" />Vraag deze datum aan via WhatsApp</a>
            <p class="mt-4 text-center text-sm text-mist">Of bel <a href={site.telHref} class="link num text-papier">{site.tel}</a></p>
          </div>
        </form>
      </div>
    </section>

    <!-- 6. Historie -->
    <section id="historie" class="py-24 md:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl">Holstein + Van Woudenberg</h2>
          <div class="rijs mt-8 space-y-5 text-lg text-grijs" style="--d:.1s">
            <p>De boerderij is rond 1870 gebouwd. Opa en oma Van Woudenberg pachtten hem jaren van een eigenaar in Amsterdam; negen kinderen groeiden er op en hielpen mee.</p>
            <p>Evert runde de boerderij vanaf zijn 14e tot zijn 70e. Zijn hobby was films maken voor anderen. Geïnspireerd op de Holstein-koeien en de achternaam Van Woudenberg bedacht hij de naam <span class="font-semibold text-inkt">Hollywoud</span>.</p>
            <p>Rond 2000 kreeg de Stroberg een nieuw rieten dak. Dat pakte zo goed uit dat dochter Manouk er haar kinderfeestje kon vieren. Zo is de verhuur geleidelijk ontstaan.</p>
          </div>
        </div>
        <div class="lg:col-span-7">
          <Image quality={70} src={oudLucht} alt="Oude luchtfoto van de boerderij tussen de weilanden" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 56vw, 100vw" class="rijs aspect-[4/3] w-full object-cover sepia-[.35]" />
        </div>
      </div>
      <div class="wrap mt-16 grid items-center gap-10 md:mt-24 lg:grid-cols-12 lg:gap-16">
        <figure class="rijs lg:col-span-7">
          <Image quality={70} src={hek} alt="Schapen achter het hek met de rode ijzeren letters Hollywoud" widths={[640, 1000, 1600]} sizes="(min-width: 1024px) 64vw, 100vw" class="aspect-[16/9] w-full object-cover" />
        </figure>
        <p class="rijs text-xl leading-relaxed lg:col-span-5" style="--d:.1s">Op de boerderij houden we schapen, produceren we groente en fruit en onderhouden en verbeteren we de natuur, zoveel mogelijk met gerecyclede materialen. En vooral genieten we van het leven op deze plek.</p>
      </div>
    </section>

    <!-- 7. Praktisch -->
    <section id="praktisch" class="border-t border-lijn bg-papier-2 py-24 md:py-32">
      <div class="wrap">
        <div class="grid gap-10 md:grid-cols-3">
          {reviews.map((r, i) => (
            <figure class="rijs" style={`--d:${i * .08}s`}>
              <div class="flex gap-0.5 text-rood" role="img" aria-label="5 sterren">{[0, 1, 2, 3, 4].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
              <blockquote class="mt-4 text-xl leading-snug">"{r.tekst}"</blockquote>
              <figcaption class="mt-4 text-sm text-grijs">{r.naam}, Google review</figcaption>
            </figure>
          ))}
        </div>

        <div class="mt-16 grid gap-14 border-t-2 border-inkt pt-14 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h2 class="text-2xl">Parkeren</h2>
            <p class="mt-4 text-grijs"><span class="font-semibold text-inkt">P1</span> ligt aan de provinciale weg, naast de rotonde: verhard, voor circa 25 auto's. Als het weiland droog is, kan daar ook geparkeerd worden.</p>
            <p class="mt-3 text-grijs"><span class="font-semibold text-inkt">P2</span> vindt u 30 meter verder aan uw linkerhand (max. 20 auto's).</p>
            <p class="mt-3 text-grijs">Tip: zet uw eigen auto alvast op P1, dan weten gasten waar ze moeten zijn.</p>
          </div>
          <div class="lg:col-span-4">
            <h2 class="text-2xl">Huisregels</h2>
            <ul class="mt-4 space-y-2 text-grijs">
              <li>Laat de Stroberg en het terrein achter zoals u ze aantrof. Tip: maak eerst een foto als u veel verplaatst.</li>
              <li>Buiten geen harde muziek; in de Stroberg kan rustige muziek met de deuren dicht.</li>
              <li>Geen confetti, en geen marshmallows in de vuurplek.</li>
              <li>Houd zelf toezicht op de kinderen. Honden zijn welkom aan de lijn.</li>
            </ul>
          </div>
          <div class="lg:col-span-4">
            <h2 class="text-2xl">Contact</h2>
            <p class="mt-4 text-grijs">Interesse in het huren van Hollywoud? Mail, app of bel.</p>
            <p class="mt-4 text-lg"><a href={site.telHref} class="link num font-semibold">{site.tel}</a></p>
            <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
            <p class="mt-4 text-grijs">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={waHoi} class="knop knop-rood"><Icoon naam="wa" />WhatsApp</a>
              <a href={site.maps} class="knop text-inkt hover:bg-inkt hover:text-papier"><Icoon naam="pin" />Route</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { prijs, site } from '../data/site';
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  if (f) {
    const datum = f.querySelector<HTMLInputElement>('[data-datum]')!;
    const gasten = f.querySelector<HTMLInputElement>('[data-gasten]')!;
    const soort = f.querySelector<HTMLSelectElement>('[data-soort]')!;
    const sp = f.querySelector<HTMLSelectElement>('[data-spellen]')!;
    const regel = f.querySelector<HTMLElement>('[data-regel]')!;
    const bedrag = f.querySelector<HTMLElement>('[data-bedrag]')!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-wa]')!;
    // Vandaag als minimum, zodat er geen datum in het verleden gekozen wordt.
    datum.min = new Date().toISOString().slice(0, 10);
    const euro = (n: number) => `€ ${n.toLocaleString('nl-NL')}`;
    const lang = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

    const zet = () => {
      const s = soort.value, t = soort.options[soort.selectedIndex].text;
      const na2027 = datum.value ? datum.value >= '2027-01-01' : false;
      const spel = Number(sp.value);
      let huur: number | null = null;
      if (s === 'feest') huur = na2027 ? prijs.feest2027 : prijs.feest;
      if (s === 'trouw') huur = na2027 ? prijs.trouw2027 : prijs.trouw;
            if (huur === null) {
        regel.textContent = spel ? `${t}: huur in overleg, spellen ${euro(spel)}` : `${t}: huur in overleg`;
        bedrag.textContent = 'In overleg';
      } else {
        regel.textContent = `${s === 'trouw' ? 'Trouwfeest' : 'Erf voor een feest'}${na2027 ? ', tarief 2027' : ''}${spel ? ', met spellen' : ''}`;
        bedrag.textContent = euro(huur + spel);
      }
      const keus = sp.options[sp.selectedIndex].text.replace(/ \(.*\)/, '').toLowerCase();
      const r = [
        'Hallo! Ik wil graag het erf van Hollywoud huren.',
        `Datum: ${datum.value ? lang(datum.value) : 'nog niet bekend'}`,
        `Gelegenheid: ${t.toLowerCase()}`,
        `Aantal gasten: ${gasten.value ? 'ongeveer ' + gasten.value : 'nog niet bekend'}`,
        `Spellen: ${spel ? keus : 'geen'}`,
        'Is deze datum nog vrij?',
      ];
      wa.href = `${site.wa}?text=${encodeURIComponent(r.join('\n'))}`;
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
