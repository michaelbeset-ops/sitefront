---
import { site, url, waHoi } from '../data/site';
const jaar = new Date().getFullYear();
---
<footer class="bg-teer text-mist">
  <div class="wrap grid gap-x-10 gap-y-10 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <a href={url()} class="merk text-[2.2rem] text-papier">Holly<span>woud</span></a>
      <p class="mt-5 max-w-sm">Recreatieboerderij aan het Blokland in Montfoort. Het erf is te huur voor feest, familiedag, workshop of vergadering.</p>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-papier">Contact</p>
      <p class="mt-3">{site.straat}, {site.postcode} {site.plaats}</p>
      <p class="mt-1"><a href={site.telHref} class="link num">{site.tel}</a> · <a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-papier">Meer zien</p>
      <p class="mt-3"><a href={site.facebook} class="link">Facebook: Stroberg Montfoort</a></p>
      <p class="mt-1"><a href={site.film} class="link">Filmpje van het erf (4 min)</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's en teksten van jullie eigen website en Facebookpagina. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
