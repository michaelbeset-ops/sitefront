---
// Wordmark naar hun oude logo (goud op donker): "DreamZzz" met de regel "Bed & Breakfast Kaatsheuvel",
// met een smalle maansikkel als beeldmerk.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const goud = licht ? '#d4ae66' : '#7a581b';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg viewBox="0 0 32 32" class="h-8 w-8 flex-none" aria-hidden="true">
    <path d="M20.5 3.5A13 13 0 1 0 28.5 22 10.5 10.5 0 0 1 20.5 3.5z" fill={goud} />
    <circle cx="24" cy="7" r="1.3" fill={goud} />
    <circle cx="28" cy="12.5" r="0.9" fill={goud} />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.7rem] leading-[0.9] font-semibold tracking-[0.01em]">Dream<span style={`color:${goud}`}>Zzz</span></span>
    <span class={`mt-1 text-[0.625rem] font-bold uppercase whitespace-nowrap tracking-[0.2em] ${licht ? 'text-white/80' : 'text-ink-soft'}`}>Bed &amp; Breakfast<span class={licht ? '' : 'hidden sm:inline'}> Kaatsheuvel</span></span>
  </span>
</span>
