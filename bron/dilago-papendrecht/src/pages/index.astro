---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, jaarkleuren, keuringMail, vraagMail } from '../data/site';
import haak from '../assets/haak.jpg';
import pand from '../assets/pand-trekbank.jpg';
import juk from '../assets/juk.jpg';
import testbank from '../assets/testbank.jpg';

const ditJaar = jaarkleuren.find((k) => k.jaar === 2026)!;

// Hun eigen rijtje uit de folder, met per regel wat hun eigen pagina's erover zeggen.
const diensten = [
  ['Verkoop', 'Takels, lieren, dommekrachten, platenklemmen, hijsbanden en valbeveiliging. Grotendeels uit voorraad, inclusief certificaat.'],
  ['Verhuur', 'Voor tijdelijke projecten. Alles wordt na retour direct gecontroleerd en getest.'],
  ['Reparatie en onderhoud', 'Gedemonteerd, geïnspecteerd, nieuwe onderdelen waar nodig, gemonteerd en getest. Geen merk of type is een probleem.'],
  ['Keuren en certificeren', 'In de eigen werkplaats of op locatie met de mobiele trekbank. Ook bovenloopkranen, ladders, trappen en steigers, en elektrisch gereedschap volgens NEN 3140.'],
  ['Storingsdienst', 'Gebouw of schip, binnen of buiten: 24 uur per dag, 7 dagen per week bereikbaar.'],
];
---
<Base title="DiLAGO Hijs- en Heftechniek | Papendrecht, sinds 1977" description="Verkoop, verhuur, reparatie, onderhoud en keuring van hijs- en hefmiddelen. EKH-gecertificeerd, 24/7 storingsdienst. Nieuwland Parc 88, Papendrecht. Bel 078 681 5333.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. Het voorblad van het keuringsrapport: links de tekst en de gegevens, rechts hun eigen gele haak, met de jaarkleuren als geschilderde band. -->
    <section class="grid md:min-h-[calc(100svh-6.5rem)] md:grid-cols-12" aria-labelledby="kop">
      <div class="flex flex-col px-5 pt-8 md:col-span-7 md:py-[clamp(2rem,6vh,4rem)] md:pl-12 md:pr-10 xl:pr-16">
        <p class="mono text-staal">Hijs- en heftechniek &middot; Papendrecht &middot; sinds 1977</p>
        <h1 id="kop" class="mt-5 max-w-[13ch] text-[clamp(2.75rem,5.6vw,5.6rem)] md:mt-6">Laat uw veiligheid onze zorg zijn.</h1>
        <p class="mt-5 max-w-[34rem] text-lg leading-snug text-staal md:mt-7 md:text-[1.3rem]">Verkoop, verhuur, reparatie, onderhoud en keuring van hijs- en hefmiddelen. In onze werkplaats of bij u op locatie.</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-3 md:mt-9">
          <a href={site.telHref} class="knop">Bel <span class="tabular-nums">{site.tel}</span></a>
          <a href={vraagMail} class="lijn text-lg">{site.mail}</a>
        </div>
        <dl class="rapport mt-10 hidden max-w-[40rem] md:mt-auto md:block md:pt-10">
          <div><dt>Gecertificeerd</dt><dd>EKH, boven en onder de haak &middot; ISO 9001 &middot; VCA*</dd></div>
          <div><dt>Storingsdienst</dt><dd>24/7 op <a href={site.telHref} class="lijn tabular-nums">{site.tel}</a></dd></div>
          <div><dt>Jaarkleur 2026</dt><dd class="flex items-center gap-3"><span class="inline-block h-3.5 w-9" style={`background:${ditJaar.kleur}`} aria-hidden="true"></span>{ditJaar.naam}, {ditJaar.ral}</dd></div>
        </dl>
      </div>

      <figure class="relative mt-8 h-[20rem] overflow-hidden bg-lucht md:col-span-5 md:mt-0 md:h-auto">
        <Foto src={haak} alt="Een geel hijsblok met zwart-gele strepen en een gele haak hangt aan staalkabels tegen een lichtblauwe lucht." hero sizes="(min-width: 768px) 42vw, 100vw" class="absolute inset-0 object-[50%_80%] md:object-[50%_30%]" />
        <!-- De zes IMO-jaarkleuren, 2026 iets breder. -->
        <div class="absolute inset-x-0 top-0 flex h-2.5 md:inset-y-0 md:left-0 md:right-auto md:h-auto md:w-3.5 md:flex-col" aria-hidden="true">
          {jaarkleuren.map((k) => <span class={k.jaar === 2026 ? 'flex-[1.8]' : 'flex-1'} style={`background:${k.kleur}`}></span>)}
        </div>
        <figcaption class="mono absolute bottom-0 right-0 bg-grafiet px-3 py-1.5 text-wit">Uit de DiLAGO-folder</figcaption>
      </figure>

      <dl class="rapport mx-5 mb-4 mt-8 md:hidden">
        <div><dt>Gecertificeerd</dt><dd>EKH, boven en onder de haak &middot; ISO 9001 &middot; VCA*</dd></div>
        <div><dt>Storingsdienst</dt><dd>24/7 op <a href={site.telHref} class="lijn tabular-nums">{site.tel}</a></dd></div>
        <div><dt>Jaarkleur 2026</dt><dd class="flex items-center gap-3"><span class="inline-block h-3.5 w-9" style={`background:${ditJaar.kleur}`} aria-hidden="true"></span>{ditJaar.naam}, {ditJaar.ral}</dd></div>
      </dl>
    </section>

    <!-- 2. Alles onder één dak: hun vijf woorden uit de folder als register, naast het pand met de mobiele trekbank. -->
    <section id="diensten" class="scroll-mt-20 border-t border-lijn-sterk py-20 md:py-28" aria-labelledby="diensten-kop">
      <div class="wrap grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <h2 id="diensten-kop" class="text-2xl">Alles onder één dak</h2>
          <figure class="mt-10">
            <div class="aspect-[950/392] overflow-hidden"><Foto src={pand} alt="Het pand van DiLAGO aan Nieuwland Parc met gele letters op de gevel, een witte bus en de opengeklapte mobiele trekbank." sizes="(min-width: 768px) 38vw, 100vw" /></div>
            <figcaption class="mono mt-2 text-staal">Nieuwland Parc 88, met de mobiele trekbank.</figcaption>
          </figure>
        </div>
        <ol class="md:col-span-7">
          {diensten.map(([k, v], i) => (
            <li class="grid gap-2 border-t border-lijn-sterk py-5 last:border-b sm:grid-cols-[3rem_14rem_1fr] sm:gap-6">
              <span class="mono text-staal" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-[1.45rem] leading-tight">{k}</h3>
              <p class="text-staal">{v}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 3. De jaarkleur: hun eigen IMO-tabel, groot. -->
    <section id="jaarkleur" class="scroll-mt-20 bg-grafiet py-20 text-wit md:py-28" aria-labelledby="jaarkleur-kop">
      <div class="wrap grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <h2 id="jaarkleur-kop" class="text-2xl">Gekeurd is te zien</h2>
          <p class="mt-6 max-w-[28rem] text-lg leading-relaxed text-mist">Na de keuring spuiten we elk hijsmiddel in de jaarkleur van het IMO, en u krijgt er een nieuw of bijgewerkt certificaat bij. Liever uw eigen huiskleur, bijvoorbeeld per afdeling? Meld het vooraf.</p>
          <a href={keuringMail} class="knop mt-9 !bg-logo !text-grafiet [box-shadow:inset_0_-4px_0_#1e202340] hover:!bg-wit">Keuring aanvragen</a>
        </div>
        <ul class="grid grid-cols-3 gap-px self-end bg-lijn-licht md:col-span-7 lg:grid-cols-6">
          {jaarkleuren.map((k) => (
            <li class={`flex flex-col bg-grafiet ${k.jaar === 2026 ? 'outline outline-2 outline-wit -outline-offset-2' : ''}`}>
              <span class="block h-24 md:h-36" style={`background:${k.kleur}`} aria-hidden="true"></span>
              <span class="px-3 pt-3 text-[1.6rem] font-semibold leading-none tabular-nums">{k.jaar}</span>
              <span class="px-3 pb-3 pt-1 text-sm text-mist">{k.naam}<br /><span class="mono">{k.ral}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="wrap mt-16 grid grid-cols-5 gap-4 md:mt-20">
        <figure class="col-span-3"><div class="aspect-[1183/985] overflow-hidden"><Foto src={juk} alt="Een groot geel hijsjuk aan een rode kraanarm voor de werkplaats, met mannen in werkkleding ernaast." sizes="(min-width: 768px) 50vw, 60vw" /></div></figure>
        <figure class="col-span-2"><div class="aspect-[598/982] h-full overflow-hidden"><Foto src={testbank} alt="Een hijsbalk met kettingen en gele banden tilt een groen gewicht van een testblok in de werkplaats." sizes="(min-width: 768px) 34vw, 40vw" /></div></figure>
      </div>
    </section>

    <!-- 4. Contact. -->
    <section id="contact" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="contact-kop">
      <div class="wrap grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <h2 id="contact-kop" class="text-3xl">Bel of mail ons</h2>
          <p class="mt-6 max-w-[26rem] text-lg text-staal">Voor advies, een bestelling, huur of een keuring. Ook als u nog geen webklant bent.</p>
        </div>
        <dl class="rapport md:col-span-7 md:pt-3">
          <div><dt>Telefoon</dt><dd class="text-[1.5rem] font-semibold tabular-nums"><a href={site.telHref} class="lijn">{site.tel}</a></dd></div>
          <div><dt>E-mail</dt><dd><a href={vraagMail} class="lijn">{site.mail}</a></dd></div>
          <div><dt>Bereikbaar</dt><dd>Maandag t/m donderdag 8.00 - 17.00<br />Vrijdag 8.00 - 16.00<br />Storingen buiten kantooruren: hetzelfde nummer</dd></div>
          <div><dt>Adres</dt><dd>{site.straat}, {site.postcode} {site.plaats}<br /><a href={site.maps} class="lijn">Route plannen</a></dd></div>
          <div><dt>Google-reviews</dt><dd>{site.google.score} uit {site.google.aantal}: vriendelijk en deskundig, prima contact</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
