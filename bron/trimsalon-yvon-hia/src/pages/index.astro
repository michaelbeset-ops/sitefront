---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waAfspraak, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import nevaVoor from '../assets/neva-voor.jpg';
import nevaNa from '../assets/neva-na.jpg';
import wassen from '../assets/wassen.jpg';
import fohnen from '../assets/fohnen.jpg';
import trimmen from '../assets/trimmen.jpg';
import trimmen2 from '../assets/trimmen-2.jpg';
import yvon from '../assets/yvon.jpg';
import r1 from '../assets/hond-r1.jpg';
import r2 from '../assets/hond-r2.jpg';
import r3 from '../assets/hond-r3.jpg';
import r4 from '../assets/hond-r4.jpg';
import r5 from '../assets/hond-r5.jpg';
import l1 from '../assets/hond-l1.jpg';
import l2 from '../assets/hond-l2.jpg';
import l3 from '../assets/hond-l3.jpg';
import mat1 from '../assets/mat-1.jpg';
import mat2 from '../assets/mat-2.jpg';
import touw2 from '../assets/touw-2.jpg';
import touw3 from '../assets/touw-3.jpg';

const vraag = (b: string) => waMet(`Hallo Yvon, ik wil graag een afspraak maken voor mijn hond: ${b.toLowerCase()}.`);

const behandelingen = [
  { t: 'Wassen', d: 'Eerst een goede wasbeurt in het bad, tot in de krullen.', src: wassen, alt: 'Jaxx, bruin met wit, staat in het bad van de trimsalon', pos: '50% 55%', wa: vraag('wassen en föhnen') },
  { t: 'Föhnen', d: 'Droog op de trimtafel, met een kapje over de oren.', src: fohnen, alt: 'Jaxx op de trimtafel met een kapje over zijn oren terwijl hij geföhnd wordt', pos: '50% 35%', wa: vraag('wassen en föhnen') },
  { t: 'Trimmen en knippen', d: 'De vacht in model, zoals jij het voor je hond wilt.', src: trimmen, alt: 'Yvon trimt Jaxx op de trimtafel in de salon', pos: '45% 40%', wa: vraag('trimmen en knippen') },
  { t: 'Eerste puppytrimbeurt', d: 'Rustig kennismaken met de tafel, de föhn en de schaar.', src: nevaNa, alt: 'Puppy Neva na haar eerste trimbeurt, met een rond geknipt kopje', pos: '50% 55%', wa: vraag('een eerste puppytrimbeurt') },
  { t: 'Alle soorten vachten', d: 'Van goldendoodle tot dwergschnauzer, ook als het een uitdaging is.', src: r1, alt: 'Een blonde doodle met lange vacht staat op de trimtafel', pos: '55% 40%', wa: vraag('trimmen en knippen') },
  { t: 'Snuffelmatten en touwen', d: 'Van fleece, te koop in de salon. Vanaf € 6,95.', src: mat1, alt: 'Snuffelmat van stroken fleece in grijs, zwart en mintgroen op een houten tafel', pos: '50% 50%', wa: '#snuffelmatten' },
];

const stappen = [
  ['Stuur een appje', 'Met de naam en het ras van je hond. Bellen kan ook, maandag tot en met vrijdag.'],
  ['Wassen en föhnen', 'Je hond gaat in bad en wordt daarna op de trimtafel droog geföhnd.'],
  ['Trimmen en knippen', 'Yvon brengt de vacht in model. Zeg gerust hoe je het wilt hebben.'],
  ['Mooi weer naar huis', 'Tijd voor een volgende beurt? Stuur dan weer een appje.'],
];

const salon = [
  { src: r4, alt: 'Een zwart-bruine keeshond zit op de trimtafel', pos: '50% 35%', groot: true },
  { src: r2, alt: 'Een kleine zwart-witte hond staat op de trimtafel', pos: '50% 50%' },
  { src: l1, alt: 'Een bruine, krullende hond zit op de houten vloer van de salon', pos: '50% 50%' },
  { src: r5, alt: 'Een kortgeknipte, beige hond zit op de trimtafel', pos: '50% 35%' },
  { src: l3, alt: 'Een bruine shih tzu ligt op de rand van de trimtafel', pos: '50% 45%' },
  { src: r3, alt: 'Een zwarte, krullende hond met een vers geknipt kopje', pos: '50% 40%' },
  { src: l2, alt: 'Een witte hond met bruine oren kijkt in de camera na zijn trimbeurt', pos: '50% 40%' },
];

const matten = [['Klein', '€ 14,95'], ['Middelgroot', '€ 19,95'], ['Groot', '€ 24,95']];
const touwen = [['Klein', '3 strengen', '€ 6,95'], ['Middel', '6 strengen', '€ 8,95'], ['Groot', '9 strengen', '€ 10,95']];
const sterren = [1, 2, 3, 4, 5];
---
<Base title={`${site.naam} | Hondentrimsalon in Hendrik-Ido-Ambacht`} description="Gediplomeerd hondentrimster, aangesloten bij de ABHB. Wassen, föhnen, trimmen en knippen aan de Paulusweg 79 in Hendrik-Ido-Ambacht. 5,0 op Google. Afspraak via WhatsApp: 06 38 20 05 95.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: Jaxx op de trimtafel, op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.5rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <div class="absolute inset-x-0 top-0 bottom-[38%] -z-20 md:bottom-0 md:left-[30%]">
        <Image src={hero} alt="Jaxx, een bruin-witte hond met lange vacht, staat op het roze matje op de trimtafel" widths={[640, 960, 1280, 1800]} sizes="(min-width: 768px) 70vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[30%_30%] md:object-[20%_35%]" />
      </div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#2a1c1800_0%,#2a1c1800_25%,#2a1c18cc_50%,#2a1c18_64%)] md:bg-[linear-gradient(90deg,#2a1c18_0%,#2a1c18_30%,#2a1c18d9_42%,#2a1c1833_70%,#2a1c1800_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-40 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow"><span class="sm:hidden">Hondentrimsalon, H.I. Ambacht</span><span class="hidden sm:inline">Hondentrimsalon in Hendrik-Ido-Ambacht</span></p>
          <h1 id="t-hero" class="mt-5 text-hero">Mooi getrimd, <span class="text-zalm">met geduld</span> en een babbel.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Wassen, föhnen, trimmen en knippen bij een gediplomeerd hondentrimster. Aan de Paulusweg, maandag tot en met vrijdag.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-mat"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#voor-en-na" class="knop knop-rand op-foto">Bekijk voor en na</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 9.00 tot 17.00 uur</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:col-start-9 lg:flex lg:justify-end lg:self-end">
          <a href={site.telHref} class="flex items-center gap-4 rounded-lg bg-nacht/70 px-5 py-4 no-underline ring-1 ring-licht/15 backdrop-blur-md transition-colors hover:bg-nacht/90">
            <span class="grid h-11 w-11 place-items-center rounded-md bg-mat text-wit"><Icoon naam="tel" class="h-5 w-5" /></span>
            <span class="text-sm leading-snug text-licht-zacht">Bellen of appen<b class="num block font-kop text-xl font-bold text-licht">{site.tel}</b></span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="In de salon, in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href={c.startsWith('Snuffel') || c.startsWith('Fleece') ? '#snuffelmatten' : '#behandelingen'} class="shrink-0 rounded-md bg-poeder px-4 py-2 text-sm font-medium no-underline transition-colors hover:bg-mat hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Behandelingen -->
    <section id="behandelingen" class="py-20 lg:py-[5.5rem]" aria-labelledby="t-beh">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">In de salon</p>
            <h2 id="t-beh" class="mt-4 text-3xl">Van een sopje in bad tot een vacht helemaal in model.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Alle foto’s komen uit de salon zelf. Tik op een kaart en je stuurt Yvon meteen een appje.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {behandelingen.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={b.wa} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[4/3]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-4 sm:p-6">
                  <div>
                    <h3 class="text-[1.0625rem] sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-md bg-poeder text-mat transition-colors group-hover:bg-mat group-hover:text-wit sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-lg bg-poeder px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Wat kost een trimbeurt?</b> <span class="text-grijs">Dat hangt af van je hond en de vacht. Stuur Yvon even een appje.</span></p>
          <a href={waMet('Hallo Yvon, wat kost een trimbeurt voor mijn hond? Het is een ')} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="wa" />Vraag het Yvon</a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Score op Google</dt><dd class="cijfer order-first text-mat">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Reviews, allemaal 5 sterren</dt><dd class="cijfer order-first">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Gediplomeerd sinds</dt><dd class="cijfer order-first">2024</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Dagen per week open</dt><dd class="cijfer order-first">5</dd></div>
      </dl>
    </section>

    <!-- 5. Voor en na: Neva -->
    <section id="voor-en-na" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-neva">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="rijs lg:col-span-4">
          <p class="eyebrow">Voor en na</p>
          <h2 id="t-neva" class="mt-4 text-3xl">Neva, haar eerste trimbeurt.</h2>
          <blockquote class="mt-8 border-l-2 border-zalm pl-5 text-xl leading-snug text-licht">“Dit vind ik toch stiekem wel het leukste om te doen, die eerste puppy trimbeurtjes, wat een metamorfose.”</blockquote>
          <p class="mt-4 text-sm text-licht-zacht">Yvon op Facebook, oktober 2024</p>
          <a href={vraag('een eerste puppytrimbeurt')} class="knop knop-mat mt-10"><Icoon naam="wa" />Puppy aanmelden</a>
        </div>
        <div class="relative grid grid-cols-2 gap-3 md:gap-5 lg:col-span-8">
          <figure class="rijs relative overflow-hidden rounded-lg">
            <Image src={nevaVoor} alt="Neva voor de trimbeurt: een bruine puppy met een lange, pluizige vacht op het roze matje" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-[3/4] w-full object-cover" />
            <figcaption class="absolute left-3 top-3 rounded-md bg-nacht/80 px-3 py-1 text-sm font-semibold backdrop-blur-sm md:left-4 md:top-4">Voor</figcaption>
          </figure>
          <figure class="rijs relative overflow-hidden rounded-lg" style="--d:.1s">
            <Image src={nevaNa} alt="Neva na de trimbeurt: kort en rond geknipt, met een rond kopje" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-[3/4] w-full object-cover" />
            <figcaption class="absolute left-3 top-3 rounded-md bg-mat px-3 py-1 text-sm font-semibold text-wit md:left-4 md:top-4">Na</figcaption>
          </figure>
          <span class="absolute left-1/2 top-1/2 grid h-12 w-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-licht text-mat shadow-md md:h-14 md:w-14" aria-hidden="true"><Icoon naam="pijl" class="h-6 w-6" /></span>
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section class="py-20 lg:py-[5.5rem]" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo gaat het</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van appje tot een frisse vacht.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Zo ging het ook bij Jaxx, bij zijn eerste trimbeurt in de salon.</p>
        </div>
        <ol class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative overflow-hidden p-5 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.5rem] font-extrabold leading-none tracking-[-0.04em] text-poeder-2">0{i + 1}</p>
              <h3 class="mt-5 text-[1.0625rem] sm:mt-7 sm:text-xl">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
              <span class="absolute inset-x-0 top-0 h-1 bg-mat" style={`transform-origin:left;transform:scaleX(${(i + 1) / 4})`} aria-hidden="true"></span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over Yvon -->
    <section id="yvon" class="donker bg-nacht text-licht" aria-labelledby="t-yvon">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[26rem] sm:min-h-[34rem] lg:col-span-5">
          <Image src={yvon} alt="Yvon geknield in het gras naast een blonde, krullende hond" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_30%]" />
          <p class="absolute bottom-4 left-4 rounded-md bg-mat px-4 py-1.5 text-sm font-semibold text-wit">Yvon, hondentrimster</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-20 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Yvon</p>
          <h2 id="t-yvon" class="mt-4 text-3xl">Gediplomeerd, en altijd in voor een babbel.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Yvon trimt honden in haar eigen salon aan de Paulusweg in Hendrik-Ido-Ambacht. In oktober 2024 slaagde ze als hondentrimster, en ze is aangesloten bij de ABHB. Grote en kleine honden, puppy’s en vachten die wat meer werk vragen: ze komen allemaal op haar tafel.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-mat text-wit"><Icoon naam="badge" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Gediplomeerd en aangesloten</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Geslaagd in oktober 2024, aangesloten bij de ABHB.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-mat text-wit"><Icoon naam="schaar" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Ook voor lastige vachten</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Een goldendoodle, een dwergschnauzer: baasjes zijn er blij mee.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-mat text-wit"><Icoon naam="hart" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Geduld en een vrolijke babbel</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Honden gaan met plezier naar binnen, schrijven baasjes.</p></div>
            </li>
          </ul>
          <a href={waAfspraak} class="knop knop-mat mt-8"><Icoon naam="wa" />Plan een afspraak</a>
        </div>
      </div>
    </section>

    <!-- 8. Uit de salon -->
    <section id="salon" class="bg-poeder py-20 lg:py-[5.5rem]" aria-labelledby="t-salon">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Uit de salon</p>
            <h2 id="t-salon" class="mt-4 text-3xl">Veel verschillende rassen op tafel.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-grijs">Een greep uit de honden die Yvon de afgelopen tijd trimde. Meer op haar Facebook-pagina.</p>
            <a href={site.facebook} class="knop knop-rand knop-klein mt-6"><Icoon naam="fb" />Volg op Facebook</a>
          </div>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14 lg:grid-cols-5">
          {salon.map((w, i) => (
            <li class={`rijs relative overflow-hidden rounded-md bg-poeder-2 ${w.groot ? 'col-span-2 row-span-2 aspect-square' : 'aspect-square'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={w.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={w.groot ? '(min-width: 1248px) 470px, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 280px, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" style={`object-position:${w.pos}`} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. Reviews -->
    <section id="reviews" class="py-20 lg:py-[5.5rem]" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat baasjes zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="font-kop text-2xl font-extrabold">{site.google.score}</b><span class="flex text-ster">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-poeder font-kop font-bold text-mat" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
