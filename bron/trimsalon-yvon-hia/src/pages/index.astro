  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const hond = v('hond') ? v('hond') + (v('ras') ? `, een ${v('ras')}` : '') : v('ras') ? `mijn ${v('ras')}` : 'mijn hond';
      const r = [`Hallo Yvon, ik wil graag een afspraak maken voor ${hond}.`];
      if (v('beh')) r.push('Graag: ' + v('beh').toLowerCase());
      if (v('dag')) r.push('Het liefst op ' + v('dag').toLowerCase());
      if (v('wens')) r.push('Goed om te weten: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31638200595?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

