---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Foto from '../components/Foto.astro';
import Wa from '../components/Wa.astro';
import { site, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import nevaVoor from '../assets/neva-voor.jpg';
import nevaNa from '../assets/neva-na.jpg';
import wassen from '../assets/wassen.jpg';
import fohnen from '../assets/fohnen.jpg';
import trimmen from '../assets/trimmen.jpg';
import yvon from '../assets/yvon.jpg';
import hond1 from '../assets/hond-1.jpg';
import hond2 from '../assets/hond-2.jpg';
import hond3 from '../assets/hond-3.jpg';
import hond4 from '../assets/hond-4.jpg';
import snuffelmat from '../assets/snuffelmat.jpg';
import fleecetouw from '../assets/fleecetouw.jpg';

const stappen = [
  { src: wassen, t: 'Wassen', alt: 'Jaxx, bruin met wit, in het bad van de trimsalon' },
  { src: fohnen, t: 'Föhnen', alt: 'Jaxx op de trimtafel met een kapje over zijn oren tegen het geluid van de föhn' },
  { src: trimmen, t: 'Trimmen', alt: 'Yvon trimt Jaxx op de trimtafel met het oudroze matje' },
];
const matten = [['Klein', '€ 14,95'], ['Middelgroot', '€ 19,95'], ['Groot', '€ 24,95']];
const touwen = [['Klein', '3 strengen', '€ 6,95'], ['Middel', '6 strengen', '€ 8,95'], ['Groot', '9 strengen', '€ 10,95']];
---
<Base
  title="Trimsalon Yvon | Hondentrimsalon in Hendrik-Ido-Ambacht"
  description="Gediplomeerd hondentrimster, aangesloten bij de ABHB. Paulusweg 79, Hendrik-Ido-Ambacht. Maandag tot en met vrijdag open. Afspraak via WhatsApp: 06 38 20 05 95."
>
  <Kop />
  <main id="inhoud">

    <!-- Eén scherm: links het oudroze vlak van de trimtafel, rechts Jaxx op dat matje. -->
    <section class="hero grid grid-rows-[auto_1fr] lg:grid-cols-12 lg:grid-rows-1" aria-labelledby="t-hero">
      <div class="beeld relative order-1 lg:order-2 lg:col-span-6">
        <Foto src={hero} alt="Jaxx, een bruin-witte hond met lange vacht, staat op de trimtafel in de salon van Yvon" hero sizes="(min-width: 1024px) 50vw, 100vw" class="object-[62%_40%]" />
      </div>
      <div class="vlak order-2 flex flex-col justify-end bg-mat px-5 pb-9 pt-8 md:px-10 lg:order-1 lg:col-span-6 lg:justify-center lg:pb-16 lg:pl-[max(2.5rem,calc((100vw-84rem)/2+2.5rem))] lg:pr-14 lg:pt-16">
        <p class="ui text-grijs">Hondentrimsalon in <br class="sm:hidden" />Hendrik-Ido-Ambacht</p>
        <h1 id="t-hero" class="mt-5 text-4xl lg:mt-8">Mooi getrimd bij&nbsp;Yvon.</h1>
        <p class="mt-5 hidden max-w-[27rem] text-grijs sm:block lg:mt-8 lg:text-lg">Gediplomeerd hondentrimster en aangesloten bij de ABHB. Aan de Paulusweg, maandag tot en met vrijdag.</p>
        <p class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4 lg:mt-11">
          <a href={waMet('ik wil graag een afspraak maken voor mijn hond.')} class="knop knop-vol"><Wa />Afspraak via WhatsApp</a>
          <a href="#voor-en-na" class="lijn text-[.9375rem]">Bekijk voor en na</a>
        </p>
      </div>
    </section>

    <!-- 1. Voor en na: Neva. -->
    <section id="voor-en-na" class="scroll-mt-20 py-24 lg:py-40" aria-labelledby="t-neva">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-4 lg:pt-10">
          <h2 id="t-neva" class="text-3xl">Neva, eerste trimbeurt.</h2>
          <p class="mt-6 max-w-[24rem] text-grijs">“Dit vind ik toch stiekem wel het leukste om te doen, die eerste puppy trimbeurtjes, wat een metamorfose.”</p>
          <p class="mt-4 text-sm text-grijs">Yvon op Facebook</p>
        </div>
        <div class="grid grid-cols-2 gap-3 md:gap-5 lg:col-span-8">
          <figure class="rijs">
            <div class="aspect-[3/4] overflow-hidden bg-mat"><Foto src={nevaVoor} alt="Neva voor de trimbeurt: een bruine puppy met een lange, pluizige vacht" sizes="(min-width: 1024px) 32vw, 50vw" /></div>
            <figcaption class="ui mt-3 text-grijs">Voor</figcaption>
          </figure>
          <figure class="rijs" style="--d:.12s">
            <div class="aspect-[3/4] overflow-hidden bg-mat"><Foto src={nevaNa} alt="Neva na de trimbeurt: kort en rond geknipt, met een rond kopje" sizes="(min-width: 1024px) 32vw, 50vw" /></div>
            <figcaption class="ui mt-3 text-grijs">Na</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Een trimbeurt: Jaxx in drie foto's. -->
    <section id="trimbeurt" class="scroll-mt-20 bg-wit py-24 lg:py-40" aria-labelledby="t-trim">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-8">
          <h2 id="t-trim" class="text-3xl lg:col-span-6">Wassen, föhnen, trimmen.</h2>
          <p class="max-w-[30rem] text-grijs lg:col-span-5 lg:col-start-8 lg:self-end">Zo ging het bij Jaxx, bij zijn eerste trimbeurt. Prijzen? Stuur Yvon even een appje.</p>
        </div>
        <ol class="mt-14 grid gap-x-5 gap-y-10 sm:grid-cols-3 lg:mt-20">
          {stappen.map((s, i) => (
            <li class:list={['rijs', { 'sm:mt-16': i === 1, 'sm:mt-32': i === 2 }]} style={`--d:${i * 0.1}s`}>
              <div class="aspect-[4/5] overflow-hidden bg-mat"><Foto src={s.src} alt={s.alt} sizes="(min-width: 640px) 33vw, 100vw" /></div>
              <p class="mt-4 text-lg font-medium tracking-[-.02em]">{s.t}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 3. Yvon, en wat baasjes over haar schrijven. -->
    <section id="yvon" class="scroll-mt-20 py-24 lg:py-40" aria-labelledby="t-yvon">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
        <figure class="rijs lg:col-span-5">
          <div class="aspect-[4/5] overflow-hidden bg-mat"><Foto src={yvon} alt="Yvon geknield in het gras naast een blonde, krullende hond" sizes="(min-width: 1024px) 40vw, 100vw" class="object-[50%_30%]" /></div>
        </figure>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-16">
          <h2 id="t-yvon" class="text-3xl">Officieel hondentrimster.</h2>
          <p class="mt-8 max-w-[32rem] text-lg text-grijs">In oktober 2024 slaagde Yvon, na bijna twee jaar stage en school. Ze is aangesloten bij de ABHB, de vakvereniging van hondentrimmers.</p>
          <div class="mt-14 border-t border-lijn pt-10">
            <p class="max-w-[32rem] text-xl leading-snug tracking-[-.015em]">Baasjes noemen haar vriendelijk en betaalbaar. Hun honden gaan met plezier naar binnen, en ook een goldendoodle of een dwergschnauzer komt mooi terug.</p>
            <p class="num mt-6 text-sm text-grijs">{site.google} op Google, uit {site.googleAantal} reviews.</p>
          </div>
        </div>
      </div>

      <div class="wrap mt-20 lg:mt-32">
        <ul class="strook grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5" aria-label="Honden uit de salon">
          <li class="rijs"><div class="aspect-square overflow-hidden bg-mat"><Foto src={hond1} alt="Witte, krullende hond op de trimtafel" sizes="(min-width: 768px) 25vw, 50vw" class="object-[40%_50%]" /></div></li>
          <li class="rijs" style="--d:.08s"><div class="aspect-square overflow-hidden bg-mat"><Foto src={hond2} alt="Zwart met crème gekleurde hond met dikke vacht op de trimtafel" sizes="(min-width: 768px) 25vw, 50vw" class="object-[45%_45%]" /></div></li>
          <li class="rijs" style="--d:.16s"><div class="aspect-square overflow-hidden bg-mat"><Foto src={hond3} alt="Lichtbruine, kortgeknipte hond op de trimtafel" sizes="(min-width: 768px) 25vw, 50vw" class="object-[50%_35%]" /></div></li>
          <li class="rijs" style="--d:.24s"><div class="aspect-square overflow-hidden bg-mat"><Foto src={hond4} alt="Bruine, krullende hond die over de rand van de trimtafel kijkt" sizes="(min-width: 768px) 25vw, 50vw" class="object-[50%_40%]" /></div></li>
        </ul>
      </div>
    </section>

    <!-- 4. Snuffelmatten en fleecetouwen, met hun eigen prijslijst. -->
    <section id="snuffelmatten" class="scroll-mt-20 bg-mat py-24 lg:py-40" aria-labelledby="t-snuf">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-5">
          <h2 id="t-snuf" class="text-3xl">Snuffelmatten en fleecetouwen.</h2>
          <p class="mt-8 max-w-[28rem] text-grijs">Door te snuffelen leest een hond de wereld. Daarom verkoopt Yvon in de salon snuffelmatten en snuffel- en speeltouwen van fleece, samen met hondenservice Miranda Ambra.</p>

          <div class="mt-12 max-w-[28rem] space-y-10">
            <div>
              <h3 class="ui text-grijs">Snuffelmatten</h3>
              <dl class="num mt-3">
                {matten.map(([m, p]) => <div class="flex justify-between gap-6 border-b border-lijn py-3"><dt>{m}</dt><dd class="whitespace-nowrap">{p}</dd></div>)}
              </dl>
            </div>
            <div>
              <h3 class="ui text-grijs">Snuffel- en speeltouwen</h3>
              <dl class="num mt-3">
                {touwen.map(([m, s, p]) => <div class="flex justify-between gap-6 border-b border-lijn py-3"><dt>{m} <span class="text-grijs">{s}</span></dt><dd class="whitespace-nowrap">{p}</dd></div>)}
              </dl>
            </div>
          </div>
          <p class="mt-10"><a href={waMet('ik heb interesse in een snuffelmat. Welke kleuren heb je nu?')} class="lijn text-[.9375rem]">Vraag welke kleuren er zijn</a></p>
        </div>
        <div class="grid grid-cols-2 gap-3 self-start md:gap-5 lg:col-span-6 lg:col-start-7">
          <div class="rijs aspect-[3/4] overflow-hidden bg-mat-diep"><Foto src={snuffelmat} alt="Ronde snuffelmat van stroken fleece in grijs, zwart en mintgroen op een houten tafel" sizes="(min-width: 1024px) 25vw, 50vw" /></div>
          <div class="rijs mt-12 aspect-[3/4] overflow-hidden bg-mat-diep lg:mt-24" style="--d:.1s"><Foto src={fleecetouw} alt="Gevlochten fleecetouw in grijs en oranje met een knoop" sizes="(min-width: 1024px) 25vw, 50vw" /></div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .hero { min-height: calc(100svh - var(--balk, 0px) - 4rem); }
  .beeld { height: 44svh; }
  @media (min-width: 768px) { .hero { min-height: calc(100svh - var(--balk, 0px) - 5rem); } }
  @media (min-width: 1024px) { .beeld { height: auto; } }
  .vlak { min-height: 0; }
</style>
