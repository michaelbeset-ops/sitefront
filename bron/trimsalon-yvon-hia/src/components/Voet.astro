---
import { Image } from 'astro:assets';
import { site, url, tijden, waAfspraak } from '../data/site';
import Icoon from './Icoon.astro';
import logo from '../assets/logo.png';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const diensten = ['Wassen en föhnen', 'Trimmen en knippen', 'Eerste puppytrimbeurt', 'Alle soorten vachten', 'Snuffelmatten en fleecetouwen'];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <Image src={logo} alt="" width={88} height={88} />
        <span><b>Trimsalon Yvon</b><small>Hendrik-Ido-Ambacht</small></span>
      </a>
      <p class="mt-6 max-w-xs">Hondentrimsalon aan de Paulusweg. Gediplomeerd hondentrimster, aangesloten bij de ABHB.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-mat" aria-label="Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
        <a href={waAfspraak} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-mat" aria-label="WhatsApp"><Icoon naam="wa" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">In de salon</p>
      <ul class="mt-4 space-y-2">
        {diensten.map((c) => <li><a href={h(c.startsWith('Snuffel') ? 'snuffelmatten' : 'behandelingen')} class="no-underline transition-colors hover:text-zalm">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-zalm">{site.tel}</a></li>
        <li><a href={waAfspraak} class="no-underline transition-colors hover:text-zalm">WhatsApp</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.maps} class="no-underline transition-colors hover:text-zalm">Route plannen</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Openingstijden</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Openingstijden</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-zalm">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p class="num">© {jaar} {site.naam}, {site.plaats}. KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-zalm">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s en logo van de Facebook-pagina en het Google-bedrijfsprofiel van Trimsalon Yvon. Reviews letterlijk van Google (stand 2 oktober 2026).</p>}
  </div>
</footer>
