---
// Header: woordmerk links, rustige navigatie, WhatsApp rechts. Op mobiel een menu-paneel.
import { site, url, waMet } from '../data/site';
import Wa from './Wa.astro';
const nav = [
  ['Voor en na', '#voor-en-na'],
  ['Trimbeurt', '#trimbeurt'],
  ['Yvon', '#yvon'],
  ['Snuffelmatten', '#snuffelmatten'],
  ['Contact', '#contact'],
];
const thuis = url('');
const waTekst = 'ik wil graag een afspraak maken voor mijn hond.';
---
<header class="kop sticky top-0 z-40" data-kop>
  <div class="wrap flex h-16 items-center justify-between gap-6 md:h-20">
    <a href={thuis} class="flex items-baseline gap-2.5" aria-label="Yvon Trimsalon, naar de homepage">
      <span class="woordmerk text-[1.375rem]" aria-hidden="true">Yvon</span>
      <span class="ui text-grijs max-[359px]:hidden" aria-hidden="true">Trimsalon</span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="ui flex gap-9">
        {nav.map(([t, h]) => <li><a href={`${thuis}${h}`} class="lijn-in">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5 sm:gap-6">
      <a href={site.telHref} class="ui num lijn-in hidden xl:inline">{site.tel}</a>
      <a href={waMet(waTekst)} class="knop knop-vol knop-klein"><Wa /><span class="max-[429px]:sr-only">WhatsApp</span></a>
      <button type="button" class="ui lg:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>Menu</button>
    </div>
  </div>

  <div id="menu" class="menu lg:hidden" hidden data-menu>
    <nav aria-label="Menu" class="wrap flex min-h-full flex-col justify-between gap-10 pb-10 pt-8">
      <ul class="space-y-1">
        {nav.map(([t, h]) => <li><a href={`${thuis}${h}`} class="block py-1 text-[2.125rem] font-medium leading-tight tracking-[-.035em]" data-menu-link>{t}</a></li>)}
      </ul>
      <p class="space-y-3">
        <a href={waMet(waTekst)} class="knop knop-vol w-full"><Wa />Afspraak via WhatsApp</a>
        <a href={site.telHref} class="knop num w-full">Bel {site.tel}</a>
      </p>
    </nav>
  </div>
</header>

<style>
  .kop { color: var(--color-inkt); background-color: color-mix(in srgb, var(--color-papier) 94%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: box-shadow .5s var(--ease-zacht); }
  .kop.schaduw { box-shadow: 0 1px 0 var(--color-lijn); }
  .menu { position: fixed; left: 0; right: 0; bottom: 0; top: 4rem; background: var(--color-papier); color: var(--color-inkt); overflow-y: auto; }
</style>

<script>
  const kop = document.querySelector<HTMLElement>('[data-kop]')!;
  const zet = () => kop.classList.toggle('schaduw', scrollY > 8);
  zet(); addEventListener('scroll', zet, { passive: true });
  const knop = kop.querySelector<HTMLButtonElement>('[data-menu-knop]')!;
  const menu = kop.querySelector<HTMLElement>('[data-menu]')!;
  const open = (aan: boolean) => {
    menu.style.top = kop.getBoundingClientRect().bottom + 'px';
    menu.hidden = !aan;
    kop.classList.toggle('open', aan);
    knop.setAttribute('aria-expanded', String(aan));
    knop.textContent = aan ? 'Sluiten' : 'Menu';
    document.documentElement.style.overflow = aan ? 'hidden' : '';
  };
  knop.addEventListener('click', () => open(menu.hidden));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => open(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { open(false); knop.focus(); } });
</script>
