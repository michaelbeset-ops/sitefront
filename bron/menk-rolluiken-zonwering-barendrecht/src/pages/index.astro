---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, particulier, zakelijk, merken } from '../data/site';
import hero from '../assets/gevel-screens.jpg';
import ramen from '../assets/ramen-rolluiken.jpg';
import roldeur from '../assets/roldeur.jpg';
import speeddeur from '../assets/speeddeur.jpg';
import schaarhek from '../assets/schaarhek.jpg';
import schaduw from '../assets/lamellen-schaduw.jpg';

const uitvoeringen = [
  { id: 'gesloten', naam: 'Gesloten', tekst: 'Inkijk en lichtinval zijn absoluut uitgesloten. Ideaal als u regelmatig lang van huis bent, of voor een pand in een gebied met meer inbraak en vandalisme.' },
  { id: 'geperforeerd', naam: 'Geperforeerd', tekst: 'Bijna dezelfde beveiliging, maar met een beperkte doorlaat van zicht, licht en lucht: het screen-effect. Zwaar beveiligd, met toch wat comfort.' },
  { id: 'transparant', naam: 'Transparant', tekst: 'Voor de etalage. Uw winkel blijft zichtbaar en representatief, terwijl het rolluik de pui beveiligt.' },
];

const stappen = [
  ['Advies', 'Wij komen vrijblijvend langs met advies op maat, aan de hand van voorbeelden en stalen. Zakelijk kan het ook bij ons op kantoor.'],
  ['Offerte', 'U krijgt een vrijblijvende offerte met de besproken opties. Daarna heeft u 30 dagen om te beslissen.'],
  ['Inmeten', 'Na uw akkoord meet ons meetteam alle kozijnen nauwkeurig in. Heeft u alleen een tekening van het pand, dan is dat ook goed.'],
  ['Vergunning', 'Is er een vergunning nodig, of toestemming van de VvE of verhuurder? Die aanvraag regelen wij voor u.'],
  ['Montage', 'Onze eigen technische dienst monteert. Kiest u voor elektrische bediening, dan werken wij met motoren van Somfy en Becker.'],
];
---
<Base
  title="Menk Rolluiken & Zonwering, Barendrecht | Rolluiken, brandroldeuren en zonwering"
  description="Rolluiken, brandwerende roldeuren, speeddeuren, rolhekken, zonwering, markiezen en horren voor woning en bedrijf. Ingemeten en gemonteerd door onze eigen technische dienst. Middeldijk 56a, Barendrecht, 0180 634 267."
>
  <div class="relative">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: een half neergelaten rolluik over de gevel -->
    <section class="relative isolate flex min-h-[100svh] flex-col bg-nacht text-wit" aria-labelledby="hero-kop">
      <Picture src={hero} alt="" widths={[640, 960, 1400, 2000, 2600]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_62%]" />
      <div class="absolute inset-x-0 top-0 -z-10 h-48 bg-[linear-gradient(180deg,#17112fcc,#17112f00)]"></div>
      <div class="min-h-[30svh] flex-1 md:min-h-[46svh]"></div>
      <div class="pantser relative shadow-[0_-18px_40px_-20px_#17112f99]">
        <!-- bovenkast + onderlat van het rolluik -->
        <div class="absolute inset-x-0 -top-3 h-3 bg-[linear-gradient(180deg,#5a4a9e,#30235d)]" aria-hidden="true"></div>
        <div class="wrap pb-8 pt-8 md:pb-10 md:pt-10">
          <h1 id="hero-kop" class="max-w-[16ch] text-hero md:max-w-none">Rolluiken, brandroldeuren <span class="text-lila">en zonwering.</span></h1>
          <div class="mt-7 grid gap-8 md:mt-9 md:grid-cols-12 md:items-end">
            <p class="max-w-xl text-lg text-wit/90 md:col-span-6 md:text-xl">Voor woning, winkel en bedrijfspand. Wij meten in, en onze eigen technische dienst monteert.</p>
            <div class="flex flex-wrap gap-3 md:col-span-6 md:justify-end">
              <a href="#maten" class="knop knop-vol">Maten doorgeven<Icoon naam="pijl" /></a>
              <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
            </div>
          </div>
        </div>
        <div class="h-4 bg-[linear-gradient(180deg,#221a4d,#17112f)]" aria-hidden="true">
          
        </div>
        <p class="wrap flex flex-wrap justify-between gap-x-6 gap-y-1 py-3 text-sm text-mist">
          <span>{site.straat}, {site.plaats}</span>
          <span>Particulier en zakelijk</span>
        </p>
      </div>
    </section>

    <!-- 2. Twee ingangen -->
    <section class="py-20 md:py-28" aria-labelledby="in-kop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12">
          <h2 id="in-kop" class="rijs text-4xl text-indigo lg:col-span-7">Voor thuis. En voor de zaak.</h2>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9 lg:pt-4" style="--d:.1s">Uitsluitend hoogwaardige producten en maatwerk, afgestemd op de particuliere én de zakelijke klant.</p>
        </div>

        <div class="mt-16 grid gap-x-12 gap-y-20 lg:mt-20 lg:grid-cols-12">
          <article id="particulier" class="lg:col-span-6">
            <figure class="rijs relative">
              <Picture src={ramen} alt="Ramen met neergelaten rolluiken in een witte gevel" widths={[480, 720, 960, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" formats={['avif', 'webp']} class="aspect-[4/3] w-full object-cover object-[50%_45%]" />
              <figcaption class="absolute bottom-3 right-4 text-xs text-wit/90 [text-shadow:0_1px_2px_#0008]">Sfeerbeeld</figcaption>
            </figure>
            <h3 class="rijs mt-8 text-3xl text-indigo">Particulier</h3>
            <p class="rijs mt-3 max-w-md text-grijs">Geen idee wat het beste bij uw woning past? Wij komen geheel vrijblijvend langs met een passend advies op maat.</p>
            <ul class="mt-8 border-b border-lijn-licht">
              {particulier.map((p, i) => (
                <li class="rijs flex items-baseline justify-between gap-4 border-t border-lijn-licht py-3.5" style={`--d:${i * 0.05}s`}>
                  <span class="font-kop text-2xl text-inkt md:text-[2rem]">{p}</span>
                </li>
              ))}
            </ul>
          </article>

          <article id="zakelijk" class="lg:col-span-5 lg:col-start-8 lg:pt-40">
            <figure class="rijs relative">
              <Picture src={roldeur} alt="Een gesloten aluminium roldeur in een betonnen bedrijfsgevel" widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 38vw, 100vw" formats={['avif', 'webp']} class="aspect-[4/5] w-full object-cover" />
              <figcaption class="absolute bottom-3 right-4 text-xs text-wit/90 [text-shadow:0_1px_2px_#0008]">Sfeerbeeld</figcaption>
            </figure>
            <h3 class="rijs mt-8 text-3xl text-indigo">Zakelijk</h3>
            <p class="rijs mt-3 max-w-md text-grijs">Kleine, middelgrote en grote projecten. Van zonwering en rolluiken tot het aanleggen van de besturing, met onze eigen gecertificeerde montageservice.</p>
            <ul class="mt-8 columns-1 gap-8 border-t border-lijn-licht pt-4 text-[1.0625rem] sm:columns-2">
              {zakelijk.map((p) => <li class="break-inside-avoid py-1.5 text-inkt">{p}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 3. Uitvoering van het rolluik -->
    <section id="uitvoering" class="alu py-20 md:py-28" aria-labelledby="ui-kop">
      <div class="wrap grid items-center gap-x-14 gap-y-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="ui-kop" class="rijs text-4xl text-indigo">Dicht, half open of doorzichtig.</h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs" style="--d:.08s">Onze rolluiken zijn van kwaliteitsstaal of aluminium. Welke uitvoering past, hangt af van het doel, uw wensen of de eisen van uw verzekering.</p>
          <div class="rijs mt-10" style="--d:.12s" role="radiogroup" aria-label="Uitvoering" data-uitvoering>
            {uitvoeringen.map((u, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-u={u.id} data-tekst={u.tekst} class="group flex w-full items-baseline justify-between gap-4 border-t border-lijn-licht py-4 text-left last:border-b aria-checked:text-indigo">
                <span class="font-kop text-3xl text-grijs transition-colors group-hover:text-indigo group-aria-checked:text-indigo">{u.naam}</span>
                <span class="h-3.5 w-3.5 shrink-0 rounded-full border-2 border-indigo/50 transition-colors group-aria-checked:border-indigo group-aria-checked:bg-indigo" aria-hidden="true"></span>
              </button>
            ))}
          </div>
          <p class="mt-6 min-h-[5.5rem] max-w-md text-inkt" aria-live="polite" data-u-tekst>{uitvoeringen[0].tekst}</p>
        </div>

        <figure class="rijs lg:col-span-6 lg:col-start-7" style="--d:.1s" aria-label="Voorbeeld van de gekozen uitvoering voor een raam">
          <div class="relative mx-auto aspect-[5/6] max-w-[30rem] bg-wit p-4 shadow-[0_30px_60px_-30px_#30235d66] md:p-6">
            <!-- kast -->
            <div class="relative h-full border-[10px] border-alu-2 bg-[linear-gradient(160deg,#7d8aa6,#b8c4d8_45%,#e6ebf2)]">
              <div class="absolute inset-x-0 top-1/2 h-px bg-alu-2"></div>
              <div class="absolute inset-y-0 left-1/2 w-px bg-alu-2"></div>
              <div class="absolute inset-x-0 top-0 h-[78%] overflow-hidden"><div class="profiel profiel-gesloten" data-p="gesloten"></div><div class="profiel profiel-geperforeerd opacity-0" data-p="geperforeerd"></div><div class="profiel profiel-transparant opacity-0" data-p="transparant"></div><div class="absolute inset-x-0 bottom-0 h-2.5 bg-indigo"></div></div>
              <div class="absolute inset-x-0 -top-[10px] h-9 -translate-y-full bg-[linear-gradient(180deg,#e9eaee,#c3c6d0)] shadow-sm"></div>
            </div>
          </div>
          <figcaption class="mt-4 text-center text-sm text-grijs">Op elke uitvoering kan val- en stormbeveiliging.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Zakelijk: brandwerend en beveiligd -->
    <section class="pantser relative overflow-hidden text-wit" aria-labelledby="bw-kop">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[26rem] lg:col-span-5 lg:min-h-full">
          <Picture src={speeddeur} alt="Een blauwe speeddeur met kijkvensters in een distributiecentrum" widths={[640, 960, 1300]} sizes="(min-width: 1024px) 42vw, 100vw" formats={['avif', 'webp']} class="absolute inset-0 h-full w-full object-cover object-[50%_40%]" />
          <span class="absolute bottom-3 left-4 text-xs text-wit/85 [text-shadow:0_1px_2px_#0008]">Speeddeur, productfoto van menkrolluiken.nl</span>
        </div>
        <div class="px-5 py-24 md:px-10 md:py-32 lg:col-span-7 lg:pl-16 lg:pr-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))]">
          <h2 id="bw-kop" class="rijs text-4xl">Voor winkel, kantoor en bedrijfshal.</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-mist" style="--d:.08s">Voor winkel- en bedrijfspanden is een rolluik vaak een vereiste voor de brand- en inbraakverzekering. Uw wensen en de eisen van de verzekering verwerken wij makkelijk, op maat, of u er nu één neemt of honderd.</p>
          <dl class="mt-12 max-w-2xl">
            <div class="rijs grid gap-2 border-t border-lijn-2 py-5 md:grid-cols-[14rem_1fr] md:gap-6">
              <dt class="font-kop text-2xl text-lila">Brandwerend</dt>
              <dd class="text-mist">Rolluiken, rolschermen en schuifdeuren die brand minder snel laten overslaan naar de ruimte erachter.</dd>
            </div>
            <div class="rijs grid gap-2 border-t border-lijn-2 py-5 md:grid-cols-[14rem_1fr] md:gap-6" style="--d:.05s">
              <dt class="font-kop text-2xl text-lila">Speeddeuren</dt>
              <dd class="text-mist">Openen en sluiten met ongeveer 1 meter per seconde, zodat het binnen even warm of koel blijft.</dd>
            </div>
            <div class="rijs grid gap-2 border-t border-lijn-2 py-5 md:grid-cols-[14rem_1fr] md:gap-6" style="--d:.1s">
              <dt class="font-kop text-2xl text-lila">Geïsoleerde roldeuren</dt>
              <dd class="text-mist">Een grote deur zonder isolatie kost veel energie. Geïsoleerd bespaart u daarop.</dd>
            </div>
            <div class="rijs grid gap-2 border-t border-lijn-2 py-5 md:grid-cols-[14rem_1fr] md:gap-6" style="--d:.15s">
              <dt class="font-kop text-2xl text-lila">Balie en pui</dt>
              <dd class="text-mist">Balie rolluiken, rolhekken en schaarhekken beschermen medewerkers en goederen tegen agressie, inbraak en overvallen.</dd>
            </div>
            <div class="rijs grid gap-2 border-y border-lijn-2 py-5 md:grid-cols-[14rem_1fr] md:gap-6" style="--d:.2s">
              <dt class="font-kop text-2xl text-lila">Onderhoud</dt>
              <dd class="text-mist">Voor bedrijven, scholen en artsenpraktijken onderhouden wij de zonwering, jaarlijks of eens per twee jaar.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section id="werkwijze" class="py-20 md:py-28" aria-labelledby="ww-kop">
      <div class="wrap grid gap-x-14 gap-y-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-10">
            <h2 id="ww-kop" class="rijs text-4xl text-indigo">Snelheid, vakkennis en afspraak is afspraak.</h2>
            <p class="rijs mt-6 max-w-md text-lg text-grijs" style="--d:.08s">Wij zijn pas tevreden als u dat ook bent. Zo gaat het, van het eerste gesprek tot het laatste schroefje.</p>
            <figure class="rijs relative mt-10 hidden lg:block" style="--d:.12s">
              <Picture src={schaarhek} alt="Een messing schaarhek, van dichtbij" widths={[480, 720, 1000]} sizes="36vw" formats={['avif', 'webp']} class="aspect-[3/2] w-full object-cover" />
              <figcaption class="mt-2 text-xs text-grijs">Schaarhek, productfoto van menkrolluiken.nl</figcaption>
            </figure>
          </div>
        </div>
        <ol class="lg:col-span-7">
          {stappen.map(([t, z], i) => (
            <li class={`rijs grid grid-cols-[4.5rem_1fr] gap-x-5 border-t py-8 md:grid-cols-[6.5rem_1fr] md:py-10 ${i === stappen.length - 1 ? 'border-b' : ''} border-lijn-licht`} style={`--d:${i * 0.05}s`}>
              <span class="font-kop text-[3.75rem] leading-none text-alu-3 md:text-[5rem]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-3xl text-indigo">{t}</h3>
                <p class="mt-2 max-w-lg text-grijs">{z}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Merken: als lamellen in een band -->
    <section class="relative isolate overflow-hidden bg-nacht py-16 text-wit md:py-20" aria-labelledby="mk-kop">
      <Picture src={schaduw} alt="" widths={[960, 1600, 2400]} sizes="100vw" formats={['avif', 'webp']} class="absolute inset-0 -z-10 h-full w-full object-cover opacity-35" />
      <div class="wrap">
        <h2 id="mk-kop" class="text-lg font-semibold text-mist" style="font-family: var(--font-sans)">Dealer van onder meer</h2>
        <p class="mt-4 max-w-5xl font-kop text-2xl leading-[1.35] text-wit md:text-[2.4rem] md:leading-[1.3]">
          {merken.map((m, i) => <><span class="whitespace-nowrap">{m}{i < merken.length - 1 && <span class="mx-3 text-lila-2 md:mx-4" aria-hidden="true">/</span>}</span>{" "}</>)}
        </p>
      </div>
    </section>

    <!-- 6. Maten doorgeven (wow) -->
    <section id="maten" class="alu py-20 md:py-28" aria-labelledby="mt-kop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12">
          <h2 id="mt-kop" class="rijs text-4xl text-indigo lg:col-span-7">Geef uw maten door.</h2>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9 lg:pt-4" style="--d:.1s">Een schatting is genoeg: ons meetteam meet daarna alles nauwkeurig in. Uw aanvraag gaat als mail naar ons.</p>
        </div>

        <form class="mt-14 grid gap-x-14 gap-y-12 lg:grid-cols-12" data-maten novalidate>
          <!-- Het raam -->
          <div class="lg:sticky lg:top-8 lg:order-2 lg:col-span-5 lg:self-start">
            <div class="bg-wit p-5 shadow-[0_30px_60px_-34px_#30235d59] md:p-7">
              <div class="flex h-[17rem] items-center justify-center pt-6 md:h-[21rem]" data-vlak>
                <div class="relative transition-[width,height] duration-500 ease-[cubic-bezier(.22,.61,.36,1)]" style="width:62%;height:72%" data-raam>
                  <div class="absolute inset-x-[-6px] -top-7 h-7 bg-[linear-gradient(180deg,#e9eaee,#c3c6d0)]" data-kast></div>
                  <div class="relative h-full overflow-hidden border-[7px] border-alu-2 bg-[linear-gradient(160deg,#7d8aa6,#b8c4d8_45%,#e6ebf2)]">
                    <div class="absolute inset-x-0 top-1/2 h-px bg-alu-2"></div>
                    <div class="absolute inset-y-0 left-1/2 w-px bg-alu-2"></div>
                    <div class="absolute inset-x-0 top-0 overflow-hidden transition-[height] duration-300" style="height:60%" data-luik>
                      <div class="profiel profiel-gesloten" data-mp="gesloten"></div>
                      <div class="profiel profiel-geperforeerd opacity-0" data-mp="geperforeerd"></div>
                      <div class="profiel profiel-transparant opacity-0" data-mp="transparant"></div>
                      <div class="profiel profiel-doek opacity-0" data-mp="doek"></div>
                      <div class="profiel profiel-hor opacity-0" data-mp="hor"></div>
                      <div class="absolute inset-x-0 bottom-0 h-2.5 bg-indigo"></div>
                    </div>
                  </div>
                  <span class="num absolute -bottom-7 left-0 right-0 whitespace-nowrap text-center text-sm font-semibold text-grijs" data-mb>120 x 140 cm</span>
                </div>
              </div>
              <label class="mt-10 block text-sm font-semibold text-grijs" data-trek><span class="flex justify-between"><span data-trek-l>Trek het rolluik omlaag</span><span class="num" data-trek-w>60%</span></span>
                <input type="range" min="0" max="100" value="60" class="trek mt-1" name="trek" aria-label="Hoe ver het rolluik omlaag is" />
              </label>
              <p class="mt-5 border-l-2 border-paars bg-alu px-4 py-3 text-[.9375rem] leading-snug" role="status" aria-live="polite" data-zin>Offerte voor 1 rolluik, ongeveer 120 x 140 cm.</p>
            </div>
          </div>

          <!-- Velden -->
          <div class="grid content-start gap-x-6 gap-y-7 sm:grid-cols-2 lg:col-span-7">
            <label class="veld sm:col-span-2"><span>Wat wilt u laten maken?</span>
              <select name="product" class="invoer">
                <optgroup label="Woning">
                  <option>Rolluik</option><option>Zonwering buiten</option><option>Zonwering binnen</option><option>Markies</option><option>Hor</option><option>Terrasoverkapping</option>
                </optgroup>
                <optgroup label="Bedrijf of winkel">
                  <option>Brandwerend rolluik</option><option>Brandwerend rolscherm</option><option>Geïsoleerde roldeur</option><option>Speeddeur</option><option>Rolhek</option><option>Schaarhek</option><option>Balie rolluik</option><option>Overkapping</option>
                </optgroup>
              </select>
            </label>
            <label class="veld eenheid"><span>Breedte</span><input name="breedte" class="invoer num" inputmode="numeric" value="120" autocomplete="off" /><i>cm</i></label>
            <label class="veld eenheid"><span>Hoogte</span><input name="hoogte" class="invoer num" inputmode="numeric" value="140" autocomplete="off" /><i>cm</i></label>
            <label class="veld eenheid"><span>Aantal</span><input name="aantal" class="invoer num" inputmode="numeric" value="1" autocomplete="off" /><i>st.</i></label>
            <label class="veld"><span>Plaats</span><input name="plaats" class="invoer" placeholder="bv. Zwijndrecht" autocomplete="address-level2" /></label>
            <fieldset class="veld sm:col-span-2" data-alleen-luik><legend class="legend">Uitvoering</legend>
              <div class="schakel">
                <label><input type="radio" name="uitvoering" value="gesloten" checked /><span>Gesloten</span></label>
                <label><input type="radio" name="uitvoering" value="geperforeerd" /><span>Geperforeerd</span></label>
                <label><input type="radio" name="uitvoering" value="transparant" /><span>Transparant</span></label>
              </div>
            </fieldset>
            <fieldset class="veld sm:col-span-2"><legend class="legend">Bediening</legend>
              <div class="schakel">
                <label><input type="radio" name="bediening" value="handmatig" checked /><span>Handmatig</span></label>
                <label><input type="radio" name="bediening" value="elektrisch" /><span>Elektrisch</span></label>
                <label><input type="radio" name="bediening" value="weet ik nog niet" /><span>Weet ik nog niet</span></label>
              </div>
            </fieldset>
            <label class="veld sm:col-span-2"><span>Naam</span><input name="naam" class="invoer" autocomplete="name" /></label>
            <label class="veld sm:col-span-2"><span>Toelichting</span><textarea name="toelichting" rows="3" class="invoer" placeholder="Bijvoorbeeld de ligging van de gevel, of een VvE of verhuurder"></textarea></label>
            <div class="sm:col-span-2">
              <p class="mb-4 hidden border-l-2 border-paars bg-wit px-4 py-3 text-[.9375rem] leading-snug" data-let></p>
              <div class="flex flex-wrap gap-3">
                <a href={`mailto:${site.mail}`} class="knop knop-paars" data-mail><Icoon naam="mail" />Mail de aanvraag</a>
                <a href={site.telHref} class="knop knop-rand num"><Icoon naam="tel" />Bel {site.tel}</a>
              </div>
              <p class="mt-4 max-w-lg text-sm text-grijs">De mail opent in uw eigen mailprogramma. Een foto van de gevel kunt u daar meesturen.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 7. Contact -->
    <section id="contact" class="pantser py-24 text-wit md:py-32" aria-labelledby="co-kop">
      <div class="wrap grid gap-x-12 gap-y-14 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 id="co-kop" class="rijs text-4xl">Middeldijk 56a, Barendrecht.</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-mist" style="--d:.08s">Wij proberen uw bericht altijd binnen 24 uur te beantwoorden, behalve in het weekend en op feestdagen. Tijdens kantooruren krijgt u aan de telefoon direct antwoord.</p>
          <div class="rijs mt-10 flex flex-wrap gap-3" style="--d:.12s">
            <a href={site.telHref} class="knop knop-vol num"><Icoon naam="tel" />{site.tel}</a>
            <a href={`mailto:${site.mail}`} class="knop knop-wit"><Icoon naam="mail" />{site.mail}</a>
          </div>
          <p class="rijs mt-8 text-mist" style="--d:.16s">{site.straat}, {site.postcode} {site.plaats}<span class="mx-2 inline-block" aria-hidden="true">·</span><a href={site.maps} class="link text-wit">Route plannen</a></p>
        </div>
        <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.1s">
          <p class="font-semibold">Werkgebied</p>
          <p class="mt-3 font-kop text-2xl leading-snug text-lila">Barendrecht, Dordrecht, Zwijndrecht, Hendrik-Ido-Ambacht, Papendrecht, Sliedrecht en Alblasserdam.</p>
          <p class="mt-3 text-mist">En wij leveren door heel Nederland.</p>
          <p class="mt-8 border-t border-lijn-2 pt-5 text-sm text-mist">Voorheen aan de Kijfhoek in Zwijndrecht. Ons nummer bleef hetzelfde.</p>
        </div>
      </div>
    </section>
  </main>
  </div>
  <Voet />
</Base>

<script>
  import { site } from '../data/site';

  // Uitvoering-kiezer (sectie 3), zet ook de maatopgave.
  const uTekst = document.querySelector<HTMLElement>('[data-u-tekst]');
  const kies = (id: string, ookForm = true) => {
    document.querySelectorAll<HTMLButtonElement>('[data-uitvoering] [data-u]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.u === id)));
    document.querySelectorAll<HTMLElement>('[data-p]').forEach((p) => p.classList.toggle('opacity-0', p.dataset.p !== id));
    const b = document.querySelector<HTMLButtonElement>(`[data-u="${id}"]`);
    if (uTekst && b) uTekst.textContent = b.dataset.tekst || uTekst.textContent;
    if (ookForm) { const r = document.querySelector<HTMLInputElement>(`input[name="uitvoering"][value="${id}"]`); if (r) { r.checked = true; r.dispatchEvent(new Event('change', { bubbles: true })); } }
  };
  document.querySelectorAll<HTMLButtonElement>('[data-uitvoering] [data-u]').forEach((b) => b.addEventListener('click', () => kies(b.dataset.u!)));

  // Maten doorgeven.
  const f = document.querySelector<HTMLFormElement>('[data-maten]');
  if (f) {
    const raam = f.querySelector<HTMLElement>('[data-raam]')!;
    const luik = f.querySelector<HTMLElement>('[data-luik]')!;
    const kast = f.querySelector<HTMLElement>('[data-kast]')!;
    const zin = f.querySelector<HTMLElement>('[data-zin]')!;
    const lt = f.querySelector<HTMLElement>('[data-let]')!;
    const mail = f.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const mb = f.querySelector<HTMLElement>('[data-mb]')!;
    const trek = f.querySelector<HTMLElement>('[data-trek]')!, trekL = f.querySelector<HTMLElement>('[data-trek-l]')!;
    const trekW = f.querySelector<HTMLElement>('[data-trek-w]')!;
    const alleenLuik = f.querySelector<HTMLElement>('[data-alleen-luik]')!;
    const v = (n: string) => ((f.elements.namedItem(n) as HTMLInputElement | null)?.value || '').trim();
    const getal = (n: string) => { const x = parseInt(v(n).replace(/\D/g, ''), 10); return isFinite(x) && x > 0 ? x : 0; };
    const radio = (n: string) => f.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value || '';
    const meervoud: Record<string, string> = {
      'Rolluik': 'rolluiken', 'Zonwering buiten': 'buitenzonweringen', 'Zonwering binnen': 'binnenzonweringen', 'Markies': 'markiezen', 'Hor': 'horren',
      'Terrasoverkapping': 'terrasoverkappingen', 'Brandwerend rolluik': 'brandwerende rolluiken', 'Brandwerend rolscherm': 'brandwerende rolschermen',
      'Geïsoleerde roldeur': 'geïsoleerde roldeuren', 'Speeddeur': 'speeddeuren', 'Rolhek': 'rolhekken', 'Schaarhek': 'schaarhekken', 'Balie rolluik': 'balie rolluiken', 'Overkapping': 'overkappingen',
    };

    const update = () => {
      const p = v('product'), B = getal('breedte'), H = getal('hoogte'), n = getal('aantal') || 1, plaats = v('plaats');
      const isLuik = /rolluik|rolhek|roldeur|speeddeur|rolscherm/i.test(p);
      alleenLuik.classList.toggle('hidden', !/^Rolluik$|Balie rolluik/.test(p));
      const u = radio('uitvoering'), bed = radio('bediening');

      // Raam tekenen in verhouding.
      const bb = Math.min(Math.max(B || 120, 30), 1200), hh = Math.min(Math.max(H || 140, 30), 600);
      const vl = f.querySelector<HTMLElement>('[data-vlak]')!; const VW = vl.clientWidth * 0.86, VH = vl.clientHeight * 0.74;
      let w = VW, h = VW * hh / bb; if (h > VH) { h = VH; w = VH * bb / hh; }
      raam.style.width = `${Math.max(48, w)}px`; raam.style.height = `${Math.max(40, h)}px`;
      mb.textContent = B && H ? `${B} x ${H} cm` : 'breedte x hoogte';
      const t = parseInt(v('trek') || '60', 10); trekW.textContent = `${t}%`; luik.style.height = `${t}%`;
      const doek = /Zonwering|Markies/.test(p), hor = p === 'Hor', kap = /overkapping/i.test(p);
      kast.style.visibility = kap || hor ? 'hidden' : 'visible';
      luik.style.display = kap ? 'none' : ''; trek.classList.toggle('hidden', kap);
      trekL.textContent = doek ? 'Laat het doek zakken' : hor ? 'Trek de hor omlaag' : /hek/i.test(p) ? 'Trek het hek omlaag' : /deur|scherm/i.test(p) ? 'Laat de deur zakken' : 'Trek het rolluik omlaag';
      const toonU = /^Rolluik$|Balie rolluik/.test(p) ? u : doek ? 'doek' : hor ? 'hor' : /Rolhek/.test(p) ? 'transparant' : 'gesloten';
      f.querySelectorAll<HTMLElement>('[data-mp]').forEach((el) => el.classList.toggle('opacity-0', el.dataset.mp !== toonU));

      const naam = n === 1 ? p.toLowerCase() : (meervoud[p] || p.toLowerCase());
      const extra = [/^Rolluik$|Balie rolluik/.test(p) ? u : '', bed === 'weet ik nog niet' ? '' : bed].filter(Boolean).join(', ');
      const maat = B && H ? `, ongeveer ${B} x ${H} cm` : '';
      const tekst = `Offerte voor ${n} ${naam}${extra ? ` (${extra})` : ''}${maat}${plaats ? `, in ${plaats}` : ''}.`;
      zin.textContent = tekst;

      // Terrasoverkapping breder dan ruim 6,5 meter: noem het, zoals hun eigen site.
      const breed = /overkapping/i.test(p) && B > 650;
      lt.classList.toggle('hidden', !breed);
      lt.textContent = breed ? 'Onze terrasoverkappingen kunnen over het algemeen ruim 6,5 meter breed zijn. Is het breder, bel ons dan even om te overleggen.' : '';

      const regels = ['Beste Menk Rolluiken & Zonwering,', '', 'Graag ontvang ik een vrijblijvende offerte voor:', '', `Product: ${p}`, `Aantal: ${n}`, `Maat: ${B && H ? `ongeveer ${B} x ${H} cm (breedte x hoogte)` : 'nog niet bekend'}`,
        ...(/^Rolluik$|Balie rolluik/.test(p) ? [`Uitvoering: ${u}`] : []), `Bediening: ${bed}`, `Plaats: ${plaats || '-'}`,
        ...(v('toelichting') ? ['', v('toelichting')] : []), '', 'Met vriendelijke groet,', v('naam') || ''];
      const onderwerp = `Offerte ${naam}${plaats ? `, ${plaats}` : ''}`;
      mail.href = `mailto:${site.mail}?subject=${encodeURIComponent(onderwerp)}&body=${encodeURIComponent(regels.join('\n'))}`;
      if (f.contains(document.activeElement) && (document.activeElement as HTMLInputElement).name === 'uitvoering') kies(u, false);
    };
    f.addEventListener('input', update);
    f.addEventListener('change', update);
    f.addEventListener('submit', (e) => e.preventDefault());
    update();
    addEventListener('resize', update);
  }
</script>
