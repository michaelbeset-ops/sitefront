---
import { site, url, particulier, zakelijk } from '../data/site';
import Logo from './Logo.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <span class="text-wit"><Logo class="h-8 w-auto" /></span>
      <p class="mt-6 max-w-xs">Rolluiken, brandroldeuren en zonwering voor woning, winkel en bedrijfspand. Ingemeten en gemonteerd door onze eigen technische dienst.</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Particulier</p>
      <ul class="mt-4 space-y-1.5">{particulier.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Zakelijk</p>
      <ul class="mt-4 space-y-1.5">{zakelijk.slice(1, 8).map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-1.5"><a href={site.maps} class="link">Route</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-lila">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en productfoto’s van menkrolluiken.nl (stand 7 oktober 2026). De overige foto’s zijn sfeerbeelden van Unsplash en tonen geen werk van Menk.</p>}
</footer>
