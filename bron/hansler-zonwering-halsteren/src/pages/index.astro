</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-samen]');
  const svg = document.querySelector<SVGSVGElement>('[data-voorbeeld]');
  if (f && svg) {
    const ns = 'http://www.w3.org/2000/svg';
    const r = (n: string) => svg.querySelector<SVGElement>(`[data-r="${n}"]`)!;
    const dicht = document.querySelector<HTMLInputElement>('[data-dicht]')!;
    const label = document.querySelector<HTMLElement>('[data-maat-label]')!;
    const samenv = document.querySelector<HTMLElement>('[data-samenvatting]')!;
    const mail = document.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const getal = (n: string, min: number, max: number, std: number) => { const v = Number((f.elements.namedItem(n) as HTMLInputElement).value); return Number.isFinite(v) && v > 0 ? Math.min(max, Math.max(min, v)) : std; };
    const gekozen = (n: string) => f.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`);
    const zet = (el: Element, a: Record<string, string | number>) => { for (const k in a) el.setAttribute(k, String(a[k])); };
    const kort = (s: string) => s.replace(/^RAL \d+ \((.*)\)$/, '$1');

    const teken = () => {
      const b = getal('breedte', 400, 4000, 1200), h = getal('hoogte', 400, 3500, 1400);
      // Raam binnen het vlak van 400x300 houden, verhouding volgen.
      const schaal = Math.min(250 / b, 190 / h);
      const w = Math.max(70, b * schaal), hh = Math.max(70, h * schaal);
      const x = (400 - w) / 2, kastH = 24, y = 36 + kastH;
      const kast = gekozen('kastkleur')?.dataset.hex || '#383e42';
      const lamel = gekozen('lamelkleur')?.dataset.hex || '#383e42';
      const rond = gekozen('kast')?.value === 'Halfronde kast';
      zet(r('kozijn'), { x: x - 6, y: y, width: w + 12, height: hh - kastH + 8 });
      zet(r('glas'), { x, y: y + 6, width: w, height: hh - kastH - 4 });
      zet(r('clip'), { x, y: y, width: w, height: hh - kastH + 2 });
      zet(r('tussen'), { x: x + w / 2 - 2, y: y + 6, width: 4, height: hh - kastH - 4 });
      zet(r('glans'), { d: `M${x} ${y + hh - kastH} L${x + w * 0.5} ${y} H${x + w * 0.68} L${x + w * 0.18} ${y + hh - kastH}Z` });
      zet(r('vb-l'), { x: x - 8, y: y - 2, width: 8, height: hh - kastH + 10, fill: kast });
      zet(r('vb-r'), { x: x + w, y: y - 2, width: 8, height: hh - kastH + 10, fill: kast });
      zet(r('vb-dorpel'), { x: x - 14, y: y + hh - kastH + 8, width: w + 28, height: 7 });
      const kx = x - 12, kw = w + 24, ky = y - kastH;
      zet(r('kast'), { fill: kast, d: rond ? `M${kx} ${ky + kastH} V${ky + 10} Q${kx} ${ky} ${kx + 12} ${ky} H${kx + kw - 12} Q${kx + kw} ${ky} ${kx + kw} ${ky + 10} V${ky + kastH}Z` : `M${kx} ${ky} H${kx + kw} V${ky + kastH} H${kx}Z` });
      // Pantser: lamellen tot de gekozen hoogte.
      const p = r('pantser'); p.replaceChildren();
      const tot = (hh - kastH + 2) * (Number(dicht.value) / 100);
      for (let ly = y; ly < y + tot; ly += 7) {
        const l = document.createElementNS(ns, 'rect'); zet(l, { x, y: ly, width: w, height: Math.min(7, y + tot - ly), fill: lamel });
        const s = document.createElementNS(ns, 'rect'); zet(s, { x, y: ly + 5.5, width: w, height: 1.2, fill: '#000', opacity: 0.22 });
        p.append(l, s);
      }
      if (tot > 4) { const e = document.createElementNS(ns, 'rect'); zet(e, { x, y: y + tot - 4, width: w, height: 4, fill: kast }); p.append(e); }
      // Bediening aan de gekozen zijde.
      const g = r('bed'); g.replaceChildren();
      const rechts = gekozen('zijde')?.value === 'Bediening rechts';
      const bx = rechts ? x + w + 20 : x - 34;
      const bed = (f.elements.namedItem('bediening') as HTMLSelectElement).value;
      const motor = (f.elements.namedItem('motor') as HTMLSelectElement).value;
      if (bed === 'Bandbediening') { const k = document.createElementNS(ns, 'rect'); zet(k, { x: bx, y: y + hh * 0.45, width: 14, height: 22, rx: 2, fill: '#f4f2ee', stroke: '#00000040' }); g.append(k); }
      else if (bed === 'Schakelaar') { const k = document.createElementNS(ns, 'rect'); zet(k, { x: bx, y: y + hh * 0.45, width: 14, height: 14, rx: 2, fill: '#f4f2ee', stroke: '#00000040' }); const t = document.createElementNS(ns, 'rect'); zet(t, { x: bx + 4, y: y + hh * 0.45 + 3, width: 6, height: 8, rx: 1, fill: '#9aa3ab' }); g.append(k, t); }
      else { const k = document.createElementNS(ns, 'rect'); zet(k, { x: bx + 1, y: y + hh * 0.42, width: 12, height: 24, rx: 4, fill: '#20272e' }); const t = document.createElementNS(ns, 'circle'); zet(t, { cx: bx + 7, cy: y + hh * 0.42 + 8, r: 2.6, fill: '#f4c430' }); g.append(k, t); }
      if (motor === 'Somfy Solar') { const zp = document.createElementNS(ns, 'rect'); zet(zp, { x: rechts ? kx + kw - 34 : kx + 6, y: ky - 7, width: 28, height: 7, fill: '#1d2b3a', stroke: '#6f8aa5', 'stroke-width': 0.8 }); g.append(zp); }
      label.textContent = `${b} x ${h} mm`;
      document.querySelector('[data-kastkleur-naam]')!.textContent = gekozen('kastkleur')?.value || '';
      document.querySelector('[data-lamelkleur-naam]')!.textContent = gekozen('lamelkleur')?.value || '';
      samenv.textContent = `${kort(gekozen('lamelkleur')?.value || '')}, ${motor === 'Geen motor' ? 'zonder motor' : motor}`;
      mail.href = `mailto:info@hansler.nl?subject=${encodeURIComponent('Prijsopgave rolluik')}&body=${encodeURIComponent(bericht())}`;
    };

    const bericht = () => {
      const d = new FormData(f); const v = (n: string) => String(d.get(n) || '').trim();
      const regels = [
        'Goedendag Hansler Zonwering, ik wil graag een vrijblijvende prijsopgave voor elektrische rolluiken op maat.',
        `Aantal: ${v('aantal') || '1'}`,
        `Breedte incl. geleiders: ${v('breedte')} mm`,
        `Hoogte incl. kast: ${v('hoogte')} mm`,
        `Kast: ${v('kast')}`,
        `Kleur kast en geleiders: ${v('kastkleur')}`,
        `Kleur lamellen: ${v('lamelkleur')}`,
        `Bediening: ${v('bediening')}, ${v('motor')}`,
        `${v('zijde')} (vanaf buiten gezien)`,
        v('montage'),
      ];
      if (v('naam')) regels.push(`Groet, ${v('naam')}`);
      return regels.join('\n');
    };

    f.addEventListener('input', teken);
    f.addEventListener('change', teken);
    dicht.addEventListener('input', teken);
    f.addEventListener('submit', (e) => { e.preventDefault(); window.open('https://wa.me/31622745708?text=' + encodeURIComponent(bericht()), '_blank', 'noopener'); });
    teken();
  }
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: 1; letter-spacing: -0.035em; }
  .cijfer { font-family: var(--font-kop); font-weight: 700; font-size: clamp(2.5rem, 3vw + 1.4rem, 3.5rem); line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: var(--radius-sm); background: var(--color-zand); }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 .85rem; border-radius: var(--radius-sm); border: 1.5px solid #121a2233; background: #fff; font-size: .9375rem; font-weight: 550; cursor: pointer; transition: background-color .2s, border-color .2s; }
  .keuze span:hover { border-color: var(--color-inkt); }
  .keuze input:checked + span { background: var(--color-zon); border-color: var(--color-zon-diep); }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-logoblauw); outline-offset: 2px; }
  .stip { position: relative; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: var(--radius-sm); cursor: pointer; }
  .stip span { width: 2.1rem; height: 2.1rem; border-radius: .3rem; box-shadow: inset 0 0 0 1px #00000026; transition: transform .2s; }
  .stip:hover span { transform: scale(1.06); }
  .stip input:checked ~ span { box-shadow: inset 0 0 0 1px #00000026, 0 0 0 2px #fff, 0 0 0 4px var(--color-inkt); }
  .stip input:focus-visible ~ span { outline: 3px solid var(--color-logoblauw); outline-offset: 4px; }
  .veld { display: block; width: 100%; min-height: 2.9rem; border-radius: var(--radius-sm); border: 1.5px solid #121a2233; background: #fff; padding: .65rem .85rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #121a2266; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-inkt); }
  .schuif { accent-color: var(--color-zon-diep); height: 2rem; }
</style>
