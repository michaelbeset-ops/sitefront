---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, fragmenten, waVraag, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import rolluiken from '../assets/rolluiken.jpg';
import screens from '../assets/screens.jpg';
import zonneschermen from '../assets/zonneschermen.jpg';
import garagedeuren from '../assets/garagedeuren.jpg';
import bord from '../assets/bord.jpg';
import service from '../assets/service.jpg';
import team from '../assets/team.jpg';
import p1 from '../assets/p1.jpg';
import p2 from '../assets/p2.jpg';
import p3 from '../assets/p3.jpg';
import p6 from '../assets/p6.jpg';
import p7 from '../assets/p7.jpg';

const vraag = (p: string) => waMet(`Goedendag Hansler Zonwering, ik heb een vraag over ${p.toLowerCase()}.`);

const producten = [
  { t: 'Rolluiken', d: 'Aluminium rolluiken van Alukon, met band, schakelaar of Somfy-motor.', src: rolluiken, alt: 'Antraciet rolluik voor een raam van een rijtjeswoning met klimop eronder', pos: '50% 45%' },
  { t: 'Screens', d: 'Screens met doeken in meer dan 550 kleuren.', src: screens, alt: 'Twee grijze screens die een overkapping in de tuin afsluiten', pos: '50% 50%' },
  { t: 'Zonneschermen en markiezen', d: 'Doeken voor allerlei systemen en markiezen.', src: zonneschermen, alt: 'Uitgerold zonnescherm met grijs-wit gestreept doek boven een voordeur', pos: '50% 40%' },
  { t: 'Garagedeuren', d: 'Op maat gemaakt in onze werkplaats en door ons gemonteerd.', src: garagedeuren, alt: 'Witte rolgaragedeur in een gemetselde boog, met de oude houten deuren opengeklapt', pos: '50% 50%' },
  { t: 'Reparatie en service', d: 'Service en reparatie van uw zonwering en rolluiken.', src: bord, alt: 'Het bord van Hansler Zonwering met de tekst Service en reparatie van uw zonwering en rolluiken, met de bedrijfsbus erachter', pos: '40% 40%' },
  { t: 'Onderdelen en zelfmontage', d: 'Bandmotoren, lamellen, geleiders, doeken en meer.', src: service, alt: 'Achterklep van de bedrijfsbus open bij de loods, vol gereedschap en onderdelen', pos: '50% 55%' },
];

const projecten = [
  { src: p1, alt: 'Twee brede antraciet rolluiken aan de voorgevel van een woning met witte boeiboorden', groot: true },
  { src: p3, alt: 'Zwarte screen voor een dakkapel op een pannendak' },
  { src: p7, alt: 'Twee crèmewitte rolluiken aan een rode bakstenen gevel' },
  { src: p6, alt: 'Antraciet screen voor een groot raam naast de regenpijp' },
  { src: p2, alt: 'Drie witte rolluiken naast elkaar aan een bungalow' },
];

const stappen = [
  ['Advies', 'Bel, app of kom langs. Wij adviseren u eerlijk, afgestemd op uw situatie en wensen.'],
  ['Inmeten', 'Wij komen altijd bij u inmeten, ook als u online een prijsopgave maakte.'],
  ['Op maat gemaakt', 'Uw rolluik wordt op maat gemaakt in onze eigen werkplaats.'],
  ['Montage', 'Wij hangen het voor u op, met 1 jaar volledige garantie. U betaalt pas bij oplevering.'],
];

const kleuren = [
  ['RAL 9010', 'zuiverwit', '#f1ece1'],
  ['RAL 9001', 'crèmewit', '#e9e0d2'],
  ['RAL 7016', 'antraciet', '#383e42'],
  ['RAL 7021', 'zwartgrijs', '#2e3234'],
  ['RAL 9005', 'zwart', '#0e0e10'],
];
---
<Base title={`${site.voluit} | Halsteren`} description="Rolluiken, screens, zonneschermen en garagedeuren op maat uit Halsteren. Al meer dan 40 jaar eerlijk advies, eigen werkplaats en montage met 1 jaar garantie. Nieuw adres: Vang 13F.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen werk op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" quality={68} widths={[640, 800, 1280, 1600, 2000, 2400]} sizes="(min-width: 768px) 100vw, 160vw" loading="eager" fetchpriority="high" class="absolute inset-x-0 top-0 -z-20 h-[23rem] w-full object-cover object-[50%_42%] md:inset-0 md:h-full md:object-[50%_40%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#121a2200_0rem,#121a2240_11rem,#121a22_22.5rem)] md:bg-[linear-gradient(90deg,#121a22f0_0%,#121a22c4_40%,#121a2230_78%),linear-gradient(0deg,#121a22b3_0%,#121a2200_40%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-10 pb-16 pt-[17rem] md:pb-20 md:pt-40 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow eyebrow-licht">Familiebedrijf in Halsteren</p>
          <h1 id="t-hero" class="mt-5 text-hero">Rolluiken en zonwering, <span class="text-zon">op maat</span> uit Halsteren.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Al meer dan 40 jaar actief in Halsteren en omgeving. Eerlijk advies, deskundige montage en een serviceteam dat voor u klaarstaat.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#samenstellen" class="knop knop-zon">Prijsopgave samenstellen<Icoon naam="pijl" /></a>
            <a href={waVraag} class="knop knop-rand op-foto"><Icoon naam="wa" />WhatsApp ons</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><Icoon naam="g" class="h-4 w-4" /><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 9.00 tot 17.00 uur</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto max-w-[20rem] rounded-md bg-nacht/70 p-6 ring-1 ring-licht/15 backdrop-blur-md">
            <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[.16em] text-zon"><Icoon naam="pin" class="h-4 w-4" />Wij zijn verhuisd</p>
            <p class="mt-3 font-kop text-2xl leading-tight">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <a href={site.telHref} class="num mt-5 flex items-center gap-2 border-t border-licht/15 pt-4 text-lg font-semibold text-licht no-underline hover:text-zon"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Assortiment in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-3 overflow-x-auto py-4 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#producten" class="shrink-0 rounded-sm border border-lijn px-3.5 py-1.5 text-sm font-medium no-underline transition-colors hover:border-zon hover:bg-zon">{c}</a>)}
      </div>
    </section>

    <!-- 3. Producten -->
    <section id="producten" class="py-20 lg:py-24" aria-labelledby="t-prod">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Ons assortiment</p>
            <h2 id="t-prod" class="mt-4 text-3xl">Alles voor uw gevel, van advies tot ophangen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Hansler levert enkel topmerken. Montage verzorgen we ook, en in Halsteren, Steenbergen en Bergen op Zoom bezorgen we gratis.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {producten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[16/10]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 border-t-4 border-zon p-4 sm:p-6">
                  <div>
                    <h3 class="hyphens-auto text-[1.0625rem] sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-sm bg-zand transition-colors group-hover:bg-zon sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Rolluik samenstellen (wow-functie) -->
    <section id="samenstellen" class="bg-zand py-20 lg:py-24" aria-labelledby="t-samen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Vrijblijvende prijsopgave</p>
            <h2 id="t-samen" class="mt-4 text-3xl">Stel uw elektrische rolluik samen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Kies maat, kleur en bediening en zie het meteen voor u. Wij nemen daarna contact met u op om uw wensen te bespreken.</p>
        </div>

        <form class="mt-12 grid gap-6 lg:mt-14 lg:grid-cols-12" data-samen aria-describedby="samen-uitleg">
          <!-- Voorbeeld -->
          <div class="kaart overflow-hidden lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
            <div class="relative bg-[#b8644a]">
              <svg viewBox="0 0 400 300" class="block w-full" role="img" aria-label="Voorbeeld van uw rolluik" data-voorbeeld>
                <defs>
                  <pattern id="steen" width="40" height="16" patternUnits="userSpaceOnUse">
                    <rect width="40" height="16" fill="#a9573f" />
                    <path d="M0 15.5h40M20 0v8M0 8h40M0 8v8M40 8v8" stroke="#c9a48f" stroke-width="1.4" />
                  </pattern>
                  <clipPath id="raam-clip"><rect data-r="clip" x="120" y="80" width="160" height="150" /></clipPath>
                </defs>
                <rect width="400" height="300" fill="url(#steen)" />
                <rect data-r="kozijn" x="112" y="72" width="176" height="166" fill="#f4f2ee" />
                <g clip-path="url(#raam-clip)">
                  <rect data-r="glas" x="120" y="80" width="160" height="150" fill="#9fb8c9" />
                  <path data-r="glans" d="M120 230 L200 80 H230 L150 230Z" fill="#ffffff" opacity=".18" />
                  <rect data-r="tussen" x="198" y="80" width="4" height="150" fill="#f4f2ee" />
                  <g data-r="pantser"></g>
                </g>
                <rect data-r="vb-l" x="112" y="62" width="9" height="176" fill="#383e42" />
                <rect data-r="vb-r" x="279" y="62" width="9" height="176" fill="#383e42" />
                <path data-r="kast" d="M106 40 H294 V66 H106Z" fill="#383e42" />
                <rect data-r="vb-dorpel" x="104" y="238" width="192" height="8" fill="#d9d4ca" />
                <g data-r="bed"></g>
              </svg>
              <div class="absolute bottom-3 left-3 rounded-sm bg-nacht/80 px-3 py-1.5 text-xs font-semibold text-licht backdrop-blur" data-maat-label>1200 x 1400 mm</div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-6">
              <label class="flex min-w-[15rem] flex-1 items-center gap-3 text-sm font-semibold">
                <span class="shrink-0">Rolluik omlaag</span>
                <input type="range" min="0" max="100" value="62" class="schuif w-full" data-dicht aria-label="Hoe ver het rolluik omlaag is" />
              </label>
              <p class="text-sm text-grijs" data-samenvatting>Antraciet, Somfy RS100</p>
            </div>
          </div>

          <!-- Keuzes -->
          <div class="kaart p-6 sm:p-8 lg:col-span-7">
            <div class="grid grid-cols-2 gap-4 sm:gap-5">
              <label class="block"><span class="text-sm font-semibold">Breedte <span class="font-normal text-grijs">incl. geleiders, mm</span></span><input name="breedte" type="number" inputmode="numeric" min="400" max="4000" step="10" value="1200" class="veld mt-2" /></label>
              <label class="block"><span class="text-sm font-semibold">Hoogte <span class="font-normal text-grijs">incl. kast, mm</span></span><input name="hoogte" type="number" inputmode="numeric" min="400" max="3500" step="10" value="1400" class="veld mt-2" /></label>
            </div>
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <fieldset>
                <legend class="text-sm font-semibold">Kleur kast en geleiders</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  {kleuren.map(([ral, naam, hex], i) => (
                    <label class="stip" title={`${ral} (${naam})`}><input type="radio" name="kastkleur" value={`${ral} (${naam})`} data-hex={hex} class="sr-only" checked={i === 2} /><span style={`background:${hex}`}></span><b class="sr-only">{ral} {naam}</b></label>
                  ))}
                </div>
                <p class="mt-2 text-xs text-grijs" data-kastkleur-naam>RAL 7016 (antraciet)</p>
              </fieldset>
              <fieldset>
                <legend class="text-sm font-semibold">Kleur lamellen</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  {kleuren.map(([ral, naam, hex], i) => (
                    <label class="stip" title={`${ral} (${naam})`}><input type="radio" name="lamelkleur" value={`${ral} (${naam})`} data-hex={hex} class="sr-only" checked={i === 2} /><span style={`background:${hex}`}></span><b class="sr-only">{ral} {naam}</b></label>
                  ))}
                </div>
                <p class="mt-2 text-xs text-grijs" data-lamelkleur-naam>RAL 7016 (antraciet)</p>
              </fieldset>
            </div>
            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              <label class="block"><span class="text-sm font-semibold">Bediening</span>
                <select name="bediening" class="veld mt-2">
                  <option>Bandbediening</option>
                  <option selected>Schakelaar</option>
                  <option>Afstandsbediening (1 kanaals)</option>
                  <option>Afstandsbediening (5 kanaals)</option>
                </select>
              </label>
              <label class="block"><span class="text-sm font-semibold">Motor</span>
                <select name="motor" class="veld mt-2">
                  <option>Geen motor</option>
                  <option>Somfy Basis</option>
                  <option selected>Somfy RS100</option>
                  <option>Somfy Solar</option>
                </select>
              </label>
            </div>
            <div class="mt-6 grid gap-6 sm:grid-cols-[1.3fr_1fr_1fr]">
              <fieldset>
              <legend class="text-sm font-semibold">Type kast</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                <label class="keuze"><input type="radio" name="kast" value="Vierkante kast" class="sr-only" checked /><span>Vierkant</span></label>
                <label class="keuze"><input type="radio" name="kast" value="Halfronde kast" class="sr-only" /><span>Halfrond</span></label>
              </div>
            </fieldset>
              <fieldset>
                <legend class="text-sm font-semibold">Bedieningszijde</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  <label class="keuze"><input type="radio" name="zijde" value="Bediening links" class="sr-only" /><span>Links</span></label>
                  <label class="keuze"><input type="radio" name="zijde" value="Bediening rechts" class="sr-only" checked /><span>Rechts</span></label>
                </div>
              </fieldset>
              <fieldset>
                <legend class="text-sm font-semibold">Montage</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  <label class="keuze"><input type="radio" name="montage" value="Ik wil de rolluiken door Hansler laten monteren" class="sr-only" checked /><span>Door ons</span></label>
                  <label class="keuze"><input type="radio" name="montage" value="Ik monteer de rolluiken zelf" class="sr-only" /><span>Zelf</span></label>
                </div>
              </fieldset>
            </div>
            <div class="mt-6 grid grid-cols-[5.5rem_1fr] gap-4 sm:grid-cols-[7rem_1fr] sm:gap-5">
              <label class="block"><span class="text-sm font-semibold">Aantal</span><input name="aantal" type="number" inputmode="numeric" min="1" max="30" value="1" class="veld mt-2" /></label>
              <label class="block"><span class="text-sm font-semibold">Naam en woonplaats</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            </div>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <button type="submit" class="knop knop-zon"><Icoon naam="wa" />Verstuur via WhatsApp</button>
              <a href={`mailto:${site.mail}`} class="knop knop-rand" data-mail>Liever per e-mail</a>
            </div>
            <p id="samen-uitleg" class="mt-5 text-sm text-grijs">Een prijsopgave is vrijblijvend. Wij komen altijd inmeten nadat u de gegevens ingevuld hebt. Betaling geschiedt pas bij oplevering. Er wordt niets verstuurd tot u in WhatsApp of uw mail zelf op verzenden drukt.</p>
          </div>
        </form>
        <div id="werkwijze" class="mt-14 flex flex-wrap items-end justify-between gap-3 lg:mt-16">
          <h3 class="text-2xl">Van advies tot montage, één vast aanspreekpunt.</h3>
          <p class="text-sm text-grijs">Liever zelf monteren? Onderdelen hebben we ook.</p>
        </div>
        <ol class="mt-6 grid gap-px overflow-hidden rounded-md bg-lijn sm:grid-cols-2 lg:grid-cols-4" aria-label="Werkwijze">
          {stappen.map(([t, d], i) => (
            <li class="rijs bg-papier p-6 lg:p-7" style={`--d:${i * 0.06}s`}>
              <p class="flex items-baseline gap-3"><span class="num font-kop text-2xl leading-none text-zon-diep">0{i + 1}</span><b class="font-kop text-lg font-bold">{t}</b></p>
              <p class="mt-3 text-[.9375rem] text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. Projecten -->
    <section id="projecten" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-4 text-3xl">Gemaakt en gemonteerd door ons eigen team.</h2>
          </div>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.05s">
            <p class="text-lg text-licht-zacht">Rolluiken, screens en zonwering bij klanten in Zuid-West Nederland.</p>
            <a href={site.instagram} class="knop knop-rand knop-klein mt-6"><Icoon naam="insta" />Meer op Instagram</a>
          </div>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14">
          {projecten.map((w, i) => (
            <li class={`rijs relative overflow-hidden rounded-sm bg-nacht-2 ${w.groot ? 'col-span-2 row-span-2 aspect-square md:aspect-auto' : 'aspect-square'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={w.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={w.groot ? '(min-width: 1248px) 600px, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8. Over ons -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:col-span-5">
          <Image src={team} alt="Een van de mannen van Hansler Zonwering naast de zwarte bedrijfsbus met het Hansler-logo" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[62%_50%]" />
          <p class="absolute bottom-4 left-4 rounded-sm bg-zon px-4 py-1.5 text-sm font-semibold text-inkt">Advies, montage en service</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Hansler</p>
          <h2 id="t-over" class="mt-4 text-3xl">Eerlijk advies en een goed product, tegen een eerlijke prijs.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Het bedrijf is opgericht door Nico Hansler. Na verloop van tijd kwam zijn zoon Robin erbij, die nu de drijvende kracht is. Sinds 2022 versterkt Teun het team. Advies, montage en service doen we zelf, zo heeft u bij Hansler één vast aanspreekpunt.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-sm bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-zon text-inkt"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Eerlijk advies</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Afgestemd op uw situatie en wensen. Klanten noemen ons in reviews deskundig.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-sm bg-nacht-2 px-5 py-4">
