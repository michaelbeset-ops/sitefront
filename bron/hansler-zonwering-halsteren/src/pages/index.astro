    <!-- 10. Contact, openingstijden en route -->
    <section id="contact" class="py-20 lg:py-24" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Contact en route</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Kom met ons in contact.</h2>
          <p class="mt-6 text-lg text-grijs">Heeft u vragen over rolluiken, screens, zonneschermen of garagedeuren? Wij staan voor u klaar. Zijn we telefonisch niet goed bereikbaar, stuur dan een WhatsApp-bericht of mail.</p>
          <ul class="mt-10 grid gap-3">
            <li><a href={waVraag} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-zon text-inkt"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-zand"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Ma t/m vr, 9.00 tot 17.00 uur</span></span><Icoon naam="pijl" class="h-5 w-5" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-zand"><Icoon naam="mail" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">E-mail</b><span class="text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5" /></a></li>
          </ul>
