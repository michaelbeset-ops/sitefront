---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Icoon from '../components/Icoon.astro';
import { site, prijzen, tijden } from '../data/site';
import hero from '../assets/hero.jpg';
import takel from '../assets/takel.jpg';
import onderkant from '../assets/onderkant.jpg';
---
<Base
  title="Autobedrijf Rob Poot Junior | APK, onderhoud en reparatie in Vlaardingen"
  description="APK, onderhoud en reparatie van alle merken in Vlaardingen, met een liefde voor Toyota's en andere Aziatische merken. Pech? Eigen ophaaldienst, dag en nacht."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: op mobiel foto met egale donkere laag; op desktop tekst links op antraciet, foto rechts. -->
    <section class="op-donker relative isolate overflow-hidden bg-ink text-white">
      <div class="absolute inset-0 -z-10 lg:left-[42%]">
        <Foto src={hero} alt="Blauwe Honda met open motorkap en een verwijderd voorwiel op bokken in een werkplaats" hero sizes="(min-width: 1024px) 60vw, 100vw" />
        <div class="absolute inset-0 bg-ink/75 lg:bg-transparent lg:bg-[linear-gradient(90deg,var(--color-ink)_0%,color-mix(in_srgb,var(--color-ink)_55%,transparent)_30%,transparent_65%)]"></div>
      </div>
      <div class="wrap grid py-14 sm:py-20 lg:grid-cols-12 lg:py-28">
        <div class="lg:col-span-6">
          <p class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-geel">Vlaardingen · familiebedrijf sinds 1985</p>
          <h1 class="mt-4 text-4xl">APK, onderhoud en reparatie van alle merken</h1>
          <p class="mt-5 max-w-xl text-lg text-white/90">Met een liefde voor Toyota's en andere Aziatische merken. U kunt altijd bellen als u problemen met uw auto heeft.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.whatsapp} class="btn btn-geel"><Icoon naam="whatsapp" size={22} />Stuur een WhatsApp</a>
            <a href={site.mobielHref} class="btn btn-line"><Icoon naam="tel" />Bel <span class="whitespace-nowrap tabular-nums">{site.mobiel}</span></a>
          </div>
          <p class="mt-6 text-sm text-white/80"><strong class="text-white">4,4</strong> uit 5 op Google, 45 reviews</p>
        </div>
      </div>
    </section>

    <!-- Pechstrook direct onder de hero: de tweede hoofdactie. -->
    <section aria-labelledby="pech-kort" class="bg-rood text-white">
      <div class="wrap flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:justify-between">
        <h2 id="pech-kort" class="flex items-center gap-3 text-xl"><Icoon naam="takel" size={28} />Pech? We halen u op, dag en nacht</h2>
        <a href={site.ophaalHref} class="btn bg-white text-ink hover:bg-ink hover:text-white"><Icoon naam="tel" />Bel <span class="whitespace-nowrap tabular-nums">{site.ophaal}</span></a>
      </div>
    </section>

    <!-- Prijsbord: grote cijfers, geen kaartjes. -->
    <section id="prijzen" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Wat het kost</h2>
          <p class="mt-4 text-ink-soft">Vanafprijzen, inclusief btw. Reparatie van alle merken: stuur een WhatsApp of bel, dan hoort u wat het wordt.</p>
        </div>
        <ul class="divide-y divide-line border-y border-line lg:col-span-8">
          {prijzen.map((p) => (
            <li class="grid grid-cols-[1fr_auto] items-end gap-x-4 py-6">
              <div>
                <h3 class="text-xl">{p.naam}</h3>
                {p.extra && <p class="mt-2 inline-block rounded-[6px] bg-geel px-2 py-0.5 font-display text-sm font-bold uppercase tracking-[0.08em] text-ink">{p.extra}</p>}
              </div>
              <p class="text-right leading-none">
                <span class="block text-xs uppercase tracking-[0.12em] text-ink-soft">vanaf</span>
                <span class="whitespace-nowrap font-display text-prijs font-bold tabular-nums">€&nbsp;{p.prijs}</span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Ophaaldienst: geel vlak met foto, stoer en direct. -->
    <div class="streep h-3" aria-hidden="true"></div>
    <section id="pech" class="scroll-mt-16 bg-geel text-ink">
      <div class="wrap grid items-center gap-10 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-6">
          <p class="font-display text-sm font-semibold uppercase tracking-[0.18em]">Eigen ophaaldienst</p>
          <h2 class="mt-3 text-3xl">Staat u met pech? Geen nood, we komen u gewoon ophalen</h2>
          <p class="mt-5 text-lg">We hebben een eigen ophaaldienst. De auto-ambulance is dag en nacht te bellen.</p>
          <a href={site.ophaalHref} class="btn btn-rood mt-8 w-full !justify-start !py-3 sm:w-auto"><Icoon naam="tel" size={24} /><span class="text-left leading-tight"><span class="block text-sm font-semibold">Bel de ophaaldienst</span><span class="block whitespace-nowrap text-xl tabular-nums">{site.ophaal}</span></span></a>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-[12px] lg:col-span-6">
          <Foto src={takel} alt="Blauwe auto op de laadvloer van een oprijwagen, met twee mensen ernaast" sizes="(min-width: 1024px) 560px, 100vw" />
        </div>
      </div>
    </section>
    <div class="streep h-3" aria-hidden="true"></div>

    <!-- Het bedrijf: foto links, tijdlijn rechts. -->
    <section id="bedrijf" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="order-2 aspect-[4/3] overflow-hidden lg:aspect-[4/5] rounded-[12px] lg:order-1 lg:col-span-5">
          <Foto src={onderkant} alt="Monteur ligt onder een auto op bokken, met een losse schokdemper op de grond" sizes="(min-width: 1024px) 460px, 100vw" />
        </div>
        <div class="order-1 lg:order-2 lg:col-span-6 lg:col-start-7">
          <h2 class="text-3xl">Een familiebedrijf met een nieuwe werkplaats</h2>
          <ol class="mt-10 space-y-8 border-l-2 border-ink pl-6">
            <li class="relative">
              <span class="absolute -left-[1.95rem] top-1.5 size-3.5 rounded-full bg-geel ring-2 ring-ink" aria-hidden="true"></span>
              <p class="font-display text-2xl font-bold tabular-nums leading-none">1985</p>
              <p class="mt-2 text-ink-soft">Het familiebedrijf begint.</p>
            </li>
            <li class="relative">
              <span class="absolute -left-[1.95rem] top-1.5 size-3.5 rounded-full bg-geel ring-2 ring-ink" aria-hidden="true"></span>
              <p class="font-display text-2xl font-bold tabular-nums leading-none">2013</p>
              <p class="mt-2 text-ink-soft">Rob Poot junior neemt het bedrijf over.</p>
            </li>
            <li class="relative">
              <span class="absolute -left-[1.95rem] top-1.5 size-3.5 rounded-full bg-rood ring-2 ring-ink" aria-hidden="true"></span>
              <p class="font-display text-2xl font-bold leading-none">Nu</p>
              <p class="mt-2 text-ink-soft">Een nieuwe werkplaats, met nieuwe apparatuur en moderne technologie op het gebied van auto-elektronica.</p>
            </li>
          </ol>
          <p class="mt-10 text-lg">Service staat bij ons voorop. Kortom: een snelle service en gedegen vakmanschap.</p>
        </div>
      </div>
    </section>

    <!-- Afspraak en contact -->
    <section id="afspraak" class="op-donker scroll-mt-16 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Afspraak maken</h2>
          <p class="mt-4 text-white/85">Het snelst via WhatsApp of telefoon. Mails proberen we binnen 24 uur te beantwoorden.</p>
          <div class="mt-8 flex flex-col gap-3">
            <a href={site.whatsapp} class="btn btn-geel"><Icoon naam="whatsapp" size={22} />Stuur een WhatsApp</a>
            <a href={site.mobielHref} class="btn btn-line"><Icoon naam="tel" />Bel <span class="whitespace-nowrap tabular-nums">{site.mobiel}</span></a>
          </div>
          <dl class="mt-10 grid gap-5">
            <div><dt class="text-sm text-white/75">Werkplaats</dt><dd><a href={site.telHref} class="whitespace-nowrap font-display text-xl font-bold tabular-nums underline decoration-geel decoration-2 underline-offset-4">{site.tel}</a></dd></div>
            <div><dt class="text-sm text-white/75">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] underline decoration-geel decoration-2 underline-offset-4">{site.mail}</a></dd></div>
            <div><dt class="text-sm text-white/75">Adres</dt><dd><address class="not-italic">{site.straat}<br />{site.postcode} {site.plaats}</address><a href={site.maps} rel="noopener" class="mt-2 inline-block underline decoration-geel decoration-2 underline-offset-4">Route plannen</a></dd></div>
          </dl>
          <h3 class="mt-10 text-xl">Openingstijden</h3>
          <table class="mt-3 w-full max-w-sm text-left">
            <caption class="sr-only">Openingstijden van de werkplaats</caption>
            <tbody>
              {tijden.map((t) => (
                <tr class="border-b border-white/10">
                  <th scope="row" class="py-2 font-normal text-white/85">{t.dag}</th>
                  <td class="whitespace-nowrap py-2 text-right tabular-nums">{t.tijd}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <form class="rounded-[12px] bg-paper p-6 text-ink md:p-8 lg:col-span-6 lg:col-start-7 lg:self-start" onsubmit="return false">
          <h3 class="text-2xl">Vraag een afspraak aan</h3>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <div><label for="naam" class="font-semibold">Naam</label><input id="naam" name="naam" autocomplete="name" class="veld mt-1.5" /></div>
            <div><label for="telefoon" class="font-semibold">Telefoon</label><input id="telefoon" name="telefoon" type="tel" autocomplete="tel" class="veld mt-1.5" /></div>
            <div><label for="kenteken" class="font-semibold">Kenteken</label><input id="kenteken" name="kenteken" class="veld mt-1.5 uppercase" /></div>
            <div><label for="soort" class="font-semibold">Waarvoor</label>
              <select id="soort" name="soort" class="veld mt-1.5">
                <option>APK</option>
                <option>Klein onderhoud</option>
                <option>Groot onderhoud</option>
                <option>Reparatie</option>
              </select>
            </div>
            <div class="sm:col-span-2"><label for="bericht" class="font-semibold">Bericht</label><textarea id="bericht" name="bericht" rows="4" class="veld mt-1.5"></textarea></div>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-[10px] border-l-4 border-rood bg-white p-4 text-sm text-ink-soft">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.mobielHref} class="whitespace-nowrap font-semibold text-ink underline tabular-nums">{site.mobiel}</a> of mail naar <a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] font-semibold text-ink underline">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-ink mt-6">Verstuur aanvraag</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
