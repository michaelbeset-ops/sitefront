---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const home = url('');
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-3">
      <a href={home} class="flex items-baseline gap-2 no-underline">
        <span class="font-display text-2xl font-semibold tracking-[0.02em] text-lak">Lotus</span>
        <span class="kicker hidden text-ink-soft min-[380px]:inline">Brielle</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm">
          <li><a href={`${home}#restaurant`} class="no-underline hover:text-lak">Restaurant</a></li>
          <li><a href={`${home}#buffet`} class="no-underline hover:text-lak">Buffet en lunch</a></li>
          <li><a href={`${home}#afhalen`} class="no-underline hover:text-lak">Afhalen</a></li>
          <li><a href={`${home}#catering`} class="no-underline hover:text-lak">Catering</a></li>
          <li><a href={`${home}#reserveren`} class="no-underline hover:text-lak">Reserveren</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-lak !px-4 !py-2 text-sm">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg>
        <span class="sm:hidden">Bellen</span><span class="hidden whitespace-nowrap tabular-nums sm:inline">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="op-donker bg-ink py-12 text-paper/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-xl font-semibold text-paper">{site.naam}</strong><br />{site.volledigeNaam}</p>
      <p class="md:col-span-4">{site.bv}<br />{site.straat}, {site.postcode} {site.plaats}<br />KvK {site.kvk}</p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
