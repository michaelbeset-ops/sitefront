---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, dagen, buffet, lunch, afhaalkaart, sushikaart, cateringMenus } from '../data/site';
import hero from '../assets/hero.jpg';
import dimsum from '../assets/dimsum.jpg';
import sushi from '../assets/sushi.jpg';
import wok from '../assets/wok.jpg';
---
<Base
  title="Restaurant Lotus Brielle | Chinees-Kantonees restaurant, buffet en afhalen"
  description="Chinees-Kantonees specialiteitenrestaurant in het voormalige bus- en tramstation van Brielle. Elke dag open van 12:00 tot 22:00, buffet van woensdag t/m zondag, afhalen en catering."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Donker, met de stoom van het bamboemandje rechts; tekst links op egale inkt. -->
    <section class="op-donker relative isolate overflow-hidden bg-ink text-paper">
      <div class="absolute inset-0 -z-10 lg:left-[40%]">
        <Foto src={hero} alt="Saus wordt over een gerecht in een kom geschonken, tegen een donkere achtergrond" hero sizes="(min-width: 1024px) 60vw, 100vw" class="object-[70%_center]" />
      </div>
      <div class="absolute inset-0 -z-10 bg-ink/80 lg:left-[40%] lg:bg-transparent lg:bg-linear-to-r lg:from-ink lg:via-ink/40 lg:to-transparent"></div>
      <div class="wrap grid pt-16 pb-12 lg:grid-cols-12 lg:pt-28 lg:pb-20">
        <div class="lg:col-span-7">
          <p class="kicker text-gold">Chinees-Kantonees specialiteitenrestaurant</p>
          <h1 class="mt-5 text-4xl">Kantonees eten in het oude bus-&nbsp;en tramstation van Brielle</h1>
          <p class="mt-6 max-w-xl text-lg text-paper/85">Een uitgebreide kaart, zodat er voor ieder wat wils is, en een chef die u graag verwent met enkele nieuwe gerechten. Aan tafel, van het buffet of om mee naar huis te nemen.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#reserveren" class="btn btn-lak">Reserveer een tafel</a>
            <a href={site.telHref} class="btn btn-line"><span>Afhalen: bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
        </div>
      </div>
      <div class="wrap pb-10 lg:pb-14">
        <dl class="grid gap-5 border-t border-paper/20 pt-6 text-sm sm:grid-cols-3 lg:max-w-4xl">
          <div><dt class="text-gold">Restaurant</dt><dd class="mt-1">Elke dag <span class="whitespace-nowrap tabular-nums">12:00 tot 22:00</span></dd></div>
          <div><dt class="text-gold">Afhaalbalie</dt><dd class="mt-1">Elke dag <span class="whitespace-nowrap tabular-nums">12:00 tot 22:00</span></dd></div>
          <div><dt class="text-gold">Google</dt><dd class="mt-1"><span class="tabular-nums">4,3</span> uit 5, <span class="whitespace-nowrap tabular-nums">1.174 reviews</span></dd></div>
        </dl>
      </div>
    </section>

    <!-- Het restaurant: tekst met een lijst van plekken, staande foto ernaast. -->
    <section id="restaurant" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <p class="kicker text-jade">Het restaurant</p>
          <h2 class="mt-4 text-3xl">Zeven dagen per week aan tafel</h2>
          <p class="mt-6 max-w-xl text-lg text-ink-soft">Het restaurant zit in het voormalige bus- en tramstation van Brielle. Ons à-la-carterestaurant is elke dag open, voor de lunch en voor het diner.</p>
          <dl class="mt-10 divide-y divide-line border-y border-line">
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="font-display text-lg font-semibold text-jade">De serre</dt>
              <dd class="text-ink-soft">Aan de achterzijde van het restaurant, met uitzicht over het water.</dd>
            </div>
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="font-display text-lg font-semibold text-jade">Het terras</dt>
              <dd class="text-ink-soft">In de zomermaanden open, zodat u buiten kunt eten.</dd>
            </div>
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="font-display text-lg font-semibold text-jade">Airco</dt>
              <dd class="text-ink-soft">Het hele restaurant is voorzien van airco, dus ook op warme dagen zit u comfortabel.</dd>
            </div>
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <dt class="font-display text-lg font-semibold text-jade">De kaart</dt>
              <dd class="text-ink-soft">Uitgebreid, met daarnaast enkele nieuwe gerechten van de chef.</dd>
            </div>
          </dl>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[4/5]">
            <Foto src={dimsum} alt="Schaal met kip in zoetzure saus met paprika" sizes="(min-width: 1024px) 460px, 100vw" />
          </div>
        </div>
      </div>
    </section>

    <!-- Buffet en lunch: prijzen als menukaart, met een foto die het Japanse deel laat zien. -->
    <section id="buffet" class="scroll-mt-20 bg-rice py-16 lg:py-28">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-jade">Buffet en lunch</p>
            <h2 class="mt-4 text-3xl">Zelf samenstellen, aan het buffet of bij de lunch</h2>
          </div>
        </div>
        <div class="mt-12 grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm">
              <Foto src={sushi} alt="Houten sushiboot vol sushirollen, nigiri met zalm, tonijn en garnaal, en avocado" sizes="(min-width: 1024px) 440px, 100vw" />
            </div>
            <div class="mt-8">
              <h3 class="text-2xl">Chinees-Kantonees-Japans buffet</h3>
              <p class="mt-2 text-ink-soft">Van woensdag t/m zondag. Aan het buffet stelt u zelf uw gerecht samen.</p>
              <ul class="mt-5 border-t border-line">
                {buffet.map((b) => (
                  <li class="flex items-baseline justify-between gap-4 border-b border-line py-3">
                    <span>{b.wanneer}</span>
                    <span class="whitespace-nowrap font-display text-lg font-semibold tabular-nums text-lak">{b.prijs}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="rounded-xl bg-paper p-6 shadow-sm ring-1 ring-line md:p-10 lg:col-span-6 lg:col-start-7">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
              <h3 class="text-2xl">Lunch</h3>
              <p class="whitespace-nowrap tabular-nums text-ink-soft">12:00 tot 15:00</p>
            </div>
            <p class="mt-3 text-ink-soft">Een vast bedrag van <strong class="whitespace-nowrap tabular-nums text-ink">€ 17,50</strong> per persoon. U stelt uw lunch zelf samen met de keuzes van de lunchkaart.</p>
            <div class="mt-8 grid gap-8 sm:grid-cols-2">
              <div>
                <p class="kicker text-jade">Soep naar keuze</p>
                <ul class="mt-3 space-y-1">{lunch.soep.map((s) => <li>{s}</li>)}</ul>
              </div>
              <div>
                <p class="kicker text-jade">Hoofdgerecht naar keuze</p>
                <ul class="mt-3 space-y-1">{lunch.hoofd.map((s) => <li>{s}</li>)}</ul>
              </div>
              <div class="sm:col-span-2">
                <p class="kicker text-jade">Daarbij</p>
                <p class="mt-3">{lunch.erbij.join(', ')}</p>
              </div>
            </div>
            <p class="mt-8 border-t border-line pt-5 text-sm text-ink-soft">De lunch komt met witte rijst. Nasi of bami: <span class="whitespace-nowrap tabular-nums">€ 2,00</span> extra. Chinese bami of mihoen: <span class="whitespace-nowrap tabular-nums">€ 5,00</span> extra.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Afhalen: donker blok, de kaartcategorieën als inhoudsopgave. -->
    <section id="afhalen" class="op-donker scroll-mt-20 bg-ink py-16 text-paper lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-gold">Afhaalbalie, elke dag <span class="whitespace-nowrap tabular-nums">12:00 tot 22:00</span></p>
          <h2 class="mt-4 text-3xl">Afhalen: even bellen, dan staat het klaar</h2>
          <p class="mt-6 text-lg text-paper/85">Belt u van tevoren, dan zorgen we dat uw bestelling op tijd klaar is. We verpakken alles goed, zodat het thuis nog lekker warm is.</p>
          <a href={site.telHref} class="btn btn-lak mt-8"><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          <div class="mt-12 aspect-[16/10] overflow-hidden rounded-xl">
            <Foto src={wok} alt="Close-up van gewokt vlees met rode peper en lente-ui in een witte schaal" sizes="(min-width: 1024px) 420px, 100vw" />
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <h3 class="text-2xl">Op de afhaalkaart</h3>
          <ol class="mt-6 grid gap-x-8 border-t border-paper/20 sm:grid-cols-2">
            {afhaalkaart.map((c, i) => (
              <li class="flex gap-4 border-b border-paper/20 py-3">
                <span class="w-6 shrink-0 text-sm tabular-nums text-gold">{String(i + 1).padStart(2, '0')}</span>
                <span>{c}</span>
              </li>
            ))}
          </ol>
          <p class="mt-6 text-sm text-paper/80">Alle gerechten worden met witte rijst geserveerd. Nasi of bami: <span class="whitespace-nowrap tabular-nums">€ 1,50</span> extra. Mihoen of Chinese bami: <span class="whitespace-nowrap tabular-nums">€ 4,00</span> extra.</p>

          <h3 class="mt-12 text-2xl">Sushi, woensdag t/m zondag</h3>
          <ul class="mt-6 border-t border-paper/20">
            {sushikaart.map((c) => <li class="border-b border-paper/20 py-3">{c}</li>)}
          </ul>
          <p class="mt-6 text-sm text-paper/75">[[AANLEVEREN: gerechten en prijzen per categorie van de afhaalkaart]]</p>
        </div>
      </div>
    </section>

    <!-- Catering: drie menu's als kolommen van een menukaart, voorwaarden en feesten eronder. -->
    <section id="catering" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-jade">Catering</p>
          <h2 class="mt-4 text-2xl min-[400px]:text-3xl">Overwerkmaaltijden voor bedrijven</h2>
        </div>
        <p class="text-lg text-ink-soft lg:col-span-5 lg:col-start-8 lg:self-end">Speciaal voor bedrijven leveren we overwerkmaaltijden, dagelijks bezorgd op een afgesproken tijdstip. U kiest uit drie menu's.</p>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {cateringMenus.map((m) => (
          <div class="border-t-2 border-lak pt-5">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-2xl">{m.naam}</h3>
              <p class="whitespace-nowrap font-display text-lg font-semibold tabular-nums text-lak">{m.prijs} <span class="font-body text-sm font-normal text-ink-soft">p.p.</span></p>
            </div>
            <ul class="mt-4 divide-y divide-line text-sm">
              {m.gerechten.map((g) => <li class="py-2">{g}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="mt-14 grid gap-10 lg:grid-cols-12">
        <ul class="space-y-3 text-ink-soft lg:col-span-5">
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-jade"></span><span>Vanaf 15 personen. Boven de 20 personen komt er 1 gerecht bij.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-jade"></span><span>Menu's combineren is niet mogelijk.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-jade"></span><span>Bezorgkosten <span class="whitespace-nowrap tabular-nums">€ 10,00</span>.</span></li>
          <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-jade"></span><span>De bakken graag schoon terugbrengen.</span></li>
        </ul>
        <div class="op-donker rounded-xl bg-jade p-6 text-paper shadow-sm md:p-10 lg:col-span-6 lg:col-start-7">
          <p class="kicker text-paper">Een feest</p>
          <h3 class="mt-3 text-2xl">Catering op locatie, vanaf 20 personen</h3>
          <p class="mt-4 text-paper/90">Voor bedrijfs-, personeels- en familiefeesten verzorgen we de catering op locatie. Vooraf bespreken we met u het menu en eventueel de dranken.</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn bg-paper text-ink hover:bg-white"><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line break-all">{site.mail}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Reserveren: formulier rechts, contact en tijden links. -->
    <section id="reserveren" class="scroll-mt-20 bg-rice py-16 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-jade">Reserveren</p>
          <h2 class="mt-4 text-3xl">Een tafel voor u vasthouden</h2>
          <p class="mt-6 text-lg text-ink-soft">Bel ons, of laat met het formulier weten wanneer u komt en met hoeveel personen.</p>
          <dl class="mt-10 space-y-5">
            <div><dt class="text-sm text-ink-soft">Telefoon</dt><dd><a href={site.telHref} class="font-display text-2xl font-semibold tabular-nums text-lak underline decoration-1 underline-offset-4">{site.tel}</a></dd></div>
            <div><dt class="text-sm text-ink-soft">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-4">{site.mail}</a></dd></div>
            <div><dt class="text-sm text-ink-soft">Adres</dt><dd><address class="not-italic">{site.straat}<br />{site.postcode} {site.plaats}</address><a href={site.maps} rel="noopener" class="mt-2 inline-block text-jade underline underline-offset-4">Route plannen</a></dd></div>
          </dl>
          <h3 class="mt-12 text-xl">Openingstijden</h3>
          <p class="mt-1 text-sm text-ink-soft">Restaurant en afhaalbalie</p>
          <ul class="mt-4 border-t border-line text-sm">
            {dagen.map((d) => (
              <li class="flex justify-between gap-4 border-b border-line py-2"><span>{d}</span><span class="whitespace-nowrap tabular-nums">12:00 - 22:00</span></li>
            ))}
          </ul>
        </div>
        <form class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line md:p-10 lg:col-span-6 lg:col-start-7 lg:self-start" onsubmit="return false">
          <h3 class="text-xl min-[400px]:text-2xl">Reserveringsverzoek</h3>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label class="text-sm sm:col-span-2">Naam<input class="veld" type="text" name="naam" autocomplete="name" required /></label>
            <label class="text-sm sm:col-span-2">Telefoonnummer<input class="veld" type="tel" name="telefoon" autocomplete="tel" required /></label>
            <label class="text-sm">Datum<input class="veld" type="date" name="datum" required /></label>
            <label class="text-sm">Tijd<input class="veld" type="time" name="tijd" min="12:00" max="22:00" step="900" required /></label>
            <label class="text-sm sm:col-span-2">Aantal personen<input class="veld" type="number" name="personen" min="1" inputmode="numeric" required /></label>
            <fieldset class="text-sm sm:col-span-2">
              <legend>Waarvoor komt u?</legend>
              <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
                <label class="flex items-center gap-2"><input type="radio" name="keuze" value="a-la-carte" class="h-4 w-4 accent-lak" checked /> À la carte</label>
                <label class="flex items-center gap-2"><input type="radio" name="keuze" value="buffet" class="h-4 w-4 accent-lak" /> Buffet (wo t/m zo)</label>
              </div>
            </fieldset>
            <label class="text-sm sm:col-span-2">Opmerking<textarea class="veld" name="opmerking" rows="3"></textarea></label>
          </div>
          {site.voorstel ? (
            <p class="mt-6 rounded-xl bg-rice p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="underline [overflow-wrap:anywhere]">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-lak mt-6 w-full sm:w-auto">Verstuur reserveringsverzoek</button>
          )}
        </form>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
