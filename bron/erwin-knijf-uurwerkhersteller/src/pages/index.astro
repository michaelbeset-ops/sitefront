---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Wijzerplaat from '../components/Wijzerplaat.astro';
import { site, wa, waMet } from '../data/site';
import uurwerk from '../assets/uurwerk.jpg';
import pendule from '../assets/pendule.jpg';
import messing from '../assets/messing.jpg';
---
<Base title="Uurwerkhersteller Erwin Knijf | Reparatie van klokken en horloges, Nieuwerkerk aan den IJssel" description="Erwin Knijf repareert klokken en horloges in Nieuwerkerk aan den IJssel. Maandag tot en met vrijdag 10:00 tot 18:00. Bel of app 06 18 23 05 08.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. Hero: de naam groot, en een gesigneerde wijzerplaat die de echte tijd aangeeft. -->
    <section class="relative overflow-hidden" aria-labelledby="kop">
      <div class="wrap grid lg:min-h-[max(640px,min(calc(100svh-6.1rem),860px))] lg:grid-cols-12">
        <div class="flex flex-col pt-8 lg:col-span-7 lg:justify-between lg:py-14">
          <div class="relative z-10">
            <p class="text-sm text-grafiet sm:text-base">Uurwerkhersteller in Nieuwerkerk aan den IJssel</p>
            <h1 id="kop" class="mt-3 text-[clamp(3.5rem,19vw,5rem)] sm:text-3xl lg:mt-6">Erwin<br class="max-sm:hidden" /> Knijf</h1>
            <p class="display mt-4 max-w-[28rem] text-xl leading-tight lg:mt-7">Reparatie van klokken en horloges.</p>
          </div>

          <!-- de plaat: op mobiel tussen naam en knop, op desktop groot rechts, over de rand van het scherm -->
          <div class="pointer-events-none mx-auto my-7 w-[min(78vw,22rem)] sm:w-[24rem] lg:absolute lg:right-[-9vw] lg:top-1/2 lg:my-0 lg:w-[min(60vw,58rem)] lg:-translate-y-1/2 xl:right-[-6vw]">
            <Wijzerplaat class="block h-auto w-full drop-shadow-[0_18px_30px_#15151526] lg:drop-shadow-[0_30px_50px_#15151530]" />
          </div>

          <div class="relative z-10 pb-10 lg:pb-0">
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
              <a href={waMet('mijn klok staat stil. Kunt u ernaar kijken?')} class="knop max-sm:w-full max-sm:justify-center"><Fragment set:html={wa} />Staat uw klok stil? App Erwin</a>
              <a href={site.telHref} class="lijn max-sm:mx-auto">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            </div>
            <div class="minuten mt-10 max-w-[34rem] max-lg:hidden" aria-hidden="true"></div>
            <p class="mt-4 text-sm text-grafiet max-lg:hidden">Maandag tot en met vrijdag <span class="whitespace-nowrap tabular-nums">10:00 tot 18:00</span>, {site.straat}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Werkwijze: wat klanten noemen, op een donkere klokkast. -->
    <section id="werkwijze" class="op-donker scroll-mt-16 bg-kast text-zilver" aria-labelledby="werk-kop">
      <div class="grid lg:grid-cols-12">
        <div class="relative h-[18rem] sm:h-[26rem] lg:col-span-6 lg:h-auto lg:min-h-[40rem]">
          <Foto src={uurwerk} alt="Sfeerfoto: een geopend horloge-uurwerk met tandwielen en een schroevendraaier op een donkere werkmat" sizes="(min-width: 1024px) 50vw, 100vw" class="object-[35%_50%]" />
        </div>
        <div class="px-5 py-16 sm:px-12 lg:col-span-6 lg:px-16 lg:py-24">
          <h2 id="werk-kop" class="text-2xl text-wit">Hij doet wat hij belooft.</h2>
          <p class="mt-6 max-w-[32rem] text-lg leading-relaxed">Zo omschrijven klanten Erwin op Google: hij belt terug, geeft een prijsopgave en brengt het uurwerk weer terug.</p>
          <div class="minuten mt-12 max-w-[34rem] !text-zilver" aria-hidden="true"></div>

          <p class="mt-12 max-w-[32rem] border-l-2 border-staal-licht pl-5">Een los pinnetje in een horloge? Dat was bij een klant in twee minuten verholpen.</p>
        </div>
      </div>
    </section>

    <!-- 3. Langskomen: adres groot, klok of horloge kiezen, en dan appen. -->
    <section id="langskomen" class="scroll-mt-16 py-20 lg:py-28" aria-labelledby="lang-kop">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <h2 id="lang-kop" class="text-2xl">Ingenieur Leemans&shy;straat 39</h2>
          <p class="mt-3 text-lg text-grafiet">{site.postcode} {site.plaats}. <a href={site.maps} class="lijn text-inkt">Route</a></p>

          <dl class="mt-10 max-w-[30rem]">
            {['Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag'].map((d) => (
              <div class="flex justify-between gap-4 border-b border-haar py-2.5"><dt>{d}</dt><dd class="whitespace-nowrap tabular-nums">10:00 - 18:00</dd></div>
            ))}
          </dl>

          <div class="mt-12 max-w-[34rem]" id="vraag">
            <fieldset>
              <legend class="display text-xl">Waar gaat het om?</legend>
              <div class="mt-4 flex flex-wrap gap-2">
                {[['klok', 'Een klok'], ['horloge', 'Een horloge']].map(([v, l], i) => (
                  <label class="keuze cursor-pointer">
                    <input type="radio" name="soort" value={v} checked={i === 0} class="sr-only" />
                    <span class="block rounded-full border border-inkt px-5 py-2 transition-colors duration-200 hover:bg-wit">{l}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
              <a href={waMet('ik heb een klok die gerepareerd moet worden. Kunt u ernaar kijken?')} id="vraag-wa" class="knop"><Fragment set:html={wa} />Stuur een WhatsApp</a>
              <a href={site.telHref} class="lijn">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            </div>
          </div>
        </div>

        <figure class="m-0 lg:col-span-5">
          <div class="relative h-[26rem] overflow-hidden sm:h-[34rem] lg:h-[40rem]">
            <Foto src={pendule} alt="Sfeerfoto: een sierlijke antieke pendule met romeinse cijfers in gedempt licht" sizes="(min-width: 1024px) 38vw, 100vw" class="object-[50%_35%]" />
          </div>
          <figcaption class="mt-3 text-sm text-grafiet">Sfeerfoto. <span class="text-xs">[[AANLEVEREN: eigen foto's van de werkbank en herstelde klokken]]</span></figcaption>
        </figure>
      </div>
    </section>

    <div class="relative h-[14rem] sm:h-[20rem]" aria-hidden="true">
      <Foto src={messing} alt="" sizes="100vw" class="object-[50%_45%]" />
    </div>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  // Klok of horloge: past het vooraf ingevulde WhatsApp-bericht aan.
  const knop = document.getElementById('vraag-wa') as HTMLAnchorElement | null;
  const tekst: Record<string, string> = {
    klok: 'Hallo Erwin, ik heb een klok die gerepareerd moet worden. Kunt u ernaar kijken?',
    horloge: 'Hallo Erwin, ik heb een horloge dat gerepareerd moet worden. Kunt u ernaar kijken?',
  };
  document.querySelectorAll<HTMLInputElement>('input[name="soort"]').forEach((r) =>
    r.addEventListener('change', () => { if (knop && r.checked) knop.href = `https://wa.me/31618230508?text=${encodeURIComponent(tekst[r.value])}`; })
  );
</script>
