---
import { site, url, wa, waMet } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-haar bg-email/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-baseline gap-3 text-inkt no-underline">
        <span class="display text-[1.7rem] leading-none">Erwin Knijf</span>
        <span class="hidden text-sm text-grafiet sm:inline">Uurwerkhersteller</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-9 text-[.95rem]">
          <li><a href={url('#werkwijze')} class="no-underline decoration-1 underline-offset-[6px] hover:underline">Werkwijze</a></li>
          <li><a href={url('#langskomen')} class="no-underline decoration-1 underline-offset-[6px] hover:underline">Langskomen</a></li>
        </ul>
      </nav>
      <a href={waMet('ik heb een vraag over een klok of horloge.')} class="knop !px-4 !py-2.5 !text-sm"><Fragment set:html={wa} /><span class="max-[359px]:sr-only">WhatsApp</span></a>
    </div>
  </header>
) : (
  <footer class="op-donker bg-kast text-zilver">
    <div class="wrap grid gap-10 pb-10 pt-14 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><span class="display block text-[2.6rem] leading-none text-wit">Erwin Knijf</span><span class="mt-2 block">Uurwerkhersteller</span></p>
      <p class="md:col-span-4">
        {site.straat}<br />{site.postcode} {site.plaats}<br />
        <a href={waMet('ik heb een vraag over een klok of horloge.')} class="lijn">WhatsApp</a> of bel <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a>
      </p>
      <p class="md:col-span-3 md:text-right">
        KvK <span class="text-xs">[[AANLEVEREN: KvK-nummer]]</span><br />
        <a href={url('privacy/')} class="lijn">Privacyverklaring</a><br />
        <span class="text-xs">{site.google.score} op Google, {site.google.aantal} reviews</span>
      </p>
    </div>
    {site.voorstel && <p class="wrap border-t border-haar-licht pb-8 pt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
