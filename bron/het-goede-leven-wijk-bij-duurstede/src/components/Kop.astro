---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Bord from './Bord.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['bord', 'Op het bord'], ['terras', 'Terras'], ['reserveren', 'Proeverijen'], ['gasten', 'Gasten'], ['bezoek', 'Bezoek']];
---
<header class:list={['top-0 z-40 w-full transition-[background-color,box-shadow,color] duration-300', thuis ? 'absolute text-wit' : 'sticky border-b border-lijn bg-muur text-inkt']} data-kop={thuis ? 'licht' : undefined}>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6 md:h-20">
    <a href={url('')} class="group flex items-center gap-3 no-underline" style="color: inherit" aria-label="Het Goede Leven, homepage">
      <Bord class="h-9 w-[3.15rem] flex-none transition-transform duration-500 group-hover:-rotate-3 md:h-10 md:w-14" vul="#1d2220" />
      <span class="schrift whitespace-nowrap text-[1.35rem] leading-none md:text-[1.55rem]">Het Goede Leven</span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-base font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="no-underline opacity-90 transition-opacity duration-200 hover:opacity-100 hover:underline hover:underline-offset-8" style="color: inherit">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="num hidden items-center gap-2 text-base font-medium no-underline xl:inline-flex" style="color: inherit"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
      <a href={h('reserveren')} class="knop hidden !min-h-11 !px-5 !text-base md:inline-flex"><Icoon naam="wa" />Reserveren</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-sm lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 7h18M3 12h18M7 17h14" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden border-t border-lijn bg-muur text-inkt lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="kop block border-b border-lijn py-4 text-xl text-inkt no-underline">{t}</a></li>)}
      <li><a href={h('reserveren')} class="schrift block border-b border-lijn py-4 text-xl text-wijn no-underline">Een tafel reserveren</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-lijn bg-muur/95 p-2 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="flex min-h-12 items-center justify-center gap-2 rounded-sm border-[1.5px] border-inkt text-base font-medium text-inkt no-underline"><Icoon naam="tel" class="h-4 w-4" />Bellen</a>
  <a href={waHoi} class="flex min-h-12 items-center justify-center gap-2 rounded-sm bg-wijn text-base font-medium text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  const kop = document.querySelector<HTMLElement>('[data-kop]');
  if (k && m) {
    k.addEventListener('click', () => {
      const o = k.getAttribute('aria-expanded') !== 'true';
      k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o);
      if (kop) kop.classList.toggle('kop-open', o);
    });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); kop?.classList.remove('kop-open'); }));
  }
  // Op de homepage ligt de kop over de foto; zodra je scrolt wordt hij een vaste, lichte balk.
  if (kop) {
    const zet = () => { const v = window.scrollY > 40; kop.classList.toggle('kop-vast', v); };
    zet(); window.addEventListener('scroll', zet, { passive: true });
  }
</script>

<style is:global>
  [data-kop].kop-vast, [data-kop].kop-open { background: var(--color-muur); color: var(--color-inkt); box-shadow: 0 1px 0 var(--color-lijn), 0 8px 24px -18px #191b1a66; }
  [data-kop].kop-vast { position: fixed; }
</style>
