---
import { site, url, waHoi, tijden, uur } from '../data/site';
import Bord from './Bord.astro';
const jaar = new Date().getFullYear();
const open = [4, 5, 6].map((i) => tijden[i]);
---
<footer class="bg-bord text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <div class="flex items-center gap-4 text-wit">
        <Bord class="h-12 w-[4.2rem] flex-none" vul="#0f1312" />
        <p class="schrift text-[1.75rem] leading-none">Het Goede Leven</p>
      </div>
      <p class="mt-6 max-w-sm">Wijnbar in de Peperstraat, in de oude binnenstad van Wijk bij Duurstede. Wijn per glas of per fles, met iets lekkers op de plank.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1"><a href={site.route} class="link link-licht">Route</a></p>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Open</p>
      <dl class="mt-3 grid max-w-[16rem] grid-cols-[1fr_auto] gap-y-1 num">
        {open.map((t) => <><dt>{t.dag}</dt><dd>{uur(t.open![0])} tot {uur(t.open![1])}</dd></>)}
        <dt>Zondag tot woensdag</dt><dd>dicht</dd>
      </dl>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Het Goede Leven, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's komen van jullie eigen Google-bedrijfsprofiel; gezichten van gasten zijn onherkenbaar gemaakt. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
