<script>
  // Tabs tarieven
  const tl = document.querySelector<HTMLElement>('[data-tabs]');
  if (tl) {
    const knoppen = [...tl.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const kies = (k: HTMLButtonElement) => {
      knoppen.forEach((b) => { const aan = b === k; b.setAttribute('aria-selected', String(aan)); b.tabIndex = aan ? 0 : -1; const p = document.getElementById(b.getAttribute('aria-controls')!); if (p) p.hidden = !aan; });
    };
    knoppen.forEach((b, i) => {
      b.addEventListener('click', () => kies(b));
      b.addEventListener('keydown', (e) => { const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (d) { const n = knoppen[(i + d + knoppen.length) % knoppen.length]; kies(n); n.focus(); } });
    });
  }
  // WhatsApp-berichtbouwer
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hoi Rijschool XXL,'];
      r.push(`Ik heb interesse in: ${(v('wat') || 'een intakeles').toLowerCase()}.`);
      if (v('theorie')) r.push('Theorie gehaald: ' + v('theorie').toLowerCase());
      if (v('wanneer')) r.push('Les het liefst: ' + v('wanneer').toLowerCase());
      if (v('vraag')) r.push(v('vraag'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31626806914?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

