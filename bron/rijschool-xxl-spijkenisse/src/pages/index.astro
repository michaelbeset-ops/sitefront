---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, team, gebieden, pakketten, los, waIntake, waMet, euro } from '../data/site';
import hero from '../assets/hero.jpg';
import auto from '../assets/auto.jpg';
import motor from '../assets/motor.jpg';
import brom from '../assets/brom.jpg';
import pand from '../assets/pand.jpg';
import tony from '../assets/tony.jpg';
import kevin from '../assets/kevin.jpg';
import cheyenne from '../assets/cheyenne.jpg';
import melissa from '../assets/melissa.jpg';
import dakbord from '../assets/dakbord.jpg';
import lMotor1 from '../assets/l-motor1.jpg';
import lMotor2 from '../assets/l-motor2.jpg';
import lBrom from '../assets/l-brom.jpg';
import lTerrein from '../assets/l-terrein.jpg';

const fotoTeam: Record<string, ImageMetadata> = { Tony: tony, Melissa: melissa, Kevin: kevin, Cheyenne: cheyenne };
const prijs = (n: number) => (Number.isInteger(n) ? euro(n) : '€ ' + n.toLocaleString('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

const opleidingen = [
  {
    id: 'auto', t: 'Auto', code: 'B', icoon: 'auto', src: auto, w: [400, 760], pos: '50% 55%',
    alt: 'Een witte lesauto van Rijschool XXL met het XXL-logo op de motorkap en het lesbord op het dak',
    punten: ['Beginnen vanaf 16,5 jaar', 'Lessen van 50 minuten, pakketten van 20 tot 40 lessen', 'Volgens de Rijopleiding in Stappen (RIS)'],
    vanaf: 970, wa: 'Hoi Rijschool XXL, ik heb interesse in autorijlessen.',
  },
  {
    id: 'motor', t: 'Motor', code: 'A2 · A', icoon: 'motor', src: motor, w: [400, 800, 1000], pos: '30% 50%',
    alt: 'Motorles op het oefenterrein: de instructeur met portofoon kijkt hoe een leerling in geel hesje aan komt rijden',
    punten: ['Middelzware (A2) en zware motor (A)', 'Lessen van 100 minuten met Tony', 'Begeleiding naar het AVB- en AVD-examen'],
    vanaf: 965, wa: 'Hoi Rijschool XXL, ik heb interesse in motorrijlessen.',
  },
  {
    id: 'brom', t: 'Bromfiets', code: 'AM', icoon: 'brom', src: brom, w: [400, 800, 1200], pos: '60% 50%',
    alt: 'Scooterles op een fietspad langs het water, gefilmd vanaf de instructeur die achter de leerlingen rijdt',
    punten: ['Theorie vanaf 15,5 jaar, praktijkexamen vanaf 16', '4 uur praktijkles, examen, scooter en helm', 'Snel examen, korte wachttijden'],
    vanaf: 450, wa: 'Hoi Rijschool XXL, ik heb interesse in bromfietsrijlessen.',
  },
];

const tabs = [
  { id: 'auto', t: 'Auto', sub: 'autorijlessen van 50 minuten' },
  { id: 'motor', t: 'Motor', sub: 'motorrijlessen van 100 minuten' },
  { id: 'brom', t: 'Bromfiets', sub: 'scooter en helm inbegrepen' },
];
const goedkoopst = (lijst: { lessen: number; nu: number }[]) => Math.min(...lijst.map((p) => p.nu / p.lessen));

const stappen = [
  ['Intakeles', 'Kennismaken in 100 minuten. Je voelt meteen of het klikt met je instructeur en de lesauto.'],
  ['Machtig ons bij het CBR', `Via mijn.cbr.nl met DigiD. Ons rijschoolnummer is ${site.cbr}; zonder machtiging kunnen wij je examen niet aanvragen.`],
  ['Haal je theorie', 'Het liefst al vóór je eerste lessen. Dan pak je het rijden veel sneller op.'],
  ['Lessen op jouw tempo', 'Meerdere lessen per week of rustig aan: alles kan. Stap voor stap volgens de RIS-methode.'],
  ['Toets en examen', 'Wil je eerst een tussentijdse toets? Geef het tijdig aan. Je instructeur plant in overleg het praktijkexamen in.'],
];

const kaders = [
  { icoon: 'lach', t: 'Streng waar het moet, altijd met humor', d: 'Geduld en humor komen in de reviews steeds terug. Tony zegt waar het op staat, en je leert er veel van.' },
  { icoon: 'helm', t: 'Eerst een keer achterop', d: 'Bij de scooter- en motorlessen mag je mee achterop bij Tony. Leerlingen met faalangst raden het iedereen aan.' },
  { icoon: 'schild', t: 'Geen lessen aangesmeerd', d: 'Leerlingen schrijven het zelf: hier word je niet aan extra lessen gehouden. Ben je klaar, dan ga je op examen.' },
];

const beeld = [
  { src: lMotor1, alt: 'Tony geeft uitleg aan een motorleerling in een geel hesje op het oefenterrein', groot: true, pos: '60% 50%' },
  { src: lBrom, alt: 'Drie scooterleerlingen in gele hesjes rijden achter elkaar over een landweggetje', pos: '50% 60%' },
  { src: dakbord, alt: 'Het gele lesbord met de tekst Spijkenisse en een L op het dak van de lesauto', pos: '40% 50%' },
  { src: lMotor2, alt: 'Motorleerlingen met helm op hun motoren, terwijl de instructeur de route aanwijst', pos: '50% 50%' },
  { src: lTerrein, alt: 'Motoren tussen de pionnen op het oefenterrein', pos: '50% 50%' },
];
---
<Base title={`${site.naam} | Auto, motor en bromfiets in Spijkenisse`} description="Rijschool in Spijkenisse voor auto, motor en bromfiets. Altijd een vaste rijinstructeur, vlakbij het CBR. 4,9 op Google uit 257 reviews. Plan je intakeles via WhatsApp.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen lesauto en lesmotor voor het pand -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-asfalt text-licht lg:items-center" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" quality={62} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[38%_60%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#12131540_0%,#121315b8_45%,#121315f5_100%)] lg:bg-[linear-gradient(90deg,#121315f7_0%,#121315d9_40%,#1213154d_75%,#12131526_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-28 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-8">
          <p class="eyebrow">Rijschool in Spijkenisse · auto · motor · bromfiets</p>
          <h1 id="t-hero" class="mt-6 text-hero">Xtra veilig en Xtra snel <span class="text-geel">je rijbewijs.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Al jaren het vertrouwde adres in Spijkenisse en omgeving. Altijd een vaste rijinstructeur, en de rijschool zit vlakbij het CBR.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waIntake} class="knop knop-geel"><Icoon naam="wa" />Plan je intakeles</a>
            <a href="#tarieven" class="knop knop-rand op-foto">Bekijk de tarieven</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ook bereikbaar in het weekend</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto w-full max-w-[19rem] bg-asfalt/80 p-7 shadow-md ring-1 ring-licht/15 backdrop-blur-md">
            <p class="text-xs font-bold uppercase tracking-[.16em] text-geel">Kennismaken</p>
            <p class="mt-4 font-kop text-2xl font-semibold uppercase leading-tight">Intakeles van 100 minuten</p>
            <p class="num mt-3 font-kop text-[3.75rem] font-bold leading-none">{euro(90)}</p>
            <p class="mt-4 text-sm text-licht-zacht">Kijk of het klikt, daarna kies je pas een pakket.</p>
            <a href={site.telHref} class="num mt-6 flex items-center justify-between border-t border-lijn-licht pt-5 font-semibold text-licht no-underline hover:text-geel">Bel {site.tel}<Icoon naam="pijl" class="h-5 w-5" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Cijfers -->
    <section class="border-b border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-grijs">Gemiddeld op Google</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,4rem)] font-bold leading-none">{site.google.score}<span class="text-[.5em] text-grijs"> / 5</span></dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Google-reviews</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,4rem)] font-bold leading-none">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Tony en Melissa geven les sinds</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,4rem)] font-bold leading-none">2003</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Dagen per week bereikbaar</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,4rem)] font-bold leading-none">7</dd></div>
      </dl>
    </section>

    <!-- 3. Opleidingen -->
    <section id="opleidingen" class="py-20 lg:py-24" aria-labelledby="t-opl">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Opleidingen</p>
            <h2 id="t-opl" class="mt-5 text-3xl">Auto, motor of bromfiets. Alles bij één rijschool.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Onze leerlingen opleiden tot veilige en verantwoorde weggebruikers, vol zelfvertrouwen. Dat staat bij ons voorop.</p>
        </div>
        <ul class="mt-14 grid gap-5 md:grid-cols-3 lg:gap-6">
          {opleidingen.map((o, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden">
                <div class="relative overflow-hidden">
                  <Image src={o.src} alt={o.alt} widths={o.w} sizes="(min-width: 1248px) 380px, (min-width: 768px) 31vw, 92vw" quality={70} class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${o.pos}`} />
                  <span class="absolute left-0 top-5 bg-geel px-3 py-1.5 font-kop text-sm font-bold uppercase tracking-wide">Rijbewijs {o.code}</span>
                </div>
                <div class="flex flex-1 flex-col p-6 lg:p-7">
                  <h3 class="flex items-center gap-3 text-2xl"><Icoon naam={o.icoon} class="h-7 w-7" />{o.t}</h3>
                  <ul class="mt-5 flex-1 space-y-2.5 text-[.9875rem]">
                    {o.punten.map((p) => <li class="flex gap-2.5"><Icoon naam="vink" class="mt-1 h-4 w-4 shrink-0" />{p}</li>)}
                  </ul>
                  <div class="mt-7 flex items-end justify-between gap-4 border-t border-lijn pt-5">
                    <p class="text-sm text-grijs">vanaf<span class="num block font-kop text-3xl font-bold leading-none text-inkt">{euro(o.vanaf)}</span></p>
                    <a href={waMet(o.wa)} class="knop knop-inkt knop-klein">Aanmelden<Icoon naam="pijl" /></a>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="rijs mt-6 flex flex-col items-start justify-between gap-5 bg-asfalt px-6 py-6 text-licht sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Aanhangwagenrijbewijs (E achter B)?</b> <span class="text-licht-zacht">Ook daarvoor kun je bij ons terecht.</span></p>
          <a href={waMet('Hoi Rijschool XXL, ik heb interesse in het aanhangwagenrijbewijs (E achter B).')} class="knop knop-geel knop-klein shrink-0"><Icoon naam="wa" />Vraag het na</a>
        </div>
      </div>
    </section>

    <!-- 4. Tarieven: pakketkiezer -->
    <section id="tarieven" class="bg-beton py-20 lg:py-24" aria-labelledby="t-tar">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Tarieven</p>
            <h2 id="t-tar" class="mt-5 text-3xl">Kies je pakket. De prijs staat erbij.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Met de knop bij een pakket staat je aanmelding klaar in WhatsApp. Pakketten zijn exclusief het CBR-praktijkexamen.</p>
        </div>

        <div class="mt-12 inline-flex bg-wit p-1 shadow-sm" role="tablist" aria-label="Soort rijbewijs" data-tabs>
          {tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`paneel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tab">{t.t}</button>
          ))}
        </div>

        {tabs.map((t, i) => {
          const lijst = pakketten[t.id as keyof typeof pakketten] as any[];
          const best = t.id !== 'brom' ? goedkoopst(lijst) : 0;
          return (
            <div id={`paneel-${t.id}`} role="tabpanel" aria-labelledby={`tab-${t.id}`} class="paneel mt-8 grid gap-6 lg:grid-cols-12" hidden={i !== 0} data-paneel>
              <ul class={`grid gap-4 sm:grid-cols-2 lg:col-span-8 ${lijst.length === 3 ? 'xl:grid-cols-3' : ''}`}>
                {lijst.map((p) => {
                  const perLes = p.lessen ? p.nu / p.lessen : 0;
                  const topper = perLes && perLes === best;
                  const bericht = p.lessen
                    ? `Hoi Rijschool XXL, ik heb interesse in ${t.id === 'auto' ? 'autorijlessen' : 'motorrijlessen'}, ${p.naam} (${p.lessen} lessen van ${p.duur}, ${euro(p.nu)}).`
                    : `Hoi Rijschool XXL, ik heb interesse in het bromfiets-${p.naam.toLowerCase()} (${euro(p.nu)}).`;
                  return (
                    <li class={`pakket flex flex-col p-6 ${topper ? 'bg-asfalt text-licht donker' : 'kaart'}`}>
                      <div class="flex items-start justify-between gap-3">
                        <h3 class="text-xl">{p.naam}</h3>
                        {topper && <span class="bg-geel px-2 py-1 text-[.6875rem] font-bold uppercase tracking-wider text-inkt">Laagste prijs per les</span>}
                      </div>
                      <p class={`mt-1.5 text-sm ${topper ? 'text-licht-zacht' : 'text-grijs'}`}>{p.lessen ? `${p.lessen} lessen van ${p.duur}` : p.wat}</p>
                      <p class="mt-6 flex items-baseline gap-3">
                        <span class="num font-kop text-[2.75rem] font-bold leading-none">{euro(p.nu)}</span>
                        {p.normaal > 0 && <s class={`num text-sm ${topper ? 'text-licht-zacht' : 'text-grijs'}`}>normaal {euro(p.normaal)}</s>}
                      </p>
                      <p class={`mt-2 min-h-[1.5rem] text-sm ${topper ? 'text-licht-zacht' : 'text-grijs'}`}>{perLes ? <>Dat is <b class={topper ? 'text-geel' : 'text-inkt'}>{prijs(Math.round(perLes * 100) / 100)}</b> per les</> : ''}</p>
                      <a href={waMet(bericht)} class={`knop knop-klein mt-6 ${topper ? 'knop-geel' : 'knop-inkt'}`}><Icoon naam="wa" />Kies {p.naam.startsWith("Pakket") ? p.naam.replace("Pakket", "pakket") : p.naam.toLowerCase()}</a>
                    </li>
                  );
                })}
              </ul>
              <aside class="kaart p-6 lg:col-span-4 lg:p-8">
                <h3 class="text-xl">Losse tarieven</h3>
                <p class="mt-1 text-sm text-grijs">{t.t}: {t.sub}</p>
                <table class="mt-5 w-full text-[.9375rem]">
                  <caption class="sr-only">Losse tarieven {t.t}</caption>
                  <tbody>
                    {los[t.id].map(([n, b]) => (
                      <tr class="border-b border-lijn last:border-0"><th scope="row" class="py-2.5 pr-4 text-left font-normal">{n}</th><td class="num whitespace-nowrap py-2.5 text-right font-semibold">{euro(b)}</td></tr>
                    ))}
                  </tbody>
                </table>
                {t.id === 'brom' && <p class="mt-5 bg-beton p-4 text-sm">Tip: doe je theorie-examen een maand of 2 voor je 16e verjaardag. Dan kunnen we je op of vlak na je verjaardag inplannen voor het praktijkexamen.</p>}
                {t.id === 'motor' && <p class="mt-5 bg-beton p-4 text-sm">Let op de kledingeisen bij het examen: helm met vizier of bril, protectoren, en geen gewone sneakers.</p>}
                {t.id === 'auto' && <p class="mt-5 bg-beton p-4 text-sm">Last van examenvrees? Er is ook een faalangstexamen. Vraag gerust wat bij je past.</p>}
              </aside>
            </div>
          );
        })}
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section id="werkwijze" class="donker bg-asfalt py-24 text-licht lg:py-32" aria-labelledby="t-stap">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Stappenplan</p>
            <h2 id="t-stap" class="mt-5 text-3xl">Van intakeles tot roze pasje.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Zo werken we bij het autorijbewijs. Voor motor en bromfiets gaat het net zo: eerst kennismaken, dan stap voor stap naar het examen.</p>
        </div>
        <ol class="mt-14 grid gap-px bg-asfalt-3 sm:grid-cols-2 lg:grid-cols-5">
          {stappen.map(([t, d], i) => (
            <li class="rijs bg-asfalt p-6 lg:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.75rem] font-bold leading-none text-geel">0{i + 1}</p>
              <h3 class="mt-6 text-xl">{t}</h3>
              <p class="mt-3 text-[.9375rem] text-licht-zacht">{d}</p>
            </li>
          ))}
        </ol>
        <div class="rijs mt-10 flex flex-col gap-5 border border-lijn-licht p-6 sm:flex-row sm:items-center sm:justify-between md:px-8">
          <p class="flex items-center gap-4"><span class="bg-geel px-3 py-2 font-kop text-xl font-bold text-inkt">{site.cbr}</span><span>Ons CBR-rijschoolnummer. Nodig voor je machtiging op mijn.cbr.nl.</span></p>
          <a href={site.machtigen} class="knop knop-rand knop-klein shrink-0">Naar mijn.cbr.nl<Icoon naam="pijl" /></a>
        </div>
      </div>
    </section>

    <!-- 6. Les in beeld -->
    <section class="py-20 lg:py-24" aria-labelledby="t-beeld">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Op de weg</p>
            <h2 id="t-beeld" class="mt-5 text-3xl">Les in beeld.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Oefenen op het terrein, de weg op met de scooter, en het gele lesbord van Spijkenisse.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-5 md:gap-4">
          {beeld.map((b, i) => (
            <li class={`rijs relative overflow-hidden bg-beton ${b.groot ? 'col-span-2 aspect-[4/3] md:col-span-1 md:aspect-[4/5]' : 'aspect-square md:aspect-[4/5]'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={b.src} alt={b.alt} widths={b.groot ? [600, 1000] : [320, 480, 640]} sizes={b.groot ? '(min-width: 1248px) 600px, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" style={`object-position:${b.pos}`} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="donker bg-asfalt text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[26rem] bg-[#d6d6d3] sm:min-h-[34rem] lg:col-span-5">
          <Image src={tony} alt="Tony, oprichter van Rijschool Spijkenisse XXL" widths={[480, 709]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_20%]" />
          <p class="absolute bottom-0 left-0 bg-geel px-5 py-3 font-kop text-lg font-bold uppercase text-inkt">Tony · oprichter</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over ons</p>
          <h2 id="t-over" class="mt-5 text-3xl">Examinator worden? Lesgeven bleek te leuk.</h2>
          <div class="mt-6 space-y-4 text-lg text-licht-zacht">
            <p>Tony en Melissa begonnen in 2003 met z’n tweeën en groeiden uit tot zes rij-instructeurs. Toen Tony het aanbod kreeg om examinator bij het CBR te worden, verkochten ze hun rijschool: een examinator mag geen eigen rijschool hebben.</p>
            <p>Maar Tony vond lesgeven te leuk om mee te stoppen. In januari 2017 begon hij Rijschool Spijkenisse XXL, met meer dan 20 jaar ervaring en één doel: het belang van de leerling voorop.</p>
          </div>
