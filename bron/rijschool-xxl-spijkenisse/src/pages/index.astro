  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; background: var(--color-beton); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #d6d6d0; }
  .keuze input:checked + span { background: var(--color-inkt); color: var(--color-geel); }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-inkt); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-sm); border: 1.5px solid #12131533; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #12131566; }
