  .tab { min-height: 2.75rem; padding: 0 .95rem; font-family: var(--font-kop); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; font-size: 1.0625rem; cursor: pointer; transition: background-color .2s, color .2s; }
  @media (min-width: 640px) { .tab { padding: 0 1.4rem; } }
  .tab:hover { background: var(--color-beton); }
