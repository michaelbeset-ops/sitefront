---
// Wordmark zoals in de kop van de oude site ("minicamping" klein boven "'t Hommeltje"), met een eigen getekende hommel
// als beeldmerk (de oude site gebruikte een tekenfilmfiguur die we niet overnemen).
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const romp = licht ? '#fffcf5' : '#221a12';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg viewBox="0 0 44 36" class="h-9 w-11 flex-none" aria-hidden="true">
    <ellipse cx="17" cy="9" rx="7.5" ry="5.5" fill={licht ? '#ffffff59' : '#1c4d7233'} stroke={romp} stroke-width="1.6" transform="rotate(-25 17 9)" />
    <ellipse cx="26" cy="8" rx="6.5" ry="5" fill={licht ? '#ffffff40' : '#1c4d7222'} stroke={romp} stroke-width="1.6" transform="rotate(20 26 8)" />
    <ellipse cx="22" cy="22" rx="15" ry="11" fill="#f5b82e" stroke={romp} stroke-width="2" />
    <path d="M17 11.6c-2.3 2.8-3.3 6.4-3.3 10.4s1 7.6 3.3 10.4M26 11.4c2 2.9 3 6.5 3 10.6s-1 7.7-3 10.6" fill="none" stroke={romp} stroke-width="3.6" stroke-linecap="round" />
    <circle cx="35.5" cy="21" r="1.7" fill={romp} />
    <path d="M7 22H3" stroke={romp} stroke-width="2" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class={`font-display text-[0.75rem] font-bold tracking-[0.04em] ${licht ? 'text-honing' : 'text-groen'}`}>minicamping</span>
    <span class="mt-0.5 font-display text-xl font-extrabold tracking-[-0.02em]">'t Hommeltje</span>
  </span>
</span>
