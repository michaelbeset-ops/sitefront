---
import { site, url, waHoi, tijden, dagNamen, uur } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const ontdek = [['kaart', 'De kaart'], ['lokaal', 'Het lokaal'], ['verhaal', 'Ons verhaal'], ['reviews', 'Reviews'], ['klik', 'Reserveren of bestellen']];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.95rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Stadshuiskamertje op steenworp van de Grote Kerk in Dordrecht. Met liefde thuis bereid.</p>
      <p class="mt-4 text-sm">Anne-Marie & Maarten</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={waHoi} class="knop knop-merk min-h-11 px-5"><Icoon naam="wa" />WhatsApp</a>
      </div>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Ontdek</p>
      <ul class="mt-5 space-y-2">
        {ontdek.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-merk">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline hover:text-merk">{site.tel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-merk">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.route} class="no-underline hover:text-merk">Route plannen</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Openingstijden</p>
      <ul class="num mt-5 space-y-1.5">
        {[3, 4, 5, 6, 0, 1, 2].map((d) => { const t = tijden[d]; return <li class="flex justify-between gap-4"><span class="text-wit/90">{dagNamen[d]}</span><span>{t ? `${uur(t[0])} - ${uur(t[1])}` : 'Gesloten'}</span></li>; })}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.volledig}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  <p class="wrap pb-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie.{site.voorstel && " Foto's van het balkon, het pand en het interieur: Lokaal de Klik zelf (Google-profiel). Kaart en teksten van jullie eigen menukaart en flyer. Reviews letterlijk van Google (stand 12 oktober 2026)."}</p>
  <div class="h-14 md:hidden" aria-hidden="true"></div>
</footer>
