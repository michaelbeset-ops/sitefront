---
// Woordmerk naar hun logo (raambord, flyer, menukaart): "de klik" in ronde, geometrische kleine letters met
// "lokaal" klein eronder, op een geel vlak. Nagetekend in Comfortaa, geen origineel bestand.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class="grid h-11 w-11 flex-none place-items-center rounded-[6px] bg-merk font-logo text-[1.05rem] font-bold leading-none tracking-[-.04em] text-inkt" aria-hidden="true">dk</span>
  <span class="leading-none">
    <span class="sr-only">Lokaal de Klik, naar de homepage</span>
    <span aria-hidden="true" class="block font-logo text-[1.5rem] font-bold tracking-[-.03em] sm:text-[1.65rem]">de klik</span>
    <span aria-hidden="true" class={`mt-1 block font-logo text-[.72rem] font-bold tracking-[.2em] ${donker ? 'text-steen' : 'text-wit/75'}`}>lokaal</span>
  </span>
</a>
