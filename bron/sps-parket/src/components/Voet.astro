---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-inkt text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk />
      <p class="mt-6 max-w-xs">Vloeren schuren, olie- en lakafwerking, renovatie en schadeherstel. Vanuit {site.plaats}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Op de site</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={url('#werkwijze')} class="link link-licht">Van korrel 50 naar 120</a></li>
        <li><a href={url('#visgraat')} class="link link-licht">Visgraat</a></li>
        <li><a href={url('#aanvraag')} class="link link-licht">Vloer aanvragen</a></li>
        <li><a href={site.reviews} class="link link-licht">Reviews op Google</a></li>
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <a href={waHoi} class="link link-licht">(ook WhatsApp)</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-1.5">{site.plaats}</p>
      <p class="mt-5 flex gap-5">
        <a href={site.facebook} class="flex items-center gap-2 no-underline transition-colors hover:text-wit"><Icoon naam="fb" class="h-5 w-5" />Facebook</a>
        <a href={site.instagram} class="flex items-center gap-2 no-underline transition-colors hover:text-wit"><Icoon naam="insta" class="h-5 w-5" />Instagram</a>
      </p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Alle foto's zijn jullie eigen foto's van Facebook en het Google-profiel. Reviews letterlijk van Google (stand 10 oktober 2026).</p>}
</footer>
