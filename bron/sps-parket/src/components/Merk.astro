---
// Woordmerk naar hun logo: S.P.S. met daaronder "Slagmolen Parket Service". Letters in serif, de punten in hun rood.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
const punt = donker ? 'text-rood' : 'text-rood-licht';
---
<a href={url('')} class={`group flex items-end gap-3 no-underline ${donker ? 'text-inkt' : 'text-wit'}`} aria-label="S.P.S. Slagmolen Parket Service, naar de homepage">
  <span class="kop text-[2.1rem] font-semibold leading-none tracking-[.02em] sm:text-[2.4rem]">S<span class={punt}>.</span>P<span class={punt}>.</span>S<span class={punt}>.</span></span>
  <span class={`mb-[.3rem] hidden text-[.72rem] font-semibold uppercase leading-tight tracking-[.14em] sm:block ${donker ? 'text-grijs' : 'text-wit/80'}`}>Slagmolen<br />Parket Service</span>
</a>
