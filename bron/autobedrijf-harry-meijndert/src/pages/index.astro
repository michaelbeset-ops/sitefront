---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, autos, tijdlijn, route, tijden } from '../data/site';
import hero from '../assets/hero.jpg';
import showroom from '../assets/showroom.jpg';
import sleutel from '../assets/sleutel.jpg';
import werkplaats from '../assets/werkplaats.jpg';
---
<Base
  title="Autobedrijf Harry Meijndert | Occasions alle merken in Spijkenisse"
  description="In- en verkoop van occasions van alle merken, gebruikte en nieuwe auto-onderdelen en financiering via de Ribank. Newtonweg 1-B, Spijkenisse. Ook op zaterdag open."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: foto over de volle breedte, tekst links op asfalt, feitenbalk die eronder uitsteekt. -->
    <section class="op-donker relative bg-asfalt text-white">
      <div class="absolute inset-0 overflow-hidden"><Foto src={hero} alt="Modern bedrijfspand met glazen gevel in de schemering, met een blauwe auto ervoor" hero sizes="100vw" /></div>
      <div class="absolute inset-0 bg-asfalt/75 lg:bg-transparent lg:bg-[linear-gradient(90deg,#1d2126f2_0%,#1d2126cc_42%,#1d212600_78%)]" aria-hidden="true"></div>
      <div class="wrap relative grid gap-10 pt-16 pb-12 lg:grid-cols-12 lg:pt-28 lg:pb-20">
        <div class="lg:col-span-7">
          <p class="smal text-sm text-geel">Autobedrijf in Spijkenisse</p>
          <h1 class="mt-4 text-4xl">Occasions van alle merken</h1>
          <p class="mt-6 max-w-xl text-lg text-white/90">In- en verkoop van occasions, verkoop van gebruikte auto-onderdelen en nieuwe onderdelen tegen sterk concurrerende prijzen. Aan de Newtonweg, ook op zaterdag geopend.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#voorraad" class="btn btn-rood">Bekijk de voorraad</a>
            <a href={site.telHref} class="btn btn-line">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
        </div>
      </div>
      <div class="relative">
        <div class="wrap">
          <dl class="grid translate-y-8 overflow-hidden rounded-md shadow-[0_2px_6px_#1d212640] sm:grid-cols-3">
            <div class="bg-geel px-5 py-5 text-asfalt">
              <dt class="smal text-xs">Ook op zaterdag open</dt>
              <dd class="mt-1 font-display text-xl font-extrabold whitespace-nowrap tabular-nums uppercase [font-stretch:70%]">Za 10.00 tot 15.00</dd>
            </div>
            <div class="bg-white px-5 py-5 text-asfalt">
              <dt class="smal text-xs text-ink-soft">Op voorraad</dt>
              <dd class="mt-1 font-display text-xl font-extrabold uppercase [font-stretch:70%]"><span class="tabular-nums">{site.voorraadAantal}</span> auto's</dd>
            </div>
            <div class="bg-white px-5 py-5 text-asfalt sm:border-l sm:border-line">
              <dt class="smal text-xs text-ink-soft">Google</dt>
              <dd class="mt-1 font-display text-xl font-extrabold uppercase [font-stretch:70%]"><span class="tabular-nums">{site.google.score}</span> uit 5 <span class="font-body text-sm font-normal normal-case text-ink-soft">({site.google.reviews} reviews)</span></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Voorraad: typografische kaarten, geen foto's. Kop links, teller rechts. -->
    <section id="voorraad" class="scroll-mt-20 pt-24 pb-16 lg:pt-32 lg:pb-24">
      <div class="wrap">
        <div class="grid items-end gap-8 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="smal text-sm text-rood">Occasions</p>
            <h2 class="mt-3 text-3xl">Een greep uit de voorraad</h2>
            <p class="mt-5 max-w-xl text-ink-soft">Van een Chevrolet Matiz tot een BMW M3 en een volledig gerestaureerde Citroën uit 1929. In- en verkoop van alle merken.</p>
          </div>
          <div class="flex items-end gap-5 lg:col-span-5 lg:justify-end">
            <p class="font-display text-[5.5rem] leading-[0.8] font-extrabold text-rood tabular-nums [font-stretch:55%]">{site.voorraadAantal}</p>
            <p class="smal pb-1 text-sm leading-tight">auto's<br />op voorraad</p>
          </div>
        </div>

        <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {autos.map((a, i) => (
            <li class:list={[i >= 6 ? "hidden sm:flex" : "flex", "flex-col rounded-md bg-white shadow-[0_1px_2px_#1d212624] ring-1 ring-line"]}>
              <div class="border-b border-line px-5 pt-5 pb-4">
                <h3 class="text-[2.5rem] leading-[0.9]">{a.merk}</h3>
                <p class="mt-1 font-display text-xl font-bold uppercase [font-stretch:75%]">{a.model}</p>
                <p class="mt-2 text-sm text-ink-soft">{a.uitvoering}</p>
              </div>
              <dl class="grid grid-cols-2 gap-x-4 gap-y-3 px-5 py-4 text-sm">
                <div><dt class="text-xs text-ink-soft">Bouwjaar</dt><dd class="font-semibold tabular-nums">{a.jaar}</dd></div>
                <div><dt class="text-xs text-ink-soft">Km-stand</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{a.km} km</dd></div>
                <div><dt class="text-xs text-ink-soft">Brandstof</dt><dd class="font-semibold">{a.brandstof}</dd></div>
                <div><dt class="text-xs text-ink-soft">Transmissie</dt><dd class="font-semibold">{a.transmissie}</dd></div>
                <div><dt class="text-xs text-ink-soft">Carrosserie</dt><dd class="font-semibold">{a.carrosserie}</dd></div>
                {a.apk && <div><dt class="text-xs text-ink-soft">APK</dt><dd class="font-semibold">{a.apk}</dd></div>}
              </dl>
              <p class="mt-auto flex items-center justify-between gap-3 rounded-b-md bg-asfalt px-5 py-3 text-white">
                <span class="smal text-xs text-white/80">Prijs</span>
                <span class="font-display text-2xl font-extrabold whitespace-nowrap tabular-nums [font-stretch:70%]">€ {a.prijs}</span>
              </p>
            </li>
          ))}
        </ul>

        <div class="mt-10 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm text-ink-soft">Voorraad van {site.voorraadDatum}</p>
            <p class="text-xs text-ink-soft">[[AANLEVEREN: koppeling voorraadfeed]]</p>
          </div>
          <a href="#voorraad" class="btn btn-rood self-start">Bekijk de hele voorraad</a>
        </div>
      </div>
    </section>

    <!-- Onderdelen: foto links, twee regels tekst rechts, op beton. -->
    <section id="onderdelen" class="scroll-mt-20 bg-beton py-16 lg:py-24">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12">
        <div class="aspect-[4/3] overflow-hidden rounded-md lg:col-span-5 lg:aspect-[4/5]">
          <Foto src={werkplaats} alt="Oude auto in restauratie in een werkplaats" sizes="(min-width: 1024px) 460px, 100vw" />
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="smal text-sm text-rood">Onderdelen</p>
          <h2 class="mt-3 text-3xl">Auto-onderdelen, gebruikt en nieuw</h2>
          <ul class="mt-10 divide-y divide-line border-y border-line">
            <li class="grid gap-2 py-6 sm:grid-cols-[10rem_1fr]">
              <h3 class="text-xl">Gebruikt</h3>
              <p class="text-ink-soft">Wij verkopen gebruikte auto-onderdelen. Daar begon het bedrijf in 1965 ook mee: handel in tweedehands onderdelen.</p>
            </li>
            <li class="grid gap-2 py-6 sm:grid-cols-[10rem_1fr]">
              <h3 class="text-xl">Nieuw</h3>
              <p class="text-ink-soft">Wij leveren ook nieuwe auto-onderdelen, tegen sterk concurrerende prijzen.</p>
            </li>
          </ul>
          <p class="mt-4 text-xs text-ink-soft">[[AANLEVEREN: voor welke merken en soorten onderdelen, en hoe bestellen]]</p>
          <a href={site.telHref} class="btn btn-line mt-8">Vraag naar een onderdeel</a>
        </div>
      </div>
    </section>

    <!-- Financiering: donker vlak, tekst links, sleutelfoto rechts. -->
    <section id="financiering" class="op-donker scroll-mt-20 bg-asfalt py-16 text-white lg:py-24">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="smal text-sm text-geel">Financiering</p>
          <h2 class="mt-3 text-3xl">Financiering via de Ribank</h2>
          <div class="mt-6 space-y-4 text-lg text-white/90">
            <p>Overweegt u een occasion bij ons te kopen? Dan is het slim om, als het voor u van toepassing is, alle financieringsmogelijkheden goed af te wegen. Wij werken daarvoor samen met een betrouwbare partner: de Ribank.</p>
            <p>Onze verkopers vertellen u er graag meer over. U kunt ook vooraf, vanuit uw eigen stoel, vrijblijvend informeren naar een lening. Dan kan die zelfs al geregeld zijn voordat u de showroom binnenloopt.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.ribank} rel="noopener" class="btn btn-rood">Lening bekijken bij de Ribank</a>
            <a href={site.telHref} class="btn btn-line">Bel een verkoper</a>
          </div>
          <p class="mt-4 text-xs text-white/70">[[AANLEVEREN: controleren of de Ribank-aanvraaglink nog klopt]]</p>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-md lg:col-span-5 lg:col-start-8">
          <Foto src={sleutel} alt="Een autosleutel wordt van hand tot hand overgegeven" sizes="(min-width: 1024px) 440px, 100vw" />
        </div>
      </div>
    </section>

    <!-- Offerte of inruil: korte uitleg links, formulier rechts. -->
    <section id="offerte" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="smal text-sm text-rood">Offerte of inruil</p>
          <h2 class="mt-3 text-3xl">Uw auto inruilen of een offerte vragen</h2>
          <p class="mt-5 text-ink-soft">Interesse in een auto uit de voorraad, of wilt u weten wat uw huidige auto nog doet? Vul het formulier in, of bel ons op <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a>.</p>
        </div>
        <form class="grid gap-5 rounded-md bg-white p-5 shadow-[0_1px_2px_#1d212624] ring-1 ring-line sm:grid-cols-2 md:p-8 lg:col-span-7 lg:col-start-6" onsubmit="return false">
          <div><label for="naam" class="text-sm font-semibold">Naam</label><input id="naam" name="naam" autocomplete="name" class="veld mt-1" /></div>
          <div><label for="telefoon" class="text-sm font-semibold">Telefoon</label><input id="telefoon" name="telefoon" type="tel" autocomplete="tel" class="veld mt-1" /></div>
          <div><label for="email" class="text-sm font-semibold">E-mail</label><input id="email" name="email" type="email" autocomplete="email" class="veld mt-1" /></div>
          <div><label for="kenteken" class="text-sm font-semibold">Kenteken inruilauto</label><input id="kenteken" name="kenteken" autocapitalize="characters" class="veld mt-1 uppercase" /></div>
          <div class="sm:col-span-2"><label for="interesse" class="text-sm font-semibold">Interesse in</label><input id="interesse" name="interesse" class="veld mt-1" placeholder="Merk en model" /></div>
          <div class="sm:col-span-2"><label for="bericht" class="text-sm font-semibold">Bericht</label><textarea id="bericht" name="bericht" rows="4" class="veld mt-1"></textarea></div>
          <div class="sm:col-span-2">
            {site.voorstel ? (
              <p class="rounded-md bg-beton p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all underline">{site.mail}</a>.</p>
            ) : (
              <button type="submit" class="btn btn-rood">Verstuur aanvraag</button>
            )}
          </div>
        </form>
      </div>
    </section>

    <!-- Over ons: tijdlijn sinds 1965 naast de showroomfoto. -->
    <section id="over-ons" class="scroll-mt-20 bg-beton py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="smal text-sm text-rood">Over ons</p>
          <h2 class="mt-3 text-3xl">Familiebedrijf in Spijkenisse, sinds 1965</h2>
          <div class="mt-8 aspect-[4/3] overflow-hidden rounded-md">
            <Foto src={showroom} alt="Showroom met een oude Toyota en een witte auto" sizes="(min-width: 1024px) 440px, 100vw" />
          </div>
        </div>
        <ol class="lg:col-span-6 lg:col-start-7">
          {tijdlijn.map((t) => (
            <li class="relative grid gap-1 border-l-2 border-asfalt pb-9 pl-6 last:pb-0 sm:grid-cols-[9.5rem_1fr] sm:gap-6">
              <span class="absolute top-1.5 -left-[7px] size-3 rounded-full bg-rood" aria-hidden="true"></span>
              <p class="font-display text-2xl leading-none font-extrabold text-rood uppercase [font-stretch:62%]">{t.jaar}</p>
              <div>
                <h3 class="text-xl">{t.titel}</h3>
                <p class="mt-2 text-ink-soft">{t.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Vacature: klein geel blok. -->
    <section id="vacature" class="scroll-mt-20 py-12">
      <div class="wrap">
        <div class="grid gap-6 rounded-md bg-geel p-6 text-asfalt md:grid-cols-12 md:items-center md:p-8">
          <div class="md:col-span-8">
            <p class="smal text-xs">Vacature</p>
            <h2 class="mt-2 text-2xl">Wij zoeken een zelfstandig werkend automonteur</h2>
            <p class="mt-3">Interesse? Neem contact met ons op.</p>
            <p class="mt-2 text-xs text-ink-soft">[[AANLEVEREN: uren, eisen en wat de functie inhoudt]]</p>
          </div>
          <div class="flex flex-wrap gap-3 md:col-span-4 md:justify-end">
            <a href={`mailto:${site.mail}?subject=Vacature%20automonteur`} class="btn bg-asfalt text-white hover:bg-asfalt-2">Mail ons</a>
            <a href={site.telHref} class="btn btn-line">Bellen</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Route en openingstijden: genummerde stappen naast een tijdenkaart. -->
    <section id="route" class="scroll-mt-20 pt-4 pb-16 lg:pb-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="smal text-sm text-rood">Routebeschrijving</p>
          <h2 class="mt-3 text-3xl">Via de A15, afslag 16</h2>
          <ol class="mt-10 space-y-5">
            {route.map((stap, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] items-baseline gap-3">
                <span class="font-display text-2xl leading-none font-extrabold text-rood tabular-nums [font-stretch:62%]">{String(i + 1).padStart(2, '0')}</span>
                <span>{stap}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <div class="rounded-md bg-asfalt p-6 text-white md:p-8">
            <h3 class="text-2xl">Openingstijden</h3>
            <dl class="mt-6 space-y-3">
              {tijden.map((t) => (
                <div class="grid gap-0.5 border-b border-white/15 pb-3">
                  <dt class="text-white/80">{t.dag}</dt>
                  <dd class="font-semibold whitespace-nowrap tabular-nums">{t.tijd}</dd>
                </div>
              ))}
            </dl>
            <address class="mt-6 not-italic text-white/90">{site.straat}<br />{site.postcode} {site.plaats}</address>
            <div class="op-donker"><a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact: groot telefoonnummer, rest ernaast. -->
    <section id="contact" class="op-donker scroll-mt-20 bg-asfalt-2 py-16 text-white lg:py-20">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h2 class="text-3xl">Langskomen of bellen</h2>
          <a href={site.telHref} class="mt-6 inline-block font-display text-4xl leading-none font-extrabold whitespace-nowrap text-geel tabular-nums no-underline [font-stretch:60%] hover:underline">{site.tel}</a>
        </div>
        <dl class="grid gap-4 lg:col-span-5">
          <div><dt class="text-sm text-white/70">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-geel decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-white/70">Adres</dt><dd>{site.straat}, {site.postcode} {site.plaats}</dd></div>
          <div><dt class="text-sm text-white/70">Google</dt><dd><span class="tabular-nums">{site.google.score}</span> uit 5, op basis van {site.google.reviews} reviews</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
