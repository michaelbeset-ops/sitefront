---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const home = url('');
---
{deel === 'kop' ? (
  <header class="op-donker sticky top-0 z-40 bg-asfalt text-white">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={home} class="flex min-w-0 items-baseline gap-2 no-underline">
        <span class="font-display text-xl leading-none font-extrabold whitespace-nowrap uppercase [font-stretch:62%] sm:text-2xl">Harry Meijndert</span>
        <span class="smal hidden text-xs text-geel sm:inline">Autobedrijf</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="smal flex gap-6 text-sm">
          <li><a href={`${home}#voorraad`} class="no-underline transition-colors hover:text-geel">Voorraad</a></li>
          <li><a href={`${home}#onderdelen`} class="no-underline transition-colors hover:text-geel">Onderdelen</a></li>
          <li><a href={`${home}#financiering`} class="no-underline transition-colors hover:text-geel">Financiering</a></li>
          <li><a href={`${home}#over-ons`} class="no-underline transition-colors hover:text-geel">Over ons</a></li>
          <li><a href={`${home}#route`} class="no-underline transition-colors hover:text-geel">Route</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-rood shrink-0 !px-4 !py-2 text-sm"><span class="hidden sm:inline">Bel</span> <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
    </div>
  </header>
) : (
  <footer class="op-donker bg-asfalt text-white/80">
    <div class="streep h-2" aria-hidden="true"></div>
    <div class="wrap grid gap-8 py-12 text-sm md:grid-cols-12">
      <p class="md:col-span-5">
        <strong class="font-display text-xl font-extrabold uppercase text-white [font-stretch:62%]">{site.naam}</strong><br />
        {site.straat}, {site.postcode} {site.plaats}<br />
        KvK Rotterdam {site.kvk}
      </p>
      <p class="md:col-span-4">
        <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br />
        <a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a><br />
        <a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a>
      </p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap pb-10 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
