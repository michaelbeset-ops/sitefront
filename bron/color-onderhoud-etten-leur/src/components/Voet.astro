---
import { site, url, waOfferte } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const diensten = ['Binnenschilderwerk', 'Buitenschilderwerk', 'Wandafwerking en stucwerk', 'Timmerwerk', 'Vloercoating', 'Kleuradvies'];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="woordmerk text-licht no-underline">Color <span>Onderhoud</span></a>
      <p class="mt-5 max-w-xs">Schildersbedrijf uit Etten-Leur. Binnen- en buitenschilderwerk, wandafwerking, timmerwerk en vloercoating.</p>
      <p class="mt-5 text-sm">Grotere verbouwing? Zusterbedrijf <a href={site.zuster} class="link text-licht">VRO Totaalbouw</a>.</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {diensten.map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-hemel">{c}</a></li>)}
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-hemel">{site.tel}</a></li>
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-hemel">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="[overflow-wrap:anywhere] no-underline transition-colors hover:text-hemel">{site.mail}</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-2">
      <p class="font-semibold text-licht">Adres</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <a href={site.maps} class="mt-4 inline-flex items-center gap-2 no-underline transition-colors hover:text-hemel"><Icoon naam="pin" class="h-4 w-4" />Route plannen</a>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.voluit} · KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-hemel">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Projectfoto’s van uw eigen website en sfeerfoto’s via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 4 oktober 2026).</p>}
  </div>
</footer>

<style>
  .woordmerk { font-family: var(--font-kop); font-weight: 700; font-size: 1.75rem; letter-spacing: -0.01em; line-height: 1; }
  .woordmerk span { color: var(--color-hemel); }
</style>
