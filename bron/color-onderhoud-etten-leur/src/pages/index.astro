---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, chips, reviews, labels, waOfferte } from '../data/site';
import hero from '../assets/hero.jpg';
import woonkamer from '../assets/woonkamer.jpg';
import zolder from '../assets/zolder.jpg';
import klossen from '../assets/klossen.jpg';
import villa from '../assets/villa.jpg';
import gevel from '../assets/gevel.jpg';
import tuinhuis from '../assets/tuinhuis.jpg';
import schuurdeur from '../assets/schuurdeur.jpg';
import topgevel from '../assets/topgevel.jpg';
import slaapkamer from '../assets/slaapkamer.jpg';
import keuken from '../assets/keuken.jpg';
import raam from '../assets/raam.jpg';
import vloercoating from '../assets/s-vloercoating.jpg';

// Diensten: teksten samengevat van hun eigen site (index, wan, tim, vlo).
const diensten = [
  { id: 'schilderwerk', t: 'Schilderwerk', sub: 'Binnen en buiten', d: 'Wanden, plafonds, kozijnen en deuren, maar ook tuinhuizen en veranda’s. Met advies over de verf die het best bij uw woning past.', src: villa, alt: 'Een vrijstaande woning met crèmewit geschilderde gevel en zwarte kozijnen', pos: '50% 60%', groot: true },
  { id: 'wandafwerking', t: 'Wandafwerking', sub: 'Stucwerk, sierpleister, behang', d: 'Schilder-, spuit- en sauswerk, glad of gestructureerd stucwerk, sierpleister, behang en glasweefselbehang.', src: zolder, alt: 'Een zolderkamer met strak geschilderde taupe wanden en een wit dakraam', pos: '50% 50%' },
  { id: 'timmerwerk', t: 'Timmerwerk', sub: 'Schilder én timmerman', d: 'Deuren afhangen, boeiborden, windveren en gevelbeplating vervangen. Zonder een tweede bedrijf erbij.', src: klossen, alt: 'Gevel van gele baksteen met wit geschilderde houten klossen onder een donkere dakgoot', pos: '50% 40%' },
  { id: 'vloercoating', t: 'Vloercoating', sub: 'Garage, keuken, werkruimte', d: 'Mat of glans, transparant of in kleur, met spikkels of extra antislip. Bestand tegen vocht en chemicaliën.', src: vloercoating, alt: 'Sfeerfoto: vakmensen brengen een lichte coating aan op een grote betonvloer', pos: '50% 60%', stock: true },
];

const projecten = [
  { src: woonkamer, alt: 'Ruime woonkamer met witte wanden, plafondspots en een donkergrijze tegelvloer', label: 'Binnen', groot: true },
  { src: topgevel, alt: 'Topgevel met donkergroen gelakte houten delen en een wit raamkozijn', label: 'Buiten' },
  { src: slaapkamer, alt: 'Kinderkamer met één wand in diep paars en één in helder rood', label: 'Binnen' },
  { src: schuurdeur, alt: 'Schuur met donkergroene deuren en houten topgevel boven gele baksteen', label: 'Buiten' },
  { src: gevel, alt: 'Woonhuis met lichte gevelbeplating, steigers ernaast tijdens het schilderwerk', label: 'Buiten' },
  { src: keuken, alt: 'Lichte open keuken met een wit kookeiland en witte wanden', label: 'Binnen', breed: true },
  { src: tuinhuis, alt: 'Tuinhuis met glanzend gelakte houten gevelbeplating in warm bruin', label: 'Buiten', breed: true },
];

// Werkwijze: volgt hun eigen tekst (offerte, kleurstalen, ondergrond eerst, Sigma en Sikkens, geen voorschot).
const stappen = [
  ['Offerte', 'U vertelt wat er moet gebeuren. U krijgt een gratis en vrijblijvende offerte.'],
  ['Kleuradvies', 'Advies over verf en kleur. De kleur kiest u zelf aan de hand van kleurstalen.'],
  ['Ondergrond', 'Hout kaal geschuurd, hersteld of vervangen. Pas als de ondergrond gezond en glad is, gaan we verder.'],
  ['Afwerking', 'Strak afgewerkt met topmerken als Sigma en Sikkens, voor schilderwerk dat jaren meegaat.'],
  ['Tevreden? Dan betalen', 'Geen voorschot en geen voorschotfactuur. U betaalt pas als u tevreden bent.'],
];

const klussen = ['Binnenschilderwerk', 'Buitenschilderwerk', 'Stucwerk of sierpleister', 'Behang', 'Timmerwerk', 'Vloercoating', 'Kleuradvies'];
---
<Base title={`${site.naam} | Schildersbedrijf in Etten-Leur`} description="Schildersbedrijf Coloronderhoud in Etten-Leur: binnen- en buitenschilderwerk, wandafwerking, timmerwerk en vloercoating. Geen voorschot, gratis offerte. 4,8 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: tekst op inktblauw, eigen projectfoto rechts op volle hoogte -->
    <section class="donker relative isolate overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <div class="lg:grid lg:min-h-[calc(100svh-7.25rem)] lg:grid-cols-12">
        <div class="relative h-[44svh] min-h-[17rem] lg:order-2 lg:col-span-5 lg:h-auto">
          <Image src={hero} alt="Gang met wit geschilderde lambrisering en radiatorombouw, een geblokte tegelvloer en een bronzen beeld" widths={[640, 926]} sizes="(min-width: 1024px) 42vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[30%_62%]" />
          <div class="absolute inset-0 bg-[linear-gradient(180deg,#0e1b2900_55%,#0e1b29_100%)] lg:bg-[linear-gradient(90deg,#0e1b29_0%,#0e1b2900_22%)]" aria-hidden="true"></div>
          <p class="absolute right-4 top-4 hidden rounded-sm bg-nacht/80 px-3 py-1.5 text-xs font-medium text-licht backdrop-blur lg:block">Eigen project: lambrisering en ombouw, binnen</p>
        </div>
        <div class="wrap relative flex flex-col justify-center pb-14 pt-4 lg:order-1 lg:col-span-7 lg:max-w-none lg:py-16 lg:pl-[max(2.5rem,calc((100vw-78rem)/2+2.5rem))] lg:pr-12">
          <p class="eyebrow">Schildersbedrijf in Etten-Leur</p>
          <h1 id="t-hero" class="mt-6 text-hero">Strak schilderwerk dat <span class="text-hemel">jaren meegaat.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.25rem] md:leading-relaxed">Binnen en buiten schilderen, wanden afwerken, timmerwerk en vloercoating. Eén vakbedrijf voor de hele klus.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="knop knop-blauw">Gratis offerte aanvragen<Icoon naam="pijl" /></a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-10 flex max-w-2xl flex-wrap gap-x-8 gap-y-3 border-t border-lijn-licht pt-7 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</span></li>
            <li class="flex items-center gap-2"><Icoon naam="euro" class="h-5 w-5 text-hemel" />Geen voorschot</li>
            <li><a href={site.telHref} class="num flex items-center gap-2 font-semibold text-licht no-underline hover:text-hemel"><Icoon naam="tel" class="h-5 w-5 text-hemel" />{site.tel}</a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Werkzaamheden in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-2.5 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-sm border border-lijn px-3.5 py-1.5 text-sm font-medium no-underline transition-colors hover:border-blauw hover:bg-blauw hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-28" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-dienst" class="mt-5 text-3xl">Van de eerste kwast tot de laatste plint.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Vier vakgebieden onder één dak. Moet er tijdens het schilderen iets hersteld worden, dan doen we dat zelf.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-12 lg:gap-6">
          {diensten.map((b, i) => (
            <li class={`rijs ${b.groot ? 'md:col-span-2 lg:col-span-7 lg:row-span-2' : i === 3 ? 'md:col-span-2 lg:col-span-12' : 'lg:col-span-5'}`} style={`--d:${(i % 3) * 0.06}s`}>
              <a href={`#offerte`} data-klus={b.t} class={`kaart group flex h-full overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md ${b.groot ? 'flex-col' : i === 3 ? 'flex-col sm:flex-row' : 'flex-col sm:flex-row lg:flex-row'}`}>
                <div class={`relative overflow-hidden ${b.groot ? 'aspect-[16/10] lg:aspect-auto lg:flex-1' : i === 3 ? 'aspect-[16/9] sm:aspect-auto sm:w-1/2 lg:w-[58%]' : 'aspect-[16/10] sm:aspect-auto sm:w-[44%]'}`}>
                  <Image src={b.src} alt={b.alt} widths={[400, 700, 960]} sizes={b.groot ? '(min-width: 1248px) 680px, (min-width: 768px) 92vw, 100vw' : '(min-width: 1024px) 40vw, 92vw'} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:absolute sm:inset-0" style={`object-position:${b.pos}`} />
                  {b.stock && <span class="absolute bottom-2 left-2 rounded-sm bg-nacht/70 px-2 py-0.5 text-[.6875rem] text-licht">Sfeerfoto</span>}
                </div>
                <div class={`flex flex-col justify-between gap-5 p-6 ${b.groot ? 'lg:p-8' : 'flex-1 lg:p-7'}`}>
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[.14em] text-blauw">{b.sub}</p>
                    <h3 class={`mt-2 ${b.groot ? 'text-[1.875rem]' : 'text-[1.5rem]'}`}>{b.t}</h3>
                    <p class="mt-3 text-grijs">{b.d}</p>
                  </div>
                  <span class="inline-flex items-center gap-2 text-sm font-semibold text-blauw">Offerte voor {b.t.toLowerCase()}<Icoon naam="pijl" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Voordelen in cijfers, zoals ze op hun eigen site staan -->
    <section class="border-y border-lijn bg-wit" aria-label="Uw voordelen">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Score op Google</dt><dd class="cijfer num order-first text-blauw">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Voorschot: u betaalt als u tevreden bent</dt><dd class="cijfer num order-first">€ 0</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Vakgebieden onder één dak</dt><dd class="cijfer num order-first">4</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Topmerken: Sigma en Sikkens</dt><dd class="cijfer num order-first">2</dd></div>
      </dl>
    </section>

    <!-- 5. Projecten -->
    <section id="projecten" class="donker bg-nacht py-20 text-licht lg:py-28" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-5 text-3xl">U herkent meteen ons vakmanschap.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Een greep uit eerder werk, binnen en buiten. Van een kinderkamer in twee kleuren tot een tuinhuis in de lak.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:gap-4 lg:mt-14 lg:grid-flow-dense lg:grid-cols-4 lg:grid-rows-[repeat(3,minmax(0,13.5rem))]">
          {projecten.map((p, i) => (
            <li class={`rijs group relative overflow-hidden rounded-md bg-nacht-2 ${p.groot ? 'col-span-2 aspect-[4/3] lg:row-span-2 lg:aspect-auto' : p.breed ? 'col-span-2 aspect-[2/1] lg:aspect-auto' : 'aspect-square lg:aspect-auto'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={p.src} alt={p.alt} widths={p.groot || p.breed ? [600, 1000] : [320, 600]} sizes={p.groot || p.breed ? '(min-width: 1024px) 600px, 92vw' : '(min-width: 1024px) 300px, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
              <span class="absolute bottom-3 left-3 rounded-sm bg-nacht/75 px-2.5 py-1 text-xs font-semibold uppercase tracking-[.12em] text-licht backdrop-blur">{p.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-28" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Eerst de ondergrond, dan pas de verf.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Elke materiaalsoort vraagt een eigen voorbehandeling. Daar begint mooi en duurzaam schilderwerk.</p>
        </div>
        <ol class="relative mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5 lg:gap-6">
          <li class="pointer-events-none absolute left-0 right-0 top-[1.4rem] hidden h-px bg-lijn lg:block" aria-hidden="true"></li>
          {stappen.map(([t, d], i) => (
            <li class="rijs relative" style={`--d:${i * 0.06}s`}>
              <p class={`num relative grid h-11 w-11 place-items-center rounded-sm font-kop text-lg font-bold ${i === 4 ? 'bg-blauw text-wit' : 'bg-wit text-blauw shadow-sm ring-1 ring-lijn'}`}>0{i + 1}</p>
              <h3 class="mt-6 text-xl">{t}</h3>
              <p class="mt-2 text-[.9875rem] text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="bg-steen" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[30rem] lg:col-span-5">
          <Image src={raam} alt="Smalle gevel met nieuw gelakte lichte beplating en zwarte kozijnen, de steiger nog ernaast" widths={[640, 960, 1300]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_45%]" />
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Coloronderhoud</p>
          <h2 id="t-over" class="mt-5 text-3xl">Schilder en timmerman in één bedrijf.</h2>
          <p class="mt-6 text-lg text-grijs">Vaak ontdekt een schilder tijdens het werk dat er eerst iets gerepareerd of vervangen moet worden. Bij Coloronderhoud hoeft u daarvoor geen ander bedrijf te laten komen: we beheersen beide ambachten. Dat scheelt in uw kosten. Vanuit Etten-Leur werken we ook in Breda en Roosendaal.</p>
          <ul class="mt-9 grid gap-3 sm:grid-cols-3">
            <li class="kaart p-5">
              <span class="grid h-10 w-10 place-items-center rounded-sm bg-blauw text-wit"><Icoon naam="klok" class="h-5 w-5" /></span>
              <h3 class="mt-4 text-lg">Afspraak is afspraak</h3>
              <p class="mt-1.5 text-[.9375rem] text-grijs">Stiptheid krijgt een vinkje van klanten op Google.</p>
            </li>
            <li class="kaart p-5">
              <span class="grid h-10 w-10 place-items-center rounded-sm bg-blauw text-wit"><Icoon naam="kwast" class="h-5 w-5" /></span>
              <h3 class="mt-4 text-lg">Netjes gewerkt</h3>
              <p class="mt-1.5 text-[.9375rem] text-grijs">Vriendelijk en schoon, ook bij u binnen.</p>
            </li>
            <li class="kaart p-5">
              <span class="grid h-10 w-10 place-items-center rounded-sm bg-blauw text-wit"><Icoon naam="stalen" class="h-5 w-5" /></span>
              <h3 class="mt-4 text-lg">Kleur op maat</h3>
              <p class="mt-1.5 text-[.9375rem] text-grijs">Advies over verf en kleur, met kleurstalen.</p>
            </li>
          </ul>
          <p class="mt-8 text-[.9375rem] text-grijs">Een aanbouw, badkamer of complete renovatie? Daarvoor is er ons zusterbedrijf <a href={site.zuster} class="link font-semibold text-inkt">VRO Totaalbouw</a>.</p>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-20 lg:py-28" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-bold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <div class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-3">
          {reviews.map((r, i) => (
            <figure class="rijs kaart flex flex-col p-7 md:p-8" style={`--d:${i * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 font-kop text-[1.4rem] font-semibold leading-snug tracking-[-0.01em]">“{r.tekst}”</blockquote>
              <figcaption class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-sm bg-steen font-kop font-bold text-blauw" aria-hidden="true">{r.naam.replace('Familie ', '')[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review{r.dienst && `, ${r.dienst.toLowerCase()}`}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </figcaption>
            </figure>
          ))}
          <div class="rijs donker flex flex-col rounded-md bg-nacht p-7 text-licht md:p-8" style="--d:.12s">
            <p class="text-sm font-semibold uppercase tracking-[.14em] text-hemel">Positief beoordeeld op</p>
            <ul class="mt-5 flex-1 space-y-2.5">
              {labels.map((l) => <li class="flex items-center gap-3 font-kop text-xl font-semibold"><Icoon naam="vink" class="h-5 w-5 text-hemel" />{l}</li>)}
            </ul>
            <p class="mt-6 border-t border-lijn-licht pt-5 text-sm text-licht-zacht">Labels die klanten zelf aanvinkten bij hun review op Google.</p>
          </div>
        </div>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Bekijk alle reviews op Google</a></p>
      </div>
    </section>

    <!-- 9. Offerte: klusplanner die een WhatsApp-bericht klaarzet -->
    <section id="offerte" class="bg-steen py-20 lg:py-28" aria-labelledby="t-offerte">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-offerte" class="mt-5 text-3xl">Vertel wat er moet gebeuren.</h2>
          <p class="mt-6 text-lg text-grijs">Kies de klus en vul in wat u weet. Wij zetten het klaar als WhatsApp-bericht; foto’s van de situatie stuurt u daarna gewoon mee. De offerte is gratis en vrijblijvend.</p>
          <ul class="mt-10 grid grid-cols-1 gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-3 p-4 no-underline sm:gap-4 sm:p-5 transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-blauw text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-blauw" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-3 p-4 no-underline sm:gap-4 sm:p-5 transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-steen text-blauw"><Icoon naam="tel" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">Bellen</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-blauw" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-3 p-4 no-underline sm:gap-4 sm:p-5 transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-steen text-blauw"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 text-blauw" /></a></li>
          </ul>
          <p class="mt-8 flex items-start gap-3 text-grijs"><Icoon naam="pin" class="mt-0.5 h-5 w-5 shrink-0 text-blauw" /><span>{site.straat}, {site.postcode} {site.plaats}. <a href={site.maps} class="link text-inkt">Route plannen</a></span></p>
        </div>
        <form class="kaart min-w-0 p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw aanvraag</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat moet er gebeuren? <span class="font-normal text-grijs">(meerdere mogelijk)</span></legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {klussen.map((b) => (
                <label class="keuze"><input type="checkbox" name="klus" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Soort pand</span>
              <select name="pand" class="veld mt-2">
                <option value="">Kies</option>
                <option>Woning</option>
                <option>Appartement</option>
                <option>Bedrijfspand</option>
                <option>Tuinhuis of schuur</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Wanneer?</span>
              <select name="wanneer" class="veld mt-2">
                <option value="">Nog niet bekend</option>
                <option>Zo snel mogelijk</option>
                <option>Binnen drie maanden</option>
                <option>Later dit jaar</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Postcode of plaats</span><input name="plaats" autocomplete="postal-code" class="veld mt-2" placeholder="Bijvoorbeeld 4871 Etten-Leur" /></label>
            <label class="block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: kozijnen en boeiborden voorzijde, hout op twee plekken zacht"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-blauw"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Gratis en vrijblijvend.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-blauw text-wit" aria-label="Offerte aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Toe aan een fris kleurtje?</h2>
          <p class="mt-2 text-lg text-wit/90">Vraag een gratis offerte aan. U betaalt pas als u tevreden bent.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp ons</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Dienstkaart aanklikken = die klus alvast aanvinken in het formulier.
  document.querySelectorAll<HTMLAnchorElement>('[data-klus]').forEach((a) => a.addEventListener('click', () => {
    const t = (a.dataset.klus || '').toLowerCase();
    document.querySelectorAll<HTMLInputElement>('input[name="klus"]').forEach((i) => {
      const v = i.value.toLowerCase();
      if ((t === 'schilderwerk' && v.includes('schilderwerk')) || (t === 'wandafwerking' && v.startsWith('stucwerk')) || v === t) i.checked = true;
    });
  }));

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const k = d.getAll('klus').map(String);
      const r = ['Goedendag, ik wil graag een vrijblijvende offerte aanvragen.'];
      if (k.length) r.push('Klus: ' + k.join(', '));
      if (v('pand')) r.push('Pand: ' + v('pand'));
      if (v('plaats')) r.push('Locatie: ' + v('plaats'));
      if (v('wanneer')) r.push('Planning: ' + v('wanneer').toLowerCase());
      if (v('wens')) r.push('Toelichting: ' + v('wens'));
      if (v('naam')) r.push('Met vriendelijke groet, ' + v('naam'));
      window.open('https://wa.me/31638406752?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: 1; letter-spacing: -0.025em; }
  .cijfer { font-family: var(--font-kop); font-size: clamp(2.75rem, 3vw + 1.5rem, 3.75rem); font-weight: 700; line-height: 1; letter-spacing: -0.03em; padding-bottom: .35rem; }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: .25rem; background: var(--color-steen); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #ddd7ca; }
  .keuze input:checked + span { background: var(--color-blauw); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-blauw); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: .25rem; border: 1.5px solid #121a2433; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #121a2466; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-blauw); }
  .veld::placeholder { color: #7a8390; }
</style>
