---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, diensten } from '../data/site';
import hero from '../assets/hero.jpg';
import onderhoud from '../assets/onderhoud.jpg';
import spuiten from '../assets/spuiten.jpg';
import oldtimer from '../assets/oldtimer.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
---
<Base
  title="Autobedrijf Heemskerk | Onderhoud, APK en schadeherstel in Alphen aan den Rijn"
  description="Full-service autobedrijf in Alphen aan den Rijn, sinds 1969. Onderhoud, reparatie, APK, schadeherstel en inbouw van elektronica. Christiaan Huijgensweg 9, Industrieterrein Molenwetering."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: foto rechts, tekst links op diep marine. Mobiel: egale overlay over de foto. -->
    <section class="donker relative overflow-hidden bg-night text-white">
      <div class="absolute inset-0 lg:left-[38%]"><Foto src={hero} alt="Monteur met pet en bril buigt zich over een oranjerode auto in een werkplaats" hero sizes="(min-width: 1024px) 62vw, 100vw" class="object-[70%_center]" /></div>
      <div class="absolute inset-0 bg-night/75 lg:bg-transparent lg:bg-gradient-to-r lg:from-night lg:from-40% lg:via-night/70 lg:via-55% lg:to-transparent lg:to-80%"></div>
      <div class="wrap relative py-14 sm:py-20 lg:py-28">
        <div class="max-w-xl">
          <p class="kicker text-lime">Alphen aan den Rijn, sinds 1969</p>
          <h1 class="mt-4 text-4xl">Onderhoud, APK en schadeherstel onder één dak</h1>
          <p class="mt-6 text-lg text-white/85">Autobedrijf Heemskerk is door de jaren heen uitgegroeid tot een full-service autobedrijf. Sinds 1987 aan de Christiaan Huijgensweg 9, op {site.terrein}.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-lime"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <p class="mt-8 flex flex-wrap gap-x-5 gap-y-1 text-sm text-white/80">
            <span><strong class="text-white">{site.google}</strong> op Google ({site.reviews} reviews)</span>
            <span>Ma t/m vr <span class="whitespace-nowrap tabular-nums">8.30 - 18.00</span></span>
            <span>Za <span class="whitespace-nowrap tabular-nums">10.00 - 14.00</span></span>
          </p>
        </div>
      </div>
    </section>

    <!-- Diensten: kop links, genummerde lijst rechts, geen kaartjes. -->
    <section id="diensten" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Alles voor uw auto, op één adres</h2>
          <p class="mt-5 text-ink-soft">Van de kleine beurt tot een nieuwe kleur lak. En heeft u onderdelen of accessoires nodig, dan leveren we die ook.</p>
        </div>
        <ol class="border-t border-line lg:col-span-7 lg:col-start-6">
          {diensten.map((d, i) => (
            <li class="grid gap-1 border-b border-line py-6 sm:grid-cols-[3rem_13rem_1fr] sm:gap-6">
              <span class="font-display text-sm font-bold tabular-nums text-ink-soft">0{i + 1}</span>
              <h3 class="text-xl">{d.naam}</h3>
              <p class="text-ink-soft">{d.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Onderhoud: foto naast een vergelijking kleine en grote beurt. -->
    <section id="onderhoud" class="scroll-mt-20 bg-mist py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <div class="aspect-[4/3] overflow-hidden rounded-xl lg:sticky lg:top-24 lg:aspect-[4/5]"><Foto src={onderhoud} alt="Slagmoersleutel met een dop van 22 op een wielmoer van een lichtmetalen velg" sizes="(min-width: 1024px) 440px, 100vw" /></div>
        </div>
        <div class="lg:col-span-7">
          <p class="kicker text-ink-soft">Onderhoud</p>
          <h2 class="mt-3 text-3xl">Kleine beurt of grote beurt</h2>
          <p class="mt-5 text-lg">De juiste vakkennis, redelijke werkplaatstarieven en kwalitatief hoogwaardige onderdelen. Vervangen onderdelen en restmaterialen voeren we verantwoord af.</p>

          <div class="mt-10 grid gap-6 md:grid-cols-2">
            <div class="rounded-xl bg-paper p-6 shadow-[0_1px_2px_#111c2e1f]">
              <h3 class="text-xl">Kleine beurt</h3>
              <p class="mt-3 text-ink-soft">Alle vitale functies nauwkeurig onderzocht: banden, uitlaat, accu, schokdempers en remmen.</p>
              <ul class="mt-4 space-y-1.5 text-sm">
                <li class="border-l-2 border-marine pl-3">Lampen bijgesteld</li>
                <li class="border-l-2 border-marine pl-3">Vloeistoffen bijgevuld</li>
                <li class="border-l-2 border-marine pl-3">Olie ververst en oliefilter vervangen</li>
              </ul>
            </div>
            <div class="rounded-xl bg-marine p-6 text-white shadow-[0_1px_2px_#111c2e1f] donker">
              <h3 class="text-xl">Grote beurt</h3>
              <p class="mt-3 text-white/85">De hele auto nagekeken: olie- en luchtfilters, remblokken, dynamo, schokbrekers, uitlaat, werking van de airconditioning, enzovoort.</p>
              <p class="mt-4 inline-block rounded-lg bg-lime px-3 py-1.5 text-sm font-bold text-night">Inclusief APK-keuring</p>
            </div>
          </div>

          <div class="mt-10 grid gap-6 border-t border-line pt-8 sm:grid-cols-2">
            <p>Bij grote gebreken nemen we altijd contact met u op en overleggen we de kosten.</p>
            <p class="text-ink-soft">Elke auto is anders, dus elke beurt heeft een eigen tarief. Vraag gerust naar een prijsindicatie als u bij ons bent.</p>
          </div>
          <p class="mt-6 text-sm text-ink-soft">Ook: uitlezen van uw auto, nieuwe (winter)banden plaatsen en bijvoorbeeld trekhaken monteren.</p>
        </div>
      </div>
    </section>

    <!-- Schadeherstel: donker vlak met twee foto's en het aanbod als strakke lijst. -->
    <section id="schade" class="donker scroll-mt-20 bg-night py-16 text-white lg:py-24">
      <div class="wrap">
        <div class="grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <p class="kicker text-lime">Schadeherstel</p>
            <h2 class="mt-3 text-3xl">Schade? Uitdeuken, spuiten, richten</h2>
            <p class="mt-6 text-lg text-white/85">Voor schade werken we samen met Auto Herstel Service Wilco, op hetzelfde adres. Bij een autoschade komt meer kijken dan u soms beseft. Wilco Nieuwenhuizen helpt u om alles tot een goed einde te brengen.</p>
            <p class="mt-4 text-white/85">We onderhouden de nodige contacten met instanties, schade-experts en verzekeringsmaatschappijen, en herstellen schade voor particulieren en voor bijna alle verzekeringsmaatschappijen.</p>
            <p class="mt-8 rounded-xl border border-white/20 p-5">
              <span class="block text-sm text-white/75">Schade: Auto Herstel Service Wilco</span>
              <a href={site.wilcoTelHref} class="font-display text-2xl font-bold whitespace-nowrap tabular-nums underline decoration-lime decoration-2 underline-offset-4">{site.wilcoTel}</a>
            </p>
          </div>
          <div class="lg:col-span-5 lg:col-start-8">
            <div class="aspect-[3/2] overflow-hidden rounded-xl"><Foto src={spuiten} alt="Handen in zwarte handschoenen trekken beschermfolie van een blauw carrosseriedeel" sizes="(min-width: 1024px) 420px, 100vw" /></div>
            <ul class="mt-8 grid gap-x-6 text-lg sm:grid-cols-2">
              {['Uitdeuken', 'Spuiten', 'Richten', 'Velgreparatie', 'Kunststofreparatie'].map((a) => (
                <li class="flex items-center gap-3 border-b border-white/15 py-3"><span class="h-2 w-2 flex-none rounded-full bg-lime" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{a}</span></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-16 grid items-center gap-10 border-t border-white/15 pt-16 lg:grid-cols-12">
          <div class="aspect-[5/4] overflow-hidden rounded-xl lg:col-span-5"><Foto src={oldtimer} alt="Koplamp en verchroomde grille van een glanzend roodbruine klassieke auto" sizes="(min-width: 1024px) 420px, 100vw" /></div>
          <div class="lg:col-span-6 lg:col-start-7">
            <h3 class="text-2xl">Lakschade, oldtimers en een nieuwe kleur</h3>
            <p class="mt-5 text-lg text-white/85">Ook lakschade door vandalisme, restauratiespuitwerk van bijvoorbeeld oldtimers of een compleet andere kleur voor uw auto, motor of bromfiets is geen probleem.</p>
            <p class="mt-4 text-white/75">Als u bij ons bent, kunt u er altijd vrijblijvend naar informeren.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Over ons: tijdlijn 1969, 1987, nu. -->
    <section id="over" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">U tevreden, wij tevreden</h2>
          <p class="mt-5 text-ink-soft">Klanttevredenheid staat bij ons hoog in het vaandel. We hebben plezier in ons werk zolang onze klanten plezier hebben met hun auto.</p>
          <p class="mt-6 text-sm"><strong class="font-display text-2xl">{site.google}</strong> <span class="text-ink-soft">op Google, {site.reviews} reviews</span></p>
        </div>
        <ol class="relative lg:col-span-7 lg:col-start-6">
          <li class="grid gap-2 border-l-2 border-marine pb-10 pl-6 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <p class="font-display text-jaar font-extrabold leading-none tracking-[-0.04em] tabular-nums">1969</p>
            <div class="sm:pt-2"><h3 class="text-xl">Het begin</h3><p class="mt-2 text-ink-soft">Autobedrijf Heemskerk bestaat sinds 1969.</p></div>
          </li>
          <li class="grid gap-2 border-l-2 border-marine pb-10 pl-6 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <p class="font-display text-jaar font-extrabold leading-none tracking-[-0.04em] tabular-nums">1987</p>
            <div class="sm:pt-2"><h3 class="text-xl">Christiaan Huijgensweg 9</h3><p class="mt-2 text-ink-soft">Sindsdien gevestigd op {site.terrein} in Alphen aan den Rijn.</p></div>
          </li>
          <li class="grid gap-2 border-l-2 border-marine pl-6 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <p class="font-display text-jaar font-extrabold leading-none tracking-[-0.04em] text-marine">Nu</p>
            <div class="sm:pt-2"><h3 class="text-xl">Full-service autobedrijf</h3><p class="mt-2 text-ink-soft">Onderhoud, reparatie, APK, schadeherstel, inbouw van elektronica en onderdelen via OTOPARTNER.</p></div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Contact: bellen en mailen voorop, tijden als tabel. -->
    <section id="contact" class="donker scroll-mt-20 bg-marine py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Langskomen of bellen</h2>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-lime"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <p class="mt-6 break-all text-white/85"><a href={`mailto:${site.mail}`} class="underline decoration-lime decoration-2 underline-offset-4">{site.mail}</a></p>
          <address class="mt-8 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-white/75">{site.terrein}</span></address>
          <a href={site.maps} rel="noopener" class="mt-4 inline-block font-semibold underline decoration-lime decoration-2 underline-offset-4">Route plannen</a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="text-xl">Openingstijden</h3>
          <dl class="mt-4 border-t border-white/20">
            {tijden.map((t) => (
              <div class="flex justify-between gap-4 border-b border-white/20 py-3"><dt>{t.dag}</dt><dd class="whitespace-nowrap tabular-nums font-semibold">{t.tijd}</dd></div>
            ))}
          </dl>
          <p class="mt-8 text-sm text-white/75">Schade: Auto Herstel Service Wilco, <a href={site.wilcoTelHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.wilcoTel}</a></p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
