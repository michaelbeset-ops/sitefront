---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, diensten } from '../data/site';
import pand from '../assets/pand.jpg';
import kantoor from '../assets/kantoor.jpg';
import afgeplakt1 from '../assets/dvc00017.jpg';
import afgeplakt2 from '../assets/dvc00018.jpg';
import banden from '../assets/bandenapparaat.jpg';
import uitlezen from '../assets/snaponsolus.jpg';
import koppeling from '../assets/koppelingnieuw.jpg';
import motor from '../assets/sample.jpg';
import oldtimer from '../assets/oldtimer.jpg';

// Keuzehulp: elke keuze wijst naar de beurt waar het volgens hun eigen site in zit.
const keuzes = [
  { id: 'apk', label: 'APK-keuring', beurt: 'groot' },
  { id: 'airco', label: 'Airco laten nakijken', beurt: 'groot' },
  { id: 'heel', label: 'De hele auto laten nakijken', beurt: 'groot' },
  { id: 'blokken', label: 'Remblokken of dynamo', beurt: 'groot' },
  { id: 'olie', label: 'Olie verversen', beurt: 'klein' },
  { id: 'vitaal', label: 'Banden, remmen en accu controleren', beurt: 'klein' },
  { id: 'lampen', label: 'Lampen en vloeistoffen', beurt: 'klein' },
];
const extra = [
  { id: 'uitlezen', label: 'Auto laten uitlezen' },
  { id: 'banden', label: '(Winter)banden plaatsen' },
  { id: 'trekhaak', label: 'Trekhaak plaatsen' },
];
const klein = [
  { t: 'Banden, uitlaat, accu, schokdempers en remmen nauwkeurig onderzocht', k: 'vitaal' },
  { t: 'Lampen bijgesteld', k: 'lampen' },
  { t: 'Vloeistoffen bijgevuld', k: 'lampen' },
  { t: 'Olie ververst en oliefilter vervangen', k: 'olie' },
];
const groot = [
  { t: 'Olie- en luchtfilters', k: 'olie heel' },
  { t: 'Remblokken', k: 'blokken vitaal heel' },
  { t: 'Dynamo', k: 'blokken heel' },
  { t: 'Schokbrekers en uitlaat', k: 'vitaal heel' },
  { t: 'Werking van de airconditioning', k: 'airco heel' },
];
const vink = `<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m2.5 6.2 2.3 2.3 4.7-5"/></svg>`;
const werkplaats = [
  { src: banden, alt: 'Een wiel met band op het bandenapparaat in onze werkplaats', bij: 'Bandenapparaat' },
  { src: uitlezen, alt: 'Het uitleesapparaat in zijn koffer', bij: 'Uitlezen' },
  { src: koppeling, alt: 'Een nieuwe koppelingsplaat', bij: 'Koppeling' },
  { src: motor, alt: 'Close-up van de motorruimte van een auto', bij: 'Motorruimte' },
];

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
---
<Base
  title="Autobedrijf Heemskerk | Onderhoud, APK en schadeherstel in Alphen aan den Rijn"
  description="Full-service autobedrijf in Alphen aan den Rijn, sinds 1969. Onderhoud, reparatie, APK, schadeherstel en inbouw van elektronica. Christiaan Huijgensweg 9, Industrieterrein Molenwetering."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: hun eigen pand. Mobiel bovenaan (herkenning), desktop als brede strook die de hero afsluit. -->
    <section class="donker flex flex-col bg-night text-white">
      <div class="wrap order-2 grid gap-10 py-10 sm:py-14 lg:order-1 lg:grid-cols-12 lg:pt-12 lg:pb-10">
        <div class="lg:col-span-8">
          <p class="kicker text-lime">Alphen aan den Rijn, sinds 1969</p>
          <h1 class="mt-4 text-4xl">Onderhoud, APK en schadeherstel onder één dak</h1>
          <p class="mt-6 max-w-2xl text-lg text-white/85">Door de jaren heen uitgegroeid tot een full-service autobedrijf. Sinds 1987 aan de Christiaan Huijgensweg 9, op {site.terrein}.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-lime"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href="#onderhoud" class="btn btn-line">Kleine of grote beurt?</a>
          </div>
        </div>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-4 self-end border-t border-white/20 pt-6 text-sm lg:col-span-4 lg:grid-cols-1 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
          <div><dt class="text-white/75">Google</dt><dd><strong class="font-display text-2xl">{site.google}</strong> <span class="text-white/80">({site.reviews} reviews)</span></dd></div>
          <div><dt class="text-white/75">Ma t/m vr</dt><dd class="font-display text-xl font-bold whitespace-nowrap tabular-nums">8.30 - 18.00</dd></div>
          <div><dt class="text-white/75">Zaterdag</dt><dd class="font-display text-xl font-bold whitespace-nowrap tabular-nums">10.00 - 14.00</dd></div>
        </dl>
      </div>
      <div class="order-1 lg:order-2 lg:bg-[linear-gradient(to_bottom,var(--color-night)_50%,var(--color-paper)_50%)]">
        <figure class="relative mx-auto max-w-[1000px] overflow-hidden lg:rounded-xl lg:shadow-[0_12px_40px_-12px_#0c1a3080]">
          <div class="aspect-[1000/387]"><Foto src={pand} alt="Ons pand aan de Christiaan Huijgensweg 9, met het logo van Autobedrijf Heemskerk op de gevel en auto's op het voorterrein" hero widths={[500, 1000]} sizes="(min-width: 1000px) 1000px, 100vw" /></div>
          <figcaption class="absolute bottom-2 left-2 rounded-lg bg-night/85 px-2.5 py-1 text-xs text-white sm:bottom-4 sm:left-4 sm:text-sm">Christiaan Huijgensweg 9</figcaption>
        </figure>
      </div>
    </section>

    <!-- Diensten: kop links, genummerde lijst rechts, geen kaartjes. -->
    <section id="diensten" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Alles voor uw auto, op één adres</h2>
          <p class="mt-5 text-ink-soft">Van de kleine beurt tot een nieuwe kleur lak. En heeft u onderdelen of accessoires nodig, dan leveren we die ook.</p>
        </div>
        <ol class="border-t border-line lg:col-span-7 lg:col-start-6">
          {diensten.map((d, i) => (
            <li class="grid gap-1 border-b border-line py-6 sm:grid-cols-[3rem_13rem_1fr] sm:gap-6">
              <span class="font-display text-sm font-bold tabular-nums text-ink-soft">0{i + 1}</span>
              <h3 class="text-xl">{d.naam}</h3>
              <p class="text-ink-soft">{d.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Onderhoud: keuzehulp kleine of grote beurt. Zonder JS: gewoon beide beurten naast elkaar. -->
    <section id="onderhoud" class="scroll-mt-20 bg-mist py-16 lg:py-24" data-keuzehulp>
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="kicker text-ink-soft">Onderhoud</p>
          <h2 class="mt-3 text-3xl">Kleine of grote beurt?</h2>
          <p class="mt-5 text-lg">De juiste vakkennis, redelijke werkplaatstarieven en kwalitatief hoogwaardige onderdelen. Vervangen onderdelen en restmaterialen voeren we verantwoord af.</p>
          <form class="mt-8" hidden data-keuzes>
            <fieldset>
              <legend class="font-display text-lg font-bold">Wat wilt u laten doen?</legend>
              <p class="mt-1 text-sm text-ink-soft">Tik aan wat van toepassing is. Meerdere keuzes kan.</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {keuzes.map((k) => (
                  <label class="optie"><input type="checkbox" class="sr-only" name="keuze" value={k.id} data-beurt={k.beurt} data-label={k.label} /><span class="vink"><Fragment set:html={vink} /></span>{k.label}</label>
                ))}
              </div>
            </fieldset>
            <fieldset class="mt-6">
              <legend class="font-display text-lg font-bold">En verder</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                {extra.map((k) => (
                  <label class="optie"><input type="checkbox" class="sr-only" name="extra" value={k.id} data-label={k.label} /><span class="vink"><Fragment set:html={vink} /></span>{k.label}</label>
                ))}
              </div>
            </fieldset>
          </form>
        </div>

        <div class="lg:col-span-7">
          <div hidden data-advies-blok class="donker rounded-xl bg-night p-5 text-white sm:p-6">
            <p class="kicker text-lime">Uw beurt</p>
            <p data-advies aria-live="polite" class="mt-2 font-display text-xl font-bold leading-snug">Tik aan wat u wilt laten doen. Dan ziet u hier welke beurt past.</p>
            <p data-extra aria-live="polite" class="mt-2 text-white/85"></p>
          </div>

          <div class="mt-6 grid gap-6 md:grid-cols-2">
            <div data-kaart="klein" class="rounded-xl bg-paper p-6 shadow-[0_1px_2px_#111c2e1f]">
              <p data-past hidden class="mb-3 inline-block rounded-md bg-marine px-2.5 py-1 text-xs font-bold text-white">Past bij uw keuze</p>
              <h3 class="text-xl">Kleine beurt</h3>
              <p class="mt-2 text-sm text-ink-soft">Alle vitale functies nauwkeurig onderzocht.</p>
              <ul class="mt-4 space-y-1.5 text-sm">
                {klein.map((r) => <li data-item={r.k} class="rounded-md border-l-2 border-marine py-1 pr-2 pl-3 transition-colors">{r.t}</li>)}
              </ul>
            </div>
            <div data-kaart="groot" class="donker rounded-xl bg-marine p-6 text-white shadow-[0_1px_2px_#111c2e1f]">
              <p data-past hidden class="mb-3 inline-block rounded-md bg-lime px-2.5 py-1 text-xs font-bold text-night">Past bij uw keuze</p>
              <h3 class="text-xl">Grote beurt</h3>
              <p class="mt-2 text-sm text-white/85">De hele auto nagekeken, onder andere:</p>
              <ul class="mt-4 space-y-1.5 text-sm">
                {groot.map((r) => <li data-item={r.k} class="rounded-md border-l-2 border-lime py-1 pr-2 pl-3 transition-colors">{r.t}</li>)}
                <li data-item="apk heel" class="rounded-md border-l-2 border-lime py-1 pr-2 pl-3 font-bold transition-colors">Inclusief APK-keuring</li>
              </ul>
            </div>
          </div>

          <div class="mt-8 grid gap-6 border-t border-line pt-8 sm:grid-cols-2">
            <p>Bij grote gebreken nemen we altijd contact met u op en overleggen we de kosten.</p>
            <p class="text-ink-soft">Elke auto is anders, dus elke beurt heeft een eigen tarief. Vraag gerust naar een prijsindicatie.</p>
          </div>
          <a href={site.telHref} class="btn btn-marine mt-6"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
        </div>
      </div>

      <!-- Uit onze werkplaats: kleine eigen foto's op (bijna) eigen formaat. -->
      <div class="wrap mt-16 lg:mt-20">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-line pt-10">
          <h3 class="text-xl">Uit onze werkplaats</h3>
          <p class="text-sm text-ink-soft">Naast de beurten ook: uitlezen van uw auto, nieuwe (winter)banden plaatsen en bijvoorbeeld trekhaken.</p>
        </div>
        <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
          {werkplaats.map((w) => (
            <li>
              <figure class="max-w-[283px]">
                <div class="aspect-[283/186] overflow-hidden rounded-xl bg-paper"><Foto src={w.src} alt={w.alt} widths={[283]} sizes="(min-width: 1024px) 283px, 46vw" /></div>
                <figcaption class="mt-2 text-sm text-ink-soft">{w.bij}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <script>
      // Keuzehulp: kiest de beurt op basis van wat er volgens de eigen site in zit. Rekent niets, toont geen prijzen.
      const sectie = document.querySelector<HTMLElement>('[data-keuzehulp]');
      if (sectie) {
        const form = sectie.querySelector<HTMLFormElement>('[data-keuzes]')!;
        const blok = sectie.querySelector<HTMLElement>('[data-advies-blok]')!;
        const advies = sectie.querySelector<HTMLElement>('[data-advies]')!;
        const extraTekst = sectie.querySelector<HTMLElement>('[data-extra]')!;
        const kaarten = sectie.querySelectorAll<HTMLElement>('[data-kaart]');
        form.hidden = false;
        blok.hidden = false;
        form.addEventListener('submit', (e) => e.preventDefault());
        const lijst = (a: string[]) => (a.length > 1 ? a.slice(0, -1).join(', ') + ' en ' + a[a.length - 1] : a[0]);
        const bijwerken = () => {
          const aan = [...form.querySelectorAll<HTMLInputElement>('input[name=keuze]:checked')];
          const extra = [...form.querySelectorAll<HTMLInputElement>('input[name=extra]:checked')].map((i) => i.dataset.label!.toLowerCase());
          const ids = aan.map((i) => i.value);
          const beurt = aan.some((i) => i.dataset.beurt === 'groot') ? 'groot' : aan.length ? 'klein' : '';
          sectie.querySelectorAll<HTMLElement>('[data-item]').forEach((li) => {
            li.toggleAttribute('data-raak', li.dataset.item!.split(' ').some((k) => ids.includes(k)));
          });
          kaarten.forEach((k) => {
            const past = k.dataset.kaart === beurt;
            k.querySelector<HTMLElement>('[data-past]')!.hidden = !past;
            k.classList.toggle('ring-4', past);
            k.classList.toggle(k.dataset.kaart === 'groot' ? 'ring-lime' : 'ring-marine', past);
            k.style.order = past ? '-1' : '';
          });
          if (beurt === 'groot') advies.textContent = 'Een grote beurt past: de hele auto nagekeken, inclusief APK-keuring.';
          else if (beurt === 'klein') advies.textContent = 'Een kleine beurt past: alle vitale functies onderzocht, olie ververst en oliefilter vervangen.';
          else advies.textContent = extra.length ? `Naast de gebruikelijke beurten doen we ook: ${lijst(extra)}.` : 'Tik aan wat u wilt laten doen. Dan ziet u hier welke beurt past.';
          extraTekst.textContent = beurt && extra.length ? `Daarnaast: ${lijst(extra)}.` : '';
        };
        form.addEventListener('change', bijwerken);
      }
    </script>

    <!-- Schadeherstel: donker vlak, eigen werkplaatsfoto's en het aanbod als strakke lijst. -->
    <section id="schade" class="donker scroll-mt-20 bg-night py-16 text-white lg:py-24">
      <div class="wrap">
        <div class="grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <p class="kicker text-lime">Schadeherstel</p>
            <h2 class="mt-3 text-3xl">Schade? Uitdeuken, spuiten, richten</h2>
            <p class="mt-6 text-lg text-white/85">Voor schade werken we samen met Auto Herstel Service Wilco, op hetzelfde adres. Bij een autoschade komt meer kijken dan u soms beseft. Wilco Nieuwenhuizen helpt u om alles tot een goed einde te brengen.</p>
            <p class="mt-4 text-white/85">We onderhouden de nodige contacten met instanties, schade-experts en verzekeringsmaatschappijen, en herstellen schade voor particulieren en voor bijna alle verzekeringsmaatschappijen.</p>
            <p class="mt-8 rounded-xl border border-white/20 p-5">
              <span class="block text-sm text-white/75">Schade: Auto Herstel Service Wilco</span>
              <a href={site.wilcoTelHref} class="font-display text-2xl font-bold whitespace-nowrap tabular-nums underline decoration-lime decoration-2 underline-offset-4">{site.wilcoTel}</a>
            </p>
          </div>
          <div class="lg:col-span-5 lg:col-start-8">
            <figure>
              <div class="grid grid-cols-2 gap-3">
                <div class="aspect-[283/186] overflow-hidden rounded-xl"><Foto src={afgeplakt1} alt="Een blauwe auto in onze werkplaats, afgeplakt voor het spuitwerk" widths={[283]} sizes="(min-width: 1024px) 230px, 46vw" /></div>
                <div class="aspect-[283/186] overflow-hidden rounded-xl"><Foto src={afgeplakt2} alt="Dezelfde auto van voren, ramen en koplampen afgeplakt" widths={[283]} sizes="(min-width: 1024px) 230px, 46vw" /></div>
              </div>
              <figcaption class="mt-3 text-sm text-white/75">Uit onze werkplaats: afgeplakt voor het spuitwerk.</figcaption>
            </figure>
            <ul class="mt-8 grid gap-x-6 text-lg sm:grid-cols-2">
              {['Uitdeuken', 'Spuiten', 'Richten', 'Velgreparatie', 'Kunststofreparatie'].map((a) => (
                <li class="flex items-center gap-3 border-b border-white/15 py-3"><span class="h-2 w-2 flex-none rounded-full bg-lime" aria-hidden="true"></span><span class="min-w-0 [overflow-wrap:anywhere]">{a}</span></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-16 grid items-center gap-10 border-t border-white/15 pt-16 lg:grid-cols-12">
          <div class="aspect-[5/4] overflow-hidden rounded-xl lg:col-span-5"><Foto src={oldtimer} alt="Koplamp en verchroomde grille van een glanzend roodbruine klassieke auto" sizes="(min-width: 1024px) 420px, 100vw" /></div>
          <div class="lg:col-span-6 lg:col-start-7">
            <h3 class="text-2xl">Lakschade, oldtimers en een nieuwe kleur</h3>
            <p class="mt-5 text-lg text-white/85">Ook lakschade door vandalisme, restauratiespuitwerk van bijvoorbeeld oldtimers of een compleet andere kleur voor uw auto, motor of bromfiets is geen probleem.</p>
            <p class="mt-4 text-white/75">Als u bij ons bent, kunt u er altijd vrijblijvend naar informeren.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Over ons: tijdlijn 1969, 1987, nu. -->
    <section id="over" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">U tevreden, wij tevreden</h2>
          <p class="mt-5 text-ink-soft">Klanttevredenheid staat bij ons hoog in het vaandel. We hebben plezier in ons werk zolang onze klanten plezier hebben met hun auto.</p>
          <p class="mt-6 text-sm"><strong class="font-display text-2xl">{site.google}</strong> <span class="text-ink-soft">op Google, {site.reviews} reviews</span></p>
          <figure class="mt-8 max-w-[282px]">
            <div class="aspect-[282/182] overflow-hidden rounded-xl"><Foto src={kantoor} alt="De balie en het kantoor in ons pand, met bakstenen muren" widths={[282]} sizes="282px" /></div>
            <figcaption class="mt-2 text-sm text-ink-soft">De balie in ons pand.</figcaption>
          </figure>
        </div>
        <ol class="relative lg:col-span-7 lg:col-start-6">
          <li class="grid gap-2 border-l-2 border-marine pb-10 pl-6 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <p class="font-display text-jaar font-extrabold leading-none tracking-[-0.04em] tabular-nums">1969</p>
            <div class="sm:pt-2"><h3 class="text-xl">Het begin</h3><p class="mt-2 text-ink-soft">Autobedrijf Heemskerk bestaat sinds 1969.</p></div>
          </li>
          <li class="grid gap-2 border-l-2 border-marine pb-10 pl-6 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <p class="font-display text-jaar font-extrabold leading-none tracking-[-0.04em] tabular-nums">1987</p>
            <div class="sm:pt-2"><h3 class="text-xl">Christiaan Huijgensweg 9</h3><p class="mt-2 text-ink-soft">Sindsdien gevestigd op {site.terrein} in Alphen aan den Rijn.</p></div>
          </li>
          <li class="grid gap-2 border-l-2 border-marine pl-6 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <p class="font-display text-jaar font-extrabold leading-none tracking-[-0.04em] text-marine">Nu</p>
            <div class="sm:pt-2"><h3 class="text-xl">Full-service autobedrijf</h3><p class="mt-2 text-ink-soft">Onderhoud, reparatie, APK, schadeherstel, inbouw van elektronica en onderdelen via OTOPARTNER.</p></div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Contact: bellen en mailen voorop, tijden als tabel. -->
    <section id="contact" class="donker scroll-mt-20 bg-marine py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Langskomen of bellen</h2>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-lime"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <p class="mt-6 break-all text-white/85"><a href={`mailto:${site.mail}`} class="underline decoration-lime decoration-2 underline-offset-4">{site.mail}</a></p>
          <address class="mt-8 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-white/75">{site.terrein}</span></address>
          <a href={site.maps} rel="noopener" class="mt-4 inline-block font-semibold underline decoration-lime decoration-2 underline-offset-4">Route plannen</a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="text-xl">Openingstijden</h3>
          <dl class="mt-4 border-t border-white/20">
            {tijden.map((t) => (
              <div class="flex justify-between gap-4 border-b border-white/20 py-3"><dt>{t.dag}</dt><dd class="whitespace-nowrap tabular-nums font-semibold">{t.tijd}</dd></div>
            ))}
          </dl>
          <p class="mt-8 text-sm text-white/75">Schade: Auto Herstel Service Wilco, <a href={site.wilcoTelHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.wilcoTel}</a></p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
