---
// Wordmark naar hun eigen logo: de groene pijl-H vervangt de H van HEEMSKERK, schuine letters in donkerblauw.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-[3px] leading-none ${cls}`}>
  <span class="sr-only">Autobedrijf Heemskerk</span>
  <svg viewBox="0 0 43 36" class="h-[2.15rem] w-auto flex-none" aria-hidden="true">
    <path transform="translate(9 0) skewX(-14)" class={licht ? 'fill-lime' : 'fill-leaf'} d="M11 0 21 11h-6v6h10V6h8v30h-8V24H15v12H7V11H1Z" />
  </svg>
  <span aria-hidden="true" class={`flex flex-col font-display italic [font-synthesis:style] ${licht ? 'text-white' : 'text-marine'}`}>
    <span class="text-[0.6rem] font-bold tracking-[0.34em]">AUTOBEDRIJF</span>
    <span class="mt-[3px] text-[1.45rem] font-extrabold tracking-[-0.01em]">EEMSKERK</span>
  </span>
</span>
