---
import { site, url } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const thuis = Astro.url.pathname.replace(/\/$/, '') === url('').replace(/\/$/, '');
const anker = (id: string) => (thuis ? `#${id}` : `${url('')}#${id}`);
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="no-underline"><Logo /></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={anker('onderhoud')} class="no-underline hover:text-marine hover:underline underline-offset-4">Onderhoud</a></li>
          <li><a href={anker('schade')} class="no-underline hover:text-marine hover:underline underline-offset-4">Schadeherstel</a></li>
          <li><a href={anker('over')} class="no-underline hover:text-marine hover:underline underline-offset-4">Over ons</a></li>
          <li><a href={anker('contact')} class="no-underline hover:text-marine hover:underline underline-offset-4">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-marine !px-4 !py-2 text-sm">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        <span class="sm:hidden">Bel</span><span class="hidden whitespace-nowrap tabular-nums sm:inline">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="donker bg-night py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5"><Logo licht /><p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}<br />KvK {site.kvk}</p></div>
      <p class="md:col-span-4"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash en foto's van de huidige website, ter illustratie. Bij oplevering vervangen we ze door nieuwe eigen foto's.</p>}
  </footer>
)}
