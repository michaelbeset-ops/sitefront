---
import { site, url, wa, telIcoon } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const thuis = Astro.url.pathname.replace(/\/$/, '') === url('').replace(/\/$/, '');
const anker = (id: string) => (thuis ? `#${id}` : `${url('')}#${id}`);
const links = [
  { id: 'werk', label: 'Werkplaats' },
  { id: 'afspraak', label: 'Afspraak' },
  { id: 'klanten', label: 'Reviews' },
  { id: 'contact', label: 'Contact' },
];
---
{deel === 'kop' ? (
  <header class="donker sticky top-0 z-40 border-b border-white/10 bg-asfalt/95 text-white backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="no-underline"><Logo /></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-8 text-sm font-semibold">
          {links.map((l) => <li><a href={anker(l.id)} class="text-white/85 no-underline underline-offset-8 transition-colors hover:text-vonk hover:underline">{l.label}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a href={site.telHref} class="btn btn-line hidden !px-4 !py-2 text-sm md:inline-flex">
          <Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">{site.tel}</span>
        </a>
        <a href={site.whatsapp} class="btn btn-vonk !px-4 !py-2 text-sm">
          <Fragment set:html={wa} /><span class="max-[359px]:sr-only">WhatsApp</span>
        </a>
      </div>
    </div>
  </header>
) : (
  <footer class="donker hexraster bg-asfalt py-14 text-white/80">
    <div class="wrap grid gap-10 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-5">{site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-white/75">KvK</span> <span class="text-xs">[[AANLEVEREN: KvK-nummer]]</span></p>
      </div>
      <p class="md:col-span-4">
        Bellen en WhatsApp <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br />
        Maandag t/m vrijdag <span class="whitespace-nowrap tabular-nums">09.00 - 17.00</span><br />
        <a href={site.maps} rel="noopener" class="underline underline-offset-2">Route via Google Maps</a>
      </p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 text-xs">Foto's van uw Google-bedrijfsprofiel en sfeerfoto's via Unsplash, ter illustratie.</p>}
  </footer>
)}
