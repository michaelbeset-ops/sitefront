---
// Ponchi Garage heeft nog geen logo. Voorstel: een zeshoek zoals de lampen in hun werkplaats, met een P,
// en de naam in smalle, vette letters.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <svg viewBox="0 0 36 40" class="h-9 w-8 flex-none" aria-hidden="true">
    <path d="M18 2 34 11v18L18 38 2 29V11z" fill="none" stroke="#ff7a1a" stroke-width="3" stroke-linejoin="round" />
    <path d="M13.5 29V11.5h6.2a5.3 5.3 0 0 1 0 10.6h-6.2" fill="none" stroke="#eaf1f6" stroke-width="3.2" stroke-linejoin="round" />
  </svg>
  <span class="flex flex-col">
    <span class="font-display text-[1.4rem] font-extrabold tracking-[0.02em] text-white uppercase" style="font-stretch:80%">Ponchi</span>
    <span class="mt-0.5 font-display text-[0.62rem] font-bold tracking-[0.34em] text-vonk uppercase" style="font-stretch:115%">Garage</span>
  </span>
</span>
