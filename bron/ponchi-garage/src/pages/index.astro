---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, wa, telIcoon } from '../data/site';
import werkplaats from '../assets/werkplaats.jpg';
import voorDeDeur from '../assets/voor-de-deur.jpg';
import opDeBrug from '../assets/op-de-brug.jpg';
import sfeer from '../assets/sfeer.jpg';
import motorruimte from '../assets/motorruimte.jpg';
import sleutel from '../assets/sleutel.jpg';
import zekeringen from '../assets/zekeringen.jpg';

const werk = [
  { naam: 'APK', tekst: 'Uw APK bij ons laten doen? Plan hem via WhatsApp of bel even.', src: motorruimte, alt: 'Een monteur buigt zich over de open motorruimte van een auto (sfeerfoto)', pos: 'object-[30%_50%]' },
  { naam: 'Onderhoud', tekst: 'Snel en goed onderhoud is wat klanten in hun reviews noemen. En u hoort duidelijk wat er aan uw auto gedaan is.', src: sleutel, alt: 'Handen met een ringsleutel in een motorruimte (sfeerfoto)', pos: 'object-center' },
  { naam: 'Storing en reparatie', tekst: 'Doet uw auto iets wat hij niet hoort te doen? Zet het in uw bericht. Komt er tijdens het werk iets anders aan het licht, dan bellen we u en overleggen we wat de beste oplossing is.', src: zekeringen, alt: 'Een monteur controleert de zekeringkast in de motorruimte van een auto (sfeerfoto)', pos: 'object-center' },
  { naam: 'Banden, verlagen en spacers', tekst: 'Andere banden, spacers of de auto verlagen: in de reviews staan klanten die dat hier lieten doen. Vraag via WhatsApp wat er voor uw auto kan.', src: voorDeDeur, alt: 'Een lage zwarte cabrio met rode kap en brede velgen voor de rolpoorten van onze werkplaats', pos: 'object-[40%_60%]' },
];

const keuzes = ['APK', 'Onderhoud', 'Storing of reparatie', 'Banden, verlagen of spacers', 'Iets anders'];

const punten = [
  'Vaste klanten zijn na de overname bij de nieuwe eigenaar gebleven.',
  'Snel en goed onderhoud, en u wordt snel ingepland.',
  'Er wordt meegedacht, met duidelijke uitleg over de werkzaamheden.',
  'Wordt er iets anders gevonden, dan bellen ze en overleggen ze wat de beste oplossing is.',
  'Kundige monteurs die netjes werken. Vriendelijk en professioneel.',
];

const hex = `<svg viewBox="0 0 20 22" class="hex" aria-hidden="true"><path d="M10 1.5 18.5 6.3v9.4L10 20.5 1.5 15.7V6.3z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></svg>`;
---
<Base
  title="Ponchi Garage | APK, onderhoud en reparatie in Dordrecht"
  description="Garage aan de Daltonstraat 14 in Dordrecht. APK, onderhoud en reparatie. Open maandag t/m vrijdag 09.00 - 17.00. Afspraak via WhatsApp of bel 06 18 31 44 49."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: hun eigen werkplaats met de hexagon-lampen, op mobiel bovenaan, op desktop verspringend over de rand. -->
    <section class="donker hexraster relative bg-asfalt text-white">
      <div class="wrap grid gap-x-12 pb-12 lg:grid-cols-12 lg:pt-16 lg:pb-6">
        <figure class="relative -mx-5 lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:mx-0 lg:translate-y-36">
          <div class="aspect-[4/3] overflow-hidden sm:aspect-[16/9] lg:aspect-[901/1100] lg:rounded-xl lg:shadow-lg">
            <Foto src={werkplaats} alt="Onze werkplaats met de zeshoekige lampen aan het plafond, een tweekolomsbrug en drie auto's met open motorkap" hero widths={[480, 901]} sizes="(min-width: 1024px) 470px, 100vw" class="object-[50%_42%] lg:object-center" />
          </div>
          <figcaption class="absolute bottom-3 left-5 rounded-md bg-asfalt/85 px-2.5 py-1 text-xs text-white lg:bottom-4 lg:left-4 lg:text-sm">Onze werkplaats aan de Daltonstraat</figcaption>
          <span class="absolute -top-5 -left-5 hidden h-20 w-[4.6rem] lg:block" aria-hidden="true">
            <svg viewBox="0 0 36 40" class="h-full w-full"><path d="M18 2 34 11v18L18 38 2 29V11z" fill="#ff7a1a" /></svg>
          </span>
        </figure>

        <div class="pt-8 lg:col-span-7 lg:row-start-1 lg:pt-0">
          <p class="kicker text-vonk">Garage aan de Daltonstraat 14</p>
          <h1 class="mt-4 text-4xl">APK, onderhoud en reparatie in Dordrecht</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">Ponchi Garage is sinds kort in handen van een nieuwe eigenaar, en de vaste klanten zijn gebleven. Laat via WhatsApp weten wat uw auto nodig heeft.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#afspraak" class="btn btn-vonk"><Fragment set:html={wa} />Afspraak via WhatsApp</a>
            <a href={site.telHref} class="btn btn-line"><Fragment set:html={telIcoon} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <dl class="mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-white/15 pt-6 text-sm">
            <div><dt class="text-white/75">Google</dt><dd><strong class="font-display text-2xl tabular-nums">{site.google}</strong> <span class="block text-white/80 sm:inline">({site.reviews} reviews)</span></dd></div>
            <div><dt class="text-white/75">Ma t/m vr</dt><dd class="font-display text-xl font-bold tabular-nums sm:whitespace-nowrap">09.00 - 17.00</dd></div>
            <div><dt class="text-white/75">Za en zo</dt><dd class="font-display text-xl font-bold">Gesloten</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Werkplaats: kop naast de overhangende hero-foto, daarna een genummerde lijst met beeld. -->
    <section id="werk" class="scroll-mt-20 py-16 lg:pt-16 lg:pb-24">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <p class="kicker text-roest">Werkplaats</p>
            <h2 class="mt-3 text-3xl">Wat we aan uw auto doen</h2>
            <p class="mt-5 max-w-lg text-lg text-ink-soft">APK, onderhoud en reparatie. En wilt u iets aan uw auto laten aanpassen, vraag het gerust.</p>
          </div>
        </div>
        <ol class="mt-12 border-t border-line lg:mt-16">
          {werk.map((w, i) => (
            <li class="group grid gap-5 border-b border-line py-8 sm:grid-cols-[3.5rem_1fr] md:grid-cols-[4.5rem_1fr_16rem] md:items-center lg:grid-cols-[6rem_1fr_22rem] lg:gap-10">
              <span class="font-display text-3xl font-extrabold text-roest tabular-nums" style="font-stretch:80%">0{i + 1}</span>
              <div class="max-w-xl">
                <h3 class="text-2xl uppercase" style="font-stretch:84%">{w.naam}</h3>
                <p class="mt-2 text-ink-soft">{w.tekst}</p>
              </div>
              <div class="aspect-[16/10] overflow-hidden rounded-xl shadow-sm sm:col-start-2 md:col-start-auto">
                <Foto src={w.src} alt={w.alt} widths={[400, 700]} sizes="(min-width: 1024px) 352px, (min-width: 768px) 256px, 90vw" class={`${w.pos} transition-transform duration-500 group-hover:scale-[1.03]`} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Wow: afspraak via WhatsApp. Zonder JS blijft de uitleg en een gewone WhatsApp-knop over. -->
    <section id="afspraak" class="donker hexraster scroll-mt-16 bg-asfalt py-16 text-white lg:py-24" data-planner>
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-vonk">Afspraak via WhatsApp</p>
          <h2 class="mt-3 text-3xl">Uw afspraak in één bericht</h2>
          <p class="mt-5 text-lg text-white/85">Kies wat uw auto nodig heeft en welke dag u uitkomt. De knop zet alles netjes in een WhatsApp-bericht aan de garage. U verstuurt het zelf.</p>
          <div class="mt-8 aspect-[3/2] overflow-hidden rounded-xl">
            <Foto src={sfeer} alt="Een donkere garage met een tl-lamp en een klassieke auto met brandende achterlichten (sfeerfoto)" widths={[500, 900]} sizes="(min-width: 1024px) 460px, 90vw" />
          </div>
          <div class="mt-6 flex items-start gap-3 rounded-xl border border-white/15 p-5 text-sm">
            <svg viewBox="0 0 20 22" class="mt-0.5 h-5 w-5 flex-none text-vonk" aria-hidden="true"><path d="M10 1.5 18.5 6.3v9.4L10 20.5 1.5 15.7V6.3z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/></svg>
            <p class="text-white/85">Open maandag t/m vrijdag <span class="whitespace-nowrap tabular-nums font-semibold text-white">09.00 - 17.00</span>. Zaterdag en zondag zijn we dicht, die dagen kunt u hier niet kiezen.</p>
          </div>
        </div>

        <div class="lg:col-span-7">
          <form class="rounded-xl bg-olie/70 p-5 ring-1 ring-white/10 sm:p-8" data-form hidden>
            <fieldset>
              <legend class="flex items-baseline gap-3 font-display text-xl font-bold"><span class="text-vonk tabular-nums">1</span>Wat heeft uw auto nodig?</legend>
              <div class="mt-4 grid gap-2 sm:grid-cols-2">
                {keuzes.map((k) => (
                  <label class="keus"><input type="radio" name="wat" value={k} class="sr-only" /><Fragment set:html={hex} />{k}</label>
                ))}
              </div>
            </fieldset>

            <fieldset class="mt-8">
              <legend class="flex items-baseline gap-3 font-display text-xl font-bold"><span class="text-vonk tabular-nums">2</span>Uw auto</legend>
              <div class="mt-4 grid gap-4 sm:grid-cols-[1fr_12rem]">
                <div><label for="p-auto" class="text-sm text-white/85">Merk en model</label><input id="p-auto" name="auto" type="text" autocomplete="off" class="veld mt-1.5" /></div>
                <div><label for="p-kenteken" class="text-sm text-white/85">Kenteken <span class="text-white/75">(mag leeg)</span></label><input id="p-kenteken" name="kenteken" type="text" autocomplete="off" class="veld mt-1.5 uppercase" /></div>
              </div>
              <div class="mt-4"><label for="p-toe" class="text-sm text-white/85">Wat merkt u, of wat wilt u laten doen? <span class="text-white/75">(mag leeg)</span></label><textarea id="p-toe" name="toelichting" rows="2" class="veld mt-1.5"></textarea></div>
            </fieldset>

            <fieldset class="mt-8">
              <legend class="flex items-baseline gap-3 font-display text-xl font-bold"><span class="text-vonk tabular-nums">3</span>Welke dag komt u uit?</legend>
              <div class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6" data-dagen></div>
            </fieldset>

            <fieldset class="mt-8">
              <legend class="flex items-baseline gap-3 font-display text-xl font-bold"><span class="text-vonk tabular-nums">4</span>Uw naam <span class="font-body text-sm font-normal text-white/75">(mag leeg)</span></legend>
              <label for="p-naam" class="sr-only">Uw naam</label>
              <input id="p-naam" name="naam" type="text" autocomplete="name" class="veld mt-4 sm:max-w-sm" />
            </fieldset>

            <div class="mt-8 border-t border-white/10 pt-6">
              <p class="kicker text-white/75">Uw bericht</p>
              <p data-bericht aria-live="polite" class="mt-3 max-w-lg rounded-xl rounded-tl-sm bg-neon p-4 text-sm leading-relaxed whitespace-pre-line text-ink shadow-sm"></p>
              <a href={site.whatsapp} data-knop class="btn btn-vonk mt-6 w-full sm:w-auto"><Fragment set:html={wa} />Open WhatsApp met dit bericht</a>
              <p class="mt-3 text-sm text-white/75">WhatsApp opent met het bericht klaar. U kunt het nog aanpassen voordat u het verstuurt.</p>
            </div>
          </form>

          <div data-zonderjs class="rounded-xl border border-white/15 p-6">
            <p class="text-lg">Stuur een WhatsApp met wat uw auto nodig heeft, het merk en model en de dag die u uitkomt.</p>
            <a href={site.whatsapp} class="btn btn-vonk mt-5"><Fragment set:html={wa} />Stuur een WhatsApp</a>
          </div>
        </div>
      </div>
    </section>

    <script>
      const sectie = document.querySelector<HTMLElement>('[data-planner]');
      if (sectie) {
        const form = sectie.querySelector<HTMLFormElement>('[data-form]')!;
        const bericht = sectie.querySelector<HTMLElement>('[data-bericht]')!;
        const knop = sectie.querySelector<HTMLAnchorElement>('[data-knop]')!;
        const dagen = sectie.querySelector<HTMLElement>('[data-dagen]')!;
        sectie.querySelector<HTMLElement>('[data-zonderjs]')!.hidden = true;
        form.hidden = false;

        // Dagkeuze: vandaag plus de komende 10 dagen. Zaterdag en zondag dicht; vandaag na 17.00 ook.
        const nu = new Date();
        const kort = new Intl.DateTimeFormat('nl-NL', { weekday: 'short' });
        const lang = new Intl.DateTimeFormat('nl-NL', { weekday: 'long', day: 'numeric', month: 'long' });
        const maak = (waarde: string, boven: string, onder: string, dicht = false, label = '') => {
          const l = document.createElement('label');
          l.className = 'dag';
          const i = document.createElement('input');
          i.type = 'radio'; i.name = 'dag'; i.value = waarde; i.className = 'sr-only'; i.disabled = dicht;
          const a = document.createElement('span'); a.className = 'text-xs'; a.textContent = boven; a.setAttribute('aria-hidden', 'true');
          const b = document.createElement('span'); b.className = 'font-display text-lg font-bold tabular-nums'; b.textContent = onder; b.setAttribute('aria-hidden', 'true');
          const c = document.createElement('span'); c.className = 'sr-only'; c.textContent = label || onder;
          l.append(i, a, b, c);
          dagen.append(l);
        };
        for (let n = 0; n < 11; n++) {
          const d = new Date(nu.getFullYear(), nu.getMonth(), nu.getDate() + n);
          const weekend = d.getDay() === 0 || d.getDay() === 6;
          const teLaat = n === 0 && nu.getHours() >= 17;
          const dicht = weekend || teLaat;
          const naam = lang.format(d);
          maak(naam, n === 0 ? 'vandaag' : kort.format(d).replace('.', ''), dicht ? 'dicht' : String(d.getDate()), dicht, dicht ? `${naam}, gesloten` : naam);
        }
        maak('maakt niet uit', '', 'Geen voorkeur', false, 'Geen voorkeur voor een dag');
        dagen.lastElementChild!.classList.add('col-span-2');
        dagen.lastElementChild!.children[2].className = 'font-display text-sm font-bold';

        const bijwerken = () => {
          const f = new FormData(form);
          const s = (k: string) => String(f.get(k) ?? '').trim();
          const wat = s('wat') === 'APK' ? 'APK' : s('wat').toLowerCase();
          const auto = s('auto');
          const kenteken = s('kenteken').toUpperCase();
          const regels = ['Hallo Ponchi Garage,', wat ? `Ik wil graag een afspraak voor: ${wat}.` : 'Ik wil graag een afspraak maken.'];
          if (auto || kenteken) regels.push(`Auto: ${[auto, kenteken && `kenteken ${kenteken}`].filter(Boolean).join(', ')}`);
          if (s('dag')) regels.push(`Voorkeursdag: ${s('dag')}`);
          if (s('toelichting')) regels.push(`Toelichting: ${s('toelichting')}`);
          regels.push(s('naam') ? `Groet, ${s('naam')}` : 'Groet');
          const tekst = regels.join('\n');
          bericht.textContent = tekst;
          knop.href = `https://wa.me/31618314449?text=${encodeURIComponent(tekst)}`;
        };
        form.addEventListener('input', bijwerken);
        form.addEventListener('change', bijwerken);
        form.addEventListener('submit', (e) => e.preventDefault());
        bijwerken();
      }
    </script>

    <!-- Wat klanten noemen: hun belangrijkste bewijs. Samengevat, geen citaten of namen. -->
    <section id="klanten" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="relative lg:col-span-5">
          <figure class="relative">
            <div class="aspect-[3/4] overflow-hidden rounded-xl shadow-sm sm:aspect-[4/3] lg:aspect-[900/1200]">
              <Foto src={opDeBrug} alt="Een zwarte cabrio op de brug in onze werkplaats, met de rolpoort op de achtergrond" widths={[480, 900]} sizes="(min-width: 1024px) 470px, 100vw" class="object-[50%_40%]" />
            </div>
            <figcaption class="absolute top-3 left-3 rounded-md bg-asfalt/85 px-2.5 py-1 text-xs text-white sm:text-sm">Op de brug in onze werkplaats</figcaption>
          </figure>
          <div class="donker relative -mt-24 ml-auto w-[88%] rounded-xl bg-asfalt p-6 text-white shadow-lg sm:w-80 lg:absolute lg:-right-10 lg:bottom-16 lg:mt-0">
            <p class="kicker text-vonk">Google-reviews</p>
            <p class="mt-2 flex items-baseline gap-3"><span class="font-display text-cijfer leading-none font-extrabold tabular-nums" style="font-stretch:78%">{site.google}</span><span class="text-white/85">van 5</span></p>
            <p class="mt-1 text-white/85">op basis van {site.reviews} reviews</p>
            <a href={site.maps} rel="noopener" class="mt-4 inline-block font-semibold underline decoration-vonk decoration-2 underline-offset-4 transition-colors hover:text-vonk">Bekijk ze op Google</a>
          </div>
        </div>

        <div class="lg:col-span-6 lg:col-start-7 lg:pt-6">
          <p class="kicker text-roest">Reviews</p>
          <h2 class="mt-3 text-3xl">Wat klanten noemen</h2>
          <p class="mt-5 text-lg text-ink-soft">Samengevat uit de reviews op Google.</p>
          <ul class="mt-8 border-t border-line">
            {punten.map((p) => (
              <li class="flex gap-4 border-b border-line py-5 text-lg">
                <svg viewBox="0 0 20 22" class="mt-1 h-5 w-5 flex-none text-roest" aria-hidden="true"><path d="M10 1.5 18.5 6.3v9.4L10 20.5 1.5 15.7V6.3z" fill="currentColor"/></svg>
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <div class="mt-10 rounded-xl bg-beton p-6">
            <h3 class="text-xl">Recent overgenomen</h3>
            <p class="mt-2 text-ink-soft">Ponchi Garage heeft een nieuwe eigenaar. Dit is de eerste website van de garage.</p>
            <p class="mt-2 text-xs text-ink-soft">[[AANLEVEREN: naam en een paar zinnen van de nieuwe eigenaar, eventueel met foto]]</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact: WhatsApp en bellen voorop, tijden met vandaag gemarkeerd, formulier dat in het voorstel niets verstuurt. -->
    <section id="contact" class="donker scroll-mt-16 bg-asfalt py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-vonk">Contact</p>
          <h2 class="mt-3 text-3xl">Langskomen of even appen</h2>
          <p class="mt-5 max-w-md text-lg text-white/85">Bellen en WhatsApp gaan naar hetzelfde nummer.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.whatsapp} class="btn btn-vonk text-lg"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line text-lg"><Fragment set:html={telIcoon} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <div class="mt-10 grid gap-8 sm:grid-cols-2">
            <div>
              <h3 class="text-xl">Adres</h3>
              <address class="mt-3 not-italic text-white/85">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
              <a href={site.maps} rel="noopener" class="mt-3 inline-block font-semibold underline decoration-vonk decoration-2 underline-offset-4 transition-colors hover:text-vonk">Route plannen</a>
            </div>
            <div>
              <h3 class="text-xl">Openingstijden</h3>
              <dl class="mt-3 border-t border-white/15 text-sm" data-tijden>
                {tijden.map((t, i) => (
                  <div data-dag={(i + 1) % 7} class="flex justify-between gap-3 border-b border-white/15 py-2">
                    <dt>{t.dag}</dt>
                    <dd class={`whitespace-nowrap tabular-nums ${t.open ? 'font-semibold' : 'text-white/75'}`}>{t.tijd}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 lg:col-start-8">
          <form class="rounded-xl bg-paper p-6 text-ink shadow-lg sm:p-8" onsubmit="return false">
            <h3 class="text-xl">Liever een bericht achterlaten?</h3>
            <div class="mt-5 space-y-4">
              <div><label for="c-naam" class="text-sm font-semibold">Naam</label><input id="c-naam" type="text" autocomplete="name" class="veld-licht mt-1.5" /></div>
              <div><label for="c-tel" class="text-sm font-semibold">Telefoonnummer</label><input id="c-tel" type="tel" autocomplete="tel" class="veld-licht mt-1.5" /></div>
              <div><label for="c-vraag" class="text-sm font-semibold">Uw vraag</label><textarea id="c-vraag" rows="4" class="veld-licht mt-1.5"></textarea></div>
            </div>
            {site.voorstel ? (
              <p class="mt-5 rounded-lg bg-beton p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel of app <a href={site.telHref} class="whitespace-nowrap tabular-nums font-semibold underline">{site.tel}</a>.</p>
            ) : (
              <button type="submit" class="btn btn-asfalt mt-5">Verstuur</button>
            )}
          </form>
        </div>
      </div>
    </section>
    <script>
      const vandaag = new Date().getDay();
      const rij = document.querySelector<HTMLElement>(`[data-tijden] [data-dag="${vandaag}"]`);
      if (rij) {
        rij.classList.add('text-vonk');
        const dt = rij.querySelector('dt')!;
        const tag = document.createElement('span');
        tag.className = 'ml-2 rounded bg-vonk px-1.5 py-0.5 text-xs font-bold text-asfalt';
        tag.textContent = 'vandaag';
        dt.append(tag);
      }
    </script>
  </main>
  <Chrome deel="voet" />
</Base>
