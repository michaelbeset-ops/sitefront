---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, merken, reviews, citaten, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import onderhoud from '../assets/onderhoud.jpg';
import airco from '../assets/airco.jpg';
import sanitair from '../assets/sanitair.jpg';
import leidingwerk from '../assets/leidingwerk.jpg';
import ketelLeiden from '../assets/ketel-leiden.jpg';
import ketelDetail from '../assets/ketel-detail.jpg';
import thermostaat from '../assets/thermostaat.jpg';
import vloer1 from '../assets/vloer-1.jpg';
import vloer2 from '../assets/vloer-2.jpg';
import vloerSet from '../assets/vloer-set.jpg';
import bus from '../assets/bus.jpg';

const vraag = (d: string) => waMet(`Goedendag John, ik heb een vraag over ${d.toLowerCase()}.`);

const diensten = [
  { t: 'CV-ketel vervangen', d: 'Advies, levering en installatie van een nieuwe ketel, afgestemd op uw gasverbruik.', src: ketelLeiden, alt: 'Nieuw geplaatste Remeha Avanta-ketel met regelunit in een woning in Leiden', pos: '50% 40%', eigen: true },
  { t: 'Onderhoud en storingen', d: 'Jaarlijks onderhoud van ketel en boiler, en snel hulp als de verwarming het laat afweten.', src: onderhoud, alt: 'Manometer en kranen aan een cv-installatie', pos: '50% 50%' },
  { t: 'Airconditioning', d: 'Split- en multisplitsystemen voor woning en bedrijf, met advies op locatie en onderhoud.', src: airco, alt: 'Buitenunit van een airco aan een bakstenen muur', pos: '50% 55%' },
  { t: 'Sanitair', d: 'Een nieuw toilet of badkamersanitair, of een doorlopende stortbak die verholpen moet worden.', src: sanitair, alt: 'Lichte badkamer met ligbad, wastafel en hangtoilet', pos: '50% 55%' },
  { t: 'Gas- en waterleiding', d: 'Leidingwerk voor keuken, badkamer en toilet, ook verleggen van keukenaansluitingen.', src: leidingwerk, alt: 'Koperen leidingen met knelfittingen langs een muur', pos: '50% 45%', klein: true },
  { t: 'Vloerverwarming', d: 'Complete cv-installaties met radiatoren, of radiatoren in combinatie met vloerverwarming.', src: vloer1, alt: 'Vloerverwarming gelegd tijdens een verbouwing aan de Drieplassenweg in Katwijk', pos: '50% 50%', eigen: true },
];

const onderhoudspunten = [
  'Reinigen en afstellen van het toestel', 'Bijvullen van de installatie', 'Testen van cv en warmwatervoorziening', 'Testen van de kamerthermostaat',
  'Visuele inspectie van ketel en installatie', 'Visuele inspectie van de opstellingsruimte', 'Stookrapport en rendementsmeting', 'Reinigen van de mechanische afzuiging',
];

const stappen = [
  ['Bel of app', 'Vertel kort wat er speelt: een storing, onderhoud of een nieuwe installatie.'],
  ['Opname bij u thuis', 'We komen de situatie bij u thuis bekijken en bespreken uw wensen persoonlijk.'],
  ['Offerte op maat', 'U ontvangt een kosteloze offerte op maat, zonder verplichtingen.'],
  ['Binnen enkele dagen', 'Een nieuwe ketel is meestal binnen enkele dagen geplaatst.'],
  ['Jaarlijks onderhoud', 'Met een onderhoudscontract komen we één keer per jaar langs.'],
];

const projecten = [
  { src: vloer2, alt: 'Vloerverwarmingsbuizen in een spiraalpatroon op een verbouwde begane grond', t: 'Vloerverwarming', p: 'Verbouwing woonhuis Drieplassenweg, Katwijk', groot: true },
  { src: vloerSet, alt: 'Verdeler voor vloerverwarming met pomp en manometer op een houten wand', t: 'Verdeler en pomp', p: 'Drieplassenweg, Katwijk' },
  { src: ketelDetail, alt: 'Geopende Remeha Avanta-ketel met zicht op brander en leidingen', t: 'Remeha Avanta', p: 'Ketelvervanging, Leiden' },
  { src: thermostaat, alt: 'Remeha iSense-kamerthermostaat op 19 graden', t: 'Remeha iSense', p: 'Kamerthermostaat' },
  { src: ketelLeiden, alt: 'Remeha Avanta-ketel met regelunit tegen een betonnen wand', t: 'Nieuwe ketel geplaatst', p: 'Woonhuis in Leiden' },
];
---
<Base title={`${site.naam} | Installatiebedrijf in Katwijk`} description="CV-ketel vervangen, onderhoud en storingen, airconditioning, sanitair en leidingwerk in Katwijk. Erkend dealer van Vaillant, Nefit, Intergas en Remeha. Meer dan 25 jaar ervaring.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#17191c59_0%,#17191cc7_45%,#17191cf5_100%)] md:bg-[linear-gradient(90deg,#17191cf7_0%,#17191cd9_45%,#17191c4d_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Installatiebedrijf in Katwijk</p>
          <h1 id="t-hero" class="mt-5 text-hero">Een binnenklimaat waar u op kunt <span class="text-gloed">vertrouwen.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">CV-ketels, airconditioning, sanitair en leidingwerk. Installatie, onderhoud en storingen, met meer dan 25 jaar ervaring.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-koper"><Icoon naam="wa" />Offerte via WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand op-foto num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><Icoon naam="ster" class="h-4 w-4 text-ster" /><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 7.00 tot 17.00 uur</span></li>
          </ul>
        </div>
        <figure class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto max-w-[20rem] rounded-lg bg-nacht/70 p-6 ring-1 ring-licht/15 backdrop-blur-md">
            <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            <blockquote class="mt-4 font-kop text-xl font-bold leading-snug text-licht">“Tot onze verbazing stond de monteur binnen een uur al voor de deur.”</blockquote>
            <figcaption class="mt-4 flex items-center gap-2 text-sm text-licht-zacht"><Icoon naam="g" class="h-4 w-4" />Google review</figcaption>
          </div>
        </figure>
      </div>
    </section>

    <!-- 2. Merken -->
    <section class="border-b border-lijn bg-wit" aria-label="Erkend dealer">
      <div class="wrap flex flex-col gap-4 py-6 md:flex-row md:items-center md:justify-between md:gap-8">
        <p class="text-sm font-semibold uppercase tracking-[.14em] text-grijs">Erkend dealer van</p>
        <ul class="flex flex-wrap items-center gap-x-8 gap-y-2 md:gap-x-12">
          {merken.map((m) => <li class="font-kop text-2xl font-black tracking-[-0.02em] text-inkt/80">{m}</li>)}
        </ul>
        <p class="text-sm text-grijs">Desgewenst ook andere merken.</p>
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-4 text-3xl">Verwarming, koeling, water en gas.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Voor woningen, praktijkruimtes en bedrijven in Katwijk en omgeving. Klik op een dienst om direct uw vraag te stellen.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={b.eigen || b.klein ? [365, b.src.width] : [400, 600, 800]} sizes="(min-width: 1024px) 380px, 46vw" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[4/3]" style={`object-position:${b.pos}`} />
                  {b.eigen && <span class="absolute left-3 top-3 rounded-md bg-nacht/80 px-2.5 py-1 text-xs font-semibold text-licht backdrop-blur">Eigen werk</span>}
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-4 sm:p-6">
                  <div>
                    <h3 class="text-[1.0625rem] hyphens-auto sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-[.7rem] bg-zand text-koper transition-colors group-hover:bg-koper group-hover:text-wit sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Ketelcheck (wow) -->
    <section id="ketelcheck" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-check">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10 [&>*]:min-w-0">
        <div class="lg:col-span-5">
          <p class="eyebrow">Ketelcheck</p>
          <h2 id="t-check" class="mt-4 text-3xl">Repareren of vervangen?</h2>
          <p class="mt-6 text-lg text-licht-zacht">De vraag die John het vaakst krijgt: hoe lang gaat mijn ketel nog mee? Vul drie dingen in en zie wat zijn vuistregels zeggen. Het advies stuurt u daarna in één keer door via WhatsApp.</p>
          <div class="mt-10 rounded-lg bg-nacht-2 p-5 ring-1 sm:p-6 ring-lijn-licht">
            <p class="flex items-center gap-3 font-kop text-xl font-extrabold"><span class="hidden h-10 w-10 shrink-0 sm:grid place-items-center rounded-[.65rem] bg-koper text-wit"><Icoon naam="meter" class="h-5 w-5" /></span>Onderhoudscontract</p>
            <p class="mt-3 text-[.9375rem] text-licht-zacht">Eén keer per jaar komen we uw ketel of boiler schoonmaken en controleren. Toch een storing? Hulp tegen normaal monteurstarief, ook in het weekend en op feestdagen.</p>
            <ul class="mt-4 grid gap-x-6 gap-y-2 text-[.9375rem] sm:grid-cols-2">
              {onderhoudspunten.map((o) => <li class="flex gap-2.5"><Icoon naam="vink" class="mt-1 h-4 w-4 shrink-0 text-gloed" /><span>{o}</span></li>)}
            </ul>
          </div>
        </div>
        <form class="rounded-lg bg-nacht-2 p-6 ring-1 ring-lijn-licht sm:p-8 lg:col-span-7 lg:p-10" data-check aria-describedby="check-uitleg">
          <p id="check-uitleg" class="sr-only">Het advies verandert direct als u iets aanpast. Er wordt niets verstuurd.</p>
          <label class="block">
            <span class="flex items-baseline justify-between text-sm font-semibold"><span>Hoe oud is uw ketel?</span><output class="num font-kop text-2xl font-black text-gloed" data-leeftijd-uit>11 jaar</output></span>
            <input type="range" name="leeftijd" min="0" max="25" value="11" class="schuif mt-4 w-full" />
            <span class="mt-1 flex justify-between text-xs text-licht-zacht"><span>nieuw</span><span>25 jaar of ouder</span></span>
          </label>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat voor ketel is het?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['HR-ketel', 'VR-ketel', 'Conventionele ketel', 'Weet ik niet'].map((b, i) => (
                <label class="keuze"><input type="radio" name="type" value={b} class="sr-only" checked={i === 0} /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-7">
            <legend class="text-sm font-semibold">Wat speelt er?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Jaarlijks onderhoud', 'Storing of dure reparatie', 'Meer comfort of lagere stookkosten'].map((b, i) => (
                <label class="keuze"><input type="radio" name="sit" value={b} class="sr-only" checked={i === 1} /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-8 rounded-lg bg-papier p-6 text-inkt" aria-live="polite">
            <p class="text-xs font-bold uppercase tracking-[.14em] text-koper" data-label>Advies</p>
            <p class="mt-2 font-kop text-2xl font-extrabold leading-tight" data-kop>Vervanging overwegen</p>
            <p class="mt-2 text-grijs" data-tekst></p>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={waOfferte} class="knop knop-koper" data-check-wa><Icoon naam="wa" />Stuur naar John</a>
            <p class="text-sm text-licht-zacht">Een indicatie. Het echte advies volgt na inspectie.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 5. Werkwijze -->
    <section class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van eerste telefoontje tot warme radiatoren.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Om precies te bepalen wat in uw situatie nodig is, komen we altijd eerst kijken.</p>
        </div>
        <ol class="mt-12 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:mt-14 lg:grid-cols-5">
          {stappen.map(([t, d], i) => (
            <li class="rijs border-t-2 border-inkt/15 pt-5" style={`--d:${i * 0.06}s`}>
              <p class="flex items-baseline gap-3"><span class="num font-kop text-2xl font-black text-koper">0{i + 1}</span><span class="font-kop text-xl font-extrabold">{t}</span></p>
              <p class="mt-2 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. Projecten -->
    <section id="projecten" class="bg-zand py-20 lg:py-24" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-4 text-3xl">Uit eigen werk.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Vloerverwarming bij een verbouwing in Katwijk en een ketelvervanging in Leiden, met een Remeha Avanta en iSense-thermostaat.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14">
          {projecten.map((w, i) => (
            <li class={`rijs group relative overflow-hidden rounded-lg bg-nacht ${w.groot ? 'col-span-2 row-span-2 aspect-[4/3] md:aspect-auto' : 'aspect-[4/3]'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={[365]} sizes={w.groot ? '(min-width: 768px) 50vw, 92vw' : '(min-width: 768px) 25vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
              <div class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#17191ce6,#17191c00)] p-4 pt-10 text-licht">
                <p class="font-kop font-extrabold leading-tight">{w.t}</p>
                <p class="text-xs text-licht/80">{w.p}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Over John -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[18rem] sm:min-h-[24rem] lg:col-span-6">
          <Image src={bus} alt="John van Duijvenvoorde naast zijn witte bestelbus met de belettering JD installatie en onderhoud" widths={[640, 800]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[55%_50%]" />
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-14 lg:py-20 xl:pr-[max(3.5rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over John</p>
          <h2 id="t-over" class="mt-4 text-3xl">Uw vaste installateur in Katwijk.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Achter JD Installatie en Onderhoud staat {site.eigenaar}. Met specialistische kennis van installatietechniek komt hij in overleg met u tot een passende oplossing, voor een nieuwe ketel net zo goed als voor een lekkende stortbak.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-3.5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-[.7rem] bg-koper text-wit"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Meedenken en terugkoppelen</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">U hoort tussendoor hoe het ervoor staat.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-3.5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-[.7rem] bg-koper text-wit"><Icoon naam="handdruk" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Afspraak is afspraak</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Afspraken nakomen is waar het bedrijf op gebouwd is.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-3.5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-[.7rem] bg-koper text-wit"><Icoon naam="oog" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Eerlijk advies</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Objectief, zonder dat commercie een rol speelt.</p></div>
            </li>
          </ul>
          <a href={site.telHref} class="knop knop-koper mt-8 num"><Icoon naam="tel" />Bel John: {site.tel}</a>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-black">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[86%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-zand font-kop font-black text-koper" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <ul class="mt-5 grid gap-3 md:grid-cols-2 md:gap-5">
          {citaten.map((c) => <li class="rijs flex items-center gap-4 rounded-md bg-zand px-6 py-5"><Icoon naam="g" class="h-5 w-5 shrink-0" /><p class="font-kop text-lg font-bold">“{c}”</p></li>)}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <!-- 10. Contact -->
    <section id="contact" class="py-20 lg:py-24" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Contact</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Vraag een offerte aan.</h2>
          <p class="mt-6 text-lg text-grijs">Kosteloos en vrijblijvend. Vertel kort wat u zoekt, dan maakt John een afspraak om de situatie bij u thuis te bekijken.</p>
          <div id="route" class="kaart mt-10 p-6 md:p-7">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Bereikbaar</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr bereikbaar</span></p>
            </div>
            <table class="mt-3 w-full">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                <tr data-dagen="1 2 3 4 5" class="border-b border-lijn data-[vandaag]:font-semibold data-[vandaag]:text-koper"><th scope="row" class="py-2 pr-4 text-left font-[inherit]">Maandag t/m vrijdag</th><td class="num py-2 text-right">07.00 - 17.00 uur</td></tr>
                <tr data-dagen="6 0" class="data-[vandaag]:font-semibold data-[vandaag]:text-koper"><th scope="row" class="py-2 pr-4 text-left font-[inherit]">Zaterdag en zondag</th><td class="py-2 text-right">Gesloten</td></tr>
              </tbody>
            </table>
            <ul class="mt-4 grid gap-3 border-t border-lijn pt-5">
              <li><a href={site.telHref} class="flex items-center gap-3 font-semibold no-underline hover:text-koper"><Icoon naam="tel" class="h-5 w-5 shrink-0 text-koper" /><span class="num whitespace-nowrap">{site.tel}</span><span class="font-normal text-grijs">bellen of WhatsApp</span></a></li>
              <li><a href={`mailto:${site.mail}`} class="flex items-center gap-3 font-semibold no-underline hover:text-koper"><Icoon naam="mail" class="h-5 w-5 shrink-0 text-koper" />{site.mail}</a></li>
              <li class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-5 w-5 shrink-0 text-koper" /><span><b class="font-semibold">{site.straat}</b>, <span class="text-grijs">{site.postcode} {site.plaats}</span><br /><a href={site.maps} class="link text-sm font-semibold">Route plannen</a></span></li>
            </ul>
          </div>
        </div>
        <form class="kaart p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw aanvraag</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Waar gaat het om?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Nieuwe cv-ketel', 'Onderhoud', 'Storing', 'Airco', 'Sanitair', 'Leidingwerk', 'Vloerverwarming'].map((b) => (
                <label class="keuze licht"><input type="radio" name="dienst" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block"><span class="text-sm font-semibold">Postcode of plaats</span><input name="plaats" autocomplete="postal-code" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: ketel uit 2012, geen warm water meer"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-koper"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Foto's van de situatie kunt u daarna meesturen.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="bg-koper text-wit" aria-label="Contact">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Verwarming kapot of toe aan een nieuwe ketel?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel of app John, dan kijken we wat er nodig is.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp</a>
          <a href={site.telHref} class="knop knop-rand op-foto num"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Ketelcheck: vuistregels van hun eigen pagina "CV-ketel vervangen?".
  const c = document.querySelector<HTMLFormElement>('[data-check]');
  if (c) {
    const uit = c.querySelector<HTMLElement>('[data-leeftijd-uit]')!;
    const kop = c.querySelector<HTMLElement>('[data-kop]')!;
    const tekst = c.querySelector<HTMLElement>('[data-tekst]')!;
    const wa = c.querySelector<HTMLAnchorElement>('[data-check-wa]')!;
    const werk = () => {
      const d = new FormData(c);
      const jaar = Number(d.get('leeftijd'));
      const type = String(d.get('type'));
      const sit = String(d.get('sit'));
      const oud = type === 'VR-ketel' || type === 'Conventionele ketel';
      uit.textContent = jaar >= 25 ? '25+ jaar' : `${jaar} jaar`;
      let k: string, t: string;
      if (sit === 'Meer comfort of lagere stookkosten') {
        k = 'Advies op maat'; t = 'Uw gasverbruik, de gezinssamenstelling en de opstelling van de ketel bepalen samen welk type ketel het beste past. John komt het bij u thuis opnemen.';
      } else if (sit === 'Storing of dure reparatie' && (jaar >= 10 || oud)) {
        k = 'Vervanging overwegen'; t = 'Is uw ketel 10 jaar of ouder en staat er een dure reparatie aan te komen, dan is vervangen vaak verstandiger. Zeker bij een conventionele of VR-ketel verdient een nieuwe, zuinige ketel de reparatiekosten snel terug.';
      } else if (jaar >= 12) {
        k = 'Tijd voor een inspectie'; t = 'Veel onderdelen zijn na ongeveer 12 jaar versleten. Ze zijn niet kapot, maar werken niet meer optimaal. Laat de ketel nakijken; vervanging is niet altijd direct nodig.';
      } else if (sit === 'Storing of dure reparatie') {
        k = 'Repareren loont'; t = 'Een ketel van deze leeftijd is meestal prima te repareren. Zolang er onderdelen te krijgen zijn, kan een ketel lang mee.';
      } else {
        k = 'Onderhoudsbeurt'; t = 'Reinigen, afstellen en controleren, met een stookrapport erbij. Met een onderhoudscontract hoeft u er niet meer aan te denken.';
      }
      kop.textContent = k; tekst.textContent = t;
      const msg = ['Goedendag John, ik heb de ketelcheck op uw website gedaan.', `Ketel: ${type === "Weet ik niet" ? "type onbekend" : type}, ongeveer ${uit.textContent} oud.`, `Situatie: ${sit.toLowerCase()}.`, `Uitkomst: ${k.toLowerCase()}. Kunt u contact met me opnemen?`];
      wa.href = 'https://wa.me/31610395514?text=' + encodeURIComponent(msg.join('\n'));
    };
    c.addEventListener('input', werk); c.addEventListener('change', werk); c.addEventListener('submit', (e) => e.preventDefault());
    werk();
  }

  const vandaag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short' }).format(new Date()));
  document.querySelectorAll('[data-dagen]').forEach((r) => { if (r.getAttribute('data-dagen')!.split(' ').includes(String(vandaag))) r.setAttribute('data-vandaag', ''); });

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Goedendag John, ik wil graag een vrijblijvende offerte aanvragen.'];
      if (v('dienst')) r.push('Het gaat om: ' + v('dienst').toLowerCase());
      if (v('plaats')) r.push('Postcode/plaats: ' + v('plaats'));
      if (v('wens')) r.push('Toelichting: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31610395514?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

