---
// Hun eigen logo (EK-teken + EXPRESS KOZIJNEN), zonder de slogan eronder.
import { Image } from 'astro:assets';
import wit from '../assets/logo-wit.png';
import inkt from '../assets/logo-inkt.png';
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = 'w-[150px] md:w-[178px]' } = Astro.props;
---
<a href={url('')} class={`block no-underline ${cls}`}>
  <Image src={licht ? inkt : wit} alt="Express Kozijnen" width={360} class="h-auto w-full" loading="eager" />
</a>
