---
import { site, url, waHoi, bereikbaar } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-ral text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Kunststof, aluminium en houten kozijnen, deuren en rolluiken op maat.</p>
      <p class="mt-5 flex gap-4">
        <a href={site.insta} class="text-as transition-colors hover:text-wit" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
        <a href={site.fb} class="text-as transition-colors hover:text-wit" aria-label="Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="md:col-span-3">
      <p class="kop font-semibold text-wit">Producten</p>
      <ul class="mt-4 space-y-1.5">
        <li>Kunststof kozijnen</li><li>Aluminium kozijnen</li><li>Houten kozijnen</li><li>Deuren en schuifpuien</li><li>Rolluiken</li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="kop font-semibold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode}</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <a href={waHoi} class="link link-licht">(ook WhatsApp)</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-licht break-all">{site.mail}</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="kop font-semibold text-wit">Bereikbaar</p>
      <p class="mt-4 num">{bereikbaar.tekst}</p>
      <p class="mt-3">Afhalen alleen op afspraak.</p>
      <p class="mt-3 num">KvK {site.kvk}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten, specificaties en projecten van expresskozijnen.nl; foto's van jullie eigen website en Google-profiel. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
