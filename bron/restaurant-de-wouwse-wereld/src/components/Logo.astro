---
// Typografisch woordmerk: "wereld" als lijnbolletje in kaarslicht, naam in Faustina.
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg aria-hidden="true" viewBox="0 0 32 32" class="h-8 w-8 shrink-0"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.6" class={licht ? 'text-koper' : 'text-kaars'} /><ellipse cx="16" cy="16" rx="6" ry="13" fill="none" stroke="currentColor" stroke-width="1.3" class={licht ? 'text-koper' : 'text-kaars'} /><path d="M3 16h26M5.5 9.5h21M5.5 22.5h21" stroke="currentColor" stroke-width="1.1" class={licht ? 'text-koper' : 'text-kaars'} /></svg>
  <span class="flex flex-col leading-none">
    <span class={`eyebrow !text-[0.625rem] !tracking-[0.28em] ${licht ? 'text-inkt-zacht' : 'text-kaars-zacht'}`}>Restaurant</span>
    <span class="whitespace-nowrap font-display text-lg font-semibold tracking-[-0.01em] min-[380px]:text-xl">De Wouwse <em class="font-medium">Wereld</em></span>
  </span>
</span>
