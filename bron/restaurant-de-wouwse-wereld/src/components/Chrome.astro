---
import { site, url } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-lijn-licht bg-nacht/95 text-creme backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="no-underline"><Logo /></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={url('#menukaart')} class="no-underline transition-colors hover:text-kaars">Menukaart</a></li>
          <li><a href={url('#reserveren')} class="no-underline transition-colors hover:text-kaars">Reserveren</a></li>
          <li><a href={url('#contact')} class="no-underline transition-colors hover:text-kaars">Openingstijden en route</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-kaars !px-4 !py-2 text-sm"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg><span class="sm:hidden">Bel</span><span class="sr-only whitespace-nowrap tabular-nums sm:not-sr-only">{site.tel}</span></a>
    </div>
  </header>
) : (
  <footer class="bg-nacht pb-10 pt-14 text-creme/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo class="text-creme" />
        <p class="mt-5">{site.straat}<br />{site.postcode} {site.plaats}<br />{site.hoek}</p>
      </div>
      <p class="md:col-span-4"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline-offset-2 hover:underline">T {site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline-offset-2 hover:underline">{site.mail}</a><br /><span class="text-creme/70">KvK <span class="text-xs">[[AANLEVEREN: KvK-nummer]]</span></span></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-10 border-t border-lijn-licht pt-6 text-xs text-creme/70">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
