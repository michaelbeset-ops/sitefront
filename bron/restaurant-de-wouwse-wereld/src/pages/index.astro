---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Menukaart from '../components/Menukaart.astro';
import Reserveer from '../components/Reserveer.astro';
import { site, kaart } from '../data/site';
import zaal from '../assets/zaal.jpg';
import vlees from '../assets/vlees.jpg';
import vis from '../assets/vis.jpg';
import tafel from '../assets/tafel.jpg';
import kaars from '../assets/kaars.jpg';

const dagen = [
  { dag: 'Maandag', wd: 1, tijd: 'Gesloten' },
  { dag: 'Dinsdag', wd: 2, tijd: 'Gesloten' },
  { dag: 'Woensdag', wd: 3, tijd: 'vanaf 18.00' },
  { dag: 'Donderdag', wd: 4, tijd: 'vanaf 18.00' },
  { dag: 'Vrijdag', wd: 5, tijd: 'vanaf 18.00' },
  { dag: 'Zaterdag', wd: 6, tijd: 'vanaf 18.00' },
  { dag: 'Zondag', wd: 0, tijd: 'vanaf 18.00' },
];
---
<Base title={`${site.naam} | Wouw, geopend vanaf 18.00 uur`} description="Restaurant De Wouwse Wereld op de hoek Roosendaalsestraat - Markt in Wouw. Woensdag t/m zondag geopend vanaf 18.00 uur. Reserveren telefonisch of per mail.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative bg-nacht text-creme">
      <div class="wrap grid gap-10 pb-10 pt-12 lg:grid-cols-12 lg:gap-8 lg:pb-14 lg:pt-20">
        <div class="lg:col-span-8">
          <p class="eyebrow text-kaars">Wouw, {site.hoek}</p>
          <h1 class="mt-5 text-4xl font-semibold">
            <span class="block text-xl font-medium italic tracking-normal text-kaars-zacht sm:text-2xl">Restaurant</span>
            De Wouwse <em class="font-medium text-kaars">Wereld</em>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-creme/85">Geopend vanaf 18.00 uur, woensdag t/m zondag. Reserveren kan telefonisch of per mail.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-kaars"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            <a href="#menukaart" class="btn btn-lijn text-creme">Bekijk de menukaart <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
        </div>
        <div class="grid content-end gap-5 sm:grid-cols-2 lg:col-span-4 lg:grid-cols-1 lg:border-l lg:border-lijn-licht lg:pl-8">
          <dl class="grid grid-cols-2 gap-5 sm:col-span-2 lg:col-span-1">
            <div>
              <dt class="text-sm text-creme/75">Google</dt>
              <dd class="mt-1 font-display text-3xl font-semibold leading-none">{site.google.score} <span class="mt-1 block font-body text-sm font-normal text-creme/75 lg:mt-2">({site.google.aantal} reviews)</span></dd>
            </div>
            <div>
              <dt class="text-sm text-creme/75">Wo t/m zo vanaf</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-3xl font-semibold leading-none tabular-nums">18.00</dd>
            </div>
          </dl>
          <div class="sm:col-span-2 lg:col-span-1"><Status /></div>
        </div>
      </div>
      <div class="relative">
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-creme" aria-hidden="true"></div>
        <div class="wrap relative">
          <figure class="relative overflow-hidden rounded-2xl shadow-xl lg:mx-10">
            <div class="aspect-[4/3] sm:aspect-[16/8]">
              <Foto src={zaal} alt="Sfeerbeeld: houten tafel met een brandend waxinelichtje in een donker restaurant" class="object-[center_62%]" hero sizes="(min-width: 1200px) 1100px, 100vw" />
            </div>
            <figcaption class="absolute bottom-4 left-4 rounded-lg bg-nacht/85 px-3 py-1.5 text-xs font-semibold text-creme backdrop-blur-sm">Woensdag t/m zondag vanaf 18.00 uur</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- GOED OM TE WETEN -->
    <section class="licht bg-creme pb-16 pt-14 lg:pb-24 lg:pt-20" aria-labelledby="weten">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-koper">Goed om te weten</p>
          <h2 id="weten" class="mt-3 text-3xl">Reserveren kan telefonisch of per mail</h2>
        </div>
        <ol class="grid gap-px overflow-hidden rounded-xl bg-lijn shadow-sm ring-1 ring-lijn sm:grid-cols-2 lg:col-span-8">
          <li class="bg-papier p-6">
            <span class="font-display text-lg italic text-koper">01</span>
            <h3 class="mt-2 text-xl">Telefonisch</h3>
            <p class="mt-2 text-inkt-zacht">Om teleurstellingen te voorkomen is reserveren (graag telefonisch) gewenst.</p>
            <a href={site.telHref} class="mt-3 inline-block whitespace-nowrap font-semibold tabular-nums text-koper underline underline-offset-4">{site.tel}</a>
          </li>
          <li class="bg-papier p-6">
            <span class="font-display text-lg italic text-koper">02</span>
            <h3 class="mt-2 text-xl">Per mail</h3>
            <p class="mt-2 text-inkt-zacht">Mail ons de datum, de tijd en met hoeveel personen u komt.</p>
            <a href={`mailto:${site.mail}`} class="mt-3 inline-block break-all font-semibold text-koper underline underline-offset-4">{site.mail}</a>
          </li>
          <li class="bg-papier p-6">
            <span class="font-display text-lg italic text-koper">03</span>
            <h3 class="mt-2 text-xl">Niet via Facebook of een reserveringssite</h3>
            <p class="mt-2 text-inkt-zacht">Wij zijn niet aangesloten bij een online reservering site (denk aan eet.nu / butler o.i.d.).</p>
          </li>
          <li class="bg-papier p-6">
            <span class="font-display text-lg italic text-koper">04</span>
            <h3 class="mt-2 text-xl">Allergenen</h3>
            <p class="mt-2 text-inkt-zacht">Een allergenenlijst is op papier aanwezig op locatie.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- MENUKAART -->
    <section id="menukaart" class="licht scroll-mt-16 bg-papier py-16 lg:py-24" aria-labelledby="kaartkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-24">
            <p class="eyebrow text-koper">Menukaart</p>
            <h2 id="kaartkop" class="mt-3 text-3xl">Van carpaccio tot Chateaubriand</h2>
            <p class="mt-4 text-inkt-zacht">De hele kaart met prijzen, van koude voorgerechten tot de DagHap.</p>
            <figure class="mt-8 hidden overflow-hidden rounded-xl shadow-sm lg:block">
              <div class="aspect-[4/5]"><Foto src={vlees} alt="Sfeerbeeld: plakjes rosé gebakken rundvlees met sperziebonen en aardappel op een donker bord" sizes="400px" /></div>
            </figure>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-8">
          <Menukaart />
        </div>
      </div>
    </section>

    <!-- FOTOSTROOK -->
    <section class="bg-nacht py-16 text-creme lg:py-24" aria-label="Sfeerbeelden">
      <div class="wrap">
        <p class="eyebrow text-kaars">Van de kaart</p>
        <ul class="mt-4 max-w-5xl font-display text-2xl font-medium italic leading-snug text-creme sm:text-3xl">
          {['Rivierkreeft cocktail met avocado', 'Gerookte paling', 'Ossenhaas van limousin', 'Vispotje Wouwse Wereld', 'Papboerke'].map((g, i, a) => (
            <li class="inline">{g}{i < a.length - 1 && <span aria-hidden="true" class="mx-3 align-middle text-base not-italic text-kaars">&#9679;</span>} </li>
          ))}
        </ul>
      </div>
      <div class="wrap mt-10 grid gap-4 md:grid-cols-12 md:gap-5 lg:mt-14">
        <figure class="overflow-hidden rounded-xl md:col-span-7 md:row-span-2">
          <div class="aspect-[4/3] h-full md:aspect-auto"><Foto src={vis} alt="Sfeerbeeld: gebakken visfilet met rode biet en aardappel op een grijs bord" sizes="(min-width: 768px) 60vw, 100vw" /></div>
        </figure>
        <figure class="overflow-hidden rounded-xl md:col-span-5">
          <div class="aspect-[3/2]"><Foto src={tafel} alt="Sfeerbeeld: een bord salade wordt opgediend aan een tafel met kaars en een glas rode wijn" sizes="(min-width: 768px) 40vw, 100vw" /></div>
        </figure>
        <figure class="overflow-hidden rounded-xl md:col-span-5">
          <div class="aspect-[3/2]"><Foto src={kaars} alt="Sfeerbeeld: waxinelichtje en een vaasje met distels op een houten tafel" sizes="(min-width: 768px) 40vw, 100vw" /></div>
        </figure>
      </div>
    </section>

    <!-- RESERVEREN -->
    <section id="reserveren" class="scroll-mt-16 bg-nacht-2 py-16 text-creme lg:py-24" aria-labelledby="reskop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-kaars">Reserveren</p>
          <h2 id="reskop" class="mt-3 text-3xl">Een tafel reserveren</h2>
          <p class="mt-5 text-creme/85">Reserveren kan telefonisch op <span class="whitespace-nowrap tabular-nums">{site.tel}</span> of per mail, niet via Facebook. Wij zijn niet aangesloten bij een online reservering site (denk aan eet.nu / butler o.i.d.).</p>
          <p class="mt-4 text-creme/85">Tapas Grande serveren wij alleen op reservering vooraf en per tafel.</p>
          <div class="mt-8 border-t border-lijn-licht pt-6">
            <p class="text-sm text-creme/75">Telefoon</p>
            <a href={site.telHref} class="mt-1 block whitespace-nowrap font-display text-3xl font-semibold tabular-nums text-kaars no-underline transition-colors hover:text-kaars-zacht">{site.tel}</a>
            <p class="mt-5 text-sm text-creme/75">E-mail</p>
            <a href={`mailto:${site.mail}`} class="mt-1 block break-all text-lg font-semibold text-creme underline-offset-4 hover:underline">{site.mail}</a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <Reserveer />
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="licht scroll-mt-16 bg-creme py-16 lg:py-24" aria-labelledby="contactkop">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-koper">Route</p>
          <h2 id="contactkop" class="mt-3 text-3xl">Op de hoek van de Markt</h2>
          <address class="mt-6 not-italic text-lg">
            <strong class="font-display text-2xl font-semibold">{site.naam}</strong><br />
            {site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-inkt-zacht">{site.hoek}</span>
          </address>
          <p class="mt-3"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline-offset-4 hover:underline">T {site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline-offset-4 hover:underline">{site.mail}</a></p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.maps} class="btn btn-koper">Route plannen <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            <a href={site.telHref} class="btn btn-lijn text-inkt hover:!bg-nacht hover:!text-creme hover:!shadow-none"><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-xl bg-papier p-6 shadow-sm ring-1 ring-lijn sm:p-8">
            <h3 class="text-2xl">Openingstijden</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden per dag</caption>
              <tbody>
                {dagen.map((d) => (
                  <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                    <th scope="row" class="py-3 font-semibold">{d.dag}</th>
                    <td class={`whitespace-nowrap py-3 text-right tabular-nums ${d.tijd === 'Gesloten' ? 'text-inkt-zacht' : 'font-semibold'}`}>{d.tijd}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="mt-6 rounded-lg bg-nacht p-5 text-creme">
              <p class="eyebrow text-kaars">Vakantiesluiting</p>
              <p class="mt-2 font-display text-xl font-semibold"><span class="whitespace-nowrap">12 september</span> t/m <span class="whitespace-nowrap">4 oktober 2026</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-koper); }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  import { nuInWouw } from '../scripts/open';
  const wd = nuInWouw().dag.wd;
  document.querySelector(`.dagrij[data-wd="${wd}"]`)?.classList.add('vandaag');
</script>
