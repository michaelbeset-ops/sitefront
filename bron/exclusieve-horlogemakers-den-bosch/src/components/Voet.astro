---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="border-t border-lijn bg-nacht text-zacht">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.875rem] md:grid-cols-12 md:py-20">
    <div class="text-ivoor md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-zacht">Onafhankelijk horlogeatelier in 's-Hertogenbosch. Niet geautoriseerd door de horlogemerken.</p>
    </div>
    <div class="md:col-span-2">
      <p class="label text-salie">Atelier</p>
      <ul class="mt-4 space-y-1">
        <li><a href={url('#diensten')} class="no-underline hover:text-salie">Onderhoud en revisie</a></li>
        <li><a href={url('#diensten')} class="no-underline hover:text-salie">Reparatie</a></li>
        <li><a href={url('#vintage')} class="no-underline hover:text-salie">Vintage</a></li>
        <li><a href={url('#diensten')} class="no-underline hover:text-salie">Polijsten</a></li>
        <li><a href={url('#opsturen')} class="no-underline hover:text-salie">Opsturen</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="label text-salie">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp <span class="num">{site.waTel}</span></a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link">info@exclusieve<wbr />horlogemakers.nl</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="label text-salie">Uitsluitend op afspraak</p>
      <dl class="mt-4 space-y-1">
        {tijden.map(([d, t]) => (
          <div class="flex justify-between gap-6 sm:max-w-xs"><dt>{d}</dt><dd class="num">{t}</dd></div>
        ))}
      </dl>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam} · KvK <span class="num">{site.kvk}</span></p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-salie">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Teksten en foto's van jullie eigen website en Google-profiel. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
