---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['atelier', 'Atelier'], ['diensten', 'Diensten'], ['opsturen', 'Opsturen'], ['reviews', 'Ervaringen'], ['aanmelden', 'Contact']];
---
<header class={thuis ? 'absolute inset-x-0 top-0 z-40' : 'relative z-40 border-b border-lijn'}>
  <div class="wrap flex h-24 items-center justify-between gap-6">
    <Merk />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[.8125rem] tracking-[.04em]">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-ivoor/85 no-underline transition-colors duration-300 hover:text-salie">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-6">
      <a href={site.telHref} class="num hidden text-[.8125rem] tracking-[.06em] text-ivoor/85 no-underline transition-colors hover:text-salie xl:block">{site.tel}</a>
      <a href={waHoi} class="knop hidden min-h-11 px-5 md:inline-flex"><Icoon naam="wa" />Afspraak maken</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-ivoor lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 9h18M3 15h18" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden bg-nacht lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn py-4 font-kop text-3xl no-underline">{t}</a></li>)}
      <li class="pt-6"><a href={site.telHref} class="num text-sm tracking-[.06em] text-zacht no-underline">{site.tel}</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-lijn bg-nacht/95 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn text-[.8125rem] font-medium tracking-[.06em] no-underline"><Icoon naam="tel" class="h-4 w-4 text-salie" />Bellen</a>
  <a href={waHoi} class="flex min-h-14 items-center justify-center gap-2.5 text-[.8125rem] font-medium tracking-[.06em] no-underline"><Icoon naam="wa" class="h-4 w-4 text-salie" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
