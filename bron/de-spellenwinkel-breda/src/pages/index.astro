---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Pion from '../components/Pion.astro';
import { site, tijden, reviews, waHoi, waMet } from '../data/site';

import gevel from '../assets/gevel.jpg';
import binnen from '../assets/binnen.jpg';
import krijtbord from '../assets/krijtbord.jpg';
import puzzeltoren from '../assets/puzzeltoren.jpg';
import stapels from '../assets/stapels.jpg';
import xxl from '../assets/xxl.jpg';

const shop = (pad: string) => `https://despellenwinkelbreda.nl/nl/${pad}`;

// Categorieën en aantallen zoals de webshop ze toont ("Er zijn N producten", 6 oktober 2026).
const kasten = [
  {
    titel: 'Spellen',
    rijen: [
      ['Kaartspellen', 317, '21-kaartspellen'],
      ['Bordspellen', 300, '19-bordspellen'],
      ['Doelgroepspellen', 129, '20-doelgroepspellen'],
      ['Dobbelspellen', 54, '31-dobbelspellen'],
      ['1-persoonsspellen', 54, '30-1-persoonsspellen'],
      ['Schaak', 7, '10-schaak'],
    ],
  },
  {
    titel: 'Puzzelen en erbij',
    rijen: [
      ['Legpuzzels', 76, '7-legpuzzels'],
      ['Breinbrekers', 52, '32-breinbrekers'],
      ['Dobbelstenen', 35, '9-dobbelstenen'],
      ['Accessoires', 27, '25-accessoires'],
      ['Speelkaarten', 7, '8-speelkaarten'],
    ],
  },
] as const;

// Spel-tip: alleen soorten die ze echt voeren. Waarde = [tekst in de zin, webshop-categorie of '' als die er niet is].
const soorten = [
  ['bordspel', '19-bordspellen'],
  ['kaartspel', '21-kaartspellen'],
  ['dobbelspel', '31-dobbelspellen'],
  ['breinbreker', '32-breinbrekers'],
  ['legpuzzel', '7-legpuzzels'],
  ['spel voor de klas of zorg', '20-doelgroepspellen'],
  ['Trading Card Game', ''],
];
const spelers = ['1 speler', '2 spelers', '3 of 4 spelers', 'een grote groep'];
const voorWie = ['kinderen', 'de hele familie', 'volwassenen', 'echte spelfanaten'];

const titel = 'Dé Spellenwinkel Breda | Spellen en puzzels sinds 2008';
const omschrijving = 'Dé Spellenwinkel, Speelhuislaan 68B in Breda: bordspellen, kaartspellen, puzzels en breinbrekers, op 3 minuten lopen van het station. Vraag Margot om een spel-tip via WhatsApp.';
const r = (i: number) => reviews[i];
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: grote kop, daaronder hun eigen gevel met de leentafel -->
    <section class="pb-16 pt-10 md:pb-24 md:pt-14">
      <div class="wrap grid items-end gap-y-8 lg:grid-cols-12 lg:gap-x-12">
        <h1 class="text-hero text-paars lg:col-span-8">Een winkel vol spel- en puzzel&shy;plezier</h1>
        <div class="lg:col-span-4 lg:pb-3">
          <p class="text-lg text-grijs">Bordspellen, kaartspellen, puzzels en breinbrekers. Aan de Speelhuislaan in Breda, op 3 minuten lopen van het station.</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waHoi} class="knop"><Icoon naam="wa" />App Margot</a>
            <a href={site.shop} class="link font-bold text-paars">Naar de webshop</a>
          </div>
        </div>
      </div>
      <figure class="wrap mt-10 md:mt-14">
        <Image src={gevel} alt="De etalage van Dé Spellenwinkel met het logo op het raam, spellen in de etalage en buiten een houten tafeltje met stoelen en spellen" quality={55} widths={[480, 720, 960, 1280, 1440]} sizes="(min-width: 1280px) 1200px, 100vw" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full rounded-md object-cover object-[50%_60%] md:aspect-[21/10] lg:aspect-[21/9]" />
        <figcaption class="mt-3 flex flex-wrap justify-between gap-x-6 gap-y-1 text-xs text-grijs">
          <span>{site.straat}, {site.plaats}</span>
          <span><span data-status></span></span>
        </figcaption>
      </figure>
    </section>

    <!-- 2. DE WINKEL: binnen, krijtbord, Margot -->
    <section id="winkel" class="bg-paars-diep py-20 text-wit md:py-28">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-7">
          <Image src={binnen} alt="Het gangpad in de winkel: links en rechts kasten tot aan het plafond vol spellen en puzzels, in het midden tafels met stapels dozen" quality={62} widths={[400, 600, 800, 1100]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[4/5] w-full rounded-md object-cover object-[50%_40%] md:aspect-[5/4] lg:aspect-[4/5]" />
        </figure>
        <div class="flex flex-col lg:col-span-5">
          <h2 class="rijs text-3xl">Kom binnen en vraag het Margot</h2>
          <p class="rijs mt-6 max-w-md text-lg text-lila">In de winkel staat veel meer dan in de webshop. Vertel wat je graag speelt, dan helpt Margot je op weg.</p>
          <blockquote class="rijs mt-10 border-l-4 border-pion pl-5">
            <p class="text-lg italic">“{r(0).tekst}”</p>
            <footer class="mt-2 text-sm text-lila">{r(0).naam} op Google</footer>
          </blockquote>
          <figure class="rijs mt-12 grid grid-cols-[7.5rem_1fr] items-center gap-5 sm:grid-cols-[10rem_1fr] lg:mt-auto">
            <Image src={krijtbord} alt="Krijtbord met de tekst: Vraag gerust naar: de 50% kortingkast, de volgende Altered-avond, reserveren voor Monopoly Breda-spel" quality={62} widths={[160, 240, 320]} sizes="10rem" class="aspect-[4/5] w-full rounded-sm object-cover" />
            <figcaption class="text-sm text-lila"><span class="font-bold text-wit">Vraag gerust naar</span> de 50%-kortingkast, de volgende Altered-avond en Monopoly Breda.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 3. COLLECTIE: inventaris als een spelregelboekje, met links naar hun webshop -->
    <section id="collectie" class="py-20 md:py-28">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <h2 class="rijs text-3xl text-paars lg:col-span-7">Ruim duizend spellen online, nog meer in de winkel</h2>
          <p class="rijs self-end text-grijs lg:col-span-4 lg:col-start-9">Bestel in de webshop en laat het verzenden, of haal het op in de winkel.</p>
        </div>

        <div class="mt-14 grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
          <div class="grid gap-y-12 sm:grid-cols-2 sm:gap-x-10 lg:col-span-7">
            {kasten.map((k) => (
              <div class="rijs">
                <h3 class="flex items-center gap-3 text-2xl"><Pion class="h-7 w-auto" lach={false} />{k.titel}</h3>
                <ul class="mt-5">
                  {k.rijen.map(([naam, aantal, pad]) => (
                    <li>
                      <a href={shop(pad)} class="group flex items-baseline gap-3 border-b border-lijn py-3 no-underline">
                        <span class="font-bold text-inkt transition-colors group-hover:text-paars">{naam}</span>
                        <span class="mb-1 flex-1 border-b-2 border-dotted border-lijn" aria-hidden="true"></span>
                        <span class="num text-sm text-grijs">{aantal}</span>
                        <Icoon naam="pijl" class="h-4 w-4 flex-none self-center text-paars transition-transform group-hover:translate-x-1" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="rijs text-sm text-grijs sm:col-span-2">Aantallen in de webshop. In de winkel ook Trading Card Games: Altered, Star Wars Unlimited en Lorcana.</p>
          </div>
          <div class="grid grid-cols-2 items-start gap-4 lg:col-span-5">
            <Image src={puzzeltoren} alt="Torens van gestapelde legpuzzeldozen tot hoog in de winkel" quality={62} widths={[240, 360, 480]} sizes="(min-width: 1024px) 20vw, 50vw" class="rijs aspect-[3/4] w-full rounded-md object-cover" />
            <Image src={stapels} alt="Stapels nieuwe spellen in plastic op een tafel in de winkel" quality={62} widths={[240, 360, 480]} sizes="(min-width: 1024px) 20vw, 50vw" class="rijs mt-16 aspect-[3/4] w-full rounded-md object-cover" style="--d:.1s" />
          </div>
        </div>
      </div>
    </section>

    <!-- 4. SPEL-TIP: één zin, eindigt in WhatsApp -->
    <section id="speltip" class="relative overflow-hidden bg-paars py-20 text-wit md:py-28" aria-labelledby="tip-titel">
      <Pion class="pointer-events-none absolute -bottom-2 right-[7%] hidden h-[78%] w-auto lg:block" />
      <div class="wrap relative">
        <h2 id="tip-titel" class="sr-only">Vraag een spel-tip</h2>
        <form class="max-w-5xl lg:max-w-[68%]" data-tip>
          <p class="font-kop text-[clamp(2rem,3.6vw+.8rem,4.25rem)] leading-[1.18]">
            Ik zoek een
            <label class="sr-only" for="t-soort">Soort spel</label>
            <select id="t-soort" class="kies" data-soort>
              {soorten.map(([t, pad]) => <option value={t} data-pad={pad}>{t}</option>)}
            </select>
            voor
            <label class="sr-only" for="t-spelers">Aantal spelers</label>
            <select id="t-spelers" class="kies" data-spelers>
              {spelers.map((t, i) => <option value={t} selected={i === 1}>{t}</option>)}
            </select>,
            voor
            <label class="sr-only" for="t-wie">Voor wie</label>
            <select id="t-wie" class="kies" data-wie>
              {voorWie.map((t, i) => <option value={t} selected={i === 1}>{t}</option>)}
            </select>.
          </p>
          <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-5">
            <a href={waMet('Hoi Margot, ik zoek een bordspel voor 2 spelers, voor de hele familie. Heb je een tip?')} class="knop knop-licht" data-tip-wa><Icoon naam="wa" />Vraag Margot om een tip</a>
            <a href={shop('19-bordspellen')} class="link link-licht font-bold" data-tip-shop>Zelf kijken in de webshop</a>
          </div>
          <p class="mt-6 max-w-lg text-sm text-lila">Je bericht opent in WhatsApp; je verstuurt het zelf.</p>
        </form>
      </div>
    </section>

    <!-- 5. XXXL: hun zelfgebouwde Ticket to Ride -->
    <section class="py-20 md:py-28" aria-labelledby="xxl-titel">
      <div class="wrap">
        <figure class="rijs mx-auto max-w-[1110px]">
          <Image src={xxl} alt="Een zelfgebouwd, groot beschilderd Ticket to Ride-bord van Nederland met grote treinwagons en houten fiches" quality={80} widths={[640, 1110]} sizes="(min-width: 1110px) 1110px, 100vw" class="aspect-[2/1] w-full rounded-md object-cover sm:aspect-[1110/300]" />
        </figure>
        <div class="mx-auto mt-10 grid max-w-[1110px] gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <h2 id="xxl-titel" class="rijs text-3xl text-paars lg:col-span-6">Ticket to Ride in XXXL</h2>
          <div class="rijs lg:col-span-5 lg:col-start-8">
            <p class="text-lg text-grijs">Zelf gebouwd, en te huur. Ontzettend leuk voor bijvoorbeeld een teambuilding.</p>
            <a href={waMet('Hoi Margot, ik wil graag meer weten over het huren van de Ticket to Ride XXXL.')} class="link mt-5 inline-block font-bold text-paars">Vraag naar de mogelijkheden</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. WAT KLANTEN ZEGGEN -->
    <section class="border-t border-lijn bg-papier-2 py-20 md:py-28" aria-labelledby="rev-titel">
      <div class="wrap">
        <h2 id="rev-titel" class="sr-only">Reviews op Google</h2>
        <div class="grid gap-x-12 gap-y-14 md:grid-cols-3">
          {[r(1), r(2), r(3)].map((x, i) => (
            <figure class="rijs" style={`--d:${i * 0.08}s`}>
              <blockquote class="font-kop text-xl leading-[1.25] text-paars md:text-[1.5rem]">“{x.tekst}”</blockquote>
              <figcaption class="mt-5 text-sm text-grijs">{x.naam} op Google</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-14 flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews · Stappen en Shoppen Award 2024</p>
      </div>
    </section>

    <!-- 7. BEZOEK -->
    <section id="bezoek" class="py-20 md:py-28">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl text-paars">Speelhuislaan 68B</h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs">Buiten het centrum, op 3 minuten lopen van de hoofdingang van station Breda.</p>
          <ul class="mt-10 max-w-md space-y-5">
            <li class="rijs flex gap-4"><span class="oog mt-2"></span><p><span class="font-bold">Parkeren</span> kan (bijna) voor de deur, betaald. De scanauto controleert vaak.</p></li>
            <li class="rijs flex gap-4"><span class="oog mt-2"></span><p><span class="font-bold">Online besteld?</span> Afhalen kan op openingsdagen, of op afspraak. Neem je factuur mee.</p></li>
            <li class="rijs flex gap-4"><span class="oog mt-2"></span><p><span class="font-bold">Liever thuis?</span> Webshopbestellingen gaan met PostNL, binnen Nederland voor € 3,95.</p></li>
          </ul>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={site.maps} class="knop"><Icoon naam="pin" />Route plannen</a>
            <a href={site.telHref} class="knop knop-licht num border border-lijn">{site.tel}</a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rijs rounded-md border border-lijn bg-wit p-7 shadow-sm md:p-9">
            <h3 class="text-2xl text-paars">Open</h3>
            <p class="mt-2 text-sm font-bold text-paars" data-status></p>
            <table class="mt-6 w-full text-base">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-bold data-[vandaag]:text-paars">
                    <th scope="row" class="py-2.5 text-left font-[inherit]">{t.naam}</th>
                    <td class="num whitespace-nowrap py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-tip]');
  if (f) {
    const soort = f.querySelector<HTMLSelectElement>('[data-soort]')!;
    const spelers = f.querySelector<HTMLSelectElement>('[data-spelers]')!;
    const wie = f.querySelector<HTMLSelectElement>('[data-wie]')!;
    const wa = f.querySelector<HTMLAnchorElement>('[data-tip-wa]')!;
    const winkel = f.querySelector<HTMLAnchorElement>('[data-tip-shop]')!;
    const basis = wa.href.split('?')[0];
    const zet = () => {
      const tekst = `Hoi Margot, ik zoek een ${soort.value} voor ${spelers.value}, voor ${wie.value}. Heb je een tip?`;
      wa.href = `${basis}?text=${encodeURIComponent(tekst)}`;
      const pad = soort.selectedOptions[0]?.dataset.pad || '';
      winkel.href = `https://despellenwinkelbreda.nl/nl/${pad}`;
      winkel.textContent = pad ? 'Zelf kijken in de webshop' : 'Naar de webshop';
    };
    // Elke keuzelijst zo breed als het gekozen woord, zodat de zin een zin blijft.
    const maat = document.createElement('span');
    maat.setAttribute('aria-hidden', 'true');
    maat.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0';
    f.appendChild(maat);
    const pas = () => f.querySelectorAll<HTMLSelectElement>('select').forEach((s) => {
      const cs = getComputedStyle(s);
      maat.style.font = cs.font; maat.style.letterSpacing = cs.letterSpacing;
      maat.textContent = s.selectedOptions[0]?.text || '';
      s.style.width = `calc(${maat.getBoundingClientRect().width}px + 1.25em)`;
    });
    f.addEventListener('change', () => { zet(); pas(); });
    document.fonts?.ready.then(pas); addEventListener('resize', pas); pas();
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
