---
// De rode pion uit hun logo, nagetekend: rond hoofd met een lach, klokvormig lijf.
interface Props { class?: string; lach?: boolean }
const { class: cls = '', lach = true } = Astro.props;
---
<svg class={cls} viewBox="0 0 40 64" aria-hidden="true">
  <path fill="#bc1823" d="M20 30c-6.5 0-9.5 4-10.5 10L6.5 58.5C6 61.5 8 64 11 64h18c3 0 5-2.5 4.5-5.5L30.5 40C29.5 34 26.5 30 20 30Z"/>
  <circle cx="20" cy="15" r="13.5" fill="#bc1823"/>
  {lach && <path d="M12.5 17.5c2 3.6 4.6 5.2 7.5 5.2s5.5-1.6 7.5-5.2" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>}
</svg>
