  .vandaag-pil { margin-left: .5rem; font-size: .6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--color-inkt); background: var(--color-blauw); border-radius: var(--radius-sm); padding: .1rem .45rem; vertical-align: 1px; }
