  .chip span { display: inline-flex; align-items: center; gap: .45rem; min-height: 2.6rem; padding: 0 1rem; border: 1px solid var(--color-lijn-licht); border-radius: var(--radius-sm); color: var(--color-licht); font-size: .9375rem; cursor: pointer; transition: background-color .25s var(--ease-zacht), border-color .25s var(--ease-zacht), color .25s var(--ease-zacht); }
  .chip span::before { content: '+'; font-weight: 700; color: var(--color-blauw); }
  .chip:hover span { border-color: var(--color-zilver); }
  .chip input:checked + span { background: var(--color-blauw); border-color: var(--color-blauw); color: var(--color-inkt); }
  .chip input:checked + span::before { content: '✓'; color: var(--color-inkt); }
  .chip input:focus-visible + span { outline: 2px solid var(--color-blauw); outline-offset: 2px; }
  .veld { display: grid; gap: .45rem; font-size: .9375rem; color: var(--color-licht); }
  .veld small { color: var(--color-zilver); font-size: .8125rem; }
  .veld input, .veld select { min-height: 3rem; padding: 0 .9rem; border: 1px solid var(--color-lijn-licht); border-radius: var(--radius-sm); background: var(--color-nacht); color: var(--color-licht); font: inherit; }
  .veld input::placeholder { color: #8b95a1; }
  .veld input:focus, .veld select:focus { border-color: var(--color-blauw); outline: none; box-shadow: 0 0 0 3px #2aa8e033; }
</style>
