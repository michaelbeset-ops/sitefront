---
import { Image } from 'astro:assets';
import { url, waAfspraak, site } from '../data/site';
import logo from '../assets/logo.png';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['diensten', 'Diensten'], ['werkwijze', 'Werkwijze'], ['over', 'Over Max'], ['werk', 'Werk'], ['reviews', 'Reviews'], ['contact', 'Contact']];
const usps = ['Dieptereiniging interieur', 'Lakcorrectie en polijsten', 'Keramische coating', '7 dagen per week open'];
const wa = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>';
---
<div class="topbar donker hidden bg-zwart text-zilver md:block">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[0.8125rem]">
    <ul class="flex gap-7">
      {usps.map((u) => (
        <li class="flex items-center gap-2"><svg viewBox="0 0 20 20" aria-hidden="true" class="h-3.5 w-3.5 text-blauw"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m4 10.5 4 4 8-9"/></svg>{u}</li>
      ))}
    </ul>
    <a href={site.telHref} class="lijn-in num font-semibold text-licht">{site.tel}</a>
  </div>
</div>

<header data-kop class:list={['kop donker sticky top-0 z-40', thuis ? 'op-hero -mb-[4.5rem]' : 'vast']}>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4">
    <a href={url('')} class="merk flex items-center gap-3 no-underline" aria-label={`${site.naam}, naar de homepage`}>
      <Image src={logo} alt="" width={54} height={49} densities={[1, 2]} class="h-[49px] w-[54px]" loading="eager" />
      <span class="woordmerk leading-none"><b>Maximum</b> <b class="text-zilver">Detailing</b></span>
    </a>

    <nav aria-label="Hoofdmenu" class="hidden xl:block">
      <ul class="flex gap-8 text-[0.9375rem] font-medium text-licht">
        {nav.map(([id, t]) => <li><a href={h(id)} class="lijn-in">{t}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.telHref} class="lijn-in num mr-3 hidden font-semibold text-licht lg:inline">{site.tel}</a>
      <a href={waAfspraak} class="knop knop-blauw knop-klein hidden sm:inline-flex"><Fragment set:html={wa} />Afspraak appen</a>
      <button type="button" class="menuknop grid h-11 w-11 place-items-center rounded-[var(--radius-sm)] border border-lijn-licht text-licht xl:hidden" aria-expanded="false" aria-controls="menu" aria-label="Menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5"><path class="m-open" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/><path class="m-dicht" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>

  <nav id="menu" aria-label="Menu mobiel" class="menu border-t border-lijn-licht bg-nacht xl:hidden" hidden>
    <div class="wrap pb-5 pt-2">
      <ul class="grid text-lg font-medium text-licht">
        {nav.map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn-licht py-3.5 no-underline">{t}</a></li>)}
      </ul>
      <div class="mt-5 grid gap-2 sm:grid-cols-2">
        <a href={waAfspraak} class="knop knop-blauw"><Fragment set:html={wa} />Afspraak appen</a>
        <a href={site.telHref} class="knop knop-rand num">Bel {site.tel}</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const kop = document.querySelector<HTMLElement>('[data-kop]');
  const knop = document.querySelector<HTMLButtonElement>('.menuknop');
  const menu = document.getElementById('menu');
  if (kop && kop.classList.contains('op-hero')) {
    const zet = () => kop.classList.toggle('vast', scrollY > 40 || !menu?.hidden);
    addEventListener('scroll', zet, { passive: true }); zet();
  }
  if (knop && menu) {
    const zet = (open: boolean) => { menu.hidden = !open; knop.setAttribute('aria-expanded', String(open)); knop.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu'); kop?.classList.toggle('vast', open || scrollY > 40 || !kop.classList.contains('op-hero')); };
    knop.addEventListener('click', () => zet(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => zet(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') zet(false); });
  }
</script>

<style>
  .kop { transition: background-color .35s var(--ease-zacht), border-color .35s var(--ease-zacht); border-bottom: 1px solid transparent; }
  .kop.op-hero { background: linear-gradient(#07090cb3, #07090c00); }
  .kop.vast { background: #07090cf2; border-bottom-color: var(--color-lijn-licht); backdrop-filter: blur(10px); }
  .woordmerk { font-family: var(--font-kop); font-weight: 800; font-stretch: 78%; font-size: 1.32rem; letter-spacing: .01em; text-transform: uppercase; color: var(--color-licht); white-space: nowrap; }
  .woordmerk b { font-weight: inherit; }
  .menuknop .m-dicht { display: none; }
  .menuknop[aria-expanded='true'] .m-open { display: none; }
  .menuknop[aria-expanded='true'] .m-dicht { display: block; }
</style>
