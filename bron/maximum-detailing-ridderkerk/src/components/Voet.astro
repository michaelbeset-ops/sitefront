---
import { Image } from 'astro:assets';
import { site, url, week, waAfspraak, waVraag } from '../data/site';
import logo from '../assets/logo.png';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const wa = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>';
---
<!-- Slotbalk in merkkleur -->
<section class="slot bg-blauw text-inkt" aria-labelledby="t-slot">
  <div class="wrap flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center md:py-14">
    <div>
      <h2 id="t-slot" class="text-[clamp(2.2rem,3vw+1.2rem,3.6rem)]">Keep it clean.</h2>
      <p class="mt-2 max-w-xl font-medium">Stuur een appje met uw auto en wat u wilt laten doen, dan kijkt Max mee.</p>
    </div>
    <a href={waAfspraak} class="knop knop-inkt shrink-0"><Fragment set:html={wa} />App Max</a>
  </div>
</section>

<footer class="donker bg-nacht text-zilver" aria-label="Voettekst">
  <div class="wrap grid gap-12 pb-14 pt-20 text-[0.9375rem] sm:grid-cols-2 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-4">
      <a href={url('')} class="flex items-center gap-4 no-underline">
        <Image src={logo} alt="" width={96} height={88} densities={[1, 2]} class="h-[88px] w-[96px]" />
        <span class="sr-only">{site.naam}</span>
      </a>
      <p class="mt-6 max-w-xs">Full service autopoetsbedrijf in Ridderkerk. Interieur, exterieur, polijsten en keramische coating.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.instagram} class="grid h-10 w-10 place-items-center rounded-[var(--radius-sm)] border border-lijn-licht text-licht transition-colors hover:border-blauw" aria-label="Maximum Detailing op Instagram"><svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.5-1.5h.01"/></svg></a>
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-[var(--radius-sm)] border border-lijn-licht text-licht transition-colors hover:border-blauw" aria-label="Maximum Detailing op Facebook"><svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4"><path fill="currentColor" d="M14 8V6.5c0-.7.2-1.2 1.2-1.2H17V2.2A23 23 0 0 0 14.4 2C11.9 2 10.4 3.5 10.4 6.2V8H8v3.4h2.4V22H14V11.4h2.7L17 8Z"/></svg></a>
        <a href={waVraag} class="grid h-10 w-10 place-items-center rounded-[var(--radius-sm)] border border-lijn-licht text-licht transition-colors hover:border-blauw [&_svg]:h-4 [&_svg]:w-4" aria-label="WhatsApp"><Fragment set:html={wa} /></a>
      </p>
    </div>
    <div class="lg:col-span-2">
      <p class="kop text-xl">Diensten</p>
      <ul class="mt-5 space-y-2.5">
        <li><a href={h('diensten')} class="lijn-in">Interieur reiniging</a></li>
        <li><a href={h('diensten')} class="lijn-in">Exterieur reiniging</a></li>
        <li><a href={h('lak')} class="lijn-in">Polijsten en lakcorrectie</a></li>
        <li><a href={h('diensten')} class="lijn-in">Keramische coating</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="kop text-xl">Contact</p>
      <ul class="mt-5 space-y-2.5">
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.telHref} class="lijn-in num">{site.tel}</a></li>
        <li><a href={waVraag} class="lijn-in">WhatsApp</a></li>
        <li><a href={site.route} class="lijn-in">Route plannen</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="kop text-xl">Openingstijden</p>
      <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 num">
        <dt>Maandag t/m zaterdag</dt><dd class="whitespace-nowrap text-right text-licht">08:00 tot 18:00</dd>
        <dt>Zondag</dt><dd class="whitespace-nowrap text-right text-licht">{week[6].van} tot {week[6].tot}</dd>
      </dl>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs">
    <p>© 2026 {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p><a href={url('privacy/')} class="lijn-in">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap pb-10 text-xs">Foto’s van uw Google-bedrijfsprofiel, uw oude website en Facebook (logo), aangevuld met twee sfeerfoto’s via Unsplash, ter illustratie. Kentekens zijn vervaagd.</p>}
</footer>

<!-- Mobiele onderbalk -->
<div class="onderbalk fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-lijn-licht bg-nacht/95 p-2.5 backdrop-blur md:hidden">
  <a href={site.telHref} class="knop knop-rand knop-klein">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Bellen
  </a>
  <a href={waAfspraak} class="knop knop-blauw knop-klein"><Fragment set:html={wa} />WhatsApp</a>
</div>
