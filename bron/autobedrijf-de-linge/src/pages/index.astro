---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, diensten, onderdelen } from '../data/site';
import hero from '../assets/hero.jpg';
import klassiek from '../assets/klassiek.jpg';
import velg from '../assets/velg.jpg';
import stuur from '../assets/stuur.jpg';

const belIcoon = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
---
<Base
  title="Autobedrijf De Linge | De Saab specialist in Geldermalsen"
  description="Erkend Saab Service Center in Geldermalsen: verkoop, onderhoud, reparatie, leasing en financiering van Saab, plus nieuwe en gebruikte Saab-onderdelen. Bel 0345 533 222."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: donkere herfstfoto, tekst links op een koele overlay, een technische specregel eronder. -->
    <section class="op-donker relative isolate overflow-hidden bg-ink text-white">
      <div class="absolute inset-0 -z-10"><Foto src={hero} alt="Zilveren Saab 9-3 sedan van achteren gezien, geparkeerd op gras vol herfstbladeren" hero sizes="100vw" class="object-[65%_center]" /></div>
      <div class="absolute inset-0 -z-10 bg-ink/80 lg:bg-transparent lg:bg-[linear-gradient(90deg,#0f1620f2_0%,#0f1620d9_42%,#0f162033_78%)]"></div>
      <div class="wrap pb-10 pt-14 sm:pt-20 lg:pb-14 lg:pt-28">
        <div class="max-w-2xl">
          <p class="label flex items-center gap-3 text-frost"><span class="streep"></span>Erkend Saab Service Center</p>
          <h1 class="mt-5 text-4xl">De Saab specialist in Geldermalsen</h1>
          <p class="mt-6 max-w-xl text-lg text-white/90">Verkoop, onderhoud, reparatie, leasing en financiering van Saab. En nieuwe en gebruikte onderdelen voor uw Saab.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-wit">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={belIcoon} /></svg>
              Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span>
            </a>
            <a href="#aanvraag" class="btn btn-line">Onderdeel of afspraak aanvragen</a>
          </div>
        </div>
        <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/25 pt-6 text-sm sm:grid-cols-4 lg:mt-24">
          <div><dt class="text-white/75">Ervaring</dt><dd class="font-display text-lg font-semibold">Ruim 40 jaar</dd></div>
          <div><dt class="text-white/75">Saab-dealer</dt><dd class="font-display text-lg font-semibold">Ruim 25 jaar</dd></div>
          <div><dt class="text-white/75">Google</dt><dd class="font-display text-lg font-semibold"><span class="tabular-nums">4,5</span> uit 5 <span class="text-sm font-normal text-white/75">(34)</span></dd></div>
          <div><dt class="text-white/75">Werkplaats</dt><dd class="font-display text-lg font-semibold">Bosch Workshop Partner</dd></div>
        </dl>
      </div>
    </section>

    <!-- Werkplaats: tekst en foto links, de dienstenlijst als specificatieblad rechts. -->
    <section id="werkplaats" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-saab">Werkplaats en verkoop</p>
          <h2 class="mt-3 text-3xl">Van onderhoud tot tuning</h2>
          <p class="mt-5 text-ink-soft">Als erkend Saab Service Center zijn wij gespecialiseerd in de verkoop, het onderhoud, de reparatie, leasing en financiering van Saab. Ook met een Lancia of een ander merk kunt u bij ons terecht.</p>
          <div class="mt-8 aspect-[16/10] overflow-hidden rounded-md">
            <Foto src={stuur} alt="Stuur met Saab-logo en het dashboard met snelheidsmeter, gezien vanaf de passagiersstoel" sizes="(min-width: 1024px) 440px, 100vw" />
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <ul class="divide-y divide-line border-y border-line">
            {diensten.map((d, i) => (
              <li class="grid gap-1 py-5 sm:grid-cols-[3rem_9rem_1fr] sm:gap-4">
                <span class="hidden font-display text-sm font-semibold tabular-nums text-ink-soft sm:block">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-lg">{d.groep}</h3>
                <p class="text-ink-soft">{d.items.join(', ')}</p>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
            <a href="#aanvraag" class="btn btn-saab sm:shrink-0 sm:whitespace-nowrap">Werkplaatsafspraak aanvragen</a>
            <p class="text-sm text-ink-soft">Werkplaats open maandag t/m vrijdag, <span class="whitespace-nowrap tabular-nums">8.00 tot 17.00</span> uur</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Onderdelen: close-up links, een lijst als magazijnbon rechts. -->
    <section id="onderdelen" class="scroll-mt-20 bg-ice py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="order-2 aspect-[4/3] overflow-hidden rounded-md lg:order-1 lg:col-span-5 lg:aspect-auto">
          <Foto src={velg} alt="Close-up van een zilveren lichtmetalen velg met het blauwe Saab-embleem en vijf wielmoeren" sizes="(min-width: 1024px) 440px, 100vw" />
        </div>
        <div class="order-1 lg:order-2 lg:col-span-7">
          <p class="label text-saab">Onderdelen</p>
          <h2 class="mt-3 text-3xl">Nieuwe en gebruikte onderdelen voor uw Saab</h2>
          <p class="mt-5 max-w-xl text-ink-soft">Bij ons kunt u nieuwe en gebruikte Saab-onderdelen kopen. Een greep uit wat er onlangs in de verkoop stond:</p>
          <ul class="mt-8 rounded-md bg-white shadow-[0_1px_2px_#0f162014] ring-1 ring-line">
            {onderdelen.map((o) => (
              <li class="flex items-baseline gap-4 border-b border-line px-5 py-4 last:border-b-0">
                <span class="w-20 shrink-0 font-display text-sm font-semibold text-saab sm:w-24">{o.type}</span>
                <span class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-4">
                  <span>{o.naam}</span>
                  {o.noot && <span class="text-sm text-ink-soft">{o.noot}</span>}
                </span>
              </li>
            ))}
          </ul>
          <p class="mt-5 text-sm text-ink-soft">De voorraad wisselt. Zoekt u iets, vraag het aan met het type, bouwjaar of kenteken van uw Saab.</p>
          <a href="#aanvraag" class="btn btn-saab mt-6">Onderdeel aanvragen</a>
        </div>
      </div>
    </section>

    <!-- Ervaring: donker blok met de klassieke 96 en de jaren als cijferkolom. -->
    <section id="ervaring" class="op-donker scroll-mt-20 bg-saab-deep py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <div class="aspect-[3/2] overflow-hidden rounded-md">
            <Foto src={klassiek} alt="Rode klassieke Saab 96 op een grindpad, met herfstbomen op de achtergrond" sizes="(min-width: 1024px) 640px, 100vw" />
          </div>
        </div>
        <div class="lg:col-span-5">
          <p class="label flex items-center gap-3 text-frost"><span class="streep"></span>Over ons</p>
          <h2 class="mt-4 text-3xl">Ruim 40 jaar Saab en Lancia</h2>
          <p class="mt-5 text-white/85">Met onze technische kennis en ervaring verkopen wij door heel Nederland.</p>
          <dl class="mt-8 divide-y divide-white/20 border-y border-white/20">
            <div class="flex items-baseline gap-5 py-4"><dt class="w-20 shrink-0 font-display text-2xl font-bold tabular-nums">40+</dt><dd class="text-white/85">jaar ervaring met Saab en Lancia</dd></div>
            <div class="flex items-baseline gap-5 py-4"><dt class="w-20 shrink-0 font-display text-2xl font-bold tabular-nums">25+</dt><dd class="text-white/85">jaar officiële Saab-dealer</dd></div>
            <div class="flex items-baseline gap-5 py-4"><dt class="w-20 shrink-0 font-display text-2xl font-bold tabular-nums">25</dt><dd class="text-white/85">jaar officiële Lancia-dealer</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Aanvraag en contact: formulier links, tijden en route rechts. -->
    <section id="contact" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-14 lg:grid-cols-12">
        <div id="aanvraag" class="scroll-mt-20 lg:col-span-7">
          <p class="label text-saab">Aanvragen</p>
          <h2 class="mt-3 text-3xl">Onderdeel of afspraak aanvragen</h2>
          <p class="mt-4 text-ink-soft">Laat weten om welke Saab het gaat en wat u zoekt. Liever direct contact? Bel <a href={site.telHref} class="whitespace-nowrap font-semibold text-saab underline underline-offset-2">{site.tel}</a>.</p>
          <form class="mt-8 grid gap-5 rounded-md bg-ice p-5 sm:grid-cols-2 sm:p-8" onsubmit="return false">
            <fieldset class="sm:col-span-2">
              <legend class="text-sm font-semibold">Waarvoor neemt u contact op?</legend>
              <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:gap-6">
                <label class="flex items-center gap-2"><input type="radio" name="soort" value="onderdeel" checked class="size-4 accent-saab" /> Onderdeel aanvragen</label>
                <label class="flex items-center gap-2"><input type="radio" name="soort" value="werkplaats" class="size-4 accent-saab" /> Werkplaatsafspraak</label>
              </div>
            </fieldset>
            <label class="text-sm font-semibold">Naam<input class="veld" type="text" name="naam" autocomplete="name" /></label>
            <label class="text-sm font-semibold">Telefoon<input class="veld" type="tel" name="telefoon" autocomplete="tel" /></label>
            <label class="text-sm font-semibold sm:col-span-2">E-mail<input class="veld" type="email" name="email" autocomplete="email" /></label>
            <label class="text-sm font-semibold sm:col-span-2">Saab-type, bouwjaar of kenteken<input class="veld" type="text" name="auto" placeholder="Bijvoorbeeld 9-3 Sport Estate, 2010" /></label>
            <label class="text-sm font-semibold sm:col-span-2">Onderdeel of werkzaamheden<input class="veld" type="text" name="wat" /></label>
            <label class="text-sm font-semibold sm:col-span-2">Bericht<textarea class="veld min-h-28" name="bericht" rows="4"></textarea></label>
            {site.voorstel ? (
              <p class="rounded-sm border-l-4 border-saab bg-white p-4 text-sm sm:col-span-2">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap font-semibold underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all font-semibold underline">{site.mail}</a>.</p>
            ) : (
              <button type="submit" class="btn btn-saab sm:col-span-2 sm:justify-self-start">Aanvraag versturen</button>
            )}
          </form>
        </div>

        <div class="lg:col-span-4 lg:col-start-9">
          <h3 class="text-xl">Openingstijden</h3>
          <dl class="mt-4 divide-y divide-line border-y border-line text-sm">
            <div class="flex justify-between gap-4 py-3"><dt>Showroom, ma t/m vr</dt><dd class="whitespace-nowrap tabular-nums">8.00 tot 17.15</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt>Werkplaats, ma t/m vr</dt><dd class="whitespace-nowrap tabular-nums">8.00 tot 17.00</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt>Zaterdag</dt><dd class="whitespace-nowrap tabular-nums">9.00 tot 14.00</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt>Zondag</dt><dd>gesloten</dd></div>
          </dl>
          <p class="mt-3 text-sm text-ink-soft">Andere tijden op afspraak.</p>

          <h3 class="mt-10 text-xl">Adres en route</h3>
          <address class="mt-4 not-italic">{site.naamBv}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <p class="mt-4 text-sm text-ink-soft">Via de A15: neem afrit 30, Geldermalsen/Est. Bovenaan rechtsaf en de rondweg volgen richting Geldermalsen. Na 4 km vindt u ons aan de linkerkant.</p>
          <p class="mt-5"><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
          <a href={site.maps} rel="noopener" class="btn btn-saab mt-6">Route plannen</a>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
