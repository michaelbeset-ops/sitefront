---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const home = url('');
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={home} class="flex min-w-0 items-baseline gap-2 no-underline">
        <span class="font-display text-xl font-bold uppercase tracking-[0.06em] text-saab sm:text-2xl">De Linge</span>
        <span class="hidden text-xs font-semibold uppercase tracking-[0.14em] text-ink-soft sm:inline">Saab specialist</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={`${home}#werkplaats`} class="no-underline transition-colors hover:text-saab">Werkplaats</a></li>
          <li><a href={`${home}#onderdelen`} class="no-underline transition-colors hover:text-saab">Onderdelen</a></li>
          <li><a href={`${home}#ervaring`} class="no-underline transition-colors hover:text-saab">Over ons</a></li>
          <li><a href={`${home}#contact`} class="no-underline transition-colors hover:text-saab">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-saab shrink-0 !px-3.5 !py-2 text-sm" aria-label={`Bel ${site.tel}`}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
        <span class="whitespace-nowrap tabular-nums">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="op-donker bg-ink py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-lg font-semibold uppercase tracking-[0.06em] text-white">{site.naamBv}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:col-span-4"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
