---
import { site, url, week } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid gap-x-8 gap-y-12 py-16 text-[.9375rem] sm:grid-cols-2 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-5">
      <p class="font-kop text-[2rem] font-extrabold leading-none tracking-[-0.04em] text-licht">Hij <span class="en">&amp;</span> Zij</p>
      <p class="mt-4 max-w-xs">Kledingreparatie en stomerij aan de {site.straat} in {site.plaats}.</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num no-underline hover:text-draad-licht">{site.tel}</a></li>
        <li><a href={site.mobielHref} class="num no-underline hover:text-draad-licht">{site.mobiel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-draad-licht">{site.mail}</a></li>
        <li>{site.straat}, {site.plaats}</li>
      </ul>
    </div>
    <div class="lg:col-span-4">
      <p class="font-bold text-licht">Open</p>
      <ul class="num mt-4 grid max-w-[15rem] grid-cols-[3rem_1fr] gap-y-1">
        {week.map((d) => <><li class="contents"><span>{d.kort}</span><span>{d.van} tot {d.tot}</span></li></>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {new Date().getFullYear()} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-draad-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">De foto's zijn sfeerbeelden van Unsplash, geen foto's van het atelier zelf.</p>}
  </div>
</footer>
