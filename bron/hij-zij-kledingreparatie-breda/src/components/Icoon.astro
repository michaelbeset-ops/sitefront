---
// Alleen de paar iconen die de site echt gebruikt, zelf getekend.
interface Props { naam: 'tel' | 'route' | 'mail' | 'klok' | 'pijl'; class?: string }
const { naam, class: klasse = 'h-5 w-5' } = Astro.props;
---
<svg class={klasse} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {naam === 'tel' && <path d="M5 3.5h3.2l1.6 4.3-2.1 1.4a11 11 0 0 0 7.1 7.1l1.4-2.1 4.3 1.6V19a1.6 1.6 0 0 1-1.7 1.6C10.6 20.1 3.9 13.4 3.4 5.2A1.6 1.6 0 0 1 5 3.5Z" />}
  {naam === 'route' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {naam === 'mail' && <><rect x="3.5" y="5.5" width="17" height="13" rx="1.5" /><path d="m4 6.5 8 6.5 8-6.5" /></>}
  {naam === 'klok' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {naam === 'pijl' && <path d="M5 12h14m-5-5 5 5-5 5" />}
</svg>
