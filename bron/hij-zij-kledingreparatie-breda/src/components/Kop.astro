---
import { site, url } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<header class="sticky top-0 z-40 border-b border-lijn bg-linnen/95 backdrop-blur-sm">
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-4">
    <a href={url('')} class="flex items-baseline gap-2 no-underline" aria-label={`${site.naam}, naar de homepage`}>
      <span class="font-kop text-[1.6rem] font-extrabold tracking-[-0.04em]">Hij <span class="en">&amp;</span> Zij</span>
      <span class="hidden text-xs font-bold uppercase tracking-[.14em] text-bruin sm:inline">Kledingreparatie</span>
    </a>
    <nav aria-label="Hoofdmenu" class="flex items-center gap-6 text-[.9375rem] font-semibold">
      <a href={h('diensten')} class="hidden no-underline hover:text-draad lg:inline">Wat we doen</a>
      <a href={h('atelier')} class="hidden no-underline hover:text-draad lg:inline">Het atelier</a>
      <a href={h('langskomen')} class="hidden no-underline hover:text-draad md:inline">Openingstijden</a>
      <a href={site.telHref} class="knop knop-draad knop-klein"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
    </nav>
  </div>
</header>
