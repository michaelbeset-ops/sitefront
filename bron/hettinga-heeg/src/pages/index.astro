---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, klusMail } from '../data/site';
import polder from '../assets/polder.jpg';
import vuurtoren from '../assets/vuurtoren.jpg';

// De gele strook uit hun logo.
const strook = ['electra', 'cv', 'gas', 'water', 'riolering', 'zinkwerk'];
// Hun vakpagina's.
const werk = [
  ['Electra', 'Elektrische installaties, ook databekabeling en alarminstallaties.'],
  ['Cv', 'Aanleg en onderhoud van cv-installaties.'],
  ['Gas', 'Aanleg en onderhoud van gasinstallaties.'],
  ['Water', 'Aanleg en onderhoud van waterleidingen.'],
  ['Riolering', 'Aanleg en onderhoud van riolering.'],
  ['Zinkwerk', 'Zinken goten en daken.'],
  ['Energie', 'Zonnepanelen, warmteterugwininstallaties en aardwarmte met een warmtepomp.'],
];
// Hun pagina "Over Hettinga".
const familie = [
  ["jaren '30", 'Pake Hielke Hettinga en zijn twee broers werken in Balk als koperslagers.'],
  ["eind jaren '60", 'Zoon Jappie Hettinga vestigt zich aan de Harinxmastraat in Heeg.'],
  ['1983', 'Hielke Hettinga neemt de zaak over. Hij is erkend installateur.'],
  ['2007', 'In januari gaat de nieuwe werkplaats aan De Opper 2 open.'],
];
const tel = `<svg viewBox="0 0 24 24" class="h-[1em] w-[1em]" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>`;
---
<Base title="Hettinga's Installatiebedrijf, Heeg | Electra, cv, gas, water, riolering en zinkwerk" description="Al meer dan 40 jaar installateur in Heeg: aanleg en onderhoud van electra, cv, gas, water, riolering en zinkwerk. Bel 0515 44 22 86.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. Het logo op ware grootte: zwarte kop op wit, Heeg ernaast, de gele strook eronder. -->
    <section class="grid md:min-h-[calc(100svh-6.1rem)] md:grid-cols-12 md:grid-rows-[1fr_auto]" aria-labelledby="kop">
      <div class="px-5 pb-8 pt-9 md:col-span-7 md:self-center md:px-12 md:py-14 xl:pl-20">
        <span class="blokjes w-12 md:w-16" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <h1 id="kop" class="mt-6 text-3xl md:mt-9 md:text-[clamp(3rem,5.3vw,5.15rem)]">Al meer dan 40&nbsp;jaar <br class="max-md:hidden" />installateur in&nbsp;Heeg.</h1>
        <p class="mt-6 max-w-[33rem] text-lg leading-snug text-staal">Aanleg en onderhoud, van de meterkast tot de dakgoot. Een kleinschalig bedrijf dat staat voor betrouwbaarheid en vakmanschap.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={site.telHref} class="knop"><Fragment set:html={tel} />Bel <span class="tabular-nums">{site.tel}</span></a>
          <a href={klusMail} class="lijn font-medium">Mail uw vraag</a>
        </div>
      </div>
      <figure class="relative h-[15rem] overflow-hidden md:col-span-5 md:h-auto">
        <Foto src={polder} alt="Fries polderlandschap onder stapelwolken: een brede vaart met rietkragen, een fietspad op de dijk en in de verte een wit zeil." hero sizes="(min-width: 768px) 42vw, 100vw" class="absolute inset-0 object-[78%_50%]" />
      </figure>
      <ul class="strook flex flex-wrap justify-between gap-x-5 gap-y-1 px-5 py-3 text-[1.15rem] md:col-span-12 md:px-12 md:py-4 md:text-[clamp(1.4rem,2.7vw,2.6rem)] xl:px-20" aria-label="Onze vakken">
        {strook.map((s) => <li>{s}</li>)}
      </ul>
    </section>

    <!-- 2. Het werk: elk vak een regel, zoals de knoppen op hun huidige site. -->
    <section id="werk" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="werk-kop">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <h2 id="werk-kop" class="text-2xl md:col-span-7">Aanleggen en onderhouden.</h2>
          <p class="text-lg text-staal md:col-span-4 md:col-start-9">Vaste klanten kunnen rekenen op een goede service.</p>
        </div>
        <ul class="mt-12 border-t-2 border-zwart md:mt-16">
          {werk.map(([vak, wat]) => (
            <li class="group grid gap-1 border-b border-lijn py-5 md:grid-cols-12 md:items-baseline md:gap-6 md:py-6">
              <h3 class="flex items-center gap-4 text-xl md:col-span-4 md:text-[2.1rem]">
                <span class="h-3 w-3 shrink-0 bg-geel transition-transform duration-200 group-hover:scale-150" aria-hidden="true"></span>{vak}
              </h3>
              <p class="pl-7 text-staal md:col-span-7 md:pl-0 md:text-lg">{wat}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. De familie: vier generaties vakwerk op een gele maatlat. -->
    <section id="familie" class="op-zwart scroll-mt-20 bg-zwart py-20 text-licht md:py-28" aria-labelledby="fam-kop">
      <div class="wrap">
        <h2 id="fam-kop" class="max-w-[16ch] text-2xl text-wit">Van koperslager in Balk tot installateur in Heeg.</h2>
        <ol class="mt-14 grid gap-8 md:mt-20 md:grid-cols-4 md:gap-0">
          {familie.map(([jaar, wat]) => (
            <li class="border-l-4 border-geel pl-5 md:border-l-0 md:border-t-4 md:pl-0 md:pr-8 md:pt-6">
              <p class="kop text-[1.9rem] font-extrabold leading-none tracking-[-.03em] text-geel md:text-[2.4rem]">{jaar}</p>
              <p class="mt-3 max-w-[22rem]">{wat}</p>
            </li>
          ))}
        </ol>
        <figure class="mt-16 grid gap-4 border-t border-lijn-licht pt-10 md:mt-24 md:grid-cols-12 md:gap-6">
          <blockquote lang="fy" class="kop text-xl font-medium leading-snug text-wit md:col-span-8">It minmachtige bedriuw stiet foar kundichheid en betrouwen, der wurdt sekuer wurk levere.</blockquote>
          <figcaption class="text-sm md:col-span-3 md:col-start-10 md:self-end">Zo staat het, in het Fries, op onze huidige site.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Creatief: het open vuur op de vuurtoren bij Workum. -->
    <section id="vuurtoren" class="scroll-mt-20 bg-paneel py-20 md:py-28" aria-labelledby="vt-kop">
      <div class="wrap grid items-center gap-12 md:grid-cols-12 md:gap-6">
        <figure class="md:col-span-4 md:col-start-2">
          <div class="relative mx-auto w-[207px] md:mx-0">
            <span class="absolute -bottom-3 -right-3 h-full w-full bg-geel" aria-hidden="true"></span>
            <div class="relative aspect-[207/300]"><Foto src={vuurtoren} alt="Witte vierkante vuurtoren met een vlaggenmast op een groene dijk, onder een grijze lucht." sizes="207px" /></div>
          </div>
        </figure>
        <div class="md:col-span-6 md:col-start-7">
          <h2 id="vt-kop" class="text-2xl">Een open vuur op de vuurtoren van Workum.</h2>
          <p class="mt-6 text-lg">In de nacht van 25 op 26 oktober 2004 brandde op de vuurtoren aan het eind van de dijk bij Workum voor het eerst sinds 1880 weer een open vuur. De installatie die veilig hoge vlammen kon maken, bouwde gasfitter Hylke Hettinga uit Heeg.</p>
          <p class="mt-4 text-staal">Bij goed zicht was het vuur tot op twintig kilometer te zien. Ook voor zulke originele en kunstzinnige projecten kunt u bij ons terecht.</p>
        </div>
      </div>
    </section>

    <!-- 5. Contact: de gele strook wordt een heel vlak. -->
    <section id="contact" class="scroll-mt-20 bg-geel py-20 md:py-28" aria-labelledby="contact-kop">
      <div class="wrap grid gap-10 md:grid-cols-12 md:gap-6">
        <div class="md:col-span-7">
          <h2 id="contact-kop" class="text-3xl">Bel Hettinga.</h2>
          <p class="mt-8"><a href={site.telHref} class="kop text-2xl font-extrabold tabular-nums no-underline decoration-[3px] underline-offset-8 hover:underline">{site.tel}</a></p>
          <p class="mt-6"><a href={klusMail} class="lijn text-lg font-medium">Of mail uw vraag naar {site.mail}</a></p>
        </div>
        <div class="md:col-span-4 md:col-start-9 md:pt-3">
          <p class="kop text-xl font-bold">Werkplaats</p>
          <p class="mt-2 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-4"><a href={site.maps} class="lijn">Route in Google Maps</a></p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
