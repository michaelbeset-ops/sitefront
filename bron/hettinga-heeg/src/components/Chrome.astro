---
import { site, url, klusMail } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const tel = `<svg viewBox="0 0 24 24" class="h-[1em] w-[1em]" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>`;
const nav = [['#werk', 'Het werk'], ['#familie', 'Sinds de jaren dertig'], ['#vuurtoren', 'Creatief'], ['#contact', 'Contact']];
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-lijn bg-wit">
    <div class="flex h-16 items-center justify-between gap-4 px-4 md:px-8">
      <a href={url('')} class="flex items-center gap-3 no-underline">
        <span class="blokjes w-8" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span class="flex flex-col items-start">
          <span class="kop text-[1.55rem] font-extrabold leading-[.9] tracking-[-.01em]">HETTINGA</span>{" "}
          <span class="mt-0.5 text-[.56rem] font-semibold uppercase leading-none tracking-[.12em] text-staal">Installatiebedrijf</span>
        </span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-8 text-[.98rem] font-medium">
          {nav.map(([h, t]) => <li><a href={url(h)} class="no-underline decoration-geel decoration-[3px] underline-offset-[7px] hover:underline">{t}</a></li>)}
        </ul>
      </nav>
      <a href={site.telHref} class="knop whitespace-nowrap !px-3.5 !py-2 !text-[1rem]"><Fragment set:html={tel} /><span class="tabular-nums max-[379px]:sr-only">{site.tel}</span><span class="sr-only">bellen</span></a>
    </div>
  </header>
) : (
  <footer class="op-zwart bg-zwart text-licht">
    <div class="wrap grid gap-10 pb-10 pt-14 md:grid-cols-12">
      <div class="md:col-span-5">
        <span class="flex items-center gap-3">
          <span class="blokjes w-9" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span class="kop text-[1.7rem] font-extrabold leading-none tracking-[-.02em] text-wit">HETTINGA</span>
        </span>
        <p class="mt-3 text-sm">Al meer dan 40 jaar gevestigd in Heeg.</p>
      </div>
      <p class="md:col-span-4">
        {site.straat}<br />{site.postcode} {site.plaats}<br />
        <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a><br />
        <a href={klusMail} class="lijn break-all">{site.mail}</a>
      </p>
      <p class="md:col-span-3 md:text-right">
        <a href={url('privacy/')} class="lijn">Privacyverklaring</a><br />
        <span class="text-sm">KvK [[AANLEVEREN: KvK-nummer]]</span><br />
        <span class="text-sm">{site.google.score} op Google ({site.google.aantal} beoordelingen)</span>
      </p>
    </div>
    {site.voorstel && <p class="wrap border-t border-lijn-licht pb-8 pt-6 text-sm">Foto van uw eigen website en een sfeerfoto via Unsplash, ter illustratie. Bij oplevering vervangen we die door eigen foto's.</p>}
  </footer>
)}
