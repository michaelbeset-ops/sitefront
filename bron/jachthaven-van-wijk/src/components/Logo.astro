---
// Typografisch wordmark: hun site heeft geen beeldlogo, alleen "Jachthaven van Wijk Woubrugge".
// Beeldmerk: het silhouet van een sloep met stootwil boven een waterlijn.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <span class="sr-only">Jachthaven van Wijk Woubrugge</span>
  <svg viewBox="0 0 40 32" class="h-8 w-10 flex-none" aria-hidden="true">
    <path d="M3 13h34l-3.2 8.2a4 4 0 0 1-3.7 2.5H9.6a4 4 0 0 1-3.7-2.5Z" fill={licht ? '#ffffff' : '#133449'} />
    <path d="M4.4 15.6h31.2" stroke="#c8894d" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="0.1 3.2" />
    <path d="M24 13V7.5h5.5L31 13" fill="none" stroke={licht ? '#a9cbe0' : '#2c5f7c'} stroke-width="1.8" stroke-linejoin="round" />
    <path d="M2 28.5c3 0 3-1.6 6-1.6s3 1.6 6 1.6 3-1.6 6-1.6 3 1.6 6 1.6 3-1.6 6-1.6 3 1.6 6 1.6" fill="none" stroke="#c8894d" stroke-width="1.8" stroke-linecap="round" />
  </svg>
  <span aria-hidden="true" class="flex flex-col">
    <span class={`text-[0.62rem] font-bold tracking-[0.2em] uppercase ${licht ? 'text-white/80' : 'text-ink-soft'}`}>Jachthaven</span>
    <span class={`font-display text-[1.45rem] font-semibold tracking-[-0.02em] ${licht ? 'text-white' : 'text-diep'}`}>van Wijk</span>
  </span>
</span>
