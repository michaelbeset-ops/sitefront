<script>
  // Machinekiezer: tabs met pijltjestoetsen.
  const box = document.querySelector<HTMLElement>('[data-machines]');
  if (box) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const kies = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => { const aan = x === t; x.setAttribute('aria-selected', String(aan)); x.tabIndex = aan ? 0 : -1; document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !aan; });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => kies(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); kies(tabs[(i + d + tabs.length) % tabs.length], true); }
      });
    });
  }

  // Klusplanner: maakt een net bericht en opent WhatsApp of de mail.
  const f = document.querySelector<HTMLFormElement>('[data-klus]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const werk = d.getAll('werk').map(String);
      const r = ['Goedendag RCM Hofstede, ik wil graag een offerte aanvragen.'];
      if (werk.length) r.push('Werk: ' + werk.join(', '));
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      r.push('Wanneer: ' + (v('wanneer') || 'in overleg'));
      if (v('wens')) r.push('Omschrijving: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      const tekst = r.join('\n');
      const via = (e as SubmitEvent).submitter?.getAttribute('value');
      if (via === 'mail') location.href = 'mailto:info@rcmhofstede.nl?subject=' + encodeURIComponent('Offerteaanvraag grondwerk') + '&body=' + encodeURIComponent(tekst);
      else window.open('https://wa.me/31653414176?text=' + encodeURIComponent(tekst), '_blank', 'noopener');
    });
  }
</script>

