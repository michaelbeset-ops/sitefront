---
import { Image } from 'astro:assets';
import { site, url, waHoi } from '../data/site';
import logo from '../assets/logo.png';
const jaar = new Date().getFullYear();
const machines = ['Inpakmachines', 'Palletiseermachines', 'Transportsystemen', 'Storingen & onderhoud', 'Aanbod machines'];
---
<footer class="bg-grafiet text-mist">
  <div class="rollers rijs" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Image src={logo} alt="Nobel Food Tech" widths={[150, 300]} sizes="150px" class="h-auto w-[150px]" />
      <p class="mt-6 max-w-xs">Technisch servicebedrijf voor verpakkingsmachines in de AGF- en voedingsindustrie.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Machines</p>
      <ul class="mt-3 space-y-1">{machines.map((d) => <li><a href={url('#machines')} class="link link-licht no-underline hover:underline">{d}</a></li>)}</ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <span class="text-mist">(ook WhatsApp)</span></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}<br />Bezoek op afspraak</p>
    </div>
  </div>
  <div class:list={["wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs", !site.voorstel && "max-md:pb-24"]}>
    <p>© {jaar} Nobel Food Tech, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><a href={waHoi} class="link link-licht">WhatsApp</a></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen website en Google-bedrijfsprofiel (Van eigenaar). Teksten op basis van nobelfoodtech.nl.</p>}
</footer>
