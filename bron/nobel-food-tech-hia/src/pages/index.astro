---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, waMet, waHoi } from '../data/site';
import hero from '../assets/hero.jpg';
import heroM from '../assets/hero-m.jpg';
import hal from '../assets/hal.jpg';
import inpak from '../assets/inpak.jpg';
import pallet from '../assets/pallet.jpg';
import punnets from '../assets/punnets.jpg';
import transport from '../assets/transport.jpg';
import glijgoot from '../assets/glijgoot.jpg';
import bus from '../assets/bus.jpg';
import aKantelaar from '../assets/a-kistenkantelaar.jpg';
import aCosmec from '../assets/a-cosmec.jpg';
import aSorma from '../assets/a-sorma.jpg';

// Aanbod zoals op nobelfoodtech.nl/aanbod-machines (7 okt 2026), details van de machinepagina's.
const aanbod = [
  { naam: 'Kistenkantelaar', regels: ['Kantelt volle kisten snel en veilig.', 'Stevige constructie en nauwkeurige besturing, voor de AGF- en voedingsindustrie.'], foto: aKantelaar, alt: 'Blauwe kistenkantelaar buiten voor de bedrijfshal', pos: '50% 70%' },
  { naam: 'Klempalletiseerder Cosmec', type: 'Pac230', regels: ['Nieuw, bouwjaar 2024.', 'Voor dozen van 60x40 of 40x30.'], foto: aCosmec, alt: 'Klempalletiseerder Cosmec Pac230 in de hal', pos: '50% 40%' },
  { naam: 'Verpakkingsmachine Sorma Girsac', type: 'BRT-134', regels: ['Bouwjaar 2013. Voor onder meer citrus in girsac-verpakking.', 'Servicebeurt bij levering, inclusief 2 netbuizen.'], foto: aSorma, alt: 'RVS verpakkingsmachine Sorma Girsac BRT-134', pos: '50% 45%' },
];
const heroMob = await Promise.all([420, 640, 855].map((w) => getImage({ src: heroM, width: w, quality: 58, format: 'webp' })));
const heroMobSet = heroMob.map((i, k) => `${i.src} ${[420, 640, 855][k]}w`).join(', ');
const stappen = ['Afwegen', 'Vullen', 'Inpakken', 'Labelen', 'Transporteren', 'Palletiseren'];
---
<Base title="Nobel Food Tech | Verpakkingsmachines en service voor de AGF" description="Technisch servicebedrijf in Hendrik-Ido-Ambacht: maatwerk inpakmachines, palletiseermachines en transportsystemen voor de AGF- en voedingsindustrie, plus storingen en onderhoud op locatie.">
  <Kop />
  <main id="inhoud">

    <!-- 1. HERO: hun eigen tomatenband, schermvullend -->
    <section class="relative isolate flex min-h-[calc(100svh-4.5rem)] items-end overflow-hidden bg-grafiet text-wit md:min-h-[calc(100svh-5rem)]" aria-labelledby="hero-titel">
      <picture>
        <source media="(max-width: 767px)" srcset={heroMobSet} sizes="100vw" type="image/webp" />
        <Image src={hero} alt="Inpaklijn met trostomaten op een RVS-transportband met blauwe modulaire mat, in een AGF-inpakhal" widths={[960, 1440, 1920]} sizes="100vw" quality={60} loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[30%_75%] md:object-[50%_55%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#161a17e6_0%,#161a17a6_42%,#161a1726_75%)] max-md:bg-[linear-gradient(0deg,#161a17f2_0%,#161a17c7_55%,#161a1799_100%)]" aria-hidden="true"></div>
      <div class="wrap pb-14 pt-24 md:pb-20">
        <p class="text-sm font-medium text-blad-licht md:text-base">Technisch servicebedrijf voor de AGF, Hendrik-Ido-Ambacht</p>
        <h1 id="hero-titel" class="mt-5 max-w-[13ch] text-hero">Inpakken, palletiseren, door&shy;draaien.</h1>
        <p class="mt-6 max-w-xl text-lg text-staal md:text-xl">Maatwerk in verpakkingsmachines, palletiseermachines en transportsystemen. En staat een machine stil, dan komen we naar u toe.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#werkbon" class="knop">Storing of offerte aanvragen</a>
          <a href="#machines" class="knop knop-lijn">Bekijk de machines</a>
        </div>
        <p class="mt-12 flex flex-wrap gap-x-6 gap-y-1 border-t border-lijn-licht pt-5 text-sm text-mist">
          <a href={site.telHref} class="num font-semibold text-wit no-underline hover:text-blad-licht">{site.tel}</a>
          <span>Bellen of WhatsApp</span>
          <span>{site.plaats}, bezoek op afspraak</span>
        </p>
      </div>
    </section>
    <div class="rollers rijs" aria-hidden="true"></div>

    <!-- 2. DE LIJN / OVER -->
    <section id="over" class="py-16 md:py-28" aria-labelledby="over-titel">
      <div class="wrap grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <h2 id="over-titel" class="rijs text-3xl">Elke stap van het verpakkings&shy;proces</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-grijs">Nieuwe en gereviseerde machines, of een complete inpaklijn. We komen op locatie om mee te denken, van ontwerp tot installatie.</p>
        </div>
        <figure class="rijs lg:col-span-6">
          <Image src={hal} alt="Twee zwarte palletiseermachines met groene armen en blauwe banden in een lichte inpakhal" widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 48vw, 100vw" quality={60} class="aspect-[4/3] w-full rounded-md object-cover" />
        </figure>
      </div>
      <ol class="wrap rijs mt-14 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:mt-20 lg:grid-cols-6" aria-label="Stappen in het verpakkingsproces">
        {stappen.map((s) => (
          <li class="border-t-[3px] border-blad pt-3 font-kop text-xl font-bold text-inkt">{s}</li>
        ))}
      </ol>
    </section>

    <!-- 3. MACHINES: drie redactionele rijen -->
    <section id="machines" class="bg-staal pb-16 pt-16 md:pb-28 md:pt-28" aria-labelledby="machines-titel">
      <div class="wrap">
        <h2 id="machines-titel" class="rijs max-w-3xl text-3xl">Machines op maat voor AGF en voeding</h2>
      </div>

      <article class="wrap mt-14 grid items-end gap-y-8 md:mt-20 lg:grid-cols-12 lg:gap-x-14" aria-labelledby="m-inpak">
        <figure class="rijs lg:col-span-7">
          <Image src={inpak} alt="Lange inpaklijn met RVS-frames, blauwe banden en een etiketteermachine" widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 56vw, 100vw" quality={60} class="aspect-[4/3] w-full rounded-md object-cover" />
        </figure>
        <div class="rijs lg:col-span-5 lg:pb-6">
          <h3 id="m-inpak" class="text-2xl md:text-[2.25rem]">Inpakmachines</h3>
          <p class="mt-4 text-grijs">Van flowpackmachines en netverpakkingssystemen tot complete inpaklijnen, voor AGF-producten en andere voedingsmiddelen. Elke lijn is anders, dus elke machine sluit aan op die van u.</p>
        </div>
      </article>

      <article class="wrap mt-20 grid items-start gap-y-8 md:mt-24 lg:grid-cols-12 lg:gap-x-14" aria-labelledby="m-pallet">
        <div class="rijs order-2 lg:order-1 lg:col-span-5 lg:pt-10">
          <h3 id="m-pallet" class="text-2xl md:text-[2.25rem]">Palletiseer&shy;machines</h3>
          <p class="mt-4 text-grijs">Kratten, dozen of zakjes: van een eenvoudige handmatige lijn tot een volledig geautomatiseerd systeem, nieuw of gereviseerd.</p>
          <p class="mt-8 border-l-[3px] border-blad pl-5 text-[.9375rem] text-inkt"><span class="font-semibold">Uit de praktijk.</span> Een palletiseermachine die dozen met druivenpunnets formeert en de lagen nauwkeurig stapelt. Een servo-gestuurd draaistation draait elke doos precies goed, met instelbare snelheid en draairichting.</p>
        </div>
        <div class="rijs order-1 grid grid-cols-5 gap-3 lg:order-2 lg:col-span-7 md:gap-4">
          <Image src={pallet} alt="Twee palletiseermachines naast elkaar achter een veiligheidshek" widths={[400, 640, 900]} sizes="(min-width: 1024px) 34vw, 60vw" quality={60} class="col-span-3 aspect-[3/4] w-full rounded-md object-cover" />
          <Image src={punnets} alt="Palletiseermachine met lagen groene punnets op een pallet" widths={[300, 480, 640]} sizes="(min-width: 1024px) 22vw, 40vw" quality={60} class="col-span-2 mt-16 aspect-[3/4] w-full rounded-md object-cover md:mt-24" />
        </div>
      </article>

      <article class="wrap mt-20 grid items-end gap-y-8 md:mt-24 lg:grid-cols-12 lg:gap-x-14" aria-labelledby="m-transport">
        <figure class="rijs lg:col-span-7">
          <Image src={transport} alt="Transportbanden met rollenbanen en blauwe banden tussen de inpakposities" widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 56vw, 100vw" quality={60} class="aspect-[16/11] w-full rounded-md object-cover object-[50%_60%]" />
        </figure>
        <div class="rijs lg:col-span-5 lg:pb-6">
          <h3 id="m-transport" class="text-2xl md:text-[2.25rem]">Transport&shy;systemen</h3>
          <p class="mt-4 text-grijs">Banden die de producten van de aanvoer naar de flowpackers en inpakmachines brengen.</p>
          <p class="mt-8 border-l-[3px] border-blad pl-5 text-[.9375rem] text-inkt"><span class="font-semibold">Uit de praktijk.</span> Voor een tomatenkweker: aanvoer van volle kratten, tafels met weegschalen voor afval en productie, een retourbaan voor lege kratten en een toevoerbaan naar de inpakmachines.</p>
        </div>
      </article>
    </section>

    <!-- 4. PROJECT GLIJGOOT: full-bleed -->
    <section class="relative isolate overflow-hidden bg-grafiet text-wit" aria-labelledby="glijgoot-titel">
      <Image src={glijgoot} alt="RVS-glijgoot die vanaf de bovenverdieping naar beneden loopt, boven de inpakposities" widths={[640, 960, 1440, 1920]} sizes="100vw" quality={60} class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_40%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,#161a17f0_0%,#161a1799_45%,#161a1733_100%)] md:bg-[linear-gradient(90deg,#161a17eb_0%,#161a17a0_40%,#161a1700_70%)]" aria-hidden="true"></div>
      <div class="wrap flex min-h-[34rem] items-end py-16 md:min-h-[40rem] md:items-center md:py-24">
        <div class="rijs max-w-lg">
          <h2 id="glijgoot-titel" class="text-3xl">Project: glijgoot voor dozen&shy;verwerking</h2>
          <p class="mt-6 text-lg text-staal">Op de bovenverdieping van een verpakkingsbedrijf worden plano dozen gemaakt. Ze worden één voor één afgestapeld, gelabeld, voorzien van een QR-code en via een glijgoot naar de inpakposities gebracht.</p>
        </div>
      </div>
    </section>

    <!-- 5. SERVICE & ONDERHOUD -->
    <section id="service" class="bg-grafiet py-20 text-wit md:py-28" aria-labelledby="service-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <h2 id="service-titel" class="rijs text-3xl">Storingen en onderhoud</h2>
          <p class="rijs mt-6 max-w-md text-lg text-mist">Een storing kan de hele productie stilleggen. Onze technici komen naar uw locatie en zorgen dat de machines zo snel mogelijk weer draaien.</p>
          <a href="#werkbon" class="knop rijs mt-9">Storing melden</a>
          <figure class="rijs mt-14">
            <Image src={bus} alt="Servicebus van Nobel in een inpakhal naast een palletiseerlijn" widths={[480, 720, 960]} sizes="(min-width: 1024px) 36vw, 100vw" quality={60} class="aspect-[16/10] w-full rounded-md object-cover object-[62%_50%]" />
          </figure>
        </div>
        <div class="lg:col-span-7 lg:pt-3">
          <dl class="border-t border-lijn-licht">
            <div class="rijs grid gap-2 border-b border-lijn-licht py-7 md:grid-cols-[14rem_1fr] md:gap-8">
              <dt class="kop text-xl text-blad-licht md:text-2xl">Storing</dt>
              <dd class="text-staal">Een kleine storing of een groter probleem: we lossen het op locatie op.</dd>
            </div>
            <div class="rijs grid gap-2 border-b border-lijn-licht py-7 md:grid-cols-[14rem_1fr] md:gap-8">
              <dt class="kop text-xl text-blad-licht md:text-2xl">Preventief onderhoud</dt>
              <dd class="text-staal">Verlengt de levensduur van uw machines en voorkomt nieuwe storingen.</dd>
            </div>
            <div class="rijs grid gap-2 border-b border-lijn-licht py-7 md:grid-cols-[14rem_1fr] md:gap-8">
              <dt class="kop text-xl text-blad-licht md:text-2xl">Onderhouds&shy;contract</dt>
              <dd class="text-staal">Eenmalige reparatie of een doorlopend onderhoudsplan, afgestemd op uw productie.</dd>
            </div>
            <div class="rijs grid gap-2 border-b border-lijn-licht py-7 md:grid-cols-[14rem_1fr] md:gap-8">
              <dt class="kop text-xl text-blad-licht md:text-2xl">Revisie</dt>
              <dd class="text-staal">Bestaande systemen reviseren of optimaliseren, zodat ze weer passen bij het productieproces.</dd>
            </div>
          </dl>
          <figure class="rijs mt-16">
            <blockquote class="font-kop text-2xl font-semibold leading-snug text-wit md:text-[2rem]">
              <p>"Wij kiezen duidelijk voor Nobel Food Tech vanwege hun betrouwbaarheid, snelheid en expertise. In onze branche is minimale stilstand cruciaal…"</p>
            </blockquote>
            <figcaption class="mt-5 text-sm text-mist">Nathan Mostert, PackXpert</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 6. AANBOD -->
    <section id="aanbod" class="py-16 md:py-28" aria-labelledby="aanbod-titel">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
          <h2 id="aanbod-titel" class="rijs text-3xl">Aanbod machines</h2>
          <p class="rijs max-w-sm text-grijs">Prijs op aanvraag. Stuur een bericht voor de prijs en meer details.</p>
        </div>
        <ul class="mt-12 grid gap-x-6 gap-y-12 md:grid-cols-3">
          {aanbod.map((m, i) => (
            <li class="rijs flex min-w-0 flex-col" style={`--d:${i * 0.08}s`}>
              <Image src={m.foto} alt={m.alt} widths={[360, 540, 760]} sizes="(min-width: 768px) 31vw, 100vw" quality={60} class="aspect-[4/3] w-full rounded-md object-cover md:aspect-[4/5]" style={`object-position:${m.pos}`} />
              <div class="plaatje -mt-10 mx-3 flex flex-1 flex-col px-5 pb-6 pt-7 shadow-sm md:mx-4 md:px-6">
                <h3 class="text-xl [hyphens:auto]">{m.naam}</h3>
                {m.type && <p class="num mt-1 text-sm font-semibold text-blad-donker">Type {m.type}</p>}
                <ul class="mt-3 space-y-1 text-[.9375rem] text-grijs">{m.regels.map((r) => <li>{r}</li>)}</ul>
                <a href={waMet(`Hallo Nobel Food Tech, ik heb interesse in de ${m.naam}${m.type ? ' ' + m.type : ''} uit uw aanbod. Wat is de prijs?`)} class="mt-auto inline-flex items-center gap-2 pt-5 font-semibold text-inkt no-underline hover:text-blad-donker">
                  <Icoon naam="wa" class="h-5 w-5 text-blad-donker" />Prijs opvragen
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. WERKBON (wow) + CONTACT -->
    <section id="contact" class="bg-staal py-16 md:py-28" aria-labelledby="werkbon-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-4">
          <h2 id="werkbon-titel" class="rijs text-3xl">Vertel welke machine het is</h2>
          <p class="rijs mt-6 text-grijs">Vul de werkbon in en stuur hem via WhatsApp. Of bel direct.</p>
          <dl class="rijs mt-10 space-y-6 text-[.9375rem]">
            <div>
              <dt class="font-semibold">Telefoon en WhatsApp</dt>
              <dd class="mt-1"><a href={site.telHref} class="link num text-lg font-semibold">{site.tel}</a></dd>
            </div>
            <div>
              <dt class="font-semibold">E-mail</dt>
              <dd class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></dd>
            </div>
            <div>
              <dt class="font-semibold">Adres</dt>
              <dd class="mt-1">{site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-grijs">Bezoek op afspraak.</span> <a href={site.maps} class="link">Route</a></dd>
            </div>
          </dl>
        </div>

        <form id="werkbon" class="etiket rijs min-w-0 scroll-mt-28 p-5 pl-8 md:p-10 md:pl-14 lg:col-span-8" data-bon aria-labelledby="bon-kop" novalidate>
          <div class="flex items-start justify-between gap-6 border-b border-dashed border-staal-2 pb-6">
            <div>
              <p id="bon-kop" class="kop flex flex-wrap items-center gap-3 text-2xl">Werkbon <span class="hidden rounded-sm border-2 border-grafiet px-2 py-0.5 text-sm tracking-wide" data-stempel>SPOED</span></p>
              <p class="mt-1 text-sm text-grijs">Nobel Food Tech · {site.plaats}</p>
            </div>
            <svg viewBox="0 0 25 25" class="h-16 w-16 shrink-0 text-inkt md:h-20 md:w-20" shape-rendering="crispEdges" aria-hidden="true" data-qr></svg>
          </div>

          <fieldset class="mt-7">
            <legend class="font-semibold">Wat is er nodig?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              <label><input type="radio" name="soort" value="storing" class="peer sr-only" checked /><span class="keus">Storing</span></label>
              <label><input type="radio" name="soort" value="onderhoud" class="peer sr-only" /><span class="keus">Onderhoud of contract</span></label>
              <label><input type="radio" name="soort" value="offerte" class="peer sr-only" /><span class="keus">Offerte nieuwe machine</span></label>
            </div>
          </fieldset>

          <div class="mt-7 grid gap-5 md:grid-cols-2">
            <label class="block">
              <span class="font-semibold">Soort machine</span>
              <select name="machine" class="veld mt-2">
                <option>Inpakmachine</option>
                <option>Palletiseermachine</option>
                <option>Transportsysteem</option>
                <option>Kistenkantelaar</option>
                <option>Andere machine</option>
              </select>
            </label>
            <label class="block">
              <span class="font-semibold">Merk en type</span>
              <input name="merk" class="veld mt-2" autocomplete="off" placeholder="Bijvoorbeeld Cosmec Pac230" />
            </label>
            <label class="block md:col-span-2">
              <span class="font-semibold">Bedrijf en plaats</span>
              <input name="bedrijf" class="veld mt-2" autocomplete="organization" />
            </label>
          </div>

          <label class="mt-7 flex cursor-pointer items-center gap-4">
            <input type="checkbox" name="spoed" class="sr-only" data-spoed />
            <span class="schuif" aria-hidden="true"></span>
            <span><span class="font-semibold">Spoed</span> <span class="text-grijs">de productie staat stil</span></span>
          </label>

          <div class="mt-8 rounded-sm bg-staal p-5">
            <p class="text-xs font-semibold text-grijs">Uw bericht</p>
            <p class="mt-2 text-[.9375rem]" data-bericht aria-live="polite"></p>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waHoi} class="knop" data-wa><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="link font-semibold" data-mail>Of per e-mail</a>
          </div>
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  // Werkbon: bouwt een kort bericht en zet het in de WhatsApp- en mailknop. Verstuurt zelf niets.
  const f = document.querySelector<HTMLFormElement>('[data-bon]');
  if (f) {
    const $ = <T extends Element>(s: string) => f.querySelector<T>(s)!;
    const wa = $<HTMLAnchorElement>('[data-wa]');
    const mail = $<HTMLAnchorElement>('[data-mail]');
    const qr = $<SVGSVGElement>('[data-qr]');
    const basis = wa.href.split('?')[0];

    // Decoratieve QR-achtige code, zoals op hun dozenetiketten; verandert mee met het bericht.
    const tekenQr = (t: string) => {
      let h = 2166136261;
      for (let i = 0; i < t.length; i++) { h ^= t.charCodeAt(i); h = Math.imul(h, 16777619); }
      const rnd = () => { h ^= h << 13; h ^= h >>> 17; h ^= h << 5; return (h >>> 0) / 4294967296; };
      const oog = (x: number, y: number) => `<rect x="${x}" y="${y}" width="7" height="7"/><rect x="${x + 1}" y="${y + 1}" width="5" height="5" fill="#fff"/><rect x="${x + 2}" y="${y + 2}" width="3" height="3"/>`;
      let s = `<rect width="25" height="25" fill="#fff"/><g fill="currentColor">${oog(0, 0)}${oog(18, 0)}${oog(0, 18)}`;
      for (let y = 0; y < 25; y++) for (let x = 0; x < 25; x++) {
        const inOog = (x < 8 && y < 8) || (x > 16 && y < 8) || (x < 8 && y > 16);
        if (!inOog && rnd() > 0.52) s += `<rect x="${x}" y="${y}" width="1" height="1"/>`;
      }
      qr.innerHTML = s + '</g>';
    };

    const zet = () => {
      const d = new FormData(f);
      const soort = String(d.get('soort'));
      const machine = String(d.get('machine') || '').toLowerCase();
      const merk = String(d.get('merk') || '').trim();
      const bedrijf = String(d.get('bedrijf') || '').trim();
      const spoed = d.get('spoed') === 'on';
      const wat = soort === 'storing' ? `een storing aan een ${machine}` : soort === 'onderhoud' ? `een vraag over onderhoud van een ${machine}` : `interesse in een offerte voor een ${machine}`;
      const tekst = `Hallo Nobel Food Tech, ik heb ${wat}${merk ? ` (${merk})` : ''}.${bedrijf ? ` Bedrijf: ${bedrijf}.` : ''}${spoed ? ' SPOED: de productie staat stil.' : ''} Kunt u contact met mij opnemen?`;
      $('[data-bericht]').textContent = tekst;
      wa.href = `${basis}?text=${encodeURIComponent(tekst)}`;
      mail.href = `mailto:${site.mail}?subject=${encodeURIComponent((spoed ? 'SPOED: ' : '') + 'Werkbon via website')}&body=${encodeURIComponent(tekst)}`;
      tekenQr(tekst);
      $('[data-stempel]').classList.toggle('hidden', !spoed);
    };
    f.addEventListener('input', zet);
    f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
