---
// Hun eigen woordmerk nagezet: OHØJ in dunne, ruime kapitalen met "coffee roasting" eronder, in een lijnkader (zoals op FB-logo en gevel).
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="inline-flex no-underline">
  <span class={`flex flex-col items-center border-[1.5px] border-current leading-none ${klein ? 'px-3 py-1.5' : 'px-3.5 py-2'}`}>
    <span class={`font-[250] tracking-[.32em] pl-[.32em] ${klein ? 'text-[1.25rem]' : 'text-[1.5rem]'}`}>OHØJ</span>
    <span class={`mt-1 font-[350] tracking-[.12em] ${klein ? 'text-[.5625rem]' : 'text-[.625rem]'}`}>coffee roasting</span>
  </span>
</a>
