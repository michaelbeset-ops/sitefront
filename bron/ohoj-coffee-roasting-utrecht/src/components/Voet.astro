---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="op-bord bg-bord pb-14 text-zacht md:pb-0">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-krijt md:col-span-5">
      <Merk klein />
      <p class="mt-6 max-w-xs text-zacht">Espressobar en specialty coffee-branderij in de Rivierenwijk, Utrecht.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-krijt">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a> · <a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-1"><a href={site.instagram} class="link">Instagram</a> · <a href={site.facebook} class="link">Facebook</a></p>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-krijt">Open</p>
      <p class="mt-4">Woensdag t/m vrijdag 08.00 - 13.00 uur<br />Zaterdag en zondag 09.00 - 13.00 uur<br />Maandag en dinsdag gesloten</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-bord py-7 text-xs">
    <p>© {jaar} {site.vol}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-kobalt-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-10 text-xs md:pb-8">Foto’s van de eigen Facebookpagina van Ohøj en van het Google-bedrijfsprofiel (pand, etalage, brander, bord). Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
