---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, bord, reviews, waHoi, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import etalage from '../assets/etalage.jpg';
import brander from '../assets/brander.jpg';
import bonen from '../assets/bonen.jpg';
import latte from '../assets/latte.jpg';
import gevel from '../assets/gevel.jpg';

const methodes = [['een espressomachine', 'espressomachine'], ['een filter', 'filter'], ['een French press', 'French press']];
const smaken = ['vol en chocoladeachtig', 'fruitig en fris', 'iets bijzonders', 'van alles, verras me maar'];
const malingen = [['hele bonen', 'hele bonen'], ['gemalen', 'gemalen']];
const vraag = (m: string, mk: string, s: string, g: string) =>
  `Hoi Kevin! Ik zet thuis koffie met ${m} en ik hou van ${s}. Welke bonen raad je aan? Graag ${g === 'gemalen' ? `gemalen voor mijn ${mk}` : 'hele bonen'}. Dan kom ik ze halen aan de Rijnlaan.`;
const startVraag = vraag(methodes[0][0], methodes[0][1], smaken[0], malingen[0][1]);

const titel = 'Ohøj Coffee Roasting | Koffiebranderij aan de Rijnlaan, Utrecht';
const omschrijving = 'Ohøj Coffee Roasting, Rijnlaan 27 in Utrecht (Rivierenwijk): vers gebrande koffiebonen, heel of gemalen, woensdag t/m zondag. Espressobar op vrijdag, zaterdag en zondag.';
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO: hun eigen foto van de koelbak vol vers gebrande bonen, schermvullend -->
    <section class="op-bord relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-bord text-krijt md:min-h-[100svh]">
      <Kop />
      <div class="absolute inset-0 -z-10">
        <Image src={hero} alt="Kevin roert met zijn hand door de koelbak van de brander, vol vers gebrande koffiebonen" quality={74} widths={[480, 768, 1080, 1440]} sizes="100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[62%_50%] md:object-[50%_46%]" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,#151515b3_0%,#15151533_26%,#15151599_52%,#151515f0_100%)] md:bg-[linear-gradient(90deg,#151515f0_0%,#151515c7_40%,#15151526_72%),linear-gradient(180deg,#15151599_0%,#15151500_24%,#15151500_70%,#151515b3_100%)]"></div>
      </div>
      <div class="wrap mt-auto pb-14 pt-28 sm:pb-20 sm:pt-36 lg:pb-24">
        <p class="text-[.9375rem] font-medium text-krijt/90">Koffiebranderij in de Rivierenwijk, Utrecht</p>
        <h1 class="mt-6 max-w-[17ch] text-hero">Vers gebrand <br class="max-md:hidden" />aan de <span class="text-kobalt-licht">Rijnlaan.</span></h1>
        <p class="mt-6 max-w-xl text-base text-krijt/90 sm:mt-7 sm:text-lg md:text-xl">Bonen, heel of gemalen voor thuis, van woensdag tot en met zondag. Op vrijdag, zaterdag en zondag zet Kevin ook je cappuccino.</p>
        <div class="mt-7 flex flex-wrap gap-3 sm:mt-9">
          <a href="#bonen" class="knop knop-kobalt max-sm:min-h-12 max-sm:px-5">Welke bonen passen bij mij?</a>
          <a href={waHoi} class="knop knop-wit max-sm:min-h-12 max-sm:px-5"><Icoon naam="wa" />WhatsApp</a>
        </div>
        <p class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-krijt/80 max-md:hidden" data-status-wrap>
          <span class="inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-kobalt-licht"></span><span data-status>Woensdag t/m zondag open tot 13.00 uur</span></span>
          <span>{site.straat}, {site.plaats}</span>
        </p>
      </div>
    </section>

    <!-- 2. DE BRANDERIJ: de etalage vol jute zakken, de brander, Kevin in eigen woorden -->
    <section id="zaak" class="py-24 md:py-36">
      <div class="wrap">
        <div class="grid items-end gap-y-8 md:grid-cols-12 md:gap-x-10">
          <h2 class="rijs text-3xl md:col-span-7">Groene bonen in de etalage, gebrand achter de bar.</h2>
          <p class="rijs max-w-md text-lg text-grijs md:col-span-5">Ohøj is een espressobar en specialty coffee-branderij. Kevin brandt de bonen zelf en verkoopt ze heel of gemalen.</p>
        </div>
        <div class="mt-16 grid gap-y-12 md:mt-20 md:grid-cols-12 md:gap-x-10">
          <figure class="rijs md:col-span-8">
            <Image src={etalage} alt="De etalage van Ohøj vol jute zakken groene koffie, met een houten bank ervoor" quality={72} widths={[480, 800, 1100, 1500]} sizes="(min-width: 768px) 64vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">De etalage aan de Rijnlaan: jute zakken groene koffie, met het bankje ervoor.</figcaption>
          </figure>
          <div class="flex flex-col gap-y-12 md:col-span-4">
            <figure class="rijs" style="--d:.1s">
              <Image src={brander} alt="De zwarte koffiebrander in de zaak, onder een gloeilamp" quality={72} widths={[400, 700]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_60%]" />
              <figcaption class="mt-3 text-sm text-grijs">De brander staat gewoon in de zaak.</figcaption>
            </figure>
            <figure class="rijs border-l-2 border-kobalt pl-6" style="--d:.15s">
              <blockquote class="text-2xl font-semibold leading-snug">“De winkel blijft drukker dan ik ooit had kunnen dromen!”</blockquote>
              <figcaption class="mt-3 text-sm text-grijs">Kevin, op Facebook</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. WOW: welke bonen passen bij mij? Eén zin met keuzes, eindigt in WhatsApp -->
    <section id="bonen" class="relative bg-kobalt text-wit">
      <div class="wrap grid gap-y-14 py-24 md:py-36 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-7">
          <h2 class="rijs text-3xl">Welke bonen passen bij jou?</h2>
          <form class="zin rijs relative mt-12 text-xl leading-[2.1] md:text-[1.75rem] md:leading-[2.05]" data-bonen onsubmit="return false">
            <span>Ik zet thuis koffie met </span>
            <label class="sr-only" for="b-methode">Zetmethode</label>
            <select id="b-methode" name="methode">{methodes.map(([t, k]) => <option value={t} data-kort={k}>{t}</option>)}</select>
            <span> en ik hou van </span>
            <label class="sr-only" for="b-smaak">Smaak</label>
            <select id="b-smaak" name="smaak">{smaken.map((s) => <option value={s}>{s}</option>)}</select><span>. </span>
            <span>Graag </span>
            <label class="sr-only" for="b-maling">Heel of gemalen</label>
            <select id="b-maling" name="maling">{malingen.map(([t, v]) => <option value={v}>{t}</option>)}</select><span>.</span>
          </form>
          <div class="rijs mt-12 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waMet(startVraag)} class="knop knop-vol" data-bonen-knop><Icoon naam="wa" />Vraag het Kevin</a>
            <p class="max-w-xs text-sm text-wit/85">Wat er op de plank staat wisselt. Kevin weet wat er nu ligt.</p>
          </div>
        </div>
        <figure class="rijs lg:col-span-5">
          <Image src={bonen} alt="Een houten plank met bruine zakken koffiebonen van Ohøj" quality={72} widths={[480, 760, 1000]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[5/4] w-full rounded-sm object-cover" />
          <figcaption class="mt-3 text-sm text-wit/85">Espresso- en filterbonen, heel of gemalen mee naar huis.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. HET BORD: hun letterbord als echte menukaart, zonder prijzen -->
    <section id="bord" class="op-bord bg-bord py-24 text-krijt md:py-36">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl">Van het bord</h2>
          <p class="rijs mt-6 max-w-md text-lg text-zacht">Koffie drinken kan op vrijdag, zaterdag en zondag, aan de bar of om mee te nemen. Gezet op een Kees van der Westen Idrocompresso.</p>
          <figure class="rijs mt-12 max-lg:hidden">
            <Image src={latte} alt="Een cappuccino met een hartje latte art van dichtbij" quality={72} widths={[480, 760]} sizes="36vw" class="aspect-square w-full rounded-sm object-cover" />
          </figure>
        </div>
        <div class="rijs lg:col-span-7">
          <div class="bord rounded-sm border border-lijn-bord p-6 sm:p-10 md:p-12">
            <div class="grid gap-x-12 gap-y-10 md:grid-cols-[1.35fr_1fr]">
              {[bord.slice(0, 2), bord.slice(2)].map((kolom) => (
                <div class="space-y-10">
                  {kolom.map((g) => (
                    <div>
                      <div class="grid grid-cols-[1fr_repeat(3,1.75rem)] items-end gap-x-1 border-b-2 border-krijt pb-2">
                        <h3 class="bord-kop text-lg">{g.kop}</h3>
                        {g.maten && ['S', 'M', 'L'].map((m) => <span class="bord-kop text-center text-sm">{m}</span>)}
                      </div>
                      <ul class="mt-4 space-y-2.5">
                        {g.regels.map((r) => (
                          <li class={`grid grid-cols-[1fr_repeat(3,1.75rem)] items-center gap-x-1 ${r.sub ? 'pl-4 text-zacht' : ''}`}>
                            <span class={`bord-regel ${g.maten ? '' : 'col-span-4'} text-[.9375rem]`}>{r.naam}</span>
                            {g.maten && r.m!.map((x) => <span class="text-center text-krijt" aria-hidden="true">{x ? '●' : ''}</span>)}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <p class="mt-4 text-sm text-zacht">Zoals op het bord aan de muur. De prijzen staan op het bord in de zaak.</p>
        </div>
      </div>
    </section>

    <!-- 5. REVIEWS: één groot citaat, drie kleine, score één keer klein -->
    <section class="py-24 md:py-36">
      <div class="wrap grid gap-y-16 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-7">
          <blockquote class="text-[clamp(1.5rem,1.6vw+1rem,2.375rem)] font-semibold leading-[1.3] tracking-[-0.01em]">“{reviews.groot.tekst}”</blockquote>
          <figcaption class="mt-6 text-sm text-grijs">{reviews.groot.naam} · Google</figcaption>
        </figure>
        <div class="lg:col-span-5 lg:pt-3">
          <ul class="space-y-9">
            {reviews.klein.map((r, i) => (
              <li class="rijs border-t border-lijn pt-6" style={`--d:${i * .08}s`}>
                <p class="text-lg">“{r.tekst}”</p>
                <p class="mt-2 text-sm text-grijs">{r.naam} · Google</p>
              </li>
            ))}
          </ul>
          <p class="rijs mt-10 inline-flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, uit {site.google.aantal} reviews</p>
        </div>
      </div>
    </section>

    <!-- 6. OPEN & ROUTE: de gevel, tijden met vandaag en live status, bar-dagen apart -->
    <section id="bezoek" class="bg-muur-2 py-24 md:py-36">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-5">
          <Image src={gevel} alt="De gevel van Ohøj met de letters OHØJ boven het grote raam en een jute zak in de etalage" quality={72} widths={[480, 760, 1000]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_30%] max-lg:aspect-[4/3] max-lg:object-[50%_6%]" />
        </figure>
        <div class="lg:col-span-6 lg:col-start-7">
          <h2 class="rijs text-3xl">Rijnlaan 27</h2>
          <p class="rijs mt-4 text-lg text-grijs">{site.postcode} {site.plaats}, in de {site.wijk}. Honden zijn welkom.</p>
          <p class="rijs mt-8 inline-flex items-center gap-2 text-sm font-semibold" data-status-wrap><span class="h-2 w-2 rounded-full bg-kobalt"></span><span data-status>Woensdag t/m zondag open</span></p>
          <table class="rijs mt-5 w-full text-[1.0625rem]">
            <caption class="sr-only">Openingstijden</caption>
            <thead class="sr-only"><tr><th scope="col">Dag</th><th scope="col">Tijden</th><th scope="col">Wat</th></tr></thead>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-bold data-[vandaag]:text-kobalt">
                  <th scope="row" class="py-3 pr-4 text-left font-[inherit]">{t.naam}</th>
                  <td class="num whitespace-nowrap py-3 pr-4">{t.open ? `${t.open} - ${t.dicht}` : 'gesloten'}</td>
                  <td class="py-3 text-right text-sm text-grijs">{t.open && (t.bar ? <><span class="sm:hidden">bonen + bar</span><span class="max-sm:hidden">bonen en koffie aan de bar</span></> : <><span class="sm:hidden">bonen</span><span class="max-sm:hidden">bonen en gemalen koffie</span></>)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="rijs mt-5 text-sm text-grijs">Even dicht, bijvoorbeeld rond de feestdagen? Dat zet Kevin op Google Maps en Instagram.</p>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={site.maps} class="knop knop-lijn"><Icoon naam="pin" />Route</a>
            <a href={waHoi} class="knop knop-kobalt"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-bonen]');
  const k = document.querySelector<HTMLAnchorElement>('[data-bonen-knop]');
  if (f && k) {
    const bouw = () => {
      const m = f.querySelector<HTMLSelectElement>('#b-methode')!;
      const mk = m.selectedOptions[0].dataset.kort || '';
      const s = f.querySelector<HTMLSelectElement>('#b-smaak')!.value;
      const g = f.querySelector<HTMLSelectElement>('#b-maling')!.value;
      const t = `Hoi Kevin! Ik zet thuis koffie met ${m.value} en ik hou van ${s}. Welke bonen raad je aan? Graag ${g === 'gemalen' ? `gemalen voor mijn ${mk}` : 'hele bonen'}. Dan kom ik ze halen aan de Rijnlaan.`;
      k.href = `https://wa.me/31657821403?text=${encodeURIComponent(t)}`;
    };
    // Elke keuzelijst zo breed als de gekozen tekst, zodat de zin een zin blijft.
    const maat = document.createElement('span');
    maat.style.cssText = 'position:absolute;left:0;top:0;visibility:hidden;white-space:pre;font-weight:700';
    f.appendChild(maat);
    const pas = () => f.querySelectorAll('select').forEach((x) => { maat.textContent = x.selectedOptions[0].text; x.style.width = `calc(${maat.offsetWidth}px + 2rem)`; });
    f.addEventListener('change', () => { bouw(); pas(); });
    bouw(); pas();
    document.fonts?.ready.then(pas);
  }
</script>
