---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Zon from './Zon.astro';
const jaar = new Date().getFullYear();
const producten = ['Rolluiken', 'Screens', 'Knikarmschermen', 'Markiezen', 'Overkappingen', 'Kozijnen'];
---
<footer class="relative overflow-hidden bg-nacht text-mist">
  <Zon class="pointer-events-none absolute -bottom-2 right-[-6rem] w-[34rem] text-wit/[.04] md:right-0" />
  <div class="wrap relative grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-wit md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-mist">Plaatst zonweringen, rolluiken &amp; meer. Een familiebedrijf uit Goirle, voor Tilburg en omstreken.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Assortiment</p>
      <ul class="mt-3 space-y-1">{producten.map((p) => <li><a href={url('#assortiment')} class="no-underline hover:text-zon">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="num no-underline hover:text-zon">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="no-underline hover:text-zon">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="no-underline hover:text-zon">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Showroom</p>
      <p class="mt-3">Bezoek op afspraak</p>
      <p class="mt-4"><a href={site.facebook} class="no-underline hover:text-zon">Facebook</a></p>
    </div>
  </div>
  <div class="wrap relative flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap relative pb-24 text-xs md:pb-8">Foto's van jullie eigen website en Facebook-pagina. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
