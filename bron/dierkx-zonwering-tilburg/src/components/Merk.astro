---
// Woordmerk naar hun logo: de halve zon in geel, "Dierkx" in Sora, "zonweringen" eronder.
import { url } from '../data/site';
import Zon from './Zon.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex items-end gap-2.5 text-current no-underline', cls]}>
  <Zon class="h-6 w-auto flex-none text-zon md:h-7" stralen={9} />
  <span class="leading-none">
    <span class="kop block text-[1.35rem] tracking-[-0.04em] md:text-[1.5rem]">Dierkx</span>
    <span class="mt-0.5 block text-[.72rem] font-semibold tracking-[.02em] opacity-80">zonweringen</span>
  </span>
</a>
