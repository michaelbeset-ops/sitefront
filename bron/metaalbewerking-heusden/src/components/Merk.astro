---
// Woordmerk naar hun logo: de naam in een schreefletter met een indigo lijn die onder de M begint met een krul.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex flex-col no-underline', licht ? 'text-wit' : 'text-indigo', cls]} aria-label="Metaalbewerking Heusden, naar de homepage">
  <span class="kop text-[1.125rem] leading-none tracking-[-.01em] sm:text-[1.3125rem]">Metaalbewerking Heusden</span>
  <svg viewBox="0 0 240 14" class="mt-1 h-[.7rem] w-full" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" preserveAspectRatio="none" aria-hidden="true">
    <path d="M10 2.5c-5 0-7 3.5-5 6.5s7.5 2.5 9-.5S12 3 14 5c3 3 8 4.5 16 4.5h208" vector-effect="non-scaling-stroke" />
  </svg>
</a>
