---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-indigo-diep text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Constructie-, las- en reparatiebedrijf voor RVS, staal en aluminium. Voor bedrijven en particulieren.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Op de site</p>
      <ul class="mt-3 space-y-1">
        {[['bewerkingen', 'Bewerkingen'], ['werkhal', 'Werkhal'], ['projecten', 'Projecten'], ['werkbon', 'Werk aanvragen']].map(([id, t]) => <li><a href={url(`#${id}`)} class="link link-licht no-underline hover:underline">{t}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3">{site.eigenaar}</p>
      <p class="mt-1"><a href={site.telHref} class="link link-licht num">{site.tel}</a> · <a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Open</p>
      <p class="mt-3 num">ma t/m do 08:00-21:00<br />vr en za 08:00-17:00</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} Metaalbewerking Heusden v.o.f., {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's en teksten van jullie huidige website. Openingstijden volgens Google.</p>}
</footer>
