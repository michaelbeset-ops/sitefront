---
import { site, url, waHoi, tijden, uur } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const werk = [['reparatie', 'Reparatie en onderhoud'], ['fietsen', 'Tweedehands fietsen'], ['inkoop', 'Fiets verkopen'], ['appje', 'Appje klaarzetten'], ['reviews', 'Reviews']];
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.95rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Inkoop, verkoop en reparatie van fietsen. Aan de Korvelseweg in {site.plaats}.</p>
      <p class="mt-5 flex items-center gap-2 text-[.9rem]"><Icoon naam="ster" class="h-4 w-4 text-merk-licht" /><span><b class="num text-wit">{site.google.score}</b> op Google, {site.google.aantal} reviews</span></p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Winkel en werkplaats</p>
      <ul class="mt-5 space-y-2">
        {werk.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2">
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a> <span class="text-mist/80">(ook WhatsApp)</span></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-merk-licht">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.route} class="no-underline hover:text-merk-licht">Route plannen</a></li>
        <li><a href={site.fb} class="inline-flex items-center gap-1.5 no-underline hover:text-merk-licht"><Icoon naam="fb" class="h-4 w-4" />Facebook</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <ul class="mt-5 space-y-2">
        <li class="flex justify-between gap-4"><span>Ma - vr</span><span class="num text-wit">{uur(10)} - {uur(18)}</span></li>
        <li class="flex justify-between gap-4"><span>Za</span><span class="num text-wit">{uur(tijden[6].open!)} - {uur(tijden[6].dicht!)}</span></li>
        <li class="flex justify-between gap-4"><span>Zo</span><span>Gesloten</span></li>
      </ul>
      <a href={waHoi} class="knop knop-merk mt-7 min-h-11 px-5"><Icoon naam="wa" />WhatsApp</a>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  <p class="wrap pb-8 text-xs">Foto's van de winkel: Google-bedrijfsprofiel en Facebook van {site.naam}. Werkplaatsfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google, tijden volgens Google (stand 13 oktober 2026).</p>
  <div class="h-14 md:hidden" aria-hidden="true"></div>
</footer>
