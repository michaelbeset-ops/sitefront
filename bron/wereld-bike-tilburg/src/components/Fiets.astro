---
// Beeldmerk naar hun neonbord: rode boog boven een fiets met twee wereldbollen als wielen.
interface Props { class?: string; boog?: string }
const { class: cls = '', boog = '#c41f2a' } = Astro.props;
---
<svg viewBox="0 0 64 52" class={cls} fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M8 22a24 24 0 0 1 48 0" stroke={boog} stroke-width="6.5" stroke-linecap="butt" />
  <g stroke-width="2.4">
    <circle cx="16" cy="39" r="10" />
    <circle cx="48" cy="39" r="10" />
    <path d="M16 39l9-14h17l6 14M25 25l9 14h-18M34 39l8-14M23 22h6M42 25l-1.5-5h4" />
  </g>
  <g stroke-width="1.2" opacity=".75">
    <ellipse cx="16" cy="39" rx="4.2" ry="10" /><path d="M6.6 35.5h18.8M6.6 42.5h18.8" />
    <ellipse cx="48" cy="39" rx="4.2" ry="10" /><path d="M38.6 35.5h18.8M38.6 42.5h18.8" />
  </g>
</svg>
