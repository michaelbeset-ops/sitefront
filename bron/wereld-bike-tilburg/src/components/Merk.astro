---
// Woordmerk naar hun eigen logo (rode boog, fiets met wereldbollen als wielen). Geen officieel logobestand beschikbaar.
import { url } from '../data/site';
import Fiets from './Fiets.astro';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 leading-none no-underline ${donker ? 'text-nacht' : 'text-wit'}`}>
  <Fiets class="h-10 w-12 flex-none sm:h-11 sm:w-[3.3rem]" />
  <span class="flex flex-col">
    <span class="kop text-[1.6rem] font-[900] leading-[.9] tracking-[-.03em] sm:text-[1.8rem]">Wereld Bike</span>
    <span class="mt-1.5 text-[.7rem] font-extrabold uppercase tracking-[.2em] opacity-75">Korvelseweg · Tilburg</span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>
