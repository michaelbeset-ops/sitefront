---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, vakken, review, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import nis from '../assets/nis.jpg';
import badkamer from '../assets/badkamer.jpg';
import sanitair from '../assets/sanitair.jpg';
import regendouche from '../assets/regendouche.jpg';
import wastafel from '../assets/wastafel.jpg';
import douche from '../assets/douche.jpg';
import ligbad from '../assets/ligbad.jpg';
import radiator from '../assets/radiator.jpg';
import bus from '../assets/bus.jpg';
import aMarmer from '../assets/a-marmer.jpg';
import aHardsteen from '../assets/a-hardsteen.jpg';
import aMonkey from '../assets/a-monkeytown.jpg';

const vraag = (b: string) => waMet(`Hallo Dennie, ik wil graag een offerte voor ${b.toLowerCase()}.`);

const diensten = [
  { t: 'Tegelwerk', d: 'Wand- en vloertegels, van groot formaat tot visgraat.', src: nis, alt: 'Verlichte nis met groene tegels in visgraatmotief, afgewerkt met een zwart profiel', pos: '50% 50%' },
  { t: 'Badkamers', d: 'Van slopen en leidingwerk tot de laatste tegel en het sanitair.', src: badkamer, alt: 'Badkamer met beige visgraattegels, een organische spiegel, een zwevend notenhouten badmeubel en een ligbad', pos: '50% 45%' },
  { t: 'Loodgieters- en installatiewerk', d: 'Leidingen, inbouwthermostaten en regendouches.', src: sanitair, alt: 'Twee inbouwthermostaten en handdouches in zwart, op grote betonlook-tegels', pos: '50% 60%' },
];

const meer = [
  { t: 'Timmerwerk', d: 'Bij een verbouwing of renovatie, binnen en buiten.', i: 'hamer' },
  { t: 'Schilder- en stucwerk', d: 'Voor strakke wanden en plafonds als afwerking.', i: 'roller' },
  { t: 'Electra', d: 'Gelijk meegenomen in de planning van het werk.', i: 'bliksem' },
  { t: 'Renovatie- en sloopwerk', d: 'Van slopen tot opnieuw opbouwen.', i: 'sloop' },
];

const stappen = [
  ['Bel of app Dennie', 'Vertel wat u wilt laten doen. Foto’s van de huidige situatie helpen om een eerste beeld te krijgen.'],
  ['Advies op maat', 'Dennie luistert naar uw wensen en geeft advies waar het nodig is, over tegels, indeling en planning.'],
  ['Offerte op maat', 'U ontvangt een vrijblijvende offerte die past bij uw klus, zodat u weet waar u aan toe bent.'],
  ['Uitvoering', 'Dennie is zelf tegelzetter. Andere vakken doen vaste onderaannemers, onder zijn coördinatie.'],
];
---
<Base title={`${site.naam} | Tegelzetter en bouwbedrijf in ${site.plaats}`} description="Tegelzetter en allround bouwbedrijf uit Maassluis, sinds 2003. Tegelwerk, badkamers, verbouw en renovatie voor particulieren en bedrijven. VCA-VOL. 5,0 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: een eigen opgeleverde badkamer op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1283]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_62%] lg:left-auto lg:w-[58%] lg:object-[50%_70%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#151816a6_0%,#151816cc_40%,#151816f5_100%)] md:bg-[linear-gradient(90deg,#151816f2_0%,#151816b8_42%,#1518161f_100%)] lg:bg-[linear-gradient(90deg,#151816_0%,#151816_42%,#151816b3_52%,#15181600_72%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Tegelzetter<span class="hidden sm:inline">&nbsp;en bouwbedrijf</span>&nbsp;in {site.plaats}</p>
          <h1 id="t-hero" class="mt-5 text-hero">Tegelwerk om door een <span class="text-lime">ringetje</span> te halen.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Dennie Hus begon in {site.sinds} als zelfstandig tegelzetter. Nu verbouwt en renoveert hij badkamers, woningen en bedrijfspanden, met een vast netwerk van vakmensen.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-groen"><Icoon naam="wa" />Offerte aanvragen</a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 7.30 tot 18.00 uur</span></li>
            <li class="flex items-center gap-2"><Icoon naam="schild" class="h-4 w-4 text-lime" />VCA-VOL</li>
          </ul>
        </div>
        <div class="hidden self-end lg:col-span-4 lg:flex lg:justify-end">
          <p class="flex items-center gap-3 rounded-md bg-nacht/80 px-4 py-3 text-sm text-licht shadow-md ring-1 ring-licht/15 backdrop-blur-md">
            <span class="h-2 w-2 rotate-45 bg-lime" aria-hidden="true"></span>Badkamer van D. Hus, met inloopdouche
          </p>
        </div>
      </div>
    </section>

    <!-- 2. Vakken -->
    <section class="border-b border-lijn bg-wit" aria-label="Vakgebieden in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {vakken.map((c) => <a href="#diensten" class="flex shrink-0 items-center gap-2 rounded-md border border-lijn bg-papier px-3.5 py-2 text-sm font-bold no-underline transition-colors hover:border-groen hover:bg-groen hover:text-wit"><span class="h-1.5 w-1.5 rotate-45 bg-groen" aria-hidden="true"></span>{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-28" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-dienst" class="mt-4 text-3xl">Van één tegelvloer tot een complete verbouwing.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Voor bouwkundig werk in en om uw woning of bedrijfspand. Dennie is uw vaste aanspreekpunt, van offerte tot oplevering.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class={`rijs ${i === 2 ? 'sm:col-span-2 lg:col-span-1' : ''}`} style={`--d:${i * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-5 sm:p-6">
                  <div>
                    <h3 class="text-xl">{b.t}</h3>
                    <p class="mt-2 text-grijs">{b.d}</p>
                  </div>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-groen-zacht text-groen transition-colors group-hover:bg-groen group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-4 grid grid-cols-2 gap-3 sm:mt-5 sm:gap-5 lg:mt-6 lg:grid-cols-4 lg:gap-6">
          {meer.map((m, i) => (
            <li class="rijs kaart p-5 sm:p-6" style={`--d:${i * 0.05}s`}>
              <span class="grid h-11 w-11 place-items-center rounded-md border border-lijn text-groen"><Icoon naam={m.i} class="h-6 w-6" /></span>
              <h3 class="mt-5 text-[1.0625rem] hyphens-auto sm:text-lg">{m.t}</h3>
              <p class="mt-1.5 text-sm text-grijs sm:text-base">{m.d}</p>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-lg bg-beton px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-black">Ook zakelijk.</b> <span class="text-grijs">Dennie werkt ook voor vastgoedbedrijven, woningcorporaties en aannemers.</span></p>
          <a href={waMet('Hallo Dennie, ik heb een zakelijke aanvraag.')} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="wa" />Zakelijke aanvraag</a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">In de bouw sinds</dt><dd class="num cijfer order-first text-groen">{site.sinds}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Vakgebieden onder één dak</dt><dd class="num cijfer order-first">8</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Score op Google</dt><dd class="num cijfer order-first">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Veilig werken, gecertificeerd</dt><dd class="cijfer order-first">VCA</dd></div>
      </dl>
    </section>

    <!-- 5. Projecten -->
    <section id="projecten" class="donker bg-nacht py-24 text-licht lg:py-32" aria-labelledby="t-proj">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-proj" class="mt-4 text-3xl">Strak tot in de hoeken.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Badkamers die Dennie de afgelopen jaren opleverde, en eerder werk aan vloeren en bedrijfspanden.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14">
          <li class="rijs relative col-span-2 aspect-square overflow-hidden rounded-md bg-nacht-2 md:row-span-2 md:aspect-auto">
            <Image src={wastafel} alt="Dubbele wastafel met zwarte kranen op een eiken onderkast, met een spiegelkast en lichte natuursteenlook-tegels" widths={[600, 900, 1200]} sizes="(min-width: 1248px) 590px, (min-width: 768px) 48vw, 92vw" class="tegel absolute inset-0 h-full w-full object-cover object-[50%_60%]" />
          </li>
          <li class="rijs relative aspect-[4/5] overflow-hidden rounded-md bg-nacht-2" style="--d:.05s">
            <Image src={douche} alt="Inloopdouche met glazen wand, thermostaatkraan en een goot in de tegelvloer" widths={[320, 480, 640]} sizes="(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw" class="tegel absolute inset-0 h-full w-full object-cover" />
          </li>
          <li class="rijs relative aspect-[4/5] overflow-hidden rounded-md bg-nacht-2" style="--d:.1s">
            <Image src={ligbad} alt="Ligbad ingetegeld met grijze patroontegels, met een verchroomde badgreep" widths={[320, 480, 640]} sizes="(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw" class="tegel absolute inset-0 h-full w-full object-cover" />
          </li>
          <li class="rijs relative aspect-[4/5] overflow-hidden rounded-md bg-nacht-2" style="--d:.15s">
            <Image src={radiator} alt="Detail: een spiegel in een in verstek getegelde dagkant, afgewerkt met een zwart profiel" widths={[320, 480, 640]} sizes="(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw" class="tegel absolute inset-0 h-full w-full object-cover object-[50%_22%]" />
          </li>
          <li class="rijs relative aspect-[4/5] overflow-hidden rounded-md bg-groen" style="--d:.2s">
            <a href={waOfferte} class="group absolute inset-0 flex flex-col justify-between p-5 text-wit no-underline sm:p-6">
              <span class="grid h-11 w-11 place-items-center rounded-md bg-wit/15"><Icoon naam="bad" class="h-6 w-6" /></span>
              <span>
                <span class="block font-kop text-lg font-black leading-tight sm:text-2xl">Uw badkamer de volgende?</span>
                <span class="mt-3 inline-flex items-center gap-2 text-sm font-bold">Offerte<span class="hidden sm:inline">&nbsp;aanvragen</span><Icoon naam="pijl" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
              </span>
            </a>
          </li>
        </ul>
        <div class="mt-16 border-t border-lijn-licht pt-10 lg:mt-20">
          <p class="text-sm font-bold uppercase tracking-[.18em] text-licht-zacht">Eerder werk</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-3 md:gap-4">
            {[
              { src: aMarmer, t: 'Marmeren vloer', d: 'Woonkeuken en woonkamer', alt: 'Glanzende marmeren vloer in een witte woonkeuken met eettafel' },
              { src: aHardsteen, t: 'Belgisch hardsteen', d: 'Woonkamer met eethoek', alt: 'Donkere vloer van Belgisch hardsteen in een lichte woonkamer met eethoek' },
              { src: aMonkey, t: 'Monkey Town, Bleiswijk', d: 'Toiletruimte, zakelijk project', alt: 'Witte wandtegels met gekleurde accenttegels en drie wastafels in de toiletruimte van Monkey Town' },
            ].map((a, i) => (
              <li class="rijs flex items-center gap-4 rounded-md bg-nacht-2 p-3" style={`--d:${i * 0.05}s`}>
                <Image src={a.src} alt={a.alt} widths={[160, 240]} sizes="96px" class="h-24 w-24 shrink-0 rounded-sm object-cover" />
                <span><b class="block font-kop text-lg font-black text-licht">{a.t}</b><span class="text-sm text-licht-zacht">{a.d}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-28" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van eerste appje tot de laatste voeg.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Eén aanspreekpunt voor de hele klus. Vrijblijvend contact opnemen kan altijd.</p>
        </div>
        <ol class="mt-12 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative overflow-hidden p-6 sm:p-7" style={`--d:${i * 0.06}s`}>
              <span class="absolute inset-x-0 top-0 h-1 bg-groen" style={`opacity:${0.4 + i * 0.2}`} aria-hidden="true"></span>
              <p class="num font-kop text-2xl font-black text-groen">0{i + 1}</p>
              <h3 class="mt-6 text-xl">{t}</h3>
              <p class="mt-3 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over Dennie -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[24rem] sm:min-h-[30rem] lg:col-span-5">
          <Image src={regendouche} alt="Dubbele regendouche met zwarte douchekoppen en inbouwthermostaten, op grote betonlook-tegels" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_40%]" />
          <figure class="absolute bottom-4 left-4 w-[11.5rem] overflow-hidden rounded-md bg-licht p-1.5 shadow-md sm:w-[14rem]">
            <Image src={bus} alt="De zwarte bus van D. Hus Tegelwerken met het groene tegellogo" widths={[240, 381]} sizes="224px" class="aspect-[3/2] w-full rounded-sm object-cover" />
            <figcaption class="px-1.5 pb-0.5 pt-1.5 text-xs font-bold text-inkt">Herkenbaar aan de groene tegels</figcaption>
          </figure>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Dennie</p>
          <h2 id="t-over" class="mt-4 text-3xl">Begonnen als tegelzetter, gegroeid tot allround bouwbedrijf.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Dennie Hus komt uit {site.plaats} en is sinds {site.sinds} actief in de bouw. Wat begon als zelfstandig tegelzetter, is uitgegroeid tot een bouwbedrijf voor verbouwen, onderhouden en renoveren van woningen en bedrijfspanden. Hij werkt in {site.werkgebied}.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-groen text-wit"><Icoon naam="team" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Eén aanspreekpunt</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Vaste onderaannemers met wie een vertrouwensband is, onder coördinatie van Dennie.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-groen text-wit"><Icoon naam="schild" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">VCA-VOL gecertificeerd</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Veilig werken volgens de Arbo-wetgeving, voor particulier en zakelijk werk.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-groen text-wit"><Icoon naam="tegels" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Kwaliteit voorop</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">In de materialen die gebruikt worden en in een vakkundige uitvoering.</p></div>
            </li>
          </ul>
          <a href={waOfferte} class="knop knop-groen mt-8"><Icoon naam="wa" />App Dennie</a>
        </div>
      </div>
    </section>

    <!-- 8. Review -->
    <section id="reviews" class="bg-beton py-20 lg:py-28" aria-labelledby="t-reviews">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="rijs lg:col-span-4">
          <p class="eyebrow">Reviews</p>
          <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          <a href={site.reviews} class="kaart mt-8 inline-flex items-center gap-4 px-5 py-4 no-underline transition-shadow hover:shadow-md">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-black">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">Bekijk op Google</span>
            </span>
          </a>
        </div>
        <figure class="rijs kaart relative overflow-hidden p-7 sm:p-10 lg:col-span-8 lg:p-14" style="--d:.06s">
          <span class="absolute inset-y-0 left-0 w-1.5 bg-groen" aria-hidden="true"></span>
          <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-5 w-5" />)}</span>
          <blockquote class="mt-6 font-kop text-[clamp(1.375rem,1.2vw+1rem,2rem)] font-bold leading-snug tracking-[-0.01em]">“{review.tekst}”</blockquote>
          <figcaption class="mt-8 flex items-center gap-3 border-t border-lijn pt-6">
            <span class="grid h-11 w-11 place-items-center rounded-md bg-groen-zacht font-kop font-black text-groen" aria-hidden="true">{review.naam[0]}</span>
            <span class="flex-1 text-sm leading-snug"><b class="block text-base font-bold">{review.naam}</b><span class="text-grijs">Google review, {review.wanneer}</span></span>
            <Icoon naam="g" class="h-6 w-6" />
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 9. Contact: offerte-aanvraag samenstellen -->
    <section id="contact" class="py-20 lg:py-28" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Vertel wat u wilt laten doen.</h2>
          <p class="mt-6 text-lg text-grijs">Kies uw klus en wanneer u wilt beginnen. Wij maken er een WhatsApp-bericht van; foto’s van de huidige situatie stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-groen text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-bold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-groen-zacht text-groen"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-bold">Bellen</b><span class="text-grijs">Ma t/m vr, 7.30 tot 18.00 uur</span></span><Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-md bg-groen-zacht text-groen"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-bold">E-mail</b><span class="block truncate text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 shrink-0 text-groen" /></a></li>
          </ul>
          <div class="kaart mt-6 p-6 md:p-7">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Bereikbaar</h3>
              <p class="status-pil text-sm font-bold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr</span></p>
            </div>
            <table class="mt-3 w-full">
              <caption class="sr-only">Bereikbaarheid per dag</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-bold data-[vandaag]:text-groen">
                    <th scope="row" class="py-2 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-4 flex items-start gap-2 text-sm text-grijs"><Icoon naam="pin" class="mt-0.5 h-4 w-4 shrink-0 text-groen" />Gevestigd in {site.plaats}. Werkgebied: regio Zuid-Holland en door heel het land.</p>
          </div>
        </div>
        <form class="kaart self-start p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw aanvraag aan Dennie</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-bold">Wat wilt u laten doen?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Badkamer', 'Toilet', 'Vloertegels', 'Wandtegels', 'Verbouwing', 'Renovatie', 'Bedrijfspand'].map((b) => (
                <label class="keuze"><input type="radio" name="klus" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block sm:col-span-2"><span class="flex items-baseline justify-between text-sm font-bold">Ongeveer hoeveel m²? <output name="m2uit" class="num text-base font-black text-groen" data-m2uit>8 m²</output></span>
              <input type="range" name="m2" min="1" max="80" value="8" class="schuif mt-3" data-m2 aria-describedby="m2-hint" />
              <span id="m2-hint" class="mt-1 flex justify-between text-xs text-grijs"><span>1 m²</span><span>Een schatting is genoeg</span><span>80+ m²</span></span>
            </label>
            <label class="block"><span class="text-sm font-bold">Wanneer starten?</span>
              <select name="start" class="veld mt-2">
                <option value="">Weet ik nog niet</option>
                <option>Zo snel mogelijk</option>
                <option>Binnen 3 maanden</option>
                <option>Later dit jaar</option>
                <option>Volgend jaar</option>
              </select>
            </label>
            <label class="block"><span class="text-sm font-bold">Plaats van de klus</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" placeholder="Bijvoorbeeld Maassluis" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-bold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-bold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: badkamer van 2 bij 3 meter, ligbad eruit en een inloopdouche erin"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-groen"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Vrijblijvend, een offerte op maat.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-groen text-wit" aria-label="Offerte aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Plannen voor een nieuwe badkamer of verbouwing?</h2>
          <p class="mt-2 text-lg text-wit/90">Neem vrijblijvend contact op voor een offerte op maat.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp Dennie</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const s = document.querySelector<HTMLInputElement>('[data-m2]');
  const o = document.querySelector<HTMLOutputElement>('[data-m2uit]');
  const zet = () => { if (s && o) o.textContent = `${s.value}${s.value === '80' ? '+' : ''} m²`; };
  s?.addEventListener('input', zet);
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hallo Dennie, ik wil graag een offerte aanvragen.'];
      if (v('klus')) r.push('Klus: ' + v('klus'));
      r.push('Ongeveer ' + v('m2') + (v('m2') === '80' ? '+' : '') + ' m²');
      if (v('start')) r.push('Starten: ' + v('start').toLowerCase());
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('wens')) r.push('Toelichting: ' + v('wens'));
      r.push('Foto’s van de huidige situatie stuur ik hierna mee.');
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31641243011?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

