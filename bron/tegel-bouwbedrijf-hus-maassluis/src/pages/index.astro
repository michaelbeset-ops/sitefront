  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: var(--color-lime); box-shadow: 0 0 0 4px #66d35c33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: var(--radius-md); background: var(--color-beton); }
  .status-pil .status-stip { background: #8a918c; }
  .status-pil[data-open='true'] .status-stip { background: var(--color-groen); box-shadow: 0 0 0 4px #1d733126; }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-md); background: var(--color-beton); font-size: .9375rem; font-weight: 700; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #dedbd2; }
  .keuze input:checked + span { background: var(--color-groen); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-groen); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-md); border: 1.5px solid #15181633; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #15181666; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-groen); }
  .veld::placeholder { color: #7a817c; }
  .schuif { width: 100%; accent-color: var(--color-groen); height: 1.5rem; cursor: pointer; }
</style>
