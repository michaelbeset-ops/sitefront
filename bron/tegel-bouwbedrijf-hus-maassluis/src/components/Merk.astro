---
// Woordmerk. Het teken volgt hun logo: groene tegels in dambordpatroon, op de punt gezet.
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
const cellen = [0, 1, 2].flatMap((i) => [0, 1, 2].map((j) => ({ i, j, groen: (i + j) % 2 === 0 })));
---
<span class={`merk ${cls}`}>
  <svg class="merk-teken" viewBox="0 0 40 40" aria-hidden="true">
    <g transform="translate(20 2.6) rotate(45)">
      {cellen.map((c) => (
        <rect x={c.i * 8.2} y={c.j * 8.2} width="7.4" height="7.4" fill={c.groen ? (licht ? '#66d35c' : '#1d7331') : 'none'} stroke={c.groen ? 'none' : 'currentColor'} stroke-opacity=".35" stroke-width=".9" />
      ))}
    </g>
  </svg>
  <span><b>D. Hus</b><small>Tegel- en bouwbedrijf</small></span>
</span>
