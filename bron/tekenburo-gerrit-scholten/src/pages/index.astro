---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site } from '../data/site';
import heroFoto from '../assets/hero-tekentafel.jpg';
import potlood from '../assets/potlood.jpg';
import pen from '../assets/pen.jpg';
import tekentafel from '../assets/tekentafel-eigen.jpg';
import w01 from '../assets/woning-01.jpg';
import w03 from '../assets/woning-03.jpg';
import w05 from '../assets/woning-05.jpg';
import w07 from '../assets/woning-07.jpg';
import w09 from '../assets/woning-09.jpg';
import w11 from '../assets/woning-11.jpg';
import w13 from '../assets/woning-13.jpg';
import w15 from '../assets/woning-15.jpg';
import w17 from '../assets/woning-17.jpg';
import w19 from '../assets/woning-19.jpg';
import w21 from '../assets/woning-21.jpg';
import w23 from '../assets/woning-23.jpg';
import p02 from '../assets/plattegrond-02.jpg';
import p04 from '../assets/plattegrond-04.jpg';
import p06 from '../assets/plattegrond-06.jpg';
import p08 from '../assets/plattegrond-08.jpg';
import p10 from '../assets/plattegrond-10.jpg';
import p12 from '../assets/plattegrond-12.jpg';
import p14 from '../assets/plattegrond-14.jpg';
import p16 from '../assets/plattegrond-16.jpg';
import p18 from '../assets/plattegrond-18.jpg';
import p20 from '../assets/plattegrond-20.jpg';
import p22 from '../assets/plattegrond-22.jpg';
import p24 from '../assets/plattegrond-24.jpg';
import pr11 from '../assets/project1-1.jpg';
import pr12 from '../assets/project1-2.jpg';
import pr21 from '../assets/project2-1.jpg';
import pr22 from '../assets/project2-2.jpg';
import pr31 from '../assets/project3-1.jpg';
import pr32 from '../assets/project3-2.jpg';
import pr41 from '../assets/project4-1.jpg';
import pr42 from '../assets/project4-2.jpg';
import pr51 from '../assets/project5-1.jpg';
import pr52 from '../assets/project5-2.jpg';
import pr61 from '../assets/project6-1.jpg';
import pr62 from '../assets/project6-2.jpg';
import pr71 from '../assets/project7-1.jpg';
import pr72 from '../assets/project7-2.jpg';
import pr81 from '../assets/project8-1.jpg';
import pr82 from '../assets/project8-2.jpg';
import pr91 from '../assets/project9-1.jpg';
import pr92 from '../assets/project9-2.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
const terug = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>`;

// Stappenplan: elke tekst komt uit hun pagina's home, profiel en diensten (letterlijk of licht ingekort).
const stappen = [
  { kort: 'Kennismaking', kop: 'Kennismaking aan huis', waar: 'Bij u thuis',
    tekst: ['Eerst komen wij bij u langs om uw wensen en eisen te bespreken.', 'Een goed ontwerp voldoet aan de wensen en eisen van de opdrachtgever en bouwregelgeving.'],
    diensten: [] as string[] },
  { kort: 'Ontwerp', kop: 'Het ontwerp', waar: 'Op ons kantoor',
    tekst: ['Kijkend naar de bouwregelgeving en onze ervaring werken wij alles op kantoor verder uit.', 'Dan nodigen wij u bij ons uit om het ontwerp te bespreken en toe te lichten en waar nodig aan te passen. Stap voor stap naar het gewenste resultaat.'],
    diensten: ['Maken van ontwerp'] },
  { kort: 'Vergunningen', kop: 'Vergunningen', waar: '',
    tekst: ['Al sinds 1988 houden wij ons bezig met het verzorgen van ontwerpen en het aanvragen van alle noodzakelijke vergunningen.'],
    diensten: ['Verzorgen aanvraag alle noodzakelijke vergunningen'] },
  { kort: 'Berekeningen', kop: 'Berekeningen', waar: '',
    tekst: ['Wij verzorgen de ventilatie-, daglicht- en EPN-berekeningen.', 'Daarnaast leveren wij aan: constructieberekening, sonderingen, grondonderzoek, en berekeningen met betrekking tot brandpreventie en akoestiek.'],
    diensten: ['Verzorgen van ventilatie, daglicht en EPN berekeningen', 'Aanleveren van constructieberekening, sonderingen, grondonderzoek, brandpreventie en akoestiek'] },
  { kort: 'Offertes', kop: 'Offertes beoordelen', waar: '',
    tekst: ['Uw eigen wensen, de benodigde vergunningen, een goede prijs en de juiste aannemer moeten ervoor zorgen dat u een pand kunt laten bouwen dat past binnen uw doelstellingen en budget.', 'Wij helpen u bij het beoordelen van offertes en overeenkomsten.'],
    diensten: ['Coördinatie prijsvorming', 'Beoordelen offertes en overeenkomsten'] },
  { kort: 'Bouw', kop: 'Bouwbegeleiding', waar: 'Naar gelang de behoefte',
    tekst: ['Naar gelang de behoefte kunnen wij de bouw begeleiden en coördineren.'],
    diensten: ['Begeleiding tijdens bouwproces'] },
  { kort: 'Oplevering', kop: 'Oplevering', waar: 'Naar gelang de behoefte',
    tekst: ['De begeleiding en coördinatie van de bouw kan tot en met de oplevering.', 'Van ontwerp tot oplevering, bij ons bent u aan het juiste adres.'],
    diensten: ['Begeleiding tijdens bouwproces en oplevering'] },
];

// Letterlijk van hun dienstenpagina.
const diensten = [
  { naam: 'Maken van ontwerp' },
  { naam: 'Verzorgen aanvraag alle noodzakelijke vergunningen' },
  { naam: 'Verzorgen van ventilatie-, daglicht- en EPN-berekeningen' },
  { naam: 'Aanleveren van constructieberekening, sonderingen en grondonderzoek', sub: 'Ook berekeningen met betrekking tot brandpreventie en akoestiek.' },
  { naam: 'Coördinatie prijsvorming' },
  { naam: 'Beoordelen offertes en overeenkomsten' },
  { naam: 'Begeleiding tijdens bouwproces en oplevering' },
];

// Voorbeeldwoningen: de namen staan in de titelbalk van hun eigen impressies.
const dubbel = [
  { r: w01, p: p02, naam: 'Tentdak dubbel', alt: 'Impressie van een twee-onder-een-kapwoning in rode baksteen met tentdak, dakramen en carport' },
  { r: w03, p: p04, naam: 'Zadeldak dubbel', alt: 'Impressie van een twee-onder-een-kapwoning met zadeldak, erkers en carport' },
  { r: w05, p: p06, naam: 'Zadeldak dubbel', alt: 'Impressie van een twee-onder-een-kapwoning met twee topgevels en erkers aan de voorkant' },
  { r: w07, p: p08, naam: 'Zadeldak dubbel', alt: 'Impressie van een twee-onder-een-kapwoning met twee spitse topgevels en een carport' },
];
const vrijstaand = [
  { r: w09, p: p10, naam: 'Tentdak vrijstaand', alt: 'Impressie van een vrijstaande woning in baksteen met tentdak en carport' },
  { r: w11, p: p12, naam: 'Tentdak vrijstaand', alt: 'Impressie van een vrijstaande woning met tentdak, dakkapel en een brede erker' },
  { r: w13, p: p14, naam: 'Klassiek vrijstaand', alt: 'Impressie van een klassieke vrijstaande woning met steil zadeldak, luiken en garage' },
  { r: w15, p: p16, naam: 'Landhuis modern', alt: 'Impressie van een landhuis in baksteen met zadeldak en dakkapel' },
  { r: w17, p: p18, naam: 'Landhuis modern', alt: 'Impressie van een landhuis met spitse topgevel en een erker met glas' },
  { r: w19, p: p20, naam: 'Landhuis riet modern', alt: 'Impressie van een wit gestuct landhuis met rieten kap en garage' },
  { r: w21, p: p22, naam: 'Notariswoning laag', alt: 'Impressie van een notariswoning in baksteen met schilddak en dakkapellen' },
  { r: w23, p: p24, naam: 'Notariswoning hoog', alt: 'Impressie van een hoge notariswoning in baksteen met schilddak en dakkapellen' },
];

// Projecten 1 t/m 9 van hun site: naam en adres letterlijk, foto's 192 px breed (niet opgeschaald).
const projecten = [
  { naam: 'Multimate van Olst', adres: 'Kamperzijweg 6', plaats: 'Heerde', f: [pr11, pr12], alt: ['Bedrijfshal met hout en bouwmaterialen op het terrein', 'Gevel met het Van Olst-logo boven een stalen overkapping'] },
  { naam: 'ABC hekwerk', adres: 'Oenerweg 16', plaats: 'Heerde', f: [pr21, pr22], alt: ['Woning in lichte baksteen achter een tuin met sierhek', 'Donkergrijs bedrijfspand met rode luifel boven de entree'] },
  { naam: 'Textielreiniging Bagerman', adres: 'Zandweg 1', plaats: 'Heerde', f: [pr31, pr32], alt: ['Lichte gevel met roodbruine vlakken en een overstekend dak', 'Bedrijfspand met lange gevel en een opbouw met plat dak'] },
  { naam: 'Fam. Schoenmaker', adres: 'Boshoekerweg 22', plaats: 'Oene', f: [pr41, pr42], alt: ['Woonboerderij en rieten bijgebouw achter een groot grasveld', 'Bakstenen gevel met witte ramen en een witte voordeur'] },
  { naam: 'Fam. Van Zoeren', adres: 'Donselaarsweg 49', plaats: 'Oene', f: [pr51, pr52], alt: ['Vrijstaande woning met rode pannen en een dakkapel', 'Dezelfde woning schuin van voren, met tuin'] },
  { naam: 'Medisch centrum Vaassen', adres: 'Van Riebeeckstraat 87', plaats: 'Vaassen', f: [pr61, pr62], alt: ['Bakstenen gebouw op de hoek met huisnummer 87', 'Hoekentree met overkapping onder huisnummer 87'] },
  { naam: 'Fam. Baltussen', adres: 'Hilsdijk 88', plaats: 'Hattem', f: [pr71, pr72], alt: ['Entree met hoge ramen en buxusbollen', 'Woning met dakkapellen, serre en terras'] },
  { naam: 'Fam. van Dijk', adres: 'Fokke Remmersstraat 8', plaats: 'Zwolle', f: [pr81, pr82], alt: ['Voordeur onder een bakstenen boog met waaiervenster', 'Woning met erker en glazen puien aan de tuin'] },
  { naam: 'Bas autowas', adres: 'Wilhelm Rontgenstraat 1', plaats: 'Zwolle', f: [pr91, pr92], alt: ['Wasstraat met geel dak naast een bedrijfspand', 'Lichte gang met een glazen wand langs de wasstraat'] },
];
const voorWie = ['Particulieren', 'Bedrijven', 'Aannemers', 'Architecten'];
---
<Base
  title="Bouwkundig Tekenburo Gerrit Scholten | Van ontwerp tot oplevering, Heerde"
  description="Bouwkundig Tekenburo Gerrit Scholten uit Heerde, sinds 1988: ontwerp, vergunningaanvragen, ventilatie-, daglicht- en EPN-berekeningen, beoordelen van offertes en bouwbegeleiding tot en met de oplevering."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: inktzwart met fijn raster, grote kop, bewijzen. Rechts een hoge sfeerfoto die over de rand valt, met hun eigen impressie als kaart. -->
    <section class="donker raster-donker relative bg-inkt text-white">
      <div class="wrap grid grid-cols-1 gap-10 pb-14 lg:grid-cols-12 lg:gap-12 lg:pt-16 lg:pb-12">
        <div class="relative -mx-5 sm:mx-0 lg:order-2 lg:col-span-5 lg:col-start-8 lg:self-start lg:-mb-44">
          <figure>
            <div class="aspect-[4/3] overflow-hidden sm:rounded-xl lg:aspect-auto lg:h-[760px] lg:shadow-lg">
              <Foto src={heroFoto} alt="Een hand tekent met een pen op een groot vel tekenpapier, met een schaallat en een rol papier op een houten tafel" hero widths={[480, 800, 1200]} sizes="(min-width: 1024px) 1170px, 100vw" class="object-[42%_50%]" />
            </div>
          </figure>
          <figure class="absolute -bottom-12 left-4 z-10 w-52 overflow-hidden rounded-xl bg-white p-1.5 shadow-lg sm:left-6 sm:w-64 lg:bottom-28 lg:-left-16 lg:w-[300px]">
            <div class="aspect-[887/590] overflow-hidden rounded-lg"><Foto src={w13} alt="Impressie van onze voorbeeldwoning klassiek vrijstaand: baksteen, steil zadeldak en luiken" widths={[320, 600]} sizes="(min-width: 1024px) 288px, 250px" /></div>
            <figcaption class="flex items-baseline justify-between gap-3 px-1.5 pt-2 pb-0.5 text-xs text-ink"><span class="font-semibold">Voorbeeldwoning</span><span class="text-ink-soft">Klassiek vrijstaand</span></figcaption>
          </figure>
        </div>

        <div class="pt-8 lg:order-1 lg:col-span-7 lg:pt-8">
          <p class="kicker text-zalm">Bouwkundig tekenburo in Heerde</p>
          <h1 class="mt-5 text-4xl">Van ontwerp tot oplevering</h1>
          <p class="mt-7 max-w-xl text-lg text-white/85">Bij het ontwerpen en bouwen van een huis of bedrijfspand komt een hoop kijken. Wij kunnen u tijdens dit gehele project op een vakkundige manier begeleiden.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-rood"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href="#werkwijze" class="btn btn-line">Bekijk het stappenplan</a>
          </div>
          <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-white/20 pt-6 text-sm sm:grid-cols-[auto_auto_1fr] sm:gap-x-10">
            <div><dt class="text-white/75">Sinds</dt><dd class="font-display text-2xl font-bold tabular-nums">{site.sinds}</dd></div>
            <div><dt class="text-white/75">Google</dt><dd><strong class="font-display text-2xl">{site.google}</strong> <span class="whitespace-nowrap text-white/80">({site.reviews} reviews)</span></dd></div>
            <div class="col-span-2 sm:col-span-1"><dt class="text-white/75">Wij werken voor</dt><dd class="mt-1 font-semibold text-white">Particulieren, bedrijven, aannemers en architecten</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Profiel: grote 1988, hun eigen foto aan de tekentafel als kleine inzet op eigen formaat. -->
    <section id="profiel" class="raster scroll-mt-20 pt-24 pb-16 lg:pt-44 lg:pb-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-rood-diep">Profiel</p>
          <h2 class="mt-3 text-3xl">Wij kunnen bouwen op een jarenlange ervaring</h2>
          <p class="mt-6 text-lg">Aan ervaring geen gebrek bij Bouwkundig Tekenburo Gerrit Scholten. Al sinds 1988 houden wij ons bezig met het verzorgen van ontwerpen en het aanvragen van alle noodzakelijke vergunningen.</p>
          <p class="mt-4 text-ink-soft">Door onze persoonlijke manier van werken, weten wij elk project tot een succes te volbrengen.</p>
          <div class="mt-10 grid grid-cols-1 gap-6 border-t border-line pt-8 sm:grid-cols-[auto_1fr] sm:items-center">
            <figure class="w-[193px] rounded-xl bg-white p-1.5 shadow-sm">
              <div class="aspect-[193/142] overflow-hidden rounded-lg"><Foto src={tekentafel} alt="Twee mannen buigen zich over een bouwtekening op een grote tafel" widths={[193]} sizes="193px" /></div>
            </figure>
            <p class="font-display text-xl leading-snug font-bold [font-stretch:108%]">Een goed ontwerp voldoet aan de wensen en eisen van de opdrachtgever en bouwregelgeving.</p>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="font-display text-jaar leading-none font-extrabold tracking-[-0.04em] text-rood tabular-nums [font-stretch:115%]">1988</p>
          <p class="mt-2 text-ink-soft">Sinds 1988 verzorgen wij ontwerpen en vergunningaanvragen.</p>
          <h3 class="mt-10 text-lg">Wij werken voor</h3>
          <ul class="mt-4 grid grid-cols-2 gap-3">
            {voorWie.map((v) => <li class="rounded-xl bg-white px-4 py-4 font-display font-bold shadow-sm">{v}</li>)}
          </ul>
          <p class="mt-4 text-sm text-ink-soft">In de woning- en utiliteitsbouw.</p>
        </div>
      </div>
    </section>

    <!-- Wow: interactief stappenplan. Zonder JavaScript staan alle stappen onder elkaar met de complete tekening. -->
    <section id="werkwijze" class="donker scroll-mt-20 bg-inkt py-16 text-white lg:py-24" data-plan>
      <div class="wrap">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="kicker text-zalm">Werkwijze</p>
            <h2 class="mt-3 text-3xl">Stap voor stap naar het gewenste resultaat</h2>
          </div>
          <p class="text-white/85 lg:col-span-5 lg:self-end">Uw eigen wensen, de benodigde vergunningen, een goede prijs en de juiste aannemer: wij kunnen u tijdens het gehele project begeleiden. Klik op een stap.</p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
          <!-- Stappenlijst: op de telefoon een maatlijn met nummers, op desktop een lijst met namen. -->
          <div class="relative lg:col-span-4" hidden data-lijst>
            <span class="absolute top-1/2 right-4 left-4 h-px bg-white/25 lg:hidden" aria-hidden="true"></span>
            <div role="tablist" aria-label="Stappen van ontwerp tot oplevering" class="relative grid grid-cols-7 gap-1 lg:grid-cols-1 lg:gap-1.5">
              {stappen.map((s, i) => (
                <button type="button" role="tab" id={`tab-${i}`} aria-controls={`stap-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="stap" data-stap={i} data-kop={s.kop}>
                  <span class="nr">{i + 1}</span>
                  <span class="sr-only lg:not-sr-only lg:font-display lg:font-bold">{s.kop}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="lg:col-span-8" data-panelen>
            <div class="grid grid-cols-1 overflow-hidden rounded-xl bg-inkt-2 shadow-lg md:grid-cols-[1fr_1.05fr]">
              <div class="p-6 sm:p-8">
                {stappen.map((s, i) => (
                  <article id={`stap-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} class="border-b border-white/15 pb-8 mb-8 last:mb-0 last:border-0 last:pb-0" data-paneel={i}>
                    <p class="kicker text-zalm">Stap {i + 1} van {stappen.length}{s.waar && <span class="text-white/75"> · {s.waar}</span>}</p>
                    <h3 class="mt-3 text-2xl">{s.kop}</h3>
                    {s.tekst.map((t) => <p class="mt-4 text-white/85">{t}</p>)}
                    {s.diensten.length > 0 && (
                      <div class="mt-6 border-t border-white/15 pt-5">
                        <p class="text-xs font-semibold tracking-wide text-white/75 uppercase">Uit onze diensten</p>
                        <ul class="mt-3 flex flex-wrap gap-2">
                          {s.diensten.map((d) => <li class="rounded-full bg-white/10 px-3 py-1.5 text-sm text-white">{d}</li>)}
                        </ul>
                      </div>
                    )}
                  </article>
                ))}
                <div class="mt-8 flex gap-2 border-t border-white/15 pt-6" hidden data-knoppen>
                  <button type="button" class="btn btn-line !px-3.5 !py-2.5 text-sm" data-vorige aria-label="Vorige stap"><Fragment set:html={terug} /></button>
                  <button type="button" class="btn btn-rood !py-2.5 text-sm" data-volgende><span data-volgende-tekst>Volgende stap</span> <Fragment set:html={pijl} /></button>
                </div>
              </div>

              <!-- De tekening groeit mee: van schetslijn tot opgeleverd huis. Puur beeld, zonder maten of beloftes. -->
              <div class="relative order-first flex flex-col justify-center border-b border-white/10 bg-inkt px-6 py-5 md:order-none md:border-b-0 md:border-l md:p-6 raster-donker">
                <svg viewBox="0 0 420 280" class="mx-auto h-auto w-full max-w-[26rem]" role="img" aria-labelledby="tekening-titel" data-tekening>
                  <title id="tekening-titel">Lijntekening van een woning die per stap verder af is</title>
                  <defs>
                    <pattern id="steen" width="12" height="6" patternUnits="userSpaceOnUse"><path d="M0 5.5h12M6 0v5.5M0 0v0" stroke="#ffffff" stroke-opacity=".28" stroke-width=".8" fill="none"/></pattern>
                    <pattern id="pan" width="10" height="7" patternUnits="userSpaceOnUse"><rect width="10" height="7" fill="#c41e2e"/><path d="M0 6.5h10M5 0v6.5" stroke="#1c1516" stroke-opacity=".35" stroke-width=".9"/></pattern>
                    <clipPath id="muur"><rect x="110" y="128" width="200" height="108"/></clipPath>
                  </defs>
                  <!-- 1: schets -->
                  <g class="laag" data-laag="0">
                    <path d="M10 236h400" stroke="#ffffff" stroke-opacity=".55" stroke-width="1.2"/>
                    <path d="M110 236V130l100-86 100 86v106" fill="none" stroke="#ff9e9e" stroke-width="1.3" stroke-dasharray="5 5"/>
                  </g>
                  <!-- 2: ontwerp -->
                  <g class="laag" data-laag="1" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linejoin="round">
                    <rect x="110" y="128" width="200" height="108"/>
                    <path d="M94 131 210 42l116 89Z"/>
                  </g>
                  <!-- 3: vergunningen: gevelindeling -->
                  <g class="laag" data-laag="2" fill="none" stroke="#ffffff" stroke-width="1.6">
                    <rect x="130" y="158" width="46" height="46"/><path d="M153 158v46M130 181h46"/>
                    <rect x="244" y="158" width="46" height="46"/><path d="M267 158v46M244 181h46"/>
                    <rect x="196" y="186" width="28" height="50"/>
                    <rect x="194" y="86" width="32" height="30"/><path d="M210 86v30"/>
                  </g>
                  <!-- 4: berekeningen: maatlijnen -->
                  <g class="laag" data-laag="3" stroke="#ff9e9e" stroke-width="1" fill="none">
                    <path d="M110 242v18M310 242v18M104 254h212"/>
                    <path d="M106 258l8-8M306 258l8-8" stroke-width="1.6"/>
                    <path d="M60 236h40M60 42h140M70 30v212" stroke-dasharray="0"/>
                    <path d="M66 240l8-8M66 46l8-8" stroke-width="1.6"/>
                    <path d="M346 150c10 0 10-12 20-12M346 166c10 0 10-12 20-12" stroke-width="1.2" stroke-linecap="round"/>
                  </g>
                  <!-- 5: offertes: materialen -->
                  <g class="laag" data-laag="4" clip-path="url(#muur)">
                    <rect x="110" y="128" width="200" height="108" fill="url(#steen)"/>
                  </g>
                  <!-- 6: bouw: dak en schoorsteen -->
                  <g class="laag" data-laag="5">
                    <path d="M260 81.7V60h16v34" fill="#9e1623" stroke="#ffffff" stroke-width="1.6"/>
                    <path d="M94 131 210 42l116 89Z" fill="url(#pan)" stroke="#ffffff" stroke-width="2.2" stroke-linejoin="round"/>
                    <rect x="194" y="86" width="32" height="30" fill="#1c1516" stroke="#ffffff" stroke-width="1.6"/><path d="M210 86v30" stroke="#ffffff" stroke-width="1.6"/>
                  </g>
                  <!-- 7: oplevering -->
                  <g class="laag" data-laag="6">
                    <g fill="#bfd7e2" fill-opacity=".85" stroke="#ffffff" stroke-width="1.6">
                      <rect x="130" y="158" width="46" height="46"/><rect x="244" y="158" width="46" height="46"/><rect x="196" y="89" width="30" height="27" stroke="none"/>
                    </g>
                    <path d="M153 158v46M130 181h46M267 158v46M244 181h46M210 86v30" stroke="#ffffff" stroke-width="1.6"/>
                    <rect x="196" y="186" width="28" height="50" fill="#9e1623" stroke="#ffffff" stroke-width="1.6"/>
                    <path d="M372 236v-40" stroke="#8a6a55" stroke-width="4"/>
                    <circle cx="372" cy="184" r="24" fill="#5d7a55"/>
                    <rect x="16" y="220" width="78" height="16" rx="8" fill="#4f6b48"/>
                    <rect x="326" y="222" width="30" height="14" rx="7" fill="#4f6b48"/>
                  </g>
                </svg>
                <p class="mt-4 flex items-center justify-between gap-3 text-sm text-white/75"><span data-tekst-tekening>Van eerste schets tot oplevering</span><span class="whitespace-nowrap tabular-nums" data-teller></span></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      // Stappenplan: toont per stap de tekst van hun eigen site en laat de tekening meegroeien. Rekent en belooft niets.
      const plan = document.querySelector<HTMLElement>('[data-plan]');
      if (plan) {
        const tabs = [...plan.querySelectorAll<HTMLButtonElement>('[data-stap]')];
        const panelen = [...plan.querySelectorAll<HTMLElement>('[data-paneel]')];
        const lagen = [...plan.querySelectorAll<SVGGElement>('[data-laag]')];
        const vorige = plan.querySelector<HTMLButtonElement>('[data-vorige]')!;
        const volgende = plan.querySelector<HTMLButtonElement>('[data-volgende]')!;
        const volgTekst = plan.querySelector<HTMLElement>('[data-volgende-tekst]')!;
        const teller = plan.querySelector<HTMLElement>('[data-teller]')!;
        const tekst = plan.querySelector<HTMLElement>('[data-tekst-tekening]')!;
        const n = tabs.length;
        plan.querySelector<HTMLElement>('[data-lijst]')!.hidden = false;
        plan.querySelector<HTMLElement>('[data-knoppen]')!.hidden = false;
        panelen.forEach((p) => p.classList.remove('border-b', 'pb-8', 'mb-8'));
        const kies = (i: number, focus = false) => {
          tabs.forEach((t, k) => {
            const aan = k === i;
            t.setAttribute('aria-selected', String(aan));
            t.tabIndex = aan ? 0 : -1;
            t.classList.toggle('gedaan', k < i);
          });
          panelen.forEach((p, k) => (p.hidden = k !== i));
          lagen.forEach((l) => l.classList.toggle('uit', Number(l.dataset.laag) > i));
          vorige.disabled = i === 0;
          vorige.classList.toggle('opacity-40', i === 0);
          volgTekst.textContent = i === n - 1 ? 'Neem contact op' : 'Volgende stap';
          teller.textContent = `${i + 1} / ${n}`;
          tekst.textContent = tabs[i].dataset.kop || '';
          if (focus) tabs[i].focus();
          huidig = i;
        };
        let huidig = 0;
        tabs.forEach((t, i) => {
          t.addEventListener('click', () => kies(i));
          t.addEventListener('keydown', (e) => {
            const k = (e as KeyboardEvent).key;
            if (k === 'ArrowRight' || k === 'ArrowDown') { e.preventDefault(); kies((i + 1) % n, true); }
            if (k === 'ArrowLeft' || k === 'ArrowUp') { e.preventDefault(); kies((i - 1 + n) % n, true); }
            if (k === 'Home') { e.preventDefault(); kies(0, true); }
            if (k === 'End') { e.preventDefault(); kies(n - 1, true); }
          });
        });
        vorige.addEventListener('click', () => huidig > 0 && kies(huidig - 1));
        volgende.addEventListener('click', () => {
          if (huidig === n - 1) { document.getElementById('contact')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); return; }
          kies(huidig + 1);
        });
        kies(0);
      }
    </script>

    <!-- Diensten: letterlijke lijst, genummerd, naast een grote detailfoto. -->
    <section id="diensten" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-rood-diep">Diensten</p>
          <h2 class="mt-3 text-3xl">Wat kunnen wij voor u betekenen</h2>
          <p class="mt-6 text-lg">Wij werken voor particulieren, bedrijven, aannemers en architecten in de woning- en utiliteitsbouw.</p>
          <figure class="mt-10 hidden lg:block">
            <div class="aspect-[4/5] overflow-hidden rounded-xl shadow-sm"><Foto src={potlood} alt="Close-up van een potlood op een bouwtekening met maatlijnen en een schaallat" sizes="(min-width: 1024px) 440px, 100vw" /></div>
          </figure>
        </div>
        <ol class="border-t border-line lg:col-span-6 lg:col-start-7">
          {diensten.map((d, i) => (
            <li class="grid grid-cols-[2.75rem_1fr] gap-2 border-b border-line py-6 sm:grid-cols-[4rem_1fr] sm:gap-4">
              <span class="font-display text-sm font-bold text-rood-diep tabular-nums">0{i + 1}</span>
              <div>
                <h3 class="text-xl">{d.naam}</h3>
                {d.sub && <p class="mt-1.5 text-ink-soft">{d.sub}</p>}
              </div>
            </li>
          ))}
          <li class="pt-8">
            <a href="#werkwijze" class="inline-flex items-center gap-2 font-display font-bold text-rood-diep underline decoration-2 underline-offset-4 transition-colors hover:text-ink">Zo werken we, stap voor stap <Fragment set:html={pijl.replace('aria-hidden', 'class="h-4 w-4" aria-hidden')} /></a>
          </li>
        </ol>
      </div>
    </section>

    <!-- Voorbeeldwoningen: hun eigen impressies, met de plattegrond erachter. -->
    <section id="woningen" class="scroll-mt-20 bg-kalk py-16 lg:py-24" data-woningen>
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
          <div class="max-w-2xl">
            <p class="kicker text-rood-diep">Voorbeeldwoningen</p>
            <h2 class="mt-3 text-3xl">Vrijstaand of <span class="whitespace-nowrap">2-onder-1-kap</span></h2>
            <p class="mt-5 text-ink-soft">Afmeting en indeling zijn geheel naar eigen wensen in te vullen. Bij elke woning hoort een plattegrond van de begane grond en de verdieping.</p>
          </div>
          <div class="flex gap-1 rounded-full bg-white p-1 shadow-sm" role="group" aria-label="Kies het type woning" hidden data-wisselaar>
            <button type="button" class="wissel" aria-pressed="true" data-toon="dubbel">2-onder-1-kap</button>
            <button type="button" class="wissel" aria-pressed="false" data-toon="vrijstaand">Vrijstaand</button>
          </div>
        </div>

        {[{ id: 'dubbel', kop: '2-onder-1-kap', lijst: dubbel }, { id: 'vrijstaand', kop: 'Vrijstaand', lijst: vrijstaand }].map((g) => (
          <div class="mt-10" data-groep={g.id}>
            <h3 class="text-xl" data-groepkop>{g.kop} <span class="font-body text-base font-normal text-ink-soft">({g.lijst.length})</span></h3>
            <ul class="mt-5 grid grid-cols-1 items-start gap-5 sm:grid-cols-2 lg:grid-cols-4">
              {g.lijst.map((w) => (
                <li class="overflow-hidden rounded-xl bg-white shadow-sm">
                  <div class="aspect-[887/590] overflow-hidden"><Foto src={w.r} alt={w.alt} widths={[400, 600, 887]} sizes="(min-width: 1024px) 280px, (min-width: 640px) 50vw, 100vw" /></div>
                  <details class="plan group">
                    <summary class="flex items-center justify-between gap-3 px-5 py-4 transition-colors hover:bg-paper">
                      <span><span class="block font-display text-lg leading-tight font-bold">{w.naam}</span><span class="text-sm text-ink-soft">Plattegrond bekijken</span></span>
                      <span class="plus grid h-9 w-9 flex-none place-items-center rounded-full bg-paper text-rood-diep" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
                    </summary>
                    <div class="border-t border-line p-3">
                      <div class="aspect-[1024/540] overflow-hidden rounded-lg"><Foto src={w.p} alt={`Plattegrond van de ${w.naam.toLowerCase()}: begane grond en verdieping`} widths={[600, 1024]} sizes="(min-width: 1024px) 360px, 100vw" class="!object-contain" /></div>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <script>
      // Wisselaar voorbeeldwoningen: zonder JavaScript staan beide groepen onder elkaar.
      const blok = document.querySelector<HTMLElement>('[data-woningen]');
      if (blok) {
        const knoppen = [...blok.querySelectorAll<HTMLButtonElement>('[data-toon]')];
        const groepen = [...blok.querySelectorAll<HTMLElement>('[data-groep]')];
        blok.querySelector<HTMLElement>('[data-wisselaar]')!.hidden = false;
        blok.querySelectorAll<HTMLElement>('[data-groepkop]').forEach((h) => h.classList.add('sr-only'));
        const toon = (id: string) => {
          knoppen.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.toon === id)));
          groepen.forEach((g) => (g.hidden = g.dataset.groep !== id));
        };
        knoppen.forEach((k) => k.addEventListener('click', () => toon(k.dataset.toon!)));
        toon('dubbel');
      }
    </script>

    <!-- Projecten: hun eigen projectfoto's op eigen formaat, met naam en adres. -->
    <section id="projecten" class="raster scroll-mt-20 py-16 lg:py-24">
      <div class="wrap">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-rood-diep">Projecten</p>
            <h2 class="mt-3 text-3xl">Van Heerde en Oene tot Vaassen, Hattem en Zwolle</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5">Woningen en bedrijfspanden uit onze projectenlijst, met de foto's van de huidige website.</p>
        </div>
        <ul class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {projecten.map((p, i) => (
            <li class="flex flex-col rounded-xl bg-white p-3 shadow-sm">
              <div class="grid grid-cols-2 gap-2">
                {p.f.map((f, k) => (
                  <div class="mx-auto w-full max-w-[192px]"><div class="aspect-[192/140] overflow-hidden rounded-lg bg-kalk"><Foto src={f} alt={`${p.naam}: ${p.alt[k].charAt(0).toLowerCase()}${p.alt[k].slice(1)}`} widths={[192]} sizes="192px" /></div></div>
                ))}
              </div>
              <div class="mt-4 flex items-start gap-3 px-1.5 pb-1">
                <span class="font-display text-sm font-bold text-rood-diep tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <div class="min-w-0">
                  <h3 class="text-lg">{p.naam}</h3>
                  <p class="text-sm text-ink-soft">{p.adres}, {p.plaats}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Contact: rood vlak, zoals hun menubalk. -->
    <section id="contact" class="donker scroll-mt-20 bg-rood text-white">
      <div class="wrap grid grid-cols-1 gap-12 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-6">
          <p class="kicker text-white">Contact</p>
          <h2 class="mt-3 text-3xl">Voor meer informatie</h2>
          <p class="mt-5 max-w-md text-lg text-white">Van ontwerp tot oplevering, bij ons bent u aan het juiste adres. Bel of mail ons voor een eerste kennismaking bij u thuis.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-wit"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line"><Fragment set:html={mail} />Mail ons</a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rounded-xl bg-inkt p-6 shadow-lg sm:p-8">
            <address class="text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
            <a href={site.maps} rel="noopener" class="mt-3 inline-block font-semibold text-zalm underline decoration-2 underline-offset-4">Route plannen</a>
            <dl class="mt-6 border-t border-white/20 text-white/90">
              <div class="flex justify-between gap-4 border-b border-white/20 py-3"><dt>Telefoon</dt><dd><a href={site.telHref} class="font-semibold whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a></dd></div>
              <div class="flex justify-between gap-4 border-b border-white/20 py-3"><dt>Fax</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{site.fax}</dd></div>
              <div class="flex flex-wrap justify-between gap-x-4 border-b border-white/20 py-3"><dt>E-mail</dt><dd class="min-w-0"><a href={`mailto:${site.mail}`} class="font-semibold break-all underline underline-offset-2">{site.mail}</a></dd></div>
              <div class="flex justify-between gap-4 py-3"><dt>KvK</dt><dd class="font-semibold tabular-nums">{site.kvk}</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Afsluitende strook: sfeerfoto op volle breedte, klein label. -->
    <figure class="relative">
      <div class="aspect-[16/7] max-h-[420px] w-full overflow-hidden sm:aspect-[16/5]"><Foto src={pen} alt="Een hand tekent met een zwarte pen op een plattegrond met maatlijnen" sizes="100vw" widths={[800, 1200, 1440]} class="object-[60%_55%]" /></div>
    </figure>
  </main>
  <Chrome deel="voet" />
</Base>
