---
// Wordmark naar hun eigen logo: "bouwkundig tekenburo" klein en vet in kleine letters,
// daaronder "GERRIT SCHOLTEN" in brede, gestreepte kapitalen (zoals de lijnen door het oude logo).
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex flex-col leading-none ${cls}`}>
  <span class="sr-only">Bouwkundig Tekenburo Gerrit Scholten</span>
  <span aria-hidden="true" class={`font-display whitespace-nowrap text-[0.7rem] font-bold sm:text-[0.74rem] tracking-[0.01em] ${licht ? 'text-zalm' : 'text-rood'}`}>bouwkundig tekenburo</span>
  <span aria-hidden="true" class={`streep mt-[3px] whitespace-nowrap font-display text-[0.96rem] min-[360px]:text-[1.08rem] sm:text-[1.42rem] font-[850] tracking-[0.02em] uppercase [font-stretch:125%] ${licht ? 'text-white' : 'text-rood'}`}>Gerrit Scholten</span>
</span>
