---
// Woordmerk naar hun eigen logo (tandwiel met moersleutels, "AutoService-Online", "Staat er voor."), als strak SVG-teken.
interface Props { slogan?: boolean }
const { slogan = true } = Astro.props;
---
<span class="merk-teken" aria-hidden="true">
  <svg viewBox="0 0 32 32" class="h-full w-full">
    <g fill="none" stroke="currentColor">
      <circle cx="16" cy="16" r="10.2" stroke-width="4.4" stroke-dasharray="4 4.01" />
      <circle cx="16" cy="16" r="7.6" stroke-width="4.2" />
    </g>
    <path d="M10.6 21.4 21.4 10.6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
  </svg>
</span>
<span><b>Auto<span>Service</span>-Online</b>{slogan && <small>Staat er voor.</small>}</span>
