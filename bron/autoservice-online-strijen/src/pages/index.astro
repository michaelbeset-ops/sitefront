<script>
  const f = document.querySelector<HTMLFormElement>('[data-wb]');
  if (f) {
    const box = f.querySelector<HTMLElement>('[data-lampjes]')!;
    const uit = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
    const bericht = () => {
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const werk = d.getAll('werk').map(String);
      const lamp = werk.includes('Er brandt een lampje');
      box.classList.toggle('hidden', !lamp);
      const r = ['Hallo AutoService-Online, ik wil graag een afspraak maken.'];
      const w = werk.filter((x) => x !== 'Er brandt een lampje');
      if (lamp) w.push(v('lampje') ? `lampje ${v('lampje').toLowerCase()} brandt` : 'er brandt een lampje');
      if (w.length) r.push('Werk: ' + w.join(', '));
      const auto = [v('auto'), v('kenteken').toUpperCase()].filter(Boolean).join(', kenteken ');
      if (auto) r.push('Auto: ' + auto);
      r.push(v('halen') === 'ophalen' ? 'Graag ophalen en terugbrengen.' : 'Ik breng de auto zelf.');
      if (v('dag')) r.push('Voorkeur: ' + v('dag'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      return r.join('\n');
    };
    const toon = () => { uit.textContent = bericht(); };
    f.addEventListener('input', toon); f.addEventListener('change', toon); toon();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31639139604?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
  }
</script>

