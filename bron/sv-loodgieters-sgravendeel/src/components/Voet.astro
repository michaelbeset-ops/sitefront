---
import { site, url, chips, plaatsen, waOfferte } from '../data/site';
import Logo from './Logo.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <Logo />
        <span><b>S&amp;V Loodgieters</b><small>Installatie en aanneming</small></span>
      </a>
      <p class="mt-6 max-w-xs">Loodgieter en installateur uit {site.plaats}. Verwarming, badkamers, riolering, gas, water en elektra, sinds 2015.</p>
      <p class="mono mt-6 text-xs uppercase tracking-[.06em]">KvK {site.kvk}</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {chips.slice(0, 7).map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-koraal">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-koraal">{site.tel}</a></li>
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-koraal">WhatsApp</a></li>
        <li><a href={h('offerte')} class="no-underline transition-colors hover:text-koraal">Offerte aanvragen</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Werkgebied</p>
      <p class="mt-4">Vanuit {site.plaats}. Klanten in onder meer {plaatsen.slice(1, 5).join(', ')} en omgeving.</p>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.rechtsnaam}, {site.plaats} · KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-koraal">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw Google-bedrijfsprofiel en uw huidige website, ter illustratie. Reviews letterlijk van Solvari (stand 3 oktober 2026).</p>}
  </div>
</footer>
