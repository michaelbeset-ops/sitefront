---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, chips, plaatsen, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import verwarming from '../assets/verwarming.jpg';
import badkamer from '../assets/badkamer.jpg';
import vloerverwarming from '../assets/vloerverwarming.jpg';
import riolering from '../assets/riolering.jpg';
import leidingwerk from '../assets/leidingwerk.jpg';
import zonnepanelen from '../assets/zonnepanelen.jpg';
import bus from '../assets/bus.jpg';
import wWastafels from '../assets/w-wastafels.jpg';
import wToilet from '../assets/w-toilet.jpg';
import wKeuken from '../assets/w-keuken.jpg';
import wDouche from '../assets/w-douche.jpg';
import wWaskom from '../assets/w-waskom.jpg';

const vraag = (d: string) => waMet(`Goedendag S&V Loodgieters, ik heb een vraag over ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Verwarming en cv-ketels', d: 'Nieuwe installaties, onderhoud van uw cv-ketel en het verhelpen van lekkages en storingen. Wij werken graag met Remeha en Nefit.', src: verwarming, alt: 'Een nieuw opgehangen Remeha-ketel met koperen leidingen en een gele gasslang', pos: '50% 30%' },
  { t: 'Badkamer en toilet', d: 'Een complete badkamer of toilet, met veel aandacht voor de afwerking. Zelf het materiaal kopen kan ook: dan doen wij de rest.', src: badkamer, alt: 'Een nieuwe badkamer met glazen inloopdouche, een antraciet designradiator en twee waskommen', pos: '50% 55%' },
  { t: 'Vloerverwarming', d: 'Vloerverwarming aanleggen en aansluiten op uw cv-installatie, in een bestaande woning of bij een verbouwing.', src: vloerverwarming, alt: 'Witte vloerverwarmingsbuizen in slingers gelegd op zwarte noppenplaten in een lege kamer', pos: '50% 60%' },
  { t: 'Riolering en afvoer', d: 'Nieuwe riolering, lekkages, verzakkingen, verstoppingen en stankoverlast. Ook een schrobput, buitengoot of vetput.', src: riolering, alt: 'Een opgegraven grijze rioolaansluiting naast een gemetselde muur', pos: '50% 45%' },
  { t: 'Gas, water en elektra', d: 'Gas- en drinkwaterleidingen volgens de regels aangelegd, plus groepenkasten, stopcontacten en lichtpunten. Zonder tweede partij.', src: leidingwerk, alt: 'Een installatiekast met verdeler, koperen leidingen en blauwe en rode waterslangen', pos: '50% 40%' },
  { t: 'Zonnepanelen en warmtepompen', d: 'Ook voor zonnepanelen en verwarming met een warmtepomp kunt u bij ons terecht.', src: zonnepanelen, alt: 'Zonnepanelen op een oranje pannendak, met beneden in de straat de bus van S&V Loodgieters', pos: '50% 60%' },
];

const werk = [
  { src: wWastafels, alt: 'Twee ronde opzetwaskommen met inbouwkranen op een donker blad', titel: 'Badkamer met dubbele wastafel', groot: true },
  { src: wToilet, alt: 'Toiletruimte met hangtoilet, fonteintje met messing kraan en een tegelwand in grijstinten', titel: 'Toilet' },
  { src: wKeuken, alt: 'Witte keuken met zwart werkblad en een achterwand van grijze steenstrips', titel: 'Leidingwerk keuken' },
  { src: wDouche, alt: 'Badkamer met wastafelmeubel, inloopdouche met glazen wand en een witte handdoekradiator', titel: 'Badkamer' },
  { src: wWaskom, alt: 'Water stroomt uit een vierkante inbouwkraan in een witte waskom', titel: 'Afwerking' },
];

const stappen = [
  ['Bel of app ons', 'U spreekt direct een van de twee monteurs. Een foto van de situatie meesturen helpt.'],
  ['Vrijblijvend langs', 'Voor een offerte komen we bij u kijken, zodat we precies weten wat er nodig is.'],
  ['Heldere offerte', 'U weet vooraf waar u aan toe bent. Afspraak is afspraak, ook over de prijs.'],
  ['Netjes opgeleverd', 'We werken secuur, ruimen op en gaan pas weg als alles werkt.'],
];
---
<Base title={`${site.naam} | Loodgieter en installateur in ${site.plaats}`} description={`Loodgieter en installateur uit ${site.plaats}: cv-ketels, vloerverwarming, badkamers, riolering, gas, water en elektra. 4,6 op Solvari uit 89 reviews. Vraag vrijblijvend een offerte aan.`}>
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen vloerverwarming, op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-9.25rem)] flex-col overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_60%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#10161d59_0%,#10161dbf_45%,#10161df5_100%)] md:bg-[linear-gradient(90deg,#10161df7_0%,#10161dd9_40%,#10161d4d_100%)]" aria-hidden="true"></div>
      <div class="wrap flex flex-1 items-end pb-14 pt-24 md:items-center md:py-20">
        <div class="max-w-3xl">
          <p class="eyebrow"><span>Loodgieter en installateur<span class="hidden sm:inline"> · {site.plaats}</span></span></p>
          <h1 id="t-hero" class="mt-6 text-hero">Secuur, netjes <span class="text-koraal">en snel.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Verwarming, vloerverwarming, badkamers, riolering, gas, water en elektra. Van een lekkende kraan tot een complete verbouwing.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="knop knop-rood">Offerte aanvragen<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-rand op-foto num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
      </div>
      <div class="border-t border-lijn-licht bg-nacht/70 backdrop-blur-md">
        <ul class="wrap grid grid-cols-1 gap-y-3 py-5 text-[.9375rem] sm:grid-cols-3 sm:gap-x-8 sm:py-6">
          <li class="flex items-center gap-3"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span><b class="num">{site.score.cijfer}</b> op Solvari, {site.score.aantal} reviews</span></li>
          <li class="flex items-center gap-3"><Icoon naam="schild" class="h-5 w-5 text-koraal" />2 jaar garantie op het werk</li>
          <li class="flex items-center gap-3"><Icoon naam="team" class="h-5 w-5 text-koraal" />Gerund door twee vaste monteurs</li>
        </ul>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Werkzaamheden in het kort">
      <div class="wrap flex items-center gap-x-2 gap-y-2 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-sm border border-lijn px-3.5 py-1.5 text-sm font-medium no-underline transition-colors hover:border-rood hover:bg-rood hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-28" aria-labelledby="t-dienst">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-dienst" class="mt-5 text-3xl">Alles rond verwarming, water en afvoer in één hand.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Wij doen het leidingwerk voor keuken, badkamer of toilet compleet zelf. U hoeft dus niet steeds een ander bedrijf te bellen.</p>
        </div>
        <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="relative overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1248px) 380px, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                  <span class="mono absolute left-0 top-0 bg-nacht px-3 py-1.5 text-xs text-licht">0{i + 1}</span>
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-xl">{b.t}</h3>
                  <p class="mt-2.5 flex-1 text-grijs">{b.d}</p>
                  <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-rood">Stel uw vraag<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-md border-l-4 border-rood bg-beton px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Ook ventilatie en complete verbouwingen.</b> <span class="text-grijs">Woonhuisventilatoren, wtw-units, roosters en kanalen. Voor een grote verbouwing werken we met vaste vakmensen.</span></p>
          <a href={waOfferte} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="wa" />Vraag het ons</a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Opgericht in</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.04em]">2015</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Gemiddelde score op Solvari</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.04em] text-rood">{site.score.cijfer}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Reviews van klanten</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.04em]">{site.score.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Jaar garantie op het werk</dt><dd class="num order-first font-kop text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-bold leading-none tracking-[-0.04em]">2</dd></div>
      </dl>
    </section>

    <!-- 5. Projecten -->
    <section id="projecten" class="donker bg-nacht py-24 text-licht lg:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-werk" class="mt-5 text-3xl">Strak afgewerkt, tot de laatste kraan.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Een greep uit eigen werk: badkamers, toiletten en het leidingwerk erachter. Ook in de productkeuze denken we graag met u mee.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-16">
          {werk.map((w, i) => (
            <li class={`rijs group relative overflow-hidden rounded-md bg-nacht-2 ${w.groot ? 'col-span-2 aspect-[4/3] md:row-span-2 md:aspect-auto' : 'aspect-square'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={w.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={w.groot ? '(min-width: 1248px) 590px, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
              <p class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#10161dd9,#10161d00)] px-4 pb-3 pt-10 text-sm font-medium">{w.titel}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-28" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Van eerste telefoontje tot oplevering.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Geen callcenter of tussenpersoon. U heeft van begin tot eind dezelfde mensen aan de lijn en over de vloer.</p>
        </div>
        <ol class="relative mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-0">
          <li class="pointer-events-none absolute left-0 right-0 top-[1.7rem] hidden h-px bg-lijn lg:block" aria-hidden="true"></li>
          {stappen.map(([t, d], i) => (
            <li class="rijs relative lg:pr-8" style={`--d:${i * 0.06}s`}>
              <span class="mono relative grid h-14 w-14 place-items-center rounded-sm bg-rood text-lg text-wit">0{i + 1}</span>
              <h3 class="mt-6 text-xl">{t}</h3>
              <p class="mt-2.5 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over ons -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:col-span-6">
          <Image src={bus} alt="De bus van S&V Loodgieters in de straat, gezien vanaf een dak met zojuist geplaatste zonnepanelen" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[45%_30%]" />
          <p class="mono absolute bottom-4 left-4 bg-rood px-3 py-1.5 text-xs uppercase tracking-[.06em] text-wit">Onderweg naar de volgende klus</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over ons</p>
          <h2 id="t-over" class="mt-5 text-3xl">Twee monteurs, één aanspreekpunt.</h2>
          <p class="mt-6 text-lg text-licht-zacht">S&amp;V Loodgieters is in 2015 opgericht met één doel: het begrip loodgieter een nieuwe betekenis geven. Service en kwaliteit voorop, tegen een eerlijke prijs. Inmiddels zijn we doorgegroeid in het aannemersvak, van warmtepompen en zonnepanelen tot een complete verbouwing.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-rood text-wit"><Icoon naam="team" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">U treft altijd een van ons</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">De twee monteurs die het bedrijf runnen, staan op de klus en nemen ook de telefoon op.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-rood text-wit"><Icoon naam="sleutel" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Alles onder één dak</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Gas, water én elektra in één hand. Daarmee weten we zeker dat alles na afloop werkt zoals het hoort.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-rood text-wit"><Icoon naam="vlam" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Warmte gaat voor alles</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Een storing aan uw cv? Dan hoeft u nooit lang te wachten op de reparatie.</p></div>
            </li>
          </ul>
          <a href="#offerte" class="knop knop-rood mt-9">Offerte aanvragen<Icoon naam="pijl" /></a>
        </div>
      </div>
    </section>

    <!-- 8. Reviews (Solvari, letterlijk) -->
    <section id="reviews" class="bg-beton py-20 lg:py-28" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.solvari} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <span class="num grid h-12 w-12 place-items-center rounded-sm bg-nacht font-kop text-lg font-bold text-wit">{site.score.cijfer}</span>
            <span>
              <span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
              <span class="mt-0.5 block text-sm text-grijs">{site.score.aantal} reviews op Solvari</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-16 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[86%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <div class="flex items-center justify-between gap-3">
                <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
                <span class="mono text-right text-xs text-grijs">{r.wanneer}</span>
              </div>
              <p class="mono mt-5 text-xs uppercase tracking-[.05em] text-rood">{r.klus}</p>
              <blockquote class="mt-3 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-sm bg-beton font-kop font-bold text-rood" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}{r.plaats && `, ${r.plaats}`}</b><span class="text-grijs">Review op Solvari</span></span>
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.solvari} class="link font-semibold">Alle {site.score.aantal} reviews op Solvari</a></p>
      </div>
    </section>

    <!-- 9. Offerte: WhatsApp-bericht samenstellen -->
    <section id="offerte" class="py-20 lg:py-28" aria-labelledby="t-offerte">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Offerte aanvragen</p>
          <h2 id="t-offerte" class="mt-5 text-3xl">Vertel ons wat er moet gebeuren.</h2>
          <p class="mt-6 text-lg text-grijs">Kies de klus en vul een paar gegevens in. Wij zetten het in een WhatsApp-bericht; foto's van de situatie stuurt u daarna gewoon mee.</p>
          <ul class="mt-10 grid gap-3">
            <li><a href={waOfferte} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-rood text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-beton text-rood"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>
          </ul>
          <div class="mt-8 rounded-md bg-nacht p-6 text-licht md:p-7">
            <p class="flex items-center gap-2.5 font-semibold"><Icoon naam="pin" class="h-5 w-5 text-koraal" />Werkgebied</p>
            <p class="mt-2 text-[.9375rem] text-licht-zacht">Vanuit {site.plaats}. Klanten in onder meer:</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {plaatsen.slice(1).map((p) => <li class="rounded-sm bg-nacht-2 px-3 py-1 text-sm">{p}</li>)}
            </ul>
          </div>
        </div>
        <form class="kaart p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw aanvraag</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Om wat voor klus gaat het?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['CV-ketel of onderhoud', 'Storing of lekkage', 'Badkamer of toilet', 'Vloerverwarming', 'Riolering of afvoer', 'Gas, water of elektra', 'Zonnepanelen of warmtepomp', 'Ventilatie', 'Iets anders'].map((b, i) => (
                <label class="keuze"><input type="radio" name="klus" value={b} class="sr-only" checked={i === 0} /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="mt-7">
            <legend class="text-sm font-semibold">Wanneer?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Zo snel mogelijk', 'Binnen een maand', 'Geen haast'].map((b) => (
                <label class="keuze"><input type="radio" name="wanneer" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld mt-2" /></label>
            <label class="block"><span class="text-sm font-semibold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: ketel is 15 jaar oud en slaat soms af"></textarea></label>
          </div>
          <div class="mt-7 rounded-md bg-[#e6f3e3] p-4" aria-live="polite">
            <p class="mono text-[.6875rem] uppercase tracking-[.06em] text-grijs">Voorbeeld van uw bericht</p>
            <p class="mt-2 whitespace-pre-line text-[.9375rem] leading-relaxed" data-voorbeeld></p>
          </div>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-rood"><Icoon naam="wa" />Open in WhatsApp</button>
            <a href={site.telHref} class="link text-sm font-semibold">Liever bellen?</a>
          </div>
        </form>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-rood text-wit" aria-label="Contact opnemen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Benieuwd wat we voor u kunnen doen?</h2>
          <p class="mt-2 text-lg text-wit/90">Bel of app, dan komen we vrijblijvend bij u kijken.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waOfferte} class="knop knop-wit"><Icoon naam="wa" />WhatsApp ons</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const bericht = () => {
    if (!f) return '';
    const d = new FormData(f);
    const v = (n: string) => String(d.get(n) || '').trim();
    const r = ['Goedendag S&V Loodgieters, ik wil graag een offerte aanvragen.'];
    if (v('klus')) r.push('Klus: ' + v('klus'));
    if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
    if (v('plaats')) r.push('Plaats: ' + v('plaats'));
    if (v('wens')) r.push('Toelichting: ' + v('wens'));
    if (v('naam')) r.push('Groet, ' + v('naam'));
    return r.join('\n');
  };
  if (f && vb) {
    const toon = () => { vb.textContent = bericht(); };
    f.addEventListener('input', toon);
    f.addEventListener('change', toon);
    toon();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31653801650?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
  }
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: .98; letter-spacing: -0.04em; }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 .95rem; border-radius: var(--radius-sm); border: 1.5px solid #10161d26; background: #fff; font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s, border-color .2s; }
  .keuze span:hover { border-color: #10161d66; }
  .keuze input:checked + span { background: var(--color-inkt); border-color: var(--color-inkt); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-rood); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-sm); border: 1.5px solid #10161d33; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #10161d66; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-rood); }
  .veld::placeholder { color: #6b7480; }
</style>
