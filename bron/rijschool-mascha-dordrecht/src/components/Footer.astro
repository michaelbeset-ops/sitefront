---
import { site, url } from '../data/site';
import Icon from './Icon.astro';
const jaar = new Date().getFullYear();
---
<footer class="donker bg-inkt text-papier/85">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-kop text-2xl font-extrabold tracking-tight text-papier" style="font-variation-settings:'SOFT' 100">Rijschool Mascha</p>
      <p class="mt-3 max-w-xs text-sm">Autorijles in Dordrecht. Bewust en met rust.</p>
    </div>
    <div class="text-sm">
      <p class="font-bold text-papier">Contact</p>
      <ul class="mt-3 space-y-2">
        <li><a href={site.telefoonLink} class="hover:underline">{site.telefoon}</a></li>
        <li><a href={`mailto:${site.email}`} class="break-all hover:underline">{site.email}</a></li>
        <li>{site.straat}, {site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="font-bold text-papier">Meer</p>
      <ul class="mt-3 space-y-2">
        <li><a href={site.facebook} class="inline-flex items-center gap-1.5 hover:underline" rel="noopener"><Icon naam="facebook" class="size-4" />Facebook</a></li>
        <li><a href={url('privacy/')} class="hover:underline">Privacyverklaring</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-papier/15">
    <p class="wrap py-5 text-xs text-papier/70">© {jaar} Rijschool Mascha, {site.plaats}</p>
  </div>
</footer>

<!-- Op de telefoon blijft bellen of mailen altijd binnen duimbereik. -->
<div class="donker fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px border-t border-papier/10 bg-inkt md:hidden">
  <a href={site.telefoonLink} class="flex min-h-[4.75rem] items-center justify-center gap-2 bg-roest font-bold text-wit"><Icon naam="telefoon" />Bel Mascha</a>
  <a href={`mailto:${site.email}`} class="flex min-h-[4.75rem] items-center justify-center gap-2 bg-inkt font-bold text-papier"><Icon naam="mail" />Mail</a>
</div>
