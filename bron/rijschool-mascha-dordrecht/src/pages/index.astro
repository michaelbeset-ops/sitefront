---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

// Sfeerbeelden van Unsplash, geen eigen foto's van de rijschool.
const unsplash = (id: string, w: number) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${w}&q=70`;
const hero = 'photo-1643634554838-1d16f11d21a2';
const stuur = 'photo-1524114051012-0a2aa8dae4e1';

const aanpak = [
  ['Ophalen waar jij wilt', 'Mascha haalt je op bij een adres naar keuze. Thuis, op school of bij je werk, jij bepaalt waar de les begint.'],
  ['Een rookvrije lesauto', 'In de lesauto wordt niet gerookt. Je stapt elke les in een frisse auto.'],
  ['Zo vaak als het jou uitkomt', 'Wil je snel opschieten? Meerdere lessen per dag of per week kan gewoon.'],
  ['Handgeschakeld', 'Je leert rijden met een versnellingspook. Met dat rijbewijs mag je later ook in een automaat rijden.'],
];
---
<Base
  title="Rijschool Mascha | Autorijles in Dordrecht, bewust en met rust"
  description="Autorijles in Dordrecht bij Mascha Fransen, rij-instructeur sinds 2001. Gespecialiseerd in faalangst, ophalen op een adres naar keuze, 2toDrive vanaf 16,5 jaar."
>
  <!-- Hero, schermvullende foto met de tekst eroverheen -->
  <div class="relative">
  <Header overFoto />
  <main id="inhoud">
  <section class="donker relative isolate flex min-h-[calc(100svh-8rem)] md:min-h-[calc(100svh-2.5rem)] flex-col overflow-hidden bg-inkt text-papier" aria-labelledby="hero-kop">
    <img
      src={unsplash(hero, 1600)}
      srcset={`${unsplash(hero, 800)} 800w, ${unsplash(hero, 1200)} 1200w, ${unsplash(hero, 1600)} 1600w`}
      sizes="100vw"
      alt="Een rustige weg tussen bomen en gras"
      class="absolute inset-0 -z-10 size-full object-cover"
      fetchpriority="high"
    />
    <!-- Donker verloop links en onder, zodat de tekst altijd leesbaar blijft op de lichte lucht. -->
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(38_28_44/0.82)_0%,rgb(38_28_44/0.55)_45%,rgb(38_28_44/0.15)_100%)]"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgb(38_28_44/0.75)_0%,transparent_55%)]"></div>

      <div class="wrap flex flex-1 flex-col justify-end pb-14 pt-28 md:pb-20">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-abrikoos">Autorijles in Dordrecht</p>
        <h1 id="hero-kop" class="mt-4 max-w-[12ch] text-4xl">Bewust en met rust.</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-papier/90">
          Bij Mascha Fransen leer je autorijden in je eigen tempo. Ze is rij-instructeur sinds 2001 en gespecialiseerd in leerlingen met faalangst.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.telefoonLink} class="knop bg-abrikoos text-inkt hover:bg-papier"><Icon naam="telefoon" />Bel {site.telefoon}</a>
          <a href="#faalangst" class="knop border border-papier/60 text-papier hover:bg-papier hover:text-inkt">Intake met gratis les<Icon naam="pijl" /></a>
        </div>
      </div>
  </section>

  <!-- Aanpak, kop links en een rustige lijst rechts -->
  <section id="aanpak" class="scroll-mt-4 py-20 md:py-28" aria-labelledby="aanpak-kop">
    <div class="wrap grid gap-12 md:grid-cols-[0.9fr_1.1fr] md:gap-20">
      <div class="rijs md:sticky md:top-10 md:self-start">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-roest">Zo gaat het</p>
        <h2 id="aanpak-kop" class="mt-4 text-3xl">Rijles zonder haast.</h2>
        <p class="mt-6 max-w-md text-grijs">
          Het motto van Mascha is bewust en met rust. Je leert rijden in je eigen tempo, zonder dat iemand je opjaagt.
        </p>
      </div>
      <ol class="border-t border-inkt/15">
        {aanpak.map(([kop, tekst], i) => (
          <li class="rijs grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-inkt/15 py-7 sm:grid-cols-[3.5rem_1fr]">
            <span class="font-kop text-xl font-extrabold text-roest" style="font-variation-settings:'SOFT' 100" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-xl">{kop}</h3>
              <p class="mt-2 text-grijs">{tekst}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Faalangst, het specialisme. Donker vlak met sfeerfoto. -->
  <section id="faalangst" class="donker scroll-mt-4 bg-pruim text-papier" aria-labelledby="faalangst-kop">
    <div class="grid md:grid-cols-2">
      <div class="relative min-h-[18rem] md:min-h-full">
        <img
          src={unsplash(stuur, 1200)}
          srcset={`${unsplash(stuur, 700)} 700w, ${unsplash(stuur, 1200)} 1200w`}
          sizes="(min-width: 768px) 50vw, 100vw"
          alt="Handen aan het stuur tijdens een rit door het bos"
          loading="lazy"
          class="absolute inset-0 size-full object-cover"
        />
      </div>
      <div class="px-5 py-16 sm:px-10 md:py-24 lg:px-16">
        <div class="max-w-lg">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-abrikoos">Faalangst</p>
          <h2 id="faalangst-kop" class="mt-4 text-3xl">Zenuwachtig achter het stuur? Dat mag.</h2>
          <p class="mt-6 text-lg leading-relaxed text-papier/90">
            Mascha is gespecialiseerd in leerlingen met faalangst. Je begint met een intakegesprek samen met een les, zonder kosten. Zo merk je eerst of het klikt, voordat je iets beslist.
          </p>
          <p class="mt-8 flex items-baseline gap-4 border-t border-papier/20 pt-6">
            <span class="font-kop text-3xl font-extrabold text-abrikoos" style="font-variation-settings:'SOFT' 100">14</span>
            <span class="text-papier/85">faalangstexamens deden leerlingen van Mascha bij het CBR in het jaar tot en met september 2026.</span>
          </p>
          <a href={site.telefoonLink} class="knop mt-9 bg-abrikoos text-inkt hover:bg-papier"><Icon naam="telefoon" />Plan je intake</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Slagingscijfers, met de echte CBR-cijfers als vergelijking -->
  <section id="slagen" class="scroll-mt-4 py-20 md:py-28" aria-labelledby="slagen-kop">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
      <div class="rijs">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-roest">Slagen</p>
        <h2 id="slagen-kop" class="mt-4 text-3xl">Vaker in één keer geslaagd dan gemiddeld in Dordrecht.</h2>
        <p class="mt-6 max-w-md text-grijs">
          Van de 30 eerste examens slaagde 47 procent. Het gemiddelde in Dordrecht lag op 39 procent. Over alle 64 examens samen was het 50 procent.
        </p>
      </div>
      <figure class="rijs self-end">
        <div class="space-y-7">
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-semibold">Rijschool Mascha</span>
              <span class="font-kop text-3xl font-extrabold text-roest" style="font-variation-settings:'SOFT' 100">47%</span>
            </div>
            <div class="mt-3 h-4 bg-zand"><div class="h-full bg-roest" style="width:47%"></div></div>
          </div>
          <div>
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-semibold text-grijs">Gemiddeld in Dordrecht</span>
              <span class="font-kop text-3xl font-extrabold text-grijs" style="font-variation-settings:'SOFT' 100">39%</span>
            </div>
            <div class="mt-3 h-4 bg-zand"><div class="h-full bg-grijs" style="width:39%"></div></div>
          </div>
        </div>
        <figcaption class="mt-6 text-xs leading-relaxed text-grijs">
          Geslaagd bij het eerste praktijkexamen auto. CBR-cijfers van 1 oktober 2025 tot en met 30 september 2026, via rijschoolspecialist.nl.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Over Mascha en 2toDrive -->
  <section id="over" class="scroll-mt-4 bg-zand py-20 md:py-28" aria-labelledby="over-kop">
    <div class="wrap grid gap-14 md:grid-cols-[1.2fr_0.8fr] md:gap-20">
      <div class="rijs">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-roest">Over Mascha</p>
        <h2 id="over-kop" class="mt-4 text-3xl">Rij-instructeur sinds 2001, eigen rijschool sinds 2015.</h2>
        <div class="mt-6 max-w-xl space-y-4 text-lg leading-relaxed">
          <p>Mascha Fransen geeft al sinds 2001 rijles. Op 1 januari 2015 begon ze haar eigen rijschool in Dordrecht.</p>
          <p>Haar motto is bewust en met rust. Je krijgt de tijd om het echt onder de knie te krijgen, ook als je het spannend vindt.</p>
        </div>
      </div>
      <aside class="rijs self-end border-l-4 border-roest bg-papier p-7 sm:p-9" aria-labelledby="tdr-kop">
        <h3 id="tdr-kop" class="text-2xl">2toDrive, al beginnen op je 16,5e</h3>
        <p class="mt-4 text-grijs">Mascha geeft ook 2toDrive. Daarmee start je al vanaf 16,5 jaar met autorijles.</p>
        <p class="mt-4 text-grijs">Wil je weten wat de lessen kosten? Bel of mail Mascha, dan hoor je het meteen.</p>
      </aside>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="scroll-mt-4 py-20 md:py-28" aria-labelledby="contact-kop">
    <div class="wrap grid gap-14 lg:grid-cols-[0.95fr_1.05fr] lg:gap-20">
      <div class="rijs">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-roest">Contact</p>
        <h2 id="contact-kop" class="mt-4 text-3xl">Even kennismaken?</h2>
        <p class="mt-6 max-w-md text-grijs">Bel of mail Mascha voor een intakegesprek met een les, zonder kosten.</p>
        <ul class="mt-10 space-y-5">
          <li>
            <a href={site.telefoonLink} class="group flex items-center gap-4">
              <span class="grid size-12 place-items-center rounded-full bg-inkt text-papier"><Icon naam="telefoon" /></span>
              <span><span class="block text-xs font-bold uppercase tracking-[0.12em] text-grijs">Bellen</span><span class="text-lg font-bold group-hover:underline">{site.telefoon}</span></span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="group flex items-center gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-full bg-inkt text-papier"><Icon naam="mail" /></span>
              <span class="min-w-0"><span class="block text-xs font-bold uppercase tracking-[0.12em] text-grijs">Mailen</span><span class="block break-all text-lg font-bold group-hover:underline">{site.email}</span></span>
            </a>
          </li>
          <li class="flex items-center gap-4">
            <span class="grid size-12 place-items-center rounded-full bg-inkt text-papier"><Icon naam="pin" /></span>
            <span><span class="block text-xs font-bold uppercase tracking-[0.12em] text-grijs">Adres</span><span class="text-lg font-bold">{site.straat}, {site.postcode} {site.plaats}</span></span>
          </li>
        </ul>
      </div>

      <form class="rijs border border-inkt/15 bg-wit p-6 sm:p-9" aria-labelledby="form-kop" onsubmit="return false">
        <h3 id="form-kop" class="text-2xl">Stuur Mascha een bericht</h3>
        <div class="mt-7 grid gap-5">
          <label class="grid gap-1.5 text-sm font-semibold">Naam
            <input type="text" name="naam" autocomplete="name" class="min-h-12 border border-inkt/25 bg-papier px-3 font-normal text-base" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold">Telefoonnummer
            <input type="tel" name="telefoon" autocomplete="tel" class="min-h-12 border border-inkt/25 bg-papier px-3 font-normal text-base" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold">Je vraag
            <textarea name="bericht" rows="4" class="border border-inkt/25 bg-papier px-3 py-2 font-normal text-base"></textarea>
          </label>
        </div>
        {site.voorstel ? (
          <p class="mt-6 border-l-4 border-roest bg-zand px-4 py-3 text-sm">Dit is een ontwerpvoorstel, het formulier verstuurt nog niets. Bel Mascha op <a href={site.telefoonLink} class="font-bold underline">{site.telefoon}</a> of mail naar <a href={`mailto:${site.email}`} class="break-all font-bold underline">{site.email}</a>.</p>
        ) : (
          <button type="submit" class="knop mt-6 bg-inkt text-papier hover:bg-pruim">Versturen</button>
        )}
      </form>
    </div>
  </section>

  </main>
  </div>
  <Footer />
</Base>
