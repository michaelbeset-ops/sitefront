---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, wa, waMet } from '../data/site';
import takoyaki from '../assets/takoyaki.jpg';
import lunch from '../assets/lunch.jpg';
import parfait from '../assets/parfait.jpg';
import latwerk from '../assets/latwerk.jpg';
import toonbank from '../assets/toonbank.jpg';
import miso from '../assets/miso.jpg';

// Gerechten uit de eigen omschrijving en de reviews; geen prijzen bekend. Japanse namen zijn vertalingen.
const kaart = [
  { groep: 'Lunch', items: [
    { naam: 'Omakase lunch', jp: 'おまかせ', bij: 'misosoep, tempura groente, salades' },
    { naam: 'Lunch special', jp: 'ランチ', bij: 'ingelegde groenten en kip teriyaki' },
    { naam: 'Japanse dagelijkse specialiteiten', jp: '日替わり' },
  ] },
  { groep: 'Klein', items: [
    { naam: 'Takoyaki', jp: 'たこ焼き', bij: 'huisgemaakt' },
    { naam: 'Onigiri', jp: 'おにぎり' },
  ] },
  { groep: 'Zoet', items: [
    { naam: 'Mochi', jp: 'もち' },
    { naam: 'Daifuku', jp: '大福' },
    { naam: 'Matcha mochi parfait', jp: '抹茶パフェ' },
  ] },
];
const tijden = [
  { wd: 4, dag: 'Donderdag', open: true },
  { wd: 5, dag: 'Vrijdag', open: true },
  { wd: 6, dag: 'Zaterdag', open: true },
  { wd: 0, dag: 'Zondag', open: true },
  { wd: 1, dag: 'Maandag', open: true },
  { wd: 2, dag: 'Dinsdag', open: false },
  { wd: 3, dag: 'Woensdag', open: false },
];
---
<Base
  title={`${site.naam} | Takoyaki, onigiri en mochi aan de Nieuwstraat, Arnhem`}
  description="Authentiek Japans café & restaurant in Arnhem. Huisgemaakte takoyaki. Onigiri, mochi en Japanse dagelijkse specialiteiten. Eat-in & take-away. Donderdag t/m maandag 12.00 tot 18.00."
>
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- Binnenkomen: een indigo noren hangt aan de houten roe en valt over de takoyaki heen. -->
    <section aria-labelledby="titel" class="relative overflow-hidden">
      <div class="wrap lg:grid lg:min-h-[max(40rem,calc(100svh-6.2rem))] lg:grid-cols-12">
        <div class="flex flex-col lg:col-span-5">
          <div class="noren relative z-10 px-6 pb-8 pt-10 sm:px-10 lg:px-11 lg:pt-14">
            <h1 id="titel" class="text-[clamp(2.75rem,4.4vw+0.7rem,5.4rem)]">Takoyaki, onigiri en&nbsp;mochi</h1>
            <p class="mt-6 max-w-[30ch] text-beton-donker">Authentiek Japans café &amp; restaurant aan de Nieuwstraat in Arnhem.</p>
          </div>
          <div class="banen relative z-10 lg:flex-1" aria-hidden="true">
            <div class="baan"><span lang="ja" class="jp verticaal text-xl">たこ焼き</span></div>
            <div class="baan"><span lang="ja" class="jp verticaal text-xl">おにぎり</span></div>
            <div class="baan"><span lang="ja" class="jp verticaal text-xl">もち</span></div>
          </div>

          <div class="relative -mx-5 -mt-16 h-[min(48svh,21rem)] sm:h-[min(60svh,30rem)] md:-mx-10 lg:absolute lg:inset-y-0 lg:left-[34%] lg:right-0 lg:mx-0 lg:mt-0 lg:h-auto">
            <Foto src={takoyaki} hero alt="Takoyaki met saus, mayonaise, bonitovlokken en zeewier op een blauw-wit Japans bord." sizes="(min-width: 1024px) 66vw, 100vw" class="object-[62%_50%]" />
          </div>

          <div class="relative z-10 py-8 lg:mt-auto lg:pb-12">
            <a href="#nieuwstraat" class="knop">Tafel reserveren</a>
            <p class="mt-3 text-sm text-staal">Donderdag t/m maandag, <span class="whitespace-nowrap tabular-nums">12.00 tot 18.00</span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- De kaart: onder het latwerk, gerecht met stippellijn naar de Japanse naam. -->
    <section id="kaart" aria-labelledby="kaart-titel" class="latwerk border-t border-lijn py-20 lg:py-32">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-7">
          <figure>
            <div class="aspect-[4/3] overflow-hidden">
              <Foto src={lunch} alt="Een lunchbord op blauw-wit Japans servies met aubergine, opgerold omelet, gefrituurde stukjes, reepjes wortel en paprika, kip en groene kruiden. Links een bakje tomaat en komkommer." sizes="(min-width: 1024px) 55vw, 100vw" />
            </div>
          </figure>
          <figure class="mt-10 grid grid-cols-12 items-end gap-x-6 lg:mt-14">
            <div class="col-span-7 aspect-[3/4] overflow-hidden sm:col-span-5 sm:col-start-3">
              <Foto src={parfait} alt="Een matcha mochi parfait in een glazen schaal: groene mochi, aardbei en ander fruit op lagen room en saus, op een houten plank met een lepel." sizes="(min-width: 1024px) 22vw, 55vw" />
            </div>
            <figcaption class="mincho col-span-5 bg-beton pb-1 text-lg leading-snug sm:col-span-4">Matcha mochi parfait</figcaption>
          </figure>
        </div>

        <div class="order-first self-start bg-beton px-6 py-10 sm:px-10 lg:order-none lg:col-span-5 lg:px-12 lg:py-14">
          <h2 id="kaart-titel" class="text-3xl">De kaart</h2>
          <p class="mt-4 text-sm text-staal">Eat-in &amp; take-away. Halal-vriendelijke opties.</p>
          {kaart.map((g) => (
            <div class="mt-10">
              <h3 class="border-b border-lijn pb-2 text-xl">{g.groep}</h3>
              <ul class="mt-4 space-y-4">
                {g.items.map((i) => (
                  <li>
                    <span class="regel"><span class="mincho text-lg leading-snug">{i.naam}</span><span class="stip" aria-hidden="true"></span><span lang="ja" class="jp shrink-0 text-sm text-staal">{i.jp}</span></span>
                    {i.bij && <span class="mt-0.5 block text-sm text-staal">{i.bij}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <p class="mt-10 text-xs text-staal">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
        </div>
      </div>
    </section>

    <!-- Binnen: het latwerkplafond over de volle breedte, beton en staal. -->
    <section id="binnen" aria-labelledby="binnen-titel" class="bg-beton-donker pb-20 lg:pb-24">
      <div class="h-[46svh] min-h-[16rem] lg:h-[78svh] lg:max-h-[56rem]">
        <Foto src={latwerk} alt="Het plafond van JAPAN CAFE: een raster van lichte houten latten onder zwarte en zilveren buizen, hanglampen, een boograam en de indigo wand met het bordje JAPAN CAFE." sizes="100vw" class="object-[50%_40%]" />
      </div>
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-10">
        <div class="relative -mt-16 bg-beton-donker pr-6 pt-8 lg:col-span-6 lg:-mt-40 lg:-ml-[max(2.5rem,calc((100vw-86rem)/2+2.5rem))] lg:pl-[max(2.5rem,calc((100vw-86rem)/2+2.5rem))] lg:pr-14 lg:pt-14">
          <h2 id="binnen-titel" class="text-3xl">Beton, staal en een plafond van hout.</h2>
          <p class="mt-6 max-w-[40ch] text-staal">Een nieuwe plek, net buiten het centrum. Op tafel: blauw-wit servies en houten plankjes.</p>
        </div>
        <figure class="relative lg:col-span-5 lg:col-start-8 lg:-mt-24">
          <div class="aspect-[4/3] overflow-hidden">
            <Foto src={miso} alt="Een lunch op een houten plankje: soep in een rode kom, witte rijst in een gecraqueleerde kom, tamagoyaki en groenten op een groen bord, een schaaltje met ingelegde groenten en eetstokjes." sizes="(min-width: 1024px) 40vw, 100vw" />
          </div>
        </figure>
      </div>
    </section>

    <!-- De indigo wand: adres, tijden, reserveren, afhalen. -->
    <section id="nieuwstraat" aria-labelledby="adres-titel" class="op-ai bg-ai text-beton py-20 lg:py-28">
      <div class="wrap grid items-start gap-14 lg:grid-cols-12">
        <figure class="lg:col-span-5">
          <div class="aspect-[3/4] overflow-hidden">
            <Foto src={toonbank} alt="De toonbank van golfplaat met theekommen en een ijzeren theeketel, daarachter rekken met servies tegen een betonwand en de indigo wand met het witte bordje JAPAN CAFE." sizes="(min-width: 1024px) 38vw, 100vw" class="object-[50%_70%]" />
          </div>
        </figure>

        <div class="lg:col-span-6 lg:col-start-7">
          <h2 id="adres-titel" class="text-wit text-[clamp(2.6rem,5.6vw,5.6rem)]">Nieuwstraat <span class="tabular-nums">53</span></h2>
          <p class="mincho mt-3 text-xl text-hout">6811 HV Arnhem</p>
          <p class="mt-3 text-sm"><a href={site.maps} class="lijnlink">Route in Google Maps</a></p>

          <h3 class="mt-14 text-2xl text-wit">Open</h3>
          <ul class="mt-4 border-t border-lijn-licht">
            {tijden.map((t) => (
              <li data-wd={t.wd} class:list={['flex items-baseline justify-between gap-4 border-b border-lijn-licht py-3', !t.open && 'text-beton-donker']}>
                <span class="mincho text-lg">{t.dag}<span class="vandaag-teken ml-3 hidden align-middle font-gothic text-xs font-bold text-hout">vandaag</span></span>
                <span class="whitespace-nowrap text-sm tabular-nums">{t.open ? '12.00 tot 18.00' : 'gesloten'}</span>
              </li>
            ))}
          </ul>

          <div class="mt-12">
            <a href="#reserveren" id="reserveren" class="knop knop-hout">Tafel reserveren</a>
            <p class="mt-3 text-xs text-beton-donker">Online via Zenchef. [[AANLEVEREN: Zenchef-reserveringslink]]</p>
          </div>
          <div class="mt-12 border-t border-lijn-licht pt-8">
            <p class="mincho text-xl text-wit">Iets afhalen, of een vraag?</p>
            <p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
              <a href={waMet('ik wil graag iets afhalen: ')} data-afhalen class="lijnlink inline-flex items-center gap-2 font-bold text-wit"><Fragment set:html={wa} />Stuur een WhatsApp</a>
              <span class="text-sm">of bel <a href={site.telHref} class="lijnlink whitespace-nowrap tabular-nums">{site.tel}</a></span>
            </p>
          </div>
          <p class="mt-4 text-sm"><a href={site.instagram} class="lijnlink">Instagram @japan_cafe_nl</a></p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  import { eerstvolgende, nuInArnhem } from '../scripts/open';
  import { waMet } from '../data/site';
  const wanneer = eerstvolgende();
  const afhalen = document.querySelector<HTMLAnchorElement>('[data-afhalen]');
  if (afhalen) afhalen.href = waMet(`ik wil graag ${wanneer} iets afhalen: `);
  document.querySelector(`[data-wd="${nuInArnhem().wd}"] .vandaag-teken`)?.classList.remove('hidden');
</script>
