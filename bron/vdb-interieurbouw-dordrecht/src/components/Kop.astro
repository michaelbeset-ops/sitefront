---
import { url, site, waStandaard } from '../data/site';
import Icoon from './Icoon.astro';
import Logo from './Logo.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['werk', 'Werk'], ['werkwijze', 'Werkwijze'], ['sven', 'Over Sven'], ['plan', 'Uw plan'], ['contact', 'Contact']];
---
<header class={thuis ? 'absolute inset-x-0 top-0 z-40' : 'relative z-40 bg-nacht'}>
  <div class="wrap flex h-24 items-center justify-between gap-6 md:h-28">
    <a href={url('')} class="text-wit no-underline"><span class="sr-only">VDB interieurbouw, naar de homepage</span><span aria-hidden="true"><Logo class="text-[34px] md:text-[42px]" /></span></a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-9 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-wit/85 no-underline transition-colors duration-200 hover:text-led-licht">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-6">
      <a href={site.telHref} class="num hidden items-center gap-2 text-[.9375rem] font-medium text-wit no-underline transition-colors hover:text-led-licht xl:flex">{site.tel}</a>
      <a href={waStandaard} class="knop knop-led hidden min-h-11 px-5 md:inline-flex"><Icoon naam="wa" />WhatsApp</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-wit lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16M4 15h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden bg-nacht lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn py-4 font-kop text-2xl text-wit no-underline">{t}</a></li>)}
      <li class="pt-6"><a href={waStandaard} class="font-semibold text-led-licht no-underline">WhatsApp Sven</a></li>
      <li class="pt-3"><a href={site.telHref} class="num font-semibold text-mist no-underline">Bel {site.tel}</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 bg-nacht md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn text-[.9375rem] font-semibold text-wit no-underline"><Icoon naam="tel" class="h-5 w-5 text-led-licht" />Bellen</a>
  <a href={waStandaard} class="flex min-h-14 items-center justify-center gap-2.5 bg-led-diep text-[.9375rem] font-semibold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
