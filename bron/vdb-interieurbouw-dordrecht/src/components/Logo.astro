  <svg viewBox="0 0 126 56" class="h-[1em] w-auto" fill="currentColor" aria-hidden="true">
    <path d="M0 0h3.4l19.4 52.6L20.6 56z" />
    <path d="M30.6 0h10.2L23.4 56h-4.6z" />
    <path d="M46 0h2.8v56H46z" />
    <path d="M47.4 0H57c18 0 29 12 29 28S75 56 57 56h-9.6v-3H57c13 0 20-11 20-25S70 3 57 3h-9.6z" />
    <path d="M94 0h2.8v56H94z" />
    <path d="M95.4 0H108c8 0 13 6 13 13.5S116 27 108 27H95.4v-2.6H107c5 0 7-4.4 7-10.9S112 2.6 107 2.6H95.4z" />
    <path d="M95.4 26H110c9 0 15 7 15 15s-6 15-15 15H95.4v-2.6H109c6 0 8.6-5.4 8.6-12.4S115 28.6 109 28.6H95.4z" />
