---
import { site, url, werk, waStandaard } from '../data/site';
import Logo from './Logo.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-nacht text-mist">
  <span class="lichtlijn" aria-hidden="true"></span>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <span class="text-wit"><Logo class="text-[52px]" /></span>
      <p class="mt-7 max-w-sm">Interieurbouw op maat voor particulieren, winkels en werkpanden. Eigen werkplaats in Dordrecht, sinds {site.sinds}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Maatwerk</p>
      <ul class="mt-4 space-y-1.5">{werk.map((w) => <li>{w}</li>)}</ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4">{site.eigenaar}<br />Werkplaats in {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waStandaard} class="link">WhatsApp</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-led-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en projectfoto’s van vdb-interieurbouw.nl (stand 7 oktober 2026).</p>}
</footer>
