---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, ruimtes, waStandaard } from '../data/site';
import slaapkamer from '../assets/slaapkamer.jpg';
import slaapkamer2 from '../assets/slaapkamer-2.jpg';
import kastDetail from '../assets/kast-detail.jpg';
import ontwerp from '../assets/ontwerp.jpg';
import toonbank from '../assets/winkel-toonbank.jpg';
import wijn from '../assets/winkel-wijn.jpg';
import schuin from '../assets/winkel-schuin.jpg';
import hoek from '../assets/hoek-eiken.jpg';
import sBar from '../assets/steiger-bar.jpg';
import sTrap from '../assets/steiger-trap.jpg';
import sKeuken from '../assets/steiger-keuken.jpg';
import sOlie from '../assets/steiger-olie.jpg';

const opties = [
  ['een keuken op maat', 'Keuken op maat'],
  ['een walk-in closet', 'Walk-in closet'],
  ['een meubel op maat', 'Meubel op maat'],
  ['een totaal project', 'Totaal project'],
];
const plekken = [
  ['de huiskamer', 'de huiskamer'], ['de badkamer', 'de badkamer'], ['de slaapkamer', 'de slaapkamer'],
  ['het toilet', 'het toilet'], ['een winkel', 'een winkel'], ['een werkpand', 'een werkpand'],
];
const stappen = [
  ['Research', 'De stap die vaak wordt onderschat, en volgens Sven de belangrijkste: uw wensen onder woorden brengen, met voorbeelden. De sfeer, de materialen, de maten, de manier van werken en het tijdsbestek.'],
  ['Ontwerp', 'Na het gesprek volgt het ontwerp, gemaakt met een computerprogramma dat een zeer realistisch beeld geeft.'],
  ['Uitvoering', 'Pas als u akkoord gaat met het ontwerp, begint de uitvoering.'],
];
---
<Base
  title="VDB interieurbouw, Dordrecht | Maatwerk voor elk interieur"
  description="Keuken op maat, walk-in closet of een totaal project. Interieurbouw door Sven van den Berg, met een eigen werkplaats in Dordrecht. Bel of app 06 48 25 66 97."
>
  <div class="relative">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="relative isolate flex overflow-hidden min-h-[calc(100svh-3.5rem)] flex-col bg-nacht text-wit md:min-h-[100svh]" aria-labelledby="hero-kop">
      <Picture src={slaapkamer} alt="Slaapkamer door VDB interieurbouw: gestoffeerd hoofdbord en een kastenwand in hoogglans" widths={[640, 960, 1400, 1920]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full md:origin-[30%_10%] md:scale-[1.14] object-cover object-[44%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#141218b3_0%,#14121840_22%,#14121899_42%,#141218e6_70%,#141218_100%)] md:bg-[linear-gradient(90deg,#141218e6_0%,#141218a6_34%,#14121826_64%,#14121800_100%),linear-gradient(180deg,#14121899_0%,#14121800_24%,#14121800_70%,#141218cc_100%)]"></div>
      <div class="wrap flex flex-1 flex-col justify-end pb-8 pt-32 md:pb-12">
        <p class="text-[.9375rem] font-medium text-led-licht">Interieurbouw uit Dordrecht</p>
        <h1 id="hero-kop" class="mt-5 max-w-[11ch] text-hero">Maatwerk voor elk interieur.</h1>
        <p class="mt-7 max-w-[34rem] text-lg text-wit/90 md:text-xl">Keuken op maat, walk-in closet of een totaal project. Ontworpen en gemaakt door Sven van den Berg, in zijn eigen werkplaats.</p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
          <a href="#plan" class="knop knop-led"><Icoon naam="wa" />Bespreek uw plan</a>
          <a href="#werk" class="link text-[1rem] font-medium text-wit">Bekijk het werk</a>
        </div>
        <span class="lichtlijn rijs mt-14 md:mt-24" aria-hidden="true"></span>
        <p class="mt-4 flex flex-wrap justify-between gap-x-6 gap-y-1 text-sm text-mist">
          <span>Sinds {site.sinds}<span class="mx-2 inline-block" aria-hidden="true">·</span><a href={site.telHref} class="num text-mist no-underline hover:text-wit">{site.tel}</a></span>
          <span class="hidden sm:inline">Slaapkamer: gestoffeerd hoofdbord, kastenwand in hoogglans</span>
        </p>
      </div>
    </section>

    <!-- 2. Wat VDB wil maken -->
    <section class="py-24 md:py-32" aria-labelledby="over-kop">
      <div class="wrap grid gap-x-12 gap-y-10 lg:grid-cols-12">
        <h2 id="over-kop" class="rijs text-4xl lg:col-span-7">Vakmanschap, passie en betrokkenheid.</h2>
        <div class="rijs lg:col-span-4 lg:col-start-9 lg:pt-4" style="--d:.1s">
          <p class="text-lg text-grijs">Vakmanschap in het werk dat geleverd wordt, passie voor het maken van interieurs op maat en betrokkenheid met de klanten en hun wensen.</p>
        </div>
      </div>
      <div class="wrap mt-16 md:mt-20">
        <p class="rijs font-kop text-3xl leading-[1.25] text-inkt/30 [text-wrap:balance]">
          {ruimtes.map((r, i) => <><span class="whitespace-nowrap">{i > 0 && <span class="mr-[.3em]" aria-hidden="true">/</span>}<span class="text-inkt">{r}</span></span>{i < ruimtes.length - 1 && ' '}</>)}
        </p>
        <p class="rijs mt-8 max-w-xl text-lg text-grijs" style="--d:.1s">Wat de ruimte ook is: het doel is een plek waar men naar terugkeert, waar warmte en samenhang de boventoon voeren.</p>
      </div>
    </section>

    <!-- 3. Werk -->
    <section id="werk" class="bg-nacht pb-24 pt-24 text-wit md:pb-32 md:pt-28" aria-labelledby="werk-kop">
      <div class="wrap flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
        <h2 id="werk-kop" class="rijs text-4xl">Recent werk</h2>
        <p class="rijs max-w-sm text-mist" style="--d:.1s">Alle foto’s op deze site zijn projecten van VDB interieurbouw.</p>
      </div>

      <!-- Slaapkamer -->
      <div class="wrap mt-14 grid gap-6 md:mt-20 lg:grid-cols-12 lg:gap-8">
        <figure class="rijs lg:col-span-8">
          <Picture src={kastDetail} alt="Detail van een kastenwand in hoogglans met een donkere verticale band" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 62vw, 100vw" formats={['avif', 'webp']} class="verstek aspect-[16/10] w-full object-cover" />
        </figure>
        <div class="flex flex-col justify-end gap-6 lg:col-span-4">
          <figure class="rijs" style="--d:.1s">
            <Picture src={slaapkamer2} alt="Dezelfde slaapkamer met fauteuil en kastenwand" widths={[400, 500]} sizes="(min-width: 1024px) 28vw, 100vw" formats={['avif', 'webp']} class="aspect-[5/4] w-full object-cover" />
          </figure>
          <div class="rijs" style="--d:.15s">
            <h3 class="font-kop text-2xl">Slaapkamer</h3>
            <p class="mt-2 text-mist">Gestoffeerd hoofdbord en een kastenwand in hoogglans, met een donkere band als greep.</p>
          </div>
        </div>
      </div>

      <!-- Winkel, full bleed -->
      <figure class="rijs relative mt-20 md:mt-28">
        <Picture src={toonbank} alt="Winkelinterieur met eiken wandkasten vol flessen en een toonbank met violette lichtlijn" widths={[640, 960, 1400, 1920]} sizes="100vw" formats={['avif', 'webp']} class="aspect-[4/3] w-full object-cover object-[60%_50%] md:aspect-[21/9] md:object-[50%_55%]" />
        <figcaption class="wrap mt-6 grid gap-2 md:grid-cols-12">
          <h3 class="font-kop text-2xl md:col-span-4">Winkelinterieur</h3>
          <p class="text-mist md:col-span-6 md:col-start-6">Eiken wandkasten van vloer tot plafond en een toonbank met een lichtlijn eronder.</p>
        </figcaption>
      </figure>
      <div class="wrap mt-10 grid gap-6 sm:grid-cols-12 lg:gap-8">
        <figure class="rijs sm:col-span-8">
          <Picture src={wijn} alt="Wijnrekken en wandkasten in dezelfde winkel" widths={[640, 960, 1400]} sizes="(min-width: 640px) 62vw, 100vw" formats={['avif', 'webp']} class="aspect-[16/9] w-full object-cover" />
        </figure>
        <figure class="rijs sm:col-span-4" style="--d:.1s">
          <Picture src={schuin} alt="Schuin genomen detail van de eiken vakken" widths={[400, 500]} sizes="(min-width: 640px) 30vw, 100vw" formats={['avif', 'webp']} class="aspect-[16/10] w-full object-cover sm:aspect-auto sm:h-full" />
        </figure>
      </div>

      <!-- Steigerhout -->
      <div class="wrap mt-24 grid gap-x-8 gap-y-10 md:mt-32 lg:grid-cols-12">
        <div class="rijs lg:col-span-12 lg:flex lg:items-baseline lg:gap-12">
          <h3 class="font-kop text-3xl">Steigerhout en staal</h3>
          <p class="mt-4 max-w-md text-mist lg:mt-0">Een trap, een bar met koffiehoek, een keuken onder de vide en wandrekken in steigerhout.</p>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:col-span-12 lg:grid-cols-4">
          <Picture src={sTrap} alt="Trap in steigerhout met stalen leuning" widths={[300, 500]} sizes="(min-width: 1024px) 22vw, 50vw" formats={['avif', 'webp']} class="rijs aspect-[5/4] w-full object-cover" />
          <Picture src={sBar} alt="Bar met koffiemachine en wandrekken van steigerhout" widths={[300, 500]} sizes="(min-width: 1024px) 22vw, 50vw" formats={['avif', 'webp']} class="rijs aspect-[5/4] w-full object-cover sm:translate-y-8" style="--d:.08s" />
          <Picture src={sKeuken} alt="Keuken onder een vide met stalen trap" widths={[300, 500]} sizes="(min-width: 1024px) 22vw, 50vw" formats={['avif', 'webp']} class="rijs aspect-[5/4] w-full object-cover" style="--d:.12s" />
          <Picture src={sOlie} alt="Detail van een wandrek in steigerhout met olietapjes" widths={[300, 500]} sizes="(min-width: 1024px) 22vw, 50vw" formats={['avif', 'webp']} class="rijs aspect-[5/4] w-full object-cover sm:translate-y-8" style="--d:.16s" />
        </div>
      </div>

    </section>

    <!-- 4. Werkwijze -->
    <section id="werkwijze" class="py-24 md:py-32" aria-labelledby="ww-kop">
      <div class="wrap">
        <h2 id="ww-kop" class="sr-only">Werkwijze</h2>
        <p class="rijs font-kop text-reus leading-[.98] text-inkt" aria-hidden="false">“Heeft u er een<br class="hidden sm:inline" /> beeld bij?”</p>
        <p class="rijs mt-8 max-w-xl text-lg text-grijs" style="--d:.1s">Op die vraag moet u na de eerste stap volmondig ja kunnen antwoorden. Zo maakt Sven van uw idee een concreet plan.</p>
      </div>
      <div class="wrap mt-14 grid gap-x-14 gap-y-14 md:mt-20 lg:grid-cols-12">
        <ol class="lg:col-span-6">
          {stappen.map(([t, x], i) => (
            <li class="rijs grid grid-cols-[3.25rem_1fr] gap-x-4 border-t border-lijn-licht py-8 md:grid-cols-[4.5rem_1fr] md:py-10" style={`--d:${i * 0.08}s`}>
              <span class="num pt-1 text-sm font-semibold tracking-wide text-led-diep">0{i + 1}</span>
              <div>
                <h3 class="font-kop text-2xl">{t}</h3>
                <p class="mt-3 text-grijs">{x}</p>
              </div>
            </li>
          ))}
        </ol>
        <figure class="rijs lg:col-span-6 lg:-mt-6" style="--d:.1s">
          <Picture src={ontwerp} alt="Ontwerptekening van een kast met materiaalstalen: hoogglans, tapijt en leer met reliëf" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 46vw, 100vw" formats={['avif', 'webp']} class="verstek aspect-[4/5] w-full object-cover object-[38%_50%] sm:aspect-[16/11]" />
          <figcaption class="mt-3 text-sm text-grijs">Ontwerptekening met materiaalstalen.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 5. Sven -->
    <section id="sven" class="bg-papier-2 py-24 md:py-28" aria-labelledby="sven-kop">
      <div class="wrap grid gap-x-14 gap-y-12 lg:grid-cols-12">
        <figure class="rijs lg:col-span-4">
          <Picture src={hoek} alt="Eiken hoek in verstek met violet licht erachter" widths={[400, 500]} sizes="(min-width: 1024px) 30vw, 100vw" formats={['avif', 'webp']} class="aspect-[4/3] w-full object-cover sm:aspect-[4/5] sm:max-w-sm" />
        </figure>
        <div class="lg:col-span-7 lg:col-start-6">
          <h2 id="sven-kop" class="rijs text-4xl">Sven van den Berg</h2>
          <p class="rijs mt-8 max-w-2xl text-lg text-grijs" style="--d:.08s">Van jongs af aan geïnteresseerd in alles wat met interieur te maken heeft: het ontwerpen, de meubels en het materiaal. Opgeleid aan het Hout- en Meubileringscollege in Rotterdam.</p>
          <p class="rijs mt-5 max-w-2xl text-lg text-grijs" style="--d:.12s">Na jaren werken onder leiding van anderen begon hij in {site.sinds} voor zichzelf, om zelf mooie en bijzondere projecten aan te nemen. Beurzen, boeken en gesprekken met vakgenoten geven hem nog altijd inspiratie.</p>
          <blockquote class="rijs mt-12 border-l border-led-diep pl-6 md:mt-16" style="--d:.16s">
            <p class="font-kop text-3xl leading-[1.15]">“Mijn eigen werkplaats in Dordrecht maakt de toepasbaarheid hiervan concreet.”</p>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- 6. Uw plan in één zin (wow) -->
    <section id="plan" class="relative bg-nacht py-24 text-wit md:py-28" aria-labelledby="plan-kop">
      <span class="lichtlijn absolute inset-x-0 top-0" aria-hidden="true"></span>
      <div class="wrap grid gap-x-14 gap-y-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 id="plan-kop" class="rijs text-4xl">Uw plan in één zin.</h2>
          <p class="rijs mt-6 text-lg text-mist" style="--d:.08s">Kies wat u zoekt. Het bericht aan Sven staat daarna klaar in WhatsApp. Voorbeelden of foto’s stuurt u er gewoon achteraan.</p>
        </div>
        <form class="rijs lg:col-span-8" data-plan style="--d:.12s" onsubmit="return false">
          <p class="zin">
            Ik denk aan
            <label class="sr-only" for="p-wat">Wat zoekt u</label>
            <select id="p-wat" name="wat">{opties.map(([v, t], i) => <option value={v} selected={i === 1}>{t.toLowerCase()}</option>)}</select>
            voor
            <label class="sr-only" for="p-waar">Voor welke ruimte</label>
            <select id="p-waar" name="waar">{plekken.map(([v, t], i) => <option value={v} selected={i === 2}>{t}</option>)}</select>
            in
            <label class="sr-only" for="p-plaats">Plaats</label>
            <input id="p-plaats" name="plaats" type="text" placeholder="uw plaats" autocomplete="address-level2" />.
          </p>
          <label class="vink mt-8"><input type="checkbox" name="voorbeeld" checked />Ik heb voorbeelden of foto’s om mee te sturen</label>
          <p class="mt-10 max-w-2xl border-l border-lijn-2 pl-5 text-sm text-mist" aria-live="polite"><span class="sr-only">Uw bericht: </span><span data-voorbeeld></span></p>
          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={waStandaard} class="knop knop-led max-w-full whitespace-normal py-3 text-center" data-wa><Icoon naam="wa" />Stuur naar Sven via WhatsApp</a>
            <a href={site.telHref} class="link num text-mist">Of bel {site.tel}</a>
          </div>
        </form>
      </div>
    </section>

    <!-- 7. Contact -->
    <section id="contact" class="py-24 md:py-28" aria-labelledby="ct-kop">
      <div class="wrap grid gap-x-14 gap-y-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="ct-kop" class="rijs text-4xl">Even bellen of appen.</h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs" style="--d:.08s">U spreekt direct met Sven, de man die uw interieur ontwerpt en maakt.</p>
        </div>
        <dl class="rijs lg:col-span-6 lg:col-start-7" style="--d:.12s">
          <div class="grid gap-1 border-t border-lijn-licht py-6 sm:grid-cols-[9rem_1fr]">
            <dt class="text-sm text-grijs">WhatsApp</dt>
            <dd><a href={waStandaard} class="link link-licht font-kop text-2xl">Stuur een bericht</a></dd>
          </div>
          <div class="grid gap-1 border-t border-lijn-licht py-6 sm:grid-cols-[9rem_1fr]">
            <dt class="text-sm text-grijs">Telefoon</dt>
            <dd><a href={site.telHref} class="link link-licht num font-kop text-2xl">{site.tel}</a></dd>
          </div>
          <div class="grid gap-1 border-t border-lijn-licht py-6 sm:grid-cols-[9rem_1fr]">
            <dt class="text-sm text-grijs">E-mail</dt>
            <dd><a href={`mailto:${site.mail}`} class="link link-licht break-all font-kop text-2xl">{site.mail}</a></dd>
          </div>
          <div class="grid gap-1 border-y border-lijn-licht py-6 sm:grid-cols-[9rem_1fr]">
            <dt class="text-sm text-grijs">Werkplaats</dt>
            <dd class="font-kop text-2xl">{site.plaats}</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  </div>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-plan]');
  if (f) {
    const wa = f.querySelector<HTMLAnchorElement>('[data-wa]')!;
    const vb = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
    const nr = '31648256697';
    const bouw = () => {
      const d = new FormData(f);
      const plaats = String(d.get('plaats') || '').trim();
      let t = `Hallo Sven, ik denk aan ${d.get('wat')} voor ${d.get('waar')}${plaats ? ` in ${plaats}` : ''}.`;
      if (d.get('voorbeeld')) t += ' Ik heb voorbeelden of foto’s die ik kan meesturen.';
      t += ' Kunnen we eens bespreken wat er mogelijk is?';
      vb.textContent = t;
      wa.href = `https://wa.me/${nr}?text=${encodeURIComponent(t)}`;
    };
    const maat = () => f.querySelectorAll<HTMLSelectElement>('select').forEach((sel) => {
      const m = document.createElement('span'); const cs = getComputedStyle(sel);
      m.style.cssText = `position:absolute;visibility:hidden;white-space:nowrap;font:${cs.font}`; m.textContent = sel.options[sel.selectedIndex].text;
      document.body.appendChild(m); sel.style.width = `calc(${m.offsetWidth}px + 1.1em)`; m.remove();
    });
    f.addEventListener('input', bouw); f.addEventListener('change', () => { bouw(); maat(); }); bouw();
    document.fonts.ready.then(maat);
  }
</script>
