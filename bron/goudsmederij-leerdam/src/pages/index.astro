---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi, waMet } from '../data/site';

import werkbank from '../assets/eigen-werkbank.jpg';
import tangen from '../assets/eigen-tangen.jpg';
import winkel from '../assets/eigen-winkel.jpg';
import smelten from '../assets/eigen-smelten.jpg';
import diamantring from '../assets/g-diamantring.jpg';
import levensboom from '../assets/werk-levensboom.jpg';
import zegelring from '../assets/werk-zegelring.jpg';
import soldeerblok from '../assets/eigen-soldeerblok.jpg';
import frivool from '../assets/ig-frivool.jpg';
import paradijsvogel from '../assets/werk-paradijsvogel.jpg';
import aquamarijn from '../assets/werk-aquamarijn.jpg';
import manchet from '../assets/werk-manchetknopen.jpg';
import lapis from '../assets/werk-lapis.jpg';
import onix from '../assets/werk-onix.jpg';
import drie from '../assets/werk-drie-items.jpg';
import saffier from '../assets/ig-saffier.jpg';
import leeuw from '../assets/ig-manchetknopen-leeuw.jpg';
import schetsen from '../assets/ig-schetsen.jpg';
import willem from '../assets/team-willem.jpg';
import tineke from '../assets/team-tineke.jpg';
import bob from '../assets/team-bob.jpg';

// Alle teksten hieronder zijn gebaseerd op goudsmederijleerdam.nl, hun Instagram en hun Google-profiel.
const maken = [
  { titel: 'Gedenken', tekst: 'Een sieraad als kostbare herinnering aan een dierbaar persoon, of aan een mooi moment. In overleg maken we een sieraad dat bij u past.', foto: levensboom, alt: 'Hanger met een levensboom op de werkbank' },
  { titel: 'Van oud naar nieuw', tekst: 'Oude sieraden die nooit meer uit de kast komen? Van uw goud gieten we een nieuw sieraad. Zo werd een gouden collier een massieve cachetring.', foto: zegelring, alt: 'Massieve gouden cachetring, gegoten van een oud collier' },
  { titel: 'Reparatie & onderhoud', tekst: 'In ons atelier repareren en onderhouden we uw sieraden. Afgeven of ophalen kan op zaterdag ook zonder afspraak.', foto: soldeerblok, alt: 'Ringen en een pincet op het soldeerblok in het atelier', pos: 'object-[60%_50%]' },
  { titel: 'WB diamant', tekst: 'Onze eigen collectie: handgemaakte sieraden met diamant, naar eigen ontwerp en van hoogwaardige materialen.', foto: frivool, alt: 'Ring Frivool met een spinel en diamanten, uit eigen atelier' },
];
const werk = [
  { foto: paradijsvogel, titel: 'De paradijsvogel', tekst: 'Broche van rookkwarts met craquelé, de vogel in 18 karaat rood goud, de titanium staart met cognac-kleurig briljant.', alt: 'Broche de paradijsvogel: een rond stuk rookkwarts met een gouden vogel en lange titanium staart', vorm: 'aspect-[3/4]' },
  { foto: saffier, titel: 'Wit- en geelgoud met oranje saffier', tekst: 'Baguette geslepen diamant en een knaller van een oranje saffier.', alt: 'Ring van wit- en geelgoud met een oranje saffier en baguette diamanten', vorm: 'aspect-square' },
  { foto: aquamarijn, titel: 'Aquamarijn in witgoud', tekst: '18 karaat witgouden palladium ring met een aquamarijn en aan weerszijden een 0,20 ct diamant.', alt: 'Witgouden ring met een rechthoekige aquamarijn en twee langwerpige diamanten', vorm: 'aspect-square' },
  { foto: lapis, titel: 'Lapis hanger', tekst: '', alt: 'Hanger met een blauwe lapis lazuli aan een spang, met de ontwerpschets erachter', vorm: 'aspect-[4/5]' },
  { foto: drie, titel: 'Van één sieraad, drie', tekst: 'Van één sieraad maakten we drie bijzondere items.', alt: 'Een paar oorknoppen en een hanger met rode steen, gemaakt uit één sieraad', vorm: 'aspect-[4/5]' },
  { foto: leeuw, titel: 'Manchetknopen met leeuwenkop', tekst: 'Handgemaakt, september 2026.', alt: 'Twee manchetknopen met een leeuwenkop', vorm: 'aspect-square' },
  { foto: onix, titel: 'Onix collier', tekst: '', alt: 'Collier van matte onix kralen met een gebogen schakel', vorm: 'aspect-[3/2]' },
  { foto: manchet, titel: 'Manchetknopen', tekst: '', alt: 'Een paar rechthoekige manchetknopen op het houten werkblok', vorm: 'aspect-square' },
];
const jaren = [
  ['1976', 'Jan en Siena Bouman beginnen een juwelierszaak aan de Voorstraat in Beesd.'],
  ['3 jaar later', 'Ze vinden het pand aan de Kerkstraat in Leerdam. Binnen enkele jaren wordt de zaak een groot succes.'],
  ['1987', 'Jan geeft het stokje door aan Willem Bouman, die de winkel twintig jaar met plezier voortzet.'],
  ['2005', 'Willem kiest voor de wereld van diamant en deelt zijn kennis als diamantair met juweliers door het hele land.'],
  ['2015', 'De comeback: Goudsmederij Leerdam, geheel gericht op ambacht en specialisme.'],
];
const team = [
  { foto: willem, naam: 'Willem', rol: 'Diamantair & goudsmid', alt: 'Portret van Willem Bouman in de winkel' },
  { foto: tineke, naam: 'Tineke', rol: 'Basis goudsmid & designer', alt: 'Portret van Tineke' },
  { foto: bob, naam: 'Bob', rol: 'Meester goudsmid', alt: 'Portret van goudsmid Bob in de winkel' },
];
const titel = 'Goudsmederij Leerdam | Atelier en juwelier aan de Kerkstraat';
const omschrijving = 'Goudsmederij Leerdam, Kerkstraat 40 in Leerdam: handgemaakte sieraden, trouwringen, gedenksieraden, van oud goud een nieuw sieraad en reparaties. Met een goudsmidswerkbank in de winkel. Maak online een afspraak.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- HERO: still uit hun eigen film, de werkbank -->
    <section class="donker relative isolate flex min-h-[40rem] items-end overflow-hidden bg-leisteen text-licht md:min-h-[calc(100svh-4.75rem)] md:max-h-[58rem]">
      <Image src={werkbank} alt="Een goudsmid aan de werkbank in de winkel zet met een tang een ring vast, met de loep op" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[64%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#1c1d1cf0_0%,#1c1d1cc2_36%,#1c1d1c33_70%,#1c1d1c14_100%)] max-md:bg-[linear-gradient(0deg,#1c1d1cf5_0%,#1c1d1cc4_58%,#1c1d1c40_100%)]" aria-hidden="true"></div>
      <div class="wrap pb-16 pt-32 md:pb-24">
        <h1 class="max-w-[12ch] text-hero">Van een draad goud tot <span class="text-fel">uw sieraad</span></h1>
        <p class="mt-7 max-w-lg text-lg text-licht/90 md:text-xl">Ons atelier zit in de winkel. Hier ontwerpen en maken we sieraden met de hand: trouwringen, gedenksieraden en nieuwe juwelen van uw oude goud.</p>
        <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={site.afspraak} class="knop knop-granaat"><Icoon naam="agenda" />Plan uw afspraak</a>
          <a href={waHoi} class="link inline-flex items-center gap-2 font-semibold"><Icoon naam="wa" class="h-4 w-4" />Of stuur ons een WhatsApp</a>
        </div>
      </div>
      <p class="absolute bottom-6 right-6 hidden text-right text-sm leading-snug text-licht/75 lg:block">Kerkstraat 40, Leerdam<br />Familiebedrijf Bouman, sinds 1976</p>
    </section>

    <!-- ATELIER: hun eigen woorden, de werkbank in de winkel -->
    <section id="atelier" class="bank pb-20 pt-36 md:pb-24 md:pt-44" style="--uit: var(--color-leisteen)">
      <div class="wrap grid grid-cols-1 gap-x-10 gap-y-14 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-6">
          <blockquote class="rijs">
            <p class="font-kop text-3xl leading-[1.05]">“Goudsmeden is een prachtig vak!”</p>
          </blockquote>
          <p class="rijs mt-7 max-w-xl text-lg text-grijs">Het is bijzonder om te zien hoe er van een draad of een plaatje edelmetaal een sieraad ontstaat. Daarom staat onze goudsmidswerkbank op een prominente plek in de winkel. Schuif gerust even aan.</p>
          <p class="rijs mt-10 font-kop text-[clamp(1.5rem,1.5vw+1rem,2.25rem)] leading-[1.25]">Solderen&nbsp;<span class="punt"></span> vijlen&nbsp;<span class="punt"></span> smeden&nbsp;<span class="punt"></span> zagen</p>
          <div class="rijs mt-10 grid max-w-xl gap-6 border-t border-lijn pt-8 sm:grid-cols-2">
            <p class="text-[.9375rem] text-grijs"><b class="font-semibold text-inkt">Onze vaste goudsmid Bob</b> laat u graag zien waar hij mee bezig is. Soms draait er een gastgoudsmid een dagje mee.</p>
            <p class="text-[.9375rem] text-grijs"><b class="font-semibold text-inkt">Basis in Schoonhoven.</b> Daar legden de meeste van onze goudsmeden hun basis. Daarna specialiseerde ieder zich in zijn passie.</p>
          </div>
        </div>
        <figure class="rijs relative min-w-0 lg:col-span-6">
          <Image src={tangen} alt="Tangen en vijlen aan de werkbank, op de achtergrond werkt een goudsmid" widths={[640, 960, 1300]} sizes="(min-width: 1024px) 44vw, 100vw" class="aspect-[5/4] w-full rounded-sm object-cover object-[30%_50%] shadow-md lg:aspect-[6/5]" />
          <figcaption class="mt-4 text-sm text-grijs">De werkbank in onze winkel aan de Kerkstraat.</figcaption>
        </figure>
      </div>
    </section>

    <!-- WAT WE MAKEN: donker, één groot verhaal + vier regels -->
    <section id="maken" class="donker bg-leisteen py-24 text-licht md:py-24">
      <div class="wrap">
        <h2 class="rijs max-w-3xl text-3xl">Gemaakt voor één persoon, of voor twee</h2>
        <div class="mt-12 grid grid-cols-1 gap-x-12 gap-y-14 lg:grid-cols-12">
          <article class="rijs min-w-0 lg:col-span-5">
            <a href={waMet('Goedendag Goudsmederij Leerdam, wij zijn op zoek naar trouwringen en willen graag een afspraak maken.')} class="group block no-underline">
              <div class="overflow-hidden rounded-sm">
                <Image src={diamantring} alt="Witgouden ring met een grote ronde diamant" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[6/5] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] max-lg:max-h-[30rem]" />
              </div>
              <h3 class="mt-7 text-[clamp(2rem,2vw+1.2rem,2.75rem)]">Trouwen</h3>
              <p class="mt-3 max-w-md text-lg text-licht-zacht">Er is niets waardevoller dan de liefde, en dat mag gevierd worden. Samen met u maken we de trouwringen die helemaal bij jullie passen.</p>
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-fel">Vraag naar trouwringen <Icoon naam="pijl" class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </a>
          </article>
          <div class="lg:col-span-7">
            <ul class="border-t border-lijn-licht">
              {maken.map((m, i) => (
                <li class="rijs grid grid-cols-[5.5rem_1fr] items-start gap-5 border-b border-lijn-licht py-6 sm:grid-cols-[7.5rem_1fr] sm:gap-7" style={`--d:${i * 0.06}s`}>
                  <Image src={m.foto} alt={m.alt} widths={[220, 300]} sizes="9rem" class={`aspect-square w-full rounded-sm object-cover ${m.pos ?? ''}`} />
                  <div>
                    <h3 class="text-2xl">{m.titel}</h3>
                    <p class="mt-2.5 max-w-lg text-licht-zacht">{m.tekst}</p>
                  </div>
                </li>
              ))}
            </ul>
            <p class="rijs mt-8 text-licht-zacht">Willem was jarenlang diamantair. Wilt u iets met een bijzondere steen? <a href={waMet('Goedendag Goudsmederij Leerdam, ik heb een vraag over een sieraad met een diamant of edelsteen.')} class="link font-semibold text-licht">Vraag het ons</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ONS WERK: echte projecten met hun eigen bijschriften -->
    <section id="werk" class="bg-taupe-licht py-20 md:py-[5.5rem]">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs max-w-2xl text-3xl">Van onze werkbank</h2>
          <a href={site.instagram} class="rijs link inline-flex items-center gap-2 font-semibold"><Icoon naam="insta" class="h-4 w-4" />Nieuw werk op Instagram</a>
        </div>
        <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 lg:grid-cols-4">
          {werk.slice(0, 7).map((w, i) => (
            <figure class:list={['rijs min-w-0', i === 0 && 'col-span-2 flex flex-col sm:col-span-1 lg:row-span-2']} style={`--d:${(i % 4) * 0.06}s`}>
              <Image src={w.foto} alt={w.alt} widths={[320, 480, 640]} sizes="(min-width: 1024px) 22vw, 50vw" class:list={['w-full rounded-sm object-cover', i === 0 ? 'aspect-[4/5] sm:aspect-auto sm:min-h-0 sm:flex-1' : 'aspect-square']} />
              <figcaption class="mt-3">
                <span class="block font-kop text-lg leading-snug">{w.titel}</span>
                {w.tekst && <span class="mt-1 block text-sm text-grijs">{w.tekst}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- WOW: samen ontwerpen, de aanvraag als zin -->
    <section id="ontwerpen" class="py-20 md:py-[5.5rem]">
      <div class="wrap grid grid-cols-1 items-start gap-x-12 gap-y-12 lg:grid-cols-12">
        <figure class="rijs relative min-w-0 lg:col-span-5">
          <Image src={schetsen} alt="Een medewerker schetst aan tafel een ontwerp voor een sieraad" widths={[480, 640]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[5/4] w-full rounded-sm object-cover object-[50%_30%] max-lg:max-w-md" />
          <blockquote class="mt-6 max-w-sm">
            <p class="font-kop text-2xl leading-snug">“Vrijblijvend meedenken en schetsen, zo krijgt een idee vorm!”</p>
            <footer class="mt-2 text-sm text-grijs">Op onze Instagram, juni 2026</footer>
          </blockquote>
        </figure>

        <div class="min-w-0 lg:col-span-7">
          <h2 class="rijs text-3xl">Vertel ons wat u zoekt</h2>
          <p class="rijs mt-5 max-w-xl text-lg text-grijs">Maak de zin af. Wij lezen mee, denken mee en plannen samen met u een afspraak aan de werkbank.</p>

          <form class="rijs mt-10 border-t-[3px] border-granaat bg-wit p-6 shadow-md sm:p-10" data-aanvraag aria-label="Aanvraag voor een sieraad">
            <p class="font-kop text-[clamp(1.5rem,1.4vw+1.05rem,2.125rem)] leading-[1.6]">
              Wij zoeken
              <label class="sr-only" for="a-wat">Wat zoekt u</label>
              <select id="a-wat" name="wat" class="zin-keus">
                <option value="trouwringen">trouwringen</option>
                <option value="een verlovingsring">een verlovingsring</option>
                <option value="een gedenksieraad">een gedenksieraad</option>
                <option value="een nieuw sieraad van oud goud">een nieuw sieraad van oud goud</option>
                <option value="een sieraad met diamant">een sieraad met diamant</option>
                <option value="iets anders">iets anders</option>
              </select>
              in
              <label class="sr-only" for="a-metaal">Metaal</label>
              <select id="a-metaal" name="metaal" class="zin-keus">
                <option>geelgoud</option>
                <option>witgoud</option>
                <option>rood goud</option>
                <option>twee kleuren goud</option>
                <option value="">een metaal dat we nog kiezen</option>
              </select>,
              <label class="sr-only" for="a-steen">Steen</label>
              <select id="a-steen" name="steen" class="zin-keus">
                <option>met diamant</option>
                <option>met een edelsteen</option>
                <option>zonder steen</option>
                <option value="">steen nog onbekend</option>
              </select>.
              Ons budget is
              <label class="sr-only" for="a-budget">Budget (mag leeg)</label>
              <input id="a-budget" name="budget" type="text" class="zin-keus w-[9.5rem]" placeholder="nog open" autocomplete="off" />
              en het moet klaar zijn
              <label class="sr-only" for="a-datum">Graag klaar op (mag leeg)</label>
              <input id="a-datum" name="datum" type="date" class="zin-keus w-[13.5rem]" />.
            </p>

            <div class="mt-8 rounded-md rounded-tl-none bg-[#e5f3dc] p-4 text-[.9375rem] leading-relaxed text-inkt" aria-live="polite">
              <p class="text-xs font-bold text-[#2d5f34]">Uw bericht</p>
              <p class="mt-1" data-bericht>Goedendag Goudsmederij Leerdam, wij zoeken trouwringen in geelgoud, met diamant.</p>
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-4">
              <a href={waHoi} class="knop knop-granaat" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
              <a href={site.afspraak} class="link font-semibold">Of plan direct een afspraak</a>
            </div>
            <p class="mt-4 text-xs text-grijs">Vrijblijvend. Er wordt pas iets verstuurd als u in WhatsApp op verzenden drukt.</p>
          </form>
        </div>
      </div>
    </section>

    <!-- OVER ONS: 1976-2015 + het team -->
    <section id="over" class="donker relative overflow-hidden bg-leisteen text-licht">
      <Image src={smelten} alt="" widths={[1440, 1920]} sizes="100vw" class="absolute inset-x-0 top-0 h-[22rem] w-full object-cover object-[50%_45%] opacity-55 md:h-[26rem]" />
      <div class="absolute inset-x-0 top-0 h-[22rem] bg-[linear-gradient(180deg,#1c1d1c00_0%,#1c1d1c_100%)] md:h-[26rem]" aria-hidden="true"></div>
      <div class="wrap relative grid grid-cols-1 gap-x-14 gap-y-14 pb-20 pt-40 md:pb-24 md:pt-48 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-5">
          <h2 class="rijs text-3xl">Een familiebedrijf, sinds 1976</h2>
          <p class="rijs mt-6 max-w-md text-lg text-licht-zacht">Alles draait hier om beleving, emotie en ambacht. En het allerbelangrijkste bent u als klant.</p>
          <div class="mt-12 grid grid-cols-3 gap-3 sm:gap-5">
            {team.map((p, i) => (
              <figure class="rijs min-w-0" style={`--d:${i * 0.08}s`}>
                <Image src={p.foto} alt={p.alt} widths={[240, 400]} sizes="(min-width: 1024px) 12vw, 30vw" class="aspect-[4/5] w-full rounded-sm object-cover grayscale" />
                <figcaption class="mt-3">
                  <span class="block font-kop text-xl">{p.naam}</span>
                  <span class="mt-1 block text-xs leading-snug text-licht-zacht">{p.rol}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
        <ol class="min-w-0 lg:col-span-7">
          {jaren.map(([j, t], i) => (
            <li class="rijs grid gap-1 border-t border-lijn-licht py-5 sm:grid-cols-[8rem_1fr] sm:gap-6" style={`--d:${i * 0.05}s`}>
              <span class:list={["num whitespace-nowrap font-kop text-fel", /^\d+$/.test(j) ? "text-2xl" : "text-xl sm:pt-1"]}>{j}</span>
              <span class="text-licht-zacht sm:pt-1">{t}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews" class="bg-wit py-20 md:py-[5.5rem]">
      <div class="wrap grid grid-cols-1 gap-x-12 gap-y-12 lg:grid-cols-12">
        <figure class="rijs min-w-0 lg:col-span-7">
          <blockquote class="font-kop text-[clamp(1.75rem,2.2vw+1rem,2.75rem)] leading-[1.18]">“{reviews[0].tekst}”</blockquote>
          <figcaption class="mt-6 text-sm text-grijs"><b class="font-semibold text-inkt">{reviews[0].naam}</b> · Google-review</figcaption>
          <a href={site.reviews} class="mt-10 inline-flex items-center gap-2.5 text-sm font-semibold no-underline hover:text-granaat">
            <Icoon naam="g" class="h-5 w-5" />
            <span class="flex gap-0.5 text-ster" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            {site.google.score} uit {site.google.aantal} reviews op Google
          </a>
        </figure>
        <div class="grid content-start gap-9 lg:col-span-5 lg:border-l lg:border-lijn lg:pl-12">
          {reviews.slice(1, 3).map((r, i) => (
            <figure class="rijs" style={`--d:${0.1 + i * 0.1}s`}>
              <span class="flex gap-0.5 text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
              <blockquote class="mt-3 text-lg leading-snug">“{r.tekst}”</blockquote>
              <figcaption class="mt-2.5 text-sm text-grijs"><b class="font-semibold text-inkt">{r.naam}</b> · Google-review</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- BEZOEK -->
    <section id="bezoek" class="border-t border-lijn bg-kalk py-20 md:py-[5.5rem]">
      <div class="wrap grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs min-w-0 self-start lg:col-span-6">
          <Image src={winkel} alt="De winkel aan de Kerkstraat: verlichte vitrines, een ronde tafel op een rood kleed en glazen appel en peer op de toonbank" widths={[640, 960, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover shadow-md lg:aspect-[5/4]" />
          <figcaption class="mt-4 text-sm text-grijs">Aan deze tafel zoekt u in alle rust uw sieraad uit.</figcaption>
        </figure>
        <div class="lg:col-span-5 lg:col-start-8">
          <h2 class="rijs text-3xl">Welkom aan de Kerkstraat</h2>
          <address class="rijs mt-7 not-italic">
            <p class="text-xl font-semibold">{site.straat}</p>
            <p class="text-lg text-grijs">{site.postcode} {site.plaats}</p>
          </address>
          <p class="rijs mt-6 inline-flex items-center gap-2.5 rounded-full bg-taupe-licht px-4 py-2 text-sm font-semibold" data-status-wrap>
            <span class="stip-open h-2.5 w-2.5 rounded-full bg-grijs" aria-hidden="true"></span>
            <span data-status>Woensdag t/m zaterdag 9.00-17.00</span>
          </p>
          <table class="rijs mt-7 w-full max-w-md">
            <caption class="sr-only">Openingstijden Goudsmederij Leerdam</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-bold data-[vandaag]:text-granaat">
                  <th scope="row" class="py-2 text-left font-[inherit]">{t.naam}{t.noot && <span class="ml-2 text-xs font-medium text-grijs">{t.noot}</span>}</th>
                  <td class="num py-2 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <div class="rijs mt-9 flex flex-wrap gap-3">
            <a href={site.afspraak} class="knop knop-granaat"><Icoon naam="agenda" />Afspraak maken</a>
            <a href={site.maps} class="knop knop-inkt"><Icoon naam="pin" />Route</a>
          </div>
          <p class="rijs mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem]">
            <a href={site.telHref} class="num inline-flex items-center gap-2 font-semibold no-underline hover:text-granaat"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
            <a href={waHoi} class="inline-flex items-center gap-2 font-semibold no-underline hover:text-granaat"><Icoon naam="wa" class="h-4 w-4" />WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="inline-flex items-center gap-2 font-semibold no-underline hover:text-granaat"><Icoon naam="mail" class="h-4 w-4" />{site.mail}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- SLOTBAND -->
    <section class="bg-granaat text-wit">
      <div class="wrap flex flex-wrap items-center justify-between gap-8 py-14 md:py-16">
        <p class="max-w-2xl font-kop text-[clamp(1.875rem,2.2vw+1rem,2.875rem)] leading-[1.08]">De werkbank staat klaar. Schuif gerust aan.</p>
        <a href={site.afspraak} class="knop knop-wit"><Icoon naam="agenda" />Plan uw afspraak</a>
      </div>
    </section>
  </main>
  <Voet />

  <style>
    [data-open='true'] .stip-open { background: #2f8a4c; box-shadow: 0 0 0 4px #2f8a4c33; }
  </style>

  <script>
    import { waMet } from '../data/site';
    const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
    if (f) {
      const uit = f.querySelector<HTMLElement>('[data-bericht]')!;
      const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const datumNl = (v: string) => { const [j, m, d] = v.split('-').map(Number); return new Date(j, m - 1, d).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }); };
      // Keuzelijsten in de zin even breed maken als de gekozen tekst.
      const meet = document.createElement('span');
      meet.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px';
      f.appendChild(meet);
      const pas = () => f.querySelectorAll<HTMLSelectElement>('select.zin-keus').forEach((sel) => {
        meet.style.font = getComputedStyle(sel).font;
        meet.textContent = sel.options[sel.selectedIndex].text;
        sel.style.width = `${Math.ceil(meet.getBoundingClientRect().width) + 30}px`;
      });
      const budget = f.querySelector<HTMLInputElement>('#a-budget')!;
      const pasB = () => { meet.style.font = getComputedStyle(budget).font; meet.textContent = budget.value || budget.placeholder; budget.style.width = `${Math.min(Math.ceil(meet.getBoundingClientRect().width) + 14, f.clientWidth - 40)}px`; };
      document.fonts?.ready.then(() => { pas(); pasB(); });
      const maak = () => {
        pas(); pasB();
        const d = new FormData(f);
        const g = (k: string) => String(d.get(k) || '').trim();
        const delen = [g('metaal') && `in ${g('metaal')}`, g('steen')].filter(Boolean).join(', ');
        let t = `Goedendag Goudsmederij Leerdam, wij zoeken ${g('wat')}${delen ? ` ${delen}` : ''}.`;
        if (g('budget')) t += ` Ons budget is ${g('budget')}.`;
        if (g('datum')) t += ` Het moet klaar zijn op ${datumNl(g('datum'))}.`;
        t += ' Kunnen we een afspraak maken?';
        uit.textContent = t;
        stuur.href = waMet(t);
      };
      f.addEventListener('input', maak); f.addEventListener('change', maak); f.addEventListener('submit', (e) => e.preventDefault());
      maak();
    }
  </script>
</Base>
