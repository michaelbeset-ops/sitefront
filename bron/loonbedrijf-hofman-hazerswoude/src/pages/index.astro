  .tab:hover { color: var(--color-licht); }
  .tab[aria-selected='true'] { background: var(--color-rood); color: #fff; box-shadow: none; }
  :global(.js) .paneel.is-dicht { display: none; }
  .machine { transition: background-color .2s; }
