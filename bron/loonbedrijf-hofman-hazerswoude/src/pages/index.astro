<script>
  // Machinepark: tabs + huurlijst die een WhatsApp-bericht vult.
  const sectie = document.querySelector<HTMLElement>('[data-huur]');
  if (sectie) {
    const tabs = [...sectie.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panelen = [...sectie.querySelectorAll<HTMLElement>('[data-paneel]')];
    const kies = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      panelen.forEach((p) => p.classList.toggle('is-dicht', p.dataset.paneel !== id));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => kies(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        n.focus(); kies(n.dataset.tab!);
      });
    });
    const teller = sectie.querySelector<HTMLElement>('[data-teller]')!;
    const lijst = sectie.querySelector<HTMLElement>('[data-lijst]')!;
    const knop = sectie.querySelector<HTMLAnchorElement>('[data-huur-knop]')!;
    const basis = knop.href;
    sectie.querySelectorAll<HTMLInputElement>('[data-machine]').forEach((c) => c.addEventListener('change', () => {
      const gekozen = [...sectie.querySelectorAll<HTMLInputElement>('[data-machine]:checked')].map((x) => x.value);
      if (!gekozen.length) { teller.textContent = 'Nog niets op uw lijst.'; lijst.textContent = 'Tik op een machine om hem toe te voegen.'; knop.href = basis; return; }
      teller.textContent = `${gekozen.length} ${gekozen.length === 1 ? 'machine' : 'machines'} op uw lijst`;
      lijst.textContent = gekozen.join(', ');
      const tekst = ['Goedendag, ik wil graag weten of deze machines beschikbaar zijn:', ...gekozen.map((g) => '- ' + g), 'Periode: ...', 'Locatie: ...'].join('\n');
      knop.href = 'https://wa.me/31621578919?text=' + encodeURIComponent(tekst);
    }));
  }

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Goedendag, ik heb een klus voor Loonbedrijf Hofman.'];
      if (v('soort')) r.push('Soort klus: ' + v('soort'));
      if (v('waar')) r.push('Plaats: ' + v('waar'));
      if (v('wanneer')) r.push('Wanneer: ' + v('wanneer').toLowerCase());
      if (v('wat')) r.push('Omschrijving: ' + v('wat'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31621578919?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

