  .veld { display: block; width: 100%; border-radius: var(--radius-md); border: 1.5px solid #16130f33; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #16130f66; }
