---
// Nagezet naar hun raamlogo (gevelfoto's dsc-1124/1157): PVC & TEGEL in een kader dat rechts open is, DESIGN rechtsonder
// in de onderlijn.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`} style="font-family: var(--font-kop)">
  <span class="block h-[2px] w-[68%] bg-current" aria-hidden="true"></span>
  <span class="block whitespace-nowrap border-l-2 border-current py-[.45rem] pl-3 pr-1 text-[1.25rem] font-[700] uppercase tracking-[.01em] sm:text-[1.45rem]">Pvc &amp; Tegel</span>
  <span class="flex items-center gap-2" aria-hidden="true"><span class="h-[2px] flex-1 bg-current"></span><span class="-mb-[.05rem] text-[.62rem] font-[650] uppercase tracking-[.3em] sm:text-[.7rem]">Design</span></span>
  <span class="sr-only">Design, naar de homepage</span>
</a>
