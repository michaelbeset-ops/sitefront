---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const vakken = ['Pvc-vloeren', 'Trappen bekleden', 'Badkamertegels', 'Keukentegels', 'Portugese tegels', 'Egaliseren en plinten'];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-7 max-w-xs">Pvc en tegels voor je vloer, je muur, je trap en terras. Uitzoeken in de winkel, gelegd door Kevin en Danny.</p>
      <a href={site.telHref} class="knop knop-merk num mt-7 min-h-12 px-5"><Icoon naam="tel" />{site.tel}</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Vakken</p>
      <ul class="mt-5 space-y-2.5">
        {vakken.map((t) => <li><a href={h('vakken')} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Winkel</p>
      <ul class="mt-5 space-y-2.5">
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li>Zaterdag <span class="num">10:00</span> tot <span class="num">16:00</span><br />Doordeweeks op afspraak</li>
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline hover:text-merk-licht">{site.mail}</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Volgen</p>
      <ul class="mt-5 space-y-2.5">
        <li><a href={site.insta} class="inline-flex items-center gap-2 no-underline hover:text-merk-licht"><Icoon naam="insta" class="h-5 w-5" />Instagram</a></li>
        <li><a href={waHoi} class="inline-flex items-center gap-2 no-underline hover:text-merk-licht"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a></li>
        <li><a href={site.reviews} class="no-underline hover:text-merk-licht">Google <span class="num">{site.google.score}</span>, {site.google.aantal} reviews</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Foto's van jullie Google-profiel en uit In de Krimpenerwaard, teksten uit jullie Instagram en Google-profiel. Reviews letterlijk van Google (stand 15 oktober 2026).</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
