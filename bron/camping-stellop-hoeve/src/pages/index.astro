---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tarieven, euro } from '../data/site';
import veld from '../assets/kampeerveld.jpg';
import bord from '../assets/welkomstbord.jpg';
import boerderij from '../assets/boerderij.jpg';
import stalling from '../assets/fietsenstalling.jpg';
import terras from '../assets/appartement-terras.jpg';
import slaapkamer from '../assets/appartement-slaapkamer.jpg';
import zithoek from '../assets/appartement-zithoek.jpg';
import keuken from '../assets/appartement-keuken.jpg';
import bbqTafel from '../assets/barbecue-tafel.jpg';
import bbqGrill from '../assets/barbecue-grill.jpg';
import zon from '../assets/zonsondergang.jpg';
import bos from '../assets/bos-tent.jpg';
import oprit from '../assets/oprit.jpg';

const faciliteiten = [
  { kop: 'Uw plaats', items: ['Verharde voortentplaatsen met 6A stroom', 'Gratis wifi vanuit de kampeerplaats', "Aparte parkeerplaatsen voor auto's", 'Campers van harte welkom', 'Honden welkom, mits aangelijnd'] },
  { kop: 'Sanitair en was', items: ['3 warmwaterdouches (met munten)', '3 wastafels', '3 toiletten, 1 urinoir', 'Invalidentoilet en -douche', 'Afvoer voor chemisch toilet', '2 koudwatertappunten', 'Wasmachine, wasdroger en centrifuge'] },
  { kop: 'Samen en buiten', items: ['Feest-/recreatiezaal met o.a. tv', 'Jeu de boulesbaan', 'Kippen', 'Overdekte fietsenstalling met oplaadpunten', 'Fietsen te huur', 'Fiets- en wandelroutes te leen'] },
];
const voorzieningen = ['Compleet ingerichte keuken', '4-pitsgasfornuis', 'Toilet', 'Privé-terras', 'TV', 'Tafel met 2 stoelen', 'Gratis wifi van de camping', 'Douchen in het toiletgebouw van de camping'];
const omgeving = [
  'Landgoed de Kampina', 'Oisterwijkse bossen en vennen', 'Brabantse Natuurpoorten', 'Trappistenklooster Koningshoeven',
  'Den Donk (binnenzwembad in Oisterwijk)', 'Loonse en Drunense duinen', 'Landgoed de Rosep', 'De Reuselhoeve',
  'Fietsen door Hart van Brabant', 'Efteling', 'Safaripark Beekse Bergen', 'Piet Plezier',
  'Binnen- en buitenspeeltuinen in de omgeving', 'Weekmarkten in de omgeving',
];
const percelen = ['Het Steeke', 'De Geweerakker', 'Het Kalverwike', 'Land de Katerstraat', 'Plas-akker', 'De Meeuw-akker', 'Dries Ome Waai', 'De Weversdries'];

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const wa = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 2.9 4.5 4 1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const vink = `<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m2.5 6.2 2.3 2.3 4.7-5"/></svg>`;
const blad = `<svg viewBox="0 0 16 16" aria-hidden="true" class="mt-1.5 h-3.5 w-3.5 flex-none"><path d="M2 14C2 6 7 2 14 2c0 7-4 12-12 12Z" fill="currentColor"/></svg>`;
---
<Base
  title="Camping De Stellop Hoeve | Kleinschalig kamperen in Moergestel"
  description="SVR-camping in Moergestel, gemeente Oisterwijk. 19 ruime kampeerplaatsen met elektra (6A) en verharde voortentplaats, en appartementen die het hele jaar te huur zijn. Oirschotseweg 50."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: diep bosgroen, grote kop, bewijzen rechts. Daaronder hun eigen kampeerveld als brede plaat, met het welkomstbord erover. -->
    <section class="donker flex flex-col bg-bos text-white">
      <div class="wrap order-2 grid gap-10 py-10 sm:py-14 lg:order-1 lg:grid-cols-12 lg:pt-14 lg:pb-12">
        <div class="lg:col-span-8">
          <p class="kicker text-oker">SVR-camping in Moergestel, gemeente Oisterwijk</p>
          <h1 class="mt-4 text-4xl">Kleinschalig kamperen in de Parel in 't Groen</h1>
          <p class="mt-6 max-w-2xl text-lg text-white/85">Op zoek naar rust en gemoedelijkheid? Camping De Stellop Hoeve ligt in Moergestel, met de prachtige bossen en vennen. 19 ruime kampeerplaatsen, en appartementen die het hele jaar te huur zijn.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-oker"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
            <a href={site.whatsapp} class="btn btn-line"><Fragment set:html={wa} />Stuur een WhatsApp</a>
          </div>
        </div>
        <div class="flex flex-col justify-between gap-10 lg:col-span-4">
        <figure class="hidden w-full max-w-[340px] rotate-2 self-end overflow-hidden rounded-xl shadow-lg ring-4 ring-white/10 lg:block">
          <div class="aspect-[1478/414]"><Foto src={bord} alt="Het houten welkomstbord: welkom op de Stellop Hoeve" widths={[340, 680]} sizes="340px" hero /></div>
        </figure>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-t border-white/20 pt-6 text-sm lg:grid-cols-1 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
          <div class="col-span-2 lg:col-span-1"><dt class="text-white/75">Google</dt><dd><strong class="font-display text-2xl">{site.google}</strong> <span class="text-white/80">({site.reviews} reviews)</span></dd></div>
          <div><dt class="text-white/75">Kampeerseizoen</dt><dd class="font-display text-lg font-bold leading-snug">15 maart <span class="whitespace-nowrap">t/m 31 oktober</span></dd></div>
          <div><dt class="text-white/75">Appartementen</dt><dd class="font-display text-lg font-bold leading-snug">het hele jaar</dd></div>
        </dl>
        </div>
      </div>
      <div class="order-1 lg:order-2 lg:bg-[linear-gradient(to_bottom,var(--color-bos)_58%,var(--color-linnen)_58%)]">
        <div class="wrap relative !px-0 lg:!px-8">
          <figure class="relative ml-auto max-w-[1000px] overflow-hidden lg:rounded-xl lg:shadow-lg">
            <div class="aspect-[4/3] sm:aspect-[1000/520]"><Foto src={veld} alt="Ons kampeerveld: caravans met voortenten aan de rand van een groot grasveld, met hoge bomen en blauwe lucht" hero widths={[500, 1000]} sizes="(min-width: 1000px) 1000px, 100vw" class="object-[50%_60%]" /></div>
            <figcaption class="absolute top-2 right-2 rounded-lg bg-bos/85 px-2.5 py-1 text-xs text-white sm:top-auto sm:right-4 sm:bottom-4 sm:text-sm">Het kampeerveld</figcaption>
          </figure>
          <figure class="absolute -bottom-6 left-4 w-[62%] max-w-[360px] -rotate-2 overflow-hidden rounded-xl shadow-lg ring-4 ring-bos sm:-bottom-8 lg:hidden">
            <div class="aspect-[1478/414]"><Foto src={bord} alt="Het houten welkomstbord: welkom op de Stellop Hoeve" widths={[360, 720]} sizes="62vw" hero /></div>
          </figure>
        </div>
      </div>
    </section>

    <!-- De camping: de hoeve groot, kerncijfers als rij. -->
    <section id="camping" class="scroll-mt-20 pt-20 pb-16 lg:pt-24 lg:pb-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-6">
          <p class="kicker text-hout">De camping</p>
          <h2 class="mt-3 text-3xl">19 ruime plaatsen, allemaal met stroom</h2>
          <p class="mt-6 text-lg">De camping heeft 19 ruime kampeerplaatsen, allemaal voorzien van elektra (6A) en een verharde voortentplaats.</p>
          <p class="mt-4 text-ink-soft">Op fietsafstand vindt u gezellige dorpen en prachtige natuurgebieden. Ook op de camping is er voldoende vermaak voor u en uw (klein)kinderen.</p>
          <ul class="mt-6 flex flex-wrap gap-2 text-sm font-semibold">
            <li class="rounded-full bg-linnen-2 px-3.5 py-1.5">SVR-camping</li>
            <li class="rounded-full bg-linnen-2 px-3.5 py-1.5">Campers van harte welkom</li>
            <li class="rounded-full bg-linnen-2 px-3.5 py-1.5">Honden welkom, mits aangelijnd</li>
          </ul>
        </div>
        <figure class="lg:col-span-6">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={boerderij} alt="Onze hoeve aan de Oirschotseweg: een lange bakstenen boerderij met luiken, een houten bank en bloeiende struiken voor het huis" sizes="(min-width: 1024px) 680px, 100vw" /></div>
          <figcaption class="mt-3 text-sm text-ink-soft">De hoeve aan de Oirschotseweg 50</figcaption>
        </figure>
      </div>
      <dl class="wrap mt-14 grid grid-cols-2 gap-px overflow-hidden lg:mt-16 lg:grid-cols-4">
        {[
          ['19', 'ruime kampeerplaatsen'],
          ['6A', 'elektra op elke plaats'],
          ['2 km', 'vanuit het dorp'],
          ['500 m', 'naar de bushalte'],
        ].map(([g, t]) => (
          <div class="flex flex-col-reverse border-t-2 border-mos pt-4 pr-4 pb-2">
            <dt class="mt-1 text-sm text-ink-soft">{t}</dt>
            <dd class="font-display text-getal leading-none font-extrabold tracking-[-0.04em] whitespace-nowrap tabular-nums">{g}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Faciliteiten: donker vlak, drie kolommen lijsten, eigen foto van de fietsenstalling als inzet. -->
    <section class="donker bg-bos py-16 text-white lg:py-24">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="kicker text-oker">Faciliteiten</p>
            <h2 class="mt-3 text-3xl">Faciliteiten van onze camping</h2>
          </div>
          <p class="text-white/85 lg:col-span-4 lg:col-start-9 lg:self-end">Wifi is gratis. De camping ligt op 2 km vanuit het dorp, met een bushalte op 500 meter.</p>
        </div>
        <div class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
          {faciliteiten.map((f) => (
            <div class="lg:col-span-3">
              <h3 class="border-b border-white/20 pb-3 text-lg text-varen">{f.kop}</h3>
              <ul class="mt-2">
                {f.items.map((i) => <li class="flex gap-3 border-b border-white/10 py-2.5 text-white/90"><span class="text-oker"><Fragment set:html={blad} /></span><span class="min-w-0 [overflow-wrap:anywhere]">{i}</span></li>)}
              </ul>
            </div>
          ))}
          <figure class="md:col-start-2 md:row-start-2 lg:col-span-3 lg:col-start-auto lg:row-start-auto">
            <div class="mx-auto aspect-[3/4] max-w-[300px] overflow-hidden rounded-xl"><Foto src={stalling} alt="De overdekte fietsenstalling met fietsen en een kinderfiets" widths={[300, 600]} sizes="300px" /></div>
            <figcaption class="mx-auto mt-3 max-w-[300px] text-sm text-white/75">Overdekte fietsenstalling met oplaadpunten</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Appartementen: eigen foto's van buiten en binnen, voorzieningen en prijs. -->
    <section id="appartementen" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <div class="grid grid-cols-6 gap-3 sm:gap-4">
            <figure class="col-span-6">
              <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={terras} alt="Een van onze appartementen van buiten: bakstenen gevel met houten schuur, een terras met tafel en stoelen tussen de hagen" widths={[480, 800]} sizes="(min-width: 1024px) 560px, 100vw" /></div>
            </figure>
            {[
              { src: slaapkamer, alt: 'De slaapkamer met twee houten bedden tegen elkaar en groene handdoeken' },
              { src: zithoek, alt: 'De zithoek met twee groene stoelen, een tafel en een tv aan de muur' },
              { src: keuken, alt: 'De keuken met witte kastjes, gasfornuis en een groene stoel' },
            ].map((f) => (
              <figure class="col-span-2">
                <div class="aspect-square overflow-hidden rounded-xl shadow-sm"><Foto src={f.src} alt={f.alt} widths={[400, 800]} sizes="(min-width: 1024px) 185px, 31vw" /></div>
              </figure>
            ))}
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="kicker text-hout">Appartementen</p>
          <h2 class="mt-3 text-3xl">Het hele jaar door te huur</h2>
          <p class="mt-6 text-lg">Onze camping is geopend van 15 maart tot en met 31 oktober, maar het hele jaar door kunt u bij ons terecht in onze gezellige appartementen. Deze zijn voorzien van alle gemakken en comfortabele bedden.</p>
          <h3 class="mt-8 text-lg">Voorzieningen in de bed &amp; breakfast</h3>
          <ul class="mt-3 grid gap-x-6 sm:grid-cols-2">
            {voorzieningen.map((v) => <li class="flex gap-2.5 border-b border-line py-2 text-sm"><span class="text-mos"><Fragment set:html={blad} /></span><span>{v}</span></li>)}
          </ul>
          <div class="mt-8 rounded-xl bg-linnen-2 p-5 shadow-sm sm:p-6">
            <p class="text-sm text-ink-soft">Kosten incl. toeristenbelasting</p>
            <dl class="mt-2">
              {tarieven.verblijf.map((r) => (
                <div class="flex justify-between gap-4 border-b border-line py-2 last:border-0"><dt>{r.t}</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{euro(r.p)}</dd></div>
              ))}
            </dl>
            <p class="mt-2 text-sm text-ink-soft">Badhanddoeken en/of theedoeken zijn niet aanwezig in het vakantieverblijf.</p>
          </div>
          <a href="#prijzen" class="btn btn-mos mt-6">Reken uw verblijf uit</a>
        </div>
      </div>
    </section>

    <!-- Wow: prijscalculator met de tarieven 2026. Zonder JS: de volledige tarieflijsten. -->
    <section id="prijzen" class="donker scroll-mt-20 bg-bos py-16 text-white lg:py-24" data-calc>
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="kicker text-oker">Tarieven 2026</p>
            <h2 class="mt-3 text-3xl">Wat kost uw verblijf?</h2>
          </div>
          <p class="text-white/85 lg:col-span-4 lg:col-start-9 lg:self-end">De tarieven op onze camping zijn inclusief toeristenbelasting. <span data-js-tekst hidden>Kies hieronder wat u wilt en zie meteen een indicatie.</span></p>
        </div>

        <div hidden data-rekenblok class="mt-10 grid gap-6 lg:grid-cols-12">
          <form class="rounded-xl bg-linnen p-5 text-ink shadow-sm sm:p-7 lg:col-span-7" data-form>
            <fieldset>
              <legend class="font-display text-lg font-bold">Waar wilt u verblijven?</legend>
              <div class="mt-3 flex flex-wrap gap-2">
                <label class="keuze"><input type="radio" name="soort" value="kamperen" class="sr-only" checked /><span class="bol"><Fragment set:html={vink} /></span>Kamperen</label>
                <label class="keuze"><input type="radio" name="soort" value="verblijf" class="sr-only" /><span class="bol"><Fragment set:html={vink} /></span>Vakantieverblijf (appartement)</label>
              </div>
            </fieldset>

            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              <div>
                <p class="font-display font-bold" id="lbl-personen">Personen</p>
                <div class="teller mt-2" role="group" aria-labelledby="lbl-personen">
                  <button type="button" data-min="personen" aria-label="Eén persoon minder">−</button>
                  <output data-waarde="personen" aria-live="polite">2</output>
                  <button type="button" data-plus="personen" aria-label="Eén persoon meer">+</button>
                </div>
                <p class="mt-1 text-xs text-ink-soft" data-hint-personen hidden>Het appartement is voor 1 of 2 personen.</p>
              </div>
              <div>
                <p class="font-display font-bold" id="lbl-nachten">Nachten</p>
                <div class="teller mt-2" role="group" aria-labelledby="lbl-nachten">
                  <button type="button" data-min="nachten" aria-label="Eén nacht minder">−</button>
                  <output data-waarde="nachten" aria-live="polite">3</output>
                  <button type="button" data-plus="nachten" aria-label="Eén nacht meer">+</button>
                </div>
              </div>
            </div>

            <div data-alleen="kamperen">
              <fieldset class="mt-6">
                <legend class="font-display font-bold">Bent u lid van de SVR?</legend>
                <div class="mt-2 flex flex-wrap gap-2">
                  <label class="keuze"><input type="radio" name="svr" value="ja" class="sr-only" /><span class="bol"><Fragment set:html={vink} /></span>Ja, SVR-lid</label>
                  <label class="keuze"><input type="radio" name="svr" value="nee" class="sr-only" checked /><span class="bol"><Fragment set:html={vink} /></span>Nee</label>
                </div>
              </fieldset>
              <fieldset class="mt-6">
                <legend class="font-display font-bold">Extra's</legend>
                <div class="mt-2 flex flex-wrap gap-2">
                  <label class="keuze"><input type="checkbox" name="tent" class="sr-only" /><span class="bol"><Fragment set:html={vink} /></span>Tent (klein)</label>
                  <label class="keuze"><input type="checkbox" name="caravan" class="sr-only" /><span class="bol"><Fragment set:html={vink} /></span>Overnachtende caravan</label>
                </div>
              </fieldset>
              <div class="mt-5 grid gap-5 sm:grid-cols-3">
                {[
                  ['huisdieren', 'Huisdieren'],
                  ['bezoekers', 'Bezoekers'],
                  ['douches', 'Douchebeurten'],
                ].map(([id, naam]) => (
                  <div>
                    <p class="font-display font-bold" id={`lbl-${id}`}>{naam}</p>
                    <div class="teller mt-2" role="group" aria-labelledby={`lbl-${id}`}>
                      <button type="button" data-min={id} aria-label={`${naam}: één minder`}>−</button>
                      <output data-waarde={id} aria-live="polite">0</output>
                      <button type="button" data-plus={id} aria-label={`${naam}: één meer`}>+</button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="sticky bottom-3 mt-6 flex items-center justify-between gap-4 rounded-xl bg-bos px-4 py-3 text-white shadow-lg lg:hidden">
              <span class="text-sm text-white/85">Indicatie</span>
              <span class="font-display text-xl font-extrabold whitespace-nowrap tabular-nums" data-mini aria-hidden="true">€ 0,00</span>
              <a href="#uitkomst" class="text-sm font-semibold underline decoration-oker decoration-2 underline-offset-4">Opbouw</a>
            </div>
          </form>

          <div id="uitkomst" class="flex scroll-mt-20 flex-col rounded-xl border border-white/20 bg-mos p-5 shadow-sm sm:p-7 lg:col-span-5">
            <p class="kicker text-varen">Indicatie</p>
            <div aria-live="polite" data-uitkomst>
              <p class="mt-2 font-display text-getal leading-none font-extrabold tracking-[-0.04em] whitespace-nowrap tabular-nums" data-totaal>€ 0,00</p>
              <p class="mt-2 text-sm text-white/85" data-samenvatting></p>
            </div>
            <ul class="mt-6 border-t border-white/20 text-sm" data-regels></ul>
            <p class="mt-6 text-sm text-white/85">Dit is een indicatie op basis van de tarieven 2026. De camping bevestigt de prijs bij uw reservering.</p>
            <p class="mt-2 text-xs text-white/75" data-aanname></p>
            <div class="mt-auto flex flex-col gap-3 pt-6 sm:flex-row sm:flex-wrap">
              <a href={`mailto:${site.mail}`} class="btn btn-oker" data-mail><Fragment set:html={mail} />Mail uw aanvraag</a>
              <a href={site.whatsapp} class="btn btn-line"><Fragment set:html={wa} />WhatsApp</a>
            </div>
          </div>
        </div>

        <!-- Tarieflijsten: altijd zichtbaar, de bron van de calculator. -->
        <div class="mt-14 grid gap-10 border-t border-white/15 pt-12 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <h3 class="text-xl">Kamperen</h3>
            <dl class="mt-4 border-t border-white/20 text-sm sm:text-base">
              {tarieven.kamperen.map((r) => (
                <div class="flex justify-between gap-4 border-b border-white/15 py-2.5"><dt class="text-white/90">{r.t}</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{euro(r.p)}</dd></div>
              ))}
            </dl>
            <p class="mt-3 text-sm text-white/75">Douchemunten € 0,50. Wifi gratis.</p>
          </div>
          <div class="lg:col-span-5 lg:col-start-8">
            <h3 class="text-xl">Vakantieverblijf</h3>
            <dl class="mt-4 border-t border-white/20 text-sm sm:text-base">
              {tarieven.verblijf.map((r) => (
                <div class="flex justify-between gap-4 border-b border-white/15 py-2.5"><dt class="text-white/90">{r.t}</dt><dd class="font-semibold whitespace-nowrap tabular-nums">{euro(r.p)}</dd></div>
              ))}
            </dl>
            <p class="mt-3 text-sm text-white/75">Bad-, hand- en theedoeken niet aanwezig.</p>
          </div>
        </div>
      </div>
    </section>

    <script>
      import { tarieven } from '../data/site';
      // Prijscalculator. Rekent alleen met de tarieven 2026 van de eigen site (incl. toeristenbelasting).
      const sectie = document.querySelector<HTMLElement>('[data-calc]');
      if (sectie) {
        const p = (t: string) => [...tarieven.kamperen, ...tarieven.verblijf].find((r) => r.t === t)!.p;
        const T = {
          twee: p('2 personen per nacht (SVR-lid)'), tweeGeen: p('2 personen per nacht (geen SVR-lid)'),
          een: p('1 persoon per nacht (SVR-lid)'), eenGeen: p('1 persoon per nacht (geen SVR-lid)'),
          meer: p('Elke persoon meer (incl. toeristenbelasting)'), tent: p('Tent (klein)'), bezoeker: p('Bezoekers p.p.'),
          douche: p('Douche per douchebeurt'), huisdier: p('Huisdieren per dag'), caravan: p('Overnachtende caravan'),
          v2: p('Voor 2 personen per nacht'), v1: p('Voor 1 persoon per nacht'), week: p('1 week 2 personen (7 nachten)'), laken: p('Lakenset (verplicht)'),
        };
        const euro = (n: number) => '€ ' + n.toLocaleString('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const form = sectie.querySelector<HTMLFormElement>('[data-form]')!;
        const q = <E extends Element = HTMLElement>(s: string) => sectie.querySelector<E>(s)!;
        const grens: Record<string, [number, number]> = { personen: [1, 8], nachten: [1, 28], huisdieren: [0, 4], bezoekers: [0, 20], douches: [0, 60] };
        const w: Record<string, number> = { personen: 2, nachten: 3, huisdieren: 0, bezoekers: 0, douches: 0 };
        q('[data-rekenblok]').hidden = false;
        q('[data-js-tekst]').hidden = false;
        form.addEventListener('submit', (e) => e.preventDefault());

        const regel = (t: string, b: number) => `<li class="flex justify-between gap-4 border-b border-white/15 py-2"><span>${t}</span><span class="font-semibold whitespace-nowrap tabular-nums">${euro(b)}</span></li>`;
        const nacht = (n: number) => (n === 1 ? '1 nacht' : `${n} nachten`);

        const reken = () => {
          const soort = (form.querySelector<HTMLInputElement>('input[name=soort]:checked')!).value;
          const verblijf = soort === 'verblijf';
          grens.personen = verblijf ? [1, 2] : [1, 8];
          w.personen = Math.min(Math.max(w.personen, grens.personen[0]), grens.personen[1]);
          sectie.querySelectorAll<HTMLElement>('[data-alleen]').forEach((el) => (el.hidden = el.dataset.alleen !== soort));
          q('[data-hint-personen]').hidden = !verblijf;
          for (const k in w) {
            q(`[data-waarde=${k}]`).textContent = String(w[k]);
            q<HTMLButtonElement>(`[data-min=${k}]`).disabled = w[k] <= grens[k][0];
            q<HTMLButtonElement>(`[data-plus=${k}]`).disabled = w[k] >= grens[k][1];
          }
          const n = w.nachten, pers = w.personen;
          const regels: [string, number][] = [];
          let aanname = '';
          if (!verblijf) {
            const svr = (form.querySelector<HTMLInputElement>('input[name=svr]:checked')!).value === 'ja';
            const basis = pers === 1 ? (svr ? T.een : T.eenGeen) : (svr ? T.twee : T.tweeGeen);
            regels.push([`${pers === 1 ? '1 persoon' : '2 personen'}, ${svr ? 'SVR-lid' : 'geen SVR-lid'}: ${nacht(n)} × ${euro(basis)}`, basis * n]);
            if (pers > 2) regels.push([`${pers - 2} ${pers - 2 === 1 ? 'persoon' : 'personen'} meer: ${nacht(n)} × ${euro(T.meer)}`, (pers - 2) * T.meer * n]);
            if (form.tent.checked) regels.push([`Tent (klein): ${nacht(n)} × ${euro(T.tent)}`, T.tent * n]);
            if (form.caravan.checked) regels.push([`Overnachtende caravan: ${nacht(n)} × ${euro(T.caravan)}`, T.caravan * n]);
            if (w.huisdieren) regels.push([`${w.huisdieren} ${w.huisdieren === 1 ? 'huisdier' : 'huisdieren'}: ${n} ${n === 1 ? 'dag' : 'dagen'} × ${euro(T.huisdier)}`, w.huisdieren * T.huisdier * n]);
            if (w.bezoekers) regels.push([`${w.bezoekers} ${w.bezoekers === 1 ? 'bezoeker' : 'bezoekers'} × ${euro(T.bezoeker)}`, w.bezoekers * T.bezoeker]);
            if (w.douches) regels.push([`${w.douches} ${w.douches === 1 ? 'douchebeurt' : 'douchebeurten'} × ${euro(T.douche)}`, w.douches * T.douche]);
            aanname = 'Tent, caravan en huisdieren rekenen we per nacht. Toeristenbelasting zit al in de tarieven.';
          } else {
            if (pers === 2 && n >= 7) {
              const weken = Math.floor(n / 7), rest = n % 7;
              regels.push([`${weken} ${weken === 1 ? 'week' : 'weken'} (7 nachten) voor 2 personen × ${euro(T.week)}`, weken * T.week]);
              if (rest) regels.push([`${nacht(rest)} × ${euro(T.v2)}`, rest * T.v2]);
            } else {
              const prijs = pers === 1 ? T.v1 : T.v2;
              regels.push([`${pers === 1 ? '1 persoon' : '2 personen'}: ${nacht(n)} × ${euro(prijs)}`, prijs * n]);
            }
            regels.push([`Lakenset (verplicht): ${pers} × ${euro(T.laken)}`, pers * T.laken]);
            aanname = 'We rekenen één lakenset per persoon. Het weektarief geldt voor 2 personen en 7 nachten. Toeristenbelasting zit al in de tarieven.';
          }
          const totaal = regels.reduce((s, r) => s + r[1], 0);
          const wat = verblijf ? 'in het vakantieverblijf' : 'kamperen';
          q('[data-totaal]').textContent = euro(totaal);
          q('[data-mini]').textContent = euro(totaal);
          q('[data-samenvatting]').textContent = `${pers === 1 ? '1 persoon' : `${pers} personen`}, ${nacht(n)} ${wat}`;
          q('[data-regels]').innerHTML = regels.map((r) => regel(r[0], r[1])).join('');
          q('[data-aanname]').textContent = aanname;
          const body = `Beste Jan en Bertha,\n\nIk wil graag reserveren: ${pers === 1 ? '1 persoon' : `${pers} personen`}, ${nacht(n)} ${wat}.\n\n${regels.map((r) => `- ${r[0]}: ${euro(r[1])}`).join('\n')}\nIndicatie: ${euro(totaal)}\n\nAankomstdatum: \nNaam: \nTelefoon: \n`;
          q<HTMLAnchorElement>('[data-mail]').href = `mailto:info@stellophoeve.nl?subject=${encodeURIComponent('Reservering ' + (verblijf ? 'vakantieverblijf' : 'kampeerplaats'))}&body=${encodeURIComponent(body)}`;
        };
        sectie.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-min], button[data-plus]');
          if (!b) return;
          const k = b.dataset.min ?? b.dataset.plus!;
          w[k] = Math.min(Math.max(w[k] + (b.dataset.min ? -1 : 1), grens[k][0]), grens[k][1]);
          reken();
        });
        form.addEventListener('change', reken);
        reken();
      }
    </script>

    <!-- Samen: de zomeravond met barbecue, eigen foto's groot en verspringend. -->
    <section class="bg-linnen-2 py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4 lg:pt-8">
          <p class="kicker text-hout">Op de camping</p>
          <h2 class="mt-3 text-3xl">Een zomeravond op de Stellop Hoeve</h2>
          <p class="mt-6 text-lg">Een heerlijke barbecue, afgesloten met een prachtige zonsondergang.</p>
          <p class="mt-4 text-ink-soft">Verder op de camping: een feest-/recreatiezaal met o.a. tv, een jeu de boulesbaan en kippen.</p>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:col-span-8">
          <figure class="col-span-2 sm:col-span-1 sm:row-span-2">
            <div class="aspect-[3/4] overflow-hidden rounded-xl shadow-sm sm:h-full sm:aspect-auto"><Foto src={bbqTafel} alt="Gasten aan een lange gedekte tafel op het kampeerveld, glazen omhoog, met voortenten en bomen erachter" sizes="(min-width: 1024px) 250px, (min-width: 640px) 31vw, 100vw" /></div>
          </figure>
          <figure>
            <div class="aspect-[3/4] overflow-hidden rounded-xl shadow-sm"><Foto src={bbqGrill} alt="Een gast bij de barbecue op het grasveld, anderen zitten in de schaduw van de bomen" sizes="(min-width: 1024px) 250px, (min-width: 640px) 31vw, 50vw" /></div>
          </figure>
          <figure>
            <div class="aspect-[3/4] overflow-hidden rounded-xl shadow-sm"><Foto src={zon} alt="Zonsondergang boven de bomen, goudkleurige wolken" widths={[400, 828]} sizes="(min-width: 1024px) 250px, (min-width: 640px) 31vw, 50vw" /></div>
          </figure>
          <div class="donker col-span-2 flex flex-col justify-between gap-6 rounded-xl bg-bos p-6 text-white shadow-sm">
            <p class="font-display text-2xl leading-tight font-bold">Bij ons staat de koffie altijd klaar.</p>
            <p class="text-sm text-white/80">Foto's: een zomeravond activiteit op de Stellop Hoeve.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Omgeving: bosfoto naast de lijst met uitjes. -->
    <section id="omgeving" class="donker scroll-mt-20 bg-bos text-white">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[260px] lg:col-span-5 lg:min-h-full">
          <div class="absolute inset-0"><Foto src={bos} alt="Sfeerbeeld: een koepeltent tussen hoge dennen in een bos" sizes="(min-width: 1024px) 42vw, 100vw" /></div>
        </div>
        <div class="px-5 py-16 sm:px-8 lg:col-span-7 lg:px-14 lg:py-24">
          <p class="kicker text-oker">Omgeving</p>
          <h2 class="mt-3 text-3xl">Bossen, vennen en de Efteling dichtbij</h2>
          <p class="mt-6 max-w-2xl text-lg text-white/85">Op fietsafstand vindt u gezellige dorpen en prachtige natuurgebieden. Uitvalswegen naar de Efteling en de Beekse Bergen zijn dichtbij.</p>
          <ul class="mt-8 grid gap-x-8 sm:grid-cols-2">
            {omgeving.map((o) => <li class="flex gap-3 border-b border-white/15 py-2.5"><span class="text-oker"><Fragment set:html={blad} /></span><span class="min-w-0 [overflow-wrap:anywhere]">{o}</span></li>)}
          </ul>
          <p class="mt-8 rounded-xl border border-white/20 p-5 text-white/90">Fiets- en wandelroutes zijn te leen op onze camping, en er zijn fietsen te huur. Informatie over de weekmarkten krijgt u bij ons op de camping.</p>
        </div>
      </div>
    </section>

    <!-- Wist u dat: de herkomst van de naam, met de oude perceelnamen. -->
    <section class="wrap py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="kicker text-hout">Wist u dat</p>
          <h2 class="mt-3 text-3xl">Waar komt de naam Stellop Hoeve vandaan?</h2>
          <p class="mt-8 font-display text-getal leading-none font-extrabold tracking-[-0.04em] text-hout">Stéél-op-Hoeve</p>
          <p class="mt-6 text-lg">De hoeve die hier vroeger stond, heette de Stellop Hoeve, ook wel de Stéél-op-Hoeve genoemd. De boerderij was omzoomd door hoge populieren, en de takken groeiden schuin, rechtop langs de stam naar boven: steil omhoog, steel op.</p>
          <p class="mt-4 text-ink-soft">Om en nabij de plek waar Oirschotseweg 50 nu staat, was destijds de boerderij met de dubbele deur. Dat zou betrekking kunnen hebben op de gastvrijheid: de deuren open zetten voor de gasten.</p>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <figure>
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={oprit} alt="De weg langs de hoeve met hoge bomen, hagen, een houten bank en een bordje Mini Camping" widths={[400, 800]} sizes="(min-width: 1024px) 350px, 100vw" /></div>
            <figcaption class="mt-3 text-sm text-ink-soft">Langs de hoeve</figcaption>
          </figure>
          <h3 class="mt-8 text-lg">Oude perceelnamen rond de camping</h3>
          <p class="mt-2 text-sm text-ink-soft">Vroeger gaven boeren hun akkers en weilanden namen, om precies aan te geven waar geploegd, gezaaid of gemaaid moest worden.</p>
          <ul class="mt-4 flex flex-wrap gap-2 text-sm">
            {percelen.map((n) => <li class="rounded-full bg-linnen-2 px-3 py-1.5 font-semibold">{n}</li>)}
          </ul>
          <p class="mt-4 text-sm text-ink-soft">'Steek' is verwant aan stek, en voor vakantiegangers is het enorm belangrijk een goede stek gevonden te hebben.</p>
        </div>
      </div>
    </section>

    <!-- Contact: bellen, appen, mailen, en de route. -->
    <section id="contact" class="donker scroll-mt-20 bg-mos py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-varen">Contact</p>
          <h2 class="mt-3 text-3xl">Voor informatie en reserveringen</h2>
          <p class="mt-5 text-lg text-white/85">{site.eigenaren}. U bent van harte welkom.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={`mailto:${site.mail}`} class="btn btn-oker"><Fragment set:html={mail} />Mail ons</a>
            <a href={site.whatsapp} class="btn btn-line"><Fragment set:html={wa} />Stuur een WhatsApp</a>
          </div>
          <p class="mt-6 break-all"><a href={`mailto:${site.mail}`} class="underline decoration-oker decoration-2 underline-offset-4">{site.mail}</a></p>
          <address class="mt-8 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="mt-4 inline-block font-semibold underline decoration-oker decoration-2 underline-offset-4">Route op Google Maps</a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="text-xl">Bellen</h3>
          <ul class="mt-4 border-t border-white/20 text-lg">
            {[[site.tel, site.telHref], [site.mobiel1, site.mobiel1Href], [site.mobiel2, site.mobiel2Href]].map(([t, h]) => (
              <li class="border-b border-white/20"><a href={h} class="flex items-center justify-between gap-4 py-3 font-display font-bold no-underline transition-colors hover:text-varen"><span class="whitespace-nowrap tabular-nums">{t}</span><span class="text-sm font-normal text-white/80">Bel</span></a></li>
            ))}
          </ul>
          <h3 class="mt-10 text-xl">Seizoen</h3>
          <dl class="mt-4 border-t border-white/20">
            <div class="flex justify-between gap-4 border-b border-white/20 py-3"><dt>Kampeerseizoen</dt><dd class="text-right font-semibold">15 maart <span class="whitespace-nowrap">t/m 31 oktober</span></dd></div>
            <div class="flex justify-between gap-4 border-b border-white/20 py-3"><dt>Appartementen</dt><dd class="text-right font-semibold">het hele jaar</dd></div>
          </dl>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
