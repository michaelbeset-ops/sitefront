---
// Beeldmerk naar hun houten welkomstbord: een schuin gezaagde eiken plank, met de naam als wordmark.
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<span class="inline-flex items-center gap-2.5">
  <svg viewBox="0 0 44 28" class="h-7 w-11 flex-none max-[359px]:hidden" aria-hidden="true">
    <path d="M9 3.5 43 2 36 25.5 1 26.5z" fill="#c8923f" />
    <path d="M9 3.5 43 2 36 25.5 1 26.5z" fill="none" stroke={licht ? '#e0b066' : '#8a5a1c'} stroke-width="1.5" stroke-linejoin="round" />
    <path d="M9 10.5h24M7 15.5h25M5.5 20.5h22" stroke="#6b4414" stroke-width="2.2" stroke-linecap="round" />
  </svg>
  <span class={`font-display leading-none ${licht ? 'text-white' : 'text-ink'}`}>
    <span class={`block text-xs font-semibold tracking-[0.02em] ${licht ? 'text-oker' : 'text-hout'}`}>camping de</span>
    <span class="block text-base font-extrabold tracking-[-0.02em] whitespace-nowrap uppercase sm:text-lg">Stellop Hoeve</span>
  </span>
</span>
