---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Langskomen from '../components/Langskomen.astro';
import { site, dagen, waIcoon, telIcoon, instaIcoon } from '../data/site';
import terras from '../assets/terras-water.jpg';
import vitrine from '../assets/vitrine.jpg';
import theehuis from '../assets/theehuis.jpg';
import uitzicht from '../assets/uitzicht.jpg';
import water from '../assets/water.jpg';
import sconesThee from '../assets/scones-thee.jpg';
import sconeJam from '../assets/scone-jam.jpg';
import taart from '../assets/taart.jpg';

// Thema's uit de Google-reviews, met het aantal keer dat ze genoemd worden (waar bekend).
const populair = [
  { naam: 'Taart', keer: 38 },
  { naam: 'Scones', keer: 18 },
  { naam: 'Koekjes' },
  { naam: 'Thee en koffie' },
  { naam: 'Warme chocolademelk', keer: 3 },
  { naam: 'Vegan opties', keer: 2 },
];
const noemen = [
  'Een Engels theehuisje, gerund door een aardig paar',
  'Scones, taart en koekjes, met thee of koffie',
  'Buiten zitten met uitzicht op het water',
  'Midden in het park, fijn bij een wandeling',
  'Warme chocolademelk en vegan opties',
  'Kindvriendelijk',
];
---
<Base title={`${site.naam} | Engels theehuisje in het Prins Hendrikpark, 's-Hertogenbosch`} description="Bloem, Engels theehuisje aan het water in het Prins Hendrikpark in 's-Hertogenbosch. Scones, taart, thee en koffie. Woensdag t/m zondag 10.00 - 16.00.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative bg-pruim text-room">
      <div class="wrap grid gap-10 pb-10 pt-10 lg:grid-cols-12 lg:gap-8 lg:pb-12 lg:pt-14">
        <div class="lg:col-span-8">
          <p class="eyebrow text-roos">Prins Hendrikpark, <span class="whitespace-nowrap">'s-Hertogenbosch</span></p>
          <h1 class="mt-5 text-4xl">Engels theehuisje <em class="font-medium text-roos">aan het water</em></h1>
          <p class="mt-6 max-w-xl text-lg text-room/90">Scones, taart en koekjes, thee en koffie. Buiten zitten met uitzicht op het water, midden in het park.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.whatsapp} class="btn btn-wa"><Fragment set:html={waIcoon} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-room"><Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
        </div>
        <div class="hidden content-end gap-5 lg:col-span-4 lg:grid lg:grid-cols-1 lg:border-l lg:border-lijn-licht lg:pl-8">
          <dl class="grid grid-cols-2 gap-5 sm:col-span-2 lg:col-span-1">
            <div>
              <dt class="text-sm text-room/75">Google</dt>
              <dd class="mt-1 font-display text-3xl font-semibold leading-none">{site.google.score} <span class="mt-1 block font-body text-sm font-normal text-room/75">({site.google.aantal} reviews)</span></dd>
            </div>
            <div>
              <dt class="text-sm text-room/75">Wo t/m zo</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-2xl font-semibold leading-none tabular-nums lg:text-xl">10.00 - 16.00</dd>
            </div>
          </dl>
          <!-- Open vandaag? -->
          <div class="status rounded-xl bg-pruim-2 p-5 shadow-sm ring-1 ring-lijn-licht sm:col-span-2 lg:col-span-1" data-status="basis">
            <p class="eyebrow flex items-center gap-2 text-roos"><span class="stip h-2 w-2 rounded-full bg-roos" aria-hidden="true"></span><span data-kort>Open vandaag?</span></p>
            <div aria-live="polite">
              <p class="mt-1.5 font-display text-xl font-semibold leading-snug" data-tekst>Woensdag t/m zondag van 10.00 tot 16.00.</p>
              <p class="text-sm text-room/80" data-verder>Maandag en dinsdag gesloten.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="relative">
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-room" aria-hidden="true"></div>
        <div class="wrap relative">
          <figure class="relative overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[4/3] sm:aspect-[16/8]">
              <Foto src={vitrine} alt="De vitrine van Bloem: scones met crème fraîche en jam, cake, plaatkoek en grote koekjes op glazen etagères" class="object-[35%_center]" hero sizes="(min-width: 1200px) 1150px, 100vw" />
            </div>
            <figcaption class="absolute bottom-4 left-4 rounded-full bg-pruim/85 px-3.5 py-1.5 text-xs font-medium text-room backdrop-blur-sm">De vitrine bij Bloem</figcaption>
          </figure>
        </div>
      </div>
      <div class="licht bg-room lg:hidden">
          <div class="wrap grid gap-5 pt-6 sm:grid-cols-2">
            <dl class="grid grid-cols-2 gap-5">
              <div><dt class="text-sm text-inkt-zacht">Google</dt><dd class="mt-1 font-display text-3xl font-semibold leading-none">{site.google.score} <span class="mt-1 block font-body text-sm font-normal text-inkt-zacht">({site.google.aantal} reviews)</span></dd></div>
              <div><dt class="text-sm text-inkt-zacht">Wo t/m zo</dt><dd class="mt-1 whitespace-nowrap font-display text-2xl font-semibold leading-none tabular-nums">10.00 - 16.00</dd></div>
            </dl>
          <!-- Open vandaag? (mobiel) -->
          <div class="status rounded-xl bg-pruim-2 p-5 shadow-sm ring-1 ring-lijn-licht text-room" data-status="basis">
            <p class="eyebrow flex items-center gap-2 text-roos"><span class="stip h-2 w-2 rounded-full bg-roos" aria-hidden="true"></span><span data-kort>Open vandaag?</span></p>
            <div aria-live="polite">
              <p class="mt-1.5 font-display text-xl font-semibold leading-snug" data-tekst>Woensdag t/m zondag van 10.00 tot 16.00.</p>
              <p class="text-sm text-room/80" data-verder>Maandag en dinsdag gesloten.</p>
            </div>
          </div>
          </div>
      </div>
    </section>

    <!-- POPULAIR BIJ GASTEN -->
    <section id="populair" class="licht scroll-mt-16 bg-room pb-16 pt-16 lg:pb-24 lg:pt-28" aria-labelledby="popkop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow text-salie">Populair bij gasten</p>
          <h2 id="popkop" class="mt-3 text-3xl">Scones, taart <em class="font-medium text-framboos">en thee</em></h2>
          <p class="mt-5 max-w-md text-inkt-zacht">Wat gasten in hun Google-reviews het vaakst noemen.</p>
          <ol class="mt-8 divide-y divide-lijn border-y border-lijn">
            {populair.map((p, i) => (
              <li class="flex flex-wrap items-baseline gap-x-4 py-3.5">
                <span class="w-7 font-display text-lg italic text-framboos">{String(i + 1).padStart(2, '0')}</span>
                <span class="min-w-0 font-display text-2xl font-semibold">{p.naam}</span>
                {p.keer && <span class="ml-auto whitespace-nowrap text-sm tabular-nums text-inkt-zacht">{p.keer}x genoemd</span>}
              </li>
            ))}
          </ol>
          <p class="mt-5 text-xs text-inkt-zacht">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
        </div>
        <div class="grid grid-cols-2 gap-4 lg:col-span-7 lg:gap-5">
          <figure class="col-span-2 overflow-hidden rounded-2xl shadow-sm">
            <div class="aspect-[3/2]"><Foto src={sconesThee} alt="Sfeerbeeld: een scone met amandelschaafsel, jam en boter naast een kop thee in bloemetjesservies" class="object-[center_60%]" sizes="(min-width: 1024px) 700px, 100vw" /></div>
          </figure>
          <figure class="overflow-hidden rounded-2xl shadow-sm">
            <div class="aspect-[4/5]"><Foto src={taart} alt="Sfeerbeeld: een punt gelaagde taart op een wit bordje naast een kop koffie" class="object-[70%_center]" sizes="(min-width: 1024px) 340px, 50vw" /></div>
          </figure>
          <figure class="overflow-hidden rounded-2xl shadow-sm">
            <div class="aspect-[4/5]"><Foto src={sconeJam} alt="Sfeerbeeld: een opengesneden scone met rozijnen en rode jam" class="object-[40%_center]" sizes="(min-width: 1024px) 340px, 50vw" /></div>
          </figure>
        </div>
      </div>
    </section>

    <!-- HET PARK EN HET WATER -->
    <section id="park" class="scroll-mt-16 bg-pruim-2 py-16 text-room lg:py-24" aria-labelledby="parkkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <p class="eyebrow text-roos">Aan het water</p>
          <h2 id="parkkop" class="mt-3 text-3xl">In het Prins Hendrikpark</h2>
        </div>
        <p class="text-lg text-room/90 lg:col-span-6">Buiten zitten met uitzicht op het water, in het park. Een fijne plek tijdens een wandeling, en ook met kinderen.</p>
      </div>
      <div class="wrap mt-10 grid gap-4 md:grid-cols-12 md:gap-5 lg:mt-14">
        <figure class="relative overflow-hidden rounded-2xl md:col-span-7 md:row-span-2">
          <div class="aspect-[4/3] h-full md:aspect-auto"><Foto src={terras} alt="Ligstoelen op het gras bij Bloem, met daarachter het water en het park" sizes="(min-width: 768px) 60vw, 100vw" /></div>
          <figcaption class="absolute bottom-4 left-4 rounded-full bg-pruim/85 px-3.5 py-1.5 text-xs font-medium text-room backdrop-blur-sm">Ligstoelen aan het water</figcaption>
        </figure>
        <figure class="relative overflow-hidden rounded-2xl md:col-span-5">
          <div class="aspect-[3/2]"><Foto src={theehuis} alt="Het theehuisje van Bloem tussen de bomen, met ligstoelen op het gras ervoor" class="object-[center_58%]" sizes="(min-width: 768px) 40vw, 100vw" /></div>
          <figcaption class="absolute bottom-4 left-4 rounded-full bg-pruim/85 px-3.5 py-1.5 text-xs font-medium text-room backdrop-blur-sm">Het theehuisje</figcaption>
        </figure>
        <figure class="relative overflow-hidden rounded-2xl md:col-span-5">
          <div class="aspect-[3/2]"><Foto src={uitzicht} alt="Binnen bij Bloem: tafeltjes bij de ramen, met uitzicht over het park en het water" sizes="(min-width: 768px) 40vw, 100vw" /></div>
          <figcaption class="absolute bottom-4 left-4 rounded-full bg-pruim/85 px-3.5 py-1.5 text-xs font-medium text-room backdrop-blur-sm">Binnen, met uitzicht</figcaption>
        </figure>
      </div>
    </section>

    <!-- WAT GASTEN NOEMEN -->
    <section class="licht bg-blos py-16 lg:py-24" aria-labelledby="noemkop">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-salie">Wat gasten noemen</p>
          <h2 id="noemkop" class="mt-3 text-3xl">{site.google.score} op Google</h2>
          <p class="mt-3 text-inkt-zacht">Uit {site.google.aantal} reviews, samengevat.</p>
          <ul class="mt-6 flex flex-wrap gap-2 text-sm">
            <li class="rounded-full bg-room px-3.5 py-1.5 font-medium shadow-sm ring-1 ring-lijn">Gerund door een vrouwelijke ondernemer</li>
            <li class="rounded-full bg-room px-3.5 py-1.5 font-medium shadow-sm ring-1 ring-lijn">LGBTQ+ vriendelijk</li>
          </ul>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-xl bg-lijn shadow-sm ring-1 ring-lijn sm:grid-cols-2 lg:col-span-8">
          {noemen.map((n) => (
            <li class="flex gap-3 bg-room p-5 sm:p-6">
              <svg aria-hidden="true" viewBox="0 0 32 32" class="mt-0.5 h-5 w-5 shrink-0 text-framboos"><g fill="currentColor">{[0, 72, 144, 216, 288].map((r) => <ellipse cx="16" cy="8.6" rx="4.6" ry="6.4" transform={`rotate(${r} 16 16)`} />)}</g><circle cx="16" cy="16" r="3.4" fill="#fcf7f2" /></svg>
              <span class="text-lg leading-snug">{n}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- LANGSKOMEN (WOW) -->
    <section id="langskomen" class="scroll-mt-16 bg-pruim py-16 text-room lg:py-24" aria-labelledby="langskop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-roos">Langskomen</p>
          <h2 id="langskop" class="mt-3 text-3xl">Kom je <em class="font-medium text-roos">(met een groep)</em> langs?</h2>
          <p class="mt-5 text-room/90">Kies een dag, het aantal personen en waar je zin in hebt. Je krijgt een kant-en-klaar WhatsApp-bericht aan Bloem.</p>
          <figure class="mt-10 hidden overflow-hidden rounded-2xl lg:block">
            <div class="aspect-[4/3]"><Foto src={water} alt="Het water in het Prins Hendrikpark onder een wolkenlucht, met bomen aan de overkant" sizes="420px" /></div>
          </figure>
        </div>
        <div class="lg:col-span-7">
          <Langskomen />
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="licht scroll-mt-16 bg-room py-16 lg:py-24" aria-labelledby="contactkop">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-salie">Route en contact</p>
          <h2 id="contactkop" class="mt-3 text-3xl">Midden in het Prins Hendrikpark</h2>
          <address class="mt-6 not-italic text-lg">
            <strong class="font-display text-2xl font-semibold">{site.naam}</strong><br />
            {site.straat}<br />{site.postcode} {site.plaats}
          </address>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.whatsapp} class="btn btn-wa"><Fragment set:html={waIcoon} />WhatsApp</a>
            <a href={site.telHref} class="btn btn-framboos"><Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            <a href={site.maps} rel="noopener" class="btn btn-lijn-licht text-inkt">Route plannen</a>
          </div>
          <a href={site.instagram} rel="noopener" class="mt-8 inline-flex items-center gap-3 rounded-xl bg-blos px-4 py-3 no-underline shadow-sm ring-1 ring-lijn transition-shadow hover:shadow-md">
            <span class="h-6 w-6 text-framboos"><Fragment set:html={instaIcoon} /></span>
            <span><span class="block text-xs text-inkt-zacht">Volg Bloem op Instagram</span><span class="font-semibold">{site.insta}</span></span>
          </a>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-lijn sm:p-8">
            <h3 class="text-2xl">Openingstijden</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden per dag</caption>
              <tbody>
                {dagen.map((d) => (
                  <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                    <th scope="row" class="py-3 font-medium">{d.dag}</th>
                    <td class={`whitespace-nowrap py-3 text-right tabular-nums ${d.tijd === 'Gesloten' ? 'text-inkt-zacht' : 'font-semibold'}`}>{d.tijd}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-framboos); }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
  .status[data-status='open'] .stip { animation: gloed 2.4s ease-in-out infinite; }
  .status[data-status='dicht'] .stip { background: var(--color-room); opacity: .55; }
  @keyframes gloed { 50% { box-shadow: 0 0 0 5px #f2b8c640; } }
</style>
<script>
  import { nuInDenBosch, isOpen, plusDag, vanYmd, OPEN_VAN, OPEN_TOT } from '../scripts/open';
  const DAG = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
  const nu = nuInDenBosch();
  document.querySelector(`.dagrij[data-wd="${nu.dag.wd}"]`)?.classList.add('vandaag');

  // Open vandaag?
  document.querySelectorAll<HTMLElement>('.status').forEach((el) => {
    let t = nu.dag.ymd;
    const volgende = () => { do { t = plusDag(t); } while (!isOpen(vanYmd(t))); const d = vanYmd(t); return t === plusDag(nu.dag.ymd) ? 'morgen' : DAG[d.wd]; };
    let r: string[];
    if (isOpen(nu.dag) && nu.min >= OPEN_VAN && nu.min < OPEN_TOT) r = ['open', 'Nu open', 'Vandaag open tot 16.00 uur.', 'Woensdag t/m zondag 10.00 - 16.00.'];
    else if (isOpen(nu.dag) && nu.min < OPEN_VAN) r = ['dicht', 'Vandaag open', 'Vandaag open van 10.00 tot 16.00 uur.', 'Maandag en dinsdag gesloten.'];
    else if (isOpen(nu.dag)) r = ['dicht', 'Voor vandaag gesloten', `Weer open ${volgende()} vanaf 10.00 uur.`, 'Woensdag t/m zondag 10.00 - 16.00.'];
    else r = ['dicht', 'Vandaag gesloten', `Weer open ${volgende()} vanaf 10.00 uur.`, 'Maandag en dinsdag gesloten.'];
    el.dataset.status = r[0];
    el.querySelector('[data-kort]')!.textContent = r[1];
    el.querySelector('[data-tekst]')!.textContent = r[2];
    el.querySelector('[data-verder]')!.textContent = r[3];
  });
</script>
