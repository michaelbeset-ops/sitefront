---
// Woordmerk: "Bloem" cursief in Cormorant met een klein vijfbladig bloemetje. Geen bestaand logo bekend
// (alleen Instagram), dus typografisch opgebouwd.
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
---
<span class={`inline-flex items-center gap-2 ${cls}`}>
  <svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7 shrink-0">
    <g class={licht ? 'text-framboos' : 'text-roos'} fill="currentColor">
      {[0, 72, 144, 216, 288].map((r) => <ellipse cx="16" cy="8.6" rx="4.6" ry="6.4" transform={`rotate(${r} 16 16)`} opacity="0.9" />)}
    </g>
    <circle cx="16" cy="16" r="3.4" class={licht ? 'text-salie' : 'text-roos-zacht'} fill="currentColor" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="whitespace-nowrap font-display text-[1.9rem] font-semibold italic leading-[0.8] tracking-[-0.01em]">Bloem</span>
    <span class={`mt-1 text-[0.625rem] font-medium uppercase tracking-[0.26em] ${licht ? 'text-inkt-zacht' : 'text-roos-zacht'}`}>Engels theehuisje</span>
  </span>
</span>
