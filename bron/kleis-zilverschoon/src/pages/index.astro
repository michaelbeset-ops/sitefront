---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site } from '../data/site';
import hero from '../assets/hero.jpg';
import winkel from '../assets/winkel.jpg';
import lamp from '../assets/lamp.jpg';
const tijden = [['Maandag t/m donderdag', '09.00 tot 17.30'], ['Vrijdag', '09.00 tot 20.00'], ['Zaterdag', '09.00 tot 17.00'], ['Zondag', 'Gesloten']];
const tijdlijn = [
  ['1934', 'Kleis Zilverschoon begint als elektromonteur, vanuit huis. Het bedrijf blijft bestaan tijdens de oorlog.'],
  ['Na de oorlog', 'Met zijn vrouw Johanna opent hij een winkel aan het Weverseinde: huishoudelijke apparaten, verlichting, grammofoonplaten, radio en televisie.'],
  ['1965', 'Verhuizing naar het veel grotere pand in het winkelcentrum van Puttershoek. Dochter Tineke helpt in de winkel, zoon Willem in het elektrische werk.'],
  ['Rond 1970', 'De naam wordt Firma Kleis Zilverschoon. Met Willems vrouw Nel komen luxe geschenken en woondecoraties in het assortiment.'],
  ['Nu', 'De derde generatie, Kleis Zilverschoon jr. en Nancy Zilverschoon-Bezuijen, zet het familiebedrijf vol enthousiasme voort.'],
];
const winkelGroepen = [
  ['Witgoed', 'Bosch, Miele, AEG, Samsung, Siemens, Zanussi en Whirlpool. Voor elk budget, met weloverwogen advies.'],
  ['Verlichting', 'Van werklicht tot sfeerlicht. We denken mee over een verlichtingsplan voor elke ruimte.'],
  ['Woondecoratie', 'Riverdale, Countryfield en Scentchips, en regelmatig iets nieuws van de beurzen.'],
  ['Huishoudelijk', 'Philips, Tefal en Inventum, en luxe merken als Kenwood, Russell Hobbs en Cuisinart.'],
  ['Televisie en audio', 'De nieuwste snufjes of juist iets eenvoudigs: advies dat bij u past.'],
  ['Zilverschoontje', 'Babykleding en kado’s in maat 50 tot en met 86, van onder meer Feetje, Z8 Newborn en BAM BAM.'],
];
---
<Base
  title="Fa. Kleis Zilverschoon | Elektrotechnisch installateur en winkel in Puttershoek"
  description="Sinds 1934 een familiebedrijf in Puttershoek: elektrotechnische installaties voor bedrijven en particulieren, en een winkel voor witgoed, verlichting, woondecoratie en babykleding."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="relative overflow-hidden bg-plum pb-16 pt-12 text-white lg:pb-28 lg:pt-24">
      <div class="absolute inset-0 lg:left-[40%]"><Foto src={winkel} alt="Warm verlichte lampen en decoratie in een winkel" hero sizes="100vw" class="opacity-40 lg:opacity-85" /></div>
      <div aria-hidden="true" class="absolute inset-0 bg-plum/70 lg:bg-transparent lg:bg-gradient-to-r lg:from-plum lg:via-plum/85 lg:to-transparent"></div>
      <div class="wrap relative grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="font-display text-[4.5rem] font-extrabold leading-none tracking-[-0.04em] text-amber">1934</p>
          <h1 class="mt-4 text-4xl">Stroom, licht en huisraad in Puttershoek</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">
            Al drie generaties het vertrouwde adres voor elektrotechnische installaties, en voor een winkel vol witgoed,
            verlichting en woondecoratie in het winkelcentrum van Puttershoek.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#installatie" class="btn btn-amber">Installatie of offerte</a>
            <a href="#winkel" class="btn btn-line">Naar de winkel</a>
          </div>
        </div>
        <aside aria-labelledby="open" class="self-end rounded-md bg-plum/90 p-6 ring-1 ring-white/10 backdrop-blur-sm lg:col-span-4 lg:col-start-9">
          <h2 id="open" class="text-2xl">Winkel open</h2>
          <dl class="mt-4 space-y-2">
            {tijden.map(([d, t]) => <div class="flex justify-between gap-4 border-b border-white/10 pb-2"><dt>{d}</dt><dd class={`whitespace-nowrap tabular-nums ${t === 'Gesloten' ? 'text-white/55' : ''}`}>{t}</dd></div>)}
          </dl>
          <p class="mt-3 text-sm text-amber">Vrijdag koopavond tot 20.00 uur</p>
        </aside>
      </div>
    </section>

    <section id="installatie" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="aspect-[4/3] overflow-hidden rounded-md lg:col-span-5"><Foto src={hero} alt="Installateur werkt aan een elektrakast" sizes="(min-width: 1024px) 460px, 100vw" /></div>
      <div class="self-center lg:col-span-6 lg:col-start-7">
        <h2 class="text-3xl">Elektrotechnisch installateur</h2>
        <p class="mt-5 text-lg">
          Wij leggen elektrotechnische installaties aan, in de ruimste zin van het woord, voor bedrijven, instellingen en particulieren.
          Met vakbekwaam personeel, waarbij ieder teamlid zijn eigen specialisatie heeft.
        </p>
        <p class="mt-4">We werken in de Hoeksche Waard, Rotterdam en omstreken.</p>
        <p class="mt-4 text-sm text-ink-soft">[[AANLEVEREN: de belangrijkste soorten werk, bijvoorbeeld groepenkasten, laadpalen of zonnepanelen]]</p>
        <a href={site.telHref} class="btn btn-plum mt-8">Vraag een offerte: {site.tel}</a>
      </div>
    </section>

    <section id="winkel" class="scroll-mt-20 bg-cream py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
          <h2 class="text-3xl lg:col-span-6">Een sfeervolle winkel, vol met van alles</h2>
          <p class="text-lg lg:col-span-5 lg:col-start-8">Van woondecoratie tot de meest innovatieve producten op elektrisch gebied. Onze medewerksters adviseren u graag.</p>
        </div>
        <div class="mt-12 grid gap-10 lg:grid-cols-12">
          <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-8">
            {winkelGroepen.map(([k, t]) => <div class="border-t-2 border-amber-deep pt-3"><dt class="font-display text-xl font-bold">{k}</dt><dd class="mt-1 text-ink-soft">{t}</dd></div>)}
          </dl>
          <div class="aspect-[3/4] overflow-hidden rounded-md lg:col-span-4"><Foto src={lamp} alt="Tafellamp met warm licht in een houten interieur" sizes="(min-width: 1024px) 360px, 100vw" /></div>
        </div>
      </div>
    </section>

    <section id="geschiedenis" class="wrap scroll-mt-20 py-16 lg:py-24">
      <h2 class="max-w-2xl text-3xl">Een echt familiebedrijf, al drie generaties</h2>
      <ol class="mt-12 grid gap-8 md:grid-cols-5">
        {tijdlijn.map(([j, t]) => (
          <li class="border-t-4 border-plum pt-4">
            <p class="font-display text-2xl font-extrabold text-amber-deep">{j}</p>
            <p class="mt-2 text-sm">{t}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="contact" class="scroll-mt-20 bg-plum py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">In het winkelcentrum van Puttershoek</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
        </div>
        <dl class="grid content-start gap-4 text-lg lg:col-span-6 lg:col-start-7">
          <div><dt class="text-sm text-white/70">Telefoon</dt><dd><a href={site.telHref} class="font-display text-3xl font-extrabold underline decoration-amber decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-white/70">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="underline decoration-amber decoration-2 underline-offset-4">{site.mail}</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
