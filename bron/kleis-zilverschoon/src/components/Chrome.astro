---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 bg-plum text-white">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="no-underline"><span class="font-display text-xl font-extrabold tracking-[-0.03em]">Kleis Zilverschoon</span><span class="ml-2 hidden text-sm text-amber sm:inline">sinds 1934</span></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-bold">
          <li><a href="#installatie" class="no-underline hover:text-amber">Installatie</a></li>
          <li><a href="#winkel" class="no-underline hover:text-amber">Winkel</a></li>
          <li><a href="#geschiedenis" class="no-underline hover:text-amber">Sinds 1934</a></li>
          <li><a href="#contact" class="no-underline hover:text-amber">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-amber !px-3.5 !py-2 text-sm">Bel</a>
    </div>
  </header>
) : (
  <footer class="bg-plum py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
