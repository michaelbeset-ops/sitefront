---
import '../styles/global.css';
import kopFont from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import { site, url, tijden } from '../data/site';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
// Openingstijden voor het live open/dicht-label: [dag] = [open, dicht] in minuten.
const minuten = Object.fromEntries(tijden.map((t) => [t.dag, t.open ? [t.open, t.dicht].map((s) => { const [h, m] = s.split('.').map(Number); return h * 60 + m; }) : null]));
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#17191b" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={kopFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansFont} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-[4.5rem] md:pb-0">
    {site.voorstel && (
      <div class="bg-merk text-inkt">
        <p class="wrap py-2 text-xs leading-snug">Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website. <a href="https://www.sitefront.nl" class="font-bold underline underline-offset-2">sitefront.nl</a></p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-wit focus:px-4 focus:py-2">Naar de inhoud</a>
    <slot />
    <script define:vars={{ minuten }}>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.rijs').forEach((el) => io.observe(el));

      // Vandaag markeren en live open/dicht tonen (Nederlandse tijd).
      const nu = new Date();
      const deel = (o) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', ...o }).format(nu);
      const dag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(deel({ weekday: 'short' }));
      const min = Number(deel({ hour: '2-digit', hourCycle: 'h23' })) * 60 + Number(deel({ minute: '2-digit' }));
      const fmt = (m) => `${Math.floor(m / 60)}.${String(m % 60).padStart(2, '0')}`;
      const namen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
      const v = minuten[dag];
      const open = !!v && min >= v[0] && min < v[1];
      let tekst;
      if (open) tekst = `Nu open, tot ${fmt(v[1])} uur`;
      else if (v && min < v[0]) tekst = `Gesloten, vandaag open vanaf ${fmt(v[0])} uur`;
      else { let d = (dag + 1) % 7; while (!minuten[d]) d = (d + 1) % 7; tekst = `Gesloten, ${d === (dag + 1) % 7 ? 'morgen' : namen[d]} open vanaf ${fmt(minuten[d][0])} uur`; }
      document.querySelectorAll('[data-status]').forEach((el) => { el.textContent = tekst; el.closest('[data-status-wrap]')?.setAttribute('data-open', String(open)); });
      document.querySelectorAll(`[data-dag="${dag}"]`).forEach((r) => r.setAttribute('data-vandaag', ''));
    </script>
  </body>
</html>
