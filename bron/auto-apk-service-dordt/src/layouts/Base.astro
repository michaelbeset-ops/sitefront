---
import '../styles/global.css';
// Voorladen voorkomt dat de grote kop verspringt als het font binnenkomt (CLS).
import display from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import body from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;
const og = new URL(u('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {voorstel && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content="nl_NL" />
  <meta name="theme-color" content="#17191b" />
  {[display, body].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('sitemap-index.xml')} />
  {!voorstel && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'AutoRepair',
      name: 'Auto APK Service Dordt',
      telephone: '+31786172011',
      email: 'apkdordt@hotmail.com',
      address: { '@type': 'PostalAddress', streetAddress: 'Planckstraat 88', postalCode: '3316 GS', addressLocality: 'Dordrecht', addressCountry: 'NL' },
      openingHours: 'Mo-Fr 08:00-17:00',
    })} />
  )}
</head>
<body>
  <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-accent text-ink px-4 py-2">Naar de inhoud</a>
  {voorstel && (
    <div class="bg-accent text-ink text-xs">
      <p class="mx-auto max-w-[84rem] px-4 sm:px-8 py-2">
        Ontwerpvoorstel van <a class="underline font-semibold" href="https://www.sitefront.nl">Sitefront</a> voor Auto APK Service Dordt. Dit is niet de officiële website.
      </p>
    </div>
  )}

  <header class="sticky top-0 z-30 bg-night text-paper">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 h-16 sm:h-[4.5rem] flex items-center justify-between gap-4">
      <a href={u()} class="leading-none">
        <span class="display text-[1.55rem] sm:text-[1.9rem]">APK <span class="text-accent">Dordt</span></span>
      </a>
      <nav aria-label="Hoofdmenu" class="flex items-center gap-7 text-sm">
        <a class="hidden lg:inline hover:text-accent" href={u('#werk')}>APK &amp; onderhoud</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#occasions')}>Occasions</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#tijden')}>Openingstijden</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#afspraak')}>Afspraak</a>
        <a href="tel:+31786172011" class="inline-flex items-center gap-2 bg-accent text-ink font-semibold px-3 sm:px-4 py-2 hover:bg-accent-deep transition-colors">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>
          <span class="whitespace-nowrap">078 617 20 11</span>
        </a>
      </nav>
    </div>
  </header>

  <main id="inhoud">
    <slot />
  </main>

  <footer class="bg-night text-paper">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 pt-16 pb-10 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="display text-[2.6rem]">Auto APK<br /><span class="text-accent">Service Dordt</span></p>
        <p class="mt-5 max-w-sm text-sm text-night-soft">APK, onderhoud, reparatie en occasions. Aan de Planckstraat op bedrijventerrein Dordtse Kil.</p>
      </div>
      <div class="md:col-span-4 text-sm leading-7">
        <p>Planckstraat 88<br />3316 GS Dordrecht</p>
        <p class="mt-3">
          <a class="hover:underline" href="tel:+31786172011">078 617 20 11</a><br />
          <a class="hover:underline" href="tel:+31682128337">06 82 12 83 37</a><br />
          <a class="hover:underline break-all" href="mailto:apkdordt@hotmail.com">apkdordt@hotmail.com</a>
        </p>
      </div>
      <div class="md:col-span-3 text-sm leading-7">
        <p>Ma t/m vr 08:00 tot 17:00</p>
        <p class="text-night-soft">Za en zo gesloten</p>
        <p class="mt-3"><a class="hover:underline" href={u('privacy/')}>Privacyverklaring</a></p>
        <p class="text-night-soft">KvK [[AANLEVEREN: KvK-nummer]]</p>
      </div>
    </div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 pb-8">
      <p class="border-t border-ink-soft pt-6 text-xs text-night-soft">© {new Date().getFullYear()} Auto APK Service Dordt</p>
    </div>
  </footer>
</body>
</html>
