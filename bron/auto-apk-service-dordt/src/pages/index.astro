  .plaat { display: flex; align-items: stretch; max-width: 24rem; height: 5rem; border-radius: 8px; background: var(--color-merk); box-shadow: inset 0 0 0 3px var(--color-inkt), 0 0 0 3px var(--color-merk); overflow: hidden; }
