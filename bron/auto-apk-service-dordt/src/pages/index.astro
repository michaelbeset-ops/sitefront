  .keuze span { display: inline-flex; align-items: center; min-height: 2.6rem; padding: 0 1rem; border-radius: 6px; background: var(--color-nacht); box-shadow: inset 0 0 0 1px var(--color-lijn-licht); font-size: .9375rem; font-weight: 600; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #2d3136; }
