  .plaat input { flex: 1; min-width: 0; width: 100%; border: 0; background: transparent; color: var(--color-inkt); font-family: var(--font-kop); font-weight: 900; font-size: 2.9rem; letter-spacing: .08em; text-align: center; text-transform: uppercase; padding: 0 .75rem; }
  .plaat input::placeholder { color: #17191b55; }
  .plaat input:focus-visible { outline: none; }
