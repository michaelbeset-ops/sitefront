---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;

const marktplaats = 'https://www.marktplaats.nl/u/autobedrijf-dordt/3632887/';
const route = 'https://www.google.com/maps/dir/?api=1&destination=Planckstraat+88+3316+GS+Dordrecht';

const tijden = [
  ['Maandag', '08:00 – 17:00'],
  ['Dinsdag', '08:00 – 17:00'],
  ['Woensdag', '08:00 – 17:00'],
  ['Donderdag', '08:00 – 17:00'],
  ['Vrijdag', '08:00 – 17:00'],
  ['Zaterdag', 'Gesloten'],
  ['Zondag', 'Gesloten'],
];
---
<Base
  title="Auto APK Service Dordt | APK en onderhoud, Planckstraat Dordrecht"
  description="APK-keuring, onderhoud, reparatie en occasions aan de Planckstraat 88 in Dordrecht. Ma t/m vr 08:00 tot 17:00. Bel 078 617 20 11."
>
  <!-- Hero: schermvullende foto, tekst linksonder. De kop staat op een donkere verloop-laag zodat hij op elke foto leesbaar blijft. -->
  <section class="relative isolate bg-night text-paper">
    <div class="absolute inset-0 -z-10 [&_img]:h-full [&_img]:w-full [&_img]:object-cover">
      <Foto naam="hero" alt="Werkplaats met auto's op de brug" sizes="100vw" eager />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(23_25_27/0.92)_10%,rgb(23_25_27/0.55)_55%,rgb(23_25_27/0.15))]"></div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 min-h-[34rem] sm:min-h-[40rem] lg:min-h-[44rem] flex flex-col justify-end pt-20 pb-12 sm:pb-16">
      <p class="text-sm font-semibold tracking-[0.12em] uppercase text-accent">Planckstraat 88 · Dordtse Kil</p>
      <h1 class="mt-4 text-4xl max-w-[15ch]">APK en onderhoud aan de Planckstraat</h1>
      <p class="mt-6 max-w-xl text-lg text-paper/90">Garage op bedrijventerrein Dordtse Kil in Dordrecht. Voor uw APK, een onderhoudsbeurt of een reparatie. En wie een occasion zoekt, kan hier ook terecht.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="tel:+31786172011" class="inline-flex items-center gap-2 bg-accent text-ink font-semibold px-5 py-3 hover:bg-accent-deep transition-colors">Bel voor een afspraak</a>
        <a href={u('#afspraak')} class="inline-flex items-center gap-2 border border-paper/70 px-5 py-3 hover:bg-paper hover:text-ink transition-colors">Afspraak aanvragen</a>
      </div>
      <p class="mt-8 text-sm text-paper/80">
        <span class="font-semibold text-paper">4,5 op Google</span> uit 66 reviews <span aria-hidden="true">·</span> 4,9 uit 25 ervaringen op Marktplaats
      </p>
    </div>
  </section>

  <!-- Wat we doen: genummerde lijst in plaats van drie kaartjes. -->
  <section id="werk" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="text-3xl">Wat we<br />voor u doen</h2>
      <p class="mt-5 text-ink-soft max-w-sm">Bel, mail of vraag hieronder een afspraak aan.</p>
    </div>
    <ol class="lg:col-span-8 border-t-2 border-ink">
      <li class="grid grid-cols-[3.5rem_1fr] sm:grid-cols-[5rem_1fr] gap-4 py-8 border-b border-line">
        <span class="display text-2xl text-ink-soft">01</span>
        <div>
          <h3 class="text-2xl">APK-keuring</h3>
          <p class="mt-3 text-ink-soft max-w-2xl">Laat uw auto keuren aan de Planckstraat. Maak vooraf even een afspraak.</p>
          <p class="mt-2 text-sm text-ink-soft">[[AANLEVEREN: prijs APK en welke voertuigen (benzine, diesel, bedrijfswagens)]]</p>
        </div>
      </li>
      <li class="grid grid-cols-[3.5rem_1fr] sm:grid-cols-[5rem_1fr] gap-4 py-8 border-b border-line">
        <span class="display text-2xl text-ink-soft">02</span>
        <div>
          <h3 class="text-2xl">Onderhoud en reparatie</h3>
          <p class="mt-3 text-ink-soft max-w-2xl">Een onderhoudsbeurt, een reparatie of een storing die u niet vertrouwt. Breng hem langs, dan kijken we ernaar.</p>
          <p class="mt-2 text-sm text-ink-soft">[[AANLEVEREN: vaste werkzaamheden en eventuele specialisaties of merken]]</p>
        </div>
      </li>
      <li class="grid grid-cols-[3.5rem_1fr] sm:grid-cols-[5rem_1fr] gap-4 py-8 border-b border-line">
        <span class="display text-2xl text-ink-soft">03</span>
        <div>
          <h3 class="text-2xl">Occasions</h3>
          <p class="mt-3 text-ink-soft max-w-2xl">Gebruikte auto's te koop. We verkopen al 21 jaar via Marktplaats.</p>
          <a href={marktplaats} class="mt-3 inline-block font-semibold underline">Bekijk het actuele aanbod</a>
        </div>
      </li>
    </ol>
  </section>

  <!-- Occasions: brede foto met een korte belofte ernaast. -->
  <section id="occasions" class="bg-paper-2">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7 [&_img]:w-full [&_img]:h-auto">
        <Foto naam="occasion" alt="Rij gebruikte auto's" sizes="(min-width: 1024px) 55vw, 100vw" />
      </div>
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Op zoek naar een occasion?</h2>
        <p class="mt-5 text-ink-soft">Kom kijken aan de Planckstraat of bekijk eerst wat er nu staat. Bel gerust om te vragen of een auto er nog is.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={marktplaats} class="inline-flex bg-ink text-paper font-semibold px-5 py-3 hover:bg-ink-soft transition-colors">Aanbod op Marktplaats</a>
          <a href="tel:+31682128337" class="inline-flex border border-ink px-5 py-3 hover:bg-ink hover:text-paper transition-colors">06 82 12 83 37</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Openingstijden en route: het praktische blok dat mensen het vaakst zoeken. -->
  <section id="tijden" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5 [&_img]:w-full [&_img]:h-auto order-2 lg:order-1">
      <Foto naam="werkplaats" alt="Monteur aan het werk onder de motorkap" sizes="(min-width: 1024px) 38vw, 100vw" />
    </div>
    <div class="lg:col-span-6 lg:col-start-7 order-1 lg:order-2">
      <h2 class="text-3xl">Openingstijden</h2>
      <dl class="mt-8 border-t-2 border-ink">
        {tijden.map(([dag, tijd]) => (
          <div class="flex justify-between gap-4 py-3 border-b border-line">
            <dt>{dag}</dt>
            <dd class={tijd === 'Gesloten' ? 'text-ink-soft' : 'font-semibold tabular-nums'}>{tijd}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-10">
        <h3 class="text-xl">Adres</h3>
        <p class="mt-2">Planckstraat 88<br />3316 GS Dordrecht</p>
        <p class="mt-1 text-ink-soft text-sm">Op bedrijventerrein Dordtse Kil I, vlak bij de A16.</p>
        <a href={route} class="mt-4 inline-block font-semibold underline">Plan uw route</a>
      </div>
      <p class="mt-10 text-sm text-ink-soft">Auto APK Service Dordt is ook erkend leerbedrijf en staat op Stagemarkt.</p>
    </div>
  </section>

  <!-- Afspraak: in de demo verstuurt het formulier niets. -->
  <section id="afspraak" class="bg-night text-paper">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Afspraak maken</h2>
        <p class="mt-5 text-night-soft max-w-md">Vul uw kenteken en wat er moet gebeuren in, dan bellen we u terug met een tijd. Liever direct bellen kan natuurlijk ook.</p>
        <p class="mt-8 leading-8">
          <a class="font-semibold hover:text-accent" href="tel:+31786172011">078 617 20 11</a><br />
          <a class="hover:text-accent" href="tel:+31682128337">06 82 12 83 37</a><br />
          <a class="hover:text-accent break-all" href="mailto:apkdordt@hotmail.com">apkdordt@hotmail.com</a>
        </p>
      </div>
      <form class="lg:col-span-6 lg:col-start-7 grid gap-5" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-key]]" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">Naam
            <input name="naam" required autocomplete="name" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper" />
          </label>
          <label class="grid gap-2 text-sm">Telefoon
            <input name="telefoon" type="tel" required autocomplete="tel" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper" />
          </label>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">Kenteken
            <input name="kenteken" autocapitalize="characters" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper uppercase" />
          </label>
          <label class="grid gap-2 text-sm">Waarvoor
            <select name="waarvoor" class="bg-night border border-night-soft px-3 py-3 text-base text-paper">
              <option>APK-keuring</option>
              <option>Onderhoudsbeurt</option>
              <option>Reparatie of storing</option>
              <option>Vraag over een occasion</option>
            </select>
          </label>
        </div>
        <label class="grid gap-2 text-sm">Toelichting (optioneel)
          <textarea name="bericht" rows="4" class="bg-transparent border border-night-soft px-3 py-3 text-base text-paper"></textarea>
        </label>
        {voorstel ? (
          <p class="border border-accent px-4 py-3 text-sm">Dit is een ontwerpvoorstel, dus het formulier verstuurt nog niets. Bel <a class="underline" href="tel:+31786172011">078 617 20 11</a> of mail <a class="underline break-all" href="mailto:apkdordt@hotmail.com">apkdordt@hotmail.com</a>.</p>
        ) : (
          <button type="submit" class="justify-self-start bg-accent text-ink font-semibold px-6 py-3 hover:bg-accent-deep transition-colors">Verstuur aanvraag</button>
        )}
        <p class="text-xs text-night-soft">We gebruiken uw gegevens alleen om de afspraak te regelen. Zie de <a class="underline" href={u('privacy/')}>privacyverklaring</a>.</p>
      </form>
    </div>
  </section>
</Base>
