---
import { site, url } from '../data/site';
---
<footer class="donker bg-nacht text-maan">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-kop text-2xl font-extrabold leading-tight text-melk">{site.naam}</p>
      <p class="mt-3 max-w-sm text-sm">Boerderijcamping tussen Bergen op Zoom en Roosendaal. Seizoen van april tot november.</p>
    </div>
    <address class="not-italic text-sm leading-relaxed">
      <p class="font-semibold text-melk">Adres</p>
      <p class="mt-2">{site.straat}<br />{site.postcode} {site.plaats}<br />gemeente {site.gemeente}</p>
    </address>
    <div class="text-sm leading-relaxed">
      <p class="font-semibold text-melk">Contact</p>
      <ul class="mt-2 space-y-1">
        <li><a href={site.mobielHref} class="link">{site.mobiel}</a> (mobiel)</li>
        <li><a href={site.vastHref} class="link">{site.vast}</a></li>
        <li><a href={`mailto:${site.email}`} class="link break-all">{site.email}</a></li>
        <li><a href={site.facebook} class="link">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-5 text-xs">
      <p>{site.naam}, {site.plaats}</p>
      <a href={url('privacy/')} class="link">Privacyverklaring</a>
    </div>
  </div>
</footer>
