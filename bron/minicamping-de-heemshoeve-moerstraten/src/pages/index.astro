---
import Base from '../layouts/Base.astro';
import { site, url, fotos } from '../data/site';

const speel = ['Schommels', 'Wippen', 'Trampolines', 'Glijbanen', 'Zandbakken', 'Zwembaden bij warm weer'];

// Uit Campercontact en Thomik. Waar ze verschillen staat het voorzichtigste.
const plaatsen = [
  ['Plaatsen', 'Hooguit 25, op gras met verharding en verlichting'],
  ['Seizoen', 'Van april tot november'],
  ['Campers', 'Tot 8 meter lang'],
  ['Hoe lang', 'Je blijft zo lang als je wilt'],
  ['Stroom', 'Bij elke caravanplaats, 4 of 6 ampere. Stroom betaal je apart'],
  ['Sanitair', '4 toiletten en 4 douches met thermostaatkraan. Douchen is gratis'],
  ['Afwassen', 'Met warm water, op munten'],
  ['Wifi', 'Gratis'],
  ['Wassen', 'Er is een wasmachine'],
  ['Camper', 'Gratis water tanken en grijs water en cassette lozen'],
  ['Honden', 'Welkom'],
];

const ico = {
  bel: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
  app: '<path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 10c.5 2 2 3.5 4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
};
---
<Base
  title={`${site.naam} | Boerderijcamping in Moerstraten`}
  description="Kleine boerderijcamping in Moerstraten, tussen Bergen op Zoom en Roosendaal. Hooguit 25 plaatsen, speeltoestellen, slapen in de hooischuur en een kampvuur bij mooi weer. Reserveren via bellen, WhatsApp of mail."
  hero
>
  <!-- Hero. Altijd een schermvullende foto; de contactbalk onderaan is het bord bij het hek. -->
  <section class="rood relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-inkt text-melk">
    <img
      src={fotos.hero(1600)}
      srcset={`${fotos.hero(800)} 800w, ${fotos.hero(1200)} 1200w, ${fotos.hero(1600)} 1600w`}
      sizes="100vw"
      alt="Een schuur met een hooibaal ervoor bij zonsopkomst"
      class="absolute inset-0 -z-10 size-full object-cover"
      fetchpriority="high"
      width="1600" height="1067"
    />
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#2a1c17e6_0%,#2a1c17b3_45%,#2a1c1733_100%)]"></div>
    <div class="wrap flex flex-1 items-center pb-12 pt-32 md:pt-36">
      <div class="max-w-5xl">
        <p class="label text-hooi">Boerderijcamping in Moerstraten</p>
        <h1 class="mt-4 text-hero">Kamperen op het erf van De Heemshoeve</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed">Een kleine camping met hooguit 25 plaatsen, tussen Bergen op Zoom en Roosendaal. Er staan speeltoestellen op het erf, kinderen mogen in de hooischuur slapen en bij mooi weer brandt het kampvuur.</p>
      </div>
    </div>
    <div class="bg-schuur">
      <div class="wrap grid divide-y divide-lijn-licht sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        <a href={site.mobielHref} class="group flex items-center gap-4 py-5 no-underline sm:pr-6">
          <svg viewBox="0 0 24 24" class="size-6 shrink-0 text-hooi" aria-hidden="true" set:html={ico.bel} />
          <span><span class="block text-xs text-hooi">Bellen</span><span class="block font-kop text-xl font-bold group-hover:underline">{site.mobiel}</span></span>
        </a>
        <a href={site.whatsapp} class="group flex items-center gap-4 py-5 no-underline sm:px-6">
          <svg viewBox="0 0 24 24" class="size-6 shrink-0 text-hooi" aria-hidden="true" set:html={ico.app} />
          <span><span class="block text-xs text-hooi">WhatsApp</span><span class="block font-kop text-xl font-bold group-hover:underline">Stuur een appje</span></span>
        </a>
        <a href={`mailto:${site.email}`} class="group flex min-w-0 items-center gap-4 py-5 no-underline sm:pl-6">
          <svg viewBox="0 0 24 24" class="size-6 shrink-0 text-hooi" aria-hidden="true" set:html={ico.mail} />
          <span class="min-w-0"><span class="block text-xs text-hooi">Mailen</span><span class="block truncate font-kop text-xl font-bold group-hover:underline">{site.email}</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Spelen. Asymmetrisch: tekst en lijst links, de foto hangt rechts tot onder de sectierand. -->
  <section id="kinderen" class="py-20 md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6">
        <p class="label text-schuur">Voor kinderen</p>
        <h2 class="mt-3 text-3xl">Een erf vol schommels en trampolines</h2>
        <p class="mt-6 max-w-lg text-aarde">Op het erf staan veel speeltoestellen. Een gast uit augustus 2025 noemt ze in een review. Camping.info raadt De Heemshoeve aan voor gezinnen met jonge kinderen.</p>
        <ul class="mt-10 border-t-2 border-inkt">
          {speel.map((s, i) => (
            <li class="flex items-baseline justify-between gap-6 border-b border-lijn py-3">
              <span class="font-kop text-2xl font-bold leading-tight">{s}</span>
              <span class="font-kop text-lg text-aarde" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </li>
          ))}
        </ul>
      </div>
      <figure class="lg:col-span-5 lg:col-start-8 lg:mt-20">
        <img src={fotos.schommel(1000)} srcset={`${fotos.schommel(600)} 600w, ${fotos.schommel(1000)} 1000w`} sizes="(min-width: 1024px) 40vw, 100vw" alt="Een rode schommel met twee schommels" loading="lazy" decoding="async" width="1000" height="1250" class="aspect-[4/5] w-full bg-stro object-cover" />
        <figcaption class="mt-3 text-xs text-aarde">Sfeerbeeld</figcaption>
      </figure>
    </div>
  </section>

  <!-- De blikvanger. Hooischuur en kampvuur, in de kleur van een zomernacht. -->
  <section id="hooischuur" class="donker bg-nacht py-20 text-maan md:py-28">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="grid grid-cols-5 gap-3 lg:col-span-6">
        <img src={fotos.hooi(900)} srcset={`${fotos.hooi(500)} 500w, ${fotos.hooi(900)} 900w`} sizes="(min-width: 1024px) 30vw, 60vw" alt="Een schuur met opgestapelde hooibalen" loading="lazy" decoding="async" width="900" height="1200" class="col-span-3 aspect-[3/4] w-full bg-nacht-2 object-cover" />
        <img src={fotos.vuur(700)} srcset={`${fotos.vuur(400)} 400w, ${fotos.vuur(700)} 700w`} sizes="(min-width: 1024px) 20vw, 40vw" alt="Brandend haardhout in het donker" loading="lazy" decoding="async" width="700" height="700" class="col-span-2 mt-24 aspect-square w-full self-start bg-nacht-2 object-cover" />
        <p class="col-span-5 text-xs">Sfeerbeelden</p>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <p class="label text-gloed">Als het donker wordt</p>
        <h2 class="mt-3 text-3xl text-melk">Slapen in de hooischuur</h2>
        <p class="mt-6 text-lg">Kinderen mogen op De Heemshoeve in de hooischuur slapen. Een nacht in het hooi, in plaats van in de tent of de caravan.</p>
        <p class="mt-4">En is het mooi weer, dan gaat 's avonds het kampvuur aan.</p>
      </div>
    </div>
  </section>

  <!-- Praktisch. Een lijst zoals een bord bij de receptie, geen kaartjes. -->
  <section id="plaatsen" class="bg-stro py-20 md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <p class="label text-schuur">Plaatsen en voorzieningen</p>
        <h2 class="mt-3 text-3xl">Klein, rustig en alles bij de hand</h2>
        <p class="mt-6 text-aarde">De Heemshoeve is een minicamping. Je staat met caravan, camper of tent op het gras van een boerderijcamping.</p>
        <div class="mt-8 border-l-4 border-schuur pl-5">
          <p class="font-kop text-xl font-bold">Wat kost een nacht?</p>
          <p class="mt-1 text-aarde">Vraag het {site.gastvrouw}. Bel of app <a href={site.mobielHref} class="link font-semibold text-inkt">{site.mobiel}</a>.</p>
        </div>
      </div>
      <dl class="border-t-2 border-inkt lg:col-span-7 lg:col-start-6">
        {plaatsen.map(([k, v]) => (
          <div class="grid gap-1 border-b border-lijn py-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <dt class="font-kop text-xl font-bold">{k}</dt>
            <dd class="text-aarde">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Gasten. Samengevat in eigen woorden, met bron en maand, geen letterlijke citaten. -->
  <section id="gasten" class="rood bg-schuur py-20 text-melk md:py-28">
    <div class="wrap">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-hooi">Gasten</p>
          <h2 class="mt-3 text-3xl">Wat gasten over De Heemshoeve zeggen</h2>
        </div>
        <div class="flex items-end gap-6 lg:col-span-6 lg:col-start-7 lg:justify-end">
          <p class="font-kop text-[6rem] font-extrabold leading-none tracking-tight sm:text-[8rem]">4<span class="text-hooi">/5</span></p>
          <p class="pb-3 text-sm leading-relaxed">op camping.info,<br />met een 5 voor schoon,<br />vriendelijkheid en<br />prijs-kwaliteit</p>
        </div>
      </div>
      <div class="mt-16 grid gap-12 border-t border-lijn-licht pt-12 md:grid-cols-2 md:gap-16">
        <article>
          <p class="text-sm text-hooi">Campercontact, april 2026</p>
          <p class="mt-3 font-kop text-2xl font-bold leading-tight">Een kleine, rustige camping met een vriendelijke en behulpzame gastvrouw. Goede fietsroutes in de buurt.</p>
        </article>
        <article class="md:mt-16">
          <p class="text-sm text-hooi">Campercontact, augustus 2025</p>
          <p class="mt-3 font-kop text-2xl font-bold leading-tight">Fijn met een kleinkind. Veel speeltoestellen, een zwembad bij warm weer, goede douches en toiletten en op zondag vers ontbijt.</p>
        </article>
      </div>
      <p class="mt-14 max-w-2xl text-sm">Samengevat uit reviews van gasten. Op camping.info wordt De Heemshoeve aangeraden voor fietsers, gezinnen met jonge kinderen, tentkampeerders, stellen en senioren.</p>
    </div>
  </section>

  <!-- Route. Het adres groot, want dat zoeken mensen onderweg. -->
  <section id="route" class="py-20 md:py-28">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="label text-schuur">Route</p>
        <h2 class="mt-3 text-3xl">Tussen Bergen op Zoom en Roosendaal</h2>
        <p class="mt-6 max-w-lg text-aarde">De Heemshoeve ligt aan de Halstersebaan in Moerstraten, gemeente Roosendaal. Een gast uit april 2026 noemt de goede fietsroutes in de buurt.</p>
      </div>
      <div class="flex flex-col items-start gap-4 lg:col-span-4 lg:col-start-9 lg:self-end">
        <address class="not-italic text-lg leading-snug">{site.straat}<br />{site.postcode} {site.plaats}</address>
        <a href={site.maps} class="knop knop-rood">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9.5" r="2.5" fill="currentColor"/></svg>
          Route plannen
        </a>
      </div>
    </div>
  </section>

  <!-- Contact. Er is geen boekingssite, dus reserveren gaat rechtstreeks. -->
  <section id="contact" class="border-t border-lijn bg-melk pb-24 md:pb-32">
    <div class="wrap grid gap-14 pt-20 md:pt-28 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <p class="label text-schuur">Reserveren</p>
        <h2 class="mt-3 text-3xl">Een plek vragen? Bel, app of mail {site.gastvrouw}</h2>
        <p class="mt-6 text-aarde">Online boeken kan niet. Je spreekt je plek gewoon af met de gastvrouw. Zeg erbij wanneer je komt, hoe lang je blijft en of je met caravan, camper of tent komt.</p>
        <ul class="mt-10 border-t-2 border-inkt">
          <li class="border-b border-lijn py-4">
            <a href={site.mobielHref} class="flex items-center gap-4 no-underline hover:text-schuur">
              <svg viewBox="0 0 24 24" class="size-6 shrink-0 text-schuur" aria-hidden="true" set:html={ico.bel} />
              <span><span class="block text-xs text-aarde">Mobiel</span><span class="font-kop text-2xl font-bold">{site.mobiel}</span></span>
            </a>
          </li>
          <li class="border-b border-lijn py-4">
            <a href={site.vastHref} class="flex items-center gap-4 no-underline hover:text-schuur">
              <svg viewBox="0 0 24 24" class="size-6 shrink-0 text-schuur" aria-hidden="true" set:html={ico.bel} />
              <span><span class="block text-xs text-aarde">Vast</span><span class="font-kop text-2xl font-bold">{site.vast}</span></span>
            </a>
          </li>
          <li class="border-b border-lijn py-4">
            <a href={site.whatsapp} class="flex items-center gap-4 no-underline hover:text-schuur">
              <svg viewBox="0 0 24 24" class="size-6 shrink-0 text-schuur" aria-hidden="true" set:html={ico.app} />
              <span><span class="block text-xs text-aarde">WhatsApp</span><span class="font-kop text-2xl font-bold">Stuur een appje</span></span>
            </a>
          </li>
          <li class="border-b border-lijn py-4">
            <a href={`mailto:${site.email}`} class="flex min-w-0 items-center gap-4 no-underline hover:text-schuur">
              <svg viewBox="0 0 24 24" class="size-6 shrink-0 text-schuur" aria-hidden="true" set:html={ico.mail} />
              <span class="min-w-0"><span class="block text-xs text-aarde">E-mail</span><span class="block break-all font-kop text-xl font-bold">{site.email}</span></span>
            </a>
          </li>
        </ul>
      </div>

      <!-- In het voorstel verstuurt dit formulier niets: geen action en geen verzendknop. -->
      <form class="bg-stro p-6 sm:p-10 lg:col-span-6 lg:col-start-7" aria-labelledby="form-kop" onsubmit="return false">
        <h3 id="form-kop" class="text-2xl">Of laat een bericht achter</h3>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <label class="block sm:col-span-2"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="name" class="veld" /></label>
          <label class="block"><span class="text-sm font-semibold">Telefoon</span><input name="telefoon" type="tel" autocomplete="tel" class="veld" /></label>
          <label class="block"><span class="text-sm font-semibold">E-mail</span><input name="email" type="email" autocomplete="email" class="veld" /></label>
          <label class="block"><span class="text-sm font-semibold">Aankomst</span><input name="aankomst" type="date" class="veld" /></label>
          <label class="block"><span class="text-sm font-semibold">Vertrek</span><input name="vertrek" type="date" class="veld" /></label>
          <label class="block"><span class="text-sm font-semibold">Je komt met</span>
            <select name="kampeermiddel" class="veld">
              <option>Caravan</option><option>Camper</option><option>Tent</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-semibold">Aantal personen</span><input name="personen" type="number" min="1" inputmode="numeric" class="veld" /></label>
          <label class="block sm:col-span-2"><span class="text-sm font-semibold">Bericht</span><textarea name="bericht" rows="4" class="veld"></textarea></label>
        </div>
        <p class="mt-8 border-l-4 border-schuur pl-4 text-sm text-aarde">Dit formulier staat uit in dit ontwerpvoorstel. Bel, app of mail De Heemshoeve rechtstreeks.</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .veld { display: block; width: 100%; margin-top: .35rem; min-height: 3rem; padding: .6rem .8rem; background: var(--color-melk); border: 1px solid #2a1c1766; border-radius: var(--radius-sm); font: inherit; color: var(--color-inkt); }
  textarea.veld { min-height: 7rem; }
  .veld:focus-visible { outline: 3px solid var(--color-schuur); outline-offset: 1px; }
</style>
