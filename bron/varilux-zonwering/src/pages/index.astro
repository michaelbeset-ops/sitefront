---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, producten } from '../data/site';
import hero from '../assets/hero.jpg';
import pergola from '../assets/pergola.jpg';
import rolluiken from '../assets/rolluiken.jpg';
---
<Base
  title="Varilux Zonwering | Zonwering, rolluiken en terrasoverkappingen op maat"
  description="Buitenzonwering op maat voor particulier en bedrijf, geleverd en gemonteerd vanuit Oud-Alblas. Zonneschermen, rolluiken, screens, terrasoverkappingen en horren. Advies aan huis."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Brede foto met een witte kaart die eroverheen schuift: zon buiten, rust binnen. -->
    <section class="relative">
      <div class="h-[46vh] min-h-[18rem] overflow-hidden lg:h-[58vh]"><Foto src={hero} alt="Woning met terrasoverkapping en een gedekte tafel in de zon" hero sizes="100vw" /></div>
      <div class="wrap relative -mt-20 lg:-mt-56">
        <div class="max-w-2xl rounded-2xl bg-white p-6 shadow-[0_1px_2px_#10233a22] ring-1 ring-line md:p-10">
          <p class="font-display font-semibold text-sky">Oud-Alblas en omgeving</p>
          <h1 class="mt-3 text-4xl">Zonwering op maat, voor uw huis of bedrijf</h1>
          <p class="mt-5 text-lg text-ink-soft">Wij leveren en monteren buitenzonwering bij bedrijf en particulier. Alles op maat, passend bij uw wensen en situatie. We komen graag bij u langs voor advies.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-sky">Maak een afspraak: {site.tel}</a>
            <a href="#producten" class="btn btn-line">Bekijk de producten</a>
          </div>
          <p class="mt-6 text-sm text-ink-soft"><strong class="text-ink">5,0</strong> op Google · maandag t/m vrijdag 9.00 tot 17.00 uur</p>
        </div>
      </div>
    </section>

    <section id="producten" class="wrap scroll-mt-20 py-16 lg:py-24">
      <h2 class="max-w-xl text-3xl">Wat we leveren en monteren</h2>
      <div class="mt-12 grid gap-12 lg:grid-cols-12">
        <ul class="grid gap-8 sm:grid-cols-2 lg:col-span-7">
          {producten.map((p) => (
            <li class="border-l-4 border-sky pl-5">
              <h3 class="text-xl">{p.naam}</h3>
              <p class="mt-2 text-ink-soft">{p.tekst}</p>
            </li>
          ))}
        </ul>
        <div class="grid gap-4 lg:col-span-5">
          <div class="aspect-[4/3] overflow-hidden rounded-2xl"><Foto src={pergola} alt="Aluminium terrasoverkapping met loungeset in een aangelegde tuin" sizes="(min-width: 1024px) 460px, 100vw" /></div>
          <div class="aspect-[16/9] overflow-hidden rounded-2xl"><Foto src={rolluiken} alt="Drie witte rolluiken voor de ramen van een groene gevel" sizes="(min-width: 1024px) 460px, 100vw" /></div>
        </div>
      </div>
    </section>

    <section id="advies" class="scroll-mt-20 bg-sand py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Advies bij u thuis</h2>
        </div>
        <div class="space-y-4 text-lg lg:col-span-6 lg:col-start-7">
          <p>Iedere situatie is anders. Daarom komen we bij u langs om de mogelijkheden te bekijken en een passende aanbieding te bespreken. Die afspraak is vrijblijvend.</p>
          <p class="text-base text-ink-soft">[[AANLEVEREN: werkgebied, levertijd en of er een showroom is om te bezoeken]]</p>
          <a href={site.telHref} class="btn btn-sky">Bel {site.tel}</a>
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-20 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Contact</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
        </div>
        <dl class="grid content-start gap-4 text-lg lg:col-span-6 lg:col-start-7">
          <div><dt class="text-sm text-white/70">Telefoon</dt><dd><a href={site.telHref} class="font-display text-3xl font-extrabold underline decoration-sky-light decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-white/70">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="underline decoration-sky-light decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-white/70">Open</dt><dd>Maandag t/m vrijdag, 9.00 tot 17.00 uur</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
