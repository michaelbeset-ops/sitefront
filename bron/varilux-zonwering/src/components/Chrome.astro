---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-2xl font-extrabold tracking-[-0.04em] text-sky no-underline">varilux<span class="ml-1 text-base font-semibold tracking-normal text-ink">zonwering</span></a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href="#producten" class="no-underline hover:text-sky">Producten</a></li>
          <li><a href="#advies" class="no-underline hover:text-sky">Advies aan huis</a></li>
          <li><a href="#contact" class="no-underline hover:text-sky">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-sky !px-4 !py-2 text-sm">Bel ons</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
