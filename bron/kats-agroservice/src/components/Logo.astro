---
// Woordmerk naar de belettering op hun eigen trekkers: "L. KATS agroservice numansdorp", geel op groen.
// Beeldmerk: een groen blok met gele akkerruggen.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const naam = licht ? '#ffffff' : '#221b13';
const sub = licht ? '#f2c230' : '#2d5a32';
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <svg viewBox="0 0 40 40" class="h-10 w-10 flex-none" aria-hidden="true">
    <rect width="40" height="40" rx="9" fill="#2d5a32" />
    <path d="M6 31 17 9M13 31 21.5 9M20 31 26 9M27 31 30.5 9M34 31 35 13" stroke="#f2c230" stroke-width="3" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col">
    <span class="font-display text-[1.45rem] font-black tracking-[-0.01em] uppercase" style={`color:${naam};font-stretch:78%`}>L. Kats</span>
    <span class="mt-0.5 text-[0.64rem] font-bold tracking-[0.2em] whitespace-nowrap lowercase" style={`color:${sub}`}>agroservice numansdorp</span>
  </span>
</span>
