<script>
  // Werkkalender: zonder JS staan alle werkzaamheden er; met JS filteren op soort bedrijf en seizoen.
  const wk = document.querySelector<HTMLElement>('[data-wk]');
  if (wk) {
    const kaarten = [...wk.querySelectorAll<HTMLElement>('.wk-kaart')];
    const typeKnoppen = [...wk.querySelectorAll<HTMLButtonElement>('[data-type]')];
    const seizoenKnoppen = [...wk.querySelectorAll<HTMLButtonElement>('button[data-seizoen]')];
    const status = wk.querySelector<HTMLElement>('[data-wk-status]')!;
    const waKnop = wk.querySelector<HTMLAnchorElement>('[data-wk-wa]')!;
    const verder = wk.querySelector<HTMLElement>('[data-wk-verder]')!;
    const verderKop = wk.querySelector<HTMLElement>('[data-wk-verder-kop]')!;
    const verderLijst = wk.querySelector<HTMLElement>('[data-wk-verder-lijst]')!;
    const basis = waKnop.getAttribute('href')!;
    let type = typeKnoppen[0].dataset.type!;
    // Start in het seizoen van vandaag.
    const m = new Date().getMonth();
    let seizoen = m >= 2 && m <= 4 ? 'voorjaar' : m >= 5 && m <= 7 ? 'zomer' : m >= 8 && m <= 10 ? 'najaar' : 'winter';
    const nu = seizoen;
    const nuKnop = seizoenKnoppen.find((k) => k.dataset.seizoen === nu);
    if (nuKnop) nuKnop.insertAdjacentHTML('beforeend', ' <span class="sr-only">(nu)</span><span aria-hidden="true" class="text-xs font-bold uppercase tracking-wider">nu</span>');

    wk.querySelectorAll<HTMLElement>('[data-wk-keuzes]').forEach((f) => (f.hidden = false));

    const voorType = (k: HTMLElement) => k.dataset.voor!.split(' ').includes(type);
    const inSeizoen = (k: HTMLElement, s: string) => k.dataset.seizoen!.split(' ').includes(s);

    const toon = () => {
      const knop = typeKnoppen.find((k) => k.dataset.type === type)!;
      const wie = knop.dataset.wie!;
      typeKnoppen.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.type === type)));
      seizoenKnoppen.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.seizoen === seizoen)));
      const vanType = kaarten.filter(voorType);
      wk.querySelectorAll<HTMLElement>('[data-telt]').forEach((t) => {
        const n = vanType.filter((k) => inSeizoen(k, t.dataset.telt!)).length;
        t.textContent = `(${n})`;
      });
      const zicht = seizoen === 'alle' ? vanType : vanType.filter((k) => inSeizoen(k, seizoen));
      kaarten.forEach((k) => (k.hidden = !zicht.includes(k)));
      const rest = vanType.filter((k) => !zicht.includes(k));
      const lidw: Record<string, string> = { voorjaar: 'in het voorjaar', zomer: 'in de zomer', najaar: 'in het najaar', winter: 'in de winter' };
      const sLabel = seizoen === 'alle' ? '' : ` ${lidw[seizoen]}`;
      status.textContent = zicht.length
        ? `${zicht.length} ${zicht.length === 1 ? 'werkzaamheid' : 'werkzaamheden'} voor ${wie}${sLabel}.`
        : `Voor ${wie} is er${sLabel} geen apart seizoenswerk. Kies hieronder wat u zoekt.`;
      verder.classList.toggle('hidden', rest.length === 0);
      verderKop.textContent = `Verder voor ${wie}`;
      verderLijst.replaceChildren(...rest.map((k) => {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'wk-keus';
        b.textContent = k.dataset.titel!;
        b.addEventListener('click', () => {
          seizoen = 'alle';
          toon();
          k.setAttribute('tabindex', '-1');
          k.scrollIntoView({ behavior: 'smooth', block: 'center' });
          k.focus({ preventScroll: true });
        });
        li.append(b);
        return li;
      }));
      const tekst = `Hallo Leen, ${knop.dataset.app} en wil graag werk plannen${sLabel}.`;
      waKnop.href = `${basis}?text=${encodeURIComponent(tekst)}`;
    };
    typeKnoppen.forEach((k) => k.addEventListener('click', () => { type = k.dataset.type!; toon(); }));
    seizoenKnoppen.forEach((k) => k.addEventListener('click', () => { seizoen = k.dataset.seizoen!; toon(); }));
    toon();
  }
</script>
