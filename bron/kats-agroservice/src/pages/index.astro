---
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site } from '../data/site';

import polder from '../assets/polder.jpg';
import avond from '../assets/avond.jpg';
import kopAkker from '../assets/kop-akkerbouw.jpg';
import kopVee from '../assets/kop-veehouderij.jpg';
import kopCultuur from '../assets/kop-cultuurtechniek.jpg';
import kopGroen from '../assets/kop-groenvoorziening.jpg';

// Eigen foto's uit hun fotoboek (640 px): nooit breder tonen dan dat.
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/f/*.jpg', { eager: true });
const F = (n: string) => fotos[`../assets/f/${n}.jpg`].default;

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const wa = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

// Vier vakgebieden, tekst van hun homepage; onderwerpen uit hun menu.
const diensten = [
  { nr: '01', naam: 'Akkerbouw', foto: kopAkker, eigen: false, alt: 'Een Claas-combine oogst graan, met het maaibord voor de machine', tekst: 'Grondbewerkingen zoals woelen, cultiveren, ploegen, frezen, eggen en kilveren. Poten en zaaien. De verzorging van gewas. Oogsten en rooien.', subs: ['Grondbewerking', 'Poten en zaaien', 'Gewasverzorging', 'Oogst'] },
  { nr: '02', naam: 'Veehouderij', foto: F('veehouderij-026'), eigen: true, alt: 'Onze groene trekker met een schudder op een gemaaid grasperceel', tekst: 'De voederwinning van gras moet zo zorgvuldig mogelijk gebeuren. Wij kunnen maaien, schudden, harken, persen, wikkelen, laden en het transport op korte en lange afstand regelen.', subs: ['Grasvoederwinning', 'Persen', 'Wikkelen en laden'] },
  { nr: '03', naam: 'Cultuurtechniek', foto: kopCultuur, eigen: false, alt: 'Onze trekker met de belettering L. Kats agroservice Numansdorp en een waterwagen op een zandbaan', tekst: 'Ruilverkaveling, grondverbetering, de aanleg en inrichting van weg- en watersystemen. Grond ontgraven en verzetten, drainagewerk, rioleringen, sloten baggeren, watergangen onderhouden, beschoeiingen en damwanden.', subs: ['Grondverzet', 'Watertransport', 'Noodoplossingen'] },
  { nr: '04', naam: 'Groenvoorziening', foto: kopGroen, eigen: false, alt: 'Onze kleine blauwe trekker met de belettering L. Kats agroservice Numansdorp freest een berm', tekst: 'Aanleg en onderhoud van groenvoorzieningen. Bomen planten en verzorgen, hagen knippen, bermen, slootkanten en gazons maaien, bedrijfsterreinen onkruidvrij maken en ongedierte bestrijden.', subs: ['Zaaien en maaien', 'Onkruidbestrijding', 'Ongediertebestrijding'] },
];

// Werkkalender. Seizoenen alleen waar hun site of fotoboek dat aangeeft (zie PLAN.md); de rest staat bij "alle seizoenen".
type Type = 'akker' | 'vee' | 'overheid' | 'aannemer' | 'particulier';
type Seizoen = 'voorjaar' | 'zomer' | 'najaar' | 'winter';
const types: { id: Type; label: string; wie: string; app: string }[] = [
  { id: 'akker', label: 'Akkerbouwer', wie: 'akkerbouwers', app: 'ik ben akkerbouwer' },
  { id: 'vee', label: 'Veehouder', wie: 'veehouders', app: 'ik ben veehouder' },
  { id: 'overheid', label: 'Gemeente, waterschap of Rijkswaterstaat', wie: 'gemeenten, waterschappen en Rijkswaterstaat', app: 'ik app namens een gemeente, waterschap of Rijkswaterstaat' },
  { id: 'aannemer', label: 'Aannemer', wie: 'aannemers', app: 'ik ben aannemer' },
  { id: 'particulier', label: 'Particulier', wie: 'particulieren', app: 'ik ben particulier' },
];
const seizoenen: { id: Seizoen; label: string }[] = [
  { id: 'voorjaar', label: 'Voorjaar' },
  { id: 'zomer', label: 'Zomer' },
  { id: 'najaar', label: 'Najaar' },
  { id: 'winter', label: 'Winter' },
];
const werk: { titel: string; vak: string; voor: Type[]; seizoen: Seizoen[]; punten: string[]; foto: string; alt: string; boek?: string }[] = [
  { titel: 'Zaaibedbereiding', vak: 'Grondbewerking', voor: ['akker'], seizoen: ['voorjaar'], foto: 'akkerbouw-019', alt: 'Een groene trekker met een rode rotoreg op een egaal zaaibed',
    punten: ['Voor de voorjaarswerkzaamheden een rotoreg van 2 of 3 meter breed, zo nodig gecombineerd met een machine in de fronthefinrichting.', 'Voor bieten een getrokken Steketee sneleg van 5 meter breed, met een trekker op lagedrukbanden.'] },
  { titel: 'Aardappels poten en aanaarden in één werking', vak: 'Poten en zaaien', voor: ['akker'], seizoen: ['voorjaar'], foto: 'akkerbouw-022', alt: 'Een groene trekker met een aardappelpootmachine op een pas bewerkt perceel', boek: 'Uit ons fotoboek: in maart de eerste aardappels gepoot.',
    punten: ['Aardappelpootmachine met speciale aanaardkappen en een frontfrees in de fronthef: u hoeft ons geen tweede keer in te schakelen.', 'De multivator zorgt voor een laag losse grond onder de pootaardappel.', 'De pootmachine is voorzien van missercontrole.'] },
  { titel: 'Suikerbieten, granen en graszaad zaaien', vak: 'Poten en zaaien', voor: ['akker'], seizoen: ['voorjaar'], foto: 'akkerbouw-020', alt: 'Een groene trekker met een brede zaaimachine op een zaaibed',
    punten: ['Suikerbieten: een elektrisch aangestuurde 12 rijen Kleine bietenzaaimachine. De trekker heeft dubbele montering op rijenafstand en een laag gewicht.', 'Ook voor alle granen, blauwmaanzaad of graszaad. We denken graag met u mee over de beste oplossing.'] },
  { titel: 'Spuiten en bemesten', vak: 'Gewasverzorging', voor: ['akker'], seizoen: [], foto: 'akkerbouw-011', alt: 'Een trekker met een getrokken veldspuit met uitgeklapte spuitboom boven een gewas',
    punten: ['Getrokken Amazone volleveldspuit met een werkbreedte van 40 meter, op het rijpadensysteem.', 'Parallel een computergestuurde Vicon kunstmeststrooier met weeginrichting.', 'Spuitlicenties 1, 2 en 3, in het bezit van onze vaste chauffeur.'] },
  { titel: 'Schoffelen en slootkanten', vak: 'Gewasverzorging', voor: ['akker'], seizoen: ['voorjaar'], foto: 'akkerbouw-025', alt: 'Een rode trekker met een gele klepelmaaier op een slootkant',
    punten: ['Suikerbieten: 6 en 12 rijen triltand schoffelmachine. Maïs en spruiten: Kongskilde triltand schoffelmachine.', 'Slootkanten met Hemos klepelmaaiers: 1 meter breed in de fronthef, 2,5 meter achterop. Zo hoeft u in het voorjaar maar één keer door het gewas.'] },
  { titel: 'Granen en graszaad oogsten', vak: 'Oogst', voor: ['akker'], seizoen: ['zomer'], foto: 'akkerbouw-029', alt: 'Een combine oogst een veld rijp graan',
    punten: ['Vier Claas combines met twee voorzetstukken: één speciaal voor graszaad en één met een standaardbak voor graan.', 'Het graanvoorzetstuk is speciaal geschikt voor koolzaad, met verlengmes en zaaimessen.'] },
  { titel: 'Hooi en stro persen', vak: 'Oogst', voor: ['akker', 'vee'], seizoen: ['zomer'], foto: 'akkerbouw-035', alt: 'Een rode trekker met een grootpakpers op een stoppelveld', boek: 'Uit ons fotoboek: in juni volop hooi binnenhalen.',
    punten: ['Vier New-Holland grootpakpersen en twee Welger kleine balenpersen.', 'Balenmaat naar keuze 1,20 x 0,90 of 1,20 x 0,70 meter. Met snijdinrichting: u bepaalt met onze chauffeurs hoe kort.', 'We staan bekend om ons grote aandeel in de aankoop van hooi en stro in de Hoekse Waard en omstreken.'] },
  { titel: 'Aardappels en suikerbieten rooien', vak: 'Oogst', voor: ['akker'], seizoen: ['najaar'], foto: 'akkerbouw-044', alt: 'Een rode bietenrooier in een veld suikerbieten', boek: 'Uit ons fotoboek: in november suikerbieten rooien.',
    punten: ['Het volledige pakket: loofklappen, rooien, transport en inschuren. Vroege aardappels loofklappen in combinatie met een Reglone bespuiting.', 'Twee getrokken Grimme rooiers, de rooiers met de minste rooibeschadiging.', 'Suikerbieten met een Vervaet bietenrooier met axiaal rollen.'] },
  { titel: 'Ploegen en spitten: grond winterklaar', vak: 'Grondbewerking', voor: ['akker'], seizoen: ['najaar'], foto: 'akkerbouw-065', alt: 'Een groene trekker met een blauwe ploeg op versgeploegde grond',
    punten: ['4-schaar Lemken ploeg met strokenpriesters: een goede keerring van de grond en een egaal ploegbeeld.', 'Voor moeilijke omstandigheden een Celli krukas spitmachine, al dan niet met rotoreg en zaaimachine.', 'Verder onder meer woelpoot, volleveldfrees, rijenfrees en cultivator.'] },
  { titel: 'Gras maaien, schudden en harken', vak: 'Grasvoederwinning', voor: ['vee'], seizoen: ['voorjaar', 'zomer'], foto: 'veehouderij-038', alt: 'Een groene trekker met een maaicombinatie voor- en achterop in het gras', boek: 'Uit ons fotoboek: in juni vaker schudden dan gebruikelijk, voor hooi van goede kwaliteit.',
    punten: ['Maaien met een maaicombinatie voor- en achterop de trekker.', 'Schudden met een Claas schudder van 6,80 meter werkbreedte, die goed aansluit op de maaicombinatie.', 'Harken met een dubbele Claas hark van 8,80 meter met middenafleg, zodat de pers het gewas eenvoudig oppakt.'] },
  { titel: 'Grootpak persen', vak: 'Grasvoederwinning', voor: ['vee'], seizoen: ['voorjaar', 'zomer'], foto: 'veehouderij-011', alt: 'Een groene trekker met een rode grootpakpers op een grasperceel',
    punten: ['Vier New-Holland grootpakpersen. Balenmaten 1,20 x 0,70, 1,20 x 0,90 en 0,80 x 0,70 meter.', 'De pers voor 1,20 x 0,70 heeft een tandemset en gestuurde as, zodat de grasmat behouden blijft.', 'Vierkante balen: makkelijk stapelen en transporteren, eenvoudig voederen in de stal en een gelijkmatige, hoge persdichtheid.'] },
  { titel: 'Wikkelen, laden en transport', vak: 'Grasvoederwinning', voor: ['vee'], seizoen: ['voorjaar'], foto: 'veehouderij-019', alt: 'Een trekker met pers op een grasperceel langs de snelweg, met het afritbord Numansdorp en Zuid-Beijerland', boek: 'Uit ons fotoboek: in mei gras inkuilen en in folie wikkelen, aan de rijksweg A29.',
    punten: ['Twee Kverneland/Taarup wikkelaars met een laag gewicht.', 'Laden met een Claas verreiker of een Ahlmann shovel.', 'Aanhangers voor transport op korte en lange afstand, ook te gebruiken met uw eigen trekker.'] },
  { titel: 'Grondverzet en transport', vak: 'Grondverzet', voor: ['aannemer', 'overheid', 'particulier'], seizoen: [], foto: 'cultuurtechniek-044', alt: 'Een groene trekker met een rode grond-dumper op een bouwterrein', boek: 'Uit ons fotoboek: veel grond verzet in januari, met de Beco Gigant 200 in Spijkenisse.',
    punten: ['Een Ahlmann shovel, bekend in de wegenbouw, en een verreiker met 7 meter hefhoogte.', 'Een 5,5 tons Hyundai rupskraan met bakken in alle maten, sorteergrijper, baggerbak, maaikorf en puinbak.', 'Een 4,5 tons kipwagen voor moeilijk bereikbare plaatsen; voor het grove werk de Beco Gigant 200.'] },
  { titel: 'Vijvers, sloten en paardenbakken', vak: 'Grondverzet', voor: ['particulier', 'aannemer'], seizoen: [], foto: 'groenvoorziening-018', alt: 'Een groene rupskraan graaft naast een fietspad',
    punten: ['Verhardingen aanleggen en verbeteren, rioleringen aansluiten en funderingen aanleggen.', 'Vijvers, sloten en paardenbakken aanleggen, en grond, grind en zand vervoeren.', 'Loonbedrijf Kats verzorgt al het grondwerk volledig.'] },
  { titel: 'Sloten, watergangen en beschoeiingen', vak: 'Cultuurtechniek', voor: ['overheid', 'particulier', 'akker'], seizoen: [], foto: 'cultuurtechniek-053', alt: 'Een rupskraan werkt vanaf de oever in een sloot',
    punten: ['Sloten baggeren en watergangen onderhouden.', 'Beschoeiingen en damwanden plaatsen.', 'Drainagewerk uitvoeren en rioleringen aanleggen.'] },
  { titel: 'Watertransport', vak: 'Watertransport', voor: ['aannemer', 'overheid'], seizoen: [], foto: 'cultuurtechniek-005', alt: 'Een groene trekker met een waterwagen op een zandbaan',
    punten: ['Waterwagen op lagedrukbanden: in de wegenbouw de zandbaan bevloeien en bij droogte nat houden tegen stof.', 'In de groenvoorziening pas geplante boompjes en bloemperken van water voorzien.', 'Water voor de drainreiniger, en bij vervuiling een rolveger voor- of achterop om de weg schoon te spoelen.'] },
  { titel: 'Wateroverlast en stroomuitval', vak: 'Noodoplossingen', voor: ['overheid', 'aannemer', 'akker'], seizoen: [], foto: 'cultuurtechniek-018', alt: 'Twee trekkers aan het water met gele afvoerslangen over de dijk',
    punten: ['Twee noodpompen van 972 en 1800 m³/h, aangedreven door een trekker, met een flexibele slang tot 50 meter.', 'Ook geschikt om water te verpompen bij een tekort, bijvoorbeeld bij beregening van uw land.', 'Een 40 kVA trekkergenerator als de stroom is onderbroken of voor een tijdelijke noodvoorziening.'] },
  { titel: 'Sneeuw en ijs', vak: 'Noodoplossingen', voor: ['overheid', 'aannemer', 'particulier'], seizoen: ['winter'], foto: 'cultuurtechniek-049', alt: 'Een groene trekker met een sneeuwschuiver in de sneeuw',
    punten: ['Meerdere sneeuwschuivers en een veegmachine voor het ruimen van sneeuw en ijs.', 'Sneeuwschuivers huren voor een seizoen, al dan niet met een strooier.'] },
  { titel: 'Bermen, slootkanten en gazons', vak: 'Zaaien en maaien', voor: ['overheid', 'particulier'], seizoen: [], foto: 'groenvoorziening-004', alt: 'Een kleine blauwe trekker met een maai-arm maait een berm langs een pad',
    punten: ['Een 4 meter lange hydraulische arm met klepelmaaier.', 'De New-Holland TCE 40: 1.350 kilo, 1,50 meter breed, met gazonbanden en een maaier van 1,80 meter in de fronthef.', 'Eggen met een rotoreg en zaaien met een graszaaimachine. Doorzaaien kan ook.'] },
  { titel: 'Bomen, hagen en versnipperen', vak: 'Groenvoorziening', voor: ['overheid', 'particulier'], seizoen: [], foto: 'groenvoorziening-024', alt: 'Een oranje houtversnipperaar achter een trekker',
    punten: ['Bomen planten en verzorgen en hagen knippen.', 'Bomen kappen en versnipperen tot een diameter van 27 centimeter, met een versnipperaar met hydraulische kraan: minder handwerk.', 'Afvoer van houtsnippers en boomstammen.'] },
  { titel: 'Onkruidvrij met Select Spray', vak: 'Onkruidbestrijding', voor: ['overheid'], seizoen: [], foto: 'groenvoorziening-010', alt: 'Een gele quad met spuitapparatuur op een stoep',
    punten: ['Select Spray selecteert onkruid op bladgroen en dient alleen vloeistof toe waar onkruid staat.', 'Op een Quad of op onze New-Holland trekker met spuitboom en haspel met spuitlans.', 'Bij grotere projecten een trekker met een 3 meter brede spuitboom en een grotere tank.'] },
  { titel: 'Eikenprocessierups en luizen', vak: 'Ongediertebestrijding', voor: ['overheid'], seizoen: [], foto: 'groenvoorziening-013', alt: 'Een trekker met een elektrostatische spuit in een laan met bomen',
    punten: ['Een elektrostatische spuit met het biologische bestrijdingsmiddel Xentari.', 'De deeltjes hechten zich optimaal aan de bladeren: geen dampwerking en verlies.', 'Een krachtige straal lucht met vloeistof, met een bereik van 40 meter.'] },
];
const labelVan = Object.fromEntries(seizoenen.map((s) => [s.id, s.label]));

// Het machinepark in maten, allemaal van hun dienstpagina's.
const maten = [
  { getal: '40 m', wat: 'werkbreedte', bij: 'Getrokken Amazone volleveldspuit' },
  { getal: '8,80 m', wat: 'dubbele hark', bij: 'Claas, met middenafleg' },
  { getal: '6,80 m', wat: 'schudder', bij: 'Claas, sluit aan op de maaicombinatie' },
  { getal: '5 m', wat: 'sneleg', bij: 'Getrokken Steketee, voor het bietenzaaibed' },
  { getal: '12 rijen', wat: 'zaaimachine', bij: 'Kleine bietenzaaimachine, elektrisch aangestuurd' },
  { getal: '4', wat: 'Claas combines', bij: 'Voor granen en graszaad' },
  { getal: '4', wat: 'grootpakpersen', bij: 'New-Holland, met snijdinrichting' },
  { getal: '7 m', wat: 'hefhoogte', bij: 'Verreiker voor bijzondere projecten' },
  { getal: '5,5 ton', wat: 'rupskraan', bij: 'Hyundai, met bakken in alle maten' },
  { getal: '1800 m³/h', wat: 'noodpomp', bij: 'Naast een pomp van 972 m³/h' },
  { getal: '40 kVA', wat: 'trekkergenerator', bij: 'Bij stroomuitval of als noodvoorziening' },
  { getal: '40 m', wat: 'bereik', bij: 'Elektrostatische spuit tegen de eikenprocessierups' },
];

// Fotoboek: eigen foto's die niet al in de werkkalender staan.
const boek = [
  { f: 'akkerbouw-004', bij: 'Trekker met rotoreg', alt: 'Een groene trekker met een oranje rotoreg op de kopakker' },
  { f: 'akkerbouw-037', bij: 'Aardappels rooien', alt: 'Een groene trekker met een getrokken rode aardappelrooier' },
  { f: 'veehouderij-013', bij: 'Balen wikkelen', alt: 'Een trekker met een rode wikkelaar die een grote baal in folie wikkelt' },
  { f: 'veehouderij-022', bij: 'Transport van gewikkelde balen', alt: 'Een oplegger vol gewikkelde balen op een grasperceel' },
  { f: 'cultuurtechniek-045', bij: 'Onze verreiker bij de betoncentrale aan de Moerdijk', alt: 'Een blauwe verreiker bij een betoncentrale' },
  { f: 'cultuurtechniek-032', bij: 'Beschoeiing langs een woning', alt: 'Een nieuwe houten beschoeiing langs een sloot naast een woning' },
  { f: 'groenvoorziening-002', bij: 'Groenonderhoud in de wijk', alt: 'Onze kleine blauwe trekker met een frees op een grasstrook bij een appartementengebouw' },
  { f: 'cultuurtechniek-014', bij: 'Sloot uitgraven', alt: 'Een rupskraan aan het werk aan een sloot in een polder' },
];
---
<Base
  title="Loonbedrijf Kats | L. Kats Agroservice in Numansdorp, Hoeksche Waard"
  description="Loonbedrijf Kats uit Numansdorp, opgericht in 1959: akkerbouw, veehouderij, cultuurtechniek en groenvoorziening voor akkerbouwers, veehouders, waterschappen, Rijkswaterstaat, gemeenten, aannemers en particulieren. VCA en VKL gecertificeerd."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: polder over de volle breedte, klei-vlak links, eigen trekker met pers als overlappende kaart. -->
    <section class="donker relative isolate overflow-hidden bg-klei text-white lg:overflow-visible">
      <div class="absolute inset-0 -z-10 overflow-hidden">
        <Foto src={polder} alt="" hero widths={[480, 768, 1200, 1800]} sizes="100vw" class="object-[70%_60%]" />
        <div class="absolute inset-0 bg-klei/70 lg:bg-transparent lg:bg-[linear-gradient(90deg,#221b13_0%,#221b13eb_32%,#221b1380_55%,#221b1300_78%)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(0deg,#221b13cc,#221b1300)]"></div>
      </div>
      <div class="wrap grid grid-cols-1 gap-10 pt-12 pb-14 lg:grid-cols-12 lg:pt-20 lg:pb-24">
        <div class="lg:col-span-7">
          <p class="kicker text-koolzaad">Loonbedrijf in de Hoeksche Waard, sinds 1959</p>
          <h1 class="mt-5 text-4xl">Loonwerk voor akker, wei, sloot en berm</h1>
          <p class="mt-6 max-w-2xl text-lg text-white/90">Vanuit Numansdorp werkzaam in de agrarische, de cultuurtechnische en de grond-, weg- en waterbouwsector. Voor akkerbouwers, veehouders, waterschappen, Rijkswaterstaat, gemeenten, aannemers en particulieren.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.whatsapp} class="btn btn-geel"><Fragment set:html={wa} /><span>WhatsApp Leen Kats</span></a>
            <a href={site.telHref} class="btn btn-line"><Fragment set:html={tel} /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <dl class="mt-11 grid max-w-2xl grid-cols-2 gap-x-4 gap-y-5 border-t sm:grid-cols-3 border-white/25 pt-6 text-sm">
            <div><dt class="text-white/75">Google</dt><dd class="mt-1"><strong class="block font-display text-2xl leading-tight font-extrabold text-koolzaad tabular-nums">{site.google}</strong><span class="text-white/80">{site.reviews} reviews</span></dd></div>
            <div><dt class="text-white/75">Opgericht</dt><dd class="mt-1"><strong class="block font-display text-2xl leading-tight font-extrabold text-koolzaad tabular-nums">1959</strong><span class="text-white/80">als spuitloonbedrijf</span></dd></div>
