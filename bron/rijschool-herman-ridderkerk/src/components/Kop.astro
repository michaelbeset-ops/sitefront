---
import { url, waIntake, site } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<header class:list={['z-40 w-full', thuis ? 'absolute inset-x-0 top-(--balk) text-licht' : 'border-b border-lijn']}>
  <div class="wrap grid h-20 grid-cols-[1fr_auto] items-center gap-6 md:h-24 md:grid-cols-[1fr_auto_1fr]">
    <a href={url('')} class="merk justify-self-start" aria-label={`${site.naam}, naar de homepage`}>
      <span aria-hidden="true">H<span class="e">E</span>RMAN</span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden md:block">
      <ul class="ui flex gap-9">
        <li><a href={h('lessen')} class="lijn-in">Lessen</a></li>
        <li><a href={h('tarieven')} class="lijn-in">Tarieven</a></li>
        <li><a href={h('werkwijze')} class="lijn-in">Werkwijze</a></li>
        <li><a href={h('contact')} class="lijn-in">Contact</a></li>
      </ul>
    </nav>
    <p class="ui flex items-center justify-end gap-8">
      <a href={site.telHref} class="lijn-in num hidden lg:inline">{site.tel}</a>
      <a href={waIntake} class="lijn-in">WhatsApp</a>
    </p>
  </div>
</header>
