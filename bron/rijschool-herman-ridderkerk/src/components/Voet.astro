---
import { site, url, waIntake, werkgebied } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <small>Rijschool</small> 
        <b>H<span class="e">E</span>RMAN</b>
      </a>
      <p class="mt-6 max-w-xs">Auto- en motorrijschool in Ridderkerk. Rijles voor rijbewijs B en A, overdag, ’s&nbsp;avonds en in het weekend.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-blauw" aria-label="Facebook"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1Z"/></svg></a>
        <a href={waIntake} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-blauw" aria-label="WhatsApp"><Icoon naam="wa" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Lessen</p>
      <ul class="mt-4 space-y-2">
        <li><a href={h('lessen')} class="no-underline transition-colors hover:text-blauw-licht">Rijbewijs B, auto</a></li>
        <li><a href={h('lessen')} class="no-underline transition-colors hover:text-blauw-licht">Rijbewijs A, motor</a></li>
        <li><a href={h('lessen')} class="no-underline transition-colors hover:text-blauw-licht">Intakeles</a></li>
        <li><a href={h('lessen')} class="no-underline transition-colors hover:text-blauw-licht">Tussentijdse toets</a></li>
        <li><a href={h('tarieven')} class="no-underline transition-colors hover:text-blauw-licht">Pakketten en tarieven</a></li>
        <li><a href={h('werkwijze')} class="no-underline transition-colors hover:text-blauw-licht">Examen aanvragen</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-blauw-licht">{site.tel}</a></li>
        <li><a href={site.tel2Href} class="num whitespace-nowrap no-underline transition-colors hover:text-blauw-licht">{site.tel2}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-blauw-licht">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.maps} class="no-underline transition-colors hover:text-blauw-licht">Route plannen</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Lestijden en werkgebied</p>
      <p class="mt-4">Overdag, ’s&nbsp;avonds en in het weekend. Bel of app voor een tijd.</p>
      <p class="mt-4">{werkgebied.join(', ')}. Daarbuiten op verzoek.</p>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats} · CBR-rijschoolnummer {site.cbr}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-blauw-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van de lesauto en lesmotor van uw huidige website en Facebook-pagina; luchtfoto’s van wegen via Unsplash, ter illustratie. Tarieven zoals op rijschoolherman.com, review letterlijk van Google, examencijfers van het CBR via Clickdrive (stand 2 oktober 2026).</p>}
  </div>
</footer>
