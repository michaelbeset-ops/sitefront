---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, waIntake, waMet, tarieven } from '../data/site';
import asfalt from '../assets/asfalt.jpg';
import lesmotor from '../assets/lesmotor.jpg';
import lesauto from '../assets/lesauto.jpg';
import lesautoVoor from '../assets/lesauto-voor.jpg';

const soorten = ['auto', 'motor'] as const;
const eerste = tarieven.auto.pakketten[2];
const waPakket = (soort: string, p: { naam: string; inhoud: string }) =>
  waMet(`Hoi, ik heb interesse in ${soort}${p.naam.replace('Pakket', 'pakket')} (${p.inhoud}). Kunnen we een intakeles plannen?`);
---
<Base
  title="Rijschool Herman | Auto- en motorrijles in Ridderkerk"
  description="Rijlessen voor je auto- en motorrijbewijs in Ridderkerk en omgeving. Overdag, 's avonds of in het weekend. Pakketten en losse lessen, plan je intakeles via WhatsApp."
>
  <Kop />
  <main id="inhoud">
    <!-- Eerste scherm: één beeld over de volle hoogte, kop en één actie. -->
    <section class="donker relative isolate flex h-[calc(100svh-var(--balk))] min-h-[34rem] flex-col justify-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={asfalt} alt="" widths={[640, 960, 1440, 1920]} sizes="100vw" quality={58} loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[0%_100%] md:object-[50%_100%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1c1d1f99_0%,#1c1d1f26_22%,#1c1d1f26_42%,#1c1d1ff2_80%)] md:bg-[linear-gradient(180deg,#1c1d1f99_0%,#1c1d1f1a_20%,#1c1d1f1a_50%,#1c1d1fcc_100%)]" aria-hidden="true"></div>
      <div class="wrap grid pb-12 md:grid-cols-12 md:pb-16">
        <div class="md:col-span-8 lg:col-span-7">
          <h1 id="t-hero" class="text-4xl">Niet meer lessen dan nodig.</h1>
          <p class="mt-7 max-w-md text-lg/relaxed text-licht/85">Rijlessen voor je auto- en motorrijbewijs in Ridderkerk en omgeving. Overdag, ’s avonds of in het weekend.</p>
          <div class="mt-10 flex flex-wrap items-center gap-x-9 gap-y-5">
            <a href={waIntake} class="knop knop-licht">Plan een intakeles</a>
            <a href="#tarieven" class="lijn text-sm">Bekijk de tarieven</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Auto en motor -->
    <section id="lessen" class="wrap py-28 lg:py-40" aria-labelledby="t-lessen">
      <div class="grid gap-y-8 md:grid-cols-12 md:gap-x-8">
        <h2 id="t-lessen" class="rijs text-3xl md:col-span-6">Auto of motor.</h2>
        <p class="rijs max-w-md text-grijs md:col-span-5 md:col-start-8 md:pt-3" style="--d:.05s">Je leert voor rijbewijs B of A in Ridderkerk, Rotterdam, Barendrecht, Hendrik-Ido-Ambacht, Zwijndrecht en Dordrecht. Daarbuiten kan het op verzoek.</p>
      </div>

      <div class="mt-20 grid gap-y-10 md:grid-cols-12 md:gap-x-8 lg:mt-28">
        <figure class="rijs md:col-span-7 md:col-start-6 md:row-start-1">
          <Image src={lesauto} alt="De lesauto van Rijschool Herman, een grijze Volkswagen Golf met dakbord" widths={[440, 880]} sizes="(min-width: 768px) 55vw, 100vw" class="aspect-[16/9] w-full bg-vlak object-cover object-[62%_50%] md:aspect-[880/242]" />
        </figure>
        <div class="rijs md:col-span-4 md:row-start-1" style="--d:.05s">
          <p class="ui text-grijs">Rijbewijs B</p>
          <h3 class="mt-4 text-2xl">Auto</h3>
          <p class="mt-5 text-grijs">Lessen van 60 of 90 minuten. We raden 90 minuten aan: je oefent langer achter elkaar, onthoudt de lesstof beter en bent sneller klaar.</p>
          <p class="mt-4 text-grijs">Een tussentijdse toets laat je vooraf voelen hoe het praktijkexamen gaat. Vanaf 16,5 jaar mag je beginnen.</p>
        </div>
      </div>

      <div class="mt-24 grid gap-y-10 md:grid-cols-12 md:gap-x-8 lg:mt-36">
        <figure class="rijs md:col-span-5">
          <Image src={lesmotor} alt="De lesmotor, een witte Honda, voor een bakstenen gevel" widths={[400, 720]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[4/5] w-full bg-vlak object-cover object-[50%_60%]" />
        </figure>
        <div class="rijs flex flex-col md:col-span-5 md:col-start-8" style="--d:.05s">
          <p class="ui text-grijs">Rijbewijs A</p>
          <h3 class="mt-4 text-2xl">Motor</h3>
          <p class="mt-5 text-grijs">Lessen van 100 minuten. Eerst oefen je voor het examen voertuigbeheersing (AVB), daarna voor verkeersdeelneming (AVD). Tijdens dat examen zit je instructeur naast de examinator en hoor je de aanwijzingen via een ontvanger in je helm.</p>
          <blockquote class="mt-auto border-t border-lijn pt-8 max-md:mt-12">
            <p class="text-xl/snug">“Super goede instructeur. Mijn AVB- en AVD-examen allebei in één keer gehaald, met een minimaal aantal lessen. Uitleg is erg duidelijk en wordt goed voorgedaan.”</p>
            <footer class="mt-4 text-sm text-grijs">Lars, review op Google</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- Tarieven: pakket kiezen, bericht staat klaar -->
    <section id="tarieven" class="bg-vlak py-28 lg:py-40" aria-labelledby="t-tarieven">
      <div class="wrap grid gap-y-14 md:grid-cols-12 md:gap-x-8">
        <div class="md:col-span-4">
          <h2 id="t-tarieven" class="rijs text-3xl">Tarieven</h2>
          <p class="rijs mt-6 max-w-xs text-grijs" style="--d:.05s">Kies een pakket. Je bericht aan ons staat dan klaar in WhatsApp.</p>
          <div class="rijs mt-10 inline-grid grid-cols-2 border border-inkt" role="radiogroup" aria-label="Rijbewijs" data-soort-keuze style="--d:.1s">
            {soorten.map((s, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-soort={s} class="soort ui h-11 px-7">{tarieven[s].label}</button>
            ))}
          </div>
        </div>

        <div class="rijs md:col-span-8" style="--d:.1s">
          {soorten.map((s, i) => (
            <div data-paneel={s} hidden={i !== 0}>
              <fieldset>
                <legend class="sr-only">Pakketten {tarieven[s].label.toLowerCase()}</legend>
                <ul class="border-t border-inkt">
                  {tarieven[s].pakketten.map((p, j) => (
                    <li class="border-b border-lijn">
                      <label class="pakket grid cursor-pointer grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-6 sm:grid-cols-[8rem_1fr_auto]">
                        <input type="radio" name={`pakket-${s}`} value={j} checked={j === 2} class="sr-only" data-naam={p.naam} data-inhoud={p.inhoud} />
                        <span class="naam text-lg">{p.naam}</span>
                        <span class="col-span-2 row-start-2 text-sm text-grijs sm:col-span-1 sm:row-start-1 sm:col-start-2">{p.inhoud}</span>
                        <span class="num col-start-2 row-start-1 text-lg sm:col-start-3">€ {p.prijs}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
              <dl class="mt-12 grid gap-x-8 text-sm sm:grid-cols-2">
                {tarieven[s].los.map(([wat, prijs]) => (
                  <div class="flex justify-between gap-6 border-b border-lijn py-3">
                    <dt class="text-grijs">{wat}</dt>
                    <dd class="num">€ {prijs}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
          <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={waPakket('auto', eerste)} class="knop knop-vol" data-pakket-knop><span>Vraag naar <span data-pakket-naam>pakket C</span></span></a>
            <p class="text-sm text-grijs">Prijzen zoals op rijschoolherman.com.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Werkwijze -->
    <section id="werkwijze" class="wrap py-28 lg:py-40" aria-labelledby="t-werkwijze">
      <div class="grid gap-y-10 md:grid-cols-12 md:gap-x-8">
        <h2 id="t-werkwijze" class="rijs text-3xl md:col-span-7">De leerling staat centraal. Het is tenslotte jouw opleiding.</h2>
        <div class="rijs space-y-5 text-grijs md:col-span-4 md:col-start-9 md:pt-3" style="--d:.05s">
          <p>Elke les bouwen we zo op dat je er zoveel mogelijk uit haalt, en als het nodig is passen we de opleiding aan. Je lest nooit meer dan nodig om het examen te halen.</p>
          <p>De lesauto en -motor voldoen aan de CBR-eisen en zijn altijd schoon. Lesmateriaal is er op aanvraag.</p>
        </div>
      </div>

      <figure class="rijs mt-20 lg:mt-28">
        <Image src={lesautoVoor} alt="Voorkant van de lesauto met de HERMAN-plaat" widths={[440, 880]} sizes="(min-width: 1024px) 880px, 100vw" class="aspect-[16/9] w-full max-w-[55rem] bg-vlak object-cover sm:aspect-[880/242]" />
      </figure>

      <div class="mt-20 grid gap-y-12 border-t border-inkt pt-12 md:grid-cols-12 md:gap-x-8 lg:mt-28">
        <h3 class="rijs text-2xl md:col-span-4">Examen aanvragen</h3>
        <ol class="rijs stappen space-y-6 text-grijs md:col-span-5" style="--d:.05s">
          <li><span class="text-inkt">Theorie.</span> Vanaf 16 jaar mag je theorie-examen doen. Het certificaat is 1,5 jaar geldig.</li>
          <li><span class="text-inkt">Machtigen.</span> Log met je DigiD in op mijn.cbr.nl en vul bij opleider ons rijschoolnummer in. Dan vragen wij je examen aan.</li>
          <li><span class="text-inkt">Zelfreflectie.</span> Voor de tussentijdse toets en het praktijkexamen vul je het zelfreflectieformulier in en neem je het mee naar het CBR.</li>
        </ol>
        <div class="rijs md:col-span-3" style="--d:.1s">
          <p class="ui text-grijs" id="t-cbr">CBR-rijschoolnummer</p>
          <button type="button" class="cbr mt-3 flex flex-col items-start gap-2 text-left" data-kopieer={site.cbr} aria-describedby="t-cbr">
            <span class="num text-3xl tracking-[-0.02em]">{site.cbr}</span>
            <span class="ui text-grijs" data-kopieer-tekst>Kopieer</span>
          </button>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Auto/motor wisselen
  const knoppen = document.querySelectorAll<HTMLButtonElement>('[data-soort]');
  const panelen = document.querySelectorAll<HTMLElement>('[data-paneel]');
  const waKnop = document.querySelector<HTMLAnchorElement>('[data-pakket-knop]');
  const waNaam = document.querySelector<HTMLElement>('[data-pakket-naam]');
  let soort = 'auto';
  const bijwerken = () => {
    const gekozen = document.querySelector<HTMLInputElement>(`input[name="pakket-${soort}"]:checked`);
    if (!gekozen || !waKnop || !waNaam) return;
    const naam = (gekozen.dataset.naam || '').replace('Pakket', 'pakket');
    waNaam.textContent = naam;
    const tekst = `Hoi, ik heb interesse in ${soort}${naam} (${gekozen.dataset.inhoud}). Kunnen we een intakeles plannen?`;
    waKnop.href = waKnop.href.split('?')[0] + '?text=' + encodeURIComponent(tekst);
  };
  knoppen.forEach((k) => k.addEventListener('click', () => {
    soort = k.dataset.soort || 'auto';
    knoppen.forEach((b) => b.setAttribute('aria-checked', String(b === k)));
    panelen.forEach((p) => (p.hidden = p.dataset.paneel !== soort));
    bijwerken();
  }));
  document.querySelectorAll('input[name^="pakket-"]').forEach((r) => r.addEventListener('change', bijwerken));

  // Rijschoolnummer kopiëren
  const cbr = document.querySelector<HTMLButtonElement>('[data-kopieer]');
  const cbrTekst = document.querySelector<HTMLElement>('[data-kopieer-tekst]');
  cbr?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(cbr.dataset.kopieer || '');
      if (cbrTekst) { cbrTekst.textContent = 'Gekopieerd'; setTimeout(() => (cbrTekst.textContent = 'Kopieer'), 2000); }
    } catch { /* geen klembord: nummer staat er gewoon */ }
  });
</script>

<style>
  .soort { transition: background-color .3s, color .3s; }
  .soort[aria-checked='true'] { background: var(--color-inkt); color: var(--color-papier); }
  .soort:not([aria-checked='true']):hover { background: #14151610; }
  .pakket { position: relative; padding-left: 2rem; }
  .pakket::before { content: ''; position: absolute; left: 0; top: 2.375rem; width: .9rem; height: .9rem; margin-top: -.45rem; background: var(--color-blauw); transform: rotate(-9deg) scale(0); transition: transform .35s var(--ease-zacht); }
  .pakket:has(input:checked)::before { transform: rotate(-9deg) scale(1); }
  .pakket:hover .naam { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .pakket:has(input:focus-visible) { outline: 2px solid var(--color-blauw-diep); outline-offset: 2px; }
  .cbr:hover [data-kopieer-tekst] { color: var(--color-inkt); }
</style>
