<script>
  // Auto/motor wisselen en pakketkeuze omzetten in een WhatsApp-bericht.
  const knoppen = document.querySelectorAll<HTMLButtonElement>('[data-soort]');
  const panelen = document.querySelectorAll<HTMLElement>('[data-paneel]');
  const samenvatting = document.querySelector<HTMLElement>('[data-samenvatting]');
  const waKnop = document.querySelector<HTMLAnchorElement>('[data-pakket-knop]');
  const keuzeTekst = document.querySelector<HTMLElement>('[data-keuze-tekst]');
  let soort = 'auto';
  const bijwerken = () => {
    const gekozen = document.querySelector<HTMLInputElement>(`input[name="pakket-${soort}"]:checked`);
    if (!gekozen || !waKnop || !keuzeTekst) return;
    const naam = (gekozen.dataset.naam || '').replace('Pakket', 'pakket');
    keuzeTekst.textContent = `${soort === 'auto' ? 'Auto' : 'Motor'}, ${naam}`;
    const tekst = `Hoi, ik heb interesse in ${soort}${naam} (${gekozen.dataset.lessen} lessen van ${gekozen.dataset.duur} minuten). Kunnen we een intakeles plannen?`;
    waKnop.href = waKnop.href.split('?')[0] + '?text=' + encodeURIComponent(tekst);
  };
  knoppen.forEach((k) => k.addEventListener('click', () => {
    soort = k.dataset.soort || 'auto';
    knoppen.forEach((b) => b.setAttribute('aria-checked', String(b === k)));
    panelen.forEach((p) => (p.hidden = p.dataset.paneel !== soort));
    // De samenvatting verhuist mee naar het zichtbare paneel.
    const doel = document.querySelector<HTMLElement>(`[data-paneel="${soort}"] .grid.gap-8`);
    if (samenvatting && doel && samenvatting.parentElement !== doel) doel.appendChild(samenvatting);
    bijwerken();
  }));
  document.querySelectorAll('input[name^="pakket-"]').forEach((r) => r.addEventListener('change', bijwerken));

  // Rijschoolnummer kopiëren
  const cbr = document.querySelector<HTMLButtonElement>('[data-kopieer]');
  const cbrTekst = document.querySelector<HTMLElement>('[data-kopieer-tekst]');
  cbr?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(cbr.dataset.kopieer || '');
      if (cbrTekst) { cbrTekst.textContent = 'Gekopieerd'; setTimeout(() => (cbrTekst.textContent = 'Kopieer nummer'), 2000); }
    } catch { /* geen klembord: het nummer staat er gewoon */ }
  });

  // Contactformulier: bericht samenstellen en WhatsApp openen.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(f);
    const v = (n: string) => String(d.get(n) || '').trim();
    const r = ['Hoi Rijschool Herman,'];
    const rb = v('soort').startsWith('Motor') ? 'mijn motorrijbewijs (A)' : 'mijn autorijbewijs (B)';
    const wat = v('wat') === 'Iets anders vragen' ? 'iets vragen' : v('wat').toLowerCase();
    r.push(`Ik wil graag ${wat} voor ${rb}.`);
    if (v('wanneer')) r.push('Het liefst les: ' + v('wanneer').toLowerCase());
    if (v('wens')) r.push(v('wens'));
    if (v('naam')) r.push('Groet, ' + v('naam'));
    window.open('https://wa.me/31614660771?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
  });
</script>

