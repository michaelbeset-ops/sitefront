---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, chips, review, werkgebied, waIntake, waMet, tarieven } from '../data/site';
import kruispunt from '../assets/kruispunt.jpg';
import rijstroken from '../assets/rijstroken.jpg';
import lesauto from '../assets/lesauto.jpg';
import lesautoVoor from '../assets/lesauto-voor.jpg';
import lesmotor from '../assets/lesmotor.jpg';

const soorten = ['auto', 'motor'] as const;
const sterren = [1, 2, 3, 4, 5];
const pakketTekst = (soort: string, p: { naam: string; lessen: number; duur: number }) =>
  `Hoi, ik heb interesse in ${soort}${p.naam.replace('Pakket', 'pakket')} (${p.lessen} lessen van ${p.duur} minuten). Kunnen we een intakeles plannen?`;
const startPakket = tarieven.auto.pakketten[2];

const extra = [
  { icoon: 'l', t: 'Intakeles', d: 'Je rijdt eerst een intake. Daarna kunnen we aangeven welke opleiding bij je past; de keuze is aan jou.', p: 'Auto € 42,50, motor € 60,00' },
  { icoon: 'toets', t: 'Tussentijdse toets', d: 'Verloopt als een echt praktijkexamen. Je weet wat je te wachten staat en kunt vrijstelling halen voor de bijzondere verrichtingen.', p: 'Auto € 210,00, motor € 205,00' },
  { icoon: 'boek', t: 'Theorie-examen', d: 'Vanaf 16 jaar mag je theorie-examen doen. Het certificaat is 1,5 jaar geldig. Lesmateriaal is er op aanvraag.', p: 'CBR € 50,00' },
  { icoon: 'kalender', t: 'Vanaf 16,5 jaar', d: 'Rijles en een tussentijdse toets mogen vanaf 16,5 jaar, examen vanaf 17. Tot je 18e rijd je met een begeleider (2toDrive).', p: 'Rijbewijs B' },
];

const stappen = [
  ['Intakeles', 'Je rijdt een intake. Daarna adviseren we welke opleiding bij je past.'],
  ['Pakket kiezen', 'Een pakket of losse lessen. Zonder intake een pakket kiezen kan ook.'],
  ['Lessen', 'Auto 60 of 90 minuten, motor 100 minuten. Overdag, ’s&nbsp;avonds of in het weekend.'],
  ['Tussentijdse toets', 'Een oefenexamen bij het CBR, zodat je weet wat je kunt verwachten.'],
  ['Examen', 'Machtig ons op mijn.cbr.nl met ons rijschoolnummer. Dan vragen wij je examen aan.'],
];
---
<Base title="Rijschool Herman | Auto- en motorrijles in Ridderkerk" description="Auto- en motorrijschool in Ridderkerk. Rijles voor rijbewijs B en A, overdag, 's avonds of in het weekend. Pakketten vanaf € 750, intakeles via WhatsApp. 5,0 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <Image src={kruispunt} alt="" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" quality={62} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#14171b59_0%,#14171bc4_45%,#14171bf5_100%)] md:bg-[linear-gradient(90deg,#14171bf5_0%,#14171bd9_40%,#14171b4d_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-28 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Auto- en motorrijschool in Ridderkerk</p>
          <h1 id="t-hero" class="mt-5 text-hero">Niet meer lessen <span class="text-blauw-licht">dan nodig.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Rijles voor je rijbewijs B of A, in Ridderkerk en omgeving. Overdag, ’s&nbsp;avonds of in het weekend.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waIntake} class="knop knop-blauw"><Icoon naam="wa" />Plan een intakeles</a>
            <a href="#tarieven" class="knop knop-rand op-foto">Bekijk de tarieven</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-geel">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw-licht" />100% aanbevolen op Facebook</li>
            <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw-licht" />Rijbewijs B en A</li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto w-full max-w-[20rem] rounded-lg bg-licht/10 p-2.5 shadow-md ring-1 ring-licht/20 backdrop-blur-md">
            <Image src={lesautoVoor} alt="Voorkant van de lesauto met de gele HERMAN-plaat" widths={[440, 880]} sizes="300px" loading="eager" class="aspect-[16/11] w-full rounded-md object-cover object-[58%_50%]" />
            <figcaption class="flex items-center justify-between gap-3 px-2 pb-1 pt-3 text-sm">
              <span>De lesauto van Rijschool Herman</span>
              <a href={site.telHref} class="num whitespace-nowrap font-semibold text-licht no-underline hover:text-blauw-licht">{site.tel}</a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Lessen in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#lessen" class="shrink-0 rounded-md bg-ijs px-4 py-2 text-sm font-medium no-underline transition-colors hover:bg-blauw hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Lessen -->
    <section id="lessen" class="py-20 lg:py-24" aria-labelledby="t-lessen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Rijlessen</p>
            <h2 id="t-lessen" class="mt-4 text-3xl">Auto of motor, je leert het in Ridderkerk.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">In een lesauto en lesmotor die voldoen aan de CBR-eisen. Standaard schoon en van alle gemakken voorzien.</p>
        </div>

        <ul class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-2 lg:gap-6">
          <li class="rijs">
            <a href={waMet('Hoi, ik wil graag autorijles. Kunnen we een intakeles plannen?')} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
              <div class="relative overflow-hidden bg-vlak">
                <Image src={lesauto} alt="De lesauto, een grijze Volkswagen Golf met dakbord, op een parkeerterrein" widths={[440, 880]} sizes="(min-width: 1024px) 600px, 92vw" class="aspect-[880/300] w-full object-cover object-[50%_60%] transition-transform duration-700 group-hover:scale-[1.03]" />
                <span class="absolute left-4 top-4 rounded-md bg-nacht px-3 py-1 text-sm font-semibold text-licht">Rijbewijs B</span>
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-8">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="text-2xl">Autorijles</h3>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-ijs text-blauw transition-colors group-hover:bg-blauw group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
                <p class="mt-3 text-grijs">Lessen van 60 of 90 minuten. We raden 90 minuten aan: je oefent langer achter elkaar, onthoudt de lesstof beter en bent sneller klaar.</p>
                <ul class="mt-6 grid gap-2 text-[.9375rem] sm:grid-cols-2">
                  <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw" />Losse les vanaf € 47,50</li>
                  <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw" />Pakketten vanaf € 1.150</li>
                  <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw" />Tussentijdse toets</li>
                  <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw" />Vanaf 16,5 jaar</li>
                </ul>
              </div>
            </a>
          </li>
          <li class="rijs" style="--d:.06s">
            <a href={waMet('Hoi, ik wil graag motorrijles. Kunnen we een intakeles plannen?')} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
              <div class="relative overflow-hidden bg-vlak">
                <Image src={rijstroken} alt="" widths={[600, 900, 1200]} sizes="(min-width: 1024px) 600px, 92vw" quality={60} class="aspect-[880/300] w-full object-cover object-[50%_45%] transition-transform duration-700 group-hover:scale-[1.03]" />
                <span class="absolute left-4 top-4 rounded-md bg-nacht px-3 py-1 text-sm font-semibold text-licht">Rijbewijs A</span>
              </div>
              <div class="flex flex-1 flex-col p-6 sm:p-8">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="text-2xl">Motorrijles</h3>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-ijs text-blauw transition-colors group-hover:bg-blauw group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
                <p class="mt-3 text-grijs">Lessen van 100 minuten. Eerst oefen je voor het examen voertuigbeheersing (AVB), daarna voor verkeersdeelneming (AVD).</p>
                <ul class="mt-6 grid gap-2 text-[.9375rem] sm:grid-cols-2">
                  <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw" />Losse les € 80,00</li>
                  <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw" />Pakketten vanaf € 750</li>
                  <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw" />AVB en AVD</li>
                  <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-blauw" />Theorie in pakket C en D</li>
                </ul>
              </div>
            </a>
          </li>
        </ul>

        <ul class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:mt-6 lg:grid-cols-4 lg:gap-6">
          {extra.map((e, i) => (
            <li class="rijs kaart flex flex-col p-6 sm:p-7" style={`--d:${i * 0.05}s`}>
              <span class="grid h-12 w-12 place-items-center rounded-md bg-ijs text-blauw"><Icoon naam={e.icoon} class="h-6 w-6" /></span>
              <h3 class="mt-6 text-xl">{e.t}</h3>
              <p class="mt-2 flex-1 text-[.9375rem] text-grijs">{e.d}</p>
              <p class="num mt-5 border-t border-lijn pt-4 text-sm font-semibold">{e.p}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col pr-4"><dt class="text-sm text-grijs">Score op Google</dt><dd class="cijfer order-first text-blauw">{site.google.score}</dd></div>
        <div class="flex flex-col pr-4 lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Aanbevolen op Facebook</dt><dd class="cijfer order-first">100%</dd></div>
        <div class="flex flex-col pr-4 lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">AVB-motorexamen in één keer gehaald (CBR-cijfers via Clickdrive)</dt><dd class="cijfer order-first">97%</dd></div>
        <div class="flex flex-col pr-4 lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Plaatsen in het werkgebied, daarbuiten op verzoek</dt><dd class="cijfer order-first">{werkgebied.length}</dd></div>
      </dl>
    </section>

    <!-- 5. Tarieven: pakket kiezen, bericht staat klaar -->
    <section id="tarieven" class="bg-vlak py-20 lg:py-24" aria-labelledby="t-tarieven">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Tarieven</p>
            <h2 id="t-tarieven" class="mt-4 text-3xl">Kies je pakket. Je bericht staat klaar.</h2>
          </div>
          <div class="rijs lg:col-span-5 lg:justify-self-end" style="--d:.05s">
            <div class="inline-grid grid-cols-2 rounded-lg bg-wit p-1.5 shadow-sm" role="radiogroup" aria-label="Rijbewijs">
              {soorten.map((s, i) => (
                <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-soort={s} class="soort flex h-12 items-center justify-center gap-2 rounded-md px-6 font-semibold sm:px-8"><Icoon naam={s} class="h-5 w-5" />{tarieven[s].label} <span class="font-normal opacity-70">({tarieven[s].rijbewijs})</span></button>
              ))}
            </div>
          </div>
        </div>

        {soorten.map((s, i) => (
          <div data-paneel={s} hidden={i !== 0}>
            <fieldset class="mt-12 lg:mt-14">
              <legend class="sr-only">Pakketten {tarieven[s].label.toLowerCase()}</legend>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
                {tarieven[s].pakketten.map((p, j) => (
                  <label class="pakket kaart relative flex cursor-pointer flex-col p-6 transition-shadow hover:shadow-md sm:p-7">
                    <input type="radio" name={`pakket-${s}`} value={j} checked={j === 2} class="sr-only" data-naam={p.naam} data-lessen={p.lessen} data-duur={p.duur} />
                    <span class="flex items-center justify-between gap-3">
                      <span class="font-kop text-lg font-bold [font-stretch:110%]">{p.naam}</span>
                      <span class="bolletje" aria-hidden="true"></span>
                    </span>
                    <span class="mt-6 flex items-baseline gap-2"><span class="num font-kop text-[3.25rem] font-extrabold leading-none tracking-[-0.04em] [font-stretch:105%]">{p.lessen}</span><span class="text-grijs">lessen van {p.duur} min.</span></span>
                    <span class="mt-1 text-sm text-grijs">{Math.round((p.lessen * p.duur) / 60)} uur rijles</span>
                    <ul class="mt-5 flex-1 space-y-1.5 border-t border-lijn pt-5 text-[.9375rem]">
                      {p.extra.map((x) => <li class="flex items-start gap-2"><Icoon naam="vink" class="mt-1 h-4 w-4 shrink-0 text-blauw" />{x}</li>)}
                    </ul>
                    <span class="num prijs mt-6 font-kop text-3xl font-extrabold tracking-[-0.03em] [font-stretch:105%]">€ {p.prijs}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:gap-10">
              <div class="kaart p-6 sm:p-8 lg:col-span-7">
                <h3 class="text-xl">Losse lessen en examens, {tarieven[s].label.toLowerCase()}</h3>
                <dl class="mt-4 grid gap-x-8 text-[.9375rem] sm:grid-cols-2">
                  {tarieven[s].los.map(([wat, prijs]) => (
                    <div class="flex justify-between gap-6 border-b border-lijn py-3">
                      <dt class="text-grijs">{wat}</dt>
                      <dd class="num font-semibold">€ {prijs}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              {i === 0 && (
                <div class="donker flex flex-col justify-between gap-6 rounded-lg bg-nacht p-6 text-licht sm:p-8 lg:col-span-5 lg:row-span-1" data-samenvatting>
                  <div>
                    <p class="eyebrow">Jouw keuze</p>
                    <p class="mt-3 font-kop text-2xl font-bold [font-stretch:110%]" data-keuze-tekst>Auto, pakket C</p>
                    <p class="mt-2 text-licht-zacht">Wij maken er een WhatsApp-bericht van. Er gaat pas iets weg als je zelf op verzenden drukt.</p>
                  </div>
                  <a href={waMet(pakketTekst('auto', startPakket))} class="knop knop-blauw self-start" data-pakket-knop><Icoon naam="wa" />Vraag naar dit pakket</a>
                </div>
              )}
            </div>
          </div>
        ))}
        <p class="mt-8 text-sm text-grijs">Prijzen zoals op rijschoolherman.com. Afkortingen: AVB is voertuigbeheersing, AVD is verkeersdeelneming.</p>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20 lg:py-24" aria-labelledby="t-werkwijze">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo gaat het</p>
            <h2 id="t-werkwijze" class="mt-4 text-3xl">Van intakeles tot rijbewijs.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">De duur van je opleiding bepaal je zelf. Wij zeggen eerlijk wat je nodig hebt.</p>
        </div>
        <ol class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-5">
          {stappen.map(([t, d], i) => (
            <li class={`rijs kaart p-5 sm:p-7 ${i === 4 ? 'col-span-2 lg:col-span-1' : ''}`} style={`--d:${i * 0.05}s`}>
              <p class="num font-kop text-lg font-extrabold text-blauw">0{i + 1}</p>
              <h3 class="mt-5 text-[1.0625rem] hyphens-auto sm:mt-8 sm:text-xl">{t}</h3>
              <p class="mt-2 text-sm text-grijs sm:mt-3 sm:text-base">{d}</p>
            </li>
          ))}
        </ol>

        <div class="rijs mt-8 grid overflow-hidden rounded-lg bg-wit shadow-sm outline outline-1 -outline-offset-1 outline-lijn lg:grid-cols-12">
          <div class="flex items-center justify-center bg-nacht px-6 py-10 lg:col-span-5">
            <p class="kenteken" aria-hidden="true"><span class="nl">NL</span><span class="num">{site.cbr}</span></p>
          </div>
          <div class="flex flex-col justify-center gap-6 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8 lg:col-span-7 lg:px-10">
            <div>
              <h3 class="text-2xl" id="t-cbr">Machtig ons bij het CBR</h3>
              <p class="mt-3 max-w-md text-[.9375rem] text-grijs">Log met DigiD in op mijn.cbr.nl en vul bij opleider ons rijschoolnummer <b class="num font-semibold text-inkt">{site.cbr}</b> in. De machtiging blijft geldig tot je geslaagd bent.</p>
            </div>
            <button type="button" class="knop knop-inkt knop-klein shrink-0" data-kopieer={site.cbr} aria-describedby="t-cbr"><Icoon naam="kopieer" /><span data-kopieer-tekst>Kopieer nummer</span></button>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Over de rijschool -->
    <section id="over" class="donker bg-nacht text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[20rem] sm:min-h-[26rem] lg:col-span-5">
          <Image src={lesmotor} alt="De lesmotor van Rijschool Herman, een witte Honda, voor een grijze bakstenen gevel" widths={[480, 720]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_62%]" />
          <p class="absolute bottom-4 left-4 rounded-md bg-blauw px-4 py-1.5 text-sm font-semibold text-wit">De lesmotor</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Rijschool Herman</p>
          <h2 id="t-over" class="mt-4 text-3xl">Het is tenslotte jouw opleiding.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Bij Rijschool Herman staat de leerling centraal. We bouwen elke les zo op dat je er zoveel mogelijk uit haalt, en passen de opleiding aan als dat nodig is. Het doel: dat je een veilige, sociaal verantwoorde en milieubewuste verkeersdeelnemer wordt. Dan haal je je examen ook.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="schild" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Niet meer lessen dan nodig</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Je lest nooit meer dan nodig om het examen te halen. Kwaliteit in de les staat voorop.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="glans" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Schone lesauto en lesmotor</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Volgens de CBR-eisen, standaard schoon en van alle gemakken voorzien.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="klok" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Lessen wanneer het jou uitkomt</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Overdag, in de avond of in het weekend.</p></div>
            </li>
          </ul>
