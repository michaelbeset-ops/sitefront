<script>
  const nummer = '31651305242';
  const w = document.querySelector<HTMLFormElement>('[data-wijzer]');
  if (w) {
    const label = w.querySelector<HTMLElement>('[data-w-label]')!;
    const prijs = w.querySelector<HTMLElement>('[data-w-prijs]')!;
    const va = w.querySelector<HTMLElement>('[data-w-va]')!;
    const zet = () => {
      const r = w.querySelector<HTMLInputElement>('input[name=maat]:checked');
      if (!r) return;
      const kat = r.value === 'kat';
      label.textContent = kat ? 'Kat trimmen' : r.dataset.label!.replace(/^./, (c) => c.toUpperCase());
      prijs.textContent = `€ ${r.dataset.prijs}`;
      va.hidden = kat;
    };
    w.addEventListener('change', zet);
    zet();
    w.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = w.querySelector<HTMLInputElement>('input[name=maat]:checked');
      const ras = String(new FormData(w).get('ras') || '').trim();
      const regels = ['Hoi Esther, ik wil graag een trimafspraak maken.'];
      if (r?.value === 'kat') regels.push('Het gaat om een kat.');
      else if (r) regels.push(`Schofthoogte van mijn hond: ${r.dataset.label!.replace('schofthoogte ', '')} (v.a. € ${r.dataset.prijs}).`);
      if (ras) regels.push('Ras/vacht: ' + ras);
      regels.push('Wat kost dat ongeveer, en wanneer is er plek?');
      window.open(`https://wa.me/${nummer}?text=${encodeURIComponent(regels.join('\n'))}`, '_blank', 'noopener');
    });
  }

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = [`Hoi Esther, ik heb een vraag over: ${v('wat').toLowerCase()}.`];
      if (v('dier')) r.push('Mijn dier: ' + v('dier'));
      if (v('wens')) r.push(v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open(`https://wa.me/${nummer}?text=${encodeURIComponent(r.join('\n'))}`, '_blank', 'noopener');
    });
  }
</script>

