---
import { site, url, waAfspraak } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <span class="merk-teken" aria-hidden="true"></span>
        <span><b>Esther</b><small class="text-licht-zacht">Hondentrimsalon</small></span>
      </a>
      <p class="mt-6 max-w-xs">Trimsalon voor honden en katten in Krimpen aan den IJssel. Ook gedragstherapie voor honden en puppytraining.</p>
      <p class="mt-6">
        <a href={site.instagram} class="inline-grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-salie" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        <li><a href={h('trimmen')} class="no-underline transition-colors hover:text-licht">Honden trimmen</a></li>
        <li><a href={h('tarieven')} class="no-underline transition-colors hover:text-licht">Katten trimmen</a></li>
        <li><a href={h('gedragstherapie')} class="no-underline transition-colors hover:text-licht">Gedragstherapie</a></li>
        <li><a href={h('puppytraining')} class="no-underline transition-colors hover:text-licht">Puppytraining</a></li>
        <li><a href={h('tarieven')} class="no-underline transition-colors hover:text-licht">Tarieven</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-licht">{site.tel}</a></li>
        <li><a href={waAfspraak} class="no-underline transition-colors hover:text-licht">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="no-underline transition-colors [overflow-wrap:anywhere] hover:text-licht">{site.mail}</a></li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-2">
      <p class="font-semibold text-licht">Adres</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-2">Op afspraak</p>
      <p class="mt-2"><a href={site.maps} class="no-underline transition-colors hover:text-licht">Route plannen</a></p>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw Google-bedrijfsprofiel, Instagram en huidige website, ter illustratie. Reviews letterlijk van Google (stand 3 oktober 2026).</p>}
  </div>
</footer>
