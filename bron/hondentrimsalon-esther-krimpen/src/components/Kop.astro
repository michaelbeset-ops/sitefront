---
import { url, waAfspraak, site } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['trimmen', 'Trimmen'], ['tarieven', 'Tarieven'], ['gedragstherapie', 'Gedragstherapie'], ['puppytraining', 'Puppytraining'], ['over', 'Over Esther'], ['contact', 'Contact']];
---
<header class="sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-md">
  <div class="wrap flex h-[4.75rem] items-center justify-between gap-6">
    <a href={url('')} class="merk">
      <span class="merk-teken text-inkt" aria-hidden="true"></span>
      <span><b>Esther</b><small class="text-salie">Hondentrimsalon</small></span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden xl:block">
      <ul class="flex gap-6 whitespace-nowrap text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-salie">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={site.telHref} class="num hidden items-center gap-2 font-semibold no-underline transition-colors hover:text-salie 2xl:inline-flex"><Icoon naam="tel" class="h-4 w-4 text-salie" />{site.tel}</a>
      <a href={waAfspraak} class="knop knop-salie knop-klein hidden sm:inline-flex"><Icoon naam="wa" />Afspraak maken</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-md bg-wit shadow-sm outline outline-1 -outline-offset-1 outline-lijn xl:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu" aria-label="Menu" class="hidden border-t border-lijn bg-papier xl:hidden" data-menu>
    <ul class="wrap py-4">
      {nav.map(([id, t]) => <li><a href={h(id)} class="flex items-center justify-between border-b border-lijn py-3.5 text-xl font-bold tracking-tight no-underline">{t}<Icoon naam="pijl" class="h-5 w-5 text-salie" /></a></li>)}
      <li class="pt-5"><a href={waAfspraak} class="knop knop-salie w-full"><Icoon naam="wa" />Afspraak via WhatsApp</a></li>
    </ul>
  </nav>
</header>

<!-- Mobiele onderbalk -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2.5 border-t border-lijn bg-papier/95 p-2.5 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="knop knop-wit knop-klein shadow-sm outline outline-1 -outline-offset-1 outline-lijn"><Icoon naam="tel" />Bellen</a>
  <a href={waAfspraak} class="knop knop-salie knop-klein"><Icoon naam="wa" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
