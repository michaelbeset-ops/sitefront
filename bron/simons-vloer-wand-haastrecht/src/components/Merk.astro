---
// Woordmerk naar hun logo: twee grijze vlakken, een zwart vlak met de S, dan IMONS en "vloer & wand".
import { url, site } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class={`merk ${cls}`}>
  <span class="merk-blokken" aria-hidden="true"><i></i><i></i><span class="merk-s">S</span></span>
  <span><b><span class="sr-only">S</span>IMONS</b><small>vloer &amp; wand</small></span>
</a>
