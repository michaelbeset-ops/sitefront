<script>
  const WA = 'https://wa.me/31626770141?text=';
  const open = (r: string[]) => window.open(WA + encodeURIComponent(r.join('\n')), '_blank', 'noopener');

  // Patronenkiezer: tabs met pijltjestoetsen, en het gekozen patroon gaat mee in het bericht.
  const kiezer = document.querySelector<HTMLElement>('[data-kiezer]');
  if (kiezer) {
    const tabs = [...kiezer.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panelen = [...kiezer.querySelectorAll<HTMLElement>('[data-paneel]')];
    const veld = kiezer.querySelector<HTMLInputElement>('input[name=patroon]')!;
    const kies = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((b) => { const ja = b === t; b.setAttribute('aria-selected', String(ja)); b.tabIndex = ja ? 0 : -1; });
      panelen.forEach((p) => { p.hidden = p.dataset.paneel !== t.dataset.tab; });
      veld.value = t.querySelector('span:last-child')?.textContent || '';
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => kies(t));
      t.addEventListener('keydown', (e) => {
        const n = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (n) { e.preventDefault(); kies(tabs[(i + n + tabs.length) % tabs.length], true); }
      });
    });
    const pf = kiezer.querySelector<HTMLFormElement>('[data-patroon-form]')!;
    pf.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(pf);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hallo Rik, ik wil graag advies over een nieuwe vloer.', 'Patroon: ' + v('patroon'), 'Ruimte: ' + v('ruimte')];
      if (v('m2')) r.push('Ongeveer ' + v('m2') + ' m²');
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      open(r);
    });
  }

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hallo Rik, ik wil graag advies en een prijsopgave.'];
      if (v('klus')) r.push('Het gaat om: ' + v('klus'));
      if (v('m2')) r.push('Ongeveer ' + v('m2') + ' m²');
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('wens')) r.push('Toelichting: ' + v('wens'));
      if (d.get('showroom')) r.push('Ik kom graag langs in de showroom.');
      if (v('naam')) r.push('Groet, ' + v('naam'));
      open(r);
    });
  }
</script>

