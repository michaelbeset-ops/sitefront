---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Patroon from '../components/Patroon.astro';
import { site, tijden, chips, review, waAfspraak, waMet } from '../data/site';
import weensePunt from '../assets/weense-punt.jpg';
import visgraatHal from '../assets/visgraat-hal.jpg';
import paneelvloer from '../assets/paneelvloer.jpg';
import patroonvloer from '../assets/patroonvloer.jpg';
import tuinhuis from '../assets/tuinhuis.jpg';
import werkReeuwijk from '../assets/werk-reeuwijk.jpg';
import houtTegels from '../assets/hout-tegels.jpg';
import trap from '../assets/trap.jpg';
import renovatie from '../assets/renovatie.jpg';
import hongaarsePunt from '../assets/hongaarse-punt.jpg';
import betondesign from '../assets/betondesign.jpg';
import erik from '../assets/erik.jpg';
import rik from '../assets/rik.jpg';
import beker from '../assets/beker.jpg';
import showroom from '../assets/showroom.jpg';
import igEetkamer from '../assets/ig-eetkamer.jpg';
import igHongaars from '../assets/ig-hongaarse-punt.jpg';
import igBies from '../assets/ig-visgraat-bies.jpg';

const vraag = (b: string) => waMet(`Hallo Rik, ik heb een vraag over ${b.toLowerCase()}.`);

const diensten = [
  { t: 'Parket en patroonvloeren', k: 'Massief, tapis', d: 'Visgraat, Hongaarse punt, Versailles, blokpatroon of een patroon dat u zelf tekent. Onze specialisatie.', src: visgraatHal, alt: 'Eiken visgraatvloer in een hal met twee openslaande deuren', pos: '50% 60%', groot: true },
  { t: 'Restauratie en renovatie', k: 'Bestaande vloeren', d: 'Aanhelen, schuren en een afwerking naar keuze.', src: renovatie, alt: 'Een eiken vloer tijdens het schuren: de helft is al licht en kaal, de rest nog donker', pos: '50% 50%' },
  { t: 'Trappen', k: 'Hout, PVC of laminaat', d: 'Een versleten trap binnen een dag weer als nieuw.', src: trap, alt: 'Een dichte trap met lichte eiken treden langs een witte wand met wandlampjes', pos: '50% 50%' },
  { t: 'Lamelparket en PVC', k: 'Planken en brede delen', d: 'Stabiel lamelparket, of stille en waterdichte PVC.', src: tuinhuis, alt: 'Eiken plankenvloer in een tuinhuis met een glazen pui en een bakstenen bank', pos: '50% 70%' },
  { t: 'Tegels en plavuizen', k: 'Naadloos naar hout', d: 'Naadloos en op exact dezelfde hoogte als het hout.', src: houtTegels, alt: 'Keuken met groene kastjes: een eiken plankenvloer gaat over in groen-witte tegeltjes', pos: '50% 55%' },
];

const patronen = [
  { id: 'visgraat', t: 'Visgraat', d: 'Korte stroken die haaks tegen elkaar liggen. Klassiek, en met een bies van noten extra mooi.', voorbeeld: 'Visgraat met een bies van donker hout, strak langs het kozijn gelegd.', src: igBies, alt: 'Eiken visgraat met een donkere bies langs een deurkozijn' },
  { id: 'hongaars', t: 'Hongaarse punt', d: 'De stroken zijn schuin afgezaagd en vormen één doorlopende punt. Rustiger dan visgraat.', voorbeeld: 'Traditioneel tapisparket: met dit onderdeel werd Rik Simons Nederlands Kampioen.', src: hongaarsePunt, alt: 'Lichte eiken vloer in Hongaarse punt in een strak wit interieur' },
  { id: 'weens', t: 'Weense punt', d: 'Een Hongaarse punt met banden ertussen. Statig, voor grotere ruimtes.', voorbeeld: 'Weense punt met noten bies en liggende band, licht verouderd en grijs geolied. Den Haag.', src: weensePunt, alt: 'Woonkamer met een eiken Weense punt, een rode deur en een zachte bank' },
  { id: 'panelen', t: 'Panelen en Versailles', d: 'Vierkante panelen met een ingelegd motief. Echt ambachtelijk werk.', voorbeeld: 'Een 9 mm eiken paneelvloer op vloerverwarming, na het leggen geschuurd en geolied. Bergambacht.', src: paneelvloer, alt: 'Lichte eiken paneelvloer met een ruitvormig motief in het zonlicht' },
  { id: 'eigen', t: 'Eigen ontwerp', d: 'Een patroon dat u zelf uittekent, of samen met ons. Rik blinkt uit in bijzondere patronen.', voorbeeld: 'Een unieke patroonvloer met zeshoekige motieven in eiken.', src: patroonvloer, alt: 'Eiken patroonvloer met zeshoekige vlakken naast een plankenvloer' },
  { id: 'planken', t: 'Planken en brede delen', d: 'Massief of lamel, smal of breed. Tijdloos en rustig in elk huis.', voorbeeld: 'Eerst Belgisch hardstenen dorpels, daarna de houten vloer. Tuinhuis in Reeuwijk.', src: tuinhuis, alt: 'Eiken plankenvloer in een tuinhuis' },
];

const projecten = [
  { src: paneelvloer, alt: 'Lichte eiken paneelvloer met ruitmotief', t: 'Paneelvloer', p: 'Bergambacht', groot: true },
  { src: weensePunt, alt: 'Eiken Weense punt in een woonkamer', t: 'Weense punt', p: 'Den Haag' },
  { src: igEetkamer, alt: 'Eetkamer met een houten tafel op een lichte visgraatvloer', t: 'Visgraat in de eetkamer', p: '' },
  { src: tuinhuis, alt: 'Plankenvloer in een tuinhuis met glazen pui', t: 'Tuinhuis', p: 'Reeuwijk' },
  { src: igHongaars, alt: 'Ruime kamer met donkere wanden en een eiken Hongaarse punt', t: 'Hongaarse punt', p: '' },
];

const stappen = [
  ['Bel of app', 'Maak een afspraak voor de showroom. Ook buiten de openingstijden is een afspraak mogelijk.'],
  ['Advies in de showroom', 'Vrijblijvend persoonlijk advies over hout, patroon en afwerking, en een prijsopgave.'],
  ['Leggen of herstellen', 'Nieuw parket of uw bestaande vloer aanhelen. Schuren doen we stofvrij.'],
  ['Afwerking naar keuze', 'Lakken of oliën, in de kleur die u wilt. We gaan pas weg als we zelf helemaal tevreden zijn.'],
];
---
<Base title={`${site.naam} | Meesterparketteur in Haastrecht`} description="Familiebedrijf sinds 1996 in Haastrecht. Parket en patroonvloeren als visgraat en Hongaarse punt, restauratie van bestaande vloeren en trappen, PVC en tegels. Nederlands Kampioen parketleggen 2012.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: hun eigen Weense punt op volle hoogte -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={weensePunt} alt="" widths={[640, 960, 1440]} sizes="100vw" quality={68} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[85%_90%] md:object-[66%_72%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#17171633_0%,#171716b3_42%,#171716f5_100%)] md:bg-[linear-gradient(90deg,#171716f2_0%,#171716c4_45%,#17171622_100%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-28 md:pb-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Meesterparketteur in Haastrecht</p>
          <h1 id="t-hero" class="mt-6 text-hero">Vakwerk in hout, <span class="text-salie">van vader op zoon.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Visgraat, Hongaarse punt en Versailles. En bestaande parketvloeren en trappen een nieuw leven geven. Familiebedrijf sinds 1996.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-groen"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-2.5 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2"><Icoon naam="beker" class="h-4 w-4 text-salie" />Nederlands Kampioen 2012</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Showroom op afspraak</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <figure class="ml-auto flex w-full max-w-[21rem] items-stretch gap-4 rounded-md bg-nacht/70 p-3 shadow-md ring-1 ring-licht/15 backdrop-blur-md">
            <Image src={beker} alt="De zilveren beker van het Nederlands Kampioenschap parketleggen, op een visgraatvloer" widths={[200, 320]} sizes="110px" loading="eager" class="aspect-[3/5] w-[6.5rem] shrink-0 rounded-sm object-cover object-[50%_40%]" />
            <figcaption class="flex flex-col justify-between py-1 pr-1 text-sm">
              <span><b class="block text-[1.0625rem] font-extrabold leading-snug text-licht">Nederlands Kampioen parketleggen 2012</b><span class="mt-2 block text-licht-zacht">Rik Simons, meesterparketteur. Vierde op het Europees Kampioenschap.</span></span>
              <a href="#over-ons" class="mt-3 inline-flex items-center gap-1.5 font-bold text-salie no-underline hover:text-licht">Over ons<Icoon naam="pijl" class="h-4 w-4" /></a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Assortiment in het kort">
      <div class="wrap flex items-center gap-x-2.5 gap-y-2.5 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#vloeren" class="shrink-0 rounded-sm border border-lijn bg-kalk px-3.5 py-2 text-sm font-semibold no-underline transition-colors hover:border-groen hover:bg-groen hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Wat we doen -->
    <section id="vloeren" class="py-16 lg:py-20" aria-labelledby="t-vloeren">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Vloeren, trappen en wanden</p>
            <h2 id="t-vloeren" class="mt-5 text-3xl">Onze passie ligt bij het werken met hout.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Van een nieuwe patroonvloer tot het opknappen van uw oude parket. Wij denken graag met u mee voor een advies op maat.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-12 lg:gap-5">
          {diensten.map((b, i) => (
            <li class={`rijs ${b.groot ? 'sm:col-span-2 lg:col-span-6 lg:row-span-2 lg:min-h-[42rem]' : 'lg:col-span-3'}`} style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="group relative isolate flex h-full min-h-[19rem] flex-col justify-end overflow-hidden rounded-md bg-nacht text-licht no-underline shadow-sm sm:min-h-[20rem]">
                <Image src={b.src} alt={b.alt} widths={b.groot ? [600, 900, 1200] : [400, 600]} sizes={b.groot ? '(min-width: 1024px) 600px, 92vw' : '(min-width: 1024px) 290px, (min-width: 640px) 46vw, 92vw'} class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#17171600_25%,#171716d9_72%,#171716f2_100%)]" aria-hidden="true"></span>
                <span class="absolute left-3 top-3 rounded-xs bg-kalk/95 px-2.5 py-1 text-xs font-bold uppercase tracking-[.12em] text-groen">{b.k}</span>
                <div class="flex items-end justify-between gap-4 p-5 sm:p-6">
                  <div>
                    <h3 class={b.groot ? 'text-[clamp(1.625rem,1.4vw+1.1rem,2.25rem)]' : 'text-xl'}>{b.t}</h3>
                    <p class={`mt-2 leading-normal text-licht/85 ${b.groot ? 'max-w-md text-[1.0625rem]' : 'text-[.9375rem]'}`}>{b.d}</p>
                  </div>
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-sm bg-licht/15 text-licht backdrop-blur-sm transition-colors group-hover:bg-groen" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
          <li class="rijs sm:col-span-2 lg:col-span-12">
            <a href={vraag('wanden')} class="kaart group grid overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md md:grid-cols-12">
              <div class="relative overflow-hidden md:col-span-5">
                <Image src={betondesign} alt="Strakke betonlook-vloer in een woonkamer met een zwarte trap met eiken treden" widths={[500, 800, 1000]} sizes="(min-width: 768px) 40vw, 92vw" class="aspect-[16/10] h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                <span class="absolute left-3 top-3 rounded-xs bg-kalk/95 px-2.5 py-1 text-xs font-bold uppercase tracking-[.12em] text-groen">Vloer en wand</span>
              </div>
              <div class="flex flex-col justify-center gap-6 p-6 md:col-span-7 md:p-10">
                <div>
                  <h3 class="text-2xl">Wanden: BetonDesign, Woodbricks en kokosmozaïek</h3>
                  <p class="mt-3 text-grijs">Wanden zijn even belangrijk als de vloer: samen geven ze de uitstraling die u wilt. Daarom de naam Vloer &amp; Wand.</p>
                </div>
                <dl class="grid gap-4 text-[.9375rem] sm:grid-cols-3">
                  <div class="border-t-2 border-groen pt-3"><dt class="font-bold">BetonDesign</dt><dd class="mt-1 text-grijs">Betonlook van Forbo, voor vloer en wand. Laag van 1 tot 1,5 mm.</dd></div>
                  <div class="border-t-2 border-groen pt-3"><dt class="font-bold">Woodbricks</dt><dd class="mt-1 text-grijs">Eiken op een multiplex basis, onzichtbaar bevestigd. Standaard in 4 kleuren, andere op aanvraag.</dd></div>
                  <div class="border-t-2 border-groen pt-3"><dt class="font-bold">Ekobe kokosmozaïek</dt><dd class="mt-1 text-grijs">Van de schil van de kokosnoot. Erik is sinds 2010 agent van Ekobe.</dd></div>
                </dl>
              </div>
            </a>
          </li>
        </ul>
        <div class="rijs mt-5 grid gap-4 md:grid-cols-2 lg:gap-5">
          <div class="flex flex-col justify-between gap-5 rounded-md bg-steen p-6 md:p-8">
            <div>
              <h3 class="text-xl">Onderhoud, waterschade en taxatie</h3>
              <p class="mt-2 text-grijs">Ook voor onderhoud kunt u bij ons terecht. Schade aan de vloer taxeren en herstellen wij voor u.</p>
            </div>
            <a href={vraag('onderhoud of schade aan mijn vloer')} class="knop knop-inkt knop-klein self-start"><Icoon naam="wa" />Stel uw vraag</a>
          </div>
          <div class="flex flex-col justify-between gap-5 rounded-md bg-steen p-6 md:p-8">
            <div>
              <h3 class="text-xl">Parket op vloerverwarming of vloerkoeling</h3>
              <p class="mt-2 text-grijs">Steeds meer klanten kiezen voor die combinatie. Wat kan wel en wat is verstandig? In de showroom leggen we het graag uit.</p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href={vraag('parket op vloerverwarming')} class="knop knop-inkt knop-klein"><Icoon naam="wa" />Vraag het ons</a>
              <a href={site.brochures} class="knop knop-rand knop-klein">Brochures van Lieverdink</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-grijs">Opgericht door Erik Simons</dt><dd class="num order-first text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.045em]">1996</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Nederlands Kampioen parketleggen</dt><dd class="num order-first text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.045em] text-groen">2012</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Plaats op het Europees Kampioenschap</dt><dd class="num order-first text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.045em]">4e</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="mt-2 text-sm text-grijs">Score op Google</dt><dd class="num order-first text-[clamp(2.75rem,3vw+1.5rem,3.75rem)] font-extrabold leading-none tracking-[-0.045em]">{site.google.score}</dd></div>
      </dl>
    </section>

    <!-- 5. Patronenkiezer -->
    <section id="patronen" class="donker bg-nacht py-16 text-licht lg:py-20" aria-labelledby="t-patronen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Kies uw patroon</p>
            <h2 id="t-patronen" class="mt-5 text-3xl">Welk patroon past bij uw huis?</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Klik een patroon aan en zie hoe wij het eerder legden. Vul de ruimte in, dan maken we er een WhatsApp-bericht van.</p>
        </div>

        <div class="mt-12 grid gap-6 lg:mt-14 lg:grid-cols-12 lg:gap-8" data-kiezer>
          <div class="lg:col-span-4" role="tablist" aria-label="Patronen">
            <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-1">
              {patronen.map((p, i) => (
                <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`paneel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={p.id} class="patroon-tab group flex items-center gap-3.5 rounded-sm bg-nacht-2 p-2.5 text-left transition-colors">
                  <span class="grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-xs bg-licht/5 text-licht-zacht"><Patroon naam={p.id} class="h-12 w-12" /></span>
                  <span class="text-[.9375rem] font-bold leading-tight">{p.t}</span>
                </button>
              ))}
            </div>
          </div>
          <div class="lg:col-span-8">
            {patronen.map((p, i) => (
              <div id={`paneel-${p.id}`} role="tabpanel" aria-labelledby={`tab-${p.id}`} data-paneel={p.id} hidden={i !== 0} class="grid overflow-hidden rounded-md bg-nacht-2 md:grid-cols-2">
                <Image src={p.src} alt={p.alt} widths={[400, 700, 900]} sizes="(min-width: 1024px) 420px, (min-width: 768px) 46vw, 92vw" class="aspect-[4/3] h-full w-full object-cover md:aspect-auto md:min-h-[26rem]" />
                <div class="flex flex-col p-6 md:p-8">
                  <h3 class="text-2xl">{p.t}</h3>
                  <p class="mt-3 text-licht-zacht">{p.d}</p>
                  <p class="mt-5 border-l-2 border-salie pl-4 text-[.9375rem] italic text-licht/90">{p.voorbeeld}</p>
                </div>
              </div>
            ))}
            <form class="mt-4 grid gap-4 rounded-md bg-licht p-5 text-inkt sm:grid-cols-[1fr_1fr_1fr_auto] sm:items-end md:p-6" data-patroon-form>
              <input type="hidden" name="patroon" value={patronen[0].t} />
              <label class="block"><span class="text-sm font-bold">Ruimte</span>
                <select name="ruimte" class="veld mt-1.5">
                  <option>Woonkamer</option><option>Hal</option><option>Keuken</option><option>Slaapkamer</option><option>Hele verdieping</option><option>Trap</option>
                </select>
              </label>
              <label class="block"><span class="text-sm font-bold">Ongeveer m²</span><input name="m2" inputmode="numeric" class="veld mt-1.5" placeholder="bijv. 40" /></label>
              <label class="block"><span class="text-sm font-bold">Plaats</span><input name="plaats" autocomplete="address-level2" class="veld mt-1.5" placeholder="bijv. Gouda" /></label>
              <button type="submit" class="knop knop-groen"><Icoon naam="wa" /><span>Vraag advies</span></button>
            </form>
            <p class="mt-3 text-sm text-licht-zacht">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Projecten -->
    <section id="projecten" class="py-16 lg:py-20" aria-labelledby="t-projecten">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Recente projecten</p>
            <h2 id="t-projecten" class="mt-5 text-3xl">Gelegd in de Krimpenerwaard en ver daarbuiten.</h2>
          </div>
          <a href={site.instagram} class="rijs knop knop-rand knop-klein shrink-0 self-start md:self-auto" style="--d:.05s"><Icoon naam="insta" />Meer op Instagram</a>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:mt-14">
          {projecten.map((w, i) => (
            <li class={`rijs group relative overflow-hidden rounded-md bg-steen ${w.groot ? 'col-span-2 row-span-2 aspect-square' : 'aspect-square'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={w.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={w.groot ? '(min-width: 1248px) 600px, (min-width: 768px) 48vw, 92vw' : '(min-width: 1248px) 290px, (min-width: 768px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
