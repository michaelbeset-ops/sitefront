---
import Foto from '../components/Foto.astro';
import hero from '../assets/hero.jpg';
import scherm from '../assets/scherm.jpg';
import terras from '../assets/terras.jpg';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site } from '../data/site';

// Productteksten ingekort uit hun eigen productpagina.
const producten = [
  ['Terraszonwering', 'Een cassettescherm houdt het doek beschermd als hij dicht is en blijft zo langer mooi. Een open knikarmscherm is voordeliger.'],
  ['Knikarmschermen', 'Ook met verlichting in de cassette, voor je balkon of terras als de zon onder is.'],
  ['Uitvalschermen', 'Voor ramen zonder openslaande delen. Getemperd licht bij de eettafel of computer, en je meubels en parket verkleuren niet.'],
  ['Screens', 'Houden warmte buiten en schittering tegen. Van binnen blijf je naar buiten kijken, van buiten kijkt niemand naar binnen.'],
  ['Markiezen', 'Met gesloten zijkanten tegen zon van opzij. Aluminium markiezen kunnen gewoon buiten overwinteren.'],
  ['Rolluiken', 'Voor beveiliging, isolatie tegen kou, zonwering en afsluiting. Opbouw of inbouw, met motoren die 30% stiller zijn.'],
  ['Serrezonwering', 'Voor kleine en grote serres, strak vormgegeven.'],
  ['Zonneroosters', 'Vaste lamellen, extreem windbestendig, met vrijwel vrij zicht naar buiten.'],
];
const tijden = [['Maandag t/m vrijdag', '09.00 tot 17.00'], ['Zaterdag en zondag', 'Gesloten']];
---
<Base
  title="Kila Zonweringen | Zonwering, screens en rolluiken op maat in Zwijndrecht"
  description="Zonwering en raamdecoratie op maat, zelf gemonteerd en onderhouden. Screens, knikarmschermen, markiezen en rolluiken in Zwijndrecht, Dordrecht, Papendrecht en omgeving."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <section class="relative overflow-hidden">
      <!-- Het gele vlak is de zon; de rest van de hero ligt in de schaduw. Eén beeldidee, geen foto nodig. -->
      <div aria-hidden="true" class="absolute -right-24 -top-24 h-[28rem] w-[28rem] rounded-full bg-sun md:-right-16 md:-top-40 md:h-[40rem] md:w-[40rem]"></div>
      <div class="wrap relative grid gap-10 pb-16 pt-14 lg:grid-cols-12 lg:pb-24 lg:pt-24">
        <div class="lg:col-span-7">
          <p class="font-display font-bold">Zwijndrecht en de hele regio</p>
          <h1 class="mt-4 text-4xl">Zonwering op maat, door ons gemonteerd</h1>
          <p class="mt-6 max-w-xl text-lg text-ink-soft">
            Voor binnen en buiten, thuis of op de zaak. Kila Zonweringen levert, monteert en onderhoudt alles zelf,
            zodat de kwaliteit ook na jaren nog klopt.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#offerte" class="btn btn-ink">Vrijblijvende offerte</a>
            <a href={site.telHref} class="btn btn-sun">Bel {site.tel}</a>
          </div>
          <p class="mt-8 text-sm text-ink-soft"><span class="font-bold text-ink">4,9</span> op Google, uit 8 reviews</p>
        </div>
        <!-- De foto in een cirkel: de schaduw onder de zon. -->
        <div class="self-center lg:col-span-5 lg:col-start-8"><div class="mx-auto aspect-square max-w-md overflow-hidden rounded-full border-[10px] border-paper"><Foto src={hero} alt="Rij huizen met gele zonneschermen boven de balkons" hero sizes="(min-width: 1024px) 440px, 90vw" /></div></div>
      </div>
    </section>

    <section id="producten" class="scroll-mt-20 bg-white py-16 lg:py-24">
      <div class="wrap">
        <div class="grid items-end gap-8 lg:grid-cols-2"><h2 class="max-w-2xl text-3xl">Wat we leveren en monteren</h2><div class="aspect-[16/9] overflow-hidden"><Foto src={scherm} alt="Zonnescherm boven een raam aan een witte gevel" sizes="(min-width: 1024px) 560px, 100vw" /></div></div>
        <dl class="mt-12 grid gap-x-12 md:grid-cols-2">
          {producten.map(([n, t]) => (
            <div class="grid gap-1 border-t border-line py-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <dt class="font-display text-lg font-extrabold">{n}</dt>
              <dd class="text-ink-soft">{t}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="thuis-zakelijk" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-2 lg:py-24">
      <div class="border-l-4 border-sun pl-6">
        <h2 class="text-2xl">Thuis</h2>
        <p class="mt-4 text-lg">Lekker buiten zitten onder een zonnescherm, of binnen koel blijven met screens. We denken mee over wat bij je huis past.</p>
      </div>
      <div class="border-l-4 border-ink pl-6">
        <h2 class="text-2xl">Zakelijk</h2>
        <p class="mt-4 text-lg">Nieuwbouw of renovatie: voorkom de hinderlijke schittering op beeldschermen en hou de warmte buiten.</p>
      </div>
      <div class="aspect-[16/9] lg:col-span-2 lg:aspect-[3/1] overflow-hidden"><Foto src={terras} alt="Terras met een uitgerold zonnescherm tussen de planten" sizes="(min-width: 1184px) 1120px, 100vw" /></div>
    </section>

    <section id="offerte" class="scroll-mt-20 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Wat kost het?</h2>
          <p class="mt-5 text-lg text-white/80">Vertel wat je zoekt, dan maken we een vrijblijvende offerte. We werken vooral in Zwijndrecht, Dordrecht, Papendrecht, Alblasserdam, Rotterdam en omliggende plaatsen.</p>
          <dl class="mt-8 space-y-2 text-white/80">
            {tijden.map(([d, t]) => <div class="flex justify-between gap-4 border-b border-white/15 pb-2"><dt>{d}</dt><dd class="whitespace-nowrap">{t}</dd></div>)}
          </dl>
        </div>
        <form class="grid gap-4 lg:col-span-6 lg:col-start-7" aria-describedby="form-uit" onsubmit="return false">
          <label class="grid gap-1 text-sm font-semibold">Naam<input type="text" name="naam" autocomplete="name" class="rounded-sm bg-white px-3 py-2.5 text-base font-normal text-ink" /></label>
          <label class="grid gap-1 text-sm font-semibold">Telefoon of e-mail<input type="text" name="contact" autocomplete="email" class="rounded-sm bg-white px-3 py-2.5 text-base font-normal text-ink" /></label>
          <label class="grid gap-1 text-sm font-semibold">Wat wil je laten maken?<textarea name="wens" rows="4" class="rounded-sm bg-white px-3 py-2.5 text-base font-normal text-ink"></textarea></label>
          {site.voorstel ? (
            <p id="form-uit" class="rounded-sm bg-white/10 p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel {site.tel} of mail naar{' '}<a href={`mailto:${site.mail}`} class="font-bold underline">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-sun justify-self-start">Offerte aanvragen</button>
          )}
        </form>
      </div>
    </section>

    <section class="wrap py-16 lg:py-20">
      <h2 class="text-2xl">Contact</h2>
      <p class="mt-4 text-lg">{site.naam}, {site.straat}, {site.postcode} {site.plaats}</p>
      <p class="mt-2"><a href={site.telHref} class="font-display text-2xl font-black underline decoration-sun decoration-[3px] underline-offset-4">{site.tel}</a><span class="mx-3 text-ink-soft">·</span><a href={`mailto:${site.mail}`} class="underline decoration-sun decoration-[3px] underline-offset-4">{site.mail}</a></p>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
