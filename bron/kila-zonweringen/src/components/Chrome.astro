---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-center gap-2 no-underline">
        <svg aria-hidden="true" width="26" height="26" viewBox="0 0 26 26"><circle cx="13" cy="13" r="6" fill="#f4b400"/><g stroke="#f4b400" stroke-width="2.4" stroke-linecap="round"><path d="M13 1.5v3M13 21.5v3M1.5 13h3M21.5 13h3M4.9 4.9l2.1 2.1M19 19l2.1 2.1M4.9 21.1 7 19M19 7l2.1-2.1"/></g></svg>
        <span class="font-display text-xl font-black tracking-[-0.035em]">Kila Zonweringen</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href="#producten" class="no-underline hover:underline decoration-sun decoration-[3px] underline-offset-4">Producten</a></li>
          <li><a href="#thuis-zakelijk" class="no-underline hover:underline decoration-sun decoration-[3px] underline-offset-4">Thuis en zakelijk</a></li>
          <li><a href="#offerte" class="no-underline hover:underline decoration-sun decoration-[3px] underline-offset-4">Offerte</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-sun !px-4 !py-2 text-sm">Bel Harry</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-white/75">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK 24460602</p>
      <p class="md:text-right"><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
  </footer>
)}
