---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="bg-nacht text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Montage, verkoop, onderhoud en reparatie van zonweringen en rolluiken. Voor thuis en voor bedrijven, vanuit Zwijndrecht.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Producten</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={h('producten')} class="link">Zonnescherm en knikarmscherm</a></li>
        <li><a href={h('producten')} class="link">Screens en ritsscreens</a></li>
        <li><a href={h('producten')} class="link">Rolluiken en markiezen</a></li>
        <li><a href={h('producten')} class="link">Raamdecoratie binnen</a></li>
        <li><a href={h('doek')} class="link">Doek vervangen</a></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
      <p class="mt-1.5"><a href={site.facebook} class="link">Facebook</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Bereikbaar</p>
      <p class="mt-4">Maandag tot en met vrijdag<br /><span class="num">09.00 tot 17.00 uur</span></p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-zon">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten van kila-zonweringen.nl. Foto’s van jullie eigen Google-profiel en Facebookpagina. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
