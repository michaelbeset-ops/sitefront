---
// Hun logo nagetekend: gloeiende zonnering + KILA in zware kapitalen met het oranje blokje als i-punt.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = true, class: cls = '' } = Astro.props;
const gid = `zr${Math.random().toString(36).slice(2, 7)}`;
const stralen = Array.from({ length: 14 }, (_, i) => i * (360 / 14));
---
<a href={url('')} class={`group inline-flex items-center gap-2.5 no-underline ${cls}`}>
  <svg viewBox="0 0 48 48" class="h-10 w-10 flex-none transition-transform duration-700 group-hover:rotate-45" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f7c04a" />
        <stop offset="1" stop-color="#ef8a22" />
      </linearGradient>
    </defs>
    <g fill={`url(#${gid})`}>
      {stralen.map((r) => <path d="M24 1.5 26.6 8h-5.2Z" transform={`rotate(${r} 24 24)`} />)}
    </g>
    <circle cx="24" cy="24" r="13" fill="none" stroke={`url(#${gid})`} stroke-width="5" />
  </svg>
  <span class="leading-none">
    <span class={`block text-[1.6rem] font-[850] tracking-[.02em] ${licht ? 'text-wit' : 'text-inkt'}`} style="font-family: var(--font-sans)">K<span class="relative">I<span class="absolute inset-x-[.04em] -top-[.2em] h-[.15em] bg-zon" aria-hidden="true"></span></span>LA</span>
    <span class="mt-1 block text-[.56rem] font-semibold tracking-[.38em] text-zon">ZONWERINGEN</span>
  </span>
</a>
