---
// De baard (tanden) van de sleutel uit hun logo als rand tussen twee vlakken.
// boven = kleur van het vlak erboven, onder = kleur van het vlak eronder.
interface Props { boven: string; onder: string; spiegel?: boolean }
const { boven, onder, spiegel = false } = Astro.props;
---
<svg class="baard" viewBox="0 0 1440 46" preserveAspectRatio="none" aria-hidden="true" style={`background:${boven};${spiegel ? 'transform:scaleX(-1)' : ''}`}>
  <path fill={onder} d="M0 46V30h560v-14h70v14h90V0h96v30h70V14h56v16h498v16Z" />
</svg>
