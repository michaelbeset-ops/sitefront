---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['diensten', 'Diensten'], ['werkwijze', 'Werkwijze'], ['hulp', 'Hulp vragen'], ['reviews', 'Reviews'], ['contact', 'Contact']];
---
<header class={thuis ? 'absolute inset-x-0 top-0 z-40' : 'relative z-40 bg-merk'}>
  <div class="hidden border-b border-lijn md:block">
    <div class="wrap flex h-10 items-center justify-between gap-6 text-[.875rem] text-wit/80">
      <ul class="flex gap-7">
        {['24/7 bereikbaar', 'Particulier en zakelijk', 'Tilburg en omgeving'].map((t) => <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-sein" />{t}</li>)}
      </ul>
      <a href={site.reviews} class="flex items-center gap-2 text-wit/80 no-underline hover:text-wit"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-3.5 w-3.5" />)}</span><b class="num font-semibold text-wit">{site.google.score}</b> op Google</a>
    </div>
  </div>
  <div class="wrap flex h-20 items-center justify-between gap-3 md:h-24 md:gap-6">
    <Merk />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-[.97rem] font-semibold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-wit/85 no-underline transition-colors duration-200 hover:text-wit">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="num hidden items-center gap-2 text-[.97rem] font-semibold text-wit no-underline transition-opacity hover:opacity-75 xl:flex"><Icoon naam="tel" class="h-4 w-4 text-sein" />{site.tel}</a>
      <a href={waHoi} class="knop knop-sein knop-klein hidden md:inline-flex"><Icoon naam="wa" />WhatsApp</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-wit lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden bg-merk lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="smal block border-b border-lijn py-4 text-3xl font-bold uppercase text-wit no-underline">{t}</a></li>)}
      <li class="pt-6"><a href={site.telHref} class="num font-semibold text-alu no-underline">{site.tel}</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 bg-merk-diep md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn text-[.97rem] font-semibold text-wit no-underline"><Icoon naam="tel" class="h-5 w-5 text-alu" />Bellen</a>
  <a href={waHoi} class="flex min-h-14 items-center justify-center gap-2.5 bg-sein text-[.97rem] font-semibold text-merk-diep no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
