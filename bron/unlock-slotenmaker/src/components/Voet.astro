---
import { site, url, waHoi, plaatsen } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<footer class="bg-merk-diep text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk />
      <p class="mt-6 max-w-xs">Slotenmaker voor particulier en zakelijk, 24 uur per dag.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Werkgebied</p>
      <ul class="mt-4 space-y-1.5">{plaatsen.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num text-wit">{site.tel}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1.5">Maandag t/m zondag, 24 uur</p>
      <p class="mt-1.5"><a href={h('reviews')} class="link">{site.google.score} op Google, {site.google.aantal} reviews</a></p>
      <p class="mt-1.5 num">KvK {site.kvk}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Foto's van jullie eigen Google-profiel. Reviews letterlijk van Google (stand 11 oktober 2026).</p>}
</footer>
