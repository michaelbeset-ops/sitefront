---
import { url } from '../data/site';
import Sleutel from './Sleutel.astro';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 leading-none no-underline ${donker ? 'text-merk' : 'text-wit'}`}>
  <Sleutel class="h-7 w-auto sm:h-8" />
  <span class="smal text-[1.35rem] font-[800] uppercase tracking-[.01em] sm:text-[1.5rem]">Unlock<span class="font-[500] opacity-80"> Slotenmaker</span></span>
  <span class="sr-only">, naar de homepage</span>
</a>
