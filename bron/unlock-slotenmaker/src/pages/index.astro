---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Baard from '../components/Baard.astro';
import Sleutel from '../components/Sleutel.astro';
import { site, reviews, plaatsen, waHoi } from '../data/site';
import deur from '../assets/deur.jpg';
import auto from '../assets/auto.jpg';
import jumbo from '../assets/jumbo.jpg';
import cilinder from '../assets/cilinder.jpg';

const werk = [
  { t: 'Buitengesloten', z: 'Deur dichtgevallen, sleutel kwijt of binnen laten liggen.' },
  { t: 'Auto openen', z: 'Auto deur openen zonder schade? Wij helpen snel op locatie, 24/7 bereikbaar.' },
  { t: 'Sloten vervangen', z: 'Een nieuwe cilinder of een heel nieuw slot.' },
  { t: 'Inbraakpreventie', z: 'Uw deur beter beveiligen.' },
];
const wat = [
  ['ik sta buitengesloten', 'Buitengesloten'],
  ['mijn auto zit op slot', 'Auto op slot'],
  ['ik wil een nieuw slot', 'Slot vervangen'],
  ['ik wil inbraakadvies', 'Inbraakpreventie'],
  ['het gaat om iets anders', 'Iets anders'],
];
const BLAUW = 'var(--color-merk)';
const PAPIER = 'var(--color-papier)';
---
<Base title={`${site.naam} | Slotenmaker in ${site.plaats}, 24/7`} description="Slotenmaker in Tilburg en omgeving, 24 uur per dag. Buitengesloten, auto openen, sloten vervangen en inbraakpreventie, voor particulier en zakelijk.">
  <main id="inhoud">
    <div class="relative">
    <Kop />
    <!-- Hero: hun eigen foto van de nachtblauwe voordeur met nieuw beslag -->
    <section class="relative flex min-h-[100svh] items-end overflow-hidden bg-merk-diep text-wit md:items-center">
      <Image src={deur} alt="Nachtblauwe voordeur met aluminium veiligheidsbeslag en cilinder, foto van Unlock Slotenmaker" widths={[640, 960, 1440, 1800]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[52%_8%] md:object-[50%_22%]" />
      <div class="absolute inset-0 bg-[linear-gradient(to_top,#0c1a28f5_0%,#0c1a28e0_48%,#0c1a2800_78%)] md:bg-[linear-gradient(to_left,#0c1a28e6_0%,#0c1a2899_40%,#0c1a2800_62%)]" aria-hidden="true"></div>
      <div class="wrap relative pb-28 pt-40 md:pb-0 md:pt-24">
        <div class="md:ml-auto md:w-[min(34rem,46%)]">
          <p class="gestanst text-alu">Slotenmaker in {site.plaats} en omgeving</p>
          <h1 class="mt-5 text-hero">Deur dicht.<br />Sleutel binnen.</h1>
          <p class="mt-6 max-w-md text-lg text-wit/85 md:text-xl">24/7 slotenmaker voor particulier en zakelijk.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={site.telHref} class="knop knop-wit"><Icoon naam="tel" />Bel <span class="num">{site.tel}</span></a>
            <a href={waHoi} class="knop knop-lijn"><Icoon naam="wa" />WhatsApp</a>
          </div>
        </div>
      </div>
    </section>
    </div>

    <!-- Wow: het WhatsApp-bericht als zin om aan te vullen -->
    <section id="hulp" class="py-24 md:py-36">
      <div class="wrap grid gap-x-12 gap-y-14 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-8">
          <h2 class="rijs text-4xl text-merk">Wat is er aan de hand?</h2>
          <form class="rijs mt-10 md:mt-14" style="--d:.1s" data-zin action={site.wa} method="get" target="_blank">
            <p class="text-[clamp(1.45rem,2.6vw+.8rem,2.9rem)] font-medium leading-[1.45] tracking-[-.01em] text-inkt">
              Hallo Unlock, <label class="sr-only" for="z-wat">Wat is er aan de hand</label><span class="whitespace-nowrap"><select id="z-wat" class="gat" data-wat>
                {wat.map(([v]) => <option value={v}>{v}</option>)}
              </select>.</span> Ik ben in <label class="sr-only" for="z-waar">Plaats</label><input id="z-waar" class="gat" data-waar value={site.plaats} placeholder="plaats" autocomplete="address-level2" />
              en <label class="sr-only" for="z-wanneer">Wanneer</label><span class="whitespace-nowrap"><select id="z-wanneer" class="gat" data-wanneer>
                <option value="het is spoed">het is spoed</option>
                <option value="ik wil graag een afspraak">ik wil graag een afspraak</option>
              </select>.</span>
            </p>
            <input type="hidden" name="text" data-tekst />
            <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
              <button type="submit" class="knop knop-merk"><Icoon naam="wa" />Verstuur via WhatsApp</button>
              <a href={site.telHref} class="link text-[.97rem] font-semibold text-merk">Of bel <span class="num">{site.tel}</span></a>
            </div>
            <p class="mt-5 text-sm text-steen">WhatsApp opent met deze zin. U verstuurt hem zelf.</p>
          </form>
        </div>
      </div>
    </section>

    <Baard boven={PAPIER} onder={BLAUW} />

    <!-- Wat ze doen: lijst + hun eigen werkfoto's -->
    <section id="werk" class="bg-merk pb-24 pt-16 text-wit md:pb-36 md:pt-24">
      <div class="wrap grid gap-x-14 gap-y-16 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="rijs text-4xl">Wat we doen</h2>
          <ul class="mt-12 border-t border-lijn">
            {werk.map((w, i) => (
              <li class="rijs border-b border-lijn py-7" style={`--d:${i * 0.06}s`}>
                <h3 class="text-3xl">{w.t}</h3>
                <p class="mt-2 max-w-md text-mist">{w.z}</p>
              </li>
            ))}
          </ul>
          <p class="rijs mt-10 max-w-md text-lg text-alu">Voor particulier en zakelijk. Dag en nacht.</p>
        </div>
        <div class="grid grid-cols-2 gap-4 lg:col-span-6 lg:gap-5">
          <figure class="rijs col-span-2">
            <Image src={auto} alt="Autodeur op een kier met een luchtkussen, auto openen op locatie" widths={[640, 1000, 1400]} sizes="(min-width:1024px) 46vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_45%]" />
            <figcaption class="mt-3 text-sm text-mist">Auto openen, op locatie.</figcaption>
          </figure>
          <figure class="rijs" style="--d:.1s">
            <Image src={jumbo} alt="Geopende gele pick-up kast voor een Jumbo, met een jas met het Unlock-logo" widths={[400, 700]} sizes="(min-width:1024px) 23vw, 50vw" class="aspect-[3/4] w-full rounded-sm object-cover object-[40%_60%]" />
            <figcaption class="mt-3 text-sm text-mist">Een pick-up kast bij de Jumbo.</figcaption>
          </figure>
          <figure class="rijs mt-12" style="--d:.18s">
            <Image src={cilinder} alt="Hand met cilinderslot en sleutels bij de deur van een tankstation" widths={[400, 700]} sizes="(min-width:1024px) 23vw, 50vw" class="aspect-[3/4] w-full rounded-sm object-cover object-[50%_70%]" />
            <figcaption class="mt-3 text-sm text-mist">Een cilinder bij een tankstation.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <Baard boven={BLAUW} onder={PAPIER} spiegel />

    <!-- Reviews: letterlijk van Google -->
    <section id="reviews" class="py-24 md:py-36">
      <div class="wrap">
        <figure class="rijs max-w-5xl">
          <blockquote class="text-[clamp(1.6rem,2.4vw+.9rem,3rem)] font-medium leading-[1.25] tracking-[-.015em] text-merk">“{reviews.groot.tekst}”</blockquote>
          <figcaption class="mt-6 text-steen">{reviews.groot.naam}, Google review</figcaption>
        </figure>
        <div class="mt-20 grid gap-x-10 gap-y-10 border-t border-lijn-licht pt-10 sm:grid-cols-2 lg:grid-cols-3">
          {reviews.klein.map((r, i) => (
            <figure class="rijs" style={`--d:${i * 0.05}s`}>
              <blockquote class="text-lg leading-snug text-inkt">“{r.tekst}”</blockquote>
              <figcaption class="mt-3 text-sm text-steen">{r.naam}</figcaption>
            </figure>
          ))}
          <p class="rijs self-end text-sm text-steen">
            <a href={site.reviews} class="link font-semibold text-merk">{site.google.score} op Google, {site.google.aantal} reviews</a>
          </p>
        </div>
      </div>
    </section>

    <Baard boven={PAPIER} onder={BLAUW} />

    <!-- Werkgebied en de sleutel: bellen -->
    <section id="werkgebied" class="overflow-hidden bg-merk pb-28 pt-16 text-wit md:pb-36 md:pt-24">
      <div class="wrap grid gap-x-14 gap-y-16 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="rijs text-4xl">Dag en nacht</h2>
          <p class="rijs mt-6 text-lg text-mist">Maandag t/m zondag, 24 uur geopend.</p>
          <ul class="rijs mt-12 space-y-1">
            {plaatsen.map((p) => <li class="smal text-3xl font-[650] uppercase leading-tight text-alu">{p}</li>)}
          </ul>
        </div>
        <div class="flex flex-col justify-end lg:col-span-7">
          <Sleutel class="rijs w-full max-w-[38rem] text-merk-2" />
          <p class="rijs mt-10 text-mist">Bel of app direct:</p>
          <a href={site.telHref} class="rijs smal num mt-2 block text-[clamp(3rem,7.5vw+.5rem,7.8rem)] font-[800] leading-none text-wit no-underline transition-opacity hover:opacity-80">{site.tel}</a>
          <div class="rijs mt-9 flex flex-wrap gap-3">
            <a href={site.telHref} class="knop knop-wit"><Icoon naam="tel" />Bellen</a>
            <a href={waHoi} class="knop knop-lijn"><Icoon naam="wa" />WhatsApp</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-zin]');
  if (f) {
    const wat = f.querySelector<HTMLSelectElement>('[data-wat]')!;
    const waar = f.querySelector<HTMLInputElement>('[data-waar]')!;
    const wanneer = f.querySelector<HTMLSelectElement>('[data-wanneer]')!;
    const tekst = f.querySelector<HTMLInputElement>('[data-tekst]')!;
    const maat = (el: HTMLElement, v: string) => { el.style.width = `min(calc(${Math.max(v.length, 5)} * .5em + 2rem), calc(100% - .5em))`; };
    const zet = () => {
      maat(wat, wat.value); maat(wanneer, wanneer.value); maat(waar, waar.value || 'plaats');
      tekst.value = `Hallo Unlock Slotenmaker, ${wat.value}. Ik ben in ${waar.value.trim() || '...'} en ${wanneer.value}.`;
    };
    [wat, waar, wanneer].forEach((el) => el.addEventListener('input', zet));
    zet();
  }
</script>
