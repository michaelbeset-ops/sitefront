---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Baard from '../components/Baard.astro';
import Sleutel from '../components/Sleutel.astro';
import { site, reviews, plaatsen, waHoi, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import sleutelhanger from '../assets/sleutelhanger.jpg';
import deur from '../assets/deur.jpg';
import auto from '../assets/auto.jpg';
import jumbo from '../assets/jumbo.jpg';
import cilinder from '../assets/cilinder.jpg';

const vraag = (t: string) => waMet(`Hallo Unlock Slotenmaker, ik heb hulp nodig: ${t.toLowerCase()}.`);

// Diensten: teksten uit hun eigen bijschriften, Werkspot-omschrijving en eigenaarsreacties op Google.
const diensten = [
  { t: 'Buitengesloten', z: 'Deur dichtgevallen, sleutel kwijt of binnen laten liggen.', src: sleutelhanger, alt: 'Hand met een bos sleutels aan een huisjeshanger bij een open deur (sfeerfoto)', pos: '50% 50%', sfeer: true },
  { t: 'Auto openen', z: 'Auto deur openen zonder schade? Wij helpen snel op locatie, 24/7 bereikbaar.', src: auto, alt: 'Autodeur op een kier met een luchtkussen, auto openen op locatie', pos: '50% 45%' },
  { t: 'Sloten vervangen', z: 'Een nieuwe cilinder of een heel nieuw slot.', src: cilinder, alt: 'Hand met een cilinderslot en sleutels bij de deur van een tankstation', pos: '50% 78%' },
  { t: 'Inbraakpreventie', z: 'Uw deur beter beveiligen. Ook voor beveiligingsadvies.', src: deur, alt: 'Nachtblauwe voordeur met aluminium veiligheidsbeslag en cilinder', pos: '50% 30%' },
];

const stappen = [
  ['Bel of app', 'Dag en nacht, ook in het weekend. Via telefoon of WhatsApp.'],
  ['Vooraf duidelijk', 'Klanten noemen het in hun reviews: duidelijke afspraken en een heldere prijs.'],
  ['Snel op locatie', 'Thuis, bij uw bedrijf of bij uw auto, in Tilburg en omgeving.'],
  ['Weer binnen', 'Deur open of slot vervangen. Met advies als het beter kan.'],
];

const kaders = [
  { i: 'klok', t: 'Dag en nacht bereikbaar', z: 'Maandag t/m zondag, 24 uur. Ook vroeg in de ochtend.' },
  { i: 'praat', t: 'Rustig en vriendelijk', z: 'Zo omschrijven klanten de hulp in hun Google-reviews.' },
  { i: 'vink', t: 'Eerlijk advies', z: 'Soms is advies genoeg. Een klant schreef: niet onnodig op kosten gejaagd.' },
];

const wat = [
  ['ik sta buitengesloten', 'Buitengesloten'],
  ['mijn auto zit op slot', 'Auto op slot'],
  ['ik wil een nieuw slot', 'Slot vervangen'],
  ['ik wil inbraakadvies', 'Inbraakpreventie'],
  ['het gaat om iets anders', 'Iets anders'],
];
const alleReviews = [reviews.groot, ...reviews.klein];
const BLAUW = 'var(--color-merk)';
const PAPIER = 'var(--color-papier)';
const sterren = [1, 2, 3, 4, 5];
---
<Base title={`${site.naam} | Slotenmaker in ${site.plaats}, 24/7`} description="Slotenmaker in Tilburg en omgeving, 24 uur per dag. Buitengesloten, auto openen, sloten vervangen en inbraakpreventie, voor particulier en zakelijk. 5,0 op Google.">
  <main id="inhoud">
    <div class="relative">
    <Kop />
    <!-- 1. Hero: sfeerfoto (Unsplash) van een deur die opengaat, in hun nachtblauw -->
    <section class={`relative isolate flex ${site.voorstel ? "min-h-[calc(100svh-3.25rem)] md:min-h-[calc(100svh-2.25rem)]" : "min-h-[100svh]"} items-end overflow-hidden bg-merk-diep text-wit md:items-center`} aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1440, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-30 h-full w-full object-cover object-[50%_50%] md:w-[80%] md:object-[30%_50%]" />
      <div class="absolute inset-0 -z-20 bg-merk mix-blend-color opacity-45" aria-hidden="true"></div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,#0c1a28_0%,#0c1a28e0_38%,#0c1a2833_70%,#0c1a2880_100%)] md:bg-[linear-gradient(to_left,#0c1a28f2_0%,#0c1a28cc_38%,#0c1a2814_68%,#0c1a2859_100%)]" aria-hidden="true"></div>
      <div class="wrap relative pb-20 pt-32 md:pb-20 md:pt-40">
        <div class="md:ml-auto md:w-[min(38rem,52%)]">
          <p class="eyebrow text-sein">Slotenmaker in {site.plaats} en omgeving</p>
          <h1 id="t-hero" class="mt-4 text-hero">Deur dicht.<br />Sleutel <span class="text-sein">binnen.</span></h1>
          <p class="mt-5 max-w-md text-lg text-wit/85 md:mt-6 md:text-[1.3125rem] md:leading-relaxed">24/7 slotenmaker voor particulier en zakelijk. Spoedservice, buitengesloten en inbraakbeveiliging.</p>
          <div class="mt-7 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap md:mt-9">
            <a href={site.telHref} class="knop knop-sein px-4 sm:px-6"><Icoon naam="tel" />Bel direct</a>
            <a href={waHoi} class="knop knop-lijn px-4 sm:px-6"><Icoon naam="wa" />WhatsApp</a>
          </div>
          <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-wit/85 md:mt-9">
            <li class="flex items-center gap-2"><span class="flex text-ster">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span><b class="num text-wit">{site.google.score}</b> op Google, <span class="num">{site.google.aantal}</span> reviews</span></li>
            <li class="flex items-center gap-2"><span class="stip" aria-hidden="true"></span>24 uur geopend, ook nu</li>
            <li class="hidden items-center gap-2 xl:flex"><Icoon naam="tel" class="h-4 w-4 text-sein" /><a href={site.telHref} class="num font-semibold text-wit no-underline">{site.tel}</a></li>
          </ul>
        </div>
      </div>
    </section>
    </div>

    <!-- 2. Echte cijfers -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-y-8 py-10 lg:grid-cols-4 lg:py-12">
        <div class="flex flex-col"><dt class="mt-1 text-sm text-steen">Score op Google</dt><dd class="cijfer order-first text-merk">{site.google.score}</dd></div>
        <div class="flex flex-col pl-6 lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-1 text-sm text-steen">Google-reviews</dt><dd class="cijfer order-first">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-1 text-sm text-steen">Uur per dag bereikbaar</dt><dd class="cijfer order-first">24</dd></div>
        <div class="flex flex-col pl-6 lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-1 text-sm text-steen">Dagen per week</dt><dd class="cijfer order-first">7</dd></div>
      </dl>
    </section>

    <!-- 3. Diensten als fotokaarten -->
    <section id="diensten" class="py-20 md:py-28" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow text-steen">Wat we doen</p>
            <h2 id="t-diensten" class="mt-4 text-4xl text-merk">Dicht, kwijt of kapot.</h2>
          </div>
          <p class="rijs text-lg text-steen lg:col-span-4 lg:col-start-9" style="--d:.05s">Spoed, slotvervanging, deuropeningen en inbraakpreventie. Voor particulier en zakelijk.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-5">
          {diensten.map((d, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={vraag(d.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-[0_12px_32px_-12px_#0f151a40]">
                <div class="relative overflow-hidden">
                  <Image src={d.src} alt={d.alt} widths={[400, 640, 900]} sizes="(min-width: 1024px) 300px, (min-width: 640px) 46vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] lg:aspect-[4/5]" style={`object-position:${d.pos}`} />
                  {!d.sfeer && <span class="absolute left-3 top-3 rounded-[4px] bg-merk-diep/80 px-2.5 py-1 text-xs font-semibold text-wit backdrop-blur">Eigen foto</span>}
                </div>
                <div class="flex flex-1 flex-col p-5 md:p-6">
                  <h3 class="text-[1.65rem] text-merk">{d.t}</h3>
                  <p class="mt-2 flex-1 text-[.97rem] text-steen">{d.z}</p>
                  <span class="mt-5 flex items-center justify-between border-t border-lijn-licht pt-4 text-[.9375rem] font-semibold text-merk">Vraag het via WhatsApp<span class="grid h-9 w-9 place-items-center rounded-full bg-papier transition-colors group-hover:bg-merk group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-4 w-4" /></span></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Baard boven={PAPIER} onder={BLAUW} />

    <!-- 4. Werkwijze -->
    <section id="werkwijze" class="bg-merk pb-20 pt-14 text-wit md:pb-28 md:pt-20" aria-labelledby="t-werkwijze">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow text-sein">Zo werkt het</p>
            <h2 id="t-werkwijze" class="mt-4 text-4xl">Van telefoontje tot weer binnen.</h2>
          </div>
          <p class="rijs text-lg text-mist lg:col-span-4 lg:col-start-9" style="--d:.05s">U kunt 24/7 contact opnemen via WhatsApp of telefoon.</p>
        </div>
        <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-5">
          {stappen.map(([t, z], i) => (
            <li class="rijs kaart-donker p-6 md:p-7" style={`--d:${i * 0.06}s`}>
              <p class="smal num text-[2.75rem] font-[800] leading-none text-sein md:text-[3.25rem]">0{i + 1}</p>
              <h3 class="mt-5 text-2xl md:mt-8">{t}</h3>
              <p class="mt-2 text-mist">{z}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Baard boven={BLAUW} onder={PAPIER} spiegel />

    <!-- 5. Wow: het WhatsApp-bericht als zin om aan te vullen -->
    <section id="hulp" class="py-20 md:py-28" aria-labelledby="t-hulp">
      <div class="wrap grid gap-x-12 gap-y-12 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-8">
          <p class="eyebrow rijs text-steen">Hulp vragen</p>
          <h2 id="t-hulp" class="rijs mt-4 text-4xl text-merk">Wat is er aan de hand?</h2>
          <form class="rijs mt-10 md:mt-12" style="--d:.1s" data-zin action={site.wa} method="get" target="_blank">
            <p class="text-[clamp(1.45rem,2.6vw+.8rem,2.6rem)] font-medium leading-[1.45] tracking-[-.01em] text-inkt">
              Hallo Unlock, <label class="sr-only" for="z-wat">Wat is er aan de hand</label><span class="whitespace-nowrap"><select id="z-wat" class="gat" data-wat>
                {wat.map(([v]) => <option value={v}>{v}</option>)}
              </select>.</span> Ik ben in <label class="sr-only" for="z-waar">Plaats</label><input id="z-waar" class="gat" data-waar value={site.plaats} placeholder="plaats" autocomplete="address-level2" />
              en <label class="sr-only" for="z-wanneer">Wanneer</label><span class="whitespace-nowrap"><select id="z-wanneer" class="gat" data-wanneer>
                <option value="het is spoed">het is spoed</option>
                <option value="ik wil graag een afspraak">ik wil graag een afspraak</option>
              </select>.</span>
            </p>
            <input type="hidden" name="text" data-tekst />
            <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
              <button type="submit" class="knop knop-merk"><Icoon naam="wa" />Verstuur via WhatsApp</button>
              <a href={site.telHref} class="link text-[.97rem] font-semibold text-merk">Of bel <span class="num">{site.tel}</span></a>
            </div>
            <p class="mt-5 text-sm text-steen">WhatsApp opent met deze zin. U verstuurt hem zelf.</p>
          </form>
        </div>
        <aside class="rijs kaart self-start p-6 md:p-8 lg:col-span-4" style="--d:.15s" aria-label="Direct contact">
          <p class="flex items-center gap-2 text-sm font-semibold text-merk"><span class="stip" aria-hidden="true"></span>Nu bereikbaar</p>
          <a href={site.telHref} class="smal num mt-4 block text-[2.6rem] font-[800] leading-none text-merk no-underline hover:opacity-80">{site.tel}</a>
          <p class="mt-3 text-steen">Maandag t/m zondag, 24 uur geopend.</p>
          <div class="mt-6 grid gap-3">
            <a href={site.telHref} class="knop knop-merk"><Icoon naam="tel" />Bellen</a>
            <a href={waHoi} class="knop border-[1.5px] border-merk/30 text-merk hover:border-merk"><Icoon naam="wa" />WhatsApp</a>
          </div>
        </aside>
      </div>
    </section>

    <!-- 6. Particulier en zakelijk: hun eigen werkfoto's -->
    <section id="zakelijk" class="bg-merk-diep text-wit" aria-labelledby="t-zakelijk">
      <div class="grid lg:grid-cols-12">
        <figure class="relative min-h-[24rem] sm:min-h-[30rem] lg:col-span-6">
          <Image src={jumbo} alt="Geopende gele pick-up kast voor een Jumbo, met een jas met het Unlock-logo" widths={[640, 960, 1280]} sizes="(min-width:1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[45%_88%]" />
          <figcaption class="absolute bottom-4 left-4 rounded-[4px] bg-merk-diep/85 px-3 py-1.5 text-sm font-semibold text-wit backdrop-blur">Eigen foto: een pick-up kast bij de Jumbo</figcaption>
        </figure>
        <div class="px-5 py-16 md:px-10 md:py-20 lg:col-span-6 lg:px-14 lg:py-24 xl:pr-[max(3.5rem,calc((100vw-84rem)/2+2.5rem))]">
          <p class="eyebrow text-sein">Particulier en zakelijk</p>
          <h2 id="t-zakelijk" class="mt-4 text-4xl">Thuis, op de zaak of langs de weg.</h2>
          <p class="mt-6 max-w-xl text-lg text-mist">Een voordeur thuis, een pick-up kast bij de Jumbo, een cilinder bij een tankstation of een auto op slot: Unlock helpt particulieren en bedrijven in Tilburg en omgeving.</p>
          <ul class="mt-8 grid gap-3">
            {kaders.map((k) => (
              <li class="kaart-donker flex items-start gap-4 px-5 py-4">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sein text-merk-diep"><Icoon naam={k.i} class="h-5 w-5" /></span>
                <div><h3 class="text-xl">{k.t}</h3><p class="mt-1 text-[.97rem] text-mist">{k.z}</p></div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 7. Reviews: letterlijk van Google -->
    <section id="reviews" class="py-20 md:py-28" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow text-steen">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-4xl text-merk">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="smal num text-3xl font-[800] leading-none text-merk">{site.google.score}</b><span class="flex text-ster">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-sm text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {alleReviews.map((r, i) => (
            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn-licht pt-5">
                <span class="smal grid h-10 w-10 place-items-center rounded-full bg-papier font-[800] text-merk" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-steen">Google review</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold text-merk">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <Baard boven={PAPIER} onder={BLAUW} />

    <!-- 8. Werkgebied en contact -->
    <section id="contact" class="overflow-hidden bg-merk pb-20 pt-14 text-wit md:pb-28 md:pt-20" aria-labelledby="t-contact">
      <div class="wrap grid gap-x-14 gap-y-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-sein">Werkgebied en contact</p>
          <h2 id="t-contact" class="mt-4 text-4xl">Dag en nacht.</h2>
          <p class="mt-6 text-lg text-mist">Maandag t/m zondag, 24 uur geopend. In Tilburg en omgeving, onder meer in:</p>
          <ul class="mt-8 flex flex-wrap gap-2">
            {plaatsen.map((p) => <li class="flex items-center gap-2 rounded-full bg-merk-2 px-4 py-2 text-[.97rem] font-semibold"><Icoon naam="pin" class="h-4 w-4 text-sein" />{p}</li>)}
          </ul>
          <div class="kaart-donker mt-10 p-6">
            <div class="flex items-center justify-between gap-3">
              <p class="font-semibold">Bereikbaarheid</p>
              <p class="flex items-center gap-2 rounded-full bg-merk px-3 py-1 text-sm font-semibold"><span class="stip" aria-hidden="true"></span>Nu open</p>
            </div>
            <table class="mt-4 w-full text-[.97rem]">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                <tr class="border-b border-lijn"><th scope="row" class="py-2.5 text-left font-normal text-mist">Maandag t/m vrijdag</th><td class="num py-2.5 text-right">24 uur</td></tr>
                <tr><th scope="row" class="py-2.5 text-left font-normal text-mist">Zaterdag en zondag</th><td class="num py-2.5 text-right">24 uur</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="flex flex-col justify-end lg:col-span-7">
          <Sleutel class="rijs hidden w-full max-w-[34rem] text-merk-2 lg:block" />
          <p class="rijs text-mist lg:mt-10">Bel of app direct:</p>
          <a href={site.telHref} class="rijs smal num mt-2 block text-[clamp(3rem,7.5vw+.5rem,7.4rem)] font-[800] leading-none text-wit no-underline transition-opacity hover:opacity-80">{site.tel}</a>
          <ul class="rijs mt-9 grid gap-3 sm:grid-cols-3">
            <li><a href={site.telHref} class="kaart-donker flex h-full items-center gap-3 p-4 no-underline transition-colors hover:bg-[#25415f]"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-sein text-merk-diep"><Icoon naam="tel" class="h-5 w-5" /></span><span><b class="block font-semibold">Bellen</b><span class="text-sm text-mist">24/7</span></span></a></li>
            <li><a href={waHoi} class="kaart-donker flex h-full items-center gap-3 p-4 no-underline transition-colors hover:bg-[#25415f]"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-sein text-merk-diep"><Icoon naam="wa" class="h-5 w-5" /></span><span><b class="block font-semibold">WhatsApp</b><span class="text-sm text-mist">Stuur een bericht</span></span></a></li>
            <li><a href={site.reviews} class="kaart-donker flex h-full items-center gap-3 p-4 no-underline transition-colors hover:bg-[#25415f]"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-sein text-merk-diep"><Icoon naam="pin" class="h-5 w-5" /></span><span><b class="block font-semibold">Google Maps</b><span class="text-sm text-mist">Profiel en reviews</span></span></a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 9. Slotbalk -->
    <section class="bg-sein text-merk-diep" aria-label="Direct hulp">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center lg:py-14">
        <div>
          <h2 class="text-[clamp(1.9rem,2vw+1.3rem,2.8rem)]">Buitengesloten?</h2>
          <p class="mt-2 text-lg">Bel of app, dag en nacht.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={site.telHref} class="knop knop-merk"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
          <a href={waHoi} class="knop border-[1.5px] border-merk-diep/40 text-merk-diep hover:border-merk-diep"><Icoon naam="wa" />WhatsApp</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-zin]');
  if (f) {
    const wat = f.querySelector<HTMLSelectElement>('[data-wat]')!;
    const waar = f.querySelector<HTMLInputElement>('[data-waar]')!;
    const wanneer = f.querySelector<HTMLSelectElement>('[data-wanneer]')!;
    const tekst = f.querySelector<HTMLInputElement>('[data-tekst]')!;
    const maat = (el: HTMLElement, v: string) => { el.style.width = `min(calc(${Math.max(v.length, 5)} * .5em + 2rem), calc(100% - .5em))`; };
    const zet = () => {
      maat(wat, wat.value); maat(wanneer, wanneer.value); maat(waar, waar.value || 'plaats');
      tekst.value = `Hallo Unlock Slotenmaker, ${wat.value}. Ik ben in ${waar.value.trim() || '...'} en ${wanneer.value}.`;
    };
    [wat, waar, wanneer].forEach((el) => el.addEventListener('input', zet));
    zet();
  }
</script>

