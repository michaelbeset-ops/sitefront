---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi, waMet } from '../data/site';

// Eigen beeld van hun Google-profiel en Marktplaats; sfeerfoto's van Unsplash. Zie src/assets/BRONNEN.txt.
import sHero from '../assets/s-hero.jpg';
import sGordijn from '../assets/s-gordijn.jpg';
import sDeuren from '../assets/s-deuren.jpg';
import eDubbel from '../assets/eigen-dubbel.jpg';
import eAntraciet from '../assets/eigen-antraciet.jpg';
import eWit from '../assets/eigen-wit.jpg';
import eHamstra from '../assets/eigen-hamstra.jpg';
import eGeplaatst from '../assets/eigen-geplaatst.jpg';

// Eigenschappen letterlijk uit hun advertenties.
const eigenschappen = ['Luxaflex, Unilux en Hamstra', 'Enkel of dubbel', 'Geruisloze ketting', 'Extra breed', 'In de dag of op de dag', 'Zwart of grijs gaas'];

const aanbod = [
  { t: 'Plissé hordeuren', d: 'Nieuwe hordeuren in plissé, geleverd met boven- en ondergeleider en met bevestigingsmateriaal.', l: ['Enkele deur of dubbele set', 'Veel RAL-kleuren, zwart of grijs gaas'], src: eGeplaatst, pos: '50% 45%', alt: 'Plissé hordeur in openslaande tuindeuren, van binnen gezien', bron: 'Eigen foto' },
  { t: 'Op maat ingekort', d: 'Inkorten op hoogte? Geen probleem, wij verzorgen dit vakkundig.', l: ['Meerdere maten op voorraad', 'Uw maat er niet bij? Stuur een bericht'], src: eAntraciet, pos: '50% 40%', alt: 'Antracietgrijze plissé hordeur uit de voorraad, tegen een witte schuurwand', bron: 'Eigen foto' },
  { t: 'Gordijnen en raamdecoratie', d: 'Naast plissé hordeuren ook gordijnen, raamdecoratie en zonwering uit overtollige partijen.', l: ['Uit restpartijen van bedrijven', 'Vraag wat er op voorraad is'], src: sGordijn, pos: '50% 50%', alt: 'Linnen gordijnen met bladschaduw (sfeerfoto)', bron: 'Sfeerfoto' },
];

const stappen = [
  ['Stuur uw maten', 'Hoogte en breedte van de opening, plus de kleur die u zoekt. Via WhatsApp of telefoon.'],
  ['Passend uit voorraad', 'Er liggen meerdere maten op voorraad. We kijken samen welke hordeur past.'],
  ['Op hoogte ingekort', 'Is de deur te hoog, dan wordt hij vakkundig ingekort.'],
  ['Ophalen of verzenden', 'Ophalen in Ridderkerk of laten verzenden. Vragen over de montage? Stuur gerust een bericht.'],
];

const kleuren = [
  ['antracietgrijs (RAL 7016)', 'Antraciet', '#383e42'],
  ['wit (RAL 9010)', 'Wit', '#f4f1e8'],
  ['crème wit (RAL 9001)', 'Crème wit', '#e9e0d2'],
  ['zwart (RAL 9005)', 'Zwart', '#0e0e10'],
  ['bruingrijs (RAL 7013)', 'Bruingrijs', '#555548'],
  ['zilvergrijs (RAL 9006)', 'Zilvergrijs', '#a5a8a6'],
];

const sterren = [1, 2, 3, 4, 5];
const voorraad = [
  { src: eDubbel, alt: 'Dubbele witte plissé hordeur uit de voorraad', maat: '252,5 × 194' },
  { src: eWit, alt: 'Witte plissé hordeur uit de voorraad', maat: '256 × 130' },
  { src: eHamstra, alt: 'Plissé hordeur van Hamstra uit de voorraad', maat: '232 × 95' },
];
---
<Base title="Kopasol | Plissé hordeuren en gordijnen in Ridderkerk" description="Nieuwe plissé hordeuren van Luxaflex, Unilux en Hamstra uit restpartijen. Inkorten op hoogte, ophalen in Ridderkerk of verzenden. Stuur uw maten via WhatsApp: 06 23 05 77 63.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: sfeerfoto open tuindeuren, donker verloop -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={sHero} alt="" widths={[640, 960, 1400, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" quality={64} class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_50%] md:object-[50%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#23282cb3_0%,#23282c40_30%,#23282cd9_60%,#23282cfa_100%)] md:bg-[linear-gradient(90deg,#23282cf7_0%,#23282ce0_36%,#23282c66_64%,#23282c26_100%),linear-gradient(180deg,#23282cb3_0%,#23282c00_30%,#23282c00_74%,#23282c99_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-28 pt-40 md:pb-20 lg:pt-48">
        <div class="max-w-[47rem]">
          <p class="eyebrow eyebrow-licht">Plissé hordeuren · Ridderkerk</p>
          <h1 id="inhoud" class="mt-6 text-hero">Plissé hordeuren op voorraad, ingekort op uw <span class="text-lint">maat.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-wit/90 md:text-[1.375rem]">Nieuwe plissé hordeuren van onder meer Luxaflex, Unilux en Hamstra, uit restpartijen. Ophalen in Ridderkerk of laten verzenden.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#maatwijzer" class="knop knop-lint"><Icoon naam="wa" />Stuur uw maten</a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />Bel {site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-3 text-[1rem] text-wit/90">
            <li class="flex items-center gap-2"><span class="flex text-lint" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-wit">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2"><b class="num text-wit">{site.mp.score}</b> op Marktplaats, {site.mp.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="pakje" class="h-5 w-5 text-lint" />Ophalen of verzenden</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <main>
    <!-- 2. Maatlint met eigenschappen -->
    <section class="bg-inkt-2 text-wit" aria-label="Eigenschappen">
      <div class="liniaal text-wit/25" aria-hidden="true"></div>
      <div class="wrap py-7">
        <ul class="flex flex-wrap gap-3">
          {eigenschappen.map((e) => <li class="chip">{e}</li>)}
        </ul>
      </div>
    </section>

    <!-- 3. Waarom zo voordelig: restpartijen -->
    <section class="bg-papier py-24 md:py-32" aria-labelledby="t-wie">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-6">
          <p class="rijs eyebrow">Hoe dat kan</p>
          <h2 id="t-wie" class="rijs mt-5 text-4xl">Nieuwe hordeuren, uit restpartijen.</h2>
          <p class="rijs mt-7 text-xl leading-relaxed text-steen" style="--d:.06s">Wij kopen foutief bestelde of verkeerd ingemeten plissé hordeuren en gordijnen op van bedrijven. Zo zitten zij niet met restpartijen, en vindt u een nieuwe hordeur voor een nette prijs.</p>
          <p class="rijs mt-5 text-lg leading-relaxed text-steen" style="--d:.1s">Door deze producten een nieuw leven te geven, verminderen we verspilling.</p>
          <dl class="rijs mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-[4px] border border-lijn-licht bg-lijn-licht sm:grid-cols-4" style="--d:.14s">
            {[
              [site.google.score, `Google, ${site.google.aantal} reviews`],
              [site.mp.score, `Marktplaats, ${site.mp.aantal} reviews`],
              ['41×', '"Reageert snel" op Marktplaats'],
              ['2 jaar', 'op Marktplaats'],
            ].map(([w, l]) => (
              <div class="bg-wit px-5 py-6">
                <dt class="sr-only">{l}</dt>
                <dd class="num text-[2.2rem] font-[800] leading-none tracking-[-.04em]" style="font-family: var(--font-kop)">{w}</dd>
                <dd class="mt-2 text-[.9375rem] leading-snug text-steen">{l}</dd>
              </div>
            ))}
          </dl>
        </div>
        <figure class="rijs lg:col-span-6">
          <ul class="grid grid-cols-3 gap-3 sm:gap-4">
            {voorraad.map((v, i) => (
              <li class={`relative overflow-hidden rounded-[4px] ${i === 1 ? 'translate-y-8' : ''}`}>
                <Image src={v.src} alt={v.alt} widths={[240, 400, 600]} sizes="(min-width: 1024px) 190px, 30vw" quality={70} class="aspect-[3/4] w-full object-cover" />
                <span class="num absolute inset-x-0 bottom-0 bg-inkt/85 px-2 py-1.5 text-center text-[.8125rem] font-bold text-wit sm:text-[.9375rem]" style="font-family: var(--font-kop)">{v.maat}</span>
              </li>
            ))}
          </ul>
          <figcaption class="mt-14 text-[.9375rem] text-steen">Uit de voorraad: eigen foto's uit onze advertenties. Maten in cm, hoogte × breedte.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Aanbod: fotokaarten -->
    <section id="aanbod" class="bg-wit py-24 md:py-32" aria-labelledby="t-aanbod">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Aanbod</p>
            <h2 id="t-aanbod" class="mt-5 text-4xl">Voor de schuifpui of de tuindeur.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-4 lg:col-start-9" style="--d:.05s">Als uw afmeting er niet tussen staat, stuur dan gerust een bericht. Er liggen meerdere maten op voorraad.</p>
        </div>
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-16 lg:grid-cols-3">
          {aanbod.map((v, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden">
                <div class="relative overflow-hidden">
                  <Image src={v.src} alt={v.alt} widths={[420, 640, 860]} sizes="(min-width: 1024px) 380px, (min-width: 768px) 46vw, 100vw" quality={70} class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${v.pos}`} />
                  <span class="absolute left-4 top-4 rounded-[3px] bg-inkt/85 px-2.5 py-1 text-[.8125rem] font-bold text-wit">{v.bron}</span>
                </div>
                <div class="flex flex-1 flex-col p-7 sm:p-8">
                  <h3 class="text-[1.85rem]">{v.t}</h3>
                  <p class="mt-3 text-steen">{v.d}</p>
                  <ul class="mt-6 space-y-2.5 border-t border-lijn-licht pt-6">
                    {v.l.map((x) => <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-inkt" />{x}</li>)}
                  </ul>
                  <a href="#maatwijzer" class="mt-auto inline-flex items-center gap-2 pt-8 font-bold text-inkt no-underline" style="font-family: var(--font-kop)"><span class="link">Vraag naar uw maat</span><Icoon naam="pijl" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Wow: de maatwijzer -> vooraf ingevuld WhatsApp -->
    <section id="maatwijzer" class="bg-papier-2 py-24 md:py-32" aria-labelledby="t-maat">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Maatwijzer</p>
            <h2 id="t-maat" class="mt-5 text-4xl">Welke maat zoekt u?</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:self-end" style="--d:.1s">Vul de maten van de opening in. U ziet meteen de tekening en het bericht; versturen doet u zelf in WhatsApp.</p>
        </div>

        <form class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-6 lg:mt-14 lg:grid-cols-12 lg:gap-8" data-maat>
          <div class="kaart min-w-0 space-y-9 p-5 sm:p-9 lg:col-span-7">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="hoogte" class="veld-label">Hoogte</label>
                <div class="maatveld"><input id="hoogte" name="hoogte" class="veld" inputmode="decimal" placeholder="232" value="232" /><span>cm</span></div>
              </div>
              <div>
                <label for="breedte" class="veld-label">Breedte</label>
                <div class="maatveld"><input id="breedte" name="breedte" class="veld" inputmode="decimal" placeholder="96" value="96" /><span>cm</span></div>
              </div>
            </div>
            <fieldset>
              <legend class="veld-label">Soort</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="keuze"><input type="radio" name="soort" value="enkel" checked />Enkele hordeur</label>
                <label class="keuze"><input type="radio" name="soort" value="dubbel" />Dubbele set</label>
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label">Kleur van het kader</legend>
              <div class="grid grid-cols-1 gap-3 min-[370px]:grid-cols-2 sm:grid-cols-3">
                {kleuren.map(([w, t, c], i) => <label class="keuze !gap-2 !px-3 text-[1rem]"><input type="radio" name="kleur" value={w} checked={i === 0} data-kleur={c} /><span class="kleur" style={`background:${c}`}></span>{t}</label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label">Gaas</legend>
              <div class="grid gap-3 sm:grid-cols-3">
                <label class="keuze"><input type="radio" name="gaas" value="zwart" checked />Zwart</label>
                <label class="keuze"><input type="radio" name="gaas" value="grijs" />Grijs</label>
                <label class="keuze"><input type="radio" name="gaas" value="" />Maakt niet uit</label>
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label">Ophalen of verzenden</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="keuze"><input type="radio" name="lever" value="ophalen" checked />Ophalen in Ridderkerk</label>
                <label class="keuze"><input type="radio" name="lever" value="verzenden" />Laten verzenden</label>
              </div>
            </fieldset>
            <div>
              <label for="naam" class="veld-label">Uw naam <span class="font-normal text-steen">(mag ook leeg)</span></label>
              <input id="naam" name="naam" class="veld" autocomplete="name" />
            </div>
          </div>

          <div class="min-w-0 lg:col-span-5">
            <div class="sticky top-6 overflow-hidden rounded-[4px] bg-inkt text-wit">
              <div class="relative grid place-items-center bg-inkt-2 px-6 pb-6 pt-8">
                <svg viewBox="0 0 320 290" class="h-auto w-full max-w-[26rem]" role="img" aria-label="Tekening van de hordeur met de ingevulde maten" data-tekening>
                  <g data-deur></g>
                  <g class="num" font-family="Schibsted Grotesk Variable, sans-serif" font-weight="700" font-size="17" fill="#f2b818" data-maten></g>
                </svg>
              </div>
              <div class="p-6 sm:p-8">
                <p class="font-bold text-mist">Uw bericht</p>
                <p class="mt-3 min-h-[8rem] whitespace-pre-line rounded-[4px] bg-inkt-2 px-5 py-4 text-[1.0625rem] leading-relaxed" data-voorbeeld aria-live="polite"></p>
                <a href={waHoi} class="knop knop-groen mt-5 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
                <p class="mt-5 text-[.9375rem] text-mist">Of bel: <a href={site.telHref} class="num font-bold text-wit no-underline hover:text-lint">{site.tel}</a></p>
              </div>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 6. Voor bedrijven: partij aanbieden -->
    <section id="bedrijven" class="relative isolate overflow-hidden bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-bedrijf">
      <div class="wrap grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Voor bedrijven</p>
          <h2 id="t-bedrijf" class="rijs mt-5 text-4xl">Verkeerd ingemeten? Wij kopen het <span class="text-lint">op.</span></h2>
          <p class="rijs mt-7 text-xl leading-relaxed text-wit/85" style="--d:.06s">Wij kopen foutief bestelde of verkeerd ingemeten plissé hordeuren en gordijnen op van bedrijven, zodat zij niet met restpartijen blijven zitten en alsnog een bedrag daarvoor terugkrijgen.</p>
          <ul class="rijs mt-9 space-y-3" style="--d:.1s">
            {[
              ['Plissé hordeuren', 'Foutief besteld of verkeerd ingemeten.'],
              ['Gordijnen en raamdecoratie', 'Ook andere raamdecoratie en zonwering.'],
              ['Ondernemers en MKB', 'Een efficiënte en duurzame oplossing voor overtollige voorraad.'],
            ].map(([t, d]) => (
              <li class="flex gap-4 rounded-[4px] border border-lijn bg-inkt-2 px-5 py-5">
                <span class="grid h-10 w-10 flex-none place-items-center rounded-[3px] bg-lint text-inkt"><Icoon naam="vink" class="h-5 w-5" /></span>
                <span><b class="block text-lg">{t}</b><span class="text-mist">{d}</span></span>
              </li>
            ))}
          </ul>
          <a href={waMet('Hallo Kopasol, ik heb een partij plissé hordeuren of gordijnen die ik wil aanbieden.')} class="rijs knop knop-lint mt-9" style="--d:.14s"><Icoon naam="wa" />Partij aanbieden</a>
        </div>
        <figure class="rijs lg:col-span-6">
          <Image src={sDeuren} alt="Openslaande tuindeuren met een tafel vol planten (sfeerfoto)" widths={[500, 800, 1100]} sizes="(min-width: 1024px) 40vw, 100vw" quality={68} class="aspect-[4/3] w-full rounded-[4px] object-cover" />
          <figcaption class="mt-3 text-[.9375rem] text-mist">Sfeerfoto, ter illustratie.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 7. Werkwijze -->
    <section id="werkwijze" class="bg-papier py-24 md:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="rijs max-w-2xl">
          <p class="eyebrow">Werkwijze</p>
          <h2 id="t-werk" class="mt-5 text-4xl">Van maat naar hordeur.</h2>
        </div>
        <div class="liniaal mt-12 text-inkt/30 lg:mt-16" aria-hidden="true"></div>
        <ol class="grid gap-x-6 gap-y-10 pt-10 sm:grid-cols-2 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs flex flex-col" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num text-inkt" aria-hidden="true">{String(i + 1).padStart(2, '0')}<span class="text-lint">.</span></span>
              <h3 class="mt-5 text-2xl">{t}</h3>
              <p class="mt-3 text-steen">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8. Een stem uit de reviews -->
    <section class="bg-lint text-inkt" aria-label="Uit een review">
      <figure class="wrap py-20 md:py-24">
        <blockquote class="rijs max-w-5xl text-[clamp(1.8rem,3vw+.8rem,3.4rem)] font-[800] leading-[1.08] tracking-[-.03em]" style="font-family: var(--font-kop)">“Man van zijn woord en handeld de zaak af met fatsoen en geduld.”</blockquote>
        <figcaption class="rijs mt-7 text-lg font-semibold" style="--d:.08s">Hans B. · Google review, kocht een plissehor voor de schuifpui</figcaption>
      </figure>
    </section>

    <!-- 9. Reviews -->
    <section class="bg-wit py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-6">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <div class="rijs flex flex-wrap gap-3 lg:col-span-6 lg:justify-end" style="--d:.06s">
            <a href={site.reviews} class="kaart flex items-center gap-4 px-5 py-4 no-underline transition-shadow hover:shadow-md">
              <Icoon naam="g" class="h-9 w-9 flex-none" />
              <span>
                <span class="flex items-center gap-2"><b class="num text-[1.75rem] font-[800] leading-none text-inkt" style="font-family: var(--font-kop)">{site.google.score}</b><span class="flex text-lint" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
                <span class="mt-1 block text-[.9375rem] text-steen">{site.google.aantal} reviews op Google</span>
              </span>
            </a>
            <a href={site.marktplaats} class="kaart flex items-center gap-4 px-5 py-4 no-underline transition-shadow hover:shadow-md">
              <span class="grid h-9 w-9 flex-none place-items-center rounded-[3px] bg-inkt text-[.8rem] font-[800] text-lint" style="font-family: var(--font-kop)" aria-hidden="true">MP</span>
              <span>
                <b class="num block text-[1.75rem] font-[800] leading-none text-inkt" style="font-family: var(--font-kop)">{site.mp.score}</b>
                <span class="mt-1 block text-[.9375rem] text-steen">{site.mp.aantal} reviews op Marktplaats</span>
              </span>
            </a>
          </div>
        </div>
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-14 lg:grid-cols-6">
          {reviews.map((r, i) => (
            <li class={`rijs ${i < 2 ? 'lg:col-span-3' : 'lg:col-span-2'}`} style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="flex h-full flex-col rounded-[4px] border border-lijn-licht bg-papier p-7 sm:p-8">
                <div class="flex gap-0.5 text-lint" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-5 w-5" />)}</div>
                <blockquote class="mt-5 flex-1 leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5">
                  <span class="grid h-10 w-10 flex-none place-items-center rounded-[3px] bg-inkt font-bold text-wit">{r.naam[0]}</span>
                  <span class="text-[1rem]"><b class="block">{r.naam}</b><span class="text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 10. Contact -->
    <section id="contact" class="border-t border-lijn-licht bg-papier py-24 md:py-32" aria-labelledby="t-contact">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Contact</p>
          <h2 id="t-contact" class="rijs mt-5 text-4xl">Stuur gerust een bericht.</h2>
          <p class="rijs mt-6 max-w-xl text-xl text-steen">Voor vragen over een maat, een kleur of de montage: app of bel. Ophalen in Ridderkerk spreken we even samen af.</p>
          <p class="rijs mt-8"><a href={site.telHref} class="num text-[clamp(2.1rem,9vw,4.8rem)] font-[800] leading-none tracking-[-.03em] text-inkt no-underline" style="font-family: var(--font-kop)">{site.tel}</a></p>
          <div class="rijs mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--d:.1s">
            <a href={waHoi} class="knop knop-lint"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" />Bellen</a>
          </div>
        </div>
        <div class="rijs lg:col-span-5" style="--d:.15s">
          <div class="kaart divide-y divide-lijn-licht">
            {[
              ['pin', 'Ridderkerk', 'Ophalen op afspraak.'],
              ['pakje', 'Verzenden', 'Verzenden is mogelijk.'],
              ['praat', 'Reageert snel', '41 keer genoemd in de reviews op Marktplaats.'],
            ].map(([ic, t, d]) => (
              <div class="flex gap-4 p-6">
                <span class="grid h-11 w-11 flex-none place-items-center rounded-[3px] bg-lint text-inkt"><Icoon naam={ic} class="h-6 w-6" /></span>
                <div><p class="text-lg font-bold" style="font-family: var(--font-kop)">{t}</p><p class="mt-1 text-steen">{d}</p></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="bg-inkt text-wit" aria-label="Maat doorgeven">
      <div class="liniaal text-wit/20" aria-hidden="true"></div>
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center md:py-16">
        <p class="text-[clamp(2rem,2.4vw+1rem,3rem)] font-[800] leading-none tracking-[-.03em]" style="font-family: var(--font-kop)">Geef uw <span class="text-lint">maat</span> door.</p>
        <a href="#maatwijzer" class="knop knop-lint shrink-0"><Icoon naam="wa" />Naar de maatwijzer</a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  // Maatwijzer: tekening met maatlijnen + vooraf ingevuld WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-maat]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const deur = document.querySelector<SVGGElement>('[data-deur]');
  const maten = document.querySelector<SVGGElement>('[data-maten]');
  const getal = (v: FormDataEntryValue | null) => { const n = parseFloat(String(v || '').replace(',', '.')); return isFinite(n) && n > 0 ? n : 0; };
  const nl = (n: number) => String(Math.round(n * 10) / 10).replace('.', ',');
  if (f && vb && knop && deur && maten) {
    const teken = (h: number, b: number, dubbel: boolean, kleur: string) => {
      const H = h || 220, B = b || 100;
      const s = Math.min(215 / H, 225 / B);
      const w = Math.max(40, B * s), hh = Math.max(60, H * s);
      const x = 52 + (236 - w) / 2, y = 14 + (225 - hh) / 2;
      const lijnen: string[] = [];
      const panelen = dubbel ? 2 : 1; const pw = w / panelen;
      for (let p = 0; p < panelen; p++) {
        const px = x + p * pw;
        lijnen.push(`<rect x="${px + 2}" y="${y + 2}" width="${pw - 4}" height="${hh - 4}" fill="#3b4247" stroke="${kleur}" stroke-width="5"/>`);
        const n = Math.max(6, Math.round((pw - 10) / 7));
        for (let i = 1; i < n; i++) { const lx = px + 4 + ((pw - 8) / n) * i; lijnen.push(`<line x1="${lx}" y1="${y + 6}" x2="${lx}" y2="${y + hh - 6}" stroke="#ffffff" stroke-opacity="${i % 2 ? .22 : .1}" stroke-width="1"/>`); }
      }
      deur.innerHTML = lijnen.join('');
      const yb = y + hh + 22, xh = x - 22;
      maten.innerHTML =
        `<line x1="${x}" y1="${yb}" x2="${x + w}" y2="${yb}" stroke="#f2b818" stroke-width="1.5"/><line x1="${x}" y1="${yb - 6}" x2="${x}" y2="${yb + 6}" stroke="#f2b818" stroke-width="1.5"/><line x1="${x + w}" y1="${yb - 6}" x2="${x + w}" y2="${yb + 6}" stroke="#f2b818" stroke-width="1.5"/>` +
        `<text x="${x + w / 2}" y="${yb + 22}" text-anchor="middle">${b ? nl(b) + ' cm' : 'breedte'}</text>` +
        `<line x1="${xh}" y1="${y}" x2="${xh}" y2="${y + hh}" stroke="#f2b818" stroke-width="1.5"/><line x1="${xh - 6}" y1="${y}" x2="${xh + 6}" y2="${y}" stroke="#f2b818" stroke-width="1.5"/><line x1="${xh - 6}" y1="${y + hh}" x2="${xh + 6}" y2="${y + hh}" stroke="#f2b818" stroke-width="1.5"/>` +
        `<text x="${xh - 10}" y="${y + hh / 2}" text-anchor="middle" transform="rotate(-90 ${xh - 10} ${y + hh / 2})">${h ? nl(h) + ' cm' : 'hoogte'}</text>`;
    };
    const zet = () => {
      const d = new FormData(f);
      const h = getal(d.get('hoogte')), b = getal(d.get('breedte'));
      const dubbel = d.get('soort') === 'dubbel';
      const kleur = String(d.get('kleur') || '');
      const kc = (f.querySelector<HTMLInputElement>('input[name="kleur"]:checked')?.dataset.kleur) || '#383e42';
      const gaas = String(d.get('gaas') || '');
      const lever = d.get('lever') === 'verzenden' ? 'Ik wil hem graag laten verzenden.' : 'Ik kom hem graag ophalen in Ridderkerk.';
      const naam = String(d.get('naam') || '').trim();
      const r = [`Hallo Kopasol, ik zoek een plissé hordeur (${dubbel ? 'dubbele set' : 'enkel'})${h && b ? ` van ${nl(h)} cm hoog en ${nl(b)} cm breed` : ''}.`];
      if (kleur) r.push(`Kleur kader: ${kleur}.`);
      if (gaas) r.push(`Gaas: ${gaas}.`);
      r.push(lever, 'Hebben jullie iets dat past?');
      if (naam) r.push(`Groet, ${naam}`);
      const t = r.join('\n');
      vb.textContent = t; knop.href = `${site.wa}?text=${encodeURIComponent(t)}`;
      teken(h, b, dubbel, kc);
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
