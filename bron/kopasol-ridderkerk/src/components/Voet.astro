---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const aanbod = [['aanbod', 'Plissé hordeuren'], ['aanbod', 'Inkorten op hoogte'], ['aanbod', 'Gordijnen en raamdecoratie'], ['maatwijzer', 'Maatwijzer'], ['bedrijven', 'Partij aanbieden']];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1.0625rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <Merk />
      <p class="mt-6 max-w-sm">Inkoop en verkoop van plissé hordeuren en gordijnen. Ophalen in {site.plaats} of laten verzenden.</p>
      <a href={waHoi} class="knop knop-lint mt-7 min-h-12 px-5"><Icoon naam="wa" />WhatsApp</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Aanbod</p>
      <ul class="mt-5 space-y-2.5">
        {aanbod.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-lint">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-4">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2.5">
        <li><a href={site.telHref} class="num no-underline hover:text-lint">{site.tel}</a></li>
        <li><a href={waHoi} class="no-underline hover:text-lint">WhatsApp</a></li>
        <li>{site.plaats}</li>
        <li><a href={site.reviews} class="no-underline hover:text-lint">Kopasol op Google</a> · <a href={site.marktplaats} class="no-underline hover:text-lint">Ksol horren op Marktplaats</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-[.9375rem]">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-[.9375rem]">Teksten uit jullie Google-profiel en Marktplaats-advertenties, eigen foto's van Google en Marktplaats. Sfeerfoto's via Unsplash, ter illustratie. Reviews letterlijk van Google (stand 12 oktober 2026).</p>}
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
