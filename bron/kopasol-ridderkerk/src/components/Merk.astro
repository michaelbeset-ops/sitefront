---
// Strak woordmerk (geen eigen logo gevonden): een plissé-hor als beeldmerk, daarnaast KOPASOL.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex items-center gap-3 leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <svg viewBox="0 0 40 40" class="h-10 w-10 flex-none" aria-hidden="true"><rect x="3" y="3" width="34" height="34" fill="none" stroke="#f2b818" stroke-width="3"/><path d="M11 9v22M16 9v22M21 9v22M26 9v22M31 9v22" stroke="currentColor" stroke-width="1.6" opacity=".85"/></svg>
  <span class="flex flex-col">
    <span class="text-[1.6rem] font-[800] uppercase tracking-[.06em]" style="font-family: var(--font-kop)">Kopasol</span>
    <span class={`mt-1 text-[.68rem] font-[700] uppercase tracking-[.2em] ${donker ? 'text-steen' : 'text-mist'}`} style="font-family: var(--font-kop)">Plissé hordeuren</span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>
