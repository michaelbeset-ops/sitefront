              <span class="font-semibold">De trimsalon, op een winterse dag</span><span class="nr">Nr. 13</span>
            </figcaption>
          </figure>
          <div class="kaart flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-oranje" /><span><b class="font-semibold">{site.straat}</b><br /><span class="text-grijs">{site.postcode} {site.plaats}</span></span></p>
            <a href={site.maps} class="knop knop-inkt knop-klein shrink-0">Route plannen<Icoon naam="pijl" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Contact: WhatsApp-bericht samenstellen -->
    <section id="contact" class="bg-steen py-20 lg:py-24" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Afspraak maken</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Plan de trimbeurt van uw hond.</h2>
          <p class="mt-6 text-lg text-grijs">Vul in wat Tanja moet weten. Er staat dan meteen een net WhatsApp-bericht klaar; een foto van uw hond stuurt u er gewoon achteraan.</p>
          <ul class="mt-10 grid gap-3">
            <li><a href={waAfspraak} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-oranje text-wit"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5 text-oranje" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-steen text-oranje"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Ma t/m za bereikbaar</span></span><Icoon naam="pijl" class="h-5 w-5 text-oranje" /></a></li>
            <li><a href={`mailto:${site.mail}`} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-sm bg-steen text-oranje"><Icoon naam="mail" class="h-6 w-6" /></span><span class="min-w-0 flex-1"><b class="block font-semibold">E-mail</b><span class="block break-all text-grijs">{site.mail}</span></span><Icoon naam="pijl" class="h-5 w-5 shrink-0 text-oranje" /></a></li>
          </ul>
        </div>
        <form class="kaart p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Uw bericht aan Tanja</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot u in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Wat mag er gebeuren?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Volledige trimbeurt', 'Knippen of scheren', 'Plukken of strippen', 'Wassen en drogen', 'Anti-verharing', 'Nagels of oren', 'Puppy kennismaken'].map((b) => (
                <label class="keuze"><input type="radio" name="beh" value={b} class="sr-only" /><span>{b}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class="text-sm font-semibold">Ras of kruising</span><input name="ras" class="veld mt-2" placeholder="Bijvoorbeeld: Labradoodle" /></label>
            <label class="block"><span class="text-sm font-semibold">Naam van uw hond</span><input name="hond" class="veld mt-2" /></label>
            <label class="block"><span class="text-sm font-semibold">Voorkeursdag</span>
              <select name="dag" class="veld mt-2">
                <option value="">Maakt niet uit</option>
                {tijden.filter((t) => t.open).map((t) => <option>{t.naam}</option>)}
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Uw naam</span><input name="naam" autocomplete="given-name" class="veld mt-2" /></label>
            <label class="flex items-start gap-3 sm:col-span-2"><input type="checkbox" name="ophalen" class="vink mt-1" /><span>Ik kan mijn hond niet zelf brengen. Kan hij thuis opgehaald worden?</span></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="submit" class="knop knop-oranje"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs">Zaterdag en zondag is de salon dicht.</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 11. Slotbalk: kadobon -->
    <section class="bg-oranje text-wit" aria-labelledby="t-kado">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div class="flex items-start gap-5">
          <Icoon naam="cadeau" class="mt-1 hidden h-9 w-9 shrink-0 sm:block" />
          <div>
            <h2 id="t-kado" class="text-[clamp(1.75rem,2vw+1.2rem,2.5rem)]">Leuk idee: geef eens een kadobon.</h2>
            <p class="mt-2 text-lg text-wit/90">Voor alleen een was- en droogbeurt of een volledige behandeling.</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waMet('Hoi Tanja, ik wil graag een kadobon voor de trimsalon.')} class="knop knop-wit"><Icoon naam="wa" />Kadobon aanvragen</a>
          <a href={site.telHref} class="knop knop-rand op-foto num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Voor en na: tik om te wisselen.
  document.querySelectorAll<HTMLElement>('[data-vn]').forEach((f) => {
    const k = f.querySelector<HTMLButtonElement>('[data-vn-knop]');
    const l = f.querySelector<HTMLElement>('[data-vn-label]');
    const a = f.querySelector<HTMLElement>('[data-vn-actie]');
    k?.addEventListener('click', () => {
      const na = k.getAttribute('aria-pressed') !== 'true';
      k.setAttribute('aria-pressed', String(na));
      f.classList.toggle('is-na', na);
      if (l) l.textContent = na ? 'Na' : 'Voor';
      if (a) a.textContent = na ? 'Toon voor' : 'Toon na';
    });
  });

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hoi Tanja, ik wil graag een afspraak maken voor mijn hond.'];
      if (v('hond') || v('ras')) r.push('Hond: ' + [v('hond'), v('ras')].filter(Boolean).join(', '));
      if (v('beh')) r.push('Behandeling: ' + v('beh'));
      if (v('dag')) r.push('Het liefst op: ' + v('dag').toLowerCase());
      if (d.get('ophalen')) r.push('Ik kan mijn hond niet zelf brengen. Kan hij thuis opgehaald worden?');
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31616567935?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

<style>
  .text-hero { font-size: var(--text-hero); line-height: 1; letter-spacing: -0.045em; }
  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: var(--radius-sm); background: var(--color-wit); }
  .vn-na { opacity: 0; transition: opacity .5s var(--ease-zacht); }
  .vn.is-na .vn-na { opacity: 1; }
  .vn button:focus-visible { outline-offset: -3px; }
  .vn.is-na [data-vn-label] { background: var(--color-oranje); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 .95rem; border-radius: var(--radius-sm); background: var(--color-steen); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #dbdad3; }
  .keuze input:checked + span { background: var(--color-inkt); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-oranje); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-sm); border: 1.5px solid #1c202333; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #1c202366; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-oranje); }
  .veld::placeholder { color: #6f757a; }
  .vink { width: 1.15rem; height: 1.15rem; accent-color: var(--color-oranje); flex: none; }
</style>
