            <Image src={pand} alt="Het trimhuisje in de sneeuw, met het bord van Hondentrimsalon Tanja Springvloed en een zwarte hond op de tuintafel ervoor" widths={[499]} sizes="(min-width: 1024px) 499px, 92vw" class="mx-auto aspect-[3/2] w-full max-w-[31.2rem] object-cover" />
