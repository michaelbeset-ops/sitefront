---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, rassen, reviews, waAfspraak, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import fohnen from '../assets/fohnen.jpg';
import pand from '../assets/pand-sneeuw.jpg';
import tanja from '../assets/tanja.jpg';
import salon from '../assets/salon.jpg';
import maltVoor from '../assets/malt-voor.jpg';
import maltNa from '../assets/malt-na.jpg';
import poedelVoor from '../assets/poedel-voor.jpg';
import poedelNa from '../assets/poedel-na.jpg';
import spinVoor from '../assets/spinone-voor.jpg';
import spinNa from '../assets/spinone-na.jpg';
import sPoedel from '../assets/s-poedel.jpg';
import sJack from '../assets/s-jackrussell.jpg';
import sBorstel from '../assets/s-borstel.jpg';
import a1 from '../assets/w-9903324.jpg';
import a2 from '../assets/w-37163186.jpg';
import a3 from '../assets/w-21962953.jpg';
import a4 from '../assets/w-21963281.jpg';
import a5 from '../assets/w-21962523.jpg';
import a6 from '../assets/w-21963014.jpg';

const vraag = (b: string) => waMet(`Hoi Tanja, ik wil graag een afspraak maken voor mijn hond: ${b.toLowerCase()}.`);

const groot = [
  { t: 'Knippen en scheren', d: 'De vacht inkorten met schaar of tondeuse, of een combinatie van beide.', src: sPoedel, alt: 'Een zwarte poedel met een krullende, net geknipte kop', pos: '50% 22%' },
  { t: 'Plukken en strippen', d: 'Het dode haar eruit, met de hand of met een trimmesje. Wat overblijft is een korte, harde bovenvacht.', src: sJack, alt: 'Portret van een Jack Russell Terrier tegen een zachtroze achtergrond', pos: '50% 40%' },
  { t: 'Anti-verharing', d: 'Voor kortharige honden die het hele jaar verharen. Eens per 6 weken, daarna laat uw hond thuis nagenoeg niets meer los.', src: sBorstel, alt: 'Een hand borstelt de lange, goudbruine vacht van een hond', pos: '50% 50%' },
];

const klein = [
  { t: 'Wassen en drogen', i: 'druppel', d: 'Zachte shampoos: pH-neutraal, 100% biologisch, hypo-allergeen en dierproefvrij. Bij jeuk een medicinale shampoo.' },
  { t: 'Ontwollen en borstelen', i: 'schaar', d: 'De losse, oude ondervacht eruit en de klitten weg, ook in de oksels, de liezen en achter de oren.' },
  { t: 'Puppy kennismaken', i: 'pup', d: 'Vanaf ongeveer 8 weken even wennen aan de tafel, de föhn en de tondeuse. Hier zijn geen kosten aan verbonden.' },
];

const paren = [
  { naam: 'Maltezer', bij: 'voor de trimbeurt en na de trimbeurt', voor: maltVoor, na: maltNa, altV: 'Een witte Maltezer met een lange, vervilte vacht op de trimtafel', altN: 'Dezelfde Maltezer na de trimbeurt, kort en netjes', pv: '50% 50%', pn: '50% 40%' },
  { naam: 'Poedeltje', bij: 'voor de trimbeurt en na de trimbeurt', voor: poedelVoor, na: poedelNa, altV: 'Een poedel met een lange, verwarde vacht', altN: 'Dezelfde poedel na de trimbeurt, met een ronde kop en de tong uit de bek', pv: '50% 30%', pn: '50% 30%' },
  { naam: 'Spinone Italiano', bij: 'na een "slootbad" en na het wassen bij ons in de trimsalon', voor: spinVoor, na: spinNa, altV: 'Een Spinone Italiano met een modderige, natte vacht op de trimtafel', altN: 'Dezelfde Spinone Italiano schoon en droog na het wassen', pv: '50% 50%', pn: '50% 50%' },
];

const stappen = [
  ['Op de trimtafel', 'De eerste keer is dat even vreemd, maar dat went snel.'],
  ['Doorkammen', 'De vacht wordt helemaal doorgekamd en eventuele klitten worden verwijderd.'],
  ['Nagels en oren', 'De nagels worden geknipt en de haren in de oren worden verwijderd.'],
  ['Trimmen en wassen', 'Getrimd passend bij het vachttype, daarna in bad en weer gedroogd.'],
  ['In model', 'Volgens rasstandaard, of in overleg een model dat uw hond zo mooi mogelijk doet uitkomen.'],
];

const album = [
  { src: a1, alt: 'Een witte terriër met een leesbril op de neus' },
  { src: a2, alt: 'Een jonge Jack Russell met een rode halsband, van dichtbij' },
  { src: a3, alt: 'Een witte pluizige hond met een blauwe strik op de trimtafel' },
  { src: a4, alt: 'Een witte poedel in model geknipt, buiten op de tegels' },
  { src: a5, alt: 'Twee Berner Sennenhonden naast elkaar in de trimsalon' },
  { src: a6, alt: 'Een lichtbruine hond met een pluizige kop, van dichtbij' },
];

const tips = [
  'Breng uw hond zo droog mogelijk: een natte hond is moeilijk te behandelen.',
  'Breng uw hond nooit met een volle maag.',
  'Laat uw hond goed uit voordat u komt. De behandeling neemt enige uren in beslag.',
  'Heeft uw hond een medische of besmettelijke aandoening, zoals kennelhoest? Dan vernemen we dat graag.',
  'Breng uw hond aangelijnd mee.',
  'Wilt u uw hond vooraf zelf in bad doen? Overleg dat eerst, veel vachten zijn na een wasbeurt moeilijk te behandelen.',
  'Kunt u niet op een afspraak komen, laat het dan zo vroeg mogelijk weten.',
];
---
<Base title={`${site.naam} | Trimsalon in Lekkerkerk`} description="Gediplomeerd hondentrimster in Lekkerkerk, lid van de ABHB. Knippen, plukken, strippen, wassen en anti-verharing. 4,9 op Google. Afspraak via WhatsApp of 06 16 56 79 35.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: een hond op Tanja's eigen trimtafel -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[42%_30%] lg:left-[36%] lg:w-[64%] lg:object-[40%_35%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1c202340_0%,#1c2023b3_40%,#1c2023f5_100%)] md:bg-[linear-gradient(90deg,#1c2023f5_0%,#1c2023d9_45%,#1c202340_80%)] lg:bg-[linear-gradient(90deg,#1c2023_0%,#1c2023_36%,#1c2023b3_44%,#1c202300_62%),linear-gradient(0deg,#1c2023cc_0%,#1c202300_30%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-40 md:pb-24 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow">Hondentrimsalon in Lekkerkerk</p>
          <h1 id="t-hero" class="mt-5 text-hero">De trimsalon met net dat <span class="text-vuur">beetje meer.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">De beste kwaliteit voor een betaalbare prijs, waar uw hond nog met veel liefde en geduld behandeld wordt.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-oranje"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#voor-en-na" class="knop knop-rand op-foto">Bekijk voor en na</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m do 9.00 tot 17.00 uur</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 2. Rassen -->
    <section class="border-b border-lijn bg-wit" aria-labelledby="t-rassen">
      <div class="wrap flex flex-col gap-4 py-6 lg:flex-row lg:items-center lg:gap-8">
        <h2 id="t-rassen" class="shrink-0 font-sans text-sm font-semibold tracking-normal text-grijs">Extra gespecialiseerd in</h2>
        <ul class="-mx-5 flex gap-2 overflow-x-auto px-5 [scrollbar-width:none] lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0">
          {rassen.map((r) => <li class="shrink-0 rounded-sm border border-lijn bg-papier px-3 py-1.5 text-sm font-medium">{r}</li>)}
        </ul>
      </div>
    </section>

    <!-- 3. Behandelingen -->
    <section id="behandelingen" class="py-20 lg:py-24" aria-labelledby="t-beh">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Behandelingen</p>
            <h2 id="t-beh" class="mt-4 text-3xl">Iedere hond heeft een vacht-specifieke behandeling nodig.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Bij elke trimbeurt worden ook de oren schoongemaakt, de nagels geknipt en indien nodig de anaalklieren geleegd.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-14 lg:gap-6">
          {groot.map((b, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={vraag(b.t)} class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1248px) 380px, (min-width: 768px) 31vw, 92vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-end justify-between gap-4 p-6">
                  <div>
                    <p class="nr">0{i + 1}</p>
                    <h3 class="mt-2 text-xl">{b.t}</h3>
                    <p class="mt-2 text-grijs">{b.d}</p>
                  </div>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-steen text-oranje transition-colors group-hover:bg-oranje group-hover:text-wit" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-5 grid gap-5 md:grid-cols-3 lg:gap-6">
          {klein.map((b, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={vraag(b.t)} class="group flex h-full gap-4 rounded-md border border-lijn p-6 no-underline transition-colors hover:border-oranje hover:bg-wit">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-inkt text-vuur" aria-hidden="true"><Icoon naam={b.i} class="h-5 w-5" /></span>
                <span>
                  <span class="nr">0{i + 4}</span>
                  <h3 class="mt-1 text-lg">{b.t}</h3>
                  <span class="mt-1.5 block text-[.9375rem] text-grijs">{b.d}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-md bg-steen px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Alleen de nagels, de oren of een lekkere wasbeurt kan ook.</b> <span class="text-grijs">De prijs geeft Tanja in overleg door, passend bij de vacht en het formaat van uw hond.</span></p>
          <a href={waMet('Hoi Tanja, wat kost een behandeling voor mijn hond? Het ras is: ')} class="knop knop-inkt knop-klein shrink-0"><Icoon naam="wa" />Vraag de prijs</a>
        </div>
      </div>
    </section>

    <!-- 4. Voor en na (wow): eigen trimfoto's, omdraaien -->
    <section id="voor-en-na" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-vn">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="rijs lg:col-span-4">
          <p class="eyebrow">Trimfoto’s</p>
          <h2 id="t-vn" class="mt-4 text-3xl">Voor de trimbeurt, en erna.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Dit zijn wel wat extreme voorbeelden. Deze hondjes hadden helaas veel vervilte klitten, en dan zit er niets anders op dan ze goed kort te maken.</p>
          <p class="mt-4 text-licht-zacht">Tik op een foto om de hond erna te zien.</p>
          <a href={waAfspraak} class="knop knop-oranje mt-8"><Icoon naam="wa" />Plan een trimbeurt</a>
        </div>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-6 lg:col-span-8 lg:gap-5">
          {paren.map((p, i) => (
            <li class="rijs" style={`--d:${i * 0.07}s`}>
              <figure class="vn bg-licht p-2 pb-3 text-inkt" data-vn>
                <button type="button" class="relative block aspect-square w-full overflow-hidden bg-steen text-left" aria-pressed="false" data-vn-knop>
                  <Image src={p.voor} alt={p.altV} widths={[280]} sizes="280px" class="vn-voor absolute inset-0 h-full w-full object-cover" style={`object-position:${p.pv}`} />
                  <Image src={p.na} alt={p.altN} widths={[280]} sizes="280px" class="vn-na absolute inset-0 h-full w-full object-cover" style={`object-position:${p.pn}`} />
                  <span class="vn-label absolute left-2 top-2 rounded-sm bg-inkt px-2 py-1 text-xs font-semibold text-licht" data-vn-label>Voor</span>
                  <span class="absolute bottom-2 right-2 flex items-center gap-1.5 rounded-sm bg-wit px-2.5 py-1.5 text-xs font-semibold text-inkt shadow-sm"><Icoon naam="draai" class="h-3.5 w-3.5 text-oranje" /><span data-vn-actie>Toon na</span></span>
                </button>
                <figcaption class="px-1 pt-3">
                  <span class="flex items-baseline justify-between gap-3"><b class="font-semibold">{p.naam}</b><span class="nr">Nr. 0{i + 1}</span></span>
                  <span class="mt-0.5 block text-sm text-grijs">{p.bij}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Zo gaat een trimbeurt -->
    <section class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">In de trimsalon</p>
          <h2 id="t-stappen" class="rijs mt-4 text-3xl">Wat er gebeurt met uw hond.</h2>
          <ol class="mt-10 border-t border-lijn">
            {stappen.map(([t, d], i) => (
              <li class="rijs grid grid-cols-[3rem_1fr] gap-x-4 border-b border-lijn py-5 sm:grid-cols-[4rem_12rem_1fr] sm:items-baseline" style={`--d:${i * 0.05}s`}>
                <span class="num font-kop text-xl font-extrabold text-oranje">0{i + 1}</span>
                <h3 class="text-lg">{t}</h3>
                <p class="col-start-2 mt-1 text-grijs sm:col-start-3 sm:mt-0">{d}</p>
              </li>
            ))}
          </ol>
          <p class="rijs mt-8 max-w-xl text-lg">Inmiddels zijn we enkele uren verder en kunt u uw hond komen halen. <span class="text-grijs">Vergeet niet te vertellen hoe mooi hij geworden is.</span></p>
        </div>
        <div class="rijs lg:col-span-5 lg:pt-6" style="--d:.08s">
          <figure class="afdruk mx-auto max-w-[31.5rem] lg:ml-auto lg:mr-0">
            <Image src={fohnen} alt="Tanja föhnt een zwarte poedel op de trimtafel in haar salon" widths={[500]} sizes="(min-width: 1024px) 400px, 92vw" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="flex items-baseline justify-between gap-3 px-1 pt-3 text-sm">
              <span class="font-semibold">Tanja aan het werk</span><span class="nr">Nr. 04</span>
            </figcaption>
          </figure>
          <p class="mx-auto mt-6 max-w-[31.5rem] text-[.9375rem] text-grijs lg:ml-auto lg:mr-0">Aan het einde van de dag wordt de trimsalon grondig gereinigd. De trimmaterialen worden gesteriliseerd, bad en trimtafel gereinigd met een goed desinfectiemiddel.</p>
        </div>
      </div>
    </section>

    <!-- 6. Over Tanja -->
    <section id="tanja" class="bg-steen py-20 lg:py-24" aria-labelledby="t-tanja">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-12">
        <div class="rijs lg:col-span-5">
          <figure class="afdruk mx-auto max-w-[32.5rem]">
            <Image src={tanja} alt="Tanja tussen het riet met haar eigen honden, een zwarte en een Berner Sennenhond" widths={[518]} sizes="(min-width: 1024px) 500px, 92vw" class="aspect-[518/450] w-full object-cover" />
            <figcaption class="flex items-baseline justify-between gap-3 px-1 pt-3 text-sm">
              <span class="font-semibold">Tanja met haar eigen honden</span><span class="nr">Nr. 05</span>
            </figcaption>
          </figure>
        </div>
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Over Tanja</p>
          <h2 id="t-tanja" class="rijs mt-4 text-3xl">Trimster, fotograaf en helemaal gek op honden.</h2>
          <div class="rijs mt-6 space-y-4 text-lg text-grijs" style="--d:.05s">
            <p>Tanja Springvloed is officieel gediplomeerd hondentrimster en lid van de ABHB, dé vakvereniging voor gediplomeerde en erkende trimsalons.</p>
            <p>Door haar eigen honden Meggy, Banjer en Sheila volgde ze de opleiding. Die drie kanjers staan nog altijd in haar logo. Naast het trimmen is Tanja fotograaf: veel kinderen, honden en paarden.</p>
          </div>
          <ul class="mt-9 grid gap-3 sm:grid-cols-3">
            <li class="rijs kaart p-5" style="--d:.04s"><Icoon naam="diploma" class="h-7 w-7 text-oranje" /><h3 class="mt-4 text-[1.0625rem]">Gediplomeerd en ABHB-lid</h3><p class="mt-1 text-[.9375rem] text-grijs">Met de algemene leveringsvoorwaarden van de ABHB.</p></li>
            <li class="rijs kaart p-5" style="--d:.08s"><Icoon naam="kruis" class="h-7 w-7 text-oranje" /><h3 class="mt-4 text-[1.0625rem]">ABHB EHBO-diploma</h3><p class="mt-1 text-[.9375rem] text-grijs">Naast het trimdiploma heeft Tanja haar EHBO-diploma van de ABHB.</p></li>
            <li class="rijs kaart p-5" style="--d:.12s"><Icoon naam="huis" class="h-7 w-7 text-oranje" /><h3 class="mt-4 text-[1.0625rem]">Ophalen in overleg</h3><p class="mt-1 text-[.9375rem] text-grijs">Kunt u niet zelf brengen? Tanja haalt uw hond thuis op.</p></li>
          </ul>
        </div>
      </div>
      <div class="wrap mt-16 lg:mt-20">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-lijn pb-4">
          <h3 class="text-xl">Uit het album van de trimsalon</h3>
          <p class="text-[.9375rem] text-grijs">Foto’s: Tanja Springvloed</p>
        </div>
        <ul class="mt-6 grid grid-cols-3 gap-3 md:grid-cols-6 md:gap-4">
          {album.map((a, i) => (
            <li class="rijs" style={`--d:${(i % 6) * 0.04}s`}>
              <figure class="afdruk p-1.5">
                <Image src={a.src} alt={a.alt} widths={[200]} sizes="(min-width: 1248px) 190px, (min-width: 768px) 15vw, 30vw" class="aspect-square w-full object-cover" />
                <figcaption class="nr px-0.5 pt-1.5">Nr. {String(i + 6).padStart(2, '0')}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Tips -->
    <section class="donker bg-nacht py-20 text-licht lg:py-28" aria-labelledby="t-tips">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="rijs lg:col-span-4">
          <p class="eyebrow">Tips</p>
          <h2 id="t-tips" class="mt-4 text-3xl">Goed voorbereid naar de trimsalon.</h2>
          <figure class="mt-8 hidden max-w-[17rem] bg-licht p-2 pb-3 text-inkt lg:block">
            <Image src={salon} alt="De trimsalon van binnen: een grijze trimtafel, een witte vakkenkast met handdoeken en shampoos en een blauwe wand" widths={[400]} sizes="260px" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="flex items-baseline justify-between gap-3 px-1 pt-3 text-sm"><span class="font-semibold">De trimsalon</span><span class="nr">Nr. 12</span></figcaption>
          </figure>
        </div>
        <ol class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
          {tips.map((t, i) => (
            <li class="rijs flex gap-4 border-t border-lijn-licht py-4" style={`--d:${(i % 2) * 0.05}s`}>
              <span class="nr pt-1">0{i + 1}</span>
              <p class="text-licht">{t}</p>
            </li>
          ))}
          <li class="rijs flex gap-4 border-t border-lijn-licht py-4">
            <span class="pt-0.5 text-vuur"><Icoon naam="pup" class="h-5 w-5" /></span>
            <p class="text-licht-zacht">Puppy? Kom gewoon eens langs om kennis te maken. Wacht niet te lang met een afspraak, want meestal is er een wachttijd.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat baasjes zeggen.</h2>
          </div>
