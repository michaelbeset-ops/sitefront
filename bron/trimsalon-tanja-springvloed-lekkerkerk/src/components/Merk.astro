---
// Woordmerk naar hun eigen logo: de drie hondenkoppen (Meggy, Banjer en Sheila) op een wit tegeltje,
// "Tanja Springvloed" in oranje en HONDENTRIMSALON klein eronder.
import { Image } from 'astro:assets';
import { url, site } from '../data/site';
import honden from '../assets/logo-honden.png';
---
<a href={url('')} class="merk">
  <span class="hidden h-11 w-[4.25rem] shrink-0 min-[380px]:grid place-items-center rounded-sm bg-wit px-1 shadow-sm ring-1 ring-lijn" aria-hidden="true">
    <Image src={honden} alt="" width={148} height={92} widths={[74, 148]} sizes="68px" loading="eager" class="h-auto w-full" />
  </span>
  <span><b>Tanja Springvloed</b><small>Hondentrimsalon</small></span>
</a>
