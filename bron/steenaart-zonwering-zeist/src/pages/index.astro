---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Waaier from '../components/Waaier.astro';
import { site, reviews, tijden, waHoi } from '../data/site';

import hero from '../assets/hero.jpg';
import markiesOnder from '../assets/markies-onder.jpg';
import knikarm from '../assets/knikarm.jpg';
import markiesStreep from '../assets/markies-streep.jpg';
import rolluikenGevel from '../assets/rolluiken-gevel.jpg';
import rolluikenFlat from '../assets/rolluiken-flat.jpg';
import folieKantoor from '../assets/folie-kantoor.jpg';
import folieDeur from '../assets/folie-deur.jpg';
import toscane from '../assets/markies-toscane.jpg';
import screensTuin from '../assets/screens-tuin.jpg';
import lunchDiner from '../assets/lunch-diner.jpg';
import screensWit from '../assets/screens-wit.jpg';
import pergola from '../assets/pergola.jpg';
import terras from '../assets/terras.jpg';

const galerij = [
  { src: toscane, alt: 'Een markies in groen, wit en rood boven de etalage van een hoekpand', cls: 'col-span-2 md:col-span-7 md:row-span-2', ar: 'aspect-[4/3] md:aspect-auto md:h-full', pos: 'object-[50%_60%]' },
  { src: screensTuin, alt: 'Neergelaten donkere screens langs de glazen gevel van een laag gebouw, met een olijfboompje ervoor', cls: 'md:col-span-5', ar: 'aspect-[4/3]', pos: 'object-center' },
  { src: lunchDiner, alt: 'Een donker uitvalscherm met de woorden Lunch en Diner boven de ramen van een restaurant', cls: 'md:col-span-5', ar: 'aspect-[4/3]', pos: 'object-[50%_45%]' },
  { src: screensWit, alt: 'Lichte screens voor een grote glazen pui', cls: 'md:col-span-4', ar: 'aspect-[4/3]', pos: 'object-center' },
  { src: pergola, alt: 'Een wit frame van een terrasscherm voor een bakstenen gebouw', cls: 'md:col-span-4', ar: 'aspect-[4/3]', pos: 'object-center' },
  { src: terras, alt: 'Onder het frame van een terrasscherm door kijkend naar bomen en water', cls: 'md:col-span-4', ar: 'aspect-[4/3]', pos: 'object-center' },
];

const wat = ['advies', 'een offerte', 'een reparatie'];
const voor = ['een zonnescherm', 'een screen', 'een markies', 'een rolluik', 'zonwerende folie', 'een nieuw doek'];
const [groot, ...klein] = reviews;
---
<Base title={`${site.naam} | Zeist`} description="Steenaart Zonwering uit Zeist: uw specialist in buitenzonwering en rolluiken, en in zonwerende folie. Advies of offerte via WhatsApp.">
  <Kop />
  <main id="inhoud">
    <!-- 1. Hero: onder het doek -->
    <section class="relative isolate flex min-h-[calc(100svh-4.25rem)] items-end overflow-hidden bg-grafiet text-wit md:min-h-[calc(100svh-4.75rem)]">
      <Image src={hero} alt="Uitzicht van onder een licht terrasscherm naar een grasveld, een bankje en het water" quality={74} widths={[480, 720, 960, 1280, 1584]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[46%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1b1d1f40_0%,#1b1d1f00_30%,#1b1d1f8c_62%,#1b1d1ff0_100%)] md:bg-[linear-gradient(90deg,#1b1d1fe6_0%,#1b1d1fa6_40%,#1b1d1f1a_75%),linear-gradient(0deg,#1b1d1fb3_0%,#1b1d1f00_45%)]"></div>
      <div class="wrap pb-24 pt-28 md:pb-16">
        <p class="kop flex items-center gap-3 text-lg tracking-[.14em] text-zon"><Waaier class="h-5 w-5" streep={2.4} />Steenaart Zonwering · {site.plaats}</p>
        <h1 class="mt-5 max-w-[17ch] text-hero">Uw specialist in buiten&shy;zonwering en <span class="text-zon">rolluiken</span></h1>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-wit/90 md:text-xl">De vakman met jarenlange ervaring in zonwering en rolluiken. Ook heeft hij zich bekwaamd in zonweringfolie.</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="#advies" class="knop"><Icoon naam="wa" />Advies via WhatsApp</a>
          <a href={site.telHref} class="kop num inline-flex items-center gap-2 text-xl tracking-[.06em] text-wit no-underline transition-colors hover:text-zon"><Icoon naam="tel" class="h-5 w-5" />{site.tel}</a>
        </div>
      </div>
    </section>
    <div class="h-2 bg-zon"></div>
    <div class="volant" aria-hidden="true"></div>

    <!-- 2. Intro: grote typografische regel + de waaier van een markies -->
    <section class="wrap grid gap-y-12 pb-20 pt-14 md:grid-cols-12 md:gap-x-10 md:pb-28 md:pt-20">
      <div class="md:col-span-7">
        <h2 class="rijs text-[clamp(2.75rem,5vw+.5rem,5.75rem)]">Grote product&shy;kennis. <span class="block text-grijs">Jarenlange montage-ervaring.</span></h2>
        <div class="rijs mt-10 max-w-xl space-y-4 text-lg text-grijs md:ml-[12%]" style="--d:.1s">
          <p><strong class="font-semibold text-inkt">Steenaart Zonwering is het bedrijf van {site.eigenaar}.</strong> Hij levert, monteert en repareert zonwering en rolluiken.</p>
          <p>Hieronder ziet u wat hij doet, en een deel van zijn werk.</p>
        </div>
      </div>
      <figure class="rijs md:col-span-5 md:-mt-4" style="--d:.15s">
        <Image src={markiesOnder} alt="Van onderen gezien: de baleinen van een geel-rood gestreepte markies waaieren uit naast een raam" quality={70} widths={[420, 640, 860]} sizes="(min-width: 768px) 38vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[35%_50%] md:aspect-square" />
      </figure>
    </section>

    <!-- 3. Werk -->
    <section id="werk" class="border-t border-lijn">
      <!-- Buitenzonwering -->
      <article class="wrap grid gap-y-10 py-20 md:grid-cols-12 md:gap-x-10 md:py-28">
        <div class="md:col-span-5 md:pt-6">
          <h2 class="rijs text-3xl">Buiten&shy;zonwering</h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs" style="--d:.08s">Zonneschermen, markiezen en screens. Ook voor een nieuw doek of een kapotte knikarm.</p>
          <figure class="rijs mt-10 hidden md:block" style="--d:.12s">
            <Image src={markiesStreep} alt="Een rood-wit gestreepte markies met golvende rand naast een groene voordeur" quality={66} widths={[360, 560]} sizes="34vw" class="aspect-[16/10] w-full rounded-sm object-cover" />
          </figure>
        </div>
        <figure class="rijs md:col-span-7" style="--d:.1s">
          <Image src={knikarm} alt="Een uitgerold zonnescherm met knikarmen schuin boven de ramen van een woning" quality={68} widths={[480, 720, 960]} sizes="(min-width: 768px) 55vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[60%_35%] md:aspect-[16/11]" />
        </figure>
      </article>

      <!-- Rolluiken -->
      <article class="bg-kalk-2">
        <div class="wrap grid gap-y-10 py-20 md:grid-cols-12 md:gap-x-10 md:py-28">
          <figure class="rijs md:col-span-7 md:row-start-1">
            <Image src={rolluikenFlat} alt="Een appartementengebouw met ronde gevel en lichte rolluiken voor de ramen" quality={68} widths={[480, 720, 960, 1280]} sizes="(min-width: 768px) 55vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-[16/10]" />
          </figure>
          <div class="md:col-span-5 md:col-start-8 md:row-start-1 md:flex md:flex-col md:justify-between">
            <div>
              <h2 class="rijs text-3xl">Rol&shy;luiken</h2>
              <p class="rijs mt-6 max-w-md text-lg text-grijs" style="--d:.08s">Nieuwe rolluiken, ook op solar. En een rolluik repareren.</p>
            </div>
            <figure class="rijs mt-10 md:mt-0" style="--d:.12s">
              <Image src={rolluikenGevel} alt="Een bakstenen woning met vier donkere rolluiken voor de ramen tegen een blauwe lucht" quality={70} widths={[360, 560, 800]} sizes="(min-width: 768px) 34vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover md:aspect-[16/10]" />
            </figure>
          </div>
        </div>
      </article>

      <!-- Zonwerende folie -->
      <article class="wrap grid gap-y-10 py-20 md:grid-cols-12 md:gap-x-10 md:py-28">
        <div class="md:col-span-5">
          <h2 class="rijs text-3xl">Zon&shy;werende folie</h2>
          <p class="rijs mt-6 max-w-md text-lg text-grijs" style="--d:.08s">Van binnenuit vrijwel doorzichtig, van buiten gezien niet. Voor ramen waar geen zonwering kan of hoeft.</p>
          <ul class="rijs mt-8 max-w-md" style="--d:.12s">
            <li class="spec"><span>Minder last van de warmte</span><span></span><Icoon naam="vink" class="h-5 w-5 flex-none" /></li>
            <li class="spec"><span>Meubels verkleuren minder snel</span><span></span><Icoon naam="vink" class="h-5 w-5 flex-none" /></li>
            <li class="spec"><span>Werkt inbraakwerend</span><span></span><Icoon naam="vink" class="h-5 w-5 flex-none" /></li>
            <li class="spec"><span>Lagere onderhoudskosten</span><span></span><Icoon naam="vink" class="h-5 w-5 flex-none" /></li>
          </ul>
        </div>
        <div class="grid grid-cols-5 gap-3 md:col-span-7 md:gap-4">
          <figure class="rijs col-span-3" style="--d:.1s">
            <Image src={folieKantoor} alt="Een vergaderruimte met een strook matte folie op de onderkant van de ramen" quality={68} widths={[360, 560, 800]} sizes="(min-width: 768px) 34vw, 60vw" class="h-full min-h-[16rem] w-full rounded-sm object-cover md:min-h-[24rem]" />
          </figure>
          <figure class="rijs col-span-2" style="--d:.16s">
            <Image src={folieDeur} alt="Glazen deuren in een kantoor met een brede strook matte folie op ooghoogte" quality={68} widths={[280, 420, 600]} sizes="(min-width: 768px) 23vw, 40vw" class="h-full min-h-[16rem] w-full rounded-sm object-cover object-[40%_50%] md:min-h-[24rem]" />
          </figure>
        </div>
      </article>
    </section>

    <!-- 4. Referenties -->
    <section id="referenties" class="bg-grafiet text-wit">
      <div class="volant -scale-y-100 [--c:var(--color-kalk)]" aria-hidden="true"></div>
      <div class="wrap py-16 md:py-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs text-reus">Referenties</h2>
          <p class="rijs max-w-sm text-lg text-mist" style="--d:.08s">Een scala aan werkzaamheden, van markies tot screens.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-4">
          {galerij.map((g, i) => (
            <li class:list={['rijs', g.cls]} style={`--d:${(i % 3) * 0.06}s`}>
              <button type="button" class="group block h-full w-full overflow-hidden rounded-sm" data-groot={g.src.src} data-alt={g.alt} aria-label={`Vergroot: ${g.alt}`}>
                <Image src={g.src} alt={g.alt} quality={64} widths={[480, 720, 960, 1280]} sizes={g.cls.includes('12') ? '(min-width: 768px) 90vw, 100vw' : '(min-width: 768px) 50vw, 100vw'} class:list={['w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]', g.ar, g.pos]} />
              </button>
            </li>
          ))}
        </ul>
      </div>
      <dialog class="m-auto max-h-[92vh] w-[min(92vw,72rem)] bg-transparent p-0 backdrop:bg-grafiet/90" data-lightbox>
        <form method="dialog" class="flex justify-end"><button class="kop mb-2 min-h-11 px-3 text-lg text-wit" aria-label="Sluiten">Sluiten ✕</button></form>
        <img src="" alt="" class="max-h-[82vh] w-full rounded-sm object-contain" data-lightbox-img />
      </dialog>
    </section>

    <!-- 5. Wow: zinsbouwer naar WhatsApp -->
    <section id="advies" class="relative isolate overflow-hidden bg-zon text-grafiet">
      <Waaier class="pointer-events-none absolute -bottom-24 -right-24 -z-10 h-[34rem] w-[34rem] text-grafiet/10 md:h-[46rem] md:w-[46rem]" streep={.5} />
      <div class="wrap py-16 md:py-24">
        <h2 class="rijs text-3xl">Vertel wat u zoekt</h2>
        <form class="rijs mt-10 max-w-5xl" style="--d:.08s" data-zin>
          <p class="kop text-[2rem] font-semibold leading-[1.45] tracking-normal md:text-[3.25rem] md:leading-[1.35]">
            Ik wil graag
            <label class="sr-only" for="z-wat">Waarvoor</label>
            <select id="z-wat" class="woord kop" data-wat>{wat.map((w) => <option>{w}</option>)}</select>
            voor
            <label class="sr-only" for="z-voor">Wat</label>
            <select id="z-voor" class="woord kop" data-voor>{voor.map((w) => <option>{w}</option>)}</select>,
            ongeveer
            <label class="sr-only" for="z-breed">Breedte in centimeters (mag leeg)</label>
            <input id="z-breed" class="woord kop num" inputmode="numeric" maxlength="4" placeholder="..." data-breed /> cm breed, in
            <label class="sr-only" for="z-plaats">Plaats</label>
            <input id="z-plaats" class="woord kop plaats" maxlength="30" value={site.plaats} data-plaats />.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={waHoi} class="knop knop-donker" data-stuur><Icoon naam="wa" />Stuur via WhatsApp</a>
            <p class="max-w-sm text-[.9375rem] font-medium">Een foto van het raam of de gevel kunt u in WhatsApp meesturen.</p>
          </div>
          <p class="mt-8 max-w-2xl border-l-4 border-grafiet pl-4 text-[.9375rem]" aria-live="polite"><span class="font-semibold">Uw bericht:</span> <span data-voorbeeld></span></p>
        </form>
      </div>
    </section>

    <!-- 6. Reviews -->
    <section id="reviews" class="wrap grid gap-y-14 py-20 md:grid-cols-12 md:gap-x-10 md:py-24">
      <figure class="rijs md:col-span-7">
        <Waaier class="h-12 w-12 text-zon" streep={2.4} />
        <blockquote class="mt-6 font-kop text-[2rem] font-semibold leading-[1.15] md:text-[2.75rem]">“{groot.tekst}”</blockquote>
        <figcaption class="mt-6 text-grijs">{groot.naam}, Google review</figcaption>
      </figure>
      <div class="md:col-span-5 md:pt-4">
        <ul class="divide-y divide-lijn border-y border-lijn">
          {klein.map((r, i) => (
            <li class="rijs py-6" style={`--d:${i * 0.06}s`}>
              <blockquote class="text-lg leading-snug">“{r.tekst}”</blockquote>
              <p class="mt-2 text-sm text-grijs">{r.naam}</p>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-grijs"><span class="num">{site.google.score}</span> op Google, {site.google.aantal} reviews</p>
      </div>
    </section>

    <!-- 7. Contact -->
    <section id="contact" class="border-t border-lijn bg-kalk-2">
      <div class="wrap grid gap-y-12 py-20 md:grid-cols-12 md:gap-x-10 md:py-28">
        <div class="md:col-span-6">
          <h2 class="rijs text-reus">Bel of app <span class="text-grijs">Robin</span></h2>
          <div class="rijs mt-10 space-y-3 text-lg" style="--d:.08s">
            <p><a href={site.telHref} class="kop num text-[2rem] tracking-[.04em] text-inkt no-underline hover:text-grijs">{site.tel}</a></p>
            <p><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
            <p class="flex items-center gap-2 text-grijs"><Icoon naam="pin" class="h-5 w-5" />{site.plaats}</p>
          </div>
          <a href={waHoi} class="knop rijs mt-10" style="--d:.12s"><Icoon naam="wa" />WhatsApp</a>
        </div>
        <div class="rijs md:col-span-5 md:col-start-8" style="--d:.1s">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-2xl">Openingstijden</h3>
            <p class="text-sm font-semibold" data-nu></p>
          </div>
          <ul class="mt-4 border-t border-lijn">
            {[1, 2, 3, 4, 5, 6, 0].map((d) => (
              <li class="spec px-2" data-dag={d}><span>{tijden[d][0]}</span><span></span><span class="num">{tijden[d][1] ?? 'Gesloten'}</span></li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-grijs">Tijden zoals op Google.</p>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script>
    // Lightbox
    const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
    document.querySelectorAll<HTMLButtonElement>('[data-groot]').forEach((b) => b.addEventListener('click', () => {
      if (!dlg || !img) return; img.src = b.dataset.groot!; img.alt = b.dataset.alt!; dlg.showModal();
    }));
    dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

    // Zinsbouwer -> WhatsApp
    const f = document.querySelector<HTMLFormElement>('[data-zin]');
    if (f) {
      const q = <T extends Element>(s: string) => f.querySelector<T>(s)!;
      const wat = q<HTMLSelectElement>('[data-wat]'), voor = q<HTMLSelectElement>('[data-voor]');
      const breed = q<HTMLInputElement>('[data-breed]'), plaats = q<HTMLInputElement>('[data-plaats]');
      const stuur = document.querySelector<HTMLAnchorElement>('[data-stuur]')!, vb = document.querySelector<HTMLElement>('[data-voorbeeld]')!;
      const bouw = () => {
        breed.value = breed.value.replace(/\D/g, '');
        let t = `Hallo Robin, ik wil graag ${wat.value} voor ${voor.value}`;
        if (breed.value) t += `, ongeveer ${breed.value} cm breed`;
        if (plaats.value.trim()) t += `, in ${plaats.value.trim()}`;
        t += '.';
        vb.textContent = t;
        stuur.href = `https://wa.me/31611392688?text=${encodeURIComponent(t)}`;
      };
      const maat = (el: HTMLSelectElement) => { const c = document.createElement('canvas').getContext('2d')!; const cs = getComputedStyle(el); c.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`; el.style.width = `calc(${Math.ceil(c.measureText(el.value.toUpperCase()).width * 1.04)}px + 2.4rem)`; };
      [wat, voor].forEach((el) => { maat(el); el.addEventListener('change', () => maat(el)); }); document.fonts?.ready.then(() => [wat, voor].forEach(maat));
      f.addEventListener('input', bouw); f.addEventListener('change', bouw); f.addEventListener('submit', (e) => e.preventDefault()); bouw();
    }

    // Vandaag + nu open
    const nu = new Date(), d = nu.getDay(), m = nu.getHours() * 60 + nu.getMinutes();
    document.querySelector(`[data-dag="${d}"]`)?.classList.add('font-semibold', 'bg-zon', 'rounded-sm');
    const nuEl = document.querySelector('[data-nu]');
    if (nuEl) nuEl.textContent = d !== 0 && m >= 600 && m < 1020 ? 'Nu open' : 'Nu gesloten';
  </script>
</Base>
