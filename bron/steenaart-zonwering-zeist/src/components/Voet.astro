---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const werk = ['Buitenzonwering', 'Rolluiken', 'Zonwerende folie', 'Reparatie en nieuw doek'];
---
<footer class="bg-grafiet text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Uw specialist in buitenzonwering en rolluiken, uit {site.plaats}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="kop text-lg text-wit">Werk</p>
      <ul class="mt-3 space-y-1">{werk.map((p) => <li><a href={url('#werk')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="kop text-lg text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="kop text-lg text-wit">Open</p>
      <p class="mt-3">Ma t/m za<br /><span class="num">{tijden[1][1]}</span><br />Zondag gesloten</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen website (referenties). Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
