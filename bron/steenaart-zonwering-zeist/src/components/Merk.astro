---
import Waaier from './Waaier.astro';
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<a href={url('')} class:list={['flex items-center gap-3 no-underline', licht ? 'text-wit' : 'text-inkt']}>
  <span class="grid h-10 w-10 place-items-center rounded-sm bg-zon text-grafiet"><Waaier class="h-7 w-7" streep={2.2} /></span>
  <span class="leading-none">
    <span class="kop block text-[1.65rem] tracking-[.04em]">Steenaart</span>
    <span class="block font-kop text-[.8125rem] font-semibold uppercase tracking-[.16em] opacity-75">Zonwering en rolluiken</span>
  </span>
</a>
