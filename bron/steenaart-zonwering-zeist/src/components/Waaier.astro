---
// Eigen detail 2: de waaier van baleinen onder een markies (referentiefoto 17), als merkteken.
interface Props { class?: string; streep?: number }
const { class: cls = '', streep = 1.6 } = Astro.props;
const hoeken = [0, 15, 30, 45, 60, 75, 90];
---
<svg class={cls} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width={streep} stroke-linecap="round" aria-hidden="true">
  {hoeken.map((h) => { const r = (h * Math.PI) / 180; return <line x1="4" y1="44" x2={(4 + 40 * Math.cos(r)).toFixed(2)} y2={(44 - 40 * Math.sin(r)).toFixed(2)} />; })}
  <path d="M44 44A40 40 0 0 0 4 4" />
  <path d="M30 44A26 26 0 0 0 4 18" opacity=".55" />
</svg>
