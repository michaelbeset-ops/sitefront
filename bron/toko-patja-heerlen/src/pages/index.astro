---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, wa, waMet, berichten, TIJDEN } from '../data/site';
import { kawung } from '../data/kawung';
import HeroFoto from '../components/HeroFoto.astro';
import vitrine from '../assets/vitrine.jpg';
import rendang from '../assets/rendang.jpg';
import bami from '../assets/bami.jpg';
import tafel from '../assets/tafel.jpg';
import tjendol from '../assets/tjendol.jpg';
import gevel from '../assets/gevel.jpg';

const gerechten = ['Rendang', 'Sate', 'Bami', 'Nasi', 'Rijsttafel', 'Sambal', 'Streetfood', 'Tjendol'];
const rijen = [
  { dagen: 'Maandag en dinsdag', nrs: [1, 2], t: null },
  { dagen: 'Woensdag t/m zaterdag', nrs: [3, 4, 5, 6], t: TIJDEN[3] },
  { dagen: 'Zondag', nrs: [0], t: TIJDEN[0] },
];
---
<Base
  title="Toko Patja | Indonesische specialiteiten aan het Wilhelminaplein, Heerlen"
  description="Toko Patja op het Wilhelminaplein in Heerlen: circa 40 traditionele Indonesische gerechten per dag. Aan tafel, afhalen of catering. Bestellen via WhatsApp."
>
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. De gedekte tafel: hun batikfoto als tafelkleed, het servetzakje erop. -->
    <section class="relative" aria-labelledby="naam">
      <div class="h-[min(96vw,30rem)] overflow-hidden md:h-[clamp(36rem,calc(100svh-6.25rem),54rem)]">
        <HeroFoto alt="Tientallen schaaltjes en borden met Indonesische gerechten op een rood-blauw batikkleed, van bovenaf" />
      </div>
      <div class="wrap relative md:absolute md:inset-x-0 md:-bottom-16">
        <div class="op-donker relative -mt-16 flex flex-col bg-antraciet px-7 pb-9 pt-10 text-center text-koper md:mt-0 md:w-[22.5rem] md:px-9 md:pb-12 md:pt-12 lg:ml-[4%]">
          <span class="mx-auto hidden h-14 w-14 rounded-full border border-koper/70 p-2.5 md:block" set:html={kawung} />
          <h1 id="naam" class="toko md:mt-7 text-[clamp(2.9rem,11vw,3.6rem)] leading-[1.02] tracking-[.2em] [margin-right:-.2em]">Toko<br />Patja</h1>
          <p class="toko-klein mt-5 text-koper/90">Indonesische specialiteiten<br />Restaurant · Catering · Afhaal</p>
          <p class="mx-auto mt-7 max-w-[15em] border-t border-koper/30 pt-7 md:mt-8 md:pt-8 text-[1.55rem] italic leading-[1.2] text-rijst">
            De smaak van Indonesië in het hart van Heerlen.
          </p>
          <a href={waMet(berichten.afhalen)} class="knop mt-7 w-full justify-center md:mt-8"><Fragment set:html={wa} />Bestel om af te halen</a>
          <p class="mt-4 text-sm text-rijst/85">of bel <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a></p>
          <p class="toko-klein mt-10 text-koper/85 md:mt-12">Wilhelminaplein 5<br />Wo t/m za 12-20 · zo 14-20</p>
        </div>
      </div>
    </section>

    <!-- 2. De vitrine: hun eigen zin, de bakken, dan de borden. -->
    <section id="vitrine" class="scroll-mt-16 pb-24 pt-16 md:pb-32 md:pt-20" aria-labelledby="vitrine-kop">
      <div class="wrap grid gap-y-10 md:grid-cols-12 md:gap-x-10">
        <h2 id="vitrine-kop" class="text-[clamp(2.1rem,2.6vw+1.2rem,3.9rem)] leading-[1.06] md:col-span-8 md:col-start-5 lg:col-span-7 lg:col-start-6">
          Op dagelijkse basis bereiden wij circa <span class="text-koper-donker">40</span> traditionele Indonesische gerechten.
        </h2>
        <figure class="md:col-span-8 md:col-start-1 lg:col-span-8 lg:mt-8">
          <div class="aspect-[3/2] overflow-hidden"><Foto src={vitrine} alt="De vitrine van Toko Patja: stalen bakken vol gerechten, met gehaktballetjes en eieren in saus vooraan" sizes="(min-width: 768px) 66vw, 100vw" /></div>
        </figure>
        <div class="self-end md:col-span-4 lg:col-span-3 lg:col-start-10">
          <p class="text-lg leading-snug">De rendang suddert urenlang. De sambals maken we zelf.</p>
          <p class="mt-4 text-grijs">Iets dat niet in de vitrine staat? Laat uw wens weten, dan kijken we wat er kan.</p>
          <a href={waMet(berichten.vitrine)} class="vraag mt-7 inline-block text-xl leading-tight">Wat staat er vandaag in de vitrine?</a>
        </div>
      </div>

      <div class="wrap mt-24 grid gap-y-10 md:mt-36 md:grid-cols-12 md:gap-x-10">
        <figure class="md:col-span-7">
          <div class="aspect-[4/5] overflow-hidden"><Foto src={rendang} alt="Rendang op gele rijst met groenten, op een blauw bord met het servetzakje van Toko Patja ernaast" sizes="(min-width: 768px) 58vw, 100vw" class="object-[50%_40%]" /></div>
        </figure>
        <div class="md:col-span-5 md:pt-6">
          <h3 class="toko text-[clamp(2.6rem,6.4vw,6.2rem)] tracking-[.1em]">Rendang</h3>
          <p class="mt-4 max-w-[22em] text-lg italic text-grijs">Urenlang gesudderd, op gele rijst of met bami.</p>
          <figure class="mt-12 md:ml-[18%] md:mt-24">
            <div class="aspect-[3/4] overflow-hidden"><Foto src={bami} alt="Bami met rendang, met kommetjes atjar, gebakken uitjes en kroepoek-sticks ernaast" sizes="(min-width: 768px) 30vw, 100vw" /></div>
            <figcaption class="toko-klein mt-3 text-grijs">Bami, rendang en wat erbij hoort</figcaption>
          </figure>
        </div>
      </div>

      <div class="wrap mt-24 md:mt-32">
        <p class="sr-only">Wat er onder meer op tafel komt:</p>
        <ul class="toko flex flex-wrap items-center justify-center gap-x-3 gap-y-3 text-center text-[clamp(1.2rem,3.4vw,3rem)] tracking-[.12em] md:gap-x-8">
          {gerechten.map((g, i) => (
            <li class="flex items-center gap-x-3 md:gap-x-8">
              {i > 0 && <span class="block h-[.55em] w-[.55em] text-koper-donker" set:html={kawung} />}
              <span>{g}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-center text-xs text-grijs">[[AANLEVEREN: afhaallijst met prijzen]]</p>
      </div>
    </section>

    <!-- 3. Tjendol op een pandangroen vlak. -->
    <section class="bg-pandan text-rijst" aria-labelledby="tjendol">
      <div class="wrap grid items-center gap-y-10 py-16 md:grid-cols-12 md:gap-x-10 md:py-0">
        <div class="md:col-span-6 md:py-24 lg:col-span-5 lg:col-start-2">
          <h2 id="tjendol" class="toko text-[clamp(2.6rem,7vw,6.5rem)] tracking-[.1em] text-pandan-licht">Tjendol</h2>
          <p class="mt-6 max-w-[20em] text-xl italic leading-snug">Koud en groen, in een hoog glas. Gasten noemen hem vaak.</p>
          <div class="kawung kawung-pandan mt-10 w-40 opacity-80" style="--h:18px" aria-hidden="true"></div>
        </div>
        <figure class="md:col-span-6 md:-my-10 lg:col-span-5 lg:col-start-8">
          <div class="aspect-[4/5] overflow-hidden"><Foto src={tjendol} alt="Een hoog glas tjendol naast een zwart servetzakje met het logo van Toko Patja" sizes="(min-width: 768px) 42vw, 100vw" class="object-[50%_30%]" /></div>
        </figure>
      </div>
    </section>

    <!-- 4. Iets te vieren? -->
    <section id="catering" class="op-donker scroll-mt-16 bg-antraciet pb-20 pt-28 text-rijst md:pb-28 md:pt-40" aria-labelledby="catering-kop">
      <div class="wrap grid gap-y-12 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-5">
          <h2 id="catering-kop" class="text-3xl italic">Iets te vieren?</h2>
          <p class="mt-7 max-w-[24em] text-lg">
            Een verjaardag, bruiloft of jubileum: een buffet met rendang en sate, of Indisch streetfood.
            Voor kleine groepen en grote gezelschappen, in heel Limburg.
          </p>
          <p class="mt-4 max-w-[24em] text-rijst/80">Een gast liet er een feest voor zeventien personen verzorgen, en schreef dat alles goed geregeld was.</p>
          <a href={waMet(berichten.catering)} class="knop mt-9"><Fragment set:html={wa} />Catering aanvragen</a>
          <p class="mt-10 text-2xl italic text-koper">Selamat makan!</p>
        </div>
        <figure class="-order-1 md:order-none md:col-span-7">
          <div class="aspect-[16/11] overflow-hidden"><Foto src={tafel} alt="Twee borden van bovenaf: rijst en bami met rendang, gebakken aardappeltjes en een ei, met kommetjes komkommer" sizes="(min-width: 768px) 55vw, 100vw" /></div>
        </figure>
      </div>
    </section>

    <!-- 5. Wilhelminaplein 5 -->
    <section id="plein" class="scroll-mt-16 pb-24 pt-20 md:pb-32 md:pt-28" aria-labelledby="plein-kop">
      <div class="wrap grid gap-y-12 md:grid-cols-12 md:gap-x-10">
        <figure class="md:col-span-7">
          <div class="aspect-[16/10] overflow-hidden"><Foto src={gevel} alt="De gevel van Toko Patja met de witte luifel, de letters Indonesische Specialiteiten op het raam en tafeltjes op het plein" sizes="(min-width: 768px) 58vw, 100vw" class="object-[40%_50%]" /></div>
        </figure>
        <div class="md:col-span-5 lg:col-span-4 lg:col-start-9">
          <h2 id="plein-kop" class="text-2xl">Wilhelminaplein 5</h2>
          <p class="mt-2 text-grijs">{site.postcode} Heerlen. Eten aan tafel, op het terras of mee naar huis.</p>
          <dl class="mt-8 border-t border-lijn">
            {rijen.map((r) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-lijn py-3" data-dag={r.nrs.join(' ')}>
                <dt class="flex items-center gap-2">{r.dagen}</dt>
                <dd class="whitespace-nowrap tabular-nums">{r.t ? `${r.t[0]}.00 - ${r.t[1]}.00` : 'gesloten'}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 min-h-[1.55em] text-sm italic text-grijs" data-nu aria-live="polite"></p>
          <a href={waMet(berichten.reserveren)} class="knop mt-7"><Fragment set:html={wa} />Tafel reserveren</a>
          <p class="mt-5 text-sm">
            Of bel <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a>
            <span class="mx-1.5 text-grijs" aria-hidden="true">·</span> <a href={site.maps} class="lijn">Route naar het plein</a>
          </p>
          <p class="mt-6 text-xs text-grijs">{site.google.score} op Google, uit {site.google.aantal} reviews.</p>
        </div>
      </div>

      <div class="wrap mt-24 grid items-end gap-y-8 md:mt-32 md:grid-cols-12 md:gap-x-10">
        <p class="toko text-[clamp(2.2rem,6vw,5.6rem)] leading-[1.08] tracking-[.08em] md:col-span-7" aria-hidden="true">
          <span class="text-koper-donker">Pat</span><span class="text-grijs/75">iwael</span><br />
          <span class="text-grijs/75">+ </span><span class="text-koper-donker">Ja</span><span class="text-grijs/75">nssen</span>
        </p>
        <p class="max-w-[24em] text-lg md:col-span-5 md:pb-3 lg:col-span-4 lg:col-start-8">
          <span class="sr-only">Patja is Patiwael plus Janssen. </span>De naam komt van de oprichters, Max Patiwael en Christie Janssen.
          Het begon met recepten uit de keuken van hun ouders en grootouders.
        </p>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
  <script>import '../scripts/open';</script>
</Base>
