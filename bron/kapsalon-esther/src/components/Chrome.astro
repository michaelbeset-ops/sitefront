---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-cream/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-baseline gap-1.5 font-display text-xl font-extrabold tracking-[-0.03em] text-ink no-underline"><span class="text-sm font-semibold tracking-normal text-clay">kapsalon</span>Esther</a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-semibold">
          <li><a href={url('#prijzen')} class="no-underline transition-colors hover:text-clay">Prijzen</a></li>
          <li><a href={url('#esther')} class="no-underline transition-colors hover:text-clay">Over Esther</a></li>
          <li><a href={url('#producten')} class="no-underline transition-colors hover:text-clay">Producten</a></li>
          <li><a href={url('#contact')} class="no-underline transition-colors hover:text-clay">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-clay !px-4 !py-2 text-sm">Bellen</a>
    </div>
  </header>
) : (
  <footer class="border-t border-white/10 bg-ink py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK {site.kvk}</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
