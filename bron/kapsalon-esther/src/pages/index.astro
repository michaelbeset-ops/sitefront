---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden, prijzen } from '../data/site';
import hero from '../assets/hero.jpg';
import knippen from '../assets/knippen.jpg';
import balie from '../assets/balie.jpg';
---
<Base
  title="Kapsalon Esther | Kapper voor dames, heren en kinderen in Dordrecht"
  description="Kapsalon Esther aan de Hooftstraat 90 in Dordrecht. Knippen, stylen, verven en permanent voor dames, heren en kinderen. Gratis parkeren. Bel 078 631 1699 voor een afspraak."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: naam groot links, foto rechts, openingstijden als los kaartje onder de naam. -->
    <section class="wrap grid gap-8 pb-16 pt-10 lg:grid-cols-12 lg:gap-x-10 lg:pb-24 lg:pt-16">
      <div class="lg:col-span-6 lg:row-start-1 lg:self-end">
        <p class="font-display text-sm font-semibold text-clay">{site.straat}, {site.plaats}</p>
        <h1 class="mt-4 text-4xl font-extrabold lg:text-[clamp(3.4rem,5vw,4.5rem)]">Kapsalon Esther</h1>
        <p class="mt-6 max-w-md text-lg text-ink-soft">Wij verzorgen de kapsels voor dames, heren en kinderen. In de salon staat de koffie altijd voor u klaar.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href={site.telHref} class="btn btn-clay">Bel<span class="hidden sm:inline">voor een afspraak</span><span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          <a href={site.mobielHref} class="text-sm font-semibold underline decoration-clay decoration-2 underline-offset-4">of mobiel <span class="whitespace-nowrap tabular-nums">{site.mobiel}</span></a>
        </div>
        <p class="mt-6 text-sm text-ink-soft"><strong class="text-ink">{site.google.score}</strong> uit 5 op Google, {site.google.aantal} reviews</p>
      </div>

      <div class="relative order-last lg:order-none lg:col-span-6 lg:col-start-7 lg:row-span-2 lg:row-start-1">
        <div class="aspect-[4/3] overflow-hidden rounded-xl lg:aspect-auto lg:h-full lg:min-h-[36rem]">
          <Foto src={hero} alt="Lichte kapsalon met een rij zwarte kappersstoelen, spiegels en schappen met haarproducten; achterin staat een vrouw bij de balie" hero sizes="(min-width: 1024px) 560px, 100vw" />
        </div>
      </div>

      <div class="rounded-xl bg-powder p-6 shadow-sm lg:relative lg:z-10 lg:col-span-5 lg:row-start-2 lg:self-start lg:p-8">
        <h2 class="font-display text-lg">Openingstijden</h2>
        <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-8 gap-y-1.5 text-sm">
          {tijden.map((t) => (
            <>
              <dt class="font-semibold">{t.dag}</dt>
              <dd class={`whitespace-nowrap tabular-nums ${t.tijd === 'Gesloten' ? 'text-ink-soft' : ''}`}>{t.tijd}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>

    <!-- Prijskaart: kop links, de kaart rechts in twee kolommen, met stippellijntjes tot de prijs. -->
    <section id="prijzen" class="scroll-mt-16 bg-powder py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Prijzen</h2>
          <p class="mt-4 max-w-xs text-ink-soft">Knippen, stylen, verven en kleuren. Bij verven en kleuren ziet u een vanaf-prijs.</p>
          <p class="mt-6 text-sm text-ink-soft">Actuele aanbieding: [[AANLEVEREN: actuele aanbieding]]</p>
        </div>
        <div class="grid gap-x-12 gap-y-10 rounded-xl bg-cream p-6 shadow-sm sm:p-10 md:grid-cols-2 lg:col-span-8">
          {prijzen.map((g, i) => (
            <div>
              <h3 class="flex items-baseline gap-3 border-b-2 border-ink pb-2 text-xl"><span class="shrink-0 font-display text-sm text-clay tabular-nums">0{i + 1}</span>{g.groep}</h3>
              <ul class="mt-4 space-y-3">
                {g.items.map((p) => (
                  <li class="flex items-end gap-2">
                    <span>{p.naam}</span>
                    <span class="leader" aria-hidden="true"></span>
                    <span class="whitespace-nowrap text-right tabular-nums">
                      {p.vanaf && <span class="mr-1 text-xs text-ink-soft">vanaf</span>}
                      <strong class="font-semibold">€&nbsp;{p.prijs}</strong>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Over Esther: foto links, groot jaartal als ankerpunt, tekst in haar eigen woorden. -->
    <section id="esther" class="scroll-mt-16 py-16 lg:py-28">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12">
        <div class="aspect-[4/3] overflow-hidden rounded-xl lg:col-span-5 lg:aspect-[3/4]">
          <Foto src={knippen} alt="Een kapster stylt het haar van een klant met een steiltang; in de spiegel is de klant te zien" sizes="(min-width: 1024px) 460px, 100vw" />
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="font-display text-5xl font-extrabold leading-none tracking-[-0.05em] text-clay tabular-nums" aria-hidden="true">1995</p>
          <h2 class="mt-4 text-3xl">Even voorstellen: ik ben Esther</h2>
          <p class="mt-6 text-lg">In 1995 ben ik voor mezelf begonnen.</p>
          <p class="mt-4 text-ink-soft">Een vakbekwame kapsalon, met goed advies, goede service en gratis parkeergelegenheid. U bent van harte welkom.</p>
          <ul class="mt-8 flex flex-wrap gap-2 text-sm font-semibold">
            <li class="rounded-full bg-powder px-4 py-1.5">Dames</li>
            <li class="rounded-full bg-powder px-4 py-1.5">Heren</li>
            <li class="rounded-full bg-powder px-4 py-1.5">Kinderen</li>
            <li class="rounded-full bg-powder px-4 py-1.5">Koffie staat klaar</li>
            <li class="rounded-full bg-powder px-4 py-1.5">Gratis parkeren</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Producten: de twee merknamen typografisch groot, foto breed ernaast. -->
    <section id="producten" class="scroll-mt-16 border-t border-line py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Waar wij mee werken</h2>
          <ul class="mt-8 space-y-1 font-display text-4xl font-extrabold leading-none tracking-[-0.04em]">
            <li>Keune</li>
            <li class="text-clay">Dupp</li>
          </ul>
          <p class="mt-8 max-w-sm text-ink-soft">De producten waar wij mee werken zijn van de merken Keune en Dupp. Deze merken staan voor kwaliteit en duurzaamheid.</p>
        </div>
        <div class="aspect-[3/2] overflow-hidden rounded-xl lg:col-span-7 lg:self-center">
          <Foto src={balie} alt="Witte balie met kassa voor schappen vol haarproducten; door een boog is een kapster aan het werk bij een klant te zien" sizes="(min-width: 1024px) 640px, 100vw" />
        </div>
      </div>
    </section>

    <section id="contact" class="scroll-mt-16 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Bel voor een afspraak</h2>
          <dl class="mt-8 grid gap-5">
            <div><dt class="text-sm text-white/75">Salon</dt><dd><a href={site.telHref} class="whitespace-nowrap text-2xl font-bold tracking-tight tabular-nums underline decoration-blush decoration-2 underline-offset-4 sm:text-3xl">{site.tel}</a></dd></div>
            <div><dt class="text-sm text-white/75">Mobiel</dt><dd><a href={site.mobielHref} class="whitespace-nowrap text-2xl font-bold tracking-tight tabular-nums underline decoration-blush decoration-2 underline-offset-4 sm:text-3xl">{site.mobiel}</a></dd></div>
            <div><dt class="text-sm text-white/75">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-blush decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          </dl>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="font-display text-lg">Adres</h3>
          <address class="mt-3 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <p class="mt-3 text-white/85">Gratis parkeergelegenheid.</p>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
          <h3 class="mt-10 font-display text-lg">Open</h3>
          <p class="mt-3 text-white/85">Dinsdag t/m vrijdag <span class="whitespace-nowrap tabular-nums">8.30 tot 17.30</span><br />Zaterdag <span class="whitespace-nowrap tabular-nums">8.30 tot 12.30</span><br />Maandag gesloten</p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
