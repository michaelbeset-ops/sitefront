---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi, waMet } from '../data/site';

import winkel from '../assets/winkel.jpg';
import bonbons from '../assets/bonbons.jpg';
import confiture from '../assets/confiture.jpg';
import theedrop from '../assets/theedrop.jpg';
import plankje from '../assets/plankje.jpg';
import guatemala from '../assets/guatemala.jpg';
import pakket from '../assets/pakket.jpg';
import eigenaresse from '../assets/eigenaresse.jpg';

// Krijtbordjes op de jute zakken (Facebook, 3 en 4 oktober 2026).
const koffie = [
  ['Indonesië', ''],
  ['Guatemala', ''],
  ['4 landen', 'Ethiopië, Oeganda, Brazilië, Peru'],
];

// Het letterbord op de toonbank (foto Facebook, 3 oktober 2026), regel voor regel.
const bord = ['Welkom bij', 'Genieten', 'Heerlijkheden', 'voor', 'jong & oud', 'elk seizoen', 'weer'];

// Keuzes voor het pakketbericht: alleen wat ze zelf verkopen of noemen.
const keuze = {
  aantal: ['een pakket', 'twee pakketten', 'drie pakketten', 'meerdere pakketten'],
  voor: ['om iemand te bedanken', 'om iemand te verrassen', 'voor de juf of meester', 'voor Sinterklaas', 'gewoon zomaar'],
  budget: ['tot € 15', 'budget nog open'],
  smaak: ['met thee', 'met koffie', 'met iets zoets', 'met iets hartigs', 'verras me maar'],
};
const standaard = `Hoi! Ik zoek ${keuze.aantal[0]} ${keuze.voor[0]}, ${keuze.budget[0]}, ${keuze.smaak[0]}. Kunnen jullie dat samenstellen?`;

const kort = (t: string) => t.replace('.00', '');
const titel = 'Genieten, delicatessen & lifestyle | Voorstraat 63, Vianen';
const omschrijving = 'Delicatessenwinkel aan de Voorstraat in Vianen: thee, koffiebonen per 100 gram, chocolade, zelfgemaakte confiture en cadeaupakketten voor elk budget.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. HERO: licht, zoals de witte winkel; rechts de winkel met de koffietonnetjes en het letterbord -->
    <section class="border-b border-lijn">
      <div class="wrap grid gap-y-10 pb-14 pt-10 lg:min-h-[calc(100svh-5rem)] lg:max-h-[56rem] lg:grid-cols-12 lg:gap-x-14 lg:py-0">
        <div class="flex flex-col justify-center lg:col-span-6 lg:py-16">
          <p class="text-sm font-medium text-grijs">Delicatessen &amp; lifestyle, Voorstraat 63 in Vianen</p>
          <h1 class="mt-5 text-hero leading-[1] lg:text-[clamp(3.4rem,5vw,4.75rem)]">Voor échte <span class="text-framboos">genietmomenten.</span></h1>
          <p class="mt-6 max-w-md text-lg text-grijs md:text-xl">Thee, koffiebonen uit de jute zak, chocolade en delicatessen. Om zelf van te genieten of om cadeau te geven.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={waHoi} class="knop knop-vol"><Icoon naam="wa" />App de winkel</a>
            <a href="#cadeau" class="link font-medium">Cadeaupakket aanvragen</a>
          </div>
        </div>
        <figure class="relative lg:col-span-6 lg:py-8">
          <Image src={winkel} alt="In de winkel: houten tonnetjes met jute zakken vol koffiebonen, een vitrine met cannoli en het zwarte letterbord met Welkom bij Genieten" quality={56} widths={[480, 720, 900, 1080]} sizes="(min-width: 1024px) 46vw, 100vw" loading="eager" fetchpriority="high" decoding="sync" class="aspect-[4/3] w-full rounded-md object-cover object-[50%_45%] sm:aspect-[5/4] lg:aspect-auto lg:h-full" />
          <figcaption class="mt-3 text-xs text-grijs lg:absolute lg:bottom-11 lg:left-4 lg:mt-0 lg:rounded-sm lg:bg-kalk/90 lg:px-3 lg:py-1.5 lg:text-inkt">De toonbank, oktober 2026</figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. DE WINKEL: het letterbord + wat er op de plank staat, in een losse mozaïek -->
    <section id="winkel" class="py-20 md:py-28">
      <div class="wrap">
        <div class="grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-16">
          <div class="letterbord rijs mx-auto w-full max-w-sm px-6 py-8 text-center sm:max-w-md lg:col-span-5 lg:mx-0" aria-label="Letterbord in de winkel">
            {bord.map((r) => <p class="text-lg sm:text-xl">{r}</p>)}
          </div>
          <div class="lg:col-span-6 lg:col-start-7">
            <h2 class="text-3xl">Lekkers voor jezelf, of om cadeau te geven.</h2>
            <p class="mt-5 max-w-lg text-grijs">Bonbons, theedrop, zelfgemaakte confiture, kruiden en oliën, en kleine cadeaus met Vianen erop. Wat er staat, wisselt mee met het seizoen.</p>
          </div>
        </div>

        <div class="mt-16 grid gap-5 md:mt-20 md:grid-cols-12 md:gap-6">
          <figure class="rijs relative md:col-span-7">
            <Image src={bonbons} alt="Glazen bakken vol bonbons in groene, blauwe en witte papiertjes, met de dozen erachter" quality={56} widths={[400, 640, 960, 1440]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover" />
            <figcaption class="krijt absolute bottom-5 left-5 text-lg md:text-xl">Bonbons</figcaption>
          </figure>
          <figure class="rijs relative md:col-span-5 md:mt-16" style="--d:.1s">
            <Image src={confiture} alt="Potten perenconfiture met roze stippeltjesstof op het deksel en handgeschreven labels" quality={64} widths={[400, 640, 960]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover md:aspect-[5/4]" />
            <figcaption class="krijt r absolute bottom-5 right-5 text-lg md:text-xl">Perenconfiture, zelf gemaakt</figcaption>
          </figure>
          <figure class="rijs relative md:col-span-4" style="--d:.05s">
            <Image src={theedrop} alt="Zakjes theedrop in een zwart draadmandje met prijsbordje, met witte nougat en snoepjes in rieten mandjes" quality={64} widths={[360, 540, 800]} sizes="(min-width: 768px) 32vw, 100vw" class="aspect-[4/5] w-full rounded-md object-cover" />
            <figcaption class="krijt absolute bottom-5 left-5 text-lg"><span class="num">Theedrop € 3,95</span></figcaption>
          </figure>
          <figure class="rijs relative md:col-span-8 md:self-end" style="--d:.12s">
            <Image src={plankje} alt="Ovaal bamboe plankje met de skyline van Vianen en het woord Vianen erin gegraveerd" quality={64} widths={[400, 640, 960, 1440]} sizes="(min-width: 768px) 64vw, 100vw" class="aspect-[16/9] w-full rounded-md object-cover" />
            <figcaption class="krijt r absolute right-5 top-5 text-lg">Met de skyline van Vianen</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 3. KOFFIE & THEE: donker als het krijtbord, met de echte prijzen van de zakken -->
    <section id="koffie" class="bg-inkt py-20 text-krijt md:py-28">
      <div class="wrap grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-6">
          <Image src={guatemala} alt="Koffiebonen in een jute zak met een krijtbordje: Guatemala, € 2,90 per 100 gram" quality={42} widths={[400, 600, 800, 1080]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[4/5] w-full rounded-md object-cover object-[50%_30%] lg:aspect-[5/6]" />
        </figure>
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Koffiebonen uit de jute zak</h2>
          <p class="mt-5 max-w-md text-krijt-zacht">Drie soorten bonen, allemaal per 100 gram.</p>
          <ul class="mt-9 max-w-lg">
            {koffie.map(([n, s]) => (
              <li class="border-b border-lijn-donker py-4">
                <div class="flex items-baseline gap-3">
                  <span class="font-kop text-2xl">{n}</span>
                  <span class="flex-1 border-b border-dotted border-krijt-zacht/60" aria-hidden="true"></span>
                  <span class="num whitespace-nowrap font-kop text-2xl">€ 2,90</span>
                </div>
                {s && <p class="mt-1 text-sm text-krijt-zacht">{s}</p>}
              </li>
            ))}
          </ul>

          <div class="mt-14 border-t border-lijn-donker pt-10">
            <h3 class="text-2xl">Losse thee</h3>
            <p class="mt-3 max-w-md text-krijt-zacht">Onze losse thee bestel je online bij Theelief. Bestel je op beide sites? Geef dan bij één bestelling aan dat je wilt afhalen, dan voegen we de orders samen.</p>
            <blockquote class="mt-7 max-w-md border-l-2 border-roze pl-5">
              <p class="font-kop text-xl text-krijt">“de thee : het geheim van Vianen is een echte aanrader”</p>
              <footer class="mt-2 text-sm text-krijt-zacht">Daphne D., Google review</footer>
            </blockquote>
            <a href={site.theelief} class="mt-8 inline-flex items-center gap-2 font-semibold text-roze no-underline hover:text-krijt">Naar Theelief <Icoon naam="pijl" class="h-4 w-4" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. CADEAUPAKKET: één zin invullen, dan staat het WhatsApp-bericht klaar -->
    <section id="cadeau" class="bg-kalk-2 py-20 md:py-28">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-6">
          <Image src={pakket} alt="Cadeaupakket in een mand met stippen: Potluck-kruiden, pasta, crackers, olijfolie, olijven en een potje pesto" quality={64} widths={[400, 640, 960, 1440]} sizes="(min-width: 1024px) 48vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover lg:aspect-[4/5] lg:object-[40%_50%]" />
        </figure>
        <div class="flex flex-col justify-center lg:col-span-6">
          <h2 class="text-3xl">Een pakket voor elk budget.</h2>
          <p class="mt-5 max-w-md text-grijs">Om iemand te verrassen, te bedanken of gewoon zomaar. Vertel wat je zoekt, dan stellen we het samen.</p>

          <form class="mt-9 border-t border-lijn-2 pt-8" data-pakket action={site.wa} method="get">
            <p class="font-kop text-2xl leading-[1.9] md:text-[1.875rem]">
              Ik zoek
              <label class="sr-only" for="p-aantal">Aantal</label>
              <select id="p-aantal" name="aantal" class="kiezer">{keuze.aantal.map((o) => <option>{o}</option>)}</select>
              <label class="sr-only" for="p-voor">Waarvoor</label>
              <select id="p-voor" name="voor" class="kiezer">{keuze.voor.map((o) => <option>{o}</option>)}</select>,
              <label class="sr-only" for="p-budget">Budget</label>
              <select id="p-budget" name="budget" class="kiezer">{keuze.budget.map((o) => <option>{o}</option>)}</select>,
              <label class="sr-only" for="p-smaak">Inhoud</label>
              <select id="p-smaak" name="smaak" class="kiezer">{keuze.smaak.map((o) => <option>{o}</option>)}</select>.
            </p>
            <p class="sr-only" aria-live="polite" data-pakket-tekst>{standaard}</p>
            <a href={waMet(standaard)} class="knop knop-vol mt-8" data-pakket-knop><Icoon naam="wa" />Stuur naar de winkel</a>
          </form>

          <ul class="mt-10 space-y-2 text-sm text-grijs">
            <li class="flex gap-3"><span class="mt-[.55rem] h-1.5 w-1.5 shrink-0 rounded-full bg-framboos" aria-hidden="true"></span><span>Op de seizoenstafel in de winkel staan pakketten van <span class="num whitespace-nowrap">maximaal € 15</span>.</span></li>
            <li class="flex gap-3"><span class="mt-[.55rem] h-1.5 w-1.5 shrink-0 rounded-full bg-framboos" aria-hidden="true"></span><span>Jute sinterklaaszakje met naam: <span class="num whitespace-nowrap">€ 2,50</span> per stuk.</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 5. DE EIGENARESSE + letterlijke reviews, geen kaartjes -->
    <section id="over" class="bg-wit py-20 md:py-28">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs mx-auto w-full max-w-xs lg:col-span-4 lg:mx-0 lg:max-w-none">
          <Image src={eigenaresse} alt="Portret van de eigenaresse in een ronde lijst met het woord Genieten" quality={64} widths={[400, 700]} sizes="(min-width: 1024px) 28vw, 320px" class="aspect-square w-full object-cover" />
          <figcaption class="mt-3 text-center text-sm text-grijs">De eigenaresse</figcaption>
        </figure>
        <div class="lg:col-span-7 lg:col-start-6">
          <h2 class="text-3xl">“De eigenaresse is altijd heel vriendelijk en behulpzaam”</h2>
          <div class="mt-10 space-y-8">
            {reviews.map((r) => (
              <blockquote class="border-t border-lijn-2 pt-6">
                <p class="text-lg md:text-xl">{r.tekst}</p>
                <footer class="mt-3 text-sm text-grijs">{r.naam} · Google review · {r.wanneer}</footer>
              </blockquote>
            ))}
          </div>
          <p class="mt-10 flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" /><span><span class="num">{site.google.score}</span> op Google · {site.google.aantal} reviews</span></p>
        </div>
      </div>
    </section>

    <!-- 6. BEZOEK: de openingstijden op het letterbord -->
    <section id="bezoek" class="py-20 md:py-28">
      <div class="wrap grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Kom gezellig langs</h2>
          <p class="mt-5 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-4 flex items-center gap-2.5 text-sm font-medium" data-status-wrap><span class="h-2 w-2 rounded-full bg-framboos" aria-hidden="true"></span><span data-status>Dinsdag tot en met zaterdag open</span></p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={waHoi} class="knop knop-vol"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-inkt"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
          </div>
          <p class="mt-5"><a href={site.maps} class="link text-sm font-medium">Route in Google Maps</a></p>
          <ul class="mt-10 space-y-3 border-t border-lijn-2 pt-8 text-sm text-grijs">
            <li>Bezorgen in Vianen, Hoef en Haag en Hagestein: <span class="num whitespace-nowrap">€ 3,-</span></li>
            <li>Verzenden binnen Nederland: <span class="num whitespace-nowrap">€ 7,75</span> per bestelling</li>
            <li>Ook pakketpunt van DPD en Vinted Go</li>
          </ul>
        </div>
        <div class="letterbord rijs w-full px-6 py-8 sm:px-10 sm:py-10 lg:col-span-6 lg:col-start-7">
          <table class="w-full text-left">
            <caption class="pb-4 text-center font-sans text-base font-semibold uppercase tracking-[.14em] sm:text-lg">Openingstijden</caption>
            <tbody>
              {tijden.map((t) => (
                <tr data-dag={t.dag} class="bord-rij">
                  <th scope="row" class="py-1.5 font-semibold uppercase tracking-[.14em]">{t.naam}</th>
                  <td class="num whitespace-nowrap py-1.5 text-right font-semibold uppercase tracking-[.1em]">{t.open ? `${kort(t.open)} - ${kort(t.dicht)}` : 'Dicht'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .kiezer {
    appearance: none; font: inherit; color: var(--color-framboos); background: transparent; cursor: pointer;
    border: 0; border-bottom: 1.5px solid var(--color-framboos); border-radius: 0; padding: 0 1.3rem 0 .1rem; margin-left: .2em; max-width: 100%; field-sizing: content;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - .55rem) 55%, calc(100% - .2rem) 55%; background-size: .35rem .35rem; background-repeat: no-repeat;
    line-height: 1.25;
  }
  .kiezer:hover { color: var(--color-framboos-2); }
  .bord-rij[data-vandaag] { background: transparent; color: var(--color-roze); }
  @media (min-width: 480px) { .bord-rij[data-vandaag] th::after { content: ' · vandaag'; } }
  .letterbord th, .letterbord td { font-size: clamp(.875rem, .5vw + .75rem, 1.125rem); }
</style>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-pakket]');
  if (f) {
    const knop = f.querySelector<HTMLAnchorElement>('[data-pakket-knop]')!;
    const uit = f.querySelector<HTMLElement>('[data-pakket-tekst]')!;
    const basis = knop.href.split('?')[0];
    const zet = () => {
      const v = (n: string) => (f.elements.namedItem(n) as HTMLSelectElement).value;
      const t = `Hoi! Ik zoek ${v('aantal')} ${v('voor')}, ${v('budget')}, ${v('smaak')}. Kunnen jullie dat samenstellen?`;
      knop.href = `${basis}?text=${encodeURIComponent(t)}`;
      uit.textContent = t;
    };
    f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
  }
</script>
