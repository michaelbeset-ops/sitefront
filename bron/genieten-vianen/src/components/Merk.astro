---
import { Image } from 'astro:assets';
import { url } from '../data/site';
import logo from '../assets/logo.png';
import logoWit from '../assets/logo-wit.png';
interface Props { wit?: boolean; class?: string }
const { wit = false, class: cls = 'h-12 md:h-14' } = Astro.props;
---
<a href={url('')} class="inline-block shrink-0 no-underline" aria-label="Genieten, delicatessen & lifestyle: naar de homepage">
  <Image src={wit ? logoWit : logo} alt="" widths={[130, 260]} sizes="130px" class={`w-auto ${cls}`} loading={wit ? "lazy" : "eager"} />
</a>
