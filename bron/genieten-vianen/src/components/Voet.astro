---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-inkt text-krijt-zacht">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk wit class="h-14 md:h-16" />
      <p class="mt-6 max-w-xs font-kop text-xl text-krijt">Voor de momenten die je wilt koesteren.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-krijt">Winkel</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.maps} class="link">Route</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-krijt">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link break-all">{site.mail}</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-krijt">Volg ons</p>
      <p class="mt-3"><a href={site.facebook} class="link">Facebook</a></p>
      <p class="mt-1"><a href={site.instagram} class="link">Instagram</a></p>
      <p class="mt-1"><a href={site.theelief} class="link">Theelief</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-donker py-7 text-xs">
    <p>© {jaar} {site.vol}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-krijt">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Foto’s van jullie eigen Facebookpagina. Reviews letterlijk van Google (stand 6 oktober 2026).</p>}
</footer>
