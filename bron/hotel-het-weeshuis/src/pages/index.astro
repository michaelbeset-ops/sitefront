---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site } from '../data/site';
import voortuin from '../assets/voortuin.jpg';
import restaurantTafel from '../assets/restaurant-tafel.jpg';
import restaurant from '../assets/restaurant.jpg';
import piano from '../assets/piano.jpg';
import ontbijt from '../assets/ontbijt.jpg';
import terras from '../assets/terras.jpg';
import radio from '../assets/radio.jpg';
import hal from '../assets/hal.jpg';
import ezelsVoortuin from '../assets/ezels-voortuin.jpg';
import suiteBoven from '../assets/suite-boven.jpg';
import suiteBovenBed from '../assets/suite-boven-bed.jpg';
import suiteTuin from '../assets/suite-tuin.jpg';
import achtertuinBoom from '../assets/achtertuin-boom.jpg';
import achtertuin from '../assets/achtertuin.jpg';
import pantry from '../assets/pantry.jpg';
import ezels from '../assets/ezels.jpg';
import bloesem from '../assets/bloesem.jpg';
import tuinBoom from '../assets/tuin-boom.jpg';
import lichtjes from '../assets/lichtjes.jpg';
import toenWeeshuis from '../assets/toen-weeshuis.jpg';
import nuWeeshuis from '../assets/nu-weeshuis.jpg';
import toenBolsward from '../assets/toen-bolsward.jpg';
import nuBolsward from '../assets/nu-bolsward.jpg';
import toenKerkstraat from '../assets/toen-kerkstraat.jpg';
import friesland from '../assets/friesland.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;
const pijl = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
const w1024 = [480, 800, 1024];

const tijdlijn = [
  { jaar: '1553', tekst: 'Weduwe Hid Hero sticht het Weeshuis en draagt de zorg voor de opvoeding van de kinderen.' },
  { jaar: 'tot 1954', tekst: 'Het Weeshuis doet dienst als opvangtehuis voor weeskinderen.' },
  { jaar: '2013', tekst: 'De huidige eigenaren vallen voor de charme van deze bijzondere plek en gaan de uitdaging aan.' },
  { jaar: 'Nu', tekst: 'Waar vroeger de wezen, de vader en de moeder onderdak hadden, zijn nu het hotel en restaurant.' },
];

const suites = [
  { id: 'boven', aantal: '6', kop: 'Op de eerste verdieping', tekst: 'Zes suites op de eerste verdieping, met een eigen woon-, slaap- en badkamer.', foto: suiteBoven, alt: 'Woonkamer van een suite boven: twee grijze oorfauteuils, bloemetjesbehang en een houten eettafel onder het schuine dak', foto2: suiteBovenBed, alt2: 'Slaapkamer onder het schuine dak met een zwart smeedijzeren bed en een eikenhouten vloer' },
  { id: 'tuin', aantal: '6', kop: 'Aan de achtertuin', tekst: 'Zes suites op de begane grond, grenzend aan de achtertuin.', foto: suiteTuin, alt: 'Slaapkamer met twee lampjes boven het bed, een tuindeur en een doorkijk naar de woonkamer', foto2: achtertuin, alt2: 'De achtertuin met een grote boom, de witte achtergevel van de kamers en twee grazende ezels' },
  { id: 'appartement', aantal: '2', kop: 'Kleine appartementjes', tekst: 'Twee kleine appartementjes, net als de suites met een eigen woon-, slaap- en badkamer.', foto: pantry, alt: 'Een kamer met een houten pantrykast, een rond tafeltje met vier stoelen en een openstaande tuindeur', foto2: null, alt2: '' },
];

const friesUit = ['Lekker het water op', 'Een bezoek aan het museum Jopie Huisman', 'Slenteren door één van de 11 pittoreske stadjes', 'Simpelweg uitwaaien met spectaculaire vergezichten'];
---
<Base
  title="Hotel Het Weeshuis | Hedendaagse herberg in Bolsward, sinds 1553"
  description="Hotel en huiskamerrestaurant in het Weeshuis van Bolsward uit 1553. 14 ruime suites van ruim 35 m², een riante tuin met fruitboomgaard, op 200 meter van het centrum. Boek rechtstreeks."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: grachtengroen vlak, grote kop links, bewijzen rechts, de voortuin als groot beeld over de rand. -->
    <section class="donker relative bg-gracht text-white">
      <div class="wrap relative grid gap-10 pt-10 pb-10 sm:pt-14 lg:grid-cols-12 lg:gap-8 lg:pt-14 lg:pb-12">
        <div class="lg:col-span-8">
          <p class="kicker text-koper-licht">Hotel en restaurant in Bolsward, sinds 1553</p>
          <h1 class="mt-5 text-4xl">Hedendaagse herberg met een <em class="text-koper-licht">vleugje nostalgie</em></h1>
          <p class="mt-6 max-w-2xl text-lg text-white/85">Veertien ruime en fris ingerichte suites, een knus huiskamerrestaurant en een riante tuin met een ouderwetse fruitboomgaard. In het oude Weeshuis, op 200 meter van het gezellige centrum van Bolsward.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#boeken" class="btn btn-koper">Boek rechtstreeks <Fragment set:html={pijl} /></a>
            <a href={site.telHref} class="btn btn-line"><Fragment set:html={tel} /><span>Bel <span class="num">{site.tel}</span></span></a>
          </div>
        </div>
        <dl class="grid grid-cols-3 gap-4 border-t border-white/20 pt-6 lg:col-span-3 lg:col-start-10 lg:grid-cols-1 lg:gap-6 lg:self-end lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
          <div><dt class="text-sm text-white/75">Google</dt><dd class="mt-1"><span class="num font-display text-2xl">{site.google}</span> <span class="block text-sm text-white/75 sm:inline">({site.reviews} reviews)</span></dd></div>
          <div><dt class="text-sm text-white/75">Suites</dt><dd class="mt-1"><span class="num font-display text-2xl">14</span> <span class="block text-sm text-white/75 sm:inline">ruim 35 m²</span></dd></div>
          <div><dt class="text-sm text-white/75">Centrum</dt><dd class="mt-1"><span class="num font-display text-2xl">200 m</span> <span class="block text-sm text-white/75 sm:inline">lopen</span></dd></div>
        </dl>
      </div>
      <div class="relative bg-[linear-gradient(to_bottom,var(--color-gracht)_55%,var(--color-paper)_55%)]">
        <div class="wrap">
          <div class="relative mx-auto max-w-[1024px]">
            <figure class="relative aspect-[4/3] overflow-hidden rounded-xl shadow-lg sm:aspect-[16/9]">
              <Foto src={voortuin} alt="De voortuin van Het Weeshuis: lavendel, stokrozen en rozen voor de bakstenen gevel met dakkapellen, met rechts het terras onder een parasol" quality={60} widths={w1024} sizes="(min-width: 1088px) 1024px, 100vw" class="object-[50%_60%]" />
              <figcaption class="absolute bottom-4 left-4 rounded-md bg-gracht-3/85 px-3 py-1.5 text-xs font-semibold text-white">De voortuin</figcaption>
            </figure>
            <figure class="absolute -right-6 -bottom-10 hidden w-[300px] rounded-xl bg-kalk p-2 text-ink shadow-lg lg:block xl:-right-16">
              <div class="aspect-[3/2] overflow-hidden rounded-md"><Foto src={restaurantTafel} alt="Het huiskamerrestaurant: een ronde houten tafel met kaarsjes, daarachter tafels bij de hoge ramen" widths={[300, 600]} sizes="284px" /></div>
              <figcaption class="px-1.5 pt-2 pb-1 text-xs font-semibold">Het knusse huiskamerrestaurant</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Wees welkom: kleinschalig en gemoedelijk, eigenaren met de ezels, citaat Bent van Looy. -->
    <section id="welkom" class="scroll-mt-20 pt-20 pb-16 lg:pt-28 lg:pb-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="kicker text-koper">Kleinschalig &amp; gemoedelijk</p>
          <h2 class="mt-3 text-3xl">Wees welkom en voel u thuis</h2>
          <p class="mt-6 text-lg">In 2013 zijn de huidige eigenaren voor de charme van deze bijzondere plek gevallen en hebben ze de uitdaging aangegaan. Samen met een leuk team proberen ze uw verblijf zo plezierig mogelijk te maken.</p>
          <p class="mt-4 text-ink-soft">Geen overdreven luxe en overdaad, maar val vooral voor de kleinschaligheid, een gemoedelijke sfeer en de bijzondere ambiance.</p>
        </div>
        <figure class="lg:col-span-7">
          <div class="aspect-[16/10] overflow-hidden rounded-xl shadow-sm"><Foto src={ezelsVoortuin} alt="De eigenaren van Het Weeshuis met twee ezels op het gras voor de bakstenen gevel van het hotel" widths={[480, 800]} sizes="(min-width: 1024px) 700px, 100vw" /></div>
          <figcaption class="mt-3 text-sm text-ink-soft">De eigenaren, met de ezels voor het hotel.</figcaption>
        </figure>
      </div>
      <div class="wrap mt-14 grid gap-8 lg:mt-20 lg:grid-cols-12 lg:items-center lg:gap-12">
        <div class="grid grid-cols-2 gap-3 lg:col-span-5">
          <div class="aspect-square overflow-hidden rounded-xl"><Foto src={radio} alt="Close-up van een oude buizenradio met houten kast" widths={[320, 640]} sizes="(min-width: 1024px) 230px, 50vw" /></div>
          <div class="aspect-square overflow-hidden rounded-xl"><Foto src={hal} alt="Een oude werkbank in de hal met een radio, kaarsen en ingelijste foto's" widths={[320, 640]} sizes="(min-width: 1024px) 230px, 50vw" /></div>
        </div>
        <blockquote class="border-l-2 border-koper pl-6 lg:col-span-7">
          <p class="font-display text-2xl leading-snug italic sm:text-[2.1rem]">"De kunst is om, waar je ook bent, je ogen op de juiste manier te openen. Dat je altijd verwonderd kan zijn. Als je dat kunt, ben je altijd op reis."</p>
          <footer class="mt-4 kicker text-ink-soft">Bent van Looy</footer>
        </blockquote>
      </div>
    </section>

    <!-- Suites: drie soorten, eigen foto's. -->
    <section id="suites" class="scroll-mt-20 bg-zand py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-koper">Kom tot rust</p>
            <h2 class="mt-3 text-3xl">Veertien suites, allemaal net even anders</h2>
          </div>
          <p class="text-lg lg:col-span-5">Allemaal ruim 35 vierkante meter groot, met een eigen woon-, slaap- en badkamer (bad of douche). Sommige kamers zijn geschikt te maken voor gezinnen tot 4 personen.</p>
        </div>

        <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-line shadow-sm md:grid-cols-4">
          <div class="bg-kalk p-4 sm:p-5"><dt class="kicker text-ink-soft">Oppervlakte</dt><dd class="mt-2 font-display text-xl sm:text-2xl">ruim 35 m²</dd></div>
          <div class="bg-kalk p-4 sm:p-5"><dt class="kicker text-ink-soft">Woonkamer</dt><dd class="mt-2 font-display text-xl sm:text-2xl">eigen</dd></div>
          <div class="bg-kalk p-4 sm:p-5"><dt class="kicker text-ink-soft">Badkamer</dt><dd class="mt-2 font-display text-xl sm:text-2xl">bad of douche</dd></div>
          <div class="bg-kalk p-4 sm:p-5"><dt class="kicker text-ink-soft">Gezinnen</dt><dd class="mt-2 font-display text-xl sm:text-2xl">tot 4 personen</dd></div>
        </dl>

        <div class="mt-12 grid gap-6 lg:grid-cols-12">
          {suites.map((s, i) => (
            <article class={`flex flex-col overflow-hidden rounded-xl bg-kalk shadow-sm ${i === 0 ? 'lg:col-span-12 lg:grid lg:grid-cols-12' : 'lg:col-span-6'}`}>
              <div class={`grid gap-1 ${i === 0 ? 'lg:col-span-8 grid-cols-3' : s.foto2 ? 'grid-cols-2' : ''}`}>
                <div class={`overflow-hidden ${i === 0 ? 'col-span-2 aspect-[4/3]' : s.foto2 ? 'aspect-[4/5]' : 'aspect-[16/10]'}`}><Foto src={s.foto} alt={s.alt} widths={[480, 800, 1024]} sizes={i === 0 ? '(min-width: 1024px) 520px, 67vw' : '(min-width: 1024px) 560px, 100vw'} /></div>
                {s.foto2 && <div class={`overflow-hidden ${i === 0 ? 'aspect-auto' : 'aspect-[4/5]'}`}><Foto src={s.foto2} alt={s.alt2} widths={[400, 800]} sizes={i === 0 ? '(min-width: 1024px) 260px, 33vw' : '(min-width: 1024px) 280px, 50vw'} /></div>}
              </div>
              <div class={`flex flex-1 flex-col p-6 sm:p-8 ${i === 0 ? 'lg:col-span-4 lg:justify-center' : ''}`}>
                <p class="flex items-baseline gap-3"><span class="font-display text-getal leading-none text-koper">{s.aantal}</span><span class="kicker text-ink-soft">{s.id === 'appartement' ? 'appartementjes' : 'suites'}</span></p>
                <h3 class="mt-4 text-2xl">{s.kop}</h3>
                <p class="mt-3 text-ink-soft">{s.tekst}</p>
                <a href="#boeken" data-suite={s.id} class="btn btn-line-licht mt-6 self-start">Vraag {s.id === 'appartement' ? 'een appartementje' : 'deze suite'} aan <Fragment set:html={pijl} /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Eetlokaal: donker, warm, fotomozaïek. -->
    <section id="eetlokaal" class="donker scroll-mt-20 bg-gracht py-16 text-white lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="kicker text-koper-licht">Eetlokaal</p>
          <h2 class="mt-3 text-3xl">Het knusse huiskamer&shy;restaurant</h2>
          <p class="mt-6 text-lg text-white/85">Voor het ontbijt, de borrel en het diner kunt u terecht in ons knusse huiskamerrestaurant. Geen onnodige overdaad, maar lekkere, verse en vooral lokale producten.</p>
          <ol class="mt-8 divide-y divide-white/15 border-y border-white/15">
            <li class="flex items-baseline gap-5 py-4"><span class="num text-sm text-koper-licht">01</span><span class="font-display text-2xl">Ontbijt</span></li>
            <li class="flex items-baseline gap-5 py-4"><span class="num text-sm text-koper-licht">02</span><span><span class="font-display text-2xl">Borrel</span><span class="mt-1 block text-white/80">Iedere dag rond borreltijd bent u van harte welkom voor een drankje en een hapje. Lekker bij de houtkachel of heerlijk in de zon op het terras.</span></span></li>
            <li class="flex items-baseline gap-5 py-4"><span class="num text-sm text-koper-licht">03</span><span class="font-display text-2xl">Diner</span></li>
          </ol>
          <div class="mt-8 rounded-xl bg-gracht-2 p-6">
            <h3 class="text-xl">De honesty bar</h3>
            <p class="mt-2 text-white/80">Centraal in het hotel staat een honesty bar voor goede koffie en thee, drankjes en snacks, een tijdschrift of een leuk gezelschapsspelletje.</p>
          </div>
        </div>
        <div class="grid grid-cols-6 gap-3 self-start lg:col-span-7">
          <div class="col-span-6 aspect-[3/2] overflow-hidden rounded-xl"><Foto src={restaurant} alt="Het restaurant met een oude werkbank vol flessen wijn, houten tafels, rode stoelen en een grote zwart-witfoto aan de muur" widths={w1024} sizes="(min-width: 1024px) 640px, 100vw" /></div>
          <div class="col-span-3 overflow-hidden rounded-xl"><Foto src={ontbijt} alt="Ontbijt op de werkbank: brood, kaas, vleeswaren, yoghurt in weckpotten, granola en een schaal appels" widths={[400, 768]} sizes="(min-width: 1024px) 320px, 50vw" /></div>
          <div class="col-span-3 grid gap-3">
            <div class="aspect-[4/3] overflow-hidden rounded-xl"><Foto src={piano} alt="Een oude piano met een typemachine erop bij de entree naar het restaurant" widths={[400, 800]} sizes="(min-width: 1024px) 320px, 50vw" /></div>
            <div class="aspect-[4/3] overflow-hidden rounded-xl"><Foto src={terras} alt="Het terras met rieten stoelen en parasols voor het hotel, tussen de bomen" widths={[400, 800]} sizes="(min-width: 1024px) 320px, 50vw" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Wow: toen en nu, met de geschiedenis sinds 1553 als tijdlijn. -->
    <section id="sinds-1553" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-6">
            <p class="kicker text-koper">Sinds 1553</p>
            <h2 class="mt-3 text-3xl">Toen weeshuis, nu hotel en restaurant</h2>
          </div>
          <p class="font-display text-xl leading-snug italic lg:col-span-6">"Je had het niet voor het zeggen: weeskind werd je vaak onverwacht. Het was je lot en dat drukte een zwaar stempel op je verdere leven."</p>
        </div>

        <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-7" data-toennu>
            <div role="tablist" aria-label="Kies een vergelijking" class="mb-4 hidden gap-2" data-tabs>
              <button type="button" role="tab" id="tab-weeshuis" aria-selected="true" aria-controls="paneel-weeshuis" class="tab keuze !text-ink !shadow-[inset_0_0_0_1.5px_var(--color-line)]">Het Weeshuis</button>
              <button type="button" role="tab" id="tab-bolsward" aria-selected="false" aria-controls="paneel-bolsward" tabindex="-1" class="tab keuze !text-ink !shadow-[inset_0_0_0_1.5px_var(--color-line)]">Bolsward</button>
            </div>
            {[
              { id: 'weeshuis', toen: toenWeeshuis, nu: nuWeeshuis, toenAlt: 'Historische zwart-witfoto van het Weeshuis aan de straat, met hoge boogramen, een smeedijzeren hek en kinderen op de stoep', nuAlt: 'De voortuin van het hotel nu: gazon, lavendel, een stenen schaal en het terras voor de lage vleugel met dakkapellen', bij: 'Toen: het Weeshuis aan de straat, met het smeedijzeren hek. Nu: de voortuin van het hotel.' },
              { id: 'bolsward', toen: toenBolsward, nu: nuBolsward, toenAlt: 'Historische zwart-witfoto van een gracht in Bolsward met oude auto\'s, winkels en een torenspits in de verte', nuAlt: 'Dezelfde gracht in Bolsward nu, met terrassen, fietsen, een Nederlandse vlag en de toren onder een blauwe lucht', bij: 'Het centrum van Bolsward, toen en nu. Vanaf het hotel is het 200 meter lopen.' },
            ].map((p, i) => (
              <div id={`paneel-${p.id}`} role="tabpanel" aria-labelledby={`tab-${p.id}`} hidden={i !== 0} data-paneel><figure>
                <div class="vergelijk aspect-[3/2] rounded-xl bg-gracht shadow-sm">
                  <div class="absolute inset-0"><Foto src={p.nu} alt={p.nuAlt} widths={w1024} sizes="(min-width: 1024px) 680px, 100vw" /></div>
                  <div class="toen"><Foto src={p.toen} alt={p.toenAlt} widths={w1024} sizes="(min-width: 1024px) 680px, 100vw" /></div>
                  <span class="absolute top-3 left-3 rounded-md bg-gracht-3/85 px-2.5 py-1 text-xs font-semibold text-white" aria-hidden="true">Toen</span>
                  <span class="absolute top-3 right-3 rounded-md bg-gracht-3/85 px-2.5 py-1 text-xs font-semibold text-white" aria-hidden="true">Nu</span>
                  <div class="lijn" aria-hidden="true"><span class="greep"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 6-6 6 6 6M15 6l6 6-6 6"/></svg></span></div>
                  <input type="range" min="0" max="100" value="50" hidden aria-label={`Schuif tussen toen en nu: ${p.id === 'weeshuis' ? 'het Weeshuis' : 'Bolsward'}`} />
                </div>
                <figcaption class="mt-3 text-sm text-ink-soft">{p.bij}</figcaption>
              </figure></div>
            ))}
            <p class="mt-2 hidden text-sm text-ink-soft" data-uitleg>Sleep over de foto, of gebruik de pijltjestoetsen.</p>
          </div>

          <ol class="relative lg:col-span-5">
            {tijdlijn.map((t, i) => (
              <li class="relative grid grid-cols-[4.75rem_1fr] gap-3 sm:grid-cols-[6.5rem_1fr] sm:gap-4 pb-8 last:pb-0">
                <span class={`font-display text-2xl leading-none ${i === tijdlijn.length - 1 ? 'text-koper' : ''}`}>{t.jaar}</span>
                <p class="border-l border-line pl-5 text-ink-soft">{t.tekst}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Tuin: fruitboomgaard, achtertuin, ezels Jonas en Grotius. -->
    <section id="tuin" class="scroll-mt-20 bg-zand py-16 lg:py-24">
      <div class="wrap grid gap-4 md:grid-cols-12">
        <div class="flex flex-col justify-between rounded-xl bg-kalk p-7 shadow-sm md:col-span-5 sm:p-9">
          <div>
            <p class="kicker text-koper">Fruitboomgaard</p>
            <h2 class="mt-3 text-3xl">Een riante tuin, voor en achter</h2>
            <p class="mt-6 text-lg">Het hotel wordt omgeven door een riante tuin met aan de voorzijde een ouderwetse fruitboomgaard.</p>
            <p class="mt-4 text-ink-soft">En in de achtertuin staan de bijenkasten van een lokale imker: honing uit eigen tuin.</p>
          </div>
          <div class="mt-8 aspect-[4/3] overflow-hidden rounded-lg md:mt-10"><Foto src={bloesem} alt="Roze en witte appelbloesem aan een fruitboom" widths={[400, 800]} sizes="(min-width: 768px) 420px, 100vw" /></div>
        </div>
        <div class="grid gap-4 md:col-span-7">
          <div class="relative aspect-[4/3] overflow-hidden rounded-xl md:aspect-[16/11]">
            <Foto src={ezels} alt="Close-up van de ezels Jonas en Grotius, snuit aan snuit" widths={w1024} sizes="(min-width: 768px) 640px, 100vw" />
            <div class="absolute inset-x-0 bottom-0 bg-gracht-3/80 p-5 text-white sm:p-6">
              <p class="font-display text-xl italic">Aangenaam kennis te maken</p>
              <p class="mt-1 text-sm text-white/85">De achtertuin is het domein van onze trouwe viervoeters Jonas en Grotius.</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="aspect-[4/3] overflow-hidden rounded-xl"><Foto src={tuinBoom} alt="Een groot gazon met een oude boom in de tuin van het hotel" widths={[400, 800]} sizes="(min-width: 768px) 320px, 50vw" /></div>
            <div class="aspect-[4/3] overflow-hidden rounded-xl"><Foto src={achtertuinBoom} alt="De achtertuin met gazon en bomen, met daarachter de witte gevel van het hotel" widths={[400, 800]} sizes="(min-width: 768px) 320px, 50vw" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Friesland: fietsen, Elfsteden, beleef Friesland. -->
    <section id="friesland" class="scroll-mt-20">
      <div class="relative">
        <div class="aspect-[4/3] overflow-hidden sm:aspect-[21/9] lg:aspect-[21/8]"><Foto src={friesland} alt="Fries landschap met een vaart, een fietspad met een fietser, rietkragen en een zeilboot onder een wolkenlucht" widths={[640, 1200, 1800]} sizes="100vw" /></div>
      </div>
      <div class="wrap relative -mt-16 pb-16 sm:-mt-24 lg:-mt-32 lg:pb-24">
        <div class="grid gap-10 rounded-xl bg-kalk p-7 shadow-lg sm:p-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-6">
            <p class="kicker text-koper">Spring maar achterop</p>
            <h2 class="mt-3 text-3xl">Bolsward, het hart van de Friese Elfsteden</h2>
            <p class="mt-6 text-lg">Niets leuker dan op de fiets Friesland verkennen. Bolsward is het hart van de Friese Elfsteden en van de inmiddels befaamde Fietselfstedentocht, ieder jaar op tweede Pinksterdag.</p>
            <p class="mt-4 text-ink-soft">Fietsen kunnen bij het hotel veilig worden gestald en ook het laden van accu's is geen probleem.</p>
          </div>
          <div class="lg:col-span-6">
            <h3 class="text-xl">Beleef Friesland</h3>
            <p class="mt-2 text-ink-soft">Los van de Elfstedenkoorts heeft Friesland zo veel meer om te ontdekken.</p>
            <ul class="mt-5 divide-y divide-line border-y border-line">
              {friesUit.map((u) => <li class="flex items-center gap-3 py-3"><span class="h-1.5 w-1.5 flex-none rounded-full bg-koper" aria-hidden="true"></span>{u}</li>)}
            </ul>
            <p class="mt-4 text-sm text-ink-soft">Leuke ideeën vindt u op <a href="https://www.visitfriesland.nl" rel="noopener" class="font-semibold text-koper underline underline-offset-2">visitfriesland.nl</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Vieren: kleine bruiloft, heisessie, borrel, diner. Aanvraag zonder verzenden. -->
    <section id="vieren" class="scroll-mt-20 pb-16 lg:pb-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="kicker text-koper">Vieren</p>
          <h2 class="mt-3 text-3xl">Vier het leven bij Het Weeshuis</h2>
          <p class="mt-6 text-lg">Een intieme locatie met verschillende mogelijkheden. Van kleine bruiloft tot heisessie, een aangeklede borrel of een diner, met natuurlijk de mogelijkheid om te blijven overnachten.</p>
          <div class="mt-8 aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={lichtjes} alt="De voortuin 's avonds, met lichtjes in de struiken en de bomen en lantaarns bij de verlichte ramen" widths={[480, 800, 1024]} sizes="(min-width: 1024px) 460px, 100vw" /></div>
        </div>
        <form class="rounded-xl bg-kalk p-6 shadow-sm sm:p-8 lg:col-span-7" data-vieren novalidate onsubmit="return false">
          <h3 class="text-2xl">Vraag de mogelijkheden aan</h3>
          <fieldset class="mt-6">
            <legend class="label">Wat wilt u vieren?</legend>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              {['Kleine bruiloft', 'Heisessie', 'Aangeklede borrel', 'Diner'].map((v, i) => (
                <label class="keuze !text-ink !shadow-[inset_0_0_0_1.5px_var(--color-line)] has-[:checked]:!text-gracht-3 has-[:checked]:!bg-koper-licht"><input type="radio" name="soort" value={v} class="sr-only" checked={i === 0} />{v}</label>
              ))}
            </div>
          </fieldset>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div><label for="v-datum" class="label">Datum</label><input id="v-datum" name="datum" type="date" class="veld" /></div>
            <div><label for="v-gasten" class="label">Aantal gasten</label><input id="v-gasten" name="gasten" type="number" min="1" inputmode="numeric" placeholder="Bijvoorbeeld 20" class="veld" /></div>
          </div>
          <label class="mt-5 flex items-center gap-3"><input type="checkbox" name="overnachten" class="h-5 w-5 accent-koper" /> <span>We willen ook blijven overnachten</span></label>
          <div class="mt-5"><label for="v-wensen" class="label">Uw wensen</label><textarea id="v-wensen" name="wensen" rows="3" class="veld" placeholder="Vertel kort wat u voor ogen heeft"></textarea></div>
          <p class="mt-6 rounded-lg bg-zand p-4 text-sm" data-samenvatting aria-live="polite">Kies wat u wilt vieren, een datum en het aantal gasten.</p>
          {site.voorstel ? (
            <p class="mt-4 text-sm text-ink-soft">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="num font-semibold text-koper underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold [overflow-wrap:anywhere] text-koper underline">{site.mail}</a>.</p>
          ) : null}
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href={`mailto:${site.mail}`} class="btn btn-donker" data-mail><Fragment set:html={mail} />Mail deze aanvraag</a>
            <a href={site.telHref} class="btn btn-line-licht"><Fragment set:html={tel} /><span>Bel <span class="num">{site.tel}</span></span></a>
          </div>
        </form>
      </div>
    </section>

    <!-- Direct boeken: aanvraag met samenvatting, verstuurt niets. -->
    <section id="boeken" class="donker scroll-mt-20 bg-gracht py-16 text-white lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="kicker text-koper-licht">Boek rechtstreeks</p>
          <h2 class="mt-3 text-3xl">Tegen goede condities en prijzen</h2>
          <p class="mt-6 text-white/85">Stel uw verblijf samen en neem direct contact op met het hotel: dan weet u meteen wat er beschikbaar is.</p>
          <div class="mt-8 hidden aspect-[4/5] overflow-hidden rounded-xl lg:block"><Foto src={restaurantTafel} alt="Kaarsjes op een ronde houten tafel in het huiskamerrestaurant" widths={[400, 800]} sizes="360px" /></div>
        </div>
        <form class="grid gap-6 lg:col-span-8" data-boeken novalidate onsubmit="return false">
          <div class="grid gap-5 rounded-xl bg-gracht-2 p-6 sm:p-8">
            <div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
              <div class="col-span-2 sm:col-span-1"><label for="b-aankomst" class="label">Aankomst</label><input id="b-aankomst" name="aankomst" type="date" class="veld" /></div>
              <div>
                <span class="label" id="b-nachten-l">Nachten</span>
                <div class="flex items-center gap-3" role="group" aria-labelledby="b-nachten-l">
                  <button type="button" class="stap" data-min="nachten" aria-label="Eén nacht minder">−</button>
                  <output class="num w-8 text-center font-display text-2xl" data-waarde="nachten" aria-live="polite">2</output>
                  <button type="button" class="stap" data-plus="nachten" aria-label="Eén nacht meer">+</button>
                </div>
              </div>
              <div>
                <span class="label" id="b-personen-l">Personen</span>
                <div class="flex items-center gap-3" role="group" aria-labelledby="b-personen-l">
                  <button type="button" class="stap" data-min="personen" aria-label="Eén persoon minder">−</button>
                  <output class="num w-8 text-center font-display text-2xl" data-waarde="personen" aria-live="polite">2</output>
                  <button type="button" class="stap" data-plus="personen" aria-label="Eén persoon meer">+</button>
                </div>
              </div>
            </div>
            <fieldset>
              <legend class="label">Soort suite</legend>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                <label class="keuze"><input type="radio" name="suite" value="boven" class="sr-only" />Eerste verdieping</label>
                <label class="keuze"><input type="radio" name="suite" value="tuin" class="sr-only" />Aan de achtertuin</label>
                <label class="keuze"><input type="radio" name="suite" value="appartement" class="sr-only" />Appartementje</label>
                <label class="keuze"><input type="radio" name="suite" value="geen" class="sr-only" checked />Geen voorkeur</label>
              </div>
            </fieldset>
          </div>

          <div class="rounded-xl bg-kalk p-6 text-ink shadow-lg sm:p-8">
            <p class="kicker text-koper">Uw aanvraag</p>
            <p class="mt-3 font-display text-xl leading-snug sm:text-2xl" data-uitkomst aria-live="polite">Kies een aankomstdatum, het aantal nachten en personen.</p>
            <p class="mt-3 hidden text-sm text-ink-soft" data-gezin>Voor 3 of 4 personen: sommige kamers zijn geschikt te maken voor gezinnen tot 4 personen. Vraag het even na.</p>
            {site.voorstel && <p class="mt-4 border-t border-line pt-4 text-sm text-ink-soft">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="num font-semibold text-koper underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold [overflow-wrap:anywhere] text-koper underline">{site.mail}</a>.</p>}
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a href={site.telHref} class="btn btn-donker"><Fragment set:html={tel} /><span>Bel <span class="num">{site.tel}</span></span></a>
              <a href={`mailto:${site.mail}`} class="btn btn-line-licht" data-mail><Fragment set:html={mail} />Mail deze aanvraag</a>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- Ligging en contact. -->
    <section id="ligging" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <p class="kicker text-koper">Ligging &amp; faciliteiten</p>
          <h2 class="mt-3 text-3xl">Rustig gelegen, op 200 meter van het centrum</h2>
          <dl class="mt-8 grid gap-px overflow-hidden rounded-xl bg-line shadow-sm sm:grid-cols-2">
            <div class="bg-kalk p-6"><dt class="font-display text-xl">Tuin</dt><dd class="mt-2 text-ink-soft">Zowel aan de voor- als achterzijde een ruime tuin.</dd></div>
            <div class="bg-kalk p-6"><dt class="font-display text-xl">Centrum</dt><dd class="mt-2 text-ink-soft">Het gezellige centrum van Bolsward ligt op 200 meter afstand.</dd></div>
            <div class="bg-kalk p-6"><dt class="font-display text-xl">Parkeren</dt><dd class="mt-2 text-ink-soft">8 eigen parkeerplaatsen, te gebruiken tegen een vergoeding per nacht. Rondom het hotel kunt u vrij parkeren.</dd></div>
            <div class="bg-kalk p-6"><dt class="font-display text-xl">Fietsen</dt><dd class="mt-2 text-ink-soft">Fietsen kunnen droog en veilig worden gestald. Accu's laden kan ook.</dd></div>
          </dl>
        </div>
        <div class="self-start lg:col-span-5">
        <aside class="donker rounded-xl bg-gracht p-7 text-white shadow-lg sm:p-9">
          <p class="kicker text-koper-licht">Contact</p>
          <h3 class="mt-3 text-2xl">{site.naam}</h3>
          <p class="mt-3 text-white/85">{site.straat}<br />{site.postcode} {site.plaats}, {site.provincie}</p>
          <ul class="mt-6 space-y-3">
            <li><a href={site.telHref} class="inline-flex items-center gap-3 font-semibold no-underline hover:text-koper-licht"><span class="grid h-10 w-10 place-items-center rounded-full bg-gracht-2 [&_svg]:h-5 [&_svg]:w-5"><Fragment set:html={tel} /></span><span class="num">{site.tel}</span></a></li>
            <li><a href={`mailto:${site.mail}`} class="inline-flex items-center gap-3 font-semibold no-underline hover:text-koper-licht"><span class="grid h-10 w-10 flex-none place-items-center rounded-full bg-gracht-2 [&_svg]:h-5 [&_svg]:w-5"><Fragment set:html={mail} /></span><span class="[overflow-wrap:anywhere]">{site.mail}</span></a></li>
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
            <a href={site.maps} rel="noopener" class="btn btn-koper">Plan uw route <Fragment set:html={pijl} /></a>
            <a href="#boeken" class="btn btn-line">Boek rechtstreeks</a>
          </div>
          <p class="mt-8 border-t border-white/15 pt-5 text-sm text-white/80">Volg Het Weeshuis op <a href={site.facebook} rel="noopener" class="font-semibold underline underline-offset-2">Facebook</a> en <a href={site.instagram} rel="noopener" class="font-semibold underline underline-offset-2">Instagram</a>.</p>
        </aside>
          <figure class="mt-6">
            <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm"><Foto src={toenKerkstraat} alt="Historische foto van de Kerkstraat in Bolsward met bakstenen huizen en een kerktoren" widths={[480, 800, 1024]} sizes="(min-width: 1024px) 460px, 100vw" /></div>
            <figcaption class="mt-3 text-sm text-ink-soft">De Kerkstraat, vroeger. Het Weeshuis staat op nummer 53.</figcaption>
          </figure>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  // Toen en nu: tabs tussen twee vergelijkingen, schuifregelaar (native range: muis, touch en pijltjestoetsen).
  const toennu = document.querySelector<HTMLElement>('[data-toennu]');
  if (toennu) {
    const tabs = toennu.querySelector<HTMLElement>('[data-tabs]')!;
    tabs.classList.remove('hidden'); tabs.classList.add('flex');
    toennu.querySelector('[data-uitleg]')?.classList.remove('hidden');
    const knoppen = [...tabs.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panelen = [...toennu.querySelectorAll<HTMLElement>('[data-paneel]')];
    const kies = (i: number, focus = false) => {
      knoppen.forEach((k, j) => { k.setAttribute('aria-selected', String(i === j)); k.tabIndex = i === j ? 0 : -1; });
      panelen.forEach((p, j) => { p.hidden = i !== j; });
      if (focus) knoppen[i].focus();
    };
    knoppen.forEach((k, i) => {
      k.addEventListener('click', () => kies(i));
      k.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); kies((i + (e.key === 'ArrowRight' ? 1 : knoppen.length - 1)) % knoppen.length, true); }
      });
    });
    panelen.forEach((p) => {
      const v = p.querySelector<HTMLElement>('.vergelijk')!;
      const r = p.querySelector<HTMLInputElement>('input[type=range]')!;
      r.hidden = false;
      const zet = () => { v.style.setProperty('--pos', r.value + '%'); r.setAttribute('aria-valuetext', `${r.value}% toen, ${100 - Number(r.value)}% nu`); };
      r.addEventListener('input', zet); zet();
    });
  }

  // Direct boeken: samenvatting, geen verzending.
  const boek = document.querySelector<HTMLFormElement>('[data-boeken]');
  const suiteNamen: Record<string, string> = { boven: 'een suite op de eerste verdieping', tuin: 'een suite aan de achtertuin', appartement: 'een klein appartementje', geen: 'een suite, geen voorkeur' };
  const tel = { nachten: 2, personen: 2 };
  const grens = { nachten: [1, 21], personen: [1, 4] } as const;
  const datumNL = (d: Date) => d.toLocaleDateString('nl-NL', { weekday: 'short', day: 'numeric', month: 'long' });
  const mailHref = (onderwerp: string, tekst: string) => `mailto:info@hotelhetweeshuis.nl?subject=${encodeURIComponent(onderwerp)}&body=${encodeURIComponent(tekst)}`;
  if (boek) {
    const aankomst = boek.querySelector<HTMLInputElement>('#b-aankomst')!;
    const vandaag = new Date(); aankomst.min = vandaag.toISOString().slice(0, 10);
    const uit = boek.querySelector<HTMLElement>('[data-uitkomst]')!;
    const gezin = boek.querySelector<HTMLElement>('[data-gezin]')!;
    const mail = boek.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const werk = () => {
      (Object.keys(tel) as (keyof typeof tel)[]).forEach((k) => {
        boek.querySelector(`[data-waarde=${k}]`)!.textContent = String(tel[k]);
        (boek.querySelector(`[data-min=${k}]`) as HTMLButtonElement).disabled = tel[k] <= grens[k][0];
        (boek.querySelector(`[data-plus=${k}]`) as HTMLButtonElement).disabled = tel[k] >= grens[k][1];
      });
      const suite = (boek.querySelector<HTMLInputElement>('input[name=suite]:checked')?.value) || 'geen';
      const n = tel.nachten, p = tel.personen;
      const deel = `${n} ${n === 1 ? 'nacht' : 'nachten'}, ${p} ${p === 1 ? 'persoon' : 'personen'}, ${suiteNamen[suite]}`;
      let zin: string;
      if (aankomst.value) {
        const a = new Date(aankomst.value + 'T12:00'); const v = new Date(a); v.setDate(a.getDate() + n);
        zin = `Van ${datumNL(a)} tot ${datumNL(v)}: ${deel}.`;
      } else zin = `${deel.charAt(0).toUpperCase() + deel.slice(1)}. Kies nog een aankomstdatum.`;
      uit.textContent = zin;
      gezin.classList.toggle('hidden', p < 3);
      mail.href = mailHref('Aanvraag verblijf', `Beste Het Weeshuis,\n\nGraag zou ik boeken: ${zin}\n\nMet vriendelijke groet,\n`);
    };
    boek.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-min],[data-plus]');
      if (!t) return;
      const k = (t.dataset.min || t.dataset.plus) as keyof typeof tel;
      tel[k] = Math.min(grens[k][1], Math.max(grens[k][0], tel[k] + (t.dataset.min ? -1 : 1)));
      werk();
    });
    boek.addEventListener('input', werk); boek.addEventListener('change', werk);
    document.querySelectorAll<HTMLAnchorElement>('[data-suite]').forEach((a) => a.addEventListener('click', () => {
      const r = boek.querySelector<HTMLInputElement>(`input[name=suite][value=${a.dataset.suite}]`);
      if (r) { r.checked = true; werk(); }
    }));
    werk();
  }

  // Vieren: samenvatting, geen verzending.
  const vier = document.querySelector<HTMLFormElement>('[data-vieren]');
  if (vier) {
    const sam = vier.querySelector<HTMLElement>('[data-samenvatting]')!;
    const mail = vier.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const datum = vier.querySelector<HTMLInputElement>('#v-datum')!;
    datum.min = new Date().toISOString().slice(0, 10);
    const werk = () => {
      const f = new FormData(vier);
      const soort = String(f.get('soort') || '');
      const d = f.get('datum') ? datumNL(new Date(String(f.get('datum')) + 'T12:00')) : '';
      const g = Number(f.get('gasten')) || 0;
      const delen = [soort, d && `op ${d}`, g && `met ${g} ${g === 1 ? 'gast' : 'gasten'}`, f.get('overnachten') && 'inclusief overnachten'].filter(Boolean);
      const zin = delen.join(', ') + '.';
      sam.textContent = `Uw aanvraag: ${zin}`;
      const wensen = String(f.get('wensen') || '').trim();
      mail.href = mailHref(`Aanvraag: ${soort}`, `Beste Het Weeshuis,\n\nWe willen graag iets vieren: ${zin}${wensen ? `\n\nOnze wensen: ${wensen}` : ''}\n\nMet vriendelijke groet,\n`);
    };
    vier.addEventListener('input', werk); vier.addEventListener('change', werk); werk();
  }
</script>
