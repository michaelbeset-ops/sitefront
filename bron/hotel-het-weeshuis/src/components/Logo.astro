---
// Wordmark: "Het Weeshuis" met "sinds 1553" eronder, zoals op hun eigen bord (bakfietsfoto oude site),
// met een beeldmerk van het hoge boogvenster uit de gevel van het Weeshuis.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const lijn = licht ? '#e0a872' : '#8b4a1e';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg viewBox="0 0 28 36" class="h-9 w-7 flex-none" aria-hidden="true">
    <path d="M3 34V13.5a11 11 0 0 1 22 0V34z" fill="none" stroke={lijn} stroke-width="2.2" />
    <path d="M14 3.5V34M3.5 20h21M3.5 27h21" stroke={lijn} stroke-width="1.3" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-lg font-medium tracking-[-0.02em] whitespace-nowrap sm:text-xl">Het Weeshuis</span>
    <span class={`mt-1 text-[0.6875rem] font-semibold uppercase tracking-[0.2em] whitespace-nowrap max-[359px]:hidden ${licht ? 'text-white/75' : 'text-ink-soft'}`}>Hotel <span aria-hidden="true">·</span> sinds 1553</span>
  </span>
</span>
