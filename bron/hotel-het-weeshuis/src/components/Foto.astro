---
// Sfeerfoto via Astro's beeldoptimalisatie: WebP in meerdere breedtes, lazy tenzij het de hero is.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; class?: string; hero?: boolean; sizes?: string; widths?: number[]; quality?: number; }
const { src, alt, class: cls = '', hero = false, sizes = '(min-width: 1024px) 50vw, 100vw', widths = [480, 800, 1200, 1800], quality = 70 } = Astro.props;
---
<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={quality}
  loading={hero ? 'eager' : 'lazy'}
  fetchpriority="auto"
  class={`block h-full w-full object-cover ${cls}`}
/>
