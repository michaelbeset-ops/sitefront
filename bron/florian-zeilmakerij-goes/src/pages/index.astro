---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, wa, waMet, mailOfferte } from '../data/site';
import bordeaux from '../assets/bordeaux-sprayhood.jpg';
import blauw from '../assets/blauw-sprayhood.jpg';
import antraciet from '../assets/antraciet-sloep.jpg';
import zwart from '../assets/zwart-verandazeil.jpg';
import sand from '../assets/sand-rolfokhoes.jpg';
import huik from '../assets/huik-v933.jpg';
import lounge from '../assets/hoes-loungebank.jpg';

// De stalenkaart: elke kleur is een echt werkstuk uit hun eigen fotogalerij (kleur en product staan in de bestandsnaam).
const stalen = [
  { k: 'bordeaux', kleur: '#7a2430', naam: 'Bordeaux', wat: 'Sprayhood', img: bordeaux, pos: '50% 55%', alt: 'Bordeauxrode sprayhood met ramen op een zeilboot met houten dek, in de haven' },
  { k: 'blauw', kleur: '#1d2a5c', naam: 'Blauw', wat: 'Sprayhood', img: blauw, pos: '35% 50%', alt: 'Donkerblauwe sprayhood op een witte zeilboot met blauwe romp, met de Nederlandse vlag op de achtergrond' },
  { k: 'antraciet', kleur: '#3c4146', naam: 'Antraciet', wat: 'Kap op een sloep', img: antraciet, pos: '45% 60%', alt: 'Sloep met antraciet kap op een trailer voor de werkplaats, ernaast de bus van Florian Zeilmakerij' },
  { k: 'zwart', kleur: '#17181a', naam: 'Zwart', wat: 'Verandazeil', img: zwart, pos: '50% 60%', alt: 'Houten veranda in een tuin, rondom dichtgemaakt met zwarte verandazeilen' },
  { k: 'sand', kleur: '#cdbf9f', naam: 'Sand', wat: 'Rolfokhoes', img: sand, pos: '50% 35%', alt: 'Zeilboot in de jachthaven met een zandkleurige rolfokhoes langs het voorstag' },
];

const tijden = [['Maandag', '09:00 - 18:00'], ['Dinsdag', '09:00 - 18:00'], ['Woensdag', '09:00 - 18:00'], ['Donderdag', '09:00 - 18:00'], ['Vrijdag', '09:00 - 18:00'], ['Zaterdag', 'op belafspraak']];
---
<Base title="Florian Zeilmakerij, Goes | Bootkappen, sprayhoods, afdekzeilen en reparaties" description="Zeilmakerij in Goes voor bootkappen, sprayhoods, biminitops, afdekzeilen, huiken, verandazeilen, hoezen en reparaties. Bel of app 06 36 32 34 94.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. Hero: de stalenkaart. Links hun eigen slogan, rechts het werk zelf; elke doekstaal wisselt de foto. -->
    <section class="relative overflow-hidden" aria-labelledby="kop">
      <div class="lg:grid lg:min-h-[max(640px,min(calc(100svh-6.1rem),860px))] lg:grid-cols-12">
        <div class="wrap relative z-10 flex flex-col pb-6 pt-7 lg:col-span-5 lg:max-w-none lg:justify-between lg:py-14 lg:!pr-14 xl:!pl-[max(3rem,calc((100vw-92rem)/2+3rem))]">
          <div>
            <p class="flex items-center gap-2.5 text-sm font-medium text-staal"><span class="knoop !h-3 !w-3" aria-hidden="true"></span>Zeilmaker in Goes</p>
            <h1 id="kop" class="mt-4 text-[clamp(2.55rem,10.4vw,3.4rem)] sm:text-3xl lg:mt-8 lg:text-[clamp(3.2rem,4.75vw,5rem)]">Dé zeilmakerij van Zeeland.</h1>
            <p class="mt-4 max-w-[30rem] text-lg leading-snug text-staal lg:mt-7 lg:text-xl lg:leading-snug">Voor al uw bootkappen, afdekzeilen, biminitops en reparaties van tenten.</p>
          </div>
          <div class="hidden lg:block">
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
              <a href={waMet('ik zag de sprayhood in bordeaux op uw site en heb een vraag.')} class="knop" data-wa><Fragment set:html={wa} />Stuur een WhatsApp</a>
              <a href={site.telHref} class="lijn font-medium">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            </div>
            <div class="naad mt-9 text-marine" aria-hidden="true"></div>
            <p class="mt-4 max-w-[27rem] text-sm text-staal">We zijn vaak in de haven aan het werk. Bellen of appen gaat sneller dan mailen.</p>
          </div>
        </div>

        <div class="relative lg:col-span-7">
          <div class="relative mx-5 aspect-[4/3] overflow-hidden rounded-sm sm:mx-12 lg:absolute lg:inset-0 lg:mx-0 lg:aspect-auto lg:rounded-none" id="lijst" data-actief="bordeaux">
            {stalen.map((s, i) => (
              <figure class="foto absolute inset-0 m-0" data-k={s.k} style={`--pos:${s.pos}`}>
                <Foto src={s.img} alt={s.alt} hero={i === 0} sizes="(min-width: 1024px) 58vw, 100vw" class="[object-position:var(--pos)]" />
              </figure>
            ))}
            <p class="absolute right-0 top-0 z-10 bg-marine px-3.5 py-2 text-sm text-wit lg:bottom-8 lg:right-8 lg:top-auto lg:px-4 lg:py-2.5">
              <span data-wat>Sprayhood</span>, <span data-naam class="lowercase">Bordeaux</span>
            </p>
          </div>

          <!-- De stalen: op mobiel een rij onder de foto, op desktop een staalboek dat over de rand van de foto hangt. -->
          <fieldset class="relative z-20 mx-5 -mt-5 sm:mx-12 lg:absolute lg:left-0 lg:top-1/2 lg:mx-0 lg:mt-0 lg:-translate-x-1/2 lg:-translate-y-1/2">
            <legend class="sr-only">Kies een doekkleur en bekijk het werkstuk</legend>
            <div class="grid grid-cols-5 gap-1.5 lg:flex lg:flex-col lg:gap-2">
              {stalen.map((s, i) => (
                <label class="staalkeuze group block cursor-pointer">
                  <input type="radio" name="staal" value={s.k} checked={i === 0} class="peer sr-only" data-naam={s.naam} data-wat={s.wat} />
                  <span class={`staal ${s.k === 'sand' ? 'licht text-marine' : 'text-wit'} flex h-16 items-end rounded-sm px-2 pb-2 text-[.72rem] font-semibold leading-none shadow-sm transition-transform duration-200 group-hover:-translate-y-0.5 peer-checked:-translate-y-2 peer-checked:ring-2 peer-checked:ring-marine peer-checked:ring-offset-2 peer-checked:ring-offset-doek peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-rog lg:h-[4.6rem] lg:w-[6.5rem] lg:px-3 lg:pb-2.5 lg:text-xs lg:group-hover:translate-x-1 lg:group-hover:translate-y-0 lg:peer-checked:translate-x-3 lg:peer-checked:translate-y-0`} style={`--k:${s.kleur}`}>{s.naam}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <div class="wrap pb-10 pt-6 lg:hidden">
          <a href={waMet('ik zag de sprayhood in bordeaux op uw site en heb een vraag.')} class="knop w-full justify-center sm:w-auto" data-wa><Fragment set:html={wa} />Stuur een WhatsApp</a>
          <p class="mt-3 text-center text-sm text-staal sm:text-left">of bel <a href={site.telHref} class="lijn whitespace-nowrap font-medium tabular-nums text-marine">{site.tel}</a>. We zijn vaak in de haven aan het werk.</p>
        </div>
      </div>
    </section>

    <!-- 2. Wat we maken: een doorlopende index, geen kaartjes. -->
    <section id="maken" class="scroll-mt-16 border-t border-lijn bg-wit py-20 lg:py-28" aria-labelledby="maken-kop">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <h2 id="maken-kop" class="text-2xl">Van bootkap tot kussenhoes.</h2>
          <p class="mt-5 max-w-[36rem] text-lg text-staal">Een Zeeuwse zeilmakerij voor alles wat een zeil behoeft. Ook voor reparaties en het wassen van zeilen kunt u bij ons terecht.</p>

          <div class="mt-12 grid gap-10 sm:grid-cols-2">
            <div class="sm:row-span-2">
              <h3 class="text-xl">Aan boord</h3>
              <ul class="mt-4 text-lg">
                {['Bootkappen en cabrioletkappen', 'Sprayhoods', 'Biminitops', 'Afdekzeilen', 'Huiken en lazy bags', 'Rolfokhoezen', 'Stuurwielconsoles', 'Wintertenten', 'Kussens en bekleding'].map((p) => (
                  <li class="border-b border-dashed border-lijn py-2.5">{p}</li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-xl">Aan wal</h3>
              <ul class="mt-4 text-lg">
                {['Verandazeilen', 'Hoezen voor tuinmeubilair en fietsendragers', 'Afdekzeilen voor aanhangers en vrachtwagens', 'Autostoelen en motorzittingen'].map((p) => (
                  <li class="border-b border-dashed border-lijn py-2.5">{p}</li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-xl">In de werkplaats</h3>
              <ul class="mt-4 text-lg">
                {['Reparaties van doek, ramen en kussens', 'Zeilwasserij: stomen en wassen'].map((p) => (
                  <li class="border-b border-dashed border-lijn py-2.5">{p}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        <figure class="relative m-0 lg:col-span-5">
          <div class="relative h-[26rem] overflow-hidden rounded-sm sm:h-[34rem] lg:h-full lg:min-h-[38rem]">
            <Foto src={huik} alt="Donkerblauwe huik over de giek van een zeilboot, met het zeilnummer erop" sizes="(min-width: 1024px) 38vw, 100vw" class="object-[30%_50%]" />
          </div>
          <span class="knoop absolute -left-[7px] -top-[7px]" aria-hidden="true"></span>
          <span class="knoop absolute -right-[7px] -top-[7px]" aria-hidden="true"></span>
          <figcaption class="mt-3 text-sm text-staal">Huik op maat, donkerblauw.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. De mal: het vakwerk zelf, groot. -->
    <section id="mal" class="scroll-mt-16 bg-doek" aria-labelledby="mal-kop">
      <div class="relative h-[19rem] sm:h-[30rem] lg:h-[40rem]">
        <Foto src={blauw} alt="Donkerblauwe sprayhood met ramen, strak op een zeilboot in de haven" sizes="100vw" class="object-[40%_50%]" />
      </div>
      <div class="wrap relative">
        <div class="op-donker relative -mt-16 bg-marine p-7 text-mist sm:p-10 lg:-mt-48 lg:ml-[8%] lg:max-w-[46rem] lg:p-14">
          <h2 id="mal-kop" class="text-2xl text-wit">Eerst een mal, aan boord.</h2>
          <p class="mt-5 text-lg leading-relaxed">Een oude sprayhood kunnen we namaken. Liever maken we een nieuwe mal aan boord, zodat hij zo strak mogelijk op uw boot staat.</p>
          <div class="naad mt-8 text-limoen !opacity-80" aria-hidden="true"></div>
          <ul class="mt-6 grid gap-x-8 gap-y-2 sm:grid-cols-2">
            {['Vorm en aantal ramen kiest u zelf', 'Bijna eindeloos veel doeken en kleuren', 'Te combineren met een aanritsbare achtertent', 'Kappen die meegaan met de vorm van uw boot'].map((t) => (
              <li class="flex gap-3"><span class="mt-[.55em] h-1.5 w-1.5 shrink-0 rounded-full bg-limoen" aria-hidden="true"></span>{t}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="wrap grid gap-10 py-20 lg:grid-cols-12 lg:gap-16 lg:py-28">
        <div class="lg:col-span-4 lg:pt-10">
          <h2 class="text-2xl">Ook aan wal.</h2>
          <p class="mt-5 text-lg text-staal">Een verandazeil maakt uw veranda in herfst en winter wind- en regendicht, en in de zomer zet u hem gewoon open. Hoezen maken we op maat, groot en klein.</p>
          <a href={waMet('ik wil graag iets op maat laten maken voor in de tuin.')} class="lijn mt-6 inline-flex items-center gap-2 font-semibold"><Fragment set:html={wa} />Vraag het via WhatsApp</a>
        </div>
        <figure class="m-0 lg:col-span-8">
          <div class="relative aspect-[1280/500] overflow-hidden rounded-sm">
            <Foto src={lounge} alt="Lichtgrijze hoes op maat over een hoekloungebank op een terras" sizes="(min-width: 1024px) 62vw, 100vw" />
          </div>
          <figcaption class="mt-3 text-sm text-staal">Hoes op maat voor een loungebank.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Werkplaats: adres groot, met hun eigen pand en bus. -->
    <section id="werkplaats" class="scroll-mt-16 border-t border-lijn bg-wit" aria-labelledby="werk-kop">
      <div class="grid lg:grid-cols-2">
        <div class="relative h-[20rem] sm:h-[28rem] lg:h-auto lg:min-h-[44rem]">
          <Foto src={antraciet} alt="De werkplaats aan de Dr. A.F. Philipsstraat in Goes, met een sloep op een trailer en de bus van Florian Zeilmakerij" sizes="(min-width: 1024px) 50vw, 100vw" class="object-[45%_50%]" />
        </div>
        <div class="px-5 py-16 sm:px-12 lg:px-16 lg:py-24 xl:pr-[max(3rem,calc((100vw-92rem)/2+3rem))]">
          <h2 id="werk-kop" class="text-2xl">Dr. A.F. Philips&shy;straat 13c, Goes</h2>
          <p class="mt-5 max-w-[32rem] text-lg text-staal">Langskomen in de werkplaats kan. Bel of app wel eerst even: we zijn vaak in de haven aan het werk.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={waMet('ik wil graag langskomen in de werkplaats. Wanneer komt het uit?')} class="knop"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="lijn font-medium">of bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
          <dl class="mt-12 max-w-[26rem] text-base">
            {tijden.map(([d, t]) => (
              <div class="flex justify-between gap-4 border-b border-dashed border-lijn py-2"><dt>{d}</dt><dd class={`whitespace-nowrap tabular-nums ${t === 'op belafspraak' ? 'text-staal' : ''}`}>{t}</dd></div>
            ))}
          </dl>
          <p class="mt-8 text-sm text-staal">Offerte liever op papier? <a href={mailOfferte} class="lijn font-medium text-marine">Mail ons</a>, of <a href={site.maps} class="lijn font-medium text-marine">open de route</a>.</p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  #lijst .foto { display: none; }
  @keyframes infaden { from { opacity: 0; } to { opacity: 1; } }
  #lijst[data-actief="bordeaux"] .foto[data-k="bordeaux"],
  #lijst[data-actief="blauw"] .foto[data-k="blauw"],
  #lijst[data-actief="antraciet"] .foto[data-k="antraciet"],
  #lijst[data-actief="zwart"] .foto[data-k="zwart"],
  #lijst[data-actief="sand"] .foto[data-k="sand"] { display: block; animation: infaden .45s ease; }
</style>

<script>
  // Stalenkaart: een staal kiezen wisselt de foto, het bijschrift en het vooraf ingevulde WhatsApp-bericht.
  const lijst = document.getElementById('lijst');
  const wat = document.querySelector('[data-wat]:not(input)');
  const naam = document.querySelector('[data-naam]:not(input)');
  document.querySelectorAll<HTMLInputElement>('input[name="staal"]').forEach((r) => {
    r.addEventListener('change', () => {
      if (!lijst || !r.checked) return;
      lijst.dataset.actief = r.value;
      // lazy foto's alvast laden
      lijst.querySelectorAll<HTMLImageElement>(`.foto[data-k="${r.value}"] img`).forEach((i) => (i.loading = 'eager'));
      if (wat) wat.textContent = r.dataset.wat ?? '';
      if (naam) naam.textContent = r.dataset.naam ?? '';
      const tekst = `Hallo, ik zag de ${(r.dataset.wat ?? '').toLowerCase()} in ${(r.dataset.naam ?? '').toLowerCase()} op uw site en heb een vraag.`;
      document.querySelectorAll<HTMLAnchorElement>('[data-wa]').forEach((a) => (a.href = `https://wa.me/31636323494?text=${encodeURIComponent(tekst)}`));
    });
  });
</script>
