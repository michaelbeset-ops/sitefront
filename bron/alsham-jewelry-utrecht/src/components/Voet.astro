---
import { site, url, waHoi } from '../data/site';
const jaar = new Date().getFullYear();
const collectie = ['Halskettingen', 'Schakelkettingen', 'Ringen', 'Armbanden', 'Oorbellen en sets', 'Goud om te sparen'];
---
<footer class="border-t border-lijn bg-nacht text-steen">
  <div class="wrap pt-14"><span class="meander" aria-hidden="true"></span></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-14 text-[.9375rem] md:grid-cols-12 md:py-16">
    <div class="md:col-span-4">
      <p class="kop text-3xl leading-none text-ivoor">Alsham</p>
      <p class="ar mt-2 text-xl text-messing" lang="ar" dir="rtl" style="text-align:left">{site.arabisch}</p>
      <p class="mt-5 max-w-xs">Juwelier in {site.centrum}, {site.plaats}. Syrisch goud van 21 karaat, elke dag open.</p>
    </div>
    <div class="md:col-span-3">
      <p class="text-ivoor">Collectie</p>
      <ul class="mt-3 space-y-1">{collectie.map((p) => <li><a href={url('#collectie')} class="no-underline transition-colors hover:text-messing">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="text-ivoor">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={site.facebook} class="link">Facebook</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="text-ivoor">Open</p>
      <ul class="num mt-3 space-y-0.5">
        <li>ma t/m za<br />11:00 tot 18:00</li>
        <li class="pt-2">zo<br />11:00 tot 17:00</li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's komen van jullie eigen Google-profiel en Facebookpagina. Openingstijden en score van Google (stand 8 oktober 2026).</p>}
</footer>
