---
// Het ruitlogo zoals het op het raam staat: een dunne ruit, "FADI'S" tussen twee stippen, eronder "eten en drinken".
// Nagetekend naar hun eigen raamfoto's; de letters gebruiken Onest (dun, gespatieerd) zoals op het glas.
interface Props { class?: string; tekst?: boolean }
const { class: cls = '', tekst = true } = Astro.props;
---
<svg viewBox="0 0 200 200" class={cls} aria-hidden="true" fill="none">
  <path d="M100 6 194 100 100 194 6 100Z" stroke="currentColor" stroke-width={tekst ? 3.2 : 9} stroke-linejoin="miter" />
  {tekst && (
    <g fill="currentColor" font-family="Onest Variable, system-ui, sans-serif">
      <circle cx="37" cy="92" r="3.2" />
      <circle cx="163" cy="92" r="3.2" />
      <text x="100" y="104" text-anchor="middle" font-size="33" font-weight="350" letter-spacing="3">FADI'S</text>
      <text x="100" y="124" text-anchor="middle" font-size="8.6" font-weight="450" letter-spacing="3.1">ETEN EN DRINKEN</text>
    </g>
  )}
</svg>
