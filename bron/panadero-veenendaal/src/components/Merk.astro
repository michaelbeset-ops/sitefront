---
// Woordmerk zoals "Panadero ontbijt" op hun menumuur: script, met koperen dubbellijnen ernaast.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex flex-col items-start no-underline', licht ? 'text-wit' : 'text-inkt', cls]} aria-label="Panadero, naar de homepage">
  <span class="script text-[2rem] font-bold leading-none md:text-[2.25rem]">Panadero</span>
  <span class:list={['mt-1 flex w-full items-center gap-2 text-[.625rem] font-semibold uppercase tracking-[.22em]', licht ? 'text-mist' : 'text-grijs']}>
    <span class:list={['h-[5px] flex-1 border-y', licht ? 'border-koper-licht' : 'border-koper']}></span>Veenendaal<span class:list={['h-[5px] flex-1 border-y', licht ? 'border-koper-licht' : 'border-koper']}></span>
  </span>
</a>
