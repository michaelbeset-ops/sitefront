---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const kort = [['Maandag t/m zaterdag', '11:00 - 21:00'], ['Zondag', '09:30 - 20:30']];
const links = [['Ontbijt', 'kaart'], ['Belegde broodjes', 'kaart'], ["Panini's en tosti's", 'kaart'], ['Wraps en burgers', 'kaart'], ['Cheesecake en koffie', 'vitrine']];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Ontbijt, broodjes, Kaddour grillworst en cheesecake by Sam. In De Scheepjeshof, Veenendaal.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Van de kaart</p>
      <ul class="mt-3 space-y-1">
        {links.map(([t, id]) => <li><a href={url(`#${id}`)} class="link link-licht no-underline hover:underline">{t}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}<br />Winkelcentrum {site.centrum}</p>
      <p class="mt-4 flex gap-2">
        <a href={site.instagram} class="grid h-11 w-11 place-items-center text-mist hover:text-koper-licht" aria-label="Panadero op Instagram"><Icoon naam="insta" class="h-6 w-6" /></a>
        <a href={site.tiktok} class="grid h-11 w-11 place-items-center text-mist hover:text-koper-licht" aria-label="Panadero op TikTok"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.3 2.2 1.6 3.6 3.9 3.8v2.6a6.8 6.8 0 0 1-3.8-1.2v5.9c0 3.3-2.3 5.9-5.6 5.9A5.6 5.6 0 0 1 5.5 14c0-3.4 2.9-6 6.5-5.5v2.8c-1.6-.4-3.6.5-3.6 2.6 0 1.6 1.2 2.7 2.7 2.7 1.7 0 2.7-1.1 2.7-3.1V3h2.8Z"/></svg></a>
      </p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      {kort.map(([d, t]) => <p class="mt-3">{d}<br /><span class="text-wit">{t}</span></p>)}
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's en kaart van jullie eigen Google-bedrijfsprofiel (de menumuur in de zaak, zonder prijzen). Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
