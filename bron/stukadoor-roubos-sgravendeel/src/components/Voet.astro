---
import { site, url, waVraag } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="donker bg-specie text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <span class="merk-teken" aria-hidden="true"><Icoon naam="spaan" class="h-6 w-6" /></span>
        <span><b>ROUBOS</b><small>Stukadoorsbedrijf</small></span>
      </a>
      <p class="mt-6 max-w-xs">Stukadoor uit {site.plaats}, in de {site.regio}. Stucwerk voor wanden en plafonds.</p>
      <p class="mt-6 flex items-center gap-2 text-sm"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><span class="num">{site.google.score} op Google</span></p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-kop font-bold uppercase tracking-[.08em] text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        <li><a href={h('diensten')} class="no-underline transition-colors hover:text-vonk">Stucwerk wanden</a></li>
        <li><a href={h('diensten')} class="no-underline transition-colors hover:text-vonk">Stucwerk plafonds</a></li>
        <li><a href={h('contact')} class="no-underline transition-colors hover:text-vonk">Klus doorgeven</a></li>
        <li><a href={h('reviews')} class="no-underline transition-colors hover:text-vonk">Reviews</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-kop font-bold uppercase tracking-[.08em] text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-vonk">{site.tel}</a></li>
        <li><a href={waVraag} class="no-underline transition-colors hover:text-vonk">WhatsApp</a></li>
        <li>{site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-kop font-bold uppercase tracking-[.08em] text-licht">Gegevens</p>
      <ul class="mt-4 space-y-2">
        <li>{site.naam}</li>
        <li>Eenmanszaak</li>
        <li class="num">KvK {site.kvk}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-vonk">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Sfeerfoto’s via Unsplash, ter illustratie; dit is niet het werk van {site.naam}. Reviews letterlijk van Google (stand 3 oktober 2026).</p>}
  </div>
</footer>
