---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-loods text-zilver">
  <span class="profiel opacity-60" aria-hidden="true"></span>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk />
      <p class="mt-6 max-w-xs">Gebruikte machines en tractoren in 's-Gravendeel. Ook bekend als MC-P Nederland.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Aanbod</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={site.aanbod} class="link link-licht">Actueel aanbod</a></li>
        <li><a href={url('#zoeken')} class="link link-licht">Machine zoeken</a></li>
        <li><a href={site.route} class="link link-licht">Route</a></li>
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4">{site.kort}<br />{site.straat}<br />{site.postcode}</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <a href={waHoi} class="link link-licht">(ook WhatsApp)</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en foto's van janslooter.nl en mc-p.nl; rubrieken en merken uit jullie aanbod op Tractors and Machinery (oktober 2026). Reviews letterlijk van Google (stand 10 oktober 2026).</p>}
</footer>
