---
// Woordmerk naar hun logo: JAN SLOOTER groot, daaronder de pijltjes en "Mechanisatiecentrum".
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class={`block leading-none no-underline ${licht ? 'text-inkt' : 'text-wit'} ${cls}`}>
  <span class="kop block text-[1.75rem] tracking-[.01em] md:text-[2.05rem]">Jan Slooter</span>
  <span class="mt-1 flex items-center gap-2">
    <span class="profiel w-[3.6rem] scale-y-75 md:w-[4.4rem]" aria-hidden="true"></span>
    <span class={`text-[.78rem] font-semibold tracking-[.02em] md:text-[.86rem] ${licht ? 'text-grijs' : 'text-zilver'}`}>Mechanisatiecentrum</span>
  </span>
</a>
