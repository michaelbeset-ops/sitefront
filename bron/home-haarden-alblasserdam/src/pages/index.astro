---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Vlam from '../components/Vlam.astro';
import { site, tijden, ervaringen, waAfspraak, waMet } from '../data/site';

import hero from '../assets/eigen-slide4-gespiegeld.jpg';
import vuur from '../assets/eigen-slide2.jpg';
import wand from '../assets/eigen-showroom-wand.jpg';
import bussen from '../assets/eigen-bussen.jpg';
import pMaestro80 from '../assets/proj-maestro-80.jpg';
import pMaestro75 from '../assets/proj-maestro-75.jpg';
import pMetro100 from '../assets/proj-metro-100xt.jpg';
import pTrisore from '../assets/proj-trisore-140.jpg';
import pMetro150 from '../assets/proj-metro-150.jpg';

// Aanbod en modellen: categorieën en filters op home-haarden.nl.
const aanbod = [
  ['Gashaarden', 'inbouw, vrijstaand, hangend of buiten'],
  ['Houtkachels', 'vrijstaand, inbouwhaard of inzethaard'],
  ['Elektrische haarden', 'inbouw of hangend'],
  ['Plateaus & maatwerk', 'haardenwand, schouw, meubel'],
  ['Onderhoud', 'de jaarlijkse onderhoudsbeurt'],
];
// Merkfilters in hun webshop.
const merken = ['DRU', 'Element4', 'Global Fires', 'Bellfires', 'Dovre', 'Wanders', 'Faber', 'Spartherm', 'Dik Geurts', 'Barbas', 'Jacobus', 'Thermocet', 'Nestor Martin', 'Helex', 'Dimplex'];
const stappen = [
  ['Advies', 'In de showroom of bij u thuis. Vrijblijvend, en ons advies is gratis.'],
  ['Voorstel', 'Ons aanbod is groot. We denken mee en maken een voorstel dat past bij uw wensen en mogelijkheden.'],
  ['Installatie', 'Door onze eigen installateurs, met ruime ervaring in alle merken. Geen onderaannemers.'],
  ['Nazorg', 'Ook daarna kunt u op ons rekenen, bijvoorbeeld voor de jaarlijkse onderhoudsbeurt.'],
];
const titel = 'Home-haarden | Haarden en kachels in Alblasserdam';
const omschrijving = 'Home-haarden in Alblasserdam: gashaarden, houtkachels en elektrische haarden. Advies, levering en installatie met ons eigen team, plus maatwerk. Showroom op afspraak.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- HERO: eigen foto, vuur achter glas -->
    <section class="donker relative isolate flex min-h-[40rem] items-end overflow-hidden bg-antraciet text-licht md:min-h-[calc(100svh-7.25rem)] md:max-h-[58rem]">
      <Image src={hero} alt="Een gashaard met houtblokken achter glas, met een okergele stoel op de voorgrond" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_45%] max-md:object-[74%_45%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#1c1b1af2_0%,#1c1b1ac4_34%,#1c1b1a14_62%)] max-md:bg-[linear-gradient(0deg,#1c1b1af5_0%,#1c1b1ac0_58%,#1c1b1a40_100%)]" aria-hidden="true"></div>
      <div class="wrap grid items-end gap-10 pb-14 pt-28 md:pb-20 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <h1 class="max-w-[12ch] text-hero">Warmte met <em class="text-gloed">sfeer</em>, bij u thuis.</h1>
          <p class="mt-7 max-w-xl text-lg text-licht/90 md:text-xl">Gashaarden, houtkachels en elektrische haarden. Wij adviseren, leveren en installeren alle merken, met ons eigen vakkundige team.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={waAfspraak} class="knop knop-sintel"><Icoon naam="wa" />Plan een showroomafspraak</a>
            <a href="#keuzehulp" class="link font-semibold">Welke haard past bij u?</a>
          </div>
        </div>
        <ul class="space-y-2 text-[.9375rem] text-licht/85 lg:col-span-4 lg:justify-self-end lg:text-right">
          <li>Erkend bedrijf, Stichting EVIS</li>
          <li>Eigen installateurs, één aanspreekpunt</li>
          <li><a href={site.telHref} class="num font-kop text-[1.75rem] leading-none text-licht no-underline hover:text-gloed">{site.tel}</a></li>
        </ul>
      </div>
    </section>

    <!-- ALLES IN 1 HAND: de haardopening + aanbod als lijst -->
    <section id="aanbod" class="py-20 md:py-28">
      <div class="wrap grid items-start gap-x-12 gap-y-16 lg:grid-cols-12">
        <div class="rijs lg:col-span-6 lg:pt-3">
          <div class="boezem">
            <div class="opening aspect-[16/9]">
              <Image src={vuur} alt="Close-up van een gashaard met brandende houtblokken" widths={[640, 960, 1200]} sizes="(min-width: 1024px) 40vw, 92vw" class="h-full w-full object-cover object-[50%_55%]" />
            </div>
            <div class="plateau" aria-hidden="true"></div>
          </div>
          <p class="mt-6 max-w-sm text-sm text-grijs">Ook de boezem, het plateau of de complete haardenwand maken we op maat.</p>
        </div>
        <div class="lg:col-span-6">
          <h2 class="rijs text-3xl">Alles in <em class="text-sintel">1 hand.</em></h2>
          <p class="rijs mt-7 max-w-lg text-lg text-grijs">Van het eerste advies tot de installatie heeft u één aanspreekpunt. We werken onafhankelijk van fabrikanten.</p>
          <ul class="mt-10 border-t border-lijn">
            {aanbod.map(([wat, uitleg], i) => (
              <li class="rijs flex items-baseline gap-4 border-b border-lijn py-4" style={`--d:${i * 0.05}s`}>
                <span class="font-kop text-xl md:text-[1.75rem]">{wat}</span>
                <span class="stip hidden sm:block" aria-hidden="true"></span>
                <span class="ml-auto text-right text-[.9375rem] text-grijs sm:ml-0">{uitleg}</span>
              </li>
            ))}
          </ul>
          <p class="rijs mt-8 text-[.9375rem] text-grijs">Meer dan 10 jaar ervaring. Ons advies is gratis.</p>
        </div>
      </div>
    </section>

    <!-- MERKEN: onafhankelijk -->
    <section class="border-y border-lijn bg-wit py-14 md:py-16" aria-labelledby="merken-kop">
      <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-3">
          <h2 id="merken-kop" class="text-2xl">Onafhankelijk van fabrikanten.</h2>
          <p class="mt-3 text-sm text-grijs">Een greep uit de merken in ons aanbod.</p>
        </div>
        <p class="rijs font-kop text-[clamp(1.5rem,1.6vw+1rem,2.25rem)] leading-[1.35] text-inkt lg:col-span-9">
          {merken.map((m, i) => <span class="whitespace-nowrap">{m}{i < merken.length - 1 && <span class="mx-3 inline-block text-sintel" aria-hidden="true">/</span>}</span>)}{" "}
        </p>
      </div>
    </section>

    <!-- MAATWERK: donker, eigen projecten -->
    <section id="maatwerk" class="donker bg-antraciet py-24 text-licht md:py-32">
      <div class="wrap">
        <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-10">
          <h2 class="rijs text-3xl lg:col-span-6">Een haardenwand, <em class="text-gloed">op maat</em> gemaakt.</h2>
          <div class="lg:col-span-5 lg:col-start-8 lg:pt-3">
            <p class="rijs text-lg text-licht-zacht">Een van onze installateurs heeft voor meubelmaker geleerd. Daardoor maken we ook de haardenwand, het meubel of de verlichting achter de boezem. Een kleine verbouwing rond uw haard hoort er gewoon bij.</p>
            <a href={waMet('Goedendag Home-haarden, ik heb een idee voor een haardenwand op maat. Kunnen we dat bespreken?')} class="rijs link mt-6 inline-block font-semibold">Bespreek uw idee via WhatsApp</a>
          </div>
        </div>

        <div class="mt-14 grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-12">
          <figure class="rijs col-span-2 flex flex-col lg:col-span-7 lg:row-span-2">
            <Image src={pMaestro80} alt="Hoekhaard in een witte boezem met een eiken bank en houtopslag eronder" widths={[640, 960, 1300]} sizes="(min-width: 1024px) 55vw, 100vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_45%] lg:aspect-auto lg:min-h-0 lg:flex-1" />
            <figcaption class="mt-3 text-sm text-licht-zacht">Dru Maestro 80/3 met maatwerk meubel</figcaption>
          </figure>
          <figure class="rijs lg:col-span-5" style="--d:.08s">
            <Image src={pMaestro75} alt="Witte roomdivider met een driezijdige gashaard op een hardstenen plateau" widths={[400, 640]} sizes="(min-width: 1024px) 30vw, 50vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
            <figcaption class="mt-3 text-sm text-licht-zacht">Dru Maestro 75 XTU roomdivider met hardstenen plateau</figcaption>
          </figure>
          <figure class="rijs lg:col-span-5" style="--d:.16s">
            <Image src={pMetro100} alt="Gestucte haardenwand met een tv-nis boven een brede gashaard" widths={[400, 640]} sizes="(min-width: 1024px) 30vw, 50vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_60%]" />
            <figcaption class="mt-3 text-sm text-licht-zacht">Dru Metro 100XT met tv-nis</figcaption>
          </figure>
          <figure class="rijs lg:col-span-4" style="--d:.08s">
            <Image src={pTrisore} alt="Witte boezem met een lange gashaard op een zwart plateau" widths={[400]} sizes="(min-width: 1024px) 25vw, 50vw" class="aspect-[4/3] w-full rounded-sm object-cover object-[50%_72%]" />
            <figcaption class="mt-3 text-sm text-licht-zacht">Element4 Trisore 140</figcaption>
          </figure>
          <figure class="rijs lg:col-span-4" style="--d:.16s">
            <Image src={pMetro150} alt="Een tunnelhaard in een nieuwe, nog ongeschilderde wand met tv-nis" widths={[400, 640]} sizes="(min-width: 1024px) 25vw, 50vw" class="aspect-[4/3] w-full rounded-sm object-cover" />
            <figcaption class="mt-3 text-sm text-licht-zacht">Dru Metro 150 Tunnel, in aanbouw</figcaption>
          </figure>
          <div class="rijs col-span-2 flex flex-col justify-between gap-8 rounded-sm border border-lijn-licht p-6 sm:p-8 lg:col-span-4" style="--d:.24s">
            <Vlam class="h-7 w-7 text-gloed" />
            <p class="font-kop text-[clamp(1.6rem,1.4vw+1rem,2.25rem)] leading-[1.1]">Haard, schouw en meubel, van één team.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WOW: keuzehulp als invulzin -->
    <section id="keuzehulp" class="py-20 md:py-24">
      <div class="wrap grid items-start gap-y-12 lg:grid-cols-12 lg:gap-x-10">
        <div class="min-w-0 lg:col-span-4">
          <h2 class="rijs text-3xl">Welke haard past <em class="text-sintel">bij u?</em></h2>
          <p class="rijs mt-7 max-w-sm text-lg text-grijs">Maak de zin af. U ziet meteen waar u op let, en uw vraag staat klaar voor een afspraak.</p>
        </div>

        <form class="rijs min-w-0 lg:col-span-8" data-hulp aria-label="Keuzehulp: welke haard past bij u">
          <p class="font-kop text-[clamp(1.75rem,2.2vw+1rem,3.25rem)] leading-[1.45]">
            Ik denk aan een
            <label class="inline"><span class="sr-only">Soort haard</span>
              <select name="soort" class="veld">
                <option value="gas">gashaard</option>
                <option value="hout">houtkachel</option>
                <option value="elek">elektrische haard</option>
                <option value="weet">haard, nog geen idee welke</option>
              </select></label>.
            In mijn huis is
            <label class="inline"><span class="sr-only">Rookkanaal</span>
              <select name="kanaal" class="veld">
                <option value="wel">wel een</option>
                <option value="geen">geen</option>
                <option value="weet">misschien een</option>
              </select></label>
            rookkanaal, en ik zie het vuur graag
            <label class="inline"><span class="sr-only">Vuurzicht</span>
              <select name="zicht" class="veld">
                <option value="aan de voorkant">aan de voorkant</option>
                <option value="aan twee kanten">aan twee kanten</option>
                <option value="aan drie kanten">aan drie kanten</option>
                <option value="dwars door de kamer">dwars door de kamer</option>
              </select></label>.
            Advies graag
            <label class="inline"><span class="sr-only">Waar</span>
              <select name="waar" class="veld">
                <option value="in de showroom">in de showroom</option>
                <option value="bij mij thuis">bij mij thuis</option>
              </select></label>.
          </p>

          <div class="mt-12 grid gap-8 border-t border-lijn pt-8 md:grid-cols-[1fr_auto] md:items-end">
            <div aria-live="polite">
              <p class="font-semibold" data-kop>Goed om te weten</p>
              <p class="mt-2 max-w-xl text-grijs" data-uitleg>Gashaarden hebben we als inbouw, vrijstaand, hangend en buitenhaard.</p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
              <a href={waAfspraak} class="knop knop-sintel" data-stuur><Icoon naam="wa" />Vraag een afspraak aan</a>
              <a href={site.telHref} class="knop knop-wit shadow-sm"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
            </div>
          </div>
          <p class="mt-6 text-xs text-grijs">De knop opent WhatsApp met uw zin als bericht. Er wordt pas iets verstuurd als u zelf op verzenden drukt.</p>
        </form>
      </div>
    </section>

    <!-- WERKWIJZE: eigen team, verticale lijst naast hun bussen -->
    <section id="werkwijze" class="bg-wit py-20 md:py-28">
      <div class="wrap grid items-start gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs relative lg:sticky lg:top-32 lg:col-span-5">
          <Image src={bussen} alt="Twee antraciet bedrijfsbussen van Home-haarden met logo en webadres" widths={[640, 960, 1200]} sizes="(min-width: 1024px) 38vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[62%_50%] max-lg:aspect-[4/3]" />
          <figcaption class="mt-4 text-sm text-grijs">Onze eigen bussen. Wij werken niet met onderaannemers.</figcaption>
        </figure>
        <div class="lg:col-span-6 lg:col-start-7">
          <h2 class="rijs text-3xl">Van advies <em class="text-sintel">tot nazorg.</em></h2>
          <ol class="mt-12 border-t border-lijn">
            {stappen.map(([t, uitleg], i) => (
              <li class="rijs grid grid-cols-[3.5rem_1fr] gap-x-5 border-b border-lijn py-6 sm:grid-cols-[5rem_1fr]" style={`--d:${i * 0.06}s`}>
                <span class="num font-kop text-[2.75rem] leading-none text-sintel sm:text-[3.5rem]" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3 class="text-2xl">{t}</h3>
                  <p class="mt-2 max-w-md text-grijs">{uitleg}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- KLANTERVARINGEN: letterlijk van hun site -->
    <section id="ervaringen" class="py-20 md:py-24">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs max-w-2xl text-3xl">Klant&shy;ervaringen</h2>
          <p class="rijs text-sm text-grijs">Letterlijk overgenomen van home-haarden.nl</p>
        </div>
        <div class="mt-10 grid gap-x-10 gap-y-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <figure class="rijs">
              <blockquote class="font-kop text-[clamp(1.875rem,2.4vw+1rem,3rem)] leading-[1.12]">“{ervaringen[0].tekst}”</blockquote>
              <figcaption class="mt-6 text-sm text-grijs"><b class="font-semibold text-inkt">{ervaringen[0].naam}</b> · {ervaringen[0].plaats}</figcaption>
            </figure>
            <figure class="rijs mt-12 border-t border-lijn pt-8">
              <blockquote class="font-kop text-2xl leading-tight">“{ervaringen[3].tekst}”</blockquote>
              <figcaption class="mt-3 text-sm text-grijs"><b class="font-semibold text-inkt">{ervaringen[3].naam}</b> · {ervaringen[3].plaats}</figcaption>
            </figure>
          </div>
          <div class="grid content-start gap-8 lg:col-span-4 lg:col-start-9 lg:border-l lg:border-lijn lg:pl-10">
            {ervaringen.slice(1, 3).map((r, i) => (
              <figure class="rijs" style={`--d:${0.1 + i * 0.1}s`}>
                <blockquote class="text-lg leading-snug">“{r.tekst}”</blockquote>
                <figcaption class="mt-3 text-sm text-grijs"><b class="font-semibold text-inkt">{r.naam}</b>{r.plaats && ` · ${r.plaats}`}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- SHOWROOM + CONTACT -->
    <section id="showroom" class="donker bg-antraciet text-licht">
      <div class="grid lg:grid-cols-2">
        <div class="relative min-h-[24rem] lg:min-h-full">
          <Image src={wand} alt="Showroom van Home-haarden: een wand met drie brandende kachels, een eettafel op de voorgrond" widths={[640, 960, 1440]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[40%_22%]" />
        </div>
        <div class="px-5 py-20 sm:px-10 md:py-28 lg:px-16 xl:px-20">
          <h2 class="rijs max-w-[14ch] text-3xl">Laat u op afspraak verwelkomen in onze <em class="text-gloed">showroom.</em></h2>
          <p class="rijs mt-7 max-w-md text-lg text-licht-zacht">In onze showroom zijn talloze haarden te bezichtigen en maatwerk meubels. Bel of app voor een afspraak.</p>
          <div class="mt-10 grid gap-10 sm:grid-cols-2">
            <address class="rijs not-italic">
              <p class="text-sm text-licht-zacht">Adres</p>
              <p class="mt-1 text-lg font-semibold">{site.straat}</p>
              <p class="text-licht-zacht">{site.postcode} {site.plaats}</p>
              <p class="mt-4 text-sm"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
              <p class="mt-1 text-sm text-licht-zacht">Vast: <a href={site.vastHref} class="num whitespace-nowrap no-underline hover:text-gloed">{site.vast}</a></p>
            </address>
            <div class="rijs">
              <p class="text-sm text-licht-zacht">Telefonisch bereikbaar</p>
              <table class="mt-2 w-full max-w-[17rem] text-[.9375rem]">
                <caption class="sr-only">Telefonisch bereikbaar</caption>
                <tbody>
                  {tijden.map((t) => (
                    <tr data-dag={t.dag} class="border-b border-lijn-licht data-[vandaag]:font-semibold data-[vandaag]:text-gloed">
                      <th scope="row" class="py-1.5 text-left font-[inherit]">{t.naam}</th>
                      <td class="num py-1.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <p class="rijs mt-8 inline-flex items-center gap-2.5 rounded-full bg-antraciet-2 px-4 py-2 text-sm font-semibold" data-status-wrap>
            <span class="stip-open h-2.5 w-2.5 rounded-full bg-licht-zacht" aria-hidden="true"></span>
            <span data-status>Telefonisch bereikbaar ma t/m vr 08.00-17.00, za 09.00-16.00</span>
          </p>
          <div class="rijs mt-10 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-sintel knop-klein"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href={site.telHref} class="knop knop-lijn knop-klein"><Icoon naam="tel" /><span class="num">{site.tel}</span></a>
            <a href={site.maps} class="knop knop-lijn knop-klein"><Icoon naam="pin" />Route</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SLOTBAND -->
    <section class="relative overflow-hidden bg-sintel text-wit">
      <Vlam class="pointer-events-none absolute -right-8 -top-10 h-72 w-72 text-[#ffffff14] max-sm:hidden" />
      <div class="wrap flex flex-wrap items-center justify-between gap-8 py-14 md:py-16">
        <p class="max-w-2xl font-kop text-[clamp(1.875rem,2.4vw+1rem,3.25rem)] leading-[1.04]">Warmte met sfeer begint met <em>een goed gesprek.</em></p>
        <a href={waAfspraak} class="knop knop-wit"><Icoon naam="wa" />Plan uw bezoek</a>
      </div>
    </section>
  </main>
  <Voet />

  <style>
    [data-open='true'] .stip-open { background: #5fd39a; box-shadow: 0 0 0 4px #5fd39a33; }
  </style>

  <script>
    import { waMet } from '../data/site';
    const f = document.querySelector<HTMLFormElement>('[data-hulp]');
    if (f) {
      const kop = f.querySelector<HTMLElement>('[data-kop]')!;
      const uitleg = f.querySelector<HTMLElement>('[data-uitleg]')!;
      const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
      const naam: Record<string, string> = { gas: 'een gashaard', hout: 'een houtkachel', elek: 'een elektrische haard', weet: 'een haard, maar ik weet nog niet welke' };
      const kanaalTekst: Record<string, string> = { wel: 'is wel een rookkanaal', geen: 'is geen rookkanaal', weet: 'is misschien een rookkanaal' };
      const maak = () => {
        const d = new FormData(f);
        const soort = String(d.get('soort')), kanaal = String(d.get('kanaal')), zicht = String(d.get('zicht')), waar = String(d.get('waar'));
        let k = 'Goed om te weten', u = '';
        if (soort === 'gas') u = kanaal === 'wel' ? 'Gashaarden hebben we als inbouw, vrijstaand, hangend en buitenhaard.' : 'Gashaarden hebben we als inbouw, vrijstaand, hangend en buitenhaard. Voor de afvoer kijken we samen wat in uw woning kan.';
        if (soort === 'hout') {
          if (kanaal === 'wel') u = 'Houtkachels hebben we vrijstaand, als inbouwhaard en als inzethaard. In ons aanbod zijn er ruim 230.';
          else { k = 'Even samen kijken'; u = 'Een houtkachel heeft een rookkanaal nodig. Is een kleine verbouwing nodig, dan denken we graag mee.'; }
        }
        if (soort === 'elek') u = 'Een elektrische haard heeft geen rookkanaal nodig. We hebben ze als inbouw en hangend model.';
        if (soort === 'weet') { k = 'Daar is het gesprek voor'; u = 'Vertel ons over uw woning en uw wensen. We laten u de verschillen zien, in de showroom of bij u thuis.'; }
        kop.textContent = k; uitleg.textContent = u;
        const t = `Goedendag Home-haarden, ik denk aan ${naam[soort]}. In mijn huis ${kanaalTekst[kanaal]}, en ik zie het vuur graag ${zicht}. Ik wil graag advies ${waar}. Wanneer kan dat?`;
        stuur.href = waMet(t);
      };
      f.addEventListener('change', maak); f.addEventListener('submit', (e) => e.preventDefault());
      maak();
    }
  </script>
