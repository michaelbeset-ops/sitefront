---
import Vlam from './Vlam.astro';
import { url } from '../data/site';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
---
<a href={url('')} class:list={['merk', licht && 'licht text-licht']}>
  <span class:list={['merk-teken', licht ? 'text-gloed' : 'text-sintel']}><Vlam class="h-5 w-5" /></span>
  <span><b>Home-<i>haarden</i></b><small>Kachels · haarden · maatwerk</small></span>
</a>
