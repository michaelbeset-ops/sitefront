---
import { site, url, tijden, waKlus } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const werk = ['Overkappingen en pergola’s', 'Dakopbouw en uitbouw', 'Verbouwen en renoveren', 'Badkamers en tegelwerk', 'Vloeren', 'Trappen, deuren en kasten'];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 text-licht lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-licht-zacht">Zelfstandig timmerman uit {site.plaats}. Timmerwerk, verbouwingen en maatwerk in de {site.regio}.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 text-licht transition-colors hover:bg-groen" aria-label="Facebook"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1Z"/></svg></a>
        <a href={site.reviews} class="grid h-10 w-10 place-items-center rounded-md bg-nacht-2 transition-colors hover:bg-groen" aria-label="Google-bedrijfsprofiel"><Icoon naam="g" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-kop font-bold text-licht">Werk</p>
      <ul class="mt-4 space-y-2">
        {werk.map((c) => <li><a href={h('werk')} class="no-underline transition-colors hover:text-mos">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-kop font-bold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-mos">{site.tel}</a></li>
        <li><a href={waKlus} class="no-underline transition-colors hover:text-mos">WhatsApp</a></li>
        <li><a href={site.facebook} class="no-underline transition-colors hover:text-mos">Facebook</a></li>
        <li>{site.plaats}<br />{site.regio}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-kop font-bold text-licht">Bereikbaar</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Wanneer u Maarten kunt bereiken</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-mos">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-mos">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw Facebook-pagina en Google-bedrijfsprofiel, ter illustratie. Reviews letterlijk van Google (stand 3 oktober 2026).</p>}
  </div>
</footer>
