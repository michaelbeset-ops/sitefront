  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: #3fbf7f; box-shadow: 0 0 0 4px #3fbf7f33; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: var(--radius-sm); background: var(--color-zaagsel); }
  /* Maatstreepjes onder elke stap, als een duimstok. */
  .stap-lijn { background: repeating-linear-gradient(90deg, var(--color-mos) 0 1px, transparent 1px 12px) top left / 100% 7px no-repeat; border-top: 1px solid #a9d4bd66; }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 .95rem; border-radius: var(--radius-sm); background: var(--color-zaagsel); font-size: .9375rem; font-weight: 500; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #ddd8cb; }
  .keuze input:checked + span { background: var(--color-groen); color: #fff; }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-groen); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-md); border: 1.5px solid #151b1833; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #151b1866; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-groen); }
