---
// Woordmerk naar hun eigen logo (raam, stoepbord en Canva-pagina): "FLINN" in dunne, ruim gespatieerde kapitalen
// met een streep eronder. Nagetekend, geen origineel bestand.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class="sr-only">Flinn Winkelcafé, naar de homepage</span>
  <span aria-hidden="true" class="block pl-[.5em] text-[1.6rem] font-light leading-none tracking-[.5em] sm:text-[1.75rem]">FLINN</span>
  <span aria-hidden="true" class={`mt-1.5 block border-t pt-1.5 text-center text-[.6rem] font-bold uppercase tracking-[.38em] ${donker ? 'border-inkt/40 text-steen' : 'border-wit/60 text-wit/80'}`}>Winkelcafé</span>
</a>
