---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi, waMet } from '../data/site';

// Beeld: foto's van de loods en het bord van hun Google-profiel, kleurstalen van tapijt-tegels.eu,
// twee sfeerfoto's van Unsplash (ter illustratie). Zie src/assets/BRONNEN.txt.
import hero from '../assets/hero.jpg';
import loods2 from '../assets/loods-2.jpg';
import loodsDeur from '../assets/loods-deur.jpg';
import loodsRek from '../assets/loods-rek.jpg';
import bord from '../assets/bord.jpg';
import close from '../assets/tegels-close.jpg';
import uKantoor from '../assets/u-kantoor.jpg';
import uVloer from '../assets/u-tegelvloer.jpg';
import stGroen from '../assets/st-groen.jpg';
import stBeige from '../assets/st-beige.jpg';
import stGrijsVilt from '../assets/st-grijs-vilt.jpg';
import stGrijsDonker from '../assets/st-grijs-donkergrijs.jpg';
import stPaars from '../assets/st-paars.jpg';
import stBlauwGroen from '../assets/st-blauw-groen.jpg';
import stGrijsStreep from '../assets/st-grijs-streep.jpg';
import stBeige2 from '../assets/st-beige-2.jpg';
import stZwartGrijs from '../assets/st-zwart-grijs-streep.jpg';
import stRood from '../assets/st-rood.jpg';
import stAntraciet from '../assets/st-antraciet.jpg';
import stBeigeGeblokt from '../assets/st-beige-geblokt.jpg';

const vraag = (wat: string) => waMet(`Hallo Tapijt-tegels.eu, ik heb een vraag over ${wat}.`);
const sterren = [1, 2, 3, 4, 5];

// Aanbod: de twee soorten restanten van hun homepage, plus grotere partijen (hun voorraadlijst en reviews).
const aanbod = [
  { t: 'Gemengde restanten', d: 'Nieuwe of gebruikte tapijttegels, niet op kleur uit te zoeken. Door kleuren en motieven te combineren leg je er zelfs grotere oppervlakken mee.', src: loodsRek, alt: 'Stellingen en pallets met tapijttegels in alle kleuren in de loods', wa: 'gemengde restanten' },
  { t: 'Per kleur, 10 tot 20 m²', d: 'Restanten tussen 10 en 20 m² per kleur. Genoeg om een kleinere ruimte, zoals een slaapkamer, in één kleur te leggen.', src: close, alt: 'Tapijttegels in grijs en blauw naast elkaar op de vloer', wa: 'tegels in één kleur' },
  { t: 'Grotere partijen', d: 'Voor een kantoor of bedrijf. Vraag welke partijen er nu liggen. Op factuur kan ook.', src: loods2, alt: 'Pallets met grote stapels donkere en grijze tapijttegels in de loods', wa: 'een grotere partij' },
];

// Voordelen: letterlijk de alinea van hun homepage, opgesplitst.
const voordelen = [
  ['Los te leggen', 'Altijd los te leggen, zonder lijm.', 'los'],
  ['Weinig snijverlies', 'Nauwelijks snijverlies.', 'schaar'],
  ['Geen ondervloer', 'Geen ondervloer nodig door de isolerende bitumen rug.', 'lagen'],
  ['Mee te verhuizen', 'Makkelijk te verhuizen en aan te passen aan een nieuwe ruimte.', 'doos'],
  ['Per tegel te vervangen', 'Eenvoudig per tegel schoon te maken en eventueel te vervangen.', 'wissel'],
  ['Combineren', 'Kleuren en motieven op decoratieve wijze te combineren.', 'raster'],
];

// Waar klanten ze leggen: letterlijk uit Google-reviews.
const toepassingen = [
  ['Kantoor', '250m2 tapijttegels gekocht voor geluidsdemping in ons kantoor.', 'Lars v.'],
  ['Ondervloer', 'Tapijttegels zijn een goed alternatief voor een ondervloer en waren wij er goedkoper mee uit.', 'Romae W.'],
  ['Studentenkamer', 'Handig om snel voor een leuk prijsje goede tapijttegels te halen voor een studentenkamer', 'Marco M.'],
  ['Beursstand', 'zo goed als nieuwe partij tegels voor onze beursstand', 'Marc d.'],
  ['Filmset', 'Ik heb de perfecte vloer voor mijn filmset gevonden!', 'Cherie F.'],
  ['Escaperoom', 'we hebben tapijt tegels gekocht voor onze escaperoom', 'John S.'],
  ['Schuur of werkkamer', 'iets moois op de vloer van je schuur of werkkamer te leggen.', 'Ton d.'],
];

const stappen = [
  ['Stuur je wens', 'Hoeveel m², welke kleur en waarvoor. Via WhatsApp of telefoon.'],
  ['Maak een afspraak', 'De loods is alleen open op afspraak. Even bellen of appen vooraf.'],
  ['Uitzoeken in de loods', 'Rustig kijken en combineren, met advies over kleur en over het leggen.'],
  ['Meenemen', 'Hulp bij het inladen. Betalen met pin, op factuur kan ook.'],
];

// Kleurstalen: foto's van restpartijen op hun eigen site (Foto nr 01 tot 12).
const kleuren = [
  { id: 'Grijs / donkergrijs', src: stGrijsDonker },
  { id: 'Antraciet', src: stAntraciet },
  { id: 'Rood', src: stRood },
  { id: 'Beige', src: stBeige2 },
  { id: 'Blauw-groen', src: stBlauwGroen },
  { id: 'Paars', src: stPaars },
  { id: 'Groen', src: stGroen },
  { id: 'Grijs vilt', src: stGrijsVilt },
  { id: 'Grijs streep', src: stGrijsStreep },
  { id: 'Zwart-grijs streep', src: stZwartGrijs },
  { id: 'Beige geblokt', src: stBeigeGeblokt },
  { id: 'Lichtbeige', src: stBeige },
];
const stalen = Object.fromEntries(await Promise.all(kleuren.map(async (k) => [k.id, (await getImage({ src: k.src, width: 160, quality: 72 })).src])));
const patronen = ['Dambord', 'Strepen', 'Gemengd'];
const ruimtes = ['Thuis', 'Kantoor of bedrijf', 'Ondervloer', 'Iets anders'];
---
<Base title="Tapijt-tegels.eu | Restpartijen tapijttegels in Tilburg, altijd 20.000 m² op voorraad" description="Tapijt-tegels.eu in Tilburg: restpartijen nieuwe en gebruikte tapijttegels van 50x50 cm. Altijd 20.000 m² op voorraad. Open op afspraak, Spinderspad 54.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: hun eigen foto van de loods vol tapijttegels -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={hero} alt="" widths={[640, 960, 1400, 1800]} sizes="100vw" loading="eager" fetchpriority="high" quality={64} class="absolute inset-0 -z-20 h-full w-full object-cover object-[45%_60%] md:object-[50%_62%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#171a2ecc_0%,#171a2e66_26%,#171a2ed9_58%,#171a2efa_100%)] md:bg-[linear-gradient(90deg,#171a2ef5_0%,#171a2ed1_38%,#171a2e40_70%,#171a2e14_100%),linear-gradient(180deg,#171a2ebf_0%,#171a2e00_30%,#171a2e00_70%,#171a2ecc_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-24 pt-36 md:pb-20 lg:pt-48">
        <div class="max-w-3xl">
          <p class="eyebrow eyebrow-licht">Tapijttegels in {site.plaats}</p>
          <h1 id="inhoud" class="mt-6 text-hero">Een loods vol <span class="text-merk-licht">tapijt&shy;tegels.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-wit/90 md:text-[1.3rem]">Altijd 20.000 m² aan restpartijen op voorraad. Nieuw of gebruikt, 50x50 cm, in vele kleuren en motieven.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#samenstellen" class="knop knop-merk">Vloer samenstellen<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.95rem] text-wit/90">
            <li class="flex items-center gap-2"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-wit">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-merk-licht" />Open op afspraak</li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-7 right-10 hidden text-xs text-wit/60 lg:block">De loods aan het Spinderspad</p>
    </section>
  </div>

  <main>
    <!-- 2. Cijfers: alleen echte cijfers -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-x-6 gap-y-9 py-11 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-steen">aan restpartijen, altijd op voorraad</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-extrabold leading-none tracking-[-.045em]">20.000 m²</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">per tegel, dus 4 tegels per m²</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-extrabold leading-none tracking-[-.045em]">50x50 cm</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">op Google, uit {site.google.aantal} reviews</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-extrabold leading-none tracking-[-.045em] text-merk">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">lijm nodig: altijd los te leggen</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-extrabold leading-none tracking-[-.045em]">0</dd></div>
      </dl>
    </section>

    <!-- 3. Aanbod: fotokaarten met hun eigen foto's -->
    <section id="aanbod" class="py-20 md:py-28" aria-labelledby="t-aanbod">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Aanbod</p>
            <h2 id="t-aanbod" class="mt-5 text-4xl">Restpartijen, nieuw en gebruikt.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Alle tegels zijn 50x50 cm. Vele kleuren en motieven, en regelmatig voldoende m² op voorraad.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-16 lg:gap-6">
          {aanbod.map((c, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden transition-shadow duration-300 hover:shadow-[0_12px_32px_#171a2e17]">
                <div class="overflow-hidden">
                  <Image src={c.src} alt={c.alt} widths={[420, 640, 820]} sizes="(min-width: 768px) 32vw, 100vw" quality={68} class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-[1.7rem]">{c.t}</h3>
                  <p class="mt-3 text-steen">{c.d}</p>
                  <a href={vraag(c.wa)} class="mt-auto inline-flex items-center gap-2 pt-6 font-bold text-merk no-underline transition-colors hover:text-merk-diep">Vraag wat er ligt<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. De loods: donker, eigen foto + wat klanten steeds noemen -->
    <section class="relative overflow-hidden bg-inkt py-20 text-wit md:py-28" aria-labelledby="t-loods">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <Image src={loodsDeur} alt="Zicht door de loods met stellingen en pallets tapijttegels naar de open roldeur" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 46vw, 100vw" quality={66} class="aspect-[4/3] w-full rounded-[4px] object-cover object-[50%_40%] lg:aspect-[4/5]" />
          <figcaption class="mt-4 text-sm text-mist">De loods aan het Spinderspad, op het terrein van IVRO.</figcaption>
        </figure>
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">De loods</p>
          <h2 id="t-loods" class="rijs mt-5 text-4xl">Kom kijken, kies en neem mee.</h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-wit/90" style="--d:.06s">Stapels tapijttegels op pallets en in stellingen. Je ziet de tegels in het echt voordat je ze meeneemt.</p>
          <ul class="mt-10 grid gap-4 sm:grid-cols-3">
            {[
              ['Eerlijk advies', 'Mr dacht goed mee en gaf een eerlijk advies.', 'Annemarie v.'],
              ['Uitleg bij het leggen', 'hij geeft je uit leg over het leggen', 'Jessy H.'],
              ['Koffie klaar', 'Zelfs de koffie stond klaar. Top service!', 'Monique O.'],
            ].map(([t, q, n], i) => (
              <li class="rijs rounded-[4px] border border-lijn bg-inkt-2 p-5" style={`--d:${0.1 + i * 0.05}s`}>
                <p class="font-kop text-lg font-extrabold tracking-[-.02em]">{t}</p>
                <p class="mt-2 text-[.95rem] leading-relaxed text-mist">“{q}”</p>
                <p class="mt-3 text-xs text-mist/80">{n}, Google</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 5. Voordelen: hun eigen alinea, met een sfeerfoto -->
    <section id="voordelen" class="bg-wit py-20 md:py-28" aria-labelledby="t-voordelen">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <p class="rijs eyebrow">Voordelen</p>
          <h2 id="t-voordelen" class="rijs mt-5 text-4xl">Waarom tapijt&shy;tegels?</h2>
          <figure class="rijs mt-10" style="--d:.06s">
            <Image src={uVloer} alt="Kantoor met een vloer van grijze tapijttegels" widths={[500, 800, 1100]} sizes="(min-width: 1024px) 38vw, 100vw" quality={66} class="aspect-[4/3] w-full rounded-[4px] object-cover" />
            <figcaption class="mt-3 text-sm text-steen">Sfeerfoto ter illustratie.</figcaption>
          </figure>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:self-center">
          {voordelen.map(([t, d, ic], i) => (
            <li class="rijs kaart flex gap-4 p-6" style={`--d:${(i % 2) * 0.05}s`}>
              <span class="grid h-11 w-11 flex-none place-items-center rounded-[4px] bg-beton text-merk"><Icoon naam={ic} class="h-6 w-6" /></span>
              <div>
                <h3 class="text-xl">{t}</h3>
                <p class="mt-1.5 text-steen">{d}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Waar klanten ze leggen: letterlijk uit reviews -->
    <section id="toepassingen" class="py-20 md:py-28" aria-labelledby="t-toep">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Toepassingen</p>
            <h2 id="t-toep" class="mt-5 text-4xl">Van kantoor tot filmset.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Waar klanten hun tegels voor gebruiken, in hun eigen woorden uit de Google-reviews.</p>
        </div>
        <div class="mt-12 grid gap-5 lg:mt-16 lg:grid-cols-12 lg:gap-6">
          <figure class="rijs relative overflow-hidden rounded-[4px] lg:col-span-5">
            <Image src={uKantoor} alt="Kantoorruimte met een vloer van grijze tapijttegels en glazen wanden" widths={[500, 800, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" quality={66} class="aspect-[4/3] h-full w-full object-cover lg:aspect-auto" />
            <figcaption class="absolute bottom-3 left-3 rounded-[4px] bg-inkt/80 px-2 py-1 text-xs font-medium text-wit">Sfeerfoto ter illustratie</figcaption>
          </figure>
          <ul class="kaart divide-y divide-lijn-licht lg:col-span-7">
            {toepassingen.map(([t, q, n]) => (
              <li class="rijs grid gap-x-6 gap-y-1 px-6 py-5 sm:grid-cols-12 sm:items-baseline sm:px-7">
                <p class="font-kop text-lg font-extrabold tracking-[-.02em] sm:col-span-4">{t}</p>
                <p class="text-steen sm:col-span-8">“{q}” <span class="whitespace-nowrap text-sm">{n}</span></p>
              </li>
            ))}
          </ul>
        </div>
        <div class="rijs mt-6 flex flex-col items-start justify-between gap-5 rounded-[4px] bg-inkt px-7 py-7 text-wit sm:flex-row sm:items-center md:px-9">
          <p class="text-xl"><b class="font-kop font-extrabold tracking-[-.02em]">Zakelijk?</b> <span class="text-mist">Stuur de m² en de ruimte, dan hoor je welke partijen passen.</span></p>
          <a href={vraag('tapijttegels voor ons bedrijf')} class="knop knop-merk shrink-0"><Icoon naam="wa" />Partij aanvragen</a>
        </div>
      </div>
    </section>

    <!-- 7. Werkwijze -->
    <section class="border-y border-lijn-licht bg-wit py-20 md:py-28" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="rijs max-w-2xl">
          <p class="eyebrow">Zo werkt het</p>
          <h2 id="t-werk" class="mt-5 text-4xl">In vier stappen een nieuwe vloer.</h2>
        </div>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
          {stappen.map(([t, d], i) => (
            <li class="rijs flex flex-col border-t-2 border-inkt pt-7" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-6 text-2xl">{t}</h3>
              <p class="mt-3 text-steen">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8. Wow: stel je vloer samen met hun eigen kleurstalen, aanvraag eindigt in WhatsApp -->
    <section id="samenstellen" class="bg-inkt py-20 text-wit md:py-28" aria-labelledby="t-samen">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow eyebrow-licht">Vloer samenstellen</p>
            <h2 id="t-samen" class="mt-5 text-4xl">Combineer je eigen vloer.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-mist lg:col-span-5 lg:col-start-8 lg:self-end" style="--d:.1s">Kies één of twee kleuren en een patroon, vul de m² in en zie hoeveel tegels je nodig hebt. Je aanvraag staat daarna klaar in WhatsApp.</p>
        </div>

        <form class="mt-12 grid gap-x-12 gap-y-12 md:mt-16 lg:grid-cols-12" data-samen data-stalen={JSON.stringify(stalen)}>
          <div class="space-y-9 lg:col-span-7">
            <fieldset>
              <legend class="veld-label">Kies één of twee kleuren <span class="text-mist/70">(stalen van eerdere partijen)</span></legend>
              <div class="grid grid-cols-4 gap-x-3 gap-y-5 sm:grid-cols-6 sm:gap-x-4">
                {kleuren.map((k, i) => (
                  <label class={`staal ${i === 1 || i === 2 ? 'gekozen' : ''}`} data-kleur={k.id}>
                    <input type="checkbox" name="kleur" value={k.id} checked={i === 1 || i === 2} />
                    <Image src={k.src} alt="" width={120} height={120} quality={70} />
                    <b class="merkje" aria-hidden="true"></b>
                    <span>{k.id}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="grid gap-7 sm:grid-cols-2">
              <fieldset>
                <legend class="veld-label">Patroon</legend>
                <div class="flex flex-wrap gap-2.5">
                  {patronen.map((p, i) => <label class="keuze"><input type="radio" name="patroon" value={p} checked={i === 0} />{p}</label>)}
                </div>
              </fieldset>
              <div>
                <label for="m2" class="veld-label">Aantal m²</label>
                <input id="m2" name="m2" class="veld num" inputmode="decimal" placeholder="bv. 20" value="20" />
              </div>
            </div>
            <fieldset>
              <legend class="veld-label">Waarvoor?</legend>
              <div class="flex flex-wrap gap-2.5">
                {ruimtes.map((r, i) => <label class="keuze"><input type="radio" name="ruimte" value={r} checked={i === 0} />{r}</label>)}
              </div>
            </fieldset>
            <fieldset>
              <legend class="veld-label">Komen kijken?</legend>
              <div class="flex flex-wrap gap-2.5">
                {['Afspraak maken', 'Eerst foto\'s ontvangen', 'Nog niet'].map((r, i) => <label class="keuze"><input type="radio" name="bezoek" value={r} checked={i === 0} />{r}</label>)}
              </div>
            </fieldset>
          </div>

          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-8">
              <div class="vloer" data-vloer role="img" aria-label="Proefvloer van 4 bij 4 meter in tegels van 50x50 cm"></div>
              <p class="mt-3 flex justify-between gap-4 text-xs text-mist"><span>Proefvloer 4 x 4 m, tegels 50x50 cm</span><span data-telling class="num"></span></p>
              <p class="veld-label mt-8">Jouw bericht</p>
              <p class="min-h-[7.5rem] whitespace-pre-line rounded-[4px] border-l-4 border-merk bg-inkt-2 px-5 py-4 text-[.98rem] leading-relaxed text-wit/90" data-voorbeeld aria-live="polite"></p>
              <a href={waHoi} class="knop knop-merk mt-5 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <p class="mt-3 text-center text-xs text-mist">De voorraad wisselt. Je hoort welke kleuren er nu liggen.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 9. Reviews -->
    <section id="reviews" class="py-20 md:py-28" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-9 w-9 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-extrabold leading-none">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-sm text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <figure class="kaart flex h-full flex-col p-7">
                <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
                <blockquote class="mt-5 flex-1 leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5 text-sm">
                  <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-beton-2 font-bold">{r.naam[0]}</span>
                  <span><b class="block font-bold">{r.naam}</b><span class="text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 10. Bezoek en contact: hun eigen foto van het bord -->
    <section id="bezoek" class="border-t border-lijn-licht bg-wit py-20 md:py-28" aria-labelledby="t-bezoek">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={bord} alt="Bord van Tapijt-tegels.eu met gekleurde tegels en een pijl, aan een bakstenen muur" widths={[420, 640, 900]} sizes="(min-width: 1024px) 38vw, 100vw" quality={70} class="aspect-[16/9] w-full rounded-[4px] object-cover" />
          <figcaption class="mt-3 text-sm text-steen">Volg het bord op het terrein van IVRO.</figcaption>
        </figure>
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Bezoek</p>
          <h2 id="t-bezoek" class="rijs mt-5 text-4xl">Op afspraak in Tilburg.</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-steen" style="--d:.04s">De loods is alleen open op afspraak. Bel of app even om een tijd af te spreken.</p>
          <p class="rijs mt-8"><a href={site.telHref} class="num font-kop text-[clamp(2.1rem,4.6vw,3.8rem)] font-extrabold leading-none tracking-[-.045em] text-inkt no-underline transition-colors hover:text-merk">{site.tel}</a></p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.08s">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" />Bellen</a>
          </div>
          <div class="rijs kaart mt-10 overflow-hidden" style="--d:.12s">
            <ul class="grid divide-y divide-lijn-licht sm:grid-cols-2 sm:divide-x sm:divide-y-0">
              <li class="flex gap-4 p-6"><Icoon naam="pin" class="mt-0.5 h-5 w-5 flex-none text-merk" /><div><p class="font-bold">{site.naam}</p><p class="mt-1 text-steen">{site.straat}<br />{site.postcode} {site.plaats}<br />{site.terrein}</p></div></li>
              <li class="flex gap-4 p-6"><Icoon naam="klok" class="mt-0.5 h-5 w-5 flex-none text-merk" /><div><p class="font-bold">Alleen op afspraak</p><p class="mt-1 text-steen">Bel of app vooraf.<br />Betalen met pin.</p></div></li>
            </ul>
            <a href={site.route} class="flex items-center justify-between gap-3 bg-inkt px-6 py-4 font-bold text-wit no-underline transition-colors hover:bg-merk">Route plannen<Icoon naam="pijl" class="h-5 w-5" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 11. Slotbalk -->
    <section class="bg-merk text-wit" aria-label="Vloer samenstellen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center md:py-14">
        <p class="font-kop text-3xl font-extrabold leading-none tracking-[-.04em]">Welke kleur wordt jouw vloer?</p>
        <a href="#samenstellen" class="knop knop-inkt shrink-0">Vloer samenstellen<Icoon naam="pijl" /></a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';

  const f = document.querySelector<HTMLFormElement>('[data-samen]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const vloer = document.querySelector<HTMLElement>('[data-vloer]');
  const telling = document.querySelector<HTMLElement>('[data-telling]');
  if (f && vb && knop && vloer) {
    const stalen = JSON.parse(f.dataset.stalen || '{}') as Record<string, string>;
    const N = 8; // 8 x 8 tegels van 50 cm = 4 x 4 m
    vloer.style.gridTemplateColumns = `repeat(${N}, 1fr)`;
    const cellen: HTMLElement[] = [];
    for (let i = 0; i < N * N; i++) { const c = document.createElement('i'); vloer.appendChild(c); cellen.push(c); }
    // vaste "willekeur" voor gemengd, zodat de vloer niet bij elke klik verspringt
    const mix = cellen.map((_, i) => ((i * 7919) % 13) / 13);
    let keuze: string[] = [...f.querySelectorAll<HTMLInputElement>('input[name=kleur]:checked')].map((i) => i.value);

    const labels = () => f.querySelectorAll<HTMLElement>('[data-kleur]').forEach((l) => {
      const n = keuze.indexOf(l.dataset.kleur || '');
      l.classList.toggle('gekozen', n > -1);
      (l.querySelector('input') as HTMLInputElement).checked = n > -1;
      const m = l.querySelector('.merkje'); if (m) m.textContent = n > -1 ? String(n + 1) : '';
    });

    const zet = () => {
      const d = new FormData(f);
      const patroon = String(d.get('patroon'));
      const [a, b] = keuze.length ? keuze : ['Antraciet'];
      cellen.forEach((c, i) => {
        const x = i % N, y = Math.floor(i / N);
        let k = a;
        if (b) {
          if (patroon === 'Dambord') k = (x + y) % 2 ? b : a;
          else if (patroon === 'Strepen') k = Math.floor(y / 2) % 2 ? b : a;
          else k = mix[i] < 0.5 ? b : a;
        }
        c.style.backgroundImage = `url("${stalen[k]}")`;
        c.classList.toggle('dwars', (x + y) % 2 === 1);
      });
      const m2 = parseFloat(String(d.get('m2') || '').replace(',', '.'));
      const tegels = m2 > 0 ? Math.ceil(m2 * 4) : 0;
      if (telling) telling.textContent = tegels ? `${tegels} tegels` : '';
      const ruimte = String(d.get('ruimte'));
      const bezoek = String(d.get('bezoek'));
      const r = ['Hallo Tapijt-tegels.eu, ik zoek tapijttegels.'];
      if (tegels) r.push(`Ongeveer ${String(m2).replace('.', ',')} m², dat is ca. ${tegels} tegels van 50x50 cm.`);
      r.push(b ? `Kleuren: ${a.toLowerCase()} en ${b.toLowerCase()}, als ${patroon.toLowerCase()}.` : `Kleur: ${a.toLowerCase()}.`);
      r.push(`Voor: ${ruimte.toLowerCase()}.`);
      if (bezoek === 'Afspraak maken') r.push('Ik wil graag een afspraak maken om te komen kijken.');
      if (bezoek === "Eerst foto's ontvangen") r.push("Kunt u mij eerst foto's sturen van wat er ligt?");
      r.push('Welke kleuren zijn er nu op voorraad?');
      const t = r.join('\n');
      vb.textContent = t;
      knop.href = `${site.wa}?text=${encodeURIComponent(t)}`;
    };

    f.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name === 'kleur') {
        if (el.checked) { keuze.push(el.value); if (keuze.length > 2) keuze = keuze.slice(-2); }
        else keuze = keuze.filter((k) => k !== el.value);
        labels();
      }
      zet();
    });
    f.addEventListener('input', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    labels(); zet();
  }
</script>
