---
// Nagetekend naar hun bord (bron/google/foto/g08.jpg): een rij gekantelde tegels in donkerblauw, rood, lila en blauw,
// met "Tapijt-tegels.eu" eronder in het rood van het bord.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
const tegels = ['#2a3a8c', '#c21d48', '#b9b3d6', '#8d86c4', '#3d6fd0'];
---
<a href={url('')} aria-label="Tapijt-tegels.eu, naar de homepage" class={`inline-flex items-center gap-3 no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class="flex" aria-hidden="true">
    {tegels.map((c, i) => <span class="block h-[.95rem] w-[.95rem] rotate-45 rounded-[1px]" style={`background:${c};margin-left:${i ? '-.28rem' : '0'}`}></span>)}
  </span>
  <span class="font-kop text-[1.35rem] font-extrabold leading-none tracking-[-.035em] sm:text-[1.5rem]" aria-hidden="true">Tapijt-tegels<span class="text-merk-licht">.eu</span></span>
</a>
