---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, tijden, waMet } from '../data/site';
import woonkamer from '../assets/woonkamer.jpg';
import tijdens from '../assets/trap-tijdens.jpg';
import klaar from '../assets/trap-klaar.jpg';
import eikenDraai from '../assets/eiken-2.jpg';
import eikenRecht from '../assets/eiken-1.jpg';
import eikenDetail from '../assets/eiken-3.jpg';

const diensten = [
  ['Vloeren', 'Alle soorten vloeren, geleverd en gelegd. Onder meer laminaat, vinyl en tapijt.'],
  ['Traprenovatie', 'Uw trap opnieuw bekleed, als u wilt met verlichting onder de treden.'],
  ['Binnenzonwering', 'Raamdecoratie op maat. Lavizon is verkooppunt van Zonnelux.'],
  ['Buitenzonwering', 'Zonwering aan de buitenkant van het huis.'],
  ['Insectenhorren', 'Geleverd en geplaatst.'],
];

const onderwerpen = [
  ['Een vloer', 'een nieuwe vloer'],
  ['Traprenovatie', 'traprenovatie'],
  ['Raamdecoratie', 'raamdecoratie'],
  ['Buitenzonwering', 'buitenzonwering'],
  ['Insectenhorren', 'insectenhorren'],
];
---
<Base title="Lavizon Woninginrichting | Vloeren, traprenovatie en raamdecoratie in Papendrecht" description="Lavizon Woninginrichting uit Papendrecht levert en plaatst vloeren, traprenovaties, binnen- en buitenzonwering en insectenhorren. Kwaliteit in woninginrichting.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Eerste scherm: wit vlak met de kop, ernaast hun eigen woonkamerfoto over de volle hoogte. -->
    <section class="hero grid lg:grid-cols-12" aria-labelledby="titel">
      <div class="wrap flex flex-col pb-8 pt-10 md:pt-14 lg:col-span-5 lg:max-w-none lg:justify-between lg:pb-12 lg:pl-10 lg:pr-12 lg:pt-20 min-[1600px]:pl-[calc((100vw-90rem)/2+2.5rem)]">
        <div>
          <h1 id="titel" class="text-4xl">Vloeren, trappen en raam&shy;decoratie.</h1>
          <p class="mt-6 max-w-[27rem] text-lg leading-relaxed text-grijs md:mt-8">Lavizon uit Papendrecht levert en plaatst vloeren, traprenovaties, zonwering en insectenhorren. Bij u aan huis.</p>
          <p class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 md:mt-10">
            <a href={waMet('ik heb een vraag over ')} class="knop">Stuur een WhatsApp <span class="pijl" aria-hidden="true">→</span></a>
            <a href={site.telHref} class="ui num lijn whitespace-nowrap">Bel {site.tel}</a>
          </p>
        </div>
        <dl class="klein mt-10 hidden grid-cols-2 gap-x-8 border-t border-lijn pt-5 text-grijs lg:grid">
          <div><dt class="sr-only">Adres</dt><dd>{site.straat}<br />{site.postcode} {site.plaats}</dd></div>
          <div><dt class="sr-only">Open</dt><dd class="num">Ma tot vr {tijden[0][1]}<br />Za {tijden[1][1]}</dd></div>
        </dl>
      </div>
      <figure class="hero-beeld relative min-h-0 flex-1 overflow-hidden bg-steen lg:col-span-7">
        <Image src={woonkamer} alt="Lichte woonkamer met witte houten jaloezieën voor de hoge ramen, een eettafel en een houtlook vloer door de hele ruimte." widths={[640, 960, 1400, 2000]} sizes="(min-width: 1024px) 58vw, 100vw" format="webp" quality={74} loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-[46%_60%]" />
        <figcaption class="klein absolute bottom-4 right-5 text-wit/90 [text-shadow:0_1px_8px_rgb(0_0_0/.35)] md:bottom-6 md:right-8">Jaloezieën en vloer, foto van Lavizon</figcaption>
      </figure>
    </section>

    <!-- 2. Wat ze doen: hun eigen zin groot, de vijf onderdelen als rustige lijst. -->
    <section id="diensten" class="wrap scroll-mt-16 py-28 lg:py-40" aria-labelledby="t-diensten">
      <div class="grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-5">
          <h2 id="t-diensten" class="text-3xl">Nieuwbouwhuis of renovatie?</h2>
          <p class="mt-7 max-w-[25rem] text-lg leading-relaxed text-grijs">Lavizon helpt u er een sfeervol geheel van te maken, met een mooie vloer, binnen- en buitenzonwering.</p>
        </div>
        <ul class="border-t border-lijn lg:col-span-6 lg:col-start-7">
          {diensten.map(([t, d], i) => (
            <li class="rijs grid gap-y-1.5 border-b border-lijn py-7 md:grid-cols-[13rem_1fr] md:gap-x-8" style={`--d:${i * 0.06}s`}>
              <h3 class="text-xl">{t}</h3>
              <p class="text-grijs">{d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. Traprenovatie: donker zoals hun treden. Tijdens en klaar, daarna een eiken trap. -->
    <section id="trappen" class="donker scroll-mt-16 bg-antraciet py-28 text-licht lg:py-40" aria-labelledby="t-trap">
      <div class="wrap">
        <div class="grid gap-y-7 lg:grid-cols-12 lg:gap-x-8">
          <h2 id="t-trap" class="text-3xl lg:col-span-6">Traprenovatie.</h2>
          <p class="max-w-[30rem] text-lg leading-relaxed text-licht-zacht lg:col-span-5 lg:col-start-8 lg:self-end">Uw eigen trap, opnieuw bekleed. Op deze trap met verlichting onder elke trede.</p>
        </div>

        <div class="mt-16 grid grid-cols-2 gap-x-3 md:gap-x-8 lg:mt-24 lg:grid-cols-12">
          <figure class="lg:col-span-5">
            <div class="aspect-[3/4] overflow-hidden bg-[#2c3135]">
              <Image src={tijdens} alt="Een trap tijdens de renovatie: de onderste trede is al antraciet bekleed en zit in de lijmklemmen, de treden erboven zijn nog kaal." widths={[400, 700, 1000]} sizes="(min-width: 1024px) 38vw, 50vw" format="webp" quality={70} class="h-full w-full object-cover" />
            </div>
            <figcaption class="klein mt-4 text-licht-zacht">Tijdens</figcaption>
          </figure>
          <figure class="lg:col-span-5 lg:col-start-7 lg:mt-24">
            <div class="aspect-[3/4] overflow-hidden bg-[#2c3135]">
              <Image src={klaar} alt="Dezelfde trap klaar: antraciet treden en stootborden, een antraciet leuning langs de witte wand en onder elke trede een warm lampje." widths={[400, 700, 1000]} sizes="(min-width: 1024px) 38vw, 50vw" format="webp" quality={70} class="h-full w-full object-cover" />
            </div>
            <figcaption class="klein mt-4 text-licht-zacht">Klaar</figcaption>
          </figure>
        </div>

        <div class="mt-28 grid gap-y-10 lg:mt-40 lg:grid-cols-12 lg:gap-x-8">
          <figure class="lg:col-span-7">
            <div class="aspect-square overflow-hidden bg-[#2c3135]">
              <Image src={eikenDraai} alt="Een draaiende trap van bovenaf: eiken treden met een donkere afwerking en witte stootborden." widths={[500, 900, 1300]} sizes="(min-width: 1024px) 55vw, 100vw" format="webp" quality={70} class="h-full w-full object-cover" />
            </div>
          </figure>
          <div class="flex flex-col gap-12 lg:col-span-4 lg:col-start-9 lg:pt-2">
            <div>
              <h3 class="text-2xl">Eiken rustiek, RAL 9010.</h3>
              <p class="mt-6 leading-relaxed text-licht-zacht">Zijkanten en stootborden met witte panelen in RAL 9010. Treden in eiken rustiek, afgewerkt met Rubio Monocoat in de kleur walnut. Onder de treden led-verlichting.</p>
            </div>
            <div class="grid grid-cols-2 gap-3 md:gap-6">
              <div class="aspect-[4/5] overflow-hidden bg-[#2c3135]">
                <Image src={eikenRecht} alt="Dezelfde trap van onderaf: eiken treden met lampjes eronder langs een witte wand." widths={[300, 600]} sizes="(min-width: 1024px) 15vw, 50vw" format="webp" quality={70} class="h-full w-full object-cover" />
              </div>
              <div class="aspect-[4/5] overflow-hidden bg-[#2c3135]">
                <Image src={eikenDetail} alt="Detail van twee eiken treden met het licht van de led-strip eronder op de witte wand." widths={[300, 600]} sizes="(min-width: 1024px) 15vw, 50vw" format="webp" quality={70} class="h-full w-full object-cover object-[30%_50%]" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Bij u thuis: onderwerp kiezen, het bericht staat zichtbaar klaar, door naar WhatsApp. -->
    <section id="aan-huis" class="scroll-mt-16 py-28 lg:py-40" aria-labelledby="t-huis">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-5">
          <h2 id="t-huis" class="text-3xl">Geheel vrijblijvend bij u aan huis.</h2>
          <p class="mt-7 max-w-[25rem] text-lg leading-relaxed text-grijs">Benieuwd wat er bij u thuis mogelijk is? Lavizon komt langs en informeert u over de mogelijkheden.</p>
        </div>
        <form class="lg:col-span-6 lg:col-start-7" data-huis novalidate>
          <fieldset>
            <legend class="klein text-grijs">Waar gaat het om?</legend>
            <div class="keuzes mt-4">
              {onderwerpen.map(([t, w], i) => <label><input type="checkbox" name="onderwerp" value={w} checked={i === 0} /><span>{t}</span></label>)}
            </div>
          </fieldset>
          <div class="mt-9 grid gap-5 sm:grid-cols-2">
            <label class="veld"><span class="klein text-grijs">Uw plaats</span><input name="plaats" autocomplete="address-level2" placeholder="bijv. Papendrecht" /></label>
            <label class="veld"><span class="klein text-grijs">Uw naam</span><input name="naam" autocomplete="name" placeholder="optioneel" /></label>
          </div>
          <div class="bericht mt-9">
            <p class="klein text-grijs">Dit bericht gaat naar Lavizon</p>
            <p class="mt-3 whitespace-pre-line text-lg leading-relaxed" aria-live="polite" data-huis-tekst></p>
          </div>
          <p class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={waMet('ik ben benieuwd naar de mogelijkheden bij mij thuis.')} class="knop" data-huis-wa>Verstuur via WhatsApp <span class="pijl" aria-hidden="true">→</span></a>
            <a href={`mailto:${site.mail}`} class="ui lijn" data-huis-mail>Of per mail</a>
          </p>
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .hero { min-height: calc(100svh - var(--balk, 0px) - 4rem); display: flex; flex-direction: column; }
  @media (min-width: 768px) { .hero { min-height: calc(100svh - var(--balk, 0px) - 4.5rem); } }
  @media (min-width: 1024px) { .hero { display: grid; height: calc(100svh - var(--balk, 0px) - 4.5rem); min-height: 40rem; max-height: 68rem; } }
  .hero-beeld { min-height: 46svh; }

  .keuzes { display: flex; flex-wrap: wrap; gap: .5rem; }
  .keuzes label { position: relative; cursor: pointer; }
  .keuzes input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .keuzes span { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.1rem; border-radius: 2px; box-shadow: inset 0 0 0 1px var(--color-lijn); font-size: var(--text-ui); transition: background-color .3s var(--ease-zacht), color .3s var(--ease-zacht), box-shadow .3s var(--ease-zacht); }
  .keuzes label:hover span { box-shadow: inset 0 0 0 1px var(--color-inkt); }
  .keuzes input:checked + span { background: var(--color-inkt); color: var(--color-papier); box-shadow: inset 0 0 0 1px var(--color-inkt); }
  .keuzes input:focus-visible + span { outline: 2px solid var(--color-inkt); outline-offset: 3px; }
  .veld { display: grid; gap: .35rem; }
  .veld input { width: 100%; min-width: 0; background: transparent; border: 0; border-bottom: 1px solid var(--color-lijn); padding: .5rem 0; font: inherit; color: var(--color-inkt); transition: border-color .3s var(--ease-zacht); }
  .veld input::placeholder { color: #8a8f95; }
  .veld input:focus { outline: none; border-bottom-color: var(--color-inkt); }
  .bericht { background: var(--color-wit); padding: 1.5rem 1.6rem 1.7rem; border-left: 2px solid var(--color-inkt); }
</style>

<script>
  // Zet de keuzes om in een kort WhatsApp- en mailbericht dat zichtbaar meeloopt.
  const form = document.querySelector<HTMLFormElement>('[data-huis]')!;
  const wa = form.querySelector<HTMLAnchorElement>('[data-huis-wa]')!;
  const mail = form.querySelector<HTMLAnchorElement>('[data-huis-mail]')!;
  const uit = form.querySelector<HTMLElement>('[data-huis-tekst]')!;
  const basisWa = wa.href.split('?')[0];
  const basisMail = mail.href.split('?')[0];
  const lijst = (a: string[]) => a.length < 2 ? a.join('') : a.slice(0, -1).join(', ') + ' en ' + a[a.length - 1];
  const maak = () => {
    const keuze = [...form.querySelectorAll<HTMLInputElement>('input[name=onderwerp]:checked')].map((i) => i.value);
    const plaats = (form.elements.namedItem('plaats') as HTMLInputElement).value.trim();
    const naam = (form.elements.namedItem('naam') as HTMLInputElement).value.trim();
    const over = keuze.length ? ` over ${lijst(keuze)}` : '';
    const waar = plaats ? ` in ${plaats}` : '';
    const tekst = `Hallo Lavizon, ik ben benieuwd naar de mogelijkheden${over} bij mij thuis${waar}. Kunt u een keer vrijblijvend langskomen?` + (naam ? `\n\nGroet, ${naam}` : '');
    uit.textContent = tekst;
    wa.href = `${basisWa}?text=${encodeURIComponent(tekst)}`;
    mail.href = `${basisMail}?subject=${encodeURIComponent('Vrijblijvend langskomen')}&body=${encodeURIComponent(tekst)}`;
  };
  form.addEventListener('input', maak);
  form.addEventListener('change', maak);
  form.addEventListener('submit', (e) => e.preventDefault());
  maak();
</script>
