---
// Woordmerk: "Lavizon" met de zon uit hun eigen logo, teruggebracht tot een cirkel met korte stralen.
interface Props { class?: string; zon?: string; zonder?: boolean }
const { class: cls = '', zon = '', zonder = false } = Astro.props;
const stralen = Array.from({ length: 12 }, (_, i) => i * 30);
---
<span class:list={['merk inline-flex items-center gap-[.32em]', cls]}>
  <span>Lavizon</span>
  {!zonder && <svg viewBox="0 0 24 24" class:list={['zon', zon]} fill="none" stroke="currentColor" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" stroke-width="1.5" />
    {stralen.map((g) => <line x1="12" y1="2" x2="12" y2="4.6" stroke-width="1.5" stroke-linecap="round" transform={`rotate(${g} 12 12)`} />)}
  </svg>}
</span>

<style>
  .merk { font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
  .zon { width: .9em; height: .9em; transform: translateY(-.3em); }
</style>
