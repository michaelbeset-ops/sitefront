---
// Header: rustige witte balk, wordt bij scrollen half doorzichtig met een haarlijn.
import { site, url, waMet } from '../data/site';
import Merk from './Merk.astro';
const nav = [
  ['Wat we doen', '#diensten'],
  ['Traprenovatie', '#trappen'],
  ['Bij u thuis', '#aan-huis'],
  ['Contact', '#contact'],
];
const thuis = url('');
---
<header class="kop sticky top-0 z-40" data-kop>
  <div class="wrap flex h-16 items-center justify-between gap-6 md:h-[4.5rem]">
    <a href={thuis} class="text-[1.375rem]" aria-label={`${site.naam}, naar de homepage`}>
      <Merk />
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="ui flex gap-9">
        {nav.map(([t, h]) => <li><a href={`${thuis}${h}`} class="lijn-in">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-7">
      <a href={site.telHref} class="ui num lijn-in hidden xl:inline">{site.tel}</a>
      <a href={waMet('ik heb een vraag. ')} class="knop knop-klein max-[359px]:hidden">WhatsApp</a>
      <button type="button" class="ui lg:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>Menu</button>
    </div>
  </div>

  <div id="menu" class="menu lg:hidden" hidden data-menu>
    <nav aria-label="Menu" class="wrap flex min-h-full flex-col justify-between gap-10 pb-10 pt-8">
      <ul class="space-y-1">
        {nav.map(([t, h]) => <li><a href={`${thuis}${h}`} class="block py-1 text-[2.25rem] leading-tight tracking-[-.04em]" data-menu-link>{t}</a></li>)}
      </ul>
      <p class="space-y-3">
        <a href={waMet('ik heb een vraag. ')} class="knop w-full">Stuur een WhatsApp</a>
        <a href={site.telHref} class="knop knop-rand num w-full">Bel {site.tel}</a>
      </p>
    </nav>
  </div>
</header>

<style>
  .kop { background-color: var(--color-papier); transition: background-color .5s var(--ease-zacht), box-shadow .5s var(--ease-zacht); }
  .kop.schaduw { background-color: color-mix(in srgb, var(--color-papier) 92%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 1px 0 var(--color-lijn); }
  .menu { position: fixed; left: 0; right: 0; bottom: 0; top: 4rem; background: var(--color-papier); overflow-y: auto; }
  .knop-rand { background: transparent; color: var(--color-inkt); box-shadow: inset 0 0 0 1px var(--color-inkt); }
  .knop-rand:hover { background: var(--color-steen); }
</style>

<script>
  const kop = document.querySelector<HTMLElement>('[data-kop]')!;
  const zet = () => kop.classList.toggle('schaduw', scrollY > 8);
  zet(); addEventListener('scroll', zet, { passive: true });
  const knop = kop.querySelector<HTMLButtonElement>('[data-menu-knop]')!;
  const menu = kop.querySelector<HTMLElement>('[data-menu]')!;
  const open = (aan: boolean) => {
    menu.style.top = kop.getBoundingClientRect().bottom + 'px';
    menu.hidden = !aan;
    knop.setAttribute('aria-expanded', String(aan));
    knop.textContent = aan ? 'Sluiten' : 'Menu';
    document.documentElement.style.overflow = aan ? 'hidden' : '';
  };
  knop.addEventListener('click', () => open(menu.hidden));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => open(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { open(false); knop.focus(); } });
</script>
