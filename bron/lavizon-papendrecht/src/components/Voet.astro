---
import { site, tijden, url, waMet } from '../data/site';
---
<footer id="contact" class="donker scroll-mt-16 bg-antraciet text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-y-16 pb-20 pt-28 lg:grid-cols-12 lg:gap-x-8 lg:pb-28 lg:pt-40">
    <div class="lg:col-span-5">
      <h2 id="t-contact" class="text-3xl">Bel of app Lavizon.</h2>
      <p class="mt-7 max-w-[26rem] text-lg leading-relaxed text-licht-zacht">Voor een vloer, een trap, raamdecoratie of horren.</p>
      <p class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={waMet('ik heb een vraag. ')} class="knop knop-licht">Stuur een WhatsApp <span class="pijl" aria-hidden="true">→</span></a>
        <a href={site.telHref} class="ui num lijn whitespace-nowrap">Bel {site.tel}</a>
      </p>
    </div>

    <div class="grid gap-x-8 gap-y-10 text-[.9375rem] sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
      <div>
        <p class="klein text-licht-zacht">Telefoon en WhatsApp</p>
        <p class="mt-2"><a href={site.telHref} class="lijn num whitespace-nowrap">{site.tel}</a></p>
        <p class="klein mt-6 text-licht-zacht">Mail</p>
        <p class="mt-2"><a href={`mailto:${site.mail}`} class="lijn">{site.mail}</a></p>
      </div>
      <div>
        <p class="klein text-licht-zacht">Adres</p>
        <p class="mt-2">{site.straat}<br />{site.postcode} {site.plaats}</p>
        <a href={site.maps} class="lijn klein mt-3 inline-block text-licht-zacht">Route in Google Maps ↗</a>
      </div>
      <div class="sm:col-span-2">
        <p class="klein text-licht-zacht">Openingstijden</p>
        <dl class="mt-3 border-t border-lijn-licht">
          {tijden.map(([d, t]) => (
            <div class="flex justify-between gap-6 border-b border-lijn-licht py-3">
              <dt>{d}</dt><dd class="num text-right">{t}</dd>
            </div>
          ))}
        </dl>
      </div>
      <figure class="sm:col-span-2">
        <blockquote class="text-xl">“Prima service en eerlijke prijs!”</blockquote>
        <figcaption class="klein mt-2 text-licht-zacht">Review op Google. Lavizon staat er op <span class="num">{site.google}</span> uit {site.googleAantal} reviews.</figcaption>
      </figure>
    </div>
  </div>

  <div class="wrap overflow-hidden pb-8" aria-hidden="true">
    <svg viewBox="0 0 1000 250" class="voetmerk block h-auto w-[62%] min-w-[16rem]" role="presentation"><text x="-6" y="208" fill="#2f3439" font-size="262" font-weight="600" letter-spacing="-15">Lavizon</text></svg>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p class="num">{site.naam}, {site.plaats}. KvK {site.kvk}. Kwaliteit in woninginrichting.</p>
    <p><a href={url('privacy/')} class="lijn-in">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Foto's van het Google-bedrijfsprofiel en de Facebookpagina van Lavizon. Teksten en gegevens van dat profiel, die pagina en Zonnelux.nl.</p>}
</footer>

<style>
  .voetmerk text { font-family: var(--font-sans); }
</style>
