---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden } from '../data/site';
import { Image } from 'astro:assets';
import interieur from '../assets/interieur.jpg';
import logo from '../assets/logo.png';
import Kaart from '../components/Kaart.astro';
import { rijstNoot, toeslagen } from '../data/menu';
import wok from '../assets/wok.jpg';
import indisch from '../assets/indisch.jpg';
const pijl = '<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"/></svg>';
---
<Base
  title="De Mandarijn | Chinees Indisch restaurant in Voorburg"
  description="Al meer dan 30 jaar Chinese, Kantonese en Indische gerechten in Voorburg, aan de Klaverweide naast de Hoogvliet. À la carte, aparte afhaalruimte en gratis parkeren. Dinsdag gesloten."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hun eigen zaal als hero: de eigenaar herkent de lampionnen en het bloemstuk direct. Logo als beeldmerk erop. -->
    <section class="wrap grid gap-8 pb-14 pt-5 lg:grid-cols-12 lg:items-center lg:gap-12 lg:pb-24 lg:pt-14">
      <div class="relative lg:order-2 lg:col-span-7">
        <div class="aspect-[4/3] overflow-hidden rounded-[1.5rem] shadow-[0_1px_2px_#13201c1f]">
          <Foto src={interieur} alt="Het restaurant van binnen: rode lampionnen, een groot bloemstuk en gedekte ronde tafels met draaiplateau" hero sizes="(min-width: 1024px) 680px, 100vw" />
        </div>
        <Image src={logo} alt="" width={96} height={96} densities={[1, 1.5]} class="absolute -bottom-6 left-4 h-20 w-20 rounded-full ring-4 ring-paper sm:h-24 sm:w-24 lg:-left-8 lg:bottom-8 lg:h-24 lg:w-24" loading="eager" />
      </div>
      <div class="pt-4 lg:order-1 lg:col-span-5 lg:pt-0">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-schil-diep">Chinees Indisch restaurant in Voorburg</p>
        <h1 class="mt-4 text-4xl text-jade">Chinees en Indisch eten, al meer dan 30 jaar in Voorburg</h1>
        <p class="mt-6 max-w-xl text-lg text-ink-soft">De Mandarijn staat voor genieten in een gezellige en informele sfeer, van Chinese en Kantonese gerechten tot Indische specialiteiten. U vindt ons naast de Hoogvliet.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={site.telHref} class="btn btn-jade justify-center">Reserveer: <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          <a href="#kaart" class="btn btn-line justify-center text-jade">Bekijk de kaart</a>
        </div>
        <p class="mt-6 text-sm text-ink-soft"><strong class="text-ink">4,0</strong> op Google (209 reviews) · open vanaf <span class="whitespace-nowrap tabular-nums">16:00</span> · dinsdag gesloten</p>
      </div>
    </section>

    <section id="kaart" class="scroll-mt-20 bg-rijst py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-schil-diep">Uit de afhaalkaart van december 2025</p>
            <h2 class="mt-4 text-3xl text-jade">Specialiteiten en favorieten van de kaart</h2>
          </div>
          <p class="border-l-4 border-schil-diep pl-5 font-display text-2xl italic leading-snug text-jade lg:col-span-5 lg:col-start-8 lg:self-end">Op onze kaart staan alleen gerechten die we zelf ook lekker vinden.</p>
        </div>

        <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12">
          <div class="lg:col-span-8 lg:order-2">
            <Kaart />
          </div>
          <aside class="lg:col-span-4 lg:order-1" aria-label="Goed om te weten">
            <div class="grid gap-6 sm:grid-cols-2 lg:sticky lg:top-24 lg:grid-cols-1">
              <div class="rounded-[1.25rem] bg-white p-6 shadow-[0_1px_2px_#13201c1f] ring-1 ring-line">
                <p class="font-display text-xl font-semibold text-jade">{rijstNoot.replace('Bovenstaande gerechten', 'De gerechten')}</p>
                <ul class="mt-4 grid gap-2 text-sm text-ink-soft">
                  {toeslagen.map((t) => (
                    <li class="border-t border-line pt-2">{t.wat}: <span class="whitespace-nowrap font-semibold text-ink tabular-nums">€ {t.prijs}</span>{t.per}</li>
                  ))}
                </ul>
                <p class="mt-5 text-sm text-ink-soft">Dit is een deel van de kaart. Soepen, voorgerechten, Kantonese en Szechuan specialiteiten en meer staan in de volledige afhaalkaart.</p>
                <a href={site.afhaalkaart} rel="noopener" class="btn btn-jade mt-5 w-full justify-center"><Fragment set:html={pijl} />Volledige kaart (PDF)</a>
              </div>
              <figure>
                <div class="aspect-[4/3] overflow-hidden rounded-[1.25rem] lg:aspect-[5/4]"><Foto src={indisch} alt="Bord met rijst, gegrilde kip, groente met taugé, komkommer en een bakje sambal" sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw" /></div>
                <figcaption class="mt-3 text-sm text-ink-soft">Laat u er niet van weerhouden om bij deze "Chinees" ook een Indische specialiteit te proberen.</figcaption>
              </figure>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section id="afhalen" class="op-jade scroll-mt-20 bg-jade py-16 text-paper lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="aspect-[3/2] overflow-hidden rounded-[1.25rem] lg:col-span-7"><Foto src={wok} alt="Bord met gewokte reepjes vlees, ui en witte rijst, eetstokjes ernaast en een afhaalbakje op de achtergrond" sizes="(min-width: 1024px) 640px, 100vw" /></div>
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Afhalen uit de eigen afhaalruimte</h2>
          <p class="mt-5 text-lg text-paper/85">Naast het restaurant is er een aparte afhaalruimte. Daar kunt u al onze gerechten meenemen en er thuis van genieten. Parkeren is gratis, en er is plek genoeg.</p>
          <ul class="mt-8 border-t border-paper/20">
            <li class="border-b border-paper/20">
              <a href={site.afhaalkaart} rel="noopener" class="flex items-center justify-between gap-4 py-4 no-underline hover:text-schil">
                <span><span class="block font-display text-xl font-semibold">Afhaalkaart</span><span class="text-sm text-paper/75">PDF, december 2025</span></span><Fragment set:html={pijl} />
              </a>
            </li>
            <li class="border-b border-paper/20">
              <a href={site.glutenvrij} rel="noopener" class="flex items-center justify-between gap-4 py-4 no-underline hover:text-schil">
                <span><span class="block font-display text-xl font-semibold">Glutenvrije gerechten</span><span class="text-sm text-paper/75">PDF, afhaalmenu</span></span><Fragment set:html={pijl} />
              </a>
            </li>
          </ul>
          <a href={site.telHref} class="btn btn-schil mt-8">Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
        </div>
      </div>
    </section>

    <section id="reserveren" class="wrap scroll-mt-20 grid gap-12 py-16 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6">
        <h2 class="text-3xl text-jade">Reserveren</h2>
        <p class="mt-5 max-w-lg text-lg text-ink-soft">Reserveren is aan te raden. Zonder reservering bent u bij ons ook van harte welkom.</p>
        <a href={site.telHref} class="mt-8 inline-block whitespace-nowrap border-b-2 border-schil-diep pb-1 font-display text-[clamp(2rem,7vw,3.25rem)] font-semibold leading-none tracking-[-0.02em] text-jade no-underline tabular-nums hover:text-schil-diep">{site.tel}</a>
        <p class="mt-4 text-ink-soft">Telefonisch van <span class="whitespace-nowrap tabular-nums">16:00 tot 21:00</span> uur, dinsdag gesloten.</p>
        <p class="mt-2 text-ink-soft">Of mail naar <a href={`mailto:${site.mail}`} class="break-all text-ink underline underline-offset-2">{site.mail}</a></p>
      </div>
      <div class="rounded-[1.25rem] bg-white p-6 shadow-[0_1px_2px_#13201c1f] ring-1 ring-line md:p-8 lg:col-span-5 lg:col-start-8">
        <h2 class="text-2xl text-jade">Openingstijden</h2>
        <table class="mt-4 w-full">
          <caption class="sr-only">Openingstijden restaurant en afhaal</caption>
          <tbody>
            {tijden.map(([d, t]) => (
              <tr class="border-b border-line last:border-0">
                <th scope="row" class="py-2.5 text-left font-medium">{d}</th>
                <td class={`py-2.5 text-right whitespace-nowrap tabular-nums ${t ? '' : 'font-semibold text-schil-diep'}`}>{t ?? 'Gesloten'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="route" class="op-jade scroll-mt-20 bg-jade py-16 text-paper lg:py-20">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Aan de Klaverweide, naast de Hoogvliet</h2>
          <a href={site.maps} rel="noopener" class="btn btn-schil mt-8">Route plannen</a>
        </div>
        <dl class="grid content-start gap-8 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
          <div class="border-t-2 border-schil pt-4">
            <dt class="text-sm text-paper/75">Adres</dt>
            <dd class="mt-1 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</dd>
          </div>
          <div class="border-t-2 border-paper/30 pt-4">
            <dt class="text-sm text-paper/75">Parkeren</dt>
            <dd class="mt-1 text-lg">Voldoende gratis parkeergelegenheid</dd>
          </div>
          <div class="border-t-2 border-paper/30 pt-4">
            <dt class="text-sm text-paper/75">Telefoon</dt>
            <dd class="mt-1 text-lg"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline decoration-schil decoration-2 underline-offset-4">{site.tel}</a></dd>
          </div>
          <div class="border-t-2 border-paper/30 pt-4">
            <dt class="text-sm text-paper/75">Google</dt>
            <dd class="mt-1 text-lg">4,0 uit 5, 209 reviews</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
