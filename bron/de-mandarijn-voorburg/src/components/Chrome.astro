---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-center gap-2.5 no-underline">
        <svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7 shrink-0"><circle cx="16" cy="17" r="11" fill="#f28a2e"/><path d="M16 6v22M6.5 11.5l19 11M6.5 22.5l19-11" stroke="#14332b" stroke-width="1.3" opacity=".35"/><path d="M16 6c1.2-3.4 4.6-4.5 7-4-1.2 2.9-4.1 4-7 4z" fill="#14332b"/></svg>
        <span class="whitespace-nowrap font-display text-lg sm:text-xl font-semibold leading-none tracking-[-0.01em] text-jade">De Mandarijn</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-medium">
          <li><a href="#kaart" class="no-underline hover:text-schil-diep">De kaart</a></li>
          <li><a href="#afhalen" class="no-underline hover:text-schil-diep">Afhalen</a></li>
          <li><a href="#reserveren" class="no-underline hover:text-schil-diep">Reserveren</a></li>
          <li><a href="#route" class="no-underline hover:text-schil-diep">Route</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-jade !px-4 !py-2 text-sm">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        <span class="sm:hidden">Bel</span><span class="hidden sm:inline">{site.tel}</span>
      </a>
    </div>
  </header>
) : (
  <footer class="bg-nacht py-10 text-paper/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg font-semibold text-white">{site.naam}</strong><br />{site.soort}<br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={`mailto:${site.mail}`} class="underline underline-offset-2">{site.mail}</a><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
