---
// Nagemaakt naar hun eigen logo: een ijshoorntje als grijze lijn met een rode en een groene boog als bolletjes,
// daarnaast IJSBOERDERIJ / HEIDEHOEVE in twee regels. Kleuren iets rustiger gemaakt.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2 leading-none ${cls}`}>
  <span class="sr-only">IJsboerderij Heidehoeve</span>
  <svg viewBox="0 0 40 52" class="h-10 w-auto flex-none" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 21 20.5 49 31 21" stroke-width="3.6" class={licht ? 'stroke-melk/70' : 'stroke-logo-grijs'} />
    <path d="M5 22a9 9 0 0 1 12-11" stroke-width="4.2" class={licht ? 'stroke-hooi' : 'stroke-logo-rood'} />
    <path d="M15 10.5a10 10 0 0 1 19 9" stroke-width="4.2" class={licht ? 'stroke-klaver' : 'stroke-logo-groen'} />
  </svg>
  <span aria-hidden="true" class={`flex flex-col font-body font-bold uppercase ${licht ? 'text-white' : 'text-weide'}`}>
    <span class="text-[0.95rem] tracking-[0.02em]">IJsboerderij</span>
    <span class="mt-[2px] text-[0.95rem] tracking-[0.06em]">Heidehoeve</span>
  </span>
</span>
