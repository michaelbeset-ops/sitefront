              <legend>Soort zaak</legend>
              <div class="mt-1 flex flex-wrap gap-2">
                {['Horeca', 'Winkel', 'Evenement', 'Anders'].map((z, i) => <label class="vak"><input type="radio" name="zaak" value={z} class="sr-only" checked={i === 0} />{z}</label>)}
              </div>
            </fieldset>
            <div class="veld"><label for="f-naam">Naam van uw zaak</label><input id="f-naam" name="bedrijf" autocomplete="organization" class="invoer" /></div>
            <div class="veld"><label for="f-contact">Contactpersoon</label><input id="f-contact" name="naam" autocomplete="name" class="invoer" /></div>
            <div class="veld"><label for="f-tel">Telefoon</label><input id="f-tel" name="telefoon" type="tel" autocomplete="tel" class="invoer" /></div>
            <div class="veld"><label for="f-mail">E-mail</label><input id="f-mail" name="email" type="email" autocomplete="email" class="invoer" /></div>
            <fieldset class="veld sm:col-span-2">
              <legend>Verpakking</legend>
              <div class="mt-1 flex flex-wrap gap-2">
                {verpakkingen.map((v) => <label class="vak"><input type="checkbox" name="verpakking" value={v} class="sr-only" />{v}</label>)}
              </div>
            </fieldset>
            <div class="veld sm:col-span-2">
              <label for="f-smaken">Smaken en wensen</label>
              <textarea id="f-smaken" name="smaken" rows="3" class="invoer" data-smaken-veld></textarea>
              <p class="text-sm text-white/85">Tip: zet bij de smaken hierboven een lijstje klaar, dan komt het hier vanzelf te staan.</p>
            </div>
          </div>
          <p data-samenvatting aria-live="polite" class="mt-6 rounded-lg bg-white/10 p-4 text-sm text-white/90" hidden></p>
          {site.voorstel ? (
            <p class="mt-6 rounded-lg bg-melk p-4 text-sm text-ink">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap tabular-nums font-semibold underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all font-semibold underline">{site.mail}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-melk mt-6">Aanvraag versturen</button>
          )}
        </form>
      </div>
    </section>

    <script>
      // Aanvraag: vult de smaken uit het lijstje in en toont een korte samenvatting. Verstuurt niets.
      const form = document.querySelector<HTMLFormElement>('[data-aanvraag-form]');
      if (form) {
        const veld = form.querySelector<HTMLTextAreaElement>('[data-smaken-veld]')!;
        const samen = form.querySelector<HTMLElement>('[data-samenvatting]')!;
        let vorige = '';
        document.addEventListener('lijstje', (e) => {
          const lijst = (e as CustomEvent<string[]>).detail.join(', ');
          if (!veld.value.trim() || veld.value === vorige) veld.value = lijst;
          vorige = lijst;
          bijwerken();
        });
        const bijwerken = () => {
          const d = new FormData(form);
          const delen = [
            `${d.get('zaak')}${d.get('bedrijf') ? `: ${d.get('bedrijf')}` : ''}`,
            (d.getAll('verpakking') as string[]).join(', '),
            String(d.get('smaken') || '').trim(),
          ].filter(Boolean);
          samen.hidden = false;
          samen.textContent = `Uw aanvraag: ${delen.join(' | ')}`;
        };
        form.addEventListener('input', bijwerken);
        form.addEventListener('change', bijwerken);
        form.addEventListener('submit', (e) => e.preventDefault());
      }
    </script>

