        <form class="rounded-xl bg-stal-diep p-5 shadow-lg sm:p-8 lg:col-span-7" data-aanvraag-form>
          <h3 class="text-2xl">Aanvraag voor uw zaak</h3>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
