            <div class="flex flex-wrap justify-between gap-x-4 border-b border-line py-3"><dt class="text-ink-soft">Facebook</dt><dd><a href={site.facebook} rel="noopener" class="font-semibold underline decoration-gras underline-offset-4">ijsboerderijheidehoeve</a></dd></div>
