  </main>
  <Chrome deel="voet" />
</Base>

<script>
  // "Nu open?": rekent in Nederlandse tijd met de openingstijden van hun eigen site.
  type Blok = { d: number; van: number; tot: number };
  const SEP: Blok[] = [ { d: 3, van: 780, tot: 1020 }, { d: 5, van: 780, tot: 1020 }, { d: 6, van: 660, tot: 1020 }, { d: 0, van: 780, tot: 1020 } ];
  const WINTER: Blok[] = [ { d: 6, van: 780, tot: 1020 } ];
  const dagen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
  const maanden = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
  const periode = (jaar: number, maand: number): 'sep' | 'winter' | null =>
    maand === 9 && jaar === 2026 ? 'sep' : maand >= 10 || maand <= 3 ? 'winter' : null;
  const uur = (m: number) => `${Math.floor(m / 60)}.${String(m % 60).padStart(2, '0')}`;

  const kaart = document.querySelector<HTMLElement>('[data-open]');
  if (kaart) {
    const delen = Object.fromEntries(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date()).map((p) => [p.type, p.value]));
    const nu = new Date(Date.UTC(+delen.year, +delen.month - 1, +delen.day));
    const min = +delen.hour * 60 + +delen.minute;
    const tekst = kaart.querySelector<HTMLElement>('[data-open-tekst]')!;
    const sub = kaart.querySelector<HTMLElement>('[data-open-sub]')!;
    const stip = kaart.querySelector<HTMLElement>('[data-open-stip]')!;
    kaart.querySelector<HTMLElement>('[data-open-klok]')!.textContent = `${dagen[nu.getUTCDay()]} ${uur(min)}`;

    const blokOp = (d: Date) => {
      const p = periode(d.getUTCFullYear(), d.getUTCMonth() + 1);
      return { p, b: p ? (p === 'sep' ? SEP : WINTER).find((x) => x.d === d.getUTCDay()) : undefined };
    };
    const vandaag = blokOp(nu);

    // Huidige periode en dag markeren, in de kaart en in het contactblok.
    if (vandaag.p) {
      document.querySelectorAll<HTMLElement>(`[data-periode="${vandaag.p === 'sep' ? 'winter' : 'sep'}"]`).forEach((el) => el.classList.add('text-ink-soft'));
      document.querySelectorAll<HTMLElement>(`[data-periode="${vandaag.p}"] [data-dag="${nu.getUTCDay()}"], [data-periode-rij="${vandaag.p}"][data-dag="${nu.getUTCDay()}"]`).forEach((el) => el.classList.add('vandaag', 'font-bold'));
    }

    if (!vandaag.p) {
      tekst.textContent = 'Van april t/m augustus zijn we ruimer open.';
      sub.textContent = 'Bel even voor de actuele tijden.';
    } else if (vandaag.b && min >= vandaag.b.van && min < vandaag.b.tot) {
      stip.className = stip.className.replace('bg-logo-grijs', 'bg-logo-groen');
      tekst.textContent = `Nu open, tot ${uur(vandaag.b.tot)} uur`;
      sub.textContent = 'Kom gerust langs.';
    } else if (vandaag.b && min < vandaag.b.van) {
      stip.className = stip.className.replace('bg-logo-grijs', 'bg-hooi');
      tekst.textContent = `Vandaag open vanaf ${uur(vandaag.b.van)} uur`;
      sub.textContent = `Tot ${uur(vandaag.b.tot)} uur.`;
    } else {
      stip.className = stip.className.replace('bg-logo-grijs', 'bg-logo-rood');
      tekst.textContent = 'Nu gesloten';
      let gevonden = '';
      for (let i = 1; i <= 21 && !gevonden; i++) {
        const d = new Date(nu.getTime() + i * 864e5);
        const v = blokOp(d);
        if (!v.p) { gevonden = 'Vanaf april ruimere tijden, die volgen op de website.'; break; }
        if (v.b) gevonden = `Weer open ${i === 1 ? 'morgen' : `op ${dagen[d.getUTCDay()]} ${d.getUTCDate()} ${maanden[d.getUTCMonth()]}`}, vanaf ${uur(v.b.van)} uur.`;
      }
      sub.textContent = gevonden;
    }
  }
</script>
