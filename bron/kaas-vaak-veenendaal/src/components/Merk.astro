---
// Hun eigen logo (de zwart-witte stempel van eapbouman.eu), bijgesneden. Op donker staat het op een witte schijf.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string; groot?: boolean }
const { licht = false, class: cls = '', groot = false } = Astro.props;
---
<a href={url('')} class:list={['group inline-flex items-center gap-3 no-underline', licht ? 'text-wit' : 'text-inkt', cls]}>
  <span class:list={['grid place-items-center rounded-full transition-transform duration-500 group-hover:-rotate-6', licht ? 'bg-wit p-1.5' : '', groot ? 'h-20 w-20' : 'h-12 w-12 md:h-14 md:w-14']}>
    <Image src={logo} alt="" width={112} densities={[1, 2]} quality={80} class="h-full w-full object-contain" />
  </span>
  <span class="leading-none">
    <span class="kop block text-[1.35rem]">Kaas Vaak</span>
    <span class:list={['mt-1 block text-xs font-semibold', licht ? 'text-mist' : 'text-grijs']}>de Kaaszaak, Veenendaal</span>
  </span>
</a>
