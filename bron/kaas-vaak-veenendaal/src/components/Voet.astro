---
import { site, url, waHoi, tijden, tijd } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const volgorde = [2, 3, 4, 5, 6, 0, 1];
---
<footer class="bg-roet text-mist">
  <div class="plank opacity-90" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Delicatessen en kwaliteitskaas aan de Prins Bernhardlaan in Veenendaal.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Winkel</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.maps} class="link link-licht">Route in Google Maps</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1"><a href={site.instagram} class="link link-licht">Instagram</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">E-mail</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Open</p>
      <ul class="num mt-3 space-y-0.5">
        {volgorde.map((i) => { const d = tijden[i]; return <li class="flex justify-between gap-4"><span>{d.dag.slice(0, 2)}</span><span>{d.blokken.length ? d.blokken.map(([a, b]) => `${tijd(a)}-${tijd(b)}`).join(', ') : 'gesloten'}</span></li>; })}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · {site.google.score} op Google uit {site.google.aantal} reviews</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen site en jullie Google-bedrijfsprofiel ("Van eigenaar"). Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
