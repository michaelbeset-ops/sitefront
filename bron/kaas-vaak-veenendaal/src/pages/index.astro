---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, tijden, tijd, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import beemster from '../assets/beemster.jpg';
import jersey from '../assets/jersey.jpg';
import boerenkaas from '../assets/boerenkaas.jpg';
import piemontino from '../assets/piemontino.jpg';
import jerseyBlue from '../assets/jersey-blue.jpg';
import delftsBlauw from '../assets/delfts-blauw.jpg';
import winkel from '../assets/winkel.jpg';
import sappen from '../assets/sappen.jpg';
import dips from '../assets/dips.jpg';
import wand from '../assets/wand.jpg';
import gevel from '../assets/gevel.jpg';

// Letterlijk van hun eigen site (eapbouman.eu, "Kaas Vaak Veenendaal").
const kaart = [
  ['Beemster van het mes', '18 kilo gerijpte Cono kaas'],
  ['Jersey kazen', 'Lactosevrij uit Rouveen'],
  ['Boeren extra belegen', 'Boer Gertjan Snoek'],
  ['Buitenlandse harde kazen', 'Parmezaan, Comté, Emmenthaler'],
  ['Buitenlands zacht', 'Wit- en blauwschimmel, rood gewassen'],
  ['Lokale kazen', 'Meester Affineurs'],
];

const pakketten = [
  ['Borrelplanken', 'Voor de vrijdagmiddagborrel, verjaardagen, openingen en bedrijfsuitjes.'],
  ['Kadopakketten', 'Van een klein pakketje voor de bingo tot grote pakketten voor bruiloften.'],
  ['Kerstpakketten', 'Ook samen met bakkerij Achterberg, slagerij Van Doorn en poelier De Munt.'],
];

const volgorde = [2, 3, 4, 5, 6, 0, 1];
const [j, mariska, plonie, ingrid, , folkert] = reviews;

const titel = 'Kaas Vaak, de Kaaszaak | Kaas en delicatessen in Veenendaal';
const omschrijving = 'Meer dan 100 soorten kaas, sappen, dipjes en olijven aan de Prins Bernhardlaan in Veenendaal. Borrelplanken, kado- en kerstpakketten, bezorgd aan huis.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: hun eigen wand met kaaswielen -->
    <section class="relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col justify-end overflow-hidden bg-roet text-wit md:min-h-[calc(100svh-5rem)]">
      <Image src={hero} alt="De winkel van Kaas Vaak van binnen: rechts houten planken vol gele kaaswielen, links de vitrine met sappen en een eikenhouten ton" quality={60} widths={[400, 600, 800, 1080, 1440, 1700]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[72%_40%] lg:object-[50%_38%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#16151440_0%,#16151480_30%,#161514d9_55%,#161514_100%)] lg:bg-[linear-gradient(90deg,#161514f2_0%,#161514c4_36%,#16151459_60%,#16151410_85%),linear-gradient(0deg,#16151499_0%,#16151400_40%)]" aria-hidden="true"></div>
      <div class="wrap pb-28 pt-32 md:pb-20 lg:pb-24">
        <p class="text-sm font-semibold text-korst">Kaaswinkel in Veenendaal</p>
        <h1 class="mt-5 max-w-[13ch] text-hero">Meer dan <span class="text-korst">100 kazen</span>, gewoon om de hoek.</h1>
        <p class="mt-7 max-w-[34rem] text-lg text-wit/90">Delicatessen en kwaliteitskaas aan de Prins Bernhardlaan. Voor de grote kaasaankoop en voor twee plakjes bij het ontbijt.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#bestellen" class="knop">Plank of pakket bestellen<Icoon naam="pijl" /></a>
          <a href="#winkel" class="knop knop-lijn">Openingstijden</a>
        </div>
      </div>
    </section>

    <!-- 2. DE KAASKAART: hun eigen indeling, met de etiketten groot in beeld -->
    <section id="kazen" class="py-20 md:py-28" aria-labelledby="kazen-titel">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <h2 id="kazen-titel" class="rijs text-3xl">Van het mes, van de boer en van ver</h2>
            <p class="rijs mt-5 max-w-md text-lg text-grijs">Een greep uit de toonbank. Vraag gerust wat er vandaag ligt.</p>
            <ul class="rijs mt-10 border-t border-lijn">
              {kaart.map(([k, v]) => <li class="kaart"><span class="font-semibold">{k}</span><span class="stip" aria-hidden="true"></span><span class="text-sm">{v}</span></li>)}
            </ul>
          </div>
        </div>
        <div class="grid grid-cols-6 gap-3 md:gap-4 lg:col-span-7">
          <figure class="rijs col-span-6 overflow-hidden rounded-md sm:col-span-4">
            <Image quality={56} src={beemster} alt="Een hele Beemster van 't mes op het granieten werkblad, oranje korst met blauw etiket" widths={[480, 720, 960]} sizes="(min-width: 1024px) 38vw, (min-width: 640px) 66vw, 100vw" class="aspect-square h-full w-full object-cover" />
          </figure>
          <div class="col-span-6 grid grid-cols-2 gap-3 sm:col-span-2 sm:grid-cols-1 md:gap-4">
            <figure class="rijs overflow-hidden rounded-md" style="--d:.1s">
              <Image quality={56} src={jersey} alt="Pure Jersey, smaakvol mild, met groene korst" widths={[320, 480]} sizes="(min-width: 640px) 20vw, 50vw" class="aspect-[3/4] h-full w-full object-cover sm:aspect-[4/5]" />
            </figure>
            <figure class="rijs overflow-hidden rounded-md" style="--d:.2s">
              <Image quality={56} src={jerseyBlue} alt="Jersey Blue van Willi Schmid, in zilverfolie" widths={[320, 480]} sizes="(min-width: 640px) 20vw, 50vw" class="aspect-[3/4] h-full w-full object-cover sm:aspect-[4/5]" />
            </figure>
          </div>
          <figure class="rijs col-span-3 overflow-hidden rounded-md">
            <Image quality={56} src={boerenkaas} alt="Boerenkaas met het etiket Nederlands erfgoed, Hollandse koeien in de polder" widths={[320, 480, 720]} sizes="(min-width: 1024px) 28vw, 50vw" class="aspect-[4/5] h-full w-full object-cover" />
          </figure>
          <figure class="rijs col-span-3 overflow-hidden rounded-md" style="--d:.1s">
            <Image quality={56} src={piemontino} alt="Een grote Piemontino Classico met ingebrande naam in de korst" widths={[320, 480, 720]} sizes="(min-width: 1024px) 28vw, 50vw" class="aspect-[4/5] h-full w-full object-cover" />
          </figure>
          <figure class="rijs col-span-6 overflow-hidden rounded-md">
            <Image quality={56} src={delftsBlauw} alt="Kaas met een Delfts blauw etiket, een tekening van een kaasmaker aan het werk" widths={[480, 720, 960]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[16/9] h-full w-full object-cover object-[50%_45%]" />
          </figure>
        </div>
      </div>
    </section>

    <div class="plank" aria-hidden="true"></div>

    <!-- 3. DELICATESSEN: wat er naast de kaas staat -->
    <section id="delicatessen" class="bg-wit py-20 md:py-28" aria-labelledby="deli-titel">
      <div class="wrap">
        <div class="grid gap-y-5 lg:grid-cols-12 lg:gap-x-14">
          <h2 id="deli-titel" class="rijs text-3xl lg:col-span-6">En alles wat erbij hoort</h2>
          <p class="rijs max-w-md self-end text-lg text-grijs lg:col-span-5 lg:col-start-8">Sappen, dipjes, olijven en alles voor de Italiaanse keuken.</p>
        </div>
        <div class="mt-12 grid grid-cols-2 gap-3 md:mt-16 md:grid-cols-12 md:gap-4">
          <figure class="rijs col-span-2 overflow-hidden rounded-md md:col-span-7 md:row-span-2">
            <Image quality={56} src={winkel} alt="De toonbank van Kaas Vaak met de weegschaal, en daarachter planken vol kaaswielen tot aan de etalage" widths={[480, 720, 960, 1280]} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[4/3] h-full w-full object-cover md:aspect-auto" />
          </figure>
          <figure class="rijs overflow-hidden rounded-md md:col-span-5" style="--d:.1s">
            <Image quality={56} src={sappen} alt="Rijen flessen appelsap en rode bessensap van Schulp" widths={[320, 480, 720]} sizes="(min-width: 768px) 40vw, 50vw" class="aspect-[4/5] h-full w-full object-cover md:aspect-[16/10]" />
          </figure>
          <figure class="rijs overflow-hidden rounded-md md:col-span-5" style="--d:.2s">
            <Image quality={56} src={dips} alt="Potjes kaasdip en andere delicatessen van bovenaf op een houten plank" widths={[320, 480, 720]} sizes="(min-width: 768px) 40vw, 50vw" class="aspect-[4/5] h-full w-full object-cover object-[50%_40%] md:aspect-[16/10]" />
          </figure>
        </div>
      </div>
    </section>

    <!-- 4. BESTELLEN: planken en pakketten, de bon eindigt in WhatsApp -->
    <section id="bestellen" class="relative isolate overflow-hidden bg-roet py-20 text-wit md:py-28" aria-labelledby="bestel-titel">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <h2 id="bestel-titel" class="rijs text-3xl">Een plank voor de borrel, een pakket voor een ander</h2>
          <dl class="rijs mt-10 space-y-7">
            {pakketten.map(([k, v]) => (
              <div class="border-t border-lijn-licht pt-5">
                <dt class="kop text-xl text-korst">{k}</dt>
                <dd class="mt-1.5 text-mist">{v}</dd>
              </div>
            ))}
          </dl>
          <p class="rijs mt-10 flex gap-3 text-wit/90"><Icoon naam="pakje" class="mt-1 h-5 w-5 flex-none text-korst" />We bezorgen aan huis en sturen kaas op binnen Nederland en de EU.</p>
          <div class="rijs mt-10 hidden overflow-hidden rounded-md lg:block">
            <Image quality={56} src={wand} alt="Kaaswielen op de plank met een kaars en een bosje groen ervoor" widths={[480, 720]} sizes="34vw" class="aspect-[16/11] w-full object-cover object-[50%_30%]" />
          </div>
        </div>

        <form id="bon" class="rijs self-start rounded-md bg-roet-2 p-6 sm:p-9 lg:col-span-6 lg:col-start-7" data-bon>
          <p class="kop text-2xl">De bestelbon</p>
          <p class="mt-2 text-mist">Vul in wat je weet. Je bericht opent in WhatsApp en je verstuurt het zelf.</p>

          <fieldset class="mt-8">
            <legend class="text-sm font-semibold text-mist">Wat wil je?</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {['Borrelplank', 'Kadopakket', 'Kerstpakket'].map((w, i) => (
                <label><input type="radio" name="wat" value={w} class="peer sr-only" checked={i === 0} /><span class="keus">{w}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="mt-8 grid gap-8 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold text-mist">Voor wie of hoeveel mensen</span>
              <input name="voor" type="text" class="veld" placeholder="Bijv. borrel met 12 collega's" autocomplete="off" />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-mist">Wanneer</span>
              <input name="datum" type="date" class="veld num min-w-0" />
            </label>
          </div>

          <fieldset class="mt-8">
            <legend class="text-sm font-semibold text-mist">Ophalen of bezorgen</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {[['Ik haal het op in de winkel.', 'Ophalen'], ['Graag bezorgen aan huis.', 'Bezorgen'], ['Graag opsturen.', 'Opsturen']].map(([v, t], i) => (
                <label><input type="radio" name="hoe" value={v} class="peer sr-only" checked={i === 0} /><span class="keus">{t}</span></label>
              ))}
            </div>
          </fieldset>

          <label class="mt-8 flex cursor-pointer items-start gap-3">
            <input type="checkbox" name="eigen" class="mt-1 h-5 w-5 flex-none accent-[#f2c21b]" />
            <span><span class="font-semibold">Ik neem mijn eigen plank of mandje mee.</span> <span class="text-mist">Tip: dan wordt het extra persoonlijk.</span></span>
          </label>

          <button type="submit" class="knop mt-10 w-full sm:w-auto"><Icoon naam="wa" />Bestelling via WhatsApp</button>
          <p class="mt-4 text-sm text-mist" data-voorbeeld aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- 5. REVIEWS: letterlijk van Google -->
    <section class="py-20 md:py-28" aria-labelledby="rev-titel">
      <div class="wrap">
        <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-14">
          <div class="lg:col-span-7">
            <h2 id="rev-titel" class="sr-only">Reviews van klanten</h2>
            <svg viewBox="0 0 48 36" class="h-9 w-12 text-korst" fill="currentColor" aria-hidden="true"><path d="M0 36V22C0 9 7 2 20 0l2 5c-7 2-10 6-10 12h8v19Zm26 0V22C26 9 33 2 46 0l2 5c-7 2-10 6-10 12h8v19Z"/></svg>
            <blockquote class="rijs mt-6">
              <p class="kop text-[clamp(1.6rem,2.2vw+1rem,2.75rem)] leading-[1.15]">{j.tekst}</p>
              <footer class="mt-6 text-sm font-semibold text-grijs">{j.naam}, Google review</footer>
            </blockquote>
          </div>
          <div class="lg:col-span-4 lg:col-start-9 lg:pt-16">
            <ul class="divide-y divide-lijn border-y border-lijn">
              {[mariska, plonie, ingrid, folkert].map((r, i) => (
                <li class="rijs py-6" style={`--d:${i * 0.08}s`}>
                  <p class="flex gap-0.5 text-korst" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</p>
                  <p class="mt-2">{r.tekst}</p>
                  <p class="mt-2 text-sm text-grijs">{r.naam}, Google review</p>
                </li>
              ))}
            </ul>
            <p class="mt-6 text-sm"><a href={site.maps} class="link">Alle reviews op Google</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. DE WINKEL: het hoekpand, tijden met live status -->
    <section id="winkel" class="bg-wit" aria-labelledby="winkel-titel">
      <div class="grid lg:grid-cols-2">
        <div class="relative min-h-[22rem] lg:min-h-full">
          <Image quality={56} src={gevel} alt="Het hoekpand van Kaas Vaak in de sneeuw: het ronde uithangbord, de open deur met eikenhouten tonnen en de bakfiets voor de etalage" widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[8%_35%]" />
        </div>
        <div class="px-5 py-16 md:px-10 md:py-24 lg:px-16 xl:px-24">
          <h2 id="winkel-titel" class="rijs text-3xl">Prins Bernhard&shy;laan 50</h2>
          <p class="rijs mt-4 text-lg text-grijs">{site.postcode} {site.plaats}. Het hoekpand met het ronde bord.</p>

          <p class="rijs mt-10 inline-flex items-center gap-2.5 rounded-full bg-wei px-4 py-2 text-sm font-semibold" data-status>
            <span class="h-2.5 w-2.5 rounded-full bg-grijs" data-stip></span><span data-status-tekst>Openingstijden</span>
          </p>
          <table class="rijs num mt-6 w-full max-w-md text-[.9375rem]">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {volgorde.map((i) => { const d = tijden[i]; return (
                <tr class="border-b border-lijn" data-dag={i}>
                  <th scope="row" class="py-2.5 pr-4 text-left font-medium">{d.dag}</th>
                  <td class="py-2.5 text-right">{d.blokken.length ? d.blokken.map(([a, b], k) => <span class="block sm:inline">{k > 0 && <span class="max-sm:hidden"> en </span>}{tijd(a)} - {tijd(b)}</span>) : <span class="text-grijs">gesloten</span>}</td>
                </tr>
              ); })}
            </tbody>
          </table>
          <p class="rijs mt-6 max-w-md text-grijs">Twijfel je of we open zijn, bijvoorbeeld rond een vakantie? Stuur even een appje.</p>
          <div class="rijs mt-8 flex flex-wrap gap-3">
            <a href={waMet('Hallo Kaas Vaak, zijn jullie vandaag open?')} class="knop"><Icoon naam="wa" />Zijn jullie open?</a>
            <a href={site.maps} class="knop knop-donker"><Icoon naam="pin" />Route</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { tijden, tijd, site } from '../data/site';

  // Live status, met de middagpauze. Tijdzone Amsterdam.
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const dag = nu.getDay(); const min = nu.getHours() * 60 + nu.getMinutes();
  document.querySelector(`[data-dag="${dag}"]`)?.classList.add('bg-wei', 'font-bold');
  const st = document.querySelector('[data-status-tekst]'); const stip = document.querySelector('[data-stip]');
  const blok = tijden[dag].blokken.find(([a, b]) => min >= a && min < b);
  let tekst = '';
  if (blok) { tekst = `Nu open, tot ${tijd(blok[1])} uur`; stip?.classList.replace('bg-grijs', 'bg-korst'); }
  else {
    const later = tijden[dag].blokken.find(([a]) => a > min);
    if (later) tekst = `Nu dicht, vandaag weer open om ${tijd(later[0])} uur`;
    else { for (let i = 1; i <= 7; i++) { const d = tijden[(dag + i) % 7]; if (d.blokken.length) { tekst = `Nu gesloten, ${i === 1 ? 'morgen' : d.dag.toLowerCase()} open vanaf ${tijd(d.blokken[0][0])} uur`; break; } } }
  }
  if (st && tekst) st.textContent = tekst;

  // Bestelbon: bouwt een WhatsApp-bericht. Verstuurt zelf niets.
  const bon = document.querySelector<HTMLFormElement>('[data-bon]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const datum = (v: string) => (v ? new Date(v + 'T12:00').toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long' }) : '');
  const bericht = () => {
    if (!bon) return '';
    const f = new FormData(bon);
    const wat = String(f.get('wat') || 'Borrelplank').toLowerCase();
    const r = [`Hallo Kaas Vaak, ik wil graag een ${wat} bestellen.`];
    const voor = String(f.get('voor') || '').trim(); if (voor) r.push(`Voor: ${voor}.`);
    const d = datum(String(f.get('datum') || '')); if (d) r.push(`Graag op ${d}.`);
    r.push(String(f.get('hoe')));
    if (f.get('eigen')) r.push('Ik neem mijn eigen plank of mandje mee.');
    return r.join(' ');
  };
  const toon = () => { if (vb) vb.textContent = `"${bericht()}"`; };
  bon?.addEventListener('input', toon); bon?.addEventListener('change', toon); toon();
  bon?.addEventListener('submit', (e) => { e.preventDefault(); window.open(`${site.wa}?text=${encodeURIComponent(bericht())}`, '_blank', 'noopener'); });
</script>
