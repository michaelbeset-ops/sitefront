---
import '../styles/global.css';
import kopUrl from '@fontsource/encode-sans-expanded/files/encode-sans-expanded-latin-700-normal.woff2?url';
import sansUrl from '@fontsource-variable/encode-sans/files/encode-sans-latin-wght-normal.woff2?url';
import { site, url, tijden } from '../data/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const tijdenJson = JSON.stringify(tijden);
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={kopUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-14 md:pb-0" data-tijden={tijdenJson}>
    {site.voorstel && (
      <div class="relative z-50 bg-inkt text-wit">
        <p class="wrap py-2 text-xs font-medium leading-snug" style="font-family: system-ui, sans-serif">
          Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website.{" "}
          <a href="https://www.sitefront.nl" class="font-bold text-zon underline underline-offset-2">sitefront.nl</a>
        </p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-sm focus:bg-wit focus:px-4 focus:py-2 focus:text-inkt">Naar de inhoud</a>
    <slot />
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.rijs').forEach((el) => io.observe(el));

      // Open of gesloten, Nederlandse tijd. Tijden van hun eigen site.
      const T = JSON.parse(document.body.dataset.tijden || '[]') as ([number, number] | null)[];
      const deel = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', ...o }).format(new Date());
      const dag = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(deel({ weekday: 'short' }));
      const min = Number(deel({ hour: '2-digit', hourCycle: 'h23' })) * 60 + Number(deel({ minute: '2-digit' }));
      const t = (m: number) => `${Math.floor(m / 60)}.${String(m % 60).padStart(2, '0')}`;
      const namen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
      const v = T[dag];
      let tekst: string; let open = false;
      if (v && min >= v[0] && min < v[1]) { open = true; tekst = `Nu bereikbaar, tot ${t(v[1])} uur`; }
      else if (v && min < v[0]) tekst = `Vandaag bereikbaar vanaf ${t(v[0])} uur`;
      else { let i = 1; while (!T[(dag + i) % 7] && i < 7) i++; const d = (dag + i) % 7; tekst = `Nu gesloten, ${i === 1 ? 'morgen' : namen[d]} weer vanaf ${t(T[d]![0])} uur`; }
      document.querySelectorAll<HTMLElement>('[data-status]').forEach((el) => { el.textContent = tekst; el.closest('[data-status-wrap]')?.setAttribute('data-open', String(open)); });
      document.querySelectorAll<HTMLElement>(`[data-dag="${dag}"]`).forEach((el) => el.setAttribute('data-vandaag', ''));
    </script>
  </body>
</html>
