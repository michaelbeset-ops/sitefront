---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['aanbod', 'Aanbod'], ['rolluiken', 'Rolluiken'], ['offerte', 'Offerte'], ['service', 'Service'], ['contact', 'Contact']];
---
<header class="sticky top-0 z-40 border-b border-lijn bg-wit/95 backdrop-blur" data-kop>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6 md:h-20">
    <a href={url('')} class="block shrink-0" aria-label={`${site.naam}, naar de startpagina`}>
      <Image src={logo} alt={site.vol} width={210} height={56} class="h-10 w-auto md:h-12" loading="eager" fetchpriority="high" />
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-grijs no-underline transition-colors duration-200 hover:text-rood">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.mobielHref} class="num hidden text-[.9375rem] font-semibold text-inkt no-underline transition-colors hover:text-rood xl:block">{site.mobiel}</a>
      <a href={waHoi} class="knop knop-rood hidden min-h-11 px-5 md:inline-flex"><Icoon naam="wa" />WhatsApp</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-inkt lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden border-t border-lijn bg-wit lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="kopf block border-b border-lijn py-4 text-2xl font-bold text-inkt no-underline">{t}</a></li>)}
      <li class="pt-6"><a href={site.mobielHref} class="num font-semibold text-grijs no-underline">{site.mobiel}</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-lijn bg-wit md:hidden">
  <a href={site.mobielHref} class="flex min-h-14 items-center justify-center gap-2.5 text-[.9375rem] font-semibold text-inkt no-underline"><Icoon naam="tel" class="h-5 w-5 text-rood" />Bellen</a>
  <a href={waHoi} class="flex min-h-14 items-center justify-center gap-2.5 bg-rood text-[.9375rem] font-semibold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
