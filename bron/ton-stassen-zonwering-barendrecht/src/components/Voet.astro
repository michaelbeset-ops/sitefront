---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site, url, waHoi, plaatsen, groepen } from '../data/site';
const jaar = new Date().getFullYear();
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <span class="inline-block rounded-md bg-wit px-4 py-3"><Image src={logo} alt={site.vol} width={190} height={51} class="h-10 w-auto" /></span>
      <p class="mt-6 max-w-xs">Zonwering, rolluiken, raamdecoratie en buitenleven. Voor particulier, VvE en projecten.</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Aanbod</p>
      <ul class="mt-4 space-y-1.5">
        {groepen.map((g) => <li><a href={url(`#aanbod`)} class="link link-d">{g.titel}</a></li>)}
        <li><a href={url('#rolluiken')} class="link link-d">Rolluiken</a></li>
        <li><a href={url('#service')} class="link link-d">Service en onderhoud</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.mobielHref} class="link link-d num">{site.mobiel}</a></p>
      <p class="mt-1.5"><a href={site.vastHref} class="link link-d num">{site.vast}</a></p>
      <p class="mt-1.5"><a href={waHoi} class="link link-d">WhatsApp</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-d">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Adres</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3">Ma t/m vr 9.00 tot 17.00 uur<br />Za 9.00 tot 16.00 uur</p>
      <p class="mt-3">Levert o.a. in {plaatsen.join(', ')}.</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-d py-7 text-xs">
    <p>© {jaar} {site.vol}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-zon">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten van stassenzonwering.nl en jullie folders. Productbeelden van jullie eigen site en Verano-folders. Bedrijfsbus van jullie Google-profiel; de dakkapel bovenaan is een foto van klant Christiaan R. op Google. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
