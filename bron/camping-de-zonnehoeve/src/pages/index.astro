---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, toer, camper, extras, euro } from '../data/site';
import hero from '../assets/polder-tent.jpg';
import eigenaren from '../assets/anja-gilles.jpg';
import wagenhuis from '../assets/wagenhuis.jpg';
import camperplek from '../assets/camperplek.jpg';
import tentDuin from '../assets/tent-duin.jpg';
import sterren from '../assets/sterren.jpg';
import panelen from '../assets/zonnepanelen.jpg';
import strandje from '../assets/strandje.jpg';
import lucht from '../assets/lucht.jpg';

const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
const mail = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`;

const erkenningen = [
  { jaar: '2000', titel: 'Mooiste boerderij van Zeeland', tekst: 'Daarmee mocht De Zonnehoeve Zeeland vertegenwoordigen bij de landelijke verkiezing.' },
  { jaar: '2003', titel: 'Mooiste boerderij van Nederland', tekst: 'Boerderij van het jaar. Uitgereikt op 25 oktober 2003 in Amersfoort.' },
  { jaar: '2015', titel: 'Vekabo camping van het jaar', tekst: 'Een prijs waar Anja en Gilles erg trots op zijn.' },
  { jaar: '2020', titel: 'ANWB charmecamping', tekst: 'En in hetzelfde jaar ook: ANWB kleine camping 2020.' },
];

const gastenNoemen = ['De rust', 'Grote plaatsen', 'Schoon sanitair', 'Een eigen waterkraan bij de plek', 'Kamperen in de boomgaard', "'s Avonds sterren kijken", 'De geiten', 'Fietsen in de omgeving'];

const speelweide = ['Spelen in een oude tractor', 'Schommelen', 'Koemelken', 'Tafeltennissen', 'Springen op de trampoline'];

const afstanden = [
  { getal: '500 m', naar: 'Grevelingenmeer', tekst: "Wandelen of fietsen langs het water, en 's zomers lekker zwemmen." },
  { getal: '3 km', naar: 'Brouwershaven', tekst: 'Het oude havenstadje.' },
  { getal: 'ca. 10 km', naar: 'Zierikzee', tekst: 'Monumentenstad: beklim de Sint Lievens Monstertoren (Dikke Toren) of maak een stadswandeling via VVV Zierikzee.' },
];

const uitjes = [
  { kop: 'Op het water', items: ['Zeehondensafari of rondvaart op de Grevelingen', 'Op de Oosterschelde vanaf Burgh Sluis met MS-Onrust', 'Op de Oosterschelde vanaf Zierikzee met Frisia rondvaarten'] },
  { kop: 'Uitstapjes', items: ['Plompe Toren: de sage van de zeemeermin over het verdronken dorp Koudekerke', 'Deltapark Neeltje Jans: beleef de Deltawerken', 'Museum RTM Ouddorp: een ritje met een oude stoom- of dieseltram', 'Watersnoodmuseum'] },
  { kop: 'Uit eten', items: ["d'Ouwe Smisse, puur proeflokaal in Zonnemaire", "Beachclub Perry's aan de Brouwersdam"] },
];
---
<Base
  title="Landschapscamping De Zonnehoeve | Kamperen op een Zeeuwse boerderij in Zonnemaire"
  description="Landschapscamping bij een 18e-eeuwse Zeeuwse boerderij op Schouwen-Duiveland. Plaatsen van 300 tot 400 m², toer-, camper- en seizoensplaatsen, stiltetuin. Open 20 maart t/m 18 oktober 2026."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: schuurzwart vlak, weidse foto rechts, en een lichte kaart met de bewijzen die over de rand schuift. -->
    <section class="donker relative bg-schuur text-white">
      <div class="relative aspect-[4/3] overflow-hidden sm:aspect-[16/8] lg:absolute lg:inset-y-0 lg:right-0 lg:aspect-auto lg:w-[60%]">
        <Foto src={hero} alt="Een tent op een grasvlakte aan het water, met een vrouw en twee kinderen in het avondlicht" hero sizes="(min-width: 1024px) 60vw, 100vw" />
        <div class="absolute inset-0 hidden bg-[linear-gradient(90deg,var(--color-schuur)_0%,#1b1c1dd9_14%,#1b1c1d00_48%)] lg:block"></div>
      </div>
      <div class="wrap relative grid pt-9 pb-24 sm:pt-12 lg:min-h-[660px] lg:grid-cols-12 lg:items-center lg:pt-16 lg:pb-36">
        <div class="lg:col-span-6">
          <p class="kicker text-zon">Zonnemaire, Schouwen-Duiveland</p>
          <h1 class="mt-4 text-4xl">Kamperen in een zee van natuur</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">Een typisch Zeeuwse boerderij uit de 18e eeuw, met grote zwarte houten schuren. Veel ruimte en groen, plaatsen van 300 tot 400 m², een stiltetuin en 's nachts een prachtige sterrenhemel.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#tarieven" class="btn btn-zon">Reken uw verblijf uit</a>
            <a href={site.telHref} class="btn btn-line"><Fragment set:html={tel} /><span>Bel <span class="num">{site.tel}</span></span></a>
          </div>
        </div>
        <figure class="absolute top-14 right-8 hidden w-[260px] rounded-xl bg-paper p-2 text-ink shadow-lg xl:block">
          <div class="aspect-[3/2] overflow-hidden rounded-md"><Foto src={wagenhuis} alt="Het oude wagenhuis van de boerderij: een zwart houten gebouw met rode pannen, nu het toiletgebouw" widths={[300]} sizes="244px" /></div>
          <figcaption class="px-1.5 pt-2 pb-1 font-display text-xs font-semibold">Het oude wagenhuis, nu het toiletgebouw</figcaption>
        </figure>
      </div>
      <div class="relative bg-[linear-gradient(to_bottom,var(--color-schuur)_50%,var(--color-paper)_50%)]">
        <div class="wrap">
          <dl class="-mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-line text-ink shadow-lg lg:grid-cols-4">
            <div class="bg-paper p-5 sm:p-6"><dt class="kicker text-ink-soft">Google</dt><dd class="mt-2"><span class="num text-2xl font-extrabold">{site.google}</span> <span class="block text-sm text-ink-soft sm:inline">uit {site.reviews} reviews</span></dd></div>
            <div class="bg-paper p-5 sm:p-6"><dt class="kicker text-ink-soft">Plaatsen</dt><dd class="mt-2"><span class="num text-2xl font-extrabold">300-400</span><span class="text-sm text-ink-soft"> m²</span></dd></div>
            <div class="bg-paper p-5 sm:p-6"><dt class="kicker text-ink-soft">Open in 2026</dt><dd class="mt-2 font-display text-lg leading-tight font-bold">20 maart t/m 18 oktober</dd></div>
            <div class="bg-zon p-5 sm:p-6"><dt class="kicker">Toerplaats</dt><dd class="mt-2"><span class="text-sm">vanaf</span> <span class="num text-2xl font-extrabold">{euro(toer[0])}</span> <span class="text-sm">p.n.</span></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- De boerderij: eigen foto van Anja en Gilles groot, verhaal ernaast, erkenningen als tijdlijn. -->
    <section id="boerderij" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5 lg:pt-4">
          <p class="kicker text-zee">De boerderij</p>
          <h2 class="mt-3 text-3xl">Alle kenmerken van het boerenleven zijn gebleven</h2>
          <p class="mt-6 text-lg">Op het zonnige Schouwen-Duiveland ligt de authentieke boerderij De Zonnehoeve. Een typisch Zeeuwse boerderij uit de 18e eeuw met een rustieke uitstraling.</p>
          <p class="mt-4 text-ink-soft">De grootse opzet met veel ruimte en groen is een weldaad voor bewoners en gasten. Er zijn schapen, kippen, ganzen en katten op de boerderij, en naast boerenerf en camping wordt een natuurgebied van 2 hectare beheerd.</p>
          <blockquote class="mt-8 border-l-4 border-zon pl-5">
            <p class="font-display text-xl leading-snug font-semibold tracking-[-0.01em]">"Bij deze grote Zeeuwse boerderij gaan verleden, heden en toekomst op voorbeeldige wijze hand in hand."</p>
            <footer class="mt-3 text-sm text-ink-soft">Uit het juryrapport, Boerderij van het jaar 2003</footer>
          </blockquote>
        </div>
        <figure class="lg:col-span-7">
          <div class="aspect-[16/10] overflow-hidden rounded-xl shadow-sm"><Foto src={eigenaren} alt="Anja en Gilles van der Bijl voor de bakstenen stal van hun boerderij, met het bordje Vekabo camping van het jaar 2015" sizes="(min-width: 1216px) 680px, (min-width: 1024px) 56vw, 100vw" /></div>
          <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 text-sm text-ink-soft"><span><strong class="font-display text-ink">{site.eigenaren}</strong></span><span>Met het bordje Vekabo camping van het jaar 2015</span></figcaption>
        </figure>
      </div>

      <div class="wrap mt-16 lg:mt-20">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-line pt-10">
          <h3 class="text-2xl">Prijzen en erkenningen</h3>
          <p class="text-sm text-ink-soft">De boerderij is uitgeroepen tot mooiste boerderij van Nederland.</p>
        </div>
        <ol class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-line lg:grid-cols-4">
          {erkenningen.map((e) => (
            <li class="bg-paper p-4 transition-colors hover:bg-kalk sm:p-6">
              <p class="num text-3xl leading-none font-extrabold tracking-[-0.04em] text-ink sm:text-getal">{e.jaar}</p>
              <h4 class="mt-3 font-display text-base leading-snug font-bold sm:mt-4 sm:text-lg">{e.titel}</h4>
              <p class="mt-2 text-sm text-ink-soft">{e.tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Plaatsen: polderlucht, grote foto's, drie soorten plaatsen als lijst met prijs-aanzet. -->
    <section id="plaatsen" class="scroll-mt-20 bg-polder py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-zee">Plaatsen</p>
            <h2 class="mt-3 text-3xl">Ruimte: plaatsen van 300 tot 400 m²</h2>
          </div>
          <p class="text-lg text-ink-soft lg:col-span-5">Er zijn seizoensplaatsen, toerplaatsen en camperplaatsen. De grootse opzet met veel ruimte en groen is een weldaad voor bewoners en gasten.</p>
        </div>

        <div class="mt-12 grid gap-4 lg:grid-cols-12 lg:gap-6">
          <figure class="lg:col-span-7">
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:aspect-[7/5]"><Foto src={tentDuin} alt="Een tent met twee kampeerstoelen op een grasveld tussen struiken, in zacht avondlicht" sizes="(min-width: 1216px) 680px, (min-width: 1024px) 56vw, 100vw" /></div>
          </figure>
          <figure class="relative lg:col-span-5">
            <div class="aspect-square max-w-[655px] overflow-hidden rounded-xl shadow-sm lg:aspect-auto lg:h-full"><Foto src={camperplek} alt="Een camperplek op De Zonnehoeve: twee stoelen en een tafeltje op het gras, met uitzicht over de velden" widths={[480, 655]} sizes="(min-width: 1024px) 460px, 100vw" /></div>
            <figcaption class="absolute bottom-3 left-3 rounded-md bg-schuur/90 px-2.5 py-1 font-display text-xs font-semibold text-white">Camperplek op De Zonnehoeve</figcaption>
          </figure>
        </div>

        <ol class="mt-10 grid gap-px overflow-hidden rounded-xl bg-line shadow-sm md:grid-cols-3">
          <li class="bg-kalk p-6 sm:p-7">
            <p class="num text-sm font-bold text-ink-soft">01</p>
            <h3 class="mt-2 text-xl">Toerplaatsen</h3>
            <p class="mt-3 text-ink-soft">Tarief per aantal personen, per nacht, inclusief auto, kampeermiddel, toeristenbelasting en stroom.</p>
            <p class="mt-5 border-t border-line pt-4 text-sm">1 persoon <span class="num font-bold">{euro(toer[0])}</span>, 2 personen <span class="num font-bold">{euro(toer[1])}</span></p>
          </li>
          <li class="bg-kalk p-6 sm:p-7">
            <p class="num text-sm font-bold text-ink-soft">02</p>
            <h3 class="mt-2 text-xl">Camperplaatsen</h3>
            <p class="mt-3 text-ink-soft">Ook met uw camper bent u van harte welkom. Er zijn 4 camperplaatsen, elke plaats heeft water en stroom.</p>
            <p class="mt-5 border-t border-line pt-4 text-sm">Camperplaats 1 en 2: <span class="num font-bold">{euro(camper)}</span> per nacht, 1-2 personen</p>
          </li>
          <li class="bg-kalk p-6 sm:p-7">
            <p class="num text-sm font-bold text-ink-soft">03</p>
            <h3 class="mt-2 text-xl">Seizoensplaatsen</h3>
            <p class="mt-3 text-ink-soft">Een vaste plek voor het hele seizoen, voor 2 personen. Stroom betaalt u op verbruik.</p>
            <p class="mt-5 border-t border-line pt-4 text-sm"><span class="num font-bold">€ 2100,00</span> voor 2 personen, excl.</p>
          </li>
        </ol>

        <div class="mt-12 grid gap-6 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h3 class="text-xl">Wat gasten in het gastenboek noemen</h3>
            <p class="mt-2 text-sm text-ink-soft">Samenvatting van de 168 reacties in het gastenboek op de huidige website.</p>
          </div>
          <ul class="flex flex-wrap content-start gap-2 lg:col-span-8">
            {gastenNoemen.map((g) => <li class="rounded-lg bg-kalk px-3.5 py-2 font-display text-sm font-semibold shadow-sm">{g}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Tarievencalculator: de echte tarieven 2026. Zonder JS staan alleen de tabellen er (ook altijd zichtbaar onderaan). -->
    <section id="tarieven" class="donker scroll-mt-16 bg-schuur py-16 text-white lg:py-24" data-calc>
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-zon">Tarieven 2026</p>
            <h2 class="mt-3 text-3xl">Wat kost uw verblijf?</h2>
          </div>
          <p class="text-white/85 lg:col-span-5">Kies uw plaats, het aantal personen en nachten en wat u extra meeneemt. U ziet meteen een indicatie op basis van de tarieven 2026.</p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12" hidden data-calc-ui>
          <form class="min-w-0 space-y-7 lg:col-span-7" data-form>
            <fieldset class="min-w-0">
              <legend class="font-display text-lg font-bold">Soort plaats</legend>
              <div class="mt-3 grid grid-cols-2 gap-2">
                <label class="keuze"><input type="radio" class="sr-only" name="soort" value="toer" checked />Toerplaats</label>
                <label class="keuze"><input type="radio" class="sr-only" name="soort" value="camper" />Camperplaats</label>
              </div>
            </fieldset>
            <fieldset class="min-w-0">
              <legend class="font-display text-lg font-bold">Aantal personen</legend>
              <p class="mt-1 text-sm text-white/75" data-pers-uitleg>Inclusief auto, kampeermiddel, toeristenbelasting en stroom.</p>
              <div class="mt-3 grid grid-cols-6 gap-1.5 sm:gap-2">
                {toer.map((_, i) => (
                  <label class="keuze !px-1" data-pers={i + 1}><input type="radio" class="sr-only" name="personen" value={i + 1} checked={i === 1} /><span class="num">{i + 1}</span><span class="sr-only"> {i === 0 ? 'persoon' : 'personen'}</span></label>
                ))}
              </div>
            </fieldset>
            <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl bg-schuur-2 p-4 sm:p-5">
              <div>
                <p class="font-display text-lg font-bold" id="nachten-label">Aantal nachten</p>
                <p class="text-sm text-white/75">Open van {site.open}.</p>
              </div>
              <div class="flex items-center gap-3" role="group" aria-labelledby="nachten-label">
                <button type="button" class="stap" data-stap="nachten" data-d="-1" aria-label="Eén nacht minder">−</button>
                <output class="num w-10 text-center text-2xl font-extrabold" data-waarde="nachten" aria-live="polite">7</output>
                <button type="button" class="stap" data-stap="nachten" data-d="1" aria-label="Eén nacht meer">+</button>
              </div>
            </div>
            <fieldset class="min-w-0">
              <legend class="font-display text-lg font-bold">Extra, per nacht</legend>
              <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                {extras.map((e) => (
                  <li class="flex items-center justify-between gap-3 rounded-xl bg-schuur-2 py-2.5 pr-2.5 pl-4">
                    <span class="min-w-0"><span class="block font-display font-bold" id={`x-${e.id}`}>{e.naam}</span><span class="num text-sm text-white/75">{euro(e.prijs)} p.n.</span></span>
                    <span class="flex items-center gap-2" role="group" aria-labelledby={`x-${e.id}`}>
                      <button type="button" class="stap" data-stap={e.id} data-d="-1" aria-label={`${e.naam}: één minder`}>−</button>
                      <output class="num w-6 text-center text-lg font-bold" data-waarde={e.id} aria-live="polite">0</output>
                      <button type="button" class="stap" data-stap={e.id} data-d="1" aria-label={`${e.naam}: één meer`}>+</button>
                    </span>
                  </li>
                ))}
              </ul>
            </fieldset>
          </form>

          <div class="lg:col-span-5">
            <div class="rounded-xl bg-paper p-6 text-ink shadow-lg sm:p-7 lg:sticky lg:top-24">
              <p class="kicker text-zee">Uw indicatie</p>
              <p class="mt-2 font-display text-lg font-bold" data-kop>Toerplaats, 2 personen, 7 nachten</p>
              <ul class="mt-4 space-y-2 border-t border-line pt-4 text-sm" data-regels></ul>
              <div class="mt-4 flex items-baseline justify-between gap-4 border-t-2 border-ink pt-4">
                <p class="font-display font-bold">Totaal</p>
                <p class="num text-getal leading-none font-extrabold tracking-[-0.04em]" data-totaal aria-live="polite">{euro(toer[1] * 7)}</p>
              </div>
              <p class="mt-4 rounded-lg bg-polder p-3 text-sm">Dit is een indicatie op basis van de tarieven 2026. De camping bevestigt uw prijs bij de reservering.</p>
              <div class="mt-5 flex flex-col gap-2 sm:flex-row lg:flex-col xl:flex-row">
                <a href={`mailto:${site.mail}`} class="btn btn-zee flex-1" data-mail><Fragment set:html={mail} />Mail deze aanvraag</a>
                <a href={site.telHref} class="btn btn-line flex-1 text-ink hover:!bg-schuur hover:!text-white"><Fragment set:html={tel} />Bel</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Volledige tarievenlijst: altijd zichtbaar, ook zonder JavaScript. -->
        <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-xl bg-schuur-2 p-6">
            <h3 class="text-lg">Toerplaatsen</h3>
            <p class="mt-1 text-sm text-white/75">Per nacht, incl. auto, kampeermiddel, toeristenbelasting en stroom.</p>
            <table class="mt-4 w-full text-sm">
              <caption class="sr-only">Tarieven toerplaatsen 2026</caption>
              <tbody>
                {toer.map((p, i) => <tr class="border-b border-white/10"><th scope="row" class="py-2 text-left font-normal">{i + 1} {i === 0 ? 'persoon' : 'personen'}</th><td class="num py-2 text-right font-bold">{euro(p)}</td></tr>)}
                <tr><th scope="row" class="py-2 text-left font-normal">Camperplaats 1 en 2, 1-2 personen</th><td class="num py-2 text-right font-bold">{euro(camper)}</td></tr>
              </tbody>
            </table>
          </div>
          <div class="rounded-xl bg-schuur-2 p-6">
            <h3 class="text-lg">Extra</h3>
            <p class="mt-1 text-sm text-white/75">Per nacht.</p>
            <table class="mt-4 w-full text-sm">
              <caption class="sr-only">Extra's per nacht 2026</caption>
              <tbody>
                {extras.map((e) => <tr class="border-b border-white/10 last:border-0"><th scope="row" class="py-2 text-left font-normal">{e.id === 'persoon' ? '1 persoon' : e.naam}</th><td class="num py-2 text-right font-bold">{euro(e.prijs)}</td></tr>)}
              </tbody>
            </table>
          </div>
          <div class="rounded-xl bg-paper p-6 text-ink shadow-sm md:col-span-2 lg:col-span-1">
            <p class="kicker text-zee">Apart tarief</p>
            <h3 class="mt-2 text-lg">Seizoensplaats</h3>
            <table class="mt-4 w-full text-sm">
              <caption class="sr-only">Tarieven seizoensplaats 2026</caption>
              <tbody>
                <tr class="border-b border-line"><th scope="row" class="py-2 text-left font-normal">Seizoensplaats, voor 2 personen (excl.)</th><td class="num py-2 text-right font-bold">€ 2100,00</td></tr>
                <tr class="border-b border-line"><th scope="row" class="py-2 text-left font-normal">Hond</th><td class="num py-2 text-right font-bold">€ 50,00</td></tr>
                <tr class="border-b border-line"><th scope="row" class="py-2 text-left font-normal">Toeristenbelasting</th><td class="num py-2 text-right"><span class="font-bold">€ 2,06</span> p.p.p.n.</td></tr>
                <tr class="border-b border-line"><th scope="row" class="py-2 text-left font-normal">Stroom, wat u verbruikt</th><td class="num py-2 text-right"><span class="font-bold">€ 0,60</span> per kWh</td></tr>
                <tr><th scope="row" class="py-2 text-left font-normal">Stalling</th><td class="py-2 text-right font-bold"><span class="num">€ 305,00</span> <span class="num">t/m € 350,00</span></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <script>
      // Tarievencalculator met de tarieven 2026 van de eigen site. Alleen een indicatie; verstuurt niets.
      const sectie = document.querySelector<HTMLElement>('[data-calc]');
      if (sectie) {
        const TOER = [3300, 3800, 4500, 5200, 5900, 6600];
        const CAMPER = 3300;
        const EXTRA: Record<string, { naam: string; prijs: number }> = {
          hond: { naam: 'Hond', prijs: 350 }, auto: { naam: 'Extra auto', prijs: 400 }, tentgroot: { naam: 'Tent groot', prijs: 700 },
          tentklein: { naam: 'Tent klein', prijs: 450 }, caravan: { naam: 'Caravan', prijs: 700 }, persoon: { naam: 'Extra persoon', prijs: 800 },
        };
        const MAX: Record<string, number> = { nachten: 60, hond: 4, auto: 3, tentgroot: 3, tentklein: 3, caravan: 2, persoon: 6 };
        const MIN: Record<string, number> = { nachten: 1 };
        const tel: Record<string, number> = { nachten: 7, hond: 0, auto: 0, tentgroot: 0, tentklein: 0, caravan: 0, persoon: 0 };
        const euro = (c: number) => '€ ' + (c / 100).toFixed(2).replace('.', ',');
        const ui = sectie.querySelector<HTMLElement>('[data-calc-ui]')!;
        const form = sectie.querySelector<HTMLFormElement>('[data-form]')!;
        const kop = sectie.querySelector<HTMLElement>('[data-kop]')!;
        const regels = sectie.querySelector<HTMLElement>('[data-regels]')!;
        const totaal = sectie.querySelector<HTMLElement>('[data-totaal]')!;
        const mailKnop = sectie.querySelector<HTMLAnchorElement>('[data-mail]')!;
        const mailBasis = mailKnop.getAttribute('href')!;
        ui.hidden = false;
        form.addEventListener('submit', (e) => e.preventDefault());

        const regel = (links: string, rechts: string) => {
          const li = document.createElement('li');
          li.className = 'flex justify-between gap-4';
          const a = document.createElement('span'); a.textContent = links;
          const b = document.createElement('span'); b.className = 'num font-bold'; b.textContent = rechts;
          li.append(a, b); return li;
        };

        const bijwerken = () => {
          const soort = (form.querySelector<HTMLInputElement>('input[name=soort]:checked')!).value;
          const persInputs = [...form.querySelectorAll<HTMLInputElement>('input[name=personen]')];
          persInputs.forEach((i) => { const uit = soort === 'camper' && +i.value > 2; i.disabled = uit; i.closest('label')!.classList.toggle('opacity-35', uit); });
          let pers = +(form.querySelector<HTMLInputElement>('input[name=personen]:checked')?.value || 2);
          if (soort === 'camper' && pers > 2) { pers = 2; persInputs[1].checked = true; }
          sectie.querySelector<HTMLElement>('[data-pers-uitleg]')!.textContent = soort === 'camper'
            ? 'Camperplaats 1 en 2: één tarief voor 1-2 personen.'
            : 'Inclusief auto, kampeermiddel, toeristenbelasting en stroom.';
          const n = tel.nachten;
          const basis = soort === 'camper' ? CAMPER : TOER[pers - 1];
          const naam = soort === 'camper' ? 'Camperplaats' : 'Toerplaats';
          const persTekst = `${pers} ${pers === 1 ? 'persoon' : 'personen'}`;
          const nTekst = `${n} ${n === 1 ? 'nacht' : 'nachten'}`;
          kop.textContent = `${naam}, ${persTekst}, ${nTekst}`;
          regels.replaceChildren();
          let som = basis * n;
          regels.append(regel(`${naam} ${euro(basis)} × ${n}`, euro(basis * n)));
          const mailRegels = [`${naam}, ${persTekst}, ${nTekst}: ${euro(basis * n)}`];
          for (const [id, x] of Object.entries(EXTRA)) {
            const k = tel[id];
            if (!k) continue;
            const bedrag = x.prijs * k * n;
            som += bedrag;
            regels.append(regel(`${k} × ${x.naam.toLowerCase()} ${euro(x.prijs)} × ${n}`, euro(bedrag)));
            mailRegels.push(`${k} x ${x.naam.toLowerCase()}: ${euro(bedrag)}`);
          }
          totaal.textContent = euro(som);
          const body = `Beste Anja en Gilles,\n\nIk wil graag reserveren:\n${mailRegels.join('\n')}\nIndicatie totaal: ${euro(som)}\n\nAankomstdatum: \nNaam: \nTelefoon: \n`;
          mailKnop.href = `${mailBasis}?subject=${encodeURIComponent('Reservering ' + naam.toLowerCase())}&body=${encodeURIComponent(body)}`;
          sectie.querySelectorAll<HTMLButtonElement>('[data-stap]').forEach((b) => {
            const id = b.dataset.stap!; const d = +b.dataset.d!;
            b.disabled = d < 0 ? tel[id] <= (MIN[id] ?? 0) : tel[id] >= MAX[id];
          });
          sectie.querySelectorAll<HTMLElement>('[data-waarde]').forEach((o) => { o.textContent = String(tel[o.dataset.waarde!]); });
        };

        sectie.addEventListener('click', (e) => {
          const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-stap]');
          if (!b || b.disabled) return;
          const id = b.dataset.stap!;
          tel[id] = Math.min(MAX[id], Math.max(MIN[id] ?? 0, tel[id] + +b.dataset.d!));
          bijwerken();
        });
        form.addEventListener('change', bijwerken);
        bijwerken();
      }
    </script>

    <!-- Stilte en sterren: de foto draagt het verhaal. -->
    <section class="donker relative isolate overflow-hidden bg-schuur text-white">
      <div class="absolute inset-0 -z-10"><Foto src={sterren} alt="" sizes="100vw" /></div>
      <div class="absolute inset-0 -z-10 bg-schuur/35 lg:bg-[linear-gradient(90deg,#1b1c1db3_0%,#1b1c1d40_50%,#1b1c1d00_100%)]"></div>
      <div class="wrap grid py-28 lg:grid-cols-12 lg:py-44">
        <div class="lg:col-span-6">
          <p class="kicker text-zon">Stiltetuin</p>
          <h2 class="mt-3 text-3xl">In de stiltetuin voelt u de rust</h2>
          <p class="mt-6 text-lg text-white/90">En 's nachts kunt u er genieten van een prachtige sterrenhemel.</p>
          <p class="mt-3 text-sm text-white/75">Sfeerfoto van een sterrenhemel.</p>
        </div>
      </div>
    </section>

    <!-- Faciliteiten en kinderen: twee lijsten naast elkaar, kleine eigen foto op eigen formaat. -->
    <section id="faciliteiten" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-zee">Faciliteiten</p>
          <h2 class="mt-3 text-3xl">Het oude wagenhuis dient nu als toiletgebouw</h2>
          <ul class="mt-8 border-t border-line">
            <li class="grid gap-1 border-b border-line py-4 sm:grid-cols-[11rem_1fr] sm:gap-6"><span class="font-display font-bold">Schuur</span><span class="text-ink-soft">Een koelkast en vriezer tot uw beschikking.</span></li>
            <li class="grid gap-1 border-b border-line py-4 sm:grid-cols-[11rem_1fr] sm:gap-6"><span class="font-display font-bold">Het 'kachelkot'</span><span class="text-ink-soft">Een wasmachine en droger waar u gebruik van kunt maken.</span></li>
            <li class="grid gap-1 border-b border-line py-4 sm:grid-cols-[11rem_1fr] sm:gap-6"><span class="font-display font-bold">Informatiebulletin</span><span class="text-ink-soft">In het toiletgebouw, met de activiteiten die er in de omgeving plaatsvinden.</span></li>
            <li class="grid gap-1 border-b border-line py-4 sm:grid-cols-[11rem_1fr] sm:gap-6"><span class="font-display font-bold">Camperplaatsen</span><span class="text-ink-soft">4 plaatsen, elk met water en stroom.</span></li>
          </ul>
          <figure class="mt-8 max-w-[300px] xl:hidden">
            <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm"><Foto src={wagenhuis} alt="Het oude wagenhuis van de boerderij: een zwart houten gebouw met rode pannen, nu het toiletgebouw" widths={[300]} sizes="300px" /></div>
            <figcaption class="mt-2 text-sm text-ink-soft">Het oude wagenhuis.</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rounded-xl bg-polder p-6 shadow-sm sm:p-8">
            <p class="kicker text-zee">Voor kinderen</p>
            <h3 class="mt-2 text-2xl">In de speelweide kun je</h3>
            <ul class="mt-5 space-y-2.5">
              {speelweide.map((s) => <li class="flex items-center gap-3"><span class="h-2.5 w-2.5 flex-none rounded-full bg-zee" aria-hidden="true"></span>{s}</li>)}
            </ul>
            <p class="mt-6 border-t border-line pt-5 text-ink-soft">Er zijn ook een aantal dieren op de boerderij: schapen, kippen, ganzen en katten.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Zonne-energie: eigen foto groot, feiten ernaast. -->
    <section class="bg-polder py-16 lg:py-24">
      <div class="wrap grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <figure class="lg:col-span-7">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={panelen} alt="De zwarte damwandschuur met zonnepanelen op het dak, met ervoor een gazon en een ronde haag" widths={[480, 800, 1024]} sizes="(min-width: 1216px) 680px, (min-width: 1024px) 56vw, 100vw" /></div>
          <figcaption class="mt-3 text-sm text-ink-soft">Zonnepanelen op het dak van de damwandschuur.</figcaption>
        </figure>
        <div class="lg:col-span-5">
          <p class="kicker text-zee">Zonne-energie</p>
          <h2 class="mt-3 text-3xl">De Zonnehoeve gaat voor zonne-energie</h2>
          <p class="mt-6 text-lg">In september 2012 zijn er zonnepanelen geplaatst op het dak van de damwandschuur.</p>
          <p class="mt-4 text-ink-soft">De opgewekte energie wordt gebruikt voor de stroom op de camping, de verlichting en de boerderij, zoals voor de ventilatoren voor het bewaren van de aardappelen en uien. De teveel geproduceerde energie wordt teruggeleverd aan het elektriciteitsnet.</p>
          <p class="mt-6 border-t border-line pt-4 text-sm text-ink-soft">Mede mogelijk gemaakt door een bijdrage uit het Europees Landbouwfonds voor Plattelandsontwikkeling.</p>
        </div>
      </div>
    </section>

    <!-- Omgeving: afstanden als grote getallen, dan de uitjes in drie kolommen. -->
    <section id="omgeving" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-zee">Omgeving</p>
            <h2 class="mt-3 text-3xl">Op 500 meter van het Grevelingenmeer</h2>
          </div>
          <p class="text-ink-soft lg:col-span-5">De Zonnehoeve is 'gastheer van de Grevelingen'. Anja heeft hier een cursus voor gevolgd en kan u van alles vertellen over wat er te zien en te doen is.</p>
        </div>

        <ol class="mt-12 grid gap-px overflow-hidden rounded-xl bg-line md:grid-cols-3">
          {afstanden.map((a) => (
            <li class="bg-paper p-6 sm:p-7">
              <p class="num text-3xl leading-none font-extrabold tracking-[-0.04em]">{a.getal}</p>
              <h3 class="mt-3 text-xl">{a.naar}</h3>
              <p class="mt-2 text-sm text-ink-soft">{a.tekst}</p>
            </li>
          ))}
        </ol>

        <div class="mt-14 grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm"><Foto src={lucht} alt="Weids grasland onder een blauwe lucht met stapelwolken" sizes="(min-width: 1024px) 460px, 100vw" /></div>
            <div class="mt-6 grid gap-5 sm:grid-cols-[auto_1fr] sm:items-start">
              <figure class="max-w-[300px]">
                <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm"><Foto src={strandje} alt="Het strandje van Bommenede aan de Grevelingen, met zeilboten op het water" widths={[300]} sizes="(min-width: 640px) 200px, 300px" /></div>
                <figcaption class="mt-2 text-sm text-ink-soft">Strandje van Bommenede</figcaption>
              </figure>
              <div>
                <h3 class="text-lg">Fietsen en wandelen</h3>
                <p class="mt-2 text-sm text-ink-soft">De Zonnehoeve ligt aan de fietsknooppuntenroute. U kunt ook mooi langs de Grevelingen richting het strand fietsen. Het wandelnetwerk "Langs water en land" beslaat het hele eiland.</p>
              </div>
            </div>
          </div>
          <div class="grid gap-8 sm:grid-cols-2 lg:col-span-7">
            {uitjes.map((u, i) => (
              <div class={i === 1 ? 'sm:row-span-2' : ''}>
                <h3 class="border-b-2 border-ink pb-2 text-lg">{u.kop}</h3>
                <ul class="mt-2">
                  {u.items.map((t) => <li class="border-b border-line py-3 text-ink-soft">{t}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact: reserveren bij Anja en Gilles. -->
    <section id="contact" class="donker scroll-mt-16 bg-schuur py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-zon">Reserveren</p>
          <h2 class="mt-3 text-3xl">Voor reserveringen: {site.eigenaren}</h2>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-zon"><Fragment set:html={tel} /><span>Bel <span class="num">{site.tel}</span></span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line"><Fragment set:html={mail} />Mail ons</a>
          </div>
          <dl class="mt-10 grid gap-6 border-t border-white/20 pt-8 sm:grid-cols-2">
            <div><dt class="text-sm text-white/75">Mobiel</dt><dd><a href={site.telHref} class="num font-display text-xl font-bold underline decoration-zon decoration-2 underline-offset-4">{site.tel}</a></dd></div>
            <div><dt class="text-sm text-white/75">Vast</dt><dd><a href={site.telVastHref} class="num font-display text-xl font-bold underline decoration-zon decoration-2 underline-offset-4">{site.telVast}</a></dd></div>
            <div class="sm:col-span-2"><dt class="text-sm text-white/75">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="font-display text-xl font-bold break-all underline decoration-zon decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          </dl>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rounded-xl bg-schuur-2 p-6 sm:p-8">
            <h3 class="text-xl">Adres</h3>
            <address class="mt-3 text-lg not-italic">{site.voluit}<br />{site.straat}<br />{site.postcode} {site.plaats}<br /><span class="text-white/75">{site.eiland}</span></address>
            <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
            <div class="mt-8 border-t border-white/15 pt-6">
              <p class="text-sm text-white/75">Seizoen 2026</p>
              <p class="mt-1 font-display text-xl font-bold">Open van {site.open}</p>
            </div>
            <p class="mt-6 text-sm text-white/75">Volg De Zonnehoeve op <a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
