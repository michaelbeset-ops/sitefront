---
// Wordmark: hun naam en "Landschapscamping" zoals in de kop van de oude site, met een beeldmerk van
// een zwarte schuur waarachter de zon opkomt.
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const schuur = licht ? '#f8f7f2' : '#1b1c1d';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg viewBox="0 0 40 32" class="h-8 w-10 flex-none" aria-hidden="true">
    <circle cx="27" cy="12" r="8.5" fill="#f3c73a" />
    <path d="M2 30V17L13 7l11 10v13z" fill={schuur} />
    <path d="M9 30v-7h8v7" fill="none" stroke={licht ? '#1b1c1d' : '#f8f7f2'} stroke-width="1.6" />
    <path d="M1 30.5h38" stroke={schuur} stroke-width="1.6" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-lg font-extrabold tracking-[-0.03em]">De Zonnehoeve</span>
    <span class={`mt-1 font-display text-[0.6875rem] font-semibold uppercase tracking-[0.18em] ${licht ? 'text-white/75' : 'text-ink-soft'}`}>Landschapscamping</span>
  </span>
</span>
