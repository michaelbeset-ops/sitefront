---
import { site, url } from '../data/site';
import Logo from './Logo.astro';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const tel = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>`;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="text-ink no-underline"><Logo /></a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 font-display text-sm font-semibold">
          <li><a href="#boerderij" class="no-underline transition-colors hover:text-zee">De boerderij</a></li>
          <li><a href="#plaatsen" class="no-underline transition-colors hover:text-zee">Plaatsen</a></li>
          <li><a href="#tarieven" class="no-underline transition-colors hover:text-zee">Tarieven</a></li>
          <li><a href="#omgeving" class="no-underline transition-colors hover:text-zee">Omgeving</a></li>
          <li><a href="#contact" class="no-underline transition-colors hover:text-zee">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-zee !px-3.5 !py-2.5 sm:!px-4"><Fragment set:html={tel} /><span class="sr-only">Bel </span><span class="num sr-only sm:not-sr-only">{site.tel}</span></a>
    </div>
  </header>
) : (
  <footer class="donker bg-schuur py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <div class="md:col-span-5">
        <span class="text-white"><Logo licht /></span>
        <p class="mt-5">{site.straat}, {site.postcode} {site.plaats}<br />{site.eiland}</p>
      </div>
      <p class="md:col-span-4">KvK [[AANLEVEREN: KvK-nummer]]<br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a><br /><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs text-white/75">Sfeerfoto's via Unsplash en foto's van de huidige website, ter illustratie. Bij oplevering vervangen we ze door nieuwe eigen foto's.</p>}
  </footer>
)}
