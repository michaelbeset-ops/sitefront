---
import { site, url } from '../data/site';
---
<footer class="donker bg-leer text-licht">
  <div class="wrap pb-10 pt-20 md:pt-28">
    <p class="woordmerk overflow-hidden text-[clamp(1.05rem,4.2vw,3.6rem)]" aria-hidden="true">Schoenmaker Toon</p>
    <div class="mt-16 grid gap-10 border-t border-lijn-licht pt-10 text-sm text-licht-zacht sm:grid-cols-2 md:mt-24 md:grid-cols-12">
      <p class="md:col-span-4">
        <span class="text-licht">{site.naam}</span><br />
        {site.straat}<br />
        {site.postcode} {site.plaats}
      </p>
      <p class="md:col-span-3">
        <a href={site.telHref} class="lijn-in num whitespace-nowrap text-licht">{site.tel}</a><br />
        <a href={site.wa} class="lijn-in">WhatsApp</a><br />
        <a href={site.maps} class="lijn-in">Route</a>
      </p>
      <p class="md:col-span-5">
        KvK [[AANLEVEREN: KvK-nummer]]<br />
        <a href={url('privacy/')} class="lijn-in">Privacyverklaring</a>
        {site.voorstel && <><br /><span class="mt-4 block">Foto's van uw Google-bedrijfsprofiel, ter illustratie.</span></>}
      </p>
    </div>
  </div>
</footer>
