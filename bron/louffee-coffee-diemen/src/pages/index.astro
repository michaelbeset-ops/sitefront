---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, url, wa, waMet, hart } from '../data/site';
import glas from '../assets/glas.jpg';
import kassa from '../assets/kassa.jpg';
import latteArt from '../assets/latte-art.jpg';
import espresso from '../assets/espresso.jpg';
import binnen from '../assets/binnen.jpg';
import bar from '../assets/bar.jpg';
import terras from '../assets/terras.jpg';

// De drie lagen van hun eigen latte macchiato (glas.jpg): hoogte van het midden van elke laag en de linkerrand van
// het glas op die hoogte, in procenten van de foto (1440 x 810).
const lagen = [
  { woord: 'Schuim,', top: 28, rand: 41.4 },
  { woord: 'espresso,', top: 47.5, rand: 42.4 },
  { woord: 'melk.', top: 67, rand: 43.4 },
];

const kaart: [string, string][] = [
  ['Espresso', 'in glas'],
  ['Cappuccino', ''],
  ['Latte', ''],
  ['Latte macchiato', 'in lagen'],
  ['Matcha', 'sterkte en zoet naar keuze'],
  ['Chai', ''],
  ['IJskoffie', 'met slagroom'],
];

const dagen: [number, string, string][] = [
  [1, 'maandag', '08:00 - 18:00'],
  [2, 'dinsdag', '08:00 - 18:00'],
  [3, 'woensdag', '08:00 - 18:00'],
  [4, 'donderdag', '08:00 - 18:00'],
  [5, 'vrijdag', '08:00 - 18:00'],
  [6, 'zaterdag', '09:30 - 18:00'],
  [0, 'zondag', '09:30 - 18:00'],
];

const sterktes = [['1', 'mild'], ['2', 'middel'], ['3', 'sterk']];
const zoet = [['0', 'niet'], ['1', 'een beetje'], ['2', 'zoet']];
const matchaTekst = 'ik kom straks langs voor een matcha: middel sterk, een beetje zoet.';
---
<Base title="Louffee Coffee | Espressobar in Diemen" description="Espresso, latte macchiato, matcha en chai aan de Dalsteindreef in Diemen. Elke dag open, met plek om te werken of te studeren.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- Opening: hun eigen glas, met de drie lagen benoemd -->
    <section class="relative h-[34rem] overflow-hidden bg-espresso text-white md:h-auto md:aspect-[16/9]">
      <Foto src={glas} hero sizes="(min-width: 768px) 100vw, 250vw" alt="Latte macchiato in een hoog glas op een houten tafel bij Louffee Coffee: melk, een laag espresso en schuim." class="absolute inset-0 object-[37%_50%] md:object-center" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,#140f0c99_0%,#140f0c40_32%,#140f0c00_48%)]" aria-hidden="true"></div>
      <h1 class="absolute inset-0">
        <span class="sr-only">Louffee Coffee in Diemen. Latte macchiato in drie lagen:</span>
        {lagen.map((l) => (
          <span class="laag absolute left-5 flex -translate-y-1/2 items-center gap-3 md:left-[4.5vw] md:gap-5" style={`top:${l.top}%;--rand:${l.rand}%`}>
            <span class="woord whitespace-nowrap leading-none [text-shadow:0_2px_24px_#0006]">{l.woord}</span>
            <span class="hidden h-px min-w-6 flex-1 bg-white/70 md:block" aria-hidden="true"></span>
            <span class="hidden h-2 w-2 shrink-0 rounded-full bg-white md:block" aria-hidden="true"></span>
          </span>
        ))}
      </h1>
      <p class="absolute bottom-4 left-5 text-xs text-white/90 [text-shadow:0_1px_8px_#000a] md:bottom-7 md:left-[4.5vw] md:text-sm">Latte macchiato aan de Dalsteindreef, Diemen</p>
    </section>

    <!-- Melklaag -->
    <section class="wrap grid gap-10 py-16 md:grid-cols-12 md:py-28">
      <h2 class="text-3xl md:col-span-7">Espressobar in Diemen, zeven dagen per week open.</h2>
      <div class="md:col-span-4 md:col-start-9 md:self-end">
        <p class="max-w-[34ch] text-grijs">Koffie, matcha en chai. Binnen veel plek, buiten een terras, en je laptop mag mee.</p>
        <p class="mt-6 text-xl leading-tight md:mt-8"><a href={waMet('we komen met een groep van [aantal] personen, rond [tijd]. Is er plek?')} class="vraag">Kom je met een groep? App even.</a></p>
      </div>
    </section>

    <!-- Op de bon: de oude kassa en de kaart als kassabon -->
    <section id="bon" class="scroll-mt-16 pb-20 md:pb-32">
      <div class="wrap grid items-start gap-y-10 md:grid-cols-12">
        <figure class="md:col-span-7 md:row-start-1">
          <div class="aspect-[1270/901] overflow-hidden bg-espresso"><Foto src={kassa} sizes="(min-width: 768px) 58vw, 100vw" alt="Een oude, donkere kassa met ronde cijfertoetsen en een venster met 'Guldens' en 'Cents', naast een koffiemolen vol bonen." /></div>
          <figcaption class="mt-3 text-sm text-grijs">De oude kassa naast de molen, nog in guldens en cents.</figcaption>
        </figure>
        <div class="relative z-10 md:col-span-5 md:row-start-1 md:-ml-14 md:mt-28 md:pl-0 lg:-ml-20">
          <h2 class="mb-6 text-3xl md:absolute md:-top-28 md:left-[5.5rem] md:mb-0 lg:left-[7rem]">Op de bon</h2>
          <div class="bon-schaduw mx-auto max-w-[26rem] md:mx-0">
            <div class="bon px-6 pb-10 pt-11 text-sm sm:px-8">
              <div class="text-center">
                <svg viewBox="0 0 100 100" class="mx-auto h-8 w-8 text-inkt" aria-hidden="true"><path d={hart} fill="none" stroke="currentColor" stroke-width="5" /></svg>
                <p class="mt-2 font-medium tracking-[.2em]">LOUFFEE COFFEE</p>
                <p class="text-grijs">{site.straat}<br />{site.postcode} {site.plaats}</p>
              </div>
              <div class="streep my-5" aria-hidden="true"></div>
              <ul class="space-y-2.5" aria-label="De kaart">
                {kaart.map(([naam, noot]) => (
                  <li class="flex items-baseline gap-2">
                    <span class="font-medium uppercase">{naam}</span>
                    <span class="stip" aria-hidden="true"></span>
                    {noot && <span class="text-right text-grijs">{noot}</span>}
                  </li>
                ))}
              </ul>
              <div class="streep my-5" aria-hidden="true"></div>
              <p class="text-xs text-grijs">[[AANLEVEREN: volledige kaart, ook eten en gebak]]</p>
              <div class="streep my-5" aria-hidden="true"></div>
              <p class="text-center leading-relaxed">Ma t/m vr 08:00 - 18:00<br />Za en zo 09:30 - 18:00</p>
              <p class="mt-4 text-center tracking-[.2em]">*** TOT ZO ***</p>
            </div>
          </div>
        </div>
      </div>

      <div class="wrap mt-16 grid gap-10 md:mt-24 md:grid-cols-12">
        <figure class="md:col-span-7">
          <div class="aspect-[4/3] overflow-hidden bg-espresso"><Foto src={latteArt} sizes="(min-width: 768px) 58vw, 100vw" alt="Een latte macchiato in glas en een cappuccino met latte art op een wit schoteltje." /></div>
          <figcaption class="mt-3 text-sm text-grijs">Latte macchiato en latte art.</figcaption>
        </figure>
        <figure class="md:col-span-5 md:col-start-8 md:mt-48">
          <div class="aspect-[4/3] overflow-hidden bg-espresso"><Foto src={espresso} sizes="(min-width: 768px) 40vw, 100vw" alt="Espresso in een glazen kopje met een metalen houder, op een glazen schotel met lepeltje." /></div>
          <figcaption class="mt-3 text-sm text-grijs">Espresso, in glas.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Espressoband: matcha, kies je sterkte -->
    <section id="matcha" class="op-donker scroll-mt-16 bg-espresso text-crema">
      <div class="wrap grid gap-12 py-20 md:grid-cols-12 md:grid-rows-[auto_1fr] md:gap-y-16 md:py-32">
        <div class="md:col-span-6">
          <h2 class="text-3xl text-white">Matcha, zo sterk als jij wilt.</h2>
          <p class="mt-6 max-w-[36ch] text-crema-zacht">Sterkte en zoetheid kies je zelf. Liever chai? Kan ook.</p>
        </div>
        <!-- Het toetsenbord als hun kassa: een venster bovenin, daaronder per kolom de toetsen. -->
        <form class="kassa w-full max-w-[24rem] justify-self-start md:col-span-5 md:col-start-8 md:row-span-2 md:justify-self-end" data-matcha onsubmit="return false">
          <div class="grid grid-cols-2 border-[3px] border-[#050403] bg-[#0b0907] text-white" aria-live="polite">
            <div class="px-5 py-4">
              <p class="text-xs text-crema-zacht">Sterkte</p>
              <p class="mt-1 flex items-center gap-3"><svg viewBox="0 0 40 10" class="h-2.5 w-9 text-crema-zacht" aria-hidden="true"><path d="M0 5h36M30 1l6 4-6 4M2 1l4 4-4 4M7 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" /></svg><span class="display text-[2.8rem] leading-none" data-uit="sterkte">2</span></p>
            </div>
            <div class="border-l border-lijn-licht px-5 py-4">
              <p class="text-xs text-crema-zacht">Zoet</p>
              <p class="mt-1 flex items-center gap-3"><svg viewBox="0 0 40 10" class="h-2.5 w-9 text-crema-zacht" aria-hidden="true"><path d="M0 5h36M30 1l6 4-6 4M2 1l4 4-4 4M7 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" /></svg><span class="display text-[2.8rem] leading-none" data-uit="zoet">1</span></p>
            </div>
          </div>
          <div class="grid grid-cols-2 border-x-[3px] border-b-[3px] border-[#050403] bg-[#14100d] px-5 pb-7 pt-6">
            {[['sterkte', 'Sterkte', sterktes, '2'], ['zoet', 'Zoet', zoet, '1']].map(([naam, legend, rij, standaard]) => (
              <fieldset>
                <legend class="sr-only">{legend}</legend>
                <div class="flex flex-col gap-4">
                  {(rij as string[][]).map(([n, w]) => (
                    <label class="flex items-center gap-3.5">
                      <input type="radio" name={naam as string} value={w} data-n={n} class="sr-only" checked={n === standaard} />
                      <span class="toets" aria-hidden="true">{n}</span>
                      <span class="text-xs leading-tight">{w}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>
        </form>
        <div class="md:col-span-6 md:row-start-2 md:self-end">
          <a href={waMet(matchaTekst)} data-matcha-link class="knop !bg-crema !text-espresso hover:!bg-white"><Fragment set:html={wa} />Zet hem klaar via WhatsApp</a>
          <p class="mt-4 max-w-[40ch] text-xs text-crema-zacht">"Hoi Louffee, <span data-matcha-tekst>{matchaTekst}</span>"</p>
        </div>
      </div>
    </section>

    <!-- Binnen: werken en studeren -->
    <section class="py-20 md:py-32">
      <div class="grid items-end gap-10 md:grid-cols-12">
        <figure class="md:col-span-8">
          <div class="aspect-[4/3] overflow-hidden bg-espresso"><Foto src={binnen} sizes="(min-width: 768px) 66vw, 100vw" alt="Interieur van Louffee Coffee: de vitrine aan de bar, houten tafels met leren stoelen, en achterin bij het grote raam mensen met laptops." /></div>
        </figure>
        <div class="px-5 md:col-span-4 md:pr-12 md:pl-2">
          <h2 class="text-3xl">Laptop mee.</h2>
          <p class="mt-6 max-w-[34ch] text-grijs">Veel ruimte binnen, aan lange tafels en bij het raam. Hier wordt gewerkt en gestudeerd, ook door studenten uit Amsterdam.</p>
          <figure class="mt-10 w-3/5 max-w-[15rem]">
            <div class="aspect-[660/940] overflow-hidden bg-espresso"><Foto src={bar} sizes="15rem" alt="De espressomachine op de bar, met zakken Louffee-koffie in wit en zwart ervoor." /></div>
            <figcaption class="mt-3 text-xs text-grijs">Louffee-koffie in eigen zakken, aan de bar.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Langskomen: de bovenste laag, wit als schuim -->
    <section id="langskomen" class="scroll-mt-16 bg-schuim">
      <div class="wrap grid gap-12 py-20 md:grid-cols-12 md:py-28">
        <div class="md:col-span-5">
          <h2 class="text-3xl">Dalsteindreef<br />2037</h2>
          <p class="mt-3 text-grijs">{site.postcode} {site.plaats}. Met terras voor de deur.</p>
          <table class="mt-10 w-full max-w-[24rem] text-sm">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {dagen.map(([n, dag, tijd]) => (
                <tr data-dag={n} class="border-b border-lijn">
                  <th scope="row" class="py-2.5 text-left font-normal">{dag}<span class="vandaag ml-2 hidden text-rood">vandaag</span></th>
                  <td class="py-2.5 text-right tabular-nums">{tijd}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waMet('')} class="knop"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <p class="text-sm">of bel <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a></p>
          </div>
          <p class="mt-8 text-sm text-grijs"><a href={site.maps} class="lijn">Route in Google Maps</a> &middot; {site.google.score} op Google, uit {site.google.aantal} reviews</p>
        </div>
        <figure class="md:col-span-6 md:col-start-7">
          <div class="aspect-[870/1080] overflow-hidden bg-espresso"><Foto src={terras} sizes="(min-width: 768px) 46vw, 100vw" alt="De gevel van Louffee Coffee met het grijze hartvormige uithangbord, en het terras met klaptafeltjes op de bestrating." /></div>
        </figure>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<script>
  import { weekdagInDiemen } from '../scripts/open';
  import { waMet } from '../data/site';

  const rij = document.querySelector(`[data-dag="${weekdagInDiemen()}"]`);
  rij?.querySelector('.vandaag')?.classList.remove('hidden');
  rij?.classList.add('font-medium');

  const form = document.querySelector<HTMLFormElement>('[data-matcha]');
  if (form) {
    const zet = () => {
      const s = form.querySelector<HTMLInputElement>('input[name="sterkte"]:checked')!;
      const z = form.querySelector<HTMLInputElement>('input[name="zoet"]:checked')!;
      form.querySelector('[data-uit="sterkte"]')!.textContent = s.dataset.n!;
      form.querySelector('[data-uit="zoet"]')!.textContent = z.dataset.n!;
      const zoetWoord = z.value === 'niet' ? 'niet zoet' : z.value;
      const tekst = `ik kom straks langs voor een matcha: ${s.value}${s.value === 'middel' ? ' sterk' : ''}, ${zoetWoord}.`;
      document.querySelector('[data-matcha-tekst]')!.textContent = tekst;
      document.querySelector<HTMLAnchorElement>('[data-matcha-link]')!.href = waMet(tekst);
    };
    form.addEventListener('change', zet);
  }
</script>

<style>
  /* De haarlijn van elk woord loopt door tot de rand van het glas. */
  .woord { font-size: clamp(2.1rem, 9.4vw, 2.6rem); }
  @media (min-width: 768px) { .laag { right: calc(100% - var(--rand)); } .woord { font-size: min(7.4vw, 8rem); } }
</style>
