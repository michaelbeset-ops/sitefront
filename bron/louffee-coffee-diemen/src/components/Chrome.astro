---
import { site, url, wa, waMet, hart } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-lijn bg-melk/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-center gap-2.5 text-inkt no-underline">
        <svg viewBox="0 0 100 100" class="h-9 w-9 shrink-0 text-grijs" aria-hidden="true"><path d={hart} fill="currentColor" /><path d={hart} fill="none" stroke="#fff" stroke-width="4.5" transform="translate(50 50) scale(.84) translate(-50 -50)" /></svg>
        <span class="flex flex-col leading-none">
          <span class="display text-[1.6rem] leading-[.9]">Louffee</span>
          <span class="mt-0.5 text-[.62rem] tracking-[.3em] text-grijs">COFFEE</span>
        </span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-9 text-sm">
          <li><a href={url('#bon')} class="no-underline decoration-1 underline-offset-4 hover:underline">Op de bon</a></li>
          <li><a href={url('#matcha')} class="no-underline decoration-1 underline-offset-4 hover:underline">Matcha</a></li>
          <li><a href={url('#langskomen')} class="no-underline decoration-1 underline-offset-4 hover:underline">Langskomen</a></li>
        </ul>
      </nav>
      <a href={waMet('')} class="knop !px-3.5 !py-2.5"><Fragment set:html={wa} /><span class="max-[359px]:sr-only">WhatsApp</span></a>
    </div>
  </header>
) : (
  <footer class="op-donker bg-espresso text-crema">
    <div class="stoep" style="--h:40px" aria-hidden="true"></div>
    <div class="wrap grid gap-10 pb-10 pt-14 text-sm md:grid-cols-12">
      <div class="flex items-center gap-4 md:col-span-5">
        <svg viewBox="0 0 100 100" class="h-16 w-16 shrink-0 text-grijs" aria-hidden="true"><path d={hart} fill="currentColor" /><path d={hart} fill="none" stroke="#ddd6cd" stroke-width="4" transform="translate(50 50) scale(.84) translate(-50 -50)" /></svg>
        <p class="leading-none"><span class="display block text-[3rem] leading-[.85] text-crema">Louffee</span><span class="mt-1 block text-xs tracking-[.3em] text-crema-zacht">COFFEE</span></p>
      </div>
      <p class="md:col-span-4">
        {site.straat}<br />{site.postcode} {site.plaats}<br />
        <a href={waMet('')} class="lijn">WhatsApp</a> of bel <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a><br />
        <a href={site.instagram} class="lijn">Instagram @louffeecoffee</a>
      </p>
      <p class="md:col-span-3 md:text-right">
        KvK <span class="text-xs">[[AANLEVEREN: KvK-nummer]]</span><br />
        <a href={url('privacy/')} class="lijn">Privacyverklaring</a>
      </p>
    </div>
    {site.voorstel && <p class="wrap border-t border-lijn-licht pb-8 pt-6 text-xs text-crema-zacht">Foto's van uw Google-bedrijfsprofiel, ter illustratie.</p>}
  </footer>
)}
