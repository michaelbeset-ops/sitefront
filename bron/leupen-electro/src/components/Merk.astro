---
// Nagetekend naar hun logo (bron/site/img/logo.jpg): vier schuine, doorschijnende vlakken van groen naar blauw die
// samen een plus vormen, met "leupen electro" vet en schuin ernaast.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
const id = donker ? 'lg-d' : 'lg-l';
---
<a href={url('')} class={`inline-flex items-center gap-2.5 leading-none no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <svg viewBox="0 0 62 56" class="h-10 w-auto sm:h-11" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#5aac2c" />
        <stop offset="1" stop-color="#2b5bb8" />
      </linearGradient>
    </defs>
    <g fill={`url(#${id})`} fill-opacity=".8">
      <path d="M11 13h27l-4 26H7z" />
      <path d="M33 4h28l-4 26H29z" />
      <path d="M25 22h28l-4 26H21z" />
      <path d="M10 28h26l-4 26H6z" />
    </g>
  </svg>
  <span class="flex flex-col text-[1.42rem] font-[800] italic leading-[.82] tracking-[-.02em] sm:text-[1.55rem]">
    <span>leupen</span><span>electro</span>
  </span>
  <span class="sr-only">, naar de homepage</span>
</a>
