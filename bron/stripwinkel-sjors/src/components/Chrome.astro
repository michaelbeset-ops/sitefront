---
// Header en footer in één component: de site heeft maar twee pagina's.
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="border-b-[3px] border-ink bg-paper">
    <div class="wrap flex items-center justify-between gap-4 py-3">
      <a href={url('')} class="font-display text-2xl font-black uppercase no-underline [font-stretch:72%]">Sjors</a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href="#nieuw" class="no-underline hover:underline decoration-red decoration-2 underline-offset-4">Net verschenen</a></li>
          <li><a href="#bestellen" class="no-underline hover:underline decoration-red decoration-2 underline-offset-4">Bestellen</a></li>
          <li><a href="#langskomen" class="no-underline hover:underline decoration-red decoration-2 underline-offset-4">Langskomen</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-red !px-3 !py-1.5 !text-base">Bel de winkel</a>
    </div>
  </header>
) : (
  <footer class="border-t-[3px] border-ink bg-paper-deep py-10">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg font-black uppercase [font-stretch:72%]">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
