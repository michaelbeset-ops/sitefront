---
import Foto from '../components/Foto.astro';
import hero from '../assets/hero.jpg';
import lezen from '../assets/lezen.jpg';
import bladeren from '../assets/bladeren.jpg';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site, nieuw } from '../data/site';

const tijden = [
  ['Maandag', 'Gesloten'],
  ['Dinsdag', 'Gesloten'],
  ['Woensdag', '11.00 tot 18.00'],
  ['Donderdag', '11.00 tot 18.00'],
  ['Vrijdag', '11.00 tot 18.00'],
  ['Zaterdag', '10.00 tot 17.30'],
  ['Zondag', '12.00 tot 17.00'],
];
const assortiment = ['Nieuw', 'Small-press', 'Buitenlands', 'Tweedehands', 'Antiquarisch', 'Curiosa', 'Zeefdrukken', 'Posters', 'Originelen'];
---
<Base
  title="Stripwinkel Sjors | Stripwinkel in hartje Dordrecht sinds 1975"
  description="Klein maar goed gevuld: nieuwe, tweedehands en antiquarische strips, small-press, zeefdrukken en originelen. Scheffersplein 1, Dordrecht. Bestellen en versturen kan ook."
>
  <Chrome deel="kop" />
  <main id="inhoud">

    <section class="wrap grid gap-10 pb-14 pt-10 lg:grid-cols-12 lg:pt-16">
      <div class="lg:col-span-8 lg:pr-8">
        <p class="font-semibold text-red-deep">Scheffersplein 1, hartje Dordrecht. Sinds 1975.</p>
        <h1 class="mt-4 text-4xl">De leukste stripwinkel ten zuiden van Amsterdam</h1>
        <p class="mt-6 max-w-[40rem] text-lg">
          Klein maar goed gevuld. Nieuw en tweedehands, buitenlands en antiquarisch, small-press, zeefdrukken, posters en originelen.
          Juist in zo'n kleine winkel kom je net datgene tegen wat je niet zocht.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#nieuw" class="btn btn-red">Net verschenen</a>
          <a href={site.maps} rel="noopener" class="btn btn-paper">Route</a>
        </div>
      </div>

      <aside aria-labelledby="open" class="self-start border-[3px] border-ink bg-white p-6 shadow-hard lg:col-span-4 lg:mt-10">
        <h2 id="open" class="text-2xl">Open</h2>
        <table class="mt-4 w-full text-base">
          <caption class="sr-only">Openingstijden</caption>
          <tbody>
            {tijden.map(([dag, tijd]) => (
              <tr class="border-b border-line last:border-0">
                <th scope="row" class="py-1.5 text-left font-semibold">{dag}</th>
                <td class={`py-1.5 text-right tabular-nums ${tijd === 'Gesloten' ? 'text-ink-soft' : ''}`}>{tijd}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-4 text-sm text-ink-soft">Zondag open, tenzij het warmer is dan 30 graden. En eerlijk is eerlijk: we gaan nooit op tijd open. We zijn altijd te laat.</p>
      </aside>

      <div class="aspect-[16/9] border-[3px] border-ink shadow-hard lg:col-span-12 lg:aspect-[3/1] overflow-hidden"><Foto src={hero} alt="Stripwinkel met volle schappen en kleurrijke albums" hero sizes="(min-width: 1216px) 1150px, 100vw" /></div>
    </section>

    <!-- Net verschenen: de pagina die zij nu elke week met de hand bijwerken, hier als nette lijst. -->
    <section id="nieuw" class="scroll-mt-4 border-y-[3px] border-ink bg-white py-16 lg:py-20">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="text-3xl">Net óf bijna verschenen</h2>
          <p class="text-sm text-ink-soft">Bijgewerkt 25 september 2026</p>
        </div>
        <ol class="mt-10 grid border-t-[3px] border-ink md:grid-cols-2 md:gap-x-12">
          {nieuw.map((b) => (
            <li class="grid grid-cols-[1fr_auto] gap-x-4 border-b border-line py-4">
              <h3 class="text-xl">{b.titel}</h3>
              <p class="row-span-2 self-start whitespace-nowrap font-display text-xl font-black tabular-nums [font-stretch:85%]">€ {b.prijs}</p>
              <p class="text-sm text-ink-soft">{b.makers} · {b.uitvoering}</p>
            </li>
          ))}
        </ol>
        <p class="mt-8 max-w-2xl">Staat jouw album er niet tussen? Vraag het gewoon. We zetten het apart of bestellen het voor je. Prijs-, zetfouten en onverwacht (of snel) uitverkocht voorbehouden.</p>
      </div>
    </section>

    <section class="wrap py-16 lg:py-20">
      <h2 class="sr-only">Assortiment</h2>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 font-display text-3xl font-black uppercase leading-none [font-stretch:72%]">
        {assortiment.map((a, i) => <li class={i % 3 === 1 ? 'text-red' : ''}>{a}</li>)}
      </ul>
      <div class="mt-12 aspect-[16/9] overflow-hidden border-[3px] border-ink md:aspect-[21/8]"><Foto src={lezen} alt="Iemand leest een opengeslagen stripalbum" sizes="(min-width: 1216px) 1150px, 100vw" /></div>
    </section>

    <section id="bestellen" class="scroll-mt-4 bg-ink py-16 text-paper lg:py-20">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Sneller dan een zoekmachine</h2>
          <p class="mt-6 text-lg text-paper/85">
            Zoek je iets speciaals, of heb je geen tijd om langs te komen? Bel of mail ons. Je krijgt persoonlijk antwoord.
            Zelfs als je de titel, de serie of de tekenaar niet weet, is de kans groot dat hier iemand weet wat je bedoelt.
          </p>
          <p class="mt-4 text-paper/85">We staan toch in de winkel, dus we zetten het meteen apart. Thuisbrengen doen we niet, versturen wel. Met een beetje geluk heb je het binnen een week in huis.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.telHref} class="btn btn-red !border-paper">Bel {site.tel}</a>
            <a href={`mailto:${site.mail}`} class="btn btn-paper">Mail ons</a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h3 class="text-2xl">Verzendkosten</h3>
          <dl class="mt-4 divide-y divide-paper/20 border-y border-paper/20">
            <div class="flex justify-between gap-4 py-3"><dt>Past door een Nederlandse brievenbus</dt><dd class="whitespace-nowrap font-bold tabular-nums">€ 4,50</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt>Past niet door de brievenbus</dt><dd class="whitespace-nowrap font-bold tabular-nums">€ 7,50</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt>Buiten Nederland</dt><dd class="font-bold">Vraag het ons</dd></div>
          </dl>
          <p class="mt-4 text-sm text-paper/70">Is het anders, dan laten we het je even weten.</p>
        </div>
      </div>
    </section>

    <section id="langskomen" class="wrap scroll-mt-4 grid gap-10 py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Langskomen</h2>
        <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
        <p class="mt-4"><a href={site.telHref} class="font-bold underline decoration-red decoration-2 underline-offset-4">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="font-bold underline decoration-red decoration-2 underline-offset-4">{site.mail}</a></p>
        <a href={site.maps} rel="noopener" class="btn btn-paper mt-8">Open in Google Maps</a>
      </div>
      <div class="aspect-[4/3] border-[3px] border-ink lg:col-span-6 lg:col-start-7 overflow-hidden"><Foto src={bladeren} alt="Iemand bladert door bakken met strips" sizes="(min-width: 1024px) 560px, 100vw" /></div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
