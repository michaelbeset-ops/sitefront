---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

// Sfeerbeelden van Unsplash, geen eigen foto's van de studio. Daarom nergens een bijschrift als "onze studio".
const unsplash = (id: string, w: number) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${w}&q=70`;
const fotos = {
  hero: 'photo-1524594152303-9fd13543fe6e',
  ballet: 'photo-1758671916868-b853bc18d031',
  studio: 'photo-1756314355464-96764066ed21',
  podium: 'photo-1758670334659-5a58d87fb8d7',
};

// Lesaanbod zoals op pattykemper.nl, alleen gegroepeerd zodat je sneller vindt wat bij je past.
const lessen = [
  ['Ballet', ['Kleuterballet', 'Pre-ballet', 'Klassiek ballet']],
  ['Dans', ['Peuterdans', 'Combi-dance', 'Mixdance', 'Moderne dans', 'Showdance']],
  ['Urban', ['HipHop en Streetdance', 'TikTok dance']],
  ['Fit door dansen', ['Dance Workout', 'Hiphop Dance Workout', '50+ dans']],
  ['Bewegen en ontspannen', ['Pilates', 'Puur Ontspannen', 'Tikva']],
] as const;

const verhaal = [
  ['1993', 'Patty Kemper studeert af aan de dansacademie in Rotterdam.'],
  ['1995', 'Na lesgeven in Alblasserdam en Papendrecht neemt Patty de balletschool over.'],
  ['1998', 'Angela komt als leerling bij Patty dansen.'],
  ['Nu', 'Angela geeft zelf les. Hiphop, urban, African, steps en shape.'],
];

const docenten = [
  ['Patty Kemper', 'Studiohoofd, ballet', 'Studeerde in 1993 af aan de dansacademie in Rotterdam en nam in 1995 de balletschool over.'],
  ['Dagmar Brans', 'Klassiek ballet, jazz en modern, hiphop', 'Opgeleid aan MBO Dans in Goes. Geeft sinds januari 2019 klassiek ballet aan kinderen tot 12 jaar.'],
  ['Angela Quist-Klijn', 'Hiphop, urban, African, steps, shape', 'Danst sinds 1998 bij Patty en heeft haar Aalo-diploma. Ze volgt de opleiding voor Tikva.'],
  ['Carola de Wit', 'Streetdance', 'Geeft sinds januari 2020 streetdance op woensdag.'],
  ['Jasmijn Visser', 'Lessen op woensdag', 'Opgeleid aan MBO Dans in Goes en de HBO-dansopleiding van Lucia Marthas in Amsterdam.'],
];

const waarom = [
  ['De eerste les is gratis', 'Kom kijken en doe mee, zonder dat je je meteen vastlegt.'],
  ['Groepen per leeftijd', 'Je danst in een groep met leeftijdsgenoten.'],
  ['Persoonlijke begeleiding', 'Aandacht voor wat jij nodig hebt.'],
  ['Een ruime studio', 'Genoeg plek om echt te bewegen.'],
  ['Betaalbare prijzen', 'Met korting als je meer lessen per week volgt.'],
  ['Optredens als je wilt', 'Meedoen aan voorstellingen en optredens mag, het hoeft niet.'],
];
---
<Base
  title="2MOVE Papendrecht | Dansles, ballet en pilates voor 3 tot 70+ jaar"
  description="Dans- en ontspanningsstudio 2MOVE in Papendrecht. Peuterdans, ballet, hiphop, 50+ dans en pilates voor 3 tot 70+ jaar. De eerste les is gratis."
>
  <div class="relative">
  <Header overFoto />
  <main id="inhoud">

  <!-- Hero, schermvullende foto met de tekst eroverheen -->
  <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] flex-col overflow-hidden bg-inkt text-kalk md:min-h-[calc(100svh-2.5rem)]" aria-labelledby="hero-kop">
    <img
      src={unsplash(fotos.hero, 1600)}
      srcset={`${unsplash(fotos.hero, 800)} 800w, ${unsplash(fotos.hero, 1200)} 1200w, ${unsplash(fotos.hero, 1600)} 1600w`}
      sizes="100vw"
      alt="Een groep vrouwen danst in een studio met een spiegelwand"
      class="absolute inset-0 -z-10 size-full object-cover"
      fetchpriority="high"
    />
    <!-- Donker verloop onder en links, zodat de tekst op elke plek van de foto leesbaar blijft. -->
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(0deg,rgb(25_22_19/0.92)_0%,rgb(25_22_19/0.55)_45%,rgb(25_22_19/0.25)_100%)]"></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(25_22_19/0.6)_0%,transparent_70%)]"></div>

    <div class="wrap flex flex-1 flex-col justify-end pb-12 pt-32 md:pb-16">
      <p class="label text-roze">Dans- en ontspanningsstudio in Papendrecht</p>
      <h1 id="hero-kop" class="mt-4 max-w-[9ch] text-4xl">Dansen van 3 tot 70<span class="text-roze">+</span></h1>
      <div class="mt-8 grid gap-8 md:grid-cols-[minmax(0,34rem)_auto] md:items-end md:justify-between">
        <p class="text-lg leading-relaxed text-kalk/90">
          Van peuterdans en klassiek ballet tot hiphop, 50+ dans en pilates. Al bijna 40 jaar dansen jong en oud uit Papendrecht, Sliedrecht en Dordrecht bij 2MOVE.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={site.inschrijven} class="knop bg-vermiljoen text-wit hover:bg-kalk hover:text-inkt" rel="noopener">Eerste les gratis<Icon naam="pijl" /></a>
          <a href={site.telefoonLink} class="knop border border-kalk/60 text-kalk hover:bg-kalk hover:text-inkt"><Icon naam="telefoon" />Bel Patty</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lesaanbod als typografische lijst, het aanbod zelf is de blikvanger -->
  <section id="lessen" class="scroll-mt-4 py-20 md:py-28" aria-labelledby="lessen-kop">
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="op lg:sticky lg:top-10 lg:self-start">
        <p class="label text-vermiljoen">Lesaanbod</p>
        <h2 id="lessen-kop" class="mt-4 text-3xl">Zestien lessen. Eén studio.</h2>
        <p class="mt-6 max-w-md text-grijs">
          Om te ontspannen, om je te laten gaan, om mensen te ontmoeten of om aan je lichaam te werken. De groepen zijn ingedeeld per leeftijd, dus je danst met mensen die bij je passen.
        </p>
        <a href={site.inschrijven} class="knop mt-8 bg-inkt text-kalk hover:bg-vermiljoen" rel="noopener">Vraag een proefles aan<Icon naam="pijl" /></a>
      </div>
      <ol class="border-t border-inkt/15">
        {lessen.map(([groep, namen], i) => (
          <li class="op grid grid-cols-[2.25rem_minmax(0,1fr)] items-baseline gap-x-2 gap-y-3 border-b border-inkt/15 py-7 sm:grid-cols-[3rem_11rem_minmax(0,1fr)] sm:gap-6">
            <span class="font-kop text-lg font-extrabold text-vermiljoen" aria-hidden="true">0{i + 1}</span>
            <h3 class="text-xl">{groep}</h3>
            <ul class="col-span-2 grid gap-y-1 font-kop sm:col-span-1 text-2xl font-bold leading-tight tracking-[-0.02em]" style="font-stretch:85%">
              {namen.map((n) => <li>{n}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Het verhaal, bijna 40 jaar en een leerling die docent werd -->
  <section id="verhaal" class="donker scroll-mt-4 bg-inkt py-20 text-kalk md:py-28" aria-labelledby="verhaal-kop">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-20">
      <div class="op order-2 lg:order-1">
        <img
          src={unsplash(fotos.ballet, 1000)}
          srcset={`${unsplash(fotos.ballet, 700)} 700w, ${unsplash(fotos.ballet, 1000)} 1000w`}
          sizes="(min-width: 1024px) 40vw, 100vw"
          alt="Balletdansers oefenen aan de barre in een studio"
          class="aspect-[4/5] w-full object-cover"
          loading="lazy"
          width="1000" height="1250"
        />
      </div>
      <div class="order-1 lg:order-2">
        <p class="label op text-roze">Bijna 40 jaar dans in Papendrecht</p>
        <h2 id="verhaal-kop" class="op mt-4 text-3xl">Van leerling naar docent, bij Patty.</h2>
        <p class="op mt-6 max-w-lg text-kalk/85">
          Al bijna 40 jaar leren kinderen en volwassenen dansen bij deze dansschool in Papendrecht. Angela was een van hen, en staat nu zelf voor de groep.
        </p>
        <ol class="mt-10 border-l border-kalk/25">
          {verhaal.map(([jaar, tekst]) => (
            <li class="op relative pb-8 pl-8 last:pb-0">
              <span class="absolute -left-[5px] top-2 size-2.5 rounded-full bg-roze" aria-hidden="true"></span>
              <p class="font-kop text-2xl font-extrabold text-roze" style="font-stretch:78%">{jaar}</p>
              <p class="mt-1 max-w-md">{tekst}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Pilates, met de foto aflopend tot de rand -->
  <section id="pilates" class="scroll-mt-4 overflow-hidden py-20 md:py-28" aria-labelledby="pilates-kop">
    <div class="wrap grid gap-12 md:grid-cols-[1fr_1fr] md:items-center md:gap-16">
      <div class="op">
        <p class="label text-vermiljoen">Pilates en ontspanning</p>
        <h2 id="pilates-kop" class="mt-4 text-3xl">Pilates, voor elk lichaam.</h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed">
          Pilates is een methode die werkt aan controle, flexibiliteit, coördinatie, kracht en spierspanning.
        </p>
        <p class="mt-6 text-sm font-bold">Geschikt voor</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {['sporters', 'mensen na een blessure', 'ouderen', 'beginners'].map((d) => (
            <li class="rounded-full border border-inkt/25 px-4 py-1.5 text-sm">{d}</li>
          ))}
        </ul>
        <p class="mt-8 max-w-lg text-grijs">Zoek je vooral rust? Kijk dan ook naar de les Puur Ontspannen.</p>
      </div>
      <div class="op md:-mr-[max(2.5rem,calc((100vw-78rem)/2+2.5rem))]">
        <img
          src={unsplash(fotos.studio, 1200)}
          srcset={`${unsplash(fotos.studio, 700)} 700w, ${unsplash(fotos.studio, 1200)} 1200w`}
          sizes="(min-width: 768px) 55vw, 100vw"
          alt="Drie mensen dansen in een studio met blauwe gordijnen"
          class="aspect-[4/3] w-full object-cover"
          loading="lazy"
          width="1200" height="900"
        />
      </div>
    </div>
  </section>

  <!-- Docenten, als rustige lijst zonder portretten (er zijn geen eigen foto's) -->
  <section id="docenten" class="scroll-mt-4 bg-krijt py-20 md:py-28" aria-labelledby="docenten-kop">
    <div class="wrap">
      <div class="op grid gap-6 md:grid-cols-[1fr_1fr] md:items-end">
        <div>
          <p class="label text-vermiljoen">Docenten</p>
          <h2 id="docenten-kop" class="mt-4 text-3xl">Wie er voor de groep staat.</h2>
        </div>
        <p class="max-w-md text-grijs md:justify-self-end">Bij alle docenten staan plezier, veiligheid en zelfvertrouwen voorop.</p>
      </div>
      <ul class="mt-14 border-t border-inkt/20">
        {docenten.map(([naam, vak, tekst]) => (
          <li class="op grid gap-2 border-b border-inkt/20 py-7 md:grid-cols-[1.1fr_1fr_1.3fr] md:gap-8">
            <h3 class="text-2xl">{naam}</h3>
            <p class="font-semibold text-vermiljoen">{vak}</p>
            <p class="text-grijs">{tekst}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Waarom 2MOVE, met de foto als podium links -->
  <section id="waarom" class="scroll-mt-4 py-20 md:py-28" aria-labelledby="waarom-kop">
    <div class="wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div class="op lg:self-start">
        <img
          src={unsplash(fotos.podium, 1000)}
          srcset={`${unsplash(fotos.podium, 700)} 700w, ${unsplash(fotos.podium, 1000)} 1000w`}
          sizes="(min-width: 1024px) 40vw, 100vw"
          alt="Een groep ballerina's danst op een podium"
          class="aspect-[3/4] w-full object-cover max-lg:aspect-[4/3]"
          loading="lazy"
          width="1000" height="1333"
        />
      </div>
      <div>
        <p class="label op text-vermiljoen">Waarom 2MOVE</p>
        <h2 id="waarom-kop" class="op mt-4 text-3xl">Gewoon goed dansles krijgen.</h2>
        <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {waarom.map(([kop, tekst], i) => (
            <div class:list={['op border-t-2 pt-4', i === 0 ? 'border-vermiljoen' : 'border-inkt']}>
              <dt class="font-kop text-xl font-extrabold tracking-[-0.02em]">{kop}</dt>
              <dd class="mt-2 text-grijs">{tekst}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Lesgeld, de regels die ouders willen weten voordat ze bellen -->
  <section id="lesgeld" class="scroll-mt-4 bg-roze py-20 md:py-24" aria-labelledby="lesgeld-kop">
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="op">
        <p class="label">Lesgeld</p>
        <h2 id="lesgeld-kop" class="mt-4 text-3xl">Zo werkt het lesgeld.</h2>
        <p class="mt-6 max-w-sm">De tarieven gelden vanaf 1 januari 2026. Vraag Patty wat jouw les kost en op welke dag hij is.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.telefoonLink} class="knop bg-inkt text-kalk hover:bg-vermiljoen"><Icon naam="telefoon" />{site.telefoon}</a>
          <a href={site.whatsapp} class="knop border border-inkt text-inkt hover:bg-inkt hover:text-kalk" rel="noopener"><Icon naam="whatsapp" />App Patty</a>
        </div>
      </div>
      <ol class="grid gap-px self-start bg-inkt/20 sm:grid-cols-2">
        {[
          ['12', 'Je betaalt het lesgeld in twaalf maandbedragen per jaar.'],
          ['Vakantie', 'In de schoolvakanties van de basisschool is er geen les.'],
          ['€ 4', 'Korting per maand voor elke extra les die je per week volgt.'],
          ['Incasso', 'Het lesgeld wordt automatisch afgeschreven.'],
        ].map(([groot, tekst]) => (
          <li class="op bg-roze p-6 sm:p-8">
            <p class="font-kop text-3xl font-extrabold leading-none" style="font-stretch:78%">{groot}</p>
            <p class="mt-3">{tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="scroll-mt-4 py-20 md:py-28" aria-labelledby="contact-kop">
    <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-20">
      <div class="op">
        <p class="label text-vermiljoen">Contact</p>
        <h2 id="contact-kop" class="mt-4 text-3xl">Kom een keer meedansen.</h2>
        <p class="mt-6 max-w-md text-grijs">De eerste les is gratis. Vraag hem aan via de inschrijfpagina, of bel of app Patty.</p>
        <ul class="mt-10 space-y-5 text-lg">
          <li class="flex gap-4"><Icon naam="pin" class="mt-1 size-5 shrink-0 text-vermiljoen" /><span>{site.straat}<br />{site.postcode} {site.plaats}</span></li>
          <li class="flex gap-4"><Icon naam="telefoon" class="mt-1 size-5 shrink-0 text-vermiljoen" /><a href={site.telefoonLink} class="font-semibold underline-offset-4 hover:underline">{site.telefoon}</a></li>
          <li class="flex gap-4"><Icon naam="mail" class="mt-1 size-5 shrink-0 text-vermiljoen" /><a href={`mailto:${site.email}`} class="break-all font-semibold underline-offset-4 hover:underline">{site.email}</a></li>
        </ul>
        <a href={site.inschrijven} class="knop mt-10 bg-vermiljoen text-wit hover:bg-inkt" rel="noopener">Naar de inschrijfpagina<Icon naam="pijl" /></a>
      </div>

      <form class="op border border-inkt/15 bg-wit p-6 sm:p-9" aria-labelledby="form-kop" onsubmit="return false">
        <h3 id="form-kop" class="text-2xl">Stel je vraag aan Patty</h3>
        <div class="mt-7 grid grid-cols-[minmax(0,1fr)] gap-5">
          <label class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-1.5 text-sm font-semibold">Naam
            <input type="text" name="naam" autocomplete="name" class="w-full min-w-0 min-h-12 border border-inkt/25 bg-kalk px-3 text-base font-normal" />
          </label>
          <label class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-1.5 text-sm font-semibold">Telefoonnummer of e-mail
            <input type="text" name="contact" autocomplete="email" class="w-full min-w-0 min-h-12 border border-inkt/25 bg-kalk px-3 text-base font-normal" />
          </label>
          <label class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-1.5 text-sm font-semibold">Welke les?
            <select name="les" class="w-full min-w-0 min-h-12 border border-inkt/25 bg-kalk px-3 text-base font-normal">
              <option value="">Weet ik nog niet</option>
              {lessen.flatMap(([, namen]) => namen).map((n) => <option>{n}</option>)}
            </select>
          </label>
          <label class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-1.5 text-sm font-semibold">Je vraag
            <textarea name="bericht" rows="4" class="w-full min-w-0 border border-inkt/25 bg-kalk px-3 py-2 text-base font-normal"></textarea>
          </label>
        </div>
        {site.voorstel ? (
          <p class="mt-6 border-l-4 border-vermiljoen bg-krijt px-4 py-3 text-sm">Dit is een ontwerpvoorstel, het formulier verstuurt nog niets. Bel Patty op <a href={site.telefoonLink} class="font-bold underline">{site.telefoon}</a> of mail naar <a href={`mailto:${site.email}`} class="whitespace-nowrap font-bold underline">{site.email}</a>.</p>
        ) : (
          <button type="submit" class="knop mt-6 bg-inkt text-kalk hover:bg-vermiljoen">Versturen</button>
        )}
      </form>
    </div>
  </section>

  </main>
  </div>
  <Footer />
</Base>
