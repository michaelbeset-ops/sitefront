---
import { site, url } from '../data/site';
import Icon from './Icon.astro';
const jaar = new Date().getFullYear();
---
<footer class="donker bg-inkt text-kalk/85">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-kop text-3xl font-extrabold leading-none tracking-[-0.04em] text-kalk" style="font-stretch:78%">2<span class="text-roze">MOVE</span></p>
      <p class="mt-4 max-w-xs text-sm">Dans- en ontspanningsstudio in Papendrecht. Lessen voor 3 tot 70+ jaar.</p>
    </div>
    <div class="text-sm">
      <p class="font-bold text-kalk">Contact</p>
      <ul class="mt-3 space-y-2">
        <li><a href={site.telefoonLink} class="hover:underline">{site.telefoon} (Patty)</a></li>
        <li><a href={`mailto:${site.email}`} class="break-all hover:underline">{site.email}</a></li>
        <li>{site.straat}, {site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="font-bold text-kalk">Volg 2MOVE</p>
      <ul class="mt-3 space-y-2">
        <li><a href={site.instagram} class="hover:underline" rel="noopener">Instagram</a></li>
        <li><a href={site.facebook} class="hover:underline" rel="noopener">Facebook</a></li>
        <li><a href={site.tiktok} class="hover:underline" rel="noopener">TikTok</a></li>
        <li><a href={url('privacy/')} class="hover:underline">Privacyverklaring</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-kalk/15">
    <p class="wrap py-5 text-xs text-kalk/70">© {jaar} Dans- en ontspanningsstudio 2MOVE, {site.plaats}</p>
  </div>
</footer>

<!-- Op de telefoon blijft bellen of appen altijd binnen duimbereik. -->
<div class="donker fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px border-t border-kalk/10 bg-inkt md:hidden">
  <a href={site.telefoonLink} class="flex min-h-[4.5rem] items-center justify-center gap-2 bg-vermiljoen font-bold text-wit"><Icon naam="telefoon" />Bel Patty</a>
  <a href={site.whatsapp} class="flex min-h-[4.5rem] items-center justify-center gap-2 bg-inkt font-bold text-kalk" rel="noopener"><Icon naam="whatsapp" />WhatsApp</a>
</div>
