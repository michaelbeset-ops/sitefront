---
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import { site } from '../../data/site';
---
<Base title="Privacyverklaring | Luxe Banden" description="Hoe Luxe Banden in Dordrecht omgaat met je persoonsgegevens.">
  <Kop thuis={false} />
  <main id="inhoud" class="wrap py-16 lg:py-24">
    <article class="max-w-2xl">
      <p class="eyebrow">Privacy</p>
      <h1 class="mt-4 text-3xl">Privacyverklaring</h1>
      <div class="mt-10 grid gap-8 text-grijs [&_h2]:mb-2 [&_h2]:text-xl [&_h2]:text-inkt">
        <section><h2>Wie zijn wij</h2><p>{site.naam}, {site.straat}, {site.postcode} {site.plaats}. Telefoon {site.tel}, e-mail {site.mail}.</p></section>
        <section><h2>Welke gegevens</h2><p>Als je belt, appt, mailt of het formulier invult, ontvangen we je naam, telefoonnummer en wat je ons vertelt over je auto, zoals je bandenmaat of kenteken.</p>
          {site.voorstel && <p class="mt-2">In dit ontwerpvoorstel verstuurt het formulier niets.</p>}</section>
        <section><h2>Waarvoor</h2><p>Alleen om contact met je op te nemen, een afspraak te maken en het werk aan je auto uit te voeren en af te rekenen. We verkopen of delen je gegevens niet.</p></section>
        <section><h2>WhatsApp</h2><p>Kies je voor WhatsApp, dan maakt de website alleen een bericht klaar. Er wordt pas iets verstuurd als je zelf in WhatsApp op verzenden drukt.</p></section>
        <section><h2>Hoe lang</h2><p>Vragen zonder opdracht bewaren we niet langer dan nodig. Gegevens van opdrachten bewaren we zolang de wet dat vraagt, bijvoorbeeld voor de administratie.</p></section>
        <section><h2>Cookies</h2><p>Deze website plaatst geen cookies en gebruikt geen analyse- of advertentiediensten. Links naar andere sites, zoals Google Maps of WhatsApp, openen pas als je erop klikt.</p></section>
        <section><h2>Je rechten</h2><p>Je mag je gegevens inzien, laten aanpassen of laten verwijderen. Neem daarvoor contact met ons op. Ben je het niet eens met hoe we met je gegevens omgaan, dan kun je een klacht indienen bij de Autoriteit Persoonsgegevens.</p></section>
      </div>
    </article>
  </main>
  <Voet thuis={false} />
</Base>
