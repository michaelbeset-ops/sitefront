            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Toelichting <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="bericht" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld je bandenmaat of wat je hoort"></textarea></label>
