---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;
const route = 'https://www.google.com/maps/dir/?api=1&destination=Daltonstraat+8A+3316+GD+Dordrecht';
---
<Base
  title="Luxe Banden | Banden, APK en reparatie, Daltonstraat Dordrecht"
  description="Garage Luxe Banden aan de Daltonstraat 8A in Dordrecht. Banden, APK en reparatie. Maandag t/m zaterdag 08:00 tot 18:00. Bel 06 47 50 32 21."
>
  <!-- Hero: kop groot over de foto, praktische info als band onderaan, want mensen zoeken vooral of je open bent. -->
  <section class="relative isolate bg-night text-paper">
    <div class="absolute inset-0 -z-10 [&_img]:h-full [&_img]:w-full [&_img]:object-cover">
      <Foto naam="hero" alt="Open garagedeur met stapels banden en velgen" sizes="100vw" eager />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(17_19_17/0.95)_15%,rgb(17_19_17/0.5)_60%,rgb(17_19_17/0.25))]"></div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 min-h-[34rem] sm:min-h-[40rem] lg:min-h-[44rem] flex flex-col justify-end pt-20 pb-10">
      <h1 class="text-4xl max-w-[13ch]">Banden, APK en reparatie</h1>
      <p class="mt-6 max-w-xl text-lg text-paper/90">Garage aan de Daltonstraat in Dordrecht. Zes dagen per week open, van acht tot zes.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="tel:+31647503221" class="inline-flex bg-accent text-paper font-semibold px-5 py-3 hover:bg-accent-deep transition-colors">Bel 06 47 50 32 21</a>
        <a href={route} class="inline-flex border border-paper/70 px-5 py-3 hover:bg-paper hover:text-ink transition-colors">Route naar de garage</a>
      </div>
      <dl class="mt-12 grid grid-cols-2 sm:grid-cols-3 gap-6 border-t border-paper/30 pt-6 text-sm">
        <div><dt class="text-night-soft">Ma t/m za</dt><dd class="mt-1 text-lg font-semibold tabular-nums">08:00 – 18:00</dd></div>
        <div><dt class="text-night-soft">Zondag</dt><dd class="mt-1 text-lg font-semibold">Gesloten</dd></div>
        <div class="col-span-2 sm:col-span-1"><dt class="text-night-soft">Adres</dt><dd class="mt-1 text-lg font-semibold">Daltonstraat 8A</dd></div>
      </dl>
    </div>
  </section>

  <!-- Wat we doen: drie brede rijen met een grote kop links, foto ernaast. -->
  <section id="werk" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12 items-start">
    <div class="lg:col-span-7">
      <h2 class="text-3xl">Wat we doen</h2>
      <div class="mt-10 divide-y divide-line border-y border-line">
        <div class="py-7 grid sm:grid-cols-[12rem_1fr] gap-3">
          <h3 class="text-2xl">Banden</h3>
          <p class="text-ink-soft">Nieuwe banden laten leggen of je banden laten wisselen. Bel even of je maat er is.<br /><span class="text-sm">[[AANLEVEREN: merken, prijzen en of jullie ook gebruikte banden en velgen verkopen]]</span></p>
        </div>
        <div class="py-7 grid sm:grid-cols-[12rem_1fr] gap-3">
          <h3 class="text-2xl">APK</h3>
          <p class="text-ink-soft">Laat je auto keuren aan de Daltonstraat.<br /><span class="text-sm">[[AANLEVEREN: prijs APK en of je kunt wachten]]</span></p>
        </div>
        <div class="py-7 grid sm:grid-cols-[12rem_1fr] gap-3">
          <h3 class="text-2xl">Reparatie</h3>
          <p class="text-ink-soft">Onderhoud en reparatie van je auto. Vertel wat er speelt, dan kijken we ernaar.<br /><span class="text-sm">[[AANLEVEREN: vaste werkzaamheden]]</span></p>
        </div>
      </div>
    </div>
    <div class="lg:col-span-5 [&_img]:w-full [&_img]:h-auto lg:mt-20">
      <Foto naam="werk" alt="Monteur stapelt banden voor een wand met velgen" sizes="(min-width: 1024px) 38vw, 100vw" />
    </div>
  </section>

  <!-- Contact: groene band met bellen als hoofdactie en een kort terugbelformulier. -->
  <section id="route" class="bg-accent text-paper">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-24 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Even bellen?</h2>
        <p class="mt-5 text-paper/90 max-w-md">Vraag of je band op voorraad is of maak een afspraak voor je APK. Bellen kan van maandag tot en met zaterdag.</p>
        <a href="tel:+31647503221" class="mt-8 inline-block display text-[2.4rem] sm:text-[3rem] leading-none hover:underline">06 47 50 32 21</a>
        <p class="mt-8">Daltonstraat 8A<br />3316 GD Dordrecht</p>
        <a href={route} class="mt-2 inline-block underline">Plan je route</a>
      </div>
      <form class="lg:col-span-6 lg:col-start-7 grid gap-5" action="https://api.web3forms.com/submit" method="POST">
        <h3 class="text-xl">Of laat je nummer achter</h3>
        <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-key]]" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">Naam<input name="naam" required autocomplete="name" class="bg-transparent border border-paper/60 px-3 py-3 text-base text-paper" /></label>
          <label class="grid gap-2 text-sm">Telefoon<input name="telefoon" type="tel" required autocomplete="tel" class="bg-transparent border border-paper/60 px-3 py-3 text-base text-paper" /></label>
        </div>
        <label class="grid gap-2 text-sm">Bandenmaat of vraag (optioneel)<input name="bericht" placeholder="bijv. 205/55 R16" class="bg-transparent border border-paper/60 px-3 py-3 text-base text-paper placeholder:text-paper/50" /></label>
        {voorstel ? (
          <p class="border border-paper/70 px-4 py-3 text-sm">Dit is een ontwerpvoorstel, dus het formulier verstuurt nog niets. Bel <a class="underline" href="tel:+31647503221">06 47 50 32 21</a>.</p>
        ) : (
          <button type="submit" class="justify-self-start bg-paper text-ink font-semibold px-6 py-3">Bel mij terug</button>
        )}
        <p class="text-xs text-paper/80">We gebruiken je gegevens alleen om je terug te bellen. Zie de <a class="underline" href={u('privacy/')}>privacyverklaring</a>.</p>
      </form>
    </div>
  </section>
</Base>
