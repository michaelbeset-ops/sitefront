</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-maat]');
  if (f) {
    const uit = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
    const band = document.querySelector<SVGTextPathElement>('[data-maat-tekst]');
    const bericht = () => {
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const maat = `${v('b')}/${v('h')} R${v('i')}`;
      const n = v('n');
      const soort = v('s') && v('s') !== 'Weet ik niet' ? ` (${v('s').toLowerCase()})` : '';
      let t = `Hoi Luxe Banden, hebben jullie ${n === '1' ? 'een band' : `${n} banden`} in maat ${maat}${soort}?`;
      if (v('k')) t += ` Mijn kenteken is ${v('k').toUpperCase()}.`;
      if (band) band.textContent = maat;
      return t;
    };
    const toon = () => { uit.textContent = bericht(); };
    f.addEventListener('input', toon);
    f.addEventListener('change', toon);
    f.addEventListener('submit', (e) => { e.preventDefault(); window.open('https://wa.me/31647503221?text=' + encodeURIComponent(bericht()), '_blank', 'noopener'); });
  }
</script>

