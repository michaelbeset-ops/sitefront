---
import { url, site, waAlgemeen } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['diensten', 'Diensten'], ['banden', 'Bandenmaat'], ['reviews', 'Reviews'], ['tijden', 'Openingstijden'], ['contact', 'Contact']];
---
<div class="bg-asfalt text-licht">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[.8125rem]">
    <ul class="flex items-center gap-6 overflow-hidden whitespace-nowrap">
      <li class="flex items-center gap-1.5"><Icoon naam="vink" class="h-3.5 w-3.5 text-fel" />Ma t/m za open</li>
      <li class="hidden items-center gap-1.5 sm:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-fel" />Banden, APK en onderhoud</li>
      <li class="hidden items-center gap-1.5 lg:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-fel" />Aircoservice en schadeherstel</li>
    </ul>
    <a href={site.telHref} class="num hidden items-center gap-1.5 font-semibold no-underline hover:text-fel md:flex"><Icoon naam="tel" class="h-3.5 w-3.5" />{site.tel}</a>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-md">
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-6">
    <a href={url('')} class="merk" aria-label="Luxe Banden, naar de homepage"><span class="l">LUXE</span> <span class="b">BANDEN</span></a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-[.9375rem] font-semibold">
        {nav.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-groen">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-2.5">
      <a href={site.telHref} class="num hidden font-bold no-underline transition-colors hover:text-groen xl:inline">{site.tel}</a>
      <a href={waAlgemeen} class="knop knop-groen knop-klein hidden sm:inline-flex"><Icoon naam="wa" />WhatsApp</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-[4px] bg-wit shadow-sm lg:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>
        <span class="sr-only">Menu</span><Icoon naam="menu" />
      </button>
    </div>
  </div>
  <nav id="menu" aria-label="Menu" class="hidden border-t border-lijn bg-papier lg:hidden" data-menu>
    <ul class="wrap py-4">
      {nav.map(([id, t]) => <li><a href={h(id)} class="flex items-center justify-between border-b border-lijn py-3.5 font-kop text-xl font-extrabold uppercase no-underline">{t}<Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>)}
      <li class="pt-5"><a href={waAlgemeen} class="knop knop-groen w-full"><Icoon naam="wa" />App ons</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2.5 border-t border-lijn bg-papier/95 p-2.5 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="knop knop-wit knop-klein shadow-sm"><Icoon naam="tel" />Bellen</a>
  <a href={waAlgemeen} class="knop knop-groen knop-klein"><Icoon naam="wa" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
