---
import { site, url, wa, waMet } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const nav = [
  ['Zo werkt het', '#brander'],
  ['Geuren', '#toonbank'],
  ['Herfst', '#herfst'],
  ['Groothandel', '#groothandel'],
  ['Contact', '#contact'],
];
---
{deel === 'kop' ? (
  <header class="op-donker sticky top-0 z-40 bg-antraciet text-licht">
    <div class="wrap flex h-[4.75rem] items-center justify-between gap-4">
      <a href={url('')} class="group border border-licht/70 px-3.5 pb-1.5 pt-2 text-center leading-none text-licht no-underline transition-colors hover:border-zon">
        <span class="logo block text-[1.3rem] font-[250]">SMELLIES<sup class="ml-px text-[.55em] tracking-normal">®</sup></span>
        <span class="mx-auto mt-1 block h-px w-3/5 bg-licht/80" aria-hidden="true"></span>
        <span class="mt-1 block text-[.62rem] tracking-[.04em] text-licht-zacht">Scents &amp; Happiness</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-8 text-[.8rem] uppercase tracking-[.12em]">
          {nav.map(([t, h]) => <li><a href={url(h)} class="no-underline decoration-1 underline-offset-[6px] transition-colors hover:text-zon hover:underline">{t}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-5">
        <a href={site.winkel} class="lijn hidden text-sm sm:inline">Webwinkel</a>
        <a href={waMet('')} class="knop !px-3.5 !py-2.5"><Fragment set:html={wa} /><span class="max-[359px]:sr-only">WhatsApp</span></a>
      </div>
    </div>
  </header>
) : (
  <footer class="op-donker bg-antraciet text-licht">
    <div class="schulp-op" style="--s:var(--color-antraciet);background-color:var(--color-wit)" aria-hidden="true"></div>
    <div class="wrap grid gap-10 pb-10 pt-14 text-sm md:grid-cols-12">
      <p class="md:col-span-5">
        <span class="inline-block border border-licht/70 px-6 pb-3 pt-4 text-center leading-none">
          <span class="logo block text-[2.1rem]">SMELLIES<sup class="ml-0.5 text-[.5em] tracking-normal">®</sup></span>
          <span class="mx-auto mt-2 block h-px w-3/5 bg-licht/80" aria-hidden="true"></span>
          <span class="mt-2 block text-xs text-licht-zacht">Scents &amp; Happiness</span>
        </span>
      </p>
      <p class="md:col-span-4">
        {site.straat}<br />{site.postcode} {site.plaats}<br />
        <a href={waMet('')} class="lijn">WhatsApp</a> of bel <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a><br />
        <a href={`mailto:${site.mail}`} class="lijn">{site.mail}</a><br />
        <a href={site.instagram} class="lijn">Instagram</a> en <a href={site.facebook} class="lijn">Facebook</a> @smellies.nl
      </p>
      <p class="md:col-span-3 md:text-right">
        KvK {site.kvk}<br />
        <a href={site.groothandel} class="lijn">Groothandel</a><br />
        <a href={url('privacy/')} class="lijn">Privacyverklaring</a>
      </p>
    </div>
    {site.voorstel && <p class="wrap border-t border-lijn-licht pb-8 pt-6 text-xs text-licht-zacht">Productfoto's, namen, omschrijvingen en prijzen van smellies.nl (stand 1 oktober 2026), ter illustratie. Bestellen gaat in dit voorstel via de bestaande webwinkel.</p>}
  </footer>
)}
