---
import { site, url, waMet } from '../data/site';
---
<footer id="contact" class="donker scroll-mt-16 bg-antraciet text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-14 pb-16 pt-24 md:grid-cols-12 md:gap-x-8 lg:pt-32">
    <h2 id="t-contact" class="rijs text-2xl md:col-span-12 lg:col-span-5">Langskomen in Dordrecht?<br /><span class="text-licht-zacht">Laat het even weten.</span></h2>

    <div class="rijs grid gap-10 text-sm sm:grid-cols-3 md:col-span-12 lg:col-span-7" style="--d:.1s">
      <div>
        <p class="ui text-licht-zacht">Adres</p>
        <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
        <a href={site.maps} class="lijn mt-3 inline-block">Route ↗</a>
      </div>
      <div>
        <p class="ui text-licht-zacht">Bereikbaar</p>
        <p class="num mt-3">Maandag tot en met donderdag<br />09.00 tot 17.00 uur</p>
        <p class="mt-3 text-licht-zacht">Langskomen op afspraak.</p>
      </div>
      <div>
        <p class="ui text-licht-zacht">Contact</p>
        <p class="mt-3 space-y-1">
          <a href={waMet('ik wil graag een keer langskomen. Kan dat op ')} class="lijn block w-fit">WhatsApp</a>
          <a href={site.telHref} class="lijn num block w-fit">{site.tel}</a>
          <a href={`mailto:${site.mail}`} class="lijn block w-fit">{site.mail}</a>
        </p>
      </div>
      <div class="sm:col-span-3 border-t border-lijn-licht pt-8">
        <p class="ui text-licht-zacht">Bestellen</p>
        <p class="mt-3 max-w-xl text-licht-zacht">Op een werkdag voor 15.00 uur besteld en op voorraad, dan gaat het dezelfde dag mee met PostNL. <span class="num text-licht">Brievenbus € 4,95, pakket € 6,95.</span></p>
      </div>
    </div>
  </div>

  <div class="wrap overflow-hidden pb-6" aria-hidden="true">
    <p class="voetmerk woordmerk text-center">SMELLIES<sup>®</sup></p>
    <p class="ui mt-4 text-center text-licht-zacht">Scents &amp; Happiness</p>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p class="num">Smellies, sinds 2013. KvK {site.kvk}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={site.instagram} class="lijn-in">Instagram</a>
      <a href={site.facebook} class="lijn-in">Facebook</a>
      <a href={site.groothandel} class="lijn-in">Groothandel</a>
      <a href={url('privacy/')} class="lijn-in">Privacyverklaring</a>
    </p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Productfoto's, namen, omschrijvingen en prijzen van smellies.nl (stand 1 oktober 2026). Bestellen gaat in dit voorstel via de bestaande webwinkel.</p>}
</footer>

<style>
  .voetmerk { font-size: clamp(2.1rem, 10.6vw, 11.5rem); font-weight: 200; padding-top: .3em; }
</style>
