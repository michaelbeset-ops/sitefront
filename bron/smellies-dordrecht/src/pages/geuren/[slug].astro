---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import Rond from '../../components/Rond.astro';
import Kaart from '../../components/Kaart.astro';
import { url } from '../../data/site';
import { geuren, famNaam, beeldMacro, pastBij, type Geur } from '../../data/geuren';

export function getStaticPaths() {
  return geuren.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
interface Props { g: Geur }
const { g } = Astro.props;
const fam = g.fam.length ? g.fam.map((f) => famNaam[f]).join(', ') : 'Parfumgeur';
const eerste = g.opties[0];
const meer = pastBij(g);
---
<Base title={`${g.naam} | Smellies`} description={`${g.naam}: ${g.zin} Handgemaakte geurbonbon van soja- en koolzaadwas, per ${g.opties.map((o) => o.stuks).join(' of ')} stuks.`}>
  <Kop actief="geuren/" />
  <main id="inhoud">
    <div class="wrap pt-10 lg:pt-14">
      <nav aria-label="Kruimelpad" class="ui flex flex-wrap gap-x-2 text-grijs">
        <a href={url('')} class="lijn-in">Home</a> <span aria-hidden="true">/</span>
        <a href={url('geuren/')} class="lijn-in">Geuren</a> <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-inkt">{g.naam}</span>
      </nav>
    </div>

    <div class="wrap grid gap-y-12 pb-24 pt-8 lg:grid-cols-12 lg:gap-x-8 lg:pb-32">
      <!-- Beelden -->
      <div class="grid gap-3 lg:col-span-7 lg:gap-4">
        <Rond g={g} class="aspect-square md:aspect-[5/4]" ring="w-[72%] md:w-[58%]" widths={[480, 720, 900]} sizes="(min-width: 1024px) 34vw, 72vw" eager alt={`Smellies ${g.naam}: geurbonbons van wax van dichtbij`} />
        <div class="grid grid-cols-2 gap-3 lg:gap-4">
          <div class="aspect-square overflow-hidden bg-nevel">
            <Image src={beeldMacro(g.beeld)} alt={`Een hoop ${g.naam}-Smellies van dichtbij`} widths={[400, 640, 900]} sizes="(min-width: 1024px) 28vw, 46vw" format="webp" quality={76} class="h-full w-full object-cover" />
          </div>
          <div class="aspect-square overflow-hidden bg-nevel">
            <Image src={beeldMacro(g.beeld)} alt={`Detail van ${g.naam}: de rand van de hoop wax`} widths={[640, 900, 1400]} sizes="(min-width: 1024px) 40vw, 70vw" format="webp" quality={76} class="h-full w-full origin-bottom-left scale-[1.7] object-cover" />
          </div>
        </div>
      </div>

      <!-- Informatie -->
      <div class="lg:col-span-4 lg:col-start-9">
        <div class="lg:sticky lg:top-28">
          <p class="ui text-grijs">{fam}</p>
          <h1 class="mt-4 text-[clamp(2.75rem,4.4vw,4.5rem)] font-light leading-[.95] tracking-[-.05em]">{g.naam}</h1>
          <div class="mt-7 space-y-4 leading-relaxed text-grijs">{g.tekst.map((t) => <p>{t}</p>)}</div>

          <fieldset class="mt-10">
            <legend class="ui">Aantal</legend>
            <div class="mt-3 grid gap-px border border-lijn bg-lijn" style={`grid-template-columns:repeat(${g.opties.length},1fr)`}>
              {g.opties.map((o, i) => (
                <label class="optie relative flex cursor-pointer items-baseline justify-between gap-3 bg-papier px-4 py-3.5">
                  <input type="radio" name="aantal" value={o.stuks} class="sr-only" checked={i === 0} data-prijs={o.prijs} data-href={o.href} />
                  <span class="text-sm">{o.stuks} stuks</span><span class="num text-sm text-grijs">€ {o.prijs}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="mt-6 flex items-end justify-between gap-6">
            <p class="num text-3xl font-light tracking-[-.03em]" aria-live="polite">€ <span data-prijs-uit>{eerste.prijs}</span></p>
            <p class="mono pb-1 text-right text-grijs">smellies.nl,<br />stand 1 oktober 2026</p>
          </div>
          <a href={eerste.href} class="knop knop-vol mt-6 w-full" data-bestel>Bestel op smellies.nl ↗</a>
          {g.opties.length === 1 && <p class="mt-3 text-xs text-grijs">Op smellies.nl nu alleen per 15 stuks te bestellen.</p>}

          <dl class="mt-10 divide-y divide-lijn border-y border-lijn text-sm">
            {g.noten.length > 0 && (
              <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="ui pt-0.5 text-grijs">Samenstelling</dt><dd class="leading-relaxed">{g.noten.join(', ')}</dd></div>
            )}
            <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="ui pt-0.5 text-grijs">Brandtijd</dt><dd>8 tot 12 uur geur, per geur verschillend</dd></div>
            <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="ui pt-0.5 text-grijs">Was</dt><dd>100% soja- en koolzaadwas, zonder paraffine</dd></div>
          </dl>

          <details class="gebruik border-b border-lijn" open>
            <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-sm font-medium">Zo gebruik je hem <span class="plus" aria-hidden="true"></span></summary>
            <ol class="space-y-2 pb-5 text-sm leading-relaxed text-grijs">
              <li><span class="mono mr-2 text-inkt">1</span>Leg een Smellie in de oliebrander en steek het waxinelichtje aan.</li>
              <li><span class="mono mr-2 text-inkt">2</span>Hij smelt en geurt meteen. Genoeg geur? Blaas het lichtje uit.</li>
              <li><span class="mono mr-2 text-inkt">3</span>Later smelt je hem opnieuw, tot de geur op is.</li>
            </ol>
          </details>
        </div>
      </div>
    </div>

    <!-- Past ook bij -->
    <section aria-labelledby="t-ook" class="border-t border-lijn">
      <div class="wrap py-20 lg:py-28">
        <div class="flex items-end justify-between gap-6">
          <h2 id="t-ook" class="text-2xl">Past ook bij {g.naam}</h2>
          <a href={url('geuren/')} class="ui lijn mb-1 shrink-0">Alle geuren</a>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 sm:grid-cols-3 sm:gap-x-6 lg:gap-x-8">
          {meer.map((m, i) => <li class:list={[i === 2 && 'max-sm:hidden']}><Kaart g={m} klein /></li>)}
        </ul>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .optie { transition: background-color .3s, color .3s; }
  .optie:has(input:checked) { background: var(--color-inkt); color: var(--color-papier); }
  .optie:has(input:checked) .text-grijs { color: var(--color-licht-zacht); }
  .optie:has(input:focus-visible) { outline: 2px solid var(--color-inkt); outline-offset: 2px; z-index: 1; }
  .plus { position: relative; width: 11px; height: 11px; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; right: 0; top: 5px; height: 1px; background: currentColor; transition: transform .4s var(--ease-zacht); }
  .plus::after { transform: rotate(90deg); }
  .gebruik[open] .plus::after { transform: rotate(0); }
  summary::-webkit-details-marker { display: none; }
</style>

<script>
  const uit = document.querySelector('[data-prijs-uit]');
  const bestel = document.querySelector<HTMLAnchorElement>('[data-bestel]');
  document.querySelectorAll<HTMLInputElement>('input[name="aantal"]').forEach((r) => r.addEventListener('change', () => {
    if (uit) uit.textContent = r.dataset.prijs!;
    if (bestel) bestel.href = r.dataset.href!;
  }));
</script>
