---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import Kaart from '../../components/Kaart.astro';
import { url, shop } from '../../data/site';
import { herfst, mixen } from '../../data/geuren';
import herfstkaarsen from '../../assets/herfstkaarsen.jpg';
import kaars from '../../assets/zo/geurkaarsen-geurkaars-black-magic.jpg';
import stokjes from '../../assets/zo/geurstokjes-geurstokjes-fresh-linen.jpg';
import spray from '../../assets/zo/roomspray-roomspray-belle.jpg';
import korrels from '../../assets/zo/stofzuigerparfum-stofzuigerkorrels-adore.jpg';
import kyoto from '../../assets/zo/branders-luxe-brander-kyoto.jpg';
import autop from '../../assets/zo/auto-parfum-50ml-autoparfum-50ml-bemin.jpg';

const zo = [
  { naam: 'Geurkaars', bij: '200 ml, meer dan 50 branduren, 100% ecologische sojawas', prijs: '€ 22,50', pad: 'c-4237155/geurkaarsen/', src: kaars, alt: 'Smellies geurkaars Black Magic in zwarte pot, met zwarte doos' },
  { naam: 'Geurstokjes', bij: 'Voor woonkamer, slaapkamer, badkamer of toilet', prijs: '€ 22,50', pad: 'c-4225804/geurstokjes/', src: stokjes, alt: 'Smellies geurstokjes Fresh Linen in een zwarte fles' },
  { naam: 'Roomspray', bij: 'Direct geur, ook samen met je Smellies', prijs: '€ 9,99', pad: 'c-4764065/roomspray/', src: spray, alt: 'Smellies roomspray Belle, zwarte fles' },
  { naam: 'Luxe brander Kyoto', bij: 'Bruin keramiek, rond design', prijs: '€ 14,99', pad: 'a-102973254/branders/luxe-brander-kyoto/', src: kyoto, alt: 'Luxe brander Kyoto van keramiek, met en zonder lichtje' },
  { naam: 'Stofzuigerkorrels', bij: '50 of 200 gram', prijs: 'vanaf € 3,49', pad: 'c-5227203/stofzuigerparfum/', src: korrels, alt: 'Smellies stofzuigerkorrels Adore in een fles' },
  { naam: 'Autoparfum', bij: '50 of 100 ml, drie dames- en drie herengeuren', prijs: 'vanaf € 4,50', pad: 'c-5746982/autoparfum/', src: autop, alt: 'Autoparfum 50 ml in de geur Bemin' },
];
const zoLijst = [
  { naam: 'Geurolie', bij: '10 ml, voor oliebrander en radiatorbakje', prijs: '€ 7,50', pad: 'c-4297372/geurolie/' },
  { naam: 'Navulling geurstokjes', bij: 'Voor je geurstokjes', prijs: '€ 13,50', pad: 'c-5777615/navulling-geurstokjes/' },
];
const herfstMeer = [
  ['Herfstkaars, limited', 'in een keramieken eikel of pompoen', '€ 17,50'],
  ['Herfstduo', 'voordeelduo', '€ 9,99'],
  ['Roomspray herfst', 'Happy, Love of Sweet Autumn', '€ 6,49'],
];
---
<Base title="Collecties | Smellies" description="De collecties van Smellies: herfst, mixen van tien geuren en Smellies & zo, met geurkaarsen, geurstokjes, roomspray en meer.">
  <Kop actief="collecties/" />
  <main id="inhoud">
    <div class="wrap pb-6 pt-14 lg:pt-20">
      <nav aria-label="Kruimelpad" class="ui flex flex-wrap gap-x-2 text-grijs"><a href={url('')} class="lijn-in">Home</a> <span aria-hidden="true">/</span> <span aria-current="page" class="text-inkt">Collecties</span></nav>
      <div class="mt-10 grid gap-8 md:grid-cols-12 md:items-end">
        <h1 class="text-[clamp(3rem,7vw,7.5rem)] font-light leading-[.92] tracking-[-.05em] md:col-span-7">Collecties</h1>
        <p class="ui flex flex-wrap gap-x-7 gap-y-3 md:col-span-5 md:justify-self-end">
          <a href="#herfst" class="lijn-in">Herfst</a><a href="#mixen" class="lijn-in">Mixen</a><a href="#smellies-en-zo" class="lijn-in">Smellies &amp; zo</a><a href={url('geuren/')} class="lijn-in">Alle geuren</a>
        </p>
      </div>
    </div>

    <!-- Herfst -->
    <section id="herfst" aria-labelledby="t-herfst" class="scroll-mt-20">
      <div class="wrap grid gap-y-10 pb-24 pt-14 md:grid-cols-12 md:gap-x-8 lg:pb-32">
        <div class="rijs md:col-span-12 lg:col-span-8">
          <div class="aspect-[1310/462] overflow-hidden bg-nevel max-sm:aspect-[16/9]">
            <Image src={herfstkaarsen} alt="De herfstkaarsen van Smellies: een keramieken eikel open met de kaars erin, een eikel en een pompoen, op een houten plank voor een herfstbos." widths={[640, 960, 1310]} sizes="(min-width: 1024px) 62vw, 100vw" format="webp" quality={72} loading="eager" class="h-full w-full object-cover" />
          </div>
        </div>
        <div class="rijs flex flex-col md:col-span-8 lg:col-span-4" style="--d:.1s">
          <p class="ui text-grijs">Herfst</p>
          <h2 id="t-herfst" class="mt-5 text-2xl">Herfstweer buiten? Happy Autumn binnen.</h2>
          <p class="mt-5 text-grijs">Vier herfstgeuren, een roomspray en kaarsen in een keramieken eikel of pompoen.</p>
          <ul class="mt-8 divide-y divide-lijn border-y border-lijn text-sm">
            {herfstMeer.map(([n, b, p]) => <li class="flex items-baseline justify-between gap-4 py-3"><span>{n} <span class="text-grijs">{b}</span></span><span class="num shrink-0">{p}</span></li>)}
          </ul>
          <p class="mt-7"><a href={shop('c-5442737/herfst/')} class="knop">Herfst op smellies.nl ↗</a></p>
        </div>
        <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 md:col-span-12 lg:grid-cols-4 lg:gap-x-8">
          {herfst.map((g) => <li class="rijs"><Kaart g={g} klein /></li>)}
        </ul>
      </div>
    </section>

    <!-- Mixen -->
    <section id="mixen" aria-labelledby="t-mixen" class="donker scroll-mt-16 bg-antraciet text-licht">
      <div class="wrap grid gap-y-12 py-24 md:grid-cols-12 md:gap-x-8 lg:py-32">
        <div class="rijs md:col-span-5">
          <p class="tien" aria-hidden="true">10</p>
          <h2 id="t-mixen" class="mt-4 text-3xl">Kun je niet kiezen? <span class="text-licht-zacht">Neem een mix van tien geuren.</span></h2>
        </div>
        <ul class="md:col-span-7 md:self-end">
          {mixen.map((m, i) => (
            <li class="rijs border-t border-lijn-licht last:border-b" style={`--d:${i * 0.06}s`}>
              <a href={m.pad} class="mix group grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-5 sm:grid-cols-[12rem_1fr_auto] sm:py-6">
                <span class="text-xl tracking-[-.02em]">{m.naam}</span>
                <span class="num text-sm sm:order-3">€ 5,50 <span class="pijl inline-block" aria-hidden="true">↗</span></span>
                <span class="col-span-2 text-sm text-licht-zacht sm:col-span-1">10 geuren, {m.zin}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Smellies & zo -->
    <section id="smellies-en-zo" aria-labelledby="t-zo" class="scroll-mt-16">
      <div class="wrap py-24 lg:py-32">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <h2 id="t-zo" class="text-3xl md:col-span-7">Smellies &amp; zo</h2>
          <p class="max-w-md text-grijs md:col-span-5 md:justify-self-end md:text-right">Dezelfde geuren, ook als kaars, stokjes, olie of spray.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-14 sm:gap-x-6 lg:grid-cols-3 lg:gap-x-8">
          {zo.map((z, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={shop(z.pad)} class="pack group block">
                <span class="block aspect-[4/5] overflow-hidden bg-blank"><Image src={z.src} alt={z.alt} widths={[320, 480, 640]} sizes="(min-width: 1024px) 28vw, 46vw" format="webp" quality={78} class="h-full w-full object-contain p-[10%]" /></span>
                <span class="mt-4 flex flex-wrap items-baseline justify-between gap-x-4"><span class="text-lg tracking-[-.02em]"><span class="lijn-in">{z.naam}</span></span><span class="num text-sm text-grijs">{z.prijs.startsWith('vanaf') && <span class="text-xs">vanaf </span>}{z.prijs.replace('vanaf ', '')}</span></span>
                <span class="mt-1 block text-sm leading-snug text-grijs">{z.bij}</span>
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-16 grid gap-x-8 border-t border-lijn md:grid-cols-2">
          {zoLijst.map((z) => (
            <li class="border-b border-lijn">
              <a href={shop(z.pad)} class="group flex items-baseline justify-between gap-4 py-4 text-sm">
                <span><span class="font-medium"><span class="lijn-in">{z.naam}</span></span> <span class="text-grijs">{z.bij}</span></span>
                <span class="num shrink-0">{z.prijs}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mono mt-6 text-grijs">Prijzen van smellies.nl, stand 1 oktober 2026. Bestellen gaat via de webwinkel.</p>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .tien { font-size: clamp(7rem, 15vw, 15rem); font-weight: 200; line-height: .8; letter-spacing: -.06em; font-variant-numeric: tabular-nums; margin-left: -.06em; }
  .mix .pijl { transition: transform .4s var(--ease-zacht); }
  .mix:hover .pijl { transform: translate(3px, -3px); }
  .mix { transition: padding .5s var(--ease-zacht); }
  @media (hover: hover) { .mix:hover { padding-left: .75rem; } }
  .pack img { transition: transform 1.2s var(--ease-zacht); }
  .pack:hover img { transform: scale(1.04); }
</style>
