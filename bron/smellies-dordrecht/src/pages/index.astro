---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Rond from '../components/Rond.astro';
import Brander from '../components/Brander.astro';
import { site, url, waMet } from '../data/site';
import { geur, smellies, smeltPaletten, famNaam, tint, beeldRond } from '../data/geuren';
import herfstkaarsen from '../assets/herfstkaarsen.jpg';
import kaars from '../assets/zo/geurkaarsen-geurkaars-black-magic.jpg';

const uitgelicht = [
  { g: geur('pumpkin-spice'), label: 'Uit de herfstcollectie' },
  { g: geur('libre'), label: famNaam.bloemig },
  { g: geur('snuggels'), label: famNaam.fris },
];
const trio = [geur('yes'), geur('space'), geur('light-blue')];
const pal0 = smeltPaletten[0];
const stappen = [
  ['Leg een Smellie in de brander.', 'Steek het waxinelichtje eronder aan. Meer heb je niet nodig.'],
  ['Hij smelt, en geurt meteen.', 'Spetteren doet hij niet: een veilig alternatief voor geurolie, geurkaars of wierook.'],
  ['Genoeg? Blaas het lichtje uit.', 'De wax wordt weer hard en geurt nog uren. Later smelt je hem opnieuw, tot de geur na 8 tot 12 uur op is.'],
];
---
<Base title="Smellies | Handgemaakte geurbonbons van soja- en koolzaadwas" description="Smellies maakt sinds 2013 geurbonbons, geurkaarsen en geurartikelen met de hand, van 100% soja- en koolzaadwas. 36 geuren, uit Dordrecht.">
  <Kop opHero />
  <main id="inhoud">

    <!-- 1. Hero: vloeiende wax in hun eigen waskleuren, met het woordmerk. -->
    <section class="hero relative -mt-16 flex min-h-[38rem] flex-col overflow-hidden" style={`--c0:${pal0.kleuren[0]};--c1:${pal0.kleuren[1]};--c2:${pal0.kleuren[2]};--c3:${pal0.kleuren[3]}`} aria-labelledby="titel" data-hero>
      <canvas class="smelt absolute inset-0 h-full w-full" aria-hidden="true" data-smelt data-paletten={JSON.stringify(smeltPaletten.map((p) => p.kleuren))} data-namen={JSON.stringify(smeltPaletten.map((p) => p.namen.slice(0, 3)))}></canvas>
      <div class="relative flex flex-1 flex-col items-center justify-center px-4 pt-16 text-center">
        <p class="heromerk woordmerk" aria-hidden="true">SMELLIES<sup>®</sup></p>
        <p class="ui mt-5 sm:mt-7">Scents &amp; Happiness</p>
      </div>
      <div class="wrap relative grid gap-8 pb-8 sm:pb-10 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <h1 id="titel" class="max-w-[17ch] text-[clamp(1.6rem,1.8vw+1rem,2.6rem)] leading-[1.08] tracking-[-.03em]">Handgemaakte geurbonbons van soja- en koolzaadwas.</h1>
          <p class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={url('geuren/')} class="knop">Bekijk de geuren</a>
            <a href={site.winkel} class="ui lijn">Naar de webwinkel ↗</a>
          </p>
        </div>
        <p class="mono max-w-[16rem] leading-relaxed max-sm:hidden md:text-right">
          <span class="text-inkt/70">In beeld, de waskleuren van</span><br />
          <span data-namen-uit>{pal0.namen.slice(0, 3).join(', ')}</span>
        </p>
      </div>
    </section>

    <!-- 2. Merkstatement -->
    <section aria-labelledby="t-over" class="wrap grid gap-y-10 py-28 md:grid-cols-12 md:gap-x-8 lg:py-40">
      <h2 id="t-over" class="rijs text-[clamp(2.25rem,4.6vw+.4rem,5.25rem)] leading-[1.03] md:col-span-10">
        Alles zelf, met de hand. <span class="text-grijs">Van 100% soja- en koolzaadwas, zonder paraffine. Sinds 2013, vanuit Dordrecht.</span>
      </h2>
      <p class="rijs mono flex flex-wrap gap-x-8 gap-y-2 text-grijs md:col-span-12" style="--d:.1s">
        <span>8 tot 12 uur geur per Smellie</span><span>Spettert niet</span><span>Niet getest op dieren</span><span>Verkooppunten in NL, BE en UK</span>
      </p>
    </section>

    <!-- 3. Uitgelicht: drie geuren, groot, elk in zijn eigen waskleur. -->
    <section aria-labelledby="t-uitgelicht">
      <div class="wrap flex items-end justify-between gap-6 pb-10">
        <h2 id="t-uitgelicht" class="text-3xl">Uitgelicht</h2>
        <a href={url('geuren/')} class="ui lijn mb-2 shrink-0">Alle {smellies.length} geuren</a>
      </div>
      {uitgelicht.map(({ g, label }, i) => (
        <article class="band" style={`background:${tint(g.kleur, 34)}`} aria-labelledby={`u-${g.slug}`}>
          <div class="wrap grid items-center gap-y-10 py-16 md:grid-cols-12 md:gap-x-8 lg:py-24">
            <a href={url(`geuren/${g.slug}/`)} class:list={['rijs block md:col-span-6', i % 2 && 'md:order-2 md:col-start-7']} tabindex="-1" aria-hidden="true">
              <Rond g={g} pct={34} class="aspect-square" ring="w-[82%] max-w-[34rem]" widths={[480, 720, 900]} sizes="(min-width: 768px) 40vw, 82vw" />
            </a>
            <div class:list={['rijs md:col-span-5', i % 2 ? 'md:order-1 md:col-start-1' : 'md:col-start-8']} style="--d:.1s">
              <p class="ui">{label}</p>
              <h3 id={`u-${g.slug}`} class="naam mt-5">{g.naam}</h3>
              <p class="mt-6 max-w-md text-xl leading-snug tracking-[-.01em]">{g.zin}</p>
              {g.noten.length > 0 && <p class="mono mt-6 max-w-md leading-relaxed">{g.noten.join(' · ')}</p>}
              <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-5 border-t border-inkt/20 pt-6">
                <p class="num text-sm">{g.opties.map((o) => `${o.stuks} stuks € ${o.prijs}`).join('   ·   ')}</p>
                <a href={url(`geuren/${g.slug}/`)} class="knop">Bekijk {g.naam}</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- 4. Collecties als rustige beeldlinks -->
    <section aria-labelledby="t-collecties" class="wrap py-28 lg:py-40">
      <h2 id="t-collecties" class="text-3xl">Collecties</h2>
      <ul class="mt-12 grid gap-x-6 gap-y-14 md:grid-cols-12">
        <li class="rijs md:col-span-7">
          <a href={url('geuren/')} class="coll group block">
            <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden bg-nevel">
              {trio.map((g, i) => (
                <div class="trio absolute aspect-square w-[38%] overflow-hidden rounded-full" style={`--i:${i}`}>
                  <Image src={beeldRond(g.beeld)} alt="" widths={[300, 480]} sizes="(min-width: 768px) 22vw, 36vw" format="webp" quality={76} class="h-full w-full object-cover" />
                </div>
              ))}
            </div>
            <p class="mt-4 flex items-baseline justify-between gap-4"><span class="text-2xl tracking-[-.03em]"><span class="lijn-in">Smellies</span></span><span class="ui text-grijs">{smellies.length} geuren</span></p>
          </a>
        </li>
        <li class="rijs md:col-span-5" style="--d:.08s">
          <a href={url('collecties/#smellies-en-zo')} class="coll group flex h-full flex-col">
            <div class="relative aspect-[4/3] overflow-hidden bg-blank md:aspect-auto md:flex-1">
              <Image src={kaars} alt="" widths={[400, 640]} sizes="(min-width: 768px) 38vw, 90vw" format="webp" quality={78} class="beeld absolute inset-0 h-full w-full object-contain p-[12%]" />
            </div>
            <p class="mt-4 flex items-baseline justify-between gap-4"><span class="text-2xl tracking-[-.03em]"><span class="lijn-in">Smellies &amp; zo</span></span><span class="ui text-grijs">Kaars, stokjes, spray</span></p>
          </a>
        </li>
        <li class="rijs md:col-span-8">
          <a href={url('collecties/#herfst')} class="coll group block">
            <div class="aspect-[1310/462] overflow-hidden bg-nevel max-md:aspect-[4/3]">
              <Image src={herfstkaarsen} alt="" widths={[640, 960, 1310]} sizes="(min-width: 768px) 62vw, 100vw" format="webp" quality={72} class="beeld h-full w-full object-cover" />
            </div>
            <p class="mt-4 flex items-baseline justify-between gap-4"><span class="text-2xl tracking-[-.03em]"><span class="lijn-in">Herfst</span></span><span class="ui text-grijs">Limited kaarsen, vier geuren</span></p>
          </a>
        </li>
        <li class="rijs md:col-span-4" style="--d:.08s">
          <a href={url('collecties/#mixen')} class="coll group flex h-full flex-col">
            <div class="flex aspect-[4/3] flex-col justify-between bg-antraciet p-6 text-licht md:aspect-auto md:flex-1">
              <span class="tien" aria-hidden="true">10</span>
              <span class="mono text-licht-zacht">Flower · Fresh · Parfum · Sweet</span>
            </div>
            <p class="mt-4 flex items-baseline justify-between gap-4"><span class="text-2xl tracking-[-.03em]"><span class="lijn-in">Mixen</span></span><span class="ui text-grijs">Tien geuren per mix</span></p>
          </a>
        </li>
      </ul>
    </section>

    <!-- 5. Zo werkt het: compact, de tekening speelt de drie stappen af. -->
    <section id="zo-werkt-het" aria-labelledby="t-zo" class="donker scroll-mt-16 bg-antraciet text-licht">
      <div class="wrap grid items-center gap-y-12 py-24 md:grid-cols-12 md:gap-x-8 lg:py-32">
        <div class="md:col-span-5 lg:col-span-4" data-stap="1" data-tekening>
          <Brander class="mx-auto block w-[min(100%,17rem)] lg:w-[min(100%,21rem)]" />
        </div>
        <div class="md:col-span-7 lg:col-span-7 lg:col-start-6">
          <h2 id="t-zo" class="max-w-[16ch] text-3xl">Eén brander, één lichtje, één Smellie.</h2>
          <ol class="mt-12 grid gap-px bg-lijn-licht sm:grid-cols-3" data-stappen>
            {stappen.map(([kop, tekst], i) => (
              <li class="bg-antraciet">
                <button type="button" class="stap h-full w-full py-5 text-left sm:pr-6" aria-pressed={i === 0 ? 'true' : 'false'} data-naar={i + 1}>
                  <span class="mono text-licht-zacht">{i + 1} / 3</span>
                  <span class="mt-3 block text-lg leading-snug tracking-[-.02em]">{kop}</span>
                  <span class="mt-2 block text-sm leading-relaxed text-licht-zacht">{tekst}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 6. Groothandel en verkooppunten -->
    <section id="groothandel" aria-labelledby="t-groot" class="scroll-mt-16 bg-nevel">
      <div class="wrap grid gap-y-14 py-24 md:grid-cols-12 md:gap-x-8 lg:py-32">
        <div class="rijs md:col-span-6 lg:col-span-5">
          <h2 id="t-groot" class="text-3xl">Smellies in je eigen winkel?</h2>
          <p class="mt-8 max-w-md text-lg leading-relaxed">Naast de webwinkel ligt Smellies bij verkooppunten in drie landen. Geef je bedrijfsgegevens door; na goedkeuring krijg je een account bij de groothandel.</p>
          <p class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={site.groothandel} class="knop knop-vol">Naar de groothandel ↗</a>
            <a href={waMet('ik heb een winkel en wil graag verkooppunt van Smellies worden. Mijn bedrijf: ')} class="ui lijn">App je gegevens</a>
          </p>
        </div>
        <ul class="landen md:col-span-6 md:col-start-7 md:self-end" aria-label="Verkooppunten in">
          {[['Nederland', 'NL'], ['België', 'BE'], ['Engeland', 'UK']].map(([l, c], i) => (
            <li class="rijs flex items-baseline justify-between border-b border-lijn py-3" style={`--d:${i * 0.08}s`}><span>{l}</span><span class="mono text-grijs">{c}</span></li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .hero { height: calc(100svh - var(--balk, 0px)); max-height: 64rem; background:
      radial-gradient(60% 70% at 18% 82%, var(--c0), transparent 70%),
      radial-gradient(50% 60% at 85% 60%, var(--c1), transparent 70%),
      radial-gradient(45% 50% at 40% 70%, var(--c2), transparent 70%),
      var(--c3); }
  .smelt { opacity: 0; transition: opacity .9s var(--ease-zacht); }
  .smelt.aan { opacity: 1; }
  .heromerk { font-size: clamp(2.1rem, 11vw, 10.5rem); font-weight: 300; letter-spacing: .3em; margin-right: -.3em; }
  @media (min-width: 768px) { .heromerk { font-size: clamp(2.1rem, 10.2vw, 10.5rem); letter-spacing: .38em; margin-right: -.38em; } }

  .naam { font-size: clamp(3rem, 6.4vw, 7rem); font-weight: 300; line-height: .95; letter-spacing: -.05em; }

  .trio { box-shadow: 0 30px 50px -28px rgb(46 47 52 / .5); transition: transform 1.2s var(--ease-zacht); }
  .trio[style*='--i:0'] { transform: translate(-62%, 6%); }
  .trio[style*='--i:1'] { transform: translate(0, -8%); z-index: 1; }
  .trio[style*='--i:2'] { transform: translate(62%, 8%); }
  .coll:hover .trio[style*='--i:0'] { transform: translate(-70%, 4%) rotate(-4deg); }
  .coll:hover .trio[style*='--i:1'] { transform: translate(0, -12%); }
  .coll:hover .trio[style*='--i:2'] { transform: translate(70%, 10%) rotate(4deg); }
  .coll .beeld { transition: transform 1.4s var(--ease-zacht); }
  .coll:hover .beeld { transform: scale(1.035); }

  .tien { font-size: clamp(6rem, 11vw, 11rem); font-weight: 200; line-height: .8; letter-spacing: -.06em; font-variant-numeric: tabular-nums; }

  .stap { position: relative; transition: color .4s; }
  .stap::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: var(--color-licht); transform: scaleX(0); transform-origin: 0 50%; }
  .stap[aria-pressed='true']::before { transform: scaleX(1); transition: transform var(--duur, 3.4s) linear; }
  .stap[aria-pressed='false'] > span:nth-child(2) { color: var(--color-licht-zacht); }

  .landen { font-size: clamp(2.25rem, 4.6vw, 4.75rem); font-weight: 300; letter-spacing: -.035em; line-height: 1.05; }
</style>

<script>
  import { smelt } from '../scripts/smelt';

  // Hero: start het smeltbeeld pas als de pagina geladen is (LCP blijft de tekst).
  const canvas = document.querySelector<HTMLCanvasElement>('[data-smelt]');
  const namenUit = document.querySelector<HTMLElement>('[data-namen-uit]');
  if (canvas) {
    const paletten = JSON.parse(canvas.dataset.paletten!) as string[][];
    const namen = JSON.parse(canvas.dataset.namen!) as string[][];
    const start = () => smelt(canvas, paletten, (i) => { if (namenUit) namenUit.textContent = namen[i].join(', '); });
    const later = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 300));
    if (document.readyState === 'complete') later(); else addEventListener('load', later, { once: true });
  }

  // Zo werkt het: de tekening speelt de stappen af zolang hij in beeld is; klikken kiest een stap.
  const tekening = document.querySelector<HTMLElement>('[data-tekening]');
  const knoppen = [...document.querySelectorAll<HTMLButtonElement>('[data-naar]')];
  const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (tekening && knoppen.length) {
    let stap = 1, klok = 0;
    const zet = (n: number) => { stap = n; tekening.dataset.stap = String(n); knoppen.forEach((k) => k.setAttribute('aria-pressed', String(Number(k.dataset.naar) === n))); };
    const loop = () => { clearInterval(klok); if (!rustig) klok = window.setInterval(() => zet((stap % 3) + 1), 3400); };
    knoppen.forEach((k) => k.addEventListener('click', () => { zet(Number(k.dataset.naar)); loop(); }));
    if (rustig) zet(2);
    else new IntersectionObserver(([e]) => { if (e.isIntersecting) { zet(1); loop(); } else clearInterval(klok); }, { threshold: 0.4 }).observe(tekening);
  }
</script>
