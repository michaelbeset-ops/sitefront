---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { site, url, shop, wa, waMet } from '../data/site';
import { smellies, brander, mixen, foto } from '../data/geuren';
import herfstkaarsen from '../assets/herfstkaarsen.jpg';
import kaars from '../assets/zo/geurkaarsen-geurkaars-black-magic.jpg';
import stokjes from '../assets/zo/geurstokjes-geurstokjes-fresh-linen.jpg';
import spray from '../assets/zo/roomspray-roomspray-belle.jpg';
import korrels from '../assets/zo/stofzuigerparfum-stofzuigerkorrels-adore.jpg';
import kyoto from '../assets/zo/branders-luxe-brander-kyoto.jpg';
import auto from '../assets/zo/auto-parfum-50ml-autoparfum-50ml-bemin.jpg';

// De vitrine bovenaan: tien echte Smellies; zes daarvan horen bij een woord uit hun eigen omschrijvingen.
const vitrine = [
  { slug: 'herfst-pumpkin-spice', naam: 'Pumpkin Spice', woord: 'pompoentaart' },
  { slug: 'smellies-choo-choo', naam: 'Choo Choo' },
  { slug: 'smellies-light-blue', naam: 'Light Blue' },
  { slug: 'smellies-apple-pie', naam: 'Apple Pie', woord: 'appeltaart' },
  { slug: 'smellies-bedtime-baby', naam: 'Bedtime Baby' },
  { slug: 'smellies-cherry-pie', naam: 'Cherry Pie', woord: 'kersentaart' },
  { slug: 'smellies-baccarat', naam: 'Baccarat' },
  { slug: 'smellies-komkommer-aloe-vera', naam: 'Komkommer & aloe vera', woord: 'komkommer' },
  { slug: 'smellies-sweet-cookies', naam: 'Sweet Cookies', woord: 'verse koekjes' },
  { slug: 'smellies-babypowder', naam: 'Babypowder', woord: 'babypoeder' },
];
const woorden = vitrine.filter((v) => v.woord);

const herfst = [
  { slug: 'herfst-happy-autumn', naam: 'Happy Autumn', pad: 'a-65943987/herfst/happy-autumn/' },
  { slug: 'herfst-love-autumn', naam: 'Love Autumn', pad: 'a-65943992/herfst/love-autumn/' },
  { slug: 'herfst-sweet-autumn', naam: 'Sweet Autumn', pad: 'a-65943997/herfst/sweet-autumn/' },
  { slug: 'herfst-pumpkin-spice', naam: 'Pumpkin Spice', pad: 'a-102141336/herfst/pumpkin-spice/' },
];

const zo = [
  { naam: 'Geurkaars', bij: '200 ml, meer dan 50 branduren', prijs: '€ 22,50', pad: 'c-4237155/geurkaarsen/' },
  { naam: 'Geurstokjes', bij: 'voor woonkamer, slaapkamer of badkamer', prijs: '€ 22,50', pad: 'c-4225804/geurstokjes/' },
  { naam: 'Navulling geurstokjes', bij: '', prijs: '€ 13,50', pad: 'c-5777615/navulling-geurstokjes/' },
  { naam: 'Geurolie', bij: '10 ml, voor brander en radiatorbakje', prijs: '€ 7,50', pad: 'c-4297372/geurolie/' },
  { naam: 'Roomspray', bij: 'direct geur, ook samen met je Smellies', prijs: '€ 9,99', pad: 'c-4764065/roomspray/' },
  { naam: 'Stofzuigerkorrels', bij: '50 of 200 gram', prijs: 'vanaf € 3,49', pad: 'c-5227203/stofzuigerparfum/' },
  { naam: 'Autoparfum', bij: '50 of 100 ml, drie dames- en drie herengeuren', prijs: '€ 4,50 / € 6,49', pad: 'c-5746982/autoparfum/' },
  { naam: 'Luxe brander Kyoto', bij: 'keramiek, rond design', prijs: '€ 14,99', pad: 'a-102973254/branders/luxe-brander-kyoto/' },
];
const zoFotos = [
  { src: kaars, alt: 'Smellies geurkaars in zwarte pot met doos' },
  { src: stokjes, alt: 'Smellies geurstokjes in zwarte fles' },
  { src: spray, alt: 'Smellies roomspray, zwarte fles' },
  { src: korrels, alt: 'Smellies stofzuigerkorrels in de geur Adore' },
  { src: kyoto, alt: 'Luxe brander Kyoto van keramiek' },
  { src: auto, alt: 'Autoparfum 50 ml in de geur Bemin' },
];
const eerste = brander[0];
---
<Base title="Smellies | Handgemaakte geurbonbons uit Dordrecht" description="Smellies: handgemaakte geurbonbons van 100% soja- en koolzaadwas voor in de brander. 36 geuren, geurkaarsen, roomspray en meer. Sinds 2013, uit Dordrecht.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. De vitrine: een bonbondoos van hun eigen wax, met één vak voor het etiket. -->
    <section aria-labelledby="titel" class="grid grid-cols-3 lg:grid-cols-6">
      <div class="col-span-3 flex flex-col justify-center px-5 pb-10 pt-12 md:px-12 lg:col-span-4 lg:row-span-2 lg:py-8 lg:[contain:size] xl:pl-[max(3rem,calc((100vw-90rem)/2+3rem))]">
        <h1 id="titel" class="text-4xl lg:text-[clamp(4rem,6.6vw,8.25rem)]">Geur die je<br class="hidden sm:block" /> laat smelten.</h1>
        <p class="cursief mt-5 text-xl text-zacht lg:mt-6">
          Straks ruikt je huis naar <span class="woordvak"><span class="inline-block text-framboos" data-woord>{woorden[0].woord}</span></span>.
        </p>
        <p class="mt-5 max-w-[34rem] text-lg leading-relaxed">Handgemaakte geurbonbons van 100% soja- en koolzaadwas. Eén in de brander, waxinelichtje aan, en hij geurt meteen.</p>
        <p class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={url('#brander')} class="knop">Kies je geur</a>
          <a href={site.winkel} class="lijn text-sm">Of ga direct naar de webwinkel</a>
        </p>
      </div>
      {vitrine.map((v, i) => (
        <div class:list={['vak group relative aspect-square overflow-hidden', i === 9 && 'max-lg:hidden']} data-vak={v.woord ?? ''} aria-hidden="true">
          <Image src={foto(v.slug)} alt="" widths={[200, 320, 480]} sizes="(min-width: 1024px) 17vw, 34vw" format="webp" quality={64} loading={i < 4 ? 'eager' : 'lazy'} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
          <span class="absolute bottom-2 left-2 bg-wit px-2 py-0.5 text-[.72rem] leading-snug text-inkt sm:bottom-3 sm:left-3 sm:text-xs">{v.naam}</span>
        </div>
      ))}
    </section>

    <!-- 2. Zo werkt het: de brander, met de geur die je kiest. -->
    <section id="brander" aria-labelledby="t-brander" class="op-donker scroll-mt-16 bg-pruim text-licht">
      <div class="schulp" style="--s:var(--color-papier)" aria-hidden="true"></div>
      <div class="wrap grid gap-12 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
        <div class="lg:col-span-5 lg:pt-6">
          <h2 id="t-brander" class="text-3xl">Eén brander,<br /> één lichtje,<br /> <span class="cursief text-vlam">één Smellie.</span></h2>
          <ol class="mt-10 max-w-md space-y-6 text-licht-zacht">
            <li><span class="text-licht">Leg een Smellie in de brander en steek het waxinelichtje aan.</span> Hij smelt langzaam en geurt meteen. Spetteren doet hij niet.</li>
            <li><span class="text-licht">Genoeg geur? Blaas het lichtje uit.</span> De wax wordt weer hard, en later smelt je hem gewoon opnieuw.</li>
            <li><span class="text-licht">Na 8 tot 12 uur is de geur op</span> (per geur verschilt het). Laat hem hard worden, zet het lichtje een paar minuten aan en haal hem eruit met een mesje.</li>
          </ol>
        </div>

        <div class="brander lg:col-span-7" data-brander style={`--wax:${eerste.kleur}`}>
          <div class="relative mx-auto max-w-[30rem]">

            <svg viewBox="0 0 420 470" class="relative w-full" role="img" aria-label="Een geurbrander met een waxinelichtje; de gekozen Smellie smelt in het schaaltje bovenop.">
              <defs>
                <linearGradient id="kl" x1="0" x2="1"><stop offset="0" stop-color="#cdbfd3" /><stop offset=".45" stop-color="#ebe3ee" /><stop offset="1" stop-color="#a999b0" /></linearGradient>
                <radialGradient id="gloed" cx=".5" cy=".62" r=".6"><stop offset="0" stop-color="#ffa244" stop-opacity=".75" /><stop offset=".55" stop-color="#ff7a2e" stop-opacity=".18" /><stop offset="1" stop-color="#ff7a2e" stop-opacity="0" /></radialGradient>
                <radialGradient id="halo"><stop offset="0" stop-color="#ff9a3c" stop-opacity=".22" /><stop offset=".6" stop-color="#ff7a2e" stop-opacity=".06" /><stop offset="1" stop-color="#ff7a2e" stop-opacity="0" /></radialGradient>
                <linearGradient id="vl" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff4c9" /><stop offset=".5" stop-color="#ffc35a" /><stop offset="1" stop-color="#ff7a1f" /></linearGradient>
                <clipPath id="boog"><path d="M148 440V338a62 62 0 0 1 124 0v102Z" /></clipPath>
              </defs>
              <ellipse cx="210" cy="446" rx="150" ry="12" fill="#000" opacity=".35" />
              <circle cx="210" cy="330" r="200" fill="url(#halo)" />
              <path d="M104 196h212l-12 232q-2 16-18 16H134q-16 0-18-16Z" fill="url(#kl)" />
              <path d="M128 230h164M131 270h158" stroke="#fff" stroke-opacity=".18" stroke-width="2" />
              <path d="M148 444V338a62 62 0 0 1 124 0v106Z" fill="#160a1a" />
              <g clip-path="url(#boog)"><circle class="gloed" cx="210" cy="392" r="120" fill="url(#gloed)" /></g>
              <rect x="180" y="412" width="60" height="26" rx="4" fill="#c9ccd2" /><ellipse cx="210" cy="412" rx="30" ry="6" fill="#eef0f3" />
              <path d="M210 412v-10" stroke="#3a2a2f" stroke-width="2" />
              <path class="vlam" d="M210 360c11 15 15 28 10 38-3 6-7 8-10 8s-7-2-10-8c-5-10-1-23 10-38Z" fill="url(#vl)" />
              <path d="M76 180q0 30 134 34q134-4 134-34Z" fill="#cbbdd1" />
              <ellipse cx="210" cy="180" rx="134" ry="26" fill="#f4eff6" />
              <ellipse cx="210" cy="182" rx="110" ry="19" fill="#b9aac0" />
              <g class="plas"><ellipse cx="210" cy="184" rx="106" ry="17" fill="var(--wax)" /><ellipse cx="186" cy="179" rx="42" ry="5" fill="#fff" opacity=".28" /></g>
              <g class="bonbon">
                <path d="M176 150h68l-7 30h-54Z" fill="var(--wax)" />
                <path d="M183 152l3 26M193 152l2 27M203 152l1 27M214 152l-1 27M225 152l-2 27M235 152l-3 26" stroke="#000" stroke-opacity=".12" stroke-width="2" />
                <ellipse cx="210" cy="150" rx="34" ry="8" fill="var(--wax)" /><ellipse cx="210" cy="150" rx="34" ry="8" fill="#fff" opacity=".25" />
              </g>
            </svg>
            <div class="damp pointer-events-none absolute inset-x-0 top-0 h-[33%]" aria-hidden="true" data-damp>
              {eerste.noten.map((n, i) => <span style={`--i:${i};--x:${(i % 3) - 1}`}>{n}</span>)}
            </div>
          </div>

          <div class="mt-10 border-t border-lijn-licht pt-8">
            <p class="text-sm text-licht-zacht" id="kies-label">Kies een geur en kijk hem smelten.</p>
            <div class="mt-4 flex flex-wrap gap-2" role="group" aria-labelledby="kies-label">
              {brander.map((g, i) => (
                <button type="button" class="staal cupje relative h-10 w-10 transition-transform hover:-translate-y-0.5 sm:h-12 sm:w-12 xl:h-[3.2rem] xl:w-[3.2rem]" aria-pressed={i === 0 ? 'true' : 'false'}
                  data-naam={g.naam} data-zin={g.zin} data-noten={g.noten.join('|')} data-kleur={g.kleur} data-href={shop(g.pad)}>
                  <Image src={foto(g.slug)} alt="" widths={[112]} sizes="56px" format="webp" quality={60} class="h-full w-full object-cover" />
                  <span class="sr-only">{g.naam}</span>
                </button>
              ))}
            </div>
            <div class="mt-8 grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end" aria-live="polite">
              <div>
                <h3 class="cursief text-2xl" data-naam-uit>{eerste.naam}</h3>
                <p class="mt-2 text-licht-zacht"><span data-zin-uit>{eerste.zin}</span> <span class="text-licht" data-noten-uit>{eerste.noten.join(', ')}.</span></p>
                <p class="mt-2 text-sm text-licht-zacht">Vanaf € 2,75, per 5 of 15 stuks.</p>
              </div>
              <a href={shop(eerste.pad)} class="knop knop-licht gap-[.35em] self-start sm:self-end" data-link-uit><span>Bestel</span><span data-naam-uit>{eerste.naam}</span></a>
            </div>
            <div class="mt-10" aria-hidden="true">
              <div class="relative h-1.5 bg-lijn-licht"><div class="absolute inset-y-0 left-[66.6%] right-0 bg-vlam"></div></div>
              <div class="relative mt-2 h-4 text-xs text-licht-zacht tabular-nums"><span class="absolute left-0">0 uur</span><span class="absolute left-[66.6%] -translate-x-1/2">8</span><span class="absolute right-0">12 uur geur</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. De toonbank: alle 36 Smellies, mixen en de rest van het assortiment. -->
    <section id="toonbank" aria-labelledby="t-toonbank" class="scroll-mt-16">
      <div class="schulp-op" style="--s:var(--color-papier);background:var(--color-pruim)" aria-hidden="true"></div>
      <div class="wrap pb-20 pt-16 lg:pb-28 lg:pt-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="t-toonbank" class="text-3xl">36 Smellies <span class="cursief text-framboos">op de toonbank</span></h2>
          <p class="max-w-sm text-zacht">Elke kleur is een andere geur. Klik er een aan en je bestelt hem in de webwinkel.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6" data-toonbank>
          {smellies.map((g, i) => (
            <li class:list={[i >= 12 && 'meer']}>
              <a href={shop(g.pad)} class="group block no-underline">
                <span class="block aspect-square overflow-hidden" style={`background:${g.kleur}`}>
                  <Image src={foto(g.slug)} alt={`Smellies ${g.naam}, geurbonbons van wax`} widths={[240, 360, 480]} sizes="(min-width: 1024px) 15vw, (min-width: 640px) 30vw, 46vw" format="webp" quality={62} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]" />
                </span>
                <span class="mt-3 flex flex-wrap items-baseline gap-x-2">
                  <span class="cursief text-[1.35rem] leading-tight transition-colors group-hover:text-framboos">{g.naam}</span>
                  <span class="stip max-sm:hidden"></span>
                  <span class="shrink-0 text-sm tabular-nums text-zacht max-sm:w-full">€ 2,75</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
          <button type="button" class="knop" data-meer aria-expanded="false" hidden>Toon alle 36 geuren</button>
          <span class="text-xs text-zacht">Prijzen vanaf, per 5 of 15 stuks. Stand 1 oktober 2026.</span>
        </p>

        <div class="mt-20 grid gap-14 lg:mt-28 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-5">
            <h3 class="text-2xl">Kun je niet kiezen?</h3>
            <p class="mt-3 max-w-md text-zacht">Neem een mix: tien verschillende geuren in één keer.</p>
            <ul class="mt-8 divide-y divide-lijn border-y border-lijn">
              {mixen.map((m) => (
                <li>
                  <a href={shop(m.pad)} class="group flex items-baseline gap-3 py-3.5 no-underline">
                    <span class="min-w-0"><span class="cursief text-xl group-hover:text-framboos">{m.naam}</span><span class="block text-sm text-zacht sm:inline sm:pl-2">10 geuren, {m.zin.toLowerCase().replace('.', '')}</span></span>
                    <span class="stip"></span>
                    <span class="shrink-0 text-sm tabular-nums">€ 5,50</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="lg:col-span-6 lg:col-start-7">
            <h3 class="text-2xl">Smellies &amp; zo</h3>
            <p class="mt-3 max-w-md text-zacht">Dezelfde geuren, ook als kaars, stokjes, olie of spray.</p>
            <ul class="mt-8 grid grid-cols-3 gap-3 sm:grid-cols-6" aria-hidden="true">
              {zoFotos.map((f) => <li class="aspect-[3/4] bg-wit p-2"><Image src={f.src} alt="" widths={[160, 240]} sizes="(min-width: 640px) 8vw, 28vw" format="webp" quality={62} class="h-full w-full object-contain" /></li>)}
            </ul>
            <ul class="mt-8 divide-y divide-lijn border-y border-lijn">
              {zo.map((z) => (
                <li>
                  <a href={shop(z.pad)} class="group flex items-baseline gap-3 py-3.5 no-underline">
                    <span class="min-w-0"><span class="font-medium group-hover:text-framboos">{z.naam}</span>{z.bij && <span class="block text-sm text-zacht sm:inline sm:pl-2">{z.bij}</span>}</span>
                    <span class="stip"></span>
                    <span class="shrink-0 text-sm tabular-nums">{z.prijs}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-xs text-zacht">Stand 1 oktober 2026.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Herfst: hun seizoenscollectie. -->
    <section id="herfst" aria-labelledby="t-herfst" class="scroll-mt-16 bg-lila">
      <div class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:gap-8 lg:py-24">
        <h2 id="t-herfst" class="text-3xl lg:col-span-10">Herfstweer buiten? <span class="cursief text-framboos">Happy Autumn binnen.</span></h2>
        <div class="lg:col-span-4">
          <p class="max-w-sm text-zacht">De herfstcollectie: vier herfstgeuren, roomspray erbij, en een kaars in een keramieken eikel of pompoen. Limited.</p>
          <ul class="mt-8 max-w-sm divide-y divide-lijn border-y border-lijn text-sm">
            <li class="flex items-baseline gap-3 py-3"><span>Herfst-Smellies</span><span class="stip"></span><span class="tabular-nums">€ 2,75</span></li>
            <li class="flex items-baseline gap-3 py-3"><span>Roomspray herfst</span><span class="stip"></span><span class="tabular-nums">€ 6,49</span></li>
            <li class="flex items-baseline gap-3 py-3"><span>Herfstkaars, limited</span><span class="stip"></span><span class="tabular-nums">€ 17,50</span></li>
          </ul>
          <a href={shop('c-5442737/herfst/')} class="knop mt-8">Bekijk de herfstcollectie</a>
        </div>
        <div class="lg:col-span-8">
          <div class="aspect-[1310/462] overflow-hidden">
            <Image src={herfstkaarsen} alt="De drie herfstkaarsen van Smellies: een keramieken eikel open met de kaars erin, een eikel en een pompoen, op een houten plank voor een herfstbos." widths={[640, 960, 1310]} sizes="(min-width: 1024px) 60vw, 100vw" format="webp" quality={62} class="h-full w-full object-cover" />
          </div>
          <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
            {herfst.map((h) => (
              <li>
                <a href={shop(h.pad)} class="group block no-underline">
                  <span class="block aspect-square overflow-hidden"><Image src={foto(h.slug)} alt={`Smellies ${h.naam}, herfstgeur`} widths={[240, 400]} sizes="(min-width: 1024px) 15vw, 45vw" format="webp" quality={62} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.05]" /></span>
                  <span class="cursief mt-2 block text-xl group-hover:text-framboos">{h.naam}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 5. Handgemaakt en ecologisch. -->
    <section aria-labelledby="t-hand" class="overflow-hidden">
      <div class="wrap grid items-center gap-12 py-20 lg:grid-cols-12 lg:gap-8 lg:py-28">
        <div class="relative lg:col-span-5">
          <div class="cupje mx-auto aspect-square w-[78%] max-w-[30rem] lg:w-full">
            <Image src={foto('smellies-baccarat')} alt="Smellies Baccarat: hartjes van wax in lila en wit" widths={[400, 640, 800]} sizes="(min-width: 1024px) 36vw, 78vw" format="webp" quality={64} class="h-full w-full object-cover" />
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <h2 id="t-hand" class="text-4xl">Alles zelf.<br /><span class="cursief text-framboos">Met de hand.</span></h2>
          <p class="mt-8 max-w-lg text-lg leading-relaxed">Sinds 2013 maakt Smellies de geurbonbons, geurkaarsen en geurartikelen zelf. Alleen met ecologische grondstoffen, omdat er in veel geurartikelen voor in huis chemische middelen zitten.</p>
          <p class="mt-8 flex flex-wrap gap-x-3 gap-y-2 text-sm">
            {['100% soja- en koolzaadwas', 'geen paraffine', 'niet getest op dieren', 'spettert niet'].map((t, i) => (
              <span class="inline-flex items-center gap-3">{i > 0 && <span class="cupje inline-block h-2.5 w-2.5 bg-framboos" aria-hidden="true"></span>}{t}</span>
            ))}
          </p>
        </div>
      </div>
    </section>

    <!-- 6. Groothandel en verkooppunten. -->
    <section id="groothandel" aria-labelledby="t-groot" class="scroll-mt-16 border-t border-lijn">
      <div class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:gap-8 lg:py-28">
        <div class="lg:col-span-6">
          <h2 id="t-groot" class="text-3xl">Smellies in je eigen winkel?</h2>
          <p class="mt-6 max-w-lg text-lg leading-relaxed">Naast de webwinkel ligt Smellies bij verkooppunten in drie landen. Heb je een winkel, geef dan je bedrijfsgegevens door. Na goedkeuring krijg je een account bij de groothandel.</p>
          <p class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={site.groothandel} class="knop">Naar de groothandel</a>
            <a href={waMet('ik heb een winkel en wil graag verkooppunt van Smellies worden. Mijn bedrijf: ')} class="lijn inline-flex items-center gap-2 text-sm"><Fragment set:html={wa} />Of app je gegevens</a>
          </p>
        </div>
        <ul class="display text-[clamp(2.6rem,6vw,6rem)] leading-[1.02] lg:col-span-5 lg:col-start-8 lg:text-right" aria-label="Verkooppunten in">
          <li>Nederland</li>
          <li class="cursief text-framboos">België</li>
          <li>Engeland</li>
        </ul>
      </div>
    </section>

    <!-- 7. Contact en langskomen. -->
    <section id="contact" aria-labelledby="t-contact" class="scroll-mt-16 bg-wit">
      <div class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:gap-8 lg:py-24">
        <div class="lg:col-span-5">
          <h2 id="t-contact" class="text-3xl">Langskomen in Dordrecht? <span class="cursief text-framboos">Laat het even weten.</span></h2>
          <p class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={waMet('ik wil graag een keer langskomen. Kan dat op ')} class="knop"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <a href={site.telHref} class="lijn text-sm tabular-nums">of bel {site.tel}</a>
          </p>
        </div>
        <div class="space-y-10 lg:col-span-7">
        <dl class="grid gap-8 text-sm sm:grid-cols-3">
          <div>
            <dt class="cursief text-xl">Adres</dt>
            <dd class="mt-2">{site.straat}<br />{site.postcode} {site.plaats}<br /><a href={site.maps} class="lijn">Route</a></dd>
          </div>
          <div>
            <dt class="cursief text-xl">Bereikbaar</dt>
            <dd class="mt-2 tabular-nums">Maandag tot en met donderdag<br />09.00 tot 17.00 uur<br /><span class="text-zacht">Vrijdag tot en met zondag dicht</span></dd>
          </div>
          <div>
            <dt class="cursief text-xl">Bestellen</dt>
            <dd class="mt-2">Op een werkdag voor 15.00 uur besteld, dan gaat het dezelfde dag mee met PostNL (als alles op voorraad is). Brievenbus € 4,95, pakket € 6,95.</dd>
          </div>
        </dl>
          <p class="flex flex-wrap gap-x-6 gap-y-2 border-t border-lijn pt-6 text-sm text-zacht">
            <a href={`mailto:${site.mail}`} class="lijn text-inkt">{site.mail}</a>
            <a href={site.instagram} class="lijn text-inkt">Instagram</a>
            <a href={site.facebook} class="lijn text-inkt">Facebook</a>
            <span>Google: 5,0 uit 5</span>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  /* Vitrine: het vak dat bij het woord hoort, krijgt een framboos randje. */
  .vak::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 0 var(--color-framboos); transition: box-shadow .5s ease; pointer-events: none; }
  .vak.aan::after { box-shadow: inset 0 0 0 6px var(--color-framboos); }
  .woordvak { display: inline-block; overflow: hidden; vertical-align: bottom; padding: 0 .05em .18em 0; margin: 0 -.05em -.18em 0; }
  [data-woord] { transition: transform .35s ease; }
  [data-woord].weg { transform: translateY(115%); }

  /* De brander. */
  .vlam { transform-box: fill-box; transform-origin: 50% 100%; animation: flakker 2.6s ease-in-out infinite; }
  .gloed { transform-box: fill-box; transform-origin: center; animation: gloei 2.6s ease-in-out infinite; }
  @keyframes flakker { 0%, 100% { transform: scale(1, 1) skewX(0); } 30% { transform: scale(.94, 1.06) skewX(2deg); } 60% { transform: scale(1.03, .96) skewX(-2deg); } }
  @keyframes gloei { 0%, 100% { opacity: .9; } 50% { opacity: .7; } }
  .plas ellipse:first-child, .bonbon path:first-child, .bonbon ellipse:first-of-type { transition: fill .6s ease; }
  .plas, .bonbon { transform-box: fill-box; }
  .plas { transform-origin: center; }
  .bonbon { transform-origin: 50% 100%; opacity: 0; }
  .speel .bonbon { animation: smelt 3.4s ease-in-out forwards; }
  .speel .plas { animation: vul 3.4s ease-in-out forwards; }
  @keyframes smelt { 0% { opacity: 0; transform: translateY(-70px); } 14% { opacity: 1; transform: translateY(0); } 34% { transform: translateY(0) scale(1, 1); opacity: 1; } 88% { transform: translateY(26px) scale(1.25, .12); opacity: .9; } 100% { transform: translateY(28px) scale(1.3, .05); opacity: 0; } }
  @keyframes vul { 0%, 30% { transform: scale(.22, .3); } 100% { transform: scale(1); } }

  .damp :global(span) { position: absolute; bottom: 0; left: 50%; white-space: nowrap; font-family: var(--font-display); font-style: italic; font-size: clamp(1rem, 1.4vw, 1.3rem); color: var(--color-licht); opacity: 0;
    translate: calc(-50% + var(--x) * var(--spreid, 3.6rem)) 0; animation: stijg 6.5s ease-out infinite; animation-delay: calc(var(--i) * 1.1s); }
  @media (min-width: 640px) { .damp { --spreid: 6.5rem; } }
  @keyframes stijg { 0% { opacity: 0; transform: translateY(40px); } 18% { opacity: .95; } 70% { opacity: .6; } 100% { opacity: 0; transform: translateY(-120px); } }
  @media (prefers-reduced-motion: reduce) { .bonbon { opacity: 0; } .damp { display: none; } }

  .staal[aria-pressed='true'] { transform: translateY(-4px) scale(1.08); }
  .staal[aria-pressed='true']::after { content: ''; position: absolute; left: 50%; bottom: -10px; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: var(--color-vlam); }
  .staal { overflow: visible; }
  .kort .meer { display: none; }
</style>

<script>
  // Vitrine: het woord in de kop wisselt, en het bijbehorende vak licht op.
  const woordEl = document.querySelector<HTMLElement>('[data-woord]');
  const vakken = [...document.querySelectorAll<HTMLElement>('[data-vak]')].filter((v) => v.dataset.vak);
  const rustig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (woordEl && vakken.length && !rustig) {
    let n = 0;
    const zet = () => { vakken.forEach((v, i) => v.classList.toggle('aan', i === n)); };
    zet();
    setInterval(() => {
      woordEl.classList.add('weg');
      setTimeout(() => { n = (n + 1) % vakken.length; woordEl.textContent = vakken[n].dataset.vak!; woordEl.classList.remove('weg'); zet(); }, 350);
    }, 2600);
  }

  // Brander: kies een geur, de bonbon valt in het schaaltje en smelt, de noten stijgen op.
  const b = document.querySelector<HTMLElement>('[data-brander]');
  if (b) {
    const damp = b.querySelector<HTMLElement>('[data-damp]')!;
    const speel = () => { b.classList.remove('speel'); void b.offsetWidth; b.classList.add('speel'); };
    b.querySelectorAll<HTMLButtonElement>('.staal').forEach((knop) => {
      knop.addEventListener('click', () => {
        const d = knop.dataset;
        b.querySelectorAll('.staal').forEach((k) => k.setAttribute('aria-pressed', String(k === knop)));
        b.style.setProperty('--wax', d.kleur!);
        b.querySelectorAll('[data-naam-uit]').forEach((e) => (e.textContent = d.naam!));
        b.querySelector('[data-zin-uit]')!.textContent = d.zin!;
        const noten = d.noten!.split('|');
        b.querySelector('[data-noten-uit]')!.textContent = noten.join(', ') + '.';
        b.querySelector<HTMLAnchorElement>('[data-link-uit]')!.href = d.href!;
        damp.replaceChildren(...noten.map((n, i) => { const s = document.createElement('span'); s.textContent = n; s.style.setProperty('--i', String(i)); s.style.setProperty('--x', String((i % 3) - 1)); return s; }));
        if (!rustig) speel();
      });
    });
    if (!rustig) new IntersectionObserver((e, o) => { if (e[0].isIntersecting) { speel(); o.disconnect(); } }, { threshold: .4 }).observe(b);
  }

  // Toonbank: eerst 12 geuren, met een knop voor alle 36.
  const lijst = document.querySelector('[data-toonbank]');
  const meer = document.querySelector<HTMLButtonElement>('[data-meer]');
  if (lijst && meer) {
    meer.hidden = false;
    lijst.classList.add('kort');
    meer.addEventListener('click', () => {
      const open = !lijst.classList.toggle('kort');
      meer.setAttribute('aria-expanded', String(open));
      meer.textContent = open ? 'Toon minder' : 'Toon alle 36 geuren';
    });
  }
</script>
