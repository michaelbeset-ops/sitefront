---
import { site, url, waHoi } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const items = ['Mozaïektafels', 'Oosterse lampen', 'Aardewerk', 'Dienbladen', 'Hennalampen', 'Poefs en spiegels'];
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht">
        <span class="merk-teken" aria-hidden="true"><Icoon naam="ster8" class="h-6 w-6" /></span>
        <span><b>Zoutewelle</b><small>import uit Marokko</small></span>
      </a>
      <p class="mt-6 max-w-xs">Ruim 20 jaar handgemaakte mozaïektafels, lampen en aardewerk uit Marokko. Showroom in Dordrecht, op afspraak.</p>
      <p class="mt-6 flex gap-3">
        <a href={site.instagram} class="grid h-10 w-10 place-items-center rounded-full bg-nacht-2 text-licht transition-colors hover:bg-groen" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
        <a href={waHoi} class="grid h-10 w-10 place-items-center rounded-full bg-nacht-2 text-licht transition-colors hover:bg-groen" aria-label="WhatsApp"><Icoon naam="wa" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Assortiment</p>
      <ul class="mt-4 space-y-2">
        {items.map((t) => <li><a href={h('assortiment')} class="no-underline transition-colors hover:text-groen-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={waHoi} class="num whitespace-nowrap no-underline transition-colors hover:text-groen-licht">WhatsApp {site.mobiel}</a></li>
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-groen-licht">{site.tel}</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-all no-underline transition-colors hover:text-groen-licht">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-2">
      <p class="font-semibold text-licht">Showroom</p>
      <p class="mt-4">Maandag t/m zaterdag<br />op afspraak<br /><span class="num">12.00 - 19.00 uur</span></p>
      <p class="mt-3"><a href={site.maps} class="no-underline transition-colors hover:text-groen-licht">Route plannen</a></p>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-groen-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van mozaiek-marokko.nl, het Google-profiel en Instagram van Zoutewelle Import. Reviews letterlijk van Google (stand 5 november 2026).</p>}
  </div>
</footer>
