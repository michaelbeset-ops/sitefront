---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['assortiment', 'Assortiment'], ['marokko', 'Uit Marokko'], ['showroom', 'Showroom'], ['reviews', 'Reviews'], ['bezoek', 'Bezoek']];
---
<!-- Eén kop bovenaan: de dunne topbalk scrolt weg, de menubalk blijft plakken. -->
<div class="bg-nacht text-licht">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[.8125rem]">
    <ul class="flex items-center gap-6 overflow-hidden whitespace-nowrap">
      <li class="flex items-center gap-1.5"><Icoon naam="vink" class="h-3.5 w-3.5 text-groen-licht" />Alles met de hand gemaakt</li>
      <li class="hidden items-center gap-1.5 sm:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-groen-licht" />Ruim 20 jaar import uit Marokko</li>
      <li class="hidden items-center gap-1.5 lg:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-groen-licht" />Gratis parkeren</li>
    </ul>
    <a href={site.wa} class="num hidden items-center gap-1.5 font-semibold no-underline hover:text-groen-licht md:flex"><Icoon naam="wa" class="h-3.5 w-3.5" />{site.mobiel}</a>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-lijn bg-zand/95 backdrop-blur-md">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <a href={url('')} class="merk" aria-label={`${site.naam}, naar de homepage`}>
      <span class="merk-teken" aria-hidden="true"><Icoon naam="ster8" class="h-6 w-6" /></span>
      <span><b>Zoutewelle</b><small>import uit Marokko</small></span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="no-underline transition-colors hover:text-groen">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={site.telHref} class="num hidden font-semibold no-underline transition-colors hover:text-groen xl:inline">{site.tel}</a>
      <a href={waHoi} class="knop knop-groen knop-klein hidden sm:inline-flex"><Icoon naam="wa" />App Edwin</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full bg-wit shadow-sm lg:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu" aria-label="Menu" class="hidden border-t border-lijn bg-zand lg:hidden" data-menu>
    <ul class="wrap py-4">
      {nav.map(([id, t]) => <li><a href={h(id)} class="flex items-center justify-between border-b border-lijn py-3.5 font-kop text-xl font-bold no-underline">{t}<Icoon naam="pijl" class="h-5 w-5 text-groen" /></a></li>)}
      <li class="pt-5"><a href={waHoi} class="knop knop-groen w-full"><Icoon naam="wa" />App voor een afspraak</a></li>
    </ul>
  </nav>
</header>

<!-- Mobiele onderbalk -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2.5 border-t border-lijn bg-zand/95 p-2.5 backdrop-blur-md md:hidden">
  <a href={site.mobielHref} class="knop knop-wit knop-klein shadow-sm"><Icoon naam="tel" />Bellen</a>
  <a href={waHoi} class="knop knop-groen knop-klein"><Icoon naam="wa" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
