---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;
const route = 'https://www.google.com/maps/dir/?api=1&destination=Aventurijn+1420+3316+LB+Dordrecht';
const app = 'https://wa.me/31621278454';

// Assortiment uit hun eigen site, in eigen woorden samengevat.
const assortiment = [
  ['Mozaïektafels en fonteinen', 'In Marrakech met de hand gelegd, van een tafeltje van 40 cm tot een tafel van 2 meter.'],
  ['Lampen en lantaarns', 'Marokkaanse en oosterse lampen van 30 tot 150 cm. Elke lamp is uniek.'],
  ['Aardewerk', 'Schalen, borden, kommen en vazen uit Safi, loodvrij.'],
  ['Dienbladen en theepotten', 'Oude zilveren dienbladen, ook als salontafel uit te voeren.'],
  ['Hennalampen', 'Leren lampen, met de hand beschilderd met henna.'],
  ['Spiegels', 'Van vertind koper of smeedijzer, van 40 bij 40 tot 180 bij 80 cm.'],
  ['Kasten en dressoirs', 'Marokkaanse kasten, dressoirs en bijzettafels.'],
  ['Stoelen en banken', 'Smeedijzer, mooi bij een mozaïektafel in de tuin.'],
  ['Poefs en kussens', 'Handgemaakte leren poefs uit de medina van Marrakech.'],
];
---
<Base
  title="Zoutewelle Import | Mozaïektafels en Marokkaanse lampen, Dordrecht"
  description="Handgemaakte mozaïektafels, lampen, aardewerk en meubels uit Marokko. Bekijk ze in de showroom aan de Aventurijn 1420 in Dordrecht."
>
  <section class="relative isolate bg-night text-paper">
    <div class="absolute inset-0 -z-10 [&_img]:h-full [&_img]:w-full [&_img]:object-cover">
      <Foto naam="hero" alt="Wand vol oosterse lantaarns met gekleurd glas" sizes="100vw" eager />
    </div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(42_29_22/0.92)_12%,rgb(42_29_22/0.55)_55%,rgb(42_29_22/0.2))]"></div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 min-h-[36rem] sm:min-h-[42rem] lg:min-h-[46rem] flex flex-col justify-end pt-20 pb-12 sm:pb-16">
      <p class="text-sm tracking-[0.14em] uppercase font-semibold text-paper/85">Showroom in Dordrecht</p>
      <h1 class="mt-4 text-4xl max-w-[16ch]">Mozaïektafels en lampen, rechtstreeks uit Marokko</h1>
      <p class="mt-6 max-w-xl text-lg text-paper/90">Al meer dan 20 jaar importeren wij handgemaakte woonaccessoires uit Marokko. Bekijk ze rustig in het echt, in onze showroom aan de Aventurijn.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={app} class="inline-flex bg-accent text-paper font-semibold px-5 py-3 hover:bg-accent-deep transition-colors">App voor een afspraak</a>
        <a href={u('#assortiment')} class="inline-flex border border-paper/70 px-5 py-3 hover:bg-paper hover:text-ink transition-colors">Bekijk het assortiment</a>
      </div>
    </div>
  </section>

  <!-- Assortiment als rustige catalogus in twee kolommen, geen kaartjes. -->
  <section id="assortiment" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28">
    <div class="grid gap-8 lg:grid-cols-12 items-end">
      <h2 class="lg:col-span-6 text-3xl">Alles met de hand gemaakt</h2>
      <p class="lg:col-span-5 lg:col-start-8 text-ink-soft">Omdat alles handwerk is, is geen tafel, lamp of schaal hetzelfde. Staat er niet wat u zoekt, dan laten we het maken in de kleur en maat die u wilt.</p>
    </div>
    <dl class="mt-12 grid md:grid-cols-2 gap-x-14 border-t-2 border-ink">
      {assortiment.map(([naam, uitleg]) => (
        <div class="py-6 border-b border-line">
          <dt class="display text-xl">{naam}</dt>
          <dd class="mt-1 text-ink-soft">{uitleg}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-6 text-sm text-ink-soft">[[AANLEVEREN: foto's van de showroom en een paar topstukken]]</p>
  </section>

  <!-- Showroom: brede foto met het verhaal van de inkoop ernaast. -->
  <section id="showroom" class="bg-paper-2">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7 [&_img]:w-full [&_img]:h-auto">
        <Foto naam="markt" alt="Kleden, tassen en lantaarns in een Marokkaans winkeltje" sizes="(min-width: 1024px) 55vw, 100vw" />
      </div>
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Zelf uitgezocht, in Marokko</h2>
        <p class="mt-6 text-ink-soft">We laten alles speciaal maken bij kleine familiebedrijven, elk met hun eigen ambacht. We gaan er regelmatig zelf heen om de bestellingen te controleren, en laden daarna een container voor Nederland.</p>
        <p class="mt-4 text-ink-soft">Bent u winkelier en wilt u onze artikelen verkopen? Mail ons met uw bedrijfsnaam, adres, website en KvK-nummer.</p>
        <a href="mailto:info@zoutewelle-import.nl" class="mt-6 inline-block font-semibold underline">info@zoutewelle-import.nl</a>
      </div>
    </div>
  </section>

  <section id="bezoek" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 class="text-3xl">Langskomen</h2>
      <dl class="mt-8 border-t-2 border-ink">
        <div class="flex justify-between gap-4 py-3 border-b border-line"><dt>Zaterdag</dt><dd class="font-semibold tabular-nums">12:30 – 17:00</dd></div>
        <div class="flex justify-between gap-4 py-3 border-b border-line"><dt>Maandag t/m vrijdag</dt><dd class="font-semibold tabular-nums">op afspraak, 12:00 – 19:00</dd></div>
      </dl>
      <p class="mt-4 text-sm text-ink-soft">Komt u doordeweeks? Bel of app even vooraf, er is niet altijd iemand in het magazijn.</p>
      <p class="mt-8">Aventurijn 1420<br />3316 LB Dordrecht</p>
      <a href={route} class="mt-3 inline-block font-semibold underline">Plan uw route</a>
      <p class="mt-8 leading-8">
        <a class="font-semibold hover:text-accent" href="tel:+31786186949">078 618 69 49</a><br />
        <a class="hover:text-accent" href={app}>06 21 27 84 54 (WhatsApp)</a>
      </p>
    </div>
    <form class="lg:col-span-6 lg:col-start-7 grid gap-5 self-start bg-paper-2 p-6 sm:p-8" action="https://api.web3forms.com/submit" method="POST">
      <h3 class="text-2xl">Vraag over een stuk?</h3>
      <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-key]]" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2 text-sm">Naam<input name="naam" required autocomplete="name" class="bg-paper border border-line px-3 py-3 text-base" /></label>
        <label class="grid gap-2 text-sm">Telefoon of e-mail<input name="contact" required class="bg-paper border border-line px-3 py-3 text-base" /></label>
      </div>
      <label class="grid gap-2 text-sm">Wat zoekt u? Kleur, maat, soort<textarea name="bericht" rows="4" class="bg-paper border border-line px-3 py-3 text-base"></textarea></label>
      {voorstel ? (
        <p class="border border-accent px-4 py-3 text-sm">Dit is een ontwerpvoorstel, dus het formulier verstuurt nog niets. Bel <a class="underline" href="tel:+31786186949">078 618 69 49</a> of app <a class="underline" href={app}>06 21 27 84 54</a>.</p>
      ) : (
        <button type="submit" class="justify-self-start bg-accent text-paper font-semibold px-6 py-3 hover:bg-accent-deep">Verstuur</button>
      )}
      <p class="text-xs text-ink-soft">We gebruiken uw gegevens alleen voor uw vraag. Zie de <a class="underline" href={u('privacy/')}>privacyverklaring</a>.</p>
    </form>
  </section>
</Base>
