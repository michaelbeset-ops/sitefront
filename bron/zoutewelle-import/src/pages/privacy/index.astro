---
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import { site } from '../../data/site';
---
<Base title={`Privacyverklaring | ${site.naam}`} description="Hoe Zoutewelle Import in Dordrecht omgaat met uw persoonsgegevens.">
  <Kop thuis={false} />
  <main id="inhoud" class="wrap py-16 lg:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Privacy</p>
      <h1 class="mt-4 text-3xl">Privacyverklaring</h1>
      <div class="mt-10 grid gap-8 text-grijs [&_h2]:text-xl [&_h2]:text-inkt [&_h2]:mb-2">
        <section><h2>Wie zijn wij</h2><p>{site.naam}, {site.straat}, {site.postcode} {site.plaats}. Telefoon {site.tel} of {site.mobiel}, e-mail <a class="link text-inkt" href={`mailto:${site.mail}`}>{site.mail}</a>.</p></section>
        <section><h2>Welke gegevens</h2><p>Als u ons appt, belt of mailt, ontvangen wij uw naam, telefoonnummer en wat u ons vertelt. De tafelkiezer op deze site verstuurt zelf niets: hij zet alleen een WhatsApp-bericht voor u klaar.</p></section>
        <section><h2>Waarvoor</h2><p>Alleen om uw vraag te beantwoorden, een afspraak te maken en een aankoop af te handelen. Wij verkopen uw gegevens niet.</p></section>
        <section><h2>Hoe lang</h2><p>Wij bewaren uw gegevens niet langer dan nodig voor uw vraag of aankoop, of zolang de wet dat vraagt.</p></section>
        <section><h2>Cookies</h2><p>Deze website plaatst geen cookies en gebruikt geen analyse- of advertentiediensten. Links naar WhatsApp, Google Maps en Instagram openen pas een andere site als u erop klikt.</p></section>
        <section><h2>Uw rechten</h2><p>U mag uw gegevens inzien, laten aanpassen of laten verwijderen. Mail of bel ons daarvoor. Bent u het niet eens met hoe wij met uw gegevens omgaan, dan kunt u een klacht indienen bij de Autoriteit Persoonsgegevens.</p></section>
      </div>
    </div>
  </main>
  <Voet thuis={false} />
</Base>
