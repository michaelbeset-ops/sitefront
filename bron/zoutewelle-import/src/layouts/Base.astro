---
import '../styles/global.css';
// Voorladen voorkomt dat de grote kop verspringt als het font binnenkomt (CLS).
import display from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import body from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;
const og = new URL(u('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {voorstel && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content="nl_NL" />
  <meta name="theme-color" content="#2a1d16" />
  {[display, body].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('sitemap-index.xml')} />
</head>
<body>
  <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-accent text-paper px-4 py-2">Naar de inhoud</a>
  {voorstel && (
    <div class="bg-ink text-paper text-xs">
      <p class="mx-auto max-w-[84rem] px-4 sm:px-8 py-2">
        Ontwerpvoorstel van <a class="underline" href="https://www.sitefront.nl">Sitefront</a> voor Zoutewelle Import. Dit is niet de officiële website.
      </p>
    </div>
  )}

  <header class="sticky top-0 z-30 bg-paper/95 border-b border-line">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
      <a href={u()} class="display text-[1.3rem] sm:text-[1.6rem] leading-none whitespace-nowrap">Zoutewelle<span class="text-accent">·</span>Import</a>
      <nav aria-label="Hoofdmenu" class="flex items-center gap-7 text-sm font-medium">
        <a class="hidden lg:inline hover:text-accent" href={u('#assortiment')}>Assortiment</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#showroom')}>Showroom</a>
        <a class="hidden lg:inline hover:text-accent" href={u('#bezoek')}>Bezoek</a>
        <a href="tel:+31786186949" class="inline-flex items-center gap-2 bg-ink text-paper px-3 sm:px-4 py-2 hover:bg-accent transition-colors">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>
          <span class="whitespace-nowrap"><span class="max-[379px]:sr-only">078 618 69 49</span><span class="min-[380px]:hidden">Bel</span></span>
        </a>
      </nav>
    </div>
  </header>

  <main id="inhoud">
    <slot />
  </main>

  <footer class="bg-night text-paper">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 pt-16 pb-10 grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="display text-[2.2rem]">Zoutewelle Import</p>
        <p class="mt-4 max-w-sm text-sm text-night-soft">Handgemaakte mozaïektafels, lampen en woonaccessoires uit Marokko. Showroom en magazijn in Dordrecht.</p>
      </div>
      <div class="md:col-span-4 text-sm leading-7">
        <p>Aventurijn 1420<br />3316 LB Dordrecht</p>
        <p class="mt-3"><a class="hover:underline" href="tel:+31786186949">078 618 69 49</a><br /><a class="hover:underline" href="tel:+31621278454">06 21 27 84 54</a><br /><a class="hover:underline break-all" href="mailto:info@zoutewelle-import.nl">info@zoutewelle-import.nl</a></p>
      </div>
      <div class="md:col-span-3 text-sm leading-7">
        <p>Zaterdag 12:30 tot 17:00</p>
        <p>Ma t/m vr op afspraak, 12:00 tot 19:00</p>
        <p class="mt-3"><a class="hover:underline" href={u('privacy/')}>Privacyverklaring</a></p>
        <p class="text-night-soft">KvK [[AANLEVEREN: KvK-nummer]]</p>
      </div>
    </div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 pb-8">
      <p class="border-t border-ink-soft pt-6 text-xs text-night-soft">© {new Date().getFullYear()} Zoutewelle Import</p>
    </div>
  </footer>
</body>
</html>
