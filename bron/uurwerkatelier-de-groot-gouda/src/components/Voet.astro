---
import { site, url } from '../data/site';
---
<footer class="donker bg-nacht text-licht">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-kop text-xl font-extrabold tracking-tight">{site.naam}</p>
      <p class="mt-2 max-w-xs text-sm text-licht-zacht">Horlogemaker in Gouda. Officieel Omega Certified Service Center en dealer van Hamilton.</p>
    </div>
    <div class="text-sm">
      <p class="font-semibold">Adres</p>
      <p class="mt-2 text-licht-zacht">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3 text-licht-zacht">{site.tijden[0].dag}<br /><span class="num">{site.tijden[0].tijd}</span></p>
    </div>
    <div class="text-sm">
      <p class="font-semibold">Contact</p>
      <ul class="mt-2 space-y-1 text-licht-zacht">
        <li><a href={site.telHref} class="num hover:text-licht">{site.tel}</a></li>
        <li><a href={site.wa} class="hover:text-licht" rel="noopener">WhatsApp</a></li>
        <li><a href={site.facebook} class="hover:text-licht" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap justify-between gap-3 py-5 text-xs text-licht-zacht">
      <p>{site.naam}, {site.plaats}</p>
      <a href={url('privacy/')} class="underline underline-offset-2 hover:text-licht">Privacyverklaring</a>
    </div>
  </div>
</footer>

<!-- Op mobiel staan bellen en appen altijd binnen duimbereik. -->
<div class="donker fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-lijn-licht bg-nacht p-2 md:hidden">
  <a href={site.telHref} class="knop knop-licht min-h-12 px-3 text-base">Bellen</a>
  <a href={site.wa} class="knop knop-rand min-h-12 px-3 text-base text-licht" rel="noopener">WhatsApp</a>
</div>
