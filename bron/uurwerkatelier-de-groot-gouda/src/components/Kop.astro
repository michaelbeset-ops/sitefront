---
import { site, url } from '../data/site';
const nav = [
  { href: url('#omega'), tekst: 'Omega-service' },
  { href: url('#diensten'), tekst: 'Diensten' },
  { href: url('#werkwijze'), tekst: 'Werkwijze en kosten' },
  { href: url('#contact'), tekst: 'Contact' },
];
---
<header class="sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-sm">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href={url()} class="flex items-center gap-3 no-underline">
      <svg viewBox="0 0 32 32" class="size-9 shrink-0" aria-hidden="true">
        <circle cx="16" cy="16" r="14.5" fill="#fbfaf6" stroke="#121726" stroke-width="1.5" />
        <path d="M16 3.5v3M28.5 16h-3M16 28.5v-3M3.5 16h3" stroke="#121726" stroke-width="1.5" />
        <path d="M16 16V9M16 16l4.5 2.6" stroke="#121726" stroke-width="1.8" stroke-linecap="round" />
        <path class="secondewijzer" d="M16 18.5V5.5" stroke="#2446a6" stroke-width="1" stroke-linecap="round" />
        <circle cx="16" cy="16" r="1.4" fill="#2446a6" />
      </svg>
      <span class="leading-tight">
        <span class="block font-kop text-lg font-extrabold tracking-tight">F.J. de Groot</span>
        <span class="block text-xs text-grijs">Uurwerkatelier, Gouda</span>
      </span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-sm font-medium">
        {nav.map((n) => <li><a href={n.href} class="hover:text-staal">{n.tekst}</a></li>)}
      </ul>
    </nav>
    <a href={site.telHref} class="knop knop-staal hidden min-h-11 px-4 text-base sm:inline-flex"><span class="num">{site.tel}</span></a>
  </div>
</header>
