---
import { Image } from 'astro:assets';
import { url } from '../data/site';
import beeldmerk from '../assets/beeldmerk.png';
---
<a href={url('')} class="inline-flex items-center gap-3 text-inherit no-underline">
  <Image src={beeldmerk} alt="" width={44} height={44} widths={[44, 88]} sizes="44px" class="h-10 w-10 object-contain md:h-11 md:w-11" />
  <span class="flex flex-col leading-none">
    <b class="font-kop text-[1.45rem] font-normal tracking-[.01em]">Lieve Lust</b>
    <small class="mt-1 text-[.6875rem] font-medium tracking-[.14em] opacity-80">veelzijdige catering</small>
  </span>
</a>
