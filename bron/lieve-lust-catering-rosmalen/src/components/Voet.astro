---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const jaar = new Date().getFullYear();
---
<footer class="op-nacht bg-nacht text-maan">
  <div class="wrap grid gap-x-10 gap-y-12 border-t border-lijn-n py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-wit md:col-span-5">
      <Merk />
      <p class="mt-6 max-w-xs text-maan">Kleinschalige, allround cateringservice in {site.plaats}.</p>
    </div>
    <div class="md:col-span-4">
      <p class="font-kop text-lg text-wit">Contact</p>
      <p class="mt-4"><a href={waHoi} class="link">WhatsApp</a> of <a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1">{site.regio}</p>
      <p class="mt-4 flex items-center gap-2"><Icoon naam="ster" class="h-4 w-4 text-oranje" /><a href={site.reviews} class="link">{site.google.score} op Google, {site.google.aantal} reviews</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-kop text-lg text-wit">Volg ons</p>
      <p class="mt-4"><a href={site.instagram} class="link">Instagram</a></p>
      <p class="mt-1"><a href={site.facebook} class="link">Facebook</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-n py-7 text-xs">
    <p>© {jaar} {site.vol}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-oranje">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en foto’s van jullie eigen website (webarchief). Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
