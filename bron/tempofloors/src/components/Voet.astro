---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-inkt text-mist">
  <div class="visgraat visgraat-licht" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk />
      <p class="mt-6 max-w-xs">Vloerspecialisten uit {site.plaats}. Verkoop en advies, egaliseren, leggen en afwerken.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Volg het werk</p>
      <ul class="mt-4 space-y-1.5">
        <li><a href={site.instagram} class="link link-licht">Instagram</a></li>
        <li><a href={site.tiktok} class="link link-licht">TikTok</a></li>
        <li><a href={site.reviews} class="link link-licht">Reviews op Google</a></li>
      </ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link link-licht num">{site.tel}</a> <a href={waHoi} class="link link-licht">(ook WhatsApp)</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-1.5">{site.plaats}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Foto's en projecten van jullie eigen Instagram en TikTok. Reviews letterlijk van Google (stand 10 oktober 2026).</p>}
</footer>
