---
// Woordmerk naar hun logo: "Tempo" groot, "Floors" kleiner eronder ingesprongen, zoals op hun wand en Instagram.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col leading-none no-underline ${donker ? 'text-merk' : 'text-wit'}`} aria-label="TempoFloors, naar de homepage">
  <span class="kop text-[1.7rem] font-[560] tracking-[-.03em] sm:text-[1.9rem]">Tempo</span>
  <span class="kop -mt-0.5 ml-[1.15em] text-[.78rem] font-[480] tracking-[.32em] opacity-85" style="font-stretch:125%">FLOORS</span>
</a>
