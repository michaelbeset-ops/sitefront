---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Bestel from '../components/Bestel.astro';
import { site } from '../data/site';
import tafel from '../assets/tafel.jpg';
import pand from '../assets/pand.jpg';
import redVelvet from '../assets/red-velvet.jpg';
import latteTosti from '../assets/latte-tosti.jpg';
import matcha from '../assets/matcha.jpg';
import pancakes from '../assets/pancakes.jpg';

const dagen = [
  { dag: 'Maandag', wd: 1, open: true },
  { dag: 'Dinsdag', wd: 2, open: false },
  { dag: 'Woensdag', wd: 3, open: true },
  { dag: 'Donderdag', wd: 4, open: true },
  { dag: 'Vrijdag', wd: 5, open: true },
  { dag: 'Zaterdag', wd: 6, open: true },
  { dag: 'Zondag', wd: 0, open: true },
];
const gevel = ['Coffee & sweets', 'Sandwiches & bowls', 'Smoothies & pancakes'];
const waPad = 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z';
const belPad = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z';
---
<Base title={`${site.naam} | Pancakes, broodjes en matcha in Eindhoven`} description="Lunchroom 1NUL1 aan de Hoogstraat 101 in Eindhoven. Pancakes, broodjes, matcha en latte, alles halal. Open 08.30 tot 17.00, dinsdag gesloten. Bestel of reserveer via WhatsApp.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO: gevelzwart, grote kop, eigen foto van tafel vol eten die over de rand valt -->
    <section class="relative bg-inkt text-melk">
      <div class="wrap grid gap-10 pb-12 pt-8 sm:pt-14 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-0 lg:pb-16 lg:pt-16">
        <div class="lg:col-span-7 lg:row-start-1">
          <p class="eyebrow text-velvet-licht"><span class="hidden sm:inline">Lunchroom · </span>Hoogstraat 101, Eindhoven</p>
          <h1 class="mt-4 text-4xl sm:mt-5">Pancakes, broodjes <span class="text-velvet-licht">&amp;</span> <span class="text-matcha-licht">matcha</span></h1>
          <p class="mt-5 max-w-xl text-melk/85 sm:mt-6 sm:text-lg">Red velvet pancakes, een sandwich kip &amp; truffel of een chicken melt, met een matcha of latte erbij. Alles is halal.</p>
          <div class="mt-7 flex flex-wrap gap-3 sm:mt-8">
            <a href={site.whatsapp} class="btn btn-velvet"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d={waPad}/></svg>Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-melk"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d={belPad}/></svg><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
        </div>

        <div class="relative lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1">
          <figure class="relative z-10 h-full overflow-hidden rounded-2xl shadow-xl">
            <div class="aspect-[4/5] sm:aspect-[5/4] lg:aspect-auto lg:h-full lg:min-h-[36rem]">
              <Foto src={tafel} alt="Tafel bij 1NUL1: een stokbrood met kip, een salade met zalm en avocado en red velvet pancakes met fruit, met jus d'orange en een smoothie" class="object-[center_65%]" hero sizes="(min-width: 1024px) 480px, 100vw" />
            </div>
          </figure>
          <p class="sticker absolute -right-2 -top-4 z-20 grid h-28 w-28 place-items-center rounded-full bg-velvet p-3 text-center font-display text-base font-bold leading-tight text-white shadow-md sm:-right-4 sm:h-32 sm:w-32 sm:text-lg">Alles halal</p>
          <figure class="absolute -bottom-6 -left-3 z-20 w-36 rotate-[-4deg] rounded-xl bg-melk p-2 pb-1.5 shadow-xl sm:w-44 lg:-bottom-8 lg:-left-16">
            <div class="aspect-square overflow-hidden rounded-lg"><Foto src={pand} alt="De gevel van Lunchroom 1NUL1 aan de Hoogstraat met terrasje" sizes="180px" class="object-top" /></div>
            <figcaption class="px-1 pt-1.5 text-xs font-bold text-tekst">Hoogstraat 101</figcaption>
          </figure>
        </div>

        <div class="lg:col-span-7 lg:row-start-2">
          <dl class="grid max-w-2xl grid-cols-3 gap-4 border-t border-lijn-licht pt-6 lg:mt-10">
            <div>
              <dt class="text-sm text-melk/75">Google</dt>
              <dd class="mt-1 font-display text-2xl font-bold leading-none sm:text-3xl">{site.google.score}<span class="mt-1.5 block font-body text-sm font-normal text-melk/75">{site.google.aantal} reviews</span></dd>
            </div>
            <div>
              <dt class="text-sm text-melk/75">Open</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-2xl font-bold leading-none tabular-nums sm:text-3xl">08.30<span class="mt-1.5 block font-body text-sm font-normal text-melk/75">tot 17.00 uur</span></dd>
            </div>
            <div>
              <dt class="text-sm text-melk/75">Keuken</dt>
              <dd class="mt-1 font-display text-2xl font-bold leading-none text-matcha-licht sm:text-3xl">Halal<span class="mt-1.5 block font-body text-sm font-normal text-melk/75">alles</span></dd>
            </div>
          </dl>
          <div class="mt-6 max-w-md"><Status /></div>
        </div>
      </div>
    </section>

    <!-- GEVELBAND: de drie regels die op hun eigen ramen staan -->
    <div class="band overflow-hidden bg-velvet py-4 text-white" aria-label="Op onze ramen: Coffee & sweets, Sandwiches & bowls, Smoothies & pancakes" role="img">
      <div class="band-rol flex w-max gap-8 font-display text-xl font-bold tracking-tight sm:text-2xl" aria-hidden="true">
        {[0, 1, 2, 3].map(() => gevel.map((g) => (
          <span class="flex items-center gap-8 whitespace-nowrap">{g}<svg viewBox="0 0 20 20" class="h-4 w-4 text-velvet-licht" fill="currentColor"><path d="M10 0l2.4 7.6L20 10l-7.6 2.4L10 20l-2.4-7.6L0 10l7.6-2.4z"/></svg></span>
        )))}
      </div>
    </div>

    <!-- POPULAIR BIJ GASTEN -->
    <section id="populair" class="licht scroll-mt-16 bg-melk py-16 lg:py-24" aria-labelledby="popkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="eyebrow text-velvet">Uit de Google-reviews</p>
          <h2 id="popkop" class="mt-3 text-3xl">Populair bij gasten</h2>
          <p class="mt-5 text-tekst-zacht">Deze gerechten en drankjes noemen gasten het vaakst. Alles is halal.</p>
          <p class="mt-4 text-sm text-tekst-zacht">[[AANLEVEREN: volledige menukaart met prijzen]]</p>
          <a href="#bestellen" class="btn btn-velvet mt-8">Bestel of reserveer <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-8 lg:gap-5">
          <article class="kaart group relative overflow-hidden rounded-2xl bg-inkt text-melk shadow-sm sm:row-span-2">
            <div class="aspect-[4/5] sm:aspect-auto sm:h-full"><Foto src={redVelvet} alt="Red velvet pancakes met poedersuiker, frambozen, munt, vers fruit en een schaaltje room" class="transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" /></div>
            <div class="absolute inset-x-0 bottom-0 bg-inkt/85 p-5 backdrop-blur-sm sm:p-6">
              <p class="eyebrow text-velvet-licht">Pancakes</p>
              <h3 class="mt-2 text-2xl">Red velvet pancakes</h3>
              <p class="mt-1 text-melk/85">En pancakes met room en fruit.</p>
            </div>
          </article>
          <article class="kaart group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-lijn">
            <div class="aspect-[16/10] overflow-hidden"><Foto src={latteTosti} alt="Sfeerbeeld: een warm gegrilde sandwich naast een glas ijskoffie" class="transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" /></div>
            <div class="p-5 sm:p-6">
              <p class="eyebrow text-velvet">Broodjes</p>
              <ul class="mt-3 grid gap-1.5 font-display text-xl font-bold tracking-tight">
                <li>Sandwich kip &amp; truffel</li>
                <li>Chicken melt</li>
                <li>Broodje carpaccio</li>
              </ul>
            </div>
          </article>
          <article class="kaart group overflow-hidden rounded-2xl bg-inkt-2 text-melk shadow-sm">
            <div class="aspect-[16/10] overflow-hidden"><Foto src={matcha} alt="Sfeerbeeld: een kop matcha latte met een blad van melkschuim" class="transition-transform duration-500 group-hover:scale-[1.03]" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" /></div>
            <div class="p-5 sm:p-6">
              <p class="eyebrow text-matcha-licht">Drinken</p>
              <p class="mt-3 font-display text-xl font-bold tracking-tight">Matcha <span class="text-melk/60" aria-hidden="true">/</span> Latte</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- WOW: BESTELLEN OF RESERVEREN VIA WHATSAPP -->
    <section id="bestellen" class="scroll-mt-16 bg-inkt py-16 text-melk lg:py-24" aria-labelledby="bestelkop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-velvet-licht">Afhalen of aan tafel</p>
            <h2 id="bestelkop" class="mt-3 text-3xl">Bestel of reserveer via WhatsApp</h2>
          </div>
          <p class="text-melk/85 lg:col-span-5">Kies wat je wilt, afhalen of aan tafel, en een tijd. Je bericht staat meteen klaar in WhatsApp.</p>
        </div>
        <div class="mt-10"><Bestel /></div>
      </div>
    </section>

    <!-- WAT GASTEN NOEMEN -->
    <section class="licht bg-roze py-16 lg:py-24" aria-labelledby="reviewkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <figure class="overflow-hidden rounded-2xl shadow-sm">
            <div class="aspect-[4/3]"><Foto src={pancakes} alt="Sfeerbeeld: pancakes met aardbeien, banaan, chocoladesaus en poedersuiker" sizes="(min-width: 1024px) 460px, 100vw" /></div>
          </figure>
          <div class="-mt-12 ml-5 mr-5 relative rounded-xl bg-inkt p-6 text-melk shadow-md sm:ml-10 sm:mr-auto sm:w-72">
            <p class="eyebrow text-velvet-licht">Op Google</p>
            <p class="mt-2 font-display text-4xl font-bold leading-none">{site.google.score}</p>
            <p class="mt-2 text-sm text-melk/80">uit {site.google.aantal} reviews</p>
          </div>
        </div>
        <div class="lg:col-span-7 lg:pt-6">
          <p class="eyebrow text-velvet">Samengevat uit de reviews</p>
          <h2 id="reviewkop" class="mt-3 text-3xl">Wat gasten noemen</h2>
          <ol class="mt-8 grid gap-px overflow-hidden rounded-xl bg-lijn shadow-sm ring-1 ring-lijn sm:grid-cols-2">
            {[
              ['Broodjes', 'Het vaakst genoemd: kip & truffel, chicken melt en carpaccio.'],
              ['Pancakes', 'Red velvet, en pancakes met room en fruit.'],
              ['Matcha en latte', 'De drankjes die gasten het vaakst noemen.'],
              ['Alles halal', 'Dat noemen gasten vaak.'],
              ['Snel geserveerd', 'Je hoeft niet lang te wachten.'],
              ['Open op zondag', 'Ook in het weekend open, alleen op dinsdag dicht.'],
            ].map(([k, t], i) => (
              <li class="bg-melk p-5 sm:p-6">
                <span class="font-display text-sm font-bold tabular-nums text-velvet">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-1 text-xl">{k}</h3>
                <p class="mt-1 text-tekst-zacht">{t}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- CONTACT EN ROUTE -->
    <section id="contact" class="licht scroll-mt-16 bg-melk py-16 lg:py-24" aria-labelledby="contactkop">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-velvet">Tijden en route</p>
          <h2 id="contactkop" class="mt-3 text-3xl">Hoogstraat 101, Eindhoven</h2>
          <address class="mt-5 not-italic text-lg">
            <strong class="font-display text-xl font-bold">{site.naam}</strong><br />
            {site.straat}<br />{site.postcode} {site.plaats}
          </address>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={site.whatsapp} class="btn btn-velvet"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d={waPad}/></svg>WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-tekst hover:!bg-inkt hover:!text-melk hover:!shadow-none"><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            <a href={site.maps} class="btn btn-lijn text-tekst hover:!bg-inkt hover:!text-melk hover:!shadow-none">Route plannen</a>
          </div>

          <div class="mt-10 rounded-xl bg-white p-6 shadow-sm ring-1 ring-lijn sm:p-8">
            <h3 class="text-2xl">Openingstijden</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden per dag</caption>
              <tbody>
                {dagen.map((d) => (
                  <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                    <th scope="row" class="py-2.5 font-semibold">{d.dag}</th>
                    <td class={`whitespace-nowrap py-2.5 text-right tabular-nums ${d.open ? 'font-semibold' : 'text-tekst-zacht'}`}>{d.open ? '08.30 - 17.00' : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="lg:col-span-6">
          <figure class="relative overflow-hidden rounded-2xl shadow-sm">
            <div class="aspect-[6/7]"><Foto src={pand} alt="De zwarte gevel van Lunchroom 1NUL1 met witte letters, grote ramen en een terrasje met houten tafels" class="object-top" sizes="(min-width: 1024px) 560px, 100vw" /></div>
          </figure>
          <a href={site.instagram} class="insta mt-5 flex items-center justify-between gap-4 rounded-xl bg-inkt p-5 text-melk no-underline shadow-sm transition-colors hover:bg-inkt-3 sm:p-6">
            <span class="min-w-0">
              <span class="eyebrow block text-velvet-licht">Instagram</span>
              <span class="mt-1 block break-all font-display text-xl font-bold">{site.insta}</span>
            </span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-8 w-8 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .band-rol { animation: rol 38s linear infinite; }
  @keyframes rol { to { transform: translateX(-50%); } }
  .sticker { transform: rotate(10deg); }
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-velvet); }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  const wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', weekday: 'short' }).format(new Date()));
  document.querySelector(`.dagrij[data-wd="${wd}"]`)?.classList.add('vandaag');
</script>
