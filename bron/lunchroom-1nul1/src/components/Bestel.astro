---
// Wow-functie: bestellen (afhalen) of een tafel reserveren via WhatsApp.
// Kies populaire items (uit de reviews, zonder prijzen), dag en tijd binnen de openingstijden (dinsdag dicht),
// en er staat een net WhatsApp-bericht klaar voor 06 25 54 09 01. Zonder JS werkt het als gewoon formulier + WhatsApp-link.
import { site, populair } from '../data/site';
const tijden: string[] = [];
for (let m = 8 * 60 + 30; m <= 16 * 60 + 30; m += 15) tijden.push(`${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
const dagen = ['maandag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag', 'zondag'];
const veld = 'mt-1.5 block w-full rounded-lg border border-lijn bg-white px-3.5 py-3 text-tekst shadow-sm transition-colors focus:border-velvet';
const waPad = 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z';
---
<form id="bestel" class="licht grid overflow-hidden rounded-2xl bg-melk text-tekst shadow-xl lg:grid-cols-12" novalidate>
  <div class="p-5 sm:p-8 lg:col-span-7">
    <fieldset>
      <legend class="eyebrow text-velvet">1. Afhalen of aan tafel?</legend>
      <div class="mt-3 grid grid-cols-2 gap-2 rounded-full bg-room p-1.5">
        <label class="keuze"><input type="radio" name="soort" value="afhalen" checked class="sr-only" /><span>Afhalen</span></label>
        <label class="keuze"><input type="radio" name="soort" value="tafel" class="sr-only" /><span>Aan tafel</span></label>
      </div>
    </fieldset>

    <fieldset class="mt-8">
      <legend class="eyebrow text-velvet">2. Wat mag het zijn?</legend>
      <p class="mt-1 text-sm text-tekst-zacht">Populair bij gasten. Iets anders? Zet het bij de opmerking.</p>
      <div class="mt-4 grid gap-5">
        {populair.map((g) => (
          <div>
            <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-tekst-zacht">{g.groep}</p>
            <ul class="mt-2 grid gap-2 sm:grid-cols-2">
              {g.items.map((it) => (
                <li class="item flex items-center justify-between gap-3 rounded-xl bg-white py-2 pl-3.5 pr-2 shadow-sm ring-1 ring-lijn transition-shadow">
                  <label for={`n-${it.id}`} class="min-w-0 font-semibold leading-tight">{it.naam}</label>
                  <span class="teller flex shrink-0 items-center gap-1">
                    <input id={`n-${it.id}`} name={it.id} data-naam={it.naam} type="number" min="0" max="20" value="0" inputmode="numeric" class="w-14 rounded-lg border border-lijn bg-melk px-2 py-1.5 text-center font-bold tabular-nums" />
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </fieldset>

    <fieldset class="mt-8">
      <legend class="eyebrow text-velvet">3. Wanneer?</legend>
      <div class="mt-3 grid gap-4 sm:grid-cols-6">
        <label class="block text-sm font-semibold sm:col-span-3">Dag
          <select name="dag" class={veld}>{dagen.map((d) => <option>{d}</option>)}</select>
        </label>
        <label class="block text-sm font-semibold sm:col-span-3" data-tijdveld>Tijd
          <select name="tijd" class={`${veld} tabular-nums`}>{tijden.map((t) => <option value={t}>{t.replace(':', '.')}</option>)}</select>
        </label>
        <label class="block text-sm font-semibold sm:col-span-2" data-personen hidden>Personen
          <input type="number" name="personen" min="1" max="20" value="2" inputmode="numeric" class={`${veld} tabular-nums`} />
        </label>
      </div>
      <p class="mt-2 text-sm text-tekst-zacht">Open van <span class="whitespace-nowrap tabular-nums">08.30 tot 17.00</span> uur, dinsdag gesloten.</p>
    </fieldset>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <label class="block text-sm font-semibold">Je naam
        <input type="text" name="naam" autocomplete="given-name" class={veld} />
      </label>
      <label class="block text-sm font-semibold">Opmerking <span class="font-normal text-tekst-zacht">(mag leeg)</span>
        <input type="text" name="opmerking" class={veld} />
      </label>
    </div>
  </div>

  <div class="flex flex-col bg-inkt-2 p-5 text-melk sm:p-8 lg:col-span-5">
    <p class="eyebrow text-velvet-licht">4. Je bericht</p>
    <div class="mt-4 flex-1">
      <div class="rounded-2xl rounded-tl-sm bg-roze p-5 text-tekst shadow-md">
        <p class="whitespace-pre-line break-words leading-relaxed" aria-live="polite" data-bericht>Kies hiernaast je bestelling of reservering. Je bericht verschijnt dan hier.</p>
      </div>
      <p class="mt-3 min-h-[1.5rem] text-sm font-semibold text-velvet-licht" aria-live="polite" data-melding></p>
    </div>
    <a href={site.whatsapp} class="btn btn-velvet mt-6 w-full" data-verstuur>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d={waPad}/></svg>
      Verstuur via WhatsApp
    </a>
    <p class="mt-3 text-center text-sm text-melk/75">WhatsApp opent met dit bericht. Jij drukt zelf op verzenden.</p>
  </div>
</form>

<style>
  .keuze { position: relative; display: block; cursor: pointer; }
  .keuze span { display: block; border-radius: 999px; padding: .7rem 1rem; text-align: center; font-weight: 800; transition: background-color .2s ease, color .2s ease, box-shadow .2s ease; }
  .keuze input:checked + span { background: var(--color-inkt); color: var(--color-melk); box-shadow: var(--shadow-sm); }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-velvet); outline-offset: 2px; }
  .item.gekozen { box-shadow: inset 0 0 0 2px var(--color-velvet), var(--shadow-sm); }
  :global(.stap) { display: grid; place-items: center; height: 2.25rem; width: 2.25rem; border-radius: 999px; background: var(--color-room); font-weight: 800; font-size: 1.15rem; line-height: 1; transition: background-color .2s ease, color .2s ease; }
  :global(.stap:hover) { background: var(--color-inkt); color: var(--color-melk); }
  :global(.js-teller input) { width: 2rem; border: 0; background: transparent; padding: 0; -moz-appearance: textfield; appearance: textfield; }
  :global(.js-teller input::-webkit-inner-spin-button), :global(.js-teller input::-webkit-outer-spin-button) { -webkit-appearance: none; margin: 0; }
  [data-verstuur][aria-disabled='true'] { background: var(--color-inkt-3); color: #fffaf6d9; box-shadow: none; transform: none; cursor: not-allowed; }
</style>

<script>
  const NUMMER = '31625540901';
  const OPEN = [1, 3, 4, 5, 6, 0];
  const DAG = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];
  const MND = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
  const f = document.getElementById('bestel') as HTMLFormElement;
  const q = <T extends Element>(s: string) => f.querySelector(s) as T;
  const bericht = q<HTMLElement>('[data-bericht]');
  const melding = q<HTMLElement>('[data-melding]');
  const knop = q<HTMLAnchorElement>('[data-verstuur]');
  const dagSel = f.elements.namedItem('dag') as HTMLSelectElement;
  const tijdSel = f.elements.namedItem('tijd') as HTMLSelectElement;
  const persVeld = q<HTMLElement>('[data-personen]');
  const dagVeld = dagSel.parentElement!;
  const tijdVeld = q<HTMLElement>('[data-tijdveld]');
  const alleTijden = [...tijdSel.options].map((o) => o.value);
  const aantallen = [...f.querySelectorAll<HTMLInputElement>('.teller input')];

  // Nu in Eindhoven
  const p: Record<string, string> = {};
  new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Amsterdam', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
    .formatToParts(new Date()).forEach((x) => { p[x.type] = x.value; });
  const vandaag = new Date(Date.UTC(+p.year, +p.month - 1, +p.day));
  const nuMin = +p.hour * 60 + +p.minute;

  // Dagen: komende twee weken zonder dinsdag; vandaag alleen als er nog een tijd over is.
  dagSel.innerHTML = '';
  for (let i = 0; i < 15 && dagSel.options.length < 12; i++) {
    const d = new Date(vandaag); d.setUTCDate(d.getUTCDate() + i);
    const wd = d.getUTCDay();
    if (!OPEN.includes(wd)) continue;
    if (i === 0 && nuMin > 16 * 60 + 15) continue;
    const naam = `${DAG[wd]} ${d.getUTCDate()} ${MND[d.getUTCMonth()]}`;
    const label = i === 0 ? `Vandaag, ${naam}` : i === 1 ? `Morgen, ${naam}` : naam;
    dagSel.add(new Option(label, `${i}|${naam}`));
  }

  function vulTijden() {
    const i = Number(dagSel.value.split('|')[0]);
    const oud = tijdSel.value;
    tijdSel.innerHTML = '';
    for (const t of alleTijden) {
      const [h, m] = t.split(':').map(Number);
      if (i === 0 && h * 60 + m < nuMin + 15) continue;
      tijdSel.add(new Option(t.replace(':', '.'), t));
    }
    if ([...tijdSel.options].some((o) => o.value === oud)) tijdSel.value = oud;
  }

  // Plus- en minknoppen rond elk aantal
  for (const inp of aantallen) {
    const t = inp.parentElement!;
    t.classList.add('js-teller');
    const min = document.createElement('button');
    const plus = document.createElement('button');
    min.type = plus.type = 'button';
    min.className = plus.className = 'stap';
    min.textContent = '−'; plus.textContent = '+';
    min.setAttribute('aria-label', `${inp.dataset.naam}: een minder`);
    plus.setAttribute('aria-label', `${inp.dataset.naam}: een erbij`);
    t.prepend(min); t.append(plus);
    min.addEventListener('click', () => { inp.value = String(Math.max(0, (+inp.value || 0) - 1)); update(); });
    plus.addEventListener('click', () => { inp.value = String(Math.min(20, (+inp.value || 0) + 1)); update(); });
  }

  function update() {
    const tafel = (f.elements.namedItem('soort') as RadioNodeList).value === 'tafel';
    persVeld.hidden = !tafel;
    dagVeld.classList.toggle('sm:col-span-3', !tafel); dagVeld.classList.toggle('sm:col-span-2', tafel);
    tijdVeld.classList.toggle('sm:col-span-3', !tafel); tijdVeld.classList.toggle('sm:col-span-2', tafel);
    const gekozen = aantallen.filter((i) => (+i.value || 0) > 0);
    aantallen.forEach((i) => i.closest('.item')!.classList.toggle('gekozen', (+i.value || 0) > 0));
    const dag = dagSel.value.split('|')[1] || '';
    const tijd = tijdSel.value.replace(':', '.');
    const pers = Math.max(1, +(f.elements.namedItem('personen') as HTMLInputElement).value || 1);
    const naam = (f.elements.namedItem('naam') as HTMLInputElement).value.trim();
    const opm = (f.elements.namedItem('opmerking') as HTMLInputElement).value.trim();
    const lijst = gekozen.map((i) => `- ${i.value}x ${i.dataset.naam}`);

    const r: string[] = [];
    if (tafel) {
      r.push(`Hoi 1NUL1! Ik wil graag een tafel reserveren voor ${pers} ${pers === 1 ? 'persoon' : 'personen'}.`);
      r.push(`Wanneer: ${dag} om ${tijd} uur`);
      if (lijst.length) r.push('', 'Alvast doorgeven:', ...lijst);
    } else {
      r.push('Hoi 1NUL1! Ik wil graag bestellen om af te halen:', ...(lijst.length ? lijst : ['- ...']));
      r.push('', `Ophalen: ${dag} om ${tijd} uur`);
    }
    if (opm) r.push(`Opmerking: ${opm}`);
    if (naam) r.push('', `Groetjes, ${naam}`);
    const tekst = r.join('\n');

    let fout = '';
    if (!dag || !tijd) fout = 'Kies een dag en tijd.';
    else if (!tafel && !lijst.length && !opm) fout = 'Kies minstens één item om af te halen.';
    bericht.textContent = tekst;
    melding.textContent = fout;
    knop.setAttribute('aria-disabled', fout ? 'true' : 'false');
    knop.href = `https://wa.me/${NUMMER}?text=${encodeURIComponent(tekst)}`;
  }

  knop.addEventListener('click', (e) => { if (knop.getAttribute('aria-disabled') === 'true') e.preventDefault(); });
  dagSel.addEventListener('change', vulTijden);
  f.addEventListener('input', update);
  f.addEventListener('change', update);
  f.addEventListener('submit', (e) => e.preventDefault());
  vulTijden();
  update();
</script>
