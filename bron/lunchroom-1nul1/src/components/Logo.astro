---
// Woordmerk naar hun gevelletters: groot "1NUL1" met "LUNCHROOM" eronder, in Bricolage Grotesque.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex flex-col leading-none ${cls}`}>
  <span class="font-display text-[1.6rem] font-extrabold tracking-[-0.04em]">1NUL1</span>
  <span class="mt-0.5 text-[0.6rem] font-extrabold tracking-[0.34em]">LUNCHROOM</span>
</span>
