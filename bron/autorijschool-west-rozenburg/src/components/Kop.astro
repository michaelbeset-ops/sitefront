---
import { url, waProefles, site } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['opleidingen', 'Opleidingen'], ['prijzen', 'Prijzen'], ['planner', 'Rijbewijsplanner'], ['over', 'Over West'], ['contact', 'Contact']];
---
<div class="bg-nacht text-licht">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[.8125rem]">
    <ul class="flex items-center gap-6 overflow-hidden whitespace-nowrap">
      <li class="flex items-center gap-1.5"><Icoon naam="vink" class="h-3.5 w-3.5 text-geel" />Familiebedrijf sinds 1973</li>
      <li class="hidden items-center gap-1.5 sm:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-geel" />Proefles: je wordt thuis opgehaald</li>
      <li class="hidden items-center gap-1.5 lg:flex"><Icoon naam="vink" class="h-3.5 w-3.5 text-geel" />Betalen in termijnen in overleg</li>
    </ul>
    <a href={site.telHref} class="num hidden items-center gap-1.5 font-semibold no-underline hover:text-geel md:flex"><Icoon naam="tel" class="h-3.5 w-3.5" />{site.tel}</a>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-lijn bg-papier/95 backdrop-blur-md">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <a href={url("")} class="merk">
      <span class="dakbord"><b>WEST</b><i aria-hidden="true">L</i></span>
      <span class="merk-tekst hidden min-[380px]:flex"><span>Autorijschool</span><small>Rozenburg</small></span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-8 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="nav-link no-underline">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={site.telHref} class="num hidden font-semibold no-underline transition-colors hover:text-grijs xl:inline">{site.tel}</a>
      <a href={waProefles} class="knop knop-geel knop-klein hidden sm:inline-flex"><Icoon naam="wa" />Proefles plannen</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-md bg-wit shadow-sm lg:hidden" aria-expanded="false" aria-controls="menu" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu" aria-label="Menu" class="hidden border-t border-lijn bg-papier lg:hidden" data-menu>
    <ul class="wrap py-4">
      {nav.map(([id, t]) => <li><a href={h(id)} class="flex items-center justify-between border-b border-lijn py-3.5 font-kop text-xl font-extrabold no-underline">{t}<Icoon naam="pijl" class="h-5 w-5" /></a></li>)}
      <li class="pt-5"><a href={waProefles} class="knop knop-geel w-full"><Icoon naam="wa" />Proefles via WhatsApp</a></li>
    </ul>
  </nav>
</header>

<!-- Mobiele onderbalk -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2.5 border-t border-lijn bg-papier/95 p-2.5 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="knop knop-inkt knop-klein"><Icoon naam="tel" />Bellen</a>
  <a href={waProefles} class="knop knop-geel knop-klein"><Icoon naam="wa" />WhatsApp</a>
</div>

<style>
  .nav-link { background: linear-gradient(var(--color-geel), var(--color-geel)) no-repeat 0 100% / 0 3px; padding-bottom: .2rem; transition: background-size .3s var(--ease-zacht); }
  .nav-link:hover { background-size: 100% 3px; }
</style>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
