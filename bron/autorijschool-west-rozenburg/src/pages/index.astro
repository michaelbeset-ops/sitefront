<script>
  // Rijbewijsplanner: mijlpalen uit de CBR-pagina van West (16, 16,5, 17 en 18 jaar).
  const geb = document.querySelector<HTMLInputElement>('[data-geb]');
  const advies = document.querySelector<HTMLElement>('[data-advies]');
  const fmt = new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
  const plus = (d: Date, maanden: number) => { const x = new Date(d); x.setMonth(x.getMonth() + maanden); return x; };
  const stappen = [192, 198, 204, 216];
  let regel = '';
  const reken = () => {
    regel = '';
    const els = document.querySelectorAll<HTMLElement>('[data-mijlpaal]');
    const labels = ['16', '16,5', '17', '18'];
    if (!geb?.value) { els.forEach((el, i) => (el.textContent = `Vanaf ${labels[i]} jaar`)); if (advies) advies.textContent = ''; return; }
    const d = new Date(geb.value + 'T12:00:00');
    const nu = new Date();
    const data = stappen.map((m) => plus(d, m));
    els.forEach((el, i) => {
      const kan = data[i] <= nu;
      el.textContent = kan ? 'Dat kan nu al' : `Vanaf ${fmt.format(data[i])}`;
      el.closest('li')?.toggleAttribute('data-klaar', kan);
    });
    if (!advies) return;
    if (data[1] <= nu) { advies.textContent = 'Je kunt meteen beginnen met rijlessen.'; regel = 'Ik mag al rijlessen nemen.'; }
    else { advies.textContent = `Rijlessen kunnen vanaf ${fmt.format(data[1])}. De theorie kun je eerder doen.`; regel = `Ik mag rijlessen nemen vanaf ${fmt.format(data[1])}.`; }
  };
  geb?.addEventListener('change', reken);
  geb?.addEventListener('input', reken);

  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(f);
    const v = (n: string) => String(fd.get(n) || '').trim();
    const k = v('keuze') || 'Proefles';
    const r = [k === 'Proefles' ? 'Hoi Autorijschool West, ik wil graag een proefles plannen.' : `Hoi Autorijschool West, ik heb interesse in: ${k}.`];
    if (regel) r.push(regel);
    if (v('naam')) r.push('Groet, ' + v('naam'));
    window.open('https://wa.me/31646615096?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
  });
</script>

