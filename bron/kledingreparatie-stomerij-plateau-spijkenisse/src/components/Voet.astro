---
import { site, url } from '../data/site';
import Hanger from './Hanger.astro';
---
<footer class="donker bg-petrol-2 text-licht">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="flex items-center gap-3 font-kop text-xl font-black leading-tight tracking-tight"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-geel text-inkt"><Hanger class="h-5 w-5" /></span> {site.naam}</p>
      <p class="mt-4 max-w-sm text-sm text-licht-zacht">Kledingreparatie, wassen en reinigen, dekens en dekbedden en gordijnen op maat. In {site.winkelcentrum}, Spijkenisse.</p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="font-kop font-extrabold">Adres</p>
      <p class="mt-2 text-licht-zacht">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-2"><a href={site.maps} class="lijn-link">Route plannen</a></p>
    </div>
    <div class="text-sm md:col-span-4">
      <p class="font-kop font-extrabold">Contact</p>
      <p class="mt-2 text-licht-zacht">Telefoon en WhatsApp <a href={site.telHref} class="num text-licht underline underline-offset-2">{site.tel}</a></p>
      <p class="mt-1"><a href={site.facebook} class="lijn-link">Facebook</a></p>
      <p class="mt-1 text-licht-zacht">KvK {site.kvk}</p>
    </div>
  </div>
  <div class="regel">
    <div class="wrap flex flex-col gap-2 py-6 text-xs text-licht-zacht md:flex-row md:justify-between">
      <p>Foto's zijn sfeerbeelden van Unsplash.</p>
      <p><a href={url('privacy/')} class="underline underline-offset-2 hover:text-licht">Privacyverklaring</a></p>
    </div>
  </div>
</footer>
