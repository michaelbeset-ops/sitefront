---
import { site, url } from '../data/site';
import Hanger from './Hanger.astro';
interface Props { licht?: boolean }
const { licht = false } = Astro.props;
const home = url('');
const links = [
  { href: `${home}#diensten`, tekst: 'Diensten' },
  { href: `${home}#gordijnen`, tekst: 'Gordijnen' },
  { href: `${home}#langskomen`, tekst: 'Langskomen' },
];
---
<header class:list={['z-30 w-full text-licht donker', licht ? 'relative bg-petrol' : 'absolute inset-x-0']}>
  <div class="wrap flex items-center justify-between gap-6 py-5">
    <a href={home} class="flex items-center gap-3 no-underline">
      <span aria-hidden="true" class="grid h-11 w-11 place-items-center rounded-full bg-geel text-inkt"><Hanger class="h-6 w-6" /></span>
      <span class="leading-none">
        <span class="block font-kop text-2xl font-black tracking-tight">Plateau</span>
        <span class="mt-1 block text-[.6875rem] font-bold uppercase tracking-[.16em] text-licht-zacht">Kledingreparatie &amp; stomerij</span>
      </span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex items-center gap-8 font-kop text-base font-bold">
        {links.map((l) => <li><a href={l.href} class="no-underline decoration-geel decoration-2 underline-offset-8 hover:underline">{l.tekst}</a></li>)}
      </ul>
    </nav>
    <a href={site.telHref} class="knop knop-rand hidden min-h-11 px-4 py-2 text-[.9375rem] md:inline-flex">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
      <span class="num">{site.tel}</span>
    </a>
  </div>
</header>
