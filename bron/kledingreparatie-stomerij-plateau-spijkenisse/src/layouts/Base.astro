---
import '../styles/global.css';
import kopFont from '@fontsource-variable/gabarito/files/gabarito-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/epilogue/files/epilogue-latin-wght-normal.woff2?url';
import { site, url, fotos } from '../data/site';

interface Props { title: string; description: string; hero?: boolean }
const { title, description, hero = false } = Astro.props;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.voorstel && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#123d40" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={kopFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansFont} crossorigin />
    {hero && <link rel="preconnect" href="https://images.unsplash.com" />}
    {hero && <link rel="preload" as="image" href={fotos.hero(1600)} imagesrcset={`${fotos.hero(800)} 800w, ${fotos.hero(1200)} 1200w, ${fotos.hero(1600)} 1600w`} imagesizes="100vw" fetchpriority="high" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh pb-[4.25rem] md:pb-0">
    {site.voorstel && (
      <div class="bg-geel text-inkt">
        <p class="wrap py-2 text-xs leading-snug">Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website. <a href="https://www.sitefront.nl" class="font-bold underline underline-offset-2">sitefront.nl</a></p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-wit focus:px-4 focus:py-2">Naar de inhoud</a>
    <slot />

    <!-- Op mobiel altijd binnen handbereik, want bellen of appen is wat bezoekers hier willen. -->
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px bg-petrol-2 md:hidden donker">
      <a href={site.telHref} class="flex min-h-[4.25rem] items-center justify-center gap-2 bg-petrol font-kop text-base font-extrabold text-licht no-underline">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
        Bellen
      </a>
      <a href={site.wa} class="flex min-h-[4.25rem] items-center justify-center gap-2 bg-geel font-kop text-base font-extrabold text-inkt no-underline">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z"/></svg>
        WhatsApp
      </a>
    </div>

    <script is:inline>
      // Een keer tonen als het blok in beeld komt, daarna niet meer.
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-op]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
