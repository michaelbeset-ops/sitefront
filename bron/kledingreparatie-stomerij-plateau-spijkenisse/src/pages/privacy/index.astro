---
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import { site, url } from '../../data/site';
---
<Base title="Privacyverklaring, Kledingreparatie & Stomerij Plateau" description="Hoe Kledingreparatie & Stomerij Plateau in Spijkenisse omgaat met uw gegevens.">
  <Kop licht />
  <main id="inhoud" class="py-16 md:py-24">
    <article class="wrap max-w-3xl">
      <p class="label">Privacy</p>
      <h1 class="mt-5 text-[length:var(--text-3xl)]">Privacyverklaring</h1>
      <div class="mt-10 space-y-8 text-grijs [&_h2]:text-xl [&_h2]:text-inkt [&_p]:mt-3">
        <section>
          <h2>Wie zijn wij</h2>
          <p>{site.naam}, {site.straat}, {site.postcode} {site.plaats}, KvK {site.kvk}. U bereikt ons op <a class="underline" href={site.telHref}>{site.tel}</a>, ook via WhatsApp.</p>
        </section>
        <section>
          <h2>Welke gegevens we gebruiken</h2>
          <p>Belt of appt u ons, of brengt u iets langs, dan gebruiken we uw naam, telefoonnummer en wat u ons vertelt. Alleen om uw vraag te beantwoorden en uw spullen weer aan u mee te geven.</p>
        </section>
        <section>
          <h2>Het contactformulier</h2>
          <p>Het formulier op deze site verstuurt nog niets. Uw gegevens worden dus niet opgeslagen of doorgestuurd.</p>
        </section>
        <section>
          <h2>Cookies</h2>
          <p>Deze website plaatst geen cookies en gebruikt geen statistieken of advertenties. Daarom ziet u ook geen cookiemelding. De foto's worden geladen vanaf een externe server (Unsplash), die daarbij uw IP-adres ziet.</p>
        </section>
        <section>
          <h2>Bewaren en uw rechten</h2>
          <p>We bewaren uw gegevens niet langer dan nodig. U mag altijd vragen welke gegevens we van u hebben, en vragen om ze aan te passen of te verwijderen. Bel of app daarvoor naar <a class="underline" href={site.telHref}>{site.tel}</a>. Bent u het niet eens met hoe we met uw gegevens omgaan, dan kunt u een klacht indienen bij de Autoriteit Persoonsgegevens.</p>
        </section>
      </div>
      <p class="mt-12"><a href={url('')} class="font-kop font-extrabold underline underline-offset-4">Terug naar de startpagina</a></p>
    </article>
  </main>
  <Voet />
</Base>
