---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, icoon } from '../data/site';
import strandZon from '../assets/strand-zon.jpg';
import huis from '../assets/huis.jpg';
import kamerKaart from '../assets/kamer-kaart.jpg';
import kamerZwart from '../assets/kamer-zwart.jpg';
import kamerBehang from '../assets/kamer-behang.jpg';
import kamerLamp from '../assets/kamer-lamp.jpg';
import badkamerBreed from '../assets/badkamer-breed.jpg';
import badkamerWastafel from '../assets/badkamer-wastafel.jpg';
import badkamerHanddoek from '../assets/badkamer-handdoek.jpg';
import badkamerSpiegel from '../assets/badkamer-spiegel.jpg';
import koffieThee from '../assets/koffie-thee.jpg';
import ontbijt from '../assets/ontbijt.jpg';
import strandBoven from '../assets/strand-boven.jpg';
import duinpad from '../assets/duinpad.jpg';
import paalhoofden from '../assets/paalhoofden.jpg';
import woning1 from '../assets/woning-1.jpg';
import woning2 from '../assets/woning-2.jpg';
import woning3 from '../assets/woning-3.jpg';

// Letterlijk uit /kamers en /vakantiewoningen.
const inKamer = [
  { kop: 'Eigen badkamer', tekst: 'Met wastafel, douche en toilet' },
  { kop: 'Luxe boxsprings', tekst: '' },
  { kop: 'Televisie', tekst: '' },
  { kop: 'Koffie en thee', tekst: 'Koffie- en theefaciliteiten op de kamer' },
  { kop: 'Gratis wifi', tekst: '' },
];
const inWoning = ['Televisie', 'Radio', 'Gratis wifi', 'Koffiezetapparaat', 'Magnetron', 'Haarföhn', 'Complete keuken', 'Wasmachine, gratis te gebruiken', 'Opbergschuur voor fietsen'];
const strandFotos = [
  { src: strandBoven, alt: 'Het strand vanaf de duinen gezien, met strandhuisjes en blauwe zee', tekst: 'Vanaf de duinen', r: '-rotate-2' },
  { src: duinpad, alt: 'Een zandpad door het helmgras langs het strand', tekst: 'Het duinpad', r: 'rotate-1' },
  { src: paalhoofden, alt: 'Houten paalhoofden in zee bij zonsondergang', tekst: 'Paalhoofden bij avondzon', r: '-rotate-1' },
];
---
<Base
  title="Bed & Breakfast Slapen & Zo Zoutelande | Kamers en vakantiewoningen op loopafstand van strand en centrum"
  description="Drie kamers met eigen badkamer, altijd inclusief ontbijt, op 150 m van strand en centrum van Zoutelande. Plus vier losstaande, volledig ingerichte vakantiewoningen op 50 m van zee."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: diepzee-vlak met hun eigen zonsondergangfoto, het eigen huis als overlappende kaart, bewijzenbalk over de rand. -->
    <section class="donker relative bg-zee text-white">
      <div class="relative aspect-[3/2] overflow-hidden lg:absolute lg:inset-y-0 lg:right-0 lg:aspect-auto lg:w-[56%] lg:max-w-[960px]">
        <Foto src={strandZon} alt="Zonsondergang aan zee: zonnestralen door de wolken boven het strand, met houten palen op de voorgrond en wandelaars op de boulevard" hero widths={[480, 960]} sizes="(min-width: 1024px) 56vw, 100vw" class="object-[40%_50%]" />
        <div class="absolute inset-0 hidden bg-[linear-gradient(90deg,var(--color-zee)_0%,#0e2f3acc_10%,#0e2f3a00_42%)] lg:block"></div>
        <p class="absolute top-4 right-4 rounded-full bg-zee/90 px-3 py-1 text-xs font-bold text-white">Avondzon aan het strand</p>
      </div>
      <div class="wrap relative grid pt-9 pb-28 sm:pt-12 lg:min-h-[700px] lg:grid-cols-12 lg:items-center lg:pt-14 lg:pb-40">
        <div class="lg:col-span-6">
          <p class="kicker text-zon">Bed &amp; Breakfast en vakantiewoningen in {site.plaats}</p>
          <h1 class="mt-5 text-4xl">Slapen op <span class="schuin text-zon">150&nbsp;meter</span> van het strand</h1>
          <p class="mt-6 max-w-xl text-lg text-white/85">Ons huis is gelegen op loopafstand van het strand en centrum. Wij verhuren drie kamers met een eigen badkamer, altijd inclusief ontbijt. Of kies een van onze vier losstaande vakantiewoningen, op 50 meter van zee.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#keuzehulp" class="btn btn-zon">Kamer of vakantiewoning?{' '}<Fragment set:html={icoon.pijl} /></a>
            <a href={site.telHref} class="btn btn-line"><Fragment set:html={icoon.tel} /><span>Bel <span class="num">{site.tel}</span></span></a>
          </div>
        </div>
      </div>
      <figure class="absolute right-6 bottom-[14rem] hidden w-[250px] rotate-2 rounded-xl bg-zand p-2 text-ink shadow-lg xl:block 2xl:right-[calc((100vw-76rem)/2)]">
        <div class="aspect-[3/2] overflow-hidden rounded-lg"><Foto src={huis} alt="Ons huis aan de Majoorwerf: een bakstenen huis met rode dakpannen en witte kozijnen" widths={[480]} sizes="234px" /></div>
        <figcaption class="px-1 pt-2 pb-0.5 text-xs font-bold">Ons huis aan de Majoorwerf</figcaption>
      </figure>
      <div class="relative bg-[linear-gradient(to_bottom,var(--color-zee)_50%,var(--color-zand)_50%)]">
        <div class="wrap">
          <dl class="-mt-20 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-line text-ink shadow-lg lg:grid-cols-4">
            <div class="bg-zand p-5 sm:p-6"><dt class="kicker text-ink-soft">Google</dt><dd class="mt-1"><span class="num font-display text-[clamp(2.4rem,2vw+1.4rem,3rem)] leading-none font-medium">{site.google}</span> <span class="block text-sm text-ink-soft">uit {site.reviews} reviews</span></dd></div>
            <div class="bg-zand p-5 sm:p-6"><dt class="kicker text-ink-soft">Naar zee</dt><dd class="mt-1"><span class="num font-display text-[clamp(2.4rem,2vw+1.4rem,3rem)] leading-none font-medium">150 m</span> <span class="block text-sm text-ink-soft">strand en centrum</span></dd></div>
            <div class="bg-zand p-5 sm:p-6"><dt class="kicker text-ink-soft">B&amp;B</dt><dd class="mt-1"><span class="num font-display text-[clamp(2.4rem,2vw+1.4rem,3rem)] leading-none font-medium">3</span> <span class="block text-sm text-ink-soft">kamers met eigen badkamer</span></dd></div>
            <div class="bg-zon p-5 text-zee sm:p-6"><dt class="kicker">Altijd</dt><dd class="mt-1"><span class="font-display text-[clamp(1.6rem,1.2vw+1.1rem,2.1rem)] leading-none font-medium">inclusief ontbijt</span> <span class="block text-sm">en zelf een lunchpakket maken</span></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 150 m naar zee: meetlinten op schaal, met de eigen strandfoto's als polaroids. -->
    <section id="ligging" class="scroll-mt-20 overflow-hidden py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-groen">De ligging</p>
          <h2 class="mt-3 text-3xl">Zo dicht bij zee</h2>
          <p class="mt-6 text-lg">Ons huis is gelegen op loopafstand (150&nbsp;m) van het strand en centrum. Onze vakantiewoningen liggen nog dichterbij: op 50&nbsp;m.</p>
          <ul class="mt-10 flex gap-3 sm:gap-5" aria-label="Foto's van het strand, van onze eigen website">
            {strandFotos.map((f) => (
              <li class={`w-1/3 max-w-[160px] ${f.r}`}>
                <figure class="rounded-lg bg-white p-1.5 shadow-sm">
                  <div class="aspect-square overflow-hidden rounded-md"><Foto src={f.src} alt={f.alt} widths={[320]} sizes="160px" /></div>
                  <figcaption class="px-0.5 pt-1.5 text-xs leading-tight font-semibold text-ink-soft">{f.tekst}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:col-span-7 lg:pt-4">
          <p class="font-display text-reus leading-[0.8] font-medium tracking-[-0.04em] text-groen" aria-hidden="true">150<span class="schuin text-koraal">m</span></p>
          <div class="mt-10 space-y-9">
            <div>
              <div class="flex items-baseline justify-between gap-4"><h3 class="text-2xl">Vanaf de B&amp;B</h3><p class="num font-display text-2xl text-koraal">150 m</p></div>
              <div class="relative mt-4 h-12" aria-hidden="true">
                <div class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 bg-[repeating-linear-gradient(90deg,var(--color-ink)_0_10px,transparent_10px_18px)]"></div>
                <div class="absolute inset-x-0 top-1/2 flex -translate-y-1/2 justify-between">{Array.from({ length: 16 }).map((_, i) => <span class={`w-px bg-ink ${i % 5 === 0 ? 'h-5' : 'h-2.5'}`}></span>)}</div>
                <span class="absolute top-1/2 left-0 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-zee text-white shadow-sm"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M12 3 2 11h3v9h5v-6h4v6h5v-9h3z"/></svg></span>
                <span class="absolute top-1/2 right-0 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-zon text-zee shadow-sm"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 15c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2M2 20c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/></svg></span>
              </div>
              <div class="mt-2 flex justify-between gap-4 text-sm text-ink-soft"><span>Ons huis, {site.straat}</span><span class="text-right">Strand en centrum</span></div>
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-4"><h3 class="text-2xl">Vanaf de vakantiewoningen</h3><p class="num font-display text-2xl text-koraal">50 m</p></div>
              <div class="relative mt-4 h-12 w-1/3 min-w-[9rem]" aria-hidden="true">
                <div class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 bg-[repeating-linear-gradient(90deg,var(--color-ink)_0_10px,transparent_10px_18px)]"></div>
                <span class="absolute top-1/2 left-0 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-groen text-white shadow-sm"><svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M12 3 2 11h3v9h5v-6h4v6h5v-9h3z"/></svg></span>
                <span class="absolute top-1/2 right-0 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-zon text-zee shadow-sm"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 15c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2M2 20c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/></svg></span>
              </div>
              <p class="mt-2 text-sm text-ink-soft">Op schaal: een derde van de afstand.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Kamers: eigen huis groot, dan de brede kamerfoto met uitrustingskaart, fotomozaïek, huisregels. -->
    <section id="kamers" class="scroll-mt-16 bg-duin py-16 lg:py-24">
      <div class="wrap">
        <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="relative lg:col-span-6">
            <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm"><Foto src={huis} alt="Ons huis aan de Majoorwerf: een bakstenen huis met rode dakpannen, witte kozijnen en een erker" widths={[480, 960]} sizes="(min-width: 1024px) 580px, 100vw" /></div>
            <p class="absolute -bottom-4 left-4 rounded-full bg-zee px-4 py-2 text-sm font-bold text-white shadow-sm">{site.straat}, {site.plaats}</p>
          </div>
          <div class="lg:col-span-6">
            <p class="kicker text-groen">Bed &amp; Breakfast</p>
            <h2 class="mt-3 text-3xl">Kamers met eigen badkamer</h2>
            <p class="mt-6 text-lg">De kamers bevinden zich op de eerste verdieping van ons huis. Wij verhuren drie kamers met een eigen badkamer, inclusief wastafel, douche en toilet.</p>
            <p class="mt-4 text-ink-soft">De kamers zijn voorzien van luxe boxsprings, televisie en koffie- en theefaciliteiten. U kunt gebruik maken van gratis wifi.</p>
          </div>
        </div>

        <div class="relative mt-16 lg:mt-24">
          <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm sm:aspect-[16/7] lg:aspect-[16/5]"><Foto src={kamerKaart} alt="Een van de kamers: tweepersoons boxspring met gebreid dekbedovertrek en badjassen, zwarte wandlampjes, een rotan stoel en een wand met een landkaart" widths={[800, 1200, 1920]} sizes="(min-width: 1216px) 1152px, 100vw" class="object-[35%_50%]" /></div>
          <div class="relative -mt-16 mx-3 rounded-xl bg-zand p-6 shadow-lg sm:mx-6 sm:p-8 lg:absolute lg:right-8 lg:-bottom-12 lg:m-0 lg:w-[400px]">
            <p class="kicker text-koraal">In elke kamer</p>
            <ul class="mt-4 border-t border-line">
              {inKamer.map((k) => <li class="border-b border-line py-2.5"><span class="font-display text-xl font-medium">{k.kop}</span>{k.tekst && <span class="block text-sm text-ink-soft">{k.tekst}</span>}</li>)}
            </ul>
          </div>
        </div>

        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:mt-24 lg:grid-cols-12">
          <figure class="sm:col-span-2 lg:col-span-7 lg:row-span-2">
            <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm lg:aspect-auto lg:h-full"><Foto src={kamerBehang} alt="Een kamer met een boxspring voor een wand met groen bladerbehang, een rotan stoel bij het raam" widths={[480, 960]} sizes="(min-width: 1024px) 660px, 100vw" /></div>
          </figure>
          <figure class="lg:col-span-5">
            <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm"><Foto src={kamerLamp} alt="Een kamer met zwarte kast, televisie aan de wand en een zwarte hanglamp boven het bed" widths={[480, 960]} sizes="(min-width: 1024px) 470px, (min-width: 640px) 50vw, 100vw" /></div>
          </figure>
          <figure class="lg:col-span-5">
            <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-sm"><Foto src={kamerZwart} alt="Een kamer met zwart tapijt, een zwarte wandtafel met waterkoker en een rotan stoel" widths={[480, 960, 1440]} sizes="(min-width: 1024px) 470px, (min-width: 640px) 50vw, 100vw" class="object-[70%_50%]" /></div>
          </figure>
        </div>

        <!-- Badkamers -->
        <div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-4">
            <p class="kicker text-groen">Uw eigen badkamer</p>
            <h3 class="mt-3 text-[clamp(2rem,2.2vw+1rem,2.75rem)] font-medium">Wastafel, douche en toilet</h3>
            <p class="mt-4 text-ink-soft">Elke kamer heeft een eigen badkamer, inclusief wastafel, douche en toilet.</p>
          </div>
          <div class="grid grid-cols-3 gap-3 sm:gap-4 lg:col-span-8">
            <div class="aspect-square overflow-hidden rounded-xl shadow-sm"><Foto src={badkamerWastafel} alt="Een witte wastafel met kraan en handdoeken tegen crèmekleurige tegels" widths={[320, 640]} sizes="(min-width: 1024px) 250px, 33vw" /></div>
            <div class="aspect-square overflow-hidden rounded-xl shadow-sm"><Foto src={badkamerHanddoek} alt="Witte handdoeken aan een zwart handdoekrek" widths={[320, 640]} sizes="(min-width: 1024px) 250px, 33vw" /></div>
            <div class="aspect-square overflow-hidden rounded-xl shadow-sm"><Foto src={badkamerSpiegel} alt="Een wastafel onder een zwarte spiegel, met een wit kroonluchtertje" widths={[320]} sizes="(min-width: 1024px) 250px, 33vw" /></div>
            <div class="col-span-3 aspect-[16/5] overflow-hidden rounded-xl shadow-sm"><Foto src={badkamerBreed} alt="Een badkamer met schuine wand: een wastafel onder een zwarte spiegel en een glazen douchewand" widths={[800, 1200, 1920]} sizes="(min-width: 1024px) 770px, 100vw" /></div>
          </div>
        </div>

        <!-- Huisregels -->
        <div class="mt-16 grid gap-3 sm:grid-cols-3 lg:mt-20">
          {[
            { kop: 'Niet roken', tekst: 'Op de kamers mag niet gerookt worden.' },
            { kop: 'Geen huisdieren', tekst: 'Huisdieren zijn niet toegestaan.' },
            { kop: 'Geen jonge kinderen', tekst: 'Ons huis is niet geschikt voor jonge kinderen.' },
          ].map((r) => (
            <div class="flex gap-4 rounded-xl bg-zand p-5 shadow-sm">
              <span class="mt-1 grid h-8 w-8 flex-none place-items-center rounded-full border-2 border-koraal text-koraal" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 18 18 6"/></svg></span>
              <div><h3 class="text-xl font-semibold">{r.kop}</h3><p class="mt-1 text-sm text-ink-soft">{r.tekst}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Ontbijt: donker vlak, eigen ontbijtfoto groot met koffie/thee-inzet. -->
    <section id="ontbijt" class="donker scroll-mt-16 bg-zee py-16 text-white lg:py-24">
      <div class="wrap grid items-center gap-14 lg:grid-cols-12">
        <div class="relative lg:col-span-7">
          <div class="aspect-[3/2] overflow-hidden rounded-xl shadow-lg"><Foto src={ontbijt} alt="Ontbijt bij Slapen & Zo: broodjes in een mandje, jus d'orange, gekookte eitjes, kaas, vleeswaren, tomaat en komkommer op rood-wit servies" widths={[480, 960]} sizes="(min-width: 1216px) 660px, (min-width: 1024px) 56vw, 100vw" /></div>
          <figure class="absolute -bottom-8 right-4 w-[150px] -rotate-2 rounded-xl bg-zand p-1.5 text-ink shadow-lg sm:right-6 sm:w-[190px]">
            <div class="aspect-square overflow-hidden rounded-lg"><Foto src={koffieThee} alt="Waterkoker, twee kopjes en een bakje met thee en suiker op de kamer" widths={[360]} sizes="180px" /></div>
            <figcaption class="px-1 pt-1.5 pb-0.5 text-xs font-bold">Koffie en thee op de kamer</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-5">
          <p class="kicker text-zon">Altijd inbegrepen</p>
          <h2 class="mt-3 text-3xl">Inclusief ontbijt, en <span class="schuin text-zon">zelf</span> een lunchpakket</h2>
          <p class="mt-6 text-lg text-white/85">Wij verhuren altijd inclusief ontbijt en u heeft zelf de keuze om een lunchpakket te maken.</p>
          <ul class="mt-8 border-t border-white/15">
            {['Altijd inclusief ontbijt', 'Zelf een lunchpakket maken', 'Koffie- en theefaciliteiten op de kamer'].map((o, i) => (
              <li class="flex items-baseline gap-4 border-b border-white/15 py-3"><span class="num font-display text-lg text-zon" aria-hidden="true">0{i + 1}</span><span class="font-display text-xl font-medium">{o}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Vakantiewoningen: de vier namen groot, drie eigen foto's getrapt, uitrusting als lijst. -->
    <section id="vakantiewoningen" class="scroll-mt-16 py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-groen">Vakantiewoningen, op 50 m van zee</p>
            <h2 class="mt-3 text-3xl">Vier losstaande vakantiewoningen</h2>
          </div>
          <p class="text-lg text-ink-soft lg:col-span-5">Deze woningen liggen op loopafstand (50&nbsp;m) van het strand en centrum, voor 2, 4 en 6 personen.</p>
        </div>

        <ul class="mt-10 flex flex-wrap items-baseline gap-x-6 gap-y-1 border-y border-line py-5 sm:gap-x-10" aria-label="De namen van de vier vakantiewoningen">
          {site.woningen.map((w, i) => (
            <li class="font-display text-[clamp(2.2rem,4vw+1rem,4rem)] leading-none font-medium">{i % 2 ? <span class="schuin text-koraal">{w}</span> : w}</li>
          ))}
        </ul>

        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          <figure class="sm:mt-0"><div class="aspect-[3/2] overflow-hidden sm:aspect-[4/5] rounded-xl shadow-sm"><Foto src={woning1} alt="Vakantiewoning Ankertje: een laag bakstenen huisje met naambordje met witte kozijnen, openslaande deuren en een grasveld" widths={[480, 960]} sizes="(min-width: 1216px) 375px, (min-width: 640px) 33vw, 100vw" /></div><figcaption class="mt-2 font-display text-xl">Ankertje</figcaption></figure>
          <figure class="sm:mt-12"><div class="aspect-[3/2] overflow-hidden sm:aspect-[4/5] rounded-xl shadow-sm"><Foto src={woning2} alt="Vakantiewoning Aster: een bakstenen huisje met rode pannen, een groene deur en een terrasje met tafel en stoelen" widths={[480, 960]} sizes="(min-width: 1216px) 375px, (min-width: 640px) 33vw, 100vw" /></div><figcaption class="mt-2 font-display text-xl">Aster</figcaption></figure>
          <figure class="sm:mt-24"><div class="aspect-[3/2] overflow-hidden sm:aspect-[4/5] rounded-xl shadow-sm"><Foto src={woning3} alt="Een van onze vakantiewoningen: een vrijstaand bakstenen huis met twee verdiepingen en een gazon ervoor" widths={[480, 960]} sizes="(min-width: 1216px) 375px, (min-width: 640px) 33vw, 100vw" /></div><figcaption class="mt-2 font-display text-xl">Een van onze woningen</figcaption></figure>
        </div>
        <p class="mt-3 text-sm text-ink-soft">Drie van onze vier vakantiewoningen. <span class="text-xs">[[AANLEVEREN: foto's van Barbara en Lelie, en per woning het aantal personen]]</span></p>

        <div class="mt-14 grid gap-8 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <h3 class="text-[clamp(2rem,2.2vw+1rem,2.75rem)] font-medium">Volledig ingericht</h3>
            <p class="mt-4 text-ink-soft">Naast een complete keuken bevatten de woningen ook een (gratis te gebruiken) wasmachine en een opbergschuur voor fietsen.</p>
          </div>
          <ul class="grid gap-x-8 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-3">
            {inWoning.map((w) => <li class="flex gap-3 border-b border-line py-3"><span class="mt-[0.6rem] h-1.5 w-1.5 flex-none rounded-full bg-koraal" aria-hidden="true"></span>{w}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- WOW: keuzehulp "Kamer of vakantiewoning?" + boekingsaanvraag. Zonder JS: de vergelijking en contactgegevens. -->
    <section id="keuzehulp" class="donker scroll-mt-16 bg-zee py-16 text-white lg:py-24" data-hulp data-voorstel={site.voorstel ? '1' : '0'}>
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="kicker text-zon">Keuzehulp</p>
            <h2 class="mt-3 text-3xl">Kamer of vakantie&shy;woning?</h2>
          </div>
          <p class="text-white/85 lg:col-span-5">Beantwoord drie korte vragen en zie wat bij u past. Daarna stelt u direct uw aanvraag samen.</p>
        </div>

        <div class="mt-10 grid gap-8 lg:grid-cols-12">
          <form class="min-w-0 space-y-7 lg:col-span-7" data-vragen hidden>
            <fieldset class="min-w-0">
              <legend class="font-display text-2xl leading-tight font-medium">1. Met hoeveel personen komt u?</legend>
              <div class="mt-3 grid grid-cols-3 gap-2">
                <label class="keuze"><input type="radio" class="sr-only" name="pers" value="2" checked />1 of 2</label>
                <label class="keuze"><input type="radio" class="sr-only" name="pers" value="6" />3 tot 6</label>
                <label class="keuze"><input type="radio" class="sr-only" name="pers" value="7" />Meer dan 6</label>
              </div>
            </fieldset>
            <fieldset class="min-w-0">
              <legend class="font-display text-2xl leading-tight font-medium">2. Komen er jonge kinderen mee?</legend>
              <div class="mt-3 grid grid-cols-2 gap-2">
                <label class="keuze"><input type="radio" class="sr-only" name="kind" value="nee" checked />Nee</label>
                <label class="keuze"><input type="radio" class="sr-only" name="kind" value="ja" />Ja</label>
              </div>
            </fieldset>
            <fieldset class="min-w-0">
              <legend class="font-display text-2xl leading-tight font-medium">3. Ontbijt of zelf koken?</legend>
              <div class="mt-3 grid gap-2 sm:grid-cols-3">
                <label class="keuze"><input type="radio" class="sr-only" name="eten" value="ontbijt" checked />Ontbijt verzorgd<small>Wij dekken de tafel</small></label>
                <label class="keuze"><input type="radio" class="sr-only" name="eten" value="koken" />Zelf koken<small>Met een eigen keuken</small></label>
                <label class="keuze"><input type="radio" class="sr-only" name="eten" value="maakt" />Maakt niet uit</label>
              </div>
            </fieldset>
          </form>

          <!-- Vergelijking: altijd zichtbaar (ook zonder JS), en de uitkomst van de keuzehulp licht één kolom op. -->
          <div class="min-w-0 lg:col-span-5">
            <div class="overflow-hidden rounded-xl bg-zand text-ink shadow-lg" data-advies>
              <div class="relative aspect-[16/9] overflow-hidden">
                <div data-foto="kamer"><Foto src={kamerBehang} alt="" widths={[480, 960]} sizes="(min-width: 1024px) 470px, 100vw" /></div>
                <div data-foto="woning" hidden class="absolute inset-0"><Foto src={woning2} alt="" widths={[480, 960]} sizes="(min-width: 1024px) 470px, 100vw" /></div>
                <p class="absolute bottom-3 left-3 rounded-full bg-zee px-3 py-1 text-xs font-bold text-white" data-label hidden>Ons advies</p>
              </div>
              <div class="p-6 sm:p-7">
                <div aria-live="polite">
                  <p class="kicker text-koraal" data-advies-kicker>Vergelijk</p>
                  <p class="mt-2 font-display text-[clamp(2rem,1.5vw+1.4rem,2.6rem)] leading-none font-medium" data-advies-kop>B&amp;B-kamer of vakantiewoning</p>
                  <ul class="mt-4 space-y-2 text-sm" data-redenen></ul>
                </div>
                <dl class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded-lg bg-line text-sm" data-tabel>
                  <div class="bg-duin p-3" data-kol="kamer"><dt class="font-bold">B&amp;B-kamer</dt><dd class="mt-1 text-ink-soft">150 m van strand en centrum. Altijd inclusief ontbijt. Eigen badkamer. Niet geschikt voor jonge kinderen.</dd></div>
                  <div class="bg-duin p-3" data-kol="woning"><dt class="font-bold">Vakantiewoning</dt><dd class="mt-1 text-ink-soft">50 m van strand en centrum. Complete keuken. Voor 2, 4 en 6 personen. Opbergschuur voor fietsen.</dd></div>
                </dl>
                <a href="#aanvraag" class="btn btn-zee mt-5 w-full" data-naar-aanvraag>Stel uw aanvraag samen <Fragment set:html={icoon.pijl} /></a>
              </div>
            </div>
          </div>
        </div>

        <!-- Boekingsaanvraag -->
        <div id="aanvraag" class="mt-16 scroll-mt-20 border-t border-white/15 pt-14 lg:mt-20" data-aanvraag>
          <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-7">
              <p class="kicker text-zon">Boekingsaanvraag</p>
              <h2 class="mt-3 text-3xl">Vraag uw verblijf aan</h2>
            </div>
            <p class="text-white/85 lg:col-span-5">Kies wat u wilt, uw data en met hoeveel u komt. U ziet direct uw aanvraag, klaar om te mailen. Wij laten u weten of het beschikbaar is.</p>
          </div>

          <noscript>
            <p class="mt-8 max-w-2xl text-lg">Aanvragen kan telefonisch: <a href={site.telHref} class="num underline">{site.tel}</a>, of per e-mail: <a href={`mailto:${site.mail}`} class="break-all underline">{site.mail}</a>.</p>
          </noscript>

          <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-12" hidden data-ui>
            <form class="min-w-0 space-y-7 lg:col-span-7" data-form>
              <fieldset class="min-w-0">
                <legend class="font-display text-2xl leading-tight font-medium">1. Wat wilt u boeken?</legend>
                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                  <label class="keuze"><input type="radio" class="sr-only" name="soort" value="kamer" checked />B&amp;B-kamer<small>Inclusief ontbijt, 150 m van zee</small></label>
                  <label class="keuze"><input type="radio" class="sr-only" name="soort" value="woning" />Vakantiewoning<small>Complete keuken, 50 m van zee</small></label>
                </div>
                <label class="mt-3 block text-sm font-bold" data-woningkeuze hidden>Welke woning?
                  <select name="woning" class="veld">
                    <option value="">Geen voorkeur</option>
                    {site.woningen.map((w) => <option value={w}>{w}</option>)}
                  </select>
                </label>
              </fieldset>

              <fieldset class="min-w-0">
                <legend class="font-display text-2xl leading-tight font-medium">2. Data</legend>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                  <label class="block text-sm font-bold">Aankomst<input type="date" name="aankomst" class="veld" required /></label>
                  <label class="block text-sm font-bold">Vertrek<input type="date" name="vertrek" class="veld" required /></label>
                </div>
                <p class="mt-2 text-sm text-zon" data-datumfout aria-live="polite"></p>
              </fieldset>

              <fieldset class="min-w-0">
                <legend class="font-display text-2xl leading-tight font-medium">3. Personen</legend>
                <div class="mt-3 flex items-center justify-between gap-3 rounded-xl bg-zee-2 py-2.5 pr-2.5 pl-4">
                  <span class="min-w-0"><span class="block font-bold" id="p-pers">Aantal personen</span><span class="text-sm text-white/75" data-pers-uitleg>Kamers: drie, elk met eigen badkamer</span></span>
                  <span class="flex items-center gap-2" role="group" aria-labelledby="p-pers">
                    <button type="button" class="stap" data-stap="-1" aria-label="Eén persoon minder">−</button>
                    <output class="num w-7 text-center font-display text-2xl font-semibold" data-pers aria-live="polite">2</output>
                    <button type="button" class="stap" data-stap="1" aria-label="Eén persoon meer">+</button>
                  </span>
                </div>
              </fieldset>

              <div class="grid gap-3 sm:grid-cols-2">
                <label class="block text-sm font-bold">Uw naam<input type="text" name="naam" class="veld" autocomplete="name" /></label>
                <label class="block text-sm font-bold">Opmerking <span class="font-normal text-white/75">(optioneel)</span><input type="text" name="opmerking" class="veld" /></label>
              </div>
            </form>

            <div class="min-w-0 lg:col-span-5">
              <div class="rounded-xl bg-zand p-6 text-ink shadow-lg sm:p-7 lg:sticky lg:top-24">
                <p class="kicker text-koraal">Uw aanvraag</p>
                <p class="mt-2 font-display text-3xl leading-none font-medium" data-kop>B&amp;B-kamer</p>
                <div class="mt-5 grid grid-cols-[1fr_auto_1fr] items-center gap-3 border-y border-line py-4">
                  <div class="min-w-0"><p class="text-xs font-bold tracking-[0.12em] text-ink-soft uppercase">Aankomst</p><p class="font-bold" data-aankomst>-</p></div>
                  <div class="rounded-lg bg-zee px-3 py-2 text-center text-white"><p class="num font-display text-3xl leading-none font-semibold text-zon" data-nachten>2</p><p class="text-xs" data-nachten-woord>nachten</p></div>
                  <div class="min-w-0 text-right"><p class="text-xs font-bold tracking-[0.12em] text-ink-soft uppercase">Vertrek</p><p class="font-bold" data-vertrek>-</p></div>
                </div>
                <ul class="mt-4 space-y-2 text-sm" data-regels></ul>
                <div class="mt-5 flex flex-col gap-2">
                  {site.voorstel ? (
                    <button type="button" class="btn btn-zee" data-verstuur><Fragment set:html={icoon.mail} />Verstuur per e-mail</button>
                  ) : (
                    <a href={`mailto:${site.mail}`} class="btn btn-zee" data-mail><Fragment set:html={icoon.mail} />Verstuur per e-mail</a>
                  )}
                  <a href={site.telHref} class="btn btn-line-licht text-ink"><Fragment set:html={icoon.tel} /><span>Of bel <span class="num">{site.tel}</span></span></a>
                </div>
                <p class="mt-3 text-sm text-ink-soft" data-melding aria-live="polite"></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script>
      // Keuzehulp: advies op basis van de feiten van de oude site. Boekingsaanvraag: bouwt een e-mail, verstuurt zelf niets.
      const h = document.querySelector<HTMLElement>('[data-hulp]');
      if (h) {
        const voorstel = h.dataset.voorstel === '1';
        const TEL = '0118 562 257', MAIL = 'info@slapenenzo.com';
        const q = <T extends HTMLElement>(sel: string) => h.querySelector<T>(sel)!;
        const vragen = q<HTMLFormElement>('[data-vragen]');
        const form = q<HTMLFormElement>('[data-form]');
        vragen.hidden = false;
        q('[data-ui]').hidden = false;
        q('[data-label]').hidden = false;
        vragen.addEventListener('submit', (e) => e.preventDefault());
        form.addEventListener('submit', (e) => e.preventDefault());

        let advies: 'kamer' | 'woning' | 'beide' | 'overleg' = 'kamer';
        const waarde = (f: HTMLFormElement, n: string) => (f.querySelector<HTMLInputElement>(`input[name=${n}]:checked`)!).value;
        const li = (t: string) => { const l = document.createElement('li'); l.className = 'flex gap-2.5'; const d = document.createElement('span'); d.className = 'mt-[0.5rem] h-1.5 w-1.5 flex-none rounded-full bg-koraal'; const s = document.createElement('span'); s.textContent = t; l.append(d, s); return l; };

        const raad = () => {
          const pers = +waarde(vragen, 'pers'), kind = waarde(vragen, 'kind') === 'ja', eten = waarde(vragen, 'eten');
          const r: string[] = [];
          if (pers > 6) {
            advies = 'overleg';
            r.push('Onze vakantiewoningen zijn voor 2, 4 en 6 personen, en wij verhuren drie kamers.');
            r.push('Met meer dan 6 personen kijken we graag samen wat past: bel of mail ons.');
          } else if (kind) {
            advies = 'woning';
            r.push('Ons huis (de B&B) is niet geschikt voor jonge kinderen.');
            r.push('Een vakantiewoning heeft een complete keuken en ligt op 50 m van strand en centrum.');
            if (eten === 'ontbijt') r.push('Let op: ontbijt hoort bij de B&B-kamers; in de woning kookt u zelf.');
          } else if (eten === 'koken') {
            advies = 'woning';
            r.push('Een complete keuken, koffiezetapparaat en magnetron in elke woning.');
            r.push('Gratis wasmachine en een opbergschuur voor fietsen.');
            r.push(pers > 2 ? 'Onze woningen zijn er voor 2, 4 en 6 personen.' : 'Ook voor twee personen hebben we een woning.');
          } else if (eten === 'ontbijt') {
            advies = 'kamer';
            r.push('Wij verhuren altijd inclusief ontbijt, en u maakt zelf een lunchpakket als u wilt.');
            r.push('Een eigen badkamer met wastafel, douche en toilet, luxe boxsprings en gratis wifi.');
            if (pers > 2) r.push('Met meer personen: wij verhuren drie kamers. Vermeld het aantal in uw aanvraag.');
          } else {
            advies = pers > 2 ? 'woning' : 'beide';
            if (pers > 2) { r.push('Onze vakantiewoningen zijn er voor 2, 4 en 6 personen.'); r.push('Liever ontbijt? Wij verhuren ook drie kamers met eigen badkamer.'); }
            else { r.push('Allebei passen: een kamer met ontbijt op 150 m, of een eigen woning op 50 m van zee.'); r.push('Kamer: altijd inclusief ontbijt. Woning: complete keuken en opbergschuur voor fietsen.'); }
          }
          const KOP = { kamer: 'Een B&B-kamer', woning: 'Een vakantiewoning', beide: 'Allebei mogelijk', overleg: 'Even overleggen' };
          q('[data-advies-kicker]').textContent = 'Ons advies';
          q('[data-advies-kop]').textContent = KOP[advies];
          const ul = q('[data-redenen]'); ul.replaceChildren(...r.map(li));
          q('[data-foto="woning"]').hidden = advies !== 'woning';
          h.querySelectorAll<HTMLElement>('[data-kol]').forEach((k) => {
            const aan = advies === 'beide' || advies === k.dataset.kol;
            k.className = `p-3 transition-colors ${aan ? 'bg-zon text-zee' : 'bg-duin'}`;
            k.querySelector('dd')!.className = `mt-1 ${aan ? '' : 'text-ink-soft'}`;
          });
        };
        vragen.addEventListener('change', raad);

        // Keuzehulp -> aanvraag: soort en personen alvast invullen.
        q('[data-naar-aanvraag]').addEventListener('click', () => {
          const soort = advies === 'kamer' ? 'kamer' : advies === 'woning' ? 'woning' : null;
          if (soort) (form.querySelector<HTMLInputElement>(`input[name=soort][value=${soort}]`)!).checked = true;
          const p = +waarde(vragen, 'pers'); pers = p > 6 ? 7 : p === 6 ? 4 : 2;
          bijwerken();
        });

        // Boekingsaanvraag
        const aank = form.elements.namedItem('aankomst') as HTMLInputElement;
        const vertr = form.elements.namedItem('vertrek') as HTMLInputElement;
        let pers = 2;
        const MAX = 12;
        const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const parse = (v: string) => { const [y, m, d] = v.split('-').map(Number); return new Date(y, m - 1, d); };
        const mooi = (v: string) => parse(v).toLocaleDateString('nl-NL', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        const nu = new Date(); nu.setHours(0, 0, 0, 0);
        const vr = new Date(nu); vr.setDate(nu.getDate() + (((5 - nu.getDay()) + 7) % 7 || 7));
        const zo = new Date(vr); zo.setDate(vr.getDate() + 2);
        aank.min = iso(nu); aank.value = iso(vr); vertr.value = iso(zo);

        const regel = (a: string, b: string) => {
          const l = document.createElement('li'); l.className = 'flex justify-between gap-4';
          const x = document.createElement('span'); x.className = 'text-ink-soft'; x.textContent = a;
          const y = document.createElement('span'); y.className = 'min-w-0 text-right font-bold [overflow-wrap:anywhere]'; y.textContent = b;
          l.append(x, y); return l;
        };

        const bijwerken = () => {
          const soort = waarde(form, 'soort');
          const woning = (form.elements.namedItem('woning') as HTMLSelectElement).value;
          q('[data-woningkeuze]').hidden = soort !== 'woning';
          q('[data-pers-uitleg]').textContent = soort === 'woning' ? 'Woningen voor 2, 4 en 6 personen' : 'Kamers: drie, elk met eigen badkamer';
          h.querySelectorAll<HTMLButtonElement>('[data-stap]').forEach((b) => { b.disabled = +b.dataset.stap! < 0 ? pers <= 1 : pers >= MAX; });
          q('[data-pers]').textContent = String(pers);

          if (aank.value) vertr.min = aank.value;
          let nachten = 0;
          if (aank.value && vertr.value) nachten = Math.round((parse(vertr.value).getTime() - parse(aank.value).getTime()) / 864e5);
          const geldig = nachten >= 1 && !!aank.value && parse(aank.value) >= nu;
          q('[data-datumfout]').textContent = !aank.value || !vertr.value ? 'Kies een aankomst- en vertrekdatum.' : parse(aank.value) < nu ? 'De aankomstdatum ligt in het verleden.' : nachten < 1 ? 'De vertrekdatum moet na de aankomstdatum liggen.' : '';

          const kop = soort === 'woning' ? (woning ? `Vakantiewoning ${woning}` : 'Vakantiewoning') : 'B&B-kamer';
          q('[data-kop]').textContent = kop;
          q('[data-aankomst]').textContent = aank.value ? mooi(aank.value) : '-';
          q('[data-vertrek]').textContent = vertr.value ? mooi(vertr.value) : '-';
          q('[data-nachten]').textContent = geldig ? String(nachten) : '-';
          q('[data-nachten-woord]').textContent = nachten === 1 ? 'nacht' : 'nachten';

          const naam = (form.elements.namedItem('naam') as HTMLInputElement).value.trim();
          const opm = (form.elements.namedItem('opmerking') as HTMLInputElement).value.trim();
          const lijst = q('[data-regels]'); lijst.replaceChildren();
          lijst.append(regel('Personen', `${pers} ${pers === 1 ? 'persoon' : 'personen'}`));
          lijst.append(regel(soort === 'woning' ? 'Keuken' : 'Ontbijt', soort === 'woning' ? 'Complete keuken' : 'Altijd inclusief'));
          if (soort === 'woning' && !woning) lijst.append(regel('Woning', 'Geen voorkeur'));
          if (opm) lijst.append(regel('Opmerking', opm));

          const tekst = [
            'Goedendag,', '',
            'Graag vraag ik een verblijf aan bij Slapen & Zo:',
            kop,
            `Aankomst: ${aank.value ? mooi(aank.value) : '-'}`,
            `Vertrek: ${vertr.value ? mooi(vertr.value) : '-'}`,
            `Aantal nachten: ${geldig ? nachten : '-'}`,
            `Personen: ${pers}`,
            ...(opm ? [`Opmerking: ${opm}`] : []), '',
            'Is dit beschikbaar?', naam ? `Groet, ${naam}` : 'Groet,',
          ].join('\n');
          const ml = h.querySelector<HTMLAnchorElement>('[data-mail]');
          if (ml) ml.href = `mailto:${MAIL}?subject=${encodeURIComponent('Aanvraag ' + kop)}&body=${encodeURIComponent(tekst)}`;
        };

        h.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          const b = t.closest<HTMLButtonElement>('[data-stap]');
          if (b && !b.disabled) { pers = Math.min(MAX, Math.max(1, pers + +b.dataset.stap!)); bijwerken(); }
          if (t.closest('[data-verstuur]') && voorstel) {
            q('[data-melding]').textContent = `Dit is een ontwerpvoorstel: deze aanvraag wordt nog niet verstuurd. Bel ${TEL} of mail naar ${MAIL}.`;
          }
        });
        form.addEventListener('input', bijwerken);
        form.addEventListener('change', bijwerken);
        raad();
        bijwerken();
      }
    </script>

    <!-- Contact -->
    <section id="contact" class="scroll-mt-16 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-groen">Contact</p>
          <h2 class="mt-3 text-3xl">Neem contact met ons op</h2>
          <p class="mt-6 text-lg">Wij helpen u graag. Bel ons of stuur een e-mail.</p>
          <dl class="mt-10 grid gap-6 border-t border-line pt-8 sm:grid-cols-2">
            <div><dt class="text-sm text-ink-soft">Telefoon</dt><dd><a href={site.telHref} class="num font-display text-[2.25rem] leading-tight font-medium underline decoration-koraal decoration-2 underline-offset-4">{site.tel}</a></dd></div>
            <div><dt class="text-sm text-ink-soft">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="text-lg font-bold break-all underline decoration-koraal decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          </dl>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-zee"><Fragment set:html={icoon.tel} /><span>Bel <span class="num">{site.tel}</span></span></a>
            <a href="#aanvraag" class="btn btn-line-licht text-ink">Stel een aanvraag samen</a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="overflow-hidden rounded-xl bg-duin shadow-sm">
            <div class="aspect-[16/9] overflow-hidden"><Foto src={huis} alt="Ons huis aan de Majoorwerf in Zoutelande" widths={[480, 960]} sizes="(min-width: 1024px) 470px, 100vw" class="object-[50%_60%]" /></div>
            <div class="p-6 sm:p-8">
              <h3 class="text-2xl">Adres</h3>
              <address class="mt-3 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
              <a href={site.maps} rel="noopener" class="btn btn-groen mt-6">Route plannen</a>
              <p class="mt-6 border-t border-line pt-5 text-sm text-ink-soft">Op onze verhuur zijn de RECRON-voorwaarden van toepassing. <span class="text-xs">[[AANLEVEREN: link naar RECRON-voorwaarden NL en DE]]</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
