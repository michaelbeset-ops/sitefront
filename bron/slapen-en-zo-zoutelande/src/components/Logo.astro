---
// Typografisch wordmark "Slapen & Zo" met een zon die in zee zakt als beeldmerk (hun oude site had geen eigen logo).
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const zon = licht ? '#f4a06b' : '#a4451c';
const zee = licht ? '#ffffff' : '#24665f';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg viewBox="0 0 32 32" class={`h-8 w-8 flex-none ${licht ? "" : "max-[359px]:hidden"}`} aria-hidden="true">
    <path d="M7 17a9 9 0 0 1 18 0z" fill={zon} />
    <path d="M3 21.5c2.2 0 2.2-1.5 4.3-1.5s2.2 1.5 4.3 1.5 2.2-1.5 4.4-1.5 2.2 1.5 4.3 1.5 2.2-1.5 4.3-1.5 2.2 1.5 4.4 1.5" fill="none" stroke={zee} stroke-width="2" stroke-linecap="round" />
    <path d="M7 26.5c2 0 2-1.3 3.9-1.3s2 1.3 3.9 1.3 2-1.3 3.9-1.3 2 1.3 3.9 1.3 2-1.3 3.9-1.3" fill="none" stroke={zee} stroke-width="2" stroke-linecap="round" opacity=".55" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-display text-[1.45rem] whitespace-nowrap leading-[0.9] sm:text-[1.65rem] font-medium tracking-[-0.01em]">Slapen <span class="schuin" style={`color:${zon}`}>&amp;</span> Zo</span>
    <span class={`mt-1 text-[0.625rem] font-bold uppercase whitespace-nowrap tracking-[0.2em] ${licht ? 'text-white/80' : 'text-ink-soft'}`}>Bed &amp; Breakfast<span class={licht ? '' : 'hidden sm:inline'}> Zoutelande</span></span>
  </span>
</span>
