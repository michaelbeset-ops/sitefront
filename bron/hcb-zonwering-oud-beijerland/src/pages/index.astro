---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, producten, reparaties, reviews, waHoi, waMet } from '../data/site';

import markiesBlauw from '../assets/markies-blauw.jpg';
import bord from '../assets/bord.jpg';
import showroomBus from '../assets/showroom-bus.jpg';
import knikarm from '../assets/knikarm-terras.jpg';
import rolluiken from '../assets/rolluiken.jpg';
import screens from '../assets/screens.jpg';
import markiesGroen from '../assets/markies-groen.jpg';
import monteurs from '../assets/monteurs-ray.jpg';
import lyceum from '../assets/hoeksch-lyceum.jpg';

// Offertezin: alleen producten en reparaties die ze zelf noemen.
const nieuw = ['rolluiken', 'een knikarmscherm', 'een uitvalscherm', 'zipscreens', 'markiezen', 'verandazonwering', 'horren of een hordeur', 'rolgordijnen of jaloezieën', 'Velux-raamdecoratie', 'Somfy-bediening'];
const aantallen = ['1 raam', '2 ramen', '3 ramen', '4 ramen', '5 ramen', '6 ramen of meer', 'een terras', 'een deur of pui'];
const stuk = ['een zonnescherm', 'een rolluik', 'een markies', 'een screen', 'een hor', 'jaloezieën'];
const klacht = ['het doek moet vervangen worden', 'hij sluit niet goed', 'een arm is kapot', 'de motor doet het niet meer', 'het gaas is kapot', 'iets anders'];
const eersteBericht = waMet(`Hallo HCB Zonwering, ik zoek ${nieuw[0]} voor ${aantallen[1]} in Oud-Beijerland. Kunt u langskomen om in te meten?`);

const ral = [
  { naam: 'Creme-wit', code: 'RAL 9001', kleur: '#e9e0d2' },
  { naam: 'Wit', code: 'RAL 9010', kleur: '#f4f1e8' },
  { naam: 'Antiek groen', code: 'RAL 6009', kleur: '#27352a' },
  { naam: 'Beige', code: 'RAL 1015', kleur: '#e6d2b5' },
];

const titel = 'HCB Zonwering | Zonwering en rolluiken op maat in Oud-Beijerland';
const omschrijving = 'Rolluiken, zonneschermen, screens, markiezen, horren en raamdecoratie uit Oud-Beijerland. Klein familiebedrijf met eigen productie, meer dan 25 jaar ervaring en een showroom aan de Zinkweg (op afspraak).';
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO: blauw-witte markiezen, hun eigen foto -->
    <section class="relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-nacht text-wit md:min-h-[100svh]">
      <Kop />
      <Image src={markiesBlauw} alt="Rood bakstenen huis met blauw-wit gestreepte markiezen met golvende rand boven de ramen en het balkon" quality={58} widths={[480, 720, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[64%_40%] md:object-[60%_30%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0e1a3acc_0%,#0e1a3a40_20%,#0e1a3a99_42%,#0e1a3ae0_62%,#0e1a3af7_100%)] md:bg-[linear-gradient(180deg,#0e1a3a99_0%,#0e1a3a00_22%),linear-gradient(0deg,#0e1a3af2_0%,#0e1a3ab3_30%,#0e1a3a00_62%),linear-gradient(90deg,#0e1a3a99_0%,#0e1a3a00_55%)]"></div>
      <div class="wrap mt-auto pb-20 pt-28 md:pb-24">
        <p class="flex items-center gap-3 text-base font-bold text-wit/95 md:text-lg"><span class="zondot" aria-hidden="true"></span>Zonwering en rolluiken uit Oud-Beijerland</p>
        <h1 class="mt-5 max-w-[12ch] text-hero">Tot op de millimeter op maat.</h1>
        <div class="mt-7 grid gap-8 md:mt-9 lg:grid-cols-12 lg:items-end">
          <p class="max-w-xl text-lg text-wit/90 md:text-xl lg:col-span-6">Een klein familiebedrijf met eigen productie, meer dan 25 jaar ervaring en een huiselijke showroom aan de Zinkweg.</p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-4 lg:col-span-6 lg:justify-end">
            <a href={waHoi} class="knop knop-zon"><Icoon naam="wa" />WhatsApp de monteur</a>
            <a href={site.telHref} class="link link-zon num font-bold text-wit max-sm:hidden">of bel {site.tel}</a>
          </div>
        </div>
      </div>
    </section>
    <div class="festoen" aria-hidden="true"></div>

    <!-- 2. BEDRIJF AAN HUIS: het bord met de zon -->
    <section id="showroom" class="pb-16 pt-20 md:pb-24 md:pt-28">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={bord} alt="Wit bord met Welkom, HCB zonwering en een lachende gele zon met zonnebril die twee duimen opsteekt, tussen groene struiken" quality={74} widths={[480, 720, 960]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[4/5] w-full rounded-lg object-cover object-[50%_62%]" />
          <figcaption class="mt-3 text-xs text-grijs">Het bord aan de Zinkweg</figcaption>
        </figure>
        <div class="lg:col-span-7 lg:pt-10">
          <h2 class="rijs text-4xl text-blauw">Bedrijf aan huis.</h2>
          <p class="rijs mt-8 font-kop text-2xl leading-[1.2] text-inkt" style="--d:.08s">Geen overbodig groot pand waar u iemand moet zoeken, maar een huiselijke showroom van alle gemakken voorzien.</p>
          <p class="rijs mt-6 max-w-xl text-grijs" style="--d:.12s">Onder het genot van koffie, thee of fris komt u alle ins &amp; outs over uw product te weten. Kom graag op afspraak, zodat we voldoende tijd voor u kunnen reserveren.</p>
          <ul class="rijs mt-10 grid max-w-xl grid-cols-1 gap-x-8 gap-y-3 font-bold sm:grid-cols-2" style="--d:.16s">
            {['Eigen productie', 'Ervaring en deskundigheid', 'Totaalprijs', 'Mond-tot-mond reclame'].map((t) => <li class="flex items-center gap-3"><span class="zondot" aria-hidden="true"></span>{t}</li>)}
          </ul>
          <div class="rijs mt-10 flex flex-wrap items-center gap-x-6 gap-y-3" style="--d:.2s">
            <a href={waMet('Hallo HCB Zonwering, ik wil graag een afspraak maken om de showroom aan de Zinkweg te bekijken.')} class="knop knop-blauw"><Icoon naam="wa" />Afspraak voor de showroom</a>
            <span class="text-sm text-grijs">{site.showroom}, {site.plaats}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. PRODUCTEN: levertijdenlijst -->
    <section id="producten" class="bg-papier py-16 md:py-24">
      <div class="wrap grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <h2 class="rijs text-4xl">Binnen en buiten, <span class="text-blauw">één adres.</span></h2>
          <p class="rijs mt-6 max-w-md text-grijs" style="--d:.08s">HCB zonwering kan ieder gewenst product leveren, voor binnen- en buitenzonwering. Waar ze het noemen, staat de levertijd erbij.</p>
          <ul class="rijs mt-9 text-lg font-bold" style="--d:.12s">
            {producten.map((x) => (
              <li><a href={x.href} class="regel"><span class="min-w-0">{x.naam}</span><span class="r-tijd num whitespace-nowrap text-sm font-semibold text-grijs md:text-base">{x.tijd || 'op maat'}</span><Icoon naam="pijl" class="r-pijl h-4 w-4 flex-none text-blauw max-sm:hidden" /></a></li>
            ))}
          </ul>
          <p class="rijs mt-5 text-sm text-grijs">Levertijden zoals op de productpagina's: leveren én installeren.</p>
        </div>
        <div class="grid grid-cols-2 gap-3 self-start lg:col-span-6 lg:sticky lg:top-8 md:gap-4">
          <figure class="rijs col-span-2">
            <Image src={knikarm} alt="Wit knikarmscherm met grijs gestreept doek boven een terras met houten tuinstoelen met groene kussens" quality={64} widths={[400, 600, 800, 1000]} sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[16/10] w-full rounded-lg object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">Knikarmscherm boven het terras</figcaption>
          </figure>
          <figure class="rijs max-sm:hidden" style="--d:.08s">
            <Image src={rolluiken} alt="Witte rolluiken voor twee ramen van een bakstenen woning met zonnepanelen op het dak" quality={72} widths={[320, 480, 640]} sizes="(min-width: 1024px) 23vw, 50vw" class="aspect-[4/5] w-full rounded-lg object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">Rolluiken</figcaption>
          </figure>
          <figure class="rijs max-sm:hidden" style="--d:.14s">
            <Image src={screens} alt="Donkere screens voor de ramen van een bakstenen woning met witte lijsten" quality={72} widths={[320, 480, 640]} sizes="(min-width: 1024px) 23vw, 50vw" class="aspect-[4/5] w-full rounded-lg object-cover object-[78%_50%]" />
            <figcaption class="mt-2 text-xs text-grijs">Screens</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 4. MARKIEZEN: eigentijdse nostalgie -->
    <section id="markiezen" class="pb-16 md:pb-24">
      <Image src={markiesGroen} alt="Twee groen-wit gestreepte markiezen met golvende rand boven een raam en een voordeur in een oude bakstenen gevel" quality={62} widths={[480, 720, 960, 1280, 1920]} sizes="100vw" class="h-[56vw] max-h-[460px] min-h-[300px] w-full object-cover object-[50%_40%]" />
      <div class="wrap mt-14 grid grid-cols-1 gap-y-12 md:mt-20 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-6">
          <h2 class="rijs text-4xl">Markiezen, <span class="text-blauw">eigentijdse nostalgie.</span></h2>
          <p class="rijs mt-7 max-w-lg text-lg text-grijs" style="--d:.08s">Dé mooiste vorm van zonwering van vandaag de dag is de markies. Kies een frame van aluminium, hardhout of grenen, met een kap van hetzelfde materiaal.</p>
          <div class="rijs mt-10" style="--d:.12s">
            <p class="font-bold">Standaard in vier kleuren</p>
            <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
              {ral.map((r) => (
                <li class="flex items-center gap-3 sm:flex-col sm:items-start">
                  <span class="h-12 w-12 flex-none rounded-full border border-lijn-2 shadow-[inset_0_-6px_10px_#0000000f]" style={`background:${r.kleur}`} aria-hidden="true"></span>
                  <span class="text-sm leading-tight"><span class="font-bold">{r.naam}</span><br /><span class="num text-grijs">{r.code}</span></span>
                </li>
              ))}
            </ul>
            <p class="mt-6 max-w-lg text-sm text-grijs">Of tegen een geringe meerprijs in een kleur die past bij het schilderwerk van uw woning, afgewerkt met biesband en nagels.</p>
          </div>
        </div>
        <div class="space-y-10 lg:col-span-5 lg:col-start-8 lg:pt-3">
          <div class="rijs rounded-lg bg-ecru p-7 md:p-9" style="--d:.1s">
            <p class="font-kop text-2xl leading-[1.15]">Alleen in wit, roomwit of industrieel zilver?</p>
            <p class="mt-4 text-grijs">Dat geldt alleen in de bouwmarkt. Omdat HCB alle onderdelen zelf op maat zaagt, kan uw rolluik of zonnescherm in elke RAL-kleur worden gepoedercoat. Zo heeft u altijd iets dat uw buren niet hebben.</p>
          </div>
          <div class="rijs border-l-4 border-zon pl-6" style="--d:.16s">
            <p class="font-bold">Een stalenboek mee naar huis</p>
            <p class="mt-2 text-grijs">U krijgt wanneer nodig een boek met tientallen doeken mee. Zo kiest u in alle rust, bij elke lichtinval, het doek dat bij uw woning past. Bij het inmeten geeft u het weer mee terug.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. OFFERTEZIN: eindigt in WhatsApp naar de monteur -->
    <section id="vraag" class="bg-nacht py-20 text-wit md:py-20">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="rijs text-4xl">Vraag het de monteur.</h2>
          <div class="rijs flex rounded-full bg-nacht-2 p-1" role="group" aria-label="Soort vraag">
            <button type="button" class="tab" aria-pressed="true" data-modus="nieuw">Iets nieuws</button>
            <button type="button" class="tab" aria-pressed="false" data-modus="reparatie">Reparatie</button>
          </div>
        </div>
        <form class="rijs mt-12 md:mt-16" data-zin onsubmit="return false" style="--d:.08s">
          <p class="font-kop text-[1.6rem] leading-[1.45] sm:text-[2.1rem] md:text-[2.6rem] lg:text-[3rem]" data-zin-nieuw>
            Ik zoek
            <label class="sr-only" for="z-product">Product</label>
            <select id="z-product" class="kies" data-v="product">{nieuw.map((x) => <option>{x}</option>)}</select>
            voor
            <label class="sr-only" for="z-aantal">Aantal</label>
            <select id="z-aantal" class="kies" data-v="aantal">{aantallen.map((x, i) => <option selected={i === 1}>{x}</option>)}</select>
            in <label class="sr-only" for="z-plaats">Plaats</label><input id="z-plaats" class="vul" data-v="plaats" type="text" value="Oud-Beijerland" placeholder="uw plaats" autocomplete="address-level2" />.
          </p>
          <p class="hidden font-kop text-[1.6rem] leading-[1.45] sm:text-[2.1rem] md:text-[2.6rem] lg:text-[3rem]" data-zin-reparatie>
            Ik heb
            <label class="sr-only" for="z-stuk">Wat moet gerepareerd worden</label>
            <select id="z-stuk" class="kies" data-v="stuk">{stuk.map((x) => <option>{x}</option>)}</select>
            en
            <label class="sr-only" for="z-klacht">Wat is er mis</label>
            <select id="z-klacht" class="kies" data-v="klacht">{klacht.map((x) => <option>{x}</option>)}</select>,
            in <label class="sr-only" for="z-plaats2">Plaats</label><input id="z-plaats2" class="vul" data-v="plaats2" type="text" value="Oud-Beijerland" placeholder="uw plaats" autocomplete="address-level2" />.
          </p>
          <div class="mt-12 grid gap-8 border-t border-lijn-donker pt-8 md:grid-cols-12 md:items-center">
            <p class="text-mist md:col-span-7">Stuur gerust een foto mee. Staat de monteur hoog op een ladder, dan belt hij u zo snel mogelijk terug.</p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3 md:col-span-5 md:justify-end">
              <a href={eersteBericht} class="knop knop-zon" data-wa><Icoon naam="wa" />Stuur naar de monteur</a>
              <a href={site.gsmHref} class="link link-zon num text-sm font-bold">{site.gsm}</a>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 6. REPARATIE: de monteurs aan het werk -->
    <section id="reparatie" class="py-16 md:py-24">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-7">
          <Image src={monteurs} alt="Twee monteurs van HCB op trappen tillen een ingepakte screenkast boven de voordeur en het raam van een rijtjeshuis" quality={72} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-lg object-cover" />
          <figcaption class="mt-4 flex flex-wrap items-baseline gap-x-3 text-sm"><span class="font-kop text-lg text-blauw">“Dit zijn nou de echte vakmannen.”</span><span class="text-grijs">Ray, bij zijn foto op Google, juni 2022</span></figcaption>
        </figure>
        <div class="lg:col-span-5 lg:pt-6">
          <h2 class="rijs text-3xl">Ook voor reparatie kunt u bij ons terecht.</h2>
          <p class="rijs mt-6 text-grijs" style="--d:.08s">De meest voorkomende motoren en onderdelen liggen op voorraad, zodat uw zonwering binnen korte tijd weer werkt. De monteur overlegt de handelingen en het kostenplaatje altijd vooraf.</p>
          <ul class="rijs mt-8 space-y-2.5" style="--d:.12s">
            {reparaties.map((r) => <li class="flex gap-3"><Icoon naam="vink" class="mt-1 h-5 w-5 flex-none text-blauw" />{r}</li>)}
          </ul>
          <a href="#vraag" class="rijs knop knop-rand mt-9" data-naar-reparatie style="--d:.16s">Reparatie doorgeven</a>
        </div>
      </div>
    </section>

    <!-- 7. PROJECTEN EN KLANTEN -->
    <section id="projecten" class="bg-papier py-16 md:py-24">
      <div class="wrap grid grid-cols-1 gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <h2 class="rijs text-3xl">Van woonhuis tot <span class="text-blauw">10 hoog.</span></h2>
          <p class="rijs mt-6 text-grijs" style="--d:.08s">Woonhuis, garage, bedrijfspand, fabriekshal, school of verzorgingstehuis. Voor grote projecten komt HCB langs om de situatie te bekijken en een plan van aanpak te maken.</p>
          <figure class="rijs mt-10" style="--d:.12s">
            <Image src={lyceum} alt="Bus van HCB zonwering en een hoogwerker voor de gevel van het Hoeksch Lyceum met een banier 100 jaar" quality={74} widths={[480, 600]} sizes="(min-width: 1024px) 34vw, 100vw" class="aspect-[3/2] w-full rounded-lg object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">Project bij het Hoeksch Lyceum</figcaption>
          </figure>
        </div>
        <div class="space-y-12 lg:col-span-6 lg:col-start-7 lg:pt-4">
          {reviews.map((r, i) => (
            <blockquote class="rijs border-t-2 border-blauw pt-8" style={`--d:${0.08 * (i + 1)}s`}>
              <p class="flex gap-1 text-zon" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-5 w-5" />)}</p>
              <p class="mt-5 font-kop text-xl leading-[1.3] md:text-[1.6rem]">“{r.tekst}”</p>
              <footer class="mt-4 text-sm text-grijs"><span class="font-bold text-inkt">{r.naam}</span>, Google review, {r.wanneer}</footer>
            </blockquote>
          ))}
          <p class="rijs flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews</p>
        </div>
      </div>
    </section>

    <!-- 8. CONTACT -->
    <section id="contact" class="pb-20 pt-16 md:pb-24 md:pt-24">
      <div class="wrap grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={showroomBus} alt="Witte HCB-bus op het grind voor de showroom met openstaande deur, een Somfy-banier en hangende bloemen" quality={72} widths={[480, 720, 960, 1280]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/3] w-full rounded-lg object-cover object-[42%_50%] lg:aspect-square" />
          <figcaption class="mt-3 text-xs text-grijs">De showroom aan de Zinkweg 97</figcaption>
        </figure>
        <div class="lg:col-span-7 lg:pt-4">
          <h2 class="rijs text-4xl">Kom langs, <span class="text-blauw">op afspraak.</span></h2>
          <p class="rijs mt-6 max-w-md text-grijs" style="--d:.08s">Bij HCB kunt u altijd vrijblijvend langskomen om producten te bekijken, uit te proberen en vragen te stellen.</p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.12s">
            <a href={waHoi} class="knop knop-zon"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-rand"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <dl class="rijs mt-12 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2" style="--d:.16s">
            <div class="border-t border-lijn-2 pt-5">
              <dt class="font-kop text-xl text-blauw">Showroom</dt>
              <dd class="mt-2">{site.showroom}<br />{site.postcode} {site.plaats}<br /><span class="text-grijs">Alleen op afspraak</span></dd>
              <dd class="mt-3"><a href={site.maps} class="link text-sm font-bold">Route plannen</a></dd>
            </div>
            <div class="border-t border-lijn-2 pt-5">
              <dt class="font-kop text-xl text-blauw">Werkplaats</dt>
              <dd class="mt-2">{site.werkplaats}<br />{site.plaats}</dd>
            </div>
            <div class="border-t border-lijn-2 pt-5">
              <dt class="font-kop text-xl text-blauw">Administratie en planning</dt>
              <dd class="mt-2"><a href={site.telHref} class="link num font-bold">{site.tel}</a></dd>
              <dd class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link text-sm">{site.mail}</a></dd>
            </div>
            <div class="border-t border-lijn-2 pt-5">
              <dt class="font-kop text-xl text-blauw">Monteur en expert</dt>
              <dd class="mt-2"><a href={site.gsmHref} class="link num font-bold">{site.gsm}</a></dd>
              <dd class="mt-1 text-sm text-grijs">Bellen of WhatsApp</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </main>
  <Voet />

  <script>
    const wa = 'https://wa.me/31650534895?text=';
    const zin = document.querySelector<HTMLFormElement>('[data-zin]');
    const knop = document.querySelector<HTMLAnchorElement>('[data-wa]');
    let modus: 'nieuw' | 'reparatie' = 'nieuw';
    const v = (k: string) => (zin?.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-v="${k}"]`)?.value || '').trim();
    // Elke keuzelijst precies zo breed als het gekozen woord, zodat de zin een zin blijft.
    const maat = document.createElement('span');
    maat.setAttribute('aria-hidden', 'true');
    maat.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0';
    document.body.appendChild(maat);
    const pas = () => {
      zin?.querySelectorAll<HTMLSelectElement>('select.kies').forEach((s) => {
        if (s.offsetParent === null) return;
        const cs = getComputedStyle(s);
        maat.style.font = cs.font; maat.style.letterSpacing = cs.letterSpacing;
        maat.textContent = s.options[s.selectedIndex]?.text || '';
        s.style.width = `calc(${maat.getBoundingClientRect().width}px + 1.15em)`;
      });
      zin?.querySelectorAll<HTMLInputElement>('input.vul').forEach((i) => {
        if (i.offsetParent === null) return;
        const cs = getComputedStyle(i);
        maat.style.font = cs.font; maat.textContent = i.value || i.placeholder || 'plaats';
        i.style.width = `calc(${Math.max(maat.getBoundingClientRect().width, 60)}px + .25em)`;
      });
    };
    const maak = () => {
      pas();
      if (!knop) return;
      const plek = (modus === 'nieuw' ? v('plaats') : v('plaats2')) || 'de Hoeksche Waard';
      const t = modus === 'nieuw'
        ? `Hallo HCB Zonwering, ik zoek ${v('product')} voor ${v('aantal')} in ${plek}. Kunt u langskomen om in te meten?`
        : `Hallo HCB Zonwering, ik heb ${v('stuk')} en ${v('klacht')}. Ik woon in ${plek}. Kunt u ernaar kijken? Ik stuur een foto mee.`;
      knop.href = wa + encodeURIComponent(t);
    };
    const zet = (m: 'nieuw' | 'reparatie') => {
      modus = m;
      document.querySelectorAll<HTMLButtonElement>('[data-modus]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modus === m)));
      document.querySelector('[data-zin-nieuw]')?.classList.toggle('hidden', m !== 'nieuw');
      document.querySelector('[data-zin-reparatie]')?.classList.toggle('hidden', m !== 'reparatie');
      maak();
    };
    document.querySelectorAll<HTMLButtonElement>('[data-modus]').forEach((b) => b.addEventListener('click', () => zet(b.dataset.modus as 'nieuw' | 'reparatie')));
    document.querySelector('[data-naar-reparatie]')?.addEventListener('click', () => zet('reparatie'));
    zin?.addEventListener('input', maak);
    zin?.addEventListener('change', maak);
    maak();
    document.fonts?.ready.then(pas);
    addEventListener('resize', pas);
  </script>
</Base>
