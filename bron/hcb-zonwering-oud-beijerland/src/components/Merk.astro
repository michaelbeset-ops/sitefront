---
// Woordmerk naar hun logo en het witte bord: blauw "HCB" voor een halve gele zon, "zonwering" eronder.
import { url } from '../data/site';
---
<a href={url('')} class="group relative inline-flex flex-col items-start overflow-hidden rounded-md bg-wit px-3.5 pb-2 pt-2 no-underline shadow-[0_1px_3px_#0e1a3a40] md:px-4">
  <span class="absolute left-[2.1rem] top-[.3rem] h-[1.45rem] w-[2.9rem] rounded-t-full bg-zon transition-transform duration-500 group-hover:-translate-y-0.5 md:left-[2.45rem] md:h-[1.7rem] md:w-[3.4rem]" aria-hidden="true"></span>
  <span class="relative font-kop text-[1.75rem] leading-none tracking-[-.01em] text-blauw md:text-[2.1rem]">HCB</span>
  <span class="relative -mt-0.5 text-[.8rem] font-extrabold italic leading-none text-blauw md:text-[.9rem]">zonwering</span>
</a>
