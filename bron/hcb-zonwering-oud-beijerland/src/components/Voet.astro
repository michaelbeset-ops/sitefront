---
import { site, url, waHoi, producten } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<div class="festoen" aria-hidden="true"></div>
<footer class="bg-nacht pt-6 text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Zonwering, rolluiken, horren en raamdecoratie uit Oud-Beijerland. Een klein familiebedrijf met meer dan 25 jaar ervaring.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-kop text-lg text-wit">Producten</p>
      <ul class="mt-4 space-y-1.5">
        {producten.map((x) => <li><a href={x.href} class="link link-zon">{x.naam}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-kop text-lg text-wit">Contact</p>
      <p class="mt-4">Planning<br /><a href={site.telHref} class="link link-zon num">{site.tel}</a></p>
      <p class="mt-3">Monteur<br /><a href={site.gsmHref} class="link link-zon num">{site.gsm}</a></p>
      <p class="mt-3"><a href={waHoi} class="link link-zon">WhatsApp</a></p>
      <p class="mt-3 break-all"><a href={`mailto:${site.mail}`} class="link link-zon">{site.mail}</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-kop text-lg text-wit">Showroom</p>
      <p class="mt-4">{site.showroom}<br />{site.postcode} {site.plaats}<br />Alleen op afspraak</p>
      <p class="mt-4 font-bold text-wit">Werkplaats</p>
      <p>{site.werkplaats}<br />{site.plaats}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-donker py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-zon">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en foto’s van hcbzonwering.nl. Foto van de monteurs: Google-foto van klant Ray (juni 2022). Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
