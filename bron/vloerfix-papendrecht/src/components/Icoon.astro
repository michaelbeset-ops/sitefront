---
// Lijn-iconen (24px raster, 1.75 lijn) plus het WhatsApp- en Google-merkteken.
interface Props { naam: 'wa' | 'tel' | 'check' | 'ster' | 'mail' | 'pin' | 'pijl' | 'klok' | 'route' | 'g' | 'laag' | 'hand' | 'liniaal' | 'zoek'; class?: string }
const { naam, class: cls = 'h-5 w-5' } = Astro.props;
---
{naam === 'wa' && <svg viewBox="0 0 24 24" class={cls} fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 4.54 0 8.23 3.7 8.23 8.24 0 4.54-3.69 8.24-8.22 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.39 1.01 2.56.12.16 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"/></svg>}
{naam === 'tel' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h3.5l1.5 4-2.2 1.4a11 11 0 0 0 6.8 6.8L16 14l4 1.5V19a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>}
{naam === 'check' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"/></svg>}
{naam === 'ster' && <svg viewBox="0 0 24 24" class={cls} fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.5.8-4.8 4.5 1.2 6.5L12 17.2l-5.8 3.2 1.2-6.5L2.6 9.4l6.5-.8L12 2.6Z"/></svg>}
{naam === 'mail' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>}
{naam === 'pin' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>}
{naam === 'pijl' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>}
{naam === 'klok' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>}
{naam === 'route' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-8-8 18-2-8-8-2Z"/></svg>}
{naam === 'laag' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 15.5 12 20l9.5-4.5M2.5 11.5 12 16l9.5-4.5L12 7l-9.5 4.5Z"/></svg>}
{naam === 'hand' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12.5 8.5 7l3 3 3-3L21 13.5M7 17h10M9.5 20.5h5"/></svg>}
{naam === 'liniaal' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6.5 8v3M10.5 8v4M14.5 8v3M18.5 8v4"/></svg>}
{naam === 'zoek' && <svg viewBox="0 0 24 24" class={cls} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>}
{naam === 'g' && <svg viewBox="0 0 24 24" class={cls} aria-hidden="true"><path fill="#4285F4" d="M22.6 12.3c0-.8-.1-1.4-.2-2.1H12v4h6c-.1 1-.8 2.5-2.3 3.5l3.5 2.7c2.1-2 3.4-4.8 3.4-8.1Z"/><path fill="#34A853" d="M12 23c2.9 0 5.4-1 7.2-2.6l-3.5-2.7c-.9.6-2.1 1.1-3.7 1.1-2.8 0-5.2-1.9-6.1-4.5L2.3 17c1.8 3.6 5.5 6 9.7 6Z"/><path fill="#FBBC05" d="M5.9 14.3c-.2-.7-.4-1.5-.4-2.3s.1-1.6.4-2.3L2.3 7C1.5 8.5 1 10.2 1 12s.5 3.5 1.3 5l3.6-2.7Z"/><path fill="#EA4335" d="M12 5.2c2 0 3.4.9 4.2 1.6l3.1-3C17.4 2 14.9 1 12 1 7.8 1 4.1 3.4 2.3 7l3.6 2.7C6.8 7.1 9.2 5.2 12 5.2Z"/></svg>}
