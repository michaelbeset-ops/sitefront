---
// Topbalk met vinkjes + telefoon, daaronder de header. Op de homepage ligt de header transparant over de hero
// en wordt hij wit zodra je voorbij de foto scrolt.
import { site, url, waMet } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
interface Props { overBeeld?: boolean }
const { overBeeld = false } = Astro.props;
const nav = [
  ['Diensten', '#diensten'],
  ['Werkwijze', '#werkwijze'],
  ['Projecten', '#projecten'],
  ['Over ons', '#over'],
  ['Reviews', '#reviews'],
  ['Contact', '#contact'],
];
const thuis = url('');
---
<div class="topbalk bg-antraciet text-licht">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[.8125rem]">
    <ul class="flex min-w-0 gap-6 overflow-hidden whitespace-nowrap">
      {['Zandcement dekvloeren', 'Op en over vloerverwarming', 'Egaliseren', 'Meer dan 25 jaar ervaring'].map((t, i) => (
        <li class:list={['flex items-center gap-2', { 'max-sm:hidden': i > 0, 'max-lg:hidden': i > 1, 'max-xl:hidden': i > 2 }]}><Icoon naam="check" class="h-3.5 w-3.5 text-rood-licht" />{t}</li>
      ))}
    </ul>
    <a href={site.telHref} class="num flex shrink-0 items-center gap-2 font-semibold hover:text-rood-licht"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
  </div>
</div>

<header class:list={['kop sticky top-0 z-40', { 'over-beeld': overBeeld }]} data-kop>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6 lg:h-20">
    <a href={thuis} class="flex items-center gap-3">
      <Merk class="h-9 w-auto shrink-0" />
      <span class="leading-none">
        <span class="woordmerk block">VLOERFIX</span>
        <span class="mt-1.5 block text-[.7rem] tracking-[.06em] opacity-75">Dekvloeren, Papendrecht</span>
      </span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-[.95rem] font-medium">
        {nav.map(([t, h]) => <li><a href={`${thuis}${h}`} class="navlink">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href={site.telHref} class="knop knop-rand knop-klein num hidden xl:inline-flex"><Icoon naam="tel" class="h-4 w-4" />{site.tel}</a>
      <a href={waMet('ik heb een vraag over een dekvloer. ')} class="knop knop-rood knop-klein hidden sm:inline-flex"><Icoon naam="wa" />WhatsApp</a>
      <button type="button" class="menu-knop grid h-11 w-11 place-items-center rounded-md lg:hidden" aria-expanded="false" aria-controls="menu" aria-label="Menu openen" data-menu-knop>
        <span class="streepjes" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="menu" class="menu lg:hidden" hidden data-menu>
    <nav aria-label="Menu" class="wrap flex min-h-full flex-col justify-between gap-10 pb-28 pt-6">
      <ul class="divide-y divide-lijn border-y border-lijn">
        {nav.map(([t, h]) => <li><a href={`${thuis}${h}`} class="flex items-center justify-between py-4 font-[family-name:var(--font-kop)] text-2xl font-extrabold tracking-[-.02em]" data-menu-link>{t}<Icoon naam="pijl" class="h-5 w-5 text-rood" /></a></li>)}
      </ul>
      <p class="grid gap-3">
        <a href={waMet('ik heb een vraag over een dekvloer. ')} class="knop knop-rood w-full"><Icoon naam="wa" />Stuur een WhatsApp</a>
        <a href={site.telHref} class="knop knop-rand num w-full"><Icoon naam="tel" />Bel {site.tel}</a>
      </p>
    </nav>
  </div>
</header>

<style>
  .kop { color: var(--color-inkt); background: color-mix(in srgb, var(--color-wit) 96%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: background-color .4s var(--ease-zacht), color .4s var(--ease-zacht), box-shadow .4s var(--ease-zacht); }
  .kop.schaduw { box-shadow: 0 1px 0 var(--color-lijn), 0 8px 24px -16px #16151340; }
  .woordmerk { font-family: var(--font-kop); font-weight: 600; font-stretch: 125%; font-size: 1.125rem; letter-spacing: .28em; margin-right: -.28em; }
  .navlink { position: relative; padding-block: .4rem; }
  .navlink::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--color-rood); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease-zacht); }
  .navlink:hover::after { transform: scaleX(1); }

  .kop.over-beeld { margin-bottom: -4.5rem; }
  @media (min-width: 1024px) { .kop.over-beeld { margin-bottom: -5rem; } }
  .kop.over-beeld:not(.vast):not(.open) { background: transparent; color: var(--color-wit); backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: none; }
  .kop.over-beeld:not(.vast):not(.open) .knop-rand { border-color: #ffffff70; }
  .kop.over-beeld:not(.vast):not(.open) .knop-rand:hover { background: var(--color-wit); color: var(--color-inkt); }
  .kop.over-beeld:not(.vast):not(.open) .navlink::after { background: var(--color-wit); }
  .kop.over-beeld:not(.vast):not(.open) :focus-visible { outline-color: var(--color-wit); }

  .streepjes { display: grid; gap: 5px; width: 22px; }
  .streepjes span { height: 2px; background: currentColor; border-radius: 2px; transition: transform .3s var(--ease-zacht), opacity .3s; }
  .open .streepjes span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .open .streepjes span:nth-child(2) { opacity: 0; }
  .open .streepjes span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .menu { position: fixed; left: 0; right: 0; bottom: 0; top: 4.5rem; background: var(--color-wit); color: var(--color-inkt); overflow-y: auto; }
</style>

<script>
  const kop = document.querySelector<HTMLElement>('[data-kop]')!;
  const beeld = document.querySelector<HTMLElement>('[data-beeld]');
  const zet = () => {
    kop.classList.toggle('schaduw', scrollY > 8);
    if (beeld) kop.classList.toggle('vast', beeld.getBoundingClientRect().bottom <= kop.offsetHeight + 1);
  };
  zet(); addEventListener('scroll', zet, { passive: true }); addEventListener('resize', zet);
  const knop = kop.querySelector<HTMLButtonElement>('[data-menu-knop]')!;
  const menu = kop.querySelector<HTMLElement>('[data-menu]')!;
  const open = (aan: boolean) => {
    menu.style.top = kop.getBoundingClientRect().bottom + 'px';
    menu.hidden = !aan;
    kop.classList.toggle('open', aan);
    knop.setAttribute('aria-expanded', String(aan));
    knop.setAttribute('aria-label', aan ? 'Menu sluiten' : 'Menu openen');
    document.documentElement.style.overflow = aan ? 'hidden' : '';
  };
  knop.addEventListener('click', () => open(menu.hidden));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => open(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { open(false); knop.focus(); } });
</script>
