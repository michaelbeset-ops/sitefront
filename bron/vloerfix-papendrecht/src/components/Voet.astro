---
import { site, url, waMet, tijden, tijdTekst } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const week = [...tijden.slice(1), tijden[0]];
---
<!-- Slotbalk in merkkleur -->
<section class="bg-rood text-wit" aria-label="Advies aanvragen">
  <div class="wrap flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between lg:py-12">
    <p class="max-w-3xl font-[family-name:var(--font-kop)] text-2xl font-extrabold leading-tight tracking-[-.02em] [font-stretch:112%] lg:text-[2.5rem]">Vrijblijvend advies of een prijs voor uw dekvloer?</p>
    <a href={waMet('ik wil graag advies of een prijs voor een dekvloer. Het gaat om ')} class="knop knop-wit shrink-0 self-start md:self-auto"><Icoon naam="wa" class="h-5 w-5 text-rood" />Stuur een WhatsApp</a>
  </div>
</section>

<footer class="donker bg-antraciet text-licht-zacht">
  <div class="wrap grid gap-12 py-16 text-sm sm:grid-cols-2 lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="lg:col-span-4">
      <a href={url('')} class="flex items-center gap-3 text-licht">
        <Merk class="h-10 w-auto" />
        <span class="voetwoord">VLOERFIX</span>
      </a>
      <p class="mt-6 max-w-xs leading-relaxed">Een klein bedrijf uit Papendrecht, gespecialiseerd in zandcement dekvloeren en het egaliseren van bestaande vloeren. Voor aannemers en particulieren.</p>
    </div>
    <div class="lg:col-span-2">
      <p class="voetkop">Diensten</p>
      <ul class="mt-4 space-y-2.5">
        <li><a href={url('#diensten')} class="hover:text-licht">Zandcement dekvloer</a></li>
        <li><a href={url('#diensten')} class="hover:text-licht">Op vloerverwarming</a></li>
        <li><a href={url('#diensten')} class="hover:text-licht">Over vloerverwarming</a></li>
        <li><a href={url('#diensten')} class="hover:text-licht">Egaliseren</a></li>
        <li><a href={url('#werkgebied')} class="hover:text-licht">Werkgebied</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="voetkop">Contact</p>
      <ul class="mt-4 space-y-2.5">
        <li><a href={site.telHref} class="num hover:text-licht">{site.tel}</a> <span class="text-xs">(ook WhatsApp)</span></li>
        <li><a href={`mailto:${site.mail}`} class="hover:text-licht">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.route} class="inline-flex items-center gap-1.5 text-licht hover:text-rood-licht">Route plannen <Icoon naam="pijl" class="h-4 w-4" /></a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="voetkop">Openingstijden</p>
      <dl class="num mt-4 grid grid-cols-[3.5rem_1fr] gap-y-1.5">
        {week.map((t) => (<><dt>{t.dag.slice(0, 2)}</dt><dd>{t.open ? `${tijdTekst(t.open)} tot ${tijdTekst(t.dicht!)}` : 'Gesloten'}</dd></>))}
      </dl>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-6 text-xs">
    <p class="num">© {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p><a href={url('privacy/')} class="underline underline-offset-2 hover:text-licht">Privacyverklaring</a></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs">Werkfoto's van vloerfix.nl (eigen archief van Vloerfix), teksten en gegevens van die website en het Google-bedrijfsprofiel. De openingsfoto is gespiegeld voor de leesbaarheid.</p>}
</footer>

<style>
  .voetkop { font-family: var(--font-kop); font-weight: 700; font-stretch: 112%; font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--color-licht); }
  .voetwoord { font-family: var(--font-kop); font-weight: 600; font-stretch: 125%; font-size: 1.25rem; letter-spacing: .28em; }
</style>
