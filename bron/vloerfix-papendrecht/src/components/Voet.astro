---
import { site, url, waMet } from '../data/site';
import Merk from './Merk.astro';
---
<footer id="contact" class="donker scroll-mt-20 bg-antraciet text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-y-16 pb-20 pt-28 lg:grid-cols-12 lg:gap-x-8 lg:pb-28 lg:pt-40">
    <div class="lg:col-span-6">
      <h2 id="t-contact" class="text-3xl">Vrijblijvend advies of een prijsopgave.</h2>
      <p class="mt-8 max-w-[30rem] text-lg leading-relaxed text-licht-zacht">Voor meer informatie, advies of een prijs kunt u Vloerfix bellen, appen of mailen.</p>
      <p class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={waMet('ik wil graag advies over een dekvloer. Het gaat om ')} class="knop knop-licht">Stuur een WhatsApp</a>
        <a href={site.telHref} class="ui num lijn whitespace-nowrap">Bel {site.tel}</a>
      </p>
    </div>

    <div class="grid grid-cols-2 gap-x-8 gap-y-10 text-[.9375rem] lg:col-span-5 lg:col-start-8 lg:self-end">
      <div>
        <p class="ui text-licht-zacht">Bellen en WhatsApp</p>
        <p class="mt-3"><a href={site.telHref} class="lijn num whitespace-nowrap">{site.tel}</a></p>
      </div>
      <div>
        <p class="ui text-licht-zacht">Adres</p>
        <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
        <a href={site.maps} class="lijn mt-3 inline-block text-licht-zacht">Kaart ↗</a>
      </div>
      <div>
        <p class="ui text-licht-zacht">Mail</p>
        <p class="mt-3"><a href={`mailto:${site.mail}`} class="lijn [overflow-wrap:anywhere]">{site.mail}</a></p>
      </div>
      <div>
        <p class="ui text-licht-zacht">Open</p>
        <p class="num mt-3">Vrijdag 10.00 tot 16.00 uur</p>
        <p class="mt-2 text-xs text-licht-zacht">Andere dag? Bel of app even.</p>
      </div>
      <div class="col-span-2 border-t border-lijn-licht pt-8">
        <p class="ui text-licht-zacht">Werkgebied</p>
        <p class="mt-3">Vanuit Papendrecht in Zuid-Holland, Utrecht, Noord-Brabant en Zeeland.</p>
      </div>
    </div>
  </div>

  <div class="wrap flex items-end gap-[2.4vw] overflow-hidden pb-10" aria-hidden="true">
    <Merk class="voetmerk-teken shrink-0 text-licht-zacht" />
    <p class="voetmerk woordmerk">VLOERFIX</p>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p class="num">{site.naam}, {site.plaats}. KvK {site.kvk}. {site.google} op Google, uit {site.googleAantal} reviews.</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={url('privacy/')} class="lijn-in">Privacyverklaring</a>
    </p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Alle foto's zijn van {site.naam} zelf: de werkfoto's van vloerfix.nl en de dekvloer bovenaan van het Google-bedrijfsprofiel. Teksten en gegevens van die website en dat profiel.</p>}
</footer>

<style>
  .voetmerk { font-size: clamp(2.4rem, 12.2vw, 12.25rem); font-weight: 200; letter-spacing: .16em; margin-right: -.16em; line-height: .76; }
  :global(.voetmerk-teken) { height: clamp(2rem, 9.6vw, 9.6rem); width: auto; }
</style>
