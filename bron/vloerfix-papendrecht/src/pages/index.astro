---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import laser from '../assets/laser.jpg';
import slang from '../assets/slang.jpg';
import uitvlakken from '../assets/uitvlakken.jpg';
import afgewerkt from '../assets/afgewerkt.jpg';
import mixer from '../assets/mixer.jpg';

const diensten = [
  ['Zandcement dekvloeren', 'Een verharde uitvlaklaag op de ruwe draagvloer van beton. Daarop komt de vloer die u kiest.'],
  ['Op en over vloerverwarming', 'Een cementdekvloer op of over de vloerverwarming, met isolatie in de opbouw als dat nodig is.'],
  ['Egaliseren', 'Bestaande vloeren egaliseren, zodat de nieuwe vloer er strak op komt te liggen.'],
];

const reeks = [
  { src: laser, alt: 'Een oranje rotatielaser op een statief, boven de vloerverwarmingsbuizen in een lege woonkamer.', tekst: 'De laser zet de hoogte uit, boven de vloerverwarming.', cls: 'lg:col-span-3' },
  { src: slang, alt: 'De slang van de pomp boven een berg zandcement in een keuken.', tekst: 'Het zandcement komt via de slang naar binnen.', cls: 'lg:col-span-3 lg:mt-16' },
  { src: uitvlakken, alt: 'Een half afgewerkte dekvloer met een geleider, de achterkamer is al strak.', tekst: 'Baan voor baan strak getrokken.', cls: 'lg:col-span-3 lg:mt-32' },
  { src: afgewerkt, alt: 'De afgewerkte dekvloer door de hele kamer, tot aan de openslaande deuren.', tekst: 'Klaar voor tegels, parket of laminaat.', cls: 'lg:col-span-3 lg:mt-48' },
];

const over = [
  ['Ervaring', 'Meer dan 25 jaar, met zandcement dekvloeren en egaliseren.'],
  ['Klanten', 'Aannemers en particulieren.'],
  ['Afspraken', 'Wij komen afspraken na.'],
  ['Werk', 'Zorgvuldig en nauwkeurig.'],
  ['Materiaal', 'Hoogwaardig materiaal, met specialistische technieken.'],
];
---
<Base title="Vloerfix | Zandcement dekvloeren en egaliseren, Papendrecht" description="Vloerfix uit Papendrecht legt zandcement dekvloeren, ook op vloerverwarming, en egaliseert bestaande vloeren. Voor aannemers en particulieren, met meer dan 25 jaar ervaring.">
  <Kop overBeeld />
  <main id="inhoud">

    <!-- 1. Eerste scherm: hun eigen dekvloer over de volle breedte en hoogte, kop en één actie erop. -->
    <section class="hero donker relative isolate flex flex-col justify-end overflow-hidden bg-antraciet text-licht" aria-labelledby="titel" data-beeld>
      <Image src={hero} alt="" widths={[640, 960, 1300]} sizes="100vw" format="webp" quality={74} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[60%_50%]" />
      <div class="hero-waas absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="wrap grid gap-y-10 pb-10 pt-32 md:pb-16 lg:grid-cols-12 lg:gap-x-8 lg:pb-20">
        <div class="lg:col-span-8">
          <h1 id="titel" class="text-4xl">Zandcement dekvloeren en egaliseren.</h1>
          <p class="mt-6 max-w-[34rem] leading-relaxed text-licht/85 md:mt-9 md:text-lg">Vloerfix is een klein bedrijf uit Papendrecht. Wim de Man en Cock Vielvoije leggen dekvloeren voor aannemers en particulieren, met meer dan 25 jaar ervaring.</p>
          <p class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5 md:mt-11">
            <a href={waMet('ik wil graag advies over een dekvloer. Het gaat om ')} class="knop knop-licht">Vraag advies via WhatsApp</a>
            <a href={site.telHref} class="ui num lijn whitespace-nowrap">Bel {site.tel}</a>
          </p>
        </div>
        <p class="ui hidden self-end text-right text-licht/75 lg:col-span-4 lg:block">Zandcement dekvloer</p>
      </div>
    </section>

    <!-- 2. Wat ze doen: rustige tekst naast een lijst met haarlijnen. -->
    <section id="diensten" class="wrap scroll-mt-20 py-28 lg:py-40" aria-labelledby="t-diensten">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-8">
        <h2 id="t-diensten" class="text-3xl lg:col-span-5">Een goede dekvloer is een vak apart.</h2>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="text-lg leading-relaxed text-grijs">De juiste verhouding tussen zand en cement, en een goede afwerking, bepalen hoe lang de vloer meegaat en wat u ermee kunt. Op de dekvloer komt de uiteindelijke vloer: tegels, parket, laminaat of een gietvloer.</p>
          <ul class="mt-14 border-t border-lijn">
            {diensten.map(([t, d]) => (
              <li class="grid gap-y-2 border-b border-lijn py-8 md:grid-cols-[14rem_1fr] md:gap-x-8">
                <h3 class="text-xl">{t}</h3>
                <p class="text-grijs">{d}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. Werkwijze in hun eigen foto's: van draagvloer tot dekvloer, als een aflopende reeks. -->
    <section id="werkwijze" class="scroll-mt-20 bg-wit py-28 lg:py-40" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-8">
          <h2 id="t-werk" class="text-3xl lg:col-span-6">Van draagvloer tot dekvloer.</h2>
          <p class="max-w-[30rem] text-grijs lg:col-span-4 lg:col-start-9 lg:self-end">Eén woonkamer, vier momenten. Foto's uit het eigen archief van Vloerfix.</p>
        </div>
        <ol class="reeks mt-16 grid grid-cols-2 gap-x-4 gap-y-12 md:gap-x-8 lg:mt-24 lg:grid-cols-12">
          {reeks.map((r, i) => (
            <li class={r.cls}>
              <figure>
                <div class="aspect-[3/4] overflow-hidden bg-steen">
                  <Image src={r.src} alt={r.alt} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 23vw, 50vw" format="webp" quality={70} class="foto-zw h-full w-full object-cover" />
                </div>
                <figcaption class="mt-4 grid grid-cols-[1.75rem_1fr] text-sm leading-relaxed">
                  <span class="num text-grijs">{i + 1}</span>
                  <span>{r.tekst}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4. Over: het eigen zwart-witbeeld van de mixer op straat, daaronder wie ze zijn. -->
    <section id="over" class="scroll-mt-20 pb-28 lg:pb-40" aria-labelledby="t-over">
      <figure class="over-beeld overflow-hidden bg-steen">
        <Image src={mixer} alt="Zwart-witfoto: de mixer, emmers en een berg zand op straat voor een rij huizen." widths={[640, 1000, 1400, 1900]} sizes="100vw" format="webp" quality={70} class="h-full w-full object-cover object-[35%_60%]" />
      </figure>
      <div class="wrap mt-20 grid gap-y-12 lg:mt-28 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-5">
          <h2 id="t-over" class="text-3xl">Wim de Man en Cock Vielvoije.</h2>
          <p class="mt-8 max-w-[28rem] text-lg leading-relaxed text-grijs">Samen zijn zij Vloerfix: een klein bedrijf, gespecialiseerd in het leggen van zandcement dekvloeren en het egaliseren van bestaande vloeren.</p>
        </div>
        <dl class="border-t border-lijn lg:col-span-6 lg:col-start-7">
          {over.map(([k, v]) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-x-5 border-b border-lijn py-5 md:grid-cols-[10rem_1fr]">
              <dt class="ui pt-1 text-grijs">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 5. Uw vloer: hun eigen lijst met gegevens voor een passend advies, als bericht naar WhatsApp. -->
    <section id="uw-vloer" class="scroll-mt-20 border-t border-lijn bg-wit py-28 lg:py-40" aria-labelledby="t-vloer">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-4">
          <h2 id="t-vloer" class="text-3xl">Wat Vloerfix van uw vloer wil weten.</h2>
          <p class="mt-8 max-w-[24rem] text-grijs">Om tot een passend advies te komen zijn deze gegevens nodig. Vul in wat u weet en stuur het als WhatsApp.</p>
        </div>
        <form class="vloer lg:col-span-7 lg:col-start-6" data-vloer novalidate>
          <div class="rij">
            <label for="v-m2" class="ui">Oppervlakte</label>
            <div class="veld-eenheid"><input id="v-m2" name="Oppervlakte" inputmode="decimal" autocomplete="off" placeholder="bijv. 45" data-eenheid="m²" /><span aria-hidden="true">m²</span></div>
          </div>
          <div class="rij">
            <label for="v-dikte" class="ui">Dikte</label>
            <div class="veld-eenheid"><input id="v-dikte" name="Gemiddelde dikte" inputmode="decimal" autocomplete="off" placeholder="gemiddeld, of per ruimte" data-eenheid="cm" /><span aria-hidden="true">cm</span></div>
          </div>
          <div class="rij">
            <label for="v-onder" class="ui">Ondergrond</label>
            <input id="v-onder" name="Ondergrond" autocomplete="off" placeholder="bijv. beton" />
          </div>
          <div class="rij" role="group" aria-labelledby="g1">
            <p id="g1" class="ui">Vloeropbouw</p>
            <div class="keuzes">
              <label><input type="checkbox" name="Vloeropbouw" value="isolatie" /><span>Isolatie</span></label>
              <label><input type="checkbox" name="Vloeropbouw" value="vloerverwarming" /><span>Vloerverwarming</span></label>
            </div>
          </div>
          <div class="rij" role="group" aria-labelledby="g2">
            <p id="g2" class="ui">Afwerking</p>
            <div class="keuzes">
              {['Tegels', 'Parket', 'Laminaat', 'Gietvloer'].map((a) => <label><input type="radio" name="Vloerafwerking" value={a.toLowerCase()} /><span>{a}</span></label>)}
            </div>
          </div>
          <div class="rij" role="group" aria-labelledby="g3">
            <p id="g3" class="ui">Gebruik</p>
            <div class="keuzes">
              {['Begane grond woonhuis', 'Garage', 'Badkamer 1e verdieping'].map((a) => <label><input type="radio" name="Gebruik" value={a.toLowerCase()} /><span>{a}</span></label>)}
            </div>
          </div>
          <div class="rij" role="group" aria-labelledby="g4">
            <p id="g4" class="ui">Wensen</p>
            <div class="keuzes">
              <label><input type="checkbox" name="Speciale wensen" value="slijtlaag" /><span>Slijtlaag</span></label>
              <label><input type="checkbox" name="Speciale wensen" value="pleisteren" /><span>Pleisteren</span></label>
            </div>
          </div>
          <div class="rij">
            <label for="v-plaats" class="ui">Locatie</label>
            <input id="v-plaats" name="Locatie" autocomplete="address-level2" placeholder="plaats, en hoe bereikbaar" />
          </div>
          <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-5">
            <a href={waMet('ik wil graag advies over een dekvloer.')} class="knop knop-vol" data-vloer-wa>Stuur via WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="ui lijn" data-vloer-mail>Of per mail</a>
          </div>
          <p class="mt-6 text-sm text-grijs" aria-live="polite" data-vloer-teller>Nog niets ingevuld. Een leeg bericht mag ook.</p>
        </form>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<style>
  .hero { min-height: calc(100svh - var(--balk, 0px)); }
  .hero-waas { background:
    linear-gradient(to top, rgb(20 20 18 / .8) 0%, rgb(20 20 18 / .5) 45%, rgb(20 20 18 / .15) 75%, rgb(20 20 18 / .35) 100%); }
  @media (min-width: 1024px) {
    .hero-waas { background:
      linear-gradient(to top, rgb(20 20 18 / .72) 0%, rgb(20 20 18 / .3) 45%, rgb(20 20 18 / 0) 75%, rgb(20 20 18 / .3) 100%),
      linear-gradient(to right, rgb(20 20 18 / .3), transparent 60%); }
  }
  .over-beeld { aspect-ratio: 4 / 3; }
  @media (min-width: 768px) { .over-beeld { aspect-ratio: 1907 / 877; } }

  /* Oude telefoonfoto's: allemaal zwart-wit, zodat de reeks één geheel is; in kleur bij aanwijzen. */
  :global(.foto-zw) { filter: grayscale(1) contrast(1.08) brightness(1.04); transition: filter .8s var(--ease-zacht), transform 1.2s var(--ease-zacht); }
  .reeks figure:hover :global(.foto-zw) { filter: grayscale(0) contrast(1) brightness(1); }

  .vloer { border-top: 1px solid var(--color-lijn); }
  .rij { display: grid; gap: .6rem 2rem; padding: 1.35rem 0; border-bottom: 1px solid var(--color-lijn); }
  @media (min-width: 768px) { .rij { grid-template-columns: 9.5rem 1fr; align-items: center; } }
  .rij > .ui { color: var(--color-grijs); }
  .rij input:not([type]), .veld-eenheid input { width: 100%; min-width: 0; background: transparent; border: 0; border-bottom: 1px solid transparent; padding: .35rem 0; font: inherit; color: var(--color-inkt); transition: border-color .3s var(--ease-zacht); }
  .rij input:not([type])::placeholder, .veld-eenheid input::placeholder { color: #8a8780; }
  .rij input:not([type]):focus, .veld-eenheid input:focus { outline: none; border-bottom-color: var(--color-inkt); }
  .veld-eenheid { display: flex; align-items: baseline; gap: .75rem; }
  .veld-eenheid span { color: var(--color-grijs); font-size: var(--text-sm); }
  .keuzes { display: flex; flex-wrap: wrap; gap: .5rem; }
  .keuzes label { position: relative; cursor: pointer; }
  .keuzes input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .keuzes span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border: 1px solid var(--color-lijn); font-size: var(--text-sm); transition: background-color .35s var(--ease-zacht), color .35s var(--ease-zacht), border-color .35s var(--ease-zacht); }
  .keuzes label:hover span { border-color: var(--color-inkt); }
  .keuzes input:checked + span { background: var(--color-inkt); color: var(--color-papier); border-color: var(--color-inkt); }
  .keuzes input:focus-visible + span { outline: 2px solid var(--color-inkt); outline-offset: 3px; }
</style>

<script>
  // Zet de ingevulde gegevens om in een kort WhatsApp- en mailbericht.
  const form = document.querySelector<HTMLFormElement>('[data-vloer]')!;
  const wa = form.querySelector<HTMLAnchorElement>('[data-vloer-wa]')!;
  const mail = form.querySelector<HTMLAnchorElement>('[data-vloer-mail]')!;
  const teller = form.querySelector<HTMLElement>('[data-vloer-teller]')!;
  const basisWa = wa.href.split('?')[0];
  const basisMail = mail.href.split('?')[0];
  const maak = () => {
    const regels: string[] = [];
    const velden = new Map<string, string[]>();
    form.querySelectorAll<HTMLInputElement>('input').forEach((i) => {
      const v = i.value.trim();
      if (!v || ((i.type === 'checkbox' || i.type === 'radio') && !i.checked)) return;
      const e = i.dataset.eenheid ? ` ${i.dataset.eenheid}` : '';
      velden.set(i.name, [...(velden.get(i.name) ?? []), v + e]);
    });
    velden.forEach((v, k) => regels.push(`${k}: ${v.join(' en ')}`));
    const tekst = 'Hallo Vloerfix, ik wil graag advies over een dekvloer.' + (regels.length ? '\n\n' + regels.join('\n') : '');
    wa.href = `${basisWa}?text=${encodeURIComponent(tekst)}`;
    mail.href = `${basisMail}?subject=${encodeURIComponent('Advies dekvloer')}&body=${encodeURIComponent(tekst + '\n\nMet vriendelijke groet,\n')}`;
    teller.textContent = regels.length ? `${regels.length} van de 8 gegevens ingevuld.` : 'Nog niets ingevuld. Een leeg bericht mag ook.';
  };
  form.addEventListener('input', maak);
  form.addEventListener('change', maak);
  form.addEventListener('submit', (e) => e.preventDefault());
  maak();
</script>
