---
import { site, url, tijden, uur, waOfferte } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
const diensten = ['Buitenschilderwerk', 'Binnenschilderwerk', 'Deuren en kozijnen', 'Trappen', 'Onderhoud', 'Nieuwbouw en verbouwing'];
---
<footer class="donker bg-inkt text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-4">
      <a href={url('')} class="merk text-licht"><b>RADI</b><small>Schilderwerken<br />Drechtsteden</small></a>
      <p class="mt-7 max-w-xs">Binnen- en buitenschilderwerk, onderhoud en kleuradvies. Vanuit {site.plaats}, in de hele {site.werkgebied}.</p>
      <a href={waOfferte} class="knop knop-groen knop-klein mt-7">Offerte aanvragen</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Diensten</p>
      <ul class="mt-4 space-y-2">
        {diensten.map((c) => <li><a href={h('diensten')} class="no-underline transition-colors hover:text-groen">{c}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-groen">{site.tel}</a></li>
        <li><a href={waOfferte} class="no-underline transition-colors hover:text-groen">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="no-underline transition-colors hover:text-groen">E-mail</a></li>
        <li>{site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-semibold text-licht">Bereikbaar</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Bereikbaarheid</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-semibold data-[vandaag]:text-groen">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{uur(t.van)} - {uur(t.tot)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-groen">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van uw Google-bedrijfsprofiel, ter illustratie. Reviews letterlijk van Google (stand 2 oktober 2026); de referentie van Fam. Mulders komt van uw vorige website.</p>}
  </div>
</footer>
