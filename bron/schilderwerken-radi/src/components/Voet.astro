---
import { site, tijden, url, waMet } from '../data/site';
---
<footer id="contact" class="donker scroll-mt-20 bg-antraciet text-licht" aria-labelledby="t-contact">
  <div class="wrap grid gap-y-16 pb-20 pt-28 lg:grid-cols-12 lg:gap-x-8 lg:pb-28 lg:pt-40">
    <div class="lg:col-span-6">
      <h2 id="t-contact" class="text-3xl">Vraag vrijblijvend een offerte aan.</h2>
      <p class="mt-8 max-w-[30rem] text-lg leading-relaxed text-licht-zacht">Stuur een appje met wat er geschilderd moet worden, of bel direct.</p>
      <p class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={waMet('ik wil graag een offerte voor schilderwerk. Het gaat om ')} class="knop knop-licht">Stuur een WhatsApp</a>
        <a href={site.telHref} class="ui num lijn whitespace-nowrap">Bel {site.tel}</a>
      </p>
    </div>

    <div class="grid grid-cols-1 gap-x-8 gap-y-10 text-[.9375rem] sm:grid-cols-2 lg:col-span-5 lg:col-start-8 lg:self-end">
      <div>
        <p class="ui text-licht-zacht">Bellen en WhatsApp</p>
        <p class="mt-3"><a href={site.telHref} class="lijn num whitespace-nowrap">{site.tel}</a></p>
      </div>
      <div>
        <p class="ui text-licht-zacht">Mail</p>
        <p class="mt-3"><a href={`mailto:${site.mail}`} class="lijn [overflow-wrap:anywhere]">{site.mail}</a></p>
      </div>
      <div class="sm:col-span-2">
        <p class="ui text-licht-zacht">Bereikbaar</p>
        <dl class="mt-3 space-y-1">
          {tijden.map(([d, t]) => (
            <div class="flex flex-wrap justify-between gap-x-6 border-b border-lijn-licht pb-2">
              <dt>{d}</dt>
              <dd class="num whitespace-nowrap text-licht-zacht">{t} uur</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="sm:col-span-2">
        <p class="ui text-licht-zacht">Werkgebied</p>
        <p class="mt-3">Vanuit {site.plaats} in de {site.werkgebied}: Dordrecht en omgeving.</p>
      </div>
    </div>
  </div>

  <div class="wrap overflow-hidden pb-10" aria-hidden="true">
    <p class="voetmerk woordmerk">RADI<span class="text-groen">.</span></p>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-lijn-licht py-7 text-xs text-licht-zacht">
    <p class="num">{site.naam}, {site.plaats}. {site.google} op Google, uit {site.googleAantal} reviews.</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2">
      <a href={url('privacy/')} class="lijn-in">Privacyverklaring</a>
    </p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs text-licht-zacht">Alle foto's zijn van {site.kort} zelf, van het Google-bedrijfsprofiel. Teksten en gegevens van de vorige website en dat profiel.</p>}
</footer>

<style>
  .voetmerk { font-size: clamp(4rem, 24vw, 22rem); font-weight: 300; letter-spacing: .12em; margin-right: -.12em; line-height: .76; margin-left: -.04em; }
</style>
