  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: var(--color-groen); box-shadow: 0 0 0 4px #7cc83e40; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: var(--radius-sm); background: var(--color-kalk); }
  .status-pil .status-stip { background: var(--color-grijs); }
  .status-pil[data-open='true'] .status-stip { background: var(--color-groen-diep); box-shadow: 0 0 0 4px #3a741926; }

  .vn-voor { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .vn-lijn { left: var(--pos); }
  .vn-schuif:focus-visible ~ .vn-lijn span, .vn:has(.vn-schuif:focus-visible) .vn-lijn span { outline: 3px solid #fff; outline-offset: 2px; }

  @media (min-width: 1024px) {
    .stappen > li + li { box-shadow: var(--shadow-sm); outline-offset: -1px; }
    .stappen > li + li::before { content: ''; position: absolute; left: -1px; top: 1.5rem; bottom: 1.5rem; width: 1px; background: var(--color-lijn); }
  }

  .keuze span { display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 1rem; border-radius: var(--radius-md); background: var(--color-kalk); font-size: .9375rem; font-weight: 600; cursor: pointer; transition: background-color .2s, color .2s; }
  .keuze span:hover { background: #dcdcd5; }
  .keuze input:checked + span { background: var(--color-groen); color: var(--color-inkt); }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-groen-diep); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-md); border: 1.5px solid #1d212533; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #1d212566; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-groen-diep); }
  .veld::placeholder { color: #7a8187; }
</style>
