---
// Woordmerk naar hun eigen advertentiebeeld (bron/mp/img/mp036.jpg): HET HANDELSHUIS in kapitalen met KAATSHEUVEL eronder.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`inline-flex flex-col no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span class="font-kop text-[1.3rem] font-black uppercase leading-none tracking-[-.02em] sm:text-[1.5rem]">Het Handelshuis</span>
  <span class="mt-1.5 flex items-center gap-2 text-[.62rem] font-bold uppercase leading-none tracking-[.42em] text-merk-licht sm:text-[.68rem]"><span class="h-px w-5 bg-current" aria-hidden="true"></span> Kaatsheuvel</span>
</a>
