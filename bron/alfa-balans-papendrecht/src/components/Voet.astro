---
import { site, url } from '../data/site';
---
<footer class="bg-bos text-linnen/80">
  <div class="wrap grid gap-10 py-14 text-sm md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-kop text-3xl text-linnen">Alfa Balans</p>
      <p class="mt-2 font-kop text-lg italic text-kurkuma-licht">{site.motto}</p>
    </div>
    <div>
      <p>{site.straat}<br />{site.postcode} {site.plaats}<br />In {site.plek}</p>
    </div>
    <div class="grid content-start gap-1">
      <a class="hover:text-linnen" href={site.mobielHref}>{site.mobiel}</a>
      <a class="hover:text-linnen" href={`mailto:${site.mail}`}>{site.mail}</a>
      <a class="hover:text-linnen" href={`https://www.instagram.com/${site.instagram}/`}>Instagram</a>
    </div>
  </div>
  <div class="wrap flex flex-wrap justify-between gap-3 border-t border-linnen/15 py-6 text-xs">
    <p>&copy; 2026 {site.naam}</p>
    <a class="underline underline-offset-2 hover:text-linnen" href={url('privacy/')}>Privacyverklaring</a>
  </div>
</footer>
