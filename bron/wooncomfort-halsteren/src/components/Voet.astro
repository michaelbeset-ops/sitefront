---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const aanbod = ['Solar screens', 'Rolluiken', 'Horren en hordeuren', 'Plisse en raamdecoratie', 'Overkappingen', "Airco's"];
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Airco, rolluiken, screens, horren en raamdecoratie op maat. Comfort, isolatie &amp; energiebesparing.</p>
      <p class="mt-5 flex gap-3">
        <a href={site.instagram} class="grid h-10 w-10 place-items-center rounded-full border border-lijn-licht text-wit transition-colors hover:border-zon hover:text-zon" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
        <a href={site.facebook} class="grid h-10 w-10 place-items-center rounded-full border border-lijn-licht text-wit transition-colors hover:border-zon hover:text-zon" aria-label="Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Aanbod</p>
      <ul class="mt-3 space-y-1">{aanbod.map((p) => <li><a href={url('#aanbod')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.plaats}</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Tijden</p>
      <ul class="num mt-3 space-y-0.5">
        <li class="flex justify-between gap-4"><span>ma t/m vr</span><span>{tijden[0][1]}</span></li>
        <li class="flex justify-between gap-4"><span>zaterdag</span><span>{tijden[5][1]}</span></li>
        <li class="flex justify-between gap-4"><span>zondag</span><span>{tijden[6][1]}</span></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam} · <span class="num">{site.google.score}</span> op Google uit {site.google.aantal} reviews</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's komen van jullie eigen Instagram. Teksten uit jullie Instagram en Facebook, reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
