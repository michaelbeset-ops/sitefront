---
// Woordmerk naar hun eigen logo: een dak met een raampje van vier ruitjes en een zon erachter, eronder WOONCOMFORT / HALSTEREN.
import { url } from '../data/site';
interface Props { licht?: boolean; erf?: boolean; class?: string }
const { licht = false, erf = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['group inline-flex items-center gap-3 no-underline', erf ? '' : licht ? 'text-wit' : 'text-inkt', cls]}>
  <svg viewBox="0 0 48 40" class="h-9 w-auto flex-none" aria-hidden="true">
    <g class="text-zon transition-transform duration-700 group-hover:rotate-[20deg]" style="transform-origin: 35px 14px" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
      <path d="M35 3.5v3M43.5 7l-2.2 2.2M46 15h-3M26.5 7l2.2 2.2" />
    </g>
    <path d="M30 14.5a5.2 5.2 0 0 1 9.6 3" fill="none" stroke="currentColor" class="text-zon" stroke-width="2.4" />
    <path d="M3 35 21 13l18 22" fill="none" stroke="currentColor" stroke-width="4.2" stroke-linejoin="miter" />
    <path d="M28 21.6 37.5 33" fill="none" stroke="currentColor" stroke-width="4.2" />
    <g fill="currentColor"><rect x="17" y="22" width="3.4" height="3.4" rx=".5" /><rect x="21.6" y="22" width="3.4" height="3.4" rx=".5" /><rect x="17" y="26.6" width="3.4" height="3.4" rx=".5" /><rect x="21.6" y="26.6" width="3.4" height="3.4" rx=".5" /></g>
  </svg>
  <span class="flex flex-col leading-none">
    <span class="text-[1.06rem] font-[820] tracking-[.02em]">WOONCOMFORT</span>
    <span class:list={['mt-1 text-[.6rem] font-bold tracking-[.42em]', erf ? 'opacity-75' : licht ? 'text-mist' : 'text-grijs']}>HALSTEREN</span>
  </span>
</a>
