---
// Plisse-vouw: een zigzaglijn zoals de geplooide stof van hun plisse, als scheiding. Vouwt open bij in beeld komen.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const pad = (n: number) => 'M0 12 ' + Array.from({ length: n }, (_, i) => `L${(i + 0.5) * (1000 / n)} ${i % 2 ? 22 : 2} L${(i + 1) * (1000 / n)} 12`).join(' ');
---
<div class={cls} aria-hidden="true">
  <svg class="vouw rijs md:!hidden" viewBox="0 0 1000 24" preserveAspectRatio="none"><path d={pad(22)} /></svg>
  <svg class="vouw rijs max-md:!hidden" viewBox="0 0 1000 24" preserveAspectRatio="none"><path d={pad(64)} /></svg>
</div>
