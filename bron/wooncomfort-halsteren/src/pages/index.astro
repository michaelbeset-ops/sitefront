---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Vouw from '../components/Vouw.astro';
import { site, reviews, tijden, waHoi } from '../data/site';

import hero from '../assets/hero.jpg';
import screenGarage from '../assets/solar-screen-garage.jpg';
import screenVierde from '../assets/solar-screen-vierde.jpg';
import solarRolluik from '../assets/solar-rolluik.jpg';
import screensTholen from '../assets/solar-screens-tholen.jpg';
import hordeur from '../assets/hordeur-schuifpui.jpg';
import hordeurSmal from '../assets/hordeur-smal.jpg';
import plisse from '../assets/plisse.jpg';
import plisseStof from '../assets/plisse-stof.jpg';
import veranda from '../assets/veranda-zonwering.jpg';
import polycarbonaat from '../assets/polycarbonaat.jpg';
import aircoChalet from '../assets/airco-chalet.jpg';
import aircoBinnen from '../assets/airco-binnen.jpg';

const titel = 'Wooncomfort Halsteren | Zonwering, rolluiken, horren en airco op maat';
const omschrijving = "Solar screens, rolluiken, hordeuren, plisse, overkappingen en airco's op maat. Wooncomfort Halsteren adviseert, levert en monteert.";

// Productkeuzes voor de offertezin: alleen wat ze zelf op Instagram/Facebook laten zien.
const producten = ['solar screens', 'screens', 'rolluiken', 'een solar rolluik', 'een hordeur', 'een hor', 'Splendid Plissé', 'een overkapping', 'een nieuw dak op mijn overkapping', 'veranda zonwering', 'een airco'];
const plekken = ['het raam', 'de schuifpui of deur', 'de gevel', 'het balkon', 'het terras', 'binnen'];
const [judith, ...rest] = reviews;
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: hun eigen overkapping met veranda zonwering, schermvullend -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-nacht text-wit">
      <Image src={hero} alt="Antraciet aluminium overkapping met veranda zonwering en een dichte zijwand, eronder een loungebank, in een tuin met siergrassen" quality={62} widths={[480, 720, 960, 1280, 1680, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[46%_60%] lg:object-[50%_58%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0e172900_30%,#0e1729b3_62%,#0e1729f2_100%)] lg:bg-[linear-gradient(90deg,#0e1729e6_0%,#0e1729a6_36%,#0e172926_62%,#0e172900_80%),linear-gradient(0deg,#0e1729b3_0%,#0e172900_45%)]" aria-hidden="true"></div>
      <div class="wrap pb-28 pt-32 md:pb-16 lg:pb-20">
        <p class="text-sm font-semibold text-wit/85">Klimaat &amp; zonwering in Halsteren</p>
        <h1 class="mt-5 max-w-[12ch] text-hero">Comfort voor ieder <span class="text-zon">seizoen.</span></h1>
        <p class="mt-7 max-w-[33rem] text-lg text-wit/90 md:text-xl">Airco's, rolluiken, screens, horren en raamdecoratie op maat. Wij adviseren, leveren én monteren.</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#offerte" class="knop">Vraag een offerte aan<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-lijn num max-sm:hidden"><Icoon naam="tel" />{site.tel}</a>
        </div>
      </div>
      <p class="absolute bottom-20 right-10 hidden max-w-[15rem] text-right text-xs leading-snug text-wit/70 lg:block">Aluminium overkapping met veranda zonwering en zijwand.</p>
    </section>

    <!-- 2. AANBOD: een wandeling rond het huis, met hun eigen foto's -->
    <section id="aanbod" class="pb-10 pt-20 md:pt-28" aria-labelledby="aanbod-titel">
      <div class="wrap grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
        <h2 id="aanbod-titel" class="rijs text-3xl lg:col-span-7">Van de gevel tot in de tuin.</h2>
        <p class="rijs max-w-md self-end text-lg text-grijs lg:col-span-4 lg:col-start-9">Elke woning is anders, daarom leveren wij altijd een oplossing op maat.</p>
      </div>

      <!-- Gevel: solar screens -->
      <article class="wrap mt-12 grid gap-y-8 md:mt-16 lg:grid-cols-12 lg:gap-x-12" aria-labelledby="p-screens">
        <div class="grid grid-cols-[1.15fr_1fr] items-end gap-3 md:gap-5 lg:col-span-7">
          <Image src={screenGarage} alt="Antraciet solar screen voor een raam in een bakstenen gevel, in dezelfde kleur als de garagedeur ernaast" widths={[360, 560, 760]} sizes="(min-width: 1024px) 30vw, 54vw" class="rijs aspect-[3/4] w-full rounded-md object-cover" />
          <figure class="rijs" style="--d:.12s">
            <Image src={screenVierde} alt="Solar screen voor een raam op de vierde etage van een appartementengebouw, met de zon erboven" widths={[320, 480, 680]} sizes="(min-width: 1024px) 26vw, 46vw" class="aspect-[3/4] w-full rounded-md object-cover object-[50%_30%]" />
            <figcaption class="mt-3 text-sm text-grijs">Ook op de 4e etage? Geen probleem!</figcaption>
          </figure>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:pt-10">
          <p class="rijs text-sm font-bold text-grijs">De gevel</p>
          <h3 id="p-screens" class="rijs mt-2 text-[clamp(1.9rem,2.2vw+1rem,2.75rem)]">Solar screens</h3>
          <p class="rijs mt-4 text-lg">Minder warmte en hinderlijk zonlicht, terwijl het uitzicht naar buiten behouden blijft.</p>
          <ul class="rijs mt-6 space-y-2 text-grijs">
            <li class="kruis">Heroal solar screens</li>
            <li class="kruis">Somfy elektrische bediening</li>
            <li class="kruis">Geen stroomaansluiting nodig, volledig op zonne-energie</li>
            <li class="kruis">Kleur afgestemd op kozijnen en garage</li>
          </ul>
          <button type="button" data-kies="solar screens" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-bold">Advies over screens<Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
      </article>

      <Vouw class="wrap mt-14 md:mt-20" />

      <!-- Raam: rolluiken -->
      <article class="wrap mt-12 grid gap-y-8 md:mt-16 lg:grid-cols-12 lg:gap-x-12" aria-labelledby="p-rolluik">
        <div class="order-2 lg:order-1 lg:col-span-4 lg:self-center">
          <p class="rijs text-sm font-bold text-grijs">Het raam</p>
          <h3 id="p-rolluik" class="rijs mt-2 text-[clamp(1.9rem,2.2vw+1rem,2.75rem)]">Rolluiken</h3>
          <p class="rijs mt-4 text-lg">Rolluiken voor verduistering, isolatie en veiligheid.</p>
          <p class="rijs mt-4 text-grijs">Voor dit solar rolluik hebben we het zonnepaneel op de geleider gemonteerd. Zo krijgt het paneel voldoende zonlicht en blijft het rolluik optimaal functioneren.</p>
          <button type="button" data-kies="rolluiken" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-bold">Advies over rolluiken<Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
        <div class="order-1 grid grid-cols-12 items-start gap-3 md:gap-5 lg:order-2 lg:col-span-7 lg:col-start-6">
          <Image src={solarRolluik} alt="Wit solar rolluik voor een raam onder zonnepanelen, met het zonnepaneeltje op de geleider" widths={[360, 560, 760]} sizes="(min-width: 1024px) 26vw, 58vw" class="rijs col-span-7 aspect-[4/5] w-full rounded-md object-cover" />
          <Image src={screensTholen} alt="Twee appartementen in een bakstenen gebouw met grijze solar screens voor de ramen" widths={[300, 480, 640]} sizes="(min-width: 1024px) 20vw, 40vw" class="rijs col-span-5 mt-[22%] aspect-square w-full rounded-md object-cover" style="--d:.12s" />
        </div>
      </article>

      <Vouw class="wrap mt-14 md:mt-20" />

      <!-- Schuifpui: horren en hordeuren -->
      <article class="wrap mt-12 grid gap-y-8 md:mt-16 lg:grid-cols-12 lg:gap-x-12" aria-labelledby="p-hor">
        <div class="lg:col-span-4 lg:pt-6">
          <p class="rijs text-sm font-bold text-grijs">De schuifpui</p>
          <h3 id="p-hor" class="rijs mt-2 text-[clamp(1.9rem,2.2vw+1rem,2.75rem)]">Horren en hordeuren</h3>
          <p class="rijs mt-4 text-lg">Horren voor frisse lucht zonder insecten.</p>
          <ul class="rijs mt-6 space-y-2 text-grijs">
            <li class="kruis">Kleur passend bij het kozijn</li>
            <li class="kruis">Onze 24 mm hordeur, ook met een volledig op maat gemaakt frame</li>
          </ul>
          <button type="button" data-kies="een hordeur" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-bold">Advies over een hor of hordeur<Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
        <div class="grid grid-cols-12 items-start gap-3 md:gap-5 lg:col-span-8">
          <Image src={hordeur} alt="Antraciet hordeur in dezelfde kleur als het kozijn, geplaatst bij een schuifpui van een nieuwbouwwoning" widths={[480, 760, 1100]} sizes="(min-width: 1024px) 38vw, 58vw" class="rijs col-span-7 aspect-square w-full rounded-md object-cover object-[40%_50%]" />
          <figure class="rijs col-span-5 mt-[12%]" style="--d:.12s">
            <Image src={hordeurSmal} alt="Hordeur in een op maat gemaakt frame bij een schuifdeur naar de tuin" widths={[320, 520, 720]} sizes="(min-width: 1024px) 26vw, 40vw" class="aspect-[4/5] w-full rounded-md object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">Weinig ruimte? Ook dan zoeken we naar een oplossing die werkt.</figcaption>
          </figure>
        </div>
      </article>
    </section>

    <!-- 3. BINNEN: plisse, op de echte stof -->
    <section class="mt-16 bg-steen py-16 md:mt-20 md:py-24" aria-labelledby="p-plisse">
      <div class="wrap grid gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-7">
          <Image src={plisse} alt="Lichte plissegordijnen in een zwart kozijn van drie ramen in een woonkamer, met een plant ervoor" widths={[480, 760, 1100]} sizes="(min-width: 1024px) 55vw, 100vw" class="rijs aspect-[4/3] w-full rounded-md object-cover" />
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:self-center">
          <p class="rijs text-sm font-bold text-grijs">Binnen</p>
          <h3 id="p-plisse" class="rijs mt-2 text-[clamp(1.9rem,2.2vw+1rem,2.75rem)]">Splendid Plissé in Frame</h3>
          <p class="rijs mt-4 text-lg">Geen zin in gaten, boren of schroeven in je kozijnen? Dan is Splendid Plissé in Frame dé oplossing.</p>
          <ul class="rijs mt-6 space-y-2 text-grijs">
            <li class="kruis">Montage zonder boren en schroeven</li>
            <li class="kruis">Ideaal voor kunststof, aluminium en houten kozijnen</li>
            <li class="kruis">Verkrijgbaar in diverse kleuren en uitvoeringen</li>
          </ul>
          <button type="button" data-kies="Splendid Plissé" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-bold">Advies over plissé<Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
      </div>
    </section>

    <!-- 4. WERKWIJZE: drie woorden over de geplooide stof -->
    <section id="werkwijze" class="relative isolate overflow-hidden bg-nacht py-20 text-wit md:py-28" aria-labelledby="werk-titel">
      <Image src={plisseStof} alt="" widths={[640, 1080]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-30 mix-blend-luminosity" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#0e1729f2_0%,#0e1729bf_55%,#0e172980_100%)]" aria-hidden="true"></div>
      <div class="wrap">
        <h2 id="werk-titel" class="rijs text-[clamp(2.75rem,6.4vw+.5rem,6.75rem)] leading-[.95]">Adviseren.<br class="lg:hidden" /> Leveren.<br class="lg:hidden" /> <span class="text-zon">Monteren.</span></h2>
        <div class="mt-12 grid gap-y-6 md:grid-cols-12 md:gap-x-12">
          <p class="rijs text-lg text-wit/90 md:col-span-5 md:text-xl">Persoonlijk advies en vakkundige montage. Volledig op maat gemaakt.</p>
          <p class="rijs text-mist md:col-span-5 md:col-start-8">Heeft u plannen? Neem gerust contact met ons op voor advies of een vrijblijvende offerte.</p>
        </div>
      </div>
    </section>

    <!-- 5. TUIN EN KLIMAAT -->
    <section class="py-16 md:py-24" aria-label="Tuin en binnenklimaat">
      <article class="wrap grid gap-y-8 lg:grid-cols-12 lg:gap-x-12" aria-labelledby="p-overkapping">
        <div class="lg:col-span-4">
          <p class="rijs text-sm font-bold text-grijs">De tuin</p>
          <h3 id="p-overkapping" class="rijs mt-2 text-[clamp(1.9rem,2.2vw+1rem,2.75rem)]">Overkappingen</h3>
          <p class="rijs mt-4 text-lg">Van een kale tuin naar een complete buitenbeleving.</p>
          <ul class="rijs mt-6 space-y-2 text-grijs">
            <li class="kruis">Veranda zonwering voor een aangename temperatuur</li>
            <li class="kruis">Zijwand voor extra beschutting tegen zon, wind en insecten</li>
            <li class="kruis">Ingebouwde LED-spots voor sfeervolle avonden</li>
            <li class="kruis">Bestaande overkapping vernieuwen met een duurzaam polycarbonaat dak</li>
          </ul>
          <button type="button" data-kies="een overkapping" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-bold">Advies over een overkapping<Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
        <div class="grid grid-cols-12 items-start gap-3 md:gap-5 lg:col-span-7 lg:col-start-6">
          <figure class="rijs col-span-12 sm:col-span-7">
            <Image src={veranda} alt="Veranda zonwering, van bovenaf gezien, uitgerold over een antraciet overkapping in een tuin" widths={[480, 760, 1080]} sizes="(min-width: 1024px) 34vw, (min-width: 640px) 56vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">Dezelfde overkapping, met de veranda zonwering uitgerold.</figcaption>
          </figure>
          <figure class="rijs col-span-12 sm:col-span-5 sm:mt-24" style="--d:.12s">
            <Image src={polycarbonaat} alt="Bestaande overkapping met een nieuw, helder polycarbonaat dak" widths={[360, 560, 800]} sizes="(min-width: 1024px) 24vw, (min-width: 640px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover sm:aspect-[4/5]" />
            <figcaption class="mt-3 text-sm text-grijs">Nieuw polycarbonaat dak op een bestaande overkapping, in Halsteren.</figcaption>
          </figure>
        </div>
      </article>

      <article class="wrap mt-20 grid gap-y-8 md:mt-28 lg:grid-cols-12 lg:gap-x-12" aria-labelledby="p-airco">
        <div class="order-2 grid grid-cols-12 items-end gap-3 md:gap-5 lg:order-1 lg:col-span-5">
          <Image src={aircoChalet} alt="Buitenunit van een LG airco naast een blauwgrijs chalet" widths={[320, 520, 720]} sizes="(min-width: 1024px) 28vw, 58vw" class="rijs col-span-7 aspect-[3/4] w-full rounded-md object-cover" />
          <Image src={aircoBinnen} alt="Binnenunit van de airco boven het raam in een lichte kamer van het chalet" widths={[280, 440, 600]} sizes="(min-width: 1024px) 20vw, 40vw" class="rijs col-span-5 aspect-[3/4] w-full rounded-md object-cover" style="--d:.12s" />
        </div>
        <div class="order-1 lg:order-2 lg:col-span-5 lg:col-start-8 lg:self-center">
          <p class="rijs text-sm font-bold text-grijs">Het klimaat binnen</p>
          <h3 id="p-airco" class="rijs mt-2 text-[clamp(1.9rem,2.2vw+1rem,2.75rem)]">Airco's</h3>
          <p class="rijs mt-4 text-lg">Een comfortabele oplossing voor zowel verkoeling in de zomer als aangename warmte in de koudere maanden.</p>
          <p class="rijs mt-4 text-grijs">Voor uw woning, chalet of bedrijf. Hier twee chalets met een LG airco.</p>
          <button type="button" data-kies="een airco" class="rijs link mt-7 inline-flex min-h-11 items-center gap-2 font-bold">Advies over een airco<Icoon naam="pijl" class="h-4 w-4" /></button>
        </div>
      </article>
    </section>

    <!-- 6. REVIEWS: letterlijk van Google -->
    <section id="reviews" class="border-t border-lijn bg-papier py-20 md:py-24" aria-labelledby="rev-titel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-5">
          <h2 id="rev-titel" class="rijs text-3xl">Snel, netjes en vriendelijk.</h2>
          <p class="rijs mt-4 flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />Reviews van Google, letterlijk overgenomen.</p>
        </div>
        <figure class="lg:col-span-7">
          <blockquote class="rijs text-[clamp(1.35rem,1.2vw+1rem,2rem)] font-semibold leading-snug tracking-[-0.015em]">“{judith.tekst}”</blockquote>
          <figcaption class="rijs mt-5 flex items-center gap-3 text-sm text-grijs"><span class="flex text-zon" role="img" aria-label="5 sterren">{[0, 1, 2, 3, 4].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>{judith.naam}, Google review</figcaption>
        </figure>
      </div>
      <div class="wrap mt-16 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
        {rest.map((r, i) => (
          <figure class="rijs border-t-2 border-inkt pt-5" style={`--d:${i * 0.06}s`}>
            <blockquote class="text-[.98rem]">“{r.tekst}”</blockquote>
            <figcaption class="mt-4 text-sm font-bold">{r.naam}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 7. WOW: de offerte in één zin, naar WhatsApp -->
    <section id="offerte" class="bg-zon py-20 text-inkt md:py-24" aria-labelledby="off-titel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2 id="off-titel" class="rijs text-3xl">Uw vraag in één zin.</h2>
          <p class="rijs mt-5 max-w-sm text-lg">Vul de zin in, dan staat uw bericht klaar in WhatsApp. Stuur er gerust een foto van de plek bij.</p>
        </div>
        <form class="min-w-0 lg:col-span-8" data-zin onsubmit="return false">
          <p class="rijs text-[clamp(1.5rem,1.9vw+1rem,2.6rem)] font-semibold leading-[1.55] tracking-[-0.02em]">
            Ik wil graag advies over
            <label class="sr-only" for="z-product">Product</label>
            <select id="z-product" class="gat" data-product>{producten.map((p) => <option value={p}>{p}</option>)}</select>
            bij
            <label class="sr-only" for="z-plek">Plek</label>
            <select id="z-plek" class="gat" data-plek>{plekken.map((p) => <option value={p}>{p}</option>)}</select>,
            ongeveer
            <label class="sr-only" for="z-breed">Breedte in centimeters</label>
            <input id="z-breed" class="gat num w-[3.6em] text-center" type="number" inputmode="numeric" min="20" max="2000" step="1" placeholder="..." data-breed /> cm breed.
          </p>
          <div class="rijs mt-10 rounded-md bg-papier p-5 shadow-[0_1px_0_#14213a1a] md:p-7">
            <p class="text-xs font-bold text-grijs">Uw WhatsApp-bericht</p>
            <p class="mt-2 whitespace-pre-line text-[1.02rem]" data-voorbeeld aria-live="polite"></p>
          </div>
          <div class="rijs mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={waHoi} class="knop knop-inkt" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
            <p class="text-sm">Of bel <a href={site.telHref} class="num font-bold underline underline-offset-4">{site.tel}</a></p>
          </div>
          <p class="mt-6 text-xs">Er wordt niets verstuurd tot u zelf in WhatsApp op verzenden drukt.</p>
        </form>
      </div>
    </section>

    <!-- 8. CONTACT EN TIJDEN -->
    <section id="contact" class="py-20 md:py-24" aria-labelledby="con-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-6">
          <h2 id="con-titel" class="rijs text-3xl">Neem gerust contact op.</h2>
          <p class="rijs mt-8"><a href={site.telHref} class="num text-[clamp(2rem,3vw+1rem,3.5rem)] font-extrabold tracking-[-0.03em] no-underline hover:text-grijs">{site.tel}</a></p>
          <div class="rijs mt-8 flex flex-wrap gap-3">
            <a href={waHoi} class="knop"><Icoon naam="wa" />WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="knop knop-inkt">E-mail</a>
          </div>
          <p class="rijs mt-8 break-all text-grijs">{site.mail}<br /><span class="break-normal">{site.plaats}</span></p>
          <p class="rijs mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <a href={site.instagram} class="link inline-flex items-center gap-2"><Icoon naam="insta" class="h-4 w-4" />Instagram</a>
            <a href={site.facebook} class="link inline-flex items-center gap-2"><Icoon naam="fb" class="h-4 w-4" />Facebook</a>
          </p>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="rijs text-sm font-bold text-grijs">Tijden</p>
          <table class="rijs num mt-4 w-full text-left" data-tijden>
            <caption class="sr-only">Tijden van Wooncomfort Halsteren</caption>
            <tbody>
              {tijden.map(([dag, t], i) => (
                <tr class="border-b border-lijn data-[vandaag]:font-extrabold" data-dag={(i + 1) % 7}>
                  <th scope="row" class="py-3 font-[inherit]">{dag}</th>
                  <td class="py-3 text-right">{t}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="rijs mt-4 text-sm text-grijs" data-nu></p>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Offertezin -> WhatsApp-bericht
  const f = document.querySelector<HTMLFormElement>('[data-zin]');
  if (f) {
    const prod = f.querySelector<HTMLSelectElement>('[data-product]')!;
    const plek = f.querySelector<HTMLSelectElement>('[data-plek]')!;
    const breed = f.querySelector<HTMLInputElement>('[data-breed]')!;
    const vb = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
    const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
    const pas = (sel: HTMLSelectElement) => { const m = document.createElement('span'); const cs = getComputedStyle(sel); m.style.cssText = `position:absolute;visibility:hidden;white-space:nowrap;font:${cs.font};letter-spacing:${cs.letterSpacing}`; m.textContent = sel.options[sel.selectedIndex]?.text || ''; document.body.append(m); sel.style.width = `calc(${m.getBoundingClientRect().width}px + 1.6em)`; m.remove(); };
    const maak = () => {
      pas(prod); pas(plek);
      const b = parseInt(breed.value, 10);
      const regels = [
        'Hallo Wooncomfort Halsteren,',
        `ik wil graag advies of een vrijblijvende offerte voor ${prod.value} bij ${plek.value}.`,
        b > 0 ? `Breedte ongeveer ${b} cm.` : 'De breedte weet ik nog niet precies.',
        'Ik stuur een foto van de plek mee.',
      ];
      const tekst = regels.join('\n');
      vb.textContent = tekst;
      stuur.href = `https://wa.me/31610874662?text=${encodeURIComponent(tekst)}`;
    };
    [prod, plek, breed].forEach((el) => el.addEventListener('input', maak));
    maak();
    document.fonts?.ready.then(maak);
    // "Advies over ..." knoppen bij de producten zetten de zin alvast goed.
    document.querySelectorAll<HTMLButtonElement>('[data-kies]').forEach((k) => k.addEventListener('click', () => {
      prod.value = k.dataset.kies || prod.value;
      maak();
      document.getElementById('offerte')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      setTimeout(() => plek.focus({ preventScroll: true }), 600);
    }));
  }

  // Tijden: vandaag markeren (Nederlandse tijd)
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const rij = document.querySelector<HTMLElement>(`[data-tijden] [data-dag="${nu.getDay()}"]`);
  rij?.setAttribute('data-vandaag', '');
  const uit = document.querySelector<HTMLElement>('[data-nu]');
  if (uit) {
    const t = nu.getHours() * 60 + nu.getMinutes(), d = nu.getDay();
    const [van, tot] = d === 0 ? [0, 0] : d === 6 ? [540, 960] : [420, 1020];
    uit.textContent = t >= van && t < tot ? 'Nu bereikbaar.' : 'Nu gesloten. Een WhatsApp-bericht kan altijd.';
  }
</script>
