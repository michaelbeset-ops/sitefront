---
import { Image } from 'astro:assets';
import { url, waEersteLes, site } from '../data/site';
import logo from '../assets/logo.png';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['aanbod', 'Lessen'], ['lestijden', 'Lestijden'], ['sensei', 'Sensei'], ['team', 'Team'], ['reviews', 'Reviews'], ['contact', 'Contact']];
const usps = ['Taekwondo en kickboksen', 'Jeugd en volwassenen', 'Van witte tot zwarte band', 'Dinsdag en zaterdag'];
---
<div class="topbar hidden bg-nacht text-licht md:block">
  <div class="wrap flex h-10 items-center justify-between gap-6 text-[0.8125rem]">
    <ul class="flex gap-7">
      {usps.map((u) => (
        <li class="flex items-center gap-2"><svg viewBox="0 0 20 20" aria-hidden="true" class="h-3.5 w-3.5 text-rood-licht"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m4 10.5 4 4 8-9"/></svg>{u}</li>
      ))}
    </ul>
    <a href={site.telHref} class="lijn-in num font-semibold">{site.tel}</a>
  </div>
</div>

<header data-kop class:list={['kop sticky top-0 z-40 pt-3', thuis && '-mb-[5.25rem]']}>
  <div class="wrap">
    <div class="pil flex h-[4.5rem] items-center justify-between gap-4 rounded-full bg-wit pl-3 pr-3 shadow-md sm:pl-4">
      <a href={url('')} class="merk flex items-center gap-3 no-underline">
        <Image src={logo} alt="" width={48} height={48} densities={[1, 2]} class="h-11 w-11 sm:h-12 sm:w-12" loading="eager" />
        <span class="leading-tight">
          <b class="kop block text-[1.0625rem] tracking-[-0.02em]">Sportschool Kwikkers</b>
          <small class="block text-[0.8125rem] text-grijs">Taekwondo en kickboksen</small>
        </span>
      </a>

      <nav aria-label="Hoofdmenu" class="hidden xl:block">
        <ul class="flex gap-7 text-[0.9375rem] font-semibold text-inkt">
          {nav.map(([id, t]) => <li><a href={h(id)} class="lijn-in">{t}</a></li>)}
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href={site.telHref} class="knop knop-klein hidden border-lijn text-inkt hover:border-inkt lg:inline-flex">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
          <span class="num">{site.tel}</span>
        </a>
        <a href={waEersteLes} class="knop knop-rood knop-klein hidden sm:inline-flex">Eerste les appen</a>
        <button type="button" class="menuknop grid h-11 w-11 place-items-center rounded-full bg-vlak text-inkt xl:hidden" aria-expanded="false" aria-controls="menu" aria-label="Menu">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5"><path class="m-open" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/><path class="m-dicht" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
    </div>

    <nav id="menu" aria-label="Menu mobiel" class="menu mt-2 rounded-[var(--radius-lg)] bg-wit p-3 shadow-md xl:hidden" hidden>
      <ul class="grid text-lg font-semibold text-inkt">
        {nav.map(([id, t]) => <li><a href={h(id)} class="block rounded-[var(--radius-sm)] px-4 py-3 no-underline hover:bg-papier">{t}</a></li>)}
      </ul>
      <div class="mt-2 grid gap-2 border-t border-lijn p-2 pt-4 sm:grid-cols-2">
        <a href={waEersteLes} class="knop knop-rood">Eerste les appen</a>
        <a href={site.telHref} class="knop knop-inkt num">Bel {site.tel}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const knop = document.querySelector<HTMLButtonElement>('.menuknop');
  const menu = document.getElementById('menu');
  if (knop && menu) {
    const zet = (open: boolean) => { menu.hidden = !open; knop.setAttribute('aria-expanded', String(open)); knop.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu'); };
    knop.addEventListener('click', () => zet(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => zet(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') zet(false); });
  }
</script>

<style>
  .menuknop .m-dicht { display: none; }
  .menuknop[aria-expanded='true'] .m-open { display: none; }
  .menuknop[aria-expanded='true'] .m-dicht { display: block; }
  .merk b { font-family: var(--font-kop); }
</style>
