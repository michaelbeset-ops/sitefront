<script>
  // Live: vandaag markeren, "nu les" of de eerstvolgende les (tijd in Nederland).
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const dag = nu.getDay();
  const min = nu.getHours() * 60 + nu.getMinutes();
  const m = (t: string) => { const [h, mm] = t.split(':').map(Number); return h * 60 + mm; };
  const tijden: Record<number, [string, string]> = { 2: ['17:00', '20:00'], 6: ['09:00', '12:00'] };
  const namen = ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'];

  let tekst = '', nuOpen = false;
  const t = tijden[dag];
  if (t && min >= m(t[0]) && min < m(t[1])) { nuOpen = true; tekst = `Nu les, tot ${t[1]}`; }
  else if (t && min < m(t[0])) tekst = `Vandaag les van ${t[0]} tot ${t[1]}`;
  else {
    for (let i = 1; i <= 7; i++) {
      const d = (dag + i) % 7;
      if (tijden[d]) { tekst = `Volgende les: ${i === 1 ? 'morgen' : namen[d]} ${tijden[d][0]}`; break; }
    }
  }
  const live = document.querySelector<HTMLElement>('[data-live]');
  if (live) { live.querySelector('[data-live-tekst]')!.textContent = tekst; live.classList.toggle('open', nuOpen); }
  const held = document.querySelector<HTMLElement>('[data-status]');
  if (held) held.innerHTML = `<span class="stip${nuOpen ? ' open' : ''}" aria-hidden="true"></span> <b class="text-licht">${tekst}</b>`;

  document.querySelectorAll<HTMLElement>('.weekdag').forEach((r) => {
    if (Number(r.dataset.dag) === dag) { r.classList.add('is-vandaag'); r.querySelector<HTMLElement>('.vandaag-pil')!.hidden = false; }
  });
  document.querySelectorAll<HTMLElement>('.dag').forEach((d) => {
    if (Number(d.dataset.dag) !== dag) return;
    d.classList.add('is-vandaag');
    d.querySelector<HTMLElement>('.vandaag')!.hidden = false;
    for (const les of d.querySelectorAll<HTMLElement>('.les')) {
      const van = m(les.dataset.van!), tot = m(les.dataset.tot!);
      if (min >= tot) { les.classList.add('voorbij'); continue; }
      const s = les.querySelector<HTMLElement>('.status')!;
      s.textContent = min >= van ? 'Nu bezig' : 'Volgende';
      s.hidden = false;
      les.classList.add('volgende');
      break;
    }
  });
</script>

