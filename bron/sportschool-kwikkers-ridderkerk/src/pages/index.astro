---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, waEersteLes, waMet, rooster, week } from '../data/site';
import hero from '../assets/hero-kickboksen.jpg';
import tkdJeugd from '../assets/tkd-jeugd.jpg';
import trap from '../assets/taekwondo-trap.jpg';
import clinch from '../assets/kickboksen-clinch.jpg';
import pads from '../assets/kick-pads.jpg';
import breektest from '../assets/breektest.jpg';
import sensei from '../assets/sensei-examen.jpg';
import tMartijn from '../assets/team-martijn.jpg';
import tWesley from '../assets/team-wesley.jpg';
import tNigel from '../assets/team-nigel.jpg';
import tGroep from '../assets/team-groep.jpg';
import logo from '../assets/logo.png';

const wa = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>';
const ster = '<svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="m10 1.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8Z"/></svg>';
const vijf = ster.repeat(5);
const pijl = '<svg viewBox="0 0 20 20" aria-hidden="true" class="h-4 w-4"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m-5-5 5 5-5 5"/></svg>';
const vink = '<svg viewBox="0 0 20 20" aria-hidden="true" class="h-4 w-4"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m4 10.5 4 4 8-9"/></svg>';

// De tien graden zoals op hun aanbodpagina. [naam, bandkleur, kleur van de slip(pen), aantal slippen]
const graden: [string, string, string, number][] = [
  ['Wit', '#f7f6f2', '', 0],
  ['Geel', '#e7c43a', '', 0],
  ['Oranje', '#dc7b2c', '', 0],
  ['Groen', '#3f8a4c', '', 0],
  ['Groen met blauwe slip', '#3f8a4c', '#2f5aa8', 1],
  ['Blauw', '#2f5aa8', '', 0],
  ['Blauw met bruine slip', '#2f5aa8', '#6b4327', 1],
  ['Bruin met zwarte slip', '#6b4327', '#121314', 1],
  ['Bruin met twee zwarte slippen', '#6b4327', '#121314', 2],
  ['Zwart, 1e dan', '#121314', '', 0],
];

const aanbod = [
  { foto: tkdJeugd, alt: 'Twee jonge taekwondoka’s op de blauwe mat, een met gele band, de ander trapt hoog', titel: 'Taekwondo jeugd en beginners', tekst: 'Je leert de basistrappen en -stoten, afweren, veel voetenwerk en simpele zelfverdediging.', tijd: 'Di 17:00 · Za 10:00', href: '#taekwondo', pos: '50% 50%' },
  { foto: trap, alt: 'Twee taekwondoka’s met zwarte band, een trap in de zaal', titel: 'Taekwondo gevorderden', tekst: 'Hard, explosief en rechtlijnig, met veel high kicks. Op weg naar de zwarte band.', tijd: 'Di 18:00 · Za 09:00 en 10:00', href: '#banden', pos: '50% 60%' },
  { foto: pads, alt: 'Kickbokstraining op de pads, scheenbeschermers en een trap', titel: 'Kickboksen (Muay Thai)', tekst: 'Op de traditionele Thaise manier: naast je vuisten ook knieën, ellebogen en benen.', tijd: 'Di 19:00 · Za 11:00', href: '#kickboksen', pos: '50% 40%' },
];

const stappen = [
  ['Stuur een appje', 'Zeg welke les je wilt proberen. Twijfel je over de groep? Vraag het gewoon.'],
  ['Kom naar de zaal', 'Sporthal aan het Scheldeplein 4 in Bolnes, op dinsdag of zaterdag.'],
  ['Train op je eigen niveau', 'Beginnende sporters krijgen de juiste begeleiding, wedstrijdsporters worden uitgedaagd.'],
  ['Examen voor je volgende band', 'We streven naar twee examens per jaar, als je er klaar voor bent.'],
];

// Letterlijk van Google (beperkte weergave, 2-10-2026), ingekort met "…". Zie bron/google-reviews.txt.
const reviews = [
  { naam: 'Sheldon K.', wanneer: '11 maanden geleden', tekst: 'Leuke sfeer, duidelijke uitleg, streng maar wel eerlijk. Iedereen heeft respect voor elkaar, er is ruimte voor wat grapjes maar er wordt zeker hard getraind! Na de les mag je ook nog vragen stellen aan de hogere banden en ze helpen je graag. Zeer fijn!' },
  { naam: 'Michel v. E.', wanneer: '2 jaar geleden', tekst: 'Hele fijne sportschool. Respect,discipline en doorzettingsvermogen staan hoog in het vaandel. Zit er nu al een paar jaar op en ook mijn kids zitten erop. Leuke groep van klein tot groot. Heel goede begeleiding en lessen van de Sensei maar ook helpen de mensen elkaar waar nodig of gevraagd. Hele fijne sfeer.' },
  { naam: 'Naj', wanneer: '2 jaar geleden', tekst: 'Mijn kind zit nu ong. bijna een jaar op taekwondo lessen, er is voldoende aandacht en begeleiding voor de kinderen (en de wat oudere deelnemers), iedereen wordt betrokken in de les … Nieuwe deelnemers komen in een warm club terecht. … Minpunten.....schiet mij op dit moment niets binnen.' },
];
---
<Base title={`${site.naam} | Taekwondo en kickboksen in Ridderkerk`} description="Taekwondo en kickboksen in Bolnes, Ridderkerk. Lessen voor jeugd en volwassenen, van beginner tot zwarte band, op dinsdag en zaterdag aan het Scheldeplein.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: volle hoogte, eigen kickboksfoto -->
    <section class="held donker relative isolate flex flex-col overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="Kickbokstraining in de sporthal: een hoge trap, scheenbeschermers, de bakstenen muur" widths={[640, 960, 1440, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[58%_50%] contrast-[1.1] md:object-[38%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#0f1011f0_0%,#0f1011c2_38%,#0f101155_70%,#0f101122_100%)]" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 h-2/5 bg-[linear-gradient(0deg,#0f1011e6,transparent)]" aria-hidden="true"></div>

      <div class="wrap grid flex-1 items-end gap-10 pb-14 pt-36 md:pb-20 lg:grid-cols-12 lg:pt-44">
        <div class="lg:col-span-8">
          <p class="eyebrow">Taekwondo en kickboksen in Bolnes, Ridderkerk</p>
          <h1 id="t-hero" class="mt-6 text-[clamp(2.75rem,6.4vw+0.5rem,6rem)] leading-[0.95] tracking-[-0.045em]">Hard trainen,<br />met <span class="text-rood-licht">respect.</span></h1>
          <p class="mt-7 max-w-[36rem] text-[clamp(1.125rem,0.5vw+1rem,1.375rem)] leading-normal text-licht/85">Vechtsportlessen op alle niveaus bij sensei Martijn Kwikkers en zijn team. Of je nu komt voor je eerste les taekwondo of een ervaren kickbokser bent.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waEersteLes} class="knop knop-rood"><Fragment set:html={wa} />App voor je eerste les</a>
            <a href="#lestijden" class="knop knop-rand">Bekijk de lestijden</a>
          </div>
        </div>
        <div class="flex flex-col gap-2 text-[0.9375rem] lg:col-span-4 lg:items-end lg:text-right">
          <p class="status-held text-licht/85" data-status>Lessen op <b class="text-licht">dinsdag 17:00 tot 20:00</b> en <b class="text-licht">zaterdag 09:00 tot 12:00</b></p>
          <p class="flex items-center gap-2 lg:justify-end"><span class="sterren"><Fragment set:html={vijf} /></span><b class="text-licht">{site.google.score}</b> op Google · {site.google.aantal} reviews</p>
          <a href={site.telHref} class="kop num mt-1 text-[1.6rem] !text-licht no-underline hover:!text-rood-licht">{site.tel}</a>
        </div>
      </div>
    </section>

    <!-- 2. Echte cijfers -->
    <section class="border-b border-lijn bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-y-8 py-10 md:grid-cols-4 md:py-12">
        {[
          ['10', 'graden, van witte tot zwarte band'],
          ['6', 'lessen per week, dinsdag en zaterdag'],
          ['5 tot 74', 'jaar: zo jong en zo oud zijn onze leden'],
          [site.google.score, `op Google, uit ${site.google.aantal} reviews`],
        ].map(([n, t], i) => (
          <div class:list={['flex flex-col-reverse gap-1 px-1 md:px-8', i > 0 && 'md:border-l md:border-lijn', i === 0 && 'md:pl-0']}>
            <dt class="text-[0.9375rem] text-grijs">{t}</dt>
            <dd class="kop num text-[clamp(2rem,2.2vw+1rem,3rem)] text-inkt">{n}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- 3. Aanbod -->
    <section id="aanbod" class="sectie" aria-labelledby="t-aanbod">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Ons aanbod</p>
            <h2 id="t-aanbod" class="mt-5 text-2xl">Taekwondo en kickboksen, op elk niveau.</h2>
          </div>
          <p class="rijs max-w-md text-lg lg:col-span-5 lg:justify-self-end" style="--d:.05s">Beginnende sporters krijgen de juiste begeleiding om zich te ontwikkelen. Wedstrijdsporters worden op hun eigen niveau uitgedaagd.</p>
        </div>
        <ul class="mt-12 grid gap-4 md:grid-cols-3 md:gap-6">
          {aanbod.map((a, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href={a.href} class="kaart groep group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={a.foto} alt={a.alt} widths={[400, 640, 900]} sizes="(min-width: 1280px) 25rem, (min-width: 768px) 32vw, 100vw" class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${a.pos}`} />
                </div>
                <div class="flex flex-1 flex-col p-6 md:p-7">
                  <p class="num text-sm font-semibold text-rood">{a.tijd}</p>
                  <h3 class="mt-2 text-xl">{a.titel}</h3>
                  <p class="mt-3 text-[0.9875rem] text-grijs">{a.tekst}</p>
                  <span class="mt-auto flex items-center gap-2 pt-6 text-[0.9375rem] font-semibold text-inkt">Meer lezen <span class="transition-transform duration-300 group-hover:translate-x-1"><Fragment set:html={pijl} /></span></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4. Taekwondo + banden -->
    <section id="taekwondo" class="sectie border-t border-lijn bg-wit" aria-labelledby="t-tkd">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs relative lg:col-span-6">
          <Image src={breektest} alt="Sensei Martijn breekt bij een breektest een stapel tegels in de sporthal" widths={[480, 800, 1200, 1560]} sizes="(min-width: 1280px) 36rem, (min-width: 1024px) 46vw, 100vw" class="aspect-square w-full rounded-[var(--radius-md)] object-cover object-[45%_40%]" />
          <figcaption class="absolute bottom-4 left-4 rounded-full bg-wit/95 px-4 py-2 text-sm font-semibold text-inkt shadow-sm">Breektest door de sensei</figcaption>
        </figure>
        <div class="rijs flex flex-col justify-center lg:col-span-6" style="--d:.06s">
          <p class="eyebrow">Taekwondo</p>
          <h2 id="t-tkd" class="mt-5 text-2xl">Koreaans, explosief en rechtlijnig.</h2>
          <p class="mt-6 text-lg">Deze Koreaanse verdedigingssport kenmerkt zich door een harde, explosieve en rechtlijnige stijl met veel high kicks. Een mooie mix van traditionele houdingen en effectiviteit.</p>
          <p class="mt-4">Omdat taekwondo heel technisch is, vormt het een goede basis voor het leren van andere vechtsporten zoals kickboksen en MMA. Een beginnende taekwondoka leert naast simpele zelfverdedigingstechnieken ook de basistrappen en -stoten, afweren en veel voetenwerk.</p>

          <div id="banden" class="mt-10 rounded-[var(--radius-md)] border border-lijn bg-papier p-6 md:p-7">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-lg">Tien graden, van wit naar zwart</h3>
              <p class="text-sm text-grijs">Examen: twee keer per jaar</p>
            </div>
            <ol class="banden mt-5" aria-label="De tien graden in taekwondo">
              {graden.map(([naam, kleur, slip, n], i) => (
                <li title={naam}><span class="band" style={`--k:${kleur};--s:${slip || kleur}`} data-slip={n} aria-hidden="true"></span><span class="num mt-2 block text-center text-xs text-grijs" aria-hidden="true">{i + 1}</span><span class="sr-only">{naam}</span></li>
              ))}
            </ol>
            <p class="mt-5 text-sm text-grijs">Wit, geel, oranje, groen, groen met blauwe slip, blauw, blauw met bruine slip, bruin met zwarte slip, bruin met twee zwarte slippen en zwart (1e dan). Sportschool Kwikkers streeft naar twee examens per jaar, mits de leerlingen er klaar voor zijn.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Kickboksen (donker) -->
    <section id="kickboksen" class="sectie donker bg-nacht text-licht-zacht" aria-labelledby="t-kick">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="rijs order-2 flex flex-col justify-center lg:order-1 lg:col-span-6">
          <p class="eyebrow">Kickboksen</p>
          <h2 id="t-kick" class="mt-5 text-2xl">Op de traditionele Thaise manier.</h2>
          <p class="mt-6 text-lg text-licht/85">Ook wel bekend als Muay Thai. Het grote verschil met regulier boksen: naast je vuisten gebruik je ook knieën, ellebogen en benen.</p>
          <ul class="mt-10 grid gap-3 sm:grid-cols-2">
            {[
              ['Knieën, ellebogen en benen', 'Niet alleen met de vuisten, zoals bij regulier boksen.'],
              ['Clinchen mag', 'Waar boksers worden gescheiden, mag je hier doorstoten.'],
              ['Van 10 tot 70 jaar', 'Een vaste groep kickboksers, jong en oud door elkaar.'],
              ['Recreant of wedstrijd', 'Respect voor elkaar geldt voor iedereen, ook voor de instructeurs.'],
            ].map(([t, s]) => (
              <li class="kaart p-5">
                <p class="flex items-center gap-2 font-semibold text-licht"><span class="text-rood-licht"><Fragment set:html={vink} /></span>{t}</p>
                <p class="mt-1.5 text-[0.9375rem]">{s}</p>
              </li>
            ))}
          </ul>
        </div>
        <figure class="rijs relative order-1 lg:order-2 lg:col-span-6" style="--d:.06s">
          <Image src={clinch} alt="Twee kickboksers in de clinch, een knie omhoog, in de sporthal" widths={[480, 800, 1200, 1547]} sizes="(min-width: 1280px) 36rem, (min-width: 1024px) 46vw, 100vw" class="aspect-square w-full rounded-[var(--radius-md)] object-cover object-[50%_60%] contrast-[1.1]" />
          <figcaption class="absolute bottom-4 left-4 rounded-full bg-nacht/85 px-4 py-2 text-sm font-semibold text-licht backdrop-blur">Clinch bij het kickboksen</figcaption>
        </figure>
      </div>
    </section>

    <!-- 6. Zo begin je -->
    <section class="sectie" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo begin je</p>
            <h2 id="t-stappen" class="mt-5 text-2xl">Van je eerste les tot je volgende band.</h2>
          </div>
          <p class="rijs max-w-md text-lg lg:col-span-5 lg:justify-self-end" style="--d:.05s">Of je nu wedstrijdvechter bent of voor het eerst op de mat staat: bij Sportschool Kwikkers ben je aan het juiste adres.</p>
        </div>
        <ol class="stappen mt-12 grid grid-cols-2 gap-3 md:gap-4 lg:grid-cols-4">
          {stappen.map(([t, s], i) => (
            <li class="rijs kaart relative p-5 md:p-7" style={`--d:${i * 0.05}s`}>
              <span class="kop num block text-[2.25rem] leading-none text-rood md:text-[2.75rem]">0{i + 1}</span>
              <h3 class="mt-4 text-base md:mt-6 md:text-lg">{t}</h3>
              <p class="mt-2 text-[0.9375rem] text-grijs">{s}</p>
            </li>
          ))}
        </ol>
              </div>
    </section>

    <!-- 7. Lestijden (wow: vandaag + nu bezig live; elke les opent een ingevuld appje) -->
    <section id="lestijden" class="sectie border-t border-lijn bg-wit" aria-labelledby="t-tijden">
      <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="rijs lg:col-span-5">
          <p class="eyebrow">Lestijden en locatie</p>
          <h2 id="t-tijden" class="mt-5 text-2xl">Dinsdag en zaterdag in de sporthal.</h2>
          <p class="mt-6 text-lg">Tik op een les en je appje aan Martijn staat klaar, met dag en tijd erin.</p>

          <div class="kaart mt-10 overflow-hidden">
            <div class="flex items-center justify-between gap-4 border-b border-lijn px-6 py-4">
              <p class="kop whitespace-nowrap text-base">Deze week</p>
              <p class="live flex items-center gap-2 text-sm font-semibold text-grijs" data-live><span class="stip" aria-hidden="true"></span><span data-live-tekst>Lestijden</span></p>
            </div>
            <table class="w-full text-[0.9375rem]">
              <caption class="sr-only">Lestijden per dag</caption>
              <tbody>
                {week.map((d) => (
                  <tr class="weekdag" data-dag={d.nr}>
                    <th scope="row" class="py-2.5 pl-6 text-left font-medium">{d.dag} <span class="vandaag-pil" hidden>vandaag</span></th>
                    <td class:list={['num py-2.5 pr-6 text-right', d.tijd ? 'font-semibold text-inkt' : 'text-grijs']}>{d.tijd || 'Geen les'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-[var(--radius-md)] bg-papier p-6">
            <div>
              <p class="font-semibold text-inkt">{site.straat}</p>
              <p class="text-[0.9375rem] text-grijs">{site.postcode} {site.plaats} ({site.wijk})</p>
            </div>
            <a href={site.route} class="knop knop-inkt knop-klein">Route plannen <Fragment set:html={pijl} /></a>
          </div>
        </div>

        <div class="grid content-start gap-8 lg:col-span-7">
          {rooster.map((d, k) => (
            <div class="rijs dag kaart overflow-hidden" data-dag={d.nr} style={`--d:${k * 0.06}s`}>
              <h3 class="flex items-center justify-between gap-4 border-b border-lijn bg-papier px-6 py-4 text-xl">
                {d.dag}
                <span class="vandaag ui rounded-full bg-rood px-3 py-1 !text-wit" hidden>Vandaag</span>
              </h3>
              <ul>
                {d.lessen.map((l) => (
                  <li class="les" data-van={l.van} data-tot={l.tot}>
                    <a href={waMet(`Hallo Martijn, ik wil graag een keer meedoen met ${l.les.toLowerCase()} op ${d.dag.toLowerCase()} om ${l.van} (${l.groep.toLowerCase()}). Kan dat?`)} class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-x-4 border-b border-lijn px-6 py-5 no-underline sm:grid-cols-[7.5rem_1fr_auto]">
                      <span class="num text-[0.9375rem] font-semibold text-inkt">{l.van}<span class="hidden font-normal text-grijs sm:inline"> tot {l.tot}</span></span>
                      <span>
                        <span class:list={['les-naam font-semibold', l.les === 'Kickboksen' ? 'text-rood' : 'text-inkt']}>{l.les}</span>
                        <span class="block text-sm text-grijs">{l.groep}</span>
                      </span>
                      <span class="actie flex items-center gap-2 text-sm font-semibold text-grijs">
                        <span class="status rounded-full px-2.5 py-0.5 text-xs" hidden></span>
                        <span class="sr-only">Stuur een appje over deze les</span>
                        <span class="wa-icoon" aria-hidden="true"><Fragment set:html={wa} /></span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <p class="text-sm text-grijs">Lestijden volgens het rooster van juni 2026. Andere vraag? Bel of app <a href={site.telHref} class="lijn num whitespace-nowrap text-inkt">{site.tel}</a>.</p>
        </div>
      </div>
    </section>

    <!-- 8. De sensei (donker) -->
    <section id="sensei" class="donker relative overflow-hidden bg-nacht text-licht-zacht" aria-labelledby="t-sensei">
      <div class="grid lg:grid-cols-2">
        <figure class="relative min-h-[26rem] lg:min-h-full">
          <Image src={sensei} alt="Sensei Martijn Kwikkers in rood pak bij een breektest, met de Koreaanse vlag en het spandoek van de sportschool" widths={[640, 960, 1440]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[40%_45%]" />
          <figcaption class="absolute bottom-0 left-0 bg-rood px-5 py-3 ui !text-wit">Sensei Martijn Kwikkers</figcaption>
        </figure>
