---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews } from '../data/site';

import hero from '../assets/hero-grill-klimop.jpg';
import heroMobiel from '../assets/hero-mobiel.jpg';
import sporthal from '../assets/ig-493-sporthal.jpg';
import amersfoortIg from '../assets/ig-260-amersfoort.jpg';
import amersfoort from '../assets/keuken-grill-spoelbak.jpg';
import ladesGrill from '../assets/lades-open-grill.jpg';
import kamado from '../assets/kamado-uitsparing.jpg';
import betoncire from '../assets/ig-betoncire.jpg';
import blum from '../assets/ig-blum.jpg';

const titel = 'JS buitenkeukens | Maatwerk buitenkeukens, uniek design';
const omschrijving = 'Buitenkeukens op maat, met de hand gemaakt: fronten van thermisch gemodificeerd Ayous, werkblad van keramisch steen of beton-ciré. Stuur een DM of WhatsApp voor een vrijblijvende prijsopgave.';

// Hero: hun eigen buitenkeuken in de zon voor de klimop (Google, "Van eigenaar").
const hD = await getImage({ src: hero, widths: [1024, 1440, 1800], sizes: '100vw', format: 'webp', quality: 62 });
const hM = await getImage({ src: heroMobiel, widths: [480, 760, 1000], sizes: '100vw', format: 'webp', quality: 46 });
const hMa = await getImage({ src: heroMobiel, widths: [480, 760, 1000], sizes: '100vw', format: 'avif', quality: 42 });
const hDa = await getImage({ src: hero, widths: [1024, 1440, 1800], sizes: '100vw', format: 'avif', quality: 48 });

// Opgeleverd in 2026: letterlijk uit hun Instagram-posts (maat BxHxD en onderdelen).
const register = [
  { m: 'sep', b: 386, maat: '386 x 95 x 64', wat: 'Graniet spoelbak met mengkraan, 2-pits inductie kookplaat, mini-bar koeling. Onbehandeld Ayous.' },
  { m: 'aug', b: 493, maat: '493 x 94 x 63', wat: '‘Modern Sink’ met graniet spoelbak, warmwater boiler, mini-bar koeling en 2-pits inductie kookplaat.' },
  { m: 'jun', b: 195, maat: '195 x 93 x 62', wat: 'Keramisch steen werkblad, 4-pits gasbarbecue, mini-bar koeling. Onbehandeld Ayous.' },
  { m: 'mei', b: 300, maat: '300 x 95 x 63', wat: '‘Modern Sink’ in zwart, graniet spoelbak met mengkraan, mini-bar koeling.' },
  { m: 'apr', b: 346, maat: '346 x 93 x 62', wat: '‘Modern Sink’ met composiet wasbak, mini-bar koeling en een uitsparing voor de kamado.' },
  { m: 'mrt', b: 260, maat: '260 x 93 x 64', wat: 'Spoelbak met warmwater boiler, 2-pits inductie kookplaat, mini-bar koeling, 4-pits gas BBQ.' },
  { m: 'feb', b: 247, maat: '247 x 93 x 62', wat: '‘Modern Sink’ met beton-ciré werkblad, composiet wasbak en mini-bar koeling.' },
  { m: 'jan', b: 220, maat: '220 x 93 x 64', wat: 'Twee mini-bars, Ayous behandeld met UV-werende olie.' },
];
const max = 500;

const [dean, ...rest] = reviews;
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. Opening: hun eigen buitenkeuken, schermvullend -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-nacht text-wit">
      <picture>
        <source media="(min-width: 768px)" srcset={hDa.srcSet.attribute} sizes="100vw" type="image/avif" />
        <source media="(min-width: 768px)" srcset={hD.srcSet.attribute} sizes="100vw" type="image/webp" />
        <source srcset={hMa.srcSet.attribute} sizes="100vw" type="image/avif" />
        <source srcset={hM.srcSet.attribute} sizes="100vw" type="image/webp" />
        <img src={hD.src} alt="Buitenkeuken met lamellen van Ayous-hout, ingebouwde gasbarbecue, glazen koeling en lades, op een terras van klinkers voor een klimophaag" width="1800" height="2400" fetchpriority="high" loading="eager" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_56%] md:object-[50%_58%]" />
      </picture>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#12121100_30%,#121211b0_62%,#121211f0_100%)] md:bg-[linear-gradient(90deg,#121211d9_0%,#1212118c_36%,#12121100_62%),linear-gradient(0deg,#121211b3_0%,#12121100_42%)]" aria-hidden="true"></div>
      <div class="wrap pb-28 pt-32 md:pb-14 lg:pb-16">
        <p class="text-[1.0625rem] font-[560] text-wit/85">Maatwerk buitenkeukens</p>
        <h1 class="mt-5 max-w-[11ch] text-hero">Buiten koken, maar dan <em class="text-ayous-licht">stijlvol.</em></h1>
        <p class="mt-7 max-w-[30rem] text-lg text-wit/90 md:text-xl">Volledig met de hand en op maat gemaakt. Jij bepaalt het formaat, de indeling en de opties.</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#tekentafel" class="knop">Teken je buitenkeuken<Icoon naam="pijl" /></a>
          <a href="#werk" class="knop knop-lijn max-sm:hidden">Bekijk opgeleverd werk</a>
        </div>
        <p class="maat mt-12 hidden max-w-[34rem] text-xs text-wit/70 md:flex" aria-hidden="true"><span class="maat-kader px-3">maatwerk</span></p>
      </div>
    </section>

    <!-- 2. Werk: groot, met de maten zoals zij ze zelf posten -->
    <section id="werk" class="pb-24 pt-20 md:pb-28 md:pt-28" aria-labelledby="werk-titel">
      <div class="wrap grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
        <h2 id="werk-titel" class="rijs text-3xl lg:col-span-7">Maatwerk kent geen standaard afmetingen.</h2>
        <p class="rijs max-w-md self-end text-lg text-grijs lg:col-span-4 lg:col-start-9">Ook bij 5 meter: één strak geheel, zonder zichtbare naden of losse delen.</p>
      </div>

      <figure class="wrap mt-14 md:mt-20">
        <p class="maat text-sm text-ayous" aria-hidden="true"><span class="num">493 cm</span></p>
        <div class="mt-4 overflow-hidden rounded-sm">
          <Image src={sporthal} quality={58} alt="Vijf meter lange buitenkeuken met Ayous-lamellen, drie lades en een donker werkblad met spoelbak en kookplaat, voor een hoge klimophaag" widths={[640, 1000, 1400, 2000]} sizes="(min-width: 1312px) 1232px, 94vw" class="aspect-[4/5] w-full object-cover object-[50%_58%] sm:aspect-[16/10] md:aspect-[21/10]" />
        </div>
        <figcaption class="mt-5 grid gap-y-2 text-sm text-grijs md:grid-cols-12 md:gap-x-12">
          <span class="font-[600] text-houtskool md:col-span-4">Voor een sporthal, als één geheel geproduceerd</span>
          <span class="num md:col-span-8">Maatwerk buitenkeuken ‘Modern Sink’ · 493 x 94 x 63 cm · Ayous fronten · graniet spoelbak met mengkraan · warmwater boiler · mini-bar koeling · 2-pits inductie kookplaat</span>
        </figcaption>
      </figure>

      <div class="wrap mt-20 grid items-end gap-y-10 md:mt-28 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-7">
          <div class="overflow-hidden rounded-sm"><Image src={amersfoort} quality={58} alt="Buitenkeuken met spoelbak en zwarte kraan, gasbarbecue in het midden, inductiekookplaat rechts en koeling met glazen deur" widths={[480, 760, 1100]} sizes="(min-width: 1024px) 55vw, 94vw" class="aspect-[4/5] w-full object-cover object-[50%_62%] md:aspect-[4/3]" /></div>
        </div>
        <div class="lg:col-span-5">
          <div class="ml-auto w-[62%] overflow-hidden rounded-sm lg:w-[52%]"><Image src={amersfoortIg} quality={58} alt="Dezelfde buitenkeuken van dichtbij: de gasbarbecue met deksel, de knoppen en de lamellen eronder" widths={[360, 560, 800]} sizes="(min-width: 1024px) 30vw, 58vw" class="aspect-[3/4] w-full object-cover" /></div>
          <blockquote class="rijs mt-10 font-serif text-[clamp(1.9rem,1.6vw+1.2rem,2.75rem)] italic leading-[1.05]">“Koken, borrelen en genieten in je eigen tuin. Wat wil je nog meer?”</blockquote>
          <p class="rijs num mt-6 text-sm text-grijs">260 x 93 x 64 cm · spoelbak, mengkraan en warmwater boiler · 2-pits inductie kookplaat · mini-bar koeling · 4-pits gas BBQ</p>
        </div>
      </div>

    </section>

    <!-- 3. Opgeleverd in 2026: de maten als een zaaglijst, met de lengte als maatlijn -->
    <section class="bg-steen py-24 md:py-28" aria-labelledby="lijst-titel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <h2 id="lijst-titel" class="rijs text-3xl">Opgeleverd in <span class="num">2026</span></h2>
          <p class="rijs mt-5 max-w-sm text-lg text-grijs">Elke keuken een eigen maat. Alle maten in cm (BxHxD), zoals op onze Instagram.</p>
          <p class="rijs mt-8"><a href={site.instagram} class="link font-[600]">Volg @jsbuitenkeukens</a></p>
        </div>
        <ol class="grid gap-x-10 border-b border-lijn sm:grid-cols-2 lg:col-span-8">
          {register.map((r, i) => (
            <li class="rijs grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-3 border-t border-lijn py-5" style={`--d:${(i % 4) * .06}s`}>
              <span class="num pt-1 text-sm text-grijs">{r.m}</span>
              <div>
                <p class="num font-serif text-[2.1rem] leading-none">{r.b}<span class="ml-1 font-sans text-sm text-grijs">cm</span></p>
                <span class="meet mt-3 flex h-3 items-center text-ayous" style={`width:${(r.b / max) * 100}%; --d:${.15 + (i % 4) * .06}s`} aria-hidden="true">
                  <span class="h-3 w-px bg-current"></span><span class="h-px flex-1 bg-current"></span><span class="h-3 w-px bg-current"></span>
                </span>
              </div>
              <p class="col-start-2 mt-3 text-[.98rem] leading-snug"><span class="num block text-sm text-grijs">{r.maat} cm</span>{r.wat}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4. Materiaal: hout, werkblad, beslag -->
    <section id="materiaal" class="py-24 md:py-28" aria-labelledby="mat-titel">
      <div class="wrap">
        <h2 id="mat-titel" class="rijs max-w-[24ch] text-3xl">Strakke lijnen, warme houttinten en een luxe werkblad.</h2>
      </div>

      <div class="wrap mt-14 grid gap-y-8 md:mt-20 lg:grid-cols-12 lg:gap-x-12">
        <div class="overflow-hidden rounded-sm lg:col-span-7"><Image src={ladesGrill} quality={58} alt="Drie lades met Ayous-lamellen staan open onder de gasbarbecue, naast een zijwand van licht keramisch steen" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 55vw, 94vw" class="aspect-[4/5] w-full object-cover md:aspect-[16/10]" /></div>
        <div class="lg:col-span-4 lg:col-start-9 lg:self-end">
          <h3 class="rijs text-[clamp(2rem,1.8vw+1.2rem,3rem)]">Ayous, thermisch gemodificeerd</h3>
          <p class="rijs mt-5 text-lg text-grijs">Alle fronten zijn van thermisch gemodificeerd Ayous. Onbehandeld, met UV-werende olie of zwart.</p>
          <div class="lamellen rijs mt-8 h-16 rounded-sm" style="--lat:#b5703f; --naad:#4a2510; --b:13px" aria-hidden="true"></div>
        </div>
      </div>

      <div class="wrap mt-16 grid gap-y-8 md:mt-24 lg:grid-cols-12 lg:gap-x-12">
        <div class="order-2 lg:order-1 lg:col-span-4 lg:self-center">
          <h3 class="rijs text-[clamp(2rem,1.8vw+1.2rem,3rem)]">Keramisch steen of beton-ciré</h3>
          <p class="rijs mt-5 text-lg text-grijs">Keramisch steen is bestand tegen intensief gebruik en verschillende weersomstandigheden.</p>
          <p class="rijs mt-4 text-lg text-grijs">Beton-ciré komt in 65 kleuren, op exterieur wbp multiplex, afgewerkt met twee lagen matte 2K coating.</p>
        </div>
        <div class="relative order-1 lg:order-2 lg:col-span-7 lg:col-start-6">
          <div class="overflow-hidden rounded-sm"><Image src={kamado} quality={58} alt="Licht werkblad met een ronde uitsparing voor een kamado, boven open vakken en lamellen van Ayous" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 55vw, 94vw" class="aspect-[4/5] w-full object-cover object-[50%_40%] md:aspect-[16/10]" /></div>
          <div class="absolute -bottom-8 left-4 w-[30%] max-w-[11rem] overflow-hidden rounded-sm border-4 border-beton md:-left-10"><Image src={betoncire} quality={58} alt="Emmer beton-ciré en flessen coating op een werkblad naast een spoelbak" widths={[200, 360]} sizes="11rem" class="aspect-[9/16] w-full object-cover" /></div>
        </div>
      </div>

      <div class="wrap mt-20 grid gap-y-8 md:mt-24 lg:grid-cols-12 lg:gap-x-12">
        <div class="overflow-hidden rounded-sm lg:col-span-5"><Image src={blum} quality={58} alt="Accuboormachines en Blum softclose scharnieren op een plank van Ayous-latten in de werkplaats" widths={[360, 600, 900]} sizes="(min-width: 1024px) 38vw, 94vw" class="aspect-[4/3] w-full object-cover lg:aspect-[16/10]" /></div>
        <div class="space-y-10 lg:col-span-6 lg:col-start-7 lg:self-center">
          <div>
            <h3 class="rijs text-[clamp(1.8rem,1.4vw+1.2rem,2.5rem)]">Softclose, in de basis</h3>
            <p class="rijs mt-4 text-lg text-grijs">Al onze deuren en lades krijgen Blum softclose scharnieren en ladegeleiders. Altijd, en niet tegen meerwerkkosten.</p>
          </div>
          <div class="border-t border-lijn pt-8">
            <h3 class="rijs text-[clamp(1.8rem,1.4vw+1.2rem,2.5rem)]">Warm water buiten</h3>
            <p class="rijs mt-4 text-lg text-grijs">Alleen een koudwaterleiding in de tuin? Dan kan er een warmwater boiler onder de spoelbak, netjes weggewerkt in een kastje naar keuze.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Tekentafel: schets je keuken, de schets gaat als bericht naar WhatsApp -->
    <section id="tekentafel" class="bg-houtskool py-20 text-wit md:py-24" aria-labelledby="teken-titel">
      <form class="wrap grid min-w-0 gap-y-12 lg:grid-cols-12 lg:gap-x-12" data-tafel onsubmit="return false" novalidate>
        <!-- De schets -->
        <div class="min-w-0 lg:sticky lg:top-28 lg:col-span-7 lg:self-start">
          <h2 id="teken-titel" class="rijs text-3xl">Teken je <em class="text-ayous-licht">buitenkeuken.</em></h2>
          <p class="rijs mt-5 max-w-md text-lg text-mist">Het moderne design is standaard, maar jij bepaalt het formaat, de indeling en de opties.</p>
          <div class="mt-10 rounded-sm border border-lijn-licht bg-nacht p-3 sm:p-5">
            <svg viewBox="0 0 1000 400" class="h-auto w-full" role="img" aria-labelledby="schets-titel" data-schets>
              <title id="schets-titel">Schets van je buitenkeuken in vooraanzicht</title>
            </svg>
          </div>
          <p class="mt-3 min-h-[1.6em] text-sm text-mist" data-krap aria-live="polite"></p>
        </div>

        <!-- De keuzes -->
        <div class="min-w-0 space-y-9 lg:col-span-5 lg:pt-4">
          <fieldset>
            <legend class="flex w-full items-baseline justify-between gap-4 font-[600]"><span>Breedte, ongeveer</span><output class="num font-serif text-[1.9rem] font-normal leading-none text-ayous-licht" data-breedte-uit>300 cm</output></legend>
            <input type="range" min="150" max="500" step="5" value="300" class="schuif mt-3" aria-label="Breedte in centimeters" data-breedte />
            <p class="num mt-1 flex justify-between text-xs text-mist" aria-hidden="true"><span>150</span><span>500 cm</span></p>
          </fieldset>

          <fieldset>
            <legend class="font-[600]">Werkblad</legend>
            <div class="mt-2 flex flex-wrap gap-x-6">
              {[['keramisch steen', 'Keramisch steen'], ['beton-ciré', 'Beton-ciré'], ['', 'Weet ik nog niet']].map(([v, t], i) => (
                <label class="keuze"><input type="radio" name="blad" value={v} checked={i === 0} /><span class="bol"></span>{t}</label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend class="font-[600]">Fronten van Ayous</legend>
            <div class="mt-2 flex flex-wrap gap-x-6">
              {[['onbehandeld', 'Onbehandeld'], ['met UV-werende olie', 'UV-werende olie'], ['zwart', 'Zwart']].map(([v, t], i) => (
                <label class="keuze"><input type="radio" name="front" value={v} checked={i === 0} /><span class="bol"></span>{t}</label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend class="font-[600]">Wat moet erin?</legend>
            <div class="mt-2 grid gap-x-6 sm:grid-cols-2">
              {[['bbq', 'Inbouw gas-BBQ (4-pits)', true], ['kamado', 'Uitsparing voor een kamado', false], ['spoel', 'Spoelbak met mengkraan', true], ['boiler', 'Warmwater boiler', false], ['inductie', '2-pits inductie kookplaat', false]].map(([v, t, aan]) => (
                <label class="keuze"><input type="checkbox" name="erin" value={v as string} checked={aan as boolean} /><span class="bol vak"></span>{t}</label>
              ))}
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-x-6">
              <span class="text-sm text-mist">Mini-bar koeling</span>
              {['0', '1', '2'].map((v) => (
                <label class="keuze"><input type="radio" name="koeling" value={v} checked={v === '1'} /><span class="bol"></span>{v === '0' ? 'geen' : v === '1' ? '1x' : '2x'}</label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend class="font-[600]">Waar komt hij te staan?</legend>
            <div class="mt-2 flex flex-wrap gap-x-6">
              {[['in de tuin', 'In de tuin'], ['onder een overkapping of veranda', 'Onder een overkapping']].map(([v, t], i) => (
                <label class="keuze"><input type="radio" name="plek" value={v} checked={i === 0} /><span class="bol"></span>{t}</label>
              ))}
            </div>
          </fieldset>

          <div class="grid gap-6 sm:grid-cols-2">
            <label class="block"><span class="sr-only">Je naam</span><input type="text" class="veld" placeholder="Je naam" autocomplete="name" data-naam /></label>
            <label class="block"><span class="sr-only">Woonplaats</span><input type="text" class="veld" placeholder="Woonplaats" autocomplete="address-level2" data-plaats /></label>
          </div>

          <div>
            <a href={site.wa} class="knop w-full sm:w-auto" data-stuur><Icoon naam="wa" />Stuur deze schets via WhatsApp</a>
            <p class="mt-4 text-sm text-mist">Je krijgt een vrijblijvende prijsopgave. Foto's van de plek kun je in WhatsApp meesturen.</p>
          </div>
        </div>
      </form>
    </section>

    <!-- 6. Reviews: één grote, de rest als tekst -->
    <section id="reviews" class="py-24 md:py-28" aria-labelledby="rev-titel">
      <div class="wrap">
        <h2 id="rev-titel" class="sr-only">Reviews</h2>
        <figure class="rijs max-w-5xl">
          <blockquote class="font-serif text-[clamp(2.1rem,3vw+1rem,4rem)] leading-[1.02]">“Echt maatwerk geleverd en alles volledig volgens afspraak uitgevoerd.”</blockquote>
          <figcaption class="mt-6 flex items-center gap-3 text-sm text-grijs">
            <span class="flex gap-0.5 text-ayous" role="img" aria-label="5 sterren">{[0, 1, 2, 3, 4].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            {dean.naam}, Google review
          </figcaption>
        </figure>
        <div class="mt-16 grid gap-x-12 gap-y-10 border-t border-lijn pt-12 md:grid-cols-2 lg:grid-cols-4">
          {rest.map((r, i) => (
            <figure class="rijs" style={`--d:${i * .06}s`}>
              <blockquote class="text-[1.0625rem]">“{r.tekst}”</blockquote>
              <figcaption class="mt-4 text-sm text-grijs">{r.naam}, Google review</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Contact -->
    <section id="contact" class="relative bg-beton pb-24 md:pb-32" aria-labelledby="contact-titel">
      <div class="lamellen h-3" style="--lat:#a6612f; --naad:#4a2510; --b:11px" aria-hidden="true"></div>
      <div class="wrap grid gap-y-10 pt-20 md:pt-28 lg:grid-cols-12 lg:gap-x-12">
        <h2 id="contact-titel" class="rijs text-3xl lg:col-span-7">Offerte of info? Stuur een DM of <em class="text-ayous">WhatsApp.</em></h2>
        <div class="rijs lg:col-span-4 lg:col-start-9 lg:self-end">
          <div class="flex flex-wrap gap-3">
            <a href={site.wa} class="knop"><Icoon naam="wa" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-donker num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <p class="mt-6 text-grijs">Elke dag bereikbaar van <span class="num">10:00</span> tot <span class="num">18:00</span>. Levering: bezorging in overleg.</p>
          <p class="mt-3"><a href={site.instagram} class="link">Instagram</a> · <a href={site.tiktok} class="link">TikTok</a></p>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const f = document.querySelector<HTMLFormElement>('[data-tafel]');
  const svg = document.querySelector<SVGSVGElement>('[data-schets]');
  if (f && svg) {
    const NS = 'http://www.w3.org/2000/svg';
    const breedte = f.querySelector<HTMLInputElement>('[data-breedte]')!;
    const uit = f.querySelector<HTMLOutputElement>('[data-breedte-uit]')!;
    const krap = document.querySelector<HTMLElement>('[data-krap]')!;
    const naam = f.querySelector<HTMLInputElement>('[data-naam]')!;
    const plaats = f.querySelector<HTMLInputElement>('[data-plaats]')!;
    const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
    const titel = svg.querySelector('title')!;
    const kies = (n: string) => f.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value ?? '';
    const erin = () => [...f.querySelectorAll<HTMLInputElement>('input[name="erin"]:checked')].map((i) => i.value);

    // Kleuren van hun eigen materialen.
    const front: Record<string, [string, string]> = { onbehandeld: ['#b97a45', '#6b3a17'], 'met UV-werende olie': ['#93501f', '#4a240b'], zwart: ['#2c2a28', '#0e0d0c'] };
    const blad: Record<string, string> = { 'keramisch steen': '#d9d8d3', 'beton-ciré': '#b4aea5', '': '#8d8c88' };

    const k = 1.8;            // px per cm
    const grond = 300;        // y van de grond
    const H = 93 * k;         // hoogte van de keuken
    const top = grond - H;

    const el = (tag: string, a: Record<string, string | number>, ouder: Element = svg) => {
      const e = document.createElementNS(NS, tag);
      for (const [n, v] of Object.entries(a)) e.setAttribute(n, String(v));
      ouder.appendChild(e);
      return e;
    };
    const tekst = (x: number, y: number, t: string, extra: Record<string, string | number> = {}) => {
      const e = el('text', { x, y, 'text-anchor': 'middle', 'font-size': 23, fill: '#a9a8a3', 'font-family': 'Instrument Sans Variable, system-ui, sans-serif', ...extra });
      e.textContent = t;
      return e;
    };

    const teken = () => {
      [...svg.querySelectorAll(':scope > :not(title)')].forEach((n) => n.remove());
      const cm = +breedte.value;
      const W = cm * k;
      const x0 = (1000 - W) / 2;
      const [lat, naad] = front[kies('front')] ?? front.onbehandeld;
      const kleurBlad = blad[kies('blad')] ?? blad[''];
      const delen = erin();
      const n = +kies('koeling');

      // Overkapping als stippellijn, de grond als lijn.
      if (kies('plek').startsWith('onder')) {
        const ox = x0 - 40, ow = W + 80;
        el('path', { d: `M${ox} ${grond} V8 H${ox + ow} V${grond}`, fill: 'none', stroke: '#ffffff40', 'stroke-width': 2, 'stroke-dasharray': '10 8' });
      }
      el('line', { x1: 20, x2: 980, y1: grond, y2: grond, stroke: '#ffffff59', 'stroke-width': 1.5 });

      // Lamellen-patroon.
      const defs = el('defs', {});
      const pat = el('pattern', { id: 'lat', width: 4.2 * k, height: 10, patternUnits: 'userSpaceOnUse', x: x0 }, defs);
      el('rect', { width: 4.2 * k, height: 10, fill: lat }, pat);
      el('rect', { x: 4.2 * k - 1.6, width: 1.6, height: 10, fill: naad }, pat);

      // Indeling: modules van links naar rechts, de rest wordt lades.
      type Mod = { t: string; w: number };
      const mods: Mod[] = [];
      for (let i = 0; i < n; i++) mods.push({ t: 'koeling', w: 55 });
      if (delen.includes('spoel')) mods.push({ t: 'spoel', w: 60 });
      if (delen.includes('bbq')) mods.push({ t: 'bbq', w: 80 });
      if (delen.includes('inductie')) mods.push({ t: 'inductie', w: 60 });
      if (delen.includes('kamado')) mods.push({ t: 'kamado', w: 70 });
      const vast = mods.reduce((s, m) => s + m.w, 0);
      const rest = cm - 8 - vast; // 4 cm zijwand links en rechts
      const past = rest >= 0;
      const schaal = past ? 1 : (cm - 8) / vast;
      if (rest >= 30) mods.push({ t: 'lades', w: rest });

      // Zijwanden en blad (zoals hun keukens: het blad loopt als kader om de lamellen).
      el('rect', { x: x0, y: top, width: W, height: H - 4 * k, fill: 'url(#lat)' });
      el('rect', { x: x0, y: grond - 4 * k, width: W, height: 4 * k, fill: '#0b0b0a' });
      el('rect', { x: x0, y: top, width: 4 * k, height: H, fill: kleurBlad });
      el('rect', { x: x0 + W - 4 * k, y: top, width: 4 * k, height: H, fill: kleurBlad });

      // Het werkblad; BBQ, kraan en kamado steken erbovenuit.
      el('rect', { x: x0, y: top - 4 * k, width: W, height: 4 * k, fill: kleurBlad });

      let x = x0 + 4 * k;
      for (const m of mods) {
        const w = (m.t === 'lades' ? m.w : m.w * schaal) * k;
        const mx = x + w / 2;
        if (m.t === 'koeling') {
          el('rect', { x: x + 6, y: top + 18, width: w - 12, height: H - 30 - 4 * k, fill: '#16191b', stroke: '#000', 'stroke-width': 3 });
          el('rect', { x: x + 14, y: top + 26, width: w - 28, height: H - 46 - 4 * k, fill: '#24292d' });
          el('line', { x1: x + 22, x2: x + 22 + (w - 40) * .5, y1: top + 34, y2: top + 34 + (H - 70) * .6, stroke: '#ffffff1f', 'stroke-width': 6 });
          tekst(mx, top - 18, 'koeling');
        }
        if (m.t === 'spoel') {
          el('path', { d: `M${mx + 8} ${top} v-44 q0 -16 -16 -16 h-14 v10`, fill: 'none', stroke: '#0f0f0e', 'stroke-width': 6, 'stroke-linecap': 'round' });
          el('rect', { x: x + 10, y: top - 3, width: w - 20, height: 3, fill: '#0f0f0e' });
          if (delen.includes('boiler')) {
            el('rect', { x: x + 16, y: top + 40, width: w - 32, height: 70, fill: 'none', stroke: '#f2efe9', 'stroke-width': 1.5, 'stroke-dasharray': '7 6' });
            tekst(mx, top + 82, 'boiler', { fill: '#f2efe9', 'font-size': 19 });
          }
          tekst(mx, top - 88, 'spoelbak');
        }
        if (m.t === 'bbq') {
          el('rect', { x: x + 6, y: top + 10, width: w - 12, height: 38, fill: '#141414', rx: 2 });
          for (let i = 0; i < 4; i++) el('circle', { cx: x + 6 + (w - 12) * (i + 1) / 5, cy: top + 29, r: 6, fill: '#3a3a3a', stroke: '#9b9b9b', 'stroke-width': 1.5 });
          el('path', { d: `M${x + 4} ${top} v-26 q0 -22 26 -26 h${w - 60} q26 4 26 26 v26 z`, fill: '#1c1c1c', stroke: '#000', 'stroke-width': 2 });
          el('rect', { x: mx - 14, y: top - 44, width: 28, height: 6, rx: 3, fill: '#5c5c5c' });
          tekst(mx, top - 66, 'gas-BBQ');
        }
        if (m.t === 'inductie') {
          el('rect', { x: x + 8, y: top - 4, width: w - 16, height: 4, fill: '#050505' });
          tekst(mx, top - 18, 'inductie');
        }
        if (m.t === 'kamado') {
          el('rect', { x: x + 6, y: top + 6, width: w - 12, height: H - 10 - 4 * k, fill: '#0f0f0e' });
          el('path', { d: `M${x + 12} ${top + 30} C${x + 8} ${top - 30}, ${x + 20} ${top - 92}, ${mx} ${top - 94} C${x + w - 20} ${top - 92}, ${x + w - 8} ${top - 30}, ${x + w - 12} ${top + 30} Z`, fill: '#232323', stroke: '#000', 'stroke-width': 2 });
          el('line', { x1: x + 12, x2: x + w - 12, y1: top - 26, y2: top - 26, stroke: '#4a4a4a', 'stroke-width': 2 });
          el('rect', { x: mx - 10, y: top - 100, width: 20, height: 8, rx: 2, fill: '#3a3a3a' });
          tekst(mx, top - 112, 'kamado');
        }
        if (m.t === 'lades') {
          const kol = Math.max(1, Math.round(w / (60 * k)));
          const kw = w / kol;
          for (let c = 0; c < kol; c++) {
            const cx = x + c * kw;
            if (c > 0) el('line', { x1: cx, x2: cx, y1: top, y2: grond - 4 * k, stroke: '#0b0b0a', 'stroke-width': 3 });
            const hh = (H - 4 * k) / 3;
            for (let r = 1; r < 3; r++) el('line', { x1: cx + 8, x2: cx + kw - 8, y1: top + hh * r, y2: top + hh * r, stroke: '#0b0b0a', 'stroke-width': 4 });
            el('rect', { x: cx + 14, y: top + 4, width: kw - 28, height: 3, fill: '#0b0b0a' });
          }
          tekst(x + w / 2, top - 18, 'lades');
        }
        x += w;
      }

      // Maatlijn eronder.
      const my = grond + 34;
      el('line', { x1: x0, x2: x0, y1: grond + 10, y2: my + 10, stroke: '#d9925f', 'stroke-width': 1.5 });
      el('line', { x1: x0 + W, x2: x0 + W, y1: grond + 10, y2: my + 10, stroke: '#d9925f', 'stroke-width': 1.5 });
      el('line', { x1: x0, x2: x0 + W, y1: my, y2: my, stroke: '#d9925f', 'stroke-width': 1.5 });
      el('path', { d: `M${x0} ${my} l12 -5 v10 z M${x0 + W} ${my} l-12 -5 v10 z`, fill: '#d9925f' });
      const lab = tekst(500, my + 36, `ca. ${cm} cm`, { fill: '#d9925f', 'font-size': 28, 'font-weight': 600 });
      lab.setAttribute('class', 'num');

      // Op een smal scherm zoomt de schets in op de keuken zelf.
      const vbW = matchMedia('(max-width: 640px)').matches ? Math.max(W + 120, 560) : 1000;
      svg.setAttribute('viewBox', `${500 - vbW / 2} 0 ${vbW} 400`);

      uit.value = `${cm} cm`;
      krap.textContent = past ? '' : `Krap: dit past waarschijnlijk niet in ${cm} cm. Kies een grotere maat, of overleg over de indeling.`;
      const namen: Record<string, string> = { bbq: 'inbouw gas-BBQ (4-pits)', kamado: 'uitsparing voor een kamado', spoel: 'spoelbak met mengkraan', boiler: 'warmwater boiler', inductie: '2-pits inductie kookplaat' };
      const lijst = delen.map((d) => namen[d]);
      if (n) lijst.push(n === 1 ? 'mini-bar koeling' : '2x mini-bar koeling');
      titel.textContent = `Schets van een buitenkeuken van ongeveer ${cm} cm breed${lijst.length ? ', met ' + lijst.join(', ') : ''}.`;

      const regels = [
        'Hoi JS buitenkeukens, ik heb een schets gemaakt en wil graag een vrijblijvende prijsopgave.',
        '',
        `Breedte: ca. ${cm} cm`,
        `Werkblad: ${kies('blad') || 'weet ik nog niet'}`,
        `Fronten: Ayous, ${kies('front')}`,
        lijst.length ? `Erin: ${lijst.join(', ')}` : '',
        `Plek: ${kies('plek')}`,
        plaats.value.trim() ? `Woonplaats: ${plaats.value.trim()}` : '',
        naam.value.trim() ? `Naam: ${naam.value.trim()}` : '',
      ].filter((r, i) => r !== '' || i === 1);
      stuur.href = `https://wa.me/31638437139?text=${encodeURIComponent(regels.join('\n'))}`;
    };

    f.addEventListener('input', teken);
    f.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      // Een boiler zit onder de spoelbak.
      if (t.value === 'boiler' && t.checked) { const s = f.querySelector<HTMLInputElement>('input[value="spoel"]'); if (s) s.checked = true; }
      if (t.value === 'spoel' && !t.checked) { const b = f.querySelector<HTMLInputElement>('input[value="boiler"]'); if (b) b.checked = false; }
      teken();
    });
    teken();
    matchMedia('(max-width: 640px)').addEventListener('change', teken);
  }
</script>
