---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const werk = [['werk', 'Opgeleverd werk'], ['materiaal', 'Hout en werkbladen'], ['tekentafel', 'Tekentafel'], ['reviews', 'Reviews']];
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">Maatwerk buitenkeukens, uniek design. Diverse werkbladen en prijsklassen.</p>
      <p class="mt-5 flex gap-3">
        <a href={site.instagram} class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-lijn-licht text-wit transition-colors hover:border-wit" aria-label="Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
        <a href={site.tiktok} class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-lijn-licht text-wit transition-colors hover:border-wit" aria-label="TikTok"><Icoon naam="tiktok" class="h-[1.05rem] w-[1.05rem]" /></a>
      </p>
    </div>
    <div class="md:col-span-3">
      <p class="font-[640] text-wit">Op deze pagina</p>
      <ul class="mt-3 space-y-1">{werk.map(([id, t]) => <li><a href={url(`#${id}`)} class="no-underline hover:underline">{t}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-[640] text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1"><a href={site.instagram} class="link">@jsbuitenkeukens</a></p>
      <p class="mt-4">Levering: bezorging in overleg</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-[640] text-wit">Bereikbaar</p>
      <p class="mt-3">Elke dag<br /><span class="num">10:00 - 18:00</span></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam} · <span class="num">{site.google.score}</span> op Google uit {site.google.aantal} reviews</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's komen van jullie eigen Google-profiel en Instagram. Teksten en maten uit jullie Instagram-posts en bio, reviews letterlijk van Google (stand 9 oktober 2026).</p>}
</footer>
