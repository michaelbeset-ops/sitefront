---
// Woordmerk nagetekend naar hun eigen logo (Google, "Van eigenaar"): een dun kader, "JS" als holle schuine letters,
// daaronder "buitenkeukens" schuin in het bruin van het logo.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['merk inline-flex flex-col items-center border px-2.5 pb-1 pt-0.5 leading-none no-underline', licht ? 'border-wit/60 text-wit' : 'border-current', cls]}>
  <span class="js-hol font-serif text-[1.75rem] italic leading-[.95] tracking-[.02em]">JS</span>{" "}
  <span class:list={['-mt-0.5 text-[.72rem] font-[640] italic tracking-[.01em]', licht ? 'text-ayous-licht' : 'text-[currentColor]']}>buitenkeukens</span>
</a>

<style>
  .js-hol { -webkit-text-fill-color: transparent; -webkit-text-stroke: 1.1px currentColor; }
  @supports not (-webkit-text-stroke: 1px black) { .js-hol { -webkit-text-fill-color: currentColor; } }
</style>
