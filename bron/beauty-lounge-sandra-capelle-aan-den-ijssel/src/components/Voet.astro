---
import Streek from './Streek.astro';
import { site, url } from '../data/site';
---
<footer class="op-donker bg-inkt text-licht">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <Streek class="text-salie" />
      <p class="mt-4 font-kop text-3xl font-semibold tracking-[-0.02em]">Beauty Lounge Sandra</p>
      <p class="mt-4 max-w-sm text-sm text-licht/80">Schoonheidssalon in {site.plaats}. Permanente make-up, huidverbetering, wimpers, harsen en IPL.</p>
    </div>
    <div class="text-sm md:col-span-4">
      <p class="font-semibold">Langskomen</p>
      <p class="mt-3 text-licht/80">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.mobielHref} class="underline-offset-4 hover:underline">{site.mobiel}</a><br /><a href={`mailto:${site.email}`} class="underline-offset-4 hover:underline [overflow-wrap:anywhere]">{site.email}</a></p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="font-semibold">Ook te vinden op</p>
      <p class="mt-3"><a href={site.treatwell} class="underline underline-offset-4">Treatwell</a><br /><a href={url('privacy/')} class="underline underline-offset-4">Privacyverklaring</a></p>
    </div>
  </div>
  <div class="wrap border-t border-licht/15 py-5 text-xs text-licht/70">
    <p>De foto's op deze site zijn sfeerbeelden van Unsplash.</p>
  </div>
</footer>
