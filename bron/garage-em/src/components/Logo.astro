---
// Nagemaakt naar het eigen logo van garage-em.nl: grote E in grijs, M in geel, een klein wit & ertussen,
// met de regels "In & verkoop - APK - reparatie" en "De betaalbare garage". Als vector, dus altijd scherp.
// variant 'licht' = op een licht vlak (zoals het origineel), 'donker' = op grafiet (E iets lichter voor contrast).
// compact = alleen het E&M-beeldmerk (header).
interface Props { variant?: 'licht' | 'donker'; compact?: boolean; class?: string }
const { variant = 'licht', compact = false, class: cls = '' } = Astro.props;
const e = variant === 'licht' ? '#4f5657' : '#b9bfc0';
const tekst = variant === 'licht' ? '#23282a' : '#ffffff';
---
<svg
  aria-hidden="true"
  viewBox={compact ? '0 20 222 88' : '0 0 222 134'}
  class={cls}
  xmlns="http://www.w3.org/2000/svg"
>
  {!compact && (
    <text x="1" y="13" textLength="220" lengthAdjust="spacingAndGlyphs" fill={tekst} style="font-family:var(--font-display)" font-weight="700" font-size="13">IN &amp; VERKOOP - APK - REPARATIE</text>
  )}
  <path d="M0 22h92v20H34v12h44v20H34v12h58v20H0z" fill={e} />
  <path d="M110 106V22h30l25 36 25-36h30v84h-28V62l-27 36-27-36v44z" fill="#f7bb00" />
  <text x="101" y="99" text-anchor="middle" fill="#ffffff" stroke="#111415" stroke-width="3" paint-order="stroke" stroke-linejoin="round" style="font-family:var(--font-display)" font-weight="800" font-size="46">&amp;</text>
  {!compact && (
    <text x="1" y="130" textLength="220" lengthAdjust="spacingAndGlyphs" fill={tekst} style="font-family:var(--font-display)" font-weight="800" font-size="15">DE BETAALBARE GARAGE</text>
  )}
</svg>
