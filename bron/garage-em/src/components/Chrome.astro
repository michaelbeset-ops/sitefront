---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
const telIcoon = '<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>';
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-white/10 bg-petrol text-white">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-baseline gap-2 font-display text-xl font-extrabold tracking-[-0.03em] no-underline sm:text-2xl">
        <span>Garage <span class="text-geel">E&amp;M</span></span>
        <span class="hidden text-sm font-medium tracking-normal text-white/75 lg:inline">Tiel</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-semibold">
          <li><a href={`${url('')}#open`} class="no-underline hover:text-geel">Openingstijden</a></li>
          <li><a href={`${url('')}#offerte`} class="no-underline hover:text-geel">Offerte</a></li>
          <li><a href={`${url('')}#route`} class="no-underline hover:text-geel">Route</a></li>
          <li><a href={`${url('')}#contact`} class="no-underline hover:text-geel">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-geel !px-3.5 !py-2 text-sm"><Fragment set:html={telIcoon} /><span class="sm:hidden">Bellen</span><span class="hidden whitespace-nowrap tabular-nums sm:inline">{site.tel}</span></a>
    </div>
  </header>
) : (
  <footer class="bg-petrol-diep py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={`mailto:${site.mail}`} class="underline underline-offset-2">{site.mail}</a><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
