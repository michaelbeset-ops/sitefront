---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Logo from '../components/Logo.astro';
import { site, tijden, routes, klanten } from '../data/site';
import sfeer from '../assets/sfeer.jpg';
import verkoop from '../assets/verkoop.jpg';
import werk from '../assets/werk.jpg';
import gereedschap from '../assets/gereedschap.jpg';
import pand from '../assets/pand.png';
import werkplaats from '../assets/werkplaats.png';
const pijl = '<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const tel = '<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>';
const snel = [
  { href: '#verkoop', nr: '01', t: 'In- en verkoop' },
  { href: '#werkplaats', nr: '02', t: 'APK' },
  { href: '#werkplaats', nr: '03', t: 'Reparatie' },
];
---
<Base
  title="Garage E&M in Tiel | De betaalbare garage"
  description="Garage E&M, Faradaystraat 13 in Tiel: in- en verkoop, APK en reparatie. Open maandag t/m vrijdag 08:00 - 18:00 en zaterdag 09:00 - 13:00. Bel 0344 627 621."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: sfeervolle motorruimte onder werklicht, hun logo groot als kop, rechts de bewijzen (Google, open, tijden). -->
    <section class="relative isolate overflow-hidden bg-grafiet-diep text-white">
      <div class="absolute inset-0 -z-20 lg:left-[34%]">
        <Foto src={sfeer} hero alt="Een geopende motorruimte onder werklicht, met gereedschap op het motorblok" sizes="(min-width: 1024px) 66vw, 100vw" class="object-[60%_center]" />
      </div>
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-grafiet-diep/70 lg:bg-transparent lg:bg-linear-to-r lg:from-grafiet-diep lg:from-35% lg:via-grafiet-diep/70 lg:via-52% lg:to-transparent"></div>
      <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-linear-to-t from-grafiet-diep/90 to-transparent"></div>

      <div class="wrap grid gap-12 pb-24 pt-12 lg:grid-cols-12 lg:items-end lg:gap-10 lg:pb-40 lg:pt-14">
        <div class="lg:col-span-7">
          <p class="flex items-center gap-3 font-display text-sm font-semibold uppercase tracking-[0.16em] text-geel"><span aria-hidden="true" class="h-0.5 w-8 bg-geel"></span>Garage in {site.plaats}</p>
          <h1 class="mt-7">
            <span class="sr-only">Garage E&amp;M in Tiel. In- en verkoop, APK, reparatie. De betaalbare garage.</span>
            <Logo variant="donker" class="block h-auto w-full max-w-[36rem]" />
          </h1>
          <p class="mt-9 max-w-xl text-lg text-white/90">Aan de {site.straat} in {site.plaats}. Bel ons, stuur een mail of vraag online een offerte aan.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-geel text-lg"><Fragment set:html={tel} />Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            <a href={site.offerte} class="btn btn-line">Online offerte aanvragen <Fragment set:html={pijl} /></a>
          </div>
        </div>

        <div id="open" class="scroll-mt-20 rounded-xl bg-grafiet-diep/85 p-6 shadow-sm ring-1 ring-white/15 backdrop-blur-sm sm:p-7 lg:col-span-4 lg:col-start-9">
          <div class="flex items-end gap-4 border-b border-white/15 pb-5">
            <span class="font-display text-4xl font-extrabold leading-none text-geel">{site.google.score}</span>
            <span class="text-sm text-white/90">uit 5 op Google<br /><span class="whitespace-nowrap">{site.google.reviews} reviews</span></span>
          </div>
          <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="font-display text-base font-bold">Openingstijden</h2>
            <p data-nu-open class="invisible flex items-center gap-2 text-sm font-semibold" aria-live="polite"><span class="inline-block size-2.5 rounded-full"></span><span></span></p>
          </div>
          <table class="mt-3 w-full">
            <caption class="sr-only">Openingstijden {site.naam}</caption>
            <tbody>
              {tijden.map((t) => (
                <tr class="border-b border-white/15 last:border-0">
                  <th scope="row" class="py-3 pr-4 text-left font-normal text-white/90">{t.dag}</th>
                  <td class="whitespace-nowrap py-3 text-right font-display font-bold tabular-nums">{t.tijd}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Eigen pand als echte foto die over de rand van de hero valt, met snelkoppelingen naar de drie diensten van hun logo. -->
    <section aria-label="Ons pand en onze diensten" class="wrap relative z-10">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <figure class="-mt-16 lg:col-span-4 lg:-mt-28">
          <div class="relative w-fit max-w-full rounded-xl bg-white p-2 shadow-sm ring-1 ring-line">
            <Image src={pand} alt="Ons pand aan de Faradaystraat, met onze witte bedrijfsbus met het E&M-logo ervoor" width={296} format="webp" quality={82} loading="eager" decoding="async" class="block h-auto w-[296px] max-w-full rounded-md" />
            <figcaption class="absolute bottom-4 left-4 rounded-md bg-grafiet-diep px-2.5 py-1 text-xs font-semibold text-white">Ons pand, {site.straat}</figcaption>
          </div>
        </figure>
        <ul class="grid gap-px overflow-hidden rounded-xl bg-line shadow-sm ring-1 ring-line sm:grid-cols-3 lg:col-span-8 lg:mb-2">
          {snel.map((s) => (
            <li>
              <a href={s.href} class="group flex h-full items-center justify-between gap-4 bg-white px-5 py-5 no-underline transition-colors duration-200 hover:bg-geel">
                <span><span class="block font-display text-xs font-bold tabular-nums text-ink-soft group-hover:text-ink">{s.nr}</span><span class="whitespace-nowrap font-display text-lg font-extrabold tracking-[-0.02em]">{s.t}</span></span>
                <span class="transition-transform duration-200 group-hover:translate-x-1"><Fragment set:html={pijl} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- In- en verkoop: groot beeld links, tekst rechts. -->
    <section id="diensten" class="wrap scroll-mt-20 pb-16 pt-16 lg:pb-24 lg:pt-24">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-ink-soft">Wat we doen</p>
          <h2 class="mt-3 text-3xl">In- en verkoop, APK en reparatie</h2>
        </div>
        <p class="text-lg text-ink-soft lg:col-span-4 lg:col-start-9">Alle drie bij ons aan de {site.straat} in {site.plaats}.</p>
      </div>

      <div id="verkoop" class="mt-12 grid scroll-mt-24 gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-sm lg:col-span-7">
          <Foto src={verkoop} alt="Een rode auto in een lichte showroom met een balie en stoelen op de voorgrond" sizes="(min-width: 1216px) 680px, (min-width: 1024px) 56vw, 100vw" />
        </div>
        <div class="lg:col-span-5">
          <p class="font-display text-sm font-bold tabular-nums text-ink-soft">01</p>
          <h3 class="mt-2 text-2xl">In- en verkoop</h3>
          <div class="mt-4 h-0.5 w-12 bg-geel" aria-hidden="true"></div>
          <p class="mt-5 text-lg text-ink-soft">Een auto kopen of uw auto verkopen? Bel ons of kom langs aan de {site.straat}.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-grafiet"><Fragment set:html={tel} />Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line-donker">Mail ons</a>
          </div>
        </div>
      </div>
    </section>

    <!-- APK en reparatie op grafiet: twee grote beeldkaarten, met hun eigen werkplaatsfoto als klein echt inzetje. -->
    <section id="werkplaats" class="scroll-mt-20 bg-grafiet-diep py-16 text-white lg:py-24">
      <div class="wrap">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="flex items-center gap-3 font-display text-sm font-semibold uppercase tracking-[0.16em] text-geel"><span aria-hidden="true" class="h-0.5 w-8 bg-geel"></span>In de werkplaats</p>
            <h2 class="mt-4 text-3xl">APK en reparatie</h2>
            <p class="mt-5 max-w-xl text-lg text-white/90">Maak een afspraak door te bellen of te mailen. Wilt u eerst weten wat het kost? Vraag online een offerte aan.</p>
          </div>
          <figure class="lg:col-span-4 lg:col-start-9 lg:justify-self-end">
            <div class="w-fit max-w-full rounded-xl bg-white p-2 shadow-sm">
              <Image src={werkplaats} alt="Onze werkplaats: een auto op een brug, een tweede brug met een zwarte auto en rode oprijplaten op de vloer" width={296} format="webp" quality={82} loading="lazy" decoding="async" class="block h-auto w-[296px] max-w-full rounded-md" />
            </div>
            <figcaption class="mt-3 text-sm text-white/80">Onze eigen werkplaats aan de {site.straat}.</figcaption>
          </figure>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
          <article class="overflow-hidden rounded-xl bg-grafiet shadow-sm ring-1 ring-white/10">
            <div class="aspect-[3/2] overflow-hidden"><Foto src={gereedschap} alt="Een open koffer met doppen en een ratel" sizes="(min-width: 1216px) 560px, (min-width: 768px) 46vw, 100vw" /></div>
            <div class="p-6 sm:p-8">
              <p class="font-display text-sm font-bold tabular-nums text-geel">02</p>
              <h3 class="mt-2 text-2xl">APK</h3>
              <p class="mt-3 text-white/90">Voor de APK maakt u een afspraak: bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline decoration-geel decoration-2 underline-offset-4">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all underline decoration-geel decoration-2 underline-offset-4">{site.mail}</a>.</p>
            </div>
          </article>
          <article class="overflow-hidden rounded-xl bg-grafiet shadow-sm ring-1 ring-white/10">
            <div class="aspect-[3/2] overflow-hidden"><Foto src={werk} alt="Handen die een pakking aanbrengen aan de uitlaat onder een auto" sizes="(min-width: 1216px) 560px, (min-width: 768px) 46vw, 100vw" /></div>
            <div class="p-6 sm:p-8">
              <p class="font-display text-sm font-bold tabular-nums text-geel">03</p>
              <h3 class="mt-2 text-2xl">Reparatie</h3>
              <p class="mt-3 text-white/90">Vraag via onze offertemodule online een prijsopgave aan, of bel ons.</p>
              <a href={site.offerte} class="btn btn-geel mt-6">Online offerte aanvragen <Fragment set:html={pijl} /></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Wat klanten noemen: samenvatting van de Google-reviews, geen citaten. Past bij 'De betaalbare garage'. -->
    <section id="klanten" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-ink-soft">{site.slogan}</p>
          <h2 class="mt-3 text-3xl">Wat klanten noemen</h2>
          <div class="mt-8 flex items-end gap-4">
            <span class="font-display text-4xl font-extrabold leading-none">{site.google.score}</span>
            <span class="pb-1 text-ink-soft">uit 5 op Google<br /><span class="whitespace-nowrap">{site.google.reviews} reviews</span></span>
          </div>
          <p class="mt-6 max-w-sm text-sm text-ink-soft">Samenvatting van wat in de Google-reviews terugkomt (september 2026).</p>
        </div>
        <ol class="border-t-2 border-ink lg:col-span-7">
          {klanten.map((k, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] items-baseline gap-x-4 border-b border-line py-6 sm:grid-cols-[3.5rem_1fr]">
              <span aria-hidden="true" class="font-display text-sm font-bold tabular-nums text-ink-soft">0{i + 1}</span>
              <span>
                <span class="block font-display text-2xl font-extrabold tracking-[-0.02em]">{k.t}</span>
                {k.bij && <span class="mt-1 block text-ink-soft">{k.bij}</span>}
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Offerte: stevige grafiet kaart op kalk. -->
    <section id="offerte" class="scroll-mt-20 bg-kalk py-16 lg:py-20">
      <div class="wrap">
        <div class="grid gap-8 overflow-hidden rounded-xl bg-grafiet p-8 text-white shadow-sm sm:p-10 lg:grid-cols-12 lg:items-center lg:p-14">
          <div class="lg:col-span-7">
            <p class="flex items-center gap-3 font-display text-sm font-semibold uppercase tracking-[0.16em] text-geel"><span aria-hidden="true" class="h-0.5 w-8 bg-geel"></span>Online offerte</p>
            <h2 class="mt-4 text-3xl">Eerst weten wat het kost</h2>
            <p class="mt-5 max-w-xl text-lg text-white/90">Via onze offertemodule vraagt u online een prijsopgave aan. Liever eerst overleggen? Bel of mail ons gerust.</p>
          </div>
          <div class="flex flex-col gap-3 lg:col-span-5 lg:col-start-8 xl:col-span-4 xl:col-start-9">
            <a href={site.offerte} class="btn btn-geel">Online offerte aanvragen <Fragment set:html={pijl} /></a>
            <a href={site.telHref} class="btn btn-line"><Fragment set:html={tel} />Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-line">Mail ons</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Route: kies waar u vandaan komt, dan ziet u alleen de stappen die u nodig hebt. Zonder JS staan beide routes er. -->
    <section id="route" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-ink-soft">Route</p>
          <h2 class="mt-3 text-3xl">Zo rijdt u naar de Faradaystraat</h2>
          <p class="mt-5 text-lg text-ink-soft">U komt over de Industrieweg (N835). Kies waar u vandaan komt.</p>

          <div id="routekiezer" class="mt-8">
            <p id="waar" class="hidden font-display font-bold" data-alleen-js>Waar komt u vandaan?</p>
            <div role="group" aria-labelledby="waar" class="mt-3 hidden grid-cols-1 gap-2 min-[360px]:grid-cols-2 sm:max-w-md" data-alleen-js>
              {routes.map((r, i) => (
                <button type="button" data-kies={r.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`route-${r.id}`} class="kies rounded-md px-4 py-3 text-left font-display font-bold ring-2 ring-ink transition-colors duration-200">
                  <span class="block text-xs font-semibold uppercase tracking-[0.12em] opacity-80">Vanaf</span>{r.knop}
                </button>
              ))}
            </div>
            <div aria-live="polite" class="mt-6 grid gap-6">
              {routes.map((r) => (
                <div id={`route-${r.id}`} data-route={r.id} class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line md:p-8">
                  <h3 class="text-xl">{r.van}</h3>
                  <p class="mt-1 text-sm text-ink-soft">{r.via}</p>
                  <ol class="mt-6">
                    {r.stappen.map((s, i) => (
                      <li class="relative flex gap-4 pb-5 last:pb-0">
                        {i < r.stappen.length - 1 && <span aria-hidden="true" class="absolute bottom-1 left-[0.9375rem] top-9 w-0.5 bg-line"></span>}
                        <span aria-hidden="true" class={`relative flex size-8 shrink-0 items-center justify-center rounded-full font-display text-sm font-bold ${i === r.stappen.length - 1 ? 'bg-grafiet text-white' : 'bg-geel text-ink'}`}>{i + 1}</span>
                        <span class="pt-0.5">{s}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
            </div>
          </div>
        </div>

        <aside aria-label="Adres" class="lg:col-span-4 lg:col-start-9 lg:pt-10">
          <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-line sm:p-8 lg:sticky lg:top-24">
            <p class="font-display text-sm font-semibold uppercase tracking-[0.14em] text-ink-soft">Adres</p>
            <address class="mt-3 font-display text-2xl font-extrabold not-italic leading-tight tracking-[-0.02em]">{site.straat}<br />{site.postcode} {site.plaats}</address>
            <div class="mt-5 flex flex-wrap items-baseline justify-between gap-2 border-t border-line pt-5">
              <span class="text-ink-soft">Nu</span>
              <p data-nu-open data-licht class="invisible flex items-center gap-2 text-sm font-semibold"><span class="inline-block size-2.5 rounded-full"></span><span></span></p>
            </div>
            <a href={site.maps} rel="noopener" class="btn btn-grafiet mt-6 w-full">Open in Google Maps <Fragment set:html={pijl} /></a>
          </div>
        </aside>
      </div>
    </section>

    <!-- Contact op grafiet: nummer groot links, gegevens rechts. -->
    <section id="contact" class="scroll-mt-20 bg-grafiet text-white">
      <div class="wrap grid gap-10 py-16 lg:grid-cols-12 lg:py-20">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Bel, mail of kom langs</h2>
          <p class="mt-8 text-sm text-white/80">Telefoon</p>
          <a href={site.telHref} class="whitespace-nowrap font-display text-3xl font-extrabold tabular-nums underline decoration-geel decoration-2 underline-offset-[6px]">{site.tel}</a>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-geel"><Fragment set:html={tel} />Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
            <a href={site.offerte} class="btn btn-line">Online offerte</a>
          </div>
        </div>
        <dl class="grid gap-6 text-lg lg:col-span-5 lg:col-start-8 lg:border-l lg:border-white/15 lg:pl-10">
          <div><dt class="text-sm text-white/80">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-geel decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-white/80">Adres</dt><dd><address class="not-italic">{site.straat}<br />{site.postcode} {site.plaats}</address></dd></div>
          <div><dt class="text-sm text-white/80">Open</dt><dd>Ma t/m vr <span class="whitespace-nowrap tabular-nums">08:00 - 18:00</span><br />Za <span class="whitespace-nowrap tabular-nums">09:00 - 13:00</span></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
  <script>
    // 'Nu open' op basis van de openingstijden, in Nederlandse tijd.
    const d = new Intl.DateTimeFormat('nl-NL', { timeZone: 'Europe/Amsterdam', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    const get = (t: string) => d.find((p) => p.type === t)?.value ?? '';
    const dag = get('weekday').replace('.', '');
    const min = Number(get('hour')) * 60 + Number(get('minute'));
    const doordeweeks = ['ma', 'di', 'wo', 'do', 'vr'].includes(dag);
    const open = (doordeweeks && min >= 480 && min < 1080) || (dag === 'za' && min >= 540 && min < 780);
    document.querySelectorAll<HTMLElement>('[data-nu-open]').forEach((el) => {
      const [stip, tekst] = el.querySelectorAll<HTMLElement>('span');
      const licht = el.hasAttribute('data-licht');
      stip.style.background = open ? (licht ? '#1f8a4c' : '#3ecf7a') : (licht ? '#c2410c' : '#ff8a70');
      tekst.textContent = licht ? (open ? 'Open' : 'Gesloten') : (open ? 'Nu open' : 'Nu gesloten');
      el.classList.remove('invisible');
    });

    // Routekiezer: toont alleen de gekozen route. Zonder JS blijven beide routes zichtbaar.
    const kiezer = document.getElementById('routekiezer');
    if (kiezer) {
      kiezer.querySelectorAll<HTMLElement>('[data-alleen-js]').forEach((n) => n.classList.remove('hidden'));
      kiezer.querySelector<HTMLElement>('[role="group"]')?.classList.add('grid');
      const knoppen = kiezer.querySelectorAll<HTMLButtonElement>('[data-kies]');
      const kies = (id: string) => {
        knoppen.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.kies === id)));
        kiezer.querySelectorAll<HTMLElement>('[data-route]').forEach((r) => { r.hidden = r.dataset.route !== id; });
      };
      knoppen.forEach((k) => k.addEventListener('click', () => kies(k.dataset.kies!)));
      kies(knoppen[0].dataset.kies!);
    }
  </script>
</Base>

<style>
  .kies[aria-pressed='true'] { background: var(--color-ink); color: var(--color-white); }
  .kies[aria-pressed='false'] { background: var(--color-white); color: var(--color-ink); }
  .kies[aria-pressed='false']:hover { background: var(--color-geel); }
</style>
