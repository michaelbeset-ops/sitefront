---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-[-0.04em] text-ink no-underline">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="h-5 w-5 shrink-0"><path d="M0 10 10 0h5L5 10zM5 20l10-10h5L10 20z" fill="#9c6b3f"/><path d="M5 10 0 5V0l10 10zM20 15l-5-5h5z" fill="#23211e"/></svg>
        <span>PVC&nbsp;Design</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-medium">
          <li><a href={url('#vloeren')} class="no-underline transition-colors hover:text-oak-deep">Vloeren en trappen</a></li>
          <li><a href={url('#werkwijze')} class="no-underline transition-colors hover:text-oak-deep">Werkwijze</a></li>
          <li><a href={url('#winkel')} class="no-underline transition-colors hover:text-oak-deep">Winkel</a></li>
          <li><a href={url('#offerte')} class="no-underline transition-colors hover:text-oak-deep">Offerte</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-ink !px-4 !py-2.5 text-xs whitespace-nowrap">Bel <span class="hidden sm:inline tabular-nums">{site.tel}</span><span class="sm:hidden">ons</span></a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-lg font-semibold text-white">{site.naam}</strong><br />Vloerenwinkel<br />{site.straat}, {site.postcode} {site.plaats}</p>
      <p class="md:col-span-4">Telefoon <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a><br />KvK {site.kvk}</p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
