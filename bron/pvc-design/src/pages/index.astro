---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, tijden } from '../data/site';
import hero from '../assets/hero.jpg';
import visgraat from '../assets/visgraat.jpg';
import trap from '../assets/trap.jpg';
import kamer from '../assets/kamer.jpg';
---
<Base
  title="PVC Design | PVC-vloeren en trappen in Schoonhoven"
  description="Vloerenwinkel in Schoonhoven voor PVC-vloeren, ook in visgraat, en trappen bekleed met PVC. Kom langs aan de Robijnstraat 12 of bel 085 200 6112."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: tekst en foto naast elkaar, met een liniaal-strook eronder zoals een maatvoering op een bouwtekening. -->
    <section class="border-b border-line">
      <div class="grid lg:grid-cols-12">
        <div class="wrap flex flex-col justify-center py-12 lg:col-span-6 lg:mr-0 lg:max-w-none lg:py-20 lg:pl-[max(2rem,calc((100vw-76rem)/2+2rem))] lg:pr-12">
          <p class="label text-oak-deep">Vloerenwinkel in Schoonhoven</p>
          <h1 class="mt-5 text-4xl">PVC-vloeren en trappen</h1>
          <p class="mt-6 max-w-md text-lg text-ink-soft">Voor een nieuwe vloer, ook in visgraat, of een trap bekleed met PVC. Kom langs in de winkel aan de Robijnstraat of bel voor advies en een offerte.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#offerte" class="btn btn-oak">Offerte aanvragen</a>
            <a href={site.telHref} class="btn btn-line"><span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
        </div>
        <div class="relative aspect-[4/3] lg:col-span-6 lg:aspect-auto lg:min-h-[34rem]">
          <Foto src={hero} alt="Lichte woonkamer met een houten vloer, een bank en op de achtergrond een keuken" hero sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
      </div>
      <dl class="wrap grid grid-cols-1 divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        <div class="py-5 sm:pr-6">
          <dt class="label text-ink-soft">Google</dt>
          <dd class="mt-1.5 font-display text-xl font-semibold tracking-[-0.03em]"><span class="tabular-nums">{site.score}</span> <span class="text-sm font-normal text-ink-soft">uit 5, {site.reviews} reviews</span></dd>
        </div>
        <div class="py-5 sm:px-6">
          <dt class="label text-ink-soft">Vandaag</dt>
          <dd class="mt-1.5 font-display text-xl font-semibold tracking-[-0.03em]" data-vandaag>Ma t/m za open</dd>
        </div>
        <div class="py-5 sm:pl-6">
          <dt class="label text-ink-soft">Winkel</dt>
          <dd class="mt-1.5 font-display text-xl font-semibold tracking-[-0.03em]"><a href="#winkel" class="no-underline hover:text-oak-deep">{site.straat}</a></dd>
        </div>
      </dl>
    </section>

    <!-- Diensten: drie genummerde rijen, elk met een eigen beeldverhouding. -->
    <section id="vloeren" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="grid gap-6 lg:grid-cols-12">
        <h2 class="text-3xl lg:col-span-6">Wat we leggen en bekleden</h2>
        <p class="aanleveren lg:col-span-5 lg:col-start-8 lg:self-end">[[AANLEVEREN: assortiment en merken, en een prijsindicatie per m²]]</p>
      </div>

      <div class="mt-14 grid items-end gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="aspect-[3/2] overflow-hidden rounded-md lg:col-span-8">
          <Foto src={kamer} alt="Woonkamer van bovenaf gezien, met een lichte houten vloer" sizes="(min-width: 1024px) 800px, 100vw" />
        </div>
        <div class="lg:col-span-4 lg:pb-4">
          <p class="font-display text-sm font-medium text-oak-deep tabular-nums">01</p>
          <h3 class="mt-3 text-2xl">PVC-vloeren</h3>
          <p class="mt-3 text-ink-soft">Een nieuwe PVC-vloer, bij u thuis gelegd.</p>
          <p class="aanleveren mt-4">[[AANLEVEREN: soorten, kleuren en welke ruimtes]]</p>
        </div>
      </div>

      <div class="mt-16 grid gap-12 lg:mt-24 lg:grid-cols-12">
        <article class="lg:col-span-5">
          <div class="aspect-[4/5] overflow-hidden rounded-md">
            <Foto src={visgraat} alt="Close-up van een houten vloer in visgraatpatroon" sizes="(min-width: 1024px) 460px, 100vw" />
          </div>
          <p class="mt-6 font-display text-sm font-medium text-oak-deep tabular-nums">02</p>
          <h3 class="mt-3 text-2xl">Ook in visgraat</h3>
          <p class="mt-3 text-ink-soft">PVC-vloeren in een visgraatpatroon.</p>
          <p class="aanleveren mt-4">[[AANLEVEREN: toelichting visgraat, bijvoorbeeld varianten of legpatronen]]</p>
        </article>
        <article class="lg:col-span-6 lg:col-start-7 lg:pt-32">
          <div class="aspect-[4/3] overflow-hidden rounded-md">
            <Foto src={trap} alt="Moderne trap met houten treden en zwarte spijlen" sizes="(min-width: 1024px) 560px, 100vw" />
          </div>
          <p class="mt-6 font-display text-sm font-medium text-oak-deep tabular-nums">03</p>
          <h3 class="mt-3 text-2xl">Trappen</h3>
          <p class="mt-3 text-ink-soft">Uw trap bekleed met PVC.</p>
          <p class="aanleveren mt-4">[[AANLEVEREN: soorten trappen en afwerking]]</p>
        </article>
      </div>
    </section>

    <!-- Werkwijze: tijdlijn op het visgraatmotief. -->
    <section id="werkwijze" class="visgraat scroll-mt-20 py-16 lg:py-24">
      <div class="wrap">
        <div class="rounded-md bg-paper p-5 shadow-sm sm:p-8 md:p-12">
          <div class="grid gap-10 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <p class="label text-oak-deep">Werkwijze</p>
              <h2 class="mt-4 text-3xl">Van winkel tot gelegde vloer</h2>
            </div>
            <ol class="grid gap-0 lg:col-span-7 lg:col-start-6">
              <li class="grid grid-cols-[1.75rem_1fr] gap-3 sm:grid-cols-[3rem_1fr] sm:gap-4 border-t border-line py-6">
                <span class="font-display text-xl font-semibold text-oak-deep tabular-nums">1</span>
                <div>
                  <h3 class="text-lg sm:text-xl">Langskomen of bellen</h3>
                  <p class="mt-2 text-ink-soft">Kom naar de winkel aan de {site.straat} in {site.plaats}, of bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a>.</p>
                </div>
              </li>
              <li class="grid grid-cols-[1.75rem_1fr] gap-3 sm:grid-cols-[3rem_1fr] sm:gap-4 border-t border-line py-6">
                <span class="font-display text-xl font-semibold text-oak-deep tabular-nums">2</span>
                <div>
                  <h3 class="text-lg sm:text-xl">Inmeten en offerte</h3>
                  <p class="aanleveren mt-2">[[AANLEVEREN: hoe het inmeten gaat en wanneer u de offerte krijgt]]</p>
                </div>
              </li>
              <li class="grid grid-cols-[1.75rem_1fr] gap-3 sm:grid-cols-[3rem_1fr] sm:gap-4 border-y border-line py-6">
                <span class="font-display text-xl font-semibold text-oak-deep tabular-nums">3</span>
                <div>
                  <h3 class="text-lg sm:text-xl">Leggen</h3>
                  <p class="aanleveren mt-2">[[AANLEVEREN: hoe het leggen verloopt, voorbereiding van de ondervloer en in welk werkgebied]]</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Offerte: korte uitleg links, formulier rechts. -->
    <section id="offerte" class="wrap scroll-mt-20 py-16 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Offerte aanvragen</h2>
          <p class="mt-5 text-ink-soft">Vertel ons om welke ruimtes het gaat en ongeveer hoeveel vierkante meter. Liever direct overleggen? Bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a>.</p>
        </div>
        <form class="grid gap-5 sm:grid-cols-2 lg:col-span-7 lg:col-start-6" onsubmit="return false">
          <div>
            <label for="naam" class="text-sm font-semibold">Naam</label>
            <input id="naam" name="naam" autocomplete="name" class="field mt-1.5" />
          </div>
          <div>
            <label for="telefoon" class="text-sm font-semibold">Telefoon</label>
            <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" class="field mt-1.5" />
          </div>
          <div class="sm:col-span-2">
            <label for="email" class="text-sm font-semibold">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" class="field mt-1.5" />
          </div>
          <div>
            <label for="ruimtes" class="text-sm font-semibold">Ruimte(s)</label>
            <input id="ruimtes" name="ruimtes" placeholder="Bijv. woonkamer en keuken" class="field mt-1.5" />
          </div>
          <div>
            <label for="m2" class="text-sm font-semibold">Ongeveer aantal m²</label>
            <input id="m2" name="m2" inputmode="numeric" class="field mt-1.5" />
          </div>
          <fieldset class="sm:col-span-2">
            <legend class="text-sm font-semibold">Ook een trap?</legend>
            <div class="mt-2 flex gap-6">
              <label class="flex items-center gap-2"><input type="radio" name="trap" value="ja" class="h-4 w-4 accent-oak-deep" /> Ja</label>
              <label class="flex items-center gap-2"><input type="radio" name="trap" value="nee" class="h-4 w-4 accent-oak-deep" /> Nee</label>
            </div>
          </fieldset>
          <div class="sm:col-span-2">
            <label for="bericht" class="text-sm font-semibold">Bericht</label>
            <textarea id="bericht" name="bericht" rows="4" class="field mt-1.5"></textarea>
          </div>
          <div class="sm:col-span-2">
            {site.voorstel ? (
              <p class="rounded-md bg-oak-light p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap tabular-nums underline underline-offset-2">{site.tel}</a> of mail naar <span class="text-ink-soft">{site.mail}</span>.</p>
            ) : (
              <button type="submit" class="btn btn-oak">Offerte aanvragen</button>
            )}
          </div>
        </form>
      </div>
    </section>

    <!-- Winkel en contact: donker vlak met de openingstijden als tabel. -->
    <section id="winkel" class="scroll-mt-20 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-oak-glow">De winkel</p>
          <h2 class="mt-4 text-3xl">Kom langs in Schoonhoven</h2>
          <address class="mt-8 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.maps} rel="noopener" class="btn btn-oak">Route plannen</a>
            <a href={site.telHref} class="btn btn-line"><span class="whitespace-nowrap tabular-nums">{site.tel}</span></a>
          </div>
          <dl class="mt-10 grid gap-4">
            <div><dt class="text-sm text-white/70">E-mail</dt><dd class="text-sm text-white/80">{site.mail}</dd></div>
            <div><dt class="text-sm text-white/70">Over ons</dt><dd class="text-sm text-white/80">[[AANLEVEREN: over het bedrijf en de eigenaren]]</dd></div>
          </dl>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <h3 class="text-xl">Openingstijden</h3>
          <table class="mt-5 w-full text-lg">
            <caption class="sr-only">Openingstijden van de winkel</caption>
            <tbody>
              {tijden.map((t) => (
                <tr class="border-t border-white/15" data-dag={t.dag}>
                  <th scope="row" class="py-3 text-left font-normal">{t.naam}</th>
                  <td class="py-3 text-right whitespace-nowrap tabular-nums">{t.open ? `${t.open} tot ${t.dicht}` : 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
  <script is:inline define:vars={{ tijden }}>
    // Markeer vandaag in de tabel en vul de strook in de hero.
    const d = new Date().getDay();
    const t = tijden.find((x) => x.dag === d);
    const el = document.querySelector('[data-vandaag]');
    if (el && t) el.textContent = t.open ? `Open ${t.open} tot ${t.dicht}` : 'Gesloten';
    const rij = document.querySelector(`[data-dag="${d}"]`);
    if (rij) { rij.classList.add('text-oak-glow', 'font-semibold'); }
  </script>
</Base>
