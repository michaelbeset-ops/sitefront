---
import Base from '../../layouts/Base.astro';
import Kop from '../../components/Kop.astro';
import Voet from '../../components/Voet.astro';
import { site } from '../../data/site';
---
<Base title="Privacyverklaring | Bella by Nella" description="Hoe Bella by Nella in Dordrecht omgaat met je persoonsgegevens.">
  <Kop thuis={false} />
  <main id="inhoud" class="wrap py-16 lg:py-24">
    <article class="max-w-2xl [overflow-wrap:anywhere]">
      <p class="label text-mauve">Privacy</p>
      <h1 class="mt-5 text-3xl">Privacyverklaring</h1>
      <div class="mt-10 grid gap-8 text-mauve [&_h2]:mb-2 [&_h2]:text-xl [&_h2]:text-inkt">
        <section><h2>Wie zijn wij</h2><p>{site.naam}, {site.straat}, {site.postcode} {site.plaats}. Telefoon en WhatsApp {site.mobiel}.</p></section>
        <section><h2>Welke gegevens</h2><p>Als je belt, appt, online boekt of het formulier invult, ontvangen we je naam, je telefoonnummer of e-mailadres, de behandeling die je kiest en wat je ons vertelt.</p>
          {site.voorstel && <p class="mt-2">In dit ontwerpvoorstel verstuurt het formulier niets.</p>}</section>
        <section><h2>Waarvoor</h2><p>Alleen om je afspraak te plannen, je vraag te beantwoorden en je goed te helpen. We verkopen of delen je gegevens niet.</p></section>
        <section><h2>Online boeken</h2><p>Online boeken gaat via Salonized of Treatwell. Die diensten verwerken je gegevens volgens hun eigen privacyverklaring.</p></section>
        <section><h2>Hoe lang</h2><p>We bewaren je gegevens niet langer dan nodig. Gegevens voor de administratie bewaren we zolang de wet dat vraagt.</p></section>
        <section><h2>Cookies</h2><p>Deze website plaatst geen cookies en gebruikt geen analyse- of advertentiediensten. De foto's worden geladen van Unsplash. De links naar Google Maps, WhatsApp, Salonized en Treatwell openen die diensten pas als je erop klikt.</p></section>
        <section><h2>Je rechten</h2><p>Je mag je gegevens inzien, laten aanpassen of laten verwijderen. Neem daarvoor contact met ons op. Ben je het niet eens met hoe we met je gegevens omgaan, dan kun je een klacht indienen bij de Autoriteit Persoonsgegevens.</p></section>
      </div>
    </article>
  </main>
  <Voet />
</Base>
