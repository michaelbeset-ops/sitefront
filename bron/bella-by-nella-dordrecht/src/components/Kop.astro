---
import { site, url } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
// Op de homepage ligt de kop over de foto heen; op andere pagina's staat hij op poeder.
const h = (anker: string) => (thuis ? `#${anker}` : url(`#${anker}`));
---
<header class:list={[thuis ? 'op-donker absolute inset-x-0 z-30 text-room' : 'border-b border-lijn text-inkt']}>
  <div class="wrap flex items-center justify-between gap-6 py-5">
    <a href={url()} class="flex items-baseline gap-1 leading-none">
      <span class="font-kop text-2xl tracking-[-0.02em]">Bella</span>{' '}
      <span class="font-kop text-lg opacity-85">by Nella</span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden items-center gap-7 text-sm font-medium md:flex">
      <a href={h('behandelingen')} class="underline-offset-[6px] hover:underline">Behandelingen</a>
      <a href={h('reviews')} class="underline-offset-[6px] hover:underline">Reviews</a>
      <a href={h('nella')} class="underline-offset-[6px] hover:underline">Over Nella</a>
      <a href={h('langskomen')} class="underline-offset-[6px] hover:underline">Langskomen</a>
      <a href={site.boeken} class:list={['knop min-h-11 px-5', thuis ? 'knop-room' : 'knop-bes']}>Boek online</a>
    </nav>
    <a href={h('langskomen')} class="text-sm font-medium underline underline-offset-4 md:hidden">Adres en tijden</a>
  </div>
</header>
