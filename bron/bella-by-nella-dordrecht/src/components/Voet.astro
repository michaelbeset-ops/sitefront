---
import { site, url } from '../data/site';
---
<footer class="op-donker bg-inkt text-room">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-kop text-4xl">Bella <span class="text-2xl text-roze">by Nella</span></p>
      <p class="mt-4 max-w-sm text-sm text-room/80">Beautystudio aan huis in {site.plaats}. Nagels, pedicure, wenkbrauwen, make-up en gezichtsbehandelingen.</p>
    </div>
    <div class="text-sm md:col-span-4">
      <p class="font-semibold">Langskomen</p>
      <p class="mt-3 text-room/80">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.mobielHref} class="underline-offset-4 hover:underline">{site.mobiel}</a><br /><a href={site.boeken} class="underline-offset-4 hover:underline">Online boeken</a></p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="font-semibold">Ook te vinden op</p>
      <p class="mt-3"><a href={site.treatwell} class="underline underline-offset-4">Treatwell</a><br /><a href={site.facebook} class="underline underline-offset-4">Facebook</a><br /><a href={url('privacy/')} class="underline underline-offset-4">Privacyverklaring</a></p>
    </div>
  </div>
  <div class="wrap border-t border-room/15 py-5 text-xs text-room/70">
    <p>De foto's op deze site zijn sfeerbeelden van Unsplash.</p>
  </div>
</footer>
