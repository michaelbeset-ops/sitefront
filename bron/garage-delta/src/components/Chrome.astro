---
import { site, url, telIcoon } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="flex items-center gap-2.5 no-underline">
        <svg aria-hidden="true" viewBox="0 0 32 32" class="h-7 w-7 shrink-0"><rect width="32" height="32" rx="7" fill="#0e3a53"/><path d="M6 23 16 8l10 15z" fill="#b8430f"/></svg>
        <span class="font-display text-xl font-bold leading-none tracking-[-0.03em] text-zee">Garage Delta</span>
      </a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-7 text-sm font-bold">
          <li><a href="#werkplaats" class="no-underline transition-colors hover:text-sein">Werkplaats</a></li>
          <li><a href="#afspraak" class="no-underline transition-colors hover:text-sein">Afspraak</a></li>
          <li><a href="#contact" class="no-underline transition-colors hover:text-sein">Route en contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-sein !gap-2 !px-3.5 !py-2 text-sm">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current"><path d={telIcoon} /></svg>
        <span>Bel<span class="hidden sm:inline"> <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></span>
      </a>
    </div>
  </header>
) : (
  <footer class="op-donker bg-zee-diep py-10 text-white/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-lg text-white">{site.officieel}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
