---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, eigenschappen, telIcoon } from '../data/site';
import hero from '../assets/hero.jpg';
import monteur from '../assets/monteur.jpg';
import onderdelen from '../assets/onderdelen.jpg';
---
<Base
  title="Garage Delta | Garage in Middelharnis"
  description="Garage Delta aan de Oost Voorgors in Middelharnis. Onderhoud en reparatie van uw auto. Bel 0187 482 920 voor een afspraak."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Zeeblauw vlak met de tekst, de werkplaats ernaast. Op de telefoon eerst de belknop, dan de foto. -->
    <section class="op-donker relative bg-zee text-white">
      <div class="wrap relative grid lg:grid-cols-12">
        <div class="py-12 sm:py-16 lg:col-span-6 lg:py-28 lg:pr-10">
          <p class="label text-sein-licht">Oost Voorgors 1, Middelharnis</p>
          <h1 class="mt-4 text-4xl">Uw garage in Middelharnis</h1>
          <p class="mt-6 max-w-lg text-lg text-white/90">Garage Delta is een garagebedrijf op Goeree-Overflakkee. Voor onderhoud of een reparatie belt u ons voor een afspraak.</p>
          <div class="mt-8 flex flex-col items-start gap-4">
            <a href={site.telHref} class="btn btn-sein text-lg">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d={telIcoon} /></svg>
              Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span>
            </a>
            <a href="#afspraak" class="font-bold underline decoration-sein-licht decoration-2 underline-offset-4">Of vraag een afspraak aan</a>
          </div>
          <p class="mt-10 flex items-center gap-2 border-t border-white/20 pt-5 text-sm text-white/90">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 shrink-0 fill-sein-licht"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9z" /></svg>
            <span><strong class="text-white">{site.google.score}</strong> uit 5 op Google, {site.google.aantal} reviews</span>
          </p>
        </div>
      </div>
      <div class="aspect-[16/10] overflow-hidden sm:aspect-[16/8] lg:absolute lg:inset-y-0 lg:right-0 lg:aspect-auto lg:w-1/2">
        <Foto src={hero} alt="Werkplaats met een monteur aan een werkbank en een auto op de brug" hero sizes="(min-width: 1024px) 50vw, 100vw" class="object-[60%_center]" />
      </div>
    </section>

    <!-- Reviews samengevat: het cijfer groot, drie eigenschappen als genummerde regels. -->
    <section id="klanten" class="scroll-mt-20 bg-zand py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Wat klanten over ons zeggen</h2>
          <div class="mt-8 flex items-end gap-4">
            <p class="font-display text-5xl font-bold leading-[0.8] tracking-[-0.05em] text-zee tabular-nums">{site.google.score}</p>
            <p class="pb-1 text-sm leading-snug text-ink-soft">uit 5 op Google<br />{site.google.aantal} reviews</p>
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <ol class="divide-y divide-line border-y border-line">
            {eigenschappen.map((e, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-x-3 py-6">
                <span class="font-display text-lg font-bold text-dijk tabular-nums">0{i + 1}</span>
                <div>
                  <h3 class="text-2xl">{e.kop}</h3>
                  <p class="mt-2 text-ink-soft">{e.tekst}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="mt-5 text-sm text-ink-soft">Persoonlijk, snel en voor een eerlijke prijs: zo omschrijven klanten ons op Google.</p>
        </div>
      </div>
    </section>

    <!-- Werkplaats: grote foto links, tekst en detailfoto rechts. -->
    <section id="werkplaats" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="aspect-[4/3] overflow-hidden rounded-xl lg:col-span-7"><Foto src={monteur} alt="Monteur met zwarte handschoenen giet olie in de motor van een auto met open motorkap" sizes="(min-width: 1024px) 640px, 100vw" /></div>
        <div class="lg:col-span-5">
          <p class="label text-dijk">Werkplaats</p>
          <h2 class="mt-3 text-3xl">Onderhoud en reparatie</h2>
          <p class="mt-5 text-lg">Voor onderhoud en reparatie van uw auto kunt u bij Garage Delta terecht. Bel even, dan kijken we wanneer u langs kunt komen.</p>
          <p class="mt-4 text-sm text-ink-soft">[[AANLEVEREN: welke werkzaamheden u doet, bijvoorbeeld APK, banden of airco, en voor welke auto's]]</p>
          <div class="mt-8 aspect-[16/9] overflow-hidden rounded-xl"><Foto src={onderdelen} alt="Close-up van gebruikte metalen auto-onderdelen op een houten werkbank" sizes="(min-width: 1024px) 420px, 100vw" /></div>
        </div>
      </div>
    </section>

    <!-- Afspraak: korte uitleg met openingstijden, formulier in een witte kaart. -->
    <section id="afspraak" class="scroll-mt-20 border-t border-line py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Afspraak aanvragen</h2>
          <p class="mt-5 text-lg">Laat uw naam, telefoonnummer en kenteken achter en vertel kort wat er moet gebeuren. Liever direct overleggen? Bel <a href={site.telHref} class="whitespace-nowrap font-bold tabular-nums underline decoration-sein decoration-2 underline-offset-4">{site.tel}</a>.</p>
          <h3 class="mt-10 text-xl">Openingstijden</h3>
          <p class="mt-2 text-sm text-ink-soft">[[AANLEVEREN: openingstijden per dag]]</p>
        </div>
        <form class="grid gap-5 rounded-xl bg-white p-6 shadow-sm ring-1 ring-line sm:grid-cols-2 md:p-8 lg:col-span-6 lg:col-start-7" onsubmit="return false">
          <div>
            <label for="naam" class="block text-sm font-bold">Naam</label>
            <input id="naam" name="naam" type="text" autocomplete="name" class="veld mt-1.5" />
          </div>
          <div>
            <label for="telefoon" class="block text-sm font-bold">Telefoon</label>
            <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" class="veld mt-1.5" />
          </div>
          <div class="sm:col-span-2">
            <label for="kenteken" class="block text-sm font-bold">Kenteken</label>
            <input id="kenteken" name="kenteken" type="text" autocapitalize="characters" class="veld mt-1.5 uppercase sm:max-w-[14rem]" />
          </div>
          <div class="sm:col-span-2">
            <label for="werk" class="block text-sm font-bold">Wat moet er gebeuren?</label>
            <textarea id="werk" name="werk" rows="4" class="veld mt-1.5"></textarea>
          </div>
          {site.voorstel ? (
            <p class="rounded-lg bg-zand p-4 text-sm sm:col-span-2">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="whitespace-nowrap font-bold tabular-nums underline">{site.tel}</a>.</p>
          ) : (
            <button type="submit" class="btn btn-sein justify-self-start sm:col-span-2">Afspraak aanvragen</button>
          )}
        </form>
      </div>
    </section>

    <!-- Route en contact op zeeblauw. -->
    <section id="contact" class="op-donker scroll-mt-20 bg-zee py-16 text-white lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Route en contact</h2>
          <address class="mt-6 text-lg not-italic">{site.officieel}<br />{site.straat}<br />{site.postcode} {site.plaats}</address>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6">Route plannen</a>
        </div>
        <dl class="grid content-start gap-6 text-lg lg:col-span-6 lg:col-start-7">
          <div><dt class="text-sm text-white/80">Telefoon</dt><dd><a href={site.telHref} class="whitespace-nowrap font-display text-3xl font-bold tabular-nums underline decoration-sein-licht decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-white/80">E-mail</dt><dd class="text-base text-white/80">[[AANLEVEREN: e-mailadres]]</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
