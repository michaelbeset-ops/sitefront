---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, lunch, reviews, waHoi } from '../data/site';

import hero from '../assets/hero.jpg';
import john from '../assets/john.jpg';
import taart from '../assets/taart.jpg';
import zalm from '../assets/zalm.jpg';
import salade from '../assets/salade.jpg';
import plank from '../assets/plank.jpg';
import nachos from '../assets/nachos.jpg';
import glazen from '../assets/glazen.jpg';
import terras from '../assets/terras.jpg';


const titel = "Grandcafé M'n Moeder | Koffie, lunch en borrel aan de Kerkstraat, Leerdam";
const omschrijving = "Grandcafé M'n Moeder, Kerkstraat 33a in Leerdam: koffie met appeltaart, lunch van 11.30 tot 16.30 uur, speciaalbier en borrelplanken, terras. Reserveren via WhatsApp: 06 57 33 92 22.";
---
<Base title={titel} description={omschrijving}>
  <main id="inhoud">

    <!-- 1. HERO: hun eigen foto, schermvullend -->
    <section class="op-inkt relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col overflow-hidden bg-inkt text-krijt md:min-h-[100svh]">
      <Kop />
      <div class="absolute inset-0 -z-10 overflow-hidden">
        <Image src={hero} alt="In het café staat een medewerker van M’n Moeder met een borrelplank, achter haar de bar met koperen lampjes" quality={74} widths={[480, 768, 1080, 1440, 1600]} sizes="(min-width: 1024px) 124vw, 100vw" loading="eager" fetchpriority="high" class="w-full max-w-none object-cover max-lg:h-[116%] max-lg:-translate-y-[13%] max-lg:object-[52%_30%] lg:h-full lg:w-[124%] lg:object-[0%_32%]" />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,#1b1411b3_0%,#1b141126_24%,#1b141133_48%,#1b1411f2_100%)] lg:bg-[linear-gradient(90deg,#1b1411f0_0%,#1b1411c4_30%,#1b141100_56%),linear-gradient(180deg,#1b141199_0%,#1b141100_24%,#1b141100_68%,#1b1411b3_100%)]"></div>
      </div>
      <div class="wrap mt-auto pb-16 pt-40 md:pb-20 lg:pb-24">
        <p class="text-[.9375rem] font-semibold text-krijt/90">Grandcafé aan de Kerkstraat, Leerdam</p>
        <h1 class="mt-5 max-w-[12ch] text-hero">Het <span class="text-groen-licht">gezelligste</span> adres van de stad.</h1>
        <p class="mt-6 max-w-[34rem] text-lg text-krijt/90 md:text-xl max-sm:[@media(max-height:700px)]:hidden">Koffie met appeltaart, een uitgebreide lunch of een speciaalbiertje van de tap.<span class="max-sm:hidden"> Binnen bij het donkere hout, of buiten op het terras.</span></p>
        <div class="mt-8 flex flex-wrap gap-2.5 sm:gap-3">
          <a href={waHoi} class="knop knop-groen max-sm:min-h-12 max-sm:px-4"><Icoon naam="wa" /><span class="max-[379px]:hidden">Tafel reserveren</span><span class="min-[380px]:hidden">Reserveren</span></a>
          <a href="#lunch" class="knop knop-wit max-sm:min-h-12 max-sm:px-4">Lunchkaart</a>
        </div>
        <p class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-krijt/80 max-md:hidden" data-status-wrap>
          <span class="inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-groen-licht"></span><span data-status>Dinsdag t/m zaterdag vanaf 10.00 uur</span></span>
          <span>{site.straat}</span>
        </p>
      </div>
    </section>

    <!-- 2. KOM BINNEN: John achter de tap, zijn eigen woorden en het groene bord -->
    <section class="py-20 md:py-28">
      <div class="wrap grid items-start gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-5">
          <Image src={john} alt="John tapt een speciaalbiertje achter de bar, onder een koperen lamp" quality={70} widths={[480, 760, 1000]} sizes="(min-width: 1024px) 36vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_40%]" />
          <figcaption class="mt-3 text-sm text-grijs">John achter de tap</figcaption>
        </figure>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-10">
          <h2 class="rijs text-3xl">Even binnenlopen bij M’n Moeder</h2>
          <blockquote class="rijs mt-8 text-xl leading-relaxed md:text-2xl md:leading-snug">“Kom binnen voor een kop koffie met een stuk gebak, een drankje met een borrelhapje of laat u zich eens verrassen door onze kleine maar verrassende menukaart.”</blockquote>
          <p class="rijs mt-4 text-sm text-grijs">John Vuurens</p>

          <div class="rijs bord mt-14 rounded-sm px-7 py-8 md:px-10 md:py-10" style="--d:.1s">
            <p class="font-kop text-2xl leading-tight">Bij grandcafé M’n Moeder kun je o.a.</p>
            <ul class="mt-5 list-disc space-y-1.5 pl-5 text-lg marker:text-groen-licht">
              <li>koffie drinken met appeltaart</li>
              <li>lunchen tot half vijf</li>
              <li>borrelen met collega’s of vrienden</li>
              <li>een speciaalbiertje van de tap proeven</li>
              <li>een feestje vieren</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. KOFFIE & TAART -->
    <section id="koffie" class="bg-papier-2 py-20 md:py-28">
      <div class="wrap grid items-center gap-y-14 md:grid-cols-12 md:gap-x-16">
        <div class="md:col-span-5 md:order-2 md:col-start-8">
          <h2 class="rijs text-3xl">Koffie met appeltaart</h2>
          <p class="rijs mt-7 max-w-md text-lg text-grijs">Een cappuccino, latte of warme chocolademelk, met een punt appeltaart of de taart van de dag. Op het terras of binnen aan de bar.</p>
          <figure class="rijs mt-12 max-w-md border-l-2 border-groen pl-6">
            <blockquote class="text-lg leading-relaxed">“{reviews.koffie.tekst}”</blockquote>
            <figcaption class="mt-3 text-sm text-grijs">{reviews.koffie.naam} · Google</figcaption>
          </figure>
        </div>
        <figure class="rijs md:col-span-6 md:order-1">
          <Image src={taart} alt="Een latte macchiato en een punt appeltaart op een dienblad, gebracht door iemand in een M’n Moeder-shirt" quality={70} widths={[480, 760, 1000, 1200]} sizes="(min-width: 768px) 46vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_55%]" />
        </figure>
      </div>
    </section>

    <!-- 4. LUNCH: de kaart als echte menukaart -->
    <section id="lunch" class="py-20 md:py-28">
      <div class="wrap">
        <div class="grid items-end gap-y-8 md:grid-cols-12 md:gap-x-10">
          <h2 class="rijs text-3xl md:col-span-7">Lunch, van half twaalf tot half vijf</h2>
          <p class="rijs max-w-md text-lg text-grijs md:col-span-5">Van een snel broodje tot een uitgebreide lunchbreak. Met een groep? Dan stellen we graag een speciaal lunchmenu samen.</p>
        </div>
        <div class="mt-16 grid gap-y-14 md:mt-20 lg:grid-cols-12 lg:gap-x-16">
          <div class="lg:col-span-6">
            <ul class="rijs border-t border-lijn" aria-label="Lunchkaart">
              {lunch.map((g) => (
                <li class="kaartregel border-b border-lijn py-4">
                  <span class="font-kop text-xl">{g.naam}</span>
                  <span class="flex items-baseline gap-3"><span class="stip flex-1"></span><span class="wat text-[.9375rem] text-grijs">{g.wat}</span></span>
                </li>
              ))}
            </ul>
            <p class="rijs mt-5 text-sm text-grijs">Een greep uit de kaart.</p>
            <figure class="rijs mt-12 border-l-2 border-groen pl-6">
              <blockquote class="text-lg leading-relaxed">“{reviews.tosti.tekst}”</blockquote>
              <figcaption class="mt-3 text-sm text-grijs">{reviews.tosti.naam} · Google</figcaption>
            </figure>
          </div>
          <div class="grid gap-6 lg:col-span-6">
            <figure class="rijs">
              <Image src={zalm} alt="Gerookte zalm met salade, zongedroogde tomaat en bloemetjes op een blauw bord" quality={70} widths={[480, 760, 1000, 1300]} sizes="(min-width: 1024px) 44vw, 100vw" class="aspect-[3/2] w-full rounded-sm object-cover" />
            </figure>
            <figure class="rijs" style="--d:.1s">
              <Image src={salade} alt="Salade met geitenkaas, zongedroogde tomaat en walnoten" quality={70} widths={[480, 760, 1000, 1300]} sizes="(min-width: 1024px) 44vw, 100vw" class="aspect-[3/2] w-full rounded-sm object-cover" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. BORREL: donker, zoals het café 's avonds -->
    <section id="borrel" class="op-inkt bg-inkt text-krijt">
      <div class="grid lg:grid-cols-2">
        <div class="relative min-h-[30rem] lg:min-h-[42rem]">
          <Image src={plank} alt="Borrelplank met brood, worst, kaas en druiven naast een glas witte wijn op de donkere bar" quality={70} widths={[480, 760, 1000, 1138]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_62%]" />
        </div>
        <div class="flex items-center px-5 py-20 md:px-10 lg:px-20">
          <div class="max-w-lg">
            <h2 class="rijs text-3xl">Borrel en speciaalbier</h2>
            <p class="rijs mt-8 text-lg text-zacht">Hertog Jan van de tap, wisselende speciaalbieren en cocktails. Met een borrelplank of nacho’s erbij. Op vrijdag en zaterdag zijn we open tot één uur ’s nachts.</p>
            <p class="rijs mt-5 text-zacht">Volg ons op <a href={site.facebook} class="link text-krijt">Facebook</a> en <a href={site.instagram} class="link text-krijt">Instagram</a>.</p>
            <figure class="rijs mt-12 grid grid-cols-[7rem_1fr] items-center gap-5 sm:grid-cols-[9rem_1fr]">
              <Image src={nachos} alt="Nacho’s met kaas, groente en zure room op een houten plankje" quality={68} widths={[200, 300]} sizes="9rem" class="aspect-square w-full rounded-sm object-cover" />
              <figcaption class="text-sm text-zacht">Nacho’s, om te delen</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. RESERVEREN: de wow, een zin die je zelf afmaakt en via WhatsApp verstuurt -->
    <section id="reserveren" class="py-20 md:py-28">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-7">
          <h2 class="rijs text-3xl">Tafel, groep of feestje?</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-grijs">Voor groepen stellen we graag een speciaal lunchmenu samen. Ook voor bedrijfsfeesten of recepties zijn er volop mogelijkheden.</p>

          <form class="rijs bord mt-10 rounded-sm px-6 py-8 md:px-10 md:py-10" data-res novalidate>
            <p class="font-kop text-2xl leading-tight">Hoi M’n Moeder,</p>
            <div class="mt-6 grid gap-4 text-lg sm:grid-cols-2">
              <label class="sm:col-span-2"><span class="mb-1.5 block text-sm font-semibold text-krijt/85">ik wil graag</span>
                <select class="veld" name="wat">
                  <option value="een tafel reserveren">een tafel reserveren</option>
                  <option value="lunchen met een groep">lunchen met een groep</option>
                  <option value="een borrel of feestje geven">een borrel of feestje geven</option>
                </select>
              </label>
              <label><span class="mb-1.5 block text-sm font-semibold text-krijt/85">op</span><input class="veld num" type="date" name="datum" /></label>
              <label><span class="mb-1.5 block text-sm font-semibold text-krijt/85">rond</span><input class="veld num" type="time" name="tijd" value="12:30" step="900" /></label>
              <label><span class="mb-1.5 block text-sm font-semibold text-krijt/85">met</span>
                <span class="flex items-center gap-3"><input class="veld num w-24" type="number" name="aantal" value="2" min="1" max="200" inputmode="numeric" /><span>personen</span></span>
              </label>
              <label><span class="mb-1.5 block text-sm font-semibold text-krijt/85">mijn naam</span><input class="veld" type="text" name="naam" autocomplete="given-name" /></label>
            </div>
            <p class="mt-5 min-h-6 text-sm text-groen-licht" data-res-let aria-live="polite"></p>
            <a href={waHoi} class="knop knop-licht mt-4 whitespace-normal py-3 text-left leading-tight" data-res-knop><Icoon naam="wa" />Verstuur via WhatsApp</a>
          </form>
          <p class="rijs mt-5 text-sm text-grijs">Of bel ons: <a href={site.telHref} class="link num">{site.tel}</a></p>
        </div>
        <figure class="rijs max-lg:hidden lg:col-span-4 lg:col-start-9">
          <Image src={glazen} alt="Twee zomerse drankjes op een dienblad buiten, met de kerk aan de Kerkstraat erachter" quality={68} widths={[480, 760]} sizes="28vw" class="aspect-[9/16] w-full rounded-sm object-cover" />
        </figure>
      </div>
    </section>

    <!-- 7. BEZOEK: terras, reviews, tijden, adres -->
    <section id="bezoek" class="bg-papier-2 py-20 md:py-28">
      <div class="wrap">
        <div class="grid items-center gap-y-12 md:grid-cols-12 md:gap-x-14">
          <figure class="rijs md:col-span-7">
            <Image src={terras} alt="Het terras van M’n Moeder met oranje stoelen, parasols en een krijtbord, in de avondzon" quality={72} widths={[480, 760, 960]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[16/9] w-full rounded-sm object-cover" />
          </figure>
          <div class="space-y-10 md:col-span-5">
            {[reviews.terras, reviews.barman].map((x, i) => (
              <figure class="rijs" style={`--d:${i * 0.1}s`}>
                <blockquote class="text-xl font-semibold leading-snug md:text-2xl">“{x.tekst}”</blockquote>
                <figcaption class="mt-3 text-sm text-grijs">{x.naam} · Google</figcaption>
              </figure>
            ))}
          </div>
        </div>

        <div class="mt-20 grid gap-y-12 border-t border-lijn pt-16 md:mt-24 md:grid-cols-12 md:gap-x-12">
          <div class="md:col-span-4">
            <h2 class="rijs text-3xl">Kom langs</h2>
            <p class="rijs mt-6 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
            <p class="rijs mt-2 text-grijs">Midden in het centrum, met terras aan de Kerkstraat.</p>
            <p class="rijs mt-6"><a href={site.maps} class="link">Route plannen</a></p>
          </div>
          <div class="md:col-span-4">
            <table class="rijs w-full max-w-xs text-[1.0625rem]">
              <caption class="mb-3 text-left font-kop text-xl">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn data-[vandaag]:font-bold data-[vandaag]:text-groen">
                    <th scope="row" class="py-2 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-3 text-sm text-grijs" data-status></p>
          </div>
          <div class="md:col-span-4">
            <p class="rijs font-kop text-xl">Reserveren of iets vragen?</p>
            <p class="rijs mt-3 text-grijs">Stuur een appje of bel ons. Voor een tafel, een groepslunch of een feestje.</p>
            <div class="rijs mt-7 flex flex-col items-start gap-3">
              <a href={waHoi} class="knop knop-groen"><Icoon naam="wa" />WhatsApp</a>
              <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" />{site.tel}</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Reserveren: maak de zin af, de WhatsApp-knop neemt hem over. Verstuurt zelf niets.
  const f = document.querySelector<HTMLFormElement>('[data-res]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-res-knop]');
  const let_ = document.querySelector<HTMLElement>('[data-res-let]');
  if (f && knop && let_) {
    const datum = f.elements.namedItem('datum') as HTMLInputElement;
    const morgen = new Date(); morgen.setDate(morgen.getDate() + 1);
    const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    datum.min = iso(new Date());
    if (morgen.getDay() === 0) morgen.setDate(morgen.getDate() + 1);
    datum.value = iso(morgen);
    const tips: Record<string, string> = {
      'lunchen met een groep': 'We stellen graag een speciaal lunchmenu voor jullie samen.',
      'een borrel of feestje geven': 'Vertel er gerust bij wat je in gedachten hebt.',
    };
    const maak = () => {
      const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value.trim();
      const d = datum.value ? new Date(`${datum.value}T12:00`) : null;
      const dag = d ? new Intl.DateTimeFormat('nl-NL', { weekday: 'long', day: 'numeric', month: 'long' }).format(d) : '…';
      const n = Math.max(1, Number(v('aantal')) || 1);
      let zin = `Hoi M'n Moeder! Ik wil graag ${v('wat')} op ${dag} rond ${v('tijd') || '…'} uur, met ${n} ${n === 1 ? 'persoon' : 'personen'}.`;
      if (v('wat') === 'lunchen met een groep') zin += ' Kunnen jullie een lunchmenu voor ons samenstellen?';
      if (v('naam')) zin += ` Groet, ${v('naam')}`;
      knop.href = `https://wa.me/31657339222?text=${encodeURIComponent(zin)}`;
      let_.textContent = d && d.getDay() === 0 ? 'Let op: op zondag zijn we gesloten.' : tips[v('wat')] ?? '';
    };
    f.addEventListener('input', maak); f.addEventListener('change', maak); f.addEventListener('submit', (e) => e.preventDefault());
    maak();
  }
</script>
