---
// Hun eigen logo (wit, van grandcafemnmoeder.nl): "Grand Café M'n Moeder" met de sierkrul.
import { Image } from 'astro:assets';
import logo from '../assets/logo-wit.png';
import { url } from '../data/site';
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<a href={url('')} class="inline-flex shrink-0 items-center no-underline" aria-label="Grandcafé M’n Moeder: naar de homepage">
  <Image src={logo} alt="Grand Café M’n Moeder" widths={[150, 300]} sizes={klein ? '120px' : '(min-width: 768px) 125px, 105px'} class={klein ? 'h-[4.25rem] w-auto' : 'h-[3.75rem] w-auto md:h-[4.5rem]'} loading="eager" />
</a>
