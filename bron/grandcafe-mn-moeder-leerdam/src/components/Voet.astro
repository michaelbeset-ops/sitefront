---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="op-inkt bg-inkt pb-14 text-zacht md:pb-0">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-krijt md:col-span-4">
      <Merk klein />
      <p class="mt-6 max-w-xs text-zacht">Grandcafé met terras aan de Kerkstraat in Leerdam.</p>
    </div>
    <div class="md:col-span-4">
      <p class="font-kop text-lg text-groen-licht">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a> · <a href={waHoi} class="link">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-1"><a href={site.facebook} class="link">Facebook</a> · <a href={site.instagram} class="link">Instagram</a></p>
    </div>
    <div class="md:col-span-4">
      <p class="font-kop text-lg text-groen-licht">Open</p>
      <ul class="num mt-4 space-y-0.5">
        <li>Maandag {tijden[0].open} - {tijden[0].dicht}</li>
        <li>Dinsdag en woensdag {tijden[1].open} - {tijden[1].dicht}</li>
        <li>Donderdag {tijden[3].open} - {tijden[3].dicht}</li>
        <li>Vrijdag en zaterdag {tijden[4].open} - {tijden[4].dicht}</li>
        <li>Zondag gesloten</li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-inkt py-7 text-xs">
    <p>© {jaar} {site.vol}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-groen-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-10 text-xs md:pb-8">Foto’s van jullie eigen Google-profiel. Reviews letterlijk van Google (stand 7 oktober 2026).</p>}
</footer>
