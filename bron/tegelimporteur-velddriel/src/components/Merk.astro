---
// Nagetekend naar hun logo (bron/site/img/001_home.jpg): "tegelimporteur" in een ronde, dunne letter, met de "o"
// als vierkant tegeltje in het rood van het logo.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} aria-label="Tegelimporteur, naar de homepage" class={`inline-flex items-baseline font-kop text-[1.6rem] font-medium leading-none tracking-[-.025em] no-underline sm:text-[1.8rem] ${donker ? 'text-inkt' : 'text-wit'}`}>
  <span aria-hidden="true">tegelimp</span><span class="mx-[.06em] inline-block h-[.5em] w-[.5em] border-[.13em] border-[#f80000]" aria-hidden="true"></span><span aria-hidden="true">rteur</span>
</a>
