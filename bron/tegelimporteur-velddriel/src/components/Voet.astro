---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Icoon from './Icoon.astro';
const jaar = new Date().getFullYear();
const thuis = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const collectie = ['Marmerlook', 'Betonlook', 'Houtlook', 'Natuursteenlook', 'Hexagon', 'Portugese tegels', 'Wandtegels', 'Buitentegels 2 cm', 'Slabs'];
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.95rem] sm:grid-cols-2 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Tegelshowroom in {site.plaats}, voor zakelijk en particulier. Specialist in marmerlook tegels.</p>
      <a href={waHoi} class="knop knop-merk mt-7 min-h-11 px-5"><Icoon naam="wa" />WhatsApp</a>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Collectie</p>
      <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-2 lg:grid-cols-1">
        {collectie.map((t) => <li><a href={h('collectie')} class="no-underline transition-colors hover:text-merk-licht">{t}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <ul class="mt-5 space-y-2">
        <li><a href={site.telHref} class="num no-underline hover:text-merk-licht">{site.tel}</a> <span class="text-mist/80">(ook WhatsApp)</span></li>
        <li><a href={`mailto:${site.mail}`} class="no-underline hover:text-merk-licht">{site.mail}</a></li>
        <li>{site.straat}, {site.etage}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.route} class="no-underline hover:text-merk-licht">Route plannen</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-wit">Showroom</p>
      <ul class="mt-5 space-y-3">
        <li><span class="block text-wit">Zaterdag</span>{site.zaterdag.tekst}</li>
        <li><span class="block text-wit">Andere dagen</span>Op afspraak, overdag en 's avonds</li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.bedrijf} · KvK {site.kvk}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-8 text-xs">Teksten, collectiebeelden en projectfoto's van jullie eigen website tegelimporteur.nl. Reviews letterlijk van Google (stand 11 oktober 2026).</p>}
  <div class="h-14 md:hidden" aria-hidden="true"></div>
</footer>
