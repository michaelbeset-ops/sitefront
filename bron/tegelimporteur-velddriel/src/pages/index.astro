---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, waHoi, waMet } from '../data/site';

// Alle beelden komen van tegelimporteur.nl: collectiebeelden uit hun diashows, projectfoto's bij hun referenties
// en hun eigen foto van het pand. Zie src/assets/BRONNEN.txt.
import hero from '../assets/hero.jpg';
import cMarmer from '../assets/c-marmer.jpg';
import cBeton from '../assets/c-beton.jpg';
import cHout from '../assets/c-hout.jpg';
import cHexagon from '../assets/c-hexagon.jpg';
import cPortugees from '../assets/c-portugees.jpg';
import cGlazuur from '../assets/c-glazuur.jpg';
import marmerSfeer from '../assets/marmer-sfeer.jpg';
import pVastgoed from '../assets/p-vastgoed.jpg';
import pApollo from '../assets/p-apollo.jpg';
import pMiru from '../assets/p-miru.jpg';
import pand from '../assets/pand.jpg';
import stMarmer from '../assets/st-marmer.jpg';
import stBeton from '../assets/st-beton.jpg';
import stHout from '../assets/st-hout.jpg';
import stNatuursteen from '../assets/st-natuursteen.jpg';
import stTerrazzo from '../assets/st-terrazzo.jpg';
import stHexagon from '../assets/st-hexagon.jpg';
import stPortugees from '../assets/st-portugees.jpg';
import stGlazuur from '../assets/st-glazuur.jpg';
import { getImage } from 'astro:assets';

const vraag = (wat: string) => waMet(`Hallo Tegelimporteur, ik heb een vraag over ${wat}.`);

// Collectie: namen, maten en series uit hun eigen menu en categoriepagina's (bron/site/*.txt).
const collectie = [
  { t: 'Marmerlook', d: 'Wit, wit met grijs, goud of zwart, crème, grijs, bruin, groen en blauw.', m: 'Van 23x27 tot 160x320 cm', src: cMarmer, foto: 'Calcuta marmerlook', wa: 'marmerlook tegels' },
  { t: 'Betonlook', d: 'Series als Tempo, Stonella, Arkety en Assen, voor vloer en wand.', m: 'Van 30x60 tot 120x120 cm', src: cBeton, foto: 'Stonella dark grey', wa: 'betonlook tegels' },
  { t: 'Houtlook', d: 'Keramische houtlook tegels in lange planken.', m: '23x120 en 30x120 cm', src: cHout, foto: 'Cleveland Roble 23x120 cm', wa: 'houtlook tegels' },
  { t: 'Hexagon', d: 'Zeshoekige tegels, effen, met reliëf of in marmerlook.', m: 'Van 17,5x22,2 tot 25,8x29 cm', src: cHexagon, foto: 'Fantasy Mix', wa: 'hexagon tegels' },
  { t: 'Portugese tegels', d: 'Florentine Blue, Black en White van Mainzu, rode scherf.', m: '20x20 cm', src: cPortugees, foto: 'Florentine Blue', wa: 'Portugese tegels' },
  { t: 'Glazuur- en wandtegels', d: 'Opal bricks van Cifre, zellige, witjes en klassieke wandtegels.', m: 'Onder andere 7,5x30 en 10x10 cm', src: cGlazuur, foto: 'Opal bricks', wa: 'wandtegels' },
];
const ook = ['Natuursteenlook', 'Terrazzo', 'Buitentegels 2 cm', 'Slabs', 'Mozaïek', 'Zellige', 'Travertin', 'Kasteel look', 'Tapijtlook', 'Metaallook', 'Lantaarn tegels', 'Keramische wasbakken', 'Kranen'];

// Soorten marmerlook letterlijk van hun homepage.
const soorten = ['Carrara', 'Calacatta', 'Emperador', 'Port Laurent', 'Creme Marfil', 'Zwart marmer', 'Grijs'];
// Formaten uit hun categorie "Wit marmerlook maten", op schaal getekend.
const schaal = [[30, 60], [60, 60], [60, 120], [90, 90], [120, 120], [160, 320]];

// Projecten: alleen wat op hun eigen referentiepagina's staat.
const projecten = [
  { t: 'Vastgoed revitalisatie', p: 'Amsterdam', d: 'Badkamers en toiletten van een pand vernieuwd met Koren Grey 90x90 cm van Argenta tegen de wanden.', src: pVastgoed, alt: 'Badkamer met grote grijze wandtegels 90x90 cm' },
  { t: 'Grieks Restaurant Apollo', p: 'Grave', d: '200 m² houtlook vloer: Caoba wengé van Alaplana in 23x120 cm.', src: pApollo, alt: 'Restaurantzaal met donkere houtlook tegelvloer' },
  { t: 'Grill- en Sushi Restaurant Miru', p: 'Oss', d: '750 m² vloer- en wandtegels, met keramische platen van 1x3 m in de keuken.', src: pMiru, alt: 'Restaurant Miru met lange tegelvloer en sfeerverlichting' },
];
const meer = [
  ['Studentenhotel, Nijmegen', '2017', '900 m² betonlook, 350 m² hexagon en 395 m² wandtegels 30x90 cm'],
  ['Vakantiepark Herperduin', '2016 tot 2022', 'Vloeren en badkamers, 5.000 tot 10.000 m²'],
  ['University of Science, Amsterdam', '2021 tot 2022', '1.000 m² marmeren vloertegels, Keope 60x120 cm'],
  ['Hampshire Hotel Churchill, Terneuzen', 'Renovatie', '1.500 m² witte wandtegels 30x90 cm'],
  ['Hotel Sandeshoven, Nieuwpoort', '2015', '1.500 m² wandtegels voor de badkamers'],
  ['Restaurant Gildenborch, Nieuwegein', '2014', '700 m² tegels'],
];

const stappen = [
  ['Stuur je wens', 'Ruimte, look en aantal m², via WhatsApp of telefoon. Een foto van de ruimte helpt.'],
  ['Kom kijken', `In de showroom op de ${site.etage}. Zaterdag open, andere dagen op afspraak, ook 's avonds.`],
  ['Prijs op maat', 'Je krijgt een prijs voor jouw tegels. Voor projecten een offerte met een totaalprijs.'],
  ['Meenemen of laten brengen', 'Veel tegels zijn uit voorraad leverbaar. Bij transport helpen we mee.'],
];

// Aanvraag: looks met een staal uit hun eigen collectiebeelden.
const looks = [
  { id: 'Marmerlook', src: stMarmer },
  { id: 'Betonlook', src: stBeton },
  { id: 'Houtlook', src: stHout },
  { id: 'Natuursteenlook', src: stNatuursteen },
  { id: 'Terrazzo', src: stTerrazzo },
  { id: 'Hexagon', src: stHexagon },
  { id: 'Portugees', src: stPortugees },
  { id: 'Glazuur', src: stGlazuur },
];
const stalen = Object.fromEntries(await Promise.all(looks.map(async (l) => [l.id, (await getImage({ src: l.src, width: 400, quality: 72 })).src])));
// Formaten uit hun eigen categorieën (b x h in cm). 0 = geen raster tonen.
const formaten = [
  ['60x60', 60, 60], ['60x120', 60, 120], ['120x120', 120, 120], ['30x60', 30, 60], ['75x75', 75, 75], ['90x90', 90, 90], ['100x100', 100, 100],
  ['23x120 (houtlook)', 23, 120], ['30x120 (houtlook)', 30, 120], ['20x20 (Portugees)', 20, 20], ['7,5x30 (wandtegel)', 7.5, 30], ['Weet ik nog niet', 0, 0],
] as const;
const ruimtes = ['Badkamer', 'Keuken', 'Woonkamer', 'Toilet', 'Terras', 'Horeca of bedrijf'];
const sterren = [1, 2, 3, 4, 5];
---
<Base title="Tegelimporteur | Tegelshowroom in Velddriel, specialist in marmerlook tegels" description="Tegelimporteur in Velddriel: tegelshowroom voor zakelijk en particulier. Marmerlook, betonlook, houtlook, hexagon, Portugese tegels, wandtegels en slabs. Zaterdag open, andere dagen op afspraak.">
  <div class="relative">
    <Kop />

    <!-- 1. Hero: hun eigen collectiebeeld Negro Marquina (zwart marmerlook) met donker verloop -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit" aria-labelledby="inhoud">
      <Image src={hero} alt="" widths={[640, 960, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" quality={66} class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_50%] md:object-[50%_50%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#141111b3_0%,#14111159_28%,#141111d1_60%,#141111fa_100%)] md:bg-[linear-gradient(90deg,#141111f2_0%,#141111c7_36%,#14111140_68%,#14111126_100%),linear-gradient(180deg,#141111b3_0%,#14111100_30%,#14111100_70%,#141111c7_100%)]" aria-hidden="true"></div>

      <div class="wrap w-full pb-24 pt-36 md:pb-20 lg:pt-48">
        <div class="max-w-3xl">
          <p class="eyebrow eyebrow-licht">Tegelshowroom in {site.plaats}</p>
          <h1 id="inhoud" class="mt-6 text-hero">Specialist in <span class="text-merk-licht">marmerlook</span> tegels.</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-wit/90 md:text-[1.3rem]">De meeste maten staan uitgestald in onze showroom: Carrara, Calacatta, Emperador, Port Laurent, Creme Marfil en meer. Voor zakelijk en particulier.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#aanvraag" class="knop knop-merk">Tegels aanvragen<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-7 gap-y-2.5 text-[.95rem] text-wit/90">
            <li class="flex items-center gap-2"><span class="flex text-merk-licht" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-wit">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-merk-licht" /><span data-status>Zaterdag open, {site.zaterdag.tekst}</span></li>
          </ul>
        </div>
      </div>
      <p class="absolute bottom-7 right-10 hidden text-xs text-wit/60 lg:block">Collectiebeeld: Negro Marquina, zwart marmerlook</p>
    </section>
  </div>

  <main>
    <!-- 2. Cijfers: alleen echte cijfers uit hun eigen site en Google -->
    <section class="border-b border-lijn-licht bg-wit" aria-label="In het kort">
      <dl class="wrap grid grid-cols-2 gap-x-6 gap-y-9 py-11 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="mt-2 text-sm text-steen">cm: het grootste formaat marmerlook in de collectie</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-black leading-none tracking-[-.04em]">160x320</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">totaal volume van één project in Duitsland, vanaf 2015</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-black leading-none tracking-[-.04em]">120.000 m²</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">op Google, uit {site.google.aantal} reviews</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-black leading-none tracking-[-.04em] text-merk">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn-licht lg:pl-10"><dt class="mt-2 text-sm text-steen">oudste referenties: Gildenborch en Royal Astrid</dt><dd class="num order-first font-kop whitespace-nowrap text-[clamp(1.9rem,2vw+1.2rem,3.1rem)] font-black leading-none tracking-[-.04em]">2014</dd></div>
      </dl>
    </section>

    <!-- 3. Collectie: fotokaarten met hun eigen collectiebeelden -->
    <section id="collectie" class="py-24 md:py-32" aria-labelledby="t-coll">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Collectie</p>
            <h2 id="t-coll" class="mt-5 text-4xl">Van marmer tot mozaïek.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Spanje en Italië zijn marktleider in tegels. Wij importeren partijen en standaardcollecties van de diverse topmerken.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {collectie.map((c, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <article class="kaart group flex h-full flex-col overflow-hidden transition-shadow duration-300 hover:shadow-[0_12px_32px_#14111117]">
                <div class="relative overflow-hidden">
                  <Image src={c.src} alt={`${c.t}: collectiebeeld ${c.foto}`} widths={[420, 640, 820]} sizes="(min-width: 1024px) 400px, (min-width: 768px) 46vw, 100vw" quality={70} class="aspect-[3/2] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                  <span class="absolute bottom-3 left-3 rounded-[2px] bg-inkt/80 px-2 py-1 text-xs font-medium text-wit">{c.foto}</span>
                </div>
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <h3 class="text-[1.75rem]">{c.t}</h3>
                  <p class="mt-3 text-steen">{c.d}</p>
                  <p class="num mt-5 border-t border-lijn-licht pt-5 text-[.98rem] font-medium">{c.m}</p>
                  <a href={vraag(c.wa)} class="mt-auto inline-flex items-center gap-2 pt-6 font-bold text-merk no-underline transition-colors hover:text-merk-diep">Vraag het via WhatsApp<Icoon naam="pijl" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></a>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="rijs mt-12 flex flex-col gap-5 lg:flex-row lg:items-start lg:gap-10">
          <p class="shrink-0 pt-2 font-bold">Ook in de collectie</p>
          <ul class="flex flex-wrap gap-2.5">
            {ook.map((t) => <li class="chip">{t}</li>)}
          </ul>
        </div>
        <p class="rijs mt-10 border-l-4 border-merk bg-wit px-6 py-5 text-lg">Een groot deel van de tegels staat nog niet online. <span class="text-steen">Vraag gerust wat er in de showroom en op voorraad ligt.</span></p>
      </div>
    </section>

    <!-- 4. Marmerlook: donker, met hun collectiebeeld en formaten op schaal -->
    <section id="marmer" class="relative overflow-hidden bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-marmer">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-6">
          <Image src={marmerSfeer} alt="Woonkamer met marmerlook vloer en wand in wit met goud (collectiebeeld Adaggio gold)" widths={[600, 900, 1300]} sizes="(min-width: 1024px) 50vw, 100vw" quality={68} class="aspect-[4/3] w-full rounded-[2px] object-cover lg:aspect-[4/5]" />
          <figcaption class="mt-4 text-sm text-mist">Collectiebeeld: Adaggio gold, wit met goud marmerlook.</figcaption>
        </figure>
        <div class="lg:col-span-6">
          <p class="rijs eyebrow eyebrow-licht">Marmerlook</p>
          <h2 id="t-marmer" class="rijs mt-5 text-4xl">Elke maat in de showroom.</h2>
          <p class="rijs mt-7 text-lg leading-relaxed text-wit/90" style="--d:.06s">Marmerlook is onze specialiteit. De meeste uiteenlopende maten staan uitgestald in de showroom, van 23x27 tot 160x320 cm.</p>
          <ul class="rijs mt-8 flex flex-wrap gap-2.5" style="--d:.1s">
            {soorten.map((s) => <li class="chip chip-donker">{s}</li>)}
          </ul>
          <div class="rijs mt-12" style="--d:.14s">
            <p class="text-sm font-medium text-mist">Formaten uit de collectie, op schaal</p>
            <ul class="mt-5 flex flex-wrap items-end gap-x-4 gap-y-6 [--s:.32px] sm:[--s:.42px]">
              {schaal.map(([b, h]) => (
                <li class="flex flex-col items-start gap-2">
                  <span class={`schaal ${b === 160 ? 'schaal-groot' : ''}`} style={`--b:${b};--h:${h}`} aria-hidden="true"></span>
                  <span class="num text-xs text-mist">{b}x{h}</span>
                </li>
              ))}
            </ul>
          </div>
          <p class="rijs mt-10 border-t border-lijn pt-7 text-mist" style="--d:.18s"><b class="font-bold text-wit">Slabs:</b> keramische tegelplaten in groot formaat, onder andere 120x260, 150x300 en 160x320 cm, in marmer-, beton- en steenlook. Monsters en modellen staan in de showroom.</p>
        </div>
      </div>
    </section>

    <!-- 5. Zakelijk: referenties van hun eigen site -->
    <section id="zakelijk" class="py-24 md:py-32" aria-labelledby="t-zak">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zakelijk</p>
            <h2 id="t-zak" class="mt-5 text-4xl">Hotels, restaurants en vastgoed.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-steen lg:col-span-5 lg:col-start-8" style="--d:.05s">Wij leveren regelmatig tegels voor hotels, restaurants en overige horeca. Gezien het volume maken we dan een offerte met een totaalprijs.</p>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-16 lg:gap-6">
          {projecten.map((p, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <article class="kaart flex h-full flex-col overflow-hidden">
                <Image src={p.src} alt={p.alt} widths={[420, 640, 900]} sizes="(min-width: 768px) 32vw, 100vw" quality={70} class="aspect-[4/3] w-full object-cover" />
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <p class="text-sm font-medium text-steen">{p.p}</p>
                  <h3 class="mt-1 text-2xl">{p.t}</h3>
                  <p class="mt-3 text-steen">{p.d}</p>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="rijs mt-6 kaart">
          <ul class="divide-y divide-lijn-licht">
            {meer.map(([t, j, d]) => (
              <li class="grid gap-x-6 gap-y-1 px-6 py-5 sm:px-7 md:grid-cols-12 md:items-baseline">
                <p class="font-bold md:col-span-4">{t}</p>
                <p class="num text-sm text-steen md:col-span-2">{j}</p>
                <p class="num text-steen md:col-span-6">{d}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-[2px] bg-inkt px-7 py-7 text-wit sm:flex-row sm:items-center md:px-9">
          <p class="text-xl"><b class="font-kop font-black tracking-[-.02em]">Een project?</b> <span class="text-mist">Stuur de m² en de wensen, dan volgt een offerte.</span></p>
          <a href={vraag('tegels voor een project')} class="knop knop-merk shrink-0"><Icoon naam="wa" />Offerte vragen</a>
        </div>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section class="border-y border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="rijs max-w-2xl">
          <p class="eyebrow">Zo werkt het</p>
          <h2 id="t-werk" class="mt-5 text-4xl">Van idee tot tegel.</h2>
        </div>
        <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
          {stappen.map(([t, d], i) => (
            <li class="rijs flex flex-col border-t-2 border-inkt pt-7" style={`--d:${i * 0.06}s`}>
              <span class="stap-nr num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-6 text-2xl">{t}</h3>
              <p class="mt-3 text-steen">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Wow: proefvloer + aanvraag die eindigt in een vooraf ingevuld WhatsApp-bericht -->
    <section id="aanvraag" class="bg-inkt py-24 text-wit md:py-32" aria-labelledby="t-aanvraag">
      <div class="wrap">
        <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow eyebrow-licht">Tegels aanvragen</p>
            <h2 id="t-aanvraag" class="mt-5 text-4xl">Leg je vloer alvast.</h2>
          </div>
          <p class="rijs max-w-md text-lg text-mist lg:col-span-5 lg:col-start-8 lg:self-end" style="--d:.1s">Kies look en formaat en zie de voegen op schaal. Je aanvraag staat daarna klaar in WhatsApp.</p>
        </div>

        <form class="mt-12 grid gap-x-12 gap-y-12 md:mt-16 lg:grid-cols-12" data-aanvraag data-stalen={JSON.stringify(stalen)}>
          <div class="space-y-9 lg:col-span-7">
            <fieldset>
              <legend class="veld-label">Welke look?</legend>
              <div class="grid grid-cols-4 gap-x-3 gap-y-5 sm:gap-x-4">
                {looks.map((l, i) => (
                  <label class="staal">
                    <input type="radio" name="look" value={l.id} checked={i === 0} />
                    <Image src={l.src} alt="" width={160} height={160} quality={70} />
                    <span>{l.id}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label for="formaat" class="veld-label">Formaat (cm)</label>
                <select id="formaat" name="formaat" class="veld">
                  {formaten.map(([t, b, h]) => <option value={t} data-b={b} data-h={h}>{t}</option>)}
                </select>
              </div>
              <div>
                <label for="m2" class="veld-label">Aantal m²</label>
                <input id="m2" name="m2" class="veld num" inputmode="decimal" placeholder="bv. 24" />
              </div>
            </div>
            <fieldset>
              <legend class="veld-label">Voor welke ruimte?</legend>
              <div class="flex flex-wrap gap-2.5">
                {ruimtes.map((r, i) => <label class="keuze"><input type="radio" name="ruimte" value={r} checked={i === 0} />{r}</label>)}
              </div>
            </fieldset>
            <div class="grid gap-7 sm:grid-cols-2">
              <fieldset>
                <legend class="veld-label">Vloer of wand?</legend>
                <div class="flex flex-wrap gap-2.5">
                  {['Vloer', 'Wand', 'Allebei'].map((r, i) => <label class="keuze"><input type="radio" name="plek" value={r} checked={i === 0} />{r}</label>)}
                </div>
              </fieldset>
              <fieldset>
                <legend class="veld-label">Showroom bezoeken?</legend>
                <div class="flex flex-wrap gap-2.5">
                  {['Zaterdag', 'Op afspraak', 'Nog niet'].map((r, i) => <label class="keuze"><input type="radio" name="bezoek" value={r} checked={i === 2} />{r}</label>)}
                </div>
              </fieldset>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-8">
              <div class="vloer" data-vloer role="img" aria-label="Proefvloer van 2,4 bij 2,4 meter met voegen op schaal"></div>
              <p class="mt-3 flex justify-between gap-4 text-xs text-mist"><span>Proefvloer 2,4 x 2,4 m, voegen op schaal</span><span data-telling class="num"></span></p>
              <p class="veld-label mt-8">Jouw bericht</p>
              <p class="min-h-[7.5rem] whitespace-pre-line rounded-[2px] border-l-4 border-merk bg-inkt-2 px-5 py-4 text-[.98rem] leading-relaxed text-wit/90" data-voorbeeld aria-live="polite"></p>
              <a href={waHoi} class="knop knop-merk mt-5 w-full" data-verstuur target="_blank" rel="noopener"><Icoon naam="wa" />Versturen via WhatsApp</a>
              <p class="mt-3 text-center text-xs text-mist">Stuur in WhatsApp gerust een foto van de ruimte mee.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section class="py-24 md:py-32" aria-labelledby="t-rev">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-rev" class="mt-5 text-4xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md lg:col-span-4 lg:col-start-9 lg:justify-self-end" style="--d:.06s">
            <Icoon naam="g" class="h-9 w-9 flex-none" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-black leading-none">{site.google.score}</b><span class="flex text-merk" aria-hidden="true">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="mt-1 block text-sm text-steen">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-6">
          {reviews.map((r, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <figure class="kaart flex h-full flex-col p-7">
                <div class="flex gap-0.5 text-merk" role="img" aria-label="5 sterren">{sterren.map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
                <blockquote class="mt-5 flex-1 leading-relaxed">“{r.tekst}”</blockquote>
                <figcaption class="mt-6 flex items-center gap-3 border-t border-lijn-licht pt-5 text-sm">
                  <span class="grid h-9 w-9 flex-none place-items-center rounded-full bg-carrara-2 font-bold">{r.naam[0]}</span>
                  <span><b class="block font-bold">{r.naam}</b><span class="text-steen">Google review, {r.wanneer}</span></span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9. Showroom en contact: hun eigen foto van het pand -->
    <section id="showroom" class="border-t border-lijn-licht bg-wit py-24 md:py-32" aria-labelledby="t-show">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs lg:col-span-5">
          <Image src={pand} alt="Het pand aan De Geerden 24 in Velddriel, met de showroom op de eerste etage" widths={[420, 640, 828]} sizes="(min-width: 1024px) 38vw, 100vw" quality={72} class="aspect-[4/3] w-full rounded-[2px] object-cover object-[50%_60%] lg:aspect-[828/890]" />
          <figcaption class="mt-3 text-sm text-steen">De Geerden 24, showroom op de {site.etage}.</figcaption>
        </figure>
        <div class="lg:col-span-7">
          <p class="rijs eyebrow">Showroom</p>
          <h2 id="t-show" class="rijs mt-5 text-4xl">Kom kijken in Velddriel.</h2>
          <p class="rijs mt-8"><a href={site.telHref} class="num font-kop text-[clamp(2.1rem,4.6vw,3.8rem)] font-black leading-none tracking-[-.04em] text-inkt no-underline transition-colors hover:text-merk">{site.tel}</a></p>
          <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.08s">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />WhatsApp</a>
            <a href={`mailto:${site.mail}`} class="knop knop-rand">{site.mail}</a>
          </div>
          <div class="rijs kaart mt-10 overflow-hidden" style="--d:.12s">
            <ul class="grid divide-y divide-lijn-licht sm:grid-cols-2 sm:divide-x sm:divide-y-0">
              <li class="flex gap-4 p-6"><Icoon naam="pin" class="mt-0.5 h-5 w-5 flex-none text-merk" /><div><p class="font-bold">{site.naam}</p><p class="mt-1 text-steen">{site.straat}, {site.etage}<br />{site.postcode} {site.plaats}</p></div></li>
              <li class="flex gap-4 p-6"><Icoon naam="klok" class="mt-0.5 h-5 w-5 flex-none text-merk" /><div><p class="font-bold" data-status-kort>Openingstijden</p><p class="mt-1 text-steen">Zaterdag {site.zaterdag.tekst}<br />Andere dagen op afspraak, overdag en 's avonds</p></div></li>
            </ul>
            <a href={site.route} class="flex items-center justify-between gap-3 bg-inkt px-6 py-4 font-bold text-wit no-underline transition-colors hover:bg-merk">Route plannen<Icoon naam="pijl" class="h-5 w-5" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Slotbalk -->
    <section class="bg-merk text-wit" aria-label="Tegels aanvragen">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center md:py-14">
        <p class="font-kop text-3xl font-black leading-none tracking-[-.035em]">Op zoek naar tegels?</p>
        <a href="#aanvraag" class="knop knop-inkt shrink-0">Tegels aanvragen<Icoon naam="pijl" /></a>
      </div>
    </section>
  </main>

  <Voet />
</Base>

<script>
  import { site } from '../data/site';

  // Live status: zaterdag 10.00 tot 16.00 open, andere dagen op afspraak.
  const nu = new Date();
  const za = nu.getDay() === 6;
  const uur = nu.getHours() + nu.getMinutes() / 60;
  const open = za && uur >= site.zaterdag.open && uur < site.zaterdag.dicht;
  const s = document.querySelector('[data-status]');
  const sk = document.querySelector('[data-status-kort]');
  if (open) { if (s) s.textContent = 'Nu open, tot 16.00 uur'; if (sk) sk.textContent = 'Nu open, tot 16.00 uur'; }
  else if (sk) sk.textContent = za && uur < site.zaterdag.open ? 'Vandaag open vanaf 10.00 uur' : 'Nu op afspraak';

  // Aanvraag
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  const vb = document.querySelector<HTMLElement>('[data-voorbeeld]');
  const knop = document.querySelector<HTMLAnchorElement>('[data-verstuur]');
  const vloer = document.querySelector<HTMLElement>('[data-vloer]');
  const telling = document.querySelector<HTMLElement>('[data-telling]');
  if (f && vb && knop && vloer) {
    const stalen = JSON.parse(f.dataset.stalen || '{}') as Record<string, string>;
    const sel = f.querySelector<HTMLSelectElement>('#formaat')!;
    const zet = () => {
      const d = new FormData(f);
      const look = String(d.get('look'));
      const opt = sel.selectedOptions[0];
      const b = Number(opt.dataset.b), h = Number(opt.dataset.h);
      vloer.style.backgroundImage = `url("${stalen[look]}")`;
      const geen = !b || look === 'Hexagon';
      vloer.classList.toggle('geen-voeg', geen);
      if (!geen) { vloer.style.setProperty('--tw', `${(b / 240) * 100}%`); vloer.style.setProperty('--th', `${(h / 240) * 100}%`); }
      if (telling) telling.textContent = geen ? '' : `ca. ${Math.round((240 / b) * (240 / h))} tegels`;
      const m2 = String(d.get('m2') || '').trim();
      const ruimte = String(d.get('ruimte'));
      const plek = String(d.get('plek'));
      const bezoek = String(d.get('bezoek'));
      const r = ['Hallo Tegelimporteur, ik zoek tegels.'];
      r.push(`Look: ${look.toLowerCase()}${opt.value !== 'Weet ik nog niet' ? `, formaat ${opt.value.replace(/ \(.*\)/, '')} cm` : ''}.`);
      r.push(`Voor: ${ruimte.toLowerCase()}, ${plek === 'Allebei' ? 'vloer en wand' : plek.toLowerCase()}${m2 ? `, ongeveer ${m2} m²` : ''}.`);
      if (bezoek === 'Zaterdag') r.push('Ik kom graag op zaterdag naar de showroom.');
      if (bezoek === 'Op afspraak') r.push('Ik wil graag een afspraak in de showroom maken.');
      const t = r.join('\n');
      vb.textContent = t;
      knop.href = `${site.wa}?text=${encodeURIComponent(t)}`;
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => e.preventDefault());
    zet();
  }
</script>
