---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, reviews, feesten, waMet } from '../data/site';

import dansvloer from '../assets/dansvloer.jpg';
import gevel from '../assets/gevel.jpg';
import tafeldetail from '../assets/tafeldetail.jpg';
import bloemen from '../assets/bloemen.jpg';
import tafelRoze from '../assets/tafel-roze.jpg';
import tafelLila from '../assets/tafel-lila.jpg';
import zaalOverzicht from '../assets/zaal-overzicht.jpg';

const titel = 'Romance Weddings & Events | Partycentrum in Vlaardingen';
const omschrijving = 'Partycentrum Romance aan de Koningin Wilhelminahaven in Vlaardingen: twee zalen in Victoriaanse stijl, elk voor 200 gasten aan tafel of 300 staand. Voor bruiloften, verlovingen, henna-avonden en meer.';
const soorten = ['Bruiloften', 'Verlovingen', 'Henna-avonden', 'Verjaardagen', 'Jubilea', 'Zakelijke events'];
const [youssra, hina, akash, hamid] = reviews;
const waStart = waMet('Hallo Romance, wij zoeken een zaal. Is er nog een datum vrij?');
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. HERO: licht, de zaal in een boog zoals hun ramen -->
    <section class="relative overflow-hidden">
      <div class="wrap grid items-center gap-y-10 pb-16 pt-6 md:pt-10 lg:min-h-[calc(100svh-6rem)] lg:grid-cols-12 lg:gap-x-12 lg:py-12">
        <div class="order-2 lg:order-1 lg:col-span-6">
          <p class="text-label font-semibold uppercase tracking-[.2em] text-framboos">Partycentrum in Vlaardingen</p>
          <h1 class="mt-5 text-hero leading-[.95]">Feesten onder de kroonluchters</h1>
          <p class="mt-7 max-w-md text-lg text-zacht">Twee zalen in Victoriaanse stijl aan de haven. Elke zaal heeft plek voor 200 gasten aan tafel, of 300 staand.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href="#aanvragen" class="knop">Vraag je datum aan<Icoon naam="pijl" /></a>
            <a href={site.telHref} class="num font-medium text-inkt no-underline transition-colors hover:text-framboos">of bel {site.tel}</a>
          </div>
        </div>
        <figure class="order-1 lg:order-2 lg:col-span-6">
          <div class="boog mx-auto aspect-square w-full max-w-[34rem] bg-kalk lg:max-w-none" style="--bv:50%">
            <Image src={dansvloer} alt="Een van de zalen: kristallen kroonluchter, witte stoelen met krullen, boogramen en een verlichte glazen dansvloer voor de bar" quality={76} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 46vw, 92vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[38%_50%]" />
          </div>
          <figcaption class="mt-3 text-center text-xs text-zacht lg:text-right">De LED-dansvloer, met de bar erachter</figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. HET PAND: baksteen buiten, en hoe je er komt -->
    <section id="route" class="bg-kalk py-20 md:py-28">
      <div class="wrap grid items-center gap-y-12 md:grid-cols-12 md:gap-x-12">
        <figure class="rijs md:col-span-6">
          <Image src={gevel} alt="De bakstenen gevel aan de haven met het lichtgevende Romance-logo boven de deur, boogramen met witte sierfolie en blauwe luiken" quality={74} widths={[480, 720, 960]} sizes="(min-width: 768px) 48vw, 92vw" class="aspect-[4/5] w-full object-cover object-[50%_70%] md:aspect-[5/6]" />
        </figure>
        <div class="md:col-span-6 lg:col-span-5 lg:col-start-8">
          <h2 class="rijs text-3xl">Baksteen buiten, stucwerk binnen</h2>
          <p class="rijs mt-7 max-w-md text-zacht">Je vindt Romance aan de Koningin Wilhelminahaven, centraal in de Randstad. Goed bereikbaar vanaf de A13, A20, A15 en A4, met gratis parkeren.</p>
          <dl class="rijs mt-10 max-w-md border-t border-lijn text-sm">
            <div class="flex justify-between gap-6 border-b border-lijn py-4"><dt class="text-zacht">Adres</dt><dd class="text-right">{site.straat}<br />{site.postcode} {site.plaats}</dd></div>
            <div class="flex justify-between gap-6 border-b border-lijn py-4"><dt class="text-zacht">Snelwegen</dt><dd class="text-right">A13 · A20 · A15 · A4</dd></div>
            <div class="flex justify-between gap-6 border-b border-lijn py-4"><dt class="text-zacht">Parkeren</dt><dd class="text-right">Gratis</dd></div>
          </dl>
          <a href={site.maps} class="rijs knop knop-rand mt-9">Route plannen<Icoon naam="pijl" /></a>
        </div>
      </div>
    </section>

    <!-- 3. DE ZALEN: groot beeld, één zin -->
    <section id="zalen" class="py-20 md:py-28">
      <div class="wrap">
        <h2 class="rijs max-w-4xl text-3xl">Twee zalen, elk voor 200 gasten aan tafel of 300 staand</h2>
        <div class="mt-14 grid gap-6 md:mt-20 md:grid-cols-12 md:gap-x-8">
          <figure class="rijs md:col-span-8">
            <Image src={zaalOverzicht} alt="Zaal met roze gordijnen, kroonluchter, witte stoelen met gouden poten en hoge bloemstukken op de tafels" quality={76} widths={[640, 1000]} sizes="(min-width: 768px) 62vw, 92vw" class="aspect-[4/3] w-full object-cover object-[50%_60%]" />
          </figure>
          <figure class="rijs md:col-span-4 md:self-end" style="--d:.1s">
            <div class="boog aspect-[12/13] w-full" style="--bv:46%">
              <Image src={bloemen} alt="Witte stoelen met gouden poten rond een tafel, met een hoge pilaar van roze en witte bloemen" quality={74} widths={[400, 640, 900]} sizes="(min-width: 768px) 30vw, 92vw" class="h-full w-full object-cover" />
            </div>
          </figure>
        </div>
        <div class="mt-6 grid gap-6 md:mt-8 md:grid-cols-12 md:gap-x-8">
          <div class="rijs md:col-span-4 md:col-start-1 md:pt-10">
            <ul class="space-y-4 text-zacht">
              <li class="border-t border-lijn pt-4"><span class="text-inkt">Victoriaanse stijlelementen</span> en kroonluchters</li>
              <li class="border-t border-lijn pt-4"><span class="text-inkt">LED-dansvloer</span> om op te dansen na de ceremonie</li>
              <li class="border-t border-lijn pt-4"><span class="text-inkt">Catering</span> kunnen wij voor je regelen</li>
            </ul>
          </div>
          <figure class="rijs md:col-span-4 md:col-start-6" style="--d:.05s">
            <div class="boog aspect-[3/4] w-full" style="--bv:37.5%">
              <Image src={tafelRoze} alt="Ronde tafel met witte stoelen en een tafelloper van roze bloemen onder een groot boogvenster" quality={74} widths={[400, 640, 900]} sizes="(min-width: 768px) 30vw, 92vw" class="h-full w-full object-cover" />
            </div>
          </figure>
        </div>
      </div>
    </section>

    <!-- 4. FEESTEN: donker, hun eigen zin en een lijst in groot schrift -->
    <section id="feesten" class="bg-nacht py-20 text-wit md:py-28">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs mx-auto w-full max-w-sm lg:col-span-4 lg:max-w-none">
          <div class="boog aspect-[3/4] w-full" style="--bv:37.5%">
            <Image src={tafelLila} alt="Gedekte ronde tafel met wit linnen, gouden stoelen en een lila bloemstuk tussen twee boogramen" quality={74} widths={[400, 640, 900]} sizes="(min-width: 1024px) 30vw, 80vw" class="h-full w-full object-cover" />
          </div>
        </figure>
        <div class="lg:col-span-7 lg:col-start-6">
          <h2 class="rijs text-2xl text-roze">Bij Romance kun je terecht voor álle feesten</h2>
          <ul class="mt-8 border-t border-lijn-licht">
            {soorten.map((s, i) => (
              <li class="rijs border-b border-lijn-licht py-3 md:py-4" style={`--d:${i * 0.05}s`}>
                <span class="font-kop text-[clamp(2rem,2.4vw+1.1rem,3.5rem)] leading-none">{s}</span>
              </li>
            ))}
          </ul>
          <p class="rijs mt-9 max-w-lg text-mist">Je hebt al genoeg te regelen. Wij denken graag met je mee over entertainment, decoratie, catering en andere zaken op je feest.</p>
        </div>
      </div>
    </section>

    <!-- 5. ERVARINGEN: één grote stem, drie kleine -->
    <section id="ervaringen" class="py-20 md:py-28">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <figure class="rijs lg:col-span-7">
          <blockquote class="font-kop text-[clamp(1.6rem,1.6vw+1.1rem,2.75rem)] leading-[1.15]">“{youssra.tekst}”</blockquote>
          <figcaption class="mt-7 text-sm text-zacht"><span class="font-semibold text-inkt">{youssra.naam}</span>, {youssra.rol} · Google</figcaption>
        </figure>
        <div class="lg:col-span-4 lg:col-start-9">
          <ul class="space-y-8">
            {[hina, akash, hamid].map((r, i) => (
              <li class="rijs border-t border-lijn pt-6" style={`--d:${i * 0.08}s`}>
                <p class="flex gap-0.5 text-framboos" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-3.5 w-3.5" />)}</p>
                <p class="mt-3">“{r.tekst}”</p>
                <p class="mt-3 text-sm text-zacht">{r.naam} · Google</p>
              </li>
            ))}
          </ul>
          <p class="rijs mt-10 flex items-center gap-3 text-sm text-zacht">
            <Icoon naam="g" class="h-5 w-5" />
            <span><span class="num">{site.google.score}</span> op Google · <a href={site.reviews} class="link">alle <span class="num">{site.google.aantal}</span> reviews</a></span>
          </p>
        </div>
      </div>
    </section>

    <!-- 6. AANVRAGEN: één zin die een WhatsApp-bericht wordt -->
    <section id="aanvragen" class="bg-kalk py-20 md:py-28">
      <div class="wrap grid items-center gap-y-14 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-7">
          <h2 class="rijs text-3xl">Is jouw datum nog vrij?</h2>
          <form class="rijs mt-10 max-w-2xl" data-aanvraag action={site.wa} method="get" novalidate>
            <p class="font-kop text-[clamp(1.6rem,1.3vw+1.2rem,2.4rem)] leading-[1.6]">
              Wij zoeken een zaal voor een
              <label class="sr-only" for="a-soort">Soort feest</label>
              <select id="a-soort" name="soort" class="veld font-kop">
                {feesten.map((f) => <option value={f.toLowerCase()}>{f.toLowerCase()}</option>)}
              </select>
              op
              <label class="sr-only" for="a-datum">Datum</label>
              <input id="a-datum" name="datum" type="date" class="veld w-[9.5em] font-sans text-[.6em]" />
              met ongeveer
              <label class="sr-only" for="a-gasten">Aantal gasten</label>
              <input id="a-gasten" name="gasten" type="number" inputmode="numeric" min="1" max="600" placeholder="150" class="veld num w-[3.6em] text-center font-kop" />
              gasten.
            </p>
            <label class="mt-8 flex cursor-pointer items-start gap-3 text-zacht">
              <input type="checkbox" name="bekijken" class="mt-1 h-5 w-5 flex-none accent-framboos" />
              <span>We komen de zaal graag eerst bekijken.</span>
            </label>
            <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
              <a href={waStart} class="knop" data-wa><Icoon naam="wa" />Stuur via WhatsApp</a>
              <a href={`mailto:${site.mail}`} class="link text-sm text-zacht">of mail {site.mail}</a>
            </div>
            <p class="mt-6 text-xs text-zacht">De datum is pas definitief na bevestiging van Romance. Er wordt pas iets verstuurd als je het bericht in WhatsApp zelf verstuurt.</p>
          </form>
        </div>
        <figure class="rijs max-lg:hidden lg:col-span-4 lg:col-start-9">
          <div class="boog aspect-[3/4] w-full" style="--bv:37.5%">
            <Image src={tafeldetail} alt="Gedekt bord met zwart-wit sierrand en een menukaartje, schaaltjes met nootjes, wijnglazen en roze rozen" quality={74} widths={[400, 620]} sizes="30vw" class="h-full w-full object-cover object-[50%_45%]" />
          </div>
        </figure>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  const knop = form?.querySelector<HTMLAnchorElement>('[data-wa]');
  if (form && knop) {
    const basis = knop.href.split('?')[0];
    const maak = () => {
      const d = new FormData(form);
      const soort = String(d.get('soort') || 'feest');
      const datum = String(d.get('datum') || '');
      const gasten = String(d.get('gasten') || '').trim();
      const wanneer = datum ? new Date(datum + 'T12:00').toLocaleDateString('nl-NL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : '';
      let t = `Hallo Romance, wij zoeken een zaal voor een ${soort}`;
      if (wanneer) t += ` op ${wanneer}`;
      if (gasten) t += ` met ongeveer ${gasten} gasten`;
      t += '. Is die datum nog vrij?';
      if (d.get('bekijken')) t += ' We komen de zaal graag eerst bekijken.';
      knop.href = `${basis}?text=${encodeURIComponent(t)}`;
    };
    form.addEventListener('input', maak);
    form.addEventListener('change', maak);
    form.addEventListener('submit', (e) => { e.preventDefault(); maak(); knop.click(); });
    maak();
  }
</script>
