---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-nacht text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk class="h-16 text-roze" />
      <p class="mt-6 max-w-xs">Partycentrum aan de Koningin Wilhelminahaven in Vlaardingen. Twee zalen in Victoriaanse stijl.</p>
    </div>
    <div class="md:col-span-3">
      <h2 class="font-sans text-label font-semibold uppercase tracking-[.18em] text-roze">Contact</h2>
      <p class="mt-4"><a href={site.telHref} class="link num text-wit">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link text-wit">WhatsApp</a></p>
      <p class="mt-1"><a href={`mailto:${site.mail}`} class="link break-all text-wit">{site.mail}</a></p>
    </div>
    <div class="md:col-span-4">
      <h2 class="font-sans text-label font-semibold uppercase tracking-[.18em] text-roze">Adres</h2>
      <p class="mt-4 text-wit">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.maps} class="link">Route plannen</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.bv} · KvK <span class="num">{site.kvk}</span></p>
    <p class="flex flex-wrap gap-x-6 gap-y-1"><a href={site.voorwaarden} class="no-underline hover:text-wit">Algemene voorwaarden</a><a href={url('privacy/')} class="no-underline hover:text-wit">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto’s van jullie eigen website en jullie Google-bedrijfsprofiel. Reviews letterlijk van Google (stand 6 oktober 2026).</p>}
</footer>
