---
import { url, waHoi, site } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['zalen', 'De zalen'], ['feesten', 'Feesten'], ['ervaringen', 'Ervaringen'], ['route', 'Route']];
---
<header class="sticky top-0 z-40 border-b border-lijn bg-wit/95 backdrop-blur-md" data-kop>
  <div class="wrap flex h-20 items-center justify-between gap-6 md:h-24">
    <Merk class="h-12 text-framboos md:h-[3.75rem]" />
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-9 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-inkt no-underline transition-colors duration-300 hover:text-framboos">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="num hidden text-[.9375rem] font-medium text-inkt no-underline transition-colors hover:text-framboos xl:block">{site.tel}</a>
      <a href={h('aanvragen')} class="knop hidden min-h-11 px-5 text-sm md:inline-flex">Datum aanvragen</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-inkt lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h18M3 16h18" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden border-t border-lijn bg-wit lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="block border-b border-lijn py-4 font-kop text-3xl no-underline">{t}</a></li>)}
      <li><a href={h('aanvragen')} class="block border-b border-lijn py-4 font-kop text-3xl text-framboos no-underline">Datum aanvragen</a></li>
      <li class="pt-6"><a href={site.telHref} class="num font-medium text-inkt no-underline">{site.tel}</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-lijn bg-wit/95 backdrop-blur-md md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn text-sm font-semibold text-inkt no-underline"><Icoon naam="tel" class="h-4 w-4 text-framboos" />Bellen</a>
  <a href={waHoi} class="flex min-h-14 items-center justify-center gap-2.5 bg-framboos text-sm font-semibold text-wit no-underline"><Icoon naam="wa" class="h-4 w-4" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
