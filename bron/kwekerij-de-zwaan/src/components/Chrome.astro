---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="whitespace-nowrap font-display text-xl font-semibold leading-none text-leaf no-underline sm:text-2xl"><span class="text-sm font-normal italic text-ink-soft sm:text-base">Kwekerij</span> De Zwaan</a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 text-sm font-medium">
          <li><a href={url('#assortiment')} class="no-underline transition-colors hover:text-geranium">Assortiment</a></li>
          <li><a href={url('#geraniums')} class="no-underline transition-colors hover:text-geranium">Geraniums</a></li>
          <li><a href={url('#tijden')} class="no-underline transition-colors hover:text-geranium">Openingstijden</a></li>
          <li><a href={url('#route')} class="no-underline transition-colors hover:text-geranium">Route</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-leaf !px-4 !py-2 whitespace-nowrap">Bel ons</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-12 text-white/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-2xl font-semibold text-white">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats} ({site.wijk})<br />KvK <span class="text-white/70">[[AANLEVEREN: KvK-nummer]]</span></p>
      <p class="leading-9 md:col-span-4"><a href={site.telHref} class="underline underline-offset-2">{site.tel}</a><br /><a href={site.mobielHref} class="underline underline-offset-2">{site.mobiel}</a><br /><a href={`mailto:${site.mail}`} class="break-all underline underline-offset-2">{site.mail}</a></p>
      <p class="leading-9 md:col-span-3 md:text-right"><a href={site.facebook} rel="noopener" class="underline underline-offset-2">Facebook</a><br /><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
