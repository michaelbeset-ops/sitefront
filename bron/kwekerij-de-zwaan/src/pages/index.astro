---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, staffel, assortiment, plaatsen, routes, laatsteStuk } from '../data/site';
import hero from '../assets/hero.jpg';
import begonia from '../assets/begonia.jpg';
import kas from '../assets/kas.jpg';
import dahlia from '../assets/dahlia.jpg';
---
<Base
  title="Kwekerij 'De Zwaan' | Geraniums, violen en perkplanten in Ridderkerk-Rijsoord"
  description="Kwekerij in Rijsoord, gespecialiseerd in balkon-, terras- en perkplanten. Geraniums uit eigen kas, violen, groenteplanten en winterharde olijfbomen. Verkoop aan huis van maart tot eind juni."
>
  <!-- Seizoensstrook: wat nu geldt, voordat iemand in de auto stapt. -->
  <div class="bg-geranium text-white">
    <p class="wrap flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3 text-sm">
      <strong class="font-semibold">Het verkoopseizoen is voorbij.</strong>
      <span>De komende zaterdagen zijn we nog open van <span class="whitespace-nowrap tabular-nums">9.00 tot 12.00 uur</span>.</span>
    </p>
  </div>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: de kas over de volle breedte, tekst onderaan op een verloop van bladgroen. -->
    <section class="relative flex min-h-[34rem] items-end overflow-hidden bg-leaf-deep text-white lg:min-h-[40rem]">
      <div class="absolute inset-0"><Foto src={hero} alt="Pad van klinkers door een kas, met aan weerszijden houten tafels vol potplanten met etiketten" hero sizes="100vw" /></div>
      <div aria-hidden="true" class="absolute inset-0 bg-leaf-deep/70 lg:bg-transparent lg:bg-gradient-to-t lg:from-leaf-deep lg:via-leaf-deep/80 lg:to-leaf-deep/35"></div>
      <div class="wrap relative grid gap-8 pb-12 pt-24 lg:grid-cols-12 lg:items-end lg:pb-16">
        <div class="lg:col-span-7">
          <p class="kicker text-sprout">Ridderkerk, Rijsoord</p>
          <h1 class="mt-4 text-4xl">Geraniums, violen en perkgoed, verkocht aan huis</h1>
          <p class="mt-6 max-w-xl text-lg text-white/90">Kwekerij 'De Zwaan' is gespecialiseerd in de teelt van balkon-, terras- en perkplanten. Van maart tot eind juni verkopen we aan huis, aan particulieren en aan bedrijven.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#route" class="btn btn-red">Route naar de kas</a>
            <a href={site.telHref} class="btn btn-line">Bel <span class="whitespace-nowrap">{site.tel}</span></a>
          </div>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <p class="border-l-4 border-sprout pl-4"><span class="block text-sm text-white/85">Verkoop aan huis</span><span class="font-display text-2xl font-semibold leading-tight">maart tot eind juni</span></p>
          <p class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-sm text-white/85">
            <span><strong class="text-white">{site.google.score}</strong> op Google ({site.google.aantal} reviews)</span>
            <span>{site.straat}, {site.plaats}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Assortiment: een genummerde lijst naast een staande foto, geen kaartjes. -->
    <section id="assortiment" class="scroll-mt-20 border-t border-line py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h2 class="text-3xl">Wat er in de kassen staat</h2>
          <p class="mt-5 text-ink-soft">Ons assortiment bestaat uit verschillende soorten planten, van violen tot pootuien.</p>
          <div class="mt-8 hidden aspect-[3/4] overflow-hidden rounded-2xl lg:block"><Foto src={dahlia} alt="Roze dahlia's van dichtbij" sizes="360px" /></div>
        </div>
        <ol class="grid gap-x-10 sm:grid-cols-2 lg:col-span-7 lg:col-start-6">
          {assortiment.map((a, i) => (
            <li class="flex gap-4 border-b border-line py-5">
              <span class="w-7 shrink-0 pt-1 font-display text-lg font-semibold tabular-nums text-geranium" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-xl">{a.naam}</h3>
                {a.tekst && <p class="mt-1 text-sm text-ink-soft">{a.tekst}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Geraniums: het rode vlak van de pagina, met een echte prijstabel. -->
    <section id="geraniums" class="scroll-mt-20 bg-geranium py-16 text-white lg:py-24">
      <div class="wrap grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="kicker text-white/85">Uit eigen kas</p>
          <h2 class="mt-3 text-3xl">Geraniums, hoe meer hoe voordeliger</h2>
          <p class="mt-5 max-w-lg text-lg text-white/90">Stekgeraniums uit onze eigen kas. Hoe meer u er meeneemt, hoe lager de prijs per stuk.</p>
          <div class="mt-8 aspect-[3/2] overflow-hidden rounded-2xl"><Foto src={kas} alt="Tafels vol jonge geraniums in grijze potten, met één roze bloem in bloei" sizes="(min-width: 1024px) 560px, 100vw" /></div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="rounded-2xl bg-paper p-6 text-ink shadow-[0_2px_8px_#1c241933] md:p-8">
            <table class="w-full text-left">
              <caption class="text-left font-display text-2xl font-semibold leading-tight">Prijs per geranium</caption>
              <thead>
                <tr class="border-b-2 border-ink text-sm text-ink-soft">
                  <th scope="col" class="pb-2 pt-5 font-medium">Aantal</th>
                  <th scope="col" class="pb-2 pt-5 text-right font-medium">Per stuk</th>
                </tr>
              </thead>
              <tbody>
                {staffel.map((s) => (
                  <tr class="border-b border-line last:border-0">
                    <th scope="row" class="py-3 font-normal">{s.vanaf}</th>
                    <td class="whitespace-nowrap py-3 text-right font-display text-xl font-semibold tabular-nums">{s.prijs}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-6 rounded-xl bg-leaf-pale p-4 text-sm">Onze <strong>bonte geraniums</strong> staan in pad 15 in de derde kas.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Olijf- en palmbomen: typografisch, met de prijs groot. -->
    <section id="olijf" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-leaf">Winterhard</p>
          <h2 class="mt-3 text-3xl">Olijf- en palmbomen</h2>
          <div class="mt-8 border-l-4 border-geranium pl-5">
            <p class="text-sm text-ink-soft">Grote olijfbomen</p>
            <p class="whitespace-nowrap font-display text-4xl font-semibold tabular-nums text-geranium">€ 89,95</p>
          </div>
        </div>
        <div class="space-y-5 lg:col-span-6 lg:col-start-7">
          <p class="text-lg">De bomen zijn winterhard en daarmee goed geschikt voor het Nederlandse klimaat. Ze vragen relatief weinig onderhoud en doen het uitstekend in de volle grond, maar ook in een bak of pot.</p>
          <p class="text-ink-soft">We verkopen jonge bomen met een gladde stam in diverse soorten: lange en korte stammen, met één of meerdere takken. De grillige, karakteristieke stammen zijn ouder en hebben een grote stamomtrek. Daarnaast zijn er olijfstruiken en jonge olijfboompjes op stam met een groene bol, in diverse prijzen.</p>
          <div>
            <p class="text-sm font-semibold">Geïmporteerd uit</p>
            <ul class="mt-3 flex flex-wrap gap-2 text-sm">
              <li class="rounded-full bg-leaf-pale px-4 py-1.5">Elche, Spanje</li>
              <li class="rounded-full bg-leaf-pale px-4 py-1.5">Sicilië, Italië</li>
              <li class="rounded-full bg-leaf-pale px-4 py-1.5">Pistoia, Italië</li>
              <li class="rounded-full bg-leaf-pale px-4 py-1.5">Albenga, Italië</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Voor bedrijven en graszoden: groen vlak, foto uitlopend naar de rand. -->
    <section id="bedrijven" class="scroll-mt-20 bg-leaf text-white">
      <div class="grid lg:grid-cols-2">
        <div class="relative aspect-[4/3] lg:aspect-auto"><div class="absolute inset-0"><Foto src={begonia} alt="Tafels vol bloeiende begonia's in oranje, rood en geel" sizes="(min-width: 1024px) 50vw, 100vw" /></div></div>
        <div class="px-5 py-14 md:px-8 lg:px-14 lg:py-20">
          <h2 class="text-3xl">Voor hoveniers, tuincentra en bloemenwinkels</h2>
          <p class="mt-5 max-w-lg text-white/90">Van maart tot eind juni verkopen we aan huis aan hoveniers, tuincentra, bloemenwinkels en andere bedrijven. Bedrijven zijn welkom van maandag tot en met zaterdag.</p>
          <p class="mt-3 max-w-lg text-white/90">Bij grotere aantallen geraniums geldt de staffelprijs, tot <span class="whitespace-nowrap tabular-nums">€ 0,85</span> per stuk vanaf 1000 stuks.</p>
          <a href={site.telHref} class="btn mt-7 bg-white text-leaf hover:bg-paper">Bel <span class="whitespace-nowrap">{site.tel}</span></a>

          <div class="mt-12 border-t border-white/25 pt-8">
            <h3 class="text-2xl">Afhaalpunt graszoden</h3>
            <p class="mt-3 max-w-lg text-white/90">U bestelt uw graszoden op graszoden-online.nl en haalt ze op bij de kwekerij.</p>
            <a href={site.graszoden} rel="noopener" class="mt-4 inline-block font-semibold text-sprout underline decoration-2 underline-offset-4">Naar graszoden-online.nl</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Openingstijden: twee kolommen, particulier en bedrijf naast elkaar. -->
    <section id="tijden" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">Openingstijden in het seizoen</h2>
          <p class="mt-5 text-ink-soft">Het verkoopseizoen loopt van maart tot eind juni.</p>
          <p class="mt-4 rounded-xl border-l-4 border-geranium bg-white p-4 text-sm shadow-sm">Nu buiten het seizoen: de komende zaterdagen nog open van <span class="whitespace-nowrap tabular-nums">9.00 tot 12.00 uur</span>.</p>
        </div>
        <div class="grid content-start gap-6 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
          <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-line">
            <h3 class="text-2xl">Particulieren</h3>
            <dl class="mt-5 space-y-3">
              <div class="border-b border-line pb-3"><dt class="text-sm text-ink-soft">Dinsdag</dt><dd class="whitespace-nowrap font-display text-xl font-semibold tabular-nums">13.00 tot 17.00</dd></div>
              <div><dt class="text-sm text-ink-soft">Woensdag t/m zaterdag</dt><dd class="whitespace-nowrap font-display text-xl font-semibold tabular-nums">9.00 tot 17.00</dd></div>
            </dl>
          </div>
          <div class="rounded-2xl bg-leaf-pale p-6">
            <h3 class="text-2xl">Bedrijven</h3>
            <dl class="mt-5 space-y-3">
              <div><dt class="text-sm text-ink-soft">Maandag t/m zaterdag</dt><dd class="whitespace-nowrap font-display text-xl font-semibold tabular-nums">9.00 tot 17.00</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Route: adres links, per richting uitklapbaar rechts. -->
    <section id="route" class="scroll-mt-20 border-t border-line bg-leaf-pale py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl">De weg naar de kas</h2>
          <address class="mt-6 text-lg not-italic">{site.naam}<br />{site.straat}<br />{site.postcode} {site.plaats} ({site.wijk})</address>
          <a href={site.maps} rel="noopener" class="btn btn-leaf mt-6">Route plannen</a>
          <p class="mt-8 text-sm text-ink-soft">Centraal gelegen voor wie komt uit</p>
          <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm font-medium">
            {plaatsen.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="divide-y divide-line rounded-2xl bg-paper shadow-sm ring-1 ring-line">
            {routes.map((r) => (
              <details class="group p-5 md:px-6">
                <summary class="flex items-center justify-between gap-4 font-display text-xl font-semibold leading-tight">
                  {r.van}
                  <span class="text-2xl leading-none text-leaf transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 text-ink-soft">{r.tekst}</p>
              </details>
            ))}
          </div>
          <p class="mt-6 text-ink-soft"><strong class="text-ink">Het laatste stuk.</strong> {laatsteStuk}</p>
        </div>
      </div>
    </section>

    <!-- Contact: donker, bellen voorop. -->
    <section id="contact" class="scroll-mt-20 bg-ink py-16 text-white lg:py-20">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <h2 class="text-3xl lg:col-span-4">Bellen of mailen</h2>
        <dl class="grid gap-6 sm:grid-cols-2 lg:col-span-8">
          <div><dt class="text-sm text-white/70">Telefoon</dt><dd><a href={site.telHref} class="whitespace-nowrap font-display text-3xl font-semibold underline decoration-petal decoration-2 underline-offset-4">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-white/70">Mobiel</dt><dd><a href={site.mobielHref} class="whitespace-nowrap font-display text-3xl font-semibold underline decoration-petal decoration-2 underline-offset-4">{site.mobiel}</a></dd></div>
          <div><dt class="text-sm text-white/70">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="break-all underline decoration-sprout decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-white/70">Aanbiedingen</dt><dd><a href={site.facebook} rel="noopener" class="underline decoration-sprout decoration-2 underline-offset-4">Kijk op onze Facebookpagina</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
