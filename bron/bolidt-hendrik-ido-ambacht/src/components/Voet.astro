---
import { site, url, sectoren, systemen } from '../data/site';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="bg-asfalt text-as">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-16">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Vloer- en deksystemen, slijtlagen en sportvloeren. Ontwikkeld, geproduceerd en aangebracht door Bolidt, sinds 1964.</p>
      <p class="mt-6 flex gap-5"><a href={site.linkedin} class="link">LinkedIn</a><a href={site.instagram} class="link">Instagram</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Sectoren</p>
      <ul class="mt-4 space-y-1.5">{sectoren.map((s) => <li><a href={h('sectoren')} class="link">{s.naam}</a></li>)}</ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">Systemen</p>
      <ul class="mt-4 space-y-1.5">{systemen.map((s) => <li><a href={s.href} class="link">{s.naam}</a></li>)}</ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-4"><a href={site.telHref} class="link num">{site.telIntl}</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-4">Bolidt Innovation Center<br />{site.straat}, {site.postcode} {site.plaats}</p>
      <p class="mt-3">Post: {site.postadres}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.bv}</p>
    <p class="flex flex-wrap gap-x-6 gap-y-1"><a href={url('privacy/')} class="no-underline hover:text-oranje">Privacyverklaring</a><a href={site.voorwaarden} class="no-underline hover:text-oranje">Algemene voorwaarden</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten, productnamen, projecten en foto’s van bolidt.com, food.bolidt.com en jobs.bolidt.com (stand 7 oktober 2026).</p>}
</footer>
