---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Status from '../components/Status.astro';
import Reserveer from '../components/Reserveer.astro';
import { site, tijden, themas, wa, telIcoon } from '../data/site';
import tafel from '../assets/tafel.jpg';
import pand from '../assets/pand.jpg';
import ribs from '../assets/ribs.jpg';
import uiensoep from '../assets/uiensoep.jpg';
import dessert from '../assets/dessert.jpg';
import ijs from '../assets/ijs.jpg';
import gebak from '../assets/gebak.jpg';
import carpaccio from '../assets/carpaccio.jpg';

const max = Math.max(...themas.map((t) => t.n));
const pijl = `<svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---
<Base title={`${site.naam} | Oudega, vrijdag t/m zondag open`} description="Restaurant By ús thús aan de Hagenadyk in Oudega (Friesland). Open vrijdag, zaterdag en zondag van 17.00 tot 21.00 uur. Reserveren via WhatsApp of telefoon.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- HERO -->
    <section class="relative overflow-hidden bg-turf text-molke">
      <div class="wrap grid gap-8 pb-14 pt-5 sm:pt-8 lg:grid-cols-12 lg:gap-12 lg:pb-20 lg:pt-14">
        <div class="lg:col-span-6 lg:pt-6">
          <p class="eyebrow text-lamp">Restaurant in Oudega, Friesland</p>
          <h1 class="zacht mt-5 text-4xl font-semibold">By <em class="font-medium text-lamp">ús thús</em></h1>
          <p class="mt-3 font-display text-xl italic text-lamp-zacht">Fries voor: bij ons thuis.</p>
          <p class="mt-6 max-w-lg text-lg text-molke/85">Het restaurant van Bennie en Jacqueline aan de Hagenadyk. Jacqueline kookt, de kaart heeft voor iedereen wat.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#reserveren" class="btn btn-lamp"><Fragment set:html={wa} />Reserveer via WhatsApp</a>
            <a href={site.telHref} class="btn btn-lijn text-molke"><Fragment set:html={telIcoon} /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
          </div>
          <dl class="mt-10 grid max-w-xl grid-cols-[auto_1fr] gap-x-10 gap-y-6 border-t border-lijn-licht pt-6">
            <div>
              <dt class="text-sm text-molke/75">Google</dt>
              <dd class="mt-1 font-display text-3xl font-semibold leading-none">{site.google.score}<span class="ml-2 font-body text-sm font-normal text-molke/75">uit {site.google.aantal} reviews</span></dd>
            </div>
            <div>
              <dt class="text-sm text-molke/75">Vrijdag t/m zondag</dt>
              <dd class="mt-1 whitespace-nowrap font-display text-2xl font-semibold leading-none tabular-nums sm:text-3xl">17.00<span class="text-lamp">-</span>21.00</dd>
            </div>
          </dl>
        </div>

        <div class="relative order-first lg:order-none lg:col-span-6">
          <figure class="relative overflow-hidden rounded-xl shadow-xl lg:rounded-2xl">
            <div class="aspect-[3/2] sm:aspect-[16/10] lg:aspect-[5/6]">
              <Foto src={tafel} alt="Een gedekte tafel van bovenaf: stoofvlees, gebakken vlees met salade, patat, gebakken aardappeltjes, rode kool en een kaarsje" class="object-[center_55%]" hero sizes="(min-width: 1024px) 560px, 100vw" />
            </div>
            <figcaption class="absolute left-3 top-3 rounded-lg bg-turf/85 lg:left-auto lg:right-4 lg:top-4 px-3 py-1.5 text-xs font-semibold text-molke backdrop-blur-sm">Aan tafel bij By ús thús</figcaption>
          </figure>
          <figure class="relative -mt-14 ml-auto mr-3 w-[44%] max-w-[16rem] overflow-hidden rounded-xl border-4 border-turf shadow-xl sm:-mt-24 lg:absolute lg:-bottom-8 lg:-left-10 lg:ml-0 lg:mr-0 lg:mt-0 lg:w-[16rem]">
            <div class="aspect-[4/3]"><Foto src={pand} alt="Ons pand aan de Hagenadyk bij avond, met de verlichte naam Restaurant By ús thús boven de deur" sizes="300px" /></div>
            <figcaption class="bg-turf px-3 py-2 text-xs font-semibold text-molke">{site.straat}, {site.plaats}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- THUIS + WAT GASTEN NOEMEN -->
    <section class="licht bg-molke py-16 lg:py-24" aria-labelledby="thuis">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-pompebled">Bij ons thuis</p>
          <h2 id="thuis" class="zacht mt-3 text-3xl">Uit eten met een huiskamersfeer</h2>
          <p class="mt-5 text-lg text-inkt-zacht">Gasten noemen By ús thús vooral gastvrij en huiselijk. Bennie en Jacqueline staan er zelf, Jacqueline in de keuken.</p>
          <figure class="mt-8 overflow-hidden rounded-xl shadow-sm">
            <div class="aspect-[4/3]"><Foto src={carpaccio} alt="Bord met dun gesneden vlees, sla, tomaat, komkommer, kaas en een snee brood" sizes="(min-width: 1024px) 420px, 100vw" /></div>
          </figure>
        </div>

        <div class="lg:col-span-7">
          <div class="rounded-2xl bg-papier p-6 shadow-sm ring-1 ring-lijn sm:p-8">
            <div class="flex flex-wrap items-end justify-between gap-4 border-b border-lijn pb-6">
              <div>
                <p class="eyebrow text-pompebled">Wat gasten noemen</p>
                <p class="mt-2 text-sm text-inkt-zacht">Samengevat uit de Google-reviews</p>
              </div>
              <p class="font-display text-4xl font-semibold leading-none">{site.google.score}<span class="ml-2 font-body text-sm font-normal text-inkt-zacht">uit {site.google.aantal} reviews</span></p>
            </div>
            <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2">
              {[
                ['Gastvrij', 'Je voelt je er thuis, in een huiskamersfeer.'],
                ['De eigenaren', 'Bennie en Jacqueline, en Jacqueline kookt.'],
                ['Een kaart voor iedereen', 'Veel keuze, voor goede prijzen.'],
                ['Mooi opgediend', 'Gasten noemen ook de desserts en de ijsjes.'],
                ['Koffie en gebak', 'Ook voor een kop koffie met gebak.'],
                ['Terras', 'Er is ook een terras.'],
              ].map(([k, t]) => (
                <li class="border-l-2 border-pompebled pl-4">
                  <h3 class="text-lg">{k}</h3>
                  <p class="mt-1 text-sm text-inkt-zacht">{t}</p>
                </li>
              ))}
            </ul>
            <div class="mt-8 border-t border-lijn pt-6">
              <h3 class="text-lg">Het vaakst genoemd</h3>
              <p class="mt-1 text-sm text-inkt-zacht">Aantal vermeldingen per onderwerp in de reviews.</p>
              <ul class="mt-4 grid gap-2">
                {themas.map((t) => (
                  <li class="grid grid-cols-[6.5rem_1fr_2rem] items-center gap-3 text-sm">
                    <span class="font-semibold">{t.woord}</span>
                    <span class="h-2.5 overflow-hidden rounded-full bg-molke" aria-hidden="true"><span class="block h-full rounded-full bg-pompebled" style={`width:${(t.n / max) * 100}%`}></span></span>
                    <span class="text-right tabular-nums text-inkt-zacht">{t.n}<span class="sr-only"> keer</span></span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VAN DE KAART -->
    <section id="kaart" class="scroll-mt-16 bg-turf py-16 text-molke lg:py-24" aria-labelledby="kaartkop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="eyebrow text-lamp">Van de kaart</p>
            <h2 id="kaartkop" class="zacht mt-3 text-3xl">Populair bij gasten</h2>
          </div>
          <p class="text-molke/85 lg:col-span-5">Wat gasten in hun reviews het vaakst noemen, van de spareribs tot de ijsjes. <span class="block pt-2 text-sm text-molke/75">[[AANLEVEREN: volledige menukaart met prijzen]]</span></p>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-12 md:gap-5">
          <figure class="group relative overflow-hidden rounded-2xl md:col-span-7 md:row-span-2">
            <div class="aspect-[4/3] h-full md:aspect-auto"><Foto src={ribs} alt="Sfeerbeeld: spareribs met saus op een houten plank, met koolsalade en aardappelpartjes" sizes="(min-width: 768px) 60vw, 100vw" /></div>
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-turf/95 via-turf/70 to-transparent p-5 pt-16 sm:p-7 sm:pt-20">
              <span class="eyebrow text-lamp-zacht">4 keer genoemd</span>
              <span class="mt-1 block font-display text-2xl font-semibold">Spareribs</span>
            </figcaption>
          </figure>
          <figure class="relative overflow-hidden rounded-2xl md:col-span-5">
            <div class="aspect-[3/2]"><Foto src={uiensoep} alt="Sfeerbeeld: kom uiensoep met gegratineerde kaas en tijm" class="object-[center_60%]" sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <figcaption class="absolute bottom-3 left-3 rounded-lg bg-turf/90 px-3 py-2 backdrop-blur-sm"><span class="eyebrow block text-lamp-zacht">2 keer genoemd</span><span class="font-display text-lg font-semibold">Uiensoep</span></figcaption>
          </figure>
          <figure class="relative overflow-hidden rounded-2xl md:col-span-5">
            <div class="aspect-[3/2]"><Foto src={dessert} alt="Dessert met schuimgebak, slagroom, aardbeien en blauwe bessen" sizes="(min-width: 768px) 40vw, 100vw" /></div>
            <figcaption class="absolute bottom-3 left-3 rounded-lg bg-turf/90 px-3 py-2 backdrop-blur-sm"><span class="eyebrow block text-lamp-zacht">5 keer genoemd</span><span class="font-display text-lg font-semibold">Desserts</span></figcaption>
          </figure>
        </div>

        <div class="mt-4 grid gap-4 md:mt-5 md:grid-cols-12 md:gap-5">
          <figure class="relative overflow-hidden rounded-2xl md:col-span-4">
            <div class="aspect-[4/5] md:aspect-[4/5]"><Foto src={ijs} alt="IJscoupe met slagroom en een koekje in een glas op een houten plankje" sizes="(min-width: 768px) 33vw, 100vw" /></div>
            <figcaption class="absolute bottom-3 left-3 rounded-lg bg-turf/90 px-3 py-2 backdrop-blur-sm"><span class="eyebrow block text-lamp-zacht">3 keer genoemd</span><span class="font-display text-lg font-semibold">IJsjes</span></figcaption>
          </figure>
          <figure class="relative overflow-hidden rounded-2xl md:col-span-5">
            <div class="aspect-[4/3] h-full md:aspect-auto"><Foto src={gebak} alt="Punt oranje taart met slagroom, aardbei en blauwe bessen op een houten tafel in de zon" class="object-[60%_center]" sizes="(min-width: 768px) 42vw, 100vw" /></div>
            <figcaption class="absolute bottom-3 left-3 rounded-lg bg-turf/90 px-3 py-2 backdrop-blur-sm"><span class="eyebrow block text-lamp-zacht">Ook</span><span class="font-display text-lg font-semibold">Koffie en gebak</span></figcaption>
          </figure>
          <div class="flex flex-col justify-between rounded-2xl bg-lamp p-6 text-turf md:col-span-3">
            <div>
              <p class="eyebrow">Ook</p>
              <h3 class="zacht mt-2 text-2xl">De snackbar</h3>
              <p class="mt-3">Naast het restaurant is er een snackbar-afdeling, voor patat of shoarma.</p>
            </div>
            <a href={site.whatsapp} class="mt-6 inline-flex items-center gap-2 font-bold underline underline-offset-4">Vraag het via WhatsApp <Fragment set:html={pijl} /></a>
          </div>
        </div>
        <p class="mt-6 text-sm text-molke/75">Spareribs en uiensoep: sfeerfoto's. De overige foto's komen van het Google-profiel van By ús thús.</p>
      </div>
    </section>

    <!-- RESERVEREN -->
    <section id="reserveren" class="scroll-mt-16 bg-greide py-16 text-molke lg:py-24" aria-labelledby="reskop">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-lamp">Reserveren</p>
          <h2 id="reskop" class="zacht mt-3 text-3xl">Een tafel reserveren via WhatsApp</h2>
          <p class="mt-5 text-molke/85">Kies met hoeveel personen u komt, welke dag en hoe laat. Wij zetten er een net bericht van klaar, u hoeft het alleen nog te versturen.</p>
          <ol class="mt-8 grid gap-4 border-t border-lijn-licht pt-6 text-sm">
            <li class="flex gap-4"><span class="font-display text-2xl italic leading-none text-lamp">vr</span><span class="pt-1">Vrijdag van 17.00 tot 21.00 uur</span></li>
            <li class="flex gap-4"><span class="font-display text-2xl italic leading-none text-lamp">za</span><span class="pt-1">Zaterdag van 17.00 tot 21.00 uur</span></li>
            <li class="flex gap-4"><span class="font-display text-2xl italic leading-none text-lamp">zo</span><span class="pt-1">Zondag van 17.00 tot 21.00 uur</span></li>
          </ol>
          <div class="mt-8 border-t border-lijn-licht pt-6">
            <p class="text-sm text-molke/75">Liever bellen?</p>
            <a href={site.telHref} class="mt-1 block whitespace-nowrap font-display text-3xl font-semibold tabular-nums text-lamp no-underline transition-colors hover:text-lamp-zacht">{site.tel}</a>
          </div>
        </div>
        <div class="min-w-0 lg:col-span-7">
          <Reserveer />
        </div>
      </div>
    </section>

    <!-- ROUTE EN OPENINGSTIJDEN -->
    <section id="route" class="licht scroll-mt-16 bg-molke py-16 lg:py-24" aria-labelledby="routekop">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="eyebrow text-pompebled">Route</p>
          <h2 id="routekop" class="zacht mt-3 text-3xl">Aan de Hagenadyk in Oudega</h2>
          <address class="mt-6 not-italic text-lg">
            <strong class="font-display text-2xl font-semibold">{site.naam}</strong><br />
            {site.straat}<br />{site.postcode} {site.plaats}
          </address>
          <p class="mt-3"><a href={site.telHref} class="whitespace-nowrap tabular-nums underline-offset-4 hover:underline">T {site.tel}</a></p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.whatsapp} class="btn btn-rood"><Fragment set:html={wa} />Stuur een WhatsApp</a>
            <a href={site.maps} class="btn btn-lijn text-inkt hover:!bg-turf hover:!text-molke hover:!shadow-none">Route plannen <Fragment set:html={pijl} /></a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-xl bg-papier p-6 shadow-sm ring-1 ring-lijn sm:p-8">
            <div class="mb-6"><Status /></div>
            <h3 class="text-2xl">Openingstijden</h3>
            <table class="mt-4 w-full text-left">
              <caption class="sr-only">Openingstijden per dag</caption>
              <tbody>
                {tijden.map((d) => (
                  <tr class="dagrij border-b border-lijn last:border-b-0" data-wd={d.wd}>
                    <th scope="row" class="py-3 font-semibold">{d.dag}</th>
                    <td class={`whitespace-nowrap py-3 text-right tabular-nums ${d.tijd === 'Gesloten' ? 'text-inkt-zacht' : 'font-semibold'}`}>{d.tijd}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>

<style>
  .dagrij.vandaag th, .dagrij.vandaag td { color: var(--color-pompebled); }
  .dagrij.vandaag th::after { content: ' (vandaag)'; font-weight: 400; font-size: var(--text-sm); }
</style>
<script>
  import { nuInOudega } from '../scripts/open';
  const wd = nuInOudega().dag.wd;
  document.querySelector(`.dagrij[data-wd="${wd}"]`)?.classList.add('vandaag');
</script>
