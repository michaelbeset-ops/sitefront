---
// Typografisch woordmerk naar hun verlichte gevelnaam: "By ús thús" in lamplicht-goud met een huisje (thús = thuis).
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
const kleur = licht ? 'text-pompebled' : 'text-lamp';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg aria-hidden="true" viewBox="0 0 32 32" class={`h-8 w-8 shrink-0 ${kleur}`} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M4 15 16 5l12 10" /><path d="M7.5 12.5V27h17V12.5" /><path d="M13.5 27v-7h5v7" /><circle cx="16" cy="14.5" r="1.6" fill="currentColor" stroke="none" /></svg>
  <span class="flex flex-col leading-none">
    <span class={`eyebrow !text-[0.625rem] !tracking-[0.28em] ${licht ? 'text-inkt-zacht' : 'text-lamp-zacht'}`}>Restaurant</span>
    <span class="zacht whitespace-nowrap font-display text-lg font-semibold tracking-[-0.01em] min-[380px]:text-xl">By <em class={`font-medium ${kleur}`}>ús thús</em></span>
  </span>
</span>
