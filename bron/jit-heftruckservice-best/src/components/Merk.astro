---
// Woordmerk naar hun logo: de gele heftruck waarvan de vork onder "J.I.T." doorloopt, met HEFTRUCKSERVICE eronder.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex items-end gap-2 no-underline', licht ? 'text-wit' : 'text-blauw', cls]}>
  <span class="sr-only">J.I.T. Heftruckservice, naar de homepage</span>
  <span class="flex flex-col leading-none" aria-hidden="true">
    <span class="flex items-end">
      <span class="kop text-[1.75rem] leading-[.8] tracking-[.06em] sm:text-[2rem]">J.I.T.</span>
      <svg viewBox="0 0 44 40" class="-mb-[3px] ml-1 h-10 w-11 flex-none text-geel sm:h-11 sm:w-12" fill="currentColor" aria-hidden="true">
        <rect x="6" y="0" width="4.5" height="31" />
        <path d="M10.5 11H26l8 13v8H10.5z" />
        <path d="M14 14h10.3l5.6 9H14z" fill={licht ? '#161513' : '#ffffff'} />
        <circle cx="16" cy="33.5" r="6" /><circle cx="16" cy="33.5" r="2.4" fill={licht ? '#161513' : '#ffffff'} />
        <circle cx="32.5" cy="34" r="5.4" /><circle cx="32.5" cy="34" r="2.1" fill={licht ? '#161513' : '#ffffff'} />
      </svg>
    </span>
    <span class="mt-1 block h-[3px] w-[62%] bg-geel"></span>
    <span class="kop mt-1.5 text-[.8125rem] tracking-[.2em] sm:text-[.875rem]">HEFTRUCKSERVICE</span>
  </span>
</a>
