---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
import Silhouet from './Silhouet.astro';
const jaar = new Date().getFullYear();
const diensten = [['onderhoud', 'Service en onderhoud'], ['onderhoud', '(Spoed)reparaties'], ['keuringen', 'Jaarlijkse keuringen'], ['verkoop', 'Verkoop en inruil'], ['verkoop', 'Verhuur'], ['verkoop', 'Batterijen en laders'], ['verkoop', 'Transport']];
---
<footer class="bg-asfalt text-mist">
  <div class="band overflow-hidden" aria-hidden="true">
    <div class="wrap flex items-end justify-between gap-6 py-3">
      {(['palletwagen', 'ept', 'stapelaar', 'heftruck', 'palletwagen', 'ept', 'stapelaar', 'heftruck'] as const).map((s, i) => <Silhouet soort={s} class:list={['h-9 w-auto flex-none', i > 3 && 'max-md:hidden', i > 5 && 'max-lg:hidden']} />)}
    </div>
  </div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk licht />
      <p class="mt-6 max-w-xs">{site.voluit}. Service, onderhoud, keuringen, verkoop en verhuur van heftrucks en interne transportmiddelen.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Diensten</p>
      <ul class="mt-3 space-y-1">{diensten.map(([id, d]) => <li><a href={url(`#${id}`)} class="link link-licht no-underline hover:underline">{d}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's en teksten van jullie huidige website jitheftruckservice.nl. De foto's zijn daar klein; voor de definitieve site graag grotere originelen.</p>}
</footer>
