---
// Eigen tekeningen naar de silhouettenbalk op hun huidige site (palletwagen tot heftruck). viewBox 0 0 96 64.
interface Props { soort: 'heftruck' | 'stapelaar' | 'ept' | 'palletwagen'; class?: string; [k: string]: any }
const { soort, class: cls = '', ...rest } = Astro.props;
---
<svg viewBox="0 0 96 64" class={cls} fill="currentColor" aria-hidden="true" {...rest}>
  {soort === 'heftruck' && (<g>
    <rect x="18" y="6" width="5" height="48" /><rect x="2" y="52" width="22" height="3.5" />
    <path d="M27 9h28l12 22h3v18H27z" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round" />
    <path d="M27 31h43v18H27z" /><rect x="50" y="20" width="9" height="12" rx="2" />
    <rect x="66" y="24" width="10" height="25" rx="2" />
    <circle cx="35" cy="52" r="8" /><circle cx="64" cy="53" r="7" />
    <circle cx="35" cy="52" r="3" style="fill: var(--hol, #f3ab01)" /><circle cx="64" cy="53" r="2.6" style="fill: var(--hol, #f3ab01)" />
  </g>)}
  {soort === 'stapelaar' && (<g>
    <rect x="36" y="2" width="5" height="54" /><rect x="44" y="2" width="3" height="54" />
    <rect x="4" y="54" width="34" height="3.5" /><rect x="10" y="45" width="3" height="10" />
    <path d="M47 28h20a4 4 0 0 1 4 4v24H47z" />
    <path d="M69 28l12-18" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" /><rect x="77" y="6" width="10" height="4" rx="2" transform="rotate(-30 82 8)" />
    <circle cx="10" cy="58" r="3.5" /><circle cx="62" cy="58" r="5" />
  </g>)}
  {soort === 'ept' && (<g>
    <rect x="4" y="52" width="46" height="4" /><rect x="4" y="48" width="4" height="6" />
    <path d="M48 32h16a4 4 0 0 1 4 4v20H48z" />
    <path d="M64 33l12-22" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" /><rect x="71" y="6" width="11" height="4" rx="2" transform="rotate(-30 76 8)" />
    <circle cx="12" cy="58" r="3.5" /><circle cx="58" cy="58" r="5" />
  </g>)}
  {soort === 'palletwagen' && (<g>
    <rect x="6" y="52" width="52" height="4" /><rect x="6" y="48" width="4" height="6" />
    <path d="M56 40h8v16h-8z" />
    <path d="M60 41l10-30" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    <path d="M66 12a6 6 0 1 1 9 3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    <circle cx="14" cy="58" r="3.5" /><circle cx="60" cy="58" r="4.5" />
  </g>)}
</svg>
