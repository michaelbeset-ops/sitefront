---
// Hun echte logo (A.R.M. met de drie strepen), donker of met witte letters voor donkere vlakken.
import { Image } from 'astro:assets';
import { url } from '../data/site';
import logo from '../assets/logo.png';
import logoLicht from '../assets/logo-licht.png';
interface Props { licht?: boolean; class?: string }
const { licht = true, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex shrink-0 no-underline', cls]}>
  <Image src={licht ? logoLicht : logo} alt="ARM Transport B.V., naar de homepage" widths={[200, 320, 480]} sizes="10.5rem" class="h-auto w-[9.5rem] md:w-[11rem]" loading="eager" />
</a>
