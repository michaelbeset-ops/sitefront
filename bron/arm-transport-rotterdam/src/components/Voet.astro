---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const vervoer = ['Spoedzendingen', 'Medische artikelen', 'Bloemen', 'Pakketpost', 'Objecten en bulk', 'Opslag en overslag'];
---
<footer class="bg-asfalt text-mist">
  <div class="strepen max-w-[34rem] opacity-90" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[1rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Transport en koeriersdiensten vanuit Rotterdam. Koerier door heel Europa, bulk door heel Nederland.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Wat wij vervoeren</p>
      <ul class="mt-3 space-y-1">{vervoer.map((p) => <li><a href={url('#vervoer')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Bereikbaar</p>
      <p class="mt-3">Opdrachten 24/7<br />Op locatie ma-vr 07-19, za 09-16</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>&copy; {jaar} {site.naam}, Rotterdam</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen websites (portfolio) en Google-bedrijfsprofiel, kentekens onscherp gemaakt. Teksten op basis van armtransport.nl en transportbedrijfinrotterdam.nl (stand 7 oktober 2026).</p>}
</footer>
