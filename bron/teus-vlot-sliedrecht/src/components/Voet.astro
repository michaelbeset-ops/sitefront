---
import { site, url, bedrijven } from '../data/site';
import Logo from './Logo.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-diep text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <span class="text-wit"><Logo class="h-10 w-auto" /></span>
      <p class="mt-6 max-w-xs">Professionals in maritieme oplossingen. Alle disciplines onder één dak, aan de Baanhoek in Sliedrecht.</p>
      <p class="mt-5"><a href={site.brochure} class="link">Blader door de brochure</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">De groep</p>
      <ul class="mt-4 space-y-1.5">
        {bedrijven.map((b) => <li><a href={b.href} class="link">{b.vol}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-1.5"><a href={site.maps} class="link">Route</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Service</p>
      <p class="mt-4">Servicelijn 24/7 bereikbaar, ook in het weekend.</p>
      <p class="mt-3"><a href={url('#storing')} class="link">Storing melden</a></p>
      <p class="mt-1.5"><a href={site.vacatures} class="link">Vacatures</a></p>
      <p class="mt-1.5"><a href={site.linkedin} class="link">LinkedIn</a></p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.bv} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-petrol-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten, cijfers en foto’s van teusvlot.com, de sites van de groepsbedrijven, jullie brochure en jullie LinkedIn-pagina (stand 7 oktober 2026).</p>}
</footer>
