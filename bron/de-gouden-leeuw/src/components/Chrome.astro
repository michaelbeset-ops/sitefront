---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="border-b border-white/10 bg-ink text-paper">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="font-display text-2xl font-black uppercase leading-none text-gold no-underline">De Gouden Leeuw</a>
      <nav aria-label="Hoofdmenu" class="hidden md:block">
        <ul class="flex gap-6 font-display text-lg font-bold uppercase">
          <li><a href="#cafe" class="no-underline hover:text-gold">Café</a></li>
          <li><a href="#overnachten" class="no-underline hover:text-gold">Overnachten</a></li>
          <li><a href="#feest" class="no-underline hover:text-gold">Feest</a></li>
          <li><a href="#contact" class="no-underline hover:text-gold">Contact</a></li>
        </ul>
      </nav>
      <a href={site.telHref} class="btn btn-gold !px-3.5 !py-1.5 !text-base">Bel</a>
    </div>
  </header>
) : (
  <footer class="bg-ink py-10 text-paper/80">
    <div class="wrap flex flex-col gap-6 text-sm md:flex-row md:justify-between">
      <p><strong class="font-display text-xl uppercase text-gold">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK [[AANLEVEREN: KvK-nummer]]</p>
      <p class="md:text-right"><a href={url('privacy/')} class="underline underline-offset-2">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-6 text-xs">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
