---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { site, planMail } from '../data/site';
import garrelsweer from '../assets/garrelsweer.jpg';
import meppel from '../assets/meppel.jpg';
import tynaarlo from '../assets/tynaarlo.jpg';
import groningen from '../assets/groningen.jpg';
import assen from '../assets/assen.jpg';
import balk from '../assets/balk.jpg';

// "Skills" van hun huidige site.
const vakken = ['Advies', 'Ontwerp', 'Engineering', 'Begeleiding', 'Aanvragen'];
// De bouwprocedure uit hun About-tekst.
const procedure = ['Ontwerp', 'Constructieberekening', 'Kostencalculatie', 'Bouwbegeleiding'];
// Projectenlijst van hun huidige site (dubbele weggelaten).
const projecten = [
  ['Hoogezand', 'Cypressenlaan, 12 woningen'],
  ['Klosterhout', 'Woning'],
  ['Tynaarlo', 'Kantoor en bedrijfsgebouw'],
  ['Zuidlaren', 'Woningen Kazerneterrein'],
  ['Groningen', 'Mitsubishi'],
  ['Assen', 'Bedrijfsgebouw met woning, Messchenveld'],
  ['Sneek', 'Renovatie In den Ros Bayeart, Wigledam'],
  ['Tynaarlo', 'Waterking, dredging'],
  ['Groningen', 'Bruins Vischer'],
  ['Meppel', 'Paradijsweg'],
];
const stempel = [
  ['Bureau', site.naam],
  ['Adres', `${site.straat}, ${site.plaats}`],
  ['Register', `Architectenregister · KIVI ${site.kivi}`],
  ['Voorwaarden', 'DNR 2005, revisie 2011'],
  ['Verzekerd', 'Centraal Beheer Achmea'],
];
const tel = `<svg viewBox="0 0 24 24" class="h-[1em] w-[1em]" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>`;
---
<Base title="Artwyse Architecten Engineers | Ontwerp, constructie en bouwbegeleiding in Assen" description="Integraal bureau in Assen: ontwerp, constructieberekeningen, kostencalculaties en bouwbegeleiding. Houtconstructie is onze specialiteit. Bel 0592 311 253.">
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- 1. Het tekenblad: ruitjespapier, stramienassen, de kop als titel en rechtsonder de stempel. -->
    <section class="ruit relative overflow-hidden border-b border-inkt md:min-h-[calc(100svh-6.1rem)]" aria-labelledby="kop">
      <!-- Stramienassen: bollen op de bovenrand, stippellijnen naar beneden. -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden md:block">
        {['A', 'B', 'C'].map((l, i) => (
          <div class="absolute bottom-0 top-3 flex flex-col items-center" style={`left:calc(${[0, 58.333, 100][i]}% + ${[1.5, 0, -1.5][i]}rem)`}>
            <span class="bol -translate-x-1/2">{l}</span>
            <span class="w-px flex-1 -translate-x-1/2 border-l border-dashed border-inkt/25"></span>
          </div>
        ))}
      </div>

      <div class="relative grid gap-y-8 px-5 pb-6 pt-8 md:min-h-[calc(100svh-6.1rem)] md:grid-cols-12 md:grid-rows-[1fr_auto] md:gap-x-6 md:px-14 md:pb-8 md:pt-14 xl:px-20">
        <div class="md:col-span-7 md:self-center">
          <h1 id="kop" class="text-3xl">Ontwerp, berekening en bouw&shy;begeleiding onder één dak.</h1>
          <p class="mt-5 max-w-[34rem] text-[1.125rem] leading-snug md:text-lg text-grafiet md:mt-6">Integraal bureau voor architectuur en engineering in Assen. Duurzame bouw- en houtconstructie is onze specialiteit.</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={site.telHref} class="knop"><Fragment set:html={tel} />Bel <span class="tabular-nums">{site.tel}</span></a>
            <a href={planMail} class="lijn">Mail ons uw bouwplan</a>
          </div>
        </div>

        <div class="md:col-span-5 md:col-start-8 md:self-center">
          <figure>
            <!-- Maatlijn boven de foto, zoals op een gevelaanzicht. -->
            <div class="mono mb-2 flex items-center gap-2 text-grafiet" aria-hidden="true">
              <span class="h-3 w-px bg-inkt"></span><span class="h-px flex-1 bg-inkt"></span>
              <span class="px-1">aanzicht</span>
              <span class="h-px flex-1 bg-inkt"></span><span class="h-3 w-px bg-inkt"></span>
            </div>
            <div class="overflow-hidden border border-inkt bg-blad p-1.5">
              <div class="aspect-[16/9] md:aspect-[717/290]"><Foto src={garrelsweer} alt="Nieuwbouwwoning in aanbouw: gevel van donkerrode baksteen onder een groot, donker pannendak, met kozijnopeningen zonder glas." hero sizes="(min-width: 768px) 560px, 100vw" /></div>
            </div>
            <figcaption class="mono mt-2 text-grafiet">Garrelsweer, woning in aanbouw</figcaption>
          </figure>
          <ul class="mt-8 border-t border-inkt md:mt-10" aria-label="Wat wij doen">
            {vakken.map((v) => (
              <li class="flex items-center justify-between border-b border-lijn py-2 text-xl leading-tight">
                {v}<span class="h-2 w-2 bg-riet" aria-hidden="true"></span>
              </li>
            ))}
          </ul>
        </div>

        <!-- De stempel: het titelblok van de tekening, op desktop als strook onderaan. -->
        <dl class="mono border border-inkt bg-blad md:col-span-12 md:grid md:grid-cols-[repeat(5,auto)]">
          {stempel.map(([k, v], i) => (
            <div class={`grid grid-cols-[6.5rem_1fr] md:block ${i ? 'border-t border-lijn md:border-l md:border-t-0' : ''}`}>
              <dt class="border-r border-lijn px-3 py-2 text-grafiet md:border-r-0 md:pb-0 md:pt-2.5">{k}</dt>
              <dd class="px-3 py-2 text-inkt md:pb-2.5 md:pt-0.5">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 2. Werk: de bouwprocedure als één lijn met maatstreepjes. -->
    <section id="werk" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="werk-kop">
      <div class="wrap grid gap-8 md:grid-cols-12 md:gap-6">
        <h2 id="werk-kop" class="text-2xl md:col-span-5">Alle kennis zelf in huis.</h2>
        <div class="md:col-span-6 md:col-start-7">
          <p class="text-lg">Wij behandelen alle aspecten van de bouwprocedure: van ontwerp en constructieberekeningen tot kostencalculaties en bouwbegeleiding. Ook de aanvragen nemen wij voor u mee.</p>
          <p class="mt-4 text-grafiet">Artwyse heeft diverse projecten gedaan, van Delfzijl tot Den Haag.</p>
        </div>
      </div>
      <ol class="wrap mt-14 grid gap-0 md:mt-20 md:grid-cols-4" aria-label="De bouwprocedure">
        {procedure.map((p, i) => (
          <li class="relative border-l border-inkt py-1 pl-5 md:border-l-0 md:border-t md:pl-0 md:pr-6 md:pt-6">
            <span class="absolute -left-[5px] top-3 h-[9px] w-[9px] rotate-45 border border-inkt bg-papier md:-top-[5px] md:left-0" aria-hidden="true"></span>
            <span class="mono text-grafiet">{String.fromCharCode(65 + i)}</span>
            <p class="mb-5 text-xl leading-tight md:mb-0 md:mt-1">{p}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 3. Houtbouw: de doorgezaagde stam op een donker vlak. -->
    <section id="hout" class="op-inkt scroll-mt-20 bg-inkt py-20 text-mist md:py-28" aria-labelledby="hout-kop">
      <div class="wrap grid items-center gap-10 md:grid-cols-12 md:gap-6">
        <figure class="md:col-span-4">
          <div class="mx-auto max-w-[285px] border border-lijn-licht p-2 md:mx-0">
            <div class="aspect-[285/222]"><Foto src={balk} alt="Doorsnede van een houten stam, met jaarringen en een droogscheur, tegen een betimmerde wand." sizes="285px" /></div>
          </div>
        </figure>
        <div class="md:col-span-7 md:col-start-6">
          <h2 id="hout-kop" class="text-2xl text-blad">Duurzame bouw- en houtconstructie is onze specialiteit.</h2>
          <p class="mt-6 max-w-[38rem] text-lg">Wij zien voordeel in dragende binnen-elementen. Samen met de Vereniging van Houtconstructeurs werken we aan rekenprogramma's die constructiebureaus in het hele land kunnen gebruiken.</p>
          <p class="mt-6"><a href={site.vhc} class="lijn text-blad">Vereniging van Houtconstructeurs</a></p>
        </div>
      </div>
    </section>

    <!-- 4. Projecten: foto's in zwart-wit (in kleur bij aanwijzen) en de lijst als tekeningenregister. -->
    <section id="projecten" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="proj-kop">
      <div class="wrap">
        <h2 id="proj-kop" class="text-2xl">Van Delfzijl tot Den Haag.</h2>
        <div class="mt-12 grid gap-5 md:grid-cols-12 md:gap-6">
          <div class="md:col-span-6">
          <figure class="grijs">
            <div class="aspect-[500/350] max-w-[500px] overflow-hidden"><Foto src={meppel} alt="Bedrijfspand met donkergrijze gevelplaten, blauw glas en een betonnen toren met de ingang." sizes="(min-width: 768px) 500px, 100vw" /></div>
            <figcaption class="mono mt-2 text-grafiet">Meppel, Paradijsweg</figcaption>
          </figure>
            <table class="mt-12 w-full border-t border-inkt text-left md:mt-16">
              <caption class="sr-only">Een selectie van onze projecten</caption>
              <thead class="sr-only"><tr><th scope="col">Plaats</th><th scope="col">Project</th></tr></thead>
              <tbody>
                {projecten.map(([plaats, wat]) => (
                  <tr class="border-b border-lijn transition-colors hover:bg-blad">
                    <th scope="row" class="w-[38%] py-3 pr-4 align-top font-medium md:w-[34%]">{plaats}</th>
                    <td class="py-3 align-top text-grafiet">{wat}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="grid content-start gap-5 md:col-span-6 md:grid-cols-2 md:gap-6 md:pt-16">
            <figure class="grijs">
              <div class="aspect-[292/210] overflow-hidden"><Foto src={tynaarlo} alt="Kantoorgebouw van baksteen met een uitstekende glazen erker op de verdieping." sizes="(min-width: 768px) 292px, 100vw" /></div>
              <figcaption class="mono mt-2 text-grafiet">Tynaarlo, Waterking</figcaption>
            </figure>
            <figure class="grijs">
              <div class="aspect-[350/210] overflow-hidden"><Foto src={assen} alt="Bedrijfsgebouw van baksteen met een gebogen dak en hoge ramen." sizes="(min-width: 768px) 350px, 100vw" /></div>
              <figcaption class="mono mt-2 text-grafiet">Assen, Messchenveld</figcaption>
            </figure>
            <figure class="grijs md:col-span-2 md:w-[80%]">
              <div class="aspect-[405/311] max-w-[405px] overflow-hidden"><Foto src={groningen} alt="Kantoorgebouw met lichte gevel, een glazen entree en een dichte bovenbouw." sizes="(min-width: 768px) 405px, 100vw" /></div>
              <figcaption class="mono mt-2 text-grafiet">Groningen, Bruins Vischer</figcaption>
            </figure>
          </div>
        </div>

      </div>
    </section>

    <!-- 5. Werkwijze: de afspraken en registraties als legenda. -->
    <section id="werkwijze" class="ruit scroll-mt-20 border-y border-inkt py-20 md:py-28" aria-labelledby="ww-kop">
      <div class="wrap grid gap-10 md:grid-cols-12 md:gap-6">
        <div class="md:col-span-5">
          <h2 id="ww-kop" class="text-2xl">Heldere afspraken, vooraf op papier.</h2>
          <p class="mt-6 max-w-[30rem] text-lg">Wij werken volgens een heldere methode, conform de huidige beroepsrichtlijnen.</p>
        </div>
        <dl class="grid gap-x-6 border-t border-inkt bg-papier md:col-span-6 md:col-start-7 sm:grid-cols-2">
          <div class="border-b border-lijn py-4"><dt class="font-medium">DNR 2005, revisie 2011</dt><dd class="mt-1 text-grafiet">Standaardvoorwaarden op alle opdrachten die wij aannemen.</dd></div>
          <div class="border-b border-lijn py-4"><dt class="font-medium">Consumentenregeling 2006</dt><dd class="mt-1 text-grafiet">Voor opdrachten van particulieren en kleine rechtspersonen.</dd></div>
          <div class="border-b border-lijn py-4"><dt class="font-medium">Architectenregister</dt><dd class="mt-1 text-grafiet"><a href={site.register} class="lijn">Ingeschreven</a></dd></div>
          <div class="border-b border-lijn py-4"><dt class="font-medium">KIVI</dt><dd class="mt-1 text-grafiet">Lid van het Koninklijk Instituut van Ingenieurs, nr. <span class="tabular-nums">{site.kivi}</span></dd></div>
          <div class="border-b border-lijn py-4 sm:col-span-2"><dt class="font-medium">Verzekerd</dt><dd class="mt-1 text-grafiet">Ons werk is verzekerd bij Centraal Beheer Achmea.</dd></div>
        </dl>
      </div>
    </section>

    <!-- 6. Contact -->
    <section id="contact" class="scroll-mt-20 py-20 md:py-28" aria-labelledby="contact-kop">
      <div class="wrap grid gap-10 md:grid-cols-12 md:gap-6">
        <div class="md:col-span-7">
          <h2 id="contact-kop" class="text-3xl">Bespreek uw plan.</h2>
          <p class="mt-8"><a href={site.telHref} class="text-2xl font-medium tabular-nums no-underline transition-colors hover:text-mos">{site.tel}</a></p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href={planMail} class="knop">Mail ons uw bouwplan</a>
            <a href={`mailto:${site.mail}`} class="lijn break-all">{site.mail}</a>
          </div>
        </div>
        <div class="md:col-span-4 md:col-start-9 md:pt-4">
          <p class="mono text-grafiet">Kantoor</p>
          <p class="mt-2 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-4 text-grafiet">Vijf minuten lopen van NS-station Assen.</p>
          <p class="mt-4"><a href={site.maps} class="lijn">Route in Google Maps</a></p>
        </div>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
