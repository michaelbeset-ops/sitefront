---
// Kleine inline-iconen, geen iconfont.
interface Props { naam: 'tel' | 'mail' | 'kanaal' | 'pijl'; class?: string }
const { naam, class: cls = 'size-5' } = Astro.props;
---
<svg aria-hidden="true" class={`flex-none ${cls}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {naam === 'tel' && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />}
  {naam === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {naam === 'kanaal' && <><path d="M4 11a8 8 0 0 1 8-8" /><path d="M4 11v6l3-2h6a4 4 0 0 0 4-4V9" /><circle cx="18" cy="5" r="2" /></>}
  {naam === 'pijl' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
