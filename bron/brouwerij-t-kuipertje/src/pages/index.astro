---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, opTap, opFles, bieren, stappen, route } from '../data/site';
import hero from '../assets/hero.jpg';
import tap from '../assets/tap.jpg';
import proefplank from '../assets/proefplank.jpg';
import proeverij from '../assets/proeverij.jpg';
import hop from '../assets/hop.jpg';
import polder from '../assets/polder.jpg';
---
<Base
  title="Brouwerij 't Kuipertje | Proeflokaal met terras in Heukelum"
  description="Kleine brouwerij met een proeflokaal aan de Appeldijk in Heukelum. Bier uit eigen brouwerij van de tap en op fles, open op zaterdagmiddag. Ook voor feesten, recepties en studiedagen voor 50 tot 60 mensen."
>
  <Chrome deel="kop" />
  <main id="inhoud">

    <!-- Hero: donker glas onder de tap. Op mobiel: kop, dan meteen de tijden (bierviltje), dan de knoppen. -->
    <section class="op-donker relative isolate overflow-hidden bg-stout text-schuim">
      <div class="absolute inset-0 -z-10">
        <Foto src={hero} alt="Hand houdt een glas onder een tapkraan terwijl er goudblond bier in stroomt" hero sizes="100vw" class="object-[70%_center]" />
        <div aria-hidden="true" class="absolute inset-0 bg-stout/80 lg:bg-transparent lg:bg-[linear-gradient(90deg,#1b1714_0%,#1b1714f2_38%,#1b1714a6_62%,#1b171440_100%)]"></div>
      </div>
      <div class="wrap grid gap-8 pt-10 pb-12 sm:pt-16 lg:min-h-[40rem] lg:grid-cols-12 lg:gap-x-8 lg:gap-y-0 lg:py-24">
        <div class="lg:col-span-7 lg:row-start-1 lg:self-end">
          <p class="label text-amber">Proeflokaal met terras, Heukelum</p>
          <h1 class="mt-4 text-4xl">Bier uit eigen brouwerij, getapt aan de Appeldijk</h1>
        </div>

        <!-- Bierviltje met de openingstijden -->
        <div class="lg:col-span-4 lg:col-start-9 lg:row-span-2 lg:row-start-1 lg:self-center">
          <div class="rounded-2xl bg-schuim p-5 text-stout shadow-[0_1px_2px_#0006] sm:p-7 lg:rotate-[-3deg]">
            <div class="flex items-baseline justify-between gap-3 border-b-2 border-stout pb-2">
              <h2 class="font-display text-xl font-extrabold">Open</h2>
              <p class="text-xs font-semibold text-ink-soft">proeflokaal en terras</p>
            </div>
            <dl class="mt-1 divide-y divide-line">
              {tijden.map((t) => (
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 py-2.5">
                  <dt class="font-semibold">{t.dag}</dt>
                  {t.tijd && <dd class="font-display text-lg font-bold whitespace-nowrap tabular-nums">{t.tijd}</dd>}
                  {t.noot && <dd class="basis-full text-sm text-ink-soft">{t.noot}</dd>}
                </div>
              ))}
            </dl>
            <a href={site.kanaal} class="mt-2 inline-flex items-start gap-2 text-sm font-semibold text-koper underline decoration-1 underline-offset-3 hover:text-stout"><Icoon naam="kanaal" class="mt-0.5 size-4" />Actuele openingstijden via ons WhatsApp-kanaal</a>
          </div>
        </div>

        <div class="lg:col-span-7 lg:row-start-2 lg:pt-6">
          <p class="max-w-xl text-lg text-schuim/90">Wilt u een biertje drinken, of een feestje geven, dat kan bij ons. Een kleine brouwerij met een proeflokaal, centraal in Nederland maar verwijderd van de drukte.</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={site.telHref} class="btn btn-koper"><Icoon naam="tel" /><span class="whitespace-nowrap tabular-nums">Bel {site.tel}</span></a>
            <a href={`mailto:${site.mail}`} class="btn btn-lijn"><Icoon naam="mail" />Mail Henk</a>
          </div>
          <p class="mt-6 text-sm text-grijs-licht"><strong class="text-schuim tabular-nums">{site.google.score}</strong> op Google ({site.google.aantal} reviews)</p>
        </div>
      </div>
    </section>

    <!-- 1. Nu op tap: krijtbord naast de flessen en pakketten. -->
    <section id="tap" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-x-10 lg:gap-y-8">
        <div class="lg:col-span-6 lg:row-start-1">
          <div class="rounded-2xl border-[10px] border-koper-donker bg-bord p-6 text-schuim shadow-[0_2px_0_#0003] sm:p-9">
            <h2 class="krijt text-3xl font-bold">Nu op tap</h2>
            <ul class="mt-7 space-y-4">
              {opTap.map((b) => (
                <li class="flex items-baseline gap-3">
                  <span class="krijt text-xl leading-tight sm:text-2xl">{b.naam}</span>
                  <span aria-hidden="true" class="min-w-4 flex-1 border-b-2 border-dotted border-schuim/40"></span>
                  <span class="krijt text-xl text-amber whitespace-nowrap tabular-nums sm:text-2xl">{b.pct}</span>
                </li>
              ))}
            </ul>
            <p class="mt-8 text-sm text-grijs-licht">De taplijst wisselt. We brouwen verschillende soorten bier, afhankelijk van het seizoen en de smaak van de brouwer.</p>
          </div>
        </div>

        <div class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center">
          <h2 class="text-3xl">Een glas uit de tap, of een fles voor thuis</h2>
          <p class="mt-5 text-lg text-ink-soft">Op zaterdagmiddag zijn wij geopend. Dan kunt u een glas van onze bieren uit de tap drinken. Als we bier op fles hebben, kunt u het ook thuis proeven.</p>

          <h3 class="mt-10 text-xl">Nu op fles</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {opFles.map((f) => <li class="rounded-full border border-stout/30 px-4 py-1.5 font-display text-lg font-bold">{f}</li>)}
          </ul>

          <div class="mt-10 grid gap-5 border-t border-line pt-6 sm:grid-cols-2">
            <div>
              <h3 class="text-xl">Bierpakketten</h3>
              <p class="mt-2 text-ink-soft">Ook voor bierpakketten en flessen kunt u bij ons terecht.</p>
            </div>
            <div>
              <h3 class="text-xl">Hapje erbij?</h3>
              <p class="mt-2 text-ink-soft">Neem zelf wat te snacken mee voor bij het bier.</p>
            </div>
          </div>
        </div>
        <div class="aspect-[16/10] overflow-hidden rounded-2xl lg:col-span-6 lg:row-start-2 lg:aspect-[16/9]"><Foto src={tap} alt="Er wordt een glas bier getapt aan een rij glanzende tapkranen op een houten bar" sizes="(min-width: 1024px) 560px, 100vw" class="object-[center_60%]" /></div>
      </div>
    </section>

    <!-- 2. Brouwen: tijdlijn van mout tot glas, horizontaal op desktop. -->
    <section id="brouwen" class="scroll-mt-20 bg-mout py-16 lg:py-24">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="label text-koper">Zo brouwen we</p>
            <h2 class="mt-3 text-3xl">Van mout tot glas in 4 tot 8 weken</h2>
          </div>
          <p class="text-lg text-ink-soft lg:col-span-4 lg:col-start-9">In onze brouwerij maken we bieren van hoge gisting. Tussen brouwen en drinken zit 4 tot 8 weken.</p>
        </div>

        <ol class="mt-12 grid gap-0 lg:mt-16 lg:grid-cols-6 lg:gap-6">
          {stappen.map((s, i) => (
            <li class="relative grid grid-cols-[2.75rem_1fr] gap-x-4 pb-8 lg:block lg:pb-0">
              <span aria-hidden="true" class={`absolute top-11 bottom-0 left-[1.35rem] w-0.5 bg-koper/40 lg:top-[1.35rem] lg:right-[-1.5rem] lg:bottom-auto lg:left-11 lg:h-0.5 lg:w-auto ${i === stappen.length - 1 ? 'hidden' : ''}`}></span>
              <span class="grid size-11 place-items-center rounded-full bg-koper font-display text-xl font-extrabold text-white tabular-nums">{i + 1}</span>
              <div class="lg:mt-5">
                <h3 class="text-xl">{s.naam}</h3>
                <p class="mt-1.5 text-ink-soft">{s.tekst}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="mt-14 grid gap-8 lg:mt-20 lg:grid-cols-12">
          <div class="overflow-hidden rounded-2xl lg:col-span-5">
            <div class="aspect-[4/3] h-full"><Foto src={hop} alt="Lichtgroene hopbellen aan de rank, met bladeren tegen een blauwe lucht" sizes="(min-width: 1024px) 460px, 100vw" /></div>
          </div>
          <div class="grid gap-6 lg:col-span-7">
            <div class="rounded-2xl bg-schuim p-6 shadow-sm ring-1 ring-line sm:p-8">
              <h3 class="text-2xl">Dat laagje op de bodem</h3>
              <p class="mt-3">Door de vergisting op fles zit er op de bodem een laagje bezinksel. Schenk de fles voorzichtig leeg, dan blijft het bier helder.</p>
              <p class="mt-3 font-display text-xl italic">Is er toch wat bezinksel meegekomen? Geen probleem, gewoon opdrinken. Zo krijgt u zelfs nog wat vitamine B binnen.</p>
            </div>
            <div class="rounded-2xl border-2 border-dashed border-koper/50 p-6 sm:p-8">
              <p class="label text-koper">Biologische mouten, sinds oktober 2009</p>
              <ul class="mt-4 grid gap-4 sm:grid-cols-3">
                <li><strong class="font-display text-lg">Weyermann</strong><br /><span class="text-sm text-ink-soft">mouterij in Bamberg, Duitsland</span></li>
                <li><strong class="font-display text-lg">Dingemans</strong><br /><span class="text-sm text-ink-soft">mouterij in België</span></li>
                <li><strong class="font-display text-lg">Holland Malt</strong><br /><span class="text-sm text-ink-soft">Nederland</span></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Alle bieren: naslaglijst met grote percentages. -->
    <section id="bieren" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-24">
            <h2 class="text-3xl">Alle bieren van 't Kuipertje</h2>
            <p class="mt-5 text-ink-soft">Bieren die we onregelmatig hebben. Wat er nu te krijgen is, ziet u op het krijtbord hierboven.</p>
            <div class="mt-8 hidden aspect-[4/3] overflow-hidden rounded-2xl lg:block"><Foto src={proefplank} alt="Vijf proefglazen bier, van blond tot donker, op een houten plankje op een stalen bar" sizes="360px" /></div>
          </div>
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <ul class="border-t-2 border-stout">
            {bieren.map((b) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-line py-4">
                <div>
                  <h3 class="text-xl sm:text-2xl">{b.naam}</h3>
                  {b.soort && <p class="text-sm text-ink-soft">{b.soort}</p>}
                </div>
                <p class="font-display text-2xl font-extrabold text-koper whitespace-nowrap tabular-nums">{b.pct}</p>
              </li>
            ))}
          </ul>
          <p class="mt-6 font-display text-xl italic">En dan nog voorjaarsbier, zomerbier en bokbier.</p>
          <div class="mt-8 aspect-[16/10] overflow-hidden rounded-2xl lg:hidden"><Foto src={proefplank} alt="Vijf proefglazen bier, van blond tot donker, op een houten plankje op een stalen bar" sizes="100vw" /></div>
        </div>
      </div>
    </section>

    <!-- 4. Feesten en groepen: donker, feiten groot, formulier op papier. -->
    <section id="feesten" class="op-donker scroll-mt-20 bg-stout py-16 text-schuim lg:py-24">
      <div class="wrap grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="label text-amber">Groepen en feesten</p>
          <h2 class="mt-3 text-3xl">Feest, receptie of studiedag in het proeflokaal</h2>
          <p class="mt-5 text-lg text-schuim/90">Ons proeflokaal is zeer geschikt voor feesten, recepties en ook studiedagen voor een bedrijf. Wij verzorgen daarbij hapjes, barbecues en buffetten. Een lunch of gourmet voor een kleinere groep behoort ook tot de mogelijkheden.</p>

          <dl class="mt-10 grid gap-px overflow-hidden rounded-2xl bg-line-licht sm:grid-cols-2">
            <div class="bg-stout-2 p-5">
              <dt class="text-sm text-grijs-licht">Groepsgrootte</dt>
              <dd class="mt-1 font-display text-2xl font-extrabold text-amber"><span class="whitespace-nowrap tabular-nums">50 tot 60</span> mensen</dd>
            </div>
            <div class="bg-stout-2 p-5">
              <dt class="text-sm text-grijs-licht">Wanneer</dt>
              <dd class="mt-1 font-display text-xl font-bold">Alle dagen, behalve zaterdagmiddag</dd>
            </div>
            <div class="bg-stout-2 p-5">
              <dt class="text-sm text-grijs-licht">Rondleiding</dt>
              <dd class="mt-1 font-display text-xl font-bold">Vanaf 15 personen, alleen op afspraak</dd>
            </div>
            <div class="bg-stout-2 p-5">
              <dt class="text-sm text-grijs-licht">Eigen etiket</dt>
              <dd class="mt-1 font-display text-xl font-bold">Een speciaal biertje met uw eigen etiket</dd>
            </div>
          </dl>
          <div class="mt-8 aspect-[16/10] overflow-hidden rounded-2xl"><Foto src={proeverij} alt="Proefglazen met rode, amberkleurige en blonde dranken op houten plankjes op een glanzende bar" sizes="(min-width: 1024px) 560px, 100vw" class="origin-[88%_75%] scale-[1.45]" /></div>
        </div>

        <div class="lg:col-span-5 lg:col-start-8">
          <form class="rounded-2xl bg-schuim p-6 text-stout sm:p-8 lg:sticky lg:top-24" action={`mailto:${site.mail}`} method="post" enctype="text/plain">
            <h3 class="text-2xl">Vraag een datum aan</h3>
            <p class="mt-2 text-sm text-ink-soft">Vertel wat u wilt vieren, wanneer en met hoeveel mensen.</p>
            <div class="mt-6 grid gap-4">
              <label class="block text-sm font-semibold">Naam<input class="veld" type="text" name="naam" autocomplete="name" /></label>
              <label class="block text-sm font-semibold">Telefoon of e-mail<input class="veld" type="text" name="contact" autocomplete="email" /></label>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-semibold">Datum<input class="veld" type="date" name="datum" /></label>
                <label class="block text-sm font-semibold">Aantal personen<input class="veld" type="number" name="aantal" min="1" inputmode="numeric" /></label>
              </div>
              <label class="block text-sm font-semibold">Soort gelegenheid
                <select class="veld" name="gelegenheid">
                  <option>Feest</option>
                  <option>Receptie</option>
                  <option>Studiedag</option>
                  <option>Rondleiding (vanaf 15 personen)</option>
                  <option>Bier met eigen etiket</option>
                  <option>Iets anders</option>
                </select>
              </label>
              <label class="block text-sm font-semibold">Bericht<textarea class="veld min-h-28" name="bericht" rows="4"></textarea></label>
            </div>
            {site.voorstel ? (
              <p class="mt-6 rounded-xl bg-mout p-4 text-sm">Dit is een ontwerpvoorstel: het formulier verstuurt nog niets. Bel <a href={site.telHref} class="font-semibold whitespace-nowrap text-koper underline">{site.tel}</a> of mail naar <a href={`mailto:${site.mail}`} class="font-semibold text-koper underline [overflow-wrap:anywhere]">{site.mail}</a>.</p>
            ) : (
              <button type="submit" class="btn btn-koper mt-6 w-full">Aanvraag versturen</button>
            )}
          </form>
        </div>
      </div>
    </section>

    <!-- 5. Route: adres en genummerde stappen langs een stippellijn, polder als vergezicht. -->
    <section id="route" class="scroll-mt-20 py-16 lg:py-24">
      <div class="wrap">
        <div class="aspect-[16/10] overflow-hidden rounded-2xl sm:aspect-[21/7]"><Foto src={polder} alt="Witte molen op een groene wal, met riet en water op de voorgrond en een kerktoren in de verte" sizes="(min-width: 1216px) 1152px, 100vw" class="object-[center_35%]" /></div>
        <div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <p class="label text-koper">Route</p>
            <h2 class="mt-3 text-3xl">Boven op de dijk, aan de linkerkant</h2>
            <address class="mt-6 font-display text-2xl leading-snug font-bold not-italic">{site.straat}<br />{site.postcode} {site.plaats}</address>
            <p class="mt-4 text-ink-soft">Wij zitten op het terrein van de Koornwaard. Volg dus de borden met Koornwaard.</p>
            <a href={site.maps} rel="noopener" class="btn btn-koper mt-7">Route plannen <Icoon naam="pijl" /></a>
            <p class="mt-8 border-l-4 border-koper pl-4 text-ink-soft">Heukelum ligt op de grens van Zuid-Holland, Gelderland en Utrecht. Centraal in Nederland, maar verwijderd van de drukte.</p>
          </div>
          <div class="lg:col-span-6 lg:col-start-7">
            <h3 class="text-xl">Vanaf de A15</h3>
            <ol class="mt-6">
              {route.map((r, i) => (
                <li class="relative grid grid-cols-[2.5rem_1fr] gap-x-4 pb-6 last:pb-0">
                  {i < route.length - 1 && <span aria-hidden="true" class="absolute top-10 bottom-1 left-[1.2rem] border-l-2 border-dashed border-stout/30"></span>}
                  <span class="grid size-10 place-items-center rounded-full border-2 border-stout font-display text-lg font-extrabold tabular-nums">{i + 1}</span>
                  <p class="pt-1.5">{r}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Contact: de brouwer, groot telefoonnummer, sluit aan op de footer. -->
    <section id="contact" class="op-donker scroll-mt-20 bg-stout pt-16 pb-12 text-schuim lg:pt-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="label text-amber">Contact</p>
          <h2 class="mt-3 text-3xl">Een vraag voor de brouwer?</h2>
          <p class="mt-5 max-w-lg text-lg text-schuim/90">Henk Kuiper brouwt het bier van 't Kuipertje. Bel hem, of mail. Geen gehoor? Spreek gerust in, of stuur een sms of Signal-bericht.</p>
          <p class="krijt mt-8 text-2xl text-amber">Groeten en tot ziens, Henk Kuiper</p>
        </div>
        <dl class="grid content-start gap-6 lg:col-span-5 lg:col-start-8">
          <div><dt class="text-sm text-grijs-licht">Telefoon, sms of Signal</dt><dd><a href={site.telHref} class="font-display text-3xl font-extrabold whitespace-nowrap tabular-nums underline decoration-amber decoration-2 underline-offset-6">{site.tel}</a></dd></div>
          <div><dt class="text-sm text-grijs-licht">E-mail</dt><dd><a href={`mailto:${site.mail}`} class="text-lg break-all underline decoration-amber decoration-2 underline-offset-4">{site.mail}</a></dd></div>
          <div><dt class="text-sm text-grijs-licht">Nieuws en actuele openingstijden</dt><dd><a href={site.kanaal} class="inline-flex items-center gap-2 text-lg underline decoration-amber decoration-2 underline-offset-4"><Icoon naam="kanaal" />WhatsApp-kanaal van 't Kuipertje</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
