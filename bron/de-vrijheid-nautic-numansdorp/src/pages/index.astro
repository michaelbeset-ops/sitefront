---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import { Image } from 'astro:assets';
import { site, url, wa, waMet, mailMet } from '../data/site';
import cees from '../assets/cees.jpg';
import dekzeil from '../assets/dekzeil.jpg';
import wintertent from '../assets/wintertent.jpg';
import letters from '../assets/letters.jpg';
import bonaireBoot from '../assets/bonaire-boot.jpg';
import bonaireZeil from '../assets/bonaire-zeil.jpg';

// Het doek in de opening: koperen ogen langs boven- en onderrand, met sjorlijnen naar de rand van het scherm.
const W = 1440, H = 430, L = 56, R = 1384, T = 30, B = 400;
const xs = [80, 300, 520, 720, 920, 1140, 1360];
const ogen = [...xs.map((x) => ({ x, y: T + 22, nx: x + (x - 720) * 0.04, ny: 0 })), ...xs.map((x) => ({ x, y: B - 22, nx: x + (x - 720) * 0.04, ny: H }))];
const mw = 390, mh = 330, mL = 14, mR = 376, mT = 22, mB = 312;
const mOgen = [44, 195, 346].flatMap((x) => [{ x, y: mT + 16, nx: x, ny: 0 }, { x, y: mB - 16, nx: x, ny: mh }]);

const werk = [
  ['Afdekzeilen en dekkleden', 'een afdekzeil'],
  ['Winter- en dektenten', 'een winter- of dektent'],
  ['Huiken', 'een huik'],
  ['Alles voor de bruine vloot', 'iets voor de bruine vloot'],
  ['Zeilreparaties', 'een zeilreparatie'],
  ['Autohoezen en industriewerk', 'een autohoes of industriewerk'],
  ['Advies en beoordelingen', 'advies of een beoordeling'],
];
---
<Base title="De Vrijheid Nautic Zeilmakerij | Numansdorp" description="Zeilmakerij van Cees Sorber aan de Havenkade in Numansdorp: afdekzeilen, winter- en dektenten, huiken, alles voor de bruine vloot en zeilreparaties.">
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Opening: een taanrood doek, gesjord aan de rand van het scherm, met doorgestikte letters. -->
    <section aria-label="De Vrijheid Nautic Zeilmakerij">
      <svg viewBox={`0 0 ${W} ${H}`} class="mx-auto hidden h-auto w-full max-w-[100rem] md:block" aria-hidden="true">
        <defs>
          <pattern id="weef" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M0 0H5M0 0V5" stroke="#000" stroke-opacity=".09" stroke-width="1" /></pattern>
        </defs>
        {ogen.map((o) => <line x1={o.x} y1={o.y} x2={o.nx} y2={o.ny} stroke="#c7ad7f" stroke-width="3" />)}
        <line x1={xs[0]} y1={T + 22} x2="0" y2={T + 4} stroke="#c7ad7f" stroke-width="3" />
        <line x1={xs[6]} y1={T + 22} x2={W} y2={T + 4} stroke="#c7ad7f" stroke-width="3" />
        <line x1={xs[0]} y1={B - 22} x2="0" y2={B - 4} stroke="#c7ad7f" stroke-width="3" />
        <line x1={xs[6]} y1={B - 22} x2={W} y2={B - 4} stroke="#c7ad7f" stroke-width="3" />
        <rect x={L} y={T} width={R - L} height={B - T} fill="#7a3120" />
        <rect x={L} y={T} width={R - L} height={B - T} fill="url(#weef)" />
        <rect x={L + 9} y={T + 9} width={R - L - 18} height={B - T - 18} fill="none" stroke="#e8e9e4" stroke-opacity=".55" stroke-width="1.5" stroke-dasharray="8 6" />
        <rect x={L + 15} y={T + 15} width={R - L - 30} height={B - T - 30} fill="none" stroke="#e8e9e4" stroke-opacity=".35" stroke-width="1.5" stroke-dasharray="8 6" />
        <g style="font-family:'Anybody Variable',sans-serif;font-weight:800;font-stretch:130%">
          <text x="720" y="268" text-anchor="middle" font-size="196" textLength="1150" lengthAdjust="spacingAndGlyphs" fill="#e8e9e4" stroke="#e8e9e4" stroke-width="14" stroke-linejoin="round">DE VRIJHEID</text>
          <text x="720" y="268" text-anchor="middle" font-size="196" textLength="1150" lengthAdjust="spacingAndGlyphs" fill="none" stroke="#7a3120" stroke-width="2" stroke-dasharray="9 6">DE VRIJHEID</text>
        </g>
        <g style="font-family:'Anybody Variable',sans-serif;font-weight:600;font-stretch:120%" font-size="21" letter-spacing="6" fill="#f0cdb9">
          <text x="128" y="344">NAUTIC ZEILMAKERIJ</text>
          <text x="1312" y="344" text-anchor="end">HAVENKADE 6 · NUMANSDORP</text>
        </g>
        {ogen.map((o) => <g><circle cx={o.x} cy={o.y} r="9" fill="#e8e9e4" stroke="#b98d3a" stroke-width="6" /><circle cx={o.x} cy={o.y} r="12" fill="none" stroke="#4c1c12" stroke-opacity=".35" stroke-width="1" /></g>)}
      </svg>
      <svg viewBox={`0 0 ${mw} ${mh}`} class="block h-auto w-full md:hidden" aria-hidden="true">
        <defs>
          <pattern id="weef-m" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M0 0H5M0 0V5" stroke="#000" stroke-opacity=".09" stroke-width="1" /></pattern>
        </defs>
        {mOgen.map((o) => <line x1={o.x} y1={o.y} x2={o.nx} y2={o.ny} stroke="#c7ad7f" stroke-width="2.5" />)}
        <rect x={mL} y={mT} width={mR - mL} height={mB - mT} fill="#7a3120" />
        <rect x={mL} y={mT} width={mR - mL} height={mB - mT} fill="url(#weef-m)" />
        <rect x={mL + 7} y={mT + 7} width={mR - mL - 14} height={mB - mT - 14} fill="none" stroke="#e8e9e4" stroke-opacity=".55" stroke-width="1.2" stroke-dasharray="6 4" />
        <g style="font-family:'Anybody Variable',sans-serif;font-weight:800;font-stretch:130%">
          <text x="195" y="146" text-anchor="middle" font-size="74" fill="#e8e9e4" stroke="#e8e9e4" stroke-width="9" stroke-linejoin="round">DE</text>
          <text x="195" y="146" text-anchor="middle" font-size="74" fill="none" stroke="#7a3120" stroke-width="1.5" stroke-dasharray="6 4">DE</text>
          <text x="195" y="230" text-anchor="middle" font-size="80" textLength="318" lengthAdjust="spacingAndGlyphs" fill="#e8e9e4" stroke="#e8e9e4" stroke-width="9" stroke-linejoin="round">VRIJHEID</text>
          <text x="195" y="230" text-anchor="middle" font-size="80" textLength="318" lengthAdjust="spacingAndGlyphs" fill="none" stroke="#7a3120" stroke-width="1.5" stroke-dasharray="6 4">VRIJHEID</text>
        </g>
        <text x="195" y="268" text-anchor="middle" font-size="13" letter-spacing="4" fill="#f0cdb9" style="font-family:'Anybody Variable',sans-serif;font-weight:600;font-stretch:120%">NAUTIC ZEILMAKERIJ</text>
        {mOgen.map((o) => <circle cx={o.x} cy={o.y} r="6.5" fill="#e8e9e4" stroke="#b98d3a" stroke-width="4.5" />)}
      </svg>

      <div class="wrap grid gap-8 pb-16 pt-6 md:pt-8 lg:grid-cols-12 lg:gap-10 lg:pb-24">
        <div class="lg:col-span-8 lg:col-start-5 lg:row-start-1 lg:pl-4">
          <h1 class="text-[clamp(1.9rem,3.4vw,3.3rem)] leading-[1.02]">Afdekzeilen, winter&shy;tenten, huiken en zeil&shy;reparaties.</h1>
          <p class="mt-4 max-w-[34rem] text-grijs">Eersteklas maatwerk van hoogwaardige materialen, uit een werkplaats aan de haven van Numansdorp. Langskomen kan op afspraak.</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={waMet('ik heb een vraag over ')} class="knop"><Fragment set:html={wa} />App Cees op WhatsApp</a>
          <p class="text-sm">of bel <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a></p>
          </div>
        </div>
        <figure class="lg:col-span-4 lg:col-start-1 lg:row-start-1">
          <div class="aspect-[3/2] max-w-[30rem] overflow-hidden"><Image src={cees} alt="Cees Sorber lachend met zijn herdershond op de arm" widths={[400, 640, 800]} sizes="(min-width: 1024px) 30vw, 100vw" format="webp" quality={62} class="block h-full w-full object-cover" /></div>
          <figcaption class="mt-2 text-xs text-grijs">{site.wie}, zeilmaker</figcaption>
        </figure>
      </div>
    </section>

    <!-- Wat Cees maakt: elke regel opent een WhatsApp-bericht over dat onderwerp. -->
    <section id="maakt" class="grid border-t border-lijn lg:grid-cols-12">
      <figure class="relative h-[20rem] sm:h-[28rem] lg:col-span-6 lg:h-auto lg:min-h-[36rem]">
        <Foto src={dekzeil} alt="Een boot onder een strak afdekzeil op het water, met een meeuw op het zeil" sizes="(min-width: 1024px) 50vw, 100vw" class="object-[22%_58%]" />
      </figure>
      <div class="px-5 py-16 md:px-12 lg:col-span-6 lg:px-16 lg:py-24">
        <h2 class="text-2xl">Van dekkleed tot huik.</h2>
        <p class="mt-4 max-w-[30rem] text-grijs">Tik op wat u nodig heeft: dan staat er een bericht aan Cees voor u klaar.</p>
        <ul class="mt-8 border-t border-lijn">
          {werk.map(([titel, onderwerp]) => (
            <li><a href={waMet(`ik heb een vraag over ${onderwerp}: `)} class="regel naad text-lg font-semibold"><span>{titel}</span><span class="pijl font-normal">WhatsApp &rarr;</span></a></li>
          ))}
        </ul>
        <div class="mt-10 grid grid-cols-[7rem_1fr] items-end gap-5">
          <div class="aspect-[3/4] overflow-hidden"><Foto src={wintertent} alt="Een zeilboot op de kant onder een witte wintertent" sizes="112px" class="object-[50%_62%]" /></div>
          <p class="text-sm text-grijs">Ook industriewerk en beoordelingen van bestaand doek. [[AANLEVEREN: foto's van eigen werk]]</p>
        </div>
      </div>
    </section>

    <!-- Ook ver weg. -->
    <section id="ver-weg" class="op-taan bg-taan text-doek">
      <div class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:py-28">
        <div class="lg:col-span-7">
          <p class="text-sm text-taan-licht">April 2008, de telefoon:</p>
          <h2 class="mt-3 text-3xl">&ldquo;Kan je naar Bonaire komen om een grootzeil te maken?&rdquo;</h2>
          <div class="mt-10 flex flex-wrap gap-3">
            <Image src={bonaireBoot} alt="Een houten zeilboot aan de kade op Bonaire, helder blauw water" width={256} height={192} class="block h-auto w-[45%] max-w-[16rem] sm:w-auto" />
            <Image src={bonaireZeil} alt="Zeildoek en touwwerk aan dek van een houten boot op Bonaire" width={256} height={192} class="block h-auto w-[45%] max-w-[16rem] sm:w-auto" />
          </div>
          <p class="mt-3 text-xs text-taan-licht">Foto's van het Bonaire-project, van de huidige website.</p>
        </div>
        <div class="lg:col-span-5 lg:pt-4">
          <div class="overflow-hidden"><Image src={letters} alt="Taanrood doek met witte, doorgestikte letters: de naam en het telefoonnummer van de Spartivento" widths={[400, 614]} sizes="(min-width: 1024px) 34vw, 100vw" format="webp" quality={64} class="block h-auto w-full" /></div>
          <h3 class="mt-5 text-xl">Doorgestikte letters op doek</h3>
          <p class="mt-2 text-taan-licht">Voor de Spartivento: naam en telefoonnummer in het doek.</p>
        </div>
      </div>
    </section>

    <!-- De werkplaats. -->
    <section id="werkplaats" class="wrap grid gap-10 py-20 lg:grid-cols-12 lg:py-28">
      <div class="lg:col-span-6">
        <h2 class="text-2xl">Geen vaste openingstijden.</h2>
        <p class="mt-5 max-w-[32rem] text-lg text-grijs">De werkplaats zit in een karakteristiek huis aan de haven. App, bel of mail gerust voor een afspraak.</p>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <p class="naad pb-4 text-xl font-semibold">{site.straat}<br />{site.postcode} {site.plaats}</p>
        <div class="mt-6 flex flex-col items-start gap-4">
          <a href={waMet('ik wil graag een afspraak maken in de werkplaats.')} class="knop"><Fragment set:html={wa} />Maak een afspraak via WhatsApp</a>
          <p class="text-sm">Bel <a href={site.telHref} class="lijn whitespace-nowrap tabular-nums">{site.tel}</a> of mail <a href={mailMet('Offerte aanvragen')} class="lijn break-all">{site.mail}</a></p>
        </div>
        <p class="mt-10 text-sm text-grijs"><a href={site.maps} class="lijn">Route in Google Maps</a> · {site.google.score} op Google ({site.google.aantal} reviews)</p>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
</Base>
