---
import { site, url, waHoi, tijden } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const winkel = ['Vintage kleding', 'Tweedehands', 'Duurzaam nieuw', 'Sieraden', 'Kleuranalyse'];
const rij = [2, 3, 4, 5, 6, 0, 1].map((i) => tijden[i]);
---
<footer class="bg-luifel text-salie-licht">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-wit md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-salie-licht">Mooi gedragen en eerlijk nieuw, voor vrouwen. Sinds 2013 in Baarn.</p>
      <span class="confetti mt-6" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-wit">In de winkel</p>
      <ul class="mt-3 space-y-1">{winkel.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-4 flex gap-5"><a href={site.instagram} class="link link-licht">Instagram</a><a href={site.facebook} class="link link-licht">Facebook</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-wit">Open</p>
      <dl class="num mt-3 grid grid-cols-[auto_1fr] gap-x-5 gap-y-1">
        {rij.map(([d, t]) => <><dt>{d}</dt><dd>{t ?? 'gesloten'}</dd></>)}
      </dl>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van jullie eigen Google-bedrijfsprofiel en Instagram. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
