---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import vintage from '../assets/vintage.jpg';
import nieuw from '../assets/look-basics.jpg';
import lookSkfk from '../assets/nieuw.jpg';
import lookTwin from '../assets/look-twin.jpg';
import team from '../assets/team.jpg';
import kleur from '../assets/kleur.jpg';

// Merken: Instagram-bio (2026) en hun eigen posts van september 2026 en september 2025.
const merken = ['Armedangels', 'SKFK', 'Oska', 'DAWN', 'Basic Apparel', 'Mazine', 'Genesis', 'The Tiny Big Sister'];
const maten = ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'weet ik niet'];
const rij = [2, 3, 4, 5, 6, 0, 1];

const titel = 'ènz. FAIRWEAR | Vintage en duurzaam nieuw in Baarn';
const omschrijving = 'Mooi gedragen en eerlijk nieuw: vintage, tweedehands en duurzame merken als Armedangels, SKFK, Oska en DAWN. Plus sieraden en kleuranalyse. Laanstraat 75, Baarn.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: hun eigen pui met de grijsgroene boogluifel en de rekken op de stoep -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-luifel text-wit">
      <Image src={hero} alt="De winkel aan de Laanstraat: een grijsgroene boogluifel boven de deur, ènz. FAIRWEAR op de ruit en rekken met jassen op de stoep" quality={74} widths={[480, 720, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[52%_50%] md:object-[50%_45%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1b232273_0%,#1b232226_18%,#1b232299_36%,#1b2322e0_62%,#1b2322f5_100%)] lg:bg-[linear-gradient(90deg,#1b2322e0_0%,#1b2322a6_34%,#1b232233_60%,#1b232200_80%),linear-gradient(0deg,#1b232299_0%,#1b232200_40%)]" aria-hidden="true"></div>
      <div class="wrap pb-28 pt-32 md:pb-16 lg:pb-20">
        <p class="text-sm font-medium text-wit/85">Vintage en duurzaam nieuw · Laanstraat 75, Baarn</p>
        <h1 class="vet mt-5 text-hero [text-shadow:0_2px_30px_#1b232280]">Mooi gedragen.<br /><span class="text-salie-licht">Eerlijk nieuw.</span></h1>
        <p class="mt-7 max-w-[31rem] text-lg text-wit/90">Tweedehands en vintage naast duurzame merken als Armedangels, SKFK, Oska en DAWN.</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#apart" class="knop knop-wit">Leg iets voor me apart<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-lijn num max-sm:hidden"><Icoon naam="tel" />{site.tel}</a>
        </div>
        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-lijn-licht pt-5 text-sm text-wit/85">
          <p class="num">Dinsdag t/m vrijdag 10.00-17.30 · zaterdag 10.00-17.00</p>
          <span class="confetti max-sm:hidden" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        </div>
      </div>
    </section>

    <!-- 2. DE WINKEL: twee rekken, vintage en nieuw, in boog-uitsnedes zoals hun luifel -->
    <section id="winkel" class="py-20 md:py-24" aria-labelledby="winkel-titel">
      <div class="wrap">
        <h2 id="winkel-titel" class="rijs vet max-w-[14ch] text-4xl">Twee rekken, één winkel.</h2>

        <div class="mt-14 grid gap-y-16 md:mt-16 md:grid-cols-12 md:gap-x-10">
          <div class="rijs md:col-span-7 lg:col-span-6">
            <div class="boog bg-poeder">
              <Image src={vintage} alt="Een rek vol kleurige tweedehands kleding achter in de winkel, ernaast een van de dames van ènz. in een pied-de-poule jas" quality={72} widths={[480, 800, 1100]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/5] w-full object-cover object-[38%_50%] md:aspect-[4/3]" />
            </div>
            <h3 class="vet mt-8 text-3xl">Vintage &amp; tweedehands</h3>
            <p class="mt-4 max-w-sm text-lg text-grijs">Mooi gedragen tweedehands kleding, vintage kleding en sieraden.</p>
          </div>
          <div class="rijs min-w-0 md:col-span-4 md:col-start-9 md:mt-20" style="--d:.12s">
            <div class="boog bg-poeder">
              <Image src={nieuw} alt="Een look van Basic Apparel: geruit jasje, gestreept shirt en wijde broek, tegen de roze muur van de paskamer" quality={72} widths={[480, 760, 1000]} sizes="(min-width: 768px) 32vw, 100vw" class="aspect-[4/5] w-full object-cover object-[50%_30%]" />
            </div>
            <h3 class="vet mt-8 text-3xl">Duurzaam nieuw</h3>
            <p class="mt-4 text-lg text-grijs">Eerlijke nieuwe dameskleding van duurzame merken. Onder andere:</p>
          </div>
          <p class="rijs kop vet text-2xl leading-snug text-luifel md:col-span-12 md:-mt-4 md:text-3xl">
            {merken.map((m, i) => <><span class="whitespace-nowrap">{m}{i < merken.length - 1 && <span class="ml-3 text-salie" aria-hidden="true">·</span>}</span>{' '}</>)}
          </p>
        </div>

        <figure class="rijs mx-auto mt-20 max-w-4xl text-center md:mt-24">
          <blockquote class="kop vet text-3xl leading-tight">“Oorbellen, haarclips, sjaaltjes, kettingen, ringen, we hebben zoveel moois.”</blockquote>
          <figcaption class="mt-5 text-sm text-grijs">ènz. op Facebook, oktober 2026</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. NET BINNEN: twee looks van hun eigen Instagram, met hun eigen onderschrift -->
    <section id="nieuw" class="bg-poeder py-20 md:py-24" aria-labelledby="nieuw-titel">
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="nieuw-titel" class="rijs vet text-4xl">Net binnen</h2>
          <a href={site.instagram} class="rijs link inline-flex items-center gap-2 text-lg"><Icoon naam="insta" class="h-5 w-5" />@enzfairwear</a>
        </div>
        <div class="mt-14 grid gap-y-14 md:grid-cols-12 md:gap-x-10">
          <figure class="rijs md:col-span-6 lg:col-span-5 lg:col-start-2">
            <Image src={lookSkfk} alt="Een bordeauxrood pak van SKFK met lichtblauw shirt en gebreide balaclava, tegen de roze muur" quality={72} widths={[480, 800, 1100]} sizes="(min-width: 768px) 56vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_35%]" />
            <figcaption class="mt-5">
              <span class="kop vet block text-2xl">Stunning SKFK suit</span>
              <span class="mt-1 block text-grijs">Jasje, broek, t-shirt en balaclava: SKFK. Schoenen: Genesis.</span>
            </figcaption>
          </figure>
          <figure class="rijs md:col-span-5 md:col-start-8 md:mt-32 lg:col-span-4 lg:col-start-8" style="--d:.12s">
            <Image src={lookTwin} alt="Twee vrouwen in gestreepte truien met kraag, jeans en petjes" quality={72} widths={[480, 760, 1000]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_30%]" />
            <figcaption class="mt-5">
              <span class="kop vet block text-2xl">Twinning is winning!</span>
              <span class="mt-1 block text-grijs">Truien: The Tiny Big Sister. Jeans: DAWN. Sneakers: Genesis. Petjes: Armedangels.</span>
            </figcaption>
          </figure>
        </div>
        <p class="rijs mt-14 text-sm text-grijs">Uit onze Instagram, september 2026. Vraag in de winkel wat er nog hangt.</p>
      </div>
    </section>

    <!-- 4. DE DAMES: hun eigen teamfoto, met hun eigen woorden -->
    <section class="bg-luifel py-24 text-wit md:py-28" aria-labelledby="team-titel">
      <div class="wrap grid items-center gap-y-12 md:grid-cols-12 md:gap-x-12">
        <div class="rijs md:col-span-6">
          <Image src={team} alt="Het ènz.-team op een rij voor een muur vol ansichtkaarten, gestyled in de nieuwe collectie met vintage parels" quality={72} widths={[480, 760, 1000]} sizes="(min-width: 768px) 46vw, 100vw" class="aspect-[4/5] w-full rounded-sm object-cover object-[50%_40%] lg:aspect-[1/1]" />
        </div>
        <div class="md:col-span-6 md:pl-6">
          <h2 id="team-titel" class="rijs vet text-4xl">The ènz-Team</h2>
          <blockquote class="rijs mt-8 max-w-md text-xl leading-relaxed text-wit/90" style="--d:.1s">“Onze shootdag was een goed moment voor een teamfoto. Natuurlijk gestyled in onze nieuwste collectie, in combinatie met vintage parels.”</blockquote>
          <p class="rijs mt-4 text-sm text-salie-licht" style="--d:.15s">Op Instagram, september 2025</p>
          <p class="rijs mt-10 max-w-md text-lg text-salie-licht" style="--d:.2s">Sinds 2013 in Baarn. Kom binnen voor een praatje, of om iets te passen.</p>
        </div>
      </div>
    </section>

    <!-- 5. KLEURANALYSE -->
    <section id="kleur" class="py-20 md:py-24" aria-labelledby="kleur-titel">
      <div class="wrap grid items-center gap-y-12 md:grid-cols-12 md:gap-x-12">
        <div class="md:col-span-6">
          <h2 id="kleur-titel" class="rijs vet max-w-[13ch] text-4xl">Welke kleuren staan jou?</h2>
          <p class="rijs mt-7 max-w-md text-lg text-grijs" style="--d:.08s">Een kleuranalyse legt de basis. We helpen je jouw eigen kleurenpalet samen te stellen. Ook voor een figuuranalyse kun je bij ons terecht.</p>
          <p class="rijs mt-4 max-w-md text-lg text-grijs" style="--d:.12s">Maximaal twee personen tegelijk.</p>
          <a href={waMet('Hoi ènz., ik wil graag een kleuranalyse plannen. Wanneer kan dat?')} class="rijs knop mt-9" style="--d:.16s"><Icoon naam="wa" />Kleuranalyse plannen</a>
        </div>
        <div class="rijs boog mx-auto w-full max-w-md bg-poeder md:col-span-5 md:col-start-8" style="--d:.1s">
          <Image src={kleur} alt="Een kleurenwaaier in de hand tijdens een kleuranalyse, op schoot een doek met de tekst Dark Autumn" quality={74} widths={[400, 680]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] w-full object-cover" />
        </div>
      </div>
    </section>

    <!-- 6. APART LEGGEN: een kledinglabel dat een WhatsApp-bericht wordt -->
    <section id="apart" class="bg-poeder py-20 md:py-24" aria-labelledby="apart-titel">
      <div class="wrap grid items-center gap-y-12 md:grid-cols-12 md:gap-x-12">
        <div class="md:col-span-5">
          <h2 id="apart-titel" class="rijs vet text-4xl">Iets gezien?</h2>
          <p class="rijs mt-7 max-w-sm text-lg text-grijs" style="--d:.08s">Op Instagram of in de etalage. Vraag of we het voor je apart leggen, of welke maat valt.</p>
          <span class="rijs confetti mt-10" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        </div>
        <form class="rijs label mx-auto w-full max-w-md px-6 pb-8 pt-16 sm:px-9 md:col-span-6 md:col-start-7" data-label style="--d:.1s" novalidate>
          <p class="kop vet text-center text-3xl">ènz.</p>
          <p class="mt-1 text-center text-[.6rem] font-medium tracking-[.42em] text-grijs">FAIRWEAR</p>
          <div class="mt-8 space-y-6">
            <label class="block">
              <span class="text-sm font-medium text-grijs">Wat heb je gezien?</span>
              <input name="wat" type="text" class="veld" placeholder="bv. de bordeauxrode SKFK-jas" autocomplete="off" />
            </label>
            <div class="grid grid-cols-2 gap-5">
              <label class="block">
                <span class="text-sm font-medium text-grijs">Je maat</span>
                <select name="maat" class="veld">{maten.map((m) => <option value={m}>{m}</option>)}</select>
              </label>
              <label class="block">
                <span class="text-sm font-medium text-grijs">Je vraag</span>
                <select name="vraag" class="veld">
                  <option value="apart">Apart leggen</option>
                  <option value="maat">Welke maat?</option>
                </select>
              </label>
            </div>
            <label class="block" data-wanneer>
              <span class="text-sm font-medium text-grijs">Ik kom langs</span>
              <select name="wanneer" class="veld">
                <option value="vandaag">vandaag</option>
                <option value="morgen">morgen</option>
                <option value="deze week">deze week</option>
                <option value="zaterdag">zaterdag</option>
              </select>
            </label>
          </div>
          <p class="mt-8 rounded-sm bg-papier p-4 text-sm leading-relaxed text-grijs" aria-live="polite" data-voorbeeld></p>
          <a href={site.wa} class="knop mt-6 w-full" data-stuur><Icoon naam="wa" />Verstuur via WhatsApp</a>
        </form>
      </div>
    </section>

    <!-- 7. BEZOEK: reviews, tijden en route -->
    <section id="bezoek" class="py-20 md:py-24" aria-labelledby="bezoek-titel">
      <div class="wrap">
        <h2 id="bezoek-titel" class="rijs vet max-w-[16ch] text-4xl">Laanstraat 75, Baarn</h2>
        <div class="mt-16 grid gap-y-16 md:grid-cols-12 md:gap-x-12">
          <div class="md:col-span-7">
            <ul class="space-y-12">
              {reviews.map((r, i) => (
                <li class="rijs border-l-2 border-salie pl-6" style={`--d:${i * .08}s`}>
                  <p class="text-xl leading-relaxed">“{r.tekst}”</p>
                  <p class="mt-3 text-sm text-grijs">{r.naam} · Google review · {r.wanneer}</p>
                </li>
              ))}
            </ul>
            <p class="rijs mt-12 inline-flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" />{site.google.score} op Google, {site.google.aantal} reviews</p>
          </div>
          <div class="rijs md:col-span-5" style="--d:.1s">
            <div class="rounded-sm bg-poeder p-7 sm:p-9">
              <p class="flex items-center gap-3 font-medium"><span class="h-2.5 w-2.5 rounded-full bg-salie" data-stip></span><span data-status>Openingstijden</span></p>
              <dl class="num mt-6 divide-y divide-lijn">
                {rij.map((i) => (
                  <div class="flex justify-between gap-4 py-2.5" data-dag={i}>
                    <dt>{tijden[i][0]}</dt>
                    <dd class:list={[!tijden[i][1] && 'text-grijs']}>{tijden[i][1] ?? 'gesloten'}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-7">{site.straat}<br />{site.postcode} {site.plaats}</p>
              <div class="mt-7 flex flex-wrap gap-3">
                <a href={site.maps} class="knop"><Icoon naam="pin" />Route</a>
                <a href={site.telHref} class="knop knop-lijn-donker num">{site.tel}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  // Kledinglabel -> vooraf ingevuld WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-label]');
  if (f) {
    const vb = f.querySelector<HTMLElement>('[data-voorbeeld]')!;
    const stuur = f.querySelector<HTMLAnchorElement>('[data-stuur]')!;
    const wanneer = f.querySelector<HTMLElement>('[data-wanneer]')!;
    const tekst = () => {
      const d = new FormData(f);
      const wat = String(d.get('wat') || '').trim() || 'iets moois';
      const maat = String(d.get('maat'));
      const maatZin = maat === 'weet ik niet' ? 'Mijn maat weet ik niet precies.' : `Mijn maat is ${maat}.`;
      if (d.get('vraag') === 'maat') return `Hoi ènz., ik zag ${wat}. Welke maat raden jullie aan? ${maat === 'weet ik niet' ? 'Mijn maat weet ik niet precies.' : `Ik draag meestal ${maat}.`}`;
      return `Hoi ènz., ik zag ${wat}. Kunnen jullie dit voor me apart leggen? ${maatZin} Ik kom ${d.get('wanneer')} langs.`;
    };
    const zet = () => {
      wanneer.hidden = new FormData(f).get('vraag') === 'maat';
      const t = tekst(); vb.textContent = t; stuur.href = `${site.wa}?text=${encodeURIComponent(t)}`;
    };
    f.addEventListener('input', zet); f.addEventListener('change', zet); f.addEventListener('submit', (e) => e.preventDefault()); zet();
  }
  // Vandaag markeren en live open/gesloten.
  const tijden: (string | null)[] = [null, null, '10.00-17.30', '10.00-17.30', '10.00-17.30', '10.00-17.30', '10.00-17.00'];
  const nu = new Date(); const dag = nu.getDay(); const t = tijden[dag];
  document.querySelector(`[data-dag="${dag}"]`)?.classList.add('font-semibold', 'text-luifel');
  const s = document.querySelector('[data-status]'); const stip = document.querySelector('[data-stip]');
  if (s && stip) {
    const min = nu.getHours() * 60 + nu.getMinutes();
    const [o, d] = t ? t.split('-').map((x) => { const [h, m] = x.split('.').map(Number); return h * 60 + m; }) : [0, 0];
    const open = !!t && min >= o && min < d;
    s.textContent = open ? `Nu open, tot ${t!.split('-')[1]}` : (t && min < o ? `Nu gesloten, vandaag open vanaf ${t.split('-')[0]}` : 'Nu gesloten');
    stip.classList.toggle('bg-c3', open); stip.classList.toggle('bg-c1', !open); stip.classList.remove('bg-salie');
  }
</script>
