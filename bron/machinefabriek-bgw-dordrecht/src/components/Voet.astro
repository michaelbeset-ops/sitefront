---
import { site, url, producten } from '../data/site';
import Logo from './Logo.astro';
const jaar = new Date().getFullYear();
---
<footer class="bg-diep text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-sm md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <span class="text-wit" style="--logo-vul: #0a1730; --logo-as: #6fb0e0"><Logo class="h-14 w-auto" /></span>
      <p class="mt-6 max-w-xs">Gespecialiseerd in lang draaiwerk tot 12 meter. Bekend met alle keuringsinstanties en de hoogste kwaliteitseisen.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Draaiwerk</p>
      <ul class="mt-4 space-y-1.5">
        {producten.map((p) => <li>{p}</li>)}
        <li>Kotteren, spiebaan steken, richten</li>
        <li>Dye Penetrant Test</li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num">{site.tel}</a></p>
      <p class="mt-1.5"><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></p>
      <p class="mt-1.5"><a href={site.maps} class="link">Route</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Werkplaats</p>
      <p class="mt-4 num">Ma - vr<br />07.30 - 16.30</p>
      <p class="mt-3">Za en zo gesloten</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.bv}<span class="mx-2 inline-block" aria-hidden="true">·</span>KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-ijs">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-20 text-xs md:pb-8">Teksten en maten van machinefabriekbgw.nl, tijden van jullie Google-profiel (stand 7 oktober 2026). Foto’s zijn sfeerbeelden van Unsplash, niet van jullie werkplaats.</p>}
</footer>
