---
// Woordmerk naar hun eigen logo (machinefabriekbgw.nl/logo2.jpg): "MACHINEFABRIEK" boven "BGW",
// met een as met centerpunten die door de letters steekt. Lijnkleur volgt currentColor.
interface Props { class?: string }
const { class: cls = 'h-10 w-auto' } = Astro.props;
---
<svg class={cls} viewBox="0 0 200 66" role="img" aria-label="Machinefabriek BGW">
  <text x="100" y="13" text-anchor="middle" textLength="148" lengthAdjust="spacingAndGlyphs" font-family="Michroma, sans-serif" font-size="11" fill="currentColor">MACHINEFABRIEK</text>
  <path d="M3 45.5 17 41.5h166l14 4-14 4H17z" fill="var(--logo-as, #6fb0e0)" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
  <path d="M17 41.5v8M183 41.5v8" stroke="currentColor" stroke-width="1.2" />
  <text x="100" y="62" text-anchor="middle" textLength="124" lengthAdjust="spacingAndGlyphs" font-family="Michroma, sans-serif" font-size="40" fill="var(--logo-vul, #6fb0e0)" stroke="currentColor" stroke-width="1.6" paint-order="stroke" style="paint-order: stroke fill">BGW</text>
</svg>
