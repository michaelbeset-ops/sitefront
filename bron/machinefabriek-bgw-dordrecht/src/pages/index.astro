---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, max, tijden, producten } from '../data/site';
import hero from '../assets/draaien-as.jpg';
import asDraait from '../assets/as-draait.jpg';
import draaibank from '../assets/draaibank.jpg';

const fmt = (n: number) => n.toLocaleString('nl-NL');
---
<Base
  title="Machinefabriek BGW, Dordrecht | Lang draaiwerk tot 12 meter"
  description="Schroefassen, pompassen, impellerassen en walsrollen tot 12 meter lengte, 1.250 mm diameter en 12,6 ton. Kotteren, spiebaan steken, richten en Dye Penetrant Test. Daltonstraat 5, Dordrecht."
>
  <div class="relative">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="relative isolate flex min-h-[calc(100svh-3.5rem)] flex-col bg-diep md:min-h-[100svh] text-wit" aria-labelledby="hero-kop">
      <Picture src={hero} alt="" widths={[640, 960, 1400, 2000, 2400]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[60%_50%] md:object-center" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#0a1730f2_0%,#0a1730c7_40%,#0a173040_80%,#0a173026_100%)] max-md:bg-[linear-gradient(180deg,#0a173080_0%,#0a173066_30%,#0a1730e6_68%)]"></div>
      <div class="wrap flex flex-1 flex-col justify-end pb-8 pt-28 md:pb-14">
        <p class="text-[.9375rem] font-semibold text-ijs-licht">Machinefabriek in Dordrecht</p>
        <h1 id="hero-kop" class="mt-4 max-w-[15ch] text-hero">Lang draaiwerk tot 12&nbsp;meter.</h1>
        <p class="mt-6 max-w-xl text-lg text-wit/90 md:text-xl">Schroefassen, pompassen, impellerassen en walsrollen. Voor nieuwbouw en reparatie.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#aanvraag" class="knop knop-vol">Aanvraag voor de draaibank<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />Bel {site.tel}</a>
        </div>
        <div class="mt-10 text-ijs md:mt-20" aria-hidden="true">
          <div class="maatlijn"><i class="st st-l"></i><i class="pk pk-l"></i><span class="maat num text-wit/85">{fmt(max.lengte)} mm</span><i class="pk pk-r"></i><i class="st st-r"></i></div>
        </div>
        <p class="mt-4 flex flex-wrap justify-between gap-x-6 gap-y-1 text-sm text-mist">
          <span>{site.straat}, {site.plaats}</span>
          <span class="num">Ma - vr 07.30 - 16.30<span class="mx-2 inline-block" aria-hidden="true">·</span><span data-open>&nbsp;</span></span>
        </p>
      </div>
    </section>

    <!-- 2. Draaiwerk -->
    <section id="draaiwerk" class="py-24 md:py-36" aria-labelledby="dw-kop">
      <div class="wrap grid gap-x-12 gap-y-14 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 id="dw-kop" class="rijs text-4xl text-marine">Wat wij draaien.</h2>
          <p class="rijs mt-6 max-w-xl text-lg text-grijs" style="--d:.1s">Drie collega’s met samen 50 jaar ervaring in alle denkbare verspaanmethoden. Ons vak: voornamelijk lange producten.</p>
          <ul class="mt-12 border-b border-lijn-licht">
            {producten.map((p, i) => (
              <li class="rijs flex items-baseline justify-between gap-6 border-t border-lijn-licht py-5 md:py-6" style={`--d:${i * 0.06}s`}>
                <span class="font-kop text-2xl text-inkt md:text-3xl">{p}</span>
                {i === 0 && <span class="shrink-0 text-sm text-grijs">hoofdzakelijk</span>}
              </li>
            ))}
            <li class="rijs flex items-baseline justify-between gap-6 border-t border-lijn-licht py-5 md:py-6" style="--d:.24s">
              <span class="font-kop text-2xl text-grijs md:text-3xl">En ieder ander product</span>
              <span class="maat num shrink-0 text-staal">≤ 12 m</span>
            </li>
          </ul>
          <p class="rijs mt-10 max-w-xl border-l-2 border-staal pl-5 text-lg text-inkt">Wie lang draaiwerk beheerst, heeft ook voor kort draaiwerk onbeperkt mogelijkheden.</p>
        </div>
        <figure class="rijs relative lg:col-span-5 lg:mt-24" style="--d:.15s">
          <Picture src={asDraait} alt="Een draaiende stalen as in een draaibank" widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" formats={['avif', 'webp']} class="aspect-[4/5] w-full object-cover" />
          <figcaption class="mt-3 text-xs text-grijs">Sfeerbeeld</figcaption>
        </figure>
      </div>
    </section>

    <!-- 3. Capaciteit: de werktekening -->
    <section id="capaciteit" class="raster py-24 md:py-36" aria-labelledby="cap-kop">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12">
          <h2 id="cap-kop" class="rijs text-4xl text-marine lg:col-span-6">Wat past er op onze bank.</h2>
          <p class="rijs text-lg text-grijs lg:col-span-5 lg:col-start-8 lg:pt-3" style="--d:.1s">Tot {fmt(max.lengte)} mm lang, {fmt(max.diameter)} mm in diameter en {String(max.gewicht).replace('.', ',')} ton zwaar. Precies zoals klant of keuringsinstantie eist.</p>
        </div>

        <figure class="rijs mt-16 md:mt-20" aria-label={`Maattekening: maximaal ${fmt(max.lengte)} mm lang en ${fmt(max.diameter)} mm in diameter`}>
          <div class="text-marine">
            <div class="maatlijn"><i class="st st-l"></i><i class="pk pk-l"></i><span class="maat num">L max. {fmt(max.lengte)}</span><i class="pk pk-r"></i><i class="st st-r"></i></div>
          </div>
          <div class="mt-3 flex items-stretch gap-3 md:gap-5">
            <svg viewBox="0 0 1000 160" class="h-24 w-full text-marine sm:h-auto" fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke" aria-hidden="true" preserveAspectRatio="none">
              <!-- hartlijn -->
              <path d="M0 80H1000" stroke-dasharray="18 6 3 6" stroke-width="1" opacity=".55" />
              <!-- conus (schroefzijde), lichaam, kraag, spiebaan, tap -->
              <path d="M2 62 L120 46 V114 L2 98 Z" fill="#ffffff" />
              <path d="M120 40 H700 V120 H120 Z" fill="#ffffff" />
              <path d="M700 28 H760 V132 H700 Z" fill="#ffffff" />
              <path d="M760 44 H930 V116 H760 Z" fill="#ffffff" />
              <path d="M930 54 H998 V106 H930 Z" fill="#ffffff" />
              <path d="M790 44 V56 H880 V44" stroke-dasharray="6 4" />
              <path d="M30 62 V98 M60 58 V102 M90 54 V106" stroke-width="1" opacity=".5" />
            </svg>
            <div class="flex w-14 shrink-0 flex-col items-center text-marine md:w-20">
              <span class="h-px w-4 bg-current"></span>
              <span class="w-px flex-1 bg-current"></span>
              <span class="maat num py-1.5 [writing-mode:vertical-rl] rotate-180">Ø {fmt(max.diameter)}</span>
              <span class="w-px flex-1 bg-current"></span>
              <span class="h-px w-4 bg-current"></span>
            </div>
          </div>
          <figcaption class="sr-only">Schematische tekening van een as met de maximale lengte en diameter.</figcaption>
        </figure>

        <div class="mt-16 grid grid-cols-1 gap-10 md:mt-20 lg:grid-cols-12">
          <dl class="rijs titelhoek lg:col-span-7">
            <div><dt>Max. lengte</dt><dd class="font-kop text-lg num">{fmt(max.lengte)} mm</dd></div>
            <div><dt>Max. diameter</dt><dd class="font-kop text-lg num">{fmt(max.diameter)} mm</dd></div>
            <div><dt>Max. gewicht</dt><dd class="font-kop text-lg num">{String(max.gewicht).replace('.', ',')} ton</dd></div>
            <div><dt>Bewerkingen</dt><dd>Draaien, kotteren, spiebaan steken en richten</dd></div>
            <div><dt>Steekwerk</dt><dd>Met én zonder radius op de bodem</dd></div>
            <div><dt>Keuring</dt><dd>Dye Penetrant Test, level 2 certificaat in huis</dd></div>
            <div><dt>Machinepark</dt><dd>Draaibanken en kotterbank van TOS</dd></div>
          </dl>
          <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.1s">
            <p class="text-lg text-inkt">Door jarenlange ervaring zijn wij bekend met alle keuringsinstanties en de hoogste kwaliteitseisen.</p>
            <a href="#aanvraag" class="knop knop-staal mt-8">Check of het past<Icoon naam="pijl" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Reparatie -->
    <section id="reparatie" class="relative overflow-hidden bg-diep text-wit" aria-labelledby="rep-kop">
      <div class="grid lg:grid-cols-2">
        <div class="relative min-h-[22rem] lg:order-2 lg:min-h-full">
          <Picture src={draaibank} alt="Een conventionele draaibank met handwielen" widths={[640, 960, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" formats={['avif', 'webp']} class="absolute inset-0 h-full w-full object-cover" />
          <span class="absolute bottom-3 right-4 text-xs text-wit/80">Sfeerbeeld</span>
        </div>
        <div class="raster-donker px-5 py-24 md:px-10 md:py-32 lg:pl-[max(2.5rem,calc((100vw-80rem)/2+2.5rem))] lg:pr-16">
          <h2 id="rep-kop" class="rijs text-4xl">Een kromme as? Die richten wij.</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-mist" style="--d:.1s">Wij werken voornamelijk voor nieuwbouw, maar ook voor reparatiewerk kunt u bij ons terecht.</p>
          <dl class="mt-12 max-w-lg">
            <div class="rijs border-t border-lijn-2 py-6">
              <dt class="font-kop text-lg text-ijs">Richten</dt>
              <dd class="mt-2 text-mist">Een kromme as wordt gericht op onze eigen richtpers.</dd>
            </div>
            <div class="rijs border-t border-lijn-2 py-6" style="--d:.08s">
              <dt class="font-kop text-lg text-ijs">Scheurenonderzoek</dt>
              <dd class="mt-2 text-mist">Na het richten is een penetrant scheuronderzoek een vereiste. Met ons level 2 certificaat voeren wij de Dye Penetrant Test gecertificeerd uit.</dd>
            </div>
            <div class="rijs border-y border-lijn-2 py-6" style="--d:.16s">
              <dt class="font-kop text-lg text-ijs">Steekwerk</dt>
              <dd class="mt-2 text-mist">Steken met én zonder radius op de bodem, precies wat klant of keuringsinstantie eist.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 5. Aanvraag (wow) -->
    <section id="aanvraag" class="py-24 md:py-36" aria-labelledby="aan-kop">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12">
          <h2 id="aan-kop" class="rijs text-4xl text-marine lg:col-span-7">Aanvraag voor de draaibank.</h2>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9 lg:pt-3" style="--d:.1s">Vul de maten in en zie direct of het op onze bank past. Uw aanvraag gaat als mail naar ons.</p>
        </div>

        <form class="mt-14 grid gap-x-12 gap-y-12 lg:grid-cols-12" data-aanvraag novalidate>
          <!-- Live bank -->
          <div class="lg:sticky lg:top-8 lg:col-span-5 lg:self-start lg:order-2">
            <div class="raster border border-lijn-licht p-5 md:p-7">
              <p class="flex items-baseline justify-between text-sm font-semibold text-grijs"><span>Op de bank</span><span class="maat num">0 - 12 m</span></p>
              <div class="relative mt-5 h-36" data-bank>
                <div class="absolute inset-0 border border-dashed border-marine/35"></div>
                <span class="maat num absolute left-2 top-1.5 text-grijs/80">max. 12.000 × Ø 1.250</span>
                <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 border-t border-dashed border-marine/40"></div>
                <div class="absolute left-0 top-1/2 h-full max-h-full -translate-y-1/2 bg-marine/85 transition-[width,height,background-color] duration-500 ease-[cubic-bezier(.22,.61,.36,1)]" style="width:0;height:0" data-deel></div>
                <div class="absolute right-0 top-0 h-full w-0.5 bg-staal" title="12 m"></div>
              </div>
              <div class="mt-2 h-3 bg-[repeating-linear-gradient(90deg,#12305e_0_1px,transparent_1px_calc(100%/12))] bg-[length:100%_100%] opacity-60" aria-hidden="true"></div>
              <div class="maat num mt-1 flex justify-between text-grijs" aria-hidden="true"><span>0</span><span>3</span><span>6</span><span>9</span><span>12 m</span></div>

              <ul class="mt-6 space-y-2 text-[.9375rem]" data-checks>
                <li class="flex items-baseline justify-between gap-4 border-t border-lijn-licht pt-2"><span>Lengte</span><span class="num font-semibold" data-c="lengte">nog invullen</span></li>
                <li class="flex items-baseline justify-between gap-4 border-t border-lijn-licht pt-2"><span>Diameter</span><span class="num font-semibold" data-c="diameter">nog invullen</span></li>
                <li class="flex items-baseline justify-between gap-4 border-t border-lijn-licht pt-2"><span>Gewicht</span><span class="num font-semibold" data-c="gewicht">nog invullen</span></li>
              </ul>
              <p class="mt-5 border-l-2 border-staal bg-wit px-4 py-3 text-[.9375rem] leading-snug" role="status" aria-live="polite" data-oordeel>Vul lengte, diameter en gewicht in.</p>
            </div>
          </div>

          <!-- Velden -->
          <div class="grid content-start gap-x-6 gap-y-7 sm:grid-cols-2 lg:col-span-7">
            <label class="veld sm:col-span-1"><span>Soort onderdeel</span>
              <select name="soort" class="invoer">
                {['Schroefas', 'Pompas', 'Impelleras', 'Walsrol'].map((p) => <option>{p}</option>)}
                <option>Ander draaiwerk</option>
              </select>
            </label>
            <fieldset class="veld"><legend class="text-[.8125rem] font-bold uppercase tracking-[.06em] text-grijs">Werk</legend>
              <div class="schakel">
                <label><input type="radio" name="werk" value="Nieuwbouw" checked /><span>Nieuwbouw</span></label>
                <label><input type="radio" name="werk" value="Reparatie" /><span>Reparatie</span></label>
              </div>
            </fieldset>
            <label class="veld eenheid"><span>Lengte</span><input name="lengte" class="invoer num" inputmode="numeric" placeholder="bv. 6500" autocomplete="off" /><i>mm</i></label>
            <label class="veld eenheid"><span>Diameter</span><input name="diameter" class="invoer num" inputmode="numeric" placeholder="bv. 320" autocomplete="off" /><i>mm</i></label>
            <label class="veld eenheid"><span>Gewicht</span><input name="gewicht" class="invoer num" inputmode="decimal" placeholder="bv. 2400" autocomplete="off" /><i>kg</i></label>
            <label class="veld eenheid"><span>Aantal</span><input name="aantal" class="invoer num" inputmode="numeric" value="1" autocomplete="off" /><i>st.</i></label>
            <fieldset class="sm:col-span-2"><legend class="text-[.8125rem] font-bold uppercase tracking-[.06em] text-grijs">Bewerkingen</legend>
              <div class="mt-2 grid gap-x-6 sm:grid-cols-2">
                {['Draaien', 'Kotteren', 'Spiebaan steken', 'Steken', 'Richten', 'Dye Penetrant Test'].map((b, i) => (
                  <label class="vink"><input type="checkbox" name="bew" value={b} checked={i === 0} />{b}</label>
                ))}
              </div>
            </fieldset>
            <fieldset class="veld"><legend class="text-[.8125rem] font-bold uppercase tracking-[.06em] text-grijs">Spoed</legend>
              <div class="schakel">
                <label><input type="radio" name="spoed" value="nee" checked /><span>Nee</span></label>
                <label><input type="radio" name="spoed" value="ja" /><span>Ja, spoed</span></label>
              </div>
            </fieldset>
            <label class="veld"><span>Bedrijf en naam</span><input name="naam" class="invoer" autocomplete="organization" /></label>
            <label class="veld sm:col-span-2"><span>Toelichting</span><textarea name="toelichting" rows="3" class="invoer" placeholder="Materiaal, tekening, gewenste leverdatum"></textarea></label>

            <div class="sm:col-span-2">
              <p class="mb-4 border-l-2 border-staal bg-papier px-4 py-3 text-[.9375rem] leading-snug lg:hidden" data-oordeel2>Vul lengte, diameter en gewicht in.</p>
              <div class="flex flex-wrap gap-3">
                <a href={`mailto:${site.mail}`} class="knop knop-staal" data-mail><Icoon naam="mail" />Mail de aanvraag</a>
                <a href={site.telHref} class="knop knop-rand num" data-bel><Icoon naam="tel" />Bel {site.tel}</a>
              </div>
              <p class="mt-4 max-w-lg text-sm text-grijs" data-tip>De mail opent in uw eigen mailprogramma. Een tekening of foto kunt u daar meesturen.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- 6. Geschiedenis -->
    <section id="geschiedenis" class="raster py-24 md:py-36" aria-labelledby="ge-kop">
      <div class="wrap grid gap-x-12 gap-y-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="rijs font-kop text-[clamp(4.5rem,13vw,10rem)] leading-none text-marine/15" aria-hidden="true">1918</p>
          <h2 id="ge-kop" class="rijs mt-2 text-3xl text-marine">Jong bedrijf, oude werkplaats.</h2>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-8">
          <p class="rijs text-lg text-inkt">In ons pand was al 40 jaar een machinefabriek actief: de firma Houtgraaf &amp; Kastelein, die in 1918 de basis legde. Zij begonnen met kort draaiwerk en groeiden uit tot specialist in lang draaiwerk.</p>
          <p class="rijs mt-5 text-lg text-grijs" style="--d:.08s">Hun twee draaibanken en kotterbank van het oerdegelijke merk TOS namen wij in uitstekende staat over. Dat machinepark en onze ervaring zorgen voor de nauwkeurigste toleranties.</p>
          <ol class="rijs mt-12 grid grid-cols-[auto_1fr] gap-x-6 text-marine" style="--d:.12s">
            <li class="contents"><span class="maat num pt-0.5">1918</span><span class="border-l border-marine/30 pb-6 pl-6 text-[.9375rem] text-inkt">Houtgraaf &amp; Kastelein legt de basis</span></li>
            <li class="contents"><span class="maat num pt-0.5">40 jaar</span><span class="border-l border-marine/30 pb-6 pl-6 text-[.9375rem] text-inkt">Machinefabriek in het pand, van kort naar lang draaiwerk</span></li>
            <li class="contents"><span class="maat num pt-0.5">2013</span><span class="border-l border-staal pl-6 text-[.9375rem] font-semibold text-inkt">Machinefabriek BGW, drie collega’s</span></li>
          </ol>
        </div>
      </div>
    </section>

    <!-- 7. Contact -->
    <section id="contact" class="raster-donker bg-marine py-24 text-wit md:py-32" aria-labelledby="co-kop">
      <div class="wrap grid gap-x-12 gap-y-14 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 id="co-kop" class="rijs text-4xl">Daltonstraat 5, Dordrecht.</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-mist" style="--d:.1s">Bel of mail ons met uw tekening of vraag.</p>
          <div class="rijs mt-10 flex flex-wrap gap-3" style="--d:.15s">
            <a href={site.telHref} class="knop knop-vol num"><Icoon naam="tel" />{site.tel}</a>
            <a href={`mailto:${site.mail}`} class="knop knop-wit"><Icoon naam="mail" />{site.mail}</a>
          </div>
          <p class="rijs mt-8 text-mist" style="--d:.2s">{site.straat}, {site.postcode} {site.plaats}<span class="mx-2 inline-block" aria-hidden="true">·</span><a href={site.maps} class="link text-wit">Route plannen</a></p>
        </div>
        <div class="rijs lg:col-span-4 lg:col-start-9" style="--d:.1s">
          <p class="flex items-baseline justify-between font-semibold"><span>Werkplaats</span><span class="text-sm font-normal text-ijs-licht" data-open>&nbsp;</span></p>
          <table class="mt-4 w-full text-[.9375rem]">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {[1, 2, 3, 4, 5, 6, 0].map((d) => (
                <tr class="border-t border-lijn-2" data-dag={d}>
                  <th scope="row" class="py-2.5 text-left font-normal text-mist">{tijden[d][0]}</th>
                  <td class="num py-2.5 text-right">{tijden[d][1] ?? 'Gesloten'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 text-xs text-mist">Tijden volgens ons Google-profiel.</p>
        </div>
      </div>
    </section>
  </main>
  </div>
  <Voet />
</Base>

<script>
  import { max, site } from '../data/site';

  // Open / gesloten (Europe/Amsterdam), ma-vr 07.30-16.30.
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const dag = nu.getDay(); const min = nu.getHours() * 60 + nu.getMinutes();
  const open = dag >= 1 && dag <= 5 && min >= 450 && min < 990;
  document.querySelectorAll('[data-open]').forEach((el) => { el.textContent = open ? 'nu open' : 'nu gesloten'; });
  document.querySelector(`[data-dag="${dag}"]`)?.classList.add('font-bold', 'text-wit', '[&>th]:text-wit');

  // Aanvraag voor de draaibank.
  const f = document.querySelector<HTMLFormElement>('[data-aanvraag]');
  if (f) {
    const deel = f.querySelector<HTMLElement>('[data-deel]')!;
    const oordeel = f.querySelector<HTMLElement>('[data-oordeel]')!;
    const oordeel2 = f.querySelector<HTMLElement>('[data-oordeel2]')!;
    const mail = f.querySelector<HTMLAnchorElement>('[data-mail]')!;
    const bel = f.querySelector<HTMLAnchorElement>('[data-bel]')!;
    const tip = f.querySelector<HTMLElement>('[data-tip]')!;
    const c = (k: string) => f.querySelector<HTMLElement>(`[data-c="${k}"]`)!;
    const getal = (n: string) => { const v = parseFloat(String((f.elements.namedItem(n) as HTMLInputElement).value).replace(/\./g, '').replace(',', '.')); return isFinite(v) && v > 0 ? v : 0; };
    const nl = (n: number) => n.toLocaleString('nl-NL');
    const waarde = (n: string) => ((f.elements.namedItem(n) as HTMLInputElement | null)?.value || '').trim();
    const radio = (n: string) => (f.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value || '');

    const zet = (el: HTMLElement, v: number, m: number, eenheid: string, maxTekst: string) => {
      if (!v) { el.textContent = 'nog invullen'; el.className = 'num font-semibold text-grijs'; return null; }
      const ok = v <= m;
      el.textContent = ok ? `${nl(v)} ${eenheid} past` : `${nl(v)} ${eenheid} > ${maxTekst}`;
      el.className = ok ? 'num font-semibold text-staal' : 'num font-semibold text-roest';
      return ok;
    };

    const update = () => {
      const L = getal('lengte'), D = getal('diameter'), G = getal('gewicht');
      const rL = zet(c('lengte'), L, max.lengte, 'mm', '12.000');
      const rD = zet(c('diameter'), D, max.diameter, 'mm', '1.250');
      const rG = zet(c('gewicht'), G, max.gewicht * 1000, 'kg', '12.600');
      deel.style.width = L ? `${Math.min(100, (L / max.lengte) * 100)}%` : '0';
      deel.style.height = D ? `${Math.max(4, Math.min(100, (D / max.diameter) * 100))}%` : '0';
      const te = [rL, rD, rG].includes(false);
      deel.style.backgroundColor = te ? '#a3401c' : '';
      const leeg = [rL, rD, rG].includes(null);
      oordeel.textContent = te
        ? 'Dit is groter dan onze maxima. Bel ons gerust om te overleggen.'
        : leeg ? 'Vul lengte, diameter en gewicht in.' : 'Dit valt binnen onze maxima. Stuur de aanvraag, dan nemen wij contact met u op.';

      oordeel2.textContent = oordeel.textContent;
      oordeel2.classList.toggle('border-roest', te); oordeel2.classList.toggle('border-staal', !te);
      const spoed = radio('spoed') === 'ja';
      const soort = waarde('soort');
      const bew = [...f.querySelectorAll<HTMLInputElement>('input[name="bew"]:checked')].map((i) => i.value);
      const regels = [
        'Beste Machinefabriek BGW,', '',
        `Graag ontvang ik een offerte voor het volgende${spoed ? ' (SPOED)' : ''}:`, '',
        `Onderdeel: ${soort}`,
        `Werk: ${radio('werk')}`,
        `Lengte: ${L ? nl(L) + ' mm' : '-'}`,
        `Diameter: ${D ? nl(D) + ' mm' : '-'}`,
        `Gewicht: ${G ? nl(G) + ' kg' : '-'}`,
        `Aantal: ${waarde('aantal') || '-'}`,
        `Bewerkingen: ${bew.join(', ') || '-'}`,
        ...(waarde('toelichting') ? ['', waarde('toelichting')] : []),
        '', 'Met vriendelijke groet,', waarde('naam') || '',
      ];
      const onderwerp = `${spoed ? 'SPOED: ' : ''}Aanvraag ${soort.toLowerCase()}${L ? `, ${nl(L)} mm` : ''}`;
      mail.href = `mailto:${site.mail}?subject=${encodeURIComponent(onderwerp)}&body=${encodeURIComponent(regels.join('\n'))}`;
      mail.className = spoed ? 'knop knop-rand' : 'knop knop-staal';
      bel.className = spoed ? 'knop knop-staal num' : 'knop knop-rand num';
      if (spoed) bel.parentElement!.prepend(bel); else bel.parentElement!.prepend(mail);
      tip.textContent = spoed ? 'Bij spoed is bellen het snelst. De mail kunt u er daarna achteraan sturen.' : 'De mail opent in uw eigen mailprogramma. Een tekening of foto kunt u daar meesturen.';
    };
    f.addEventListener('input', update);
    f.addEventListener('change', update);
    f.addEventListener('submit', (e) => e.preventDefault());
    update();
  }
</script>
