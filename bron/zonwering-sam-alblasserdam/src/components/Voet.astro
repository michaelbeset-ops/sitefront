---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const buiten = ['Screens', 'Knikarmschermen', 'Uitvalschermen', 'Markiezen'];
---
<footer class="bg-antraciet text-mist">
  <div class="rolmaat h-3" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="text-wit md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-mist">Leveren en monteren van zonwering en raamdecoratie op maat, voor binnen en buiten. Ook voor onderhoud en reparaties.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Producten</p>
      <ul class="mt-3 space-y-1">
        {buiten.map((p) => <li><a href={url('#producten')} class="link link-licht no-underline hover:underline">{p}</a></li>)}
        <li><a href={url('#producten')} class="link link-licht no-underline hover:underline">Rolluiken</a></li>
        <li><a href={url('#producten')} class="link link-licht no-underline hover:underline">Binnenzonwering</a></li>
      </ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <p class="mt-3">Ma t/m vr<br /><span class="num">08:00 - 18:00</span></p>
      <p class="mt-4">Storingen: 24 uur, ook in het weekend</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.volledig}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Werkfoto's: klantfoto's van jullie Google-profiel (kentekens, huisnummers en een spiegeling onherkenbaar gemaakt). De foto bij binnenzonwering is een sfeerfoto van Unsplash. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
