---
// De zon uit hun logo, nagetekend: halve zon met stralen op een horizon.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 40 26" class={cls} fill="none" aria-hidden="true">
  <g stroke="var(--color-zon)" stroke-width="2.6" stroke-linecap="round">
    <path d="M20 2v4.5M8.7 6.7l3.1 3.1M3 18h4.5M31.3 6.7l-3.1 3.1M37 18h-4.5" />
  </g>
  <path d="M11.5 22a8.5 8.5 0 0 1 17 0Z" fill="var(--color-zon)" />
  <path d="M2 24h36" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
</svg>
