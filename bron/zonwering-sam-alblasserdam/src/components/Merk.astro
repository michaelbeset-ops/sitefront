---
// Woordmerk naar hun logo: de zon boven "Sam", met "Zonwering" eronder.
import { url } from '../data/site';
import Zon from './Zon.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex items-end gap-2.5 text-current no-underline', cls]} aria-label="Sam Zonwering, naar de homepage">
  <Zon class="h-7 w-auto flex-none" />
  <span class="leading-none">
    <span class="kop block text-[1.55rem] leading-[.85] tracking-[-0.04em]">Sam</span>{" "}
    <span class="block pt-1 text-[.7rem] font-bold uppercase tracking-[.18em] opacity-80">Zonwering</span>
  </span>
</a>
