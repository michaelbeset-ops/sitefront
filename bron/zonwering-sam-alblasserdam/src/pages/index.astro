---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Zon from '../components/Zon.astro';
import Meetbriefje from '../components/Meetbriefje.astro';
import { site, tijden, reviews, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import nieuwbouw from '../assets/nieuwbouw.jpg';
import uitval from '../assets/uitvalscherm.jpg';
import binnen from '../assets/binnen.jpg';

// Productnamen en zinnen van hun eigen site (sam-zonwering.nl/onze-producten, /buiten-zonwering, /binnen-zonwering).
const producten = [
  { naam: 'Buiten', zin: 'Zonneschermen, screens, markiezen en meer.', items: ['Screens', 'Knikarmschermen', 'Uitvalschermen', 'Markiezen'] },
  { naam: 'Rolluiken', zin: 'Veilig en betrouwbaar. Ze waarborgen uw privacy en houden inbrekers buiten.', items: ['Daglichtrolluiken', 'Jaloezierolluiken', 'Inbouwrolluiken'] },
  { naam: 'Binnen', zin: 'Rolgordijnen, paneelgordijnen, jaloezieën, shutters en meer.', items: ['Rolgordijnen', 'Jaloezieën', 'Lamelgordijnen', 'Paneelgordijnen', 'Vouwgordijnen', 'Silhouette gordijnen'] },
];

const waStoring = waMet('Hallo, ik heb een storing aan mijn zonwering. Het gaat om een ... in ...');
const titel = 'Sam Zonwering | Zonwering en rolluiken uit Alblasserdam';
const omschrijving = 'Screens, knikarmschermen, markiezen, rolluiken en binnenzonwering op maat, geleverd en gemonteerd door Sam Zonwering uit Alblasserdam. Gratis meten, 24 uur bereikbaar voor storingen.';
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. Opening: een terras in de zon, met hun slogan -->
    <section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-antraciet text-wit">
      <Image quality={68} src={hero} alt="Antraciet terrasscherm boven een terras met loungeset achter een woning, rolluiken op de dakkapel" widths={[640, 960, 1440, 2048]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[38%_50%] md:object-[50%_45%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#16181b99_0%,#16181b26_30%,#16181b59_55%,#16181bf0_100%)] md:bg-[linear-gradient(90deg,#16181be6_0%,#16181ba6_38%,#16181b14_70%),linear-gradient(0deg,#16181bb3_0%,#16181b00_45%)]"></div>
      <div class="wrap pb-32 pt-32 md:pb-20">
        <p class="rijs text-[.9375rem] font-semibold text-wit/85">Montage en zonwering, Alblasserdam</p>
        <h1 class="rijs mt-4 max-w-[11ch] text-hero" style="--d:.08s">Sterk in <span class="text-zon">zonwering.</span></h1>
        <p class="rijs mt-6 max-w-[33rem] text-lg text-wit/90 md:text-xl" style="--d:.16s">Leveren en monteren van zonwering en raamdecoratie op maat, voor binnen en buiten. Ook voor onderhoud en reparaties.</p>
        <div class="rijs mt-9 flex flex-wrap items-center gap-3" style="--d:.24s">
          <a href="#meten" class="knop">Offerte aanvragen<Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-lijn num hidden sm:inline-flex"><Icoon naam="tel" />{site.tel}</a>
        </div>
        <p class="rijs mt-10 text-sm text-wit/75 md:mt-14" style="--d:.3s">Gratis meten <span class="px-2 text-zon" aria-hidden="true">/</span> Alle losse onderdelen <span class="px-2 text-zon" aria-hidden="true">/</span> Storingen 24 uur, ook in het weekend</p>
      </div>
    </section>

    <!-- 2. Het werk: klantfoto's naast wat diezelfde klant schreef -->
    <section id="werk" class="pt-20 md:pt-32">
      <div class="wrap">
        <h2 class="rijs max-w-[14ch] text-3xl">Zo hangt het er bij klanten bij.</h2>
      </div>

      <div class="wrap mt-12 grid gap-y-14 md:mt-20 md:grid-cols-12 md:gap-x-8">
        <figure class="rijs md:col-span-7">
          <Image quality={66} src={nieuwbouw} alt="Nieuwbouwwoning met antraciet rolluiken voor de ramen en een scherm boven de voordeur" widths={[640, 960, 1086]} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover object-[50%_40%]" />
        </figure>
        <blockquote class="rijs self-end md:col-span-4 md:col-start-9 md:pb-6" style="--d:.1s">
          <p class="kop text-[clamp(1.4rem,1.2vw+1rem,2rem)] leading-[1.15]">“{reviews.karim.tekst}”</p>
          <footer class="mt-5 text-sm text-grijs">{reviews.karim.naam}, rolluiken en zonwering voor en achter</footer>
        </blockquote>

        <blockquote class="rijs order-last self-start md:order-none md:col-span-4 md:pt-10" style="--d:.1s">
          <p class="kop text-[clamp(1.4rem,1.2vw+1rem,2rem)] leading-[1.15]">“{reviews.natascha.tekst}”</p>
          <footer class="mt-5 text-sm text-grijs">{reviews.natascha.naam}, rolluiken en scherm</footer>
        </blockquote>
        <figure class="rijs md:col-span-7 md:col-start-6">
          <Image quality={66} src={uitval} alt="Donker uitvalscherm boven het grote voorraam van een rijtjeshuis" widths={[640, 960, 1400]} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover object-[30%_50%]" />
        </figure>
      </div>

      <div class="relative mt-20 md:mt-28">
        <Image quality={64} src={hero} alt="Detail van het terrasscherm boven het terras, met nieuw doek" widths={[640, 1200, 1920]} sizes="100vw" class="h-[60svh] min-h-[22rem] w-full object-cover object-[40%_45%]" />
        <div class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#16181be0,#16181b00)] pt-28">
          <div class="wrap pb-8 text-wit md:pb-12">
            <p class="kop max-w-[22ch] text-[clamp(1.5rem,1.6vw+1rem,2.5rem)] leading-[1.1]">“{reviews.bouwman.tekst}”</p>
            <p class="mt-4 text-sm text-wit/75">{reviews.bouwman.naam}, nieuw doek op de zonwering</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Producten: drie grote woorden, hun eigen lijst eronder -->
    <section id="producten" class="py-24 md:py-32">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-4">
          <h2 class="rijs text-3xl">Voor binnen en buiten.</h2>
          <p class="rijs mt-5 max-w-sm text-grijs" style="--d:.06s">Alle typen binnen- en buitenzonwering, op maat gemaakt en door ons gemonteerd.</p>
          <figure class="rijs mt-10 hidden lg:block" style="--d:.12s">
            <Image quality={64} src={binnen} alt="Grijs rolgordijn half voor een raam in een witte muur" widths={[480, 800]} sizes="30vw" class="aspect-[4/5] w-full rounded-md object-cover" />
          </figure>
        </div>
        <ol class="lg:col-span-8">
          {producten.map((p, i) => (
            <li class="rijs grid gap-x-8 gap-y-4 border-t border-lijn py-9 first:border-t-0 first:pt-0 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:py-12" style={`--d:${i * 0.06}s`}>
              <div>
                <h3 class="flex items-baseline gap-4 text-[clamp(2.6rem,4.6vw+1rem,5.5rem)] leading-[.9] tracking-[-0.045em]"><span class="num text-sm font-bold tracking-normal text-grijs">{String(i + 1).padStart(2, '0')}</span>{p.naam}</h3>
                <p class="mt-4 max-w-xs text-grijs md:pl-9">{p.zin}</p>
              </div>
              <ul class="flex flex-wrap content-start gap-2 md:pt-3">
                {p.items.map((it) => <li class="rounded-full border border-lijn px-4 py-1.5 text-[.9375rem] font-medium">{it}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4. Wow: het meetbriefje -->
    <section id="meten" class="bg-papier-2 py-20 md:py-28">
      <div class="wrap">
        <div class="grid gap-y-6 md:grid-cols-12 md:gap-x-8">
          <h2 class="rijs text-3xl md:col-span-7">Eerst een schets, dan komen we meten.</h2>
          <p class="rijs max-w-md text-grijs md:col-span-5 md:self-end" style="--d:.08s">Kies het product, schuif ongeveer de breedte op de rolmaat en stuur het via WhatsApp. Het meten bij u thuis is gratis.</p>
        </div>
        <Meetbriefje />
      </div>
    </section>

    <!-- 5. Storing: donker, kort -->
    <section id="storing" class="bg-antraciet py-20 text-wit md:py-28">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-7">
          <Zon class="rijs h-10 w-auto text-wit/40" />
          <h2 class="rijs mt-8 text-3xl" style="--d:.06s">Storing? Ook in het weekend.</h2>
          <p class="rijs mt-6 max-w-lg text-lg text-mist" style="--d:.12s">Wij zijn 24 uur bereikbaar voor storingen en reparaties, ook in het weekend. Alle losse onderdelen zijn verkrijgbaar.</p>
          <div class="rijs mt-9 flex flex-wrap gap-3" style="--d:.18s">
            <a href={waStoring} class="knop"><Icoon naam="wa" />Storing melden</a>
            <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" />{site.tel}</a>
          </div>
        </div>
        <figure class="rijs lg:col-span-5 lg:self-end" style="--d:.1s">
          <blockquote class="border-l-2 border-zon pl-6 text-lg leading-relaxed">“{reviews.sem.tekst}”</blockquote>
          <figcaption class="mt-4 pl-6 text-sm text-mist">{reviews.sem.naam}, op Google</figcaption>
        </figure>
      </div>
    </section>

    <!-- 6. Klanten: één zin groot, de rest klein -->
    <section class="py-20 md:py-28">
      <div class="wrap">
        <figure class="rijs max-w-5xl">
          <blockquote class="kop text-[clamp(1.75rem,3.2vw+.6rem,3.6rem)] leading-[1.06]">
            <span class="text-zon-diep">“</span>{reviews.jaap.tekst}<span class="text-zon-diep">”</span>
          </blockquote>
          <figcaption class="mt-6 text-grijs">{reviews.jaap.naam}, op Google</figcaption>
        </figure>
        <div class="mt-14 grid gap-x-10 gap-y-10 border-t border-lijn pt-10 md:mt-20 md:grid-cols-3">
          {[reviews.aad, reviews.fenna, reviews.sonja].map((r, i) => (
            <figure class="rijs" style={`--d:${i * 0.06}s`}>
              <blockquote class="leading-relaxed">“{r.tekst}”</blockquote>
              <figcaption class="mt-4 text-sm font-semibold text-grijs">{r.naam}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Contact, tijden en route -->
    <section id="contact" class="pb-20 md:pb-28">
      <div class="wrap">
        <div class="overflow-hidden rounded-md bg-wit shadow-sm">
          <div class="rolmaat h-4" aria-hidden="true"></div>
          <div class="grid gap-y-12 p-6 sm:p-10 md:grid-cols-12 md:gap-x-10 lg:p-14">
            <div class="md:col-span-6">
              <h2 class="rijs text-3xl">Bel, app of mail.</h2>
              <ul class="rijs mt-9 border-b border-lijn text-[1.0625rem]" style="--d:.06s">
                <li class="flex items-center justify-between gap-4 border-t border-lijn py-3.5"><span class="text-grijs">Telefoon en WhatsApp</span><a href={site.telHref} class="link num whitespace-nowrap font-semibold">{site.tel}</a></li>
                <li class="flex items-center justify-between gap-4 border-t border-lijn py-3.5"><span class="text-grijs">E-mail</span><a href={`mailto:${site.mail}`} class="link break-all text-right font-semibold">{site.mail}</a></li>
                <li class="flex items-start justify-between gap-4 border-t border-lijn py-3.5"><span class="text-grijs">Adres</span><span class="text-right font-semibold">{site.straat}<br />{site.postcode} {site.plaats}</span></li>
              </ul>
              <div class="rijs mt-8 flex flex-wrap gap-3" style="--d:.12s">
                <a href={waMet('Hallo, ik wil graag een afspraak maken om te laten meten.')} class="knop"><Icoon naam="wa" />Afspraak voor meten</a>
                <a href={site.maps} class="knop knop-donker"><Icoon naam="pin" />Route</a>
              </div>
            </div>
            <div class="md:col-span-5 md:col-start-8">
              <p class="rijs text-sm font-semibold text-grijs">Openingstijden</p>
              <table class="rijs mt-4 w-full text-[1.0625rem]" style="--d:.06s" data-tijden>
                <tbody>
                  {[1, 2, 3, 4, 5, 6, 0].map((d) => (
                    <tr class="border-t border-lijn" data-dag={d}>
                      <th scope="row" class="py-2.5 text-left font-medium">{tijden[d][0]}</th>
                      <td class="num py-2.5 text-right">{tijden[d][1] ?? <span class="text-grijs">Gesloten</span>}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="mt-6 inline-flex items-center gap-2 text-sm text-grijs"><Icoon naam="g" class="h-4 w-4" /><span><span class="num">{site.google.score}</span> op Google, {site.google.aantal} reviews</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  const rij = document.querySelector<HTMLElement>(`[data-tijden] [data-dag="${new Date().getDay()}"]`);
  if (rij) { rij.classList.add('font-bold'); rij.style.boxShadow = 'inset 3px 0 0 var(--color-zon)'; rij.querySelector('th')!.style.paddingLeft = '.75rem'; }
</script>
