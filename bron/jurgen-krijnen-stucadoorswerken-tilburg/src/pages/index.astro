---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, klanten, soorten, diensten, werkvelden, openingstijden, foto, srcset } from '../data/site';

const heroSet = srcset(foto.hero, [640, 960, 1280, 1600]);
---
<Base
  title="Stucadoor in Tilburg | Jurgen Krijnen Stucadoorswerken"
  description="Jurgen Krijnen uit Tilburg doet pleisterwerk, schuurwerk, sierpleister, airless spuiten en kooflijsten. Een 10 uit 22 beoordelingen op Google. Bel 06 14692490."
  heroFoto={foto.hero(1280)}
  heroSrcset={heroSet}
>
  <Kop />
  <main id="inhoud">
    <!-- Hero: schermvullende foto, tekst links onderin, en onderaan een band met de drie dingen die een klant eerst wil weten. -->
    <section class="op-donker relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-grafiet text-gips">
      <img
        src={foto.hero(1280)}
        srcset={heroSet}
        sizes="100vw"
        alt=""
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(32_36_39/0.96)_0%,rgb(32_36_39/0.82)_38%,rgb(32_36_39/0.35)_75%,rgb(32_36_39/0.55)_100%)]"></div>
      <div class="wrap pb-12 pt-32 md:pb-16 md:pt-40">
        <div class="max-w-4xl">
          <span class="liniaal text-oker" aria-hidden="true"></span>
          <p class="label mt-6 text-oker">Stucadoor in {site.plaats}, bijna 30 jaar werkervaring</p>
          <h1 class="mt-4 text-5xl">Van een nieuwe muur tot een klassiek plafond.</h1>
          <p class="mt-6 max-w-2xl text-lg text-gips/90">Jurgen Krijnen stuct wanden en plafonds, zet sierpleister op, spuit latex en maakt kooflijsten. In nieuwbouw, bij een verbouwing en in oude panden.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.mobielHref} class="knop knop-oker">Bel {site.mobiel}</a>
            <a href="#soorten" class="knop knop-lijn">Soorten stucwerk</a>
          </div>
        </div>
      </div>
      <div class="border-t border-gips/15 bg-grafiet/70">
        <div class="wrap grid sm:grid-cols-3 sm:divide-x sm:divide-gips/15">
          <p class="flex items-baseline gap-3 border-b border-gips/15 py-4 sm:border-b-0 sm:py-5 sm:pr-6">
            <span class="font-kop text-3xl font-extrabold leading-none tracking-[-0.03em] text-oker [font-stretch:88%]">10</span>
            <span class="text-sm text-gips/85">uit {site.aantalReviews} beoordelingen op Google</span>
          </p>
          <p class="flex items-baseline gap-3 border-b border-gips/15 py-4 sm:border-b-0 sm:px-6 sm:py-5">
            <span class="font-kop text-xl font-extrabold leading-none tracking-[-0.02em] [font-stretch:88%]">Top Score 2026</span>
            <span class="text-sm text-gips/85">op stukadoorgids.nl</span>
          </p>
          <p class="flex items-baseline gap-3 py-4 sm:py-5 sm:pl-6">
            <span class="text-sm text-gips/85">Bereikbaar</span>
            <span class="text-sm font-semibold">ma t/m vr 8.30 tot 17.00 uur</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Blikvanger: het cijfer groot, en wat klanten er zelf over schrijven als werkbonregels ernaast. -->
    <section class="py-20 lg:py-32" aria-labelledby="klanten-kop">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="liniaal text-okerdonker" aria-hidden="true"></span>
          <h2 id="klanten-kop" class="mt-6 text-4xl">Netjes, glad, en afspraak is afspraak.</h2>
          <p class="mt-8 flex items-end gap-4">
            <span class="font-kop text-[clamp(7rem,5rem+9vw,13rem)] font-extrabold leading-[0.78] tracking-[-0.06em] [font-stretch:80%]">10</span>
            <span class="pb-2 text-leisteen">gemiddeld, uit {site.aantalReviews}<br />beoordelingen op Google</span>
          </p>
          <p class="mt-8 max-w-md text-leisteen">Op stukadoorgids.nl kreeg Jurgen daarvoor de Top Score 2026. <a href={site.reviewsBron} class="font-semibold text-okerdonker underline underline-offset-4" rel="noopener">Alle beoordelingen lezen</a></p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="label text-leisteen">Wat klanten noemen</p>
          <ol class="mt-4 border-t-2 border-grafiet">
            {klanten.map((k) => (
              <li class="rij grid grid-cols-[minmax(0,1fr)] gap-1 border-b border-lijn py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
                <p class="text-sm text-leisteen">{k.datum}</p>
                <div>
                  <p class="font-kop text-2xl font-bold leading-tight tracking-[-0.02em] [font-stretch:88%] [overflow-wrap:break-word]">{k.over}</p>
                  <p class="mt-1 text-sm text-leisteen">{k.naam}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Het bereik van zijn werk: zijn eigen woorden als kop, met een maatlat van de ene naar de andere kant. -->
    <section id="bereik" class="scroll-mt-4 border-t border-lijn bg-gips py-20 lg:py-32" aria-labelledby="bereik-kop">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <span class="liniaal text-okerdonker" aria-hidden="true"></span>
          <h2 id="bereik-kop" class="mt-6 text-4xl">Alles is dus mogelijk.</h2>
          <p class="mt-6 max-w-xl text-lg text-leisteen">Zo zegt Jurgen het zelf. Hij maakt nieuwe muren behangklaar, en hij zet een klassiek plafond terug in een antiek pand. En alles daartussen, van eenvoudig tot bijzonder stucwerk.</p>
          <div class="mt-12 max-w-xl" aria-hidden="true">
            <div class="flex justify-between text-sm font-semibold">
              <span>Behangklaar</span><span class="text-right">Klassiek plafond</span>
            </div>
            <div class="mt-2 h-4 border-x-2 border-b-2 border-grafiet bg-[repeating-linear-gradient(90deg,var(--color-grafiet)_0_1px,transparent_1px_10%)] [background-size:100%_8px] bg-bottom bg-no-repeat"></div>
            <div class="mt-2 flex justify-between text-xs text-leisteen">
              <span>Nieuwe muur</span><span>Antiek pand</span>
            </div>
          </div>
          <h3 class="mt-14 text-xl">Waar Jurgen werkt</h3>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-leisteen">
            {werkvelden.map((w) => <li class="flex items-center gap-2"><span class="inline-block h-2 w-2 bg-oker" aria-hidden="true"></span>{w}</li>)}
          </ul>
        </div>
        <figure class="lg:col-span-5">
          <img
            src={foto.plafond(900)}
            srcset={srcset(foto.plafond, [480, 720, 900, 1200])}
            sizes="(min-width: 1024px) 40vw, 100vw"
            alt="Een wit geschilderd plafond"
            class="aspect-[4/5] w-full bg-kalk object-cover"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="mt-3 text-xs text-leisteen">Sfeerbeeld</figcaption>
        </figure>
      </div>
    </section>

    <!-- De staalkaart: elke soort stucwerk als een genummerd staal, met de uitleg van Jurgen zelf. -->
    <section id="soorten" class="op-donker scroll-mt-4 bg-grafiet py-20 text-gips lg:py-32" aria-labelledby="soorten-kop">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <span class="liniaal text-oker" aria-hidden="true"></span>
            <h2 id="soorten-kop" class="mt-6 text-4xl">Welk stucwerk past bij uw muur?</h2>
          </div>
          <p class="max-w-md text-gips/80 lg:col-span-4 lg:col-start-9">Vijf soorten op een rij, met wat het is en waar het voor dient. Twijfelt u, dan denkt Jurgen met u mee.</p>
        </div>
        <ol class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-5">
          {soorten.map((s, i) => (
            <li class:list={['rij', i % 2 === 1 && 'lg:mt-16']}>
              <div class="relative">
                <img
                  src={foto[s.foto](600)}
                  srcset={srcset(foto[s.foto], [400, 600, 800])}
                  sizes="(min-width: 1024px) 18vw, (min-width: 640px) 45vw, 100vw"
                  alt=""
                  class="aspect-[4/3] w-full bg-lood object-cover lg:aspect-[3/4]"
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute left-0 top-0 bg-oker px-2.5 py-1 text-xs font-bold text-grafiet">Staal {String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-5 text-2xl">{s.naam}</h3>
              <p class="mt-3 text-sm leading-relaxed text-gips/80">{s.uitleg}</p>
            </li>
          ))}
        </ol>
        <p class="mt-12 text-xs text-gips/70">De structuurfoto's zijn sfeerbeelden.</p>
      </div>
    </section>

    <!-- Diensten als een lijst om af te vinken, met de kop vast ernaast op grote schermen. -->
    <section class="py-20 lg:py-32" aria-labelledby="diensten-kop">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-10">
            <span class="liniaal text-okerdonker" aria-hidden="true"></span>
            <h2 id="diensten-kop" class="mt-6 text-4xl">Wat Jurgen voor u doet</h2>
            <p class="mt-6 text-leisteen">Voor particulieren en in de woningbouw. Een klus bespreken kan gewoon telefonisch.</p>
            <a href={site.mobielHref} class="knop knop-grafiet mt-8">Bel {site.mobiel}</a>
          </div>
        </div>
        <ul class="border-t-2 border-grafiet lg:col-span-7 lg:col-start-6">
          {diensten.map((d, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-lijn py-6 sm:grid-cols-[3.5rem_1fr_1fr] sm:items-baseline">
              <span class="font-kop text-lg font-extrabold text-okerdonker">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-2xl">{d.naam}</h3>
              <p class="col-start-2 text-leisteen sm:col-start-3">{d.uitleg}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Over Jurgen: kort, met een werkbon met de feiten in plaats van een teamfoto. -->
    <section id="over" class="scroll-mt-4 border-t border-lijn bg-gips py-20 lg:py-32" aria-labelledby="over-kop">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-6">
          <span class="liniaal text-okerdonker" aria-hidden="true"></span>
          <h2 id="over-kop" class="mt-6 text-4xl">Bijna 30 jaar met de spaan in de hand</h2>
          <div class="mt-8 grid max-w-xl gap-5 text-lg text-leisteen">
            <p>Jurgen Krijnen heeft bijna 30 jaar werkervaring als stucadoor. Hij werkt vanuit {site.plaats}, als zelfstandige.</p>
            <p>Welke pleister, welke structuur, glad of gespoten. Jurgen adviseert u bij die keuzes, zodat het past bij het huis en bij wat u wilt.</p>
            <p class="font-semibold text-grafiet">Vragen over uw muren of plafonds? Neem gerust contact op.</p>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <dl class="border-2 border-grafiet bg-kalk">
            <div class="border-b-2 border-grafiet bg-grafiet px-5 py-3 text-gips">
              <dt class="sr-only">Bedrijf</dt>
              <dd class="font-kop text-xl font-extrabold tracking-[-0.02em] [font-stretch:88%]">{site.naam}</dd>
            </div>
            <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3 sm:grid-cols-[8rem_minmax(0,1fr)] border-b border-lijn px-5 py-4"><dt class="text-sm text-leisteen">Vakman</dt><dd class="font-semibold">{site.eigenaar}</dd></div>
            <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3 sm:grid-cols-[8rem_minmax(0,1fr)] border-b border-lijn px-5 py-4"><dt class="text-sm text-leisteen">Ervaring</dt><dd class="font-semibold">Bijna 30 jaar</dd></div>
            <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3 sm:grid-cols-[8rem_minmax(0,1fr)] border-b border-lijn px-5 py-4"><dt class="text-sm text-leisteen">Vanuit</dt><dd class="font-semibold">{site.straat}, {site.plaats}</dd></div>
            <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3 sm:grid-cols-[8rem_minmax(0,1fr)] border-b border-lijn px-5 py-4"><dt class="text-sm text-leisteen">Sierpleister</dt><dd class="font-semibold">SPS en Strikolith</dd></div>
            <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3 sm:grid-cols-[8rem_minmax(0,1fr)] px-5 py-4"><dt class="text-sm text-leisteen">Google</dt><dd class="font-semibold">10 uit {site.aantalReviews}</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Contact: gegevens en tijden links, het formulier rechts. In het voorstel verstuurt het formulier niets. -->
    <section id="contact" class="op-donker scroll-mt-4 bg-lood py-20 text-gips lg:py-32" aria-labelledby="contact-kop">
      <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="liniaal text-oker" aria-hidden="true"></span>
          <h2 id="contact-kop" class="mt-6 text-4xl">Bel of mail Jurgen</h2>
          <p class="mt-8 font-kop text-3xl font-extrabold tracking-[-0.03em] [font-stretch:88%]"><a href={site.mobielHref} class="underline-offset-[6px] hover:underline">{site.mobiel}</a></p>
          <p class="mt-2"><a href={`mailto:${site.mail}`} class="break-all text-lg underline underline-offset-4">{site.mail}</a></p>
          <p class="mt-8 text-gips/85">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <p class="mt-3"><a href={site.route} class="font-semibold text-oker underline underline-offset-4" rel="noopener">Route in Google Maps</a></p>
          <h3 class="mt-12 text-xl">Bereikbaar</h3>
          <dl class="mt-4 max-w-sm border-t border-gips/20">
            {openingstijden.map((o) => (
              <div class="flex justify-between gap-4 border-b border-gips/20 py-3 text-sm"><dt class="text-gips/80">{o.dag}</dt><dd class="font-semibold">{o.tijd}</dd></div>
            ))}
          </dl>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <!-- In het voorstel heeft het formulier geen action, zodat ook Enter in een veld niets verstuurt. -->
          <form class="grid gap-5 border-2 border-gips/25 p-6 sm:p-8" action={site.voorstel ? undefined : 'https://api.web3forms.com/submit'} method={site.voorstel ? undefined : 'POST'} onsubmit={site.voorstel ? 'return false' : undefined} aria-describedby="formulier-noot">
            <p class="font-kop text-2xl font-extrabold tracking-[-0.02em] [font-stretch:88%]">Vertel kort over de klus</p>
            <label class="grid gap-2 text-sm font-semibold">Naam
              <input name="naam" autocomplete="name" class="min-h-12 border border-gips/40 bg-grafiet px-3 text-base font-normal text-gips" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">Telefoon of e-mail
              <input name="contact" autocomplete="tel" class="min-h-12 border border-gips/40 bg-grafiet px-3 text-base font-normal text-gips" />
            </label>
            <label class="grid gap-2 text-sm font-semibold">Wat moet er gebeuren?
              <textarea name="bericht" rows="4" class="border border-gips/40 bg-grafiet px-3 py-2 text-base font-normal text-gips"></textarea>
            </label>
            {site.voorstel ? (
              <p id="formulier-noot" class="border-l-4 border-oker pl-4 text-sm text-gips/85">Dit is een ontwerpvoorstel, het formulier verstuurt niets. Bel {site.mobiel} of mail {site.mail} rechtstreeks.</p>
            ) : (
              <>
                <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-sleutel]]" />
                <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
                <p id="formulier-noot" class="text-sm text-gips/75">Jurgen gebruikt uw gegevens alleen om te reageren.</p>
                <button type="submit" class="knop knop-oker justify-self-start">Versturen</button>
              </>
            )}
          </form>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>
