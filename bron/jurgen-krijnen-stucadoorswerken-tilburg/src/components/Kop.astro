---
import { site, url } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const basis = thuis ? '' : url('');
const links = [
  { href: `${basis}#bereik`, tekst: 'Stucwerk' },
  { href: `${basis}#soorten`, tekst: 'Soorten' },
  { href: `${basis}#over`, tekst: 'Over Jurgen' },
  { href: `${basis}#contact`, tekst: 'Contact' },
];
---
<!-- Op de homepage ligt de kop over de foto; op de privacypagina staat hij op grafiet. -->
<header class:list={['op-donker z-30 text-gips', thuis ? 'absolute inset-x-0' : 'relative bg-grafiet']}>
  <div class="wrap flex items-center justify-between gap-6 py-5">
    <a href={url('')} class="group flex items-baseline gap-2 leading-none">
      <span class="font-kop text-2xl font-extrabold tracking-[-0.03em] [font-stretch:88%]">Jurgen Krijnen</span>
      <span class="hidden text-xs font-semibold text-oker sm:inline">Stucadoorswerken</span>
    </a>
    <nav aria-label="Hoofdmenu" class="hidden items-center gap-7 text-sm font-semibold md:flex">
      {links.map((l) => <a href={l.href} class="underline-offset-[6px] hover:underline">{l.tekst}</a>)}
      <a href={site.mobielHref} class="knop knop-oker min-h-[2.75rem] px-4 text-sm">{site.mobiel}</a>
    </nav>
    <a href={site.mobielHref} class="text-sm font-bold underline underline-offset-4 md:hidden">{site.mobiel}</a>
  </div>
</header>
