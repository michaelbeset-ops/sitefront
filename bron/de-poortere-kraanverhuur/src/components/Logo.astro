---
// Woordmerk naar het opschrift op hun kraan: "DE POORTERE" in brede kapitalen, met een rood beeldmerk (giek met haak).
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
const naam = licht ? '#ffffff' : '#131416';
const sub = licht ? '#ff6a5c' : '#b8141f';
---
<span class={`inline-flex items-center gap-2.5 leading-none ${cls}`}>
  <svg viewBox="0 0 40 40" class="h-10 w-10 flex-none" aria-hidden="true">
    <rect width="40" height="40" rx="7" fill="#b8141f" />
    <path d="M8 32h12M11 32l4-8 17-14" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M32 10v11" stroke="#fff" stroke-width="1.6" />
    <path d="M32 21c0 3-4 3-4 0" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col">
    <span class="font-display text-[1.05rem] whitespace-nowrap font-extrabold sm:text-[1.2rem] tracking-[0.01em] uppercase [font-stretch:125%]" style={`color:${naam}`}>De Poortere</span>
    <span class="mt-1 font-display text-[0.64rem] font-bold tracking-[0.34em] uppercase [font-stretch:115%]" style={`color:${sub}`}>Kraanverhuur</span>
  </span>
</span>
