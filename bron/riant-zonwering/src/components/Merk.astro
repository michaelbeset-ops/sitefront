---
// Woordmerk: Riant in Gabarito 900 met een klein gestreept scherm (doek + volant) erboven.
import { url } from '../data/site';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<a href={url('')} class={`group inline-flex items-center gap-3 no-underline ${donker ? 'text-inkt' : 'text-wit'}`}>
  <svg viewBox="0 0 44 30" class="h-9 w-[3.25rem] flex-none" aria-hidden="true">
    <path d="M2 3h40l-3 14H5z" fill="#f6f2e8" />
    <path d="M8.2 3h6.4l-1.2 14H6.4zM20.8 3h6.4l.6 14h-7.4zM33.4 3h6.4L37 17h-5.6z" fill="#1d6146" />
    <path d="M5 17a2.67 2.67 0 0 0 5.33 0 2.67 2.67 0 0 0 5.33 0 2.67 2.67 0 0 0 5.34 0 2.67 2.67 0 0 0 5.33 0 2.67 2.67 0 0 0 5.34 0 2.67 2.67 0 0 0 5.33 0z" fill="#f6f2e8" />
    <path d="M2 3h40" stroke={donker ? '#142019' : '#ffffff'} stroke-width="2.4" stroke-linecap="round" />
  </svg>
  <span class="leading-none">
    <span class="block font-[family-name:var(--font-kop)] text-[1.75rem] font-[900] tracking-[-.04em]">Riant</span><span class="sr-only"> </span>
    <span class={`mt-1 block text-[.75rem] font-semibold uppercase tracking-[.16em] ${donker ? 'text-steen' : 'text-wit/75'}`}>Zonwering</span>
  </span>
</a>
