---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, merken, reviews, waHoi } from '../data/site';

import hoedenwand from '../assets/hoedenwand.jpg';
import petten from '../assets/petten.jpg';
import tassen from '../assets/tassen.jpg';
import plaids from '../assets/plaids.jpg';
import zomerhoeden from '../assets/zomerhoeden.jpg';
import etalage from '../assets/etalage-gevel.jpg';
import kerst from '../assets/etalage-kerst.jpg';
import voorjaar from '../assets/etalage-voorjaar.jpg';
import buste from '../assets/buste-vilt.jpg';
import tafel from '../assets/winkel-tafel.jpg';

const titel = 'Bax Lederwaren, Hoeden en Petten | Peperstraat 48, Wijk bij Duurstede';
const omschrijving = 'Hoeden, petten, lederen tassen, handschoenen en sjaals in de Peperstraat van Wijk bij Duurstede. Open woensdag tot en met zaterdag.';
const [john, henk, jan] = reviews.los;
const soorten = ['een hoed', 'een pet', 'een lederen tas', 'handschoenen', 'een sjaal of plaid', 'bretels of een strik', 'een cadeau'];
const voorWie = ['mezelf', 'mijn partner', 'iemand anders'];
const rij = [3, 4, 5, 6, 0, 1, 2];
---
<Base title={titel} description={omschrijving}>
  <Kop />
  <main id="inhoud">

    <!-- 1. OPENING: hun eigen hoedenwand, planken vol vilt- en strohoeden -->
    <section class="relative isolate flex min-h-[calc(100svh-4.5rem)] flex-col justify-end overflow-hidden bg-inkt text-wit md:min-h-[calc(100svh-5rem)]">
      <Image src={hoedenwand} alt="Een wand met houten planken vol gestapelde hoeden: vilthoeden in bruin en grijs, strohoeden met zwarte band, en blauwe en rode hoeden in het midden" quality={56} widths={[400, 600, 828, 1100, 1440, 1800]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_58%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#1d202433_0%,#1d202440_35%,#1d2024c7_62%,#1d2024f2_100%)] lg:bg-[linear-gradient(90deg,#1d2024eb_0%,#1d2024b8_34%,#1d202433_62%,#1d202400_82%),linear-gradient(0deg,#1d2024a6_0%,#1d202400_42%)]" aria-hidden="true"></div>
      <div class="wrap grid items-end gap-y-10 pb-28 pt-28 md:pb-16 lg:grid-cols-12 lg:pb-20">
        <div class="lg:col-span-8">
          <p class="text-sm font-semibold text-wit/85">Hoeden, petten en lederwaren in Wijk bij Duurstede</p>
          <h1 class="mt-5 max-w-[12ch] text-hero">Kom <em class="font-[480]">passen</em> in de Peperstraat.</h1>
          <p class="mt-7 max-w-[34rem] text-lg text-wit/90">Hoeden, petten, lederen tassen, handschoenen en sjaals. Alexander en Stefka nemen de tijd om met je mee te kijken.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waHoi} class="knop"><Icoon naam="wa" />Stuur een WhatsApp</a>
            <a href="#tijden" class="knop knop-lijn">Openingstijden en route</a>
          </div>
        </div>
        <p class="hidden justify-self-end text-right text-sm text-wit/80 lg:col-span-4 lg:block">
          <span class="bordje !h-9 !min-w-12 !text-lg">·48·</span><br />
          <span class="mt-3 inline-block">{site.straat}, {site.plaats}</span>
        </p>
      </div>
    </section>

    <!-- 2. ASSORTIMENT: hun eigen schappen, groot, met een register als in een winkelboek -->
    <section id="assortiment" class="py-20 md:py-28" aria-labelledby="ass-titel">
      <div class="wrap">
        <div class="grid gap-y-12 md:grid-cols-12 md:gap-x-10">
          <div class="md:col-span-5 lg:col-span-4">
            <h2 id="ass-titel" class="rijs text-3xl">Van strohoed tot flatcap</h2>
            <p class="rijs mt-6 max-w-sm text-lg text-grijs">Alles wat je op of om je hoofd draagt, en het leer om het mee te nemen.</p>
            <ul class="rijs mt-10 text-lg" aria-label="In de winkel">
              <li class="spec"><span class="kop text-2xl font-semibold">Hoeden</span><span></span><span class="text-sm text-grijs">stro en vilt</span></li>
              <li class="spec"><span class="kop text-2xl font-semibold">Petten</span><span></span><span class="text-sm text-grijs">in alle maten</span></li>
              <li class="spec"><span class="kop text-2xl font-semibold">Lederen tassen</span><span></span><span class="text-sm text-grijs">leer</span></li>
              <li class="spec"><span class="kop text-2xl font-semibold">Handschoenen</span><span></span><span class="text-sm text-grijs">in kleur</span></li>
              <li class="spec"><span class="kop text-2xl font-semibold">Sjaals en plaids</span><span></span><span class="text-sm text-grijs">in warme kleuren</span></li>
              <li class="spec"><span class="kop text-2xl font-semibold">Bretels en strikken</span><span></span><span class="text-sm text-grijs">en sokken</span></li>
            </ul>
          </div>
          <figure class="rijs md:col-span-7 md:col-start-6 lg:col-span-8 lg:col-start-5">
            <Image src={petten} alt="Houten bakken vol flatcaps in tweed, ruit en effen kleuren, met daarboven stapels petten onder een bord van Peaky Blinders" quality={62} widths={[400, 560, 760, 1000, 1280]} sizes="(min-width: 768px) 60vw, 100vw" class="aspect-[4/3] w-full object-cover object-[50%_60%]" />
            <figcaption class="mt-3 text-sm text-grijs">Flatcaps, onder andere van Peaky Blinders</figcaption>
          </figure>
        </div>

        <div class="mt-16 grid grid-cols-2 gap-x-3 gap-y-10 md:mt-24 md:grid-cols-12 md:gap-x-6">
          <figure class="rijs col-span-2 md:col-span-4">
            <Image src={tassen} alt="Een wand met lederen schoudertassen in zwart, cognac en bruin onder het merkbord van Spikes & Sparrow" quality={62} widths={[360, 480, 640, 900]} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[4/5] w-full object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">Lederen tassen van Spikes &amp; Sparrow</figcaption>
          </figure>
          <figure class="rijs md:col-span-4 md:mt-28" style="--d:.1s">
            <Image src={zomerhoeden} alt="Gevlochten zomerhoeden in grijs, naturel en zalmrood op een tafel, eentje met een strik" quality={62} widths={[240, 360, 480, 640, 900]} sizes="(min-width: 768px) 33vw, 50vw" class="aspect-square w-full object-cover" />
            <figcaption class="mt-3 text-sm text-grijs">Zomerhoeden</figcaption>
          </figure>
          <figure class="rijs md:col-span-4" style="--d:.2s">
            <Image src={plaids} alt="Een kast vol opgevouwen wollen plaids met franjes, in groen, grijs, oranje en geel" quality={62} widths={[240, 360, 480, 640, 900]} sizes="(min-width: 768px) 33vw, 50vw" class="aspect-[4/5] w-full object-cover md:aspect-[3/5]" />
            <figcaption class="mt-3 text-sm text-grijs">Plaids met franjes</figcaption>
          </figure>
        </div>

        <div class="rijs mt-16 flex flex-col gap-3 border-t border-lijn pt-6 md:mt-20 md:flex-row md:items-baseline md:gap-8">
          <p class="text-sm font-semibold">Op de planken, onder andere:</p>
          <ul class="flex flex-wrap gap-x-6 gap-y-1">{merken.map((m) => <li class="kop text-xl font-semibold">{m}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- 3. DE WINKEL: hun eigen etalage met de belettering op de ruit -->
    <section id="etalage" class="bg-inkt py-20 text-wit md:py-28" aria-labelledby="etalage-titel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-12">
        <figure class="rijs lg:col-span-8">
          <Image src={etalage} alt="De etalage van Bax met op de ruit 'Bax Lederwaren, Hoeden en Petten' in witte letters, drie paspoppen met hoeden en sjaals, oranje vilthoeden en twee wollen plaids" quality={62} widths={[400, 560, 760, 1000, 1280]} sizes="(min-width: 1024px) 62vw, 100vw" class="aspect-[4/3] w-full object-cover" />
        </figure>
        <div class="flex flex-col justify-between gap-y-10 lg:col-span-4">
          <div>
            <span class="bordje rijs">·48·</span>
            <h2 id="etalage-titel" class="rijs mt-8 text-3xl">Achter deze ruit</h2>
            <p class="rijs mt-6 text-lg text-mist">De winkel van {site.eigenaren}, in de Peperstraat in het oude centrum. Kom binnen en pas gerust, er wordt de tijd voor genomen.</p>
            <p class="rijs mt-6"><a href="#tijden" class="link link-licht font-semibold">Openingstijden en route</a></p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <figure class="rijs">
              <Image src={kerst} alt="De etalage in de kersttijd, met hoeden, rode petten en kerstversiering achter de beletterde ruit" quality={66} widths={[240, 360, 480]} sizes="(min-width: 1024px) 14vw, 45vw" class="aspect-square w-full object-cover object-[70%_50%]" />
              <figcaption class="mt-2 text-xs text-mist">Met kerst</figcaption>
            </figure>
            <figure class="rijs" style="--d:.1s">
              <Image src={voorjaar} alt="Een paspop met een oranje hoed en sjaal in de etalage, tussen gele bloemen en andere hoeden" quality={66} widths={[240, 360, 480]} sizes="(min-width: 1024px) 14vw, 45vw" class="aspect-square w-full object-cover object-[50%_35%]" />
              <figcaption class="mt-2 text-xs text-mist">In het voorjaar</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. IETS ZOEKEN: een briefje dat eindigt in WhatsApp -->
    <section id="zoeken" class="py-20 md:py-28" aria-labelledby="zoek-titel">
      <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-14">
        <figure class="rijs hidden lg:col-span-4 lg:block">
          <Image src={buste} alt="Een paspop met een grijze vilten hoed met strik en een oranje met grijze sjaal" quality={68} widths={[360, 480, 720]} sizes="30vw" class="aspect-[3/4] w-full object-cover" />
        </figure>
        <div class="lg:col-span-8 lg:self-center">
          <h2 id="zoek-titel" class="rijs text-3xl">Op zoek naar iets?</h2>
          <p class="rijs mt-5 max-w-xl text-lg text-grijs">Vul het briefje in en stuur het via WhatsApp. Dan hoor je of het in de winkel ligt.</p>

          <form id="briefje" class="rijs kader mt-10 bg-wit px-7 py-9 text-inkt shadow-[0_1px_2px_#1d202414,0_10px_30px_#1d20240f] sm:p-10 md:p-12" data-briefje novalidate>
            <p class="kop text-[1.55rem] leading-[2.3] sm:text-[1.9rem]">
              <label for="z-wat">Ik zoek</label>{' '}
              <select id="z-wat" name="wat" class="veld">{soorten.map((s) => <option>{s}</option>)}</select>{' '}
              <label for="z-wie">voor</label>{' '}
              <select id="z-wie" name="wie" class="veld">{voorWie.map((s) => <option>{s}</option>)}</select>,{' '}
              <label for="z-stijl">het liefst</label>{' '}
              <input id="z-stijl" name="stijl" class="veld w-[11ch]" placeholder="kleur of stijl" autocomplete="off" />.
            </p>
            <p class="mt-3 kop text-xl leading-[2.3] text-grijs" data-maat>
              <label for="z-maat">Mijn hoofdomtrek is</label>{' '}
              <input id="z-maat" name="maat" class="veld w-[3.2ch] !text-xl" inputmode="numeric" maxlength="2" placeholder="57" autocomplete="off" /> cm{' '}
              <span class="font-sans text-sm">(mag leeg blijven)</span>
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-lijn pt-8">
              <button type="submit" class="knop"><Icoon naam="wa" />Stuur naar Alexander</button>
              <a href={site.telHref} class="link num font-semibold">of bel {site.tel}</a>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- 5. REVIEWS: letterlijk van Google -->
    <section id="reviews" class="border-t border-lijn bg-kalk-2 py-20 md:py-28" aria-labelledby="rev-titel">
      <div class="wrap">
        <h2 id="rev-titel" class="sr-only">Reviews</h2>
        <figure class="rijs max-w-5xl">
          <blockquote class="kop text-3xl leading-[1.12]">“{reviews.groot.tekst}”</blockquote>
          <figcaption class="mt-6 text-sm text-grijs"><span class="font-semibold text-inkt">{reviews.groot.naam}</span> · Google review</figcaption>
        </figure>
        <div class="mt-16 grid gap-y-10 md:mt-20 md:grid-cols-3 md:gap-x-10">
          {[john, henk, jan].map((r, i) => (
            <figure class="rijs border-t-2 border-inkt pt-6" style={`--d:${i * 0.1}s`}>
              <blockquote class="text-lg">“{r.tekst}”</blockquote>
              <figcaption class="mt-4 text-sm text-grijs"><span class="font-semibold text-inkt">{r.naam}</span> · Google review</figcaption>
            </figure>
          ))}
        </div>
        <p class="rijs mt-14 text-sm text-grijs"><a href={site.google.url} class="link font-semibold text-inkt">{site.google.score} op Google uit {site.google.aantal} reviews</a></p>
      </div>
    </section>

    <!-- 6. TIJDEN EN ROUTE -->
    <section id="tijden" class="py-20 md:py-28" aria-labelledby="tijden-titel">
      <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-14">
        <div class="lg:col-span-5">
          <h2 id="tijden-titel" class="rijs text-3xl">Woensdag tot en met zaterdag open</h2>
          <p class="rijs mt-6 text-lg font-semibold" data-status aria-live="polite">&nbsp;</p>
          <table class="rijs mt-6 w-full text-left num">
            <caption class="sr-only">Openingstijden</caption>
            <tbody>
              {rij.map((i) => (
                <tr class="border-b border-lijn" data-dag={i}>
                  <th scope="row" class="py-3 font-medium capitalize">{tijden[i].dag}</th>
                  <td class="py-3 text-right">{tijden[i].van ? `${tijden[i].van} tot ${tijden[i].tot}` : <span class="text-grijs">gesloten</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="rijs mt-10 text-lg">{site.straat}<br />{site.postcode} {site.plaats}</p>
          <div class="rijs mt-8 flex flex-wrap gap-3">
            <a href={site.route} class="knop knop-inkt"><Icoon naam="pin" />Route plannen</a>
            <a href={waHoi} class="knop"><Icoon naam="wa" />WhatsApp</a>
          </div>
        </div>
        <figure class="rijs lg:col-span-7">
          <Image src={tafel} alt="Een houten tafel in de winkel met gestapelde wollen plaids, daarop vilthoeden en baretten in rood, zwart en naturel, met tassen en sjaals op de achtergrond" quality={62} widths={[400, 560, 760, 1000, 1200]} sizes="(min-width: 1024px) 55vw, 100vw" class="aspect-[4/5] w-full object-cover lg:aspect-[5/6]" />
        </figure>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { waMet } from '../data/site';
  // Zoekbriefje: zin + optionele hoofdomtrek naar een vooraf ingevuld WhatsApp-bericht.
  const f = document.querySelector<HTMLFormElement>('[data-briefje]');
  if (f) {
    const maat = f.querySelector<HTMLElement>('[data-maat]');
    const wat = f.querySelector<HTMLSelectElement>('#z-wat');
    const toon = () => { if (maat && wat) maat.hidden = !/hoed|pet/.test(wat.value); };
    wat?.addEventListener('change', toon); toon();
    // Keuzelijsten zo breed als de gekozen tekst, zodat de zin als een zin leest.
    const ctx = document.createElement('canvas').getContext('2d');
    const pas = (s: HTMLSelectElement) => { if (!ctx) return; const cs = getComputedStyle(s); ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`; s.style.width = `${Math.ceil(ctx.measureText(s.selectedOptions[0]?.text || '').width + parseFloat(cs.fontSize) * 1.25)}px`; };
    f.querySelectorAll<HTMLSelectElement>('select.veld').forEach((s) => { s.addEventListener('change', () => pas(s)); document.fonts.ready.then(() => pas(s)); });
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const stijl = String(d.get('stijl') || '').trim();
      const cm = String(d.get('maat') || '').replace(/\D/g, '');
      let t = `Hallo Alexander, ik zoek ${d.get('wat')} voor ${d.get('wie')}`;
      if (stijl) t += `, het liefst ${stijl}`;
      t += '.';
      if (cm && maat && !maat.hidden) t += ` Mijn hoofdomtrek is ${cm} cm.`;
      t += ' Hebben jullie iets in de winkel?';
      window.open(waMet(t), '_blank', 'noopener');
    });
  }
  // Vandaag in de tabel markeren en open/dicht tonen.
  import { tijden } from '../data/site';
  const nu = new Date(); const dag = nu.getDay(); const min = nu.getHours() * 60 + nu.getMinutes();
  const m = (s: string) => { const [h, mm] = s.split(':').map(Number); return h * 60 + mm; };
  const tr = document.querySelector(`[data-dag="${dag}"]`); tr?.classList.add('bg-wit', 'font-semibold');
  const st = document.querySelector('[data-status]');
  const t = tijden[dag];
  if (st) {
    if (t.van && t.tot && min >= m(t.van) && min < m(t.tot)) st.textContent = `Nu open, vandaag tot ${t.tot}`;
    else {
      let i = 0, n = dag;
      if (t.van && min < m(t.van)) { st.textContent = `Vandaag open vanaf ${t.van}`; }
      else {
        do { n = (n + 1) % 7; i++; } while (!tijden[n].van && i < 7);
        st.textContent = `Nu gesloten. ${i === 1 ? 'Morgen' : tijden[n].dag[0].toUpperCase() + tijden[n].dag.slice(1)} weer open vanaf ${tijden[n].van}`;
      }
    }
  }
</script>
