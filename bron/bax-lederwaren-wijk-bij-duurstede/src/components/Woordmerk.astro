---
// Het woordmerk zoals het op hun etalageruit staat: "Bax", daaronder LEDERWAREN in een boog, en "Hoeden en Petten".
interface Props { class?: string; id: string; titel?: boolean }
const { class: c = '', id, titel = true } = Astro.props;
---
<svg viewBox="0 0 240 118" class={c} role={titel ? 'img' : undefined} aria-hidden={titel ? undefined : 'true'} aria-label={titel ? 'Bax Lederwaren, Hoeden en Petten' : undefined}>
  <defs><path id={`boog-${id}`} d="M14 92 Q120 34 226 92" fill="none" /></defs>
  <text x="120" y="30" text-anchor="middle" fill="currentColor" style="font-family: var(--font-sans); font-weight: 450; font-size: 30px; letter-spacing: .5px">Bax</text>
  <text fill="currentColor" style="font-family: var(--font-kop); font-weight: 700; font-size: 31px; letter-spacing: .5px">
    <textPath href={`#boog-${id}`} startOffset="50%" text-anchor="middle">LEDERWAREN</textPath>
  </text>
  <path d="M38 96 Q120 66 202 96" fill="none" stroke="currentColor" stroke-width="1.6" />
  <text x="120" y="114" text-anchor="middle" fill="currentColor" style="font-family: var(--font-sans); font-weight: 450; font-size: 17px; letter-spacing: .3px">Hoeden en Petten</text>
</svg>
