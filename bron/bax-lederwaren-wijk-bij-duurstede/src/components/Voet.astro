---
import { site, url, waHoi, tijden } from '../data/site';
import Woordmerk from './Woordmerk.astro';
const jaar = new Date().getFullYear();
const lijst = ['Hoeden', 'Petten', 'Lederen tassen', 'Handschoenen', 'Sjaals en plaids', 'Bretels, strikken en sokken'];
const open = [3, 4, 5, 6].map((i) => tijden[i]);
---
<footer class="bg-inkt text-mist">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Woordmerk id="voet" class="h-20 w-auto text-wit" />
      <p class="mt-6 max-w-xs">Hoeden, petten en lederwaren van {site.eigenaren}, in de Peperstraat van Wijk bij Duurstede.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">In de winkel</p>
      <ul class="mt-3 space-y-1">{lijst.map((p) => <li><a href={url('#assortiment')} class="link link-licht no-underline hover:underline">{p}</a></li>)}</ul>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link link-licht num">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a></p>
      <p class="mt-1 break-all"><a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4 flex gap-5"><a href={site.facebook} class="link link-licht">Facebook</a><a href={site.instagram} class="link link-licht">Instagram</a></p>
    </div>
    <div class="md:col-span-2">
      <p class="font-bold text-wit">Open</p>
      <ul class="mt-3 space-y-1 num">{open.map((t) => <li><span class="inline-block w-9">{t.dag.slice(0, 2)}</span> {t.van} tot {t.tot}</li>)}</ul>
      <p class="mt-2">zo t/m di gesloten</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Alle foto's komen van jullie eigen Google-profiel. Reviews letterlijk van Google (stand 8 oktober 2026).</p>}
</footer>
