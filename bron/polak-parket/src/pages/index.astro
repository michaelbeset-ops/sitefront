---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, reviews, waHoi, waMet } from '../data/site';

import hero from '../assets/hero.jpg';
import kampioen from '../assets/kampioen.jpg';
import lukasz from '../assets/lukasz.jpg';
import paneel from '../assets/paneel.jpg';
import bies from '../assets/bies.jpg';
import leggen from '../assets/leggen.jpg';
import zolder from '../assets/zolder.jpg';
import bar from '../assets/bar.jpg';
import kamer from '../assets/kamer.jpg';
import planken from '../assets/planken.jpg';
import donker from '../assets/donker.jpg';
import deur from '../assets/deur.jpg';
import hoek from '../assets/hoek.jpg';
import nGang from '../assets/n-gang.jpg';
import nPilaren from '../assets/n-pilaren.jpg';
import nTrap from '../assets/n-trap.jpg';
import nRaam from '../assets/n-raam.jpg';
import nChevron from '../assets/n-chevron.jpg';
import blok from '../assets/blok2.jpg';

// Diensten: titels en zinnen letterlijk uit hun eigen Werkspot-omschrijving.
const diensten = [
  { titel: 'Parket leggen', tekst: 'Van traditioneel visgraat tot moderne patroonvloeren.', foto: zolder, alt: 'Eiken visgraatvloer onder een driehoekig raam, gelegd door Polak Parket', pos: 'center 70%' },
  { titel: 'Vloerrenovatie', tekst: 'Professioneel en stofvrij schuren, oliën of lakken.', foto: kamer, alt: 'Afgewerkte eiken visgraatvloer in een kamer met raam', pos: 'center 70%' },
  { titel: 'Afwerking', tekst: 'Vakkundige montage van plinten en profielen.', foto: deur, alt: 'Visgraatvloer met rand langs een paneeldeur en strakke plint', pos: 'center 75%' },
];

// Patronen die ze zelf noemen: visgraat (Werkspot), Hongaarse punt (review) / Franse chevron (Facebook),
// bies en band (Facebook, Instagram "bend en bies"), "Europees eiken blokpatroon" (Instagram), multiplank (Werkspot-review).
const patronen = [
  { id: 'visgraat', naam: 'Visgraat', foto: leggen, alt: 'Lukasz legt een eiken visgraatvloer', pos: 'center 60%' },
  { id: 'chevron', naam: 'Hongaarse punt', foto: nGang, alt: 'Eiken in Franse chevron in een gang met donkere bies', pos: 'center' },
  { id: 'bies', naam: 'Met bies en band', foto: bies, alt: 'Visgraat met dubbele bies rond een kolom', pos: '40% center' },
  { id: 'blok', naam: 'Blokpatroon', foto: blok, alt: 'Europees eiken blokpatroon bij openslaande deuren', pos: 'center 60%' },
  { id: 'planken', naam: 'Rechte planken', foto: planken, alt: 'Brede houten planken, geolied, voor een glazen pui', pos: 'center 75%' },
];

const stappen = [
  ['Eerste contact', 'Bel of app voor advies of een gratis offerte.'],
  ['De opties', 'Patroon, hout en afwerking samen kiezen.'],
  ['Voorbereiding', 'De ruimte klaar voor het werk.'],
  ['Leggen of schuren', 'Leggen, schuren, oliën of lakken.'],
  ['Plinten', 'Plinten en profielen als laatste detail.'],
];

const kort = (t: (typeof tijden)[number]) => (t.open ? `${String(t.open[0]).padStart(2, '0')}.00 tot ${t.open[1]}.00` : 'Gesloten');
const band = ['Visgraat', 'Hongaarse punt', 'Blokpatroon', 'Bies en band', 'Schuren', 'Oliën', 'Lakken', 'Plinten'];
---
<Base title="Polak Parket | Parketteur in Tilburg, Nederlands Kampioen Parketleggen 2025" description="Polak Parket uit Tilburg legt en renoveert houten vloeren: visgraat, Hongaarse punt, bies en band. Schuren, oliën of lakken. Gratis offerte via WhatsApp.">
  <Kop />
  <main id="inhoud">
    <!-- HERO -->
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden bg-inkt text-wit">
      <Image quality={66} src={hero} alt="Eiken visgraatvloer in een appartement hoog boven de stad, gelegd door Polak Parket" widths={[640, 960, 1400, 1920, 2600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_70%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#161513d9_0%,#16151340_30%,#16151366_55%,#161513f2_100%)] lg:bg-[linear-gradient(90deg,#161513f0_0%,#161513b3_42%,#16151326_75%),linear-gradient(180deg,#16151399_0%,transparent_28%)]"></div>
      <div class="wrap pb-24 pt-32 md:pb-24 md:pt-40 lg:pb-28">
        <p class="eyebrow text-wit/90">Parketteur in Tilburg en omgeving</p>
        <h1 class="mt-5 max-w-[13ch] text-hero">Parket, gelegd door de Nederlands <span class="text-eik-licht">kampioen</span>.</h1>
        <p class="mt-6 max-w-xl text-lg text-wit/85 md:text-xl">Houten vloeren verkopen, leggen en renoveren: van traditioneel visgraat tot moderne patroonvloeren.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={waHoi} class="knop knop-eik"><Icoon naam="wa" class="h-5 w-5" />Vraag een offerte aan</a>
          <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" class="h-5 w-5" />Bel {site.tel}</a>
        </div>
        <ul class="mt-7 flex flex-wrap gap-x-7 gap-y-2 text-[.9375rem] font-semibold text-wit/85">
          <li class="flex items-center gap-2"><Icoon naam="vink" class="h-4 w-4 text-eik-licht" />Nederlands Kampioen Parketleggen 2025</li>
          <li class="hidden items-center gap-2 sm:flex"><Icoon naam="vink" class="h-4 w-4 text-eik-licht" />Gratis offerte</li>
          <li class="hidden items-center gap-2 sm:flex"><Icoon naam="vink" class="h-4 w-4 text-eik-licht" />Ma t/m za bereikbaar</li>
        </ul>
      </div>
    </section>

    <!-- PATRONENBAND -->
    <div class="border-t border-lijn bg-inkt text-mist">
      <ul class="wrap flex flex-wrap items-center justify-center gap-x-5 gap-y-2 py-6 text-[.875rem] font-semibold uppercase tracking-[.14em] lg:justify-between">
        {band.map((b, i) => (<li class="flex items-center gap-5">{i > 0 && <span class="hidden h-2 w-3 bg-eik [clip-path:polygon(50%_0,100%_62%,100%_100%,50%_38%,0_100%,0_62%)] sm:block" aria-hidden="true"></span>}{b}</li>))}
      </ul>
    </div>

    <!-- WAT WE DOEN -->
    <section id="werk" class="py-20 lg:py-28">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 class="text-4xl lg:col-span-7">Leggen, renoveren, afwerken.</h2>
          <p class="max-w-md text-lg text-steen lg:col-span-5 lg:justify-self-end">Polak Parket verkoopt houten en parketvloeren en maakt oude vloeren weer mooi.</p>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {diensten.map((d, i) => (
            <article class={`rijs group relative ${i === 1 ? 'md:mt-14' : ''}`}>
              <div class="foto zoom aspect-[4/5] lg:aspect-[1/1]">
                <Image quality={66} src={d.foto} alt={d.alt} widths={[400, 640, 900]} sizes="(min-width: 768px) 32vw, 100vw" style={`object-position:${d.pos}`} />
              </div>
              <div class="relative -mt-14 mr-6 bg-kalk pr-6 pt-6">
                <p class="num font-kop text-sm font-[700] text-eik-diep">0{i + 1}</p>
                <h3 class="mt-1 text-2xl">{d.titel}</h3>
                <p class="mt-2 text-steen">{d.tekst}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- KAMPIOEN -->
    <section id="kampioen" class="relative bg-inkt text-wit">
      <div class="bbb"></div>
      <div class="wrap grid gap-12 py-24 lg:grid-cols-12 lg:gap-16 lg:py-32">
        <div class="rijs lg:col-span-5">
          <div class="foto aspect-[4/5] lg:aspect-[3/4]">
            <Image quality={66} src={kampioen} alt="Lukasz Polak met kampioensgordel en bekers op het NK Parketleggen" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 38vw, 100vw" class="object-[50%_30%]" />
          </div>
        </div>
        <div class="flex flex-col justify-center lg:col-span-7">
          <h2 class="text-4xl">Van vijfde naar <span class="text-eik-licht">eerste</span>.</h2>
          <p class="mt-6 max-w-xl text-lg text-mist">Op het NK Parketleggen werd Lukasz Polak in 2023 vijfde, in 2024 derde en in 2025 Nederlands kampioen.</p>

          <!-- De klim: drie houten blokken, zoals een podium -->
          <ol class="mt-12 grid max-w-xl grid-cols-3 items-end gap-3" aria-label="Uitslagen NK Parketleggen">
            <li class="flex flex-col">
              <span class="num font-kop text-xl font-[800] text-mist">2023</span>
              <span class="mt-3 grid h-20 place-items-center border border-lijn bg-inkt-3 font-kop text-3xl font-[800]"><span>5<sup class="text-sm">e</sup></span></span>
            </li>
            <li class="flex flex-col">
              <span class="num font-kop text-xl font-[800] text-mist">2024</span>
              <span class="mt-3 grid h-32 place-items-center border border-lijn bg-[#3a3631] font-kop text-4xl font-[800]"><span>3<sup class="text-base">e</sup></span></span>
            </li>
            <li class="flex flex-col">
              <span class="num font-kop text-xl font-[800] text-eik-licht">2025</span>
              <span class="mt-3 grid h-48 place-items-center bg-[linear-gradient(160deg,#dcab74,#b47a42)] font-kop text-[3.75rem] font-[800] text-inkt"><span>1<sup class="text-xl">e</sup></span></span>
            </li>
          </ol>

          <blockquote class="mt-14 max-w-xl border-l-2 border-eik pl-6">
            <p class="font-kop text-2xl font-[600] leading-snug">"Wij werken netjes, komen afspraken na en zorgen voor een vloer die generaties lang meegaat."</p>
            <footer class="mt-3 text-[.9375rem] text-mist">Polak Parket</footer>
          </blockquote>
        </div>
      </div>
      <figure class="relative">
        <div class="foto h-[38vh] min-h-64 lg:h-[46vh]">
          <Image quality={66} src={paneel} alt="Paneel met sterpatroon, omlijst met donkere bies en band, uit het portfolio van Polak Parket" widths={[640, 1200, 1800, 2200]} sizes="100vw" class="object-[50%_45%]" />
        </div>
        <figcaption class="wrap py-4 text-[.9375rem] text-mist">Uit het portfolio: patroonwerk met bies en band.</figcaption>
      </figure>
    </section>

    <!-- PATRONENBOEK (wow) -->
    <section id="patronen" class="py-20 lg:py-28">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <h2 class="text-4xl lg:col-span-6">Welk patroon wordt het?</h2>
          <p class="max-w-lg text-lg text-steen lg:col-span-6 lg:justify-self-end">Kies een vloer uit ons eigen werk, vul de maat in en stuur het via WhatsApp. Voor advies of een gratis offerte.</p>
        </div>

        <form id="planner" class="mt-14" novalidate>
          <fieldset>
            <legend class="sr-only">Kies een patroon</legend>
            <div class="grid grid-cols-2 gap-4 md:grid-cols-5">
              {patronen.map((p, i) => (
                <label class={`patroon block cursor-pointer ${i === 4 ? 'col-span-2 md:col-span-1' : ''}`}>
                  <input type="radio" name="patroon" value={p.naam} class="sr-only" checked={i === 0} />
                  <span class="patroon-kaart block bg-wit transition-[outline-color] duration-200">
                    <span class={`foto relative block ${i === 4 ? 'aspect-[2/1] md:aspect-[3/4]' : 'aspect-[3/4]'}`}>
                      <Image quality={66} src={p.foto} alt={p.alt} widths={[300, 480, 640]} sizes="(min-width: 768px) 18vw, 46vw" style={`object-position:${p.pos}`} />
                      <span class="vink absolute right-2 top-2 grid h-8 w-8 place-items-center bg-eik text-inkt opacity-0 transition-opacity duration-200"><Icoon naam="vink" class="h-5 w-5" /></span>
                    </span>
                    <span class="block px-3 py-3 font-kop text-lg font-[750] leading-tight">{p.naam}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="mt-10 grid gap-8 lg:grid-cols-12">
            <div class="grid gap-7 lg:col-span-7">
              <fieldset>
                <legend class="text-[.9375rem] font-bold uppercase tracking-[.12em]">Wat moet er gebeuren?</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  <label class="keuze cursor-pointer"><input type="radio" name="klus" value="nieuw" class="sr-only" checked /><span class="inline-flex min-h-12 items-center border border-inkt/30 px-4 font-semibold transition-colors">Nieuwe vloer leggen</span></label>
                  <label class="keuze cursor-pointer"><input type="radio" name="klus" value="renovatie" class="sr-only" /><span class="inline-flex min-h-12 items-center border border-inkt/30 px-4 font-semibold transition-colors">Bestaande vloer opknappen</span></label>
                </div>
              </fieldset>
              <fieldset>
                <legend class="text-[.9375rem] font-bold uppercase tracking-[.12em]">Afwerking</legend>
                <div class="mt-3 flex flex-wrap gap-2">
                  {['Olie', 'Lak', 'Weet ik nog niet'].map((a, i) => (
                    <label class="keuze cursor-pointer"><input type="radio" name="afwerking" value={a} class="sr-only" checked={i === 2} /><span class="inline-flex min-h-12 items-center border border-inkt/30 px-4 font-semibold transition-colors">{a}</span></label>
                  ))}
                </div>
              </fieldset>
              <div class="grid gap-5 sm:grid-cols-2">
                <label class="block">
                  <span class="text-[.9375rem] font-bold uppercase tracking-[.12em]">Ongeveer m²</span>
                  <input name="m2" type="number" inputmode="numeric" min="1" max="2000" placeholder="bijv. 45" class="num mt-2 block min-h-13 w-full border border-inkt/30 bg-wit px-4 text-lg focus:border-inkt" />
                </label>
                <label class="block">
                  <span class="text-[.9375rem] font-bold uppercase tracking-[.12em]">Woonplaats</span>
                  <input name="plaats" type="text" autocomplete="address-level2" placeholder="bijv. Tilburg" class="mt-2 block min-h-13 w-full border border-inkt/30 bg-wit px-4 text-lg focus:border-inkt" />
                </label>
              </div>
              <label class="flex cursor-pointer items-center gap-3 font-semibold">
                <input name="plinten" type="checkbox" class="h-5 w-5 accent-[#8a5524]" />
                Ook nieuwe plinten
              </label>
            </div>

            <div class="lg:col-span-5">
              <div class="flex h-full flex-col bg-inkt p-6 text-wit md:p-8">
                <p class="text-[.9375rem] font-bold uppercase tracking-[.12em] text-eik-licht">Uw bericht</p>
                <p id="planner-tekst" class="mt-4 flex-1 whitespace-pre-line text-lg leading-relaxed" aria-live="polite"></p>
                <a id="planner-knop" href={waHoi} class="knop knop-eik mt-6 w-full"><Icoon naam="wa" class="h-5 w-5" />Verstuur via WhatsApp</a>
                <p class="mt-3 text-[.875rem] text-mist">WhatsApp opent met dit bericht. U verstuurt het zelf.</p>
              </div>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- PROJECT UITGELICHT -->
    <section id="projecten" class="bg-inkt py-24 text-wit lg:py-32">
      <div class="wrap">
        <div class="grid gap-10 lg:grid-cols-12">
          <div class="lg:col-span-5 lg:pt-8">
            <p class="text-[.9375rem] font-bold uppercase tracking-[.12em] text-eik-licht">Onlangs opgeleverd</p>
            <h2 class="mt-4 text-4xl">Nassaukade, Amsterdam.</h2>
            <p class="mt-6 text-lg text-mist">Een monumentaal pand uit 1885, op een steenworp afstand van het Rijksmuseum. Eiken in Franse chevron, rond de authentieke pilaren afgewerkt met een strakke, contrasterende bies en band.</p>
          </div>
          <div class="grid grid-cols-2 gap-4 lg:col-span-7">
            <div class="foto zoom col-span-2 aspect-[4/5] sm:col-span-1 sm:row-span-2 sm:aspect-auto sm:min-h-full">
              <Image quality={66} src={nPilaren} alt="Bovenaanzicht: chevron met bies rond twee pilaren" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 28vw, (min-width: 640px) 46vw, 100vw" />
            </div>
            <div class="foto zoom aspect-[3/4]">
              <Image quality={66} src={nTrap} alt="Chevron met bies tussen twee pilaren, met de trap op de achtergrond" widths={[300, 600]} sizes="(min-width: 1024px) 28vw, 46vw" />
            </div>
            <div class="foto zoom aspect-[3/4]">
              <Image quality={66} src={nRaam} alt="Chevron naar het raam toe, tussen twee pilaren" widths={[300, 600]} sizes="(min-width: 1024px) 28vw, 46vw" />
            </div>
          </div>
        </div>

        <div class="mt-16 grid grid-cols-2 gap-4 md:grid-cols-4">
          <div class="foto zoom aspect-[3/4]"><Image quality={66} src={hoek} alt="Planken in een diagonaal patroon, doorgezet tegen de wand" widths={[300, 600]} sizes="(min-width: 768px) 24vw, 46vw" class="object-[30%_50%]" /></div>
          <div class="foto zoom aspect-[3/4]"><Image quality={66} src={bar} alt="Visgraatvloer langs een wand met flessen in een horecazaak" widths={[300, 600]} sizes="(min-width: 768px) 24vw, 46vw" /></div>
          <div class="foto zoom aspect-[3/4]"><Image quality={66} src={donker} alt="Donkere visgraatvloer bij een open haard" widths={[300, 600]} sizes="(min-width: 768px) 24vw, 46vw" /></div>
          <div class="foto zoom aspect-[3/4]"><Image quality={66} src={nChevron} alt="Eiken chevron met een donkere bies langs een deurpost, Nassaukade" widths={[300, 600]} sizes="(min-width: 768px) 24vw, 46vw" class="object-[50%_60%]" /></div>
        </div>
        <p class="mt-8"><a href={site.insta} class="link inline-flex items-center gap-2 font-bold text-wit hover:text-eik-licht"><Icoon naam="insta" class="h-5 w-5" />Meer werk op Instagram</a></p>
      </div>
    </section>

    <!-- WERKWIJZE + LUKASZ -->
    <section id="over" class="py-20 lg:py-28">
      <div class="wrap">
        <h2 class="text-4xl">Zo gaat het.</h2>
        <ol class="mt-12 grid gap-px border border-lijn-licht bg-[#16151324] sm:grid-cols-2 lg:grid-cols-5">
          {stappen.map(([t, z], i) => (
            <li class="bg-kalk p-6 lg:p-7">
              <span class="num font-kop text-4xl font-[800] text-eik-diep">0{i + 1}</span>
              <h3 class="mt-4 font-sans text-lg font-[800] tracking-normal">{t}</h3>
              <p class="mt-1.5 text-steen">{z}</p>
            </li>
          ))}
        </ol>
        <p class="mt-5 max-w-3xl text-[.9375rem] text-steen">"Vanaf het eerste contact, het tonen van de vele opties, de voorbereiding, het leggen zelf tot aan de nazorg, het zetten van plinten …" Pieter V. op Google</p>

        <div class="mt-20 grid gap-12 lg:mt-28 lg:grid-cols-12 lg:gap-16">
          <div class="rijs lg:col-span-5">
            <div class="foto aspect-[4/5]">
              <Image quality={66} src={lukasz} alt="Lukasz Polak op zijn knieën bij een eiken vloer, met handschoen en kniebeschermers" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 38vw, 100vw" class="object-[50%_70%]" />
            </div>
          </div>
          <div class="flex flex-col justify-center lg:col-span-7">
            <h2 class="text-4xl">Lukasz Polak.</h2>
            <p class="mt-6 max-w-xl text-lg text-steen">Lukasz Polak legt de vloeren zelf, van eerste plank tot laatste plint.</p>
            <ul class="mt-10 grid gap-4 sm:grid-cols-3">
              <li class="border-t-2 border-eik pt-4"><p class="font-kop text-xl font-[750] leading-snug">"Neemt de tijd om alles goed uit te leggen"</p><p class="mt-2 text-[.9375rem] text-steen">Stella, Werkspot</p></li>
              <li class="border-t-2 border-eik pt-4"><p class="font-kop text-xl font-[750] leading-snug">"Werkt heel nauwkeurig"</p><p class="mt-2 text-[.9375rem] text-steen">Majkel C., Google</p></li>
              <li class="border-t-2 border-eik pt-4"><p class="font-kop text-xl font-[750] leading-snug">"Denkt mee, veel opties"</p><p class="mt-2 text-[.9375rem] text-steen">Werkspot-gebruiker, Helmond</p></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews" class="bg-kalk-2 py-20 lg:py-28">
      <div class="wrap">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <h2 class="text-4xl">Wat klanten zeggen</h2>
          <a href={site.werkspot} class="inline-flex items-center gap-3 self-start bg-wit px-4 py-3 text-inkt no-underline shadow-[0_1px_0_#16151314] hover:bg-kalk md:self-auto">
            <span class="flex text-eik-diep">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
            <span class="num text-[.9375rem] font-bold">{site.werkspotScore.score} op Werkspot · {site.werkspotScore.aantal} reviews</span>
          </a>
        </div>
        <div class="mt-12 columns-1 gap-5 md:columns-2 lg:columns-3">
          {reviews.map((r) => (
            <figure class="mb-5 break-inside-avoid bg-wit p-7">
              <div class="flex text-eik-diep" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</div>
              <blockquote class="mt-4 text-[1.0625rem] leading-relaxed">"{r.tekst}"</blockquote>
              <figcaption class="mt-5 flex items-center justify-between gap-3 border-t border-lijn-licht pt-4 text-[.9375rem]">
                <span class="font-bold">{r.naam}{r.plaats ? `, ${r.plaats}` : ''}</span>
                <span class="flex items-center gap-1.5 text-steen">{r.bron === 'Google' && <Icoon naam="g" class="h-4 w-4" />}{r.bron} review</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-bold">
          <a href={site.werkspot} class="link text-inkt">Alle reviews op Werkspot</a>
          <a href={site.google} class="link text-inkt">Reviews op Google</a>
        </p>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="bg-inkt text-wit">
      <div class="wrap grid gap-14 py-24 lg:grid-cols-12 lg:py-32">
        <div class="lg:col-span-7">
          <h2 class="text-4xl">Vertel ons over uw vloer.</h2>
          <p class="mt-6 max-w-lg text-lg text-mist">Stuur een foto van de ruimte via WhatsApp, of bel. Polak Parket werkt in {site.regio}.</p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a href={waMet('Hallo Lukasz, ik heb een vraag over een houten vloer. Ik stuur een foto van de ruimte mee.')} class="knop knop-eik"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
            <a href={site.telHref} class="knop knop-lijn num"><Icoon naam="tel" class="h-5 w-5" />{site.tel}</a>
          </div>
          <p class="mt-6"><a href={`mailto:${site.mail}`} class="link break-all text-wit hover:text-eik-licht">{site.mail}</a></p>
        </div>
        <div class="lg:col-span-5">
          <div class="border border-lijn p-6 md:p-8">
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-sans text-lg font-[800] tracking-normal">Openingstijden</h3>
              <p id="nu-open" class="text-[.9375rem] font-bold text-eik-licht"></p>
            </div>
            <dl class="num mt-5 divide-y divide-lijn">
              {tijden.map((t) => (
                <div class="flex justify-between gap-4 py-2.5" data-dag={t.nr}>
                  <dt>{t.dag}</dt><dd class="text-mist">{kort(t)}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
      <div class="bg-eik text-inkt">
        <div class="wrap flex flex-col gap-5 py-9 md:flex-row md:items-center md:justify-between">
          <p class="font-kop text-2xl font-[800]">Een vloer die generaties lang meegaat.</p>
          <a href={waHoi} class="knop knop-inkt self-start md:self-auto"><Icoon naam="wa" class="h-5 w-5" />Offerte aanvragen</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  import { site } from '../data/site';
  // Patronenboek: bouwt een kort WhatsApp-bericht uit de keuzes. Verstuurt zelf niets.
  const f = document.querySelector<HTMLFormElement>('#planner');
  const uit = document.querySelector<HTMLElement>('#planner-tekst');
  const knop = document.querySelector<HTMLAnchorElement>('#planner-knop');
  function bouw() {
    if (!f || !uit || !knop) return;
    const d = new FormData(f);
    const patroon = String(d.get('patroon') || 'Visgraat');
    const nieuw = d.get('klus') !== 'renovatie';
    const afw = String(d.get('afwerking') || '');
    const m2 = String(d.get('m2') || '').trim();
    const plaats = String(d.get('plaats') || '').trim();
    const regels = ['Hallo Lukasz,', ''];
    regels.push(nieuw ? `Ik wil graag een nieuwe vloer laten leggen: ${patroon.toLowerCase()}.` : `Ik heb een bestaande houten vloer (${patroon.toLowerCase()}) die ik wil laten opknappen.`);
    if (m2) regels.push(`Ongeveer ${m2} m².`);
    if (afw && afw !== 'Weet ik nog niet') regels.push(`Afwerking: ${afw.toLowerCase()}.`);
    else regels.push('Afwerking: graag uw advies.');
    if (d.get('plinten')) regels.push('Graag ook nieuwe plinten.');
    if (plaats) regels.push(`Plaats: ${plaats}.`);
    regels.push('', 'Kunt u een offerte maken?');
    const tekst = regels.join('\n');
    uit.textContent = tekst;
    knop.href = `${site.wa}?text=${encodeURIComponent(tekst)}`;
  }
  f?.addEventListener('input', bouw);
  f?.addEventListener('change', bouw);
  f?.addEventListener('submit', (e) => e.preventDefault());
  bouw();

  // Openingstijden: vandaag markeren + nu open/gesloten (Nederlandse tijd).
  const nl = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const dag = nl.getDay();
  const uur = nl.getHours() + nl.getMinutes() / 60;
  const rij = document.querySelector<HTMLElement>(`[data-dag="${dag}"]`);
  if (rij) { rij.classList.add('font-bold', 'text-eik-licht'); rij.querySelector('dd')?.classList.replace('text-mist', 'text-eik-licht'); }
  const tijden: Record<number, [number, number] | null> = { 0: null, 1: [8, 17], 2: [8, 17], 3: [8, 17], 4: [8, 17], 5: [8, 17], 6: [8, 13] };
  const t = tijden[dag];
  const nu = document.querySelector('#nu-open');
  if (nu) nu.textContent = t && uur >= t[0] && uur < t[1] ? `Nu open tot ${t[1]}.00` : 'Nu gesloten';
</script>
