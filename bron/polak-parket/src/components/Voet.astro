---
import { site, tijden, url, waHoi } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
const kort = (t: (typeof tijden)[number]) => (t.open ? `${String(t.open[0]).padStart(2, '0')}.00 tot ${t.open[1]}.00` : 'Gesloten');
---
<footer class="bg-inkt pb-24 text-mist md:pb-0">
  <div class="bbb"></div>
  <div class="wrap grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-12 lg:py-20">
    <div class="lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Houten vloeren leggen, schuren, oliën en lakken. Uit {site.plaats}.</p>
      <div class="mt-6 flex gap-3">
        <a href={site.insta} class="grid h-11 w-11 place-items-center border border-lijn text-wit hover:border-eik hover:text-eik-licht" aria-label="Polak Parket op Instagram"><Icoon naam="insta" class="h-5 w-5" /></a>
        <a href={site.fb} class="grid h-11 w-11 place-items-center border border-lijn text-wit hover:border-eik hover:text-eik-licht" aria-label="Polak Parket op Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
      </div>
    </div>
    <div class="lg:col-span-3">
      <h2 class="font-sans text-sm font-bold uppercase tracking-[.16em] text-wit">Wat we doen</h2>
      <ul class="mt-5 space-y-2.5">
        <li>Parket leggen</li>
        <li>Visgraat en patroonvloeren</li>
        <li>Schuren, oliën of lakken</li>
        <li>Plinten en profielen</li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <h2 class="font-sans text-sm font-bold uppercase tracking-[.16em] text-wit">Contact</h2>
      <ul class="mt-5 space-y-2.5">
        <li><a href={site.telHref} class="num text-wit no-underline hover:text-eik-licht">{site.tel}</a></li>
        <li><a href={waHoi} class="text-wit no-underline hover:text-eik-licht">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="break-words text-wit no-underline hover:text-eik-licht">{site.mail}</a></li>
        <li>{site.regio}</li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <h2 class="font-sans text-sm font-bold uppercase tracking-[.16em] text-wit">Openingstijden</h2>
      <dl class="num mt-5 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1.5">
        {tijden.map((t) => (<><dt>{t.dag}</dt><dd class="text-wit/90">{kort(t)}</dd></>))}
      </dl>
    </div>
  </div>
  <div class="border-t border-lijn">
    <div class="wrap flex flex-col gap-3 py-6 text-[.9375rem] md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} {site.naam} · KvK {site.kvk} · <a href={url('privacy/')} class="link text-mist hover:text-wit">Privacy</a></p>
      <p>Alle foto's: eigen werk van Polak Parket.</p>
    </div>
  </div>
</footer>
