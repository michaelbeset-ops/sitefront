---
// Woordmerk naar hun logo: een chevron van twee eikenplanken boven POLAK, met PARKET tussen twee lijntjes.
import { url } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<a href={url('')} class={`flex items-center gap-3 text-wit no-underline ${cls}`}>
  <span class="sr-only">Polak Parket</span>
  <svg viewBox="0 0 48 30" class="h-8 w-12 flex-none md:h-9 md:w-14" aria-hidden="true">
    <defs>
      <linearGradient id="plank-l" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#b98149" /><stop offset="1" stop-color="#e2b884" /></linearGradient>
      <linearGradient id="plank-r" x1="1" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#9c6a38" /><stop offset="1" stop-color="#d6a46c" /></linearGradient>
    </defs>
    <path d="M24 0 0 20.5V30L24 9.5Z" fill="url(#plank-l)" />
    <path d="M24 0 48 20.5V30L24 9.5Z" fill="url(#plank-r)" />
    <path d="M24 9.5V0" stroke="#161513" stroke-width=".8" />
  </svg>
  <span class="flex flex-col leading-none" aria-hidden="true">
    <span class="font-kop text-[1.45rem] font-[650] tracking-[.24em] md:text-[1.6rem]">POLAK</span>
    <span class="mt-1.5 flex items-center gap-1.5 text-[.625rem] font-bold tracking-[.42em] text-wit/80"><span class="h-px w-3 bg-current"></span>PARKET<span class="-ml-1 h-px w-3 bg-current"></span></span>
  </span>
</a>
