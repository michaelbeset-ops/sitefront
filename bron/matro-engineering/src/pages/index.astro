---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Voet from '../components/Voet.astro';
import { site, url, vraagMail } from '../data/site';
import portaal from '../assets/schets-portaal.jpg';
import transport from '../assets/schets-transport.jpg';
import zwenkkraan from '../assets/tekening-zwenkkraan.jpg';
import slijptafel from '../assets/slijptafel-render.jpg';
import slijptekening from '../assets/slijptafel-tekening.jpg';
import machine from '../assets/machine-render.jpg';

const tel = `<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>`;

const werk = [
  {
    id: 'A', titel: 'Conceptontwerp',
    tekst: 'Voor elk probleem, groot of klein, is een oplossing. Die vinden wij en vertalen wij in een conceptontwerp: praktisch, economisch en haalbaar.',
    klein: 'Creatief brainstormen, schetsen, afwegen en kiezen.',
    beeld: transport, alt: 'Handschets van Matro: een transportband met kantelstation, ingekleurd met marker.', breed: true,
  },
  {
    id: 'B', titel: 'Rekenen en tekenen',
    tekst: 'Het ouderwetse vakwerk. Wij berekenen de sterkte van constructies, hijs- en hefgereedschappen, (druk)tanks en machineonderdelen, volgens geldende normen en richtlijnen.',
    klein: 'Autodesk Inventor en AutoCAD; ook step en iges.',
    beeld: zwenkkraan, alt: 'Werktekening van Matro van een zwenkkraan, WLL 230 kg.', breed: false,
  },
  {
    id: 'C', titel: 'Productontwikkeling',
    tekst: 'Toe aan een herontwerp, doorontwikkeling, of heeft u alleen een idee? Wij helpen met ervaring, een frisse blik en kennis van productiemethoden.',
    klein: 'Van werktekening tot prototype.',
    beeld: slijptafel, alt: '3D-render van een slijptafel, ontwikkeld door Matro.', breed: false, extra: slijptekening,
  },
  {
    id: 'D', titel: 'Machinebouw',
    tekst: 'Wij bouwen zelf onze machines: meestal prototypes en unieke, klantspecifieke machines, of een upgrade van een bestaande machine.',
    klein: 'Samen met vaste toeleveranciers en onze vaste softwareprogrammeur.',
    beeld: machine, alt: '3D-render van een machine van Matro, met een figuur op ware grootte ernaast.', breed: true,
  },
];
---
<Base title="Matro Engineering | Machinebouw, berekenen en tekenen | Nieuw-Vennep" description="Sinds 2000 bedenkt, tekent, berekent en bouwt Matro Engineering machines, apparaten, producten en constructies voor alle takken van de industrie. Pondweg 11F, Nieuw-Vennep.">
  <!-- Eerste scherm: één tekenvel met coördinaten langs de rand. -->
  <div class="px-2.5 pb-2.5 pt-2.5 md:px-6 md:pb-6 md:pt-6 lg:px-10 lg:pb-10 lg:pt-9">
    <div class="blad flex flex-col lg:min-h-[calc(100dvh-5.5rem)]">
      <div class="coord coord-boven" aria-hidden="true">{[1,2,3,4,5,6,7,8].map((n) => <span>{n}</span>)}</div>
      <div class="coord coord-links" aria-hidden="true">{['A','B','C','D'].map((n) => <span>{n}</span>)}</div>

      <header class="flex h-16 items-center justify-between gap-4 border-b border-inkt px-4 md:h-[4.5rem] md:px-7">
        <a href={url('')} class="text-[.82rem] text-inkt no-underline md:text-[.95rem]" aria-label={`${site.naam}, naar de homepage`}><Logo /></a>
        <nav aria-label="Hoofdmenu" class="hidden lg:block">
          <ul class="flex gap-10 text-[1rem]">
            <li><a href="#werk" class="no-underline transition-colors hover:text-cyaan-diep">Wat wij doen</a></li>
            <li><a href="#contact" class="no-underline transition-colors hover:text-cyaan-diep">Contact</a></li>
          </ul>
        </nav>
        <a href={site.telHref} class="mono inline-flex items-center gap-2 border border-inkt px-3 py-2 !text-[.78rem] no-underline transition-colors hover:bg-inkt hover:text-wit md:px-4"><Fragment set:html={tel} /><span class="max-[379px]:sr-only">{site.tel}</span><span class="sr-only"> bellen</span></a>
      </header>

      <main id="inhoud" class="flex flex-1 flex-col">
        <section class="grid flex-1 lg:grid-cols-12" aria-labelledby="kop">
          <div class="flex flex-col px-5 pb-9 pt-9 md:px-10 md:pt-14 lg:col-span-6 lg:border-r lg:border-inkt lg:px-14 lg:pb-12 lg:pt-[4.5rem]">
            <h1 id="kop" class="text-[clamp(2.9rem,6.4vw,5.9rem)]">Van schets<br />tot <span class="marker">machine</span>.</h1>
            <p class="mt-7 max-w-[34rem] text-[1.12rem] leading-[1.55] text-potlood md:mt-9 md:text-[1.3rem]">
              Sinds 2000 bedenken, tekenen, berekenen en bouwen wij machines, apparaten, producten en constructies. In een klein team, voor alle takken van de industrie.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5 md:mt-10">
              <a href={site.telHref} class="knop">Bel {site.tel}</a>
              <a href={vraagMail} class="lijn text-[1.05rem]">Mail uw vraagstuk</a>
            </div>
            <p class="mono mt-auto hidden pt-12 text-potlood lg:block">{site.straat}, {site.plaats}</p>
          </div>

          <figure class="relative flex flex-col border-t border-inkt bg-wit lg:col-span-6 lg:border-t-0">
            <div class="flex flex-1 items-center justify-center px-3 pb-3 pt-4 md:px-10 md:pt-10 lg:px-10 lg:pb-[7.5rem] lg:pt-10">
              <Image src={portaal} alt="Handschets van Matro: een portaalconstructie met loopkat, met maten en materialen in de kantlijn." widths={[390, 700]} sizes="(min-width: 1024px) 700px, 100vw" format="webp" quality={78} loading="eager" fetchpriority="high" class="block h-auto w-full max-w-[700px] mix-blend-multiply" />
            </div>
            <figcaption class="sr-only">Conceptontwerp, handschets van Matro Engineering.</figcaption>
            <dl class="titel grid-cols-[1.1fr_1fr] border-x-0 border-b-0 lg:absolute lg:bottom-0 lg:right-0 lg:w-[30rem] lg:grid-cols-[1.2fr_1fr_.7fr] lg:border-b-0 lg:border-r-0" aria-label="Titelhoek">
              <div class="col-span-2 border-b lg:col-span-1 lg:row-span-2 lg:border-b-0 lg:border-r">
                <dt>Getekend door</dt>
                <dd class="pt-1 text-[.8rem]"><Logo /></dd>
              </div>
              <div class="border-b border-r lg:border-r">
                <dt>Onderdeel</dt><dd>Conceptontwerp</dd>
              </div>
              <div class="border-b">
                <dt>Sinds</dt><dd class="tabular-nums">2000</dd>
              </div>
              <div class="border-r">
                <dt>Werkplaats</dt><dd>Nieuw-Vennep</dd>
              </div>
              <div>
                <dt>Blad</dt><dd class="tabular-nums">1 / 4</dd>
              </div>
            </dl>
          </figure>
        </section>
      </main>
    </div>
  </div>

  <!-- Wat wij doen: vier bladen, A tot en met D, met hun eigen schetsen, tekeningen en renders. -->
  <section id="werk" class="wrap pb-10 pt-16 md:pt-24" aria-labelledby="werk-kop">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <h2 id="werk-kop" class="text-[clamp(2.2rem,4.4vw,4rem)] md:col-span-7">Bedenken, tekenen, berekenen en bouwen.</h2>
      <p class="max-w-md text-lg text-potlood md:col-span-5 md:justify-self-end">Werktuigbouwkunde in de breedste zin. Een moeilijk probleem splitsen wij op in kleinere deelproblemen, elk met een eigen oplossing.</p>
    </div>

    <ol class="mt-14 border-t border-inkt md:mt-20">
      {werk.map((w, i) => (
        <li class="grid grid-cols-[minmax(0,1fr)] gap-6 border-b border-inkt py-10 md:grid-cols-12 md:gap-8 md:py-14">
          <div class="flex min-w-0 items-start gap-4 md:col-span-5 md:gap-5 lg:col-span-4">
            <span class="mono grid h-9 w-9 shrink-0 place-items-center border border-inkt !text-[.8rem]" aria-hidden="true">{w.id}</span>
            <div>
              <h3 class="text-[clamp(1.5rem,2.2vw,2.3rem)] [overflow-wrap:anywhere]">{w.titel}</h3>
              <p class="mt-4 max-w-md text-[1.08rem] text-inkt/90">{w.tekst}</p>
              <p class="mono mt-5 text-potlood">{w.klein}</p>
            </div>
          </div>
          <div class={`md:col-span-7 lg:col-span-8 ${w.breed ? '' : 'lg:pl-[16%]'}`}>
            <div class={`grid gap-3 ${w.extra ? 'sm:grid-cols-2' : 'max-w-[46rem]'}`}>
              <div class="border border-raster bg-wit p-3 md:p-5">
                <Image src={w.beeld} alt={w.alt} widths={[400, 700]} sizes="(min-width: 768px) 55vw, 100vw" format="webp" quality={72} class="block h-auto w-full mix-blend-multiply" />
              </div>
              {w.extra && (
                <div class="border border-raster bg-wit p-3 md:p-5">
                  <Image src={w.extra} alt="Samenstellingstekening van de slijptafel, met stuklijst in de titelhoek." widths={[400, 700]} sizes="(min-width: 768px) 30vw, 100vw" format="webp" quality={72} class="block h-auto w-full" />
                </div>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Contact: de titelhoek in het groot. -->
  <section id="contact" class="wrap pb-20 pt-10 md:pb-28" aria-labelledby="contact-kop">
    <div class="grid border border-inkt bg-wit md:grid-cols-12">
      <div class="p-6 md:col-span-7 md:border-r md:border-inkt md:p-12">
        <h2 id="contact-kop" class="text-[clamp(2rem,3.6vw,3.4rem)]">Benieuwd wat Matro voor u kan betekenen?</h2>
        <p class="mt-5 max-w-lg text-lg text-potlood">Stuur een schets, een foto van de bestaande machine of alleen het probleem. Bellen kan natuurlijk ook.</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-5">
          <a href={site.telHref} class="knop">Bel {site.tel}</a>
          <a href={vraagMail} class="lijn text-[1.05rem]">Mail uw vraagstuk</a>
        </div>
      </div>
      <dl class="titel border-0 border-t border-inkt md:col-span-5 md:border-t-0">
        <div class="border-b"><dt>Adres</dt><dd>{site.straat}<br />{site.postcode} {site.plaats}</dd></div>
        <div class="border-b"><dt>Telefoon</dt><dd><a href={site.telHref} class="lijn tabular-nums">{site.tel}</a></dd></div>
        <div class="border-b"><dt>E-mail</dt><dd><a href={vraagMail} class="lijn break-all">{site.mail}</a></dd></div>
        <div><dt>Route</dt><dd><a href={site.maps} class="lijn">Open in Google Maps</a></dd></div>
      </dl>
    </div>
  </section>

  <Voet />
</Base>
