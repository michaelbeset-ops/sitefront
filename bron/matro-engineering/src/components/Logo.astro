---
// Hun logo nagetekend: de zware M met drie balkjes (zwart, cyaan, zwart) en de drie woorden ernaast.
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
const ink = licht ? '#ffffff' : '#0d1014';
---
<span class={`inline-flex items-center gap-[.55em] leading-none ${cls}`}>
  <svg viewBox="0 0 92 44" class="h-[2.35em] w-auto shrink-0" aria-hidden="true">
    <path fill={ink} d="M0 44V0h13.5L30 25.5 46.5 0H60v44H48.5V17.5L33.2 41h-6.4L11.5 17.5V44Z" />
    <rect x="64" y="1" width="28" height="7" fill={ink} />
    <rect x="64" y="18.5" width="28" height="7" fill="#00b5ec" />
    <rect x="64" y="36" width="28" height="7" fill={ink} />
  </svg>
  <span class="flex flex-col justify-between self-stretch py-[.02em] text-[.74em] font-medium uppercase tracking-[.04em]">
    <span>Matro</span>
    <span class={licht ? 'text-cyaan' : 'text-cyaan-diep'}>Engineering</span>
    <span>Machinebouw</span>
  </span>
</span>
