---
import Logo from './Logo.astro';
import { site, url } from '../data/site';
---
<footer class="bg-inkt text-wit">
  <div class="wrap grid gap-10 pb-10 pt-14 md:grid-cols-12">
    <div class="md:col-span-5"><span class="text-[1rem]"><Logo licht /></span></div>
    <p class="md:col-span-4">{site.naam}<br />{site.straat}, {site.postcode} {site.plaats}<br /><a href={site.telHref} class="lijn tabular-nums">{site.tel}</a></p>
    <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="lijn">Privacyverklaring</a><br /><span class="mono text-raster">KvK [[AANLEVEREN: KvK-nummer]]</span></p>
  </div>
  {site.voorstel && <p class="wrap border-t border-white/20 pb-8 pt-6 text-sm text-raster">Schetsen, tekeningen en renders van uw eigen website, ter illustratie.</p>}
</footer>
