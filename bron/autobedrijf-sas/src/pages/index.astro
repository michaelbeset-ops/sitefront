---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import Foto from '../components/Foto.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden } from '../data/site';
import hero from '../assets/hero.jpg';
import motor from '../assets/motor.jpg';
import wiel from '../assets/wiel.jpg';
import werkplaats from '../assets/werkplaats.jpg';
---
<Base
  title="Autobedrijf SAS | Garage in Werkendam, ook op zaterdag open"
  description="Autobedrijf SAS aan de Velsenstraat 10C in Werkendam. Open maandag t/m vrijdag 09:00 tot 17:00 en zaterdag 09:00 tot 15:00. Stuur een WhatsApp of bel 06 24 27 06 77."
>
  <Chrome deel="kop" />
  <main id="inhoud">
    <!-- Hero: grafiet vlak met tekst, foto ernaast (desktop) of eronder (mobiel). Geen tekst op de foto. -->
    <section class="op-donker bg-ink text-white">
      <div class="lg:grid lg:grid-cols-2">
        <div class="wrap py-10 sm:py-14 lg:mr-0 lg:max-w-[37rem] lg:py-24 lg:pr-12">
          <p class="label text-lime">Velsenstraat 10C, Werkendam</p>
          <h1 class="mt-4 text-4xl">Autobedrijf in Werkendam</h1>
          <p class="mt-5 max-w-md text-lg text-white/85">Is er iets met uw auto? Stuur een WhatsApp met uw kenteken en wat er aan de hand is, of bel even. Ook op zaterdag open.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={site.waAfspraak} class="btn btn-signal text-lg"><Icoon naam="app" />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line"><Icoon naam="tel" /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
          <dl class="mt-10 grid grid-cols-2 border-t border-line-dark pt-5 text-sm">
            <div class="pr-4">
              <dt class="label text-white/70">Vandaag</dt>
              <dd class="mt-1 flex items-center gap-2 font-display text-lg font-bold">
                <span class="inline-block size-2.5 shrink-0 rounded-full bg-lime" aria-hidden="true" data-lamp></span>
                <span data-vandaag class="tabular-nums">Ma t/m za open</span>
              </dd>
            </div>
            <div class="border-l border-line-dark pl-4">
              <dt class="label text-white/70">Google</dt>
              <dd class="mt-1 font-display text-lg font-bold"><span class="text-lime">{site.google.score}</span> <span class="text-sm font-medium text-white/80">uit 5, {site.google.aantal} reviews</span></dd>
            </div>
          </dl>
        </div>
        <div class="aspect-[16/10] overflow-hidden lg:aspect-auto lg:min-h-[34rem]">
          <Foto src={hero} alt="Monteur in een lichte werkplaats buigt zich over de motor van een auto met open motorkap, naast een hefbrug" hero sizes="(min-width: 1024px) 50vw, 100vw" class="object-[60%_50%]" />
        </div>
      </div>
    </section>

    <!-- Diensten: een grote tegel en twee kleinere, asymmetrisch. Details komen van de klant. -->
    <section id="diensten" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-4 lg:grid-cols-12 lg:items-end">
        <h2 class="text-3xl lg:col-span-7">Waarvoor u bij ons terechtkunt</h2>
        <p class="aanleveren lg:col-span-5">[[AANLEVEREN: welke werkzaamheden u doet, of u APK keurt, welke merken, en of u occasions verkoopt]]</p>
      </div>
      <div class="mt-10 grid gap-4 lg:grid-cols-12">
        <article class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-line lg:col-span-7 lg:row-span-2 lg:flex lg:flex-col">
          <div class="aspect-[16/9] overflow-hidden lg:aspect-auto lg:flex-1"><Foto src={motor} alt="Twee handen in een motorruimte, een ervan houdt een ringsleutel vast" sizes="(min-width: 1024px) 680px, 100vw" /></div>
          <div class="p-6 md:p-8">
            <p class="label text-signal-deep">01</p>
            <h3 class="mt-2 text-2xl">Onderhoud en reparatie</h3>
            <p class="aanleveren mt-3">[[AANLEVEREN: wat valt hieronder, bijvoorbeeld soorten onderhoud en reparaties]]</p>
          </div>
        </article>
        <article class="grid overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-line sm:grid-cols-5 lg:col-span-5">
          <div class="aspect-[21/9] overflow-hidden sm:col-span-2 sm:aspect-auto"><Foto src={wiel} alt="Handen met een slagmoersleutel bij een lichtmetalen velg" sizes="(min-width: 1024px) 190px, (min-width: 640px) 40vw, 100vw" class="object-[20%_100%] sm:object-[0%_60%]" /></div>
          <div class="p-6 sm:col-span-3">
            <p class="label text-signal-deep">02</p>
            <h3 class="mt-2 text-xl">Ook op zaterdag</h3>
            <p class="mt-2 text-ink-soft">Zaterdag open van 09:00 tot 15:00 uur.</p>
          </div>
        </article>
        <article class="op-donker flex flex-col justify-between gap-8 rounded-xl bg-ink p-6 text-white lg:col-span-5">
          <div>
            <p class="label text-lime">03</p>
            <h3 class="mt-2 text-xl">Iets anders aan de hand?</h3>
          </div>
          <p class="border-t border-line-dark pt-5"><a href={site.waAfspraak} class="font-semibold text-lime underline underline-offset-4">Stuur een WhatsApp</a> met uw kenteken, of bel <a href={site.telHref} class="whitespace-nowrap font-semibold underline underline-offset-4">{site.tel}</a>.</p>
        </article>
      </div>
    </section>

    <!-- Werkwijze: afspraak via WhatsApp in twee stappen, als genummerde lijst. -->
    <section id="afspraak" class="op-donker scroll-mt-20 bg-ink py-16 text-white lg:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-lime">Afspraak maken</p>
          <h2 class="mt-3 text-3xl">Afspraak via WhatsApp</h2>
          <p class="mt-5 text-lg text-white/85">Stuur een berichtje met twee dingen erin. Dan is meteen duidelijk om welke auto het gaat en waar het om draait.</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <ol class="divide-y divide-line-dark border-y border-line-dark">
            <li class="grid grid-cols-[3.5rem_1fr] gap-2 py-6">
              <span class="font-display text-3xl font-black italic text-lime" aria-hidden="true">1</span>
              <div><h3 class="text-xl">Stuur uw kenteken</h3><p class="mt-1 text-white/80">Het kenteken zegt meteen om welke auto het gaat.</p></div>
            </li>
            <li class="grid grid-cols-[3.5rem_1fr] gap-2 py-6">
              <span class="font-display text-3xl font-black italic text-lime" aria-hidden="true">2</span>
              <div><h3 class="text-xl">Vertel wat er aan de hand is</h3><p class="mt-1 text-white/80">Een geluid, een lampje op het dashboard, of gewoon tijd voor een beurt. Een foto meesturen mag ook.</p></div>
            </li>
          </ol>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={site.waAfspraak} class="btn btn-signal text-lg"><Icoon naam="app" />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line"><Icoon naam="tel" /><span>Bel <span class="whitespace-nowrap tabular-nums">{site.tel}</span></span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- Openingstijden groot, met vandaag uitgelicht; ernaast route en toegankelijkheid. -->
    <section id="tijden" class="wrap scroll-mt-20 py-16 lg:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Openingstijden</h2>
          <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-signal px-4 py-1.5 font-display text-sm font-bold text-white">Ook op zaterdag open, <span class="whitespace-nowrap tabular-nums">09:00 tot 15:00</span></p>
          <table class="mt-8 w-full text-lg">
            <caption class="sr-only">Openingstijden per dag</caption>
            <tbody class="divide-y divide-line border-y border-line">
              {tijden.map((t) => (
                <tr data-dag={t.dag} class={t.dag === 6 ? 'font-semibold' : ''}>
                  <th scope="row" class="py-3 pr-4 text-left font-display font-semibold">{t.naam}</th>
                  <td class="py-3 text-right whitespace-nowrap tabular-nums">{t.open ? `${t.open} tot ${t.dicht}` : <span class="text-ink-soft">Gesloten</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <div class="aspect-[4/3] overflow-hidden rounded-xl"><Foto src={werkplaats} alt="Werkplaats met een werkbank vol gereedschap, een lasapparaat en twee losse banden, een monteur aan het werk" sizes="(min-width: 1024px) 430px, 100vw" /></div>
          <h3 class="mt-8 text-2xl">Zo vindt u ons</h3>
          <address class="mt-3 text-lg not-italic">{site.straat}<br />{site.postcode} {site.plaats}</address>
          <p class="mt-3 text-ink-soft">Rolstoeltoegankelijke ingang en parkeerplaats.</p>
          <a href={site.maps} rel="noopener" class="btn btn-line mt-6"><Icoon naam="pin" />Route plannen</a>
        </div>
      </div>
    </section>

    <section id="contact" class="op-donker scroll-mt-20 bg-ink-2 py-16 text-white lg:py-20">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <h2 class="text-3xl">Contact</h2>
          <p class="mt-6 label text-white/70">Mobiel en WhatsApp</p>
          <a href={site.telHref} class="mt-1 inline-block font-display text-3xl font-extrabold whitespace-nowrap tabular-nums underline decoration-lime decoration-2 underline-offset-8">{site.tel}</a>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={site.wa} class="btn btn-signal"><Icoon naam="app" />Stuur een WhatsApp</a>
            <a href={site.telHref} class="btn btn-line"><Icoon naam="tel" />Bellen</a>
          </div>
        </div>
        <dl class="grid gap-5 lg:col-span-5 lg:col-start-8">
          <div><dt class="label text-white/70">Adres</dt><dd class="mt-1">{site.naam}, {site.straat}, {site.postcode} {site.plaats}</dd></div>
          <div><dt class="label text-white/70">E-mail</dt><dd class="aanleveren mt-1">[[AANLEVEREN: e-mailadres]]</dd></div>
          <div><dt class="label text-white/70">Open</dt><dd class="mt-1">Ma t/m vr <span class="whitespace-nowrap tabular-nums">09:00 tot 17:00</span>, za <span class="whitespace-nowrap tabular-nums">09:00 tot 15:00</span></dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Chrome deel="voet" />
  <script is:inline define:vars={{ tijden }}>
    // Vandaag: status in de hero en de rij in de tabel uitlichten.
    const nu = new Date();
    const d = nu.getDay();
    const t = tijden.find((x) => x.dag === d);
    const el = document.querySelector('[data-vandaag]');
    const lamp = document.querySelector('[data-lamp]');
    if (el && t) {
      const hm = nu.toTimeString().slice(0, 5);
      if (!t.open) { el.textContent = 'Gesloten'; }
      else if (hm < t.open) { el.textContent = `Open vanaf ${t.open}`; }
      else if (hm < t.dicht) { el.textContent = `Open tot ${t.dicht}`; }
      else { el.textContent = 'Nu gesloten'; }
      if (lamp && (!t.open || hm >= t.dicht)) lamp.style.background = '#ffffff66';
    }
    const rij = document.querySelector(`[data-dag="${d}"]`);
    if (rij) { rij.classList.add('bg-white', 'font-semibold'); rij.firstElementChild.insertAdjacentHTML('beforeend', ' <span class="label text-signal-deep">vandaag</span>'); }
  </script>
</Base>
