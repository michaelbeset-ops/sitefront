---
import { getImage } from 'astro:assets';
import logo from '../assets/logo-wit.png';
import { url } from '../data/site';
// Hun eigen logo (Facebook-profielfoto), wit uitgesneden.
const img = await getImage({ src: logo, width: 300, format: 'png' });
---
<a href={url('')} class="merk" aria-label="Kaffee de Bonnefooi, naar de homepage">
  <img src={img.src} width="150" height="87" alt="Kaffee de Bonnefooi Dinteloord, since 1996" />
</a>
