---
import { site, url, tijden, waHoi } from '../data/site';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const jaar = new Date().getFullYear();
---
<footer class="border-t border-lijn-licht bg-asfalt text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 text-licht lg:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs text-licht-zacht">Café met podium aan de Stoofdijk in Dinteloord. Sinds 1996, and still rockin'.</p>
      <p class="mt-5 flex items-center gap-2 text-sm"><Icoon naam="g" class="h-4 w-4" /><span class="num">{site.google.score} op Google · {site.google.aantal} reviews</span></p>
      <p class="mt-5">
        <a href={site.facebook} class="inline-grid h-10 w-10 place-items-center rounded-sm bg-asfalt-3 text-licht transition-colors hover:bg-rood" aria-label="Kaffee de Bonnefooi op Facebook"><Icoon naam="fb" class="h-5 w-5" /></a>
      </p>
    </div>
    <div class="lg:col-span-2">
      <p class="font-bold text-licht">In de Bonnefooi</p>
      <ul class="mt-4 space-y-2">
        <li><a href={h('agenda')} class="no-underline transition-colors hover:text-rood-neon">Agenda en kaarten</a></li>
        <li><a href={h('cafe')} class="no-underline transition-colors hover:text-rood-neon">Het café</a></li>
        <li><a href={h('terras')} class="no-underline transition-colors hover:text-rood-neon">Terras</a></li>
        <li><a href={h('feest')} class="no-underline transition-colors hover:text-rood-neon">Besloten feest</a></li>
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-bold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline transition-colors hover:text-rood-neon">{site.tel}</a></li>
        <li><a href={waHoi} class="no-underline transition-colors hover:text-rood-neon">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="text-sm [overflow-wrap:anywhere] no-underline transition-colors hover:text-rood-neon">{site.mail}</a></li>
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
      </ul>
    </div>
    <div class="col-span-2 sm:col-span-1 lg:col-span-3">
      <p class="font-bold text-licht">Openingstijden</p>
      <table class="mt-4 w-full max-w-[16rem]">
        <caption class="sr-only">Openingstijden</caption>
        <tbody>
          {tijden.map((t) => (
            <tr data-dag={t.dag} class="data-[vandaag]:font-bold data-[vandaag]:text-licht">
              <th scope="row" class="py-0.5 pr-4 text-left font-normal">{t.naam}</th>
              <td class="num py-0.5 text-right">{t.open ? `${t.open} - ${t.dicht}` : 'Gesloten'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {jaar} {site.naam}, {site.plaats}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-rood-neon">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Foto’s van jullie Google-bedrijfsprofiel en eigen Facebookpagina. Agenda van Facebook en reviews letterlijk van Google (stand 5 oktober 2026).</p>}
  </div>
</footer>
