---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
---
<footer class="op-donker bg-roet text-rook">
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      <Merk />
      <p class="mt-6 max-w-xs">Pelletkachels, houtkachels, kookhaarden, binnen- en buitenhaarden. Showroom in Groot-Ammers, alleen op afspraak.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-as">Assortiment</p>
      <ul class="mt-4 space-y-1">
        <li>Pelletkachels</li><li>Houtkachels met cv</li><li>Kookhaarden</li><li>Binnenhaarden</li><li>Buitenhaarden en vuurschalen</li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <p class="font-semibold text-as">Contact</p>
      <p class="mt-4">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={site.telHref} class="link num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link">WhatsApp</a></p>
    </div>
    <div class="md:col-span-3">
      <p class="font-semibold text-as">Op afspraak</p>
      <ul class="num mt-4 space-y-1">
        <li class="flex justify-between gap-4"><span>Maandag t/m zaterdag</span><span class="whitespace-nowrap">10.00 - 20.00</span></li>
        <li class="flex justify-between gap-4"><span>Zondag</span><span>gesloten</span></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn py-7 text-xs">
    <p>© {jaar} {site.naam} · KvK {site.kvk}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-vlam">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Foto's van uw Google-bedrijfsprofiel. Teksten op basis van uw eigen website.</p>}
</footer>
