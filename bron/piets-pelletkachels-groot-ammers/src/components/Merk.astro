---
// Woordmerk naar hun logo: drie dunne vlammen (rood, oranje, geel) boven de naam. Nagetekend, geen kopie van het bestand.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = true, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex items-end gap-2.5 no-underline', licht ? 'text-as' : 'text-roet', cls]}>
  <svg viewBox="0 0 34 40" class="h-10 w-auto flex-none" fill="none" stroke-linecap="round" aria-hidden="true">
    <path d="M6 38c-4-6-3-13 2-19 1 4 3 6 5 7-1-8 2-16 9-23-1 7 1 12 4 16 1-3 3-5 5-6-1 6 2 12-1 25" stroke="#d6331a" stroke-width="2.4" />
    <path d="M11 38c-2-5-1-9 2-13 1 3 2 4 4 5 0-5 2-9 5-13 0 5 2 8 4 11 1 4 0 7-2 10" stroke="#f0611f" stroke-width="2.2" />
    <path d="M16 38c-1-3 0-6 2-8 .5 2 2 3 3 4 1 2 0 3-1 4" stroke="#f6b445" stroke-width="2" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="font-kop text-[1.75rem] uppercase tracking-[.02em]">Piet's<span class="sr-only"> </span></span>
    <span class:list={['mt-1 text-[.625rem] font-semibold uppercase tracking-[.2em]', licht ? 'text-rook' : 'text-grijs']}>pelletkachels</span>
  </span>
</a>
