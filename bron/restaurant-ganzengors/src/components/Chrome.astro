---
import { site, url } from '../data/site';
interface Props { deel: 'kop' | 'voet' }
const { deel } = Astro.props;
---
{deel === 'kop' ? (
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
    <div class="wrap flex h-16 items-center justify-between gap-4">
      <a href={url('')} class="whitespace-nowrap font-display text-xl leading-none text-ink no-underline sm:text-2xl"><span class="italic">'t</span> Ganzengors</a>
      <nav aria-label="Hoofdmenu" class="hidden lg:block">
        <ul class="flex gap-7 text-sm">
          <li><a href={url('#kaart')} class="no-underline transition-colors hover:text-wine">De kaart</a></li>
          <li><a href={url('#restaurant')} class="no-underline transition-colors hover:text-wine">Restaurant</a></li>
          <li><a href={url('#agenda')} class="no-underline transition-colors hover:text-wine">Agenda</a></li>
          <li><a href={url('#cursussen')} class="no-underline transition-colors hover:text-wine">Cursussen</a></li>
          <li><a href={url('#delvino')} class="no-underline transition-colors hover:text-wine">DelVino</a></li>
          <li><a href={url('#route')} class="no-underline transition-colors hover:text-wine">Route</a></li>
        </ul>
      </nav>
      <a href={url('#reserveren')} class="btn btn-wine shrink-0 !px-3.5 !py-2 text-sm sm:!px-4">Reserveren</a>
    </div>
  </header>
) : (
  <footer class="op-donker border-t border-line-dark bg-ink py-12 text-paper/80">
    <div class="wrap grid gap-8 text-sm md:grid-cols-12">
      <p class="md:col-span-5"><strong class="font-display text-xl font-medium text-paper">{site.naam}</strong><br />{site.straat}, {site.postcode} {site.plaats}<br />KvK <span class="text-paper/70">[[AANLEVEREN: KvK-nummer]]</span></p>
      <p class="md:col-span-4"><a href={site.telHref} class="num underline underline-offset-4">{site.tel}</a><br /><a href={`mailto:${site.mail}`} class="underline underline-offset-4 [overflow-wrap:anywhere]">{site.mail}</a></p>
      <p class="md:col-span-3 md:text-right"><a href={url('privacy/')} class="underline underline-offset-4">Privacyverklaring</a></p>
    </div>
    {site.voorstel && <p class="wrap mt-8 text-xs text-paper/70">Sfeerfoto's via Unsplash, ter illustratie. Bij oplevering vervangen we ze door eigen foto's.</p>}
  </footer>
)}
