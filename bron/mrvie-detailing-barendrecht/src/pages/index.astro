---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, waAfspraak, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import voor from '../assets/voor.jpg';
import na from '../assets/na.jpg';
import vie from '../assets/vie.jpg';
import bmw from '../assets/bmw.jpg';
import mercedes from '../assets/mercedes.jpg';
import schuim from '../assets/schuim.jpg';
import taycan from '../assets/taycan.jpg';
import handschoen from '../assets/washandschoen.jpg';

// Pakketten en vanaf-prijzen letterlijk van mrvie.nl (Wayback-archief 8 mei 2026).
const pakketten = [
  { id: 'wash', naam: 'Wash & Wax', kort: 'Wash & Wax', prijs: '49' },
  { id: 'combi', naam: 'Exterieur + interieur combi', kort: 'Combi', prijs: '79' },
  { id: 'full', naam: 'Full Detail', kort: 'Full Detail', prijs: '250' },
];
const W = 'wash', C = 'combi', F = 'full';
const groepen: [string, [string, string[]][]][] = [
  ['Exterieur', [
    ['Wielkasten reinigen', [W, C, F]],
    ['Velgen reinigen, banden zwart', [W, C, F]],
    ['Pre-wash met snow foam', [W, C, F]],
    ['Exterieur grondig handwassen', [W, C, F]],
    ['Volledig kleien', [F]],
    ['Deursponningen reinigen', [W, C, F]],
    ['Ramen reinigen', [W, C, F]],
    ['Volledig polijsten', [F]],
    ['Waxlaag aanbrengen', [W, C, F]],
    ['Quartz coating aanbrengen', [F]],
  ]],
  ['Interieur', [
    ['Stofzuigen, inclusief kofferbak', [C, F]],
    ['Dashboard, console en deurpanelen reinigen', [C, F]],
    ['Diepreiniging stuurwiel, matterend resultaat', [C, F]],
    ['Diepreiniging stoelen, indien nodig', [F]],
    ['Ramen binnenkant', [C, F]],
  ]],
];
const waPakket = (naam: string) => waMet(`Hoi Vie, ik wil graag een afspraak voor het pakket ${naam}.`);

const werk = [
  { src: bmw, alt: 'Zwarte BMW 1-serie, glanzend na de behandeling, op een lichte oprit' },
  { src: taycan, alt: 'Vie aan het werk bij een zwarte Porsche Taycan met rode remklauwen' },
  { src: schuim, alt: 'Een auto helemaal in de snow foam op het bedrijventerrein' },
  { src: mercedes, alt: 'De glanzende zwarte motorkap van een Mercedes in de zon' },
  { src: handschoen, alt: 'Een washandschoen vol schuim boven een emmer' },
];
---
<Base title={`${site.naam} | Auto detailing in Barendrecht`} description="Handwas, kleien, polijsten en coating op Bedrijventerrein Dierenstein in Barendrecht. Wash & Wax vanaf € 49, Full Detail vanaf € 250. Afspraak via WhatsApp.">
  <Kop />
  <main id="inhoud">

    <!-- Eerste scherm: de auto komt uit het donker -->
    <section class="relative isolate flex min-h-[100svh] overflow-hidden bg-nacht" aria-labelledby="t-hero">
      <div class="hero-beeld absolute inset-0 -z-10 md:left-auto md:w-[70%]">
        <Image src={hero} alt="" widths={[640, 960, 1400, 2000]} sizes="(min-width: 768px) 70vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[64%_50%] md:object-[70%_50%]" />
      </div>
      <div class="absolute inset-0 -z-10 bg-nacht/60 md:hidden" aria-hidden="true"></div>

      <div class="wrap relative flex flex-col justify-end pb-10 pt-32 md:justify-center md:pb-24 md:pt-40">
        <h1 id="t-hero" class="max-w-[11ch] text-3xl">Een schone auto vertelt je veel.</h1>
        <p class="mt-8 max-w-[25rem] text-licht/85">Detailing op Bedrijventerrein Dierenstein in Barendrecht. Van een grondige handwas tot kleien, polijsten en coating.</p>
        <div class="mt-11 flex flex-wrap items-center gap-x-9 gap-y-5">
          <a href={waAfspraak} class="knop knop-vol">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            App voor een afspraak
          </a>
          <a href="#pakketten" class="lijn text-sm">Bekijk de pakketten</a>
        </div>
        <p class="ui mt-12 text-licht-zacht md:absolute md:bottom-10 md:right-10 md:mt-0 md:text-right">
          <span class="num block">Ma t/m vr 18:00–22:00</span>
          <span class="num mt-1 block">Za en zo 07:00–17:00</span>
        </p>
      </div>
    </section>

    <!-- Pakketten: één strak overzicht, kies en app -->
    <section id="pakketten" class="licht" aria-labelledby="t-pakketten">
      <div class="wrap grid gap-y-14 py-24 md:grid-cols-12 md:gap-x-8 lg:py-36">
        <div class="rijs md:col-span-12 lg:col-span-4 lg:sticky lg:top-28 lg:self-start">
          <h2 id="t-pakketten" class="text-2xl">Drie pakketten.</h2>
          <p class="mt-6 max-w-sm text-grijs">Kies er een en app hem door. Twijfelt u welk pakket bij uw auto past? Stuur dan gewoon een berichtje.</p>
        </div>

        <div class="rijs min-w-0 md:col-span-12 lg:col-span-8" data-pakketten style="--d:.06s">
          <table class="pakket w-full border-collapse text-left">
            <caption class="sr-only">Wat er in elk pakket zit</caption>
            <thead>
              <tr>
                <td></td>
                {pakketten.map((p) => (
                  <th scope="col" class="kol" data-kol={p.id}>
                    <button type="button" class="kies" data-kies={p.id} data-naam={p.naam} data-prijs={p.prijs} aria-pressed={p.id === 'combi' ? 'true' : 'false'}>
                      <span class="block text-xs leading-tight sm:text-base"><span class="sm:hidden">{p.kort}</span><span class="hidden sm:inline">{p.naam}</span></span>
                      <span class="num mt-2 block text-[0.75rem] text-grijs sm:text-xs">vanaf <span class="whitespace-nowrap">€ {p.prijs}</span></span>
                    </button>
                  </th>
                ))}
              </tr>
            </thead>
            {groepen.map(([groep, rijen]) => (
              <tbody>
                <tr><th scope="rowgroup" colspan="4" class="ui pb-3 pt-10 font-medium text-grijs">{groep}</th></tr>
                {rijen.map(([taak, in_]) => (
                  <tr class="border-t border-lijn">
                    <th scope="row" class="py-3.5 pr-3 font-normal">{taak}</th>
                    {pakketten.map((p) => (
                      <td class="kol" data-kol={p.id}>
                        {in_.includes(p.id)
                          ? <svg class="vink" viewBox="0 0 16 16" role="img" aria-label="Ja"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                          : <span class="leeg" role="img" aria-label="Nee"></span>}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))}
          </table>

          <div class="mt-12 flex flex-wrap items-center justify-between gap-x-8 gap-y-6 border-t border-inkt pt-8">
            <p aria-live="polite"><span class="text-grijs">Gekozen:</span> <span data-gekozen>Exterieur + interieur combi, vanaf € 79</span></p>
            <a href={waPakket('Exterieur + interieur combi')} class="knop knop-vol" data-pakket-knop>App dit pakket</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Voor en na: hun eigen collage, uit elkaar gehaald -->
    <section id="voor-na" class="bg-nacht" aria-labelledby="t-voor-na">
      <div class="wrap py-24 lg:py-36">
        <div class="rijs grid gap-y-6 md:grid-cols-12 md:items-end md:gap-x-8">
          <h2 id="t-voor-na" class="text-2xl md:col-span-7">Dezelfde motorkap.<br />Voor, en na.</h2>
          <p class="max-w-sm text-licht-zacht md:col-span-4 md:col-start-9">Op Google schrijven klanten dat de kleine krasjes allemaal weg waren, en noemen ze het werk vakkundig.</p>
        </div>
        <div class="mt-14 grid grid-cols-2 gap-2 md:mt-20 md:gap-3">
          <figure class="rijs">
            <Image src={voor} alt="Groene motorkap vóór de behandeling: dof, met vlekken en kalkresten" widths={[400, 776]} sizes="(min-width: 1312px) 640px, 50vw" class="aspect-square w-full object-cover" />
            <figcaption class="ui mt-4 text-licht-zacht">Voor</figcaption>
          </figure>
          <figure class="rijs" style="--d:.12s">
            <Image src={na} alt="Dezelfde groene motorkap erna: spiegelend, met de gevels en bomen erin weerspiegeld" widths={[400, 776]} sizes="(min-width: 1312px) 640px, 50vw" class="aspect-square w-full object-cover" />
            <figcaption class="ui mt-4 text-licht-zacht">Na</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Over Vie -->
    <section id="vie" class="licht" aria-labelledby="t-vie">
      <div class="wrap grid gap-y-12 py-24 md:grid-cols-12 md:items-center md:gap-x-8 lg:py-36">
        <figure class="rijs md:col-span-7">
          <Image src={vie} alt="Vie polijst met een machine de motorkap van een donkere auto, buiten op het bedrijventerrein" widths={[640, 1000, 1600]} sizes="(min-width: 1312px) 720px, (min-width: 768px) 56vw, 100vw" class="aspect-[16/10] w-full object-cover object-[40%_50%]" />
        </figure>
        <div class="rijs md:col-span-5 lg:col-start-8" style="--d:.08s">
          <h2 id="t-vie" class="text-2xl">Het begon met een auto die niet schoon terugkwam.</h2>
          <p class="mt-7 text-grijs">Vie bracht zijn eigen auto ooit naar een detailer en betaalde er flink voor. Bij het ophalen zaten er nog modder en zand op. Dat kon beter, vond hij.</p>
          <p class="mt-4 text-grijs">Sindsdien detailt hij zelf, en wil hij elke auto tot in het kleinste detail verzorgd teruggeven.</p>
          <p class="mt-9"><a href={waAfspraak} class="lijn text-sm">App Vie direct</a></p>
        </div>
      </div>
    </section>

    <!-- Werk -->
    <section class="bg-nacht" aria-labelledby="t-werk">
      <div class="wrap py-24 lg:py-36">
        <div class="rijs flex flex-wrap items-end justify-between gap-6">
          <h2 id="t-werk" class="text-2xl">Uit de praktijk.</h2>
          <a href={site.instagram} class="lijn text-sm">Meer op Instagram</a>
        </div>
        <ul class="mt-14 grid grid-cols-2 gap-2 md:mt-20 md:grid-cols-5 md:gap-3">
          {werk.map((f, i) => (
            <li class={`rijs ${i === 0 ? 'col-span-2 md:col-span-1' : ''}`} style={`--d:${i * 0.05}s`}>
              <Image src={f.src} alt={f.alt} widths={[320, 520]} sizes="(min-width: 768px) 20vw, 50vw" class={`w-full object-cover ${i === 0 ? 'aspect-[4/3] md:aspect-[4/5]' : 'aspect-[4/5]'}`} />
            </li>
          ))}
        </ul>
      </div>
    </section>

  </main>
  <Voet />
</Base>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-pakketten]');
  if (wrap) {
    const knop = wrap.querySelector<HTMLAnchorElement>('[data-pakket-knop]')!;
    const tekst = wrap.querySelector<HTMLElement>('[data-gekozen]')!;
    const basis = knop.href.split('?')[0];
    const kies = (b: HTMLButtonElement) => {
      wrap.querySelectorAll<HTMLButtonElement>('[data-kies]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      wrap.querySelectorAll<HTMLElement>('.kol').forEach((c) => c.classList.toggle('aan', c.dataset.kol === b.dataset.kies));
      tekst.textContent = `${b.dataset.naam}, vanaf € ${b.dataset.prijs}`;
      knop.href = basis + '?text=' + encodeURIComponent(`Hoi Vie, ik wil graag een afspraak voor het pakket ${b.dataset.naam}.`);
    };
    wrap.querySelectorAll<HTMLButtonElement>('[data-kies]').forEach((b) => {
      b.addEventListener('click', () => kies(b));
      if (b.getAttribute('aria-pressed') === 'true') kies(b);
    });
  }
</script>

<style>
  @media (min-width: 768px) {
    .hero-beeld { mask-image: linear-gradient(90deg, transparent 0, #000 45%); -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 45%); }
  }
  .pakket th[scope='row'] { font-size: var(--text-sm); line-height: 1.35; }
  .pakket .kol { width: 16%; text-align: center; vertical-align: middle; transition: background-color .35s var(--ease-zacht); }
  @media (min-width: 640px) { .pakket .kol { width: 17%; } }
  .pakket .kol:global(.aan) { background: #1112140a; }
  .pakket thead .kol { vertical-align: bottom; padding: 0 0 1.25rem; }
  .kies { width: 100%; padding: 1rem .15rem .25rem; text-align: center; cursor: pointer; border-bottom: 1px solid transparent; transition: border-color .35s var(--ease-zacht); }
  .kies[aria-pressed='true'] { border-bottom-color: var(--color-inkt); }
  .kies:hover { border-bottom-color: #11121466; }
  .kies[aria-pressed='true']:hover { border-bottom-color: var(--color-inkt); }
  .vink { width: 1rem; height: 1rem; margin-inline: auto; display: block; }
  .leeg { display: block; width: .6rem; height: 1px; margin-inline: auto; background: #11121440; }
</style>
