          <h2 id="t-route" class="mt-5 text-3xl">Na je werk, of in het weekend.</h2>
          <p class="mt-6 text-lg text-grijs">Op {site.terrein} in Barendrecht. Rolstoeltoegankelijke ingang en parkeerplaats.</p>
          <div class="kaart mt-10 p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Openingstijden</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Elke dag open</span></p>
            </div>
