---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, pakketten, chips, reviews, waAfspraak, waMet } from '../data/site';
import vie from '../assets/vie.jpg';
import voor from '../assets/voor.jpg';
import na from '../assets/na.jpg';
import zijVoor from '../assets/zij-voor.jpg';
import zijNa from '../assets/zij-na.jpg';
import antVoor from '../assets/antenne-voor.jpg';
import antNa from '../assets/antenne-na.jpg';
import mercedes from '../assets/mercedes.jpg';
import schuim from '../assets/schuim.jpg';
import taycan from '../assets/taycan.jpg';
import velgen from '../assets/velgen.jpg';
import foamDuo from '../assets/foam-duo.jpg';
import vieWassen from '../assets/vie-wassen.jpg';

const waPakket = (naam: string) => waMet(`Hoi Vie, ik wil graag een afspraak maken voor het pakket ${naam}.`);

const paren = [
  { id: 'kap', titel: 'Motorkap', voor, na, altV: 'Groene motorkap vóór de behandeling: dof, met vlekken en kalkresten', altN: 'Dezelfde groene motorkap erna: spiegelend, met de bomen en gevels erin', groot: true },
  { id: 'zij', titel: 'Zijkant en velg', voor: zijVoor, na: zijNa, altV: 'Zijkant van de groene sedan vóór de behandeling, met een doffe, vlekkerige lak', altN: 'Dezelfde zijkant erna, diepgroen en glanzend, de banden weer zwart' },
  { id: 'ant', titel: 'Achterscherm', voor: antVoor, na: antNa, altV: 'Achterscherm bij de antenne vóór de behandeling, met krassen en waas', altN: 'Hetzelfde achterscherm erna: de krassen weg, de omgeving spiegelt in de lak' },
];

const diensten = [
  { t: 'Handwas', d: 'Eerst een dikke laag schuim, dan grondig met de hand. Ook wielkasten en deursponningen.', src: schuim, alt: 'Een auto helemaal onder de snow foam op het bedrijventerrein', pos: '50% 50%' },
  { t: 'Velgen en banden', d: 'Velgen gereinigd, banden weer zwart. Bij elk pakket.', src: velgen, alt: 'Vie reinigt de velg van een rode Renault Clio', pos: '60% 60%' },
  { t: 'Polijsten en coating', d: 'Kleien, polijsten en een quartz coating bij de Full Detail. Klanten zien kleine krasjes verdwijnen.', src: mercedes, alt: 'De glanzende zwarte motorkap van een Mercedes in de zon', pos: '50% 35%' },
];

const stappen = [
  ['Stuur een appje', 'Zeg welk pakket je wilt en om welke auto het gaat. Twijfel je? Stuur een foto mee.'],
  ['Kies een moment', 'Doordeweeks ’s avonds of in het weekend overdag. Vie spreekt met je af wanneer het past.'],
  ['Vie gaat aan de slag', 'Snow foam, handwas en de rest van je pakket, tot in het kleinste detail.'],
  ['Rijden maar', 'Je haalt je auto weer schoon en glanzend op.'],
];

---
<Base title={`${site.naam} | Auto detailing in Barendrecht`} description="Handwas, kleien, polijsten en quartz coating op Bedrijventerrein Dierenstein in Barendrecht. Wash & Wax vanaf € 49, Full Detail vanaf € 250. 5,0 op Google. Afspraak via WhatsApp.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: Vie aan het polijsten -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht md:items-center" aria-labelledby="t-hero">
      <div class="absolute inset-0 -z-20 md:left-[30%]">
        <Image src={vie} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width: 768px) 70vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-[46%_40%] md:object-[44%_50%]" />
      </div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0d0e0c40_0%,#0d0e0cb3_45%,#0d0e0cf5_100%)] md:bg-[linear-gradient(90deg,#0d0e0c_0%,#0d0e0c_30%,#0d0e0ccc_46%,#0d0e0c26_75%,#0d0e0c00_100%)]" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 hidden h-40 bg-[linear-gradient(0deg,#0d0e0cd9,transparent)] md:block" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-24 pt-40 md:py-24 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Auto detailing in Barendrecht</p>
          <h1 id="t-hero" class="mt-6 text-hero">Een schone auto vertelt je <span class="text-groen">veel.</span></h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Van een grondige handwas tot kleien, polijsten en quartz coating. Op {site.terrein}, ook ’s avonds en in het weekend.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waAfspraak} class="knop knop-groen"><Icoon naam="wa" />Afspraak via WhatsApp</a>
            <a href="#pakketten" class="knop knop-rand op-foto">Bekijk de pakketten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 18.00 - 22.00, za en zo 07.00 - 17.00</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:block">
          <div class="ml-auto w-full max-w-[19rem] rounded-lg bg-nacht/70 p-6 ring-1 ring-licht/15 backdrop-blur-md">
            <p class="font-kop text-sm font-bold uppercase tracking-[.14em] text-groen">Pakketten</p>
            <ul class="mt-4 divide-y divide-licht/10">
              {pakketten.map((p) => (
                <li class="flex items-baseline justify-between gap-4 py-2.5"><span>{p.id === 'combi' ? 'Combi' : p.naam}</span><span class="num whitespace-nowrap text-licht-zacht">vanaf <b class="font-kop text-lg text-licht">€ {p.prijs}</b></span></li>
              ))}
            </ul>
            <a href={site.telHref} class="mt-4 flex items-center justify-between gap-3 border-t border-licht/10 pt-4 font-kop font-bold no-underline hover:text-groen"><span class="text-sm font-normal text-licht-zacht">Of bel Vie</span><span class="num">{site.tel}</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Wat Vie doet, in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#pakketten" class="shrink-0 rounded-md border border-lijn bg-papier px-4 py-2 text-sm font-medium no-underline transition-colors hover:border-inkt hover:bg-inkt hover:text-licht">{c}</a>)}
      </div>
    </section>

    <!-- 3. Pakketten -->
    <section id="pakketten" class="py-20 lg:py-24" aria-labelledby="t-pak">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Pakketten en prijzen</p>
            <h2 id="t-pak" class="mt-5 text-3xl">Drie pakketten. Kies er een en app hem door.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Elk pakket begint met snow foam en een grondige handwas. Twijfel je welk pakket bij je auto past? Stuur een foto via WhatsApp.</p>
        </div>
        <ul class="mt-12 grid gap-5 lg:mt-14 lg:grid-cols-3 lg:items-stretch">
          {pakketten.map((p, i) => {
            const top = p.id === 'combi';
            return (
              <li class={`rijs relative flex flex-col rounded-lg p-7 md:p-8 ${top ? 'donker bg-nacht text-licht shadow-md' : 'kaart'}`} style={`--d:${i * 0.06}s`}>
                {p.label && <p class="absolute -top-3 left-7 rounded-sm bg-groen px-2.5 py-1 font-kop text-xs font-bold uppercase tracking-[.12em] text-inkt md:left-8">{p.label}</p>}
                <h3 class="text-2xl">{p.naam}</h3>
                <p class={`mt-3 lg:min-h-[3.2em] ${top ? 'text-licht-zacht' : 'text-grijs'}`}>{p.zin}</p>
                <p class="mt-7 flex items-baseline gap-2"><span class={top ? 'text-licht-zacht' : 'text-grijs'}>vanaf</span><span class="font-kop text-[3.25rem] font-extrabold leading-none tracking-[-0.04em]">€ {p.prijs},-</span></p>
                <div class={`mt-7 flex-1 border-t pt-6 ${top ? 'border-lijn-licht' : 'border-lijn'}`}>
                  {(() => {
                    const acc = top ? 'text-groen' : 'text-groen-diep';
                    const kop = (t: string) => <p class={`font-kop text-xs font-bold uppercase tracking-[.14em] ${acc}`}>{t}</p>;
                    const lijst = (xs: string[]) => <ul class="mt-3 space-y-1 text-[.9375rem]">{xs.map((x) => <li class="flex gap-2.5"><Icoon naam="vink" class={`mt-1 h-4 w-4 shrink-0 ${acc}`} />{x}</li>)}</ul>;
                    if (p.id === 'wash') return <>{kop('Exterieur')}{lijst(p.exterieur)}</>;
                    if (p.id === 'combi') return <><p class="flex items-center gap-2.5 font-semibold"><Icoon naam="vink" class={`h-4 w-4 shrink-0 ${acc}`} />{p.basis}</p><div class="mt-5">{kop('Plus interieur')}</div>{lijst(p.interieur)}</>;
                    return <><p class="flex items-center gap-2.5 font-semibold"><Icoon naam="vink" class={`h-4 w-4 shrink-0 ${acc}`} />{p.basis}</p><div class="mt-5">{kop('Plus')}</div>{lijst(p.extra ?? [])}</>;
                  })()}
                </div>
                <a href={waPakket(p.naam)} class={`knop mt-8 w-full ${top ? 'knop-groen' : 'knop-inkt'}`}><Icoon naam="wa" class={top ? '' : 'text-groen'} />Kies {p.id === 'combi' ? 'de combi' : p.naam}</a>
              </li>
            );
          })}
        </ul>
        <p class="rijs mt-8 text-center text-sm text-grijs">Alle prijzen zijn vanaf-prijzen.</p>
      </div>
    </section>

    <!-- 5. Voor en na -->
    <section id="voor-na" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-vn">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Voor en na</p>
            <h2 id="t-vn" class="mt-5 text-3xl">Dezelfde auto. Zie het verschil zelf.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Een groene sedan bij Vie: dof en vlekkerig binnengekomen, diepgroen weer weg. Tik op Voor en Na.</p>
        </div>
        <div class="mt-12 grid gap-4 lg:mt-14 lg:grid-cols-12 lg:gap-5">
          {paren.map((p, i) => (
            <figure class={`rijs vn group relative overflow-hidden rounded-lg bg-nacht-2 ${p.groot ? 'lg:col-span-7 lg:row-span-2' : 'lg:col-span-5'}`} data-vn style={`--d:${i * 0.06}s`}>
              <div class={`relative ${p.groot ? 'aspect-square lg:aspect-auto lg:h-full lg:min-h-[30rem]' : 'aspect-[16/10]'}`}>
                <Image src={p.voor} alt={p.altV} widths={[480, 776]} sizes={p.groot ? '(min-width: 1024px) 680px, 92vw' : '(min-width: 1024px) 480px, 92vw'} class="absolute inset-0 h-full w-full object-cover" />
                <Image src={p.na} alt={p.altN} widths={[480, 776]} sizes={p.groot ? '(min-width: 1024px) 680px, 92vw' : '(min-width: 1024px) 480px, 92vw'} class="na absolute inset-0 h-full w-full object-cover" />
              </div>
              <figcaption class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 bg-[linear-gradient(0deg,#0d0e0ce6,transparent)] p-4 pt-16 sm:p-5 sm:pt-20">
                <span class="font-kop text-lg font-bold">{p.titel}</span>
                <span class="flex rounded-md bg-nacht/80 p-1 ring-1 ring-licht/15 backdrop-blur" role="group" aria-label={`${p.titel}: voor of na`}>
                  <button type="button" class="wissel" data-toon="voor" aria-pressed="false">Voor</button>
                  <button type="button" class="wissel" data-toon="na" aria-pressed="true">Na</button>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Wat Vie doet -->
    <section class="py-20 lg:py-24" aria-labelledby="t-wat">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Wat Vie doet</p>
            <h2 id="t-wat" class="mt-5 text-3xl">Van handwas tot quartz coating.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Geen wasstraat, maar handwerk. Dit zit er in de pakketten.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-14 lg:grid-cols-4 lg:gap-5">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${i * 0.06}s`}>
              <a href="#pakketten" class="kaart group flex h-full flex-col overflow-hidden no-underline transition-shadow duration-300 hover:shadow-md">
                <div class="overflow-hidden">
                  <Image src={b.src} alt={b.alt} widths={[400, 640]} sizes="(min-width: 1024px) 290px, 46vw" class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-[1.04] sm:aspect-[4/3]" style={`object-position:${b.pos}`} />
                </div>
                <div class="flex flex-1 items-start justify-between gap-4 p-4 sm:p-6">
                  <div>
                    <h3 class="text-[1.0625rem] hyphens-auto sm:text-xl">{b.t}</h3>
                    <p class="mt-1.5 text-sm text-grijs sm:mt-2 sm:text-base">{b.d}</p>
                  </div>
                                  </div>
              </a>
            </li>
          ))}
          <li class="rijs" style="--d:.18s">
            <div class="donker flex h-full flex-col justify-between gap-6 rounded-lg bg-nacht p-4 text-licht sm:p-7">
              <div>
                <span class="hidden h-12 w-12 place-items-center rounded-md bg-groen text-inkt sm:grid"><Icoon naam="glans" class="h-6 w-6" /></span>
                <h3 class="text-[1.0625rem] sm:mt-6 sm:text-xl">Ook binnen schoon?</h3>
                <p class="mt-2 text-sm text-licht-zacht sm:mt-3 sm:text-base">Stofzuigen tot in de kofferbak, dashboard en deurpanelen afnemen, het stuur diepreinigen. In de combi vanaf € 79.</p>
              </div>
              <a href={waPakket('Exterieur + interieur combi')} class="knop knop-groen knop-klein w-full whitespace-normal text-center"><Icoon naam="wa" />App voor de combi</a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- 7. Werkwijze -->
    <section class="border-t border-lijn bg-vlak py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo werkt het</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Van appje tot glanzende auto.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Een afspraak regel je via WhatsApp of telefoon, rechtstreeks met Vie.</p>
        </div>
        <ol class="mt-12 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:mt-14 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs stap kaart relative p-5 sm:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num font-kop text-[2.5rem] font-extrabold leading-none tracking-[-0.04em] text-inkt/15">0{i + 1}</p>
              <h3 class="mt-4 text-xl sm:mt-8">{t}</h3>
              <p class="mt-2 text-grijs sm:mt-3">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 8. Over Vie -->
    <section id="vie" class="donker bg-nacht text-licht" aria-labelledby="t-vie">
      <div class="grid lg:grid-cols-12">
        <div class="relative px-5 pt-16 md:px-10 lg:col-span-5 lg:py-20 lg:pl-[max(2.5rem,calc((100vw-78rem)/2+2.5rem))] lg:pr-0">
          <div class="relative mx-auto max-w-[32rem] pb-16 lg:pb-0">
            <Image src={taycan} alt="Vie aan het werk bij de velg van een zwarte Porsche Taycan" widths={[480, 640]} sizes="(min-width: 1024px) 512px, 90vw" class="aspect-[4/5] w-full rounded-lg object-cover object-[62%_50%]" />
            <figure class="absolute -bottom-0 right-0 w-[48%] rounded-lg bg-nacht p-1.5 lg:-bottom-10 lg:-right-8">
              <Image src={vieWassen} alt="Vie wast een auto met de hand, met een groene emmer ernaast" widths={[320, 480]} sizes="240px" class="aspect-[4/3] w-full rounded-md object-cover" />
            </figure>
            <p class="absolute left-4 top-4 rounded-sm bg-groen px-3 py-1.5 font-kop text-sm font-bold text-inkt">Vie, eigenaar</p>
          </div>
        </div>
        <div class="px-5 pb-20 pt-12 md:px-10 lg:col-span-7 lg:px-16 lg:py-20 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Vie</p>
          <h2 id="t-vie" class="mt-5 text-3xl">Het begon met een auto die niet schoon terugkwam.</h2>
          <p class="mt-6 text-lg text-licht-zacht">Vie bracht zijn eigen auto ooit naar een detailer en betaalde er flink voor. Bij het ophalen zaten er nog sporen van modder en zand op. Hij wist dat het beter kon.</p>
          <p class="mt-4 text-lg text-licht-zacht">Die teleurstelling werd de start van MrVie Detailing. Sindsdien wil hij elke auto tot in het kleinste detail verzorgd teruggeven.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-groen text-inkt"><Icoon naam="oog" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Tot in het kleinste detail</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Van de deursponningen tot de wielkasten.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-groen text-inkt"><Icoon naam="schild" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Kundig en vakkundig</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Zo omschrijven klanten het werk op Google.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-nacht-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-groen text-inkt"><Icoon naam="praat" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Rechtstreeks met Vie</h3><p class="mt-1 text-[.9375rem] text-licht-zacht">Je appt met degene die ook aan je auto werkt.</p></div>
            </li>
          </ul>
          <a href={waAfspraak} class="knop knop-groen mt-9"><Icoon naam="wa" />App Vie direct</a>
        </div>
      </div>
    </section>

    <!-- 10. Reviews -->
    <section id="reviews" class="border-t border-lijn bg-wit py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.maps} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="font-kop text-2xl font-extrabold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="mt-12 grid gap-4 md:grid-cols-3 md:gap-5 lg:mt-14">
          {reviews.map((r, i) => (
            <li class="rijs flex flex-col rounded-lg bg-papier p-6 ring-1 ring-lijn md:p-8" style={`--d:${i * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 font-kop text-[1.375rem] font-semibold leading-snug tracking-[-0.015em]">“{r.tekst}”</blockquote>
              <div class="mt-8 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-md bg-nacht font-kop font-bold text-groen" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 11. Openingstijden en locatie -->
