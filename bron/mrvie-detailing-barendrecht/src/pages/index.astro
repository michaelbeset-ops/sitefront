  .status-stip { width: .55rem; height: .55rem; border-radius: 999px; background: var(--color-licht-zacht); flex: none; }
  [data-open='true'] .status-stip { background: var(--color-groen); box-shadow: 0 0 0 4px #c6f04a40; }
  .status-pil { display: inline-flex; align-items: center; gap: .5rem; padding: .35rem .8rem; border-radius: var(--radius-sm); background: var(--color-vlak); }
  .status-pil[data-open='true'] .status-stip { background: var(--color-groen-diep); box-shadow: 0 0 0 4px #3d5c0026; }
  .tegel { transition: transform .9s var(--ease-zacht); }
  li:hover > .tegel { transform: scale(1.04); }
  .vn .na { transition: opacity .6s var(--ease-zacht); }
  .vn:global(.toon-voor) .na { opacity: 0; }
  .wissel { min-height: 2.25rem; padding: 0 .9rem; border-radius: .3rem; font-family: var(--font-kop); font-size: .875rem; font-weight: 700; color: var(--color-licht); cursor: pointer; transition: background-color .2s, color .2s; }
  .wissel:hover { background: #f5f4ef1a; }
  .wissel[aria-pressed='true'] { background: var(--color-groen); color: var(--color-inkt); }
  .stap::after { content: ''; position: absolute; left: 1.25rem; right: 1.25rem; top: 0; height: 3px; background: var(--color-groen); border-radius: 0 0 2px 2px; }
  @media (min-width: 640px) { .stap::after { left: 1.75rem; right: 1.75rem; } }
  .keuze > span { display: flex; align-items: center; gap: .75rem; min-height: 3.25rem; padding: .6rem 1rem; border-radius: var(--radius-md); border: 1.5px solid #0d0e0c26; background: #fff; font-size: .9375rem; cursor: pointer; transition: border-color .2s, background-color .2s; }
  .keuze > span:hover { border-color: #0d0e0c66; }
  .keuze input:checked + span { border-color: var(--color-inkt); background: var(--color-groen-zacht); box-shadow: inset 0 0 0 1px var(--color-inkt); }
  .keuze input:focus-visible + span { outline: 3px solid var(--color-groen-diep); outline-offset: 2px; }
  .veld { display: block; width: 100%; border-radius: var(--radius-md); border: 1.5px solid #0d0e0c33; background: #fff; padding: .7rem .9rem; font: inherit; color: var(--color-inkt); transition: border-color .2s; }
  .veld:hover { border-color: #0d0e0c66; }
  .veld:focus-visible { outline-offset: 1px; border-color: var(--color-inkt); }
  .veld::placeholder { color: #7a7c74; }
</style>
