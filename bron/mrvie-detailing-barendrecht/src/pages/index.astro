          <figure class="relative flex-1 overflow-hidden rounded-lg">
            <Image src={foamDuo} alt="Twee sportwagens onder de snow foam voor een bedrijfspand" widths={[640]} sizes="(min-width: 1248px) 700px, (min-width: 1024px) 56vw, 92vw" class="h-full min-h-[18rem] w-full object-cover object-[50%_60%]" />
          </figure>
          <div class="kaart flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-groen-diep" /><span><b class="font-semibold">{site.straat}</b><br /><span class="text-grijs">{site.postcode} {site.plaats}, {site.terrein}</span></span></p>
            <a href={site.maps} class="knop knop-inkt knop-klein shrink-0">Route plannen<Icoon naam="pijl" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 12. Contact: WhatsApp-bericht samenstellen -->
    <section id="contact" class="border-t border-lijn bg-vlak py-20 lg:py-24" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Afspraak maken</p>
          <h2 id="t-contact" class="mt-5 text-3xl">Plan je beurt.</h2>
          <p class="mt-6 text-lg text-grijs">Kies je pakket en wanneer het je uitkomt. Wij maken er een WhatsApp-bericht van; een foto van je auto stuur je daarna gewoon mee.</p>
          <ul class="mt-10 grid gap-3">
            <li><a href={waAfspraak} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-groen text-inkt"><Icoon naam="wa" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">WhatsApp</b><span class="num text-grijs">{site.tel}</span></span><Icoon naam="pijl" class="h-5 w-5" /></a></li>
            <li><a href={site.telHref} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-vlak"><Icoon naam="tel" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Bellen</b><span class="text-grijs">Tijdens de openingstijden</span></span><Icoon naam="pijl" class="h-5 w-5" /></a></li>
            <li><a href={site.instagram} class="kaart flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-md"><span class="grid h-12 w-12 place-items-center rounded-md bg-vlak"><Icoon naam="insta" class="h-6 w-6" /></span><span class="flex-1"><b class="block font-semibold">Instagram</b><span class="text-grijs">@mrvie_detailing</span></span><Icoon naam="pijl" class="h-5 w-5" /></a></li>
          </ul>
        </div>
        <form class="kaart p-6 sm:p-8 lg:col-span-7 lg:p-10" data-wa aria-describedby="wa-uitleg">
          <h3 class="text-2xl">Je bericht aan Vie</h3>
          <p id="wa-uitleg" class="mt-2 text-grijs">Er wordt niets verstuurd tot je in WhatsApp zelf op verzenden drukt.</p>
          <fieldset class="mt-8">
            <legend class="text-sm font-semibold">Pakket</legend>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              {pakketten.map((p) => (
                <label class="keuze"><input type="radio" name="pakket" value={p.naam} data-prijs={p.prijs} class="sr-only" checked={p.id === 'combi'} /><span><b class="font-semibold">{p.naam}</b><span class="num ml-auto whitespace-nowrap">vanaf € {p.prijs}</span></span></label>
              ))}
              <label class="keuze"><input type="radio" name="pakket" value="" class="sr-only" /><span><b class="font-semibold">Weet ik nog niet</b></span></label>
            </div>
          </fieldset>
          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Auto <span class="font-normal text-grijs">(merk en model)</span></span><input name="auto" class="veld mt-2" placeholder="Bijvoorbeeld: Volkswagen Golf" /></label>
            <label class="block"><span class="text-sm font-semibold">Dag</span>
              <select name="dag" class="veld mt-2">
                <option value="">Maakt niet uit</option>
                {tijden.map((t) => <option value={t.naam}>{t.naam} ({t.open} - {t.dicht})</option>)}
              </select>
            </label>
            <label class="block"><span class="text-sm font-semibold">Naam</span><input name="naam" autocomplete="given-name" class="veld mt-2" /></label>
            <label class="block sm:col-span-2"><span class="text-sm font-semibold">Opmerking <span class="font-normal text-grijs">(optioneel)</span></span><textarea name="wens" rows="3" class="veld mt-2" placeholder="Bijvoorbeeld: veel hondenharen in de kofferbak"></textarea></label>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-lijn pt-6">
            <button type="submit" class="knop knop-groen"><Icoon naam="wa" />Open in WhatsApp</button>
            <p class="text-sm text-grijs" aria-live="polite" data-samenvatting>Exterieur + interieur combi, vanaf € 79</p>
          </div>
        </form>
      </div>
    </section>

    <!-- 13. Slotbalk -->
    <section class="bg-groen text-inkt" aria-label="Afspraak maken">
      <div class="wrap flex flex-col items-start justify-between gap-6 py-14 md:flex-row md:items-center lg:py-16">
        <div>
          <h2 class="text-[clamp(1.75rem,2vw+1.2rem,2.75rem)]">Tijd voor een schone auto?</h2>
          <p class="mt-2 text-lg">Stuur Vie een appje, dan plannen jullie samen een moment.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={waAfspraak} class="knop knop-inkt"><Icoon naam="wa" class="text-groen" />WhatsApp Vie</a>
          <a href={site.telHref} class="knop knop-rand num">{site.tel}</a>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>

<script>
  // Voor/na wisselen per foto.
  document.querySelectorAll<HTMLElement>('[data-vn]').forEach((fig) => {
    const knoppen = fig.querySelectorAll<HTMLButtonElement>('[data-toon]');
    knoppen.forEach((k) => k.addEventListener('click', () => {
      fig.classList.toggle('toon-voor', k.dataset.toon === 'voor');
      knoppen.forEach((x) => x.setAttribute('aria-pressed', String(x === k)));
    }));
  });

  // WhatsApp-bericht samenstellen.
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    const sam = f.querySelector<HTMLElement>('[data-samenvatting]')!;
    const zet = () => {
      const r = f.querySelector<HTMLInputElement>('input[name=pakket]:checked');
      sam.textContent = r && r.value ? `${r.value}, vanaf € ${r.dataset.prijs}` : 'Vie denkt met je mee over het pakket';
    };
    f.addEventListener('change', zet);
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const r = ['Hoi Vie, ik wil graag een afspraak maken.'];
      r.push('Pakket: ' + (v('pakket') || 'weet ik nog niet, wat raad je aan?'));
      if (v('auto')) r.push('Auto: ' + v('auto'));
      if (v('dag')) r.push('Het liefst op: ' + v('dag').toLowerCase());
      if (v('wens')) r.push('Opmerking: ' + v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      window.open('https://wa.me/31622326223?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

