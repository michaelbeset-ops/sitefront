---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waAfspraak, waMet } from '../data/site';
import pitbox from '../assets/pitbox.jpg';
import porsche from '../assets/porsche.jpg';
import interieur from '../assets/interieur.jpg';
import bekleding from '../assets/bekleding.jpg';
import velg from '../assets/velg.jpg';
import motorkap from '../assets/motorkap.jpg';
import cabrio from '../assets/cabrio.jpg';
import bus from '../assets/bus.jpg';
import citroen from '../assets/citroen.jpg';
import pand from '../assets/pand.jpg';
import reinigen from '../assets/reinigen.jpg';
import mercedes from '../assets/mercedes.jpg';
import q5 from '../assets/q5.jpg';

const vraag = (d: string) => waMet(`Hoi Pitstop, ik heb een vraag over ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Lak polijsten en poetsen', d: 'Doffe lak en krasjes weer op glans. Ook waxoil of teflon.', src: motorkap, alt: 'Zwarte motorkap waarin de lucht en de fotograaf spiegelen', pos: '50% 45%' },
  { t: 'Interieur reinigen', d: 'Dashboard, deurpanelen en stoelen grondig schoon.', src: interieur, alt: 'Schoon interieur van een Mercedes met zwarte stoelen en blauwe sfeerverlichting', pos: '50% 50%' },
  { t: 'Bekleding en gehemelte', d: 'Stof en leer, en het gehemelte boven je hoofd.', src: bekleding, alt: 'BMW met de deur open en een cognackleurig lederen interieur', pos: '50% 60%' },
  { t: 'Velgen reinigen', d: 'Remstof en vuil eraf, tot in de spaken.', src: velg, alt: 'Glimmende velg met rode remklauw aan een donkerblauwe Audi', pos: '60% 70%' },
  { t: 'Wassen en ontvetten', d: 'Grondig wassen onder hoge druk, motorruimte reinigen en ontvetten.', src: reinigen, alt: 'Medewerker reinigt een donkergrijze stationwagen in de werkplaats', pos: '50% 35%' },
  { t: 'Bussen en bedrijfsauto’s', d: 'Van bestelbus tot XL-bus. Ook stickers en belettering verwijderen.', src: bus, alt: 'Witte bestelbus met de deur open in de hal', pos: '40% 50%' },
];

const werk = [
  { src: porsche, alt: 'Zwarte Porsche Macan voor de open deur van Pitstop, met het PIT STOP-bord boven de ingang', groot: true, pos: '50% 60%' },
  { src: mercedes, alt: 'Glimmende zwarte Mercedes GLE voor de deur van de werkplaats', pos: '50% 50%' },
  { src: citroen, alt: 'Blauwe Citroën-bakwagen rijdt de werkplaats uit', pos: '50% 45%' },
  { src: cabrio, alt: 'Grijze BMW cabrio met zwarte kap in de hal', pos: '50% 55%' },
  { src: q5, alt: 'Blauwe Audi Q5 op het terrein in de avondzon', pos: '55% 50%' },
];

const stappen = [
  ['App of bel', 'Zeg wat er moet gebeuren. Een foto van de lak of de krassen helpt ons al op weg.'],
  ['Breng hem langs', 'Kom naar de Edisonweg 3. We bekijken de auto en spreken vooraf de prijs af.'],
  ['Wij gaan aan de slag', 'Wassen, poetsen, polijsten of reinigen. Van binnen, van buiten of allebei.'],
  ['Glimmend ophalen', 'Je hoort van ons wanneer hij klaarstaat.'],
];
---
<Base title={`${site.naam} | Autopoetsbedrijf in Gorinchem`} description="Autopoetsbedrijf op de Edisonweg in Gorinchem. Lak polijsten en poetsen, interieur en bekleding reinigen, wassen en ontvetten. Voor particulieren en bedrijven, van personenauto tot bus. 4,6 op Google.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero: tekst op asfalt, hun eigen pitbox rechts -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7.25rem)] items-end overflow-hidden bg-asfalt text-licht lg:items-center" aria-labelledby="t-hero">
      <Image src={pitbox} alt="" widths={[480, 640, 820]} quality={50} sizes="(min-width: 1024px) 48vw, 100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_42%] lg:left-[52%] lg:object-[50%_6%] lg:w-[48%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#11121433_0%,#111214a6_38%,#111214f5_72%)] lg:bg-[linear-gradient(90deg,#111214_0%,#111214_52%,#11121499_56%,#11121400_72%)]" aria-hidden="true"></div>
      <div class="vlag absolute inset-y-0 left-[52%] -z-10 hidden w-4 lg:block" style="--vs:16px;--v1:#f3f2ee;--v2:#111214" aria-hidden="true"></div>
      <div class="wrap grid w-full gap-12 pb-20 pt-56 sm:pt-72 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-6">
          <p class="eyebrow">Autopoetsbedrijf in Gorinchem</p>
          <h1 id="t-hero" class="mt-6 text-hero">Uw auto weer als <span class="text-rood-licht">nieuw.</span></h1>
          <p class="mt-7 max-w-lg text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Lak polijsten en poetsen, interieur en bekleding reinigen, wassen onder hoge druk. Voor particulieren en bedrijven, van personenauto tot bus.</p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href={waAfspraak} class="knop knop-rood"><span><Icoon naam="wa" />WhatsApp ons</span></a>
            <a href="#diensten" class="knop knop-rand op-foto"><span>Bekijk de diensten</span></a>
          </div>
          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-2.5 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m vr 8.30 tot 17.00 uur</span></li>
          </ul>
        </div>
        <div class="hidden items-end justify-end lg:col-span-5 lg:col-start-8 lg:flex">
          <p class="pitbord mt-auto translate-y-28">
            <span class="block text-xs font-semibold uppercase tracking-[.2em] text-licht-zacht">Binnenrijden aan de</span>
            <span class="block font-kop text-xl font-bold uppercase tracking-[.04em]">{site.straat}, {site.plaats}</span>
            <a href={site.telHref} class="num mt-1 block font-kop text-xl font-extrabold italic text-rood-licht no-underline hover:text-licht">{site.tel}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- 2. Chips: hun eigen lijst -->
    <section class="border-b border-lijn bg-wit" aria-label="Wat we doen, in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="tag shrink-0 no-underline"><span>{c}</span></a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-5 text-3xl">Van binnen en van buiten <span class="text-rood">grondig</span> schoon.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Gebruikt of nieuw, personenauto, jeep, pickup of bus. Tik op een dienst en stel je vraag meteen via WhatsApp.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-5 lg:mt-16 lg:grid-cols-3 lg:gap-6">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="dienst group relative block overflow-hidden rounded-md bg-asfalt text-licht no-underline shadow-sm">
                <Image src={b.src} quality={55} quality={60} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1248px) 380px, (min-width: 1024px) 30vw, 46vw" class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]" style={`object-position:${b.pos}`} />
                <span class="absolute inset-0 bg-[linear-gradient(180deg,#11121400_35%,#111214e6_100%)]" aria-hidden="true"></span>
                <span class="absolute left-0 top-0 bg-rood px-3 py-1 font-kop text-sm font-extrabold italic text-wit sm:text-base">0{i + 1}</span>
                <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-4 sm:p-6">
                  <span>
                    <h3 class="text-[1.125rem] sm:text-2xl">{b.t}</h3>
                    <span class="mt-1.5 hidden text-[.9375rem] leading-snug text-licht/85 sm:block">{b.d}</span>
                  </span>
                  <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-sm bg-wit/15 text-wit backdrop-blur-sm transition-colors group-hover:bg-rood sm:grid" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="rijs mt-8 flex flex-col items-start justify-between gap-5 rounded-md bg-beton px-6 py-6 sm:flex-row sm:items-center md:px-8">
          <p class="text-lg"><b class="font-semibold">Auto verkopen of afleveren?</b> <span class="text-grijs">We maken gebruikte en nieuwe auto’s ook showroomklaar.</span></p>
          <a href={vraag('showroomklaar maken')} class="knop knop-inkt knop-klein shrink-0"><span><Icoon naam="wa" />Vraag het ons</span></a>
        </div>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="border-y border-lijn bg-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-grijs">Score op Google</dt><dd class="cijfer order-first text-rood">{site.google.score}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Google-reviews</dt><dd class="cijfer order-first">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Jaar ervaring</dt><dd class="cijfer order-first">10+</dd></div>
        <div class="flex flex-col lg:border-l lg:border-lijn lg:pl-10"><dt class="text-sm text-grijs">Dagen per week open</dt><dd class="cijfer order-first">6</dd></div>
      </dl>
    </section>

    <!-- 5. Werk -->
    <section id="werk" class="cv donker bg-asfalt py-24 text-licht lg:py-32" aria-labelledby="t-werk">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werk</p>
            <h2 id="t-werk" class="mt-5 text-3xl">Zo rollen ze <span class="text-rood-licht">de deur uit.</span></h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Foto’s van onze eigen werkplaats aan de Edisonweg. Van een Porsche tot een bakwagen.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:gap-4 lg:mt-16 lg:grid-cols-4">
          {werk.map((w, i) => (
            <li class={`rijs relative overflow-hidden rounded-md bg-asfalt-2 ${w.groot ? 'col-span-2 aspect-square lg:row-span-2' : 'aspect-square'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} quality={58} quality={60} alt={w.alt} widths={w.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={w.groot ? '(min-width: 1248px) 590px, (min-width: 1024px) 48vw, 92vw' : '(min-width: 1248px) 290px, (min-width: 1024px) 23vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" style={`object-position:${w.pos}`} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section class="py-20 lg:py-24" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Zo gaat het</p>
            <h2 id="t-stappen" class="mt-5 text-3xl">Van appje tot <span class="text-rood">glimmend</span> ophalen.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Geen ingewikkeld boekingssysteem. Gewoon even contact, en dan de auto langsbrengen.</p>
        </div>
        <ol class="mt-12 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:mt-16 lg:grid-cols-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative overflow-hidden p-6 sm:p-7" style={`--d:${i * 0.06}s`}>
              <span class="vlag absolute inset-x-0 top-0 h-1.5" style="--vs:6px;--v1:#111214;--v2:#ffffff" aria-hidden="true"></span>
              <p class="num font-kop text-5xl font-extrabold italic leading-none text-rood">0{i + 1}</p>
              <h3 class="mt-6 text-xl sm:text-2xl">{t}</h3>
              <p class="mt-2 text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over Pitstop -->
    <section id="over" class="cv donker bg-asfalt text-licht" aria-labelledby="t-over">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[24rem] sm:min-h-[30rem] lg:col-span-5">
          <Image src={reinigen} quality={60} alt="Medewerker van Pitstop reinigt een donkergrijze stationwagen in de werkplaats" widths={[640, 900, 1080]} sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[50%_30%]" />
          <p class="absolute bottom-0 left-0 bg-rood px-4 py-2 font-kop text-base font-bold uppercase tracking-[.06em] text-wit">In de werkplaats aan de Edisonweg</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-7 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Pitstop</p>
          <h2 id="t-over" class="mt-5 text-3xl">Al meer dan 10 jaar poetsen in <span class="text-rood-licht">Gorinchem.</span></h2>
          <p class="mt-7 text-lg text-licht-zacht">Car Polish &amp; Cleaning Autopoetscenter Pitstop is een professioneel autopoetsbedrijf voor de totale reconditionering van personen- en bedrijfsauto’s, voor particulieren én bedrijven. Gebruikte en nieuwe (showroom)auto’s, jeeps, pickups en bussen: normaal, XL en touring.</p>
          <ul class="mt-9 grid gap-3">
            <li class="flex items-center gap-4 rounded-md bg-asfalt-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-rood text-wit"><Icoon naam="euro" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Eerlijke prijs vooraf</h3><p class="mt-0.5 text-[.9375rem] text-licht-zacht">Je weet waar je aan toe bent voordat we beginnen.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-asfalt-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-rood text-wit"><Icoon naam="klok" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Snel terecht</h3><p class="mt-0.5 text-[.9375rem] text-licht-zacht">Klanten konden dezelfde week, soms dezelfde ochtend al langskomen.</p></div>
            </li>
            <li class="flex items-center gap-4 rounded-md bg-asfalt-2 px-5 py-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-sm bg-rood text-wit"><Icoon naam="duim" class="h-5 w-5" /></span>
              <div><h3 class="text-xl">Vriendelijk en vakkundig</h3><p class="mt-0.5 text-[.9375rem] text-licht-zacht">Dat schrijven klanten steeds weer in hun reviews.</p></div>
            </li>
          </ul>
          <a href={waAfspraak} class="knop knop-rood mt-10"><span><Icoon naam="wa" />Plan je poetsbeurt</span></a>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="bg-beton py-20 lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-5 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs kaart flex items-center gap-4 self-start px-5 py-4 no-underline transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-3xl font-extrabold italic">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-16 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[86%] shrink-0 snap-center flex-col p-6 md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-sm bg-asfalt font-kop text-lg font-extrabold italic text-wit" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="link font-semibold">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <!-- 9. Openingstijden en locatie -->
    <section id="route" class="cv py-20 lg:py-24" aria-labelledby="t-route">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Openingstijden en route</p>
          <h2 id="t-route" class="mt-5 text-3xl">Rij binnen aan de <span class="text-rood">Edisonweg.</span></h2>
          <p class="mt-6 text-lg text-grijs">Op het industrieterrein van Gorinchem-Oost. Je herkent ons aan het PIT STOP-bord boven de grote deur.</p>
          <div class="kaart mt-10 p-6 md:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-2xl">Openingstijden</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za open</span></p>
            </div>
            <table class="mt-4 w-full">
              <caption class="sr-only">Openingstijden van Pitstop</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-rood">
                    <th scope="row" class="py-2.5 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num py-2.5 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="flex flex-col gap-5 lg:col-span-7">
          <figure class="relative min-h-[22rem] flex-1 overflow-hidden rounded-md">
            <Image src={pand} quality={60} alt="Het pand van Pitstop aan de Edisonweg: witte loods met het PIT STOP-bord boven de open deur en een blauwe bus ervoor" widths={[600, 950]} sizes="(min-width: 1248px) 700px, (min-width: 1024px) 56vw, 92vw" class="absolute inset-0 h-full w-full object-cover object-[50%_32%]" />
          </figure>
          <div class="kaart flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex items-start gap-3"><Icoon naam="pin" class="mt-0.5 h-6 w-6 shrink-0 text-rood" /><span><b class="font-semibold">{site.straat}</b><br /><span class="text-grijs">{site.postcode} {site.plaats}</span></span></p>
            <a href={site.maps} class="knop knop-inkt knop-klein shrink-0"><span>Route plannen<Icoon naam="pijl" /></span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Contact: het pitbord -->
    <section id="contact" class="donker bg-asfalt py-20 text-licht lg:py-24" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Contact</p>
          <h2 id="t-contact" class="mt-5 text-3xl">Plan je <span class="text-rood-licht">pitstop.</span></h2>
          <p class="mt-6 text-lg text-licht-zacht">Kies je auto en wat er moet gebeuren. Wij zetten het in een WhatsApp-bericht, foto’s van de lak of het interieur stuur je daarna gewoon mee.</p>
          <ul class="mt-10 grid gap-3">
