---
// Woordmerk naar hun logo (PIT zwart, STOP rood, cursief, geblokte vlag), als tekst zodat het scherp blijft.
import { url } from '../data/site';
interface Props { class?: string; licht?: boolean }
const { class: cls = '', licht = false } = Astro.props;
---
<a href={url('')} class={`merk ${cls}`}>
  <span class="merk-woord">PIT<span>STOP</span></span>
  <span class="merk-vlag vlag" style={licht ? '--v1:#f3f2ee;--v2:transparent' : '--v1:#111214;--v2:transparent'} aria-hidden="true"></span>
  <small>Car polish &amp; cleaning</small>
</a>
