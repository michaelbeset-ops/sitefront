---
import { site, url, diensten, waAlgemeen } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
---
<footer class="donker bg-nacht text-licht-zacht">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-12 py-16 text-[.9375rem] lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="col-span-2 lg:col-span-5">
      <a href={url('')} class="merk text-licht"><span class="merk-teken" aria-hidden="true"><Icoon naam="sleutel" class="h-5 w-5" /></span><span><b>Riemar</b><small>Montage</small></span></a>
      <p class="mt-6 max-w-sm">Sinds 2004 badkamers en keukens monteren in Dordrecht. Ook interieurbouw, timmerwerk en onderhoud aan schepen.</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-semibold text-licht">Werk</p>
      <ul class="mt-4 space-y-2">{diensten.map((d) => <li><a href={h('werk')} class="no-underline hover:text-merk-licht">{d}</a></li>)}</ul>
    </div>
    <div class="lg:col-span-4">
      <p class="font-semibold text-licht">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={site.telHref} class="num whitespace-nowrap no-underline hover:text-merk-licht">{site.tel}</a></li>
        <li><a href={waAlgemeen} class="no-underline hover:text-merk-licht">WhatsApp</a></li>
        <li>{site.plaats}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-6 text-xs">
      <p>© {new Date().getFullYear()} {site.naam}, {site.plaats} · KvK {site.kvk}</p>
      <p class="flex gap-6"><a href={url('privacy/')} class="no-underline hover:text-merk-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
    </div>
    {site.voorstel && <p class="wrap pb-8 text-xs">Sfeerfoto's via Unsplash, ter illustratie; nog geen eigen projectfoto's. Review van het Google-profiel (5 november 2026).</p>}
  </div>
</footer>
