---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';

const voorstel = import.meta.env.PUBLIC_VOORSTEL === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p = '') => `${base}/${p}`;

// Werkzaamheden zoals vermeld in de bedrijfsomschrijving (KvK-gidsen).
const werk = [
  ['Badkamers', 'Renovatie van uw badkamer: sanitair plaatsen en vloer- en wandtegels zetten.'],
  ['Keukens', 'Montage en onderhoud van keukens.'],
  ['Interieurbouw en timmerwerk', 'Maatwerk binnenshuis en timmerwerk.'],
  ['Schepen', 'Reparatie en onderhoud aan boord.'],
];
---
<Base
  title="Riemar Montage | Badkamer en keuken laten monteren in Dordrecht"
  description="Riemar Montage uit Dordrecht: montage en onderhoud van badkamers en keukens, interieurbouw, timmerwerk en onderhoud aan schepen. Sinds 2004."
>
  <!-- Hero: foto vult het scherm, tekst in een effen blok linksonder zodat hij op de lichte badkamerfoto leesbaar blijft. -->
  <section class="relative isolate">
    <div class="absolute inset-0 -z-10 [&_img]:h-full [&_img]:w-full [&_img]:object-cover">
      <Foto naam="hero" alt="Gerenoveerde badkamer met witte wandtegels en een dubbel badmeubel" sizes="100vw" eager />
    </div>
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 min-h-[36rem] sm:min-h-[42rem] lg:min-h-[46rem] flex items-end pt-24 pb-8 sm:pb-12">
      <div class="bg-night text-paper p-6 sm:p-10 max-w-2xl">
        <p class="text-sm tracking-[0.12em] uppercase text-accent-light">Dordrecht · sinds 2004</p>
        <h1 class="mt-4 text-4xl">Badkamer en keuken, netjes gemonteerd</h1>
        <p class="mt-6 text-lg text-paper/90">Riemar Montage plaatst en onderhoudt badkamers en keukens, en doet interieurbouw en timmerwerk.</p>
        <a href="tel:+31654948189" class="mt-8 inline-flex bg-accent text-paper font-semibold px-5 py-3 hover:bg-accent-deep transition-colors">Bel 06 54 94 81 89</a>
      </div>
    </div>
  </section>

  <section id="werk" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28">
    <h2 class="text-3xl max-w-xl">Wat Riemar voor u doet</h2>
    <div class="mt-12 grid gap-x-12 md:grid-cols-2">
      {werk.map(([titel, tekst]) => (
        <div class="py-7 border-t border-ink grid grid-cols-[1.5rem_1fr] gap-4">
          <svg aria-hidden="true" class="mt-1.5 text-accent" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 12.5 9.5 18 20 6"/></svg>
          <div><h3 class="text-xl">{titel}</h3><p class="mt-2 text-ink-soft">{tekst}</p></div>
        </div>
      ))}
    </div>
    <p class="mt-6 text-sm text-ink-soft">[[AANLEVEREN: foto's van eigen projecten, voor en na]]</p>
  </section>

  <section id="over" class="bg-paper-2">
    <div class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-10 lg:grid-cols-12 items-center">
      <div class="lg:col-span-7 [&_img]:w-full [&_img]:h-auto">
        <Foto naam="keuken" alt="Keuken die afgeplakt is tijdens een verbouwing" sizes="(min-width: 1024px) 55vw, 100vw" />
      </div>
      <div class="lg:col-span-5">
        <h2 class="text-3xl">Eén vakman, van begin tot eind</h2>
        <p class="mt-6 text-ink-soft">Riemar Montage is sinds 2004 een eenmanszaak in Dordrecht. Wie belt, spreekt dus meteen degene die het werk ook uitvoert.</p>
        <p class="mt-3 text-sm text-ink-soft">[[AANLEVEREN: naam, korte introductie en werkgebied]]</p>
      </div>
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-[84rem] px-4 sm:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 class="text-3xl">Klus bespreken?</h2>
      <p class="mt-5 text-ink-soft">Bel, of laat hieronder uw gegevens achter. Een paar foto's van de ruimte helpen om een goed beeld te krijgen.</p>
      <a href="tel:+31654948189" class="mt-8 inline-block display text-[2.2rem] leading-none hover:text-accent">06 54 94 81 89</a>
    </div>
    <form class="lg:col-span-6 lg:col-start-7 grid gap-5" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="[[AANLEVEREN: Web3Forms-key]]" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2 text-sm">Naam<input name="naam" required autocomplete="name" class="bg-paper border border-line px-3 py-3 text-base" /></label>
        <label class="grid gap-2 text-sm">Telefoon<input name="telefoon" type="tel" required autocomplete="tel" class="bg-paper border border-line px-3 py-3 text-base" /></label>
      </div>
      <label class="grid gap-2 text-sm">Soort klus
        <select name="klus" class="bg-paper border border-line px-3 py-3 text-base">
          <option>Badkamer</option><option>Keuken</option><option>Interieurbouw of timmerwerk</option><option>Schip</option><option>Anders</option>
        </select>
      </label>
      <label class="grid gap-2 text-sm">Toelichting<textarea name="bericht" rows="4" class="bg-paper border border-line px-3 py-3 text-base"></textarea></label>
      {voorstel ? (
        <p class="border border-accent px-4 py-3 text-sm">Dit is een ontwerpvoorstel, dus het formulier verstuurt nog niets. Bel <a class="underline" href="tel:+31654948189">06 54 94 81 89</a>.</p>
      ) : (
        <button type="submit" class="justify-self-start bg-accent text-paper font-semibold px-6 py-3 hover:bg-accent-deep">Verstuur</button>
      )}
      <p class="text-xs text-ink-soft">We gebruiken uw gegevens alleen voor uw klus. Zie de <a class="underline" href={u('privacy/')}>privacyverklaring</a>.</p>
    </form>
  </section>
</Base>
