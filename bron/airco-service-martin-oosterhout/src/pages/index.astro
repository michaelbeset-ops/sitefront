<script>
  const f = document.querySelector<HTMLFormElement>('[data-wa]');
  if (f) {
    const vb = f.querySelector<HTMLElement>('[data-voorbeeld]');
    const ruimtes = f.querySelector<HTMLElement>('[data-ruimtes]');
    const zinnen: Record<string, string> = {
      nieuw: 'ik wil graag een offerte voor een nieuwe airco in huis.',
      bedrijf: 'ik wil graag een offerte voor airco in ons bedrijf.',
      onderhoud: 'ik wil graag een onderhoudsbeurt voor mijn airco laten doen.',
      storing: 'mijn airco heeft een storing. Kunt u ernaar kijken?',
      auto: 'de airco van mijn auto koelt niet goed meer. Kan ik langskomen?',
    };
    const bericht = () => {
      const d = new FormData(f);
      const v = (n: string) => String(d.get(n) || '').trim();
      const soort = v('soort') || 'nieuw';
      const metRuimtes = soort === 'nieuw' || soort === 'bedrijf';
      if (ruimtes) ruimtes.hidden = !metRuimtes;
      const r = ['Hallo Martin, ' + zinnen[soort]];
      if (metRuimtes && v('ruimtes')) r.push('Aantal ruimtes: ' + v('ruimtes'));
      if (v('plaats')) r.push('Plaats: ' + v('plaats'));
      if (v('wens')) r.push(v('wens'));
      if (v('naam')) r.push('Groet, ' + v('naam'));
      return r.join('\n');
    };
    const toon = () => { if (vb) vb.textContent = bericht(); };
    f.addEventListener('input', toon);
    f.addEventListener('change', toon);
    toon();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.open('https://wa.me/31624580452?text=' + encodeURIComponent(bericht()), '_blank', 'noopener');
    });
  }
</script>

