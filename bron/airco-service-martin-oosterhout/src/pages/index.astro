---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import { site, tijden, chips, reviews, waOfferte, waMet } from '../data/site';
import hero from '../assets/hero.jpg';
import martin from '../assets/martin-auto.jpg';
import bus from '../assets/bus.jpg';
import binnenGordijn from '../assets/binnen-gordijn.jpg';
import steeg from '../assets/steeg-units.jpg';
import gevelTwee from '../assets/gevel-twee.jpg';
import loods from '../assets/loods-omkasting.jpg';
import machinekamer from '../assets/machinekamer.jpg';
import dakZon from '../assets/dak-zon.jpg';
import antraciet from '../assets/omkasting-antraciet.jpg';
import trap from '../assets/binnen-trap.jpg';
import tuin from '../assets/tuin-omkasting.jpg';
import parket from '../assets/console-parket.jpg';
import grind from '../assets/grind-mitsubishi.jpg';
import lift from '../assets/gevel-lift.jpg';

const vraag = (d: string) => waMet(`Hallo Martin, ik heb een vraag over: ${d.toLowerCase()}.`);

const diensten = [
  { t: 'Airco in huis', d: 'Complete split-unit airco van een topmerk, inclusief installatie en montage. Standaard Mitsubishi met inverter-warmtepomp.', src: binnenGordijn, alt: 'Witte binnenunit van een airco boven een raam met een donkergroen gordijn', pos: '50% 45%' },
  { t: 'Meerdere ruimtes', d: 'Van één slaapkamer tot vier binnenunits op twee buitenunits. Ook voor kantoor en bedrijf.', src: steeg, alt: 'Een rij buitenunits op steunen langs een bakstenen muur, boven een grindpad', pos: '50% 55%' },
  { t: 'Onderhoud en storingen', d: 'Periodiek onderhoud volgens de STEK-normen, en reparatie als de airco minder koelt of stilvalt.', src: gevelTwee, alt: 'Twee buitenunits naast elkaar op een witte gevel tussen ramen met groene luiken', pos: '50% 40%' },
  { t: 'Auto-airco', d: 'Eerst een check op lekkage, daarna afpersen, vacumeren en bijvullen. Ook bij u op locatie en voor bedrijfswagens.', src: bus, alt: 'Bestelbus met open motorkap, aangesloten op meetklokken en een koudemiddelfles', pos: '50% 60%' },
  { t: 'Aircocover en afwerking', d: 'De buitenunit netjes weggewerkt in een omkasting, de leidingen strak langs de gevel.', src: loods, alt: 'Antraciet omkasting om een buitenunit op een nieuw terras voor een bakstenen schuurwoning', pos: '30% 60%' },
  { t: 'Boten, kranen en machines', d: 'Ook voor mobiele kranen, landbouwvoertuigen, boten, campers, caravans en oldtimers.', src: machinekamer, alt: 'Machinekamer met blauwe motoren, leidingen en een traanplaatvloer', pos: '50% 50%' },
];

const projecten = [
  { src: dakZon, alt: 'Twee buitenunits op een plat dak naast een houten gevel, met de zon erboven', t: 'Twee buitenunits op een plat dak', groot: true },
  { src: antraciet, alt: 'Antraciet omkasting om een buitenunit naast een voordeur', t: 'Omkasting naast de voordeur' },
  { src: trap, alt: 'Witte binnenunit hoog aan de muur boven een trap', t: 'Binnenunit boven de trap' },
  { src: parket, alt: 'Wit vloermodel-binnenunit op een visgraatvloer', t: 'Vloermodel in de woonkamer' },
  { src: tuin, alt: 'Witte omkasting tussen roze hortensia’s naast een serre', t: 'Witte cover in de border' },
  { src: grind, alt: 'Twee Mitsubishi-buitenunits op het grind tegen een bakstenen muur', t: 'Mitsubishi-buitenunits' },
  { src: lift, alt: 'Buitenunit hoog aan een bakstenen gevel, geplaatst met een ladderlift', t: 'Hoog aan de gevel' },
];

const stappen = [
  ['Appje of telefoontje', 'Stuur een WhatsApp of bel. Vaak kan Martin al snel langskomen.'],
  ['Kijken bij u thuis', 'Martin bekijkt ter plekke wat er nodig is, en wat wel en niet kan.'],
  ['Offerte op maat', 'Een duidelijke prijsopgave, zonder dat u er lang op hoeft te wachten.'],
  ['Netjes geplaatst', 'Plaatsen, testen en uitleggen. Daarna wordt alles opgeruimd, ook het verpakkingsmateriaal.'],
  ['Ook daarna', 'Onderhoud of een storing? Een appje aan Martin is genoeg.'],
];
---
<Base title={`${site.naam} | Airco plaatsen, onderhoud en auto-airco in Oosterhout`} description="STEK-gecertificeerd airco-installateur in Oosterhout. Split-unit airco's voor huis en bedrijf, onderhoud, storingen en auto-airco. 4,8 op Google. Offerte via WhatsApp.">
  <Kop />
  <main id="inhoud">

    <!-- 1. Hero -->
    <section class="donker relative isolate flex min-h-[calc(100svh-7rem)] items-end overflow-hidden bg-nacht text-licht" aria-labelledby="t-hero">
      <Image src={hero} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[58%_60%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0b142040_0%,#0b1420b8_40%,#0b1420f2_100%)] md:bg-[linear-gradient(90deg,#0b1420f5_0%,#0b1420d0_38%,#0b142030_75%),linear-gradient(0deg,#0b1420cc_0%,#0b142000_40%)]" aria-hidden="true"></div>
      <div class="wrap grid w-full items-end gap-12 pb-20 pt-28 md:pb-16 md:pt-32 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="eyebrow">Airco-installateur in Oosterhout</p>
          <h1 id="t-hero" class="mt-5 text-hero">Uw airco, <span class="text-vries">netjes</span> geplaatst door Martin.</h1>
          <p class="mt-6 max-w-xl text-lg text-licht/90 md:text-[1.3125rem] md:leading-relaxed">Split-unit airco’s voor huis en bedrijf, onderhoud en storingen, en service voor de airco in uw auto. STEK-gecertificeerd, met een vrijblijvende offerte op maat.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={waOfferte} class="knop knop-blauw"><Icoon naam="wa" />Offerte via WhatsApp</a>
            <a href="#projecten" class="knop knop-rand op-foto">Bekijk projecten</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-[.9375rem] text-licht/90">
            <li class="flex items-center gap-2"><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><b class="num text-licht">{site.google.score}</b> op Google, {site.google.aantal} reviews</li>
            <li class="flex items-center gap-2" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za bereikbaar</span></li>
          </ul>
        </div>
        <div class="hidden lg:col-span-4 lg:flex lg:justify-end">
          <a href={site.telHref} class="group flex w-full max-w-[19rem] items-center gap-4 rounded-lg bg-licht/10 p-3 pr-5 no-underline ring-1 ring-licht/20 backdrop-blur-md transition-colors hover:bg-licht/15">
            <Image src={martin} alt="Martin in zijn blauwe Airco Service Martin-polo" widths={[160]} sizes="80px" loading="eager" class="h-[4.5rem] w-[4.5rem] shrink-0 rounded-md object-cover object-[16%_22%]" />
            <span class="text-sm leading-snug">
              <span class="block text-licht-zacht">U spreekt Martin zelf</span>
              <b class="num mt-1 block font-kop text-xl font-bold tracking-[-0.02em] text-licht group-hover:text-vries">{site.tel}</b>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Chips -->
    <section class="border-b border-lijn bg-wit" aria-label="Diensten in het kort">
      <div class="wrap flex items-center gap-x-3 gap-y-3 overflow-x-auto py-5 [scrollbar-width:none] md:flex-wrap md:justify-center md:overflow-visible">
        {chips.map((c) => <a href="#diensten" class="shrink-0 rounded-md bg-ijs px-4 py-2 text-sm font-medium no-underline transition-colors hover:bg-blauw hover:text-wit">{c}</a>)}
      </div>
    </section>

    <!-- 3. Diensten -->
    <section id="diensten" class="py-20 lg:py-24" aria-labelledby="t-diensten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Diensten</p>
            <h2 id="t-diensten" class="mt-4 text-3xl">Plaatsen, onderhouden en repareren.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Voor woningen, bedrijven en voertuigen. Ook als uw airco niet door ons is geplaatst, kunt u contact opnemen.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-5">
          {diensten.map((b, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.06}s`}>
              <a href={vraag(b.t)} class="group relative isolate flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-lg bg-nacht p-6 text-licht no-underline shadow-sm sm:aspect-[4/5] lg:aspect-square lg:p-7">
                <Image src={b.src} alt={b.alt} widths={[400, 600, 800]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw" class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" style={`object-position:${b.pos}`} />
                <span class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#0b142000_30%,#0b1420d9_72%,#0b1420f5_100%)]" aria-hidden="true"></span>
                <span class="num absolute left-6 top-6 rounded-sm bg-licht/15 px-2 py-1 text-xs font-bold tracking-[.12em] backdrop-blur-sm lg:left-7 lg:top-7">0{i + 1}</span>
                <span class="flex items-end justify-between gap-4">
                  <span>
                    <h3 class="text-xl lg:text-[1.5rem]">{b.t}</h3>
                    <span class="mt-2 block text-[.9375rem] leading-relaxed text-licht/85">{b.d}</span>
                  </span>
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit transition-colors group-hover:bg-wit group-hover:text-blauw" aria-hidden="true"><Icoon naam="pijl" class="h-5 w-5" /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="rijs mt-8 text-grijs">Merken die Martin levert: <b class="font-semibold text-inkt">Mitsubishi, Daikin, Giatsu, Toshiba en Samsung.</b></p>
      </div>
    </section>

    <!-- 4. Cijfers -->
    <section class="bg-blauw text-wit" aria-label="In cijfers">
      <dl class="wrap grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4 lg:py-14">
        <div class="flex flex-col"><dt class="text-sm text-wit/85">Score op Google</dt><dd class="num cijfer order-first">{site.google.score}</dd></div>
        <div class="flex flex-col pl-6 lg:border-l lg:border-wit/25 lg:pl-10"><dt class="text-sm text-wit/85">Google-reviews</dt><dd class="num cijfer order-first">{site.google.aantal}</dd></div>
        <div class="flex flex-col lg:border-l lg:border-wit/25 lg:pl-10"><dt class="text-sm text-wit/85">Jaar installatiegarantie</dt><dd class="num cijfer order-first">5</dd></div>
        <div class="flex flex-col pl-6 lg:border-l lg:border-wit/25 lg:pl-10"><dt class="text-sm text-wit/85">Jaar garantie op service en reparatie</dt><dd class="num cijfer order-first">2</dd></div>
      </dl>
    </section>

    <!-- 5. Projecten -->
    <section id="projecten" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-projecten">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Projecten</p>
            <h2 id="t-projecten" class="mt-4 text-3xl">Strak weggewerkt, binnen en buiten.</h2>
          </div>
          <p class="rijs text-lg text-licht-zacht lg:col-span-4 lg:col-start-9" style="--d:.05s">Een greep uit recent werk: op het dak, aan de gevel, in een omkasting of als vloermodel in de kamer.</p>
        </div>
        <ul class="mt-12 grid grid-cols-2 gap-3 md:grid-cols-5 md:gap-4 lg:mt-14">
          {projecten.map((w, i) => (
            <li class={`rijs group relative overflow-hidden rounded-md bg-nacht-2 ${w.groot ? 'col-span-2 row-span-2 aspect-square md:aspect-auto' : 'aspect-[4/5] md:aspect-[3/4]'}`} style={`--d:${(i % 4) * 0.05}s`}>
              <Image src={w.src} alt={w.alt} widths={w.groot ? [600, 900, 1200] : [320, 480, 640]} sizes={w.groot ? '(min-width: 1248px) 470px, (min-width: 768px) 40vw, 92vw' : '(min-width: 1248px) 230px, (min-width: 768px) 19vw, 46vw'} class="tegel absolute inset-0 h-full w-full object-cover" />
              <p class="absolute inset-x-0 bottom-0 bg-[linear-gradient(0deg,#0b1420e6,#0b142000)] px-4 pb-3 pt-10 text-sm font-medium">{w.t}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. Werkwijze -->
    <section id="werkwijze" class="py-20" aria-labelledby="t-stappen">
      <div class="wrap">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="rijs lg:col-span-7">
            <p class="eyebrow">Werkwijze</p>
            <h2 id="t-stappen" class="mt-4 text-3xl">Van eerste appje tot koele kamer.</h2>
          </div>
          <p class="rijs text-lg text-grijs lg:col-span-4 lg:col-start-9" style="--d:.05s">Zo beschrijven klanten de aanpak in hun reviews. Martin en zijn collega doen het werk zelf.</p>
        </div>
        <ol class="stappen mt-12 grid gap-3 sm:grid-cols-2 lg:mt-14 lg:grid-cols-5 lg:gap-4">
          {stappen.map(([t, d], i) => (
            <li class="rijs kaart relative p-5 sm:p-6 lg:p-7" style={`--d:${i * 0.06}s`}>
              <p class="num flex items-center gap-3 font-kop text-lg font-extrabold text-blauw">0{i + 1}<span class="h-px flex-1 bg-lijn" aria-hidden="true"></span></p>
              <h3 class="mt-3 text-lg sm:mt-6 lg:mt-8 lg:text-xl">{t}</h3>
              <p class="mt-2 text-[.9375rem] text-grijs">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Over Martin -->
    <section id="martin" class="bg-ijs" aria-labelledby="t-martin">
      <div class="grid lg:grid-cols-12">
        <div class="relative min-h-[22rem] sm:min-h-[30rem] lg:col-span-6">
          <Image src={martin} alt="Martin in zijn blauwe Airco Service Martin-polo bij een auto met open motorkap en aangesloten meetklokken" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover object-[30%_40%]" />
          <p class="absolute bottom-4 left-4 rounded-md bg-blauw px-4 py-1.5 text-sm font-semibold text-wit">Martin, eigenaar</p>
        </div>
        <div class="px-5 py-20 md:px-10 lg:col-span-6 lg:px-14 lg:py-20 xl:pr-[max(3.5rem,calc((100vw-78rem)/2+2.5rem))]">
          <p class="eyebrow">Over Martin</p>
          <h2 id="t-martin" class="mt-4 text-3xl">Geen callcenter, gewoon Martin.</h2>
          <p class="mt-6 text-lg text-grijs">Bij Airco Service Martin spreekt u de vakman zelf. Martin komt kijken, maakt de offerte en plaatst de airco samen met zijn collega. En koelt de airco in uw auto niet meer, dan kunt u ook bij hem terecht.</p>
          <ul class="mt-8 grid gap-3">
            <li class="flex items-start gap-4 rounded-md bg-wit px-5 py-4 shadow-sm">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="kalender" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Afspraak is afspraak</h3><p class="mt-1 text-[.9375rem] text-grijs">Klanten noemen hem stipt en op tijd, en de planning klopt.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-wit px-5 py-4 shadow-sm">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="huis" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Netjes in uw huis</h3><p class="mt-1 text-[.9375rem] text-grijs">“Uiteraard gaan wij netjes met jullie spullen om wij zijn te gast.” Martin, in een reactie op Google.</p></div>
            </li>
            <li class="flex items-start gap-4 rounded-md bg-wit px-5 py-4 shadow-sm">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-blauw text-wit"><Icoon naam="sleutel" class="h-5 w-5" /></span>
              <div><h3 class="text-lg">Ook na de plaatsing</h3><p class="mt-1 text-[.9375rem] text-grijs">Een storing na jaren gebruik? Ook dan maakt Martin tijd om het op te lossen.</p></div>
            </li>
          </ul>
          <a href={waOfferte} class="knop knop-blauw mt-8"><Icoon naam="wa" />App Martin</a>
        </div>
      </div>
    </section>

    <!-- 8. Reviews -->
    <section id="reviews" class="donker bg-nacht py-20 text-licht lg:py-24" aria-labelledby="t-reviews">
      <div class="wrap">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="rijs">
            <p class="eyebrow">Reviews</p>
            <h2 id="t-reviews" class="mt-4 text-3xl">Wat klanten zeggen.</h2>
          </div>
          <a href={site.reviews} class="rijs flex items-center gap-4 self-start rounded-lg bg-wit px-5 py-4 text-inkt no-underline shadow-sm transition-shadow hover:shadow-md md:self-auto" style="--d:.05s">
            <Icoon naam="g" class="h-9 w-9" />
            <span>
              <span class="flex items-center gap-2"><b class="num font-kop text-2xl font-extrabold">{site.google.score}</b><span class="flex text-ster">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span></span>
              <span class="block text-sm text-grijs">{site.google.aantal} reviews op Google</span>
            </span>
          </a>
        </div>
        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 lg:mt-14 lg:grid-cols-3" aria-label="Reviews, veeg voor meer">
          {reviews.map((r, i) => (
            <li class="rijs kaart flex w-[84%] shrink-0 snap-center flex-col p-6 text-inkt md:w-auto md:p-7" style={`--d:${(i % 3) * 0.06}s`}>
              <span class="flex text-ster" role="img" aria-label="5 van 5 sterren">{[1, 2, 3, 4, 5].map(() => <Icoon naam="ster" class="h-[1.125rem] w-[1.125rem]" />)}</span>
              <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed">“{r.tekst}”</blockquote>
              <div class="mt-7 flex items-center gap-3 border-t border-lijn pt-5">
                <span class="grid h-10 w-10 place-items-center rounded-md bg-ijs font-kop font-bold text-blauw" aria-hidden="true">{r.naam[0]}</span>
                <span class="flex-1 text-sm leading-snug"><b class="block font-semibold">{r.naam}</b><span class="text-grijs">Google review, {r.wanneer}</span></span>
                <Icoon naam="g" class="h-5 w-5" />
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-center"><a href={site.reviews} class="font-semibold text-licht underline decoration-vries decoration-[1.5px] underline-offset-4 hover:text-vries">Alle {site.google.aantal} reviews op Google</a></p>
      </div>
    </section>

    <!-- 9. Contact: offerte-bouwer + tijden -->
    <section id="contact" class="py-20" aria-labelledby="t-contact">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5">
          <p class="eyebrow">Offerte en contact</p>
          <h2 id="t-contact" class="mt-4 text-3xl">Vertel wat u nodig hebt.</h2>
          <p class="mt-6 text-lg text-grijs">Kies wat er moet gebeuren en voor hoeveel ruimtes. Wij zetten het in een WhatsApp-bericht aan Martin; een foto van de plek stuurt u daarna gewoon mee.</p>
          <div class="kaart mt-10 p-6 md:p-7">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl">Bereikbaar</h3>
              <p class="status-pil text-sm font-semibold" data-status-wrap><span class="status-stip" aria-hidden="true"></span><span data-status>Ma t/m za</span></p>
            </div>
            <table class="mt-4 w-full">
              <caption class="sr-only">Openingstijden</caption>
              <tbody>
                {tijden.map((t) => (
                  <tr data-dag={t.dag} class="border-b border-lijn last:border-0 data-[vandaag]:font-semibold data-[vandaag]:text-blauw">
                    <th scope="row" class="py-2 pr-4 text-left font-[inherit]">{t.naam}</th>
                    <td class="num whitespace-nowrap py-2 text-right">{t.open ? `${t.open} - ${t.dicht} uur` : 'Gesloten'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            <li><a href={site.telHref} class="kaart flex h-full items-center gap-4 p-4 no-underline transition-shadow hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-ijs text-blauw"><Icoon naam="tel" class="h-5 w-5" /></span><span class="min-w-0"><b class="block font-semibold">Bellen</b><span class="num whitespace-nowrap text-sm text-grijs">{site.tel}</span></span></a></li>
