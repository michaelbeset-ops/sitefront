<script>
  const f = document.querySelector<HTMLFormElement>('[data-kies]');
  if (f) {
    const keuze = f.querySelector<HTMLElement>('[data-keuze]')!;
    const duren = f.querySelector<HTMLElement>('[data-duren]')!;
    const uit = f.querySelector<HTMLElement>('[data-prijs-uit]')!;
    const gekozen = () => f.querySelector<HTMLInputElement>('input[name=m]:checked');
    const duur = () => f.querySelector<HTMLInputElement>('input[name=duur]:checked');
    const zetPrijs = () => { const d = duur(); uit.textContent = d ? `€ ${d.dataset.prijs}` : ''; };
    const bouwDuren = () => {
      const m = gekozen(); if (!m) return;
      keuze.textContent = m.dataset.t || '';
      const opties: [number, number][] = JSON.parse(m.dataset.opties || '[]');
      duren.innerHTML = '';
      opties.forEach(([min, pr], i) => {
        const l = document.createElement('label'); l.className = 'duur';
        l.innerHTML = `<input type="radio" name="duur" value="${min}" data-prijs="${pr}" class="sr-only"${i === Math.min(2, opties.length - 1) ? ' checked' : ''}><span class="num">${min} min</span>`;
        duren.append(l);
      });
      zetPrijs();
    };
    f.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'm') bouwDuren();
      if (t.name === 'duur') zetPrijs();
    });
    bouwDuren();
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      const m = gekozen(), d = duur();
      const data = new FormData(f);
      const v = (n: string) => String(data.get(n) || '').trim();
      const r = [`Hallo Maureen, ik wil graag een afspraak maken voor: ${m?.dataset.t}${d ? `, ${d.value} minuten (€ ${d.dataset.prijs})` : ''}.`];
      if (v('dag')) r.push(`Het liefst op: ${v('dag').toLowerCase()}.`);
      if (v('naam')) r.push(`Groet, ${v('naam')}`);
      window.open('https://wa.me/31629495979?text=' + encodeURIComponent(r.join('\n')), '_blank', 'noopener');
    });
  }
</script>

