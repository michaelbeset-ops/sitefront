---
// Woordmerk: een kawung-bloem (vier bladen, Javaans batikmotief) + "Mareta" + "wellness".
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`merk ${cls}`}>
  <span class="merk-teken" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="h-[1.35rem] w-[1.35rem]" fill="none" stroke="currentColor" stroke-width="1.5">
      <ellipse cx="7.5" cy="7.5" rx="2.6" ry="5.4" transform="rotate(-45 7.5 7.5)" />
      <ellipse cx="16.5" cy="7.5" rx="2.6" ry="5.4" transform="rotate(45 16.5 7.5)" />
      <ellipse cx="7.5" cy="16.5" rx="2.6" ry="5.4" transform="rotate(45 7.5 16.5)" />
      <ellipse cx="16.5" cy="16.5" rx="2.6" ry="5.4" transform="rotate(-45 16.5 16.5)" />
    </svg>
  </span>
  <span><b>Mareta</b> <small>wellness</small></span>
</span>
