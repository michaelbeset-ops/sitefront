---
import { site, url } from '../data/site';
---
<footer class="op-donker bg-inkt text-mist">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="font-kop text-2xl font-extrabold tracking-[-0.03em] text-ivoor">{site.naam}</p>
      <p class="mt-3 max-w-sm text-sm">Permanente make-up, wimpers en wenkbrauwen bij {site.eigenaar}. Salon aan huis in {site.plaats}.</p>
    </div>
    <div class="text-sm md:col-span-3">
      <p class="label text-zand">Adres</p>
      <p class="mt-3">{site.straat}<br />{site.postcode} {site.plaats}</p>
    </div>
    <div class="text-sm md:col-span-4">
      <p class="label text-zand">Contact</p>
      <ul class="mt-3 grid gap-1">
        <li><a href={site.mobielHref} class="hover:text-ivoor hover:underline">{site.mobiel}</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-ivoor hover:underline">{site.email}</a></li>
        <li><a href={site.instagram} class="hover:text-ivoor hover:underline">Instagram</a> en <a href={site.facebook} class="hover:text-ivoor hover:underline">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-wrap justify-between gap-3 border-t border-ivoor/15 py-6 text-xs">
    <p>© {new Date().getFullYear()} {site.naam}</p>
    <a href={url('privacy/')} class="hover:text-ivoor hover:underline">Privacyverklaring</a>
  </div>
</footer>
