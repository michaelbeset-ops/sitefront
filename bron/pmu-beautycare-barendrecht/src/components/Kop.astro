---
import { site, url } from '../data/site';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
// Op de homepage ligt de kop over de hero-foto, op andere pagina's staat hij gewoon op het papier.
const a = (h: string) => (thuis ? h : url(h));
---
<header class:list={[thuis ? 'op-donker absolute inset-x-0 z-30 text-ivoor' : 'border-b border-lijn text-inkt']}>
  <div class="wrap flex items-center justify-between gap-6 py-5">
    <a href={url('')} class="leading-none">
      <span class="block font-kop text-xl font-extrabold tracking-[-0.03em]">PMU BeautyCare</span>
      <span class:list={['label mt-1 block text-[0.6875rem]', thuis ? 'text-zand' : 'text-henna']}>Barendrecht</span>
    </a>
    <nav aria-label="Hoofdmenu" class="flex items-center gap-7 text-sm font-medium">
      <a href={a('#traject')} class="hidden hover:underline underline-offset-4 lg:inline">Powder brows</a>
      <a href={a('#prijzen')} class="hidden hover:underline underline-offset-4 lg:inline">Prijzen</a>
      <a href={a('#gwendolyn')} class="hidden hover:underline underline-offset-4 lg:inline">Over Gwendolyn</a>
      <a href={a('#contact')} class="hidden hover:underline underline-offset-4 lg:inline">Contact</a>
      <a href={site.boeken} class:list={['knop min-h-11 px-4 text-sm', thuis ? 'knop-ivoor' : 'knop-henna']}>Afspraak maken</a>
    </nav>
  </div>
</header>
