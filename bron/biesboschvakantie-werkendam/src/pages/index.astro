---
import Base from '../layouts/Base.astro';
import { site, seizoen, tarieven, url, fotos } from '../data/site';

const faciliteiten = [
  'Sanitair met een aparte dames- en herenafdeling',
  'Gratis douchen',
  'Afwassen met warm water bij het informatiehok',
  'Stroom 4A, tegen vergoeding',
  'Kano en sup huren, met vaarkaart',
  'Huisdieren welkom',
];

const weten = [
  { kop: 'Je plek', tekst: 'Kies je ter plaatse. Elke plaats is 200 m².' },
  { kop: 'Honden', tekst: 'Welkom, aan de lijn.' },
  { kop: 'De auto', tekst: 'Staat op het parkeerterrein, niet bij je plaats. Parkeren is gratis.' },
  { kop: 'Barbecue', tekst: 'Mag. Open vuur en vuurkorven niet.' },
  { kop: 'Bijzettent', tekst: 'Mag tot 5 m². Partytenten zijn niet toegestaan.' },
  { kop: 'Wifi', tekst: 'Is er niet.' },
  { kop: 'Feesten', tekst: 'Niet op het terrein. Het blijft hier rustig.' },
  { kop: 'Boodschappen', tekst: 'Er is geen winkel of broodjesservice. Boodschappen doe je in Werkendam.' },
  { kop: 'Iets huren', tekst: 'Kampeermiddelen huur je alleen in de vorm van een trekkershut.' },
];

const uitjes = ['Biesbosch MuseumEiland', 'Slot Loevestein', 'Woudrichem', 'Dordrecht', 'De Efteling'];
---
<Base
  title="Biesbosch Vakantie | Kamperen aan de kreek in Werkendam"
  description="Minicamping De Witboom, Natuurkampeerterrein De Knotwilg en trekkershutten aan de Noordwaard in de Biesbosch. Plaatsen van 200 m², kano huren, open van 27 maart t/m 4 oktober 2026."
  hero
>
  <!-- Hero: schermvullende foto, tekst linksonder zoals je over het water kijkt. -->
  <section class="donker relative isolate flex min-h-[100svh] items-end overflow-hidden bg-kreek text-licht">
    <img
      src={fotos.hero(1600)}
      srcset={`${fotos.hero(800)} 800w, ${fotos.hero(1200)} 1200w, ${fotos.hero(1600)} 1600w`}
      sizes="100vw"
      alt="Hoog riet langs stil water"
      class="absolute inset-0 -z-20 size-full object-cover"
      fetchpriority="high"
    />
    <!-- Donkere sluier van onder naar boven, zodat de tekst op elke foto leesbaar blijft. -->
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,#16302ab3_0%,#16302a33_30%,#16302a59_55%,#16302af2_100%)]"></div>
    <div class="wrap grid gap-10 pb-14 pt-36 md:pb-20 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-4xl">
        <p class="label">Nationaal Park De Biesbosch, Werkendam</p>
        <h1 class="mt-5 text-hero">Kamperen aan de kreek, midden in de Biesbosch</h1>
        <p class="mt-6 max-w-2xl text-lg text-licht/90 md:text-xl">Twee kleine terreinen en trekkershutten aan de Noordwaard. Ruime plaatsen, rust om je heen, en een kano die je zo te water laat.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.boeken} class="knop knop-licht">Online boeken</a>
          <a href={url('#tarieven')} class="knop knop-rand">Tarieven 2026</a>
        </div>
      </div>
      <p class="border-l-2 border-kano-licht pl-4 text-sm leading-snug text-licht/90">
        Seizoen {seizoen.jaar}<br />
        <span class="font-kop text-2xl font-extrabold tracking-tight text-licht">{seizoen.van} t/m {seizoen.tot}</span>
      </p>
    </div>
  </section>

  <!-- Blikvanger: de 200 m² aan de kreek, het sterkste punt van de camping. -->
  <section id="kreek" class="py-20 md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-6">
        <p class="label">Aan de kreek</p>
        <p class="num mt-6 font-kop text-reus font-extrabold leading-[.85] tracking-[-0.05em] text-kreek" aria-hidden="true">200<span class="align-top text-[.4em] tracking-normal">m²</span></p>
        <h2 class="mt-6 max-w-xl text-3xl">Ruimte genoeg, en het water naast je plek</h2>
        <div class="mt-6 max-w-xl space-y-4 text-mos">
          <p>Op Minicamping De Witboom kampeer je achter het huis, direct aan de kreek. Elke plaats is 200 m² en je kiest je plek als je aankomt.</p>
          <p>Huur een kano of sup, neem de vaarkaart mee en je peddelt vanaf de camping zo de Biesbosch in. Een kano kost 35 euro per dag.</p>
        </div>
      </div>
      <figure class="relative lg:col-span-5 lg:col-start-8 lg:mt-24">
        <img src={fotos.kano(1000)} srcset={`${fotos.kano(600)} 600w, ${fotos.kano(1000)} 1000w`} sizes="(min-width: 1024px) 40vw, 100vw" alt="Een kano op stil water, met hoge bomen op de oever" loading="lazy" class="aspect-[4/3] w-full bg-riet-2 object-cover lg:aspect-[4/5]" />
        <div class="absolute -bottom-5 -left-5 hidden h-24 w-24 border-b-2 border-l-2 border-kano md:block" aria-hidden="true"></div>
      </figure>
    </div>
  </section>

  <!-- Terreinen: een genummerde lijst met lijnen ertussen, geen kaartjes. -->
  <section id="terreinen" class="border-t border-lijn bg-wit py-20 md:py-28">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="label">Twee terreinen en trekkershutten</p>
          <h2 class="mt-4 text-3xl">Kies je plek aan het water</h2>
        </div>
        <p class="max-w-md text-mos lg:col-span-5 lg:self-end">Beide terreinen liggen aan de Witboomkil in Werkendam, aan natuurgebied De Noordwaard.</p>
      </div>

      <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-8">
        <ol class="divide-y divide-lijn border-y border-lijn lg:col-span-7">
          <li class="grid gap-3 py-9 sm:grid-cols-[4.5rem_1fr]">
            <span class="num font-kop text-2xl font-extrabold text-kano">01</span>
            <div>
              <h3 class="text-2xl">Minicamping De Witboom</h3>
              <p class="mt-3 text-mos">Achter ons huis, aan de kreek. Vanaf hier vaar je met de kano het natuurgebied in.</p>
              <ul class="mt-5 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
                {faciliteiten.map((f) => (
                  <li class="flex gap-3"><svg viewBox="0 0 16 16" class="mt-1.5 size-3.5 flex-none text-kano" aria-hidden="true"><path d="M2 8.5l3.5 3.5L14 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>{f}</li>
                ))}
              </ul>
            </div>
          </li>
          <li class="grid gap-3 py-9 sm:grid-cols-[4.5rem_1fr]">
            <span class="num font-kop text-2xl font-extrabold text-kano">02</span>
            <div>
              <h3 class="text-2xl">Natuurkampeerterrein De Knotwilg</h3>
              <p class="mt-3 text-mos">Ruim opgezet aan open water, met bomen voor schaduw. Voor je tent, camper of caravan. Het terrein heeft een helofytenfilter, een natuurlijke waterzuivering met riet.</p>
            </div>
          </li>
          <li class="grid gap-3 py-9 sm:grid-cols-[4.5rem_1fr]">
            <span class="num font-kop text-2xl font-extrabold text-kano">03</span>
            <div>
              <h3 class="text-2xl">Trekkershutten</h3>
              <p class="mt-3 text-mos">Geen tent bij je? Slaap in een trekkershut met een eigen terras en uitzicht over het water.</p>
            </div>
          </li>
        </ol>
        <div class="lg:col-span-4 lg:col-start-9">
          <img src={fotos.tent(900)} srcset={`${fotos.tent(600)} 600w, ${fotos.tent(900)} 900w`} sizes="(min-width: 1024px) 30vw, 100vw" alt="Een tent in een open veld onder een bewolkte lucht" loading="lazy" class="aspect-[4/3] w-full bg-riet-2 object-cover lg:sticky lg:top-8 lg:aspect-[3/4]" />
        </div>
      </div>
    </div>
  </section>

  <!-- Tarieven: de tabel die op de oude site een lege rij en opmaakfouten had, nu leesbaar op mobiel. -->
  <section id="tarieven" class="py-20 md:py-28">
    <div class="wrap">
      <div class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="label">Seizoen {seizoen.jaar}</p>
          <h2 class="mt-4 text-3xl">Tarieven {seizoen.jaar}</h2>
          <p class="mt-4 max-w-md text-mos">Prijzen in euro's, per nacht tenzij er iets anders staat.</p>
        </div>
        <dl class="grid grid-cols-2 gap-4 self-end sm:grid-cols-3 border-t-2 border-kreek pt-5 lg:col-span-6">
          <div class="col-span-2 sm:col-span-1"><dt class="text-xs font-extrabold uppercase tracking-[.12em] text-mos">Open</dt><dd class="mt-1 font-kop text-lg font-bold leading-tight sm:text-xl">{seizoen.van} t/m {seizoen.tot}</dd></div>
          <div><dt class="text-xs font-extrabold uppercase tracking-[.12em] text-mos">Aankomst</dt><dd class="num mt-1 font-kop text-lg font-bold leading-tight sm:text-xl">vanaf {seizoen.aankomst} uur</dd></div>
          <div><dt class="text-xs font-extrabold uppercase tracking-[.12em] text-mos">Vertrek</dt><dd class="num mt-1 font-kop text-lg font-bold leading-tight sm:text-xl">voor {seizoen.vertrek} uur</dd></div>
        </dl>
      </div>

      <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
        {tarieven.map((t) => (
          <table class="w-full text-left">
            <caption class="pb-3 text-left font-kop text-xl font-bold">{t.groep}</caption>
            <thead class="sr-only"><tr><th scope="col">Omschrijving</th><th scope="col">Prijs</th></tr></thead>
            <tbody class="border-t border-kreek">
              {t.regels.map(([wat, prijs]) => (
                <tr class="border-b border-lijn">
                  <th scope="row" class="py-3 pr-4 font-normal">{wat}</th>
                  <td class="num whitespace-nowrap py-3 text-right font-extrabold">{prijs === 'gratis' ? 'gratis' : `€ ${prijs}`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ))}
      </div>

      <div class="mt-14 flex flex-col gap-5 bg-riet-2 p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
        <p class="max-w-xl"><span class="font-kop text-xl font-bold">Weet je wanneer je komt?</span><br /><span class="text-mos">Boek je plaats of trekkershut via de boekingspagina.</span></p>
        <a href={site.boeken} class="knop knop-kano shrink-0">Online boeken</a>
      </div>
    </div>
  </section>

  <!-- Huisregels uit de veelgestelde vragen, kort en eerlijk, op donker als rustpunt. -->
  <section id="goed-om-te-weten" class="donker bg-kreek py-20 text-licht md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <p class="label">Goed om te weten</p>
        <h2 class="mt-4 text-3xl">Zo houden we het rustig</h2>
        <p class="mt-5 max-w-sm text-licht-zacht">Kleinschalig kamperen in de natuur gaat het best met een paar afspraken.</p>
      </div>
      <dl class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
        {weten.map((w) => (
          <div class="border-t border-lijn-licht py-5">
            <dt class="font-kop text-lg font-bold text-kano-licht">{w.kop}</dt>
            <dd class="mt-1 text-licht/90">{w.tekst}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Omgeving: typografisch, zonder afstanden of claims die we niet kunnen onderbouwen. -->
  <section id="omgeving" class="py-20 md:py-28">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <p class="label">In de omgeving</p>
        <h2 class="mt-4 text-3xl">Het park begint aan de rand van het erf</h2>
        <p class="mt-5 max-w-md text-mos">Wandel en fiets door het Nationaal Park, vaar met de kano of sup door de kreken en kijk naar de dieren in de Noordwaard.</p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="text-sm font-extrabold uppercase tracking-[.12em] text-mos">Een dagje weg</p>
        <ul class="mt-3 border-t border-kreek">
          {uitjes.map((u) => <li class="border-b border-lijn py-4 font-kop text-2xl font-bold tracking-tight">{u}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Contact: boeken gaat via het bestaande systeem, vragen per mail. Formulier staat uit in het voorstel. -->
  <section id="contact" class="border-t border-lijn bg-wit py-20 md:py-28">
    <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <p class="label">Contact</p>
        <h2 class="mt-4 text-3xl">Vragen, of meteen boeken?</h2>
        <p class="mt-5 max-w-md text-mos">Boeken doe je online. Heb je eerst een vraag, mail dan of gebruik het formulier. Je vraag komt bij {site.beheerders}, de beheerders.</p>
        <a href={site.boeken} class="knop knop-kano mt-8">Online boeken</a>
        <dl class="mt-12 space-y-6">
          <div>
            <dt class="text-xs font-extrabold uppercase tracking-[.12em] text-mos">Adres</dt>
            <dd class="mt-1 text-lg">{site.straat}, {site.postcode} {site.plaats}<br /><a href={site.maps} class="link text-base">Route plannen</a></dd>
          </div>
          <div>
            <dt class="text-xs font-extrabold uppercase tracking-[.12em] text-mos">E-mail</dt>
            <dd class="mt-1 text-lg"><a href={`mailto:${site.email}`} class="link">{site.email}</a></dd>
          </div>
        </dl>
      </div>

      <form class="lg:col-span-6 lg:col-start-7" onsubmit="return false" aria-describedby="formulier-uit">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block font-bold">Naam <span class="text-kano">*</span><input class="veld font-normal" type="text" name="naam" autocomplete="name" disabled /></label>
          <label class="block font-bold">Telefoonnummer<input class="veld font-normal" type="tel" name="telefoon" autocomplete="tel" disabled /></label>
          <label class="block font-bold">E-mail <span class="text-kano">*</span><input class="veld font-normal" type="email" name="email" autocomplete="email" disabled /></label>
          <label class="block font-bold">Onderwerp <span class="text-kano">*</span><input class="veld font-normal" type="text" name="onderwerp" disabled /></label>
          <label class="block font-bold sm:col-span-2">Bericht<textarea class="veld min-h-36 font-normal" name="bericht" rows="5" disabled></textarea></label>
        </div>
        {site.voorstel ? (
          <p id="formulier-uit" class="mt-6 border-l-2 border-kano bg-riet px-5 py-4 text-sm">Dit is een ontwerpvoorstel, dit formulier verstuurt nog niets. Mail je vraag naar <a href={`mailto:${site.email}`} class="link">{site.email}</a>.</p>
        ) : (
          <p id="formulier-uit" class="mt-6 text-sm text-mos">Velden met een * zijn verplicht.</p>
        )}
      </form>
    </div>
  </section>
</Base>
