---
import { site, url } from '../data/site';
---
<footer class="donker bg-kreek text-licht">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-kop text-2xl font-extrabold tracking-tight">Biesbosch Vakantie</p>
      <p class="mt-2 max-w-sm text-licht-zacht">{site.terreinen}, aan de Noordwaard in Nationaal Park De Biesbosch.</p>
    </div>
    <div class="text-sm leading-relaxed">
      <p class="font-bold">Adres</p>
      <p class="mt-1 text-licht-zacht">{site.straat}<br />{site.postcode} {site.plaats}</p>
      <p class="mt-3"><a href={`mailto:${site.email}`} class="link">{site.email}</a></p>
    </div>
    <div class="text-sm leading-relaxed">
      <p class="font-bold">Volg ons</p>
      <ul class="mt-1 space-y-1">
        <li><a href={site.facebook} class="link">Facebook</a></li>
        <li><a href={site.youtube} class="link">YouTube</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lijn-licht">
    <div class="wrap flex flex-col gap-2 py-6 text-xs text-licht-zacht sm:flex-row sm:justify-between">
      <p>KvK <span class="num">{site.kvk}</span></p>
      <p><a href={url('privacy/')} class="link">Privacyverklaring</a></p>
    </div>
  </div>
</footer>
