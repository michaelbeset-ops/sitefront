---
import { url, waLink, site } from '../data/site';
import Icoon from './Icoon.astro';
import Logo from './Logo.astro';
interface Props { thuis?: boolean }
const { thuis = true } = Astro.props;
const h = (id: string) => (thuis ? `#${id}` : url(`#${id}`));
const nav = [['buiten', 'Buiten'], ['schaduw', 'Waar wilt u schaduw?'], ['binnen', 'Binnen'], ['service', 'Reparatie'], ['contact', 'Contact']];
const wa = waLink('Hallo Sam, ik heb een vraag over zonwering.');
---
<header class={thuis ? 'absolute inset-x-0 top-0 z-40' : 'relative z-40 border-b border-lijn bg-wit'}>
  <div class="wrap flex h-20 items-center justify-between gap-6 md:h-24">
    <a href={url()} class="block shrink-0" aria-label="Sam Zonwering"><Logo class="h-12 w-auto md:h-14" /></a>
    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex gap-7 text-[.9375rem] font-medium">
        {nav.map(([id, t]) => <li><a href={h(id)} class="text-inkt no-underline transition-colors duration-200 hover:text-sam-2">{t}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-5">
      <a href={site.telHref} class="num hidden text-[.9375rem] font-semibold text-sam no-underline transition-colors hover:text-sam-2 xl:block">{site.tel}</a>
      <a href={wa} class="knop knop-sam hidden min-h-11 px-4 md:inline-flex"><Icoon naam="wa" />WhatsApp</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-sam lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="menu-nav" aria-label="Menu" class="hidden border-t border-lijn bg-wit lg:hidden" data-menu>
    <ul class="wrap pb-8 pt-2">
      {nav.map(([id, t]) => <li><a href={h(id)} class="kop block border-b border-lijn py-4 text-2xl font-bold text-sam no-underline">{t}</a></li>)}
      <li class="pt-6"><a href={site.telHref} class="num font-semibold text-sam no-underline">{site.tel}</a></li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-lijn bg-wit md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 text-[.9375rem] font-bold text-sam no-underline"><Icoon naam="tel" class="h-5 w-5" />Bellen</a>
  <a href={wa} class="flex min-h-14 items-center justify-center gap-2.5 bg-sam text-[.9375rem] font-bold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
