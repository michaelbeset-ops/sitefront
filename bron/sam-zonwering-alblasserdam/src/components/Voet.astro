---
import { site, url, buiten, binnen, waLink } from '../data/site';
import Logo from './Logo.astro';
---
<footer class="op-donker bg-nacht text-mist">
  <div class="wrap grid gap-12 pb-10 pt-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.1fr] lg:pt-20">
    <div>
      <Logo licht class="h-14 w-auto" />
      <p class="mt-6 max-w-xs text-sm leading-relaxed">Binnen- en buitenzonwering op maat. Leveren, monteren, onderhoud en reparatie.</p>
    </div>
    <div>
      <h2 class="kop text-lg font-bold text-wit">Buiten</h2>
      <ul class="mt-4 space-y-2 text-sm">{buiten.map((b) => <li><a href={url('#buiten')} class="no-underline transition-colors hover:text-zon">{b.titel}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="kop text-lg font-bold text-wit">Binnen</h2>
      <ul class="mt-4 space-y-2 text-sm">{binnen.map((b) => <li><a href={url('#binnen')} class="no-underline transition-colors hover:text-zon">{b.titel}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="kop text-lg font-bold text-wit">Contact</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li>{site.straat}<br />{site.postcode} {site.plaats}</li>
        <li><a href={site.telHref} class="num no-underline transition-colors hover:text-zon">{site.tel}</a></li>
        <li><a href={waLink('Hallo Sam, ik heb een vraag over zonwering.')} class="no-underline transition-colors hover:text-zon">WhatsApp</a></li>
        <li><a href={`mailto:${site.mail}`} class="no-underline transition-colors hover:text-zon">{site.mail}</a></li>
        <li class="pt-2">Ma t/m vr 08.00 tot 18.00 uur</li>
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-col gap-3 border-t border-lijn-d py-6 text-xs md:flex-row md:items-center md:justify-between">
    <p>© {new Date().getFullYear()} {site.officieel}, {site.plaats}</p>
    <p>Sfeerfoto's via Unsplash, ter illustratie. <a href={url('privacy/')} class="link">Privacy</a></p>
  </div>
</footer>
