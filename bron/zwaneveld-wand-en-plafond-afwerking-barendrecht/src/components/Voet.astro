---
import { site, url } from '../data/site';
---
<footer class="op-donker bg-inkt text-mist">
  <div class="wrap grid gap-8 py-12 text-sm md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="font-kop text-2xl font-extrabold tracking-[-0.035em] text-wit">Zwaneveld</p>
      <p class="mt-2">{site.naam}, {site.straat}, {site.postcode} {site.plaats}</p>
      <p class="mt-1">KvK {site.kvk}</p>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <li><a href={site.mobielHref} class="underline underline-offset-4 hover:text-wit">{site.mobiel}</a></li>
      <li><a href={`mailto:${site.mail}`} class="underline underline-offset-4 hover:text-wit">{site.mail}</a></li>
      <li><a href={url('privacy/')} class="underline underline-offset-4 hover:text-wit">Privacy</a></li>
    </ul>
  </div>
</footer>
