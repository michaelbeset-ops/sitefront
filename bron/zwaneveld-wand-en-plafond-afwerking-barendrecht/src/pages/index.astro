---
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import { site, tijden, diensten, ook, reviews, foto, srcset } from '../data/site';

const heroSet = srcset(foto.hero, [640, 960, 1280, 1600]);
---
<Base
  title="Stukadoor in Barendrecht | R. Zwaneveld Wand & Plafond afwerking"
  description="Rodney Zwaneveld, stukadoor in Barendrecht sinds 2000. Stucwerk, plafonds, spackspuitwerk, latex spuiten en sauswerk. 9,6 uit 24 reviews."
  heroFoto={foto.hero(1280)}
  heroSrcset={heroSet}
>
  <Kop />
  <main id="inhoud">
    <!-- Hero: schermvullende foto, tekst onderaan links. De rode laserlijn loopt vanaf de kop tot buiten beeld. -->
    <section class="op-donker relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-nacht text-wit" aria-labelledby="hero-kop">
      <img
        src={foto.hero(1280)}
        srcset={heroSet}
        sizes="100vw"
        alt=""
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,#111923_8%,#111923e6_40%,#1119238c_70%,#11192340)] lg:bg-[linear-gradient(100deg,#111923f2_0%,#111923d9_42%,#11192366_75%,#11192326)]"></div>

      <div class="wrap pb-14 pt-36 lg:pb-20">
        <p class="label text-mist"><span class="kruis text-laser-licht" aria-hidden="true"></span>Stukadoor in Barendrecht, sinds 2000</p>
        <h1 id="hero-kop" class="mt-6 max-w-[15ch] text-5xl lg:max-w-[21ch]">“Strak gladde muren en kaarsrechte hoeken.”</h1>
        <div class="trek laserlijn mt-9 w-[100vw]" aria-hidden="true"></div>
        <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="max-w-xl text-wit/90 sm:text-lg">Zo beschreef familie Feenstra in april 2026 het werk van Rodney Zwaneveld in hun woonkamer, keuken en badkamer. Hij stuukt muren en plafonds in Barendrecht en omgeving.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={site.mobielHref} class="knop knop-laser">Bel Rodney, {site.mobiel}</a>
              <a href="#werk" class="knop knop-lijn text-wit">Wat hij doet</a>
            </div>
          </div>
          <a href={site.reviewsBron} class="group flex items-end gap-4 lg:col-span-4 lg:col-start-9 lg:justify-self-end">
            <span class="font-kop text-[4.25rem] font-extrabold leading-[0.8] tracking-[-0.05em]">{site.score}</span>
            <span class="text-sm leading-snug text-mist">uit {site.aantalReviews} reviews<br /><span class="underline underline-offset-4 group-hover:text-wit">Top Score 2026 op stukadoorgids.nl</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- Wat hij doet: de diensten als genummerde regels, zoals maten op een werktekening. Geen kaartjes. -->
    <section id="werk" class="scroll-mt-4 py-20 lg:py-32" aria-labelledby="werk-kop">
      <div class="wrap grid grid-cols-1 gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-laser"><span class="kruis" aria-hidden="true"></span>Wat Rodney doet</p>
          <h2 id="werk-kop" class="mt-5 text-4xl">Muren en plafonds, binnen in huis</h2>
          <p class="mt-6 max-w-md text-grijs">Woonkamers, keukens, badkamers en hoge hallen. Rodney werkt bij mensen thuis, in Barendrecht en de omgeving.</p>
          <figure class="mt-12 hidden lg:block">
            <img src={foto.plafond(900)} srcset={srcset(foto.plafond, [600, 900, 1200])} sizes="(min-width: 1280px) 460px, 38vw" alt="Wit plafond met lijstwerk" loading="lazy" class="aspect-[4/5] w-full bg-wand object-cover" />
            <figcaption class="mt-2 text-xs text-grijs">Sfeerbeeld</figcaption>
          </figure>
        </div>

        <div class="lg:col-span-7">
          <ol class="border-b border-lijn">
            {diensten.map((d, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-t border-lijn py-7 sm:grid-cols-[3.5rem_minmax(0,14rem)_1fr] sm:gap-x-6">
                <span class="pt-1.5 text-sm font-semibold tabular-nums text-laser">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="text-2xl">{d.naam}</h3>
                <p class="col-start-2 mt-2 text-grijs sm:col-start-3 sm:mt-0 sm:pt-0.5">{d.uitleg}</p>
              </li>
            ))}
          </ol>

          <h3 class="mt-16 text-xl tracking-[-0.02em]">En wat klanten er verder over vertellen</h3>
          <div class="mt-6 grid gap-8 sm:grid-cols-2">
            {ook.map((o) => (
              <div class="border-l-2 border-laser pl-5">
                <p class="font-semibold">{o.titel}</p>
                <p class="mt-1 text-grijs">{o.tekst}</p>
                <p class="mt-3 text-xs text-grijs">Uit de review van {o.wie}, {o.datum}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Reviews: de blikvanger. Eén groot citaat, dan de hal van 6 meter, dan korte citaten op een lijn. -->
    <section id="reviews" class="op-donker scroll-mt-4 bg-nacht py-20 text-wit lg:py-32" aria-labelledby="reviews-kop">
      <div class="wrap">
        <p class="label text-mist"><span class="kruis text-laser-licht" aria-hidden="true"></span>Uit de reviews</p>
        <h2 id="reviews-kop" class="sr-only">Wat klanten over Rodney schrijven</h2>
        <figure class="mt-8 max-w-5xl">
          <blockquote>
            <p class="font-kop text-4xl font-extrabold leading-[1.02] tracking-[-0.035em]">“Een TOP VAKMAN (met hoofdletters).”</p>
          </blockquote>
          <figcaption class="mt-6 max-w-xl text-mist">Familie Feenstra, 28 april 2026, nadat Rodney hun woonkamer, keuken en badkamer stuukte.</figcaption>
        </figure>

        <div class="mt-20 grid gap-12 lg:mt-28 lg:grid-cols-12 lg:items-stretch">
          <figure class="lg:col-span-5">
            <img src={foto.trap(900)} srcset={srcset(foto.trap, [600, 900, 1200])} sizes="(min-width: 1280px) 460px, (min-width: 1024px) 38vw, 100vw" alt="Witte trap naar een overloop met strakke witte muren" loading="lazy" class="aspect-[4/3] w-full bg-inkt object-cover lg:aspect-[4/5]" />
            <figcaption class="mt-2 text-xs text-mist">Sfeerbeeld</figcaption>
          </figure>
          <!-- De verticale laserlijn met maat: een hal van 6 meter vraagt om een lijn die echt loodrecht staat. -->
          <div class="grid grid-cols-[auto_1fr] gap-6 lg:col-span-6 lg:col-start-7 lg:gap-10">
            <div class="flex flex-col items-center" aria-hidden="true">
              <span class="h-px w-5 bg-laser-licht"></span>
              <span class="w-[2px] flex-1 bg-laser-licht"></span>
              <span class="h-px w-5 bg-laser-licht"></span>
            </div>
            <div class="flex flex-col justify-between gap-10 py-1">
              <p class="font-kop text-[5rem] font-extrabold leading-[0.8] tracking-[-0.05em] text-laser-licht sm:text-[7rem]">6 m</p>
              <div>
                <h3 class="text-3xl">Een hal van 6&nbsp;meter hoog</h3>
                <blockquote class="mt-5 text-xl text-wit/90"><p>“Het resultaat is werkelijk indrukwekkend.”</p></blockquote>
                <p class="mt-3 text-sm text-mist">Een klant van Rodney op stucmanager.nl</p>
              </div>
            </div>
          </div>
        </div>

        <ul class="mt-20 grid gap-x-12 sm:grid-cols-2 lg:mt-28">
          {reviews.map((r) => (
            <li class="border-t border-lijn-licht py-8">
              <blockquote><p class="font-kop text-2xl font-bold tracking-[-0.02em]">“{r.tekst}”</p></blockquote>
              <p class="mt-3 text-sm text-mist">{r.wie}{r.datum && `, ${r.datum}`}, via {r.bron}</p>
            </li>
          ))}
        </ul>

        <div class="mt-6 flex flex-wrap items-baseline justify-between gap-4 border-t border-lijn-licht pt-8">
          <p class="text-mist"><span class="font-kop text-2xl font-extrabold text-wit">{site.score}</span> uit {site.aantalReviews} reviews op Google en stukadoorgids.nl</p>
          <a href={site.reviewsBron} class="font-semibold text-laser-licht underline underline-offset-4">Alle reviews lezen</a>
        </div>
      </div>
    </section>

    <!-- Over: zijn eigen zin van de oude site als kop, met de feiten op een rij. -->
    <section id="over" class="scroll-mt-4 py-20 lg:py-32" aria-labelledby="over-kop">
      <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
        <figure class="lg:col-span-5">
          <img src={foto.afgeplakt(900)} srcset={srcset(foto.afgeplakt, [600, 900, 1200])} sizes="(min-width: 1280px) 460px, (min-width: 1024px) 38vw, 100vw" alt="Keuken tijdens een verbouwing, de kastjes afgedekt met plastic en papier" loading="lazy" class="aspect-[5/4] w-full bg-wand object-cover lg:aspect-[4/5]" />
          <figcaption class="mt-2 text-xs text-grijs">Sfeerbeeld</figcaption>
        </figure>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="label text-laser"><span class="kruis" aria-hidden="true"></span>Over Rodney</p>
          <h2 id="over-kop" class="mt-5 text-3xl">“Mijn naam is Rodney en ik ben stukadoor uit Barendrecht.”</h2>
          <p class="mt-6 text-grijs">Zo stelt Rodney Zwaneveld zichzelf voor. Wand &amp; plafond afwerking R. Zwaneveld is een eenmanszaak, opgericht in april 2000. Wie belt, krijgt Rodney zelf aan de lijn.</p>
          <p class="mt-4 text-grijs">In de reviews komen dezelfde dingen steeds terug. Afspraken nakomen, netjes werken en opgeruimd opleveren.</p>
          <dl class="mt-10 grid grid-cols-1 border-t border-lijn sm:grid-cols-3">
            <div class="border-b border-lijn py-5 sm:border-b-0 sm:pr-6"><dt class="text-sm text-grijs">Stukadoor sinds</dt><dd class="mt-1 font-kop text-2xl font-extrabold tracking-[-0.03em]">2000</dd></div>
            <div class="border-b border-lijn py-5 sm:border-b-0 sm:border-l sm:px-6"><dt class="text-sm text-grijs">Werkgebied</dt><dd class="mt-1 font-semibold">Barendrecht en omgeving</dd></div>
            <div class="py-5 sm:border-l sm:pl-6"><dt class="text-sm text-grijs">Garantie</dt><dd class="mt-1 font-semibold">Op het werk</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- Contact: bellen staat voorop, het formulier is in dit voorstel uitgeschakeld. -->
    <section id="contact" class="scroll-mt-4 border-t border-lijn bg-wand py-20 lg:py-32" aria-labelledby="contact-kop">
      <div class="wrap grid grid-cols-1 gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="label text-inkt"><span class="kruis text-laser" aria-hidden="true"></span>Contact</p>
          <h2 id="contact-kop" class="mt-5 text-4xl">Vertel Rodney welke muren aan de beurt zijn</h2>
          <p class="mt-6 max-w-md text-grijs">Bel of mail, en vertel om welke ruimtes het gaat.</p>
          <div class="mt-10 grid gap-8">
            <div>
              <p class="text-sm text-grijs">Bellen</p>
              <a href={site.mobielHref} class="mt-1 block font-kop text-3xl font-extrabold tracking-[-0.03em] underline-offset-4 hover:underline">{site.mobiel}</a>
            </div>
            <div>
              <p class="text-sm text-grijs">Mailen</p>
              <a href={`mailto:${site.mail}`} class="mt-1 block break-all font-semibold underline underline-offset-4">{site.mail}</a>
            </div>
            <div>
              <p class="text-sm text-grijs">Adres</p>
              <p class="mt-1">{site.straat}<br />{site.postcode} {site.plaats}</p>
              <a href={site.route} class="mt-2 inline-block text-sm font-semibold underline underline-offset-4">Route in Google Maps</a>
            </div>
            <div>
              <p class="text-sm text-grijs">Bereikbaar</p>
              <dl class="mt-1">
                {tijden.map((t) => (
                  <div class="flex flex-wrap justify-between gap-x-6 border-b border-lijn py-2"><dt>{t.dag}</dt><dd class="font-semibold">{t.tijd}</dd></div>
                ))}
              </dl>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          <form class="bg-wit p-6 sm:p-10" aria-describedby="formulier-uit" onsubmit="return false">
            <p class="font-kop text-2xl font-extrabold tracking-[-0.03em]">Vraag het via de website</p>
            <div class="mt-8 grid gap-6">
              <label class="grid gap-2 text-sm font-semibold">Naam
                <input type="text" name="naam" autocomplete="name" class="min-h-12 border border-lijn bg-gips px-3 text-base font-normal" />
              </label>
              <label class="grid gap-2 text-sm font-semibold">Telefoon of e-mail
                <input type="text" name="contact" autocomplete="email" class="min-h-12 border border-lijn bg-gips px-3 text-base font-normal" />
              </label>
              <label class="grid gap-2 text-sm font-semibold">Welke ruimtes en wat moet er gebeuren?
                <textarea name="bericht" rows="5" class="border border-lijn bg-gips px-3 py-2 text-base font-normal"></textarea>
              </label>
            </div>
            {site.voorstel ? (
              <p id="formulier-uit" class="mt-8 border-l-2 border-laser pl-4 text-sm text-grijs">Dit is een ontwerpvoorstel, het formulier verstuurt nog niets. Bel Rodney op <a href={site.mobielHref} class="font-semibold text-inkt underline underline-offset-2">{site.mobiel}</a> of mail naar <a href={`mailto:${site.mail}`} class="break-all font-semibold text-inkt underline underline-offset-2">{site.mail}</a>.</p>
            ) : (
              <p id="formulier-uit" class="mt-8 text-sm text-grijs">[[AANLEVEREN: Web3Forms-key voor het formulier]]</p>
            )}
          </form>
        </div>
      </div>
    </section>
  </main>
  <Voet />
</Base>
