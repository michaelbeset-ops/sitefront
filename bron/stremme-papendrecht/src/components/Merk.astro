---
// Woordmerk naar hun eigen kop: STREMME in zware hoofdletters, met de drie draadkleuren als onderstreep.
import { url } from '../data/site';
interface Props { licht?: boolean; class?: string }
const { licht = false, class: cls = '' } = Astro.props;
---
<a href={url('')} class:list={['inline-flex flex-col no-underline', licht ? 'text-wit' : 'text-blauw', cls]} aria-label="Stremme Technisch Onderhoud, naar de homepage">
  <span class="pt-1 text-[1.625rem] font-black uppercase leading-none tracking-[-.02em] sm:text-[1.875rem]">Stremme</span>{" "}
  <span class="mt-1 block w-full" style="height:6px;background:linear-gradient(var(--color-draad-bruin) 0 2px,var(--color-draad-blauw) 2px 4px,var(--color-draad-geel) 4px 6px)" aria-hidden="true"></span>
  <span class:list={['mono mt-1 text-[.625rem] uppercase leading-none tracking-[.16em] sm:text-[.6875rem]', licht ? 'text-mist' : 'text-grijs']}>Technisch Onderhoud</span>
</a>
