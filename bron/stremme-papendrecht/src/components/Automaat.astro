---
// Installatieautomaat (eigen tekening): wit huis, hendel, venstertje dat rood wordt als hij aan staat.
interface Props { class?: string; aan?: boolean; nr?: string }
const { class: cls = '', aan = false, nr = '' } = Astro.props;
---
<svg viewBox="0 0 40 64" class:list={['automaat', aan && 'aan', cls]} aria-hidden="true">
  <rect x="1" y="1" width="38" height="62" rx="3" fill="#ffffff" stroke="#b9c0c9" stroke-width="1.5" />
  <rect x="2" y="2" width="36" height="8" rx="2" fill="#eceef0" />
  <rect x="11" y="16" width="18" height="26" rx="2.5" fill="#d7dbe0" />
  <rect class="hendel" x="13" y="18" width="14" height="13" rx="2" fill="#004895" />
  <rect class="venster" x="15" y="47" width="10" height="5" rx="1" fill="#3aa04a" />
  {nr && <text x="20" y="60" text-anchor="middle" font-family="Overpass Mono, monospace" font-size="6" fill="#4a5361">{nr}</text>}
</svg>
