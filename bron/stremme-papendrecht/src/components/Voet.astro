---
import { site, url, waHoi } from '../data/site';
import Merk from './Merk.astro';
const jaar = new Date().getFullYear();
const groepen = ['Elektrotechniek', 'Beveiliging', 'Data', 'Groene energie', 'Service en storing'];
---
<footer class="bg-nacht text-mist">
  <div class="draden" aria-hidden="true"></div>
  <div class="wrap grid gap-x-10 gap-y-12 py-16 text-[.9375rem] md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <Merk licht />
      <p class="mt-6 max-w-xs">Elektrotechnisch installatiebedrijf voor particulieren en bedrijven. Sinds 1999, vanuit {site.plaats}.</p>
    </div>
    <div class="md:col-span-3">
      <p class="font-bold text-wit">Groepen</p>
      <ul class="mt-3 space-y-1">{groepen.map((g) => <li><a href={url('#werk')} class="link link-licht no-underline hover:underline">{g}</a></li>)}</ul>
    </div>
    <div class="md:col-span-4">
      <p class="font-bold text-wit">Contact</p>
      <p class="mt-3">Kantoor <a href={site.telHref} class="link link-licht num whitespace-nowrap">{site.tel}</a></p>
      <p class="mt-1">Mobiel en storing <a href={site.mobielHref} class="link link-licht num whitespace-nowrap">{site.mobiel}</a></p>
      <p class="mt-1"><a href={waHoi} class="link link-licht">WhatsApp</a>{" · "}<a href={`mailto:${site.mail}`} class="link link-licht">{site.mail}</a></p>
      <p class="mt-4">{site.eigenaar}, {site.plaats}</p>
    </div>
  </div>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-lijn-licht py-7 text-xs">
    <p>© {jaar} {site.naam}, {site.plaats}</p>
    <p class="flex gap-6"><a href={url('privacy/')} class="link link-licht">Privacyverklaring</a><span>Website door Sitefront</span></p>
  </div>
  {site.voorstel && <p class="wrap pb-24 text-xs md:pb-8">Teksten op basis van stremme.nl (webarchief, 2025 en 2026) en jullie Google-profiel. Foto van de bus: eerdere stremme.nl. Groepenkast en luchtfoto: Unsplash, ter sfeer.</p>}
</footer>
